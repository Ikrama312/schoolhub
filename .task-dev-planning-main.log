{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MgPRpzUwc1fDZ9B7iRZ3qm","type":"tool_result","content":"src\nsrc/app\nsrc/app/(app)\nsrc/app/(app)/dashboard\nsrc/app/(public)\nsrc/app/api\nsrc/app/api/academic-years\nsrc/app/api/academic-years/[id]\nsrc/app/api/academic-years/[id]/set-current\nsrc/app/api/academic-years/[id]/terms\nsrc/app/api/academic-years/[id]/terms/generate\nsrc/app/api/audit-logs\nsrc/app/api/grade-levels\nsrc/app/api/grade-levels/[id]\nsrc/app/api/health\nsrc/app/api/me\nsrc/app/api/me/children\nsrc/app/api/me/profile\nsrc/app/api/rooms\nsrc/app/api/rooms/[id]\nsrc/app/api/settings\nsrc/app/api/settings/school\nsrc/app/api/students\nsrc/app/api/students/[id]\nsrc/app/api/students/[id]/parents\nsrc/app/api/students/[id]/parents/[parentId]\nsrc/app/api/subjects\nsrc/app/api/subjects/[id]\nsrc/app/api/terms\nsrc/app/api/terms/[id]\nsrc/app/api/terms/reorder\nsrc/app/api/users\nsrc/app/api/users/[id]\nsrc/app/api/users/[id]/archive\nsrc/app/api/users/[id]/invite\nsrc/app/api/users/[id]/restore\nsrc/app/api/users/[id]/status\nsrc/app/api/users/[id]/unlock\nsrc/app/api/users/export\nsrc/app/api/users/import\nsrc/app/api/users/search\nsrc/app/forbidden\nsrc/components\nsrc/components/ConfirmDialog\nsrc/components/DataTable\nsrc/components/DateDisplay\nsrc/components/EmptyState\nsrc/components/FormField\nsrc/components/LoadingSkeleton\nsrc/components/PageHeader\nsrc/components/StatCard\nsrc/components/Toast\nsrc/components/UserAvatar\nsrc/components/UserPicker\nsrc/config\nsrc/lib\nsrc/lib/validators\nsrc/server\nsrc/server/auth\nsrc/server/services\nsrc/theme\n---notifications/email existing?---\n---prisma schema tail---\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id              String           @id @default(cuid())\n  name            String           @unique\n  shortName       String           @unique\n  order           Int              @unique\n  archivedAt      DateTime?\n  createdAt       DateTime         @default(now())\n  updatedAt       DateTime         @updatedAt\n  studentProfiles StudentProfile[]\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"21428f3c-ee64-490e-9dd6-6d268e3d5ec0","uuid":"2ab6f8e4-2c15-49b8-96d6-0b2142cb55e3","timestamp":"2026-10-19T10:13:57.060Z","tool_use_result":{"stdout":"src\nsrc/app\nsrc/app/(app)\nsrc/app/(app)/dashboard\nsrc/app/(public)\nsrc/app/api\nsrc/app/api/academic-years\nsrc/app/api/academic-years/[id]\nsrc/app/api/academic-years/[id]/set-current\nsrc/app/api/academic-years/[id]/terms\nsrc/app/api/academic-years/[id]/terms/generate\nsrc/app/api/audit-logs\nsrc/app/api/grade-levels\nsrc/app/api/grade-levels/[id]\nsrc/app/api/health\nsrc/app/api/me\nsrc/app/api/me/children\nsrc/app/api/me/profile\nsrc/app/api/rooms\nsrc/app/api/rooms/[id]\nsrc/app/api/settings\nsrc/app/api/settings/school\nsrc/app/api/students\nsrc/app/api/students/[id]\nsrc/app/api/students/[id]/parents\nsrc/app/api/students/[id]/parents/[parentId]\nsrc/app/api/subjects\nsrc/app/api/subjects/[id]\nsrc/app/api/terms\nsrc/app/api/terms/[id]\nsrc/app/api/terms/reorder\nsrc/app/api/users\nsrc/app/api/users/[id]\nsrc/app/api/users/[id]/archive\nsrc/app/api/users/[id]/invite\nsrc/app/api/users/[id]/restore\nsrc/app/api/users/[id]/status\nsrc/app/api/users/[id]/unlock\nsrc/app/api/users/export\nsrc/app/api/users/import\nsrc/app/api/users/search\nsrc/app/forbidden\nsrc/components\nsrc/components/ConfirmDialog\nsrc/components/DataTable\nsrc/components/DateDisplay\nsrc/components/EmptyState\nsrc/components/FormField\nsrc/components/LoadingSkeleton\nsrc