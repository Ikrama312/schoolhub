ave a system-design.md for this ticket (not found anywhere under artifacts/architect/ for ticketId abcd-02 — see handoff-to-dev-planning.json blockers). Contracts below are derived directly from artifacts/intake/requirements.json and the source PRD's explicit API table (02-academic-structure.md, section 'API'), which fully specify method/path/role/body for every endpoint.\",\n\n  \"conventions\": {\n    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n    \"listEnvelope\": { \"data\": \"[...]\", \"page\": 1, \"pageSize\": 20, \"total\": 0 },\n    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\"],\n    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100)\",\n    \"sorting\": \"?sort=field&order=asc|desc\",\n    \"search\": \"?q=\",\n    \"auth\": \"GET endpoints: any signed-in user. All write endpoints (POST/PATCH/DELETE): requireRole('ADMIN') server-side, 403 on non-admin.\",\n    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action <entity>.create|update|archive|delete.\"\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/settings/school\",\n      \"description\": \"Return the single SchoolSettings record.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string (IANA zone)\" } },\n      \"requirementIds\": [\"FR-2\", \"FR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/settings/school\",\n      \"description\": \"Update one or more SchoolSettings fields. Writes audit entry settings.school.update with changed field names in metadata.\",\n      \"requestSchema\": { \"name\": \"string?\", \"logoUrl\": \"string(url)?\", \"address\": \"string?\", \"contactEmail\": \"string?\", \"contactPhone\": \"string?\", \"timezone\": \"string (IANA zone)?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string\" } },\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/academic-years\",\n      \"description\": \"List academic years including their terms, ordered by term order.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\", \"terms\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] } ] },\n      \"requirementIds\": [\"FR-6\", \"FR-10\", \"FR-11\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/academic-years\",\n      \"description\": \"Create an academic year. Validates endDate after startDate and no date-range overlap with any other year, inside a transaction.\",\n      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },\n      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/academic-years/:id\",\n      \"description\": \"Update an academic year's name/dates; re-validates the overlap rule.\",\n      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },\n      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/academic-years/:id/set-current\",\n      \"description\": \"Set isCurrent = true on this year and false on every other year, inside one transaction. Confirm dialog gates this on the client.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"isCurrent\": true } },\n      \"requirementIds\": [\"FR-8\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/academic-years/:id\",\n      \"description\": \"Delete an academic year. Returns CONFLICT (409) if it has terms or is referenced elsewhere.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n      \"requirementIds\": [\"FR-9\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/academic-years/:id/terms\",\n      \"description\": \"Create a term under this academic year. Validates term dates fall inside the year's range and do not overlap sibling terms; order auto-assigns as max+1.\",\n      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/academic-years/:id/terms/generate\",\n      \"description\": \"Split the year's date range into equal consecutive, named, contiguous terms. Only allowed when the year has zero terms. Earlier terms get the extra day when the range doesn't divide evenly.\",\n      \"requestSchema\": { \"pattern\": \"'SEMESTERS' | 'TRIMESTERS' | 'QUARTERS'\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] },\n      \"requirementIds\": [\"FR-14\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/terms/:id\",\n      \"description\": \"Update a term's name/dates/order. Re-validates range and sibling-overlap rules.\",\n      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\", \"order\": \"int?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/terms/:id\",\n      \"description\": \"Delete a term.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n      \"requirementIds\": [\"FR-12\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/terms/reorder\",\n      \"description\": \"Persist a new term order for one academic year (drag handle or up/down buttons).\",\n      \"requestSchema\": { \"academicYearId\": \"string\", \"termIds\": \"string[]\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"order\": \"int\" } ] },\n      \"requirementIds\": [\"FR-13\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/grade-levels\",\n      \"description\": \"List grade levels ordered by `order`. ?includeArchived=true includes archived rows.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-15\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/grade-levels\",\n      \"description\": \"Create a grade level.\",\n      \"requestSchema\": { \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" } },\n      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/grade-levels/:id\",\n      \"description\": \"Update fields, reorder, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n      \"requestSchema\": { \"name\": \"string?\", \"shortName\": \"string?\", \"order\": \"int?\", \"archived\": \"boolean?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } },\n      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/subjects\",\n      \"description\": \"List subjects, searchable by name/code via ?q=.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string(hex)\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/subjects\",\n      \"description\": \"Create a subject. Code is normalised upper-case; duplicate code returns CONFLICT (409) with field error 'Code already used by <subject>.'\",\n      \"requestSchema\": { \"name\": \"string\", \"code\": \"string (2-10 chars, normalised upper-case)\", \"description\": \"string?\", \"color\": \"string(hex, one of 12 preset swatches)\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\" } },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/subjects/:id\",\n      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n      \"requestSchema\": { \"name\": \"string?\", \"code\": \"string?\", \"description\": \"string?\", \"color\": \"string(hex)?\", \"archived\": \"boolean?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\", \"archivedAt\": \"datetime|null\" } },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/rooms\",\n      \"description\": \"List rooms.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-17\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/rooms\",\n      \"description\": \"Create a room.\",\n      \"requestSchema\": { \"name\": \"string\", \"building\": \"string?\", \"capacity\": \"int (1-500)?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\" } },\n      \"requirementIds\": [\"FR-17\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/rooms/:id\",\n      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n      \"requestSchema\": { \"name\": 