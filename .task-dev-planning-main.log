{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ZRvECDxC6tMZ2PLFfZsKA","type":"tool_result","content":"          </ListItemButton>\n        );\n        return collapsed && isDesktop ? (\n          <Tooltip key={item.href} title={item.label} placement=\"right\">\n            {button}\n          </Tooltip>\n        ) : (\n          button\n        );\n      })}\n    </List>\n  );\n\n  return (\n    <Box sx={{ display: 'flex', minHeight: '100vh' }}>\n      <AppBar\n        position=\"fixed\"\n        sx={{\n          zIndex: (t) => t.zIndex.drawer + 1,\n          ...(isDesktop\n            ? { width: `calc(100% - ${drawerWidth}px)`, ml: `${drawerWidth}px` }\n            : {}),\n        }}\n      >\n        <Toolbar sx={{ gap: 1 }}>\n          {!isDesktop && (\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Open navigation\"\n              edge=\"start\"\n              onClick={() => setMobileOpen(true)}\n            >\n              <MenuIcon />\n            </IconButton>\n          )}\n          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n            {schoolShortName}\n          </Typography>\n\n          <Tooltip title=\"Notifications\">\n            <IconButton color=\"inherit\" aria-label=\"Notifications\">\n              <Badge badgeContent={0} color=\"error\">\n                <NotificationsNoneIcon />\n              </Badge>\n            </IconButton>\n          </Tooltip>\n\n          <Tooltip title={mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}>\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Toggle color mode\"\n              onClick={() => setMode(mode === 'dark' ? 'light' : 'dark')}\n            >\n              {mode === 'dark' ? <LightModeIcon /> : <DarkModeIcon />}\n            </IconButton>\n          </Tooltip>\n\n          <IconButton onClick={(event) => setMenuAnchor(event.currentTarget)} aria-label=\"User menu\">\n            <UserAvatar userId={PLACEHOLDER_USER.id} name={PLACEHOLDER_USER.name} size={32} />\n          </IconButton>\n          <Menu anchorEl={menuAnchor} open={Boolean(menuAnchor)} onClose={() => setMenuAnchor(null)}>\n=== users.ts sendInvite ===\n}\n\n/** FR-31: clears exactly the two lockout fields that exist in the schema today. */\nexport async function unlockUser(userId: string) {\n  return prisma.user.update({\n    where: { id: userId },\n    data: { lockedUntil: null, failedLoginCount: 0 },\n    select: { id: true, lockedUntil: true, failedLoginCount: true },\n  });\n}\n\n/**\n * FR-7/FR-12 sequencing dependency (see system-design.md Overview/Component\n * 20): PRD-01's real auth/session has not landed, so this is a stubbed\n * no-op behind the same placeholder convention requireRole.ts establishes.\n * Call sites (POST /api/users/:id/invite, createUser's sendInvite checkbox)\n * do not change when PRD-01 lands and makes this real.\n */\nexport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n  logger.info('sendInvite stub called (PRD-01 auth not landed yet)', { userId });\n  return { id: userId, inviteSentAt: new Date() };\n}\n=== eslintrc ===\n{\n  \"root\": true,\n  \"extends\": [\"next/core-web-vitals\", \"plugin:@typescript-eslint/recommended\"],\n  \"parser\": \"@typescript-eslint/parser\",\n  \"rules\": {\n    \"no-restricted-imports\": [\n      \"error\",\n      {\n        \"paths\": [\n          { \"name\": \"tailwindcss\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"name\": \"lucide-react\", \"message\": \"Use @mui/icons-material instead.\" },\n          { \"name\": \"next-themes\", \"message\": \"Use MUI cssVariables colorSchemes + useColorScheme() instead.\" },\n          { \"name\": \"@tanstack/react-table\", \"message\": \"Use the shared DataTable (MUI X DataGrid) instead.\" },\n          { \"name\": \"recharts\", \"message\": \"Use @mui/x-charts instead.\" },\n          { \"name\": \"react-select\", \"message\": \"Use MUI Autocomplete instead.\" },\n          { \"name\": \"react-datepicker\", \"message\": \"Use @mui/x-date-pickers instead.\" },\n          { \"name\": \"sonner\", \"message\": \"Use the shared useToast()/ToastProvider instead.\" },\n          { \"name\": \"notistack\", \"message\": \"Use the shared useToast()/ToastProvider instead.\" },\n          { \"name\": \"antd\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"name\": \"react-bootstrap\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" }\n        ],\n        \"patterns\": [\n          { \"group\": [\"@radix-ui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"group\": [\"@headlessui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"group\": [\"@fullcalendar/*\"], \"message\": \"Use @mui/x-scheduler (later PRD) instead.\" },\n          { \"group\": [\"@chakra-ui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" }\n        ]\n      }\n    ]\n  }\n}\n=== eslint test ===\nimport { describe, expect, it } from 'vitest';\nimport { ESLint } from 'eslint';\nimport eslintConfig from '../../.eslintrc.json';\n\nconst BANNED_NAMED_IMPORTS = [\n  'tailwindcss',\n  'lucide-react',\n  'next-themes',\n  '@tanstack/react-table',\n  'recharts',\n  'react-select',\n  'react-datepicker',\n  'sonner',\n  'notistack',\n  'antd',\n  'react-bootstrap',\n];\n\nconst BANNED_PATTERN_IMPORTS = [\n  '@radix-ui/react-dialog',\n  '@headlessui/react',\n  '@fullcalendar/core',\n  '@chakra-ui/react',\n];\n\ndescribe('no-restricted-imports (ADR-5: MUI-only)', () => {\n  const eslint = new ESLint({\n    useEslintrc: false,\n    baseConfig: { ...eslintConfig, extends: [] },\n    overrideConfig: { rules: { 'no-restricted-imports': eslintConfig.rules['no-restricted-imports'] } },\n  });\n\n  it.each([...BAN