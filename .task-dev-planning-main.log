{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0158zDH49A92ikaYRjHKJemB","type":"tool_result","content":"--- seed.ts ---\nimport { PrismaClient } from '@prisma/client';\n\nconst prisma = new PrismaClient();\n\n/**\n * Idempotent: upsert on the fixed \"singleton\" id, so re-running the seed\n * never creates a duplicate SchoolSettings row.\n */\nasync function main() {\n  await prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: {\n      id: 'singleton',\n      name: 'SchoolHub Academy',\n      shortName: 'SchoolHub',\n      timezone: 'America/New_York',\n      city: 'Springfield',\n      country: 'USA',\n      phone: '+1 555 0100',\n      email: 'office@schoolhub.test',\n    },\n  });\n\n  const year = await prisma.academicYear.upsert({\n    where: { name: '2026-2027' },\n    update: { isCurrent: true },\n    create: {\n      name: '2026-2027',\n      startDate: new Date('2026-08-17'),\n      endDate: new Date('2027-06-11'),\n      isCurrent: true,\n    },\n  });\n\n  const semesters: { name: string; startDate: string; endDate: string; order: number }[] = [\n    { name: 'Semester 1', startDate: '2026-08-17', endDate: '2027-01-15', order: 1 },\n    { name: 'Semester 2', startDate: '2027-01-18', endDate: '2027-06-11', order: 2 },\n  ];\n  for (const term of semesters) {\n...\n    { name: 'Grade 7', shortName: 'G7', order: 2 },\n    { name: 'Grade 8', shortName: 'G8', order: 3 },\n  ];\n  for (const grade of gradeLevels) {\n    await prisma.gradeLevel.upsert({ where: { name: grade.name }, update: {}, create: grade });\n  }\n\n  const subjects = [\n    { name: 'Mathematics', code: 'MATH', color: '#4F46E5' },\n    { name: 'English Language Arts', code: 'ELA', color: '#0EA5E9' },\n    { name: 'Science', code: 'SCI', color: '#16A34A' },\n    { name: 'Social Studies', code: 'SOC', color: '#D97706' },\n    { name: 'Physical Education', code: 'PE', color: '#DC2626' },\n    { name: 'Art', code: 'ART', color: '#9333EA' },\n  ];\n  for (const subject of subjects) {\n    await prisma.subject.upsert({ where: { code: subject.code }, update: {}, create: subject });\n  }\n\n  const rooms = [\n    { name: 'Room 101', building: 'Main Building', capacity: 30 },\n    { name: 'Room 102', building: 'Main Building', capacity: 28 },\n    { name: 'Science Lab A', building: 'Science Wing', capacity: 24 },\n    { name: 'Gymnasium', building: 'Athletics Building', capacity: 120 },\n    { name: 'Art Studio', building: 'Main Building', capacity: 20 },\n  ];\n  for (const room of rooms) {\n    await prisma.room.upsert({ where: { name: room.name }, update: {}, create: room });\n  }\n}\n\nmain()\n  .then(async () => {\n    await prisma.$disconnect();\n  })\n  .catch(async (error) => {\n    console.error(error);\n    await prisma.$disconnect();\n    process.exit(1);\n  });\n--- ParentStudentLink model ---\n73:  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")\n74:  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")\n75-\n76-  @@index([lastName, firstName, email])\n77-}\n78-\n79-/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n80-/// only -- enforced in the service layer (src/server/services/users.ts,\n81-/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\n82-model StudentProfile {\n83-  userId           String     @id\n84-  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n85-  admissionNumber  String     @unique\n86-  dateOfBirth      DateTime   @db.Date\n87-  gender           Gender     @default(UNDISCLOSED)\n88-  gradeLevelId     String\n89-  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n90-  enrollmentDate   DateTime   @db.Date\n91-  addressLine1     String?\n92-  city             String?\n93-  medicalNotes     String?\n94-  emergencyContact String?\n--\n120:model ParentStudentLink {\n121-  id           String               @id @defa