t through the `mui-mcp` docs server before writing UI code, and stop if it can't reach it.\n- **Stale files from SH-6:** they're still in `artifacts/dev/`, `artifacts/qa/` and `artifacts/ui-verification/`. The later phases will need to regenerate them.","ttft_ms":2708,"type":"result","duration_ms":89866,"uuid":"68f6abb5-0236-4fe9-9e19-2909a6656ca6","ttft_stream_ms":1840,"time_to_request_ms":119,"first_content_frame_ms":1840,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":16,"outputTokens":10083,"cacheReadInputTokens":320492,"cacheCreationInputTokens":53908,"webSearchRequests":0,"costUSD":0.6970864,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1531,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":53908,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
