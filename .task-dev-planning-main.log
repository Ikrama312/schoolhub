dit log/My children)\n    student-tabs.ts                     (MODIFY — register Overview tab)\n\n  app/\n    api/\n      users/\n        route.ts                        (CREATE — GET list, POST create)\n        [id]/\n          route.ts                      (CREATE — GET detail, PATCH update)\n          invite/route.ts               (CREATE)\n          unlock/route.ts               (CREATE)\n          status/route.ts               (CREATE)\n          archive/route.ts              (CREATE)\n          restore/route.ts              (CREATE)\n        import/route.ts                 (CREATE)\n        export/route.ts                 (CREATE)\n        search/route.ts                 (CREATE)\n      students/\n        [id]/\n          route.ts                      (CREATE — GET student detail)\n          parents/\n            route.ts                    (CREATE — POST link)\n            [parentId]/route.ts         (CREATE — DELETE unlink)\n      me/\n        children/route.ts               (CREATE)\n        profile/route.ts                (CREATE)\n      audit-logs/\n        route.ts                        (CREATE)\n\n    (app)/\n      shell.tsx                         (MODIFY — wire Profile menu item)\n      admin/\n        users/\n          page.tsx                      (CREATE — list, filters, row/bulk actions)\n          new/page.tsx                  (CREATE)\n          [id]/\n            page.tsx                    (CREATE — detail)\n            edit/page.tsx               (CREATE)\n          UserFormStepper.tsx           (CREATE — shared create/edit stepper)\n          import/page.tsx               (CREATE)\n        audit-log/\n          page.tsx                      (CREATE)\n      students/\n        [studentId]/page.tsx            (CREATE)\n      my-children/\n        page.tsx                        (CREATE)\n      account/\n        profile/page.tsx                (CREATE)\n\ntests/\n  unit/\n    userValidators.test.ts              (CREATE)\n    userNumberGenerator