{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Zcw7Qs3Kdt2MZmgCKTmYD","type":"tool_result","content":"'use client';\n\nimport { useEffect, useMemo, useState } from 'react';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport TextField from '@mui/material/TextField';\nimport Box from '@mui/material/Box';\nimport Typography from '@mui/material/Typography';\nimport CircularProgress from '@mui/material/CircularProgress';\nimport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\nimport type { Role } from '@/config/navigation';\n\nexport interface UserPickerOption {\n  id: string;\n  name: string;\n  email: string;\n  role: Role;\n}\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface UserPickerProps {\n  label: string;\n  /** Restrict search to a single role (e.g. \"PARENT\" when linking a student's family). */\n  role?: Role;\n  multiple?: boolean;\n  value: UserPickerOption[] | UserPickerOption | null;\n  onChange: (value: UserPickerOption[] | UserPickerOption | null) => void;\n  helperText?: string;\n  error?: boolean;\n}\n\n/**\n * Reusable directory picker (FR-28) on MUI Autocomplete: async search\n * against GET /api/users/search, optional multi-select, avatar+name+role\n * renderOption. Used for inline parent/student linking in the create/edit\n * Stepper and the student detail page's Family card.\n */\nexport function UserPicker({ label, role, multiple, value, onChange, helperText, error }: UserPickerProps) {\n  const [inputValue, setInputValue] = useState('');\n  const [options, setOptions] = useState<UserPickerOption[]>([]);\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    const handle = setTimeout(async () => {\n      setLoading(true);\n      try {\n        const params = new URLSearchParams();\n        if (role) params.set('role', role);\n        if (inputValue) params.set('q', inputValue);\n        const res = await fetch(`/api/users/search?${params.toString()}`);\n        const json = await res.json();\n        setOptions(res.ok ? json.data : []);\n      } catch {\n        setOptions([]);\n      } finally {\n        setLoading(false);\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n  }, [inputValue, role]);\nimport { z } from 'zod';\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { listUsers } from '@/server/services/users';\nimport { ROLE_VALUES } from '@/lib/validators/users';\n\nconst querySchema = z.object({\n  role: z.enum(ROLE_VALUES).optional(),\n  q: z.string().optional(),\n});\n\nconst SEARCH_ROW_CAP = 20;\n\n/** GET /api/users/search — ADMIN/TEACHER only, picker search (FR-28). Excludes archived, capped to 20 rows. */\nexport const GET = withHandler(async (request: Request) => {\n  requireRole('ADMIN', 'TEACHER');\n\n  const url = new URL(request.url);\n  const query = parseQuery(url.searchParams, querySchema);\n\n  const { rows } = await listUsers(\n    { role: query.role ? [query.role] : undefined, q: query.q, includeArchived: false },\n    { skip: 0, take: SEARCH_ROW_CAP },\n  );\n\n  return ok(\n    rows.map((row) => ({\n      id: row.id,\n      name: `${row.firstName} ${row.lastName}`,\n      email: row.email,\n      role: row.role,\n    })),\n  );\n});\n\n  const toggleCollapsed = () => {\n    setCollapsed((prev) => {\n      const next = !prev;\n      window.localStorage.setItem(COLLAPSE_STORAGE_KEY, String(next));\n      return next;\n    });\n  };\n\n  const drawerWidth = collapsed ? DRAWER_WIDTH_COLLAPSED : DRAWER_WIDTH_EXPANDED;\n  const items = navigationForRole(PLACEHOLDER_USER.role);\n\n  const navList = (\n    <List sx={{ pt: 1 }}>\n      {items.map((item) => {\n        const Icon = item.icon;\n        const active = pathname === item.href || pathname.startsWith(`${item.href}/`);\n        const button = (\n          <ListItemButton\n            key={item.href}\n            component={Link}\n            href={item.href}\n            selected={active}\n            onClick={() => setMobileOpen(false)}\n            sx={{ justifyContent: collapsed && isDesktop ? 'center' : 'flex-start' }}\n          >\n            <ListItemIcon sx={{ minWidth: collapsed && isDesktop ? 0 : 40, justifyContent: 'center' }}>\n              <Icon />\n            </ListItemIcon>\n            {!(collapsed && isDesktop) && <ListItemText primary={item.label} />}\n          </ListItemButton>\n        );\n        return collapsed && isDesktop ? (\n          <Tooltip key={item.href} title={item.label} placement=\"right\">\n            {button}\n          </Tooltip>\n        ) : (\n          button\n        );\n      })}\n    </List>\n  );\n\n  return (\n    <Box sx={{ display: 'flex', minHeight: '100vh' }}>\n      <AppBar\n        position=\"fixed\"\n        sx={{\n          zIndex: (t) => t.zIndex.drawer + 1,\n          ...(isDesktop\n            ? { width: `calc(100% - ${drawerWidth}px)`, ml: `${drawerWidth}px` }\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}'],\n  },\n});\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id              String           @id @default(cuid())\n  name            String           @unique\n  shortName       String           @unique\n  order           Int              @unique\n  archivedAt      DateTime?\n  createdAt       DateTime         @default(now())\n  updatedAt       DateTime         @updatedAt\n  studentProfiles StudentProfile[]\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n\n/// In-app notification (PRD-04 FR-1). type is a key from the compile-time\n/// registry (src/server/notifications/types.ts) rather than an enum/FK, so\n/// later PRDs register new keys without a migration. category is resolved\n/// from the registry at read time (src/server/notifications/list.ts), not\n/// stored here. The composite index backs both getUnreadCount() (NFR-3,\n/// <50ms) and listNotifications()'s own-rows-newest-first query.","is_error":false}]},"parent_tool_use_id":null,"session_id":"663c6c96-740a-404e-b9ed-7275dd3841b6","uuid":"e693f4d6-4dea-426e-a19d-cde3020a857a","timestamp":"2026-10-27T16:34:56.540Z","tool_use_result":{"stdout":"'use client';\n\nimport { useEffect, useMemo, useState } from 'react';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport TextField from '@mui/material/TextField';\nimport Box from '@mui/material/Box';\nimport Typography from '@mui/material/Typography';\nimport CircularProgress from '@mui/material/CircularProgress';\nimport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\nimport type { Role } from '@/config/navigation';\n\nexport interface UserPickerOption {\n  id: string;\n  name: string;\n  email: string;\n  role: Role;\n}\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface UserPickerProps {\n  label: string;\n  /** Restrict search to a single role (e.g. \"PARENT\" when linking a student's family). */\n  role?: Role;\n  multiple?: boolean;\n  value: UserPickerOption[] | UserPickerOption | null;\n  onChange: (value: UserPickerOption[] | UserPickerOption | null) => void;\n  helperText?: string;\n  error?: boolean;\n}\n\n/**\n * Reusable directory picker (FR-28) on MUI Autocomplete: async search\n * against GET /api/users/search, optional multi-select, avatar+name+role\n * renderOption. Used for inline parent/student linking in the create/edit\n * Stepper and the student detail page's Family card.\n */\nexport function UserPicker({ label, role, multiple, value, onChange, helperText, error }: UserPickerProps) {\n  const [inputValue, setInputValue] = useState('');\n  const [options, setOptions] = useState<UserPickerOption[]>([]);\n  const [