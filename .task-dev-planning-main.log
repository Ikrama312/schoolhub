{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XEgDJgRxFQSnDyEhGiLV1B","type":"tool_result","content":"import { z } from 'zod';\n\n/**\n * Fail-fast env validation. Runs once at module load (startup boundary) —\n * anything importing this module gets a readable error naming every\n * missing/invalid variable instead of an undefined-at-runtime surprise.\n */\nconst envSchema = z.object({\n  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n  APP_URL: z.string().min(1, 'APP_URL is required'),\n  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n\n  // Email (PRD-04). EMAIL_TRANSPORT defaults to 'console' so dev/test never\n  // need real SMTP creds; the smtp branch (src/server/email/transport.ts)\n  // only reads SMTP_*/EMAIL_FROM when EMAIL_TRANSPORT='smtp'.\n  EMAIL_TRANSPORT: z.enum(['smtp', 'console']).default('console'),\n  SMTP_HOST: z.string().optional(),\n  SMTP_PORT: z.coerce.number().int().optional(),\n  SMTP_USER: z.string().optional(),\n  SMTP_PASS: z.string().optional(),\n  SMTP_SECURE: z.coerce.boolean().optional(),\n  EMAIL_FROM: z.string().optional(),\n  // Bearer token for POST /api/internal/email/dispatch (NFR-8). Optional so\n  // existing .env files don't break; left unset, the route rejects every\n  // request (fail-safe, not fail-open).\n  CRON_SECRET: z.string().optional(),\n});\n\nfunction loadEnv() {\n  const parsed = envSchema.safeParse(process.env);\n  if (!parsed.success) {\n    const issues = parsed.error.issues\n      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n      .join('\\n');\n    throw new Error(`Invalid environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\n# Postgres connection string used by Prisma. Matches docker-compose.yml's\n# schoolhub/schoolhub/schoolhub db/user/password on localhost:5432.\nDATABASE_URL=\"postgresql://schoolhub:schoolhub@localhost:5432/schoolhub?schema=public\"\n\n# Public base URL of the app (used for absolute links, e.g. in emails later).\nAPP_URL=\"http://localhost:3000\"\n\n# Secret used to sign auth sessions (wired up by a later PRD). Generate with\n# `openssl rand -base64 32` for real environments.\nAUTH_SECRET=\"dev-secret-change-me\"\n\n# Standard Node environment flag. One of: development | test | production.\nNODE_ENV=\"development\"\n\n# Outbound email (PRD-04). \"console\" (default) logs subject/recipient/text\n# instead of sending — fine for dev/test. Switch to \"smtp\" and fill in the\n# SMTP_* vars below for a real mail server.\nEMAIL_TRANSPORT=\"console\"\nSMTP_HOST=\"\"\nSMTP_PORT=\"587\"\nSMTP_USER=\"\"\nSMTP_PASS=\"\"\nSMTP_SECURE=\"false\"\nEMAIL_FROM=\"SchoolHub <no-reply@schoolhub.test>\"\n\n# Bearer token POST /api/internal/email/dispatch requires in its\n# Authorization header. Generate with `openssl rand -base64 32` for real\n# environments.\nCRON_SECRET=\"dev-secret-change-me\"\nsrc/app/forbidden:\npage.tsx\n\nsrc/components/Toast:\nToastProvider.tsx\nuseToast.ts\n\nsrc/components/UserAvatar:\nUserAvatar.tsx\nsrc/app/api/users/[id]/invite/route.ts:4:import { sendInvite } from '@/server/services/users';\nsrc/app/api/users/[id]/invite/route.ts:9:  const result = await sendInvite(params.id);\nsrc/app/api/users/import/route.ts:11:  sendInvites: z.boolean().default(false),\nsrc/app/api/users/import/route.ts:30:  const summary = await importUsers(input.type, input.rows, input.sendInvites);\nsrc/server/services/userImport.ts:6:import { sendInvite } from '@/server/services/users';\nsrc/server/services/userImport.ts:170:export async function importUsers(type: ImportType, rows: unknown[], sendInvites: boolean): Promise<ImportSummary> {\nsrc/server/services/userImport.ts:224:  if (sendInvites) {\nsrc/server/services/userImport.ts:225:    await Promise.all(allCreatedUserIds.map((id) => sendInvite(id)));\nsrc/server/services/users.ts:164:  if (input.sendInvite) {\nsrc/server/services/us