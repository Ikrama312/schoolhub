er) is reused as-is per NFR-9.\n>\n> **Gap note:** `requireRole()` and `audit()` are assumed \"existing\" by the\n> PRD, but PRD-01 (ticket abcd-2)'s dev phase never landed them in `src/`\n> (confirmed: no `src/server/auth*`, no `auth.ts`, `AppShell` still uses a\n> `PLACEHOLDER_USER`). TASK-2 adds minimal, single-chokepoint stand-ins\n> consistent with that existing placeholder pattern so every write endpoint\n> has one real place to swap in PRD-01's real session once it lands —\n> not a parallel auth system.\n\n```\nprisma/\n  schema.prisma                                  (MODIFY — add AcademicYear, Term, GradeLevel, Subject, Room)\n  seed.ts                                         (MODIFY — seed academic year/terms/grade levels/subjects/rooms)\n\nsrc/\n  server/\n    auth/\n      requireRole.ts                              (NEW — single role-check chokepoint)\n    audit.ts                                      (NEW — AuditLog insert helper)\n    services/\n      dateRange.ts                                (NEW — shared overlap/range validation)\n      academicYears.ts                             (NEW)\n      terms.ts                                     (NEW)\n      settings.ts                                  (NEW)\n      gradeLevels.ts                                (NEW)\n      subjects.ts                                  (NEW)\n      rooms.ts                                      (NEW)\n\n  app/\n    api/\n      settings/school/route.ts                     (NEW — GET/PATCH)\n      academic-years/\n        route.ts                                   (NEW — GET/POST)\n        [id]/\n          route.ts                                  (NEW — PATCH/DELETE)\n          set-current/route.ts                      (NEW — POST)\n          terms/\n            route.ts                                (NEW — POST)\n            generate/route.ts                        (NEW — POST)\n      terms/\n        [id]/route.ts                               (NEW — PATCH/DELETE)\n        reorder/route.ts                             (NEW — POST)\n      grade-levels/\n        route.ts                                     (NEW — GET/POST)\n        [id]/route.ts                                (NEW — PATCH)\n      subjects/\n        route.ts                                     (NEW — GET/POST)\n        [id]/route.ts                                (NEW — PATCH)\n      rooms/\n        route.ts                                     (NEW — GET/POST)\n        [id]/route.ts                                (NEW — PATCH)\n\n    (app)/\n      shell.tsx                                      (MODIFY — render \"Administration\" group header)\n      admin/\n        layout.tsx                                   (NEW — mounts NoCurrentYearBanner on every admin page)\n        settings/school/\n          page.tsx                                    (NEW)\n          SchoolSettingsForm.tsx                       (NEW)\n        academic-years/\n          page.tsx                                     (NEW — list)\n          AcademicYearDialog.tsx                        (NEW — create/edit)\n          [id]/\n            page.tsx                                    (NEW — detail: terms list)\n            TermDialog.tsx                                (NEW — create/edit term)\n            GenerateTermsDialog.tsx                        (NEW — semesters/trimesters/quarters)\n        grade-levels/\n          page.tsx                                       (NEW)\n          GradeLevelDialog.tsx                            (NEW)\n        subjects/\n          page.tsx                                        (NEW)\n          SubjectDialog.tsx                                (NEW)\n          subjectColors.ts                                 (NEW — 12-swatch palette constants)\n        rooms/\n          page.tsx                                         (NEW)\n          RoomDialog.tsx                                    (NEW)\n\n  components/\n    NoCurrentYearBanner/NoCurrentYearBanner.tsx          (NEW)\n\n  config/\n    navigation.ts                                        (MODIFY — add Administration group + 5 items)\n\ntests/\n  unit/\n    dateRange.test.ts                                     (NEW)\n    terms.test.ts                                          (NEW)\n    subjects.test.ts                                        (NEW)\n    academicYears.integration.test.ts                       (NEW — set-current tx, delete-in-use conflict)\n  e2e/\n    academic-structure.spec.ts                              (NEW)\n```\n","userModified":false}}
