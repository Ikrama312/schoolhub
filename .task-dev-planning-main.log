{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013vP5eoboVzD3p2x9W2LDku","type":"tool_result","content":"1\t{\n2\t  \"ticketId\": \"abcd-04\",\n3\t  \"timestamp\": \"2026-10-19T15:10:00Z\",\n4\t  \"phase\": \"architect\",\n5\t  \"version\": \"1.0\",\n6\t\n7\t  \"note\": \"Derived from system-design.md's Component Breakdown/Data Flow (abcd-04, Components 3/8/11/15/16/17) and the source PRD's explicit API table (04-notifications.md, section 'API'), which fully specifies method/path/role/body for all 11 endpoints (the table's 'POST /api/notifications/:id/read · /unread' row is two endpoints). Two items carried forward, unresolved here because they are sequencing/confirmation items for dev-planning, not contract-shape questions: (1) every non-ADMIN, non-CRON_SECRET endpoint below calls requireRole(...ALL_ROLES) as the stand-in for a real requireUser() per system-design.md's Overview/Component 12 finding — src/server/auth/permissions.ts does not exist yet (only requireRole.ts's ADMIN-placeholder does), so 'own notifications only' / 'own preferences only' scoping is written against the request's userId param today and must be swapped to the real session identity when PRD-01 lands, not re-derived; (2) list/count responses use the real paginated()/ok() shapes from src/server/http.ts (data + nested meta for lists), confirmed directly against src/server/http.ts and existing routes (src/app/api/users/route.ts, src/app/api/audit-logs/route.ts) rather than assumed.\",\n8\t\n9\t  \"conventions\": {\n10\t    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n11\t    \"listEnvelope\": { \"data\": \"[...]\", \"meta\": { \"page\": 1, \"pageSize\": 20, \"total\": 0 } },\n12\t    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n13\t    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\", \"INVALID_TOKEN (410)\"],\n14\t    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100), per src/server/http.ts parsePagination()\",\n15\t    \"auth\": \"Own-row routes call requireRole(...ALL_ROLES) (placeholder for PRD-01's requireUser(); see note). ADMIN-only routes call requireRole('ADMIN') directly — already real today. POST /api/internal/email/dispatch checks Authorization: Bearer ${CRON_SECRET} itself, not requireRole.\",\n16\t    \"security\": \"Notification.link values are validated server-side as '/'-prefixed relative paths before any write that sets them (NFR-5); this is a notify()-time invariant, not re-validated at the read endpoints below.\"\n17\t  },\n18\t\n19\t  \"endpoints\": [\n20\t    {\n21\t      \"method\": \"GET\",\n22\t      \"path\": \"/api/notifications\",\n23\t      \"description\": \"Any role. Own notifications only (userId scoped server-side). Backs both the /notifications page (paginated, filterable) and, with pageSize=10 and no filters, the bell popover's recent-10 list — one implementation (Component 11), not two query paths.\",\n24\t      \"requestSchema\": { \"unread\": \"boolean?\", \"category\": \"\\\"ACCOUNT\\\"|\\\"ACADEMIC\\\"|\\\"ATTENDANCE\\\"|\\\"COMMUNICATION\\\"|\\\"FINANCE\\\"|\\\"SYSTEM\\\"?\", \"page\": \"int? (default 1)\", \"pageSize\": \"int? (default 20, max 100)\" },\n25\t      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"type\": \"string\", \"category\": \"string\", \"title\": \"string\", \"body\": \"string|null\", \"link\": \"string|null\", \"readAt\": \"datetime|null\", \"createdAt\": \"datetime\" } ], \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n26\t      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n27\t    },\n28\t    {\n29\t      \"method\": \"GET\",\n30\t      \"path\": \"/api/notifications/unread-count\",\n31\t      \"description\": \"Any role. Own count only. Backed by the Notification(userId, readAt, createdAt) composite index; must respond under 50ms (NFR-3). Polled by the bell every 30s while the tab is visible.\",\n32\t      \"requestSchema\": {},\n33\t      \"responseSchema\": { \"data\": { \"count\": \"int\" } },\n34\t      \"requirementIds\": [\"FR-14\", \"FR-21\", \"NFR-3\", \"NFR-7\"]\n35\t    },\n36\t    {\n37\t      \"method\": \"POST\",\n38\t      \"path\": \"/api/notifications/:id/read\",\n39\t      \"description\": \"Owner only (the notification's userId must match the caller). Sets readAt=now if not already set; idempotent. NOT_FOUND if the id doesn't belong to the caller (never reveals another user's notification exists).\",\n40\t      \"requestSchema\": {},\n41\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"readAt\": \"datetime\" } },\n42\t      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n43\t    },\n44\t    {\n45\t      \"method\": \"POST\",\n46\t      \"path\": \"/api/notifications/:id/unread\",\n47\t      \"description\": \"Owner only. Clears readAt. Same ownership/NOT_FOUND rule as /read.\",\n48\t      \"requestSchema\": {},\n49\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"readAt\": null } },\n50\t      \"requirementIds\": [\"FR-16\", \"FR-21\", \"NFR-7\"]\n51\t    },\n52\t    {\n53\t      \"method\": \"POST\",\n54\t      \"path\": \"/api/notifications/read-all\",\n55\t      \"description\": \"Any role. Sets readAt=now on every unread Notification row owned by the caller in one update.\",\n56\t      \"requestSchema\": {},\n57\t      \"responseSchema\": { \"data\": { \"updated\": \"int\" } },\n58\t      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n59\t    },\n60\t    {\n61\t      \"method\": \"GET\",\n62\t      \"path\": \"/api/me/notification-preferences\",\n63\t      \"description\": \"Any role. Merges NOTIFICATION_TYPES registry entries visible to the caller's role with the caller's existing NotificationPreference rows (registry defaultEmail/mandatoryInApp used where no row exists).\",\n64\t      \"requestSchema\": {},\n65\t      \"responseSchema\": { \"data\": [ { \"type\": \"string\", \"label\": \"string\", \"description\": \"string\", \"category\": \"string\", \"inApp\": \"boolean\", \"email\": \"boolean\", \"mandatoryInApp\": \"boolean\" } ] },\n66\t      \"requirementIds\": [\"FR-18\", \"FR-21\", \"NFR-7\"]\n67\t    },\n68\t    {\n69\t      \"method\": \"PUT\",\n70\t      \"path\": \"/api/me/notification-preferences\",\n71\t      \"description\": \"Any role. Upserts one {type, inApp, email} preference row for the caller. Rejects inApp=false for mandatoryInApp types with VALIDATION_ERROR before any write (FR-22) — defense in depth alongside the disabled UI switch.\",\n72\t      \"requestSchema\": { \"type\": \"string (must exist in NOTIFICATION_TYPES)\", \"inApp\": \"boolean\", \"email\": \"boolean\" },\n73\t      \"responseSchema\": { \"data\": { \"type\": \"string\", \"inApp\": \"boolean\", \"email\": \"boolean\" } },\n74\t      \"requirementIds\": [\"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"NFR-7\"]\n75\t    },\n76\t    {\n77\t      \"method\": \"POST\",\n78\t      \"path\": \"/api/internal/email/dispatch\",\n79\t      \"description\": \"Requires header Authorization: Bearer ${CRON_SECRET}; mismatch or missing header returns 401 UNAUTHENTICATED via the standard error envelope (NFR-8), checked before any other work. On success: recovers stuck SENDING rows (>10min), claims up to batchSize PENDING rows via FOR UPDATE SKIP LOCKED, sends each, applies the retry backoff on failure, and runs the once-per-day purge.\",\n80\t      \"requestSchema\": { \"batchSize\": \"int? (default 50)\" },\n81\t      \"responseSchema\": { \"data\": { \"sent\": \"int\", \"failed\": \"int\", \"retried\": \"int\" } },\n82\t      \"requirementIds\": [\"FR-10\", \"FR-11\", \"FR-12\", \"FR-17\", \"FR-21\", \"NFR-4\", \"NFR-8\"]\n83\t    },\n84\t    {\n85\t      \"method\": \"GET\",\n86\t      \"path\": \"/api/admin/email-log\",\n87\t      \"de