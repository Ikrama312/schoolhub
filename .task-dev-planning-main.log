61\t\n62\t/**\n63\t * Wraps a route handler, mapping thrown errors to the shared envelope:\n64\t * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n65\t * AppError -> its own code/status\n66\t * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n67\t * anything else -> INTERNAL (500), stack logged, never returned to client\n68\t */\n69\texport function withHandler<Args extends unknown[]>(\n70\t  fn: (...args: Args) => Promise<Response>,\n71\t) {\n72\t  return async (...args: Args): Promise<Response> => {\n73\t    try {\n74\t      return await fn(...args);\n75\t    } catch (error) {\n76\t      if (error instanceof ZodError) {\n77\t        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n78\t      }\n79\t\n80\t      if (error instanceof AppError) {\n81\t        return apiError(error.code, error.message, error.details);\n82\t      }\n83\t\n84\t      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n85\t        if (error.code === 'P2002') {\n86\t          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n87\t        }\n88\t        if (error.code === 'P2025') {\n89\t          return apiError('NOT_FOUND', 'Resource not found');\n90\t        }\n91\t      }\n92\t\n93\t      logger.error('Unhandled error in route handler', {\n94\t        message: error instanceof Error ? error.message : String(error),\n95\t        stack: error instanceof Error ? error.stack : undefined,\n96\t      });\n97\t      return apiError('INTERNAL', 'Internal server error');\n98\t    }\n99\t  };\n100\t}\n101\t\n102\texport interface PaginationParams {\n103\t  page: number;\n104\t  pageSize: number;\n105\t  skip: number;\n106\t  take: number;\n107\t}\n108\t\n109\tconst MAX_PAGE_SIZE = 100;\n110\t\n111\texport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n112\t  const rawPage = Number(searchParams.get('page'));\n113\t  const rawPageSize = Number(searchParams.get('pageSize'));\n114\t\n115\t  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n116\t  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n117\t  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n118\t\n119\t  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n120\t}\n121\t\n122\texport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n123\t  const json = await request.json().catch(() => ({}));\n124\t  return schema.parse(json);\n125\t}\n126\t\n127\texport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n128\t  return schema.parse(Object.fromEntries(searchParams.entries()));\n129\t}\n130\t"}]},"parent_tool_use_id":null,"session_id":"dd056bf4-3785-420e-8a1f-0c3d146fa266","uuid":"a2c9dc09-91f1-4593-8b43-9e43f390ff7a","timestamp":"2026-10-19T08:21:33.632Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/http.ts","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\nexport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\nexport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\n","numLines":130,"startLine":1,"totalLines":130}}}
