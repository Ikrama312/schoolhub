er\",\"src/components/EmptyState\",\"src/components/DataTable\",\"src/components/Toast\",\"src/server/notifications\",\"src/server/auth\",\"src/lib/validators\",\"src/lib/dates.ts\"]),\n (\"tests\",[\"src/server/notifications\",\"src/server/email\",\"src/lib/validators\"]),\n]\ndef w(name,obj): json.dump(obj,open(os.path.join(out,name),\"w\"),indent=2); open(os.path.join(out,name),\"a\").write(\"\\n\")\nw(\"module-dependencies.json\",{**hdr(),\"modules\":[{\"name\":n,\"dependsOn\":d} for n,d in mods]})\nw(\"file-ownership-matrix.json\",{**hdr(),\"entries\":entries})\nfs={}\nfor p in seen:\n    d,f=os.path.split(p); fs.setdefault(d+\"/\",[]).append(f)\nw(\"implementation-plan.json\",{**hdr(),\"tasks\":plan_tasks,\"fileStructure\":{k:sorted(v) for k,v in sorted(fs.items())},\n  \"totalEstimateHours\":sum(t[\"estimateHours\"] for t in plan_tasks),\"nxpPatterns\":[],\n  \"notes\":[\"Preconditions for dev: mui-mcp (useMuiDocs → fetchDocs) must be reachable before UI tasks TASK-14..17 (NFR-10 hard stop).\",\n           \"Migration directory name is fixed to 20261104120000_notifications_email so the ownership matrix path is exact.\",\n           \"No new dependencies; schema.prisma, env.ts, .env.example, navigation.ts and package.json stay untouched.\",\n           \"Replaces stale abcd-1 dev-planning artifacts.\"],\n  \"status\":\"complete\"})\nEOF\ncd /Users/ikramaansari/Documents/forge/schoolhub-prds && python3 -I /tmp/sh4plan/gen.py artifacts/dev-planning && python3 -c \"\nimport json;[json.load(open('artifacts/dev-planning/'+f)) for f in ['implementation-plan.json','file-ownership-matrix.json','module-dependencies.json']];p=json.load(open('artifacts/dev-planning/implementation-plan.json'));print(len(p['tasks']),p['totalEstimateHours'])\"","description":"Generate and validate dev-planning JSON artifacts"}}}
