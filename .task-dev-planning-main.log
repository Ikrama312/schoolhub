server/services\",\"src/server/rate-limit\",\"prisma/schema.prisma\"]},\n {\"name\":\"tests/e2e\",\"dependsOn\":[\"tests/e2e/helpers\",\"prisma/seed.ts\",\"src/app/(auth)\",\"src/app/(app)\"]},\n]\ntree = \"\"\"# File Structure — SH-1 (PRD-01 Auth, Sessions & RBAC)\n\nBrownfield. Only the files marked NEW/MOD are touched. Everything under `src/server/`, `src/app/api/`,\n`src/middleware.ts`, `src/config/public-routes.ts`, `src/lib/validators/auth.ts` and\n`src/components/PasswordChecklist/` stays **untouched** (NFR-13).\n\n```\nprisma/\n├── schema.prisma                                   MOD  TASK-1  (+@@index([role, status]) on User)\n├── seed.ts                                         MOD  TASK-2  (6 ACTIVE + 1 INVITED user)\n└── migrations/\n    └── 20261106000000_user_role_status_index/\n        └── migration.sql                           NEW  TASK-1\nsrc/app/\n├── (auth)/                                         (layout.tsx exists: Card + Container)\n│   ├── login/\n│   │   ├── page.tsx                                NEW  TASK-3\n│   │   └── LoginForm.tsx                           NEW  TASK-3  (exports loginErrorMessage)\n│   ├── forgot-password/\n│   │   └── page.tsx                                NEW  TASK-5  ('use client')\n│   ├── reset-password/[token]/\n│   │   ├── page.tsx                                NEW  TASK-6  (server: verifyToken)\n│   │   └── ResetClient.tsx                         NEW  TASK-6\n│   └── invite/[token]/\n│       ├── page.tsx                                NEW  TASK-7  (server: verifyToken)\n│       └── InviteClient.tsx                        NEW  TASK-7\n└── (app)/\n    ├── layout.tsx                                  MOD  TASK-8  (requirePageUser → AppShell user)\n    ├── shell.tsx                                   MOD  TASK-8  (PLACEHOLDER_USER removed, signOut)\n    └── account/security/\n        ├── page.tsx                                NEW  TASK-9\n        └── ChangePasswordForm.tsx                  NEW  TASK-9\ntests/\n├── unit/login-error-message.test.ts                NEW  TASK-4\n├── integration/\n│   ├── auth-authorize.test.ts                      NEW  TASK-10\n│   ├── auth-accept-invite.test.ts                  NEW  TASK-11\n│   ├── auth-reset-password.test.ts                 NEW  TASK-11\n│   └── auth-change-password.test.ts                NEW  TASK-12\n└── e2e/\n    ├── helpers/auth.ts                             NEW  TASK-13 (signInAs)\n    ├── dashboard.spec.ts                           MOD  TASK-13\n    └── auth.spec.ts                                NEW  TASK-14\n```\n\nNotes for dev:\n- `ResetClient.tsx` and `InviteClient.tsx` exist because `SetPasswordForm` takes an `onSubmit` callback, which a Server Component cannot pass.\n- The confirm field is `confirm`, not `confirmPassword`. `INVALID_TOKEN` is HTTP 410 (api-contracts designCorrections).\n- NFR-6 gate: look up every MUI component through mui-mcp (`useMuiDocs` → `fetchDocs`, @mui/material@9.5.0) before writing JSX. If it is unreachable, stop and report.\n\"\"\"\nopen(D+\"file-structure.md\",\"w\").write(tree)\njson.dump({**hdr(),\"modules\":mods},open(D+\"module-dependencies.json\",\"w\"),indent=2)\njson.dump({**hdr(),\"entries\":[{\"path\":p,\"taskId\":t[0],\"operation\":op} for t in tasks for p,op in t[2]]},open(D+\"file-ownership-matrix.json\",\"w\"),indent=2)\nplan = {\"ticketId\":TID,\"version\":\"1.0\",\"timestamp\":TS,\"phase\":\"dev-planning\",\n \"tasks\":[{\"id\":t,\"description\":d,\"files\":[p for p,_ in f],\"dependencies\":dp,\"estimateHours\":h,\"requirementIds\":r} for t,d,f,dp,h,r in tasks],\n \"fileStructure\":fs,\"totalEstimateHours\":sum(t[4] for t in tasks),\"nxpPatterns\":[],\"status\":\"complete\"}\njson.dump(plan,open(D+\"implementation-plan.json\",\"w\"),indent=2)\nprint(\"tasks\",len(tasks),\"files\",len(paths),\"hours\",plan[\"totalEstimateHours\"])\nEOF\npython3 -I /tmp/sh1plan/gen.py","description":"Generate and validate all dev-planning artifacts"},"caller":{"type":"direct"}}],"container":nul