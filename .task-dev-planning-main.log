{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FpzTy4Q4gfQh6s8XUtbYx9","type":"tool_result","content":"1\timport { NextResponse } from 'next/server';\n2\timport { Prisma } from '@prisma/client';\n3\timport { ZodError, type ZodSchema } from 'zod';\n4\timport { logger } from '@/lib/logger';\n5\t\n6\t/**\n7\t * The one chokepoint every route handler goes through. Nothing here should\n8\t * be reimplemented per-route — new endpoints import from this module, they\n9\t * don't hand-roll envelopes, pagination clamping or error mapping.\n10\t */\n11\t\n12\texport type ApiErrorCode =\n13\t  | 'VALIDATION_ERROR'\n14\t  | 'NOT_FOUND'\n15\t  | 'CONFLICT'\n16\t  | 'INTERNAL'\n17\t  | 'RATE_LIMITED'\n18\t  | 'UNAUTHENTICATED'\n19\t  | 'FORBIDDEN'\n20\t  | 'INVALID_TOKEN';\n21\t\n22\tconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n23\t  VALIDATION_ERROR: 400,\n24\t  NOT_FOUND: 404,\n25\t  CONFLICT: 409,\n26\t  INTERNAL: 500,\n27\t  RATE_LIMITED: 429,\n28\t  UNAUTHENTICATED: 401,\n29\t  FORBIDDEN: 403,\n30\t  INVALID_TOKEN: 410,\n31\t};\n32\t\n33\t/** Throw this from a handler for a known, intentional failure. */\n34\texport class AppError extends Error {\n35\t  code: ApiErrorCode;\n36\t  details?: unknown;\n37\t\n38\t  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n39\t    super(message);\n40\t    this.code = code;\n41\t    this.details = details;\n42\t  }\n43\t}\n44\t\n45\texport function ok<T>(data: T, init?: ResponseInit) {\n46\t  return NextResponse.json({ data }, init);\n47\t}\n48\t\n49\texport function paginated<T>(\n50\t  data: T[],\n51\t  meta: { page: number; pageSize: number; total: number },\n52\t  init?: ResponseInit,\n53\t) {\n54\t  return NextResponse.json({ data, meta }, init);\n55\t}\n56\t\n57\texport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n58\t  return NextResponse.json(\n59\t    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n60\t    { status: ERROR_STATUS[code] },\n61\t  );\n62\t}\n63\t\n64\t/**\n65\t * Wraps a route handler, mapping thrown errors to the shared envelope:\n66\t * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n67\t * AppError -> its own code/status\n68\t * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n69\t * anything else -> INTERNAL (500), stack logged, never returned to client\n70\t */\n71\texport function withHandler<Args extends unknown[]>(\n72\t  fn: (...args: Args) => Promise<Response>,\n73\t) {\n74\t  return async (...args: Args): Promise<Response> => {\n75\t    try {\n76\t      return await fn(...args);\n77\t    } catch (error) {\n78\t      if (error instanceof ZodError) {\n79\t        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n80\t      }\n81\t\n82\t      if (error instanceof AppError) {\n83\t        return apiError(error.code, error.message, error.details);\n84\t      }\n85\t\n86\t      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n87\t        if (error.code === 'P2002') {\n88\t          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n89\t        }\n90\t        if (error.code === 'P2025') {\n91\t          return apiError('NOT_FOUND', 'Resource not found');\n92\t        }\n93\t      }\n94\t\n95\t      logger.error('Unhandled error in route handler', {\n96\t        message: error instanceof Error ? error.message : String(error),\n97\t        stack: error instanceof Error ? error.stack : undefined,\n98\t      });\n99\t      return apiError('INTERNAL', 'Internal server error');\n100\t    }\n101\t  };\n102\t}\n103\t\n104\texport interface PaginationParams {\n105\t  page: number;\n106\t  pageSize: number;\n107\t  skip: number;\n108\t  take: number;\n109\t}\n110\t\n111\tconst MAX_PAGE_SIZE = 100;\n112\t\n113\texport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n114\t  const rawPage = Number(searchParams.get('page'));\n115\t  const rawPageSize = Number(searchParams.get('pageSize'));\n116\t\n117\t  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n118\t  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n119\t  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n120\t\n121\t  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n122\t}\n123\t\n124\texport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n125\t  const json = await request.json().catch(() => ({}));\n126\t  return schema.parse(json);\n127\t}\n128\t\n129\texport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n130\t  return schema.parse(Object.fromEntries(searchParams.entries()));\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"d5a8f152-49e8-4bf2-bd8a-06ac76b7320e","uuid":"bfd4f65d-ec7c-479d-9e5e-0cec1a541775","timestamp":"2026-10-19T09:17:34.263Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/http.ts","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\nexport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\nexport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\n","numLines":132,"startLine":1,"totalLines":132}}}
