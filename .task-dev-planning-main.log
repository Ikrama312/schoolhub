llbackUrl: '/dashboard' },\n  });\n  expect(res.ok()).toBeTruthy();\n  const session = await (await page.request.get('/api/auth/session')).json();\n  expect(session?.user?.email).toBe(ADMIN.email);\n}\n\nconst bell = (page: Page) => page.getByRole('button', { name: /^Notifications/ });\n\ntest('admin test notification bumps the bell, mark all read clears it', async ({ page }) => {\n1:// @vitest-environment node\n2:import { afterAll, beforeEach, describe, expect, it, vi } from 'vitest';\n26:describe.runIf(process.env.TEST_DATABASE_URL)('dispatchEmails (integration)', () => {\n29:  beforeEach(async () => {","is_error":false}]},"parent_tool_use_id":null,"session_id":"e695f9e3-b58d-43ba-a40f-80582ccbd08f","uuid":"202bf08a-9ffa-4983-b55b-9dd364e3b051","timestamp":"2026-11-05T16:32:22.938Z","tool_use_result":{"stdout":"export { PasswordChecklist, type PasswordChecklistProps } from './PasswordChecklist';\nexport {\n  SetPasswordForm,\n  postJson,\n  applyFieldErrors,\n  passwordInputSlot,\n  type SetPasswordFormProps,\n  type ApiFailure,\n} from './SetPasswordForm';\n20:export interface ApiFailure {\n28:export async function postJson<T = unknown>(url: string, body: unknown): Promise<{ data: T } | { error: ApiFailure }> {\n51:export function applyFieldErrors<T extends FieldValues>(\n67:/** Visibility toggle for a password TextField (v9: slotProps.input). */\n68:export function passwordInputSlot(show: boolean, toggle: () => void) {\n82:export interface SetPasswordFormProps {\n87:  onSubmit: (password: string, confirm: string) => Promise<ApiFailure | void>;\n91:export function SetPasswordForm({ name, email, submitLabel = 'Set password', onSubmit }: SetPasswordFormProps) {\n102:    const failure = await onSubmit(password, confirm);\n108:    <Box component=\"form\" noValidate onSubmit={submit}>\n111:        {name && <TextField label=\"Name\" value={name} fullWidth slotProps={{ htmlInput: { readOnly: true } }} />}\n112:        <TextField label=\"Email\" value={email} fullWidth s