te audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nsrc/server/http.ts:12:export type ApiErrorCode =\nsrc/server/http.ts:34:export class AppError extends Error {\nsrc/server/http.ts:45:export function ok<T>(data: T, init?: ResponseInit) {\nsrc/server/http.ts:49:export function paginated<T>(\nsrc/server/http.ts:57:export function apiError(code: ApiErrorCode, message: string, details?: unknown) {\nsrc/server/http.ts:71:export function withHandler<Args extends unknown[]>(\nsrc/server/http.ts:104:export interface PaginationParams {\nsrc/server/http.ts:113:export function parsePagination(searchParams: URLSearchParams): PaginationParams {\nsrc/server/http.ts:124:export async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\nsrc/server/http.ts:129:export function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\nsrc/server/db.ts:11:export const prisma = globalForPrisma.prisma ?? new PrismaClient();\nsrc/server/services/academicYears.ts:9:export interface AcademicYearInput {\nsrc/server/services/academicYears.ts:35:export async function listAcademicYears() {\nsrc/server/services/academicYears.ts:42:export async function createAcademicYear(input: AcademicYearInput) {\nsrc/server/services/academicYears.ts:53:export async function updateAcademicYear(id: string, input: Partial<AcademicYearInput>) {\nsrc/server/services/academicYears.ts:71:export async function setCurrentAcademicYear(id: string) {\nsrc/server/services/academicYears.ts:79:export async function deleteAcademicYear(id: string) {\nsrc/server/services/academicYears.ts:88:export const getCurrentAcademicYear = cache(async () => {\nsrc/server/services/academicYears.ts:96:export async function getCurrentTerm(date: Date = new Date()) {\nsrc/server/services/dateRange.ts:1:export interface DateRange {\nsrc/server/services/dateRange.ts:7:export function rangesOverlap(a: DateRange, b: DateRange): 