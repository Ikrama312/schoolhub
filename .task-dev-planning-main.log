{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BDdBxCXEDVHKkgWRYhEj1H","type":"tool_result","content":"1\t{\n2\t  \"ticketId\": \"abcd-05\",\n3\t  \"timestamp\": \"2026-10-27T00:31:00Z\",\n4\t  \"phase\": \"architect\",\n5\t  \"version\": \"1.0\",\n6\t\n7\t  \"status\": \"complete\",\n8\t  \"endpointCount\": 17,\n9\t  \"blockers\": [\n10\t    {\n11\t      \"severity\": \"advisory\",\n12\t      \"description\": \"NFR-7 (carried from intake, resolved as system-design Decision 2): routes use the requireRole(...) stand-in from src/server/auth/requireRole.ts; course-scoped reads add assertCanViewCourse from the new src/server/auth/course-access.ts. No permissions.ts/requireUser() is introduced here — that consolidation belongs to PRD-01. Identity-dependent scoping (GET /api/me/courses, GET /api/courses non-ADMIN, roster role projection) inherits the stand-in's single-identity behaviour until PRD-01 lands.\"\n13\t    },\n14\t    {\n15\t      \"severity\": \"advisory\",\n16\t      \"description\": \"FR-20 (carried from intake, resolved as system-design Decision 1): add optional `group?: string` to NavItem in src/config/navigation.ts; 'Sections'/'Courses' get group 'Administration' (ADMIN only), 'My courses' stays ungrouped. No API impact.\"\n17\t    },\n18\t    {\n19\t      \"severity\": \"advisory\",\n20\t      \"description\": \"List envelope: the PRD shows flat { data, page, pageSize, total }, but the real paginated() helper in src/server/http.ts returns { data, meta: { page, pageSize, total } }. Contracts follow the helper; do not hand-roll the PRD shape.\"\n21\t    },\n22\t    {\n23\t      \"severity\": \"advisory\",\n24\t      \"description\": \"Contract-level decisions not spelled out in the PRD (dev-planning should implement as written in api-contracts.json): POST /api/courses/:id/enrollments refuses CORE courses with CONFLICT; PATCH /api/courses/:id treats sectionId/kind/academicYearId as immutable; move-section and PATCH /api/enrollments/:id accept optional overrideCapacity; GET /api/me/courses returns an empty list for ADMIN; copy-to-year skips top-grade sections and reports them in `skipped`.\"\n25\t    }\n26\t  ],\n27\t  \"nextPhase\": \"dev-planning\"\n28\t}\n29\t"}]},"parent_tool_use_id":null,"session_id":"663c6c96-740a-404e-b9ed-7275dd3841b6","uuid":"200163f2-445c-45c9-922a-3881cd706030","timestamp":"2026-10-27T16:34:24.257Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/handoff-to-dev-planning.json","content":"{\n  \"ticketId\": \"abcd-05\",\n  \"timestamp\": \"2026-10-27T00:31:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"status\": \"complete\",\n  \"endpointCount\": 17,\n  \"blockers\": [\n    {\n      \"severity\": \"advisory\",\n      \"description\": \"NFR-7 (carried from intake, resolved as system-design Decision 2): routes use the requireRole(...) stand-in from src/server/auth/requireRole.ts; course-scoped reads add assertCanViewCourse from the new src/server/auth/course-access.ts. No permissions.ts/requireUser() is introduced here — that consolidation belongs to PRD-01. Identity-dependent scoping (GET /api/me/courses, GET /api/courses non-ADMIN, roster role projection) inherits the stand-in's single-identity behaviour until PRD-01 lands.\"\n    },\n    {\n      \"severity\": \"advisory\",\n      \"description\": \"FR-20 (carried from intake, resolved as system-design Decision 1): add optional `group?: string` to NavItem in src/config/navigation.ts; 'Sections'/'Courses' get group 'Administration' (ADMIN only), 'My courses' stays ungrouped. No API impact.\"\n    },\n    {\n      \"severity\": \"advisory\",\n      \"description\": \"List envelope: the PRD shows flat { data, page, pageSize, total }, but the real paginated() helper in src/server/http.ts returns { data, meta: { page, pageSize, total } }. Contracts follow the helper; do not hand-roll the PRD shape.\"\n    },\n    {\n      \"severity\": \"advisory\",\n      \"description\": \"Contract-level decisions not spelled out in the PRD (dev-planning should implement as written in api-contracts.json): POST /api/courses/:id/enrollments refuses CORE courses with CONFLICT; PATCH /api/courses/:id treats sectionId/kind/academicYearId as immutable; move-section and PATCH /api/enrollments/:id accept optional overrideCapacity; GET /api/me/courses returns an empty list for ADMIN; copy-to-year skips top-grade sections and reports them in `skipped`.\"\n    }\n  ],\n  \"nextPhase\": \"dev-planning\"\n}\n","numLines":29,"startLine":1,"totalLines":29}},"tool_result_meta":[{"id":"toolu_01BDdBxCXEDVHKkgWRYhEj1H","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgT4k5rCBVJsWMMpSFfKQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0188Uh7fAUcyBXsyMCSWGaU5","name":"Read","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15506,"cache_read_input_tokens":30586,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15506},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"663c6c96-740a-404e-b9ed-7275dd3841b6","uuid":"9da07acc-3b55-49eb-bf83-f74ee4bd4c64","timestamp":"2026-10-27T16:34:25.709Z","request_id":"req_011CgT4k5Zb4FDd6Cpp3vpNb","wire_tool_inputs":{"toolu_0188Uh7fAUcyBXsyMCSWGaU5":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0188Uh7fAUcyBXsyMCSWGaU5","type":"tool_result","content":"1\t{\n2\t  \"ticketId\": \"abcd-05\",\n3\t  \"timestamp\": \"2026-10-27T00:30:00Z\",\n4\t  \"phase\": \"architect\",\n5\t  \"version\": \"1.0\",\n6\t\n7\t  \"note\": \"Derived from system-design.md (REST API surface + Data Flow) and 05-classes-enrollment.md's API table; 17 endpoints (the table's '·'-joined rows are expanded). Conventions shared by every endpoint, not repeated per entry: (1) every handler is wrapped in withHandler() from src/server/http.ts, which maps ZodError->VALIDATION_ERROR 400, AppError->its code, Prisma P2002->CONFLICT 409, P2025->NOT_FOUND 404; (2) success = ok() -> { data }, lists = paginated() -> { data: [...], meta: { page, pageSize, total } } — the real helper nests pagination under `meta`, unlike the PRD's flat example; follow the helper; (3) list query conventions: page (default 1), pageSize (default 20, max 100), sort, order=asc|desc, q; (4) auth: every route calls requireRole(...) from src/server/auth/requireRole.ts (NFR-7 stand-in; no permissions.ts/requireUser()); course-scoped reads additionally call assertCanViewCourse from src/server/auth/course-access.ts (FR-18); (5) every write calls audit() inside the same $transaction (FR-24) via the service/engine, never at the route layer; (6) handlers are thin: zod parse -> one service call -> envelope. Shared shapes are named under `schemas` and referenced as \\\"$ref\\\": \\\"#/schemas/<Name>\\\".\",\n8\t\n9\t  \"schemas\": {\n10\t    \"Section\": {\n11\t      \"id\": \"string\", \"academicYearId\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevel\": { \"id\": \"string\", \"name\": \"string\", \"order\": \"number\" },\n12\t      \"name\": \"string\", \"homeroomTeacherId\": \"string|null\", \"homeroomTeacher\": { \"id\": \"string\", \"name\": \"string\" },\n13\t      \"roomId\": \"string|null\", \"room\": { \"id\": \"string\", \"name\": \"string\" }, \"capacity\": \"number (1-60)\",\n14\t      \"memberCount\": \"number\", \"courseCount\": \"number\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n15\t    },\n16\t    \"SectionInput\": {\n17\t      \"academicYearId\": \"string (required on create)\", \"gradeLevelId\": \"string\", \"name\": \"string (min 1)\",\n18\t      \"homeroomTeacherId\": \"string|null (must be role=TEACHER; at most one section per teacher per year -> CONFLICT)\",\n19\t      \"roomId\": \"string|null\", \"capacity\": \"int 1-60, default 30\"\n20\t    },\n21\t    \"Course\": {\n22\t      \"id\": \"string\", \"academicYearId\": \"string\", \"subjectId\": \"string\", \"subject\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"color\": \"string\" },\n23\t      \"sectionId\": \"string|null\", \"section\": { \"id\": \"string\", \"name\": \"string\", \"room\": { \"id\": \"string\", \"name\": \"string\" } },\n24\t      \"teacherId\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" }, \"coTeacherIds\": \"string[]\", \"coTeachers\": [{ \"id\": \"string\", \"name\": \"string\" }],\n25\t      \"name\": \"string\", \"code\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"description\": \"string|null\", \"capacity\": \"number|null\",\n26\t      \"archivedAt\": \"ISO 8601|null\", \"enrolledCount\": \"number (ACTIVE only)\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n27\t    },\n28\t    \"CourseInput\": {\n29\t      \"academicYearId\": \"string (required on create)\", \"subjectId\": \"string\", \"sectionId\": \"string|null (required iff kind=CORE — single zod refinement shared with the dialog, FR-14)\",\n30\t      \"teacherId\": \"string (role=TEACHER)\", \"coTeacherIds\": \"string[] (max 3, role=TEACHER)\", \"name\": \"string (default '<Subject> – <Section>')\",\n31\t      \"code\": \"string (default '<SUBJECTCODE>-<SECTION>', transformed to uppercase; unique per year -> CONFLICT)\", \"kind\": \"CORE|ELECTIVE (default CORE)\",\n32\t      \"capacity\": \"int>=1|null\", \"description\": \"string|null\"\n33\t    },\n34\t    \"Enrollment\": {\n35\t      \"id\": \"string\", \"courseId\": \"string\", \"studentId\": \"string\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\" },\n36\t      \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\"\n37\t    },\n38\t    \"EnrollStudentsInput\": { \"studentIds\": \"string[] (min 1)\", \"overrideCapacity\": \"boolean (optional, default false)\" },\n39\t    \"EnrollResult\": { \"enrolled\": \"number (new ACTIVE rows)\", \"reactivated\": \"number (DROPPED->ACTIVE)\", \"alreadyActive\": \"number\" },\n40\t    \"CapacityConflict\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Section 7A is full (30/30). | Course MATH-7A is full (30/30).\" } }\n41\t  },\n42\t\n43\t  \"endpoints\": [\n44\t    {\n45\t      \"method\": \"GET\",\n46\t      \"path\": \"/api/sections\",\n47\t      \"description\": \"List sections for an academic year (defaults to current). Roles: ADMIN, TEACHER. Service: sections-service.listSections.\",\n48\t      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, defaults to current AcademicYear)\", \"gradeLevelId\": \"string (optional)\", \"q\": \"string (optional, name search)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"name|gradeLevel|memberCount (default gradeLevel)\", \"order\": \"asc|desc\" } },\n49\t      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Section\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } }, \"403\": \"FORBIDDEN (STUDENT/PARENT)\" },\n50\t      \"requirementIds\": [\"FR-2\", \"FR-23\", \"NFR-7\"]\n51\t    },\n52\t    {\n53\t      \"method\": \"POST\",\n54\t      \"path\": \"/api/sections\",\n55\t      \"description\": \"Create a section. Role: ADMIN. Homeroom-teacher-per-year check runs inside the write transaction (system-design Decision 3). Audits section.create.\",\n56\t      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/SectionInput\" } },\n57\t      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"409\": \"CONFLICT — duplicate name in year (P2002), or teacher already homeroom of another section this year\", \"400\": \"VALIDATION_ERROR\" },\n58\t      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n59\t    },\n60\t    {\n61\t      \"method\": \"PATCH\",\n62\t      \"path\": \"/api/sections/:id\",\n63\t      \"description\": \"Update a section (partial SectionInput, academicYearId immutable). Role: ADMIN. Capacity may not be lowered below current memberCount. Audits section.update.\",\n64\t      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<SectionInput> without academicYearId\" },\n65\t      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (name/homeroom uniqueness)\", \"400\": \"VALIDATION_ERROR (capacity < memberCount)\" },\n66\t      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n67\t    },\n68\t    {\n69\t      \"method\": \"DELETE\",\n70\t      \"path\": \"/api/sections/:id\",\n71\t      \"description\": \"Delete a section. Role: ADMIN. Allowed only when it has no members and no courses. Audits section.delete.\",\n72\t      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n73\t      \"responseSchema\": { \"200\": { \"data\": { \"id\": \"string\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT — 'Section 7A still has members or courses.'\" },\n74\t      \"requirementIds\": [\"FR-23\", \"FR-24\"]\n75\t    },\n76\t    {\n77\t      \"method\": \"POST\",\n78\t      \"path\": \"/api/sections/:id/members\",\n79\t      \"description\": \"Add students to a section and auto-enroll them ACTIVE in every non-archived CORE course of the section (reactivating DROPPED rows), all in one $transaction via roster-engine.enrollSectionCoreCourses with batched createMany/updateMany. Role: ADMIN. Audits section.member.add + enrollment.*.\",\n80\t      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n81\t      \"responseSchema\": {\n82\t        \"201\": { \"data\": { \"added\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n83\t        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Sam Student is already in section 7A for 2026–2027.' (SectionMember @@unique P2002, mapped to the friendly message by the service)\"],\n84\t        \"400\": \"VALIDATION_ERROR — student not role=STUDENT or wrong grade level\", \"404\": \"NOT_FOUND\"\n85\t      },\n86\t      \"requirementIds\": [\"FR-4\", \"FR-7\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-2\", \"NFR-3\"]\n87\t    },\n88\t    {\n89\t      \"method\": \"DELETE\",\n90\t      \"path\": \"/api/sections/:id/members/:studentId\",\n91\t      \"description\": \"Remove a student from a section; their ACTIVE enrollments in this section's CORE courses become DROPPED with droppedAt=now (electives untouched) via roster-engine.dropSectionCoreCourses, same transaction. Role: ADMIN. Audits section.member.remove + enrollment.drop.\",\n92\t      \"requestSchema\": { \"params\": { \"id\": \"string\", \"studentId\": \"string\" } },\n93\t      \"responseSchema\": { \"200\": { \"data\": { \"removed\": true, \"droppedEnrollments\": \"number\" } }, \"404\": \"NOT_FOUND (student not a member)\" },\n94\t      \"requirementIds\": [\"FR-4\", \"FR-8\", \"FR-12\", \"FR-23\", \"FR-24\"]\n95\t    },\n96\t    {\n97\t      \"method\": \"POST\",\n98\t      \"path\": \"/api/students/:id/move-section\",\n99\t      \"description\": \"Move a student to another section of the same academic year in a single $transaction: remove membership + drop source CORE enrollments, add membership + enroll/reactivate destination CORE enrollments (roster-engine.moveStudentSection). Electives unchanged. Role: ADMIN. Audits section.member.move + enrollment.*.\",\n100\t      \"requestSchema\": { \"params\": { \"id\": \"string (studentId)\" }, \"body\": { \"toSectionId\": \"string\", \"overrideCapacity\": \"boolean (optional, default false)\" } },\n101\t      \"responseSchema\": {\n102\t        \"200\": { \"data\": { \"fromSectionId\": \"string\", \"toSectionId\": \"string\", \"dropped\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n103\t        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }],\n104\t        \"400\": \"VALIDATION_ERROR — destination in a different academic year, or same as source\", \"404\": \"NOT_FOUND — student has no section this year, or toSectionId unknown\"\n105\t      },\n106\t      \"requirementIds\": [\"FR-9\", \"FR-7\", \"FR-8\", \"FR-11\", \"FR-23\", \"FR-24\"]\n107\t    },\n108\t    {\n109\t      \"method\": \"POST\",\n110\t      \"path\": \"/api/sections/:id/core-courses\",\n111\t      \"description\": \"Bulk-create one CORE course per item (default name '<Subject> – <Section>', code '<SUBJECTCODE>-<SECTION>') and enroll all current section members in each, one $transaction. Subjects must be non-archived. Role: ADMIN. Audits course.create + enrollment.* per course.\",\n112\t      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"items\": [{ \"subjectId\": \"string\", \"teacherId\": \"string (role=TEACHER)\" }], \"_constraints\": \"items min 1, subjectIds unique\" } },\n113\t      \"responseSchema\": { \"201\": { \"data\": { \"courses\": [{ \"$ref\": \"#/schemas/Course\" }], \"enrollmentsCreated\": \"number\" } }, \"409\": \"CONFLICT — course code already exists this year (P2002)\", \"400\": \"VALIDATION_ERROR\" },\n114\t      \"requirementIds\": [\"FR-5\", \"FR-10\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n115\t    },\n116\t    {\n117\t      \"method\": \"POST\",\n118\t      \"path\": \"/api/sections/copy-to-year\",\n119\t      \"description\": \"Structural copy of all sections from one year to a future, non-current year: name, room, capacity copied; gradeLevel advanced to the next GradeLevel by `order` (sections at the top grade are skipped); no members, no homeroom teacher, no courses. Role: ADMIN. Audits section.create per copy.\",\n120\t      \"requestSchema\": { \"body\": { \"fromYearId\": \"string\", \"toYearId\": \"string (must be a future, non-current AcademicYear)\" } },\n121\t      \"responseSchema\": { \"201\": { \"data\": { \"created\": \"number\", \"skipped\": [{ \"name\": \"string\", \"reason\": \"no next grade level | name already exists in target year\" }] } }, \"400\": \"VALIDATION_ERROR — toYearId is current or not in the future\" },\n122\t      \"requirementIds\": [\"FR-6\", \"FR-23\", \"FR-24\", \"NFR-6\"]\n123\t    },\n124\t    {\n125\t      \"method\": \"GET\",\n126\t      \"path\": \"/api/courses\",\n127\t      \"description\": \"List courses. ADMIN sees all; TEACHER sees courses they teach/co-teach; STUDENT/PARENT see courses with an ACTIVE enrollment for self/linked child (scoping done in courses-service, not by client filter). Excludes archived unless includeArchived=true (ADMIN only).\",\n128\t      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, default current)\", \"gradeLevelId\": \"string\", \"subjectId\": \"string\", \"teacherId\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"sectionId\": \"string\", \"includeArchived\": \"boolean\", \"q\": \"string (name/code)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"code|name|enrolledCount\", \"order\": \"asc|desc\" } },\n129\t      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Course\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n130\t      \"requirementIds\": [\"FR-13\", \"FR-23\", \"NFR-7\"]\n131\t    },\n132\t    {\n133\t      \"method\": \"POST\",\n134\t      \"path\": \"/api/courses\",\n135\t      \"description\": \"Create a course. Role: ADMIN. A new CORE course on a section enrolls all current section members ACTIVE in the same transaction (FR-10). Audits course.create (+ enrollment.* if CORE).\",\n136\t      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/CourseInput\" } },\n137\t      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"409\": \"CONFLICT — code already used this year\", \"400\": \"VALIDATION_ERROR — e.g. kind=CORE without sectionId, >3 coTeachers\" },\n138\t      \"requirementIds\": [\"FR-14\", \"FR-10\", \"FR-23\", \"FR-24\"]\n139\t    },\n140\t    {\n141\t      \"method\": \"PATCH\",\n142\t      \"path\": \"/api/courses/:id\",\n143\t      \"description\": \"Update a course (partial CourseInput; academicYearId/sectionId/kind immutable after creation to avoid silent roster rewrites). Archive via { archived: true } (sets archivedAt), unarchive via { archived: false }. Role: ADMIN. Audits course.update / course.archive.\",\n144\t      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<CourseInput> without academicYearId/sectionId/kind, plus archived?: boolean\" },\n145\t      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (code)\", \"400\": \"VALIDATION_ERROR (capacity < enrolledCount)\" },\n146\t      \"requirementIds\": [\"FR-14\", \"FR-23\", \"FR-24\"]\n147\t    },\n148\t    {\n149\t      \"method\": \"GET\",\n150\t      \"path\": \"/api/courses/:id\",\n151\t      \"description\": \"Course header/overview data for /courses/[courseId]. Gated by assertCanViewCourse (ADMIN all; TEACHER teacher/co-teacher; STUDENT ACTIVE enrollment; PARENT linked child ACTIVE enrollment).\",\n152\t      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n153\t      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"403\": \"FORBIDDEN\", \"404\": \"NOT_FOUND\" },\n154\t      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\", \"FR-23\"]\n155\t    },\n156\t    {\n157\t      \"method\": \"GET\",\n158\t      \"path\": \"/api/courses/:id/roster\",\n159\t      \"description\": \"Course roster, ACTIVE enrollments by default. Gated by assertCanViewCourse; PARENT gets FORBIDDEN (Roster tab not shown). Shape from courses-service.getCourseRoster(id, viewerRole) — the same function the Roster tab server component uses.\",\n160\t      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"query\": { \"status\": \"ACTIVE|DROPPED|ALL (default ACTIVE; DROPPED/ALL only for ADMIN/TEACHER)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"q\": \"string\" } },\n161\t      \"responseSchema\": {\n162\t        \"200 (ADMIN, TEACHER)\": { \"data\": [{ \"enrollmentId\": \"string\", \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\", \"profileUrl\": \"/students/:id\" } }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },\n163\t        \"200 (STUDENT)\": { \"data\": [{ \"name\": \"string\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" }, \"_privacy\": \"Projection is names only — no ids, emails, admission numbers, avatars or profile links; status forced to ACTIVE (NFR-4)\" },\n164\t        \"403\": \"FORBIDDEN (no view access, or PARENT)\"\n165\t      },\n166\t      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-12\", \"FR-23\", \"NFR-4\"]\n167\t    },\n168\t    {\n169\t      \"method\": \"POST\",\n170\t      \"path\": \"/api/courses/:id/enrollments\",\n171\t      \"description\": \"Enroll students directly in a course (create or reactivate DROPPED; same semantics as the roster engine helper). Role: ADMIN. Refused for CORE courses (membership is managed via the section). Capacity checked via checkCapacityOrThrow. Audits enrollment.create / enrollment.reactivate.\",\n172\t      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n173\t      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/EnrollResult\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Core course enrollment is managed via section 7A.'\"], \"400\": \"VALIDATION_ERROR — non-student ids\", \"404\": \"NOT_FOUND\" },\n174\t      \"requirementIds\": [\"FR-15\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n175\t    },\n176\t    {\n177\t      \"method\": \"PATCH\",\n178\t      \"path\": \"/api/enrollments/:id\",\n179\t      \"description\": \"Drop or reactivate a single enrollment (DROPPED sets droppedAt=now; ACTIVE clears it and runs checkCapacityOrThrow). Historical data is retained either way. Role: ADMIN. Audits enrollment.drop / enrollment.reactivate.\",\n180\t      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"status\": \"ACTIVE|DROPPED\", \"overrideCapacity\": \"boolean (optional, only meaningful for ACTIVE)\" } },\n181\t      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Enrollment\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }], \"404\": \"NOT_FOUND\" },\n182\t      \"requirementIds\": [\"FR-15\", \"FR-12\", \"FR-11\", \"FR-23\", \"FR-24\"]\n183\t    },\n184\t    {\n185\t      \"method\": \"GET\",\n186\t      \"path\": \"/api/me/courses\",\n187\t      \"description\": \"Current user's courses for /my-courses, current academic year, non-archived. TEACHER: taught/co-taught; STUDENT: ACTIVE enrollments; PARENT: grouped by linked child; ADMIN: empty list (admins use /admin/courses). Role: any (requireRole(...ALL_ROLES), NFR-7 stand-in identity).\",\n188\t      \"requestSchema\": {},\n189\t      \"responseSchema\": {\n190\t        \"200 (TEACHER)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"section\": { \"id\": \"string\", \"name\": \"string\" }, \"enrolledCount\": \"number\" }] },\n191\t        \"200 (STUDENT)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] },\n192\t        \"200 (PARENT)\": { \"data\": [{ \"child\": { \"id\": \"string\", \"name\": \"string\" }, \"courses\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] }] }\n193\t      },\n194\t      \"requirementIds\": [\"FR-19\", \"FR-23\", \"NFR-7\"]\n195\t    }\n196\t  ],\n197\t  \"status\": \"complete\"\n198\t}\n199\t"}]},"parent_tool_use_id":null,"session_id":"663c6c96-740a-404e-b9ed-7275dd3841b6","uuid":"88dd2be3-175d-4576-9d61-d8e0c67f853d","timestamp":"2026-10-27T16:34:26.088Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"abcd-05\",\n  \"timestamp\": \"2026-10-27T00:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md (REST API surface + Data Flow) and 05-classes-enrollment.md's API table; 17 endpoints (the table's '·'-joined rows are expanded). Conventions shared by every endpoint, not repeated per entry: (1) every handler is wrapped in withHandler() from src/server/http.ts, which maps ZodError->VALIDATION_ERROR 400, AppError->its code, Prisma P2002->CONFLICT 409, P2025->NOT_FOUND 404; (2) success = ok() -> { data }, lists = paginated() -> { data: [...], meta: { page, pageSize, total } } — the real helper nests pagination under `meta`, unlike the PRD's flat example; follow the helper; (3) list query conventions: page (default 1), pageSize (default 20, max 100), sort, order=asc|desc, q; (4) auth: every route calls requireRole(...) from src/server/auth/requireRole.ts (NFR-7 stand-in; no permissions.ts/requireUser()); course-scoped reads additionally call assertCanViewCourse from src/server/auth/course-access.ts (FR-18); (5) every write calls audit() inside the same $transaction (FR-24) via the service/engine, never at the route layer; (6) handlers are thin: zod parse -> one service call -> envelope. Shared shapes are named under `schemas` and referenced as \\\"$ref\\\": \\\"#/schemas/<Name>\\\".\",\n\n  \"schemas\": {\n    \"Section\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevel\": { \"id\": \"string\", \"name\": \"string\", \"order\": \"number\" },\n      \"name\": \"string\", \"homeroomTeacherId\": \"string|null\", \"homeroomTeacher\": { \"id\": \"string\", \"name\": \"string\" },\n      \"roomId\": \"string|null\", \"room\": { \"id\": \"string\", \"name\": \"string\" }, \"capacity\": \"number (1-60)\",\n      \"memberCount\": \"number\", \"courseCount\": \"number\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"SectionInput\": {\n      \"academicYearId\": \"string (required on create)\", \"gradeLevelId\": \"string\", \"name\": \"string (min 1)\",\n      \"homeroomTeacherId\": \"string|null (must be role=TEACHER; at most one section per teacher per year -> CONFLICT)\",\n      \"roomId\": \"string|null\", \"capacity\": \"int 1-60, default 30\"\n    },\n    \"Course\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"subjectId\": \"string\", \"subject\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"color\": \"string\" },\n      \"sectionId\": \"string|null\", \"section\": { \"id\": \"string\", \"name\": \"string\", \"room\": { \"id\": \"string\", \"name\": \"string\" } },\n      \"teacherId\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" }, \"coTeacherIds\": \"string[]\", \"coTeachers\": [{ \"id\": \"string\", \"name\": \"string\" }],\n      \"name\": \"string\", \"code\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"description\": \"string|null\", \"capacity\": \"number|null\",\n      \"archivedAt\": \"ISO 8601|null\", \"enrolledCount\": \"number (ACTIVE only)\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"CourseInput\": {\n      \"academicYearId\": \"string (required on create)\", \"subjectId\": \"string\", \"sectionId\": \"string|null (required iff kind=CORE — single zod refinement shared with the dialog, FR-14)\",\n      \"teacherId\": \"string (role=TEACHER)\", \"coTeacherIds\": \"string[] (max 3, role=TEACHER)\", \"name\": \"string (default '<Subject> – <Section>')\",\n      \"code\": \"string (default '<SUBJECTCODE>-<SECTION>', transformed to uppercase; unique per year -> CONFLICT)\", \"kind\": \"CORE|ELECTIVE (default CORE)\",\n      \"capacity\": \"int>=1|null\", \"description\": \"string|null\"\n    },\n    \"Enrollment\": {\n      \"id\": \"string\", \"courseId\": \"string\", \"studentId\": \"string\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\" },\n      \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\"\n    },\n    \"EnrollStudentsInput\": { \"studentIds\": \"string[] (min 1)\", \"overrideCapacity\": \"boolean (optional, default false)\" },\n    \"EnrollResult\": { \"enrolled\": \"number (new ACTIVE rows)\", \"reactivated\": \"number (DROPPED->ACTIVE)\", \"alreadyActive\": \"number\" },\n    \"CapacityConflict\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Section 7A is full (30/30). | Course MATH-7A is full (30/30).\" } }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/sections\",\n      \"description\": \"List sections for an academic year (defaults to current). Roles: ADMIN, TEACHER. Service: sections-service.listSections.\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, defaults to current AcademicYear)\", \"gradeLevelId\": \"string (optional)\", \"q\": \"string (optional, name search)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"name|gradeLevel|memberCount (default gradeLevel)\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Section\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } }, \"403\": \"FORBIDDEN (STUDENT/PARENT)\" },\n      \"requirementIds\": [\"FR-2\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections\",\n      \"description\": \"Create a section. Role: ADMIN. Homeroom-teacher-per-year check runs inside the write transaction (system-design Decision 3). Audits section.create.\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/SectionInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"409\": \"CONFLICT — duplicate name in year (P2002), or teacher already homeroom of another section this year\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Update a section (partial SectionInput, academicYearId immutable). Role: ADMIN. Capacity may not be lowered below current memberCount. Audits section.update.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<SectionInput> without academicYearId\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (name/homeroom uniqueness)\", \"400\": \"VALIDATION_ERROR (capacity < memberCount)\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Delete a section. Role: ADMIN. Allowed only when it has no members and no courses. Audits section.delete.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"id\": \"string\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT — 'Section 7A still has members or courses.'\" },\n      \"requirementIds\": [\"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/members\",\n      \"description\": \"Add students to a section and auto-enroll them ACTIVE in every non-archived CORE course of the section (reactivating DROPPED rows), all in one $transaction via roster-engine.enrollSectionCoreCourses with batched createMany/updateMany. Role: ADMIN. Audits section.member.add + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": {\n        \"201\": { \"data\": { \"added\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Sam Student is already in section 7A for 2026–2027.' (SectionMember @@unique P2002, mapped to the friendly message by the service)\"],\n        \"400\": \"VALIDATION_ERROR — student not role=STUDENT or wrong grade level\", \"404\": \"NOT_FOUND\"\n      },\n      \"requirementIds\": [\"FR-4\", \"FR-7\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-2\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id/members/:studentId\",\n      \"description\": \"Remove a student from a section; their ACTIVE enrollments in this section's CORE courses become DROPPED with droppedAt=now (electives untouched) via roster-engine.dropSectionCoreCourses, same transaction. Role: ADMIN. Audits section.member.remove + enrollment.drop.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\", \"studentId\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"removed\": true, \"droppedEnrollments\": \"number\" } }, \"404\": \"NOT_FOUND (student not a member)\" },\n      \"requirementIds\": [\"FR-4\", \"FR-8\", \"FR-12\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/students/:id/move-section\",\n      \"description\": \"Move a student to another section of the same academic year in a single $transaction: remove membership + drop source CORE enrollments, add membership + enroll/reactivate destination CORE enrollments (roster-engine.moveStudentSection). Electives unchanged. Role: ADMIN. Audits section.member.move + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string (studentId)\" }, \"body\": { \"toSectionId\": \"string\", \"overrideCapacity\": \"boolean (optional, default false)\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"fromSectionId\": \"string\", \"toSectionId\": \"string\", \"dropped\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }],\n        \"400\": \"VALIDATION_ERROR — destination in a different academic year, or same as source\", \"404\": \"NOT_FOUND — student has no section this year, or toSectionId unknown\"\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-7\", \"FR-8\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/core-courses\",\n      \"description\": \"Bulk-create one CORE course per item (default name '<Subject> – <Section>', code '<SUBJECTCODE>-<SECTION>') and enroll all current section members in each, one $transaction. Subjects must be non-archived. Role: ADMIN. Audits course.create + enrollment.* per course.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"items\": [{ \"subjectId\": \"string\", \"teacherId\": \"string (role=TEACHER)\" }], \"_constraints\": \"items min 1, subjectIds unique\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"courses\": [{ \"$ref\": \"#/schemas/Course\" }], \"enrollmentsCreated\": \"number\" } }, \"409\": \"CONFLICT — course code already exists this year (P2002)\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-5\", \"FR-10\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/copy-to-year\",\n      \"description\": \"Structural copy of all sections from one year to a future, non-current year: name, room, capacity copied; gradeLevel advanced to the next GradeLevel by `order` (sections at the top grade are skipped); no members, no homeroom teacher, no courses. Role: ADMIN. Audits section.create per copy.\",\n      \"requestSchema\": { \"body\": { \"fromYearId\": \"string\", \"toYearId\": \"string (must be a future, non-current AcademicYear)\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"created\": \"number\", \"skipped\": [{ \"name\": \"string\", \"reason\": \"no next grade level | name already exists in target year\" }] } }, \"400\": \"VALIDATION_ERROR — toYearId is current or not in the future\" },\n      \"requirementIds\": [\"FR-6\", \"FR-23\", \"FR-24\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses\",\n      \"description\": \"List courses. ADMIN sees all; TEACHER sees courses they teach/co-teach; STUDENT/PARENT see courses with an ACTIVE enrollment for self/linked child (scoping done in courses-service, not by client filter). Excludes archived unless includeArchived=true (ADMIN only).\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, default current)\", \"gradeLevelId\": \"string\", \"subjectId\": \"string\", \"teacherId\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"sectionId\": \"string\", \"includeArchived\": \"boolean\", \"q\": \"string (name/code)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"code|name|enrolledCount\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Course\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"requirementIds\": [\"FR-13\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses\",\n      \"description\": \"Create a course. Role: ADMIN. A new CORE course on a section enrolls all current section members ACTIVE in the same transaction (FR-10). Audits course.create (+ enrollment.* if CORE).\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/CourseInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"409\": \"CONFLICT — code already used this year\", \"400\": \"VALIDATION_ERROR — e.g. kind=CORE without sectionId, >3 coTeachers\" },\n      \"requirementIds\": [\"FR-14\", \"FR-10\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Update a course (partial CourseInput; academicYearId/sectionId/kind immutable after creation to avoid silent roster rewrites). Archive via { archived: true } (sets archivedAt), unarchive via { archived: false }. Role: ADMIN. Audits course.update / course.archive.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<CourseInput> without academicYearId/sectionId/kind, plus archived?: boolean\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (code)\", \"400\": \"VALIDATION_ERROR (capacity < enrolledCount)\" },\n      \"requirementIds\": [\"FR-14\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Course header/overview data for /courses/[courseId]. Gated by assertCanViewCourse (ADMIN all; TEACHER teacher/co-teacher; STUDENT ACTIVE enrollment; PARENT linked child ACTIVE enrollment).\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"403\": \"FORBIDDEN\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\", \"FR-23\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/roster\",\n      \"description\": \"Course roster, ACTIVE enrollments by default. Gated by assertCanViewCourse; PARENT gets FORBIDDEN (Roster tab not shown). Shape from courses-service.getCourseRoster(id, viewerRole) — the same function the Roster tab server component uses.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"query\": { \"status\": \"ACTIVE|DROPPED|ALL (default ACTIVE; DROPPED/ALL only for ADMIN/TEACHER)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"q\": \"string\" } },\n      \"responseSchema\": {\n        \"200 (ADMIN, TEACHER)\": { \"data\": [{ \"enrollmentId\": \"string\", \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\", \"profileUrl\": \"/students/:id\" } }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },\n        \"200 (STUDENT)\": { \"data\": [{ \"name\": \"string\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" }, \"_privacy\": \"Projection is names only — no ids, emails, admission numbers, avatars or profile links; status forced to ACTIVE (NFR-4)\" },\n        \"403\": \"FORBIDDEN (no view access, or PARENT)\"\n      },\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-12\", \"FR-23\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/enrollments\",\n      \"description\": \"Enroll students directly in a course (create or reactivate DROPPED; same semantics as the roster engine helper). Role: ADMIN. Refused for CORE courses (membership is managed via the section). Capacity checked via checkCapacityOrThrow. Audits enrollment.create / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/EnrollResult\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Core course enrollment is managed via section 7A.'\"], \"400\": \"VALIDATION_ERROR — non-student ids\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/enrollments/:id\",\n      \"description\": \"Drop or reactivate a single enrollment (DROPPED sets droppedAt=now; ACTIVE clears it and runs checkCapacityOrThrow). Historical data is retained either way. Role: ADMIN. Audits enrollment.drop / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"status\": \"ACTIVE|DROPPED\", \"overrideCapacity\": \"boolean (optional, only meaningful for ACTIVE)\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Enrollment\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }], \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-12\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/courses\",\n      \"description\": \"Current user's courses for /my-courses, current academic year, non-archived. TEACHER: taught/co-taught; STUDENT: ACTIVE enrollments; PARENT: grouped by linked child; ADMIN: empty list (admins use /admin/courses). Role: any (requireRole(...ALL_ROLES), NFR-7 stand-in identity).\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"200 (TEACHER)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"section\": { \"id\": \"string\", \"name\": \"string\" }, \"enrolledCount\": \"number\" }] },\n        \"200 (STUDENT)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] },\n        \"200 (PARENT)\": { \"data\": [{ \"child\": { \"id\": \"string\", \"name\": \"string\" }, \"courses\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] }] }\n      },\n      \"requirementIds\": [\"FR-19\", \"FR-23\", \"NFR-7\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n","numLines":199,"startLine":1,"totalLines":199}},"tool_result_meta":[{"id":"toolu_0188Uh7fAUcyBXsyMCSWGaU5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
