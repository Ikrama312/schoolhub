ricted-imports rule actually flags each banned import.\",\n      \"files\": [\"tests/unit/eslint-no-restricted-imports.test.ts\"],\n      \"dependencies\": [\"TASK-20\", \"TASK-19\"],\n      \"estimateHours\": 1,\n      \"requirementIds\": [\"NFR-6\"]\n    },\n    {\n      \"id\": \"TASK-24\",\n      \"description\": \"Playwright e2e + @axe-core/playwright scenarios on / and /dashboard asserting zero serious/critical accessibility violations.\",\n      \"files\": [\"tests/e2e/landing.spec.ts\", \"tests/e2e/dashboard.spec.ts\"],\n      \"dependencies\": [\"TASK-20\", \"TASK-16\", \"TASK-17\"],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\"NFR-3\", \"NFR-6\"]\n    }\n  ],\n\n  \"fileStructure\": {\n    \"./\": [\"package.json\", \"tsconfig.json\", \".eslintrc.json\", \".prettierrc.json\", \"next.config.js\", \"docker-compose.yml\", \".env.example\", \"vitest.config.ts\", \"playwright.config.ts\"],\n    \"prisma/\": [\"schema.prisma\", \"seed.ts\"],\n    \"src/lib/\": [\"env.ts\", \"logger.ts\", \"dates.ts\"],\n    \"src/server/\": [\"db.ts\", \"http.ts\"],\n    \"src/theme/\": [\"theme.ts\"],\n    \"src/config/\": [\"navigation.ts\", \"student-tabs.ts\"],\n    \"src/components/\": [\"PageHeader/\", \"EmptyState/\", \"DataTable/\", \"ConfirmDialog/\", \"Toast/\", \"FormField/\", \"StatCard/\", \"UserAvatar/\", \"DateDisplay/\", \"LoadingSkeleton/\"],\n    \"src/app/\": [\"layout.tsx\", \"not-found.tsx\", \"error.tsx\", \"global-error.tsx\", \"forbidden/\", \"api/health/\", \"(app)/\", \"(public)/\"],\n    \"tests/unit/\": [\"http.test.ts\", \"env.test.ts\", \"dates.test.ts\", \"DataTable.test.tsx\", \"ConfirmDialog.test.tsx\", \"useToast.test.tsx\", \"eslint-no-restricted-imports.test.ts\"],\n    \"tests/e2e/\": [\"landing.spec.ts\", \"dashboard.spec.ts\"]\n  },\n\n  \"totalEstimateHours\": 59,\n  \"nxpPatterns\": [],\n  \"status\": \"complete\"\n}\n","numLines":219,"startLine":1,"totalLines":219}}}
