{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01McJTKWHetq6uMYvMir8jpc","type":"tool_result","content":"1\timport { AppError } from '@/server/http';\n2\timport type { Role } from '@/config/navigation';\n3\t\n4\t/**\n5\t * Single chokepoint for server-side role checks on write endpoints.\n6\t *\n7\t * PRD-01 (real auth/session) has not landed in this workspace yet, so\n8\t * there is no session to read. This returns the same ADMIN placeholder\n9\t * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n10\t * and throws FORBIDDEN when that role isn't in the allowed list. Every\n11\t * write endpoint in this PRD calls requireRole() instead of checking role\n12\t * itself, so wiring up a real session later is a one-file change here\n13\t * instead of touching every route.\n14\t */\n15\tconst PLACEHOLDER_USER = { id: 'placeholder-user', role: 'ADMIN' as Role };\n16\t\n17\texport function requireRole(...roles: Role[]): { id: string; role: Role } {\n18\t  if (!roles.includes(PLACEHOLDER_USER.role)) {\n19\t    throw new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n20\t  }\n21\t  return PLACEHOLDER_USER;\n22\t}\n23\t"}]},"parent_tool_use_id":null,"session_id":"fe42c453-12ae-4515-b32c-f0603dc8fe6d","uuid":"2ce2925e-105b-404e-8827-c0d88d299cd6","timestamp":"2026-10-20T06:04:33.310Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/auth/requireRole.ts","content":"import { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side role checks on write endpoints.\n *\n * PRD-01 (real auth/session) has not landed in this workspace yet, so\n * there is no session to read. This returns the same ADMIN placeholder\n * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n * and throws FORBIDDEN when that role isn't in the allowed list. Every\n * write endpoint in this PRD calls requireRole() instead of checking role\n * itself, so wiring up a real session later is a one-file change here\n * instead of touching every route.\n */\nconst PLACEHOLDER_USER = { id: 'placeholder-user', role: 'ADMIN' as Role };\n\nexport function requireRole(...roles: Role[]): { id: string; role: Role } {\n  if (!roles.includes(PLACEHOLDER_USER.role)) {\n    throw new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n  }\n  return PLACEHOLDER_USER;\n}\n","numLines":23,"startLine":1,"totalLines":23}}}
