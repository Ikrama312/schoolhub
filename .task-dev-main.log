{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VDSL4T8HHkbaA7yy5XV41m","type":"tool_result","content":"1\timport type { Prisma } from '@prisma/client';\n2\timport { z } from 'zod';\n3\timport { prisma } from '@/server/db';\n4\timport { studentCsvRowSchema, teacherCsvRowSchema, GUARDIAN_RELATIONSHIP_VALUES } from '@/lib/validators/users';\n5\timport { linkParentToStudentTx } from '@/server/services/userLinks';\n6\timport { sendInvite } from '@/server/services/users';\n7\t\n8\t/**\n9\t * Server-side import batch transaction (component 9, FR-18, FR-20..FR-23,\n10\t * NFR-3). Never trusts the client: every row is re-validated here against\n11\t * the same Zod schemas the create form uses (src/lib/validators/users.ts).\n12\t *\n13\t * Batching contract: rows are processed in chunks of 200. Each batch is\n14\t * validated first (read-only, no writes) so an existing-email row can be\n15\t * classified \"skipped\" without touching the DB; if any row in the batch is\n16\t * a genuine error (bad data, unknown grade level), the whole batch is\n17\t * rolled back / never written (NFR-3's all-or-rollback), and every row in\n18\t * that batch — including ones that would otherwise have succeeded — is\n19\t * reported as 'error' so the summary never claims a write that didn't\n20\t * happen. Other batches are unaffected.\n21\t */\n22\t\n23\texport type ImportType = 'STUDENTS' | 'TEACHERS';\n24\t\n25\texport interface ImportRowResult {\n26\t  rowIndex: number;\n27\t  result: 'created' | 'skipped' | 'error';\n28\t  reason: string | null;\n29\t}\n30\t\n31\texport interface ImportSummary {\n32\t  createdStudents: number;\n33\t  createdParents: number;\n34\t  linkedExistingParents: number;\n35\t  skipped: number;\n36\t  failed: number;\n37\t  rowResults: ImportRowResult[];\n38\t}\n39\t\n40\tconst BATCH_SIZE = 200;\n41\t\n42\ttype TxClient = Prisma.TransactionClient;\n43\ttype GuardianRelationship = (typeof GUARDIAN_RELATIONSHIP_VALUES)[number];\n44\t\n45\tinterface ParsedParent {\n46\t  firstName: string;\n47\t  lastName: string;\n48\t  email: string;\n49\t  phone?: string;\n50\t  relationship: GuardianRelationship;\n51\t}\n52\t\n53\tfunction parentRelationship(value: string | undefined): GuardianRelationship {\n54\t  const upper = (value ?? '').toUpperCase();\n55\t  return (GUARDIAN_RELATIONSHIP_VALUES as readonly string[]).includes(upper)\n56\t    ? (upper as GuardianRelationship)\n57\t    : 'OTHER';\n58\t}\n59\t\n60\tasync function findGradeLevel(client: TxClient | typeof prisma, name: string) {\n61\t  return client.gradeLevel.findFirst({\n62\t    where: {\n63\t      OR: [{ name: { equals: name, mode: 'insensitive' } }, { shortName: { equals: name, mode: 'insensitive' } }],\n64\t    },\n65\t  });\n66\t}\n67\t\n68\ttype PlannedRow =\n69\t  | { rowIndex: number; status: 'error'; reason: string }\n70\t  | { rowIndex: number; status: 'skip'; reason: string }\n71\t  | { rowIndex: number; status: 'valid'; data: Record<string, unknown> };\n72\t\n73\t/** Validates (never writes) one row. */\n74\tasync function planRow(client: typeof prisma, type: ImportType, rowIndex: number, raw: unknown): Promise<PlannedRow> {\n75\t  const schema = type === 'STUDENTS' ? studentCsvRowSchema : teacherCsvRowSchema;\n76\t  const parsed = schema.safeParse(raw);\n77\t  if (!parsed.success) {\n78\t    return { rowIndex, status: 'error', reason: parsed.error.issues[0]?.message ?? 'Invalid row' };\n79\t  }\n80\t\n81\t  const existing = await client.user.findUnique({ where: { email: parsed.data.email } });\n82\t  if (existing) {\n83\t    return { rowIndex, status: 'skip', reason: 'Already exists' };\n84\t  }\n85\t\n86\t  if (type === 'TEACHERS') {\n87\t    return { rowIndex, status: 'valid', data: parsed.data };\n88\t  }\n89\t\n90\t  const row = parsed.data as z.infer<typeof studentCsvRowSchema>;\n91\t  const gradeLevel = await findGradeLevel(client, row.grade_level);\n92\t  if (!gradeLevel) {\n93\t    return { rowIndex, status: 'error', reason: `Grade level not found: ${row.grade_level}` };\n94\t  }\n95\t\n96\t  const parents: ParsedParent[] = [];\n97\t  if (row.parent1_email && row.parent1_first_name && row.parent1_last_name) {\n98\t    parents.push({\n99\t      firstName: row.parent1_first_name,\n100\t      lastName: row.parent1_last_name,\n101\t      email: row.parent1_email,\n102\t      phone: row.parent1_phone,\n103\t      relationship: parentRelationship(row.parent1_relationship),\n104\t    });\n105\t  }\n106\t  if (row.parent2_email && row.parent2_first_name && row.parent2_last_name) {\n107\t    parents.push({\n108\t      firstName: row.parent2_first_name,\n109\t      lastName: row.parent2_last_name,\n110\t      email: row.parent2_email,\n111\t      phone: row.parent2_phone,\n112\t      relationship: parentRelationship(row.parent2_relationship),\n113\t    });\n114\t  }\n115\t\n116\t  return { rowIndex, status: 'valid', data: { ...row, gradeLevelId: gradeLevel.id, parents } };\n117\t}\n118\t\n119\tasync function createStudentRow(tx: TxClient, data: Record<string, unknown>) {\n120\t  const row = data as z.infer<typeof studentCsvRowSchema> & { gradeLevelId: string; parents: ParsedParent[] };\n121\t  const user = await tx.user.create({\n122\t    data: { firstName: row.first_name, lastName: row.last_name, email: row.email, role: 'STUDENT', status: 'INVITED' },\n123\t  });\n124\t  await tx.studentProfile.create({\n125\t    data: {\n126\t      userId: user.id,\n127\t      admissionNumber: row.admission_number,\n128\t      dateOfBirth: row.date_of_birth,\n129\t      gradeLevelId: row.gradeLevelId,\n130\t      enrollmentDate: row.enrollment_date,\n131\t    },\n132\t  });\n133\t\n134\t  let createdParents = 0;\n135\t  let linkedExistingParents = 0;\n136\t  const createdUserIds = [user.id];\n137\t\n138\t  for (const parent of row.parents) {\n139\t    let parentUser = await tx.user.findUnique({ where: { email: parent.email } });\n140\t    if (parentUser) {\n141\t      linkedExistingParents += 1;\n142\t    } else {\n143\t      parentUser = await tx.user.create({\n144\t        data: { firstName: parent.firstName, lastName: parent.lastName, email: parent.email, phone: parent.phone, role: 'PARENT', status: 'INVITED' },\n145\t      });\n146\t      await tx.parentProfile.create({ data: { userId: parentUser.id } });\n147\t      createdParents += 1;\n148\t      createdUserIds.push(parentUser.id);\n149\t    }\n150\t    await linkParentToStudentTx(tx, {\n151\t      studentId: user.id,\n152\t      parentId: parentUser.id,\n153\t      relationship: parent.relationship,\n154\t      isPrimary: row.parents[0] === parent,\n155\t    });\n156\t  }\n157\t\n158\t  return { createdParents, linkedExistingParents, createdUserIds };\n159\t}\n160\t\n161\tasync function createTeacherRow(tx: TxClient, data: Record<string, unknown>) {\n162\t  const row = data as z.infer<typeof teacherCsvRowSchema>;\n163\t  const user = await tx.user.create({\n164\t    data: { firstName: row.first_name, lastName: row.last_name, email: row.email, phone: row.phone, role: 'TEACHER', status: 'INVITED' },\n165\t  });\n166\t  await tx.teacherProfile.create({ data: { userId: user.id, employeeNumber: row.employee_number, title: row.title } });\n167\t  return { createdUserIds: [user.id] };\n168\t}\n169\t\n170\texport async function importUsers(type: ImportType, rows: unknown[], sendInvites: boolean): Promise<ImportSummary> {\n171\t  const rowResults: ImportRowResult[] = [];\n172\t  let createdPrimary = 0;\n173\t  let createdParents = 0;\n174\t  let linkedExistingParents = 0;\n175\t  let skipped = 0;\n176\t  let failed = 0;\n177\t  const allCreatedUserIds: string[] = [];\n178\t\n179\t  for (let start = 0; start < rows.length; start += BATCH_SIZE) {\n180\t    const batch = rows.slice(start, start + BATCH_SIZE);\n181\t    const plan = await Promise.all(batch.map((raw, i) => planRow(prisma, type, start + i, raw)));\n182\t    const hasError = plan.some((p) => p.status === 'error');\n183\t\n184\t    if (hasError) {\n185\t      for (const p of plan) {\n186\t        failed += 1;\n187\t        rowResults.push({\n188\t          rowIndex: p.rowIndex,\n189\t          result: 'error',\n190\t          reason: p.status === 'error' ? p.reason : 'Batch rolled back: another row in this batch failed.',\n191\t        });\n192\t      }\n193\t      continue;\n194\t    }\n195\t\n196\t    const validPlans = plan.filter((p): p is PlannedRow & { status: 'valid' } => p.status === 'valid');\n197\t    if (validPlans.length > 0) {\n198\t      await prisma.$transaction(async (tx) => {\n199\t        for (const p of validPlans) {\n200\t          if (type === 'STUDENTS') {\n201\t            const result = await createStudentRow(tx, p.data);\n202\t            createdParents += result.createdParents;\n203\t            linkedExistingParents += result.linkedExistingParents;\n204\t            allCreatedUserIds.push(...result.createdUserIds);\n205\t          } else {\n206\t            const result = await createTeacherRow(tx, p.data);\n207\t            allCreatedUserIds.push(...result.createdUserIds);\n208\t          }\n209\t          createdPrimary += 1;\n210\t        }\n211\t      });\n212\t    }\n213\t\n214\t    for (const p of plan) {\n215\t      if (p.status === 'skip') {\n216\t        skipped += 1;\n217\t        rowResults.push({ rowIndex: p.rowIndex, result: 'skipped', reason: p.reason });\n218\t      } else {\n219\t        rowResults.push({ rowIndex: p.rowIndex, result: 'created', reason: null });\n220\t      }\n221\t    }\n222\t  }\n223\t\n224\t  if (sendInvites) {\n225\t    await Promise.all(allCreatedUserIds.map((id) => sendInvite(id)));\n226\t  }\n227\t\n228\t  rowResults.sort((a, b) => a.rowIndex - b.rowIndex);\n229\t\n230\t  // Contract (api-contracts.json) reuses `createdStudents` as the primary-row\n231\t  // created count for both import types — there is no `createdTeachers` field.\n232\t  return { createdStudents: createdPrimary, createdParents, linkedExistingParents, skipped, failed, rowResults };\n233\t}\n234\t"}]},"parent_tool_use_id":null,"session_id":"e93ce62f-466e-4ebf-a57c-8fec1a196fdd","uuid":"3d9e3a60-acbc-4533-bd23-78ba25e2fbbe","timestamp":"2026-10-19T09:57:07.821Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/services/userImport.ts","content":"import type { Prisma } from '@prisma/client';\nimport { z } from 'zod';\nimport { prisma } from '@/server/db';\nimport { studentCsvRowSchema, teacherCsvRowSchema, GUARDIAN_RELATIONSHIP_VALUES } from '@/lib/validators/users';\nimport { linkParentToStudentTx } from '@/server/services/userLinks';\nimport { sendInvite } from '@/server/services/users';\n\n/**\n * Server-side import batch transaction (component 9, FR-18, FR-20..FR-23,\n * NFR-3). Never trusts the client: every row is re-validated here against\n * the same Zod schemas the create form uses (src/lib/validators/users.ts).\n *\n * Batching contract: rows are processed in chunks of 200. Each batch is\n * validated first (read-only, no writes) so an existing-email row can be\n * classified \"skipped\" without touching the DB; if any row in the batch is\n * a genuine error (bad data, unknown grade level), the whole batch is\n * rolled back / never written (NFR-3's all-or-rollback), and every row in\n * that batch — including ones that would otherwise have succeeded — is\n * reported as 'error' so the summary never claims a write that didn't\n * happen. Other batches are unaffected.\n */\n\nexport type ImportType = 'STUDENTS' | 'TEACHERS';\n\nexport interface ImportRowResult {\n  rowIndex: number;\n  result: 'created' | 'skipped' | 'error';\n  reason: string | null;\n}\n\nexport interface ImportSummary {\n  createdStudents: number;\n  createdParents: number;\n  linkedExistingParents: number;\n  skipped: number;\n  failed: number;\n  rowResults: ImportRowResult[];\n}\n\nconst BATCH_SIZE = 200;\n\ntype TxClient = Prisma.TransactionClient;\ntype GuardianRelationship = (typeof GUARDIAN_RELATIONSHIP_VALUES)[number];\n\ninterface ParsedParent {\n  firstName: string;\n  lastName: string;\n  email: string;\n  phone?: string;\n  relationship: GuardianRelationship;\n}\n\nfunction parentRelationship(value: string | undefined): GuardianRelationship {\n  const upper = (value ?? '').toUpperCase();\n  return (GUARDIAN_RELATIONSHIP_VALUES as readonly string[]).includes(upper)\n    ? (upper as GuardianRelationship)\n    : 'OTHER';\n}\n\nasync function findGradeLevel(client: TxClient | typeof prisma, name: string) {\n  return client.gradeLevel.findFirst({\n    where: {\n      OR: [{ name: { equals: name, mode: 'insensitive' } }, { shortName: { equals: name, mode: 'insensitive' } }],\n    },\n  });\n}\n\ntype PlannedRow =\n  | { rowIndex: number; status: 'error'; reason: string }\n  | { rowIndex: number; status: 'skip'; reason: string }\n  | { rowIndex: number; status: 'valid'; data: Record<string, unknown> };\n\n/** Validates (never writes) one row. */\nasync function planRow(client: typeof prisma, type: ImportType, rowIndex: number, raw: unknown): Promise<PlannedRow> {\n  const schema = type === 'STUDENTS' ? studentCsvRowSchema : teacherCsvRowSchema;\n  const parsed = schema.safeParse(raw);\n  if (!parsed.success) {\n    return { rowIndex, status: 'error', reason: parsed.error.issues[0]?.message ?? 'Invalid row' };\n  }\n\n  const existing = await client.user.findUnique({ where: { email: parsed.data.email } });\n  if (existing) {\n    return { rowIndex, status: 'skip', reason: 'Already exists' };\n  }\n\n  if (type === 'TEACHERS') {\n    return { rowIndex, status: 'valid', data: parsed.data };\n  }\n\n  const row = parsed.data as z.infer<typeof studentCsvRowSchema>;\n  const gradeLevel = await findGradeLevel(client, row.grade_level);\n  if (!gradeLevel) {\n    return { rowIndex, status: 'error', reason: `Grade level not found: ${row.grade_level}` };\n  }\n\n  const parents: ParsedParent[] = [];\n  if (row.parent1_email && row.parent1_first_name && row.parent1_last_name) {\n    parents.push({\n      firstName: row.parent1_first_name,\n      lastName: row.parent1_last_name,\n      email: row.parent1_email,\n      phone: row.parent1_phone,\n      relationship: parentRelationship(row.parent1_relationship),\n    });\n  }\n  if (row.parent2_email && row.parent2_first_name && row.parent2_last_name) {\n    parents.push({\n      firstName: row.parent2_first_name,\n      lastName: row.parent2_last_name,\n      email: row.parent2_email,\n      phone: row.parent2_phone,\n      relationship: parentRelationship(row.parent2_relationship),\n    });\n  }\n\n  return { rowIndex, status: 'valid', data: { ...row, gradeLevelId: gradeLevel.id, parents } };\n}\n\nasync function createStudentRow(tx: TxClient, data: Record<string, unknown>) {\n  const row = data as z.infer<typeof studentCsvRowSchema> & { gradeLevelId: string; parents: ParsedParent[] };\n  const user = await tx.user.create({\n    data: { firstName: row.first_name, lastName: row.last_name, email: row.email, role: 'STUDENT', status: 'INVITED' },\n  });\n  await tx.studentProfile.create({\n    data: {\n      userId: user.id,\n      admissionNumber: row.admission_number,\n      dateOfBirth: row.date_of_birth,\n      gradeLevelId: row.gradeLevelId,\n      enrollmentDate: row.enrollment_date,\n    },\n  });\n\n  let createdParents = 0;\n  let linkedExistingParents = 0;\n  const createdUserIds = [user.id];\n\n  for (const parent of row.parents) {\n    let parentUser = await tx.user.findUnique({ where: { email: parent.email } });\n    if (parentUser) {\n      linkedExistingParents += 1;\n    } else {\n      parentUser = await tx.user.create({\n        data: { firstName: parent.firstName, lastName: parent.lastName, email: parent.email, phone: parent.phone, role: 'PARENT', status: 'INVITED' },\n      });\n      await tx.parentProfile.create({ data: { userId: parentUser.id } });\n      createdParents += 1;\n      createdUserIds.push(parentUser.id);\n    }\n    await linkParentToStudentTx(tx, {\n      studentId: user.id,\n      parentId: parentUser.id,\n      relationship: parent.relationship,\n      isPrimary: row.parents[0] === parent,\n    });\n  }\n\n  return { createdParents, linkedExistingParents, createdUserIds };\n}\n\nasync function createTeacherRow(tx: TxClient, data: Record<string, unknown>) {\n  const row = data as z.infer<typeof teacherCsvRowSchema>;\n  const user = await tx.user.create({\n    data: { firstName: row.first_name, lastName: row.last_name, email: row.email, phone: row.phone, role: 'TEACHER', status: 'INVITED' },\n  });\n  await tx.teacherProfile.create({ data: { userId: user.id, employeeNumber: row.employee_number, title: row.title } });\n  return { createdUserIds: [user.id] };\n}\n\nexport async function importUsers(type: ImportType, rows: unknown[], sendInvites: boolean): Promise<ImportSummary> {\n  const rowResults: ImportRowResult[] = [];\n  let createdPrimary = 0;\n  let createdParents = 0;\n  let linkedExistingParents = 0;\n  let skipped = 0;\n  let failed = 0;\n  const allCreatedUserIds: string[] = [];\n\n  for (let start = 0; start < rows.length; start += BATCH_SIZE) {\n    const batch = rows.slice(start, start + BATCH_SIZE);\n    const plan = await Promise.all(batch.map((raw, i) => planRow(prisma, type, start + i, raw)));\n    const hasError = plan.some((p) => p.status === 'error');\n\n    if (hasError) {\n      for (const p of plan) {\n        failed += 1;\n        rowResults.push({\n          rowIndex: p.rowIndex,\n          result: 'error',\n          reason: p.status === 'error' ? p.reason : 'Batch rolled back: another row in this batch failed.',\n        });\n      }\n      continue;\n    }\n\n    const validPlans = plan.filter((p): p is PlannedRow & { status: 'valid' } => p.status === 'valid');\n    if (validPlans.length > 0) {\n      await prisma.$transaction(async (tx) => {\n        for (const p of validPlans) {\n          if (type === 'STUDENTS') {\n            const result = await createStudentRow(tx, p.data);\n            createdParents += result.createdParents;\n            linkedExistingParents += result.linkedExistingParents;\n            allCreatedUserIds.push(...result.createdUserIds);\n          } else {\n            const result = await createTeacherRow(tx, p.data);\n            allCreatedUserIds.push(...result.createdUserIds);\n          }\n          createdPrimary += 1;\n        }\n      });\n    }\n\n    for (const p of plan) {\n      if (p.status === 'skip') {\n        skipped += 1;\n        rowResults.push({ rowIndex: p.rowIndex, result: 'skipped', reason: p.reason });\n      } else {\n        rowResults.push({ rowIndex: p.rowIndex, result: 'created', reason: null });\n      }\n    }\n  }\n\n  if (sendInvites) {\n    await Promise.all(allCreatedUserIds.map((id) => sendInvite(id)));\n  }\n\n  rowResults.sort((a, b) => a.rowIndex - b.rowIndex);\n\n  // Contract (api-contracts.json) reuses `createdStudents` as the primary-row\n  // created count for both import types — there is no `createdTeachers` field.\n  return { createdStudents: createdPrimary, createdParents, linkedExistingParents, skipped, failed, rowResults };\n}\n","numLines":234,"startLine":1,"totalLines":234}}}
