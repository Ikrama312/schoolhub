{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017h6CBJbDkXgv5jWQqbNRUF","type":"tool_result","content":"import { prisma } from '@/server/db';\nimport { AppShell } from './shell';\n\nexport default async function AppLayout({ children }: { children: React.ReactNode }) {\n  const settings = await prisma.schoolSettings.findUnique({ where: { id: 'singleton' } });\n\n  return <AppShell schoolShortName={settings?.shortName ?? 'SchoolHub'}>{children}</AppShell>;\n}\n'use client';\n\nimport Box from '@mui/material/Box';\nimport AppBar from '@mui/material/AppBar';\nimport Toolbar from '@mui/material/Toolbar';\nimport Drawer from '@mui/material/Drawer';\nimport List from '@mui/material/List';\nimport ListItemButton from '@mui/material/ListItemButton';\nimport ListItemIcon from '@mui/material/ListItemIcon';\nimport ListItemText from '@mui/material/ListItemText';\nimport ListSubheader from '@mui/material/ListSubheader';\nimport { Fragment, useEffect, useState } from 'react';\nimport IconButton from '@mui/material/IconButton';\nimport Typography from '@mui/material/Typography';\nimport Tooltip from '@mui/material/Tooltip';\nimport Menu from '@mui/material/Menu';\nimport MenuItem from '@mui/material/MenuItem';\nimport Divider from '@mui/material/Divider';\nimport Chip from '@mui/material/Chip';\nimport useMediaQuery from '@mui/material/useMediaQuery';\nimport { useColorScheme } from '@mui/material/styles';\nimport Link from 'next/link';\nimport { usePathname } from 'next/navigation';\nimport MenuIcon from '@mui/icons-material/Menu';\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\nimport ChevronRightIcon from '@mui/icons-material/ChevronRight';\nimport LightModeIcon from '@mui/icons-material/LightMode';\nimport DarkModeIcon from '@mui/icons-material/DarkMode';\nimport PersonOutlineIcon from '@mui/icons-material/PersonOutlineOutlined';\nimport LogoutIcon from '@mui/icons-material/Logout';\nimport { navigationForRole, type Role } from '@/config/navigation';\nimport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\nimport { NotificationBell } from '@/components/NotificationBell/NotificationBell';\n\nconst DRAWER_WIDTH_EXPANDED = 256;\nconst DRAWER_WIDTH_COLLAPSED = 64;\nconst COLLAPSE_STORAGE_KEY = 'schoolhub.sidebar.collapsed';\n\n// Placeholder user until PRD-01 wires real auth (FR-33's \"for later wiring\" note).\nconst PLACEHOLDER_USER: { id: string; name: string; role: Role } = {\n  id: 'placeholder-user',\n  name: 'Guest User',\n  role: 'ADMIN',\n};\n\nexport interface AppShellProps {\n  schoolShortName: string;\n  children: React.ReactNode;\n}\n\nconst DESKTOP_BREAKPOINT_PX = 1024;\n\nexport function AppShell({ schoolShortName, children }: AppShellProps) {\n  const { mode, setMode } = useColorScheme();\n  const pathname = usePathname();\n  // FR-31/NFR-4 fix the fork at exactly 1024px — MUI's own \"lg\" breakpoint\n  // (1200px) doesn't match that, so this uses an explicit media query.\n  const isDesktop = useMediaQuery(`(min-width:${DESKTOP_BREAKPOINT_PX}px)`);\n\n  const [collapsed, setCollapsed] = useState(false);\n  const [mobileOpen, setMobileOpen] = useState(false);\n  const [menuAnchor, setMenuAnchor] = useState<HTMLElement | null>(null);\n\n  useEffect(() => {\n    const stored = window.localStorage.getItem(COLLAPSE_STORAGE_KEY);\n    if (stored === 'true') setCollapsed(true);\n  }, []);\n\n  const toggleCollapsed = () => {\n    setCollapsed((prev) => {\n      const next = !prev;\n      window.localStorage.setItem(COLLAPSE_STORAGE_KEY, String(next));\n      return next;\n    });\n  };\n\n  const drawerWidth = collapsed ? DRAWER_WIDTH_COLLAPSED : DRAWER_WIDTH_EXPANDED;\n  const items = navigationForRole(PLACEHOLDER_USER.role);\n\n  const navList = (\n    <List sx={{ pt: 1 }}>\n      {items.map((item, index) => {\n        const Icon = item.icon;\n        // Subheader above the first item of each consecutive group run; hidden when collapsed.\n        const showGroup =\n          item.group && item.group !== items[index - 1]?.group && !(collapsed && isDesktop);\n        const active = pathname === item.href || pathname.startsWith(`${item.href}/`);\n        const button = (\n          <ListItemButton\n            key={item.href}\n            component={Link}\n            href={item.href}\n            selected={active}\n            onClick={() => setMobileOpen(false)}\n            sx={{ justifyContent: collapsed && isDesktop ? 'center' : 'flex-start' }}\n          >\n            <ListItemIcon sx={{ minWidth: collapsed && isDesktop ? 0 : 40, justifyContent: 'center' }}>\n              <Icon />\n            </ListItemIcon>\n            {!(collapsed && isDesktop) && <ListItemText primary={item.label} />}\n          </ListItemButton>\n        );\n        return (\n          <Fragment key={item.href}>\n            {showGroup && (\n              <ListSubheader disableSticky sx={{ lineHeight: 2.5, bgcolor: 'transparent' }}>\n                {item.group}\n              </ListSubheader>\n            )}\n            {collapsed && isDesktop ? (\n              <Tooltip title={item.label} placement=\"right\">\n                {button}\n              </Tooltip>\n            ) : (\n              button\n            )}\n          </Fragment>\n        );\n      })}\n    </List>\n  );\n\n  return (\n    <Box sx={{ display: 'flex', minHeight: '100vh' }}>\n      <AppBar\n        position=\"fixed\"\n        sx={{\n          zIndex: (t) => t.zIndex.drawer + 1,\n          ...(isDesktop\n            ? { width: `calc(100% - ${drawerWidth}px)`, ml: `${drawerWidth}px` }\n            : {}),\n        }}\n      >\n        <Toolbar sx={{ gap: 1 }}>\n          {!isDesktop && (\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Open navigation\"\n              edge=\"start\"\n              onClick={() => setMobileOpen(true)}\n            >\n              <MenuIcon />\n            </IconButton>\n          )}\n          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n            {schoolShortName}\n          </Typography>\n\n          <NotificationBell />\n\n          <Tooltip title={mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}>\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Toggle color mode\"\n              onClick={() => setMode(mode === 'dark' ? 'light' : 'dark')}\n            >\n              {mode === 'dark' ? <LightModeIcon /> : <DarkModeIcon />}\n            </IconButton>\n          </Tooltip>\n\n          <IconButton onClick={(event) => setMenuAnchor(event.currentTarget)} aria-label=\"User menu\">\n            <UserAvatar userId={PLACEHOLDER_USER.id} name={PLACEHOLDER_USER.name} size={32} />\n          </IconButton>\n          <Menu anchorEl={menuAnchor} open={Boolean(menuAnchor)} onClose={() => setMenuAnchor(null)}>\n            <Box sx={{ px: 2, py: 1 }}>\n              <Typography variant=\"subtitle2\">{PLACEHOLDER_USER.name}</Typography>\n              <Chip size=\"small\" label={PLACEHOLDER_USER.role} sx={{ mt: 0.5 }} />\n            </Box>\n            <Divider />\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <PersonOutlineIcon fontSize=\"small\" sx={{ mr: 1 }} /> Profile\n            </MenuItem>\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <LogoutIcon fontSize=\"small\" sx={{ mr: 1 }} /> Sign out\n            </MenuItem>\n          </Menu>\n        </Toolbar>\n      </AppBar>\n\n      {isDesktop ? (\n        <Drawer\n          variant=\"permanent\"\n          sx={{\n            width: drawerWidth,\n            flexShrink: 0,\n            [`& .MuiDrawer-paper`]: { width: drawerWidth, boxSizing: 'border-box', overflowX: 'hidden' },\n          }}\n        >\n          <Toolbar />\n          {navList}\n          <Box sx={{ mt: 'auto', display: 'flex', justifyContent: 'flex-end', p: 1 }}>\n            <IconButton onClick={toggleCollapsed} aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}>\n              {collapsed ? <ChevronRightIcon /> : <ChevronLeftIcon />}\n            </IconButton>\n          </Box>\n        </Drawer>\n      ) : (\n        <Drawer\n          variant=\"temporary\"\n          open={mobileOpen}\n          onClose={() => setMobileOpen(false)}\n          ModalProps={{ keepMounted: true }}\n          sx={{ [`& .MuiDrawer-paper`]: { width: DRAWER_WIDTH_EXPANDED, boxSizing: 'border-box' } }}\n        >\n          <Toolbar />\n          {navList}\n        </Drawer>\n      )}\n\n      <Box\n        component=\"main\"\n        sx={{\n          flexGrow: 1,\n          p: 3,\n          width: isDesktop ? `calc(100% - ${drawerWidth}px)` : '100%',\n        }}\n      >\n        <Toolbar />\n        {children}\n      </Box>\n    </Box>\n  );\n}\nimport { cache } from 'react';\nimport { headers } from 'next/headers';\nimport { redirect } from 'next/navigation';\nimport { AppError } from '@/server/http';\nimport { auth } from '@/server/auth/auth';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side authorization (FR-28, FR-29, ADR-2).\n * Route handlers use requireUser/requireRole (throw AppError → 401/403 via\n * withHandler); server pages/layouts use requirePageUser/requirePageRole\n * (redirect to /login or /forbidden).\n */\nexport interface SessionUser {\n  id: string;\n  role: Role;\n  firstName: string;\n  lastName: string;\n  email: string;\n}\n\nexport const getCurrentUser = cache(async (): Promise<SessionUser | null> => {\n  const user = (await auth())?.user;\n  if (!user?.id) return null;\n  return { id: user.id, role: user.role, firstName: user.firstName, lastName: user.lastName, email: user.email };\n});\n\ntype Check = { user: SessionUser } | { error: 'UNAUTHENTICATED' | 'FORBIDDEN' };\n\nasync function resolve(roles: Role[]): Promise<Check> {\n  const user = await getCurrentUser();\n  if (!user) return { error: 'UNAUTHENTICATED' };\n  if (roles.length && !roles.includes(user.role)) return { error: 'FORBIDDEN' };\n  return { user };\n}\n\nexport async function requireRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  throw result.error === 'UNAUTHENTICATED'\n    ? new AppError('UNAUTHENTICATED', 'You must be signed in.')\n    : new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n}\n\nexport async function requireUser(): Promise<SessionUser> {\n  return requireRole();\n}\n\nexport async function requirePageRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  if (result.error === 'FORBIDDEN') redirect('/forbidden');\n  const callbackUrl = headers().get('x-pathname') ?? '/dashboard';\n  redirect(`/login?callbackUrl=${encodeURIComponent(callbackUrl)}`);\n}\n\nexport async function requirePageUser(): Promise<SessionUser> {\n  return requirePageRole();\n}\nimport { createHash, randomBytes, timingSafeEqual } from 'node:crypto';\nimport type { AuthToken, AuthTokenType, Prisma, User } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\n\n/**\n * The only code that touches AuthToken (FR-13, NFR-1). Raw tokens are\n * returned to the caller once and never stored; only sha256(raw) hex is.\n */\n\ntype Tx = Prisma.TransactionClient;\n\n/** Invite token lifetime; the invite email's expiry date reads this too (PRD-04 FR-15). */\nexport const INVITE_TTL = { days: 7 } as const;\n\nexport function hashToken(raw: string): string {\n  return createHash('sha256').update(raw).digest('hex');\n}\n\n/** Invalidates the user's older unused tokens of `type`, then issues a new one. Returns the raw token. */\nexport async function createToken(\n  userId: string,\n  type: AuthTokenType,\n  ttl: { minutes?: number; days?: number },\n  tx?: Tx,\n): Promise<string> {\n  const raw = randomBytes(32).toString('base64url');\n  const now = new Date();\n  const ttlMs = ((ttl.days ?? 0) * 24 * 60 + (ttl.minutes ?? 0)) * 60_000;\n\n  const run = async (client: Tx) => {\n    await client.authToken.updateMany({ where: { userId, type, usedAt: null }, data: { usedAt: now } });\n    await client.authToken.create({\n      data: { userId, type, tokenHash: hashToken(raw), expiresAt: new Date(now.getTime() + ttlMs) },\n    });\n  };\n  if (tx) await run(tx);\n  else await prisma.$transaction(run);\n  return raw;\n}\n\nexport type VerifiedToken = {\n  token: AuthToken;\n  user: Pick<User, 'id' | 'email' | 'firstName' | 'lastName' | 'status'>;\n};\n\n/** Returns the token + user, or null if missing, wrong type, used or expired. */\nexport async function verifyToken(raw: string, type: AuthTokenType): Promise<VerifiedToken | null> {\n  if (!raw) return null;\n  const hash = hashToken(raw);\n  const token = await prisma.authToken.findUnique({\n    where: { tokenHash: hash },\n    include: { user: { select: { id: true, email: true, firstName: true, lastName: true, status: true } } },\n  });\n  if (!token) return null;\n  if (!timingSafeEqual(Buffer.from(token.tokenHash, 'hex'), Buffer.from(hash, 'hex'))) return null;\n  if (token.type !== type || token.usedAt || token.expiresAt <= new Date()) return null;\n  const { user, ...rest } = token;\n  return { token: rest, user };\n}\n\n/** Marks the token used; throws INVALID_TOKEN if it was already consumed (double submit). */\nexport async function consumeToken(tokenId: string, tx?: Tx): Promise<void> {\n  const { count } = await (tx ?? prisma).authToken.updateMany({\n    where: { id: tokenId, usedAt: null },\n    data: { usedAt: new Date() },\n  });\n  if (count === 0) throw new AppError('INVALID_TOKEN', 'This link is invalid or has expired.');\n}\nnotifications","is_error":false}]},"parent_tool_use_id":null,"session_id":"3418fb08-df3a-4486-bb21-2c26927907e3","uuid":"1f2797b9-8da0-432e-837e-5182ab6f2af4","timestamp":"2026-11-05T06:59:28.100Z","to