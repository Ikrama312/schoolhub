t.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n133-}\n134-\n135-export function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n136-  return schema.parse(Object.fromEntries(searchParams.entries()));\n137-}\nimport { defineConfig } from 'vitest/config.js';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\nimport { describe, it, expect } from 'vitest';\nimport { computeLockout } from '@/server/auth/credentials';\n\ndescribe('computeLockout', () => {\n  const now = new Date('2026-11-04T12:00:00Z');\n\n  it('keeps counting below 5 failures', () => {\n    expect(computeLockout(1, now)).toEqual({ failedLoginCount: 1, lockedUntil: null });\n    expect(computeLockout(4, now)).toEqual({ failedLoginCount: 4, lockedUntil: null });\n  });\n\n  it('locks for 15 minutes and resets the count at 5', () => {\n    expect(computeLockout(5, now)).toEqual({\n      failedLoginCount: 0,\n      lockedUntil: new Date('2026-11-04T12:15:00Z'),\n.env:4:DATABASE_URL=\"postgresql://***@localhost:5433/schoolhub?schema=public\"\n.env.example:3:DATABASE_URL=\"postgresql://***@localhost:5432/schoolhub?schema=public\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018feFRKVa7bomkcZT8P3QQf","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
