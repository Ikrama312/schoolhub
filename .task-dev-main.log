{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjE4HG9k3NkUix83tYUe","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QS8Y2Grs26JmPUMQe13BL2","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/timetable/clash-rules.ts","content":"/**\n * Pure clash engine (PRD-06 FR-9..FR-14, ADR-4). No Prisma import, so the\n * NFR-11 unit tests run without a DB. timetable-service.ts loads the rows,\n * this decides. Every rule runs; all clashes are returned (FR-14).\n */\n\nexport type ClashRule = 'TEACHER' | 'ROOM' | 'SECTION' | 'STUDENT' | 'PERIOD_KIND' | 'NON_TEACHING_DAY';\nexport type Clash = { rule: ClashRule; message: string };\n\nexport interface CandidateCourse {\n  id: string;\n  code: string;\n  teacherId: string;\n  coTeacherIds: string[];\n  sectionId: string | null;\n  sectionName?: string | null;\n  subjectName: string;\n}\n\nexport interface OtherSlot {\n  id: string;\n  roomId: string | null;\n  roomName?: string | null;\n  course: CandidateCourse;\n}\n\nexport interface CellCtx {\n  dayLabel: string;\n  period: { name: string; kind: string };\n  isTeaching: boolean;\n}\n\nexport interface ClashOptions {\n  /** userId → display name, for the TEACHER message (co-teachers included). */\n  teacherNames?: Map<string, string>;\n  /** The moving slot itself, skipped on a PATCH (FR-14). */\n  excludeSlotId?: string;\n}\n\nconst teachersOf = (c: CandidateCourse) => [c.teacherId, ...c.coTeacherIds];\n\nexport function clashesForCell(\n  course: CandidateCourse,\n  roomId: string | null,\n  cell: CellCtx,\n  others: OtherSlot[],\n  overlapByCourseId: Map<string, number>,\n  opts: ClashOptions = {},\n): Clash[] {\n  const at = `on ${cell.dayLabel}, ${cell.period.name}.`;\n  const rest = others.filter((o) => o.id !== opts.excludeSlotId);\n  const clashes: Clash[] = [];\n\n  if (cell.period.kind !== 'CLASS') {\n    clashes.push({ rule: 'PERIOD_KIND', message: `Period '${cell.period.name}' is not a class period.` });\n  }\n  if (!cell.isTeaching) {\n    clashes.push({ rule: 'NON_TEACHING_DAY', message: `${cell.dayLabel} is not a teaching day.` });\n  }\n\n  const mine = new Set(teachersOf(course));\n  for (const o of rest) {\n    for (const t of new Set(teachersOf(o.course))) {\n      if (!mine.has(t)) continue;\n      const name = opts.teacherNames?.get(t) ?? 'A teacher';\n      clashes.push({ rule: 'TEACHER', message: `Clash: ${name} already teaches ${o.course.code} ${at}` });\n    }\n  }\n\n  if (roomId) {\n    for (const o of rest) {\n      if (o.roomId !== roomId) continue;\n      clashes.push({ rule: 'ROOM', message: `Clash: ${o.roomName ?? 'The room'} is used by ${o.course.code} ${at}` });\n    }\n  }\n\n  if (course.sectionId) {\n    for (const o of rest) {\n      if (o.course.sectionId !== course.sectionId) continue;\n      const section = o.course.sectionName ?? course.sectionName ?? 'The section';\n      clashes.push({ rule: 'SECTION', message: `Clash: ${section} already has ${o.course.subjectName} ${at}` });\n    }\n  }\n\n  for (const o of rest) {\n    const n = overlapByCourseId.get(o.course.id) ?? 0;\n    if (n > 0) {\n      clashes.push({\n        rule: 'STUDENT',\n        message: `Clash: ${n} students in ${course.code} also take ${o.course.code} at this time.`,\n      });\n    }\n  }\n\n  return clashes;\n}\n\n/** Half-open [start, end) overlap on 'HH:MM' strings (FR-6). */\nexport function periodsOverlap(\n  a: { startTime: string; endTime: string },\n  b: { startTime: string; endTime: string },\n): boolean {\n  return a.startTime < b.endTime && b.startTime < a.endTime;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1622,"cache_read_input_tokens":103370,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1622},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"df25e571-0ce8-4c8c-9cc6-c89019e911c3","uuid":"3d9803c2-af7b-4dae-ab9c-e1c04548e385","timestamp":"2026-11-05T05:26:29.062Z","request_id":"req_011CgjE4H2kqqQWiTAxQPGMG","wire_tool_inputs":{"toolu_01QS8Y2Grs26JmPUMQe13BL2":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/timetable/clash-rules.ts","content":"/**\n * Pure clash engine (PRD-06 FR-9..FR-14, ADR-4). No Prisma import, so the\n * NFR-11 unit tests run without a DB. timetable-service.ts loads the rows,\n * this decides. Every rule runs; all clashes are returned (FR-14).\n */\n\nexport type ClashRule = 'TEACHER' | 'ROOM' | 'SECTION' | 'STUDENT' | 'PERIOD_KIND' | 'NON_TEACHING_DAY';\nexport type Clash = { rule: ClashRule; message: string };\n\nexport interface CandidateCourse {\n  id: string;\n  code: string;\n  teacherId: string;\n  coTeacherIds: string[];\n  sectionId: string | null;\n  sectionName?: string | null;\n  subjectName: string;\n}\n\nexport interface OtherSlot {\n  id: string;\n  roomId: string | null;\n  roomName?: string | null;\n  course: CandidateCourse;\n}\n\nexport interface CellCtx {\n  dayLabel: string;\n  period: { name: string; kind: string };\n  isTeaching: boolean;\n}\n\nexport interface ClashOptions {\n  /** userId → display name, for the TEACHER message (co-teachers included). */\n  teacherNames?: Map<string, string>;\n  /** The moving slot itself, skipped on a PATCH (FR-14). */\n  excludeSlotId?: string;\n}\n\nconst teachersOf = (c: CandidateCourse) => [c.teacherId, ...c.coTeacherIds];\n\nexport function clashesForCell(\n  course: CandidateCourse,\n  roomId: string | null,\n  cell: CellCtx,\n  others: OtherSlot[],\n  overlapByCourseId: Map<string, number>,\n  opts: ClashOptions = {},\n): Clash[] {\n  const at = `on ${cell.dayLabel}, ${cell.period.name}.`;\n  const rest = others.filter((o) => o.id !== opts.excludeSlotId);\n  const clashes: Clash[] = [];\n\n  if (cell.period.kind !== 'CLASS') {\n    clashes.push({ rule: 'PERIOD_KIND', message: `Period '${cell.period.name}' is not a class period.` });\n  }\n  if (!cell.isTeaching) {\n    clashes.push({ rule: 'NON_TEACHING_DAY', message: `${cell.dayLabel} is not a teaching day.` });\n  }\n\n  const mine = new Set(teachersOf(course));\n  for (const o of rest) {\n    for (const t of new Set(teachersOf(o.course))) {\n      if (!mine.has(t)) continue;\n      const name = opts.teacherNames?.get(t) ?? 'A teacher';\n      clashes.push({ rule: 'TEACHER', message: `Clash: ${name} already teaches ${o.course.code} ${at}` });\n    }\n  }\n\n  if (roomId) {\n    for (const o of rest) {\n      if (o.roomId !== roomId) continue;\n      clashes.push({ rule: 'ROOM', message: `Clash: ${o.roomName ?? 'The room'} is used by ${o.course.code} ${at}` });\n    }\n  }\n\n  if (course.sectionId) {\n    for (const o of rest) {\n      if (o.course.sectionId !== course.sectionId) continue;\n      const section = o.course.sectionName ?? course.sectionName ?? 'The section';\n      clashes.push({ rule: 'SECTION', message: `Clash: ${section} already has ${o.course.subjectName} ${at}` });\n    }\n  }\n\n  for (const o of rest) {\n    const n = overlapByCourseId.get(o.course.id) ?? 0;\n    if (n > 0) {\n      clashes.push({\n        rule: 'STUDENT',\n        message: `Clash: ${n} students in ${course.code} also take ${o.course.code} at this time.`,\n      });\n    }\n  }\n\n  return clashes;\n}\n\n/** Half-open [start, end) overlap on 'HH:MM' strings (FR-6). */\nexport function periodsOverlap(\n  a: { startTime: string; endTime: string },\n  b: { startTime: string; endTime: string },\n): boolean {\n  return a.startTime < b.endTime && b.startTime < a.endTime;\n}\n"}}}
