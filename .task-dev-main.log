{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HFZuB5SuDELoSvvg3AGd8t","type":"tool_result","content":"1\timport { z } from 'zod';\n2\t\n3\t/**\n4\t * Single source of truth for user/profile validation (FR-10, FR-19, FR-20).\n5\t * Reused as: the React Hook Form resolver for the create/edit Stepper, the\n6\t * CSV row validator for the import preview grid (client), and the\n7\t * server-side re-validator in /api/users/import (never trusts the client).\n8\t */\n9\t\n10\texport const PHONE_REGEX = /^\\+?[0-9 ()-]{7,20}$/;\n11\tconst EMAIL_REGEX = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n12\tconst STRICT_DATE_REGEX = /^\\d{4}-\\d{2}-\\d{2}$/;\n13\t\n14\tfunction emptyToUndefined(value: unknown) {\n15\t  return value === '' || value === null ? undefined : value;\n16\t}\n17\t\n18\texport const phoneSchema = z.string().regex(PHONE_REGEX, 'Phone must look like +1 555-123-4567');\n19\texport const optionalPhoneSchema = z.preprocess(emptyToUndefined, phoneSchema.optional());\n20\t\n21\texport const requiredEmailSchema = z.string().regex(EMAIL_REGEX, 'Invalid email address');\n22\texport const optionalEmailSchema = z.preprocess(emptyToUndefined, requiredEmailSchema.optional());\n23\t\n24\t/** Parses a strict YYYY-MM-DD string (CSV / date-only API input) into a Date. */\n25\texport function strictDateSchema(label: string) {\n26\t  return z\n27\t    .string()\n28\t    .regex(STRICT_DATE_REGEX, `${label} must be in YYYY-MM-DD format`)\n29\t    .refine((value) => !Number.isNaN(Date.parse(value)), `${label} is not a valid date`)\n30\t    .transform((value) => new Date(`${value}T00:00:00.000Z`));\n31\t}\n32\t\n33\texport function calculateAgeYears(dateOfBirth: Date, asOf: Date = new Date()): number {\n34\t  let age = asOf.getUTCFullYear() - dateOfBirth.getUTCFullYear();\n35\t  const monthDiff = asOf.getUTCMonth() - dateOfBirth.getUTCMonth();\n36\t  if (monthDiff < 0 || (monthDiff === 0 && asOf.getUTCDate() < dateOfBirth.getUTCDate())) {\n37\t    age -= 1;\n38\t  }\n39\t  return age;\n40\t}\n41\t\n42\t/** FR-10: a student's date of birth must make them between 3 and 21 years old. */\n43\texport function isValidStudentAge(dateOfBirth: Date): boolean {\n44\t  const age = calculateAgeYears(dateOfBirth);\n45\t  return age >= 3 && age <= 21;\n46\t}\n47\t\n48\texport const GENDER_VALUES = ['FEMALE', 'MALE', 'OTHER', 'UNDISCLOSED'] as const;\n49\texport const GUARDIAN_RELATIONSHIP_VALUES = ['MOTHER', 'FATHER', 'GUARDIAN', 'GRANDPARENT', 'OTHER'] as const;\n50\texport const ROLE_VALUES = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'] as const;\n51\t\n52\tconst studentDobSchema = z.coerce\n53\t  .date()\n54\t  .refine(isValidStudentAge, { message: 'Student must be between 3 and 21 years old' });\n55\t\n56\t// ---- Form / API body schemas (role-specific profile shapes) ----\n57\t\n58\texport const studentProfileSchema = z.object({\n59\t  dateOfBirth: studentDobSchema,\n60\t  gender: z.enum(GENDER_VALUES).default('UNDISCLOSED'),\n61\t  gradeLevelId: z.string().min(1, 'Grade level is required'),\n62\t  enrollmentDate: z.coerce.date().default(() => new Date()),\n63\t  addressLine1: z.string().optional(),\n64\t  city: z.string().optional(),\n65\t  medicalNotes: z.string().optional(),\n66\t  emergencyContact: z.string().optional(),\n67\t  emergencyPhone: optionalPhoneSchema,\n68\t});\n69\texport type StudentProfileInput = z.infer<typeof studentProfileSchema>;\n70\t\n71\texport const teacherProfileSchema = z.object({\n72\t  title: z.string().optional(),\n73\t  qualifications: z.string().optional(),\n74\t  hireDate: z.coerce.date().optional(),\n75\t});\n76\texport type TeacherProfileInput = z.infer<typeof teacherProfileSchema>;\n77\t\n78\texport const parentProfileSchema = z.object({\n79\t  occupation: z.string().optional(),\n80\t  address: z.string().optional(),\n81\t});\n82\texport type ParentProfileInput = z.infer<typeof parentProfileSchema>;\n83\t\n84\texport const userLinkInputSchema = z.object({\n85\t  linkedUserId: z.string().min(1),\n86\t  relationship: z.enum(GUARDIAN_RELATIONSHIP_VALUES),\n87\t  isPrimary: z.boolean().default(false),\n88\t});\n89\texport type UserLinkInput = z.infer<typeof userLinkInputSchema>;\n90\t\n91\texport const createUserSchema = z.object({\n92\t  firstName: z.string().min(1, 'First name is required'),\n93\t  lastName: z.string().min(1, 'Last name is required'),\n94\t  email: requiredEmailSchema,\n95\t  phone: optionalPhoneSchema,\n96\t  role: z.enum(ROLE_VALUES),\n97\t  profile: z.union([studentProfileSchema, teacherProfileSchema, parentProfileSchema]).optional(),\n98\t  links: z.array(userLinkInputSchema).optional(),\n99\t  sendInvite: z.boolean().default(true),\n100\t});\n101\texport type CreateUserInput = z.infer<typeof createUserSchema>;\n102\t\n103\texport const updateUserSchema = z.object({\n104\t  firstName: z.string().min(1).optional(),\n105\t  lastName: z.string().min(1).optional(),\n106\t  email: requiredEmailSchema.optional(),\n107\t  phone: optionalPhoneSchema,\n108\t  profile: z\n109\t    .object({\n110\t      dateOfBirth: z.coerce.date().refine(isValidStudentAge, {\n111\t        message: 'Student must be between 3 and 21 years old',\n112\t      }).optional(),\n113\t      gender: z.enum(GENDER_VALUES).optional(),\n114\t      gradeLevelId: z.string().min(1).optional(),\n115\t      enrollmentDate: z.coerce.date().optional(),\n116\t      addressLine1: z.string().optional(),\n117\t      city: z.string().optional(),\n118\t      medicalNotes: z.string().optional(),\n119\t      emergencyContact: z.string().optional(),\n120\t      emergencyPhone: optionalPhoneSchema,\n121\t      title: z.string().optional(),\n122\t      qualifications: z.string().optional(),\n123\t      hireDate: z.coerce.date().optional(),\n124\t      occupation: z.string().optional(),\n125\t      address: z.string().optional(),\n126\t    })\n127\t    .optional(),\n128\t});\n129\texport type UpdateUserInput = z.infer<typeof updateUserSchema>;\n130\t\n131\texport const meProfileSchema = z.object({\