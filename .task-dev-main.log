(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  shortName  String    @unique\n  order      Int       @unique\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}","originalFile":"generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n","structuredPatch":[{"oldStart":101,"oldLines":3,"newStart":101,"newLines":74,"lines":["   createdAt    DateTime @default(now())","   updatedAt    DateTime @updatedAt"," }","+","+/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true","+/// at a time -- enforced in src/server/services/academicYears.ts's","+/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't","+/// express \"exactly one true\" as a simple unique index).","+model AcademicYear {","+  id        String   @id @default(cuid())","+  name      String   @unique","+  startDate DateTime @db.Date","+  endDate   DateTime @db.Date","+  isCurrent Boolean  @default(false)","+  createdAt DateTime @default(now())","+  updatedAt DateTime @updatedAt","+  terms     Term[]","+}","+","+/// A term (semester/trimester/quarter) inside one academic year. onDelete:","+/// Restrict means the year can't be deleted while it still has terms --","+/// the service layer checks this first to return a friendly 409 instead of","+/// a raw FK error.","+model Term {","+  id             String       @id @default(cuid())","+  academicYearId String","+  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)","+  name           String","+  startDate      DateTime     @db.Date","+  endDate        DateTime     @db.Date","+  order          Int","+  createdAt      DateTime     @default(now())","+  updatedAt      DateTime     @updatedAt","+","+  @@unique([academicYearId, name])","+  @@unique([academicYearId, order])","+}","+","+/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)","+/// reference grade levels, so they're archived instead of deleted.","+model GradeLevel {","+  id         String    @id @default(cuid())","+  name       String    @unique","+  shortName  String    @unique","+  order      Int       @unique","+  archivedAt DateTime?","+  createdAt  DateTime  @default(now())","+  updatedAt  DateTime  @updatedAt","+}","+","+/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in","+/// the service layer, not the DB) so the unique constraint catches","+/// case-insensitive duplicates like \"math\" vs \"MATH\".","+model Subject {","+  id          String    @id @default(cuid())","+  name        String","+  code        String    @unique","+  description String?","+  color       String    @default(\"#4F46E5\")","+  archivedAt  DateTime?","+  createdAt   DateTime  @default(now())","+  updatedAt   DateTime  @updatedAt","+}","+","+/// A physical room classes are scheduled in.","+model Room {","+  id         String    @id @default(cuid())","+  name       String    @unique","+  building   String?","+  capacity   Int?","+  archivedAt DateTime?","+  createdAt  DateTime  @default(now())","+  updatedAt  DateTime  @updatedAt","+}"]}],"userModified":false,"replaceAll":false}}
