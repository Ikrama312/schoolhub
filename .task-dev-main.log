{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AXc84fEPsYkgyknMv96EgB","type":"tool_result","content":"import { createHash, randomUUID } from 'node:crypto';\nimport { createReadStream, createWriteStream } from 'node:fs';\nimport { mkdir, rename, unlink } from 'node:fs/promises';\nimport path from 'node:path';\nimport { Transform, type Readable } from 'node:stream';\nimport { pipeline } from 'node:stream/promises';\nimport { env } from '@/lib/env';\n\n/**\n * Local-disk file storage (PRD-08 FR-2, NFR-5, NFR-11). Single implementation,\n * no interface: bytes live under UPLOAD_DIR (never public/) and are only ever\n * served through GET /api/files/:id.\n */\n\nfunction root(): string {\n  // Read per call so tests can point UPLOAD_DIR at a temp dir.\n  return path.resolve(process.env.UPLOAD_DIR || env.UPLOAD_DIR);\n}\n\n/** Absolute path for a storage key; throws if the key escapes UPLOAD_DIR (traversal guard). */\nexport function resolveKey(storageKey: string): string {\n  const base = root();\n  const full = path.resolve(base, storageKey);\n  if (!full.startsWith(base + path.sep)) throw new Error('Invalid storage key');\n  return full;\n}\n\nexport interface SavedFile {\n  storageKey: string;\n  sizeBytes: number;\n  sha256: string;\n}\n\n/**\n * Streams `stream` to UPLOAD_DIR/.tmp, hashing and counting bytes on the way,\n * then renames to <yyyy>/<mm>/<id>.<ext>. On any stream error (including an\n * abort for oversize/bad type) the tmp file is removed and the error rethrown.\n */\nexport async function saveFile(stream: Readable, meta: { ext: string }): Promise<SavedFile> {\n  const base = root();\n  const id = randomUUID().replace(/-/g, '');\n  const tmpDir = path.join(base, '.tmp');\n  await mkdir(tmpDir, { recursive: true });\n  const tmp = path.join(tmpDir, id);\n\n  const hash = createHash('sha256');\n  let sizeBytes = 0;\n  const tap = new Transform({\n    transform(chunk: Buffer, _enc, cb) {\n      hash.update(chunk);\n      sizeBytes += chunk.length;\n      cb(null, chunk);\n    },\n  });\n\n  try {\n    await pipeline(stream, tap, createWriteStream(tmp));\n  } catch (error) {\n    await unlink(tmp).catch(() => undefined);\n    throw error;\n  }\n\n  const now = new Date();\n  const ext = meta.ext.toLowerCase().replace(/[^a-z0-9]/g, '');\n  const storageKey = `${now.getUTCFullYear()}/${String(now.getUTCMonth() + 1).padStart(2, '0')}/${id}${ext ? `.${ext}` : ''}`;\n  const dest = resolveKey(storageKey);\n  await mkdir(path.dirname(dest), { recursive: true });\n  await rename(tmp, dest);\n  return { storageKey, sizeBytes, sha256: hash.digest('hex') };\n}\n\nexport function readFile(storageKey: string): Readable {\n  return createReadStream(resolveKey(storageKey));\n}\n\n/** Removes stored bytes; a missing file is not an error. */\nexport async function deleteFile(storageKey: string): Promise<void> {\n  try {\n    await unlink(resolveKey(storageKey));\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;\n  }\n}\n/**\n * Pure upload validation (PRD-08 FR-4..FR-7, FR-40, FR-41, ADR-3). No I/O:\n * the caller sniffs the first bytes with file-type and passes the result in.\n */\n\ntype Sniff = 'required' | 'none' | 'zip-or-ooxml';\n\ninterface Rule {\n  /** Stored mimeType -- never taken from the client. */\n  mime: string;\n  sniff: Sniff;\n  /** Sniffed mimes accepted for 'required'/'zip-or-ooxml'. */\n  accept: string[];\n}\n\nconst CFB = 'application/x-cfb';\nconst OOXML = (mime: string): Rule => ({ mime, sniff: 'zip-or-ooxml', accept: ['application/zip', mime] });\n\nexport const ALLOWED: Record<string, Rule> = {\n  pdf: { mime: 'application/pdf', sniff: 'required', accept: ['application/pdf'] },\n  doc: { mime: 'application/msword', sniff: 'required', accept: [CFB] },\n  xls: { mime: 'application/vnd.ms-excel', sniff: 'required', accept: [CFB] },\n  ppt: { mime: 'application/vnd.ms-powerpoint', sniff: 'required', accept: [CFB] },\n  docx: OOXML('application/vnd.openxmlformats-officedocument.wordprocessingml.document'),\n  xlsx: OOXML('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'),\n  pptx: OOXML('application/vnd.openxmlformats-officedocument.presentationml.presentation'),\n  txt: { mime: 'text/plain', sniff: 'none', accept: [] },\n  csv: { mime: 'text/csv', sniff: 'none', accept: [] },\n  png: { mime: 'image/png', sniff: 'required', accept: ['image/png'] },\n  jpg: { mime: 'image/jpeg', sniff: 'required', accept: ['image/jpeg'] },\n  jpeg: { mime: 'image/jpeg', sniff: 'required', accept: ['image/jpeg'] },\n  gif: { mime: 'image/gif', sniff: 'required', accept: ['image/gif'] },\n  webp: { mime: 'image/webp', sniff: 'required', accept: ['image/webp'] },\n  mp3: { mime: 'audio/mpeg', sniff: 'required', accept: ['audio/mpeg'] },\n  mp4: { mime: 'video/mp4', sniff: 'required', accept: ['video/mp4', 'audio/mp4'] },\n  zip: { mime: 'application/zip', sniff: 'required', accept: ['application/zip'] },\n  // FR-41: SVG is text (no signature) and only allowed for the logo context.\n  svg: { mime: 'image/svg+xml', sniff: 'none', accept: [] },\n};\n\nconst LOGO_EXTS = ['png', 'jpg', 'jpeg', 'webp', 'svg'];\nconst NAME_MAX = 150;\n\n/** Lower-case extension without the dot, or '' when there is none. */\nexport function extOf(name: string): string {\n  const dot = name.lastIndexOf('.');\n  return dot > 0 ? name.slice(dot + 1).toLowerCase() : '';\n}\n\n/** FR-7: strip path separators and control chars, trim, cap at 150 chars keeping the extension. */\nexport function sanitizeFilename(name: string): string {\n  // eslint-disable-next-line no-control-regex\n  let clean = name.replace(/[/\\\\\\x00-\\x1f\\x7f]/g, '').trim();\n  if (!clean) clean = 'file';\n  if (clean.length <= NAME_MAX) return clean;\n  const ext = extOf(clean);\n  const suffix = ext && ext.length < 20 ? `.${ext}` : '';\n  return clean.slice(0, NAME_MAX - suffix.length) + suffix;\n}\n\nexport type TypeCheck = { ok: true; mime: string } | { ok: false; error: string };\n\n/**\n * ext: from the sanitised name. sniffed: file-type's mime for the head, or\n * undefined when no signature matched. head: the first bytes (SVG check).\n */\nexport function checkType(ext: string, sniffed: string | undefined, context: string, head?: Buffer): TypeCheck {\n  const error = { ok: false as const, error: `File type .${ext || 'unknown'} is not allowed.` };\n  const rule = ALLOWED[ext];\n  if (!rule) return error;\n  if (context === 'logo' ? !LOGO_EXTS.includes(ext) : ext === 'svg') return error;\n\n  switch (rule.sniff) {\n    case 'none':\n      // Any detected signature (ELF, PE, zip...) behind a text extension is a disguise.\n      if (sniffed !== undefined) return error;\n      if (ext === 'svg' && !(head ?? Buffer.alloc(0)).toString('utf8').toLowerCase().includes('<svg')) return error;\n      return { ok: true, mime: rule.mime };\n    case 'required':\n    case 'zip-or-ooxml':\n      return sniffed !== undefined && rule.accept.includes(sniffed) ? { ok: true, mime: rule.mime } : error;\n  }\n}\n\n/** Per-context byte limit: 2 MB for logos, MAX_UPLOAD_MB otherwise. */\nexport function maxBytesFor(context: string, maxUploadMb: number): number {\n  return (context === 'logo' ? 2 : maxUploadMb) * 1024 * 1024;\n}\nimport type { FileObject } from '@prisma/client';\nimport { registerBuiltInContexts } from './contexts';\n\n/**\n * File access registry (PRD-08 FR-9, NFR-1). Every download goes through\n * canAccessFile. Later PRDs call registerFileAccess for their own contexts.\n */\n\nexport interface FileAccessUser {\n  id: string;\n  role: string;\n}\n\nexport type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\n\n/** Resolvers receive null for anonymous callers; only return true for null if the context is public. */\nexport type FileAccessResolver = (user: FileAccessUser | null, file: FileAccessFile) => boolean | Promise<boolean>;\n\nconst registry = new Map<string, FileAccessResolver>();\n\nexport function registerFileAccess(context: string, resolver: FileAccessResolver): void {\n  registry.set(context, resolver);\n}\n\nconst ownerOrAdmin = (user: FileAccessUser | null, file: FileAccessFile) =>\n  user !== null && (user.role === 'ADMIN' || user.id === file.ownerId);\n\nlet builtInsRegistered = false;\n\n/**\n * Dispatch order: (1) unattached -> owner/ADMIN; (2) registered resolver;\n * (3) unknown context -> owner/ADMIN. Anonymous is denied except where a\n * resolver explicitly accepts null. Resolver errors deny.\n */\nexport async function canAccessFile(user: FileAccessUser | null, file: FileAccessFile): Promise<boolean> {\n  // Lazy so the circular import with contexts.ts never hits an uninitialised registry,\n  // and no caller can forget to load the built-in contexts.\n  if (!builtInsRegistered) {\n    builtInsRegistered = true;\n    registerBuiltInContexts(registerFileAccess);\n  }\n  if (file.contextId === null) return ownerOrAdmin(user, file);\n  const resolver = registry.get(file.context);\n  if (!resolver) return ownerOrAdmin(user, file);\n  try {\n    return (await resolver(user, file)) === true;\n  } catch {\n    return false;\n  }\n}\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n}\nimport type { ContentStatus } from '@prisma/client';\n\n/**\n * Single source of truth for content visibility (PRD-08 FR-18, FR-19, FR-44).\n * Pure: evaluated at read time, no background job. Used by list, get,\n * prev/next, file access, progress and the Learning tab.\n */\n\nexport interface Publishable {\n  status: ContentStatus;\n  publishAt: Date | null;\n}\n\nexport function isVisible(item: Publishable, now: Date): boolean {\n  if (item.status === 'PUBLISHED') return true;\n  return item.status === 'SCHEDULED' && item.publishAt !== null && item.publishAt.getTime() <= now.getTime();\n}\n\n/** A lesson is visible to students/parents only when it AND its module are visible. */\nexport function isLessonVisible(lesson: Publishable, module: Publishable, now: Date): boolean {\n  return isVisible(module, now) && isVisible(lesson, now);\n}\n\n/** ADMIN, or the course's teacher/co-teacher, see drafts and scheduled items. */\nexport function canSeeDrafts(\n  user: { id: string; role: string },\n  course: { teacherId: string; coTeacherIds: string[] },\n): boolean {\n  if (user.role === 'ADMIN') return true;\n  return user.role === 'TEACHER' && (course.teacherId === user.id || course.coTeacherIds.includes(user.id));\n}\n/**\n * Video URL parsing (PRD-08 FR-30). Shared by the Zod validator and the\n * viewer. Only ever emits the two privacy-enhanced origins allowed by the\n * CSP frame-src in next.config.js.\n */\nexport interface ParsedVideo {\n  provider: 'youtube' | 'vimeo';\n  id: string;\n}\n\nconst YT_ID = /^[A-Za-z0-9_-]{6,20}$/;\nconst VIMEO_ID = /^\\d{1,12}$/;\n\nexport function parseVideoUrl(raw: string): ParsedVideo | null {\n  let url: URL;\n  try {\n    url = new URL(raw.trim());\n  } catch {\n    return null;\n  }\n  if (url.protocol !== 'https:' && url.protocol !== 'http:') return null;\n  const host = url.hostname.toLowerCase().replace(/^(www\\.|m\\.)/, '');\n  const firstSegment = url.pathname.split('/').filter(Boolean)[0] ?? '';\n\n  if (host === 'youtube.com' && url.pathname === '/watch') {\n    const id = url.searchParams.get('v') ?? '';\n    return YT_ID.test(id) ? { provider: 'youtube', id } : null;\n  }\n  if (host === 'youtu.be') {\n    return YT_ID.test(firstSegment) ? { provider: 'youtube', id: firstSegment } : null;\n  }\n  if (host === 'vimeo.com') {\n    return VIMEO_ID.test(firstSegment) ? { provider: 'vimeo', id: firstSegment } : null;\n  }\n  return null;\n}\n\nexport function embedUrl(video: ParsedVideo): string {\n  return video.provider === 'youtube'\n    ? `https://www.youtube-nocookie.com/embed/${video.id}`\n    : `https://player.vimeo.com/video/${video.id}`;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"1ed4e388-5ff3-479e-ba38-660b1be74fc5","uuid":"205178af-0e68-4598-9c06-2d019f2df2ef","timestamp":"2026-11-06T23:54:59.133Z","tool_use_result":{"stdout":"import { createHash, randomUUID } from 'node:crypto';\nimport { createReadStream, createWriteStream } from 'node:fs';\nimport { mkdir, rename, unlink } from 'node:fs/promises';\nimport path from 'node:path';\nimport { Transform, type Readable } from 'node:stream';\nimport { pipeline } from 'node:stream/promises';\nimport { env } from '@/lib/env';\n\n/**\n * Local-disk file storage (PRD-08 FR-2, NFR-5, NFR-11). Sing