{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TSycq4Z2SC23PU1TJyLpA7","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { useCallback, useEffect, useState } from 'react';\n4\timport { useRouter, usePathname, useSearchParams } from 'next/navigation';\n5\timport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\n6\timport Box from '@mui/material/Box';\n7\timport TextField from '@mui/material/TextField';\n8\timport InputAdornment from '@mui/material/InputAdornment';\n9\timport SearchIcon from '@mui/icons-material/Search';\n10\timport { EmptyState } from '@/components/EmptyState/EmptyState';\n11\t\n12\tconst SEARCH_DEBOUNCE_MS = 300;\n13\t\n14\texport interface DataTableProps {\n15\t  columns: GridColDef[];\n16\t  rows: readonly Record<string, unknown>[];\n17\t  total: number;\n18\t  loading?: boolean;\n19\t  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n20\t  getRowId?: (row: Record<string, unknown>) => string | number;\n21\t}\n22\t\n23\t/**\n24\t * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n25\t * from (and written to) URL query params, a debounced search box, and the\n26\t * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n27\t * params change — this component owns no fetch logic of its own.\n28\t */\n29\texport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n30\t  const router = useRouter();\n31\t  const pathname = usePathname();\n32\t  const searchParams = useSearchParams();\n33\t\n34\t  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n35\t  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n36\t  const sortField = searchParams.get('sort') ?? undefined;\n37\t  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n38\t\n39\t  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n40\t\n41\t  const updateParams = useCallback(\n42\t    (updates: Record<string, string | undefined>) => {\n43\t      const next = new URLSearchParams(searchParams.toString());\n44\t      for (const [key, value] of Object.entries(updates)) {\n45\t        if (value === undefined || value === '') {\n46\t          next.delete(key);\n47\t        } else {\n48\t          next.set(key, value);\n49\t        }\n50\t      }\n51\t      router.push(`${pathname}?${next.toString()}`);\n52\t    },\n53\t    [pathname, router, searchParams],\n54\t  );\n55\t\n56\t  // Debounce search -> URL param, resetting to page 1.\n57\t  useEffect(() => {\n58\t    const handle = setTimeout(() => {\n59\t      if (searchInput !== (searchParams.get('q') ?? '')) {\n60\t        updateParams({ q: searchInput || undefined, page: '1' });\n61\t      }\n62\t    }, SEARCH_DEBOUNCE_MS);\n63\t    return () => clearTimeout(handle);\n64\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n65\t  }, [searchInput]);\n66\t\n67\t  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n68\t\n69\t  return (\n70\t    <Box>\n71\t      <TextField\n72\t        value={searchInput}\n73\t        onChange={(event) => setSearchInput(event.target.value)}\n74\t        placeholder=\"Search…\"\n75\t        size=\"small\"\n76\t        sx={{ mb: 2, maxWidth: 320 }}\n77\t        InputProps={{\n78\t          startAdornment: (\n79\t            <InputAdornment position=\"start\">\n80\t              <SearchIcon fontSize=\"small\" />\n81\t            </InputAdornment>\n82\t          ),\n83\t        }}\n84\t        inputProps={{ 'aria-label': 'Search' }}\n85\t      />\n86\t      <DataGrid\n87\t        autoHeight\n88\t        columns={columns}\n89\t        rows={rows}\n90\t        rowCount={total}\n91\t        loading={loading}\n92\t        getRowId={getRowId}\n93\t        paginationMode=\"server\"\n94\t        sortingMode=\"server\"\n95\t        paginationModel={{ page: page - 1, pageSize }}\n96\t        onPaginationModelChange={(model) =>\n97\t          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n98\t        }\n99\t        sortModel={sortModel}\n100\t        onSortModelChange={(model) =>\n101\t          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n102\t        }\n103\t        pageSizeOptions={[10, 20, 50, 100]}\n104\t        slots={{\n105\t          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n106\t        }}\n107\t        disableRowSelectionOnClick\n108\t      />\n109\t    </Box>\n110\t  );\n111\t}\n112\t"}]},"parent_tool_use_id":null,"session_id":"39a14436-29b4-4676-8dbf-5a7662c4deb1","uuid":"ab9e7852-c5a5-432e-83d4-9b9d5f82277c","timestamp":"2026-10-19T08:28:19.336Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/DataTable/DataTable.tsx","content":"'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport TextField from '@mui/material/TextField';\nimport InputAdornment from '@mui/material/InputAdornment';\nimport SearchIcon from '@mui/icons-material/Search';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface DataTableProps {\n  columns: GridColDef[];\n  rows: readonly Record<string, unknown>[];\n  total: number;\n  loading?: boolean;\n  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n  getRowId?: (row: Record<string, unknown>) => string | number;\n}\n\n/**\n * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n * from (and written to) URL query params, a debounced search box, and the\n * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n * params change — this component owns no fetch logic of its own.\n */\nexport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const sortField = searchParams.get('sort') ?? undefined;\n  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n\n  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n\n  const updateParams = useCallback(\n    (updates: Record<string, string | undefined>) => {\n      const next = new URLSearchParams(searchParams.toString());\n      for (const [key, value] of Object.entries(updates)) {\n        if (value === undefined || value === '') {\n          next.delete(key);\n        } else {\n          next.set(key, value);\n        }\n      }\n      router.push(`${pathname}?${next.toString()}`);\n    },\n    [pathname, router, searchParams],\n  );\n\n  // Debounce search -> URL param, resetting to page 1.\n  useEffect(() => {\n    const handle = setTimeout(() => {\n      if (searchInput !== (searchParams.get('q') ?? '')) {\n        updateParams({ q: searchInput || undefined, page: '1' });\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [searchInput]);\n\n  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n\n  return (\n    <Box>\n      <TextField\n        value={searchInput}\n        onChange={(event) => setSearchInput(event.target.value)}\n        placeholder=\"Search…\"\n        size=\"small\"\n        sx={{ mb: 2, maxWidth: 320 }}\n        InputProps={{\n          startAdornment: (\n            <InputAdornment position=\"start\">\n              <SearchIcon fontSize=\"small\" />\n            </InputAdornment>\n          ),\n        }}\n        inputProps={{ 'aria-label': 'Search' }}\n      />\n      <DataGrid\n        autoHeight\n        columns={columns}\n        rows={rows}\n        rowCount={total}\n        loading={loading}\n        getRowId={getRowId}\n        paginationMode=\"server\"\n        sortingMode=\"server\"\n        paginationModel={{ page: page - 1, pageSize }}\n        onPaginationModelChange={(model) =>\n          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n        }\n        sortModel={sortModel}\n        onSortModelChange={(model) =>\n          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n        }\n        pageSizeOptions={[10, 20, 50, 100]}\n        slots={{\n          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n        }}\n        disableRowSelectionOnClick\n      />\n    </Box>\n  );\n}\n","numLines":112,"startLine":1,"totalLines":112}}}
