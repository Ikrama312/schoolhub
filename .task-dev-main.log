.hasOwnProperty.call(NOTIFICATION_TYPES, type)\n    ? (NOTIFICATION_TYPES as Record<string, NotificationTypeDef>)[type]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Dp4ir8Gxkdh8PmG6hA6Wkw","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
