{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011DfsFxqNHBJpxy6qftHeH9","type":"tool_result","content":"1\timport type { ComponentType } from 'react';\n2\timport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\n3\t\n4\texport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n5\t\n6\texport interface NavItem {\n7\t  label: string;\n8\t  href: string;\n9\t  icon: ComponentType;\n10\t  roles: Role[];\n11\t}\n12\t\n13\tconst ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n14\t\n15\t/**\n16\t * Sidebar source of truth. A later PRD that adds a page adds its entry here\n17\t * instead of hard-coding links in the shell.\n18\t */\n19\texport const navigation: NavItem[] = [\n20\t  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n21\t];\n22\t\n23\texport function navigationForRole(role: Role): NavItem[] {\n24\t  return navigation.filter((item) => item.roles.includes(role));\n25\t}\n26\t"}]},"parent_tool_use_id":null,"session_id":"26ce942b-d6a7-4ab5-ac09-e89a7a8e3024","uuid":"0cf410f1-9df5-48a3-a257-42f713b70668","timestamp":"2026-10-20T07:00:47.409Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/config/navigation.ts","content":"import type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n}\n\nconst ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\n","numLines":26,"startLine":1,"totalLines":26}}}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgD4LFEHT5Sj45GC75Jqt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VCDUY1KAKWMrjYjsdnV4Pc","name":"Read","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/services/users.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2322,"cache_read_input_tokens":59044,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2322},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"26ce942b-d6a7-4ab5-ac09-e89a7a8e3024","uuid":"1e41e8d5-bb34-49ae-8071-4405bf285f10","timestamp":"2026-10-20T07:00:47.810Z","request_id":"req_011CgD4LExuemxawdVBetLHJ"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VCDUY1KAKWMrjYjsdnV4Pc","type":"tool_result","content":"1\timport type { Prisma, Role, UserStatus } from '@prisma/client';\n2\timport { prisma } from '@/server/db';\n3\timport { AppError } from '@/server/http';\n4\timport { logger } from '@/lib/logger';\n5\timport { linkParentToStudentTx } from '@/server/services/userLinks';\n6\timport {\n7\t  studentProfileSchema,\n8\t  teacherProfileSchema,\n9\t  parentProfileSchema,\n10\t  type CreateUserInput,\n11\t  type UpdateUserInput,\n12\t} from '@/lib/validators/users';\n13\t\n14\ttype TxClient = Prisma.TransactionClient;\n15\t\n16\t/**\n17\t * Core user service (component 2, FR-1..FR-14/FR-31). Every write endpoint\n18\t * under /api/users and /api/me goes through here instead of touching\n19\t * prisma.user directly, so the role-immutability, self/last-admin and\n20\t * admission/employee-number invariants live in exactly one place.\n21\t */\n22\t\n23\t// ---- number generators (FR-1) ----\n24\t// ponytail: zero-padded(4) string ordering breaks past 9999 of either kind\n25\t// in one year/ever; widen the pad or switch to a sequence table if a school\n26\t// actually enrolls that many students/teachers.\n27\t\n28\tasync function generateAdmissionNumber(tx: TxClient): Promise<string> {\n29\t  const prefix = `S${new Date().getUTCFullYear()}-`;\n30\t  const last = await tx.studentProfile.findFirst({\n31\t    where: { admissionNumber: { startsWith: prefix } },\n32\t    orderBy: { admissionNumber: 'desc' },\n33\t  });\n34\t  const next = last ? parseInt(last.admissionNumber.slice(prefix.length), 10) + 1 : 1;\n35\t  return `${prefix}${String(next).padStart(4, '0')}`;\n36\t}\n37\t\n38\tasync function generateEmployeeNumber(tx: TxClient): Promise<string> {\n39\t  const prefix = 'T-';\n40\t  const last = await tx.teacherProfile.findFirst({\n41\t    where: { employeeNumber: { startsWith: prefix } },\n42\t    orderBy: { employeeNumber: 'desc' },\n43\t  });\n44\t  const next = last ? parseInt(last.employeeNumber.slice(prefix.length), 10) + 1 : 1;\n45\t  return `${prefix}${String(next).padStart(4, '0')}`;\n46\t}\n47\t\n48\t// ---- shared read shaping ----\n49\t\n50\tconst detailInclude = {\n51\t  studentProfile: { include: { gradeLevel: true } },\n52\t  teacherProfile: true,\n53\t  parentProfile: true,\n54\t} satisfies Prisma.UserInclude;\n55\t\n56\ttype UserWithProfile = Prisma.UserGetPayload<{ include: typeof detailInclude }>;\n57\t\n58\tfunction buildProfile(user: UserWithProfile): Record<string, unknown> | null {\n59\t  if (user.role === 'STUDENT' && user.studentProfile) {\n60\t    const { userId: _userId, gradeLevel, ...rest } = user.studentProfile;\n61\t    return { ...rest, gradeLevelName: gradeLevel?.name ?? null };\n62\t  }\n63\t  if (user.role === 'TEACHER' && user.teacherProfile) {\n64\t    const { userId: _userId, ...rest } = user.teacherProfile;\n65\t    return rest;\n66\t  }\n67\t  if (user.role === 'PARENT' && user.parentProfile) {\n68\t    const { userId: _userId, ...rest } = user.parentProfile;\n69\t    return rest;\n70\t  }\n71\t  return null;\n72\t}\n73\t\n74\tfunction toUserDto(user: UserWithProfile) {\n75\t  return {\n76\t    id: user.id,\n77\t    firstName: user.firstName,\n78\t    lastName: user.lastName,\n79\t    email: user.email,\n80\t    role: user.role,\n81\t    status: user.status,\n82\t    phone: user.phone,\n83\t    profile: buildProfile(user),\n84\t  };\n85\t}\n86\t\n87\tasync function getUserWithProfile(tx: TxClient | typeof prisma, id: string) {\n88\t  const user = await tx.user.findUnique({ where: { id }, include: detailInclude });\n89\t  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n90\t  return toUserDto(user);\n91\t}\n92\t\n93\tfunction pick<T extends object>(obj: T, keys: (keyof T)[]): Partial<T> {\n94\t  const out: Partial<T> = {};\n95\t  for (const key of keys) {\n96\t    if (obj[key] !== undefined) out[key] = obj[key];\n97\t  }\n98\t  return out;\n99\t}\n100\t\n101\tconst STUDENT_PROFILE_KEYS = [\n102\t  'dateOfBirth',\n103\t  'gender',\n104\t  'gradeLevelId',\n105\t  'enrollmentDate',\n106\t  'addressLine1',\n107\t  'city',\n108\t  'medicalNotes',\n109\t  'emergencyContact',\n110\t  'emergencyPhone',\n111\t] as const;\n112\tconst TEACHER_PROFILE_KEYS = ['title', 'qualifications', 'hireDate'] as const;\n113\tconst PARENT_PROFILE_KEYS = ['occupation', 'address'] as const;\n114\t\n115\t// ---- create / update (FR-1, FR-6..FR-10, FR-15, FR-16) ----\n116\t\n117\texport async function createUser(input: CreateUserInput) {\n118\t  const userId = await prisma.$transaction(async (tx) => {\n119\t    const user = await tx.user.create({\n120\t      data: {\n121\t        firstName: input.firstName,\n122\t        lastName: input.lastName,\n123\t        email: input.email,\n124\t        phone: input.phone,\n125\t        role: input.role,\n126\t        status: 'INVITED',\n127\t      },\n128\t    });\n129\t\n130\t    if (input.role === 'STUDENT') {\n131\t      const profile = studentProfileSchema.parse(input.profile ?? {});\n132\t      const admissionNumber = await generateAdmissionNumber(tx);\n133\t      await tx.studentProfile.create({ data: { userId: user.id, admissionNumber, ...profile } });\n134\t    } else if (input.role === 'TEACHER') {\n135\t      const profile = teacherProfileSchema.parse(input.profile ?? {});\n136\t      const employeeNumber = await generateEmployeeNumber(tx);\n137\t      await tx.teacherProfile.create({ data: { userId: user.id, employeeNumber, ...profile } });\n138\t    } else if (input.role === 'PARENT') {\n139\t      const profile = parentProfileSchema.parse(input.profile ?? {});\n140\t      await tx.parentProfile.create({ data: { userId: user.id, ...profile } });\n141\t    }\n142\t\n143\t    for (const link of input.links ?? []) {\n144\t      if (input.role === 'STUDENT') {\n145\t        await linkParentToStudentTx(tx, {\n146\t          studentId: user.id,\n147\t          parentId: link.linkedUserId,\n148\t          relationship: link.relationship,\n149\t          isPrimary: link.isPrimary,\n150\t        });\n151\t      } else if (input.role === 'PARENT') {\n152\t        await linkParentToStudentTx(tx, {\n153\t          studentId: link.linkedUserId,\n154\t          parentId: user.id,\n155\t          relationship: link.relationship,\n156\t          isPrimary: link.isPrimary,\n157\t        });\n158\t      }\n159\t    }\n160\t\n161\t    return user.id;\n162\t  });\n163\t\n164\t  if (input.sendInvite) {\n165\t    await sendInvite(userId);\n166\t  }\n167\t\n168\t  return getUserWithProfile(prisma, userId);\n169\t}\n170\t\n171\texport async function updateUser(id: string, input: UpdateUserInput) {\n172\t  return prisma.$transaction(async (tx) => {\n173\t    const existing = await tx.user.findUniqueOrThrow({ where: { id } });\n174\t    const emailChanged = input.email !== undefined && input.email !== existing.email;\n175\t\n176\t    await tx.user.update({\n177\t      where: { id },\n178\t      data: {\n179\t        firstName: input.firstName,\n180\t        lastName: input.lastName,\n181\t        email: input.email,\n182\t        phone: input.phone,\n183\t      },\n184\t    });\n185\t\n186\t    if (input.profile) {\n187\t      if (existing.role === 'STUDENT') {\n188\t        const data = pick(input.profile, STUDENT_PROFILE_KEYS);\n189\t        if (Object.keys(data).length > 0) {\n190\t          await tx.studentProfile.update({ where: { userId: id }, data });\n191\t        }\n192\t      } else if (existing.role === 'TEACHER') {\n193\t        const data = pick(input.profile, TEACHER_PROFILE_KEYS);\n194\t        if (Object.keys(data).length > 0) {\n195\t          await tx.teacherProfile.update({ where: { userId: id }, data });\n196\t        }\n197\t      } else if (existing.role === 'PARENT') {\n198\t        const data = pick(input.profile, PARENT_PROFILE_KEYS);\n199\t        if (Object.keys(data).length > 0) {\n200\t          await tx.parentProfile.update({ where: { userId: id }, data });\n201\t        }\n202\t      }\n203\t    }\n204\t\n205\t    if (emailChanged) {\n206\t      // FR-8: a stale invite link must not activate the old address.\n207\t      await tx.authToken.updateMany({\n208\t        where: { userId: id, type: 'INVITE', usedAt: null },\n209\t        data: { usedAt: new Date() },\n210\t      });\n211\t    }\n212\t\n213\t    return getUserWithProfile(tx, id);\n214\t  });\n215\t}\n216\t\n217\t// ---- list / detail (FR-2, FR-3, FR-11, NFR-2) ----\n218\t\n219\texport interface ListUsersFilters {\n220\t  role?: Role[];\n221\t  status?: UserStatus;\n222\t  gradeLevelId?: string;\n223\t  q?: string;\n224\t  includeArchived?: boolean;\n225\t}\n226\t\n227\tfunction searchClauses(q: string): Prisma.UserWhereInput[] {\n228\t  return [\n229\t    { firstName: { contains: q, mode: 'insensitive' } },\n230\t    { lastName: { contains: q, mode: 'insensitive' } },\n231\t    { email: { contains: q, mode: 'insensitive' } },\n232\t    { studentProfile: { admissionNumber: { contains: q, mode: 'insensitive' } } },\n233\t    { teacherProfile: { employeeNumber: { contains: q, mode: 'insensitive' } } },\n234\t  ];\n235\t}\n236\t\n237\texport async function listUsers(filters: ListUsersFilters, pagination: { skip: number; take: number }) {\n238\t  const where: Prisma.UserWhereInput = {\n239\t    ...(filters.role && filters.role.length > 0 ? { role: { in: filters.role } } : {}),\n240\t    ...(filters.status ? { status: filters.status } : {}),\n241\t    ...(filters.includeArchived ? {} : { archivedAt: null }),\n242\t    ...(filters.gradeLevelId ? { studentProfile: { gradeLevelId: filters.gradeLevelId } } : {}),\n243\t    ...(filters.q ? { OR: searchClauses(filters.q) } : {}),\n244\t  };\n245\t\n246\t  // Ordered by (lastName, firstName) to use the composite index (NFR-2).\n247\t  const [rows, total] = await Promise.all([\n248\t    prisma.user.findMany({\n249\t      where,\n250\t      include: { studentProfile: { include: { gradeLevel: true } } },\n251\t      orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }],\n252\t      skip: pagination.skip,\n253\t      take: pagination.take,\n254\t    }),\n255\t    prisma.user.count({ where }),\n256\t  ]);\n257\t\n258\t  return {\n259\t    rows: rows.map((row) => ({\n260\t      id: row.id,\n261\t      firstName: row.firstName,\n262\t      lastName: row.lastName,\n263\t      email: row.email,\n264\t      role: row.role,\n265\t      status: row.status,\n266\t      gradeLevelId: row.studentProfile?.gradeLevelId ?? null,\n267\t      gradeLevelName: row.studentProfile?.gradeLevel.name ?? null,\n268\t      lastLoginAt: row.lastLoginAt,\n269\t      lockedUntil: row.lockedUntil,\n270\t    })),\n271\t    total,\n272\t  };\n273\t}\n274\t\n275\texport async function getUserDetail(id: string) {\n276\t  const user = await prisma.user.findUnique({\n277\t    where: { id },\n278\t    include: {\n279\t      ...detailInclude,\n280\t      parentLinks: { include: { student: { select: { id: true, firstName: true, lastName: true } } } },\n281\t      studentLinks: { include: { parent: { select: { id: true, firstName: true, lastName: true } } } },\n282\t    },\n283\t  });\n284\t  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n285\t\n286\t  const familyLinks =\n287\t    user.role === 'STUDENT'\n288\t      ? user.studentLinks.map((link) => ({\n289\t          id: link.id,\n290\t          linkedUserId: link.parentId,\n291\t          linkedUserName: `${link.parent.firstName} ${link.parent.lastName}`,\n292\t          relationship: link.relationship,\n293\t          isPrimary: link.isPrimary,\n294\t        }))\n295\t      : user.role === 'PARENT'\n296\t        ? user.parentLinks.map((link) => ({\n297\t            id: link.id,\n298\t            linkedUserId: link.studentId,\n299\t            linkedUserName: `${link.student.firstName} ${link.student.lastName}`,\n300\t            relationship: link.relationship,\n301\t            isPrimary: link.isPrimary,\n302\t          }))\n303\t        : [];\n304\t\n305\t  const recentAuditLogs = await prisma.auditLog.findMany({\n306\t    where: { OR: [{ actorId: id }, { entityId: id }] },\n307\t    orderBy: { createdAt: 'desc' },\n308\t    take: 20,\n309\t  });\n310\t\n311\t  return {\n312\t    ...toUserDto(user),\n313\t    lastLoginAt: user.lastLoginAt,\n314\t    familyLinks,\n315\t    recentAuditLogs: recentAuditLogs.map((log) => ({\n316\t      id: log.id,\n317\t      action: log.action,\n318\t      actorId: log.actorId,\n319\t      entityType: log.entityType,\n320\t      entityId: log.entityId,\n321\t      createdAt: log.createdAt,\n322\t    })),\n323\t  };\n324\t}\n325\t\n326\t// ---- status / archive / unlock (FR-12, FR-13, FR-14, FR-31) ----\n327\t\n328\t/** Self-disable and last-active-admin guards shared by setUserStatus/archiveUser. */\n329\tasync function assertNotSelfOrLastAdmin(tx: TxClient, actorId: string, userId: string) {\n330\t  if (actorId === userId) {\n331\t    throw new AppError('VALIDATION_ERROR', 'You cannot disable your own account.');\n332\t  }\n333\t  const target = await tx.user.findUniqueOrThrow({ where: { id: userId } });\n334\t  if (target.role === 'ADMIN') {\n335\t    const activeAdmins = await tx.user.count({\n336\t      where: { role: 'ADMIN', status: 'ACTIVE', archivedAt: null, id: { not: userId } },\n337\t    });\n338\t    if (activeAdmins === 0) {\n339\t      throw new AppError('VALIDATION_ERROR', 'At least one active admin is required.');\n340\t    }\n341\t  }\n342\t}\n343\t\n344\texport async function setUserStatus(actorId: string, userId: string, status: 'ACTIVE' | 'DISABLED') {\n345\t  return prisma.$transaction(async (tx) => {\n346\t    if (status === 'DISABLED') {\n347\t      await assertNotSelfOrLastAdmin(tx, actorId, userId);\n348\t    }\n349\t    return tx.user.update({ where: { id: userId }, data: { status }, select: { id: true, status: true } });\n350\t  });\n351\t}\n352\t\n353\texport async function archiveUser(actorId: string, userId: string) {\n354\t  return prisma.$transaction(async (tx) => {\n355\t    await assertNotSelfOrLastAdmin(tx, actorId, userId);\n356\t    return tx.user.update({\n357\t      where: { id: userId },\n358\t      data: { status: 'DISABLED', archivedAt: new Date() },\n359\t      select: { id: true, status: true, archivedAt: true },\n360\t    });\n361\t  });\n362\t}\n363\t\n364\texport async function restoreUser(userId: string) {\n365\t  return prisma.user.update({\n366\t    where: { id: userId },\n367\t    data: { archivedAt: null },\n368\t    select: { id: true, status: true, archivedAt: true },\n369\t  });\n370\t}\n371\t\n372\t/** FR-31: clears exactly the two lockout fields that exist in the schema today. */\n373\texport async function unlockUser(userId: string) {\n374\t  return prisma.user.update({\n375\t    where: { id: userId },\n376\t    data: { lockedUntil: null, failedLoginCount: 0 },\n377\t    select: { id: true, lockedUntil: true, failedLoginCount: true },\n378\t  });\n379\t}\n380\t\n381\t/**\n382\t * FR-7/FR-12 sequencing dependency (see system-design.md Overview/Component\n383\t * 20): PRD-01's real auth/session has not landed, so this is a stubbed\n384\t * no-op behind the same placeholder convention requireRole.ts establishes.\n385\t * Call sites (POST /api/users/:id/invite, createUser's sendInvite checkbox)\n386\t * do not change when PRD-01 lands and makes this real.\n387\t */\n388\texport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n389\t  logger.info('sendInvite stub called (PRD-01 auth not landed yet)', { userId });\n390\t  return { id: userId, inviteSentAt: new Date() };\n391\t}\n392\t"}]},"parent_tool_use_id":null,"session_id":"26ce942b-d6a7-4ab5-ac09-e89a7a8e3024","uuid":"3faf6d0c-a141-48b9-8175-1361f693cf38","timestamp":"2026-10-20T07:00:47.822Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/services/users.ts","content":"import type { Prisma, Role, UserStatus } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { logger } from '@/lib/logger';\nimport { linkParentToStudentTx } from '@/server/services/userLinks';\nimport {\n  studentProfileSchema,\n  teacherProfileSchema,\n  parentProfileSchema,\n  type CreateUserInput,\n  type UpdateUserInput,\n} from '@/lib/validators/users';\n\ntype TxClient = Prisma.TransactionClient;\n\n/**\n * Core user service (component 2, FR-1..FR-14/FR-31). Every write endpoint\n * under /api/users and /api/me goes through here instead of touching\n * prisma.user directly, so the role-immutability, self/last-admin and\n * admission/employee-number invariants live in exactly one place.\n */\n\n// ---- number generators (FR-1) ----\n// ponytail: zero-padded(4) string ordering breaks past 9999 of either kind\n// in one year/ever; widen the pad or switch to a sequence table if a school\n// actually enrolls that many students/teachers.\n\nasync function generateAdmissionNumber(tx: TxClient): Promise<string> {\n  const prefix = `S${new Date().getUTCFullYear()}-`;\n  const last = await tx.studentProfile.findFirst({\n    where: { admissionNumber: { startsWith: prefix } },\n    orderBy: { admissionNumber: 'desc' },\n  });\n  const next = last ? parseInt(last.admissionNumber.slice(prefix.length), 10) + 1 : 1;\n  return `${prefix}${String(next).padStart(4, '0')}`;\n}\n\nasync function generateEmployeeNumber(tx: TxClient): Promise<string> {\n  const prefix = 'T-';\n  const last = await tx.teacherProfile.findFirst({\n    where: { employeeNumber: { startsWith: prefix } },\n    orderBy: { employeeNumber: 'desc' },\n  });\n  const next = last ? parseInt(last.employeeNumber.slice(prefix.length), 10) + 1 : 1;\n  return `${prefix}${String(next).padStart(4, '0')}`;\n}\n\n// ---- shared read shaping ----\n\nconst detailInclude = {\n  studentProfile: { include: { gradeLevel: true } },\n  teacherProfile: true,\n  parentProfile: true,\n} satisfies Prisma.UserInclude;\n\ntype UserWithProfile = Prisma.UserGetPayload<{ include: typeof detailInclude }>;\n\nfunction buildProfile(user: UserWithProfile): Record<string, unknown> | null {\n  if (user.role === 'STUDENT' && user.studentProfile) {\n    const { userId: _userId, gradeLevel, ...rest } = user.studentProfile;\n    return { ...rest, gradeLevelName: gradeLevel?.name ?? null };\n  }\n  if (user.role === 'TEACHER' && user.teacherProfile) {\n    const { userId: _userId, ...rest } = user.teacherProfile;\n    return rest;\n  }\n  if (user.role === 'PARENT' && user.parentProfile) {\n    const { userId: _userId, ...rest } = user.parentProfile;\n    return rest;\n  }\n  return null;\n}\n\nfunction toUserDto(user: UserWithProfile) {\n  return {\n    id: user.id,\n    firstName: user.firstName,\n    lastName: user.lastName,\n    email: user.email,\n    role: user.role,\n    status: user.status,\n    phone: user.phone,\n    profile: buildProfile(user),\n  };\n}\n\nasync function getUserWithProfile(tx: TxClient | typeof prisma, id: string) {\n  const user = await tx.user.findUnique({ where: { id }, include: detailInclude });\n  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n  return toUserDto(user);\n}\n\nfunction pick<T extends object>(obj: T, keys: (keyof T)[]): Partial<T> {\n  const out: Partial<T> = {};\n  for (const key of keys) {\n    if (obj[key] !== undefined) out[key] = obj[key];\n  }\n  return out;\n}\n\nconst STUDENT_PROFILE_KEYS = [\n  'dateOfBirth',\n  'gender',\n  'gradeLevelId',\n  'enrollmentDate',\n  'addressLine1',\n  'city',\n  'medicalNotes',\n  'emergencyContact',\n  'emergencyPhone',\n] as const;\nconst TEACHER_PROFILE_KEYS = ['title', 'qualifications', 'hireDate'] as const;\nconst PARENT_PROFILE_KEYS = ['occupation', 'address'] as const;\n\n// ---- create / update (FR-1, FR-6..FR-10, FR-15, FR-16) ----\n\nexport async function createUser(input: CreateUserInput) {\n  const userId = await prisma.$transaction(async (tx) => {\n    const user = await tx.user.create({\n      data: {\n        firstName: input.firstName,\n        lastName: input.lastName,\n        email: input.email,\n        phone: input.phone,\n        role: input.role,\n        status: 'INVITED',\n      },\n    });\n\n    if (input.role === 'STUDENT') {\n      const profile = studentProfileSchema.parse(input.profile ?? {});\n      const admissionNumber = await generateAdmissionNumber(tx);\n      await tx.studentProfile.create({ data: { userId: user.id, admissionNumber, ...profile } });\n    } else if (input.role === 'TEACHER') {\n      const profile = teacherProfileSchema.parse(input.profile ?? {});\n      const employeeNumber = await generateEmployeeNumber(tx);\n      await tx.teacherProfile.create({ data: { userId: user.id, employeeNumber, ...profile } });\n    } else if (input.role === 'PARENT') {\n      const profile = parentProfileSchema.parse(input.profile ?? {});\n      await tx.parentProfile.create({ data: { userId: user.id, ...profile } });\n    }\n\n    for (const link of input.links ?? []) {\n      if (input.role === 'STUDENT') {\n        await linkParentToStudentTx(tx, {\n          studentId: user.id,\n          parentId: link.linkedUserId,\n          relationship: link.relationship,\n          isPrimary: link.isPrimary,\n        });\n      } else if (input.role === 'PARENT') {\n        await linkParentToStudentTx(tx, {\n          studentId: link.linkedUserId,\n          parentId: user.id,\n          relationship: link.relationship,\n          isPrimary: link.isPrimary,\n        });\n      }\n    }\n\n    return user.id;\n  });\n\n  if (input.sendInvite) {\n    await sendInvite(userId);\n  }\n\n  return getUserWithProfile(prisma, userId);\n}\n\nexport async function updateUser(id: string, input: UpdateUserInput) {\n  return prisma.$transaction(async (tx) => {\n    const existing = await tx.user.findUniqueOrThrow({ where: { id } });\n    const emailChanged = input.email !== undefined && input.email !== existing.email;\n\n    await tx.user.update({\n      where: { id },\n      data: {\n        firstName: input.firstName,\n        lastName: input.lastName,\n        email: input.email,\n        phone: input.phone,\n      },\n    });\n\n    if (input.profile) {\n      if (existing.role === 'STUDENT') {\n        const data = pick(input.profile, STUDENT_PROFILE_KEYS);\n        if (Object.keys(data).length > 0) {\n          await tx.studentProfile.update({ where: { userId: id }, data });\n        }\n      } else if (existing.role === 'TEACHER') {\n        const data = pick(input.profile, TEACHER_PROFILE_KEYS);\n        if (Object.keys(data).length > 0) {\n          await tx.teacherProfile.update({ where: { userId: id }, data });\n        }\n      } else if (existing.role === 'PARENT') {\n        const data = pick(input.profile, PARENT_PROFILE_KEYS);\n        if (Object.keys(data).length > 0) {\n          await tx.parentProfile.update({ where: { userId: id }, data });\n        }\n      }\n    }\n\n    if (emailChanged) {\n      // FR-8: a stale invite link must not activate the old address.\n      await tx.authToken.updateMany({\n        where: { userId: id, type: 'INVITE', usedAt: null },\n        data: { usedAt: new Date() },\n      });\n    }\n\n    return getUserWithProfile(tx, id);\n  });\n}\n\n// ---- list / detail (FR-2, FR-3, FR-11, NFR-2) ----\n\nexport interface ListUsersFilters {\n  role?: Role[];\n  status?: UserStatus;\n  gradeLevelId?: string;\n  q?: string;\n  includeArchived?: boolean;\n}\n\nfunction searchClauses(q: string): Prisma.UserWhereInput[] {\n  return [\n    { firstName: { contains: q, mode: 'insensitive' } },\n    { lastName: { contains: q, mode: 'insensitive' } },\n    { email: { contains: q, mode: 'insensitive' } },\n    { studentProfile: { admissionNumber: { contains: q, mode: 'insensitive' } } },\n    { teacherProfile: { employeeNumber: { contains: q, mode: 'insensitive' } } },\n  ];\n}\n\nexport async function listUsers(filters: ListUsersFilters, pagination: { skip: number; take: number }) {\n  const where: Prisma.UserWhereInput = {\n    ...(filters.role && filters.role.length > 0 ? { role: { in: filters.role } } : {}),\n    ...(filters.status ? { status: filters.status } : {}),\n    ...(filters.includeArchived ? {} : { archivedAt: null }),\n    ...(filters.gradeLevelId ? { studentProfile: { gradeLevelId: filters.gradeLevelId } } : {}),\n    ...(filters.q ? { OR: searchClauses(filters.q) } : {}),\n  };\n\n  // Ordered by (lastName, firstName) to use the composite index (NFR-2).\n  const [rows, total] = await Promise.all([\n    prisma.user.findMany({\n      where,\n      include: { studentProfile: { include: { gradeLevel: true } } },\n      orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }],\n      skip: pagination.skip,\n      take: pagination.take,\n    }),\n    prisma.user.count({ where }),\n  ]);\n\n  return {\n    rows: rows.map((row) => ({\n      id: row.id,\n      firstName: row.firstName,\n      lastName: row.lastName,\n      email: row.email,\n      role: row.role,\n      status: row.status,\n      gradeLevelId: row.studentProfile?.gradeLevelId ?? null,\n      gradeLevelName: row.studentProfile?.gradeLevel.name ?? null,\n      lastLoginAt: row.lastLoginAt,\n      lockedUntil: row.lockedUntil,\n    })),\n    total,\n  };\n}\n\nexport async function getUserDetail(id: string) {\n  const user = await prisma.user.findUnique({\n    where: { id },\n    include: {\n      ...detailInclude,\n      parentLinks: { include: { student: { select: { id: true, firstName: true, lastName: true } } } },\n      studentLinks: { include: { parent: { select: { id: true, firstName: true, lastName: true } } } },\n    },\n  });\n  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n\n  const familyLinks =\n    user.role === 'STUDENT'\n      ? user.studentLinks.map((link) => ({\n          id: link.id,\n          linkedUserId: link.parentId,\n          linkedUserName: `${link.parent.firstName} ${link.parent.lastName}`,\n          relationship: link.relationship,\n          isPrimary: link.isPrimary,\n        }))\n      : user.role === 'PARENT'\n        ? user.parentLinks.map((link) => ({\n            id: link.id,\n            linkedUserId: link.studentId,\n            linkedUserName: `${link.student.firstName} ${link.student.lastName}`,\n            relationship: link.relationship,\n            isPrimary: link.isPrimary,\n          }))\n        : [];\n\n  const recentAuditLogs = await prisma.auditLog.findMany({\n    where: { OR: [{ actorId: id }, { entityId: id }] },\n    orderBy: { createdAt: 'desc' },\n    take: 20,\n  });\n\n  return {\n    ...toUserDto(user),\n    lastLoginAt: user.lastLoginAt,\n    familyLinks,\n    recentAuditLogs: recentAuditLogs.map((log) => ({\n      id: log.id,\n      action: log.action,\n      actorId: log.actorId,\n      entityType: log.entityType,\n      entityId: log.entityId,\n      createdAt: log.createdAt,\n    })),\n  };\n}\n\n// ---- status / archive / unlock (FR-12, FR-13, FR-14, FR-31) ----\n\n/** Self-disable and last-active-admin guards shared by setUserStatus/archiveUser. */\nasync function assertNotSelfOrLastAdmin(tx: TxClient, actorId: string, userId: string) {\n  if (actorId === userId) {\n    throw new AppError('VALIDATION_ERROR', 'You cannot disable your own account.');\n  }\n  const target = await tx.user.findUniqueOrThrow({ where: { id: userId } });\n  if (target.role === 'ADMIN') {\n    const activeAdmins = await tx.user.count({\n      where: { role: 'ADMIN', status: 'ACTIVE', archivedAt: null, id: { not: userId } },\n    });\n    if (activeAdmins === 0) {\n      throw new AppError('VALIDATION_ERROR', 'At least one active admin is required.');\n    }\n  }\n}\n\nexport async function setUserStatus(actorId: string, userId: string, status: 'ACTIVE' | 'DISABLED') {\n  return prisma.$transaction(async (tx) => {\n    if (status === 'DISABLED') {\n      await assertNotSelfOrLastAdmin(tx, actorId, userId);\n    }\n    return tx.user.update({ where: { id: userId }, data: { status }, select: { id: true, status: true } });\n  });\n}\n\nexport async function archiveUser(actorId: string, userId: string) {\n  return prisma.$transaction(async (tx) => {\n    await assertNotSelfOrLastAdmin(tx, actorId, userId);\n    return tx.user.update({\n      where: { id: userId },\n      data: { status: 'DISABLED', archivedAt: new Date() },\n      select: { id: true, status: true, archivedAt: true },\n    });\n  });\n}\n\nexport async function restoreUser(userId: string) {\n  return prisma.user.update({\n    where: { id: userId },\n    data: { archivedAt: null },\n    select: { id: true, status: true, archivedAt: true },\n  });\n}\n\n/** FR-31: clears exactly the two lockout fields that exist in the schema today. */\nexport async function unlockUser(userId: string) {\n  return prisma.user.update({\n    where: { id: userId },\n    data: { lockedUntil: null, failedLoginCount: 0 },\n    select: { id: true, lockedUntil: true, failedLoginCount: true },\n  });\n}\n\n/**\n * FR-7/FR-12 sequencing dependency (see system-design.md Overview/Component\n * 20): PRD-01's real auth/session has not landed, so this is a stubbed\n * no-op behind the same placeholder convention requireRole.ts establishes.\n * Call sites (POST /api/users/:id/invite, createUser's sendInvite checkbox)\n * do not change when PRD-01 lands and makes this real.\n */\nexport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n  logger.info('sendInvite stub called (PRD-01 auth not landed yet)', { userId });\n  return { id: userId, inviteSentAt: new Date() };\n}\n","numLines":392,"startLine":1,"totalLines":392}}}
