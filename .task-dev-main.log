{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AZymzNHncmdqGLMaNjTEHu","type":"tool_result","content":"'use client';\n\nimport { Controller, type Control, type FieldValues, type Path } from 'react-hook-form';\nimport TextField, { type TextFieldProps } from '@mui/material/TextField';\nimport MenuItem from '@mui/material/MenuItem';\nimport Checkbox from '@mui/material/Checkbox';\nimport Switch from '@mui/material/Switch';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormControl from '@mui/material/FormControl';\nimport FormLabel from '@mui/material/FormLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Radio from '@mui/material/Radio';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { DateTimePicker } from '@mui/x-date-pickers/DateTimePicker';\n\ninterface BaseProps<TFieldValues extends FieldValues> {\n  name: Path<TFieldValues>;\n  control: Control<TFieldValues>;\n  label: string;\n  helperText?: string;\n}\n\n/** Plain text / number / etc. MUI TextField bound via Controller. */\nexport function TextFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  ...rest\n}: BaseProps<TFieldValues> & Omit<TextFieldProps, 'name' | 'label' | 'error' | 'helperText'>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          {...rest}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\nimport { test, expect, type Page } from '@playwright/test';\nimport { PrismaClient } from '@prisma/client';\nimport bcrypt from 'bcrypt';\n\n/**\n * PRD-04 NFR-16. Creates its own ACTIVE admin (no login UI exists yet) and\n * signs in through next-auth's credentials callback, sharing cookies with the page.\n */\nconst prisma = new PrismaClient();\nconst ADMIN = { email: 'e2e-notifications-admin@schoolhub.test', password: 'E2e-Notif!2026-pass' };\n\ntest.describe.configure({ mode: 'serial' });\n\ntest.beforeAll(async () => {\n  const passwordHash = await bcrypt.hash(ADMIN.password, 10);\n  const admin = await prisma.user.upsert({\n    where: { email: ADMIN.email },\n    update: { passwordHash, status: 'ACTIVE', archivedAt: null, failedLoginCount: 0, lockedUntil: null, role: 'ADMIN' },\n    create: { email: ADMIN.email, passwordHash, firstName: 'E2E', lastName: 'Admin', role: 'ADMIN', status: 'ACTIVE' },\n  });\n  // Start from defaults even if an earlier run died before afterAll.\n  await prisma.notificationPreference.deleteMany({ where: { userId: admin.id } });\n  await prisma.notification.deleteMany({ where: { userId: admin.id } });\n});\n\ntest.afterAll(async () => {\n  // Cascades remove the admin's notifications and preferences; outbox rows have no FK.\n  await prisma.user.deleteMany({ where: { email: ADMIN.email } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: ADMIN.email } });\n  await prisma.$disconnect();\n});\n\nasync function signIn(page: Page) {\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  const res = await page.request.post('/api/auth/callback/credentials', {\n    form: { email: ADMIN.email, password: ADMIN.password, csrfToken, callbackUrl: '/dashboard' },\n  });\n  expect(res.ok()).toBeTruthy();\n  const session = await (await page.request.get('/api/auth/session')).json();\n  expect(session?.user?.email).toBe(ADMIN.email);\n}\n\nconst bell = (page: Page) => page.getByRole('button', { name: /^Notifications/ });\n\ntest('admin test notification bumps the bell, mark all read clears it', async ({ page }) => {\n  await signIn(page);\n  await page.request.post('/api/notifications/read-all');\n\n  await page.goto('/admin/email-log');\n  await expect(bell(page)).toHaveAccessibleName('Notifications');\n\n  await page.getByRole('button', { name: 'Send test notification to me' }).click();\n  await expect(page.getByText('Test notification sent to you')).toBeVisible();\n\n  // The bell polls every 30 s; a reload fetches immediately.\n  await page.reload();\n  await expect(bell(page)).toHaveAccessibleName('Notifications, 1 unread');\n\n  await bell(page).click();\n  await expect(page.getByRole('button', { name: /Test notification/ })).toBeVisible();\n  await page.getByRole('button', { name: 'Mark all as read' }).click();\n  await expect(bell(page)).toHaveAccessibleName('Notifications');\n\n  const { data } = await (await page.request.get('/api/notifications/unread-count')).json();\n  expect(data.count).toBe(0);\n});\n\ntest('a preference toggle persists across reload', async ({ page }) => {\n  await signIn(page);\n  await page.goto('/account/notifications');\n\n  const email = page.getByRole('switch', { name: 'Test notification email' });\n  await expect(email).toBeChecked();\n\n  const saved = page.waitForResponse((r) => r.url().endsWith('/api/me/notification-preferences') && r.request().method() === 'PUT');\n  await email.click();\n  expect((await saved).ok()).toBeTruthy();\n\n  await page.reload();\n  await expect(page.getByRole('switch', { name: 'Test notification email' })).not.toBeChecked();\n});\nimport { test, expect } from '@playwright/test';\nimport AxeBuilder from '@axe-core/playwright';\n\ntest.describe('dashboard page (/dashboard)', () => {\n  test('renders the welcome header and empty state', async ({ page }) => {\n    await page.goto('/dashboard');\n    await expect(page.getByRole('heading', { level: 1, name: /welcome to schoolhub/i })).toBeVisible();\n  });\n\n  test('has zero serious/critical accessibility violations', async ({ page }) => {\n    await page.goto('/dashboard');\n    const results = await new AxeBuilder({ page }).analyze();\n    const seriousOrCritical = results.violations.filter(\n      (v) => v.impact === 'serious' || v.impact === 'critical',\n    );\n    expect(seriousOrCritical).toEqual([]);\n  });\n});\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { resetPasswordSchema } from '@/lib/validators/auth';\nimport { resetPassword } from '@/server/services/auth';\n\n/** POST /api/auth/reset-password — public; 410 for an invalid/expired/used token (FR-21). */\nexport const POST = withHandler(async (request: Request) => {\n  const body = await parseBody(request, resetPasswordSchema);\n  return ok(await resetPassword(body, request));\n});\n4:import { INVITE_TTL } from '@/server/auth/tokens';\n5:import { enqueueEmail } from '@/server/email/outbox';\n6:import { getEmailSchool, renderEmail } from '@/server/email/render';\n16:export function authLink(kind: AuthEmailKind, rawToken: string): string {\n27:  user: { email: string; firstName?: string },\n42:  await enqueueEmail({ toEmail: user.email, toName: name || null, subject: SUBJECTS[kind], ...rendered });\nimport { requirePageUser } from '@/server/auth/requireRole';\nimport { getPreferencesFor } from '@/server/notifications/preferences';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { PreferencesTable } from './PreferencesTable';\n\nexport const dynamic = 'force-dynamic';\n\n/** /account/notifications — PRD-04 FR-28..30. */\nexport default async function NotificationPreferencesPage() {\n  const me = await requirePageUser();\n  const initial = await getPreferencesFor(me);\n  return (\n    <>\n      <PageHeader title=\"Notification preferences\" description=\"Choose how you hear about activity in SchoolHub.\" />\n      <PreferencesTable initial={initial} />\n    </>\n  );\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"f2906e1d-ad0e-4bbc-bb8a-30196499bfbf","uuid":"e781e5ca-17aa-46fa-835d-8daf91db9405","timestamp":"2026-11-05T16:34:48.386Z","tool_use_result":{"stdout":"'use client';\n\nimport { Controller, type Control, type FieldValues, type Path } from 'react-hook-form';\nimport TextField, { type TextFieldProps } from '@mui/material/TextField';\nimport MenuItem from '@mui/material/MenuItem';\nimport Checkbox from '@mui/material/Checkbox';\nimport Switch from '@mui/material/Switch';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormControl from '@mui/material/FormControl';\nimport FormLabel from '@mui/material/FormLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Radio from '@mui/material/Radio';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { DateTimePicker } from '@mui/x-date-pickers/DateTimePicker';\n\ninterface BaseProps<TFieldValues extends FieldValues> {\n  name: Path<TFieldValues>;\n  control: Control<TFieldValues>;\n  label: string;\n  helperText?: string;\n}\n\n/** Plain text / number / etc. MUI TextField bound via Controller. */\nexport function TextFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  ...rest\n}: BaseProps<TFieldValues> & Omit<TextFieldProps, 'name' | 'label' | 'error' | 'helperText'>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          {...rest}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?