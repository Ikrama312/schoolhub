{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BPBVTD5gC4mvA5imYbHzyy","type":"tool_result","content":"import { prisma } from '@/server/db';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { getCurrentAcademicYear } from '@/server/services/academicYears';\nimport { isCopyTargetYear, listSections } from '@/server/sections/sections-service';\nimport { SectionsClient } from './SectionsClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /admin/sections — PRD-05 FR-2/FR-3/FR-6. */\nexport default async function SectionsPage() {\n  await requirePageRole('ADMIN');\n  const [years, gradeLevels, rooms, current] = await Promise.all([\n    prisma.academicYear.findMany({ orderBy: { startDate: 'asc' } }),\n    prisma.gradeLevel.findMany({ where: { archivedAt: null }, orderBy: { order: 'asc' } }),\n    prisma.room.findMany({ where: { archivedAt: null }, orderBy: { name: 'asc' } }),\n    getCurrentAcademicYear(),\n  ]);\n  const initial = await listSections({}, { skip: 0, take: 20 });\n\n  return (\n    <SectionsClient\n      years={years.map((y) => ({ id: y.id, name: y.name, isCurrent: y.isCurrent, isCopyTarget: isCopyTargetYear(y) }))}\n      currentYearId={current?.id ?? null}\n      gradeLevels={gradeLevels.map((g) => ({ id: g.id, name: g.name }))}\n      rooms={rooms.map((r) => ({ id: r.id, name: r.name }))}\n      initialRows={JSON.parse(JSON.stringify(initial.rows))}\n      initialTotal={initial.total}\n    />\n  );\n}\n'use client';\n\nimport { useState } from 'react';\nimport Dialog from '@mui/material/Dialog';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogContentText from '@mui/material/DialogContentText';\nimport DialogActions from '@mui/material/DialogActions';\nimport Button from '@mui/material/Button';\nimport CircularProgress from '@mui/material/CircularProgress';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  title: string;\n  description?: string;\n  destructive?: boolean;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  onConfirm: () => void | Promise<void>;\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}: ConfirmDialogProps) {\n  const [pending, setPending] = useState(false);\n\n  const handleConfirm = async () => {\n    setPending(true);\n    try {\n      await onConfirm();\n    } finally {\n      setPending(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n      {description && (\n        <DialogContent>\n          <DialogContentText>{description}</DialogContentText>\n        </DialogContent>\n      )}\n      <DialogActions>\n        <Button onClick={onCancel} disabled={pending}>\n          {cancelLabel}\n        </Button>\n        <Button\n          onClick={handleConfirm}\n          color={destructive ? 'error' : 'primary'}\n          variant=\"contained\"\n          disabled={pending}\n          startIcon={pending ? <CircularProgress size={16} color=\"inherit\" /> : undefined}\n        >\n          {confirmLabel}\n        </Button>\n      </DialogActions>\n    </Dialog>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\n'use client';\n\nimport { useEffect, useMemo, useState } from 'react';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport TextField from '@mui/material/TextField';\nimport Box from '@mui/material/Box';\nimport Typography from '@mui/material/Typography';\nimport CircularProgress from '@mui/material/CircularProgress';\nimport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\nimport type { Role } from '@/config/navigation';\n\nexport interface UserPickerOption {\n  id: string;\n  name: string;\n  email: string;\n  role: Role;\n}\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface UserPickerProps {\n  label: string;\n  /** Restrict search to a single role (e.g. \"PARENT\" when linking a student's family). */\n  role?: Role;\n  multiple?: boolean;\n  value: UserPickerOption[] | UserPickerOption | null;\n  onChange: (value: UserPickerOption[] | UserPickerOption | null) => void;\n  helperText?: string;\n  error?: boolean;\n}\n\n/**\n * Reusable directory picker (FR-28) on MUI Autocomplete: async search\n * against GET /api/users/search, optional multi-select, avatar+name+role\n * renderOption. Used for inline parent/student linking in the create/edit\n * Stepper and the student detail page's Family card.\n */\nexport function UserPicker({ label, role, multiple, value, onChange, helperText, error }: UserPickerProps) {\n  const [inputValue, setInputValue] = useState('');\n  const [options, setOptions] = useState<UserPickerOption[]>([]);\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    const handle = setTimeout(async () => {\n      setLoading(true);\n      try {\n        const params = new URLSearchParams();\n        if (role) params.set('role', role);\n        if (inputValue) params.set('q', inputValue);\n        const res = await fetch(`/api/users/search?${params.toString()}`);\n        const json = await res.json();\n        setOptions(res.ok ? json.data : []);\n      } catch {\n        setOptions([]);\n      } finally {\n        setLoading(false);\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n  }, [inputValue, role]);\n\n  const selectedIds = useMemo(() => {\n    if (!value) return new Set<string>();\n    return new Set(Array.isArray(value) ? value.map((v) => v.id) : [value.id]);\n  }, [value]);\n\n  return (\n    <Autocomplete\n      multiple={Boolean(multiple)}\n      options={options}\n      value={value as never}\n      onChange={(_event, next) => onChange(next as UserPickerOption[] | UserPickerOption | null)}\n      inputValue={inputValue}\n      onInputChange={(_event, next) => setInputValue(next)}\n      getOptionLabel={(option) => `${option.name} (${option.email})`}\n      isOptionEqualToValue={(option, selected) => option.id === selected.id}\n      filterOptions={(opts) => opts.filter((opt) => !selectedIds.has(opt.id) || selectedIds.size === 0)}\n      loading={loading}\n      renderOption={(props, option) => (\n        <Box component=\"li\" {...props} key={option.id} sx={{ display: 'flex', alignItems: 'center', gap: 1.5 }}>\n          <UserAvatar userId={option.id} name={option.name} size={28} />\n          <Box sx={{ minWidth: 0 }}>\n            <Typography variant=\"body2\" noWrap>\n              {option.name}\n            </Typography>\n            <Typography variant=\"caption\" color=\"text.secondary\" noWrap>\n              {option.email} · {option.role}\n            </Typography>\n          </Box>\n        </Box>\n      )}\n      renderInput={(params) => (\n        <TextField\n          {...params}\n          label={label}\n          error={error}\n          helperText={helperText}\n          slotProps={{\n            input: {\n              ...params.slotProps.input,\n              endAdornment: (\n                <>\n                  {loading ? <CircularProgress color=\"inherit\" size={16} /> : null}\n                  {params.slotProps.input.endAdornment}\n                </>\n              ),\n            },\n          }}\n        />\n      )}\n    />\n  );\n}\nimport Link from 'next/link';\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Chip from '@mui/material/Chip';\nimport Paper from '@mui/material/Paper';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableContainer from '@mui/material/TableContainer';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanViewStudent } from '@/server/auth/student-access';\nimport { AppError } from '@/server/http';\nimport { getStudentCourses } from '@/server/courses/courses-service';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { ALL_ROLES } from '@/config/navigation';\n\nexport const dynamic = 'force-dynamic';\n\n/** Student \"Courses\" tab — PRD-05 FR-21/FR-22. */\nexport default async function StudentCoursesPage({ params }: { params: { id: string } }) {\n  const user = await requirePageRole(...ALL_ROLES);\n  try {\n    await assertCanViewStudent(user, params.id);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const { academicYear, section, courses } = await getStudentCourses(params.id);\n\n  return (\n    <Box>\n      <PageHeader title=\"Courses\" description={academicYear ? academicYear.name : 'No current academic year'} />\n      <Paper variant=\"outlined\" sx={{ p: 2, mb: 2 }}>\n        <Typography variant=\"body2\">\n          <strong>Section:</strong> {section?.name ?? '—'}\n          {'  ·  '}\n          <strong>Homeroom teacher:</strong> {section?.homeroomTeacher?.name ?? '—'}\n        </Typography>\n      </Paper>\n      {courses.length === 0 ? (\n        <EmptyState title=\"No courses this year\" />\n      ) : (\n        <TableContainer component={Paper} variant=\"outlined\">\n          <Table size=\"small\" aria-label=\"Student courses\">\n            <TableHead>\n              <TableRow>\n                <TableCell>Course</TableCell>\n                <TableCell>Code</TableCell>\n                <TableCell>Teacher</TableCell>\n                <TableCell>Kind</TableCell>\n                <TableCell>Status</TableCell>\n              </TableRow>\n            </TableHead>\n            <TableBody>\n              {courses.map((c) => (\n                <TableRow key={c.enrollmentId}>\n                  <TableCell>\n                    <Box component=\"span\" sx={{ display: 'inline-block', width: 10, height: 10, borderRadius: '50%', bgcolor: c.subjectColor, mr: 1 }} />\n                    <Link href={`/courses/${c.courseId}`}>{c.name}</Link>\n                  </TableCell>\n                  <TableCell>{c.code}</TableCell>\n                  <TableCell>{c.teacher.name}</TableCell>\n                  <TableCell>{c.kind}</TableCell>\n                  <TableCell>\n                    <Chip size=\"small\" color={c.status === 'ACTIVE' ? 'success' : 'default'} label={c.status} />\n                  </TableCell>\n                </TableRow>\n              ))}\n            </TableBody>\n          </Table>\n        </TableContainer>\n      )}\n    </Box>\n  );\n}\nimport Link from 'next/link';\nimport { notFound } from 'next/navigation';\nimport Chip from '@mui/material/Chip';\nimport List from '@mui/material/List';\nimport ListItem from '@mui/material/ListItem';\nimport ListItemText from '@mui/material/ListItemText';\nimport Paper from '@mui/material/Paper';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableContainer from '@mui/material/TableContainer';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { getCourseRoster, type RosterEntry } from '@/server/courses/courses-service';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { ALL_ROLES } from '@/config/navigation';\n\nexport const dynamic = 'force-dynamic';\n\n/** Roster tab — FR-17 / NFR-4: same getCourseRoster as the API; PARENT has no roster. */\nexport default async function CourseRosterPage({ params }: { params: { courseId: string } }) {\n  const user = await requirePageRole(...ALL_ROLES);\n  if (user.role === 'PARENT') notFound();\n  const { rows } = await getCourseRoster(params.courseId, user.role);\n\n  if (rows.length === 0) return <EmptyState title=\"No students enrolled\" />;\n\n  if (user.role === 'STUDENT') {\n    return (\n      <Paper variant=\"outlined\">\n        <List dense aria-label=\"Classmates\">\n          {(rows as { name: string }[]).map((r, i) => (\n            <ListItem key={i}>\n              <ListItemText primary={r.name} />\n            </ListItem>\n          ))}\n        </List>\n      </Paper>\n    );\n  }\n\n  return (\n    <TableContainer component={Paper} variant=\"outlined\">\n      <Table size=\"small\" aria-label=\"Course roster\">\n        <TableHead>\n          <TableRow>\n            <TableCell>Student</TableCell>\n            <TableCell>Admission no.</TableCell>\n            <TableCell>Status</TableCell>\n            <TableCell>Enrolled</TableCell>\n          </TableRow>\n        </TableHead>\n        <TableBody>\n          {(rows as RosterEntry[]).map((r) => (\n            <TableRow key={r.enrollmentId}>\n              <TableCell>\n                <Link href={r.student.profileUrl}>{r.student.name}</Link>\n              </TableCell>\n              <TableCell>{r.student.admissionNumber ?? '—'}</TableCell>\n              <TableCell>\n                <Chip size=\"small\" color={r.status === 'ACTIVE' ? 'success' : 'default'} label={r.status} />\n              </TableCell>\n              <TableCell>{r.enrolledAt.toLocaleDateString()}</TableCell>\n            </TableRow>\n          ))}\n        </TableBody>\n      </Table>\n    </TableContainer>\n  );\n}\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { AppError } from '@/server/http';\nimport { getCourse } from '@/server/courses/courses-service';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { CourseTabs } from './CourseTabs';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course home shell — PRD-05 FR-16/FR-18. Gate once here; tabs inherit it. */\nexport default async function CourseLayout({\n  params,\n  children,\n}: {\n  params: { courseId: string };\n  children: React.ReactNode;\n}) {\n  const user = await requirePageRole(...ALL_ROLES);\n  try {\n    await assertCanViewCourse(user, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const course = await getCourse(params.courseId);\n  const teachers = [course.teacher, ...course.coTeachers].map((t) => t.name).join(', ');\n\n  return (\n    <Box>\n      <Paper variant=\"outlined\" sx={{ mb: 2, overflow: 'hidden' }}>\n        <Box sx={{ height: 8, bgcolor: course.subject.color }} />\n        <Box sx={{ p: 2 }}>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {course.name}\n          </Typography>\n          <Stack direction=\"row\" spacing={2} sx={{ mt: 0.5, flexWrap: 'wrap', color: 'text.secondary' }} useFlexGap>\n            <Typography variant=\"body2\">{course.code}</Typography>\n            <Typography variant=\"body2\">Teachers: {teachers}</Typography>\n            {course.section && <Typography variant=\"body2\">Section {course.section.name}</Typography>}\n            {course.section?.room && <Typography variant=\"body2\">Room {course.section.room.name}</Typography>}\n          </Stack>\n        </Box>\n      </Paper>\n      <CourseTabs courseId={course.id} role={user.role} />\n      {children}\n    </Box>\n  );\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"df25e571-0ce8-4c8c-9cc6-c89019e911c3","uuid":"ddfbcef5-3900-48ba-a0c7-393d4c17d92e","timestamp":"2026-11-05T05:24:12.356Z","tool_use_result":{"stdout":"import { prisma } from '@/server/db';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { getCurrentAcademicYear } from '@/server/services/academicYears';\nimport { isCopyTargetYear, listSections } from '@/server/sections/sections-service';\nimport { SectionsClient } from './SectionsClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /admin/sections — PRD-05 FR-2/FR-3/FR-6. */\nexport default async function SectionsPage() {\n  await requirePageRole('ADMIN');\n  const [years, gradeLevels, rooms, current] = await Promise.all([\n    prisma.academicYear.findMany({ orderBy: { startDate: 'asc' } }),\n    prisma.gradeLevel.findMany({ where: { archivedAt: null }, orderBy: { order: 'asc' } }),\n    prisma.room.findMany({ where: { archivedAt: null }, orderBy: { name: 'asc' } }),\n    getCurrentAcademicYear(),\n  ]);\n  const initial = await listSections({}, { skip: 0, take: 20 });\n\n  return (\n    <SectionsClient\n      years={years.map((y) => ({ id: y.id, name: y.name, isCurrent: y.isCurrent, isCopyTarget: isCopyTargetYear(y) }))}\n      currentYearId={current?.id ?? null}\n      gradeLevels={gradeLevels.map((g) => ({ id: g.id, name: g.name }))}\n      rooms={rooms.map((r) => ({ id: r.id, name: r.name }))}\n      initialRows={JSON.parse(JSON.stringify(initial.rows))}\n      initialTotal={initial.total}\n    />\n  );\n}\n'use client';\n\nimport { useState } from 'react';\nimport Dialog from '@mui/material/Dialog';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogContentText from '@mui/material/DialogContentText';\nimport DialogActions from '@mui/material/DialogActions';\nimport Button from '@mui/material/Button';\nimport CircularProgress from '@mui/material/CircularProgress';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  title: string;\n  description?: string;\n  destructive?: boolean;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  onConfirm: () => void | Promise<void>;\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}: ConfirmDialogProps) {\n  const [pending, setPending] = useState(false);\n\n  const handleConfirm = async () => {\n    setPending(true);\n    try {\n      await onConfirm();\n    } finally {\n      setPending(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n      {description && (\n        <DialogContent>\n          <DialogContentText>{description}</DialogContentText>\n        </DialogContent>\n      )}\n      <DialogActions>\n        <Button onClick={onCancel} disabled={pending}>\n          {cancelLabel}\n        </Button>\n        <Button\n          onClick={handleConfirm}\n          color={destructive ? 'error' : 'primary'}\n          variant=\"contained\"\n          disabled={pending}\n          startIcon={pending ? <CircularProgress size={16} color=\"inherit\" /> : undefined}\n        >\n          {confirmLabel}\n        </Button>\n      </DialogActions>\n    </Dialog>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\n'use client';\n\nimport { useEffect, useMemo, useState } from 'react';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport TextField from '@mui/material/TextField';\nimport Box from '@mui/material/Box';\nimport Typography from '@mui/material/Typography';\nimport CircularProgress from '@mui/material/CircularProgress';\nimport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\nimport type { Role } from '@/config/navigation';\n\nexport interface UserPickerOption {\n  id: string;\n  name: string;\n  email: string;\n  role: Role;\n}\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface UserPickerProps {\n  label: string;\n  /** Restrict search to a single role (e.g. \"PARENT\" when linking a student's family). */\n  role?: Role;\n  multiple?: boolean;\n  value: UserPickerOption[] | UserPickerOption | null;\n  onChange: (value: UserPickerOption[] | UserPickerOption | null) => void;\n  helperText?: string;\n  error?: boolean;\n}\n\n/**\n * Reusable directory picker (FR-28) on MUI Autocomplete: async search\n * against GET /api/users/search, optional multi-select, avatar+name+role\n * renderOption. Used for inline parent/student linking in the create/edit\n * Stepper and the student detail page's Family card.\n */\nexport function UserPicker({ label, role, multiple, value, onChange, helperText, error }: UserPickerProps) {\n  const [inputValue, setInputValue] = useState('');\n  const [options, setOptions] = useState<UserPickerOption[]>([]);\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    const handle = setTimeout(async () => {\n      setLoading(true);\n      try {\n        const params = new URLSearchParams();\n        if (role) params.set('role', role);\n        if (inputValue) params.set('q', inputValue);\n        const res = await fetch(`/api/users/search?${params.toString()}`);\n        const json = await res.json();\n        setOptions(res.ok ? json.data : []);\n      } catch {\n        setOptions([]);\n      } finally {\n        setLoading(false);\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n  }, [inputValue, role]);\n\n  const selectedIds = useMemo(() => {\n    if (!value) return new Set<string>();\n    return new Set(Array.isArray(value) ? value.map((v) => v.id) : [value.id]);\n  }, [value]);\n\n  return (\n    <Autocomplete\n      multiple={Boolean(multiple)}\n      options={options}\n      value={value as never}\n      onChange={(_event, next) => onChange(next as UserPickerOption[] | UserPickerOption | null)}\n      inputValue={inputValue}\n      onInputChange={(_event, next) => setInputValue(next)}\n      getOptionLabel={(option) => `${option.name} (${option.email})`}\n      isOptionEqualToValue={(option, selected) => option.id === selected.id}\n      filterOptions={(opts) => opts.filter((opt) => !selectedIds.has(opt.id) || selectedIds.size === 0)}\n      loading={loading}\n      renderOption={(props, option) => (\n        <Box component=\"li\" {...props} key={option.id} sx={{ display: 'flex', alignItems: 'center', gap: 1.5 }}>\n          <UserAvatar userId={option.id} name={option.name} size={28} />\n          <Box sx={{ minWidth: 0 }}>\n            <Typography variant=\"body2\" noWrap>\n              {option.name}\n            </Typography>\n            <Typography variant=\"caption\" color=\"text.secondary\" noWrap>\n              {option.email} · {option.role}\n            </Typography>\n          </Box>\n        </Box>\n      )}\n      renderInput={(params) => (\n        <TextField\n          {...params}\n          label={label}\n          error={error}\n          helperText={helperText}\n          slotProps={{\n            input: {\n              ...params.slotProps.input,\n              endAdornment: (\n                <>\n                  {loading ? <CircularProgress color=\"inherit\" size={16} /> : null}\n                  {params.slotProps.input.endAdornment}\n                </>\n              ),\n            },\n          }}\n        />\n      )}\n    />\n  );\n}\nimport Link from 'next/link';\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Chip from '@mui/material/Chip';\nimport Paper from '@mui/material/Paper';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableContainer from '@mui/material/TableContainer';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanViewStudent } from '@/server/auth/student-access';\nimport { AppError } from '@/server/http';\nimport { getStudentCourses } from '@/server/courses/courses-service';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { ALL_ROLES } from '@/config/navigation';\n\nexport const dynamic = 'force-dynamic';\n\n/** Student \"Courses\" tab — PRD-05 FR-21/FR-22. */\nexport default async function StudentCoursesPage({ params }: { params: { id: string } }) {\n  const user = await requirePageRole(...ALL_ROLES);\n  try {\n    await assertCanViewStudent(user, params.id);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const { academicYear, section, courses } = await getStudentCourses(params.id);\n\n  return (\n    <Box>\n      <PageHeader title=\"Courses\" description={academicYear ? academicYear.name : 'No current academic year'} />\n      <Paper variant=\"outlined\" sx={{ p: 2, mb: 2 }}>\n        <Typography variant=\"body2\">\n          <strong>Section