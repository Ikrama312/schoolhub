{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TWusSmEadBh6kiFh9PFtaA","type":"tool_result","content":"generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\nenum Gender {\n  FEMALE\n  MALE\n  OTHER\n  UNDISCLOSED\n}\n\nenum GuardianRelationship {\n  MOTHER\n  FATHER\n  GUARDIAN\n  GRANDPARENT\n  OTHER\n}\n\nenum EmailStatus {\n  PENDING\n  SENDING\n  SENT\n  FAILED\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n/// field shared by every role, archivedAt backs FR-13's archive/restore\n/// (separate from status so a DISABLED-but-not-archived user stays distinct\n/// from an archived one).\nmodel User {\n  id                      String                   @id @default(cuid())\n  email                   String                   @unique\n  passwordHash            String?\n  firstName               String\n  lastName                String\n  phone                   String?\n  role                    Role\n  status                  UserStatus               @default(INVITED)\n  failedLoginCount        Int                      @default(0)\n  lockedUntil             DateTime?\n  lastLoginAt             DateTime?\n  passwordChangedAt       DateTime?\n  archivedAt              DateTime?\n  createdAt               DateTime                 @default(now())\n  updatedAt               DateTime                 @updatedAt\n  authTokens              AuthToken[]\n  auditLogs               AuditLog[]\n  studentProfile          StudentProfile?\n  teacherProfile          TeacherProfile?\n  parentProfile           ParentProfile?\n  parentLinks             ParentStudentLink[]      @relation(\"ParentLinks\")\n  studentLinks            ParentStudentLink[]      @relation(\"StudentLinks\")\n  notifications           Notification[]\n  notificationPreferences NotificationPreference[]\n  homeroomSections        Section[]                @relation(\"HomeroomTeacher\")\n  sectionMemberships      SectionMember[]\n  taughtCourses           Course[]                 @relation(\"CourseTeacher\")\n  enrollments             Enrollment[]\n\n  @@index([lastName, firstName, email])\n}\n\n/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n/// only -- enforced in the service layer (src/server/services/users.ts,\n/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\nmodel StudentProfile {\n  userId           String     @id\n  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  admissionNumber  String     @unique\n  dateOfBirth      DateTime   @db.Date\n  gender           Gender     @default(UNDISCLOSED)\n  gradeLevelId     String\n  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n  enrollmentDate   DateTime   @db.Date\n  addressLine1     String?\n  city             String?\n  medicalNotes     String?\n  emergencyContact String?\n  emergencyPhone   String?\n}\n\n/// Teacher-specific fields (FR-1).\nmodel TeacherProfile {\n  userId         String    @id\n  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  employeeNumber String    @unique\n  title          String?\n  qualifications String?\n  hireDate       DateTime? @db.Date\n}\n\n/// Parent-specific fields (FR-1).\nmodel ParentProfile {\n  userId     String  @id\n  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  occupation String?\n  address    String?\n}\n\n/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n/// transaction invariants rather than DB constraints.\nmodel ParentStudentLink {\n  id           String               @id @default(cuid())\n  parentId     String\n  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n  studentId    String\n  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n  relationship GuardianRelationship\n  isPrimary    Boolean              @default(false)\n  createdAt    DateTime             @default(now())\n\n  @@unique([parentId, studentId])\n  @@index([studentId])\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"24b2a9c9-4488-41ba-bad0-91baebb96cfb","uuid":"6b028b0a-4602-4caf-8b86-f4d7cb5922f2","timestamp":"2026-11-04T06:45:00.848Z","tool_use_result":{"stdout":"generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\nenum Gender {\n  FEMALE\n  MALE\n  OTHER\n  UNDISCLOSED\n}\n\nenum GuardianRelationship {\n  MOTHER\n  FATHER\n  GUARDIAN\n  GRANDPARENT\n  OTHER\n}\n\nenum EmailStatus {\n  PENDING\n  SENDING\n  SENT\n  FAILED\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n/// field share