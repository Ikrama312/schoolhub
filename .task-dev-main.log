{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017EZXkwKP2pi5dPB9WSv3BX","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { useCallback, useEffect, useState } from 'react';\n4\timport Link from 'next/link';\n5\timport { usePathname, useRouter, useSearchParams } from 'next/navigation';\n6\timport type { GridColDef } from '@mui/x-data-grid';\n7\timport Box from '@mui/material/Box';\n8\timport Button from '@mui/material/Button';\n9\timport Dialog from '@mui/material/Dialog';\n10\timport DialogActions from '@mui/material/DialogActions';\n11\timport DialogContent from '@mui/material/DialogContent';\n12\timport DialogTitle from '@mui/material/DialogTitle';\n13\timport IconButton from '@mui/material/IconButton';\n14\timport MenuItem from '@mui/material/MenuItem';\n15\timport Stack from '@mui/material/Stack';\n16\timport TextField from '@mui/material/TextField';\n17\timport Tooltip from '@mui/material/Tooltip';\n18\timport Typography from '@mui/material/Typography';\n19\timport AddIcon from '@mui/icons-material/Add';\n20\timport ContentCopyIcon from '@mui/icons-material/ContentCopy';\n21\timport DeleteOutlineIcon from '@mui/icons-material/DeleteOutline';\n22\timport EditOutlinedIcon from '@mui/icons-material/EditOutlined';\n23\timport { DataTable } from '@/components/DataTable/DataTable';\n24\timport { PageHeader } from '@/components/PageHeader/PageHeader';\n25\timport { ConfirmDialog } from '@/components/ConfirmDialog/ConfirmDialog';\n26\timport { UserPicker, type UserPickerOption } from '@/components/UserPicker/UserPicker';\n27\timport { useToast } from '@/components/Toast/useToast';\n28\timport { sectionInputSchema } from '@/lib/validators/sections';\n29\t\n30\tinterface Option {\n31\t  id: string;\n32\t  name: string;\n33\t}\n34\tinterface YearOption extends Option {\n35\t  isCurrent: boolean;\n36\t  isCopyTarget: boolean;\n37\t}\n38\texport interface SectionRow {\n39\t  id: string;\n40\t  name: string;\n41\t  academicYearId: string;\n42\t  gradeLevelId: string;\n43\t  gradeLevel: { id: string; name: string };\n44\t  homeroomTeacher: Option | null;\n45\t  roomId: string | null;\n46\t  room: Option | null;\n47\t  capacity: number;\n48\t  memberCount: number;\n49\t  courseCount: number;\n50\t}\n51\t\n52\tasync function send(url: string, method: string, body?: unknown) {\n53\t  const res = await fetch(url, {\n54\t    method,\n55\t    headers: { 'Content-Type': 'application/json' },\n56\t    body: body === undefined ? undefined : JSON.stringify(body),\n57\t  });\n58\t  const json = await res.json().catch(() => ({}));\n59\t  if (!res.ok) throw new Error(json?.error?.message ?? 'Request failed');\n60\t  return json;\n61\t}\n62\t\n63\tinterface FormState {\n64\t  id?: string;\n65\t  gradeLevelId: string;\n66\t  name: string;\n67\t  homeroomTeacher: UserPickerOption | null;\n68\t  roomId: string;\n69\t  capacity: string;\n70\t}\n71\tconst emptyForm: FormState = { gradeLevelId: '', name: '', homeroomTeacher: null, roomId: '', capacity: '30' };\n72\t\n73\texport function SectionsClient({\n74\t  years,\n75\t  currentYearId,\n76\t  gradeLevels,\n77\t  rooms,\n78\t  initialRows,\n79\t  initialTotal,\n80\t}: {\n81\t  years: YearOption[];\n82\t  currentYearId: string | null;\n83\t  gradeLevels: Option[];\n84\t  rooms: Option[];\n85\t  initialRows: SectionRow[];\n86\t  initialTotal: number;\n87\t}) {\n88\t  const router = useRouter();\n89\t  const pathname = usePathname();\n90\t  const searchParams = useSearchParams();\n91\t  const { showToast } = useToast();\n92\t  const yearId = searchParams.get('academicYearId') ?? currentYearId ?? '';\n93\t\n94\t  const [rows, setRows] = useState(initialRows);\n95\t  const [total, setTotal] = useState(initialTotal);\n96\t  const [loading, setLoading] = useState(false);\n97\t  const [form, setForm] = useState<FormState | null>(null);\n98\t  const [errors, setErrors] = useState<Record<string, string>>({});\n99\t  const [saving, setSaving] = useState(false);\n100\t  const [toDelete, setToDelete] = useState<SectionRow | null>(null);\n101\t  const [confirmCopy, setConfirmCopy] = useState(false);\n102\t\n103\t  const copyTarget = years.find((y) => y.isCopyTarget && y.id !== yearId) ?? null;\n104\t\n105\t  const load = useCallback(async () => {\n106\t    setLoading(true);\n107\t    try {\n108\t      const params = new URLSearchParams(searchParams.toString());\n109\t      if (yearId) params.set('academicYearId', yearId);\n110\t      const json = await send(`/api/sections?${params.toString()}`, 'GET');\n111\t      setRows(json.data);\n112\t      setTotal(json.meta.total);\n113\t    } catch (error) {\n114\t      showToast({ message: (error as Error).message, severity: 'error' });\n115\t    } finally {\n116\t      setLoading(false);\n117\t    }\n118\t  }, [searchParams, yearId, showToast]);\n119\t\n120\t  useEffect(() => {\n121\t    void load();\n122\t  }, [load]);\n123\t\n124\t  const setYear = (id: string) => {\n125\t    const next = new URLSearchParams(searchParams.toString());\n126\t    next.set('academicYearId', id);\n127\t    next.set('page', '1');\n128\t    router.push(`${pathname}?${next.toString()}`);\n129\t  };\n130\t\n131\t  const openEdit = (row: SectionRow) =>\n132\t    setForm({\n133\t      id: row.id,\n134\t      gradeLevelId: row.gradeLevelId,\n135\t      name: row.name,\n136\t      homeroomTeacher: row.homeroomTeacher\n137\t        ? { id: row.homeroomTeacher.id, name: row.homeroomTeacher.name, email: '', role: 'TEACHER' }\n138\t        : null,\n139\t      roomId: row.roomId ?? '',\n140\t      capacity: String(row.capacity),\n141\t    });\n142\t\n143\t  const save = async () => {\n144\t    if (!form) return;\n145\t    const payload = {\n146\t      academicYearId: yearId,\n147\t      gradeLevelId: form.gradeLevelId,\n148\t      name: form.name,\n149\t      homeroomTeacherId: form.homeroomTeacher?.id ?? null,\n150\t      roomId: form.roomId || null,\n151\t      capacity: form.capacity,\n152\t    };\n153\t    const parsed = sectionInputSchema.safeParse(payload);\n154\t    if (!parsed.success) {\n155\t      const fieldErrors = parsed.error.flatten().fieldErrors;\n156\t      setErrors(Object.fromEntries(Object.entries(fieldErrors).map(([k, v]) => [k, v?.[0] ?? ''])));\n157\t      return;\n158\t    }\n159\t    setErrors({});\n160\t    setSaving(true);\n161\t    try {\n162\t      if (form.id) {\n163\t        const { academicYearId: _ignored, ...update } = parsed.data;\n164\t        await send(`/api/sections/${form.id}`, 'PATCH', update);\n165\t      } else {\n166\t        await send('/api/sections', 'POST', parsed.data);\n167\t      }\n168\t      showToast({ message: form.id ? 'Section updated' : 'Section created', severity: 'success' });\n169\t      setForm(null);\n170\t      await load();\n171\t    } catch (error) {\n172\t      showToast({ message: (error as Error).message, severity: 'error' });\n173\t    } finally {\n174\t      setSaving(false);\n175\t    }\n176\t  };\n177\t\n178\t  const remove = async () => {\n179\t    if (!toDelete) return;\n180\t    try {\n181\t      await send(`/api/sections/${toDelete.id}`, 'DELETE');\n182\t      showToast({ message: `Section ${toDelete.name} deleted`, severity: 'success' });\n183\t      await load();\n184\t    } catch (error) {\n185\t      showToast({ message: (error as Error).message, severity: 'error' });\n186\t    } finally {\n187\t      setToDelete(null);\n188\t    }\n189\t  };\n190\t\n191\t  const copy = async () => {\n192\t    if (!copyTarget) return;\n193\t    try {\n194\t      const json = await send('/api/sections/copy-to-year', 'POST', { fromYearId: yearId, toYearId: copyTarget.id });\n195\t      const skipped = json.data.skipped as { name: string; reason: string }[];\n196\t      showToast({\n197\t        message: `Copied ${json.data.created} section(s) to ${copyTarget.name}.${\n198\t          skipped.length ? ` Skipped: ${skipped.map((s) => `${s.name} (${s.reason})`).join(', ')}` : ''\n199\t        }`,\n200\t        severity: skipped.length ? 'warning' : 'success',\n201\t      });\n202\t    } catch (error) {\n203\t      showToast({ message: (error as Error).message, severity: 'error' });\n204\t    } finally {\n205\t      setConfirmCopy(false);\n206\t    }\n207\t  };\n208\t\n209\t  const columns: GridColDef[] = [\n210\t    {\n211\t      field: 'name',\n212\t      headerName: 'Name',\n213\t      flex: 1,\n214\t      renderCell: ({ row }) => <Link href={`/admin/sections/${row.id}`}>{row.name}</Link>,\n215\t    },\n216\t    { field: 'gradeLevel', headerName: 'Grade', flex: 1, valueGetter: (_v, row) => row.gradeLevel?.name },\n217\t    {\n218\t      field: 'homeroomTeacher',\n219\t      headerName: 'Homeroom teacher',\n220\t      flex: 1.5,\n221\t      sortable: false,\n222\t      valueGetter: (_v, row) => row.homeroomTeacher?.name ?? '—',\n223\t    },\n224\t    { field: 'room', headerName: 'Room', flex: 1, sortable: false, valueGetter: (_v, row) => row.room?.name ?? '—' },\n225\t    {\n226\t      field: 'memberCount',\n227\t      headerName: 'Members',\n228\t      flex: 1,\n229\t      renderCell: ({ row }) => (\n230\t        <Typography\n231\t          variant=\"body2\"\n232\t          sx={{ color: row.memberCount >= row.capacity * 0.9 ? 'warning.main' : 'text.primary', lineHeight: 'inherit' }}\n233\t        >\n234\t          {row.memberCount}/{row.capacity}\n235\t        </Typography>\n236\t      ),\n237\t    },\n238\t    { field: 'courseCount', headerName: 'Courses', flex: 0.7, sortable: false },\n239\t    {\n240\t      field: 'actions',\n241\t      headerName: '',\n242\t      sortable: false,\n243\t      width: 100,\n244\t      renderCell: ({ row }) => (\n245\t        <>\n246\t          <Tooltip title=\"Edit\">\n247\t            <IconButton size=\"small\" aria-label={`Edit ${row.name}`} onClick={() => openEdit(row)}>\n248\t              <EditOutlinedIcon fontSize=\"small\" />\n249\t            </IconButton>\n250\t          </Tooltip>\n251\t          <Tooltip title=\"Delete\">\n252\t            <IconButton size=\"small\" aria-label={`Delete ${row.name}`} onClick={() => setToDelete(row)}>\n253\t              <DeleteOutlineIcon fontSize=\"small\" />\n254\t            </IconButton>\n255\t          </Tooltip>\n256\t        </>\n257\t      ),\n258\t    },\n259\t  ];\n260\t\n261\t  return (\n262\t    <Box>\n263\t      <PageHeader\n264\t        title=\"Sections\"\n265\t        breadcrumbs={[{ label: 'Administration' }, { label: 'Sections' }]}\n266\t        actions={\n267\t          <Stack direction=\"row\" spacing={1}>\n268\t            <Tooltip title={copyTarget ? `Copy into ${copyTarget.name}` : 'Requires a future, non-current academic year'}>\n269\t              <span>\n270\t                <Button\n271\t                  startIcon={<ContentCopyIcon />}\n272\t                  disabled={!copyTarget || !yearId}\n273\t                  onClick={() => setConfirmCopy(true)}\n274\t                >\n275\t                  Copy sections to next year\n276\t                </Button>\n277\t              </span>\n278\t            </Tooltip>\n279\t            <Button\n280\t              variant=\"contained\"\n281\t              startIcon={<AddIcon />}\n282\t              disabled={!yearId}\n283\t              onClick={() => {\n284\t                setErrors({});\n285\t                setForm(emptyForm);\n286\t              }}\n287\t            >\n288\t              New section\n289\t            </Button>\n290\t          </Stack>\n291\t        }\n292\t      />\n293\t\n294\t      <TextField\n295\t        select\n296\t        size=\"small\"\n297\t        label=\"Academic year\"\n298\t        value={yearId}\n299\t        onChange={(e) => setYear(e.target.value)}\n300\t        sx={{ mb: 2, minWidth: 220 }}\n301\t      >\n302\t        {years.map((y) => (\n303\t          <MenuItem key={y.id} value={y.id}>\n304\t            {y.name}\n305\t            {y.isCurrent ? ' (current)' : ''}\n306\t          </MenuItem>\n307\t        ))}\n308\t      </TextField>\n309\t\n310\t      <DataTable columns={columns} rows={rows as never} total={total} loading={loading} />\n311\t\n312\t      <Dialog open={Boolean(form)} onClose={() => setForm(null)} fullWidth maxWidth=\"sm\">\n313\t        <DialogTitle>{form?.id ? 'Edit section' : 'New section'}</DialogTitle>\n314\t        {form && (\n315\t          <DialogContent>\n316\t            <Stack spacing={2} sx={{ mt: 1 }}>\n317\t              <TextField\n318\t                select\n319\t                label=\"Grade level\"\n320\t                value={form.gradeLevelId}\n321\t                onChange={(e) => setForm({ ...form, gradeLevelId: e.target.value })}\n322\t                error={Boolean(errors.gradeLevelId)}\n323\t                helperText={errors.gradeLevelId}\n324\t              >\n325\t                {gradeLevels.map((g) => (\n326\t                  <MenuItem key={g.id} value={g.id}>\n327\t                    {g.name}\n328\t                  </MenuItem>\n329\t                ))}\n330\t              </TextField>\n331\t              <TextField\n332\t                label=\"Name\"\n333\t                value={form.name}\n334\t                onChange={(e) => setForm({ ...form, name: e.target.value })}\n335\t                error={Boolean(errors.name)}\n336\t                helperText={errors.name ?? 'e.g. 7A'}\n337\t              />\n338\t              <UserPicker\n339\t                label=\"Homeroom teacher\"\n340\t                role=\"TEACHER\"\n341\t                value={form.homeroomTeacher}\n342\t                onChange={(v) => setForm({ ...form, homeroomTeacher: (v as UserPickerOption | null) ?? null })}\n343\t                error={Boolean(errors.homeroomTeacherId)}\n344\t                helperText={errors.homeroomTeacherId ?? 'A teacher can be homeroom teacher of one section per year.'}\n345\t              />\n346\t              <TextField\n347\t                select\n348\t                label=\"Room\"\n349\t                value={form.roomId}\n350\t                onChange={(e) => setForm({ ...form, roomId: e.target.value })}\n351\t              >\n352\t                <MenuItem value=\"\">None</MenuItem>\n353\t                {rooms.map((r) => (\n354\t                  <MenuItem key={r.id} value={r.id}>\n355\t                    {r.name}\n356\t                  </MenuItem>\n357\t                ))}\n358\t              </TextField>\n359\t              <TextField\n360\t                label=\"Capacity\"\n361\t                type=\"number\"\n362\t                value={form.capacity}\n363\t                onChange={(e) => setForm({ ...form, capacity: e.target.value })}\n364\t                error={Boolean(errors.capacity)}\n365\t                helperText={errors.capacity ?? '1–60'}\n366\t                slotProps={{ htmlInput: { min: 1, max: 60 } }}\n367\t              />\n368\t            </Stack>\n369\t          </DialogContent>\n370\t        )}\n371\t        <DialogActions>\n372\t          <Button onClick={() => setForm(null)} disabled={saving}>\n373\t            Cancel\n374\t          </Button>\n375\t          <Button variant=\"contained\" onClick={save} disabled={saving}>\n376\t            Save\n377\t          </Button>\n378\t        </DialogActions>\n379\t      </Dialog>\n380\t\n381\t      <ConfirmDialog\n382\t        open={Boolean(toDelete)}\n383\t        title={`Delete section ${toDelete?.name ?? ''}?`}\n384\t        description=\"Only sections without members or courses can be deleted.\"\n385\t        destructive\n386\t        confirmLabel=\"Delete\"\n387\t        onConfirm={remove}\n388\t        onCancel={() => setToDelete(null)}\n389\t      />\n390\t      <ConfirmDialog\n391\t        open={confirmCopy}\n392\t        title={`Copy sections to ${copyTarget?.name ?? ''}?`}\n393\t        description=\"Copies names, rooms and capacities with the grade level advanced by one. Members, homeroom teachers and courses are not copied.\"\n394\t        confirmLabel=\"Copy\"\n395\t        onConfirm={copy}\n396\t        onCancel={() => setConfirmCopy(false)}\n397\t      />\n398\t    </Box>\n399\t  );\n400\t}\n401\t"}]},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"b8150b60-afe4-4c7f-91f6-dd620940e262","timestamp":"2026-10-27T16:49:25.271Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/(app)/admin/sections/SectionsClient.tsx","content":"'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport Link from 'next/link';\nimport { usePathname, useRouter, useSearchParams } from 'next/navigation';\nimport type { GridColDef } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Dialog from '@mui/material/Dialog';\nimport DialogActions from '@mui/material/DialogActions';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport IconButton from '@mui/material/IconButton';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport Tooltip from '@mui/material/Tooltip';\nimport Typography from '@mui/material/Typography';\nimport AddIcon from '@mui/icons-material/Add';\nimport ContentCopyIcon from '@mui/icons-material/ContentCopy';\nimport DeleteOutlineIcon from '@mui/icons-material/DeleteOutline';\nimport EditOutlinedIcon from '@mui/icons-material/EditOutlined';\nimport { DataTable } from '@/components/DataTable/DataTable';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { ConfirmDialog } from '@/components/ConfirmDialog/ConfirmDialog';\nimport { UserPicker, type UserPickerOption } from '@/components/UserPicker/UserPicker';\nimport { useToast } from '@/components/Toast/useToast';\nimport { sectionInputSchema } from '@/lib/validators/sections';\n\ninterface Option {\n  id: string;\n  name: string;\n}\ninterface YearOption extends Option {\n  isCurrent: boolean;\n  isCopyTarget: boolean;\n}\nexport interface SectionRow {\n  id: string;\n  name: string;\n  academicYearId: string;\n  gradeLevelId: string;\n  gradeLevel: { id: string; name: string };\n  homeroomTeacher: Option | null;\n  roomId: string | null;\n  room: Option | null;\n  capacity: number;\n  memberCount: number;\n  courseCount: number;\n}\n\nasync function send(url: string, method: string, body?: unknown) {\n  const res = await fetch(url, {\n    method,\n    headers: { 'Content-Type': 'application/json' },\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const json = await res.json().catch(() => ({}));\n  if (!res.ok) throw new Error(json?.error?.message ?? 'Request failed');\n  return json;\n}\n\ninterface FormState {\n  id?: string;\n  gradeLevelId: string;\n  name: string;\n  homeroomTeacher: UserPickerOption | null;\n  roomId: string;\n  capacity: string;\n}\nconst emptyForm: FormState = { gradeLevelId: '', name: '', homeroomTeacher: null, roomId: '', capacity: '30' };\n\nexport function SectionsClient({\n  years,\n  currentYearId,\n  gradeLevels,\n  rooms,\n  initialRows,\n  initialTotal,\n}: {\n  years: YearOption[];\n  currentYearId: string | null;\n  gradeLevels: Option[];\n  rooms: Option[];\n  initialRows: SectionRow[];\n  initialTotal: number;\n}) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  const { showToast } = useToast();\n  const yearId = searchParams.get('academicYearId') ?? currentYearId ?? '';\n\n  const [rows, setRows] = useState(initialRows);\n  const [total, setTotal] = useState(initialTotal);\n  const [loading, setLoading] = useState(false);\n  const [form, setForm] = useState<FormState | null>(null);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [saving, setSaving] = useState(false);\n  const [toDelete, setToDelete] = useState<SectionRow | null>(null);\n  const [confirmCopy, setConfirmCopy] = useState(false);\n\n  const copyTarget = years.find((y) => y.isCopyTarget && y.id !== yearId) ?? null;\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const params = new URLSearchParams(searchParams.toString());\n      if (yearId) params.set('academicYearId', yearId);\n      const json = await send(`/api/sections?${params.toString()}`, 'GET');\n      setRows(json.data);\n      setTotal(json.meta.total);\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setLoading(false);\n    }\n  }, [searchParams, yearId, showToast]);\n\n  useEffect(() => {\n    void load();\n  }, [load]);\n\n  const setYear = (id: string) => {\n    const next = new URLSearchParams(searchParams.toString());\n    next.set('academicYearId', id);\n    next.set('page', '1');\n    router.push(`${pathname}?${next.toString()}`);\n  };\n\n  const openEdit = (row: SectionRow) =>\n    setForm({\n      id: row.id,\n      gradeLevelId: row.gradeLevelId,\n      name: row.name,\n      homeroomTeacher: row.homeroomTeacher\n        ? { id: row.homeroomTeacher.id, name: row.homeroomTeacher.name, email: '', role: 'TEACHER' }\n        : null,\n      roomId: row.roomId ?? '',\n      capacity: String(row.capacity),\n    });\n\n  const save = async () => {\n    if (!form) return;\n    const payload = {\n      academicYearId: yearId,\n      gradeLevelId: form.gradeLevelId,\n      name: form.name,\n      homeroomTeacherId: form.homeroomTeacher?.id ?? null,\n      roomId: form.roomId || null,\n      capacity: form.capacity,\n    };\n    const parsed = sectionInputSchema.safeParse(payload);\n    if (!parsed.success) {\n      const fieldErrors = parsed.error.flatten().fieldErrors;\n      setErrors(Object.fromEntries(Object.entries(fieldErrors).map(([k, v]) => [k, v?.[0] ?? ''])));\n      return;\n    }\n    setErrors({});\n    setSaving(true);\n    try {\n      if (form.id) {\n        const { academicYearId: _ignored, ...update } = parsed.data;\n        await send(`/api/sections/${form.id}`, 'PATCH', update);\n      } else {\n        await send('/api/sections', 'POST', parsed.data);\n      }\n      showToast({ message: form.id ? 'Section updated' : 'Section created', severity: 'success' });\n      setForm(null);\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const remove = async () => {\n    if (!toDelete) return;\n    try {\n      await send(`/api/sections/${toDelete.id}`, 'DELETE');\n      showToast({ message: `Section ${toDelete.name} deleted`, severity: 'success' });\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setToDelete(null);\n    }\n  };\n\n  const copy = async () => {\n    if (!copyTarget) return;\n    try {\n      const json = await send('/api/sections/copy-to-year', 'POST', { fromYearId: yearId, toYearId: copyTarget.id });\n      const skipped = json.data.skipped as { name: string; reason: string }[];\n      showToast({\n        message: `Copied ${json.data.created} section(s) to ${copyTarget.name}.${\n          skipped.length ? ` Skipped: ${skipped.map((s) => `${s.name} (${s.reason})`).join(', ')}` : ''\n        }`,\n        severity: skipped.length ? 'warning' : 'success',\n      });\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setConfirmCopy(false);\n    }\n  };\n\n  const columns: GridColDef[] = [\n    {\n      field: 'name',\n      headerName: 'Name',\n      flex: 1,\n      renderCell: ({ row }) => <Link href={`/admin/sections/${row.id}`}>{row.name}</Link>,\n    },\n    { field: 'gradeLevel', headerName: 'Grade', flex: 1, valueGetter: (_v, row) => row.gradeLevel?.name },\n    {\n      field: 'homeroomTeacher',\n      headerName: 'Homeroom teacher',\n      flex: 1.5,\n      sortable: false,\n      valueGetter: (_v, row) => row.homeroomTeacher?.name ?? '—',\n    },\n    { field: 'room', headerName: 'Room', flex: 1, sortable: false, valueGetter: (_v, row) => row.room?.name ?? '—' },\n    {\n      field: 'memberCount',\n      headerName: 'Members',\n      flex: 1,\n      renderCell: ({ row }) => (\n        <Typography\n          variant=\"body2\"\n          sx={{ color: row.memberCount >= row.capacity * 0.9 ? 'warning.main' : 'text.primary', lineHeight: 'inherit' }}\n        >\n          {row.memberCount}/{row.capacity}\n        </Typography>\n      ),\n    },\n    { field: 'courseCount', headerName: 'Courses', flex: 0.7, sortable: false },\n    {\n      field: 'actions',\n      headerName: '',\n      sortable: false,\n      width: 100,\n      renderCell: ({ row }) => (\n        <>\n          <Tooltip title=\"Edit\">\n            <IconButton size=\"small\" aria-label={`Edit ${row.name}`} onClick={() => openEdit(row)}>\n              <EditOutlinedIcon fontSize=\"small\" />\n            </IconButton>\n          </Tooltip>\n          <Tooltip title=\"Delete\">\n            <IconButton size=\"small\" aria-label={`Delete ${row.name}`} onClick={() => setToDelete(row)}>\n              <DeleteOutlineIcon fontSize=\"small\" />\n            </IconButton>\n          </Tooltip>\n        </>\n      ),\n    },\n  ];\n\n  return (\n    <Box>\n      <PageHeader\n        title=\"Sections\"\n        breadcrumbs={[{ label: 'Administration' }, { label: 'Sections' }]}\n        actions={\n          <Stack direction=\"row\" spacing={1}>\n            <Tooltip title={copyTarget ? `Copy into ${copyTarget.name}` : 'Requires a future, non-current academic year'}>\n              <span>\n                <Button\n                  startIcon={<ContentCopyIcon />}\n                  disabled={!copyTarget || !yearId}\n                  onClick={() => setConfirmCopy(true)}\n                >\n                  Copy sections to next year\n                </Button>\n              </span>\n            </Tooltip>\n            <Button\n              variant=\"contained\"\n              startIcon={<AddIcon />}\n              disabled={!yearId}\n              onClick={() => {\n                setErrors({});\n                setForm(emptyForm);\n              }}\n            >\n              New section\n            </Button>\n          </Stack>\n        }\n      />\n\n      <TextField\n        select\n        size=\"small\"\n        label=\"Academic year\"\n        value={yearId}\n        onChange={(e) => setYear(e.target.value)}\n        sx={{ mb: 2, minWidth: 220 }}\n      >\n        {years.map((y) => (\n          <MenuItem key={y.id} value={y.id}>\n            {y.name}\n            {y.isCurrent ? ' (current)' : ''}\n          </MenuItem>\n        ))}\n      </TextField>\n\n      <DataTable columns={columns} rows={rows as never} total={total} loading={loading} />\n\n      <Dialog open={Boolean(form)} onClose={() => setForm(null)} fullWidth maxWidth=\"sm\">\n        <DialogTitle>{form?.id ? 'Edit section' : 'New section'}</DialogTitle>\n        {form && (\n          <DialogContent>\n            <Stack spacing={2} sx={{ mt: 1 }}>\n              <TextField\n                select\n                label=\"Grade level\"\n                value={form.gradeLevelId}\n                onChange={(e) => setForm({ ...form, gradeLevelId: e.target.value })}\n                error={Boolean(errors.gradeLevelId)}\n                helperText={errors.gradeLevelId}\n              >\n                {gradeLevels.map((g) => (\n                  <MenuItem key={g.id} value={g.id}>\n                    {g.name}\n                  </MenuItem>\n                ))}\n              </TextField>\n              <TextField\n                label=\"Name\"\n                value={form.name}\n                onChange={(e) => setForm({ ...form, name: e.target.value })}\n                error={Boolean(errors.name)}\n                helperText={errors.name ?? 'e.g. 7A'}\n              />\n              <UserPicker\n                label=\"Homeroom teacher\"\n                role=\"TEACHER\"\n                value={form.homeroomTeacher}\n                onChange={(v) => setForm({ ...form, homeroomTeacher: (v as UserPickerOption | null) ?? null })}\n                error={Boolean(errors.homeroomTeacherId)}\n                helperText={errors.homeroomTeacherId ?? 'A teacher can be homeroom teacher of one section per year.'}\n              />\n              <TextField\n                select\n                label=\"Room\"\n                value={form.roomId}\n                onChange={(e) => setForm({ ...form, roomId: e.target.value })}\n              >\n                <MenuItem value=\"\">None</MenuItem>\n                {rooms.map((r) => (\n                  <MenuItem key={r.id} value={r.id}>\n                    {r.name}\n                  </MenuItem>\n                ))}\n              </TextField>\n              <TextField\n                label=\"Capacity\"\n                type=\"number\"\n                value={form.capacity}\n                onChange={(e) => setForm({ ...form, capacity: e.target.value })}\n                error={Boolean(errors.capacity)}\n                helperText={errors.capacity ?? '1–60'}\n                slotProps={{ htmlInput: { min: 1, max: 60 } }}\n              />\n            </Stack>\n          </DialogContent>\n        )}\n        <DialogActions>\n          <Button onClick={() => setForm(null)} disabled={saving}>\n            Cancel\n          </Button>\n          <Button variant=\"contained\" onClick={save} disabled={saving}>\n            Save\n          </Button>\n        </DialogActions>\n      </Dialog>\n\n      <ConfirmDialog\n        open={Boolean(toDelete)}\n        title={`Delete section ${toDelete?.name ?? ''}?`}\n        description=\"Only sections without members or courses can be deleted.\"\n        destructive\n        confirmLabel=\"Delete\"\n        onConfirm={remove}\n        onCancel={() => setToDelete(null)}\n      />\n      <ConfirmDialog\n        open={confirmCopy}\n        title={`Copy sections to ${copyTarget?.name ?? ''}?`}\n        description=\"Copies names, rooms and capacities with the grade level advanced by one. Members, homeroom teachers and courses are not copied.\"\n        confirmLabel=\"Copy\"\n        onConfirm={copy}\n        onCancel={() => setConfirmCopy(false)}\n      />\n    </Box>\n  );\n}\n","numLines":401,"startLine":1,"totalLines":401}},"tool_result_meta":[{"id":"toolu_017EZXkwKP2pi5dPB9WSv3BX","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
