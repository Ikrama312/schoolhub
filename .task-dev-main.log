known[], sendInvites: boolean): Promise<ImportSummary> {\nsrc/server/services/userLinks.ts:7:export interface LinkParentToStudentInput {\nsrc/server/services/userLinks.ts:25:export async function linkParentToStudentTx(tx: TxClient, input: LinkParentToStudentInput) {\nsrc/server/services/userLinks.ts:49:export async function linkParentToStudent(input: LinkParentToStudentInput) {\nsrc/server/services/userLinks.ts:53:export async function unlinkParentFromStudent(studentId: string, parentId: string) {\nsrc/server/services/userLinks.ts:57:export async function listLinksForStudent(studentId: string) {\nsrc/server/services/userLinks.ts:64:export async function listLinksForParent(parentId: string) {\nsrc/server/services/users.ts:117:export async function createUser(input: CreateUserInput) {\nsrc/server/services/users.ts:171:export async function updateUser(id: string, input: UpdateUserInput) {\nsrc/server/services/users.ts:219:export interface ListUsersFilters {\nimport { prisma } from '@/server/db';\n\nexport interface GradeLevelInput {\n  name: string;\n  shortName: string;\n  order: number;\n}\n\nexport interface UpdateGradeLevelInput {\n  name?: string;\n  shortName?: string;\n  order?: number;\n  archived?: boolean;\n}\n\nexport async function listGradeLevels(includeArchived = false) {\n  return prisma.gradeLevel.findMany({\n    where: includeArchived ? undefined : { archivedAt: null },\n    orderBy: { order: 'asc' },\n  });\n}\n\nexport async function createGradeLevel(input: GradeLevelInput) {\n  return prisma.gradeLevel.create({ data: input });\n}\n\nexport async function updateGradeLevel(id: string, input: UpdateGradeLevelInput) {\n  return prisma.$transaction(async (tx) => {\n    const existing = await tx.gradeLevel.findUniqueOrThrow({ where: { id } });\n\n    if (input.order !== undefined && input.order !== existing.order) {\n      // Swap via a negative placeholder so the order-unique constraint never\n      // collides with whichever record currently holds the target slot.\n      const other = await tx.gradeLevel.findUnique({ where: { order: input.order } });\n      if (other) {\n        await tx.gradeLevel.update({ where: { id: other.id }, data: { order: -1 } });\n        await tx.gradeLevel.update({ where: { id }, data: { order: input.order } });\n        await tx.gradeLevel.update({ where: { id: other.id }, data: { order: existing.order } });\n      } else {\n        await tx.gradeLevel.update({ where: { id }, data: { order: input.order } });\n      }\n    }\n\n    return tx.gradeLevel.update({\n      where: { id },\n      data: {\n        name: input.name ?? existing.name,\n        shortName: input.shortName ?? existing.shortName,\n        archivedAt: input.archived === undefined ? existing.archivedAt : input.archived ? new Date() : null,\n      },\n    });\n  });\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"020b7a6e-6236-4f8d-a760-9a7fb50fdcce","uuid":"927c688f-76b3-4740-b007-28dc81c93706","timestamp":"2026-10-27T16:41:28.081Z","tool_use_result":{"stdout":"src/server/services/academicYears.ts:9:export interface AcademicYearInput {\nsrc/server/services/academicYears.ts:35:export async function listAcademicYears() {\nsrc/server/services/academicYears.ts:42:export async function createAcademicYear(input: AcademicYearInput) {\nsrc/server/services/academicYears.ts:53:export async function updateAcademicYear(id: string, input: Partial<AcademicYearInput>) {\nsrc/server/services/academicYears.ts:71:export async function setCurrentAcademicYear(id: string) {\nsrc/server/services/academicYears.ts:79:export async function deleteAcademicYear(id: string) {\nsrc/server/services/academicYears.ts:88:export const getCurrentAcademicYear = cache(async () => {\nsrc/server/services/academicYears.ts:96:export async function getCurrentTerm(date: Date = new Date()) {\nsrc/server/services/dateRange.ts:1:export interface DateRange {\nsrc/server/services/dateRange.ts:7:export function rangesOverlap(a: DateRange, b: DateRange):