{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019gj449Vw4P5RpeC6ZZtuZ6","type":"tool_result","content":"import { formatInTimeZone } from 'date-fns-tz';\n\n/**\n * Formats a UTC date/ISO-string in the school's configured timezone\n * (SchoolSettings.timezone). pattern is a date-fns format string.\n */\nexport function formatInSchoolTz(\n  date: Date | string,\n  pattern: string,\n  timezone: string,\n): string {\n  const value = typeof date === 'string' ? new Date(date) : date;\n  return formatInTimeZone(value, timezone, pattern);\n}\n\n/** ISO weekday (1=Mon … 7=Sun) and 'HH:mm' wall clock in the school timezone. Never the browser's. */\nexport function schoolNow(now: Date, tz: string): { isoDay: number; hhmm: string } {\n  return { isoDay: Number(formatInSchoolTz(now, 'i', tz)), hhmm: formatInSchoolTz(now, 'HH:mm', tz) };\n}\n\n/** The period running at hhmm ([start, end)) and the next one to start after hhmm. */\nexport function nowAndNext<P extends { startTime: string; endTime: string }>(\n  periods: P[],\n  hhmm: string,\n): { now: P | null; next: P | null } {\n  const sorted = [...periods].sort((a, b) => a.startTime.localeCompare(b.startTime));\n  return {\n    now: sorted.find((p) => p.startTime <= hhmm && hhmm < p.endTime) ?? null,\n    next: sorted.find((p) => p.startTime > hhmm) ?? null,\n  };\n}\n\n/** ISO weekday labels, index 1=Mon … 7=Sun (index 0 unused). */\nexport const ISO_DAY_NAMES = ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];\nimport { describe, expect, it } from 'vitest';\nimport { formatInSchoolTz } from '@/lib/dates';\n\ndescribe('formatInSchoolTz', () => {\n  const utcDate = '2024-01-15T17:30:00.000Z';\n\n  it('formats a UTC ISO string in the given timezone', () => {\n    expect(formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York')).toBe('2024-01-15 12:30');\n  });\n\n  it('formats a Date object the same way as an equivalent ISO string', () => {\n    const asDate = new Date(utcDate);\n    expect(formatInSchoolTz(asDate, 'yyyy-MM-dd HH:mm', 'America/New_York')).toBe(\n      formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York'),\n    );\n  });\n\n  it('produces a different wall-clock time for a different timezone', () => {\n    const inTokyo = formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'Asia/Tokyo');\n    const inNewYork = formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York');\n    expect(inTokyo).not.toBe(inNewYork);\n    expect(inTokyo).toBe('2024-01-16 02:30');\n  });\n\n  it('respects the given date-fns pattern', () => {\n    expect(formatInSchoolTz(utcDate, 'MMM d, yyyy', 'UTC')).toBe('Jan 15, 2024');\n  });\n});\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/** Extension point for the student detail page; later PRDs register their tab here. */\nexport const studentTabs: StudentTab[] = [\n  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\n];\n/** @type {import('next').NextConfig} */\nconst securityHeaders = [\n  { key: 'X-Content-Type-Options', value: 'nosniff' },\n  { key: 'Referrer-Policy', value: 'strict-origin-when-cross-origin' },\n  { key: 'X-Frame-Options', value: 'DENY' },\n  {\n    key: 'Content-Security-Policy',\n    value: \"default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self';\",\n  },\n];\n\nconst nextConfig = {\n  reactStrictMode: true,\n  async headers() {\n    return [\n      {\n        source: '/:path*',\n        headers: securityHeaders,\n      },\n    ];\n  },\n};\n\nmodule.exports = nextConfig;\nimport { defineConfig } from 'vitest/config.js';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\n{\n  \"name\": \"schoolhub\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"engines\": {\n    \"node\": \">=18.18.0\"\n  },\n  \"scripts\": {\n    \"dev\": \"next dev\",\n    \"build\": \"next build\",\n    \"start\": \"next start\",\n    \"lint\": \"next lint\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\",\n    \"test:e2e\": \"playwright test\",\n    \"db:migrate\": \"prisma migrate dev\",\n    \"db:deploy\": \"prisma migrate deploy\",\n    \"db:seed\": \"tsx prisma/seed.ts\",\n    \"db:reset\": \"prisma migrate reset --force\",\n    \"worker:email\": \"tsx scripts/worker-email.ts\",\n    \"format\": \"prettier --write .\"\n  },\n  \"dependencies\": {\n    \"@dnd-kit/core\": \"6.3.1\",\n    \"@dnd-kit/sortable\": \"10.0.0\",\n    \"@emotion/react\": \"11.13.3\",\n    \"@emotion/styled\": \"11.13.0\",\n    \"@hookform/resolvers\": \"3.9.0\",\n    \"@mui/icons-material\": \"9.5.0\",\n    \"@mui/material\": \"9.5.0\",\n    \"@mui/material-nextjs\": \"9.5.0\",\n    \"@mui/x-charts\": \"9.5.0\",\n    \"@mui/x-data-grid\": \"9.5.0\",\n    \"@mui/x-date-pickers\": \"9.5.0\",\n    \"@prisma/client\": \"5.20.0\",\n    \"@react-email/components\": \"0.0.25\",\n    \"@react-email/render\": \"1.0.1\",\n    \"bcrypt\": \"^6.0.0\",\n    \"date-fns\": \"3.6.0\",\n    \"date-fns-tz\": \"3.2.0\",\n    \"file-type\": \"20.5.0\",\n    \"next\": \"14.2.18\",\n    \"next-auth\": \"5.0.0-beta.25\",\n    \"nodemailer\": \"^6.9.14\",\n    \"papaparse\": \"^5.4.1\",\n    \"react\": \"18.3.1\",\n    \"react-dom\": \"18.3.1\",\n    \"react-hook-form\": \"7.53.0\",\n    \"react-is\": \"18.3.1\",\n    \"react-markdown\": \"10.1.0\",\n    \"rehype-sanitize\": \"6.0.0\",\n    \"remark-gfm\": \"4.0.1\",\n    \"zod\": \"3.23.8\"\n  },\n  \"devDependencies\": {\n    \"@axe-core/playwright\": \"4.10.0\",\n    \"@playwright/test\": \"1.47.2\",\n    \"@testing-library/jest-dom\": \"6.5.0\",\n    \"@testing-library/react\": \"16.0.1\",\n    \"@testing-library/user-event\": \"14.5.2\",\n    \"@types/bcrypt\": \"^6.0.0\",\n    \"@types/eslint\": \"^8.56.10\",\n    \"@types/node\": \"20.14.10\",\n    \"@types/nodemailer\": \"^6.4.15\",\n    \"@types/papaparse\": \"^5.3.14\",\n    \"@types/react\": \"18.3.3\",\n    \"@types/react-dom\": \"18.3.0\",\n    \"@typescript-eslint/eslint-plugin\": \"7.16.1\",\n    \"@typescript-eslint/parser\": \"7.16.1\",\n    \"@vitejs/plugin-react\": \"4.3.1\",\n    \"eslint\": \"8.57.0\",\n    \"eslint-config-next\": \"14.2.18\",\n    \"jsdom\": \"25.0.0\",\n    \"prettier\": \"3.3.3\",\n    \"prisma\": \"5.20.0\",\n    \"tsx\": \"4.16.2\",\n    \"typescript\": \"5.5.4\",\n    \"vitest\": \"2.1.1\"\n  },\n  \"overrides\": {\n    \"react-is\": \"18.3.1\",\n    \"playwright-core\": \"1.47.2\"\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"80a968fd-48d7-4da9-a01e-aaa2035d3ca9","uuid":"2dffc3f8-eb65-49f7-a93b-b1b14a04ad9d","timestamp":"2026-11-09T05:35:43.700Z","tool_use_result":{"stdout":"import { formatInTimeZone } from 'date-fns-tz';\n\n/**\n * Formats a UTC date/ISO-string in the school's configured timezone\n * (SchoolSettings.timezone). pattern is a date-fns format string.\n */\nexport function formatInSchoolTz(\n  date: Date | string,\n  pattern: string,\n  timezone: string,\n): string {\n  const value = typeof date === 'string' ? new Date(date) : date;\n  return formatInTimeZone(value, timezone, pattern);\n}\n\n/** ISO weekday (1=Mon … 7=Sun) and 'HH:mm' wall clock in the school timezone. Never the browser's. */\nexport function schoolNow(now: Date, tz: string): { isoDay: number; hhmm: string } {\n  return { isoDay: Number(formatInSchoolTz(now, 'i', tz)), hhmm: formatInSchoolTz(now, 'HH:mm', tz) };\n}\n\n/** The period running at hhmm ([start, end)) and the next one to start after hhmm. */\nexport function nowAndNext<P extends { startTime: string; endTime: string }>(\n  periods: P[],\n  hhmm: string,\n): { now: P | null; next: P | null } {\n  const sorted = [...periods].sort((a, b) => a.startTime.localeCompare(b.startTime));\n  return {\n    now: sorted.find((p) => p.startTime <= hhmm && hhmm < p.endTime) ?? null,\n    next: sorted.find((p) => p.startTime > hhmm) ?? null,\n  };\n}\n\n/** ISO weekday labels, index 1=Mon … 7=Sun (index 0 unused). */\nexport const ISO_DAY_NAMES = ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];\nimport { describe, expect, it } from 'vitest';\nimport { formatInSchoolTz } from '@/lib/dates';\n\ndescribe('formatInSchoolTz', () => {\n  const utcDate = '2024-01-15T17:30:00.000Z';\n\n  it('formats a UTC ISO string in the given timezone', () => {\n    expect(formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York')).toBe('2024-01-15 12:30');\n  });\n\n  it('formats a Date object the same way as an equivalent ISO string', () => {\n    const asDate = new Date(utcDate);\n    expect(formatInSchoolTz(asDate, 'yyyy-MM-dd HH:mm', 'America/New_York')).toBe(\n      formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York'),\n    );\n  });\n\n  it('produces a different wall-clock time for a different timezone', () => {\n    const inTokyo = formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'Asia/Tokyo');\n    const inNewYork = formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York');\n    expect(inTokyo).not.toBe(inNewYork);\n    expect(inTokyo).toBe('2024-01-16 02:30');\n  });\n\n  it('respects the given date-fns pattern', () => {\n    expect(formatInSchoolTz(utcDate, 'MMM d, yyyy', 'UTC')).toBe('Jan 15, 2024');\n  });\n});\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/** Extension point for the student detail page; later PRDs register their tab here. */\nexport const studentTabs: StudentTab[] = [\n  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\n];\n/** @type {import('next').NextConfig} */\nconst securityHeaders = [\n  { key: 'X-Content-Type-Options', value: 'nosniff' },\n  { key: 'Referrer-Policy', value: 'strict-origin-when-cross-origin' },\n  { key: 'X-Frame-Options', value: 'DENY' },\n  {\n    key: 'Content-Security-Policy',\n    value: \"default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self';\",\n  },\n];\n\nconst nextConfig = {\n  reactStrictMode: true,\n  async headers() {\n    return [\n      {\n        source: '/:path*',\n        headers: securityHeaders,\n      },\n    ];\n  },\n};\n\nmodule.exports = nextConfig;\nimport { defineConfig } from 'vitest/config.js';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\n{\n  \"name\": \"schoolhub\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"engines\": {\n    \"node\": \">=18.18.0\"\n  },\n  \"scripts\": {\n    \"dev\": \"next dev\",\n    \"build\": \"next build\",\n    \"start\": \"next start\",\n    \"lint\": \"next lint\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\",\n    \"test:e2e\": \"playwright test\",\n    \"db:migrate\": \"prisma migrate dev\",\n    \"db:deploy\": \"pris