{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vy1NT4mZzrJW7SmxnEJooc","type":"tool_result","content":"1\timport { describe, expect, it, vi } from 'vitest';\n2\timport { z, ZodError } from 'zod';\n3\timport { Prisma } from '@prisma/client';\n4\timport { AppError, ok, paginated, apiError, withHandler, parsePagination, parseBody, parseQuery } from '@/server/http';\n5\t\n6\tvi.mock('@/lib/logger', () => ({\n7\t  logger: { info: vi.fn(), warn: vi.fn(), error: vi.fn() },\n8\t}));\n9\t\n10\tdescribe('ok/paginated/apiError envelopes', () => {\n11\t  it('ok() wraps the payload in { data }', async () => {\n12\t    const res = ok({ foo: 'bar' });\n13\t    expect(res.status).toBe(200);\n14\t    expect(await res.json()).toEqual({ data: { foo: 'bar' } });\n15\t  });\n16\t\n17\t  it('paginated() includes data + meta', async () => {\n18\t    const res = paginated([1, 2], { page: 1, pageSize: 20, total: 2 });\n19\t    expect(await res.json()).toEqual({ data: [1, 2], meta: { page: 1, pageSize: 20, total: 2 } });\n20\t  });\n21\t\n22\t  it('apiError() maps each code to its documented status', async () => {\n23\t    expect((await apiError('VALIDATION_ERROR', 'bad')).status).toBe(400);\n24\t    expect((await apiError('NOT_FOUND', 'missing')).status).toBe(404);\n25\t    expect((await apiError('CONFLICT', 'dupe')).status).toBe(409);\n26\t    expect((await apiError('INTERNAL', 'boom')).status).toBe(500);\n27\t    const res = apiError('NOT_FOUND', 'missing', { id: '1' });\n28\t    expect(await res.json()).toEqual({ error: { code: 'NOT_FOUND', message: 'missing', details: { id: '1' } } });\n29\t  });\n30\t});\n31\t\n32\tdescribe('withHandler error mapping', () => {\n33\t  it('maps ZodError to VALIDATION_ERROR (400)', async () => {\n34\t    const handler = withHandler(async () => {\n35\t      z.object({ name: z.string() }).parse({});\n36\t      throw new Error('unreachable');\n37\t    });\n38\t    const res = await handler();\n39\t    expect(res.status).toBe(400);\n40\t    expect((await res.json()).error.code).toBe('VALIDATION_ERROR');\n41\t  });\n42\t\n43\t  it('maps AppError to its own code/status', async () => {\n44\t    const handler = withHandler(async () => {\n45\t      throw new AppError('CONFLICT', 'already exists');\n46\t    });\n47\t    const res = await handler();\n48\t    expect(res.status).toBe(409);\n49\t    expect((await res.json()).error).toEqual({ code: 'CONFLICT', message: 'already exists' });\n50\t  });\n51\t\n52\t  it('maps Prisma P2002 to CONFLICT', async () => {\n53\t    const handler = withHandler(async () => {\n54\t      throw new Prisma.PrismaClientKnownRequestError('Unique constraint failed', {\n55\t        code: 'P2002',\n56\t        clientVersion: '5.20.0',\n57\t        meta: { target: ['email'] },\n58\t      });\n59\t    });\n60\t    const res = await handler();\n61\t    expect(res.status).toBe(409);\n62\t    expect((await res.json()).error.code).toBe('CONFLICT');\n63\t  });\n64\t\n65\t  it('maps Prisma P2025 to NOT_FOUND', async () => {\n66\t    const handler = withHandler(async () => {\n67\t      throw new Prisma.PrismaClientKnownRequestError('Record not found', {\n68\t        code: 'P2025',\n69\t        clientVersion: '5.20.0',\n70\t      });\n71\t    });\n72\t    const res = await handler();\n73\t    expect(res.status).toBe(404);\n74\t    expect((await res.json()).error.code).toBe('NOT_FOUND');\n75\t  });\n76\t\n77\t  it('maps anything else to INTERNAL (500) without leaking the message', async () => {\n78\t    const handler = withHandler(async () => {\n79\t      throw new Error('some internal secret detail');\n80\t    });\n81\t    const res = await handler();\n82\t    expect(res.status).toBe(500);\n83\t    const body = await res.json();\n84\t    expect(body.error.code).toBe('INTERNAL');\n85\t    expect(body.error.message).not.toContain('secret');\n86\t  });\n87\t\n88\t  it('passes through a successful response untouched', async () => {\n89\t    const handler = withHandler(async () => ok({ ok: true }));\n90\t    const res = await handler();\n91\t    expect(res.status).toBe(200);\n92\t  });\n93\t});\n94\t\n95\tdescribe('parsePagination', () => {\n96\t  it('defaults to page 1 / pageSize 20', () => {\n97\t    expect(parsePagination(new URLSearchParams())).toEqual({ page: 1, pageSize: 20, skip: 0, take: 20 });\n98\t  });\n99\t\n100\t  it('clamps pageSize to a max of 100', () => {\n101\t    expect(parsePagination(new URLSearchParams('pageSize=500')).pageSize).toBe(100);\n102\t  });\n103\t\n104\t  it('clamps page to a minimum of 1', () => {\n105\t    expect(parsePagination(new URLSearchParams('page=0')).page).toBe(1);\n106\t    expect(parsePagination(new URLSearchParams('page=-5')).page).toBe(1);\n107\t  });\n108\t\n109\t  it('computes skip/take from page/pageSize', () => {\n110\t    expect(parsePagination(new URLSearchParams('page=3&pageSize=10'))).toEqual({\n111\t      page: 3,\n112\t      pageSize: 10,\n113\t      skip: 20,\n114\t      take: 10,\n115\t    });\n116\t  });\n117\t\n118\t  it('falls back to defaults on non-numeric input', () => {\n119\t    expect(parsePagination(new URLSearchParams('page=abc&pageSize=xyz'))).toEqual({\n120\t      page: 1,\n121\t      pageSize: 20,\n122\t      skip: 0,\n123\t      take: 20,\n124\t    });\n125\t  });\n126\t});\n127\t\n128\tdescribe('parseBody / parseQuery', () => {\n129\t  const schema = z.object({ name: z.string() });\n130\t\n131\t  it('parseBody resolves parsed JSON matching the schema', async () => {\n132\t    const request = new Request('http://test', { method: 'POST', body: JSON.stringify({ name: 'Ada' }) });\n133\t    await expect(parseBody(request, schema)).resolves.toEqual({ name: 'Ada' });\n134\t  });\n135\t\n136\t  it('parseBody throws ZodError on invalid JSON body', async () => {\n137\t    const request = new Request('http://test', { method: 'POST', body: JSON.stringify({}) });\n138\t    await expect(parseBody(request, schema)).rejects.toBeInstanceOf(ZodError);\n139\t  });\n140\t\n141\t  it('parseQuery