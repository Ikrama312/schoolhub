unction DateDisplay({ date, pattern = DEFAULT_PATTERN, timezone }: DateDisplayProps) {\n  return <span>{formatInSchoolTz(date, pattern, timezone)}</span>;\nsrc/app/(app)/courses/[courseId]:\nassignments\nattendance\nCourseTabs.tsx\nlayout.tsx\npage.tsx\nquizzes\nroster\n\nsrc/app/(app)/students/[id]:\nassignments\nattendance\ncourses\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { AppError } from '@/server/http';\nimport { getCourse } from '@/server/courses/courses-service';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { CourseTabs } from './CourseTabs';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course home shell — PRD-05 FR-16/FR-18. Gate once here; tabs inherit it. */\nexport default async function CourseLayout({\n  params,\n  children,\n}: {\n  params: { courseId: string };\n  children: React.ReactNode;\n}) {\n  const user = await requirePageRole(...ALL_ROLES);\n  try {\n    await assertCanViewCourse(user, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const course = await getCourse(params.courseId);\n  const teachers = [course.teacher, ...course.coTeachers].map((t) => t.name).join(', ');\n\n  return (\n    <Box>\n      <Paper variant=\"outlined\" sx={{ mb: 2, overflow: 'hidden' }}>\n        <Box sx={{ height: 8, bgcolor: course.subject.color }} />\n        <Box sx={{ p: 2 }}>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {course.name}\n          </Typography>\n          <Stack direction=\"row\" spacing={2} sx={{ mt: 0.5, flexWrap: 'wrap', color: 'text.secondary' }} useFlexGap>\n            <Typography variant=\"body2\">{course.code}</Typography>\n            <Typography variant=\"body2\">Teachers: {teachers}</Typography>\n            {course.section && <Typography variant=\"body2\">Section {course.section.name}</Typography>}\n            {course.section?.room && <Typography variant=\"body2\">Room {course.section.room.name}</Typography>}\n          </Stack>\n        </Box>\n      </Paper>\n      <CourseTabs courseId={course.id} role={user.role} />\n      {children}\n    </Box>\n  );\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"c6f85ae0-4ad4-4d10-b797-6ff9d3e2b1f5","uuid":"cc05fac1-c060-4dcb-b65d-60a0be54fda8","timestamp":"2026-11-09T12:36:19.057Z","tool_use_result":{"stdout":"src/components/Toast/useToast.ts:6:export interface ToastOptions {\nsrc/components/Toast/useToast.ts:11:export interface ToastContextValue {\nsrc/components/Toast/useToast.ts:15:export const ToastContext = createContext<ToastContextValue | null>(null);\nsrc/components/Toast/useToast.ts:17:export function useToast(): ToastContextValue {\nsrc/components/ConfirmDialog/ConfirmDialog.tsx:12:export interface ConfirmDialogProps {\nsrc/components/ConfirmDialog/ConfirmDialog.tsx:23:export function ConfirmDialog({\nsrc/components/DateDisplay/DateDisplay.tsx:3:export interface DateDisplayProps {\nsrc/components/DateDisplay/DateDisplay.tsx:12:export function DateDisplay({ date, pattern = DEFAULT_PATTERN, timezone }: DateDisplayProps) {\nsrc/components/PageHeader/PageHeader.tsx:8:export interface Breadcrumb {\nsrc/components/PageHeader/PageHeader.tsx:13:export interface PageHeaderProps {\nsrc/components/PageHeader/PageHeader.tsx:20:export function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\nsrc/components/EmptyState/EmptyState.tsx:6:export interface EmptyStateProps {\nsrc/components/EmptyState/EmptyState.tsx:13:export function EmptyState({ icon, tit