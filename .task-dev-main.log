\n  const existing = await prisma.room.findUniqueOrThrow({ where: { id } });\n  return prisma.room.update({\n    where: { id },\n    data: {\n      name: input.name ?? existing.name,\n      building: input.building === undefined ? existing.building : input.building,\n      capacity: input.capacity === undefined ? existing.capacity : input.capacity,\n      archivedAt: input.archived === undefined ? existing.archivedAt : input.archived ? new Date() : null,\n    },\nsrc/server/services/gradeLevels.ts:3:export interface GradeLevelInput {\nsrc/server/services/gradeLevels.ts:9:export interface UpdateGradeLevelInput {\nsrc/server/services/gradeLevels.ts:16:export async function listGradeLevels(includeArchived = false) {\nsrc/server/services/gradeLevels.ts:23:export async function createGradeLevel(input: GradeLevelInput) {\nsrc/server/services/gradeLevels.ts:27:export async function updateGradeLevel(id: string, input: UpdateGradeLevelInput) {\nsrc/server/services/subjects.ts:4:export interface SubjectInput {\nsrc/server/services/subjects.ts:11:export interface UpdateSubjectInput extends Partial<SubjectInput> {\nsrc/server/services/subjects.ts:16:export function normalizeCode(code: string): string {\nsrc/server/services/subjects.ts:27:export async function listSubjects(q?: string) {\nsrc/server/services/subjects.ts:36:export async function createSubject(input: SubjectInput) {\nsrc/server/services/subjects.ts:42:export async function updateSubject(id: string, input: UpdateSubjectInput) {","is_error":false}]},"parent_tool_use_id":null,"session_id":"a6e489fc-abc2-4cf6-8575-95ca4cd13810","uuid":"0a836bc4-9a33-42df-8754-1005d5077bc8","timestamp":"2026-10-27T16:47:27.179Z","tool_use_result":{"stdout":"dates.ts\nenv.ts\nlogger.ts\nvalidators\n(eval):1: no matches found: --include=*.tsx\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}