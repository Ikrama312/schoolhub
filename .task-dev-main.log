severity=\"info\">No online submission. This assignment is graded by your teacher.</Alert>;\n\n    const receipt = submission && (\n      <Stack spacing={1.5}>\n        <Typography>\n          {submission.attemptNumber === 0\n            ? 'Graded without a submission'\n            : `Submitted ${formatInSchoolTz(submission.submittedAt, 'EEE d MMM yyyy, HH:mm', timezone)} (attempt ${submission.attemptNumber})`}\n          {submission.isLate && <Chip size=\"small\" color=\"warning\" label={`Late · ${submission.lateDays} day${submission.lateDays === 1 ? '' : 's'}`} sx={{ ml: 1 }} />}\n        </Typography>\n        <Alert severity=\"info\">Submitted — awaiting grading</Alert>\n        {submission.text && (\n          <Paper variant=\"outlined\" sx={{ p: 2 }}>\n            <MarkdownView source={submission.text} />\n          </Paper>\n        )}\n        <FileList files={submission.files} />\n      </Stack>\n    );\n\n    if (readOnly) return receipt ?? <Typography color=\"text.secondary\">Not submitted yet.</Typography>;\n    if (!editing) {\n      return (\n        <Stack spacing={2}>\n          {receipt}\n          {open && a.submissionType !== 'NO_SUBMISSION' && (\n            <Box>\n              <Button variant=\"outlined\" onClick={() => setEditing(true)}>\n                Resubmit\n              </Button>\n            </Box>\n          )}\n        </Stack>\n      );\n    }\n    if (!open) return <Alert severity=\"warning\">The deadline has passed and late submissions are closed.</Alert>;\n    return (\n      <Stack spacing={2}>\n        {now > due && <Alert severity=\"warning\">This will be marked late.</Alert>}\n        {takesText && <MarkdownEditor label=\"Your answer\" value={text} onChange={changeText} maxLength={SUBMISSION_TEXT_MAX} />}\n        {takesFiles && <FileUpload context=\"submission\" max={a.maxFileCount} value={files} onChange={setFiles} />}\n        {error && <Alert severity=\"error\">{error}</Alert>}\n        <Stack direction=\"row\" spacing={1}>\n          <Button variant=\"contained\" disabled={!canSubmit} onClick={() => setConfirm(true)}>\n            Submit\n          </Button>\n          {submission && <Button onClick={() => setEditing(false)}>Cancel</Button>}\n        </Stack>\n      </Stack>\n    );\n  })();\n\n  return (\n    <Paper variant=\"outlined\" sx={{ p: 2 }}>\n      <Typography variant=\"h6\" component=\"h2\" gutterBottom>\n        {readOnly ? 'Submission' : 'Your work'}\n      </Typography>\n      <Divider sx={{ mb: 2 }} />\n      {body}\n      <ConfirmDialog\n        open={confirm}\n        title={submission ? 'Resubmit your work?' : 'Submit your work?'}\n        description={submission ? 'Your previous attempt will be replaced. Your teacher can still see earlier attempts.' : 'You can resubmit until the deadline, unless your work has been returned.'}\n        confirmLabel=\"Submit\"\n        onConfirm={doSubmit}\n        onCancel={() => setConfirm(false)}\n      />\n    </Paper>\n  );\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01H76qqe9XDcu6Urweik9WMj","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgrq7QCo97RkccJTcUyxA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q3wXvssrMrWV5GDnqSGWMz","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/src/app/(app)/courses/[courseId]/assignments/[assignmentId]/page.tsx","content":"import NextLink from 'next/link';\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Grid from '@mui/material/Grid';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport Typography from '@mui/material/Typography';\nimport { requirePageUser } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getAssignment, getSchoolTimezone, type AssignmentDto } from '@/server/assignments/assignments-service';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { MarkdownView } from '@/components/MarkdownView/MarkdownView';\nimport { FileList } from '@/components/FileList/FileList';\nimport { DueCountdown, SubmissionPanel } from './SubmissionPanel';\n\nexport const dynamic = 'force-dynamic';\n\nconst pts = (s: string) => String(Number(s));\nconst TYPE_LABELS = { ONLINE_TEXT: 'Online text', FILE_UPLOAD: 'File upload', TEXT_AND_FILE: 'Text and file', NO_SUBMISSION: 'No submission' } as const;\n\nfunction latePolicy(a: AssignmentDto, tz: string): string {\n  if (!a.allowLate) return 'Late submissions are not accepted.';\n  const cutoff = a.lateCutoffAt ? ` until ${formatInSchoolTz(a.lateCutoffAt, 'EEE d MMM, HH:mm', tz)}` : '';\n  const penalty = Number(a.latePenaltyPercentPerDay) > 0 ? `, ${pts(a.latePenaltyPercentPerDay)} % per day late (max ${pts(a.maxLatePenaltyPercent)} %)` : ', no penalty';\n  return `Late submissions accepted${cutoff}${penalty}.`;\n}\n\n/** FR-19: assignment page. Non-managers get NOT_FOUND unless visible (service). */\nexport default async function AssignmentPage({ params, searchParams }: { params: { courseId: string; assignmentId: string }; searchParams: { studentId?: string } }) {\n  const user = await requirePageUser();\n  let data: Awaited<ReturnType<typeof getAssignment>>;\n  try {\n    data = await getAssignment(user, params.assignmentId, searchParams.studentId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const a = data.assignment;\n  if (a.courseId !== params.courseId) notFound();\n  const tz = await getSchoolTimezone();\n\n  return (\n    <Box>\n      <PageHeader\n        title={a.title}\n        breadcrumbs={[{ label: 'Assignments', href: `/courses/${params.courseId}/assignments` }, { label: a.title }]}\n        actions={\n          data.canManage ? (\n            <>\n              <Button variant=\"outlined\" component={NextLink} href={`/courses/${params.courseId}/assignments/${a.id}/edit`}>\n                Edit\n              </Button>\n              <Button variant=\"contained\" component={NextLink} href={`/courses/${params.courseId}/assignments/${a.id}/grade`}>\n                Grade\n              </Button>\n            </>\n          ) : undefined\n        }\n      />\n      <Grid container spacing={2}>\n        <Grid size={{ xs: 12, md: 7 }}>\n          <Stack spacing={2}>\n            <Paper variant=\"outlined\" sx={{ p: 2 }}>\n              <Stack direction=\"row\" spacing={1} useFlexGap sx={{ flexWrap: 'wrap', alignItems: 'center', mb: 1 }}>\n                <Typography variant=\"body1\" sx={{ fontWeight: 600 }}>\n                  Due {formatInSchoolTz(a.dueAt, 'EEE d MMM yyyy, HH:mm', tz)}\n                </Typography>\n                <DueCountdown dueAt={a.dueAt} serverNow={data.serverNow} />\n                {data.canManage && <Chip size=\"small\" label={a.status.charAt(0) + a.status.slice(1).toLowerCase()} />}\n                {a.archivedAt && <Chip size=\"small\" variant=\"outlined\" label=\"Archived\" />}\n              </Stack>\n              <Typography variant=\"body2\" color=\"text.secondary\">\n                {pts(a.maxPoints)} points · {TYPE_LABELS[a.submissionType]}\n                {a.allowExtraCredit ? ' · extra credit allowed' : ''}\n              </Typography>\n              <Typography variant=\"body2\" color=\"text.secondary\">\n                {latePolicy(a, tz)}\n              </Typography>\n            </Paper>\n            {(a.instructions.trim() || a.attachments.length > 0) && (\n              <Paper variant=\"outlined\" sx={{ p: 2 }}>\n                <MarkdownView source={a.instructions} />\n                <FileList files={a.attachments} />\n              </Paper>\n            )}\n            {a.rubric && (\n              <Paper variant=\"outlined\" sx={{ p: 2, overflowX: 'auto' }}>\n                <Typography variant=\"h6\" component=\"h2\" gutterBottom>\n                  Rubric\n                </Typography>\n                <Table size=\"small\" aria-label=\"Rubric\">\n                  <TableHead>\n                    <TableRow>\n                      <TableCell>Criterion</TableCell>\n                      <TableCell>Levels</TableCell>\n                      <TableCell align=\"right\">Max</TableCell>\n                    </TableRow>\n                  </TableHead>\n                  <TableBody>\n                    {a.rubric.map((c) => (\n                      <TableRow key={c.id}>\n                        <TableCell>\n                          <Typography variant=\"body2\" sx={{ fontWeight: 600 }}>\n                            {c.title}\n                          </Typography>\n                          <Typography variant=\"caption\" color=\"text.secondary\">\n                            {c.description}\n                          </Typography>\n                        </TableCell>\n                        <TableCell>\n                          {c.levels.map((l) => (\n                            <Typography key={l.label} variant=\"body2\">\n                              {l.label} — {pts(l.points)}\n                              {l.description ? `: ${l.description}` : ''}\n                            </Typography>\n                          ))}\n                        </TableCell>\n                        <TableCell align=\"right\">{pts(c.maxPoints)}</TableCell>\n                      </TableRow>\n                    ))}\n                  </TableBody>\n                </Table>\n              </Paper>\n            )}\n          </Stack>\n        </Grid>\n        <Grid size={{ xs: 12, md: 5 }}>\n          {data.canManage ? (\n            <Paper variant=\"outlined\" sx={{ p: 2 }}>\n              <Typography variant=\"h6\" component=\"h2\" gutterBottom>\n                Submissions\n              </Typography>\n              <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mb: 2 }}>\n                {data.submissionCount} submitted\n              </Typography>\n              <Button variant=\"contained\" component={NextLink} href={`/courses/${params.courseId}/assignments/${a.id}/grade`}>\n                Open grading\n              </Button>\n            </Paper>\n          ) : (\n            <SubmissionPanel\n              assignment={a}\n              submission={data.submission}\n              exempt={data.exempt}\n              userId={user.id}\n              readOnly={user.role !== 'STUDENT'}\n              timezone={tz}\n              serverNow={data.serverNow}\n            />\n          )}\n        </Grid>\n      </Grid>\n    </Box>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2753,"cache_read_input_tokens":237380,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2753},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"80a968fd-48d7-4da9-a01e-aaa2035d3ca9","uuid":"5794d0a0-a643-4971-b395-e796b67d96f4","timestamp":"2026-11-09T05:50:53.179Z","request_id":"req_011Cgrq7PvgAz4WZYFTxfHoF","wire_tool_inputs":{"toolu_01Q3wXvssrMrWV5GDnqSGWMz":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/src/app/(app)/courses/[courseId]/assignments/[assignmentId]/page.tsx","content":"import NextLink from 'next/link';\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Grid from '@mui/material/Grid';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport Typography from '@mui/material/Typography';\nimport { requirePageUser } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getAssignment, getSchoolTimezone, type AssignmentDto } from '@/server/assignments/assignments-service';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { MarkdownView } from '@/components/MarkdownView/MarkdownView';\nimport { FileList } from '@/components/FileList/FileList';\nimport { DueCountdown, SubmissionPanel } from './Subm