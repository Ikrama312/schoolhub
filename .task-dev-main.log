{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018tWpKBwedjFwTFifHAB5iH","type":"tool_result","content":"  return prisma.user.update({\n    where: { id: userId },\n    data: { lockedUntil: null, failedLoginCount: 0 },\n    select: { id: true, lockedUntil: true, failedLoginCount: true },\n  });\n}\n\n/** FR-26: a fresh 7-day INVITE token (older unused ones are invalidated). Returns the raw token. */\nexport function createInviteToken(userId: string): Promise<string> {\n  return createToken(userId, 'INVITE', INVITE_TTL);\n}\n\n/**\n * FR-25/FR-27: issue an invite token and email the link. Call sites\n * (POST /api/users/:id/invite, createUser's sendInvite checkbox, CSV import)\n * keep the same {id, inviteSentAt} shape.\n */\nexport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n  const user = await prisma.user.findUnique({ where: { id: userId }, select: { email: true, firstName: true } });\n  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n  const raw = await createInviteToken(userId);\n  await sendAuthEmail(user, 'invite', authLink('invite', raw));\n  return { id: userId, inviteSentAt: new Date() };\n}\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport { formatInTimeZone } from 'date-fns-tz';\nimport { env } from '@/lib/env';\nimport { prisma } from '@/server/db';\nimport { INVITE_TTL } from '@/server/auth/tokens';\nimport { enqueueEmail } from '@/server/email/outbox';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\n\nexport type AuthEmailKind = 'invite' | 'password-reset';\n\nconst PATHS: Record<AuthEmailKind, string> = { invite: '/invite/', 'password-reset': '/reset-password/' };\nconst SUBJECTS: Record<AuthEmailKind, string> = {\n  invite: \"You're invited to SchoolHub\",\n  'password-reset': 'Reset your SchoolHub password',\n};\n\nexport function authLink(kind: AuthEmailKind, rawToken: string): string {\n  return new URL(PATHS[kind] + encodeURIComponent(rawToken), env.APP_URL).toString();\n}\n\n/**\n * PRD-04 FR-16: renders the invite/password-reset template and enqueues one\n * EmailOutbox row (no Notification row, no preference lookup). Unlike\n * notify(), this still throws: a silently lost invite/reset is worse than a\n * 500. The raw link is never logged.\n */\nexport async function sendAuthEmail(\n  user: { email: string; firstName?: string },\n  kind: AuthEmailKind,\n  link: string,\n): Promise<void> {\n  const school = await getEmailSchool();\n  const name = user.firstName ?? '';\n  let rendered: { html: string; text: string };\n  if (kind === 'invite') {\n    const settings = await prisma.schoolSettings.findUnique({ where: { id: 'singleton' }, select: { timezone: true } });\n    const expires = new Date(Date.now() + INVITE_TTL.days * 24 * 60 * 60_000);\n    const expiresAt = formatInTimeZone(expires, settings?.timezone ?? 'UTC', 'MMMM d, yyyy');\n    rendered = await renderEmail('invite', { name: name || 'there', link, expiresAt }, school);\n  } else {\n    rendered = await renderEmail('password-reset', { name: name || undefined, link }, school);\n  }\n  await enqueueEmail({ toEmail: user.email, toName: name || null, subject: SUBJECTS[kind], ...rendered });\n}\nsrc/app/providers.tsx:9:import { ToastProvider } from '@/components/Toast/ToastProvider';\nsrc/app/providers.tsx:17:          <ToastProvider>{children}</ToastProvider>\n'use client';\n\nimport { Controller, type Control, type FieldValues, type Path } from 'react-hook-form';\nimport TextField, { type TextFieldProps } from '@mui/material/TextField';\nimport MenuItem from '@mui/material/MenuItem';\nimport Checkbox from '@mui/material/Checkbox';\nimport Switch from '@mui/material/Switch';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormControl from '@mui/material/FormControl';\nimport FormLabel from '@mui/material/FormLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Radio from '@mui/material/Radio';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { DateTimePicker } from '@mui/x-date-pickers/DateTimePicker';\n\ninterface BaseProps<TFieldValues extends FieldValues> {\n  name: Path<TFieldValues>;\n  control: Control<TFieldValues>;\n  label: string;\n  helperText?: string;\n}\n\n/** Plain text / number / etc. MUI TextField bound via Controller. */\nexport function TextFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  ...rest\n}: BaseProps<TFieldValues> & Omit<TextFieldProps, 'name' | 'label' | 'error' | 'helperText'>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          {...rest}\n          label={label}\n          error={Boolean(fieldState.error)}\n          helperText={fieldState.error?.message ?? helperText}\n          fullWidth\n        />\n      )}\n    />\n  );\n}\n\nexport interface SelectOption {\n  value: string;\n  label: string;\n}\n\nexport function SelectFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,","is_error":false}]},"parent_tool_use_id":null,"session_id":"3418fb08-df3a-4486-bb21-2c26927907e3","uuid":"32753400-1a2a-426f-982c-e342be5cc0fa","timestamp":"2026-11-05T06:59:37.065Z","tool_use_result":{"stdout":"  return prisma.user.update({\n    where: { id: userId },\n    data: { lockedUntil: null, failedLoginCount: 0 },\n    select: { id: true, lockedUntil: true, failedLoginCount: true },\n  });\n}\n\n/** FR-26: a fresh 7-day INVITE token (older unused ones are invalidated). Returns the raw token. */\nexport function createInviteToken(userId: string): Promise<string> {\n  return createToken(userId, 'INVITE', INVITE_TTL);\n}\n\n/**\n * FR-25/FR-27: issue an invite token and email the link. Call sites\n * (POST /api/users/:id/invite, createUser's sendInvite checkbox, CSV import)\n * keep the same {id, inviteSentAt} shape.\n */\nexport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n  const user = await prisma.user.findUnique({ where: { id: userId }, select: { email: true, firstName: true } });\n  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n  const raw = await createInviteToken(userId);\n  await sendAuthEmail(user, 'invite', authLink('invite', raw));\n  return { id: userId, inviteSentAt: new Date() };\n}\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport { formatInTimeZone } from 'date-fns-tz';\nimport { env } from '@/lib/env';\nimport { prisma } from '@/server/db';\nimport { INVITE_TTL } from '@/server/auth/tokens';\nimport { enqueueEmail } from '@/server/email/outbox';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\n\nexport type AuthEmailKind = 'invite' | 'password-reset';\n\nconst PATHS: Record<AuthEmailKind, string> = { invite: '/invite/', 'password-reset': '/reset-password/' };\nconst SUBJECTS: Record<AuthEmailKind, string> = {\n  invite: \"You're invited to SchoolHub\",\n  'password-reset': 'Reset your SchoolHub password',\n};\n\nexport function authLink(kind: AuthEmailKind, rawToken: string): string {\n  return new URL(PATHS[kind] + encodeURIComponent(rawToken), env.APP_URL).toString();\n}\n\n/**\n * PRD-04 FR-16: renders the invite/password-reset template and enqueues one\n * EmailOutbox row (no Notification row, no preference lookup). Unlike\n * notify(), this still throws: a silently lost invite/reset is worse than a\n * 500. The raw link is never logged.\n */\nexport async function sendAuthEmail(\n  user: { email: string; firstName?: string },\n  kind: AuthEmailKind,\n  link: string,\n): Promise<void> {\n  const school = await getEmailSchool();\n  const name = user.firstName ?? '';\n  let rendered: { html: string; text: string };\n  if (kind === 'invite') {\n    const settings = await prisma.schoolSettings.findUnique({ where: { id: 'singleton' }, select: { timezone: true } });\n    const expires = new Date(Date.now() + INVITE_TTL.days * 24 * 60 * 60_000);\n    const expiresAt = formatInTimeZone(expires, settings?.timezone ?? 'UTC', 'MMMM d, yyyy');\n    rendered = await renderEmail('invite', { name: name || 'there', link, expiresAt }, school);\n  } else {\n    rendered = await renderEmail('password-reset', { name: name || undefined, link }, school);\n  }\n  await enqueueEmail({ toEmail: user.email, toName: name || null, subject: SUBJECTS[kind], ...rendered });\n}\nsrc/app/providers.tsx:9:import { ToastProvider } from '@/components/Toast/ToastProvider';\nsrc/app/providers.tsx:17:          <ToastProvider>{children}</ToastProvider>\n'use client';\n\nimport { Controller, type Control, type FieldValues, type Path } from 'react-hook-form';\nimport TextField, { type TextFieldProps } from '@mui/material/TextField';\nimport MenuItem from '@mui/material/MenuItem';\nimport Checkbox from '@mui/material/Checkbox';\nimport Switch from '@mui/material/Switch';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormControl from '@mui/material/FormControl';\nimport FormLabel from '@mui/material/FormLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Radio from '@mu