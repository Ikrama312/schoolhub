{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg69NXgbZz5zo39K18hc1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VK1Zmu3qkuPi7Rb2wEi1pL","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/Toast/ToastProvider.tsx","content":"'use client';\n\nimport { useCallback, useMemo, useRef, useState } from 'react';\nimport Snackbar from '@mui/material/Snackbar';\nimport Alert from '@mui/material/Alert';\nimport { ToastContext, type ToastOptions } from './useToast';\n\nconst AUTO_HIDE_MS = 5000;\n\ninterface QueuedToast extends ToastOptions {\n  key: number;\n}\n\nexport function ToastProvider({ children }: { children: React.ReactNode }) {\n  const [queue, setQueue] = useState<QueuedToast[]>([]);\n  const [current, setCurrent] = useState<QueuedToast | null>(null);\n  const [open, setOpen] = useState(false);\n  const nextKey = useRef(0);\n\n  const showToast = useCallback((options: ToastOptions) => {\n    nextKey.current += 1;\n    setQueue((prev) => [...prev, { ...options, key: nextKey.current }]);\n  }, []);\n\n  if (!current && queue.length > 0 && !open) {\n    setCurrent(queue[0]);\n    setQueue((prev) => prev.slice(1));\n    setOpen(true);\n  }\n\n  const handleClose = (_event?: unknown, reason?: string) => {\n    if (reason === 'clickaway') return;\n    setOpen(false);\n  };\n\n  const handleExited = () => {\n    setCurrent(null);\n  };\n\n  const value = useMemo(() => ({ showToast }), [showToast]);\n\n  return (\n    <ToastContext.Provider value={value}>\n      {children}\n      <Snackbar\n        key={current?.key}\n        open={open}\n        autoHideDuration={AUTO_HIDE_MS}\n        onClose={handleClose}\n        TransitionProps={{ onExited: handleExited }}\n        anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}\n      >\n        {current ? (\n          <Alert onClose={handleClose} severity={current.severity ?? 'info'} variant=\"filled\" sx={{ width: '100%' }}>\n            {current.message}\n          </Alert>\n        ) : undefined}\n      </Snackbar>\n    </ToastContext.Provider>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1621,"cache_read_input_tokens":83203,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1621},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab594185-c31c-412a-a5f0-563328d811ca","uuid":"89c8abba-4251-40a6-842a-f895b358a646","timestamp":"2026-10-16T15:22:47.191Z","request_id":"req_011Cg69NXMzd2BbE9X16qcgx"}
