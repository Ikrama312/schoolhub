{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QXDfBpQBY32WpZ9eKVGqbw","type":"tool_result","content":"}: {\n  years: YearOption[];\n  currentYearId: string | null;\n  gradeLevels: Option[];\n  rooms: Option[];\n  initialRows: SectionRow[];\n  initialTotal: number;\n}) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  const { showToast } = useToast();\n  const yearId = searchParams.get('academicYearId') ?? currentYearId ?? '';\n\n  const [rows, setRows] = useState(initialRows);\n  const [total, setTotal] = useState(initialTotal);\n  const [loading, setLoading] = useState(false);\n  const [form, setForm] = useState<FormState | null>(null);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [saving, setSaving] = useState(false);\n  const [toDelete, setToDelete] = useState<SectionRow | null>(null);\n  const [confirmCopy, setConfirmCopy] = useState(false);\n\n  const copyTarget = years.find((y) => y.isCopyTarget && y.id !== yearId) ?? null;\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const params = new URLSearchParams(searchParams.toString());\n      if (yearId) params.set('academicYearId', yearId);\n      const json = await send(`/api/sections?${params.toString()}`, 'GET');\n      setRows(json.data);\n      setTotal(json.meta.total);\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setLoading(false);\n    }\n  }, [searchParams, yearId, showToast]);\n\n  useEffect(() => {\n    void load();\n  }, [load]);\n\n  const setYear = (id: string) => {\n    const next = new URLSearchParams(searchParams.toString());\n    next.set('academicYearId', id);\n    next.set('page', '1');\n    router.push(`${pathname}?${next.toString()}`);\n  };\n\n  const openEdit = (row: SectionRow) =>\n    setForm({\n      id: row.id,\n      gradeLevelId: row.gradeLevelId,\n      name: row.name,\n      homeroomTeacher: row.homeroomTeacher\n        ? { id: row.homeroomTeacher.id, name: row.homeroomTeacher.name, email: '', role: 'TEACHER' }\n        : null,\n      roomId: row.roomId ?? '',\n      capacity: String(row.capacity),\n    });\n\n  const save = async () => {\n    if (!form) return;\n    const payload = {\n      academicYearId: yearId,\n      gradeLevelId: form.gradeLevelId,\n      name: form.name,\n      homeroomTeacherId: form.homeroomTeacher?.id ?? null,\n      roomId: form.roomId || null,\n      capacity: form.capacity,\n    };\n    const parsed = sectionInputSchema.safeParse(payload);\n    if (!parsed.success) {\n      const fieldErrors = parsed.error.flatten().fieldErrors;\n      setErrors(Object.fromEntries(Object.entries(fieldErrors).map(([k, v]) => [k, v?.[0] ?? ''])));\n      return;\n    }\n    setErrors({});\n    setSaving(true);\n    try {\n      if (form.id) {\n        const { academicYearId: _ignored, ...update } = parsed.data;\n        await send(`/api/sections/${form.id}`, 'PATCH', update);\n      } else {\n        await send('/api/sections', 'POST', parsed.data);\n      }\n      showToast({ message: form.id ? 'Section updated' : 'Section created', severity: 'success' });\n      setForm(null);\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const remove = async () => {\n    if (!toDelete) return;\n    try {\n      await send(`/api/sections/${toDelete.id}`, 'DELETE');\n      showToast({ message: `Section ${toDelete.name} deleted`, severity: 'success' });\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setToDelete(null);\n    }\n  };\n\n  const copy = async () => {\n    if (!copyTarget) return;\n    try {\n      const json = await send('/api/sections/copy-to-year', 'POST', { fromYearId: yearId, toYearId: copyTarget.id });\n      const skipped = json.data.skipped as { name: string; reason: string }[];\n      showToast({\n        message: `Copied ${json.data.created} section(s) to ${copyTarget.name}.${\n          skipped.length ? ` Skipped: ${skipped.map((s) => `${s.name} (${s.reason})`).join(', ')}` : ''\n        }`,\n        severity: skipped.length ? 'warning' : 'success',\nimport { z } from 'zod';\n\n/**\n * Section validation (PRD-05 FR-3/FR-23), shared by the /admin/sections\n * dialogs and the /api/sections* handlers.\n */\n\nconst optionalId = z.preprocess((v) => (v === '' ? null : v), z.string().min(1).nullable().optional());\n\nexport const sectionCapacitySchema = z.coerce\n  .number()\n  .int('Capacity must be a whole number')\n  .min(1, 'Capacity must be at least 1')\n  .max(60, 'Capacity must be at most 60');\n\nexport const sectionInputSchema = z.object({\n  academicYearId: z.string().min(1, 'Academic year is required'),\n  gradeLevelId: z.string().min(1, 'Grade level is required'),\n  name: z.string().trim().min(1, 'Name is required').max(40),\n  homeroomTeacherId: optionalId,\n  roomId: optionalId,\n  capacity: sectionCapacitySchema.default(30),\n});\nexport type SectionInput = z.infer<typeof sectionInputSchema>;\n\n/** academicYearId is immutable after creation. */\nexport const sectionUpdateSchema = sectionInputSchema.omit({ academicYearId: true }).partial();\nexport type SectionUpdateInput = z.infer<typeof sectionUpdateSchema>;\n\nexport const enrollStudentsSchema = z.object({\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}'],\n  },\n});\nimport { defineConfig } from '@playwright/test';\n\nexport default defineConfig({\n  testDir: './tests/e2e',\n  fullyParallel: true,\n  reporter: 'list',\n  use: {\n    baseURL: process.env.APP_URL ?? 'http://localhost:3000',\n  },\n  webServer: {\n    command: 'npm run start',\n    url: process.env.APP_URL ?? 'http://localhost:3000',\n    reuseExistingServer: !process.env.CI,\n    timeout: 60_000,\n  },\n});\nimport { test, expect } from '@playwright/test';\nimport AxeBuilder from '@axe-core/playwright';\n\ntest.describe('dashboard page (/dashboard)', () => {\n  test('renders the welcome header and empty state', async ({ page }) => {\n    await page.goto('/dashboard');\n    await expect(page.getByRole('heading', { level: 1, name: /welcome to schoolhub/i })).toBeVisible();\n  });\n\n  test('has zero serious/critical accessibility violations', async ({ page }) => {\n    await page.goto('/dashboard');\n    const results = await new AxeBuilder({ page }).analyze();\n    const seriousOrCritical = results.violations.filter(\n      (v) => v.impact === 'serious' || v.impact === 'critical',\n    );\n    expect(seriousOrCritical).toEqual([]);\n  });\n});\n  const semesters: { name: string; startDate: string; endDate: string; order: number }[] = [\n    { name: 'Semester 1', startDate: '2026-08-17', endDate: '2027-01-15', order: 1 },\n    { name: 'Semester 2', startDate: '2027-01-18', endDate: '2027-06-11', order: 2 },\n  ];\n  for (const term of semesters) {\n    await prisma.term.upsert({\n      where: { academicYearId_name: { academicYearId: year.id, name: term.name } },\n      update: {},\n      create: {\n        academicYearId: year.id,\n        name: term.name,\n        startDate: new Date(term.startDate),\n        endDate: new Date(term.endDate),\n        order: term.order,\n      },\n    });\n  }\n\n  const gradeLevels = [\n    { name: 'Grade 6', shortName: 'G6', order: 1 },\n    { name: 'Grade 7', shortName: 'G7', order: 2 },\n    { name: 'Grade 8', shortName: 'G8', order: 3 },\n  ];\n  for (const grade of gradeLevels) {\n    await prisma.gradeLev