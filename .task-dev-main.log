w').write(s)\n\np='src/server/auth/tokens.ts'\ns=open(p).read()\ns=s.replace(\"type Tx = Prisma.TransactionClient;\\n\",\"type Tx = Prisma.TransactionClient;\\n\\n/** Invite token lifetime; the invite email's expiry date reads this too (PRD-04 FR-15). */\\nexport const INVITE_TTL = { days: 7 } as const;\\n\",1)\nopen(p,'w').write(s)\n\np='src/server/services/users.ts'\ns=open(p).read()\ns=s.replace(\"import { createToken } from '@/server/auth/tokens';\",\"import { createToken, INVITE_TTL } from '@/server/auth/tokens';\")\ns=s.replace(\"return createToken(userId, 'INVITE', { days: 7 });\",\"return createToken(userId, 'INVITE', INVITE_TTL);\")\nopen(p,'w').write(s)\nEOF\ngrep -n INVITE_TTL src/server/services/users.ts src/server/auth/tokens.ts","description":"Update auth email seam, tokens, users.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1378,"cache_read_input_tokens":108923,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1378},"output_tokens":40,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1921163e-32be-4c5c-99f3-b230ef406493","uuid":"2e02d3ea-d42b-4ea3-b74b-eab6a2c82b25","timestamp":"2026-11-04T14:57:33.976Z","request_id":"req_011Cgi5pNv96zTjCSBB4fN3E","wire_tool_inputs":{"toolu_01EXeif6cyxLqif8o1WExyZ7":{"command":"cd /Users/ikramaansari/Documents/forge/schoolhub-prds && python3 - <<'EOF'\nimport re\np='src/server/auth/email.ts'\ns=open(p).read()\ns=s.replace(\"\"\"import { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\n\"\"\",\"\"\"import { formatInTimeZone } from 'date-fns-tz';\nimport { env } from '@/lib/env';\nimport { prisma } from '@/server/db';\nimport { INVITE_TTL } from '@/server/auth/tokens';\nimport { enqueueEmail } from '@/server/email/outbox';\nimp