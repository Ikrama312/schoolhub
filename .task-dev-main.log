{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TcVVjRN9BDvevbuaSQiy2e","type":"tool_result","content":"252: * (preferring one ACTIVE in courseId when given). Anyone else → FORBIDDEN.\n256:    if (studentId && studentId !== user.id) throw new AppError('FORBIDDEN', 'You can only view your own assignments.');\n277:      if (!children.some((c) => c.id === studentId)) throw new AppError('FORBIDDEN', 'That student is not linked to your account.');\n281:    if (!pick) throw new AppError('FORBIDDEN', 'No linked students.');\n284:  throw new AppError('FORBIDDEN', 'You do not have permission to view this.');\n550:  if (user.role !== 'STUDENT') throw new AppError('FORBIDDEN', 'Only students can submit work.');\n555:  if (!enrolled) throw new AppError('FORBIDDEN', 'You are not enrolled in this course.');\nimport { ok, parseBody, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { deleteOrArchiveAssignment, getAssignment, updateAssignment } from '@/server/assignments/assignments-service';\nimport { assignmentPatch, studentQuery } from '@/lib/validators/assignments';\n\ntype Ctx = { params: { id: string } };\n\n/** GET /api/assignments/:id (FR-50) · PATCH / DELETE (FR-51). Course access is checked in the service. */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const { studentId } = parseQuery(new URL(request.url).searchParams, studentQuery);\n  return ok(await getAssignment(user, params.id, studentId));\n});\n\nexport const PATCH = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const patch = await parseBody(request, assignmentPatch);\n  return ok(await updateAssignment(user, params.id, patch, request));\n});\n\nexport const DELETE = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  return ok(await deleteOrArchiveAssignment(user, params.id, request));\n});\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { gradeSubmission } from '@/server/assignments/assignments-service';\nimport { gradeInput } from '@/lib/validators/assignments';\n\n/** PUT /api/submissions/:id/grade — Save, or Save & return with return:true (FR-56, D6). */\nexport const PUT = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  const input = await parseBody(request, gradeInput);\n  return ok(await gradeSubmission(user, params.id, input, request));\n});\nimport { ok, parseBody, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { createAssignment, listCourseAssignments } from '@/server/assignments/assignments-service';\nimport { assignmentInput, studentQuery } from '@/lib/validators/assignments';\n\ntype Ctx = { params: { id: string } };\n\n/** GET /api/courses/:id/assignments — role-shaped list (FR-48). View-course check in the service. */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const { studentId } = parseQuery(new URL(request.url).searchParams, studentQuery);\n  return ok(await listCourseAssignments(user, params.id, studentId));\n});\n\n/** POST /api/courses/:id/assignments — create (FR-49). assertCanManageCourse in the service. */\nexport const POST = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const input = await parseBody(request, assignmentInput);\n  return ok(await createAssignment(user, params.id, input, request), { status: 201 });\n});\nimport NextLink from 'next/link';\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport AddIcon from '@mui/icons-material/Add';\nimport { requirePageUser } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolTimezone, listCourseAssignments } from '@/server/assignments/assignments-service';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { AssignmentList } from '../../../assignments/AssignmentList';\nimport { CourseAssignmentsTable } from './CourseAssignmentsTable';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course \"Assignments\" tab (FR-16..FR-18). Role-shaped by the service; course access in the layout and service. */\nexport default async function CourseAssignmentsPage({ params, searchParams }: { params: { courseId: string }; searchParams: { studentId?: string } }) {\n  const user = await requirePageUser();\n  let data: Awaited<ReturnType<typeof listCourseAssignments>>;\n  try {\n    data = await listCourseAssignments(user, params.courseId, searchParams.studentId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const timezone = await getSchoolTimezone();\n\n  if (data.view === 'manager') {\n    return (\n      <Box>\n        <PageHeader\n          title=\"Assignments\"\n          actions={\n            <Button variant=\"contained\" startIcon={<AddIcon />} component={NextLink} href={`/courses/${params.courseId}/assignments/new`}>\n              New assignment\n            </Button>\n          }\n        />\n        <CourseAssignmentsTable courseId={params.courseId} items={data.items} timezone={timezone} />\n      </Box>\n    );\n  }\n  return (\n    <Box>\n      <PageHeader title=\"Assignments\" />\n      <AssignmentList variant=\"grouped\" rows={data.items} timezone={timezone} childOptions={data.children} studentId={data.studentId} />\n    </Box>\n  );\n}\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanManageCourse } from '@/server/auth/course-access';\nimport { AppError } from '@/server/http';\nimport { prisma } from '@/server/db';\nimport { getSchoolTimezone, listManagedCourses } from '@/server/assignments/assignments-service';\nimport { nextTeachingDayDueAt } from '@/lib/dates';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { AssignmentForm } from '../AssignmentForm';\n\nexport const dynamic = 'force-dynamic';\n\n/** FR-9: create page (manage course). dueAt default = next teaching day 23:59 school time (FR-10). */\nexport default async function NewAssignmentPage({ params }: { params: { courseId: string } }) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  try {\n    await assertCanManageCourse(user, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const [timezone, days, managedCourses] = await Promise.all([\n    getSchoolTimezone(),\n    prisma.schoolDay.findMany(),\n    listManagedCourses(user),\n  ]);\n  // A missing SchoolDay row (unseeded DB) defaults to Mon–Fri teaching, as in the timetable service.\n  const teaching = [1, 2, 3, 4, 5, 6, 7].filter((d) => days.find((r) => r.dayOfWeek === d)?.isTeaching ?? d <= 5);\n  const defaultDueAt = nextTeachingDayDueAt(new Date(), timezone, teaching).toISOString();\n\n  return (\n    <Box>\n      <PageHeader title=\"New assignment\" breadcrumbs={[{ label: 'Assignments', href: `/courses/${params.courseId}/assignments` }, { label: 'New' }]} />\n      <AssignmentForm courseId={params.courseId} timezone={timezone} defaultDueAt={defaultDueAt} managedCourses={managedCourses} />\n    </Box>\n  );\n}\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getAssignment, getSchoolTimezone, listGradingRoster } from '@/server/assignments/assignments-service';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { GradingWorkspace } from './GradingWorkspace';\n\nexport const dynamic = 'force-dynamic';\n\n/** FR-28: grading page (manage course; checked by getAssignment/listGradingRoster). */\nexport default async function GradePage({ params }: { params: { courseId: string; assignmentId: string } }) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  let data: Awaited<ReturnType<typeof getAssignment>>;\n  let roster: Awaited<ReturnType<typeof listGradingRoster>>;\n  try {\n    data = await getAssignment(user, params.assignmentId);\n    if (!data.canManage) redirect('/forbidden');\n    roster = await listGradingRoster(user, params.assignmentId, { sort: 'name' }, { skip: 0, take: 1000 });\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  if (data.assignment.courseId !== params.courseId) notFound();\n  const timezone = await getSchoolTimezone();\n\n  return (\n    <Box>\n      <PageHeader\n        title={`Grade: ${data.assignment.title}`}\n        breadcrumbs={[\n          { label: 'Assignments', href: `/courses/${params.courseId}/assignments` },\n          { label: data.assignment.title, href: `/courses/${params.courseId}/assignments/${params.assignmentId}` },\n          { label: 'Grade' },\n        ]}\n      />\n      <GradingWorkspace assignment={data.assignment} initialRoster={roster.items} timezone={timezone} />\n    </Box>\n  );\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"3eb50254-5396-4c9e-84e7-da065a5fc108","uuid":"6cb21957-9757-4421-8d87-7fd4a66ae877","timestamp":"2026-11-09T07:12:59.207Z","tool_use_result":{"stdout":"252: * (preferring