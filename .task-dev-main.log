{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgnTdHn6zgsZ4VYawnWqF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018mNgfLg8RQyHnqReEn64TV","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/src/lib/video.ts","content":"/**\n * Video URL parsing (PRD-08 FR-30). Shared by the Zod validator and the\n * viewer. Only ever emits the two privacy-enhanced origins allowed by the\n * CSP frame-src in next.config.js.\n */\nexport interface ParsedVideo {\n  provider: 'youtube' | 'vimeo';\n  id: string;\n}\n\nconst YT_ID = /^[A-Za-z0-9_-]{6,20}$/;\nconst VIMEO_ID = /^\\d{1,12}$/;\n\nexport function parseVideoUrl(raw: string): ParsedVideo | null {\n  let url: URL;\n  try {\n    url = new URL(raw.trim());\n  } catch {\n    return null;\n  }\n  if (url.protocol !== 'https:' && url.protocol !== 'http:') return null;\n  const host = url.hostname.toLowerCase().replace(/^(www\\.|m\\.)/, '');\n  const firstSegment = url.pathname.split('/').filter(Boolean)[0] ?? '';\n\n  if (host === 'youtube.com' && url.pathname === '/watch') {\n    const id = url.searchParams.get('v') ?? '';\n    return YT_ID.test(id) ? { provider: 'youtube', id } : null;\n  }\n  if (host === 'youtu.be') {\n    return YT_ID.test(firstSegment) ? { provider: 'youtube', id: firstSegment } : null;\n  }\n  if (host === 'vimeo.com') {\n    return VIMEO_ID.test(firstSegment) ? { provider: 'vimeo', id: firstSegment } : null;\n  }\n  return null;\n}\n\nexport function embedUrl(video: ParsedVideo): string {\n  return video.provider === 'youtube'\n    ? `https://www.youtube-nocookie.com/embed/${video.id}`\n    : `https://player.vimeo.com/video/${video.id}`;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1786,"cache_read_input_tokens":123275,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1786},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"34574e28-0591-42df-96fb-64403ec6dad4","uuid":"c912ffa9-3e52-4249-a2cd-1214947f188d","timestamp":"2026-11-06T22:25:56.945Z","request_id":"req_011CgnTdHYxhvqocxEMpJ6tc","wire_tool_inputs":{"toolu_018mNgfLg8RQyHnqReEn64TV":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/src/lib/video.ts","content":"/**\n * Video URL parsing (PRD-08 FR-30). Shared by the Zod validator and the\n * viewer. Only ever emits the two privacy-enhanced origins allowed by the\n * CSP frame-src in next.config.js.\n */\nexport interface ParsedVideo {\n  provider: 'youtube' | 'vimeo';\n  id: string;\n}\n\nconst YT_ID = /^[A-Za-z0-9_-]{6,20}$/;\nconst VIMEO_ID = /^\\d{1,12}$/;\n\nexport function parseVideoUrl(raw: string): ParsedVideo | null {\n  let url: URL;\n  try {\n    url = new URL(raw.trim());\n  } catch {\n    return null;\n  }\n  if (url.protocol !== 'https:' && url.protocol !== 'http:') return null;\n  const host = url.hostname.toLowerCase().replace(/^(www\\.|m\\.)/, '');\n  const firstSegment = url.pathname.split('/').filter(Boolean)[0] ?? '';\n\n  if (host === 'youtube.com' && url.pathname === '/watch') {\n    const id = url.searchParams.get('v') ?? '';\n    return YT_ID.test(id) ? { provider: 'youtube', id } : null;\n  }\n  if (host === 'youtu.be') {\n    return YT_ID.test(firstSegment) ? { provider: 'youtube', id: firstSegment } : null;\n  }\n  if (host === 'vimeo.com') {\n    return VIMEO_ID.test(firstSegment) ? { provider: 'vimeo', id: firstSegment } : null;\n  }\n  return null;\n}\n\nexport function embedUrl(video: ParsedVideo): string {\n  return video.provider === 'youtube'\n    ? `https://www.youtube-nocookie.com/embed/${video.id}`\n    : `https://player.vimeo.com/video/${video.id}`;\n}\n"}}}
