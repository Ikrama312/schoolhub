;\n  const eligible = files.filter(\n    (f) =>\n      (user.role === 'ADMIN' || f.ownerId === user.id) &&\n      (f.contextId === null || (f.contextId === contextId && f.context === context)),\n  );\n  if (eligible.length !== ids.length) {\n    throw new AppError('VALIDATION_ERROR', 'One or more files cannot be attached.', {\n      fileIds: ids.filter((id) => !eligible.some((f) => f.id === id)),\n    });\n  }\n  await tx.fileObject.updateMany({ where: { id: { in: ids } }, data: { context, contextId } });\n}\n\n/** D5: detached files get contextId null and are purged 24 h later. */\nexport async function detachFiles(tx: Tx, fileIds: string[]): Promise<void> {\n  if (fileIds.length === 0) return;\n  await tx.fileObject.updateMany({ where: { id: { in: fileIds } }, data: { contextId: null } });\n}\n","structuredPatch":[{"oldStart":82,"oldLines":9,"newStart":82,"newLines":16,"lines":["   }"," ","   async function* body() {","+    let total = head.length;","+    if (total > maxBytes) throw tooBig(maxBytes);","     yield head;","     if (!done) {","-      for (let next = await iterator.next(); !next.done; next = await iterator.next()) yield next.value;","+      for (let next = await iterator.next(); !next.done; next = await iterator.next()) {","+        total += next.value.length;","+        // Per-context cap (logo 2 MB) is enforced here mid-stream; saveFile unlinks the tmp file.","+        if (total > maxBytes) throw tooBig(maxBytes);","+        yield next.value;","+      }","     }","     // busboy stops emitting at limits.fileSize and marks the stream truncated.","     if (stream.truncated) throw tooBig(maxBytes);"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01DHe5dM8zJwgm9zBhPVXndd","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
