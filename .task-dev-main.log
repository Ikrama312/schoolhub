enaltyPercent    Decimal                @default(0) @db.Decimal(5, 2)\n  maxFileCount             Int                    @default(3)\n  allowExtraCredit         Boolean                @default(false)\n  status                   AssignmentStatus       @default(DRAFT)\n  rubricId                 String?                @unique\n  rubric                   Rubric?                @relation(fields: [rubricId], references: [id], onDelete: SetNull)\n  notifiedAt               DateTime?\n  archivedAt               DateTime?\n  createdById              String\n  createdAt                DateTime               @default(now())\n  updatedAt                DateTime               @updatedAt\n  attachments              AssignmentAttachment[]\n  submissions              Submission[]\n  exemptions               GradeExemption[]\n  reminders                AssignmentReminder[]\n\n  @@index([courseId, dueAt])\n}\n\n/// file has no onDelete -> Restrict: an attached file can't be hard-deleted.\nmodel AssignmentAttachment {\n  assignmentId String\n  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n  fileId       String\n  file         FileObject @relation(fields: [fileId], references: [id])\n\n  @@id([assignmentId, fileId])\n}\n\nmodel Rubric {\n  id         String            @id @default(cuid())\n  criteria   RubricCriterion[]\n  assignment Assignment?\n}\n\nmodel RubricCriterion {\n  id          String  @id @default(cuid())\n  rubricId    String\n  rubric      Rubric  @relation(fields: [rubricId], references: [id], onDelete: Cascade)\n  title       String\n  description String?\n  maxPoints   Decimal @db.Decimal(6, 2)\n  order       Int\n  /// [{label, points, description}]\n  levels      Json\n\n  @@index([rubricId, order])\n}\n\n/// One row per (assignment, student); earlier attempts live in SubmissionHistory.\n/// attemptNumber 0 = offline grade (FR-8).\nmodel Submission {\n  id             String              @id @default(cuid())\n  assignmentId   String\n  assignment     Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n  studentId      String\n  student        User                @relation(\"SubmissionStudent\", fields: [studentId], references: [id])\n  status         SubmissionStatus    @default(SUBMITTED)\n  text           String?             @db.Text\n  attemptNumber  Int\n  submittedAt    DateTime\n  isLate         Boolean             @default(false)\n  lateDays       Int                 @default(0)\n  rawScore       Decimal?            @db.Decimal(6, 2)\n  penaltyPercent Decimal?            @db.Decimal(5, 2)\n  finalScore     Decimal?            @db.Decimal(6, 2)\n  /// [{criterionId, points, comment}]\n  rubricScores   Json?\n  feedback       String?             @db.Text\n  gradedById     String?\n  gradedBy       User?               @relation(\"SubmissionGrader\", fields: [gradedById], references: [id])\n  gradedAt       DateTime?\n  returnedAt     DateTime?\n  createdAt      DateTime            @default(now())\n  updatedAt      DateTime            @updatedAt\n  files          SubmissionFile[]\n  history        SubmissionHistory[]\n\n  @@unique([assignmentId, studentId])\n  @@index([studentId])\n}\n\nmodel SubmissionFile {\n  submissionId String\n  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)\n  fileId       String\n  file         FileObject @relation(fields: [fileId], references: [id])\n\n  @@id([submissionId, fileId])\n}\n\n/// fileIds has no FK on purpose: old-attempt files stay attached to the submission (B1).\nmodel SubmissionHistory {\n  id            String     @id @default(cuid())\n  submissionId  String\n  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)\n  attemptNumber Int\n  text          String?    @db.Text\n  fileIds       String[]\n  submittedAt   DateTime\n\n  @@index([submissionId, attemptNumber])\n}\n\n/// The row itself is the PRD-11 \"exclude from gradebook\" flag (FR-35).\nmodel GradeExemption {\n  assignmentId String\n  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n  studentId    String\n  reason       String?\n  createdAt    DateTime   @default(now())\n\n  @@id([assignmentId, studentId])\n}\n\n/// Idempotency key for due_soon / missing reminders (FR-6).\nmodel AssignmentReminder {\n  id           String     @id @default(cuid())\n  assignmentId String\n  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n  studentId    String\n  kind         String\n  createdAt    DateTime   @default(now())\n\n  @@unique([assignmentId, studentId, kind])\n}\n'''\nopen(p,'w').write(s)\nEOF\nnpx prisma format 2>&1 | tail -2 && mkdir -p prisma/migrations/20261109000000_add_assignments && npx prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/20261109000000_add_assignments/migration.sql && head -5 prisma/migrations/20261109000000_add_assignments/migration.sql && grep -c \"\" prisma/migrations/20261109000000_add_assignments/migration.sql","description":"Add assignment models and generate migration SQL"}},"wire_ingest_context":{"toolu_01EUcCY7hK2KigB6UPUdfotu":{"cwd":"/Users/ikramaansari/Documents/forge/schoolhub"}}}
