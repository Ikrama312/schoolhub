{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PRg2USRBeD24KixEFd1Gvh","type":"tool_result","content":"'use client';\n\nimport { useState } from 'react';\nimport Dialog from '@mui/material/Dialog';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogContentText from '@mui/material/DialogContentText';\nimport DialogActions from '@mui/material/DialogActions';\nimport Button from '@mui/material/Button';\nimport CircularProgress from '@mui/material/CircularProgress';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  title: string;\n  description?: string;\n  destructive?: boolean;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  onConfirm: () => void | Promise<void>;\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}: ConfirmDialogProps) {\n  const [pending, setPending] = useState(false);\n\n  const handleConfirm = async () => {\n    setPending(true);\n    try {\n      await onConfirm();\n    } finally {\n      setPending(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n      {description && (\n        <DialogContent>\n          <DialogContentText>{description}</DialogContentText>\n        </DialogContent>\n      )}\n      <DialogActions>\n        <Button onClick={onCancel} disabled={pending}>\n          {cancelLabel}\n        </Button>\n        <Button\n          onClick={handleConfirm}\n          color={destructive ? 'error' : 'primary'}\n          variant=\"contained\"\n          disabled={pending}\n          startIcon={pending ? <CircularProgress size={16} color=\"inherit\" /> : undefined}\n        >\n          {confirmLabel}\n        </Button>\n      </DialogActions>\n    </Dialog>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      alignItems=\"center\"\n      justifyContent=\"center\"\n      spacing={1.5}\n      sx={{ py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" alignItems=\"flex-start\" justifyContent=\"space-between\" spacing={2}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" fontWeight={600}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\nimport Avatar from '@mui/material/Avatar';\n\nexport interface UserAvatarProps {\n  userId: string;\n  name: string;\n  size?: number;\n}\n\nconst PALETTE = ['#4F46E5', '#0EA5E9', '#15803D', '#B45309', '#B91C1C', '#7C3AED', '#0D9488'];\n\nfunction colorForId(id: string): string {\n  let hash = 0;\n  for (let i = 0; i < id.length; i += 1) {\n    hash = (hash * 31 + id.charCodeAt(i)) | 0;\n  }\n  return PALETTE[Math.abs(hash) % PALETTE.length];\n}\n\nfunction initialsFor(name: string): string {\n  const parts = name.trim().split(/\\s+/).filter(Boolean);\n  if (parts.length === 0) return '?';\n  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n}\n\n/** Avatar with initials on a deterministic background colour derived from userId. */\nexport function UserAvatar({ userId, name, size = 32 }: UserAvatarProps) {\n  return (\n    <Avatar sx={{ bgcolor: colorForId(userId), width: size, height: size, fontSize: size * 0.4 }}>\n      {initialsFor(name)}\n    </Avatar>\n  );\n}\nimport { cache } from 'react';\nimport { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { rangesOverlap } from './dateRange';\nimport { getSchoolSettings } from './settings';\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface AcademicYearInput {\n  name: string;\n  startDate: Date;\n  endDate: Date;\n}\n\nfunction assertValidRange(startDate: Date, endDate: Date) {\n  if (endDate <= startDate) {\n    throw new AppError('VALIDATION_ERROR', 'End date must be after start date.');\n  }\n}\n\nasync function assertNoOverlap(\n  tx: Prisma.TransactionClient,\n  range: { startDate: Date; endDate: Date },\n  excludeId?: string,\n) {\n  const others = await tx.academicYear.findMany({\n    where: excludeId ? { id: { not: excludeId } } : undefined,\n  });\n  const conflict = others.find((year) => rangesOverlap(range, year));\n  if (conflict) {\n    throw new AppError('VALIDATION_ERROR', `Dates overlap with ${conflict.name}.`);\n  }\n}\n\nexport async function listAcademicYears() {\n  return prisma.academicYear.findMany({\n    orderBy: { startDate: 'asc' },\n    include: { terms: { orderBy: { order: 'asc' } } },\n  });\n}\n\nexport async function createAcademicYear(input: AcademicYearInput) {\n  assertValidRange(input.startDate, input.endDate);\n  return prisma.$transaction(\n    async (tx) => {\n      await assertNoOverlap(tx, input);\n      return tx.academicYear.create({ data: input });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\nexport async function updateAcademicYear(id: string, input: Partial<AcademicYearInput>) {\n  return prisma.$transaction(\n    async (tx) => {\n      const existing = await tx.academicYear.findUniqueOrThrow({ where: { id } });\n      const startDate = input.startDate ?? existing.startDate;\n      const endDate = input.endDate ?? existing.endDate;\n      assertValidRange(startDate, endDate);\n      await assertNoOverlap(tx, { startDate, endDate }, id);\n      return tx.academicYear.update({\n        where: { id },\n        data: { name: input.name ?? existing.name, startDate, endDate },\n      });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\n/** Sets isCurrent = true on `id` and false on every other year, atomically. */\nexport async function setCurrentAcademicYear(id: string) {\n  const [, updated] = await prisma.$transaction([\n    prisma.academicYear.updateMany({ where: { id: { not: id } }, data: { isCurrent: false } }),\n    prisma.academicYear.update({ where: { id }, data: { isCurrent: true } }),\n  ]);\n  return updated;\n}\n\nexport async function deleteAcademicYear(id: string) {\n  const termCount = await prisma.term.count({ where: { academicYearId: id } });\n  if (termCount > 0) {\n    throw new AppError('CONFLICT', 'In use — cannot delete.');\n  }\n  await prisma.academicYear.delete({ where: { id } });\n}\n\n/** The one place the rest of the app reads \"the current academic year\" from. */\nexport const getCurrentAcademicYear = cache(async () => {\n  return prisma.academicYear.findFirst({\n    where: { isCurrent: true },\n    include: { terms: { orderBy: { order: 'asc' } } },\n  });\n});\n\n/** Returns the term whose range contains `date` (school-timezone calendar day), or null. */\nexport async function getCurrentTerm(date: Date = new Date()) {\n  const settings = await getSchoolSettings();\n  const dayKey = formatInSchoolTz(date, 'yyyy-MM-dd', settings.timezone);\n  const asOf = new Date(`${dayKey}T00:00:00.000Z`);\n  return prisma.term.findFirst({\n    where: { startDate: { lte: asOf }, endDate: { gte: asOf } },\n  });\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"020b7a6e-6236-4f8d-a760-9a7fb50fdcce","uuid":"a69115b9-5a0e-4058-8f43-ec202feb8537","timestamp":"2026-10-27T16:37:32.313Z","tool_use_result":{"stdout":"'use client';\n\nimport { useState } from 'react';\nimport Dialog from '@mui/material/Dialog';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogContentText from '@mui/material/DialogContentText';\nimport DialogActions from '@mui/material/DialogActions';\nimport Button from '@mui/material/Button';\nimport CircularProgress from '@mui/material/CircularProgress';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  title: string;\n  description?: string;\n  destructive?: boolean;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  onConfirm: () => void | Promise<void>;\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}: ConfirmDialogProps) {\n  const [pending, setPending] = useState(false);\n\n  const handleConfirm = async () => {\n    setPending(true);\n    try {\n      await onConfirm();\n    } finally {\n      setPending(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n      {description && (\n        <DialogContent>\n          <DialogContentText>{description}</DialogContentText>\n        </DialogContent>\n      )}\n      <DialogActions>\n        <Button onClick={onCancel} disabled={pending}>\n          {cancelLabel}\n        </Button>\n        <Button\n          onClick={handleConfirm}