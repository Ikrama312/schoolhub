{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DYQhCm6Fcg52krQ883JTxd","type":"tool_result","content":"{\n  \"ticketId\": \"abcd-05\",\n  \"timestamp\": \"2026-10-27T00:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md (REST API surface + Data Flow) and 05-classes-enrollment.md's API table; 17 endpoints (the table's '·'-joined rows are expanded). Conventions shared by every endpoint, not repeated per entry: (1) every handler is wrapped in withHandler() from src/server/http.ts, which maps ZodError->VALIDATION_ERROR 400, AppError->its code, Prisma P2002->CONFLICT 409, P2025->NOT_FOUND 404; (2) success = ok() -> { data }, lists = paginated() -> { data: [...], meta: { page, pageSize, total } } — the real helper nests pagination under `meta`, unlike the PRD's flat example; follow the helper; (3) list query conventions: page (default 1), pageSize (default 20, max 100), sort, order=asc|desc, q; (4) auth: every route calls requireRole(...) from src/server/auth/requireRole.ts (NFR-7 stand-in; no permissions.ts/requireUser()); course-scoped reads additionally call assertCanViewCourse from src/server/auth/course-access.ts (FR-18); (5) every write calls audit() inside the same $transaction (FR-24) via the service/engine, never at the route layer; (6) handlers are thin: zod parse -> one service call -> envelope. Shared shapes are named under `schemas` and referenced as \\\"$ref\\\": \\\"#/schemas/<Name>\\\".\",\n\n  \"schemas\": {\n    \"Section\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevel\": { \"id\": \"string\", \"name\": \"string\", \"order\": \"number\" },\n      \"name\": \"string\", \"homeroomTeacherId\": \"string|null\", \"homeroomTeacher\": { \"id\": \"string\", \"name\": \"string\" },\n      \"roomId\": \"string|null\", \"room\": { \"id\": \"string\", \"name\": \"string\" }, \"capacity\": \"number (1-60)\",\n      \"memberCount\": \"number\", \"courseCount\": \"number\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"SectionInput\": {\n      \"academicYearId\": \"string (required on create)\", \"gradeLevelId\": \"string\", \"name\": \"string (min 1)\",\n      \"homeroomTeacherId\": \"string|null (must be role=TEACHER; at most one section per teacher per year -> CONFLICT)\",\n      \"roomId\": \"string|null\", \"capacity\": \"int 1-60, default 30\"\n    },\n    \"Course\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"subjectId\": \"string\", \"subject\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"color\": \"string\" },\n      \"sectionId\": \"string|null\", \"section\": { \"id\": \"string\", \"name\": \"string\", \"room\": { \"id\": \"string\", \"name\": \"string\" } },\n      \"teacherId\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" }, \"coTeacherIds\": \"string[]\", \"coTeachers\": [{ \"id\": \"string\", \"name\": \"string\" }],\n      \"name\": \"string\", \"code\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"description\": \"string|null\", \"capacity\": \"number|null\",\n      \"archivedAt\": \"ISO 8601|null\", \"enrolledCount\": \"number (ACTIVE only)\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"CourseInput\": {\n      \"academicYearId\": \"string (required on create)\", \"subjectId\": \"string\", \"sectionId\": \"string|null (required iff kind=CORE — single zod refinement shared with the dialog, FR-14)\",\n      \"teacherId\": \"string (role=TEACHER)\", \"coTeacherIds\": \"string[] (max 3, role=TEACHER)\", \"name\": \"string (default '<Subject> – <Section>')\",\n      \"code\": \"string (default '<SUBJECTCODE>-<SECTION>', transformed to uppercase; unique per year -> CONFLICT)\", \"kind\": \"CORE|ELECTIVE (default CORE)\",\n      \"capacity\": \"int>=1|null\", \"description\": \"string|null\"\n    },\n    \"Enrollment\": {\n      \"id\": \"string\", \"courseId\": \"string\", \"studentId\": \"string\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\" },\n      \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\"\n    },\n    \"EnrollStudentsInput\": { \"studentIds\": \"string[] (min 1)\", \"overrideCapacity\": \"boolean (optional, default false)\" },\n    \"EnrollResult\": { \"enrolled\": \"number (new ACTIVE rows)\", \"reactivated\": \"number (DROPPED->ACTIVE)\", \"alreadyActive\": \"number\" },\n    \"CapacityConflict\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Section 7A is full (30/30). | Course MATH-7A is full (30/30).\" } }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/sections\",\n      \"description\": \"List sections for an academic year (defaults to current). Roles: ADMIN, TEACHER. Service: sections-service.listSections.\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, defaults to current AcademicYear)\", \"gradeLevelId\": \"string (optional)\", \"q\": \"string (optional, name search)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"name|gradeLevel|memberCount (default gradeLevel)\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Section\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } }, \"403\": \"FORBIDDEN (STUDENT/PARENT)\" },\n      \"requirementIds\": [\"FR-2\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections\",\n      \"description\": \"Create a section. Role: ADMIN. Homeroom-teacher-per-year check runs inside the write transaction (system-design Decision 3). Audits section.create.\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/SectionInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"409\": \"CONFLICT — duplicate name in year (P2002), or teacher already homeroom of another section this year\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Update a section (partial SectionInput, academicYearId immutable). Role: ADMIN. Capacity may not be lowered below current memberCount. Audits section.update.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<SectionInput> without academicYearId\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (name/homeroom uniqueness)\", \"400\": \"VALIDATION_ERROR (capacity < memberCount)\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Delete a section. Role: ADMIN. Allowed only when it has no members and no courses. Audits section.delete.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"id\": \"string\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT — 'Section 7A still has members or courses.'\" },\n      \"requirementIds\": [\"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/members\",\n      \"description\": \"Add students to a section and auto-enroll them ACTIVE in every non-archived CORE course of the section (reactivating DROPPED rows), all in one $transaction via roster-engine.enrollSectionCoreCourses with batched createMany/updateMany. Role: ADMIN. Audits section.member.add + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": {\n        \"201\": { \"data\": { \"added\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Sam Student is already in section 7A for 2026–2027.' (SectionMember @@unique P2002, mapped to the friendly message by the service)\"],\n        \"400\": \"VALIDATION_ERROR — student not role=STUDENT or wrong grade level\", \"404\": \"NOT_FOUND\"\n      },\n      \"requirementIds\": [\"FR-4\", \"FR-7\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-2\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id/members/:studentId\",\n      \"description\": \"Remove a student from a section; their ACTIVE enrollments in this section's CORE courses become DROPPED with droppedAt=now (electives untouched) via roster-engine.dropSectionCoreCourses, same transaction. Role: ADMIN. Audits section.member.remove + enrollment.drop.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\", \"studentId\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"removed\": true, \"droppedEnrollments\": \"number\" } }, \"404\": \"NOT_FOUND (student not a member)\" },\n      \"requirementIds\": [\"FR-4\", \"FR-8\", \"FR-12\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/students/:id/move-section\",\n      \"description\": \"Move a student to another section of the same academic year in a single $transaction: remove membership + drop source CORE enrollments, add membership + enroll/reactivate destination CORE enrollments (roster-engine.moveStudentSection). Electives unchanged. Role: ADMIN. Audits section.member.move + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string (studentId)\" }, \"body\": { \"toSectionId\": \"string\", \"overrideCapacity\": \"boolean (optional, default false)\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"fromSectionId\": \"string\", \"toSectionId\": \"string\", \"dropped\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }],\n        \"400\": \"VALIDATION_ERROR — destination in a different academic year, or same as source\", \"404\": \"NOT_FOUND — student has no section this year, or toSectionId unknown\"\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-7\", \"FR-8\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/core-courses\",\n      \"description\": \"Bulk-create one CORE course per item (default name '<Subject> – <Section>', code '<SUBJECTCODE>-<SECTION>') and enroll all current section members in each, one $transaction. Subjects must be non-archived. Role: ADMIN. Audits course.create + enrollment.* per course.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"items\": [{ \"subjectId\": \"string\", \"teacherId\": \"string (role=TEACHER)\" }], \"_constraints\": \"items min 1, subjectIds unique\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"courses\": [{ \"$ref\": \"#/schemas/Course\" }], \"enrollmentsCreated\": \"number\" } }, \"409\": \"CONFLICT — course code already exists this year (P2002)\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-5\", \"FR-10\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/copy-to-year\",\n      \"description\": \"Structural copy of all sections from one year to a future, non-current year: name, room, capacity copied; gradeLevel advanced to the next GradeLevel by `order` (sections at the top grade are skipped); no members, no homeroom teacher, no courses. Role: ADMIN. Audits section.create per copy.\",\n      \"requestSchema\": { \"body\": { \"fromYearId\": \"string\", \"toYearId\": \"string (must be a future, non-current AcademicYear)\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"created\": \"number\", \"skipped\": [{ \"name\": \"string\", \"reason\": \"no next grade level | name already exists in target year\" }] } }, \"400\": \"VALIDATION_ERROR — toYearId is current or not in the future\" },\n      \"requirementIds\": [\"FR-6\", \"FR-23\", \"FR-24\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses\",\n      \"description\": \"List courses. ADMIN sees all; TEACHER sees courses they teach/co-teach; STUDENT/PARENT see courses with an ACTIVE enrollment for self/linked child (scoping done in courses-service, not by client filter). Excludes archived unless includeArchived=true (ADMIN only).\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, default current)\", \"gradeLevelId\": \"string\", \"subjectId\": \"string\", \"teacherId\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"sectionId\": \"string\", \"includeArchived\": \"boolean\", \"q\": \"string (name/code)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"code|name|enrolledCount\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Course\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"requirementIds\": [\"FR-13\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses\",\n      \"description\": \"Create a course. Role: ADMIN. A new CORE course on a section enrolls all current section members ACTIVE in the same transaction (FR-10). Audits course.create (+ enrollment.* if CORE).\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/CourseInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"409\": \"CONFLICT — code already used this year\", \"400\": \"VALIDATION_ERROR — e.g. kind=CORE without sectionId, >3 coTeachers\" },\n      \"requirementIds\": [\"FR-14\", \"FR-10\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Update a course (partial CourseInput; academicYearId/sectionId/kind immutable after creation to avoid silent roster rewrites). Archive via { archived: true } (sets archivedAt), unarchive via { archived: false }. Role: ADMIN. Audits course.update / course.archive.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<CourseInput> without academicYearId/sectionId/kind, plus archived?: boolean\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (code)\", \"400\": \"VALIDATION_ERROR (capacity < enrolledCount)\" },\n      \"requirementIds\": [\"FR-14\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Course header/overview data for /courses/[courseId]. Gated by assertCanViewCourse (ADMIN all; TEACHER teacher/co-teacher; STUDENT ACTIVE enrollment; PARENT linked child ACTIVE enrollment).\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"403\": \"FORBIDDEN\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\", \"FR-23\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/roster\",\n      \"description\": \"Course roster, ACTIVE enrollments by default. Gated by assertCanViewCourse; PARENT gets FORBIDDEN (Roster tab not shown). Shape from courses-service.getCourseRoster(id, viewerRole) — the same function the Roster tab server component uses.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"query\": { \"status\": \"ACTIVE|DROPPED|ALL (default ACTIVE; DROPPED/ALL only for ADMIN/TEACHER)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"q\": \"string\" } },\n      \"responseSchema\": {\n        \"200 (ADMIN, TEACHER)\": { \"data\": [{ \"enrollmentId\": \"string\", \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\", \"profileUrl\": \"/students/:id\" } }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },\n        \"200 (STUDENT)\": { \"data\": [{ \"name\": \"string\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" }, \"_privacy\": \"Projection is names only — no ids, emails, admission numbers, avatars or profile links; status forced to ACTIVE (NFR-4)\" },\n        \"403\": \"FORBIDDEN (no view access, or PARENT)\"\n      },\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-12\", \"FR-23\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/enrollments\",\n      \"description\": \"Enroll students directly in a course (create or reactivate DROPPED; same semantics as the roster engine helper). Role: ADMIN. Refused for CORE courses (membership is managed via the section). Capacity checked via checkCapacityOrThrow. Audits enrollment.create / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/EnrollResult\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Core course enrollment is managed via section 7A.'\"], \"400\": \"VALIDATION_ERROR — non-student ids\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/enrollments/:id\",\n      \"description\": \"Drop or reactivate a single enrollment (DROPPED sets droppedAt=now; ACTIVE clears it and runs checkCapacityOrThrow). Historical data is retained either way. Role: ADMIN. Audits enrollment.drop / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"status\": \"ACTIVE|DROPPED\", \"overrideCapacity\": \"boolean (optional, only meaningful for ACTIVE)\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Enrollment\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }], \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-12\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/courses\",\n      \"description\": \"Current user's courses for /my-courses, current academic year, non-archived. TEACHER: taught/co-taught; STUDENT: ACTIVE enrollments; PARENT: grouped by linked child; ADMIN: empty list (admins use /admin/courses). Role: any (requireRole(...ALL_ROLES), NFR-7 stand-in identity).\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"200 (TEACHER)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"section\": { \"id\": \"string\", \"name\": \"string\" }, \"enrolledCount\": \"number\" }] },\n        \"200 (STUDENT)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] },\n        \"200 (PARENT)\": { \"data\": [{ \"child\": { \"id\": \"string\", \"name\": \"string\" }, \"courses\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] }] }\n      },\n      \"requirementIds\": [\"FR-19\", \"FR-23\", \"NFR-7\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n# Tech Stack Decisions — PRD-05 Classes & Enrollment\n\nTicket: abcd-05 · Phase: architect (arch-research-stack) · Status: complete\n\nBase platform (from `artifacts/intake/tech-stack.json`, confidence 100%):\nNext.js 14 App Router, React 18, TypeScript strict, Prisma 5 / PostgreSQL,\nMUI v9 + emotion, `zod` for input validation, `date-fns`. This PRD is\nbrownfield on top of that stack — intake's detection notes already confirm\nit \"adds no new frontend framework or dependency,\" only new Prisma models\nand pages. The decisions below are the implementation-pattern deltas this\nPRD's requirements force, not a re-litigation of the base stack. No new\nruntime dependency is added by this PRD.\n\n## ADR-1: Bulk enroll/drop writes — `Prisma.$transaction` with batched\n`createMany`/`updateMany`, no job queue\n\n**Context.** NFR-3 requires adding 30 students to a section with 8 core\ncourses (240 resulting enrollments) to complete in under 1 second. FR-7–\nFR-10 describe enroll-on-add, drop-on-remove, move-section, and\ncreate-core-course as all-or-nothing operations touching many `Enrollment`\nrows at once.\n\n**Decision.** Implement each of these as a single `prisma.$transaction`\nthat computes the affected (studentId, courseId) pairs in memory first,\nthen issues one `enrollment.createMany({ skipDuplicates: true })` for new\nACTIVE rows and one `enrollment.updateMany` (keyed on the unique\n`[courseId, studentId]`) to reactivate previously-DROPPED rows, instead of\nlooping `create`/`update` calls per student per course. This is plain\nPrisma batch-write API already in the installed `@prisma/client` — no\nqueue, no background worker, no new dependency. 240 rows in one\n`createMany` plus one `updateMany` comfortably clears the 1-second bar on\nPostgres; a per-row loop (240 round-trips) would not.\n\n**Consequences.** Business logic that decides \"create vs. reactivate\" for\neach pair must be computed with a single prior `findMany`, not per-row\nqueries, to keep the whole operation at a small constant number of\nround-trips. If a future PRD needs enroll/drop across thousands of rows\n(bulk import), that's a new ADR for chunking or a background job — not a\nretrofit of this one.\n\n_Cites: FR-7, FR-8, FR-9, FR-10, NFR-3_\n\n## ADR-2: Capacity + uniqueness enforcement — DB unique constraints for\nidentity, in-transaction count check for capacity, no distributed lock\n\n**Context.** NFR-2 requires the one-section-per-student-per-year rule to be\na database constraint, not just app logic. FR-11 requires capacity\nenforcement (section and course) that refuses with CONFLICT unless an\nexplicit \"Override capacity\" flag is set, under concurrent admin actions.\n\n**Decision.** Identity/duplication rules (`@@unique([studentId,\nacademicYearId])` on `SectionMember`, `@@unique([courseId, studentId])` on\n`Enrollment`) are enforced by Postgres unique indexes already specified in\nFR-1; application code catches the Prisma `P2002` violation and maps it to\nthe existing CONFLICT error envelope rather than pre-checking existence\nfirst (avoids a check-then-insert race). Capacity, which is a *computed*\ncount rather than a stored invariant, is checked inside the same\n`$transaction` that performs the insert — `count()` the current\nmembers/enrollments, compare to `capacity`, and only then\n`create`/`createMany`, so a concurrent request either serializes behind the\ntransaction or re-checks and fails cleanly. No advisory lock, no Redis, no\ndistributed-lock library: Postgres's own transactional read-your-writes\nwithin one `$transaction` is sufficient at this app's scale (a school\nadmin console, not a high-concurrency storefront).\n\n**Consequences.** Capacity checks are \"good enough\" serialization, not a\nhard guarantee under extreme concurrent load from multiple admins hitting\nthe exact same section simultaneously; acceptable because this is an\ninternal admin tool with low write concurrency. If that ever changes,\nupgrading the capacity check to `SELECT ... FOR UPDATE` on a row is a small\nfollow-up, not a new ADR.\n\n_Cites: FR-1, FR-11, NFR-2_\n\n## ADR-3: No new dependency for the admin UI (tables, dialogs, pickers)\n\n**Context.** NFR-1 mandates every visible element in the sections/courses/\nenrollment screens come from `@mui/material`, `@mui/icons-material`, or MUI\nX, with no banned libraries (Tailwind, shadcn/ui, Radix, react-select,\netc.). FR-2–FR-6, FR-13–FR-19 describe filtered tables, create/edit\ndialogs, multi-select pickers, tabs, and card grids.\n\n**Decision.** Build all of it from the already-installed MUI v9 set plus\nthe existing shared components (`DataTable`, `UserPicker`, `ConfirmDialog`,\n`useToast`, `PageHeader`) per the brownfield reuse already confirmed in\nintake. Multi-select student/subject pickers extend `UserPicker`'s\nexisting `role` filter pattern rather than introducing a new\nautocomplete/select component. No new UI dependency.\n\n**Consequences.** None beyond the existing MUI-MCP lookup discipline\n(NFR-1) for any component variant not already used elsewhere in the\ncodebase.\n\n_Cites: FR-2, FR-3, FR-4, FR-5, FR-6, FR-13, FR-14, FR-15, FR-17, FR-19, NFR-1_\n\n## ADR-4: Auth — keep the `requireRole(...ALL_ROLES)` stand-in, no new\nauth helper\n\n**Context.** NFR-7 flags that `src/server/auth/permissions.ts` and\n`requireUser()` described in the platform context don't exist yet — only\n`requireRole.ts` and `student-access.ts` are present. This is the same\nbrownfield gap PRD-04's architect handoff already flagged.\n\n**Decision.** New route handlers in this PRD (sections/courses/enrollment\nCRUD, move-section, roster) continue to use the existing\n`requireRole(...ALL_ROLES)`-style stand-in, and `assertCanViewCourse`/\n`assertCanManageCourse` (FR-18) are added as plain functions in\n`src/server/auth/course-access.ts` alongside the existing\n`student-access.ts`, not as part of a new `permissions.ts` module. No new\nauth library, no new abstraction invented ahead of PRD-01 landing it\nproperly.\n\n**Consequences.** Role-gating logic stays slightly duplicated across\nper-feature `*-access.ts` files until PRD-01 ships a real\n`permissions.ts`; that consolidation is PRD-01's job, not this one's.\n\n_Cites: FR-18, FR-22, NFR-7_\n\n## Summary of new dependencies\n\nNone. Every requirement in this PRD (bulk transactional writes, capacity\nchecks, uniqueness, admin UI, auth gating) is covered by Prisma 5,\nPostgreSQL, MUI v9, and TypeScript already in the stack — intake's\nconfidence-100% stack detection holds.","is_error":false}]},"parent_tool_use_id":null,"session_id":"a6e489fc-abc2-4cf6-8575-95ca4cd13810","uuid":"b4ff207f-59c5-4840-a0d6-066b072af255","timestamp":"2026-10-27T16:42:58.321Z","tool_use_result":{"stdout":"{\n  \"ticketId\": \"abcd-05\",\n  \"timestamp\": \"2026-10-27T00:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md (REST API surface + Data Flow) and 05-classes-enrollment.md's API table; 17 endpoints (the table's '·'-joined rows are expanded). Conventions shared by every endpoint, not repeated per entry: (1) every handler is wrapped in withHandler() from src/server/http.ts, which maps ZodError->VALIDATION_ERROR 400, AppError->its code, Prisma P2002->CONFLICT 409, P2025->NOT_FOUND 404; (2) success = ok() -> { data }, lists = paginated() -> { data: [...], meta: { page, pageSize, total } } — the real helper nests pagination under `meta`, unlike the PRD's flat example; follow the helper; (3) list query conventions: page (default 1), pageSize (default 20, max 100), sort, order=asc|desc, q; (4) auth: every route calls requireRole(...) from src/server/auth/requireRole.ts (NFR-7 stand-in; no permissions.ts/requireUser()); course-scoped reads additionally call assertCanViewCourse from src/server/auth/course-access.ts (FR-18); (5) every write calls audit() inside the same $transaction (FR-24) via the service/engine, never at the route layer; (6) handlers are thin: zod parse -> one service call -> envelope. Shared shapes are named under `schemas` and referenced as \\\"$ref\\\": \\\"#/schemas/<Name>\\\".\",\n\n  \"schemas\": {\n    \"Section\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevel\": { \"id\": \"string\", \"name\": \"string\", \"order\": \"number\" },\n      \"name\": \"string\", \"homeroomTeacherId\": \"string|null\", \"homeroomTeacher\": { \"id\": \"string\", \"name\": \"string\" },\n      \"roomId\": \"string|null\", \"room\": { \"id\": \"string\", \"name\": \"string\" }, \"capacity\": \"number (1-60)\",\n      \"memberCount\": \"number\", \"courseCount\": \"number\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"SectionInput\": {\n      \"academicYearId\": \"string (required on create)\", \"gradeLevelId\": \"string\", \"name\": \"string (min 1)\",\n      \"homeroomTeacherId\": \"string|null (must be role=TEACHER; at most one section per teacher per year -> CONFLICT)\",\n      \"roomId\": \"string|null\", \"capacity\": \"int 1-60, default 30\"\n    },\n    \"Course\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"subjectId\": \"string\", \"subject\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"color\": \"string\" },\n      \"sectionId\": \"string|null\", \"section\": { \"id\": \"string\", \"name\": \"string\", \"room\": { \"id\": \"string\", \"name\": \"string\" } },\n      \"teacherId\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" }, \"coTeacherIds\": \"string[]\", \"coTeachers\": [{ \"id\": \"string\", \"name\": \"string\" }],\n      \"name\": \"string\", \"code\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"description\": \"string|null\", \"capacity\": \"number|null\",\n      \"archivedAt\": \"ISO 8601|null\", \"enrolledCount\": \"number (ACTIVE only)\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"CourseInput\": {\n      \"academicYearId\": \"string (required on create)\", \"subjectId\": \"string\", \"sectionId\": \"string|null (required iff kind=CORE — single zod refinement shared with the dialog, FR-14)\",\n      \"teacherId\": \"string (role=TEACHER)\", \"coTeacherIds\": \"string[] (max 3, role=TEACHER)\", \"name\": \"string (default '<Subject> – <Section>')\",\n      \"code\": \"string (default '<SUBJECTCODE>-<SECTION>', transformed to uppercase; unique per year -> CONFLICT)\", \"kind\": \"CORE|ELECTIVE (default CORE)\",\n      \"capacity\": \"int>=1|null\", \"description\": \"string|null\"\n    },\n    \"Enrollment\": {\n      \"id\": \"string\", \"courseId\": \"string\", \"studentId\": \"string\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\" },\n      \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\"\n    },\n    \"EnrollStudentsInput\": { \"studentIds\": \"string[] (min 1)\", \"overrideCapacity\": \"boolean (optional, default false)\" },\n    \"EnrollResult\": { \"enrolled\": \"number (new ACTIVE rows)\", \"reactivated\": \"number (DROPPED->ACTIVE)\", \"alreadyActive\": \"number\" },\n    \"CapacityConflict\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Section 7A is full (30/30). | Course MATH-7A is full (30/30).\" } }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/sections\",\n      \"description\": \"List sections for an academic year (defaults to current). Roles: ADMIN, TEACHER. Service: sections-service.listSections.\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, defaults to current AcademicYear)\", \"gradeLevelId\": \"string (optional)\", \"q\": \"string (optional, name search)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"name|gradeLevel|memberCount (default gradeLevel)\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Section\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } }, \"403\": \"FORBIDDEN (STUDENT/PARENT)\" },\n      \"requirementIds\": [\"FR-2\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections\",\n      \"description\": \"Create a section. Role: ADMIN. Homeroom-teacher-per-year check runs inside the write transaction (system-design Decision 3). Audits section.create.\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/SectionInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"409\": \"CONFLICT — duplicate name in year (P2002), or teacher already homeroom of another section this year\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Update a section (partial SectionInput, academicYearId immutable). Role: ADMIN. Capacity may not be lowered below current memberCount. Audits section.update.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<SectionInput> without academicYearId\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (name/homeroom uniqueness)\", \"400\": \"VALIDATION_ERROR (capacity < memberCount)\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Delete a section. Role: ADMIN. Allowed only when it has no members and no courses. Audits section.delete.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"id\": \"string\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT — 'Section 7A still has members or courses.'\" },\n      \"requirementIds\": [\"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/members\",\n      \"description\": \"Add students to a section and auto-enroll them ACTIVE in every non-archived CORE course of the section (reactivating DROPPED rows), all in one $transaction via roster-engine.enrollSectionCoreCourses with batched createMany/updateMany. Role: ADMIN. Audits section.member.add + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": {\n        \"201\": { \"data\": { \"added\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Sam Student is already in section 7A for 2026–2027.' (SectionMember @@unique P2002, mapped to the friendly message by the service)\"],\n        \"400\": \"VALIDATION_ERROR — student not role=STUDENT or wrong grade level\", \"404\": \"NOT_FOUND\"\n      },\n      \"requirementIds\": [\"FR-4\", \"FR-7\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-2\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id/members/:studentId\",\n      \"description\": \"Remove a student from a section; their ACTIVE enrollments in this section's CORE courses become DROPPED with droppedAt=now (electives untouched) via roster-engine.dropSectionCoreCourses, same transaction. Role: ADMIN. Audits section.member.remove + enrollment.drop.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\", \"studentId\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"removed\": true, \"droppedEnrollments\": \"number\" } }, \"404\": \"NOT_FOUND (student not a member)\" },\n      \"requirementIds\": [\"FR-4\", \"FR-8\", \"FR-12\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/students/:id/move-section\",\n      \"description\": \"Move a student to another section of the same academic year in a single $transaction: remove membership + drop source CORE enrollments, add membership + enroll/reactivate destination CORE enrollments (roster-engine.moveStudentSection). Electives unchanged. Role: ADMIN. Audits section.member.move + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string (studentId)\" }, \"body\": { \"toSectionId\": \"string\", \"overrideCapacity\": \"boolean (optional, default false)\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"fromSectionId\": \"string\", \"toSectionId\": \"string\", \"dropped\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }],\n        \"400\": \"VALIDATION_ERROR — destination in a different academic year, or same as source\", \"404\": \"NOT_FOUND — student has no section this year, or toSectionId unknown\"\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-7\", \"FR-8\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/core-courses\",\n      \"description\": \"Bulk-create one CORE course per item (default name '<Subject> – <Section>', code '<SUBJECTCODE>-<SECTION>') and enroll all current section members in each, one $transaction. Subjects must be non-archived. Role: ADMIN. Audits course.create + enrollment.* per course.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"items\": [{ \"subjectId\": \"string\", \"teacherId\": \"string (role=TEACHER)\" }], \"_constraints\": \"items min 1, subjectIds unique\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"courses\": [{ \"$ref\": \"#/schemas/Course\" }], \"enrollmentsCreated\": \"number\" } }, \"409\": \"CONFLICT — course code already exists this year (P2002)\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-5\", \"FR-10\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/copy-to-year\",\n      \"description\": \"Structural copy of all sections from one year to a future, non-current year: name, room, capacity copied; gradeLevel advanced to the next GradeLevel by `order` (sections at the top grade are skipped); no members, no homeroom teacher, no courses. Role: ADMIN. Audits section.create per copy.\",\n      \"requestSchema\": { \"body\": { \"fromYearId\": \"string\", \"toYearId\": \"string (must be a future, non-current AcademicYear)\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"created\": \"number\", \"skipped\": [{ \"name\": \"string\", \"reason\": \"no next grade level | name already exists in target year\" }] } }, \"400\": \"VALIDATION_ERROR — toYearId is current or not in the future\" },\n      \"requirementIds\": [\"FR-6\", \"FR-23\", \"FR-24\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses\",\n      \"description\": \"List courses. ADMIN sees all; TEACHER sees courses they teach/co-teach; STUDENT/PARENT see courses with an ACTIVE enrollment for self/linked child (scoping done in courses-service, not by client filter). Excludes archived unless includeArchived=true (ADMIN only).\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, default current)\", \"gradeLevelId\": \"string\", \"subjectId\": \"string\", \"teacherId\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"sectionId\": \"string\", \"includeArchived\": \"boolean\", \"q\": \"string (name/code)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"code|name|enrolledCount\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Course\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"requirementIds\": [\"FR-13\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses\",\n      \"description\": \"Create a course. Role: ADMIN. A new CORE course on a section enrolls all current section members ACTIVE in the same transaction (FR-10). Audits course.create (+ enrollment.* if CORE).\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/CourseInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"409\": \"CONFLICT — code already used this year\", \"400\": \"VALIDATION_ERROR — e.g. kind=CORE without sectionId, >3 coTeachers\" },\n      \"requirementIds\": [\"FR-14\", \"FR-10\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Update a course (partial CourseInput; academicYearId/sectionId/kind immutable after creation to avoid silent roster rewrites). Archive via { archived: true } (sets archivedAt), unarchive via { archived: false }. Role: ADMIN. Audits course.update / course.archive.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<CourseInput> without academicYearId/sectionId/kind, plus archived?: boolean\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (code)\", \"400\": \"VALIDATION_ERROR (capacity < enrolledCount)\" },\n      \"requirementIds\": [\"FR-14\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Course header/overview data for /courses/[courseId]. Gated by assertCanViewCourse (ADMIN all; TEACHER teacher/co-teacher; STUDENT ACTIVE enrollment; PARENT linked child ACTIVE enrollment).\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"403\": \"FORBIDDEN\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\", \"FR-23\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/roster\",\n      \"description\": \"Course roster, ACTIVE enrollments by default. Gated by assertCanViewCourse; PARENT gets FORBIDDEN (Roster tab not shown). Shape from courses-service.getCourseRoster(id, viewerRole) — the same function the Roster tab server component uses.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"query\": { \"status\": \"ACTIVE|DROPPED|ALL (default ACTIVE; DROPPED/ALL only for ADMIN/TEACHER)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"q\": \"string\" } },\n      \"responseSchema\": {\n        \"200 (ADMIN, TEACHER)\": { \"data\": [{ \"enrollmentId\": \"string\", \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\", \"profileUrl\": \"/students/:id\" } }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },\n        \"200 (STUDENT)\": { \"data\": [{ \"name\": \"string\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" }, \"_privacy\": \"Projection is names only — no ids, emails, admission numbers, avatars or profile links; status forced to ACTIVE (NFR-4)\" },\n        \"403\": \"FORBIDDEN (no view access, or PARENT)\"\n      },\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-12\", \"FR-23\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/enrollments\",\n      \"description\": \"Enroll students directly in a course (create or reactivate DROPPED; same semantics as the roster engine helper). Role: ADMIN. Refused for CORE courses (membership is managed via the section). Capacity checked via checkCapacityOrThrow. Audits enrollment.create / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/EnrollResult\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Core course enrollment is managed via section 7A.'\"], \"400\": \"VALIDATION_ERROR — non-student ids\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/enrollments/:id\",\n      \"description\": \"Drop or reactivate a single enrollment (DROPPED sets droppedAt=now; ACTIVE clears it and runs checkCapacityOrThrow). Historical data is retained either way. Role: ADMIN. Audits enrollment.drop / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"status\": \"ACTIVE|DROPPED\", \"overrideCapacity\": \"boolean (optional, only meaningful for ACTIVE)\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Enrollment\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }], \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-12\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/courses\",\n      \"description\": \"Current user's courses for /my-courses, current academic year, non-archived. TEACHER: taught/co-taught; STUDENT: ACTIVE enrollments; PARENT: grouped by linked child; ADMIN: empty list (admins use /admin/courses). Role: any (requireRole(...ALL_ROLES), NFR-7 stand-in identity).\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"200 (TEACHER)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"section\": { \"id\": \"string\", \"name\": \"string\" }, \"enrolledCount\": \"number\" }] },\n        \"200 (STUDENT)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] },\n        \"200 (PARENT)\": { \"data\": [{ \"child\": { \"id\": \"string\", \"name\": \"string\" }, \"courses\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] }] }\n      },\n      \"requirementIds\": [\"FR-19\", \"FR-23\", \"NFR-7\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n# Tech Stack Decisions — PRD-05 Classes & Enrollment\n\nTicket: abcd-05 · Phase: architect (arch-research-stack) · Status: complete\n\nBase platform (from `artifacts/intake/tech-stack.json`, confidence 100%):\nNext.js 14 App Router, React 18, TypeScript strict, Prisma 5 / PostgreSQL,\nMUI v9 + emotion, `zod` for input validation, `date-fns`. This PRD is\nbrownfield on top of that stack — intake's detection notes already confirm\nit \"adds no new frontend framework or dependency,\" only new Prisma models\nand pages. The decisions below are the implementation-pattern deltas this\nPRD's requirements force, not a re-litigation of the base stack. No new\nruntime dependency is added by this PRD.\n\n## ADR-1: Bulk enroll/drop writes — `Prisma.$transaction` with batched\n`createMany`/`updateMany`, no job queue\n\n**Context.** NFR-3 requires adding 30 students to a section with 8 core\ncourses (240 resulting enrollments) to complete in under 1 second. FR-7–\nFR-10 describe enroll-on-add, drop-on-remove, move-section, and\ncreate-core-course as all-or-nothing operations touching many `Enrollment`\nrows at once.\n\n**Decision.** Implement each of these as a single `prisma.$transaction`\nthat computes the affected (studentId, courseId) pairs in memory first,\nthen issues one `enrollment.createMany({ skipDuplicates: true })` for new\nACTIVE rows and one `enrollment.updateMany` (keyed on the unique\n`[courseId, studentId]`) to reactivate previously-DROPPED rows, instead of\nlooping `create`/`update` calls per student per course. This is plain\nPrisma batch-write API already in the installed `@prisma/client` — no\nqueue, no background worker, no new dependency. 240 rows in one\n`createMany` plus one `updateMany` comfortably clears the 1-second bar on\nPostgres; a per-row loop (240 round-trips) would not.\n\n**Consequences.** Business logic that decides \"create vs. reactivate\" for\neach pair must be computed with a single prior `findMany`, not per-row\nqueries, to keep the whole operation at a small constant number of\nround-trips. If a future PRD needs enroll/drop across thousands of rows\n(bulk import), that's a new ADR for chunking or a background job — not a\nretrofit of this one.\n\n_Cites: FR-7, FR-8, FR-9, FR-10, NFR-3_\n\n## ADR-2: Capacity + uniqueness enforcement — DB unique constraints for\nidentity, in-transaction count check for capacity, no distributed lock\n\n**Context.** NFR-2 requires the one-section-per-student-per-year rule to be\na database constraint, not just app logic. FR-11 requires capacity\nenforcement (section and course) that refuses with CONFLICT unless an\nexplicit \"Override capacity\" flag is set, under concurrent admin actions.\n\n**Decision.** Identity/duplication rules (`@@unique([studentId,\nacademicYearId])` on `SectionMember`, `@@unique([courseId, studentId])` on\n`Enrollment`) are enforced by Postgres unique indexes already specified in\nFR-1; application code catches the Prisma `P2002` violation and maps it to\nthe existing CONFLICT error envelope rather than pre-checking existence\nfirst (avoids a check-then-insert race). Capacity, which is a *computed*\ncount rather than a stored invariant, is checked inside the same\n`$transaction` that performs the insert — `count()` the current\nmembers/enrollments, compare to `capacity`, and only then\n`create`/`createMany`, so a concurrent request either serializes behind the\ntransaction or re-checks and fails cleanly. No advisory lock, no Redis, no\ndistributed-lock library: Postgres's own transactional read-your-writes\nwithin one `$transaction` is sufficient at this app's scale (a school\nadmin console, not a high-concurrency storefront).\n\n**Consequences.** Capacity checks are \"good enough\" serialization, not a\nhard guarantee under extreme concurrent load from multiple admins hitting\nthe exact same section simultaneously; acceptable because this is an\ninternal admin tool with low write concurrency. If that ever changes,\nupgrading the capacity check to `SELECT ... FOR UPDATE` on a row is a small\nfollow-up, not a new ADR.\n\n_Cites: FR-1, FR-11, NFR-2_\n\n## ADR-3: No new dependency for the admin UI (tables, dialogs, pickers)\n\n**Context.** NFR-1 mandates every visible element in the sections/courses/\nenrollment screens come from `@mui/material`, `@mui/icons-material`, or MUI\nX, with no banned libraries (Tailwind, shadcn/ui, Radix, react-select,\netc.). FR-2–FR-6, FR-13–FR-19 describe filtered tables, create/edit\ndialogs, multi-select pickers, tabs, and card grids.\n\n**Decision.** Build all of it from the already-installed MUI v9 set plus\nthe existing shared components (`DataTable`, `UserPicker`, `ConfirmDialog`,\n`useToast`, `PageHeader`) per the brownfield reuse already confirmed in\nintake. Multi-select student/subject pickers extend `UserPicker`'s\nexisting `role` filter pattern rather than introducing a new\nautocomplete/select component. No new UI dependency.\n\n**Consequences.** None beyond the existing MUI-MCP lookup discipline\n(NFR-1) for any component variant not already used elsewhere in the\ncodebase.\n\n_Cites: FR-2, FR-3, FR-4, FR-5, FR-6, FR-13, FR-14, FR-15, FR-17, FR-19, NFR-1_\n\n## ADR-4: Auth — keep the `requireRole(...ALL_ROLES)` stand-in, no new\nauth helper\n\n**Context.** NFR-7 flags that `src/server/auth/permissions.ts` and\n`requireUser()` described in the platform context don't exist yet — only\n`requireRole.ts` and `student-access.ts` are present. This is the same\nbrownfield gap PRD-04's architect handoff already flagged.\n\n**Decision.** New route handlers in this PRD (sections/courses/enrollment\nCRUD, move-section, roster) continue to use the existing\n`requireRole(...ALL_ROLES)`-style stand-in, and `assertCanViewCourse`/\n`assertCanManageCourse` (FR-18) are added as plain functions in\n`src/server/auth/course-access.ts` alongside the existing\n`student-access.ts`, not as part of a new `permissions.ts` module. No new\nauth library, no new abstraction invented ahead of PRD-01 landing it\nproperly.\n\n**Consequences.** Role-gating logic stays slightly duplicated across\nper-feature `*-access.ts` files until PRD-01 ships a real\n`permissions.ts`; that consolidation is PRD-01's job, not this one's.\n\n_Cites: FR-18, FR-22, NFR-7_\n\n## Summary of new dependencies\n\nNone. Every requirement in this PRD (bulk transactional writes, capacity\nchecks, uniqueness, admin UI, auth gating) is covered by Prisma 5,\nPostgreSQL, MUI v9, and TypeScript already in the stack — intake's\nconfidence-100% stack detection holds.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DYQhCm6Fcg52krQ883JTxd","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgT5Pyn8W31SS2cVdT2bp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XYDbgeHUenNs9ocVN92h4A","name":"Bash","input":{"command":"cat src/server/http.ts src/server/auth/requireRole.ts src/server/audit.ts src/server/db.ts src/server/services/academicYears.ts | head -300","description":"Read server infra helpers"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10396,"cache_read_input_tokens":53877,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10396},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a6e489fc-abc2-4cf6-8575-95ca4cd13810","uuid":"32df3776-8788-44be-b632-0f750f8bba91","timestamp":"2026-10-27T16:43:01.502Z","request_id":"req_011CgT5PyVGPbAH7egT4iB5F","wire_tool_inputs":{"toolu_01XYDbgeHUenNs9ocVN92h4A":{"command":"cd /Users/ikramaansari/Documents/forge/schoolhub-prds && cat src/server/http.ts src/server/auth/requireRole.ts src/server/audit.ts src/server/db.ts src/server/services/academicYears.ts | head -300","description":"Read server infra helpers"}},"wire_ingest_context":{"toolu_01XYDbgeHUenNs9ocVN92h4A":{"cwd":"/Users/ikramaansari/Documents/forge/schoolhub-prds"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XYDbgeHUenNs9ocVN92h4A","type":"tool_result","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\nexport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\nexport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side role checks on write endpoints.\n *\n * PRD-01 (real auth/session) has not landed in this workspace yet, so\n * there is no session to read. This returns the same ADMIN placeholder\n * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n * and throws FORBIDDEN when that role isn't in the allowed list. Every\n * write endpoint in this PRD calls requireRole() instead of checking role\n * itself, so wiring up a real session later is a one-file change here\n * instead of touching every route.\n */\nconst PLACEHOLDER_USER = { id: 'placeholder-user', role: 'ADMIN' as Role };\n\nexport function requireRole(...roles: Role[]): { id: string; role: Role } {\n  if (!roles.includes(PLACEHOLDER_USER.role)) {\n    throw new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n  }\n  return PLACEHOLDER_USER;\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n}\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: input.metadata,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\nimport { cache } from 'react';\nimport { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { rangesOverlap } from './dateRange';\nimport { getSchoolSettings } from './settings';\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface AcademicYearInput {\n  name: string;\n  startDate: Date;\n  endDate: Date;\n}\n\nfunction assertValidRange(startDate: Date, endDate: Date) {\n  if (endDate <= startDate) {\n    throw new AppError('VALIDATION_ERROR', 'End date must be after start date.');\n  }\n}\n\nasync function assertNoOverlap(\n  tx: Prisma.TransactionClient,\n  range: { startDate: Date; endDate: Date },\n  excludeId?: string,\n) {\n  const others = await tx.academicYear.findMany({\n    where: excludeId ? { id: { not: excludeId } } : undefined,\n  });\n  const conflict = others.find((year) => rangesOverlap(range, year));\n  if (conflict) {\n    throw new AppError('VALIDATION_ERROR', `Dates overlap with ${conflict.name}.`);\n  }\n}\n\nexport async function listAcademicYears() {\n  return prisma.academicYear.findMany({\n    orderBy: { startDate: 'asc' },\n    include: { terms: { orderBy: { order: 'asc' } } },\n  });\n}\n\nexport async function createAcademicYear(input: AcademicYearInput) {\n  assertValidRange(input.startDate, input.endDate);\n  return prisma.$transaction(\n    async (tx) => {\n      await assertNoOverlap(tx, input);\n      return tx.academicYear.create({ data: input });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\nexport async function updateAcademicYear(id: string, input: Partial<AcademicYearInput>) {\n  return prisma.$transaction(\n    async (tx) => {\n      const existing = await tx.academicYear.findUniqueOrThrow({ where: { id } });\n      const startDate = input.startDate ?? existing.startDate;\n      const endDate = input.endDate ?? existing.endDate;\n      assertValidRange(startDate, endDate);\n      await assertNoOverlap(tx, { startDate, endDate }, id);\n      return tx.academicYear.update({\n        where: { id },\n        data: { name: input.name ?? existing.name, startDate, endDate },\n      });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\n/** Sets isCurrent = true on `id` and false on every other year, atomically. */\nexport async function setCurrentAcademicYear(id: string) {\n  const [, updated] = await prisma.$transaction([\n    prisma.academicYear.updateMany({ where: { id: { not: id } }, data: { isCurrent: false } }),\n    prisma.academicYear.update({ where: { id }, data: { isCurrent: true } }),\n  ]);\n  return updated;\n}\n\nexport async function deleteAcademicYear(id: string) {\n  const termCount = await prisma.term.count({ where: { academicYearId: id } });\n  if (termCount > 0) {\n    throw new AppError('CONFLICT', 'In use — cannot delete.');\n  }\n  await prisma.academicYear.delete({ where: { id } });\n}\n\n/** The one place the rest of the app reads \"the current academic year\" from. */\nexport const getCurrentAcademicYear = cache(async () => {\n  return prisma.academicYear.findFirst({\n    where: { isCurrent: true },\n    include: { terms: { orderBy: { order: 'asc' } } },\n  });\n});\n\n/** Returns the term whose range contains `date` (school-timezone calendar day), or null. */\nexport async function getCurrentTerm(date: Date = new Date()) {","is_error":false}]},"parent_tool_use_id":null,"session_id":"a6e489fc-abc2-4cf6-8575-95ca4cd13810","uuid":"83cef2ae-b899-4a4c-b3ff-9f660bbcf184","timestamp":"2026-10-27T16:43:01.639Z","tool_use_result":{"stdout":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiErr