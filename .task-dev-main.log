ts'),\n  description: z.string().trim().max(1000).optional().default(''),\n});\n\nexport const rubricCriterionInput = z\n  .object({\n    id: id.optional(),\n    title: z.string().trim().min(1, 'Criterion title is required').max(TITLE_MAX),\n    description: z.string().trim().max(1000).optional().default(''),\n    maxPoints: decimal(0, 1000, 'Criterion points'),\n    levels: z.array(rubricLevelInput).min(1, 'Add at least one level').max(10),\n  })\n  .superRefine((c, ctx) => {\n    c.levels.forEach((l, i) => {\n      if (dec(l.points).gt(dec(c.maxPoints))) {\n        ctx.addIssue({ code: 'custom', path: ['levels', i, 'points'], message: 'Level points exceed the criterion maximum' });\n      }\n    });\n  });\n\nexport const rubricSumMessage = (sum: string, maxPoints: string) =>\n  `Rubric totals ${sum} points but the assignment is worth ${maxPoints}.`;\n\nconst trimZeros = (s: string) => dec(s).toString();\n\nexport const assignmentFields = z.object({\n  title: z.string().trim().min(1, 'Title is required').max(TITLE_MAX),\n  instructions: z.string().max(INSTRUCTIONS_MAX).default(''),\n  submissionType: z.enum(SUBMISSION_TYPES),\n  maxPoints: decimal(0, 1000, 'Max points'),\n  dueAt: instant,\n  availableFrom: instant.nullable().optional(),\n  allowLate: z.boolean().default(false),\n  lateCutoffAt: instant.nullable().optional(),\n  latePenaltyPercentPerDay: decimal(0, 100, 'Penalty per day').default(0),\n  maxLatePenaltyPercent: decimal(0, 100, 'Maximum penalty').default(0),\n  maxFileCount: z.coerce.number().int().min(1).max(10).default(3),\n  allowExtraCredit: z.boolean().default(false),\n  status: z.enum(ASSIGNMENT_STATUSES),\n  rubric: z.array(rubricCriterionInput).max(20).nullable().optional(),\n  attachmentFileIds: z.array(id).max(10).default([]),\n});\n\nassignment-validators.test.ts\ngrading-math.test.ts\nimport { describe, expect, it } from 'vitest';\nimport { assignmentInput, gradeInput, submissionInput } from '@/lib/validators/assignments';\n\nconst base = {\n  title: 'Fractions worksheet',\n  submissionType: 'FILE_UPLOAD',\n  maxPoints: 20,\n  dueAt: '2026-09-14T22:59:00Z',\n  status: 'PUBLISHED',\n};\nconst criterion = (maxPoints: number | string) => ({ title: 'C', maxPoints, levels: [{ label: 'Full', points: maxPoints }] });\nconst messages = (r: { success: boolean; error?: { issues: { message: string }[] } }) => r.error?.issues.map((i) => i.message) ?? [];\n\ndescribe('assignmentInput (FR-7, FR-11)', () => {\n  it('accepts the minimum and applies defaults; decimals become 2 dp strings', () => {\n    const r = assignmentInput.parse(base);\n    expect(r.maxPoints).toBe('20.00');\n    expect(r.maxFileCount).toBe(3);\n    expect(r.allowLate).toBe(false);\n    expect(r.attachmentFileIds).toEqual([]);\n  });\n\n  it('enforces field limits', () => {\n    expect(assignmentInput.safeParse({ ...base, title: 'x'.repeat(151) }).success).toBe(false);\n    expect(assignmentInput.safeParse({ ...base, maxPoints: 1001 }).success).toBe(false);\n    expect(assignmentInput.safeParse({ ...base, maxPoints: '1.234' }).success).toBe(false);\n    expect(assignmentInput.safeParse({ ...base, maxFileCount: 11 }).success).toBe(false);\n    expect(assignmentInput.safeParse({ ...base, latePenaltyPercentPerDay: 101 }).success).toBe(false);\n    expect(assignmentInput.safeParse({ ...base, instructions: 'x'.repeat(50_001) }).success).toBe(false);\n  });\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\n24:    \"@dnd-kit/core\": \"6.3.1\",\n25:    \"@dnd-kit/sortable\": \"10.0.0\",\n30:    \"@mui/material\": \"9.5.0\",\n32:    \"@mui/x-charts\": \"9.5.0\",\n34:    \"@mui/x-date-pickers\