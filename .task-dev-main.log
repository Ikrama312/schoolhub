ongDate = (d: string) => formatInSchoolTz(toDbDate(d), 'EEEE d MMM yyyy', 'UTC');\n52:function kindWhere(mode: AttendanceMode): Prisma.AttendanceSessionWhereInput {\n106:    ? { courseId: key.courseId, periodId: key.periodId, date: toDbDate(key.date) }\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013bPUcN7kTB6VpceFbz4aBn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
