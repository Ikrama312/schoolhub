{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WtNrQ9T9BozSaqBym8pA8A","type":"tool_result","content":"'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport Avatar from '@mui/material/Avatar';\n\nexport interface UserAvatarProps {\n  userId: string;\n  name: string;\n  size?: number;\n}\n\nconst PALETTE = ['#4F46E5', '#0EA5E9', '#15803D', '#B45309', '#B91C1C', '#7C3AED', '#0D9488'];\n\nfunction colorForId(id: string): string {\n  let hash = 0;\n  for (let i = 0; i < id.length; i += 1) {\n    hash = (hash * 31 + id.charCodeAt(i)) | 0;\n  }\n  return PALETTE[Math.abs(hash) % PALETTE.length];\n}\n\nfunction initialsFor(name: string): string {\n  const parts = name.trim().split(/\\s+/).filter(Boolean);\n  if (parts.length === 0) return '?';\n  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n}\n\n/** Avatar with initials on a deterministic background colour derived from userId. */\nexport function UserAvatar({ userId, name, size = 32 }: UserAvatarProps) {\n  return (\n    <Avatar sx={{ bgcolor: colorForId(userId), width: size, height: size, fontSize: size * 0.4 }}>\n      {initialsFor(name)}\n    </Avatar>\n  );\n}\nFormField.tsx\n'use client';\n\nimport { Controller, type Control, type FieldValues, type Path } from 'react-hook-form';\nimport TextField, { type TextFieldProps } from '@mui/material/TextField';\nimport MenuItem from '@mui/material/MenuItem';\nimport Checkbox from '@mui/material/Checkbox';\nimport Switch from '@mui/material/Switch';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormControl from '@mui/material/FormControl';\nimport FormLabel from '@mui/material/FormLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Radio from '@mui/material/Radio';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { DateTimePicker } from '@mui/x-date-pickers/DateTimePicker';\n\ninterface BaseProps<TFieldValues extends FieldValues> {\n  name: Path<TFieldValues>;\n  control: Control<TFieldValues>;\n  label: string;\n  helperText?: string;\n}\n\n/** Plain text / number / etc. MUI TextField bound via Controller. */\nexport function TextFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  ...rest\n}: BaseProps<TFieldValues> & Omit<TextFieldProps, 'name' | 'label' | 'error' | 'helperText'>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          {...rest}\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface DateDisplayProps {\n  date: Date | string;\n  pattern?: string;\n  timezone: string;\n}\n\nconst DEFAULT_PATTERN = 'MMM d, yyyy h:mm a';\n\n/** Renders a UTC date formatted in the school's timezone. */\nexport function DateDisplay({ date, pattern = DEFAULT_PATTERN, timezone }: DateDisplayProps) {\n  return <span>{formatInSchoolTz(date, pattern, timezone)}</span>;\n}\n192:  timezone     String   @default(\"UTC\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"46abff3e-324d-47c1-a451-e45bcb70c7c7","uuid":"7d96ba5e-70e2-4e1a-9674-79d93b3370c2","timestamp":"2026-11-04T06:52:01.072Z","tool_use_result":{"stdout":"'use client';\n\nimport { createContext