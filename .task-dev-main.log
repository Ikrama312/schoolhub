: 0.5, flexWrap: 'wrap', color: 'text.secondary' }} useFlexGap>\n            <Typography variant=\"body2\">{course.code}</Typography>\n            <Typography variant=\"body2\">Teachers: {teachers}</Typography>\n            {course.section && <Typography variant=\"body2\">Section {course.section.name}</Typography>}\n            {course.section?.room && <Typography variant=\"body2\">Room {course.section.room.name}</Typography>}\n          </Stack>\n        </Box>\n      </Paper>\n      <CourseTabs courseId={course.id} role={user.role} />\n      {children}\n    </Box>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1141,"cache_read_input_tokens":117304,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1141},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"81bbf07f-aa50-4be8-a9fd-aadb53d823ea","timestamp":"2026-10-27T16:53:01.493Z","request_id":"req_011CgT69W3ji1xTkP1Z3stj5","wire_tool_inputs":{"toolu_01P1t1a1NJ62CK7tRkh2debZ":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/(app)/courses/[courseId]/layout.tsx","content":"import { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { AppError } from '@/server/http';\nimport { getCourse } from '@/server/courses/courses-service';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { CourseTabs } from './CourseTabs';\n\nexport const dynamic = 'force-dy