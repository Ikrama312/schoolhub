sma: phone is FR-3's common\n/// field shared by every role, archivedAt backs FR-13's archive/restore\n/// (separate from status so a DISABLED-but-not-archived user stays distinct\n/// from an archived one).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  phone             String?\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  archivedAt        DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n  studentProfile    StudentProfile?\n  teacherProfile    TeacherProfile?\n  parentProfile     ParentProfile?\n  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")\n  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")\n\n  @@index([lastName, firstName, email])\n}\n\n/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n/// only -- enforced in the service layer (src/server/services/users.ts,\n/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\nmodel StudentProfile {\n  userId           String     @id\n  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  admissionNumber  String     @unique\n  dateOfBirth      DateTime   @db.Date\n  gender           Gender     @default(UNDISCLOSED)\n  gradeLevelId     String\n  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n  enrollmentDate   DateTime   @db.Date\n  addressLine1     String?\n  city             String?\n  medicalNotes     String?\n  emergencyContact String?\n  emergencyPhone   String?\n}\n\n/// Teacher-specific fields (FR-1).\nmodel TeacherProfile {\n  userId         String    @id\n  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  employeeNumber String    @unique\n  title          String?\n  qualifications String?\n  hireDate       DateTime? @db.Date\n}\n\n/// Parent-specific fields (FR-1).\nmodel ParentProfile {\n  userId     String  @id\n  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  occupation String?\n  address    String?\n}\n\n/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n/// transaction invariants rather than DB constraints.\nmodel ParentStudentLink {\n  id           String               @id @default(cuid())\n  parentId     String\n  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n  studentId    String\n  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n  relationship GuardianRelationship\n  isPrimary    Boolean              @default(false)\n  createdAt    DateTime             @default(now())\n\n  @@unique([parentId, studentId])\n  @@index([studentId])\n}","originalFile":"generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  shortName  String    @unique\n  order      Int       @unique\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n","structuredPatch":[{"oldStart":26,"oldLines":27,"newStart":26,"newLines":111,"lines":["   PASSWORD_RESET"," }"," ","+enum Gender {","+  FEMALE","+  MALE","+  OTHER","+  UNDISCLOSED","+}","+","+enum GuardianRelationship {","+  MOTHER","+  FATHER","+  GUARDIAN","+  GRANDPARENT","+  OTHER","+}","+"," /// Every authenticated person. passwordHash is nullable because an INVITED"," /// user has no password until they accept their invite (TASK-8's"," /// acceptInvite step sets both passwordHash and status=ACTIVE together).","+/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the","+/// only task in this PRD that owns schema.prisma: phone is FR-3's common","+/// field shared by every role, archivedAt backs FR-13's archive/restore","+/// (separate from status so a DISABLED-but-not-archived user stays distinct","+/// from an archived one)."," model User {","   id                String      @id @default(cuid())","   email             String      @unique","   passwordHash      String?","   firstName         String","   lastName          String","+  phone             String?","   role              Role","   status            UserStatus  @default(INVITED)","   failedLoginCount  Int         @default(0)","   lockedUntil       DateTime?","   lastLoginAt       DateTime?","   passwordChangedAt DateTime?","+  archivedAt        DateTime?","   createdAt         DateTime    @default(now())","   updatedAt         DateTime    @updatedAt","   authTokens        AuthToken[]","   auditLogs         AuditLog[]","+  studentProfile    StudentProfile?","+  teacherProfile    TeacherProfile?","+  parentProfile     ParentProfile?","+  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")","+  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")","+","+  @@index([lastName, firstName, email])"," }"," ","+/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER","+/// only -- enforced in the service layer (src/server/services/users.ts,","+/// src/app/api/students/[id]/route.ts), never by hiding it client-side.","+model StudentProfile {","+  userId           String     @id","+  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)","+  admissionNumber  String     @unique","+  dateOfBirth      DateTime   @db.Date","+  gender           Gender     @default(UNDISCLOSED)","+  gradeLevelId     String","+  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])","+  enrollmentDate   DateTime   @db.Date","+  addressLine1     String?","+  city             String?","+  medicalNotes     String?","+  emergencyContact String?","+  emergencyPhone   String?","+}","+","+/// Teacher-specific fields (FR-1).","+model TeacherProfile {","+  userId         String    @id","+  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)","+  employeeNumber String    @unique","+  title          String?","+  qualifications String?","+  hireDate       DateTime? @db.Date","+}","+","+/// Parent-specific fields (FR-1).","+model ParentProfile {","+  userId     String  @id","+  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)","+  occupation String?","+  address    String?","+}","+","+/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for","+/// emails; src/server/services/userLinks.ts is the only writer, enforcing","+/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as","+/// transaction invariants rather than DB constraints.","+model ParentStudentLink {","+  id           String               @id @default(cuid())","+  parentId     String","+  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)","+  studentId    String","+  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)","+  relationship GuardianRelationship","+  isPrimary    Boolean              @default(false)","+  createdAt    DateTime             @default(now())","+","+  @@unique([parentId, studentId])","+  @@index([studentId])","+}","+"," /// Invite + password-reset tokens. Only the SHA-256 hash is ever stored"," /// (NFR-1) — the raw token exists only in the link emailed/logged to the"," /// user. One shared shape for both token types; src/server/auth/tokens.ts"]}],"userModified":false,"replaceAll":false}}
