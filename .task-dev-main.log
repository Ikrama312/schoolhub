{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LvEzTCbXpL7udcKgyGSx5J","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/auth/student-access.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"020b7a6e-6236-4f8d-a760-9a7fb50fdcce","uuid":"6c3a01a3-2f22-4d50-bb12-5ed959b8a50d","timestamp":"2026-10-27T16:41:24.267Z","tool_use_result":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/auth/student-access.ts","oldString":" * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN, and TEACHER is denied everything until PRD-05).","newString":" * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN; TEACHER is denied students outside their courses/homeroom).","originalFile":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\nexport interface AccessUser {\n  id: string;\n  role: Role;\n}\n\nexport type AccessibleStudentIds = 'ALL' | string[];\n\n/**\n * FR-17: resolves which student ids `user` may see.\n * - ADMIN: \"ALL\" (every student)\n * - STUDENT: only themselves\n * - PARENT: students linked via ParentStudentLink (component 6)\n * - TEACHER (PRD-05 FR-22): students ACTIVE in courses they teach or\n *   co-teach, plus members of sections they are homeroom teacher of.\n */\nexport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n  switch (user.role) {\n    case 'ADMIN':\n      return 'ALL';\n    case 'STUDENT':\n      return [user.id];\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({\n        where: { parentId: user.id },\n        select: { studentId: true },\n      });\n      return links.map((link) => link.studentId);\n    }\n    case 'TEACHER': {\n      const [enrolled, members] = await Promise.all([\n        prisma.enrollment.findMany({\n          where: {\n            status: 'ACTIVE',\n            course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] },\n          },\n          select: { studentId: true },\n          distinct: ['studentId'],\n        }),\n        prisma.sectionMember.findMany({\n          where: { section: { homeroomTeacherId: user.id } },\n          select: { studentId: true },\n        }),\n      ]);\n      return [...new Set([...enrolled, ...members].map((row) => row.studentId))];\n    }\n    default:\n      return [];\n  }\n}\n\n/**\n * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n * not allowed to see this particular studentId -- NOT_FOUND rather than\n * FORBIDDEN so existence of another family's student is never revealed.\n * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN, and TEACHER is denied everything until PRD-05).\n */\nexport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n  const accessible = await getAccessibleStudentIds(user);\n\n  if (accessible === 'ALL') return;\n\n  if (accessible.includes(studentId)) return;\n\n  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n    throw new AppError('NOT_FOUND', 'Resource not found');\n  }\n\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n}\n","structuredPatch":[{"oldStart":58,"oldLines":7,"newStart":58,"newLines":7,"lines":["  * not allowed to see this particular studentId -- NOT_FOUND rather than","  * FORBIDDEN so existence of another family's student is never revealed.","  * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to","- * ADMIN, and TEACHER is denied everything until PRD-05).","+ * ADMIN; TEACHER is denied students outside their courses/homeroom).","  */"," export async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {","   const accessible = await getAccessibleStudentIds(user);"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01LvEzTCbXpL7udcKgyGSx5J","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
