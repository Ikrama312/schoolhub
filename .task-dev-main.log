  profile/page.tsx                (CREATE)\n89\t\n90\ttests/\n91\t  unit/\n92\t    userValidators.test.ts              (CREATE)\n93\t    userNumberGenerators.test.ts        (CREATE)\n94\t    csv.test.ts                         (CREATE)\n95\t    studentAccess.test.ts               (CREATE)\n96\t    userImport.integration.test.ts      (CREATE)\n97\t    users.integration.test.ts           (CREATE)\n98\t    userLinks.integration.test.ts       (CREATE)\n99\t  e2e/\n100\t    user-management.spec.ts             (CREATE)\n101\t```\n102\t"}]},"parent_tool_use_id":null,"session_id":"58cb2461-07a2-4908-85eb-953f83a6620f","uuid":"3bb6aa03-4bbb-46bc-8407-9b1fee495585","timestamp":"2026-10-19T09:41:31.773Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/dev-planning/file-structure.md","content":"# File Structure — ticket abcd-03 (PRD-03 User Management)\n\nBrownfield additions only. Everything under `(existing)` already exists in\n`src/` from PRD-00/01/02 and is reused as-is (no new file) — listed here\nonly for orientation, not as a task output.\n\n```\nprisma/\n  schema.prisma                         (MODIFY — StudentProfile, TeacherProfile,\n                                          ParentProfile, ParentStudentLink, Gender,\n                                          GuardianRelationship, User relations,\n                                          composite index)\n\npublic/\n  templates/\n    students-template.csv               (CREATE)\n    teachers-template.csv                (CREATE)\n\nsrc/\n  lib/\n    validators/\n      users.ts                          (CREATE — shared Zod schemas)\n\n  server/\n    csv.ts                              (CREATE — escapeCsvCell/toCsv, medicalNotes strip)\n    auth/\n      requireRole.ts                    (existing — reused unchanged)\n      student-access.ts                 (CREATE — getAccessibleStudentIds/assertCanViewStudent)\n    services/\n      users.ts                          (CREATE — core user service + sendInvite stub)\n      userLinks.ts                      (CREATE — parent-student link invariants)\n      userImport.ts                     (CREATE — CSV import batch transaction)\n\n  components/\n    UserPicker/\n      UserPicker.tsx                    (CREATE)\n    DataTable/, ConfirmDialog/, UserAvatar/, EmptyState/,\n    FormField/, PageHeader/, Toast/      (existing — reused unchanged)\n\n  config/\n    navigation.ts                       (MODIFY — Users/Import users/Audit log/My children)\n    student-tabs.ts                     (MODIFY — register Overview tab)\n\n  app/\n    api/\n      users/\n        route.ts                        (CREATE — GET list, POST create)\n        [id]/\n          route.ts                      (CREATE — GET detail, PATCH update)\n          invite/route.ts               (CREATE)\n          unlock/route.ts               (CREATE)\n          status/route.ts               (CREATE)\n          archive/route.ts              (CREATE)\n          restore/route.ts              (CREATE)\n        import/route.ts                 (CREATE)\n        export/route.ts                 (CREATE)\n        search/route.ts                 (CREATE)\n      students/\n        [id]/\n          route.ts                      (CREATE — GET student detail)\n          parents/\n            route.ts                    (CREATE — POST link)\n            [parentId]/route.ts         (CREATE — DELETE unlink)\n      me/\n        children/route.ts               (CREATE)\n        profile/route.ts                (CREATE)\n      audit-logs/\n        route.ts                        (CREATE)\n\n    (app)/\n      shell.tsx                         (MODIFY — wire Profile menu item)\n      admin/\n        users/\n          page.tsx                      (CREATE — list, filters, row/bulk actions)\n          new/page.tsx                  (CREATE)\n          [id]/\n            page.tsx                    (CREATE — detail)\n            edit/page.tsx               (CREATE)\n          UserFormStepper.tsx           (CREATE — shared create/edit stepper)\n          import/page.tsx               (CREATE)\n        audit-log/\n          page.tsx                      (CREATE)\n      students/\n        [studentId]/page.tsx            (CREATE)\n      my-children/\n        page.tsx                        (CREATE)\n      account/\n        profile/page.tsx                (CREATE)\n\ntests/\n  unit/\n    userValidators.test.ts              (CREATE)\n    userNumberGenerators.test.ts        (CREATE)\n    csv.test.ts                         (CREATE)\n    studentAccess.test.ts               (CREATE)\n    userImport.integration.test.ts      (CREATE)\n    users.integration.test.ts           (CREATE)\n    userLinks.integration.test.ts       (CREATE)\n  e2e/\n    user-management.spec.ts             (CREATE)\n```\n","numLines":102,"startLine":1,"totalLines":102}}}
