{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgsPW3qpEZyPqhXRxxrT7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018FZpRuCZLkB8S4gSQ9CAWt","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/components/gradebook/StudentGradesView.tsx","content":"'use client';\n\nimport { useState } from 'react';\nimport Accordion from '@mui/material/Accordion';\nimport AccordionDetails from '@mui/material/AccordionDetails';\nimport AccordionSummary from '@mui/material/AccordionSummary';\nimport Card from '@mui/material/Card';\nimport CardContent from '@mui/material/CardContent';\nimport Chip from '@mui/material/Chip';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport TextField from '@mui/material/TextField';\nimport Typography from '@mui/material/Typography';\nimport ExpandMoreIcon from '@mui/icons-material/ExpandMore';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { useToast } from '@/components/Toast/useToast';\nimport type { StudentGrades } from '@/server/gradebook/student-grades-service';\n\nconst pts = (v: string) => String(Number(v));\n\n/**\n * PRD-11 student/parent grade view (FR-26–FR-28). Renders only what GET /api/students/:id/grades\n * returns (visible items, released scores). One card per course; expand for items and subtotals.\n */\nexport function StudentGradesView({ initial, courseId }: { initial: StudentGrades; courseId?: string }) {\n  const { showToast } = useToast();\n  const [data, setData] = useState(initial);\n\n  const changeTerm = async (termId: string) => {\n    const q = new URLSearchParams({ termId, ...(courseId ? { courseId } : {}) });\n    const res = await fetch(`/api/students/${data.student.id}/grades?${q}`);\n    const json = await res.json().catch(() => ({}));\n    if (!res.ok) return showToast({ message: json?.error?.message ?? 'Could not load grades.', severity: 'error' });\n    setData(json.data);\n  };\n\n  if (!data.term) return <EmptyState title=\"No terms yet\" description=\"Grades appear once the school year has terms.\" />;\n\n  return (\n    <Stack spacing={2}>\n      {data.terms.length > 1 && (\n        <TextField select size=\"small\" label=\"Term\" value={data.term.id} onChange={(e) => void changeTerm(e.target.value)} sx={{ maxWidth: 240 }}>\n          {data.terms.map((t) => (\n            <MenuItem key={t.id} value={t.id}>\n              {t.name}\n              {t.isCurrent ? ' (current)' : ''}\n            </MenuItem>\n          ))}\n        </TextField>\n      )}\n      {data.courses.length === 0 && <EmptyState title=\"No courses\" description=\"There are no grades for this term.\" />}\n      {data.courses.map((c) => (\n        <Card key={c.course.id} variant=\"outlined\" data-testid={`grades-course-${c.course.code}`}>\n          <CardContent sx={{ pb: 1 }}>\n            <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'center' }}>\n              <Stack sx={{ flex: 1, minWidth: 0 }}>\n                <Typography variant=\"h6\" component=\"h2\" noWrap>\n                  {c.course.name}\n                </Typography>\n                <Typography variant=\"body2\" color=\"text.secondary\">\n                  {c.course.code}\n                  {c.course.teacherName ? ` · ${c.course.teacherName}` : ''}\n                </Typography>\n              </Stack>\n              <Chip\n                color={c.colour ?? 'default'}\n                label={c.percent === null ? 'No grade yet' : `${c.percent}% ${c.letter ?? ''}`.trim()}\n                sx={{ fontWeight: 700 }}\n                aria-label={c.percent === null ? 'No grade yet' : `Term grade ${c.percent} percent, ${c.letter ?? 'no letter'}`}\n              />\n            </Stack>\n            {c.descriptor && (\n              <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n                {c.descriptor}\n              </Typography>\n            )}\n          </CardContent>\n          <Accordion disableGutters elevation={0} sx={{ '&:before': { display: 'none' } }}>\n            <AccordionSummary expandIcon={<ExpandMoreIcon />}>\n              <Typography variant=\"body2\">\n                {c.items.length} item{c.items.length === 1 ? '' : 's'}\n              </Typography>\n            </AccordionSummary>\n            <AccordionDetails sx={{ overflowX: 'auto' }}>\n              {c.categories.length > 0 && (\n                <Stack direction=\"row\" spacing={1} sx={{ mb: 2, flexWrap: 'wrap' }} useFlexGap>\n                  {c.categories.map((cat) => (\n                    <Chip\n                      key={cat.id ?? 'none'}\n                      variant=\"outlined\"\n                      size=\"small\"\n                      label={`${cat.name}${Number(cat.weightPercent) ? ` (${pts(cat.weightPercent)}%)` : ''}: ${cat.percent === null ? '—' : `${cat.percent}%`}`}\n                    />\n                  ))}\n                </Stack>\n              )}\n              <Table size=\"small\" aria-label={`${c.course.name} grades`}>\n                <TableHead>\n                  <TableRow>\n                    <TableCell>Item</TableCell>\n                    <TableCell>Category</TableCell>\n                    <TableCell align=\"right\">Score</TableCell>\n                    <TableCell align=\"right\">%</TableCell>\n                    <TableCell>Comment</TableCell>\n                  </TableRow>\n                </TableHead>\n                <TableBody>\n                  {c.items.map((i) => (\n                    <TableRow key={i.id}>\n                      <TableCell>\n                        <Stack direction=\"row\" spacing={1} sx={{ alignItems: 'center' }}>\n                          <span>{i.title}</span>\n                          {i.missing && !i.excused && i.score === null && <Chip size=\"small\" color=\"error\" label=\"Missing\" />}\n                          {i.excused && <Chip size=\"small\" label=\"Excused\" />}\n                          {i.dropped && <Chip size=\"small\" variant=\"outlined\" label=\"Dropped\" />}\n                        </Stack>\n                      </TableCell>\n                      <TableCell>{i.categoryName}</TableCell>\n                      <TableCell align=\"right\">{i.excused ? 'EX' : `${i.score === null ? '—' : pts(i.score)} / ${pts(i.maxPoints)}`}</TableCell>\n                      <TableCell align=\"right\">{i.percent ?? '—'}</TableCell>\n                      <TableCell>{i.comment ?? ''}</TableCell>\n                    </TableRow>\n                  ))}\n                </TableBody>\n              </Table>\n            </AccordionDetails>\n          </Accordion>\n        </Card>\n      ))}\n    </Stack>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":50,"cache_read_input_tokens":358808,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":50},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c6f85ae0-4ad4-4d10-b797-6ff9d3e2b1f5","uuid":"d4826b07-f52c-42f0-8291-4bcbf9d37af2","timestamp":"2026-11-09T12:55:04.845Z","request_id":"req_011CgsPW32wjGt32fzJ9kswk","wire_tool_inputs":{"toolu_018FZpRuCZLkB8S4gSQ9CAWt":{"file_path":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/components/gradebook/StudentGradesView.tsx","content":"'use client';\n\nimport { useState } from 'react';\nimport Accordion from '@mui/material/Accordion';\nimport AccordionDetails from '@mui/material/AccordionDetails';\nimport AccordionSummary from '@mui/material/AccordionSummary';\nimport Card from '@mui/material/Card';\nimport CardContent from '@mui/material/CardContent';\nimport Chip from '@mui/material/Chip';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport TextField from '@mui/material/TextField';\nimport Typography from '@mui/material/Typography';\nimport ExpandMoreIcon from '@mui/icons-material/ExpandMore';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { useToast } from '@/components/Toast/useToast';\nimport type { StudentGrades } from '@/server/gradebook/student-grades-service';\n\nconst pts = (v: string) => String(Number(v));\n\n/**\n * PRD-11 student/parent grade view (FR-26–FR-28). Renders only what GET /api/students/:id/grades\n * returns (visible items, released scores). One card per course; expand for items and subtotals.\n */\nexport function StudentGradesView({ initial, courseId }: { initial: StudentGrades; courseId?: string }) {\n  const { showToast } = useToast();\n  const [data, setData] = useState(initial);\n\n  const changeTerm = async (termId: string) => {\n    const q = new URLSearchParams({ termId, ...(courseId ? { courseId } : {}) });\n    const res = await fetch(`/api/students/${data.student.id}/grades?${q}`);\n    const json = await res.json().catch(() => ({}));\n    if (!res.ok) return showToast({ message: json?.error?.message ?? 'Could not load grades.', severity: 'error' });\n    setData(json.data);\n  };\n\n  if (!data.term) return <EmptyState title=\"No terms yet\" description=\"Grades appear once the school year has terms.\" />;\n\n  return (\n    <Stack spacing={2}>\n      {data.terms.length > 1 && (\n        <TextField select size=\"small\" label=\"Term\" value={data.term.id} onChange={(e) => void changeTerm(e.target.value)} sx={{ maxWidth: 240 }}>\n          {data.terms.map((t) => (\n            <MenuItem key={t.id} value={t.id}>\n              {t.name}\n              {t.isCurrent ? ' (current)' : ''}\n            </MenuItem>\n          ))}\n        </TextField>\n      )}\n      {data.courses.length === 0 && <EmptyState title=\"No courses\" description=\"There are no grades for this term.\" />}\n      {data.courses.map((c) => (\n        <Card key={c.course.id} variant=\"outlined\" data-testid={`grades-course-${c.course.code}`}>\n          <CardContent sx={{ pb: 1 }}>\n            <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'center' }}>\n              <Stack sx={{ flex: 1, minWidth: 0 }}>\n                <Typography variant=\"h6\" component=\"h2\" noWrap>\n                  {c.course.name}\n                </Typography>\n                <Typography variant=\"body2\" color=\"text.secondary\">\n                  {c.course.code}\n                  {c.course.teacherName ? ` · ${c.course.teacherName}` : ''}\n                </Typography>\n              </Stack>\n              <Chip\n                color={c.colour ?? 'default'}\n                label={c.percent === null ? 'No grade yet' : `${c.percent}% ${c.letter ?? ''}`.trim()}\n                sx={{ fontWeight: 700 }}\n                aria-label={c.percent === null ? 'No grade yet' : `Term grade ${c.percent} percent, ${c.letter ?? 'no letter'}`}\n              />\n            </Stack>\n            {c.descriptor && (\n              <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n                {c.descriptor}\n              </Typography>\n            )}\n          </CardContent>\n          <Accordion disableGutters elevation={0} sx={{ '&:before': { display: 'none' } }}>\n            <AccordionSummary expandIcon={<ExpandMoreIcon />}>\n              <Typography variant=\"body2\">\n                {c.items.length} item{c.items.length === 1 ? '' : 's'}\n              </Typography>\n            </AccordionSummary>\n            <AccordionDetails sx={{ overflowX: 'auto' }}>\n              {c.categories.length > 0 && (\n                <Stack direction=\"row\" spacing={1} sx={{ mb: 2, flexWrap: 'wrap' }} useFlexGap>\n                  {c.categories.map((cat) => (\n                    <Chip\n                      key={cat.id ?? 'none'}\n                      variant=\"outlined\"\n                      size=\"small\"\n                      label={`${cat.name}${Number(cat.weightPercent) ? ` (${pts(cat.weightPercent)}%)` : ''}: ${cat.percent === null ? '—' : `${cat.percent}%`}`}\n                    />\n                  ))}\n                </Stack>\n              )}\n              <Table size=\"small\" aria-label={`${c.course.name} grades`}>\n                <TableHead>\n                  <TableRow>\n                    <TableCell>Item</TableCell>\n                    <TableCell>Category</TableCell>\n                    <TableCell align=\"right\">Score</TableCell>\n                    <TableCell align=\"right\">%</TableCell>\n                    <TableCell>Comment</TableCell>\n                  </TableRow>\n                </TableHead>\n                <TableBody>\n                  {c.items.map((i) => (\n                    <TableRow key={i.id}>\n                      <TableCell>\n                        <Stack direction=\"row\" spacing={1} sx={{ alignItems: 'center' }}>\n                          <span>{i.title}</span>\n                          {i.missing && !i.excused && i.score === null && <Chip size=\"small\" color=\"error\" label=\"Missing\" />}\n                          {i.excused && <Chip size=\"small\" label=\"Excused\" />}\n                          {i.dropped && <Chip size=\"small\" variant=\"outlined\" label=\"Dropped\" />}\n                        </Stack>\n                      </TableCell>\n                      <TableCell>{i.categoryName}</TableCell>\n                      <TableCell align=\"right\">{i.excused ? 'EX' : `${i.score === null ? '—' : pts(i.score)} / ${pts(i.maxPoints)}`}</TableCell>\n                      <TableCell align=\"right\">{i.percent ?? '—'}</TableCell>\n                      <TableCell>{i.comment ?? ''}</TableCell>\n                    </TableRow>\n                  ))}\n                </TableBody>\n              </Table>\n            </AccordionDetails>\n          </Accordion>\n        </Card>\n      ))}\n    </Stack>\n  );\n}\n"}}}
