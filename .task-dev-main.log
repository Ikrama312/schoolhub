d environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\nexport const env = loadEnv();\nexport type Env = z.infer<typeof envSchema>;\n=== src/lib/logger.ts\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};\n    1000 src/server/auth/common-passwords.txt\n1000\npassword123\npassword1234\nqwerty123456\n167:model AuditLog {\n168-  id         String   @id @default(cuid())\n169-  actorId    String?\n170-  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n171-  action     String\n172-  entityType String?\n173-  entityId   String?\n174-  metadata   Json?\n175-  ip         String?\n176-  createdAt  DateTime @default(now())\n177-\n178-  @@index([actorId])\n179-  @@index([action])\n","numLines":861,"startLine":1,"totalLines":861}},"tool_result_meta":[{"id":"toolu_016Q5BjxL7EXmNUd3rhWrWP5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
