{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015S4MWKwaiGUsVLnmfNGudb","type":"tool_result","content":"import { formatInSchoolTz } from '@/lib/dates';\n\n/**\n * PRD-07 pure rules (FR-8, FR-19, FR-22, FR-26, FR-28). No DB imports, so\n * unit tests and the client (DatePicker limits) can use it directly.\n * Dates are 'yyyy-MM-dd' strings in the school timezone (ADR-5).\n */\n\nexport type Status = 'PRESENT' | 'ABSENT' | 'LATE' | 'EXCUSED';\nexport type RuleRole = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport const TEACHER_WINDOW_DAYS = 14;\nexport const WINDOW_REASON = `Teachers can edit registers up to ${TEACHER_WINDOW_DAYS} days after the register date`;\n\nexport interface Rec {\n  studentId: string;\n  status: Status;\n  minutesLate?: number | null;\n  note?: string | null;\n}\n\nexport function schoolToday(now: Date, tz: string): string {\n  return formatInSchoolTz(now, 'yyyy-MM-dd', tz);\n}\n\n/** Whole days from `from` to `to` (both yyyy-MM-dd). */\nexport function daysBetween(from: string, to: string): number {\n  return Math.round((Date.parse(`${to}T00:00:00Z`) - Date.parse(`${from}T00:00:00Z`)) / 86_400_000);\n}\n\n/** yyyy-MM-dd shifted by n days. */\nexport function addDays(date: string, n: number): string {\n  return new Date(Date.parse(`${date}T00:00:00Z`) + n * 86_400_000).toISOString().slice(0, 10);\n}\n\nexport type OpenResult = { ok: true } | { ok: false; code: 'FUTURE' | 'WINDOW'; reason: string };\n\n/** FR-8: never the future; ADMIN any past date; TEACHER only the last 14 days. */\nexport function canOpen(role: RuleRole, date: string, today: string): OpenResult {\n  if (date > today) return { ok: false, code: 'FUTURE', reason: 'Registers cannot be taken for future dates' };\n}\n\nexport interface StatusCounts {\n  records: number;\n  present: number;\n  absent: number;\n  late: number;\n  excused: number;\n  rate: number | null;\n}\n\n/** FR-28: (P+L+E)/total×100, 1 dp; null with no records. */\nexport function attendanceRate(c: { present: number; absent: number; late: number; excused: number }): number | null {\n  const total = c.present + c.absent + c.late + c.excused;\n  if (total === 0) return null;\n  return Math.round(((c.present + c.late + c.excused) / total) * 1000) / 10;\n}\n\nexport function countStatuses(statuses: Iterable<Status>): StatusCounts {\n  const c = { present: 0, absent: 0, late: 0, excused: 0 };\n  for (const s of statuses) c[s.toLowerCase() as keyof typeof c] += 1;\n  const records = c.present + c.absent + c.late + c.excused;\n  return { records, ...c, rate: attendanceRate(c) };\n}\n\nexport type DayColour = 'success' | 'warning' | 'error' | 'default';\n\n/** FR-26: red if any absence, amber if any late, green otherwise; grey with no data. */\nexport function dayColour(statuses: Status[]): DayColour {\n  if (statuses.length === 0) return 'default';\n  if (statuses.includes('ABSENT')) return 'error';\n  if (statuses.includes('LATE')) return 'warning';\n  return 'success';\n}\n    title: `Register not taken: ${course.name}`,\n    body: `${period.name}, ${longDate(input.date)}`,\n    link: `/attendance/take/${course.id}?date=${input.date}&periodId=${input.periodId}`,\n  });\n  await audit({ actorId: admin.id, action: 'attendance.remind', entityType: 'Course', entityId: course.id, metadata: { ...input, teacherId: course.teacher.id }, request });\n  return { reminded: userRef(course.teacher)! };\n}\n\nexport interface StudentSummaryRow extends StatusCounts {\n  studentId: string;\n  studentName: string;\n  sectionName: string | null;\n  gradeLevelName: string | null;\n}\n\n/** groupBy (studentId, status) → per-student rows with names, sorted by last name. */\nasync function aggregate(where: Prisma.AttendanceRecordWhereInput, mustHave?: Status): Promise<StudentSummaryRow[]> {\n  const groups = await prisma.attendanceRecord.groupBy({ by: ['studentId', 'status'], where, _count: { _all: true } });\n  const byStudent = new Map<string, typeof groups>();\n  for (const g of groups) byStudent.set(g.studentId, [...(byStudent.get(g.studentId) ?? []), g]);\n  const ids = [...byStudent.keys()].filter((id) => !mustHave || byStudent.get(id)!.some((g) => g.status === mustHave));\n  if (!ids.length) return [];\n\n  const students = await prisma.user.findMany({\n    where: { id: { in: ids } },\n    select: {\n      id: true,\n      firstName: true,\n      lastName: true,\n      studentProfile: { select: { gradeLevel: { select: { name: true } } } },\n      sectionMemberships: { where: { section: { academicYear: { isCurrent: true } } }, select: { section: { select: { name: true } } } },\n    },\n    orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }],\n  });\n  return students.map((s) => ({\n    studentId: s.id,\n    studentName: fullName(s),\n    sectionName: s.sectionMemberships[0]?.section.name ?? null,\n    gradeLevelName: s.studentProfile?.gradeLevel.name ?? null,\n    ...foldCounts(byStudent.get(s.id)!),\n  }));\n}\n\n// ponytail: rows are paginated in memory after the groupBy -- bounded by the student count;\n// move to SQL window pagination if the school grows past a few thousand students.\nexport async function getReport(filters: ReportFilters): Promise<StudentSummaryRow[]> {\n  const { mode } = await loadSettings();\n  const student: Prisma.UserWhereInput = {\n    ...(filters.gradeLevelId ? { studentProfile: { gradeLevelId: filters.gradeLevelId } } : {}),\n    ...(filters.sectionId ? { sectionMemberships: { some: { sectionId: filters.sectionId } } } : {}),\n  };\n  return aggregate(\n    {\n      session: {\n        date: { gte: toDbDate(filters.from), lte: toDbDate(filters.to) },\n        ...(filters.courseId ? { courseId: filters.courseId } : kindWhere(mode)),\n      },\n      student,\n    },\n    filters.status,\n  );\n}\n\nexport async function getBelowThreshold() {\n  const { tz, mode, threshold } = await loadSettings();\n  const today = schoolToday(new Date(), tz);\n  const year = await currentYearWithTerm(today);\