{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgrq5U9NwCUT721mP6rkv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ni839u6Nm2fXUdYWfVzETt","name":"Bash","input":{"command":"B=\"src/app/(app)/courses/[courseId]/assignments\" && cat > \"$B/CourseAssignmentsTable.tsx\" <<'EOF'\n'use client';\n\nimport NextLink from 'next/link';\nimport { useSearchParams } from 'next/navigation';\nimport type { GridColDef } from '@mui/x-data-grid';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Link from '@mui/material/Link';\nimport Stack from '@mui/material/Stack';\nimport { DataTable } from '@/components/DataTable/DataTable';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport type { listCourseAssignments } from '@/server/assignments/assignments-service';\n\ntype ManagerItem = Extract<Awaited<ReturnType<typeof listCourseAssignments>>, { view: 'manager' }>['items'][number];\n\nconst STATUS_COLOR = { DRAFT: 'default', SCHEDULED: 'info', PUBLISHED: 'success' } as const;\n\n/** FR-17: manager table on the shared DataTable (MUI X DataGrid, override verified per ADR-2). */\nexport function CourseAssignmentsTable({ courseId, items, timezone }: { courseId: string; items: ManagerItem[]; timezone: string }) {\n  const searchParams = useSearchParams();\n  const q = (searchParams.get('q') ?? '').toLowerCase();\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const matching = items.filter((a) => a.title.toLowerCase().includes(q));\n  // ponytail: one course's assignments are loaded at once and paged here; move paging server-side if a course ever has hundreds.\n  const rows = matching.slice((page - 1) * pageSize, page * pageSize);\n\n  const columns: GridColDef<ManagerItem>[] = [\n    {\n      field: 'title',\n      headerName: 'Title',\n      flex: 2,\n      minWidth: 200,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Link component={NextLink} href={`/courses/${courseId}/assignments/${row.id}`}>\n          {row.title}\n        </Link>\n      ),\n    },\n    { field: 'dueAt', headerName: 'Due', flex: 1, minWidth: 150, sortable: false, valueFormatter: (v: string) => formatInSchoolTz(v, 'EEE d MMM, HH:mm', timezone) },\n    {\n      field: 'status',\n      headerName: 'Status',\n      flex: 1,\n      minWidth: 170,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Stack direction=\"row\" spacing={0.5} sx={{ alignItems: 'center', height: '100%' }}>\n          <Chip size=\"small\" label={row.status.charAt(0) + row.status.slice(1).toLowerCase()} color={STATUS_COLOR[row.status]} />\n          {row.archivedAt && <Chip size=\"small\" variant=\"outlined\" label=\"Archived\" />}\n        </Stack>\n      ),\n    },\n    {\n      field: 'submitted',\n      headerName: 'Submitted',\n      minWidth: 110,\n      sortable: false,\n      valueGetter: (_v, row) => (row.submissionType === 'NO_SUBMISSION' ? '—' : `${row.counts.submitted}/${row.counts.enrolled}`),\n    },\n    { field: 'graded', headerName: 'Graded', minWidth: 100, sortable: false, valueGetter: (_v, row) => `${row.counts.graded}/${row.submissionType === 'NO_SUBMISSION' ? row.counts.enrolled : row.counts.submitted}` },\n    {\n      field: 'actions',\n      headerName: '',\n      minWidth: 110,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Button size=\"small\" variant=\"outlined\" component={NextLink} href={`/courses/${courseId}/assignments/${row.id}/grade`}>\n          Grade\n        </Button>\n      ),\n    },\n  ];\n\n  return <DataTable columns={columns as GridColDef[]} rows={rows} total={matching.length} />;\n}\nEOF\ncat > \"$B/page.tsx\" <<'EOF'\nimport NextLink from 'next/link';\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport AddIcon from '@mui/icons-material/Add';\nimport { requirePageUser } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolTimezone, listCourseAssignments } from '@/server/assignments/assignments-service';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { AssignmentList } from '../../../assignments/AssignmentList';\nimport { CourseAssignmentsTable } from './CourseAssignmentsTable';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course \"Assignments\" tab (FR-16..FR-18). Role-shaped by the service; course access in the layout and service. */\nexport default async function CourseAssignmentsPage({ params, searchParams }: { params: { courseId: string }; searchParams: { studentId?: string } }) {\n  const user = await requirePageUser();\n  let data: Awaited<ReturnType<typeof listCourseAssignments>>;\n  try {\n    data = await listCourseAssignments(user, params.courseId, searchParams.studentId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const timezone = await getSchoolTimezone();\n\n  if (data.view === 'manager') {\n    return (\n      <Box>\n        <PageHeader\n          title=\"Assignments\"\n          actions={\n            <Button variant=\"contained\" startIcon={<AddIcon />} component={NextLink} href={`/courses/${params.courseId}/assignments/new`}>\n              New assignment\n            </Button>\n          }\n        />\n        <CourseAssignmentsTable courseId={params.courseId} items={data.items} timezone={timezone} />\n      </Box>\n    );\n  }\n  return (\n    <Box>\n      <PageHeader title=\"Assignments\" />\n      <AssignmentList variant=\"grouped\" rows={data.items} timezone={timezone} childOptions={data.children} studentId={data.studentId} />\n    </Box>\n  );\n}\nEOF\nnpx tsc --noEmit 2>&1 | head","description":"Write course assignments page and table","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3059,"cache_read_input_tokens":234321,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3059},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"80a968fd-48d7-4da9-a01e-aaa2035d3ca9","uuid":"870d74ca-2bf3-4373-86f3-1b98828062ca","timestamp":"2026-11-09T05:49:49.168Z","request_id":"req_011Cgrq5Tr1uAPRzTdrwJ1Sn","wire_tool_inputs":{"toolu_01Ni839u6Nm2fXUdYWfVzETt":{"command":"cd /Users/ikramaansari/Documents/forge/schoolhub && B=\"src/app/(app)/courses/[courseId]/assignments\" && cat > \"$B/CourseAssignmentsTable.tsx\" <<'EOF'\n'use client';\n\nimport NextLink from 'next/link';\nimport { useSearchParams } from 'next/navigation';\nimport type { GridColDef } from '@mui/x-data-grid';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Link from '@mui/material/Link';\nimport Stack from '@mui/material/Stack';\nimport { DataTable } from '@/components/DataTable/DataTable';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport type { listCourseAssignments } from '@/server/assignments/assignments-service';\n\ntype ManagerItem = Extract<Awaited<ReturnType<typeof listCourseAssignments>>, { view: 'manager' }>['items'][number];\n\nconst STATUS_COLOR = { DRAFT: 'default', SCHEDULED: 'info', PUBLISHED: 'success' } as const;\n\n/** FR-17: manager table on the shared DataTable (MUI X DataGrid, override verified per ADR-2). */\nexport function CourseAssignmentsTable({ courseId, items, timezone }: { courseId: string; items: ManagerItem[]; timezone: string }) {\n  const searchParams = useSearchParams();\n  const q = (searchParams.get('q') ?? '').toLowerCase();\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const matching = items.filter((a) => a.title.toLowerCase().includes(q));\n  // ponytail: one course's assignments are loaded at once and paged here; move paging server-side if a course ever has hundreds.\n  const rows = matching.slice((page - 1) * pageSize, page * pageSize);\n\n  const columns: GridColDef<ManagerItem>[] = [\n    {\n      field: 'title',\n      headerName: 'Title',\n      flex: 2,\n      minWidth: 200,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Link component={NextLink} href={`/courses/${courseId}/assignments/${row.id}`}>\n          {row.title}\n        </Link>\n      ),\n    },\n    { field: 'dueAt', headerName: 'Due', flex: 1, minWidth: 150, sortable: false, valueFormatter: (v: string) => formatInSchoolTz(v, 'EEE d MMM, HH:mm', timezone) },\n    {\n      field: 'status',\n      headerName: 'Status',\n      flex: 1,\n      minWidth: 170,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Stack direction=\"row\" spacing={0.5} sx={{ alignItems: 'center', height: '100%' }}>\n          <Chip size=\"small\" label={row.status.charAt(0) + row.status.slice(1).toLowerCase()} color={STATUS_COLOR[row.status]} />\n          {row.archivedAt && <Chip size=\"small\" variant=\"outlined\" label=\"Archived\" />}\n        </Stack>\n      ),\n    },\n    {\n      field: 'submitted',\n      headerName: 'Submitted',\n      minWidth: 110,\n      sortable: false,\n      valueGetter: (_v, row) => (row.submissionType === 'NO_SUBMISSION' ? '—' : `${row.counts.submitted}/${row.counts.enrolled}`),\n    },\n    { field: 'graded', headerName: 'Graded', minWidth: 100, sortable: false, valueGetter: (_v, row) => `${row.counts.graded}/${row.submissionType === 'NO_SUBMISSION' ? row.counts.enrolled : row.counts.submitted}` },\n    {\n      field: 'actions',\n      headerName: '',\n      minWidth: 110,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Button size=\"small\" variant=\"outlined\" component={NextLink} href={`/courses/${courseId}/assignments/${row.id}/grade`}>\n          Grade\n        </Button>\n      ),\n    },\n  ];\n\n  return <DataTable columns={columns as GridColDef[]} rows={rows} total={matching.length} />;\n}\nEOF\ncat > \"$B/page.tsx\" <<'EOF'\nimport NextLink from 'next/link';\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport AddIcon from '@mui/icons-material/Add';\nimport { requirePageUser } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolTimezone, listCourseAssignments } from '@/server/assignments/assignments-service';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { AssignmentList } from '../../../assignments/AssignmentList';\nimport { CourseAssignmentsTable } from './CourseAssignmentsTable';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course \"Assignments\" tab (FR-16..FR-18). Role-shaped by the service; course access in the layout and service. */\nexport default async function CourseAssignmentsPage({ params, searchParams }: { params: { courseId: string }; searchParams: { studentId?: string } }) {\n  const user = await requirePageUser();\n  let data: Awaited<ReturnType<typeof listCourseAssignments>>;\n  try {\n    data = await listCourseAssignments(user, params.courseId, searchParams.studentId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const timezone = await getSchoolTimezone();\n\n  if (data.view === 'manager') {\n    return (\n      <Box>\n        <PageHeader\n          title=\"Assignments\"\n          actions={\n            <Button variant=\"contained\" startIcon={<AddIcon />} component={NextLink} href={`/courses/${params.courseId}/assignments/new`}>\n              New assignment\n            </Button>\n          }\n        />\n        <CourseAssignmentsTable courseId={params.courseId} items={data.items} timezone={timezone} />\n      </Box>\n    );\n  }\n  return (\n    <Box>\n      <PageHeader title=\"Assignments\" />\n      <AssignmentList variant=\"grouped\" rows={data.items} timezone={timezone} childOptions={data.children} studentId={data.studentId} />\n    </Box>\n  );\n}\nEOF\nnpx tsc --noEmit 2>&1 | head","description":"Write course assignments page and table","timeout":300000}},"wire_ingest_context":{"toolu_01Ni839u6Nm2fXUdYWfVzETt":{"cwd":"/Users/ikramaansari/Documents/forge/schoolhub"}}}
