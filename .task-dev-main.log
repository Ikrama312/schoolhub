{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012bwL347u2fUp97LP3AqrAJ","type":"tool_result","content":"1\timport { prisma } from '@/server/db';\n2\timport { AppError } from '@/server/http';\n3\t\n4\texport interface SubjectInput {\n5\t  name: string;\n6\t  code: string;\n7\t  description?: string | null;\n8\t  color: string;\n9\t}\n10\t\n11\texport interface UpdateSubjectInput extends Partial<SubjectInput> {\n12\t  archived?: boolean;\n13\t}\n14\t\n15\t/** Codes are always stored upper-case so \"math\" and \"MATH\" collide. */\n16\texport function normalizeCode(code: string): string {\n17\t  return code.trim().toUpperCase();\n18\t}\n19\t\n20\tasync function assertCodeAvailable(code: string, excludeId?: string) {\n21\t  const existing = await prisma.subject.findUnique({ where: { code } });\n22\t  if (existing && existing.id !== excludeId) {\n23\t    throw new AppError('CONFLICT', `Code already used by ${existing.name}.`);\n24\t  }\n25\t}\n26\t\n27\texport async function listSubjects(q?: string) {\n28\t  return prisma.subject.findMany({\n29\t    where: q\n30\t      ? { OR: [{ name: { contains: q, mode: 'insensitive' } }, { code: { contains: normalizeCode(q) } }] }\n31\t      : undefined,\n32\t    orderBy: { name: 'asc' },\n33\t  });\n34\t}\n35\t\n36\texport async function createSubject(input: SubjectInput) {\n37\t  const code = normalizeCode(input.code);\n38\t  await assertCodeAvailable(code);\n39\t  return prisma.subject.create({ data: { ...input, code } });\n40\t}\n41\t\n42\texport async function updateSubject(id: string, input: UpdateSubjectInput) {\n43\t  const existing = await prisma.subject.findUniqueOrThrow({ where: { id } });\n44\t  const code = input.code ? normalizeCode(input.code) : existing.code;\n45\t  if (code !== existing.code) {\n46\t    await assertCodeAvailable(code, id);\n47\t  }\n48\t  return prisma.subject.update({\n49\t    where: { id },\n50\t    data: {\n51\t      name: input.name ?? existing.name,\n52\t      code,\n5