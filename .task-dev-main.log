erWidth}px` }\n            : {}),\n        }}\n      >\n        <Toolbar sx={{ gap: 1 }}>\n          {!isDesktop && (\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Open navigation\"\n              edge=\"start\"\n              onClick={() => setMobileOpen(true)}\n            >\n              <MenuIcon />\n            </IconButton>\n          )}\n          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n            {schoolShortName}\n          </Typography>\n\n          <Tooltip title=\"Notifications\">\n            <IconButton color=\"inherit\" aria-label=\"Notifications\">\n              <Badge badgeContent={0} color=\"error\">\n                <NotificationsNoneIcon />\n              </Badge>\n            </IconButton>\n          </Tooltip>\n\n          <Tooltip title={mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}>\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Toggle color mode\"\n              onClick={() => setMode(mode === 'dark' ? 'light' : 'dark')}\n            >\n              {mode === 'dark' ? <LightModeIcon /> : <DarkModeIcon />}\n            </IconButton>\n          </Tooltip>\n\n          <IconButton onClick={(event) => setMenuAnchor(event.currentTarget)} aria-label=\"User menu\">\n            <UserAvatar userId={PLACEHOLDER_USER.id} name={PLACEHOLDER_USER.name} size={32} />\n          </IconButton>\n          <Menu anchorEl={menuAnchor} open={Boolean(menuAnchor)} onClose={() => setMenuAnchor(null)}>\n            <Box sx={{ px: 2, py: 1 }}>\n              <Typography variant=\"subtitle2\">{PLACEHOLDER_USER.name}</Typography>\n              <Chip size=\"small\" label={PLACEHOLDER_USER.role} sx={{ mt: 0.5 }} />\n            </Box>\n            <Divider />\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <PersonOutlineIcon fontSize=\"small\" sx={{ mr: 1 }} /> Profile\n            </MenuItem>\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <LogoutIcon fontSize=\"small\" sx={{ mr: 1 }} /> Sign out\n            </MenuItem>\n          </Menu>\n        </Toolbar>\n      </AppBar>\n\n      {isDesktop ? (\n        <Drawer\n          variant=\"permanent\"\n          sx={{\n            width: drawerWidth,\n            flexShrink: 0,\n            [`& .MuiDrawer-paper`]: { width: drawerWidth, boxSizing: 'border-box', overflowX: 'hidden' },\n          }}\n        >\n          <Toolbar />\n          {navList}\n          <Box sx={{ mt: 'auto', display: 'flex', justifyContent: 'flex-end', p: 1 }}>\n            <IconButton onClick={toggleCollapsed} aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}>\n              {collapsed ? <ChevronRightIcon /> : <ChevronLeftIcon />}\n            </IconButton>\n          </Box>\n        </Drawer>\n      ) : (\n        <Drawer\n          variant=\"temporary\"\n          open={mobileOpen}\n          onClose={() => setMobileOpen(false)}\n          ModalProps={{ keepMounted: true }}\n          sx={{ [`& .MuiDrawer-paper`]: { width: DRAWER_WIDTH_EXPANDED, boxSizing: 'border-box' } }}\n        >\n          <Toolbar />\n          {navList}\n        </Drawer>\n      )}\n\n      <Box\n        component=\"main\"\n        sx={{\n          flexGrow: 1,\n          p: 3,\n          width: isDesktop ? `calc(100% - ${drawerWidth}px)` : '100%',\n        }}\n      >\n        <Toolbar />\n        {children}\n      </Box>\n    </Box>\n  );\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
