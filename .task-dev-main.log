e gradebook\n  availableFrom      DateTime\n  availableUntil     DateTime // > availableFrom\n  timeLimitMinutes   Int? // 1–300, null = untimed\n  maxAttempts        Int                 @default(1) // 1–10\n  scoringPolicy      ScoringPolicy       @default(HIGHEST)\n  shuffleQuestions   Boolean             @default(false)\n  shuffleOptions     Boolean             @default(false)\n  oneQuestionPerPage Boolean             @default(false)\n  resultsVisibility  ResultsVisibility   @default(AFTER_CLOSE)\n  showCorrectAnswers Boolean             @default(true) // when results are visible\n  resultsReleasedAt  DateTime? // MANUAL release; also the AFTER_CLOSE \"notified once\" claim (A6)\n  status             QuizStatus          @default(DRAFT)\n  createdById        String\n  createdBy          User                @relation(\"QuizCreatedBy\", fields: [createdById], references: [id])\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  questions          Question[]\n  attempts           QuizAttempt[]\n  accommodations     QuizAccommodation[]\n\n  @@index([courseId, status])\n}\n\nmodel Question {\n  id            String       @id @default(cuid())\n  quizId        String\n  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)\n  type          QuestionType\n  prompt        String // Markdown, may include an uploaded image\n  points        Decimal      @db.Decimal(5, 2) // 0.5–100\n  order         Int\n  options       Json? // choice types: [{ id, text }]\n  correct       Json // see FR-2\n  explanation   String? // shown with correct answers\n  caseSensitive Boolean      @default(false) // SHORT_ANSWER\n  answers       QuizAnswer[]\n\n  @@index([quizId, order])\n}\n\n/// Only one IN_PROGRESS attempt per (quizId, studentId): partial unique index\n/// \"quiz_attempt_one_in_progress_uq\" lives in migration 20261110000000_add_quizzes (FR-19, ADR-2).\n/// Prisma can't express it — never use `prisma db push`.\nmodel QuizAttempt {\n  id            String        @id @default(cuid())\n  quizId        String\n  quiz          Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)\n  studentId     String\n  student       User          @relation(fields: [studentId], references: [id])\n  attemptNumber Int\n  status        AttemptStatus @default(IN_PROGRESS)\n  startedAt     DateTime      @default(now())\n  deadlineAt    DateTime? // min(startedAt + limit + extraTime, availableUntil)\n  submittedAt   DateTime?\n  autoSubmitted Boolean       @default(false)\n  questionOrder String[] // frozen order for this attempt\n  score         Decimal?      @db.Decimal(7, 2)\n  maxScore      Decimal       @db.Decimal(7, 2)\n  answers       QuizAnswer[]\n\n  @@unique([quizId, studentId, attemptNumber])\n  @@index([quizId, status])\n  @@index([status, deadlineAt])\n}\n\nmodel QuizAnswer {\n  attemptId     String\n  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)\n  questionId    String\n  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)\n  response      Json?\n  pointsAwarded Decimal?    @db.Decimal(5, 2)\n  isCorrect     Boolean?\n  feedback      String?\n  gradedById    String?\n  gradedBy      User?       @relation(\"QuizAnswerGradedBy\", fields: [gradedById], references: [id])\n  updatedAt     DateTime    @updatedAt\n\n  @@id([attemptId, questionId])\n}\n\nmodel QuizAccommodation {\n  quizId           String\n  quiz             Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)\n  studentId        String\n  student          User   @relation(fields: [studentId], references: [id])\n  extraTimeMinutes Int    @default(0) // 0–300\n  extraAttempts    Int    @default(0) // 0–5\n\n  @@id([quizId, studentId])\n}\n'''\nopen(p,'w').write(s)\nEOF\nnpx prisma format >/dev/null && npx prisma migrate dev --create-only --name add_quizzes 2>&1 