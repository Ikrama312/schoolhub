{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011V3eZ7n3pyqM1Wf88265Jv","type":"tool_result","content":"1\tgenerator client {\n2\t  provider = \"prisma-client-js\"\n3\t}\n4\t\n5\tdatasource db {\n6\t  provider = \"postgresql\"\n7\t  url      = env(\"DATABASE_URL\")\n8\t}\n9\t\n10\tenum Role {\n11\t  ADMIN\n12\t  TEACHER\n13\t  STUDENT\n14\t  PARENT\n15\t}\n16\t\n17\tenum UserStatus {\n18\t  ACTIVE\n19\t  INVITED\n20\t  DISABLED\n21\t  ARCHIVED\n22\t}\n23\t\n24\tenum AuthTokenType {\n25\t  INVITE\n26\t  PASSWORD_RESET\n27\t}\n28\t\n29\tenum Gender {\n30\t  FEMALE\n31\t  MALE\n32\t  OTHER\n33\t  UNDISCLOSED\n34\t}\n35\t\n36\tenum GuardianRelationship {\n37\t  MOTHER\n38\t  FATHER\n39\t  GUARDIAN\n40\t  GRANDPARENT\n41\t  OTHER\n42\t}\n43\t\n44\t/// Every authenticated person. passwordHash is nullable because an INVITED\n45\t/// user has no password until they accept their invite (TASK-8's\n46\t/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n47\t/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n48\t/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n49\t/// field shared by every role, archivedAt backs FR-13's archive/restore\n50\t/// (separate from status so a DISABLED-but-not-archived user stays distinct\n51\t/// from an archived one).\n52\tmodel User {\n53\t  id                String      @id @default(cuid())\n54\t  email             String      @unique\n55\t  passwordHash      String?\n56\t  firstName         String\n57\t  lastName          String\n58\t  phone             String?\n59\t  role              Role\n60\t  status            UserStatus  @default(INVITED)\n61\t  failedLoginCount  Int         @default(0)\n62\t  lockedUntil       DateTime?\n63\t  lastLoginAt       DateTime?\n64\t  passwordChangedAt DateTime?\n65\t  archivedAt        DateTime?\n66\t  createdAt         DateTime    @default(now())\n67\t  updatedAt         DateTime    @updatedAt\n68\t  authTokens        AuthToken[]\n69\t  auditLogs         AuditLog[]\n70\t  studentProfile    StudentProfile?\n71\t  teacherProfile    TeacherProfile?\n72\t  parentProfile     ParentProfile?\n73\t  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")\n74\t  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")\n75\t\n76\t  @@index([lastName, firstName, email])\n77\t}\n78\t\n79\t/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n80\t/// only -- enforced in the service layer (src/server/services/users.ts,\n81\t/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\n82\tmodel StudentProfile {\n83\t  userId           String     @id\n84\t  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n85\t  admissionNumber  String     @unique\n86\t  dateOfBirth      DateTime   @db.Date\n87\t  gender           Gender     @default(UNDISCLOSED)\n88\t  gradeLevelId     String\n89\t  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n90\t  enrollmentDate   DateTime   @db.Date\n91\t  addressLine1     String?\n92\t  city             String?\n93\t  medicalNotes     String?\n94\t  emergencyContact String?\n95\t  emergencyPhone   String?\n96\t}\n97\t\n98\t/// Teacher-specific fields (FR-1).\n99\tmodel TeacherProfile {\n100\t  userId         String    @id\n101\t  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n102\t  employeeNumber String    @unique\n103\t  title          String?\n104\t  qualifications String?\n105\t  hireDate       DateTime? @db.Date\n106\t}\n107\t\n108\t/// Parent-specific fields (FR-1).\n109\tmodel ParentProfile {\n110\t  userId     String  @id\n111\t  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n112\t  occupation String?\n113\t  address    String?\n114\t}\n115\t\n116\t/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n117\t/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n118\t/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n119\t/// transaction invariants rather than DB constraints.\n120\tmodel ParentStudentLink {\n121\t  id           String               @id @default(cuid())\n122\t  parentId     String\n123\t  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n124\t  studentId    String\n125\t  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n126\t  relationship GuardianRelationship\n127\t  isPrimary    Boolean              @default(false)\n128\t  createdAt    DateTime             @default(now())\n129\t\n130\t  @@unique([parentId, studentId])\n131\t  @@index([studentId])\n132\t}\n133\t\n134\t/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n135\t/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n136\t/// user. One shared shape for both token types; src/server/auth/tokens.ts\n137\t/// is the single producer/consumer.\n138\tmodel AuthToken {\n139\t  id        String        @id @default(cuid())\n140\t  userId    String\n141\t  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n142\t  type      AuthTokenType\n143\t  tokenHash String        @unique\n144\t  expiresAt DateTime\n145\t  usedAt    DateTime?\n146\t  createdAt DateTime      @default(now())\n147\t\n148\t  @@index([userId, type])\n149\t}\n150\t\n151\t/// Insert-only audit trail written exclusively through src/server/audit.ts's\n152\t/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n153\t/// non-existent email can still be recorded.\n154\tmodel AuditLog {\n155\t  id         String   @id @default(cuid())\n156\t  actorId    String?\n157\t  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n158\t  action     String\n159\t  entityType String?\n160\t  entityId   String?\n161\t  metadata   Json?\n162\t  ip         String?\n163\t  createdAt  DateTime @default(now())\n164\t\n165\t  @@index([actorId])\n166\t  @@index([action])\n167\t}\n168\t\n169\t/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n170\t/// info. Later PRDs read this for top-bar branding and public footer; no\n171\t/// other PRD should add a second row or a second settings model.\n172\tmodel SchoolSettings {\n173\t  id           String   @id @default(\"singleton\")\n174\t  name         String   @default(\"SchoolHub Academy\")\n175\t  shortName    String   @default(\"SchoolHub\")\n176\t  logoUrl      String?\n177\t  timezone     String   @default(\"UTC\")\n178\t  addressLine1 String?\n179\t  addressLine2 String?\n180\t  city         String?\n181\t  country      String?\n182\t  phone        String?\n183\t  email        String?\n184\t  website      String?\n185\t  createdAt    DateTime @default(now())\n186\t  updatedAt    DateTime @updatedAt\n187\t}\n188\t\n189\t/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n190\t/// at a time -- enforced in src/server/services/academicYears.ts's\n191\t/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n192\t/// express \"exactly one true\" as a simple unique index).\n193\tmodel AcademicYear {\n194\t  id        String   @id @default(cuid())\n195\t  name      String   @unique\n196\t  startDate DateTime @db.Date\n197\t  endDate   DateTime @db.Date\n198\t  isCurrent Boolean  @default(false)\n199\t  createdAt DateTime @default(now())\n200\t  updatedAt DateTime @updatedAt\n201\t  terms     Term[]\n202\t}\n203\t\n204\t/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n205\t/// Restrict means the year can't be deleted while it still has terms --\n206\t/// the service layer checks this first to return a friendly 409 instead of\n207\t/// a raw FK error.\n208\tmodel Term {\n209\t  id             String       @id @default(cuid())\n210\t  academicYearId String\n211\t  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n212\t  name           String\n213\t  startDate      DateTime     @db.Date\n214\t  endDate        DateTime     @db.Date\n215\t  order          Int\n216\t  createdAt      DateTime     @default(now())\n217\t  updatedAt      DateTime     @updatedAt\n218\t\n219\t  @@unique([academicYearId, name])\n220\t  @@unique([academicYearId, order])\n221\t}\n222\t\n223\t/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n224\t/// reference grade levels, so they're archived instead of deleted.\n225\tmodel GradeLevel {\n226\t  id              String           @id @default(cuid())\n227\t  name            String           @unique\n228\t  shortName       String           @unique\n229\t  order           Int              @unique\n230\t  archivedAt      DateTime?\n231\t  createdAt       DateTime         @default(now())\n232\t  updatedAt       DateTime         @updatedAt\n233\t  studentProfiles StudentProfile[]\n234\t}\n235\t\n236\t/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n237\t/// the service layer, not the DB) so the unique constraint catches\n238\t/// case-insensitive duplicates like \"math\" vs \"MATH\".\n239\tmodel Subject {\n240\t  id          String    @id @default(cuid())\n241\t  name        String\n242\t  code        String    @unique\n243\t  description String?\n244\t  color       String    @default(\"#4F46E5\")\n245\t  archivedAt  DateTime?\n246\t  createdAt   DateTime  @default(now())\n247\t  updatedAt   DateTime  @updatedAt\n248\t}\n249\t\n250\t/// A physical room classes are scheduled in.\n251\tmodel Room {\n252\t  id         String    @id @default(cuid())\n253\t  name       String    @unique\n254\t  building   String?\n255\t  capacity   Int?\n256\t  archivedAt DateTime?\n257\t  createdAt  DateTime  @default(now())\n258\t  updatedAt  DateTime  @updatedAt\n259\t}\n260\t"}]},"parent_tool_use_id":null,"session_id":"bb2b8c62-3325-431e-93eb-03c63909bc5e","uuid":"3dc45bb6-56d4-4849-ba25-5551a748dbf5","timestamp":"2026-10-19T09:47:00.848Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/prisma/schema.prisma","content":"generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\nenum Gender {\n  FEMALE\n  MALE\n  OTHER\n  UNDISCLOSED\n}\n\nenum GuardianRelationship {\n  MOTHER\n  FATHER\n  GUARDIAN\n  GRANDPARENT\n  OTHER\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n/// field shared by every role, archivedAt backs FR-13's archive/restore\n/// (separate from status so a DISABLED-but-not-archived user stays distinct\n/// from an archived one).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  phone             String?\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  archivedAt        DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n  studentProfile    StudentProfile?\n  teacherProfile    TeacherProfile?\n  parentProfile     ParentProfile?\n  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")\n  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")\n\n  @@index([lastName, firstName, email])\n}\n\n/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n/// only -- enforced in the service layer (src/server/services/users.ts,\n/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\nmodel StudentProfile {\n  userId           String     @id\n  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  admissionNumber  String     @unique\n  dateOfBirth      DateTime   @db.Date\n  gender           Gender     @default(UNDISCLOSED)\n  gradeLevelId     String\n  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n  enrollmentDate   DateTime   @db.Date\n  addressLine1     String?\n  city             String?\n  medicalNotes     String?\n  emergencyContact String?\n  emergencyPhone   String?\n}\n\n/// Teacher-specific fields (FR-1).\nmodel TeacherProfile {\n  userId         String    @id\n  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  employeeNumber String    @unique\n  title          String?\n  qualifications String?\n  hireDate       DateTime? @db.Date\n}\n\n/// Parent-specific fields (FR-1).\nmodel ParentProfile {\n  userId     String  @id\n  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  occupation String?\n  address    String?\n}\n\n/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n/// transaction invariants rather than DB constraints.\nmodel ParentStudentLink {\n  id           String               @id @default(cuid())\n  parentId     String\n  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n  studentId    String\n  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n  relationship GuardianRelationship\n  isPrimary    Boolean              @default(false)\n  createdAt    DateTime             @default(now())\n\n  @@unique([parentId, studentId])\n  @@index([studentId])\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id              String           @id @default(cuid())\n  name            String           @unique\n  shortName       String           @unique\n  order           Int              @unique\n  archivedAt      DateTime?\n  createdAt       DateTime         @default(now())\n  updatedAt       DateTime         @updatedAt\n  studentProfiles StudentProfile[]\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n","numLines":260,"startLine":1,"totalLines":260}}}
