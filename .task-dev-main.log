{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgT66KTvM1q9M2euggufo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QeYcSH7gF4iJtLfQbDJk4V","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/(app)/admin/courses/[id]/enrollment/EnrollmentClient.tsx","content":"'use client';\n\nimport { useState } from 'react';\nimport Link from 'next/link';\nimport { useRouter, useSearchParams } from 'next/navigation';\nimport type { GridColDef } from '@mui/x-data-grid';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { DataTable } from '@/components/DataTable/DataTable';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { ConfirmDialog } from '@/components/ConfirmDialog/ConfirmDialog';\nimport { UserPicker, type UserPickerOption } from '@/components/UserPicker/UserPicker';\nimport { useToast } from '@/components/Toast/useToast';\nimport { enrollStudentsSchema } from '@/lib/validators/sections';\n\ninterface RosterRow {\n  enrollmentId: string;\n  status: 'ACTIVE' | 'DROPPED';\n  enrolledAt: string;\n  droppedAt: string | null;\n  student: { id: string; name: string; admissionNumber: string | null };\n}\ninterface CourseSummary {\n  id: string;\n  name: string;\n  code: string;\n  kind: 'CORE' | 'ELECTIVE';\n  capacity: number | null;\n  enrolledCount: number;\n  section: { id: string; name: string } | null;\n}\n\nclass ConflictError extends Error {}\n\nasync function send(url: string, method: string, body?: unknown) {\n  const res = await fetch(url, {\n    method,\n    headers: { 'Content-Type': 'application/json' },\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const json = await res.json().catch(() => ({}));\n  if (!res.ok) {\n    const message = json?.error?.message ?? 'Request failed';\n    throw res.status === 409 ? new ConflictError(message) : new Error(message);\n  }\n  return json;\n}\n\n/** A capacity CONFLICT can be retried with overrideCapacity after the admin confirms. */\ntype Pending = { message: string; retry: () => Promise<string> };\n\nexport function EnrollmentClient({ course, roster }: { course: CourseSummary; roster: RosterRow[] }) {\n  const router = useRouter();\n  const searchParams = useSearchParams();\n  const { showToast } = useToast();\n  const [toAdd, setToAdd] = useState<UserPickerOption[]>([]);\n  const [busy, setBusy] = useState(false);\n  const [pending, setPending] = useState<Pending | null>(null);\n  const isCore = course.kind === 'CORE';\n\n  const run = async (fn: (override: boolean) => Promise<string>) => {\n    setBusy(true);\n    try {\n      showToast({ message: await fn(false), severity: 'success' });\n      router.refresh();\n    } catch (error) {\n      const message = (error as Error).message;\n      if (error instanceof ConflictError && /is full/.test(message)) {\n        setPending({ message, retry: () => fn(true) });\n      } else {\n        showToast({ message, severity: 'error' });\n      }\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const confirmOverride = async () => {\n    if (!pending) return;\n    const { retry } = pending;\n    setPending(null);\n    setBusy(true);\n    try {\n      showToast({ message: await retry(), severity: 'success' });\n      router.refresh();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const addStudents = () =>\n    run(async (overrideCapacity) => {\n      const body = enrollStudentsSchema.parse({ studentIds: toAdd.map((s) => s.id), overrideCapacity });\n      const json = await send(`/api/courses/${course.id}/enrollments`, 'POST', body);\n      setToAdd([]);\n      return `Enrolled ${json.data.enrolled}, reactivated ${json.data.reactivated}`;\n    });\n\n  const setStatus = (row: RosterRow, status: 'ACTIVE' | 'DROPPED') =>\n    run(async (overrideCapacity) => {\n      await send(`/api/enrollments/${row.enrollmentId}`, 'PATCH', { status, overrideCapacity });\n      return `${row.student.name} ${status === 'DROPPED' ? 'dropped' : 'reactivated'}`;\n    });\n\n  const q = (searchParams.get('q') ?? '').toLowerCase();\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const filtered = roster.filter((r) => !q || r.student.name.toLowerCase().includes(q));\n  const visible = filtered.slice((page - 1) * pageSize, page * pageSize);\n\n  const columns: GridColDef[] = [\n    {\n      field: 'student',\n      headerName: 'Student',\n      flex: 1.5,\n      sortable: false,\n      renderCell: ({ row }) => <Link href={`/students/${row.student.id}`}>{row.student.name}</Link>,\n    },\n    {\n      field: 'admissionNumber',\n      headerName: 'Admission no.',\n      flex: 1,\n      sortable: false,\n      valueGetter: (_v, row) => row.student.admissionNumber ?? '—',\n    },\n    {\n      field: 'status',\n      headerName: 'Status',\n      flex: 0.8,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Chip size=\"small\" color={row.status === 'ACTIVE' ? 'success' : 'default'} label={row.status} />\n      ),\n    },\n    {\n      field: 'enrolledAt',\n      headerName: 'Enrolled',\n      flex: 1,\n      sortable: false,\n      valueGetter: (v) => new Date(v as string).toLocaleDateString(),\n    },\n    {\n      field: 'actions',\n      headerName: '',\n      width: 130,\n      sortable: false,\n      renderCell: ({ row }) =>\n        row.status === 'ACTIVE' ? (\n          <Button size=\"small\" color=\"error\" disabled={busy} onClick={() => setStatus(row, 'DROPPED')}>\n            Drop\n          </Button>\n        ) : (\n          <Button size=\"small\" disabled={busy} onClick={() => setStatus(row, 'ACTIVE')}>\n            Reactivate\n          </Button>\n        ),\n    },\n  ];\n\n  return (\n    <Box>\n      <PageHeader\n        title={`${course.code} · ${course.name}`}\n        description={`${course.enrolledCount}${course.capacity ? `/${course.capacity}` : ''} enrolled · ${course.kind}`}\n        breadcrumbs={[\n          { label: 'Administration' },\n          { label: 'Courses', href: '/admin/courses' },\n          { label: course.code, href: `/courses/${course.id}` },\n          { label: 'Enrollment' },\n        ]}\n      />\n\n      <Paper variant=\"outlined\" sx={{ p: 2, mb: 3 }}>\n        <Typography variant=\"subtitle1\" component=\"h2\" fontWeight={600} sx={{ mb: 1 }}>\n          Add students\n        </Typography>\n        {isCore && (\n          <Alert severity=\"info\" sx={{ mb: 2 }}>\n            Core course enrollment is managed via section{' '}\n            {course.section ? <Link href={`/admin/sections/${course.section.id}`}>{course.section.name}</Link> : '(none)'}.\n          </Alert>\n        )}\n        <Stack direction={{ xs: 'column', md: 'row' }} spacing={2} alignItems={{ md: 'center' }}>\n          <Box sx={{ flex: 1, ...(isCore ? { pointerEvents: 'none', opacity: 0.5 } : {}) }} aria-disabled={isCore}>\n            <UserPicker\n              label=\"Students\"\n              role=\"STUDENT\"\n              multiple\n              value={toAdd}\n              onChange={(v) => setToAdd((v as UserPickerOption[]) ?? [])}\n            />\n          </Box>\n          <Button variant=\"contained\" disabled={isCore || busy || toAdd.length === 0} onClick={addStudents}>\n            Enroll\n          </Button>\n        </Stack>\n      </Paper>\n\n      <DataTable\n        columns={columns}\n        rows={visible as never}\n        total={filtered.length}\n        getRowId={(row) => row.enrollmentId as string}\n      />\n\n      <ConfirmDialog\n        open={Boolean(pending)}\n        title=\"Course is full\"\n        description={`${pending?.message ?? ''} Enroll anyway and exceed capacity?`}\n        confirmLabel=\"Override capacity\"\n        onConfirm={confirmOverride}\n        onCancel={() => setPending(null)}\n      />\n    </Box>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7449,"cache_read_input_tokens":105324,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7449},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"b23e39e1-d3d6-44fe-9979-c53958a83ef6","timestamp":"2026-10-27T16:52:34.007Z","request_id":"req_011CgT66JwQtUucjTzw4PCap","wire_tool_inputs":{"toolu_01QeYcSH7gF4iJtLfQbDJk4V":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/(app)/admin/courses/[id]/enrollment/EnrollmentClient.tsx","content":"'use client';\n\nimport { useState } from 'react';\nimport Link from 'next/link';\nimport { useRouter, useSearchParams } from 'next/navigation';\nimport type { GridColDef } from '@mui/x-data-grid';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { DataTable } from '@/components/DataTable/DataTable';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { ConfirmDialog } from '@/components/ConfirmDialog/ConfirmDialog';\nimport { UserPicker, type UserPickerOption } from '@/components/UserPicker/UserPicker';\nimport { useToast } from '@/components/Toast/useToast';\nimport { enrollStudentsSchema } from '@/lib/validators/sections';\n\ninterface RosterRow {\n  enrollmentId: string;\n  status: 'ACTIVE' | 'DROPPED';\n  enrolledAt: string;\n  droppedAt: string | null;\n  student: { id: string; name: string; admissionNumber: string | null };\n}\ninterface CourseSummary {\n  id: string;\n  name: string;\n  code: string;\n  kind: 'CORE' | 'ELECTIVE';\n  capacity: number | null;\n  enrolledCount: number;\n  section: { id: string; name: string } | null;\n}\n\nclass ConflictError extends Error {}\n\nasync function send(url: string, method: string, body?: unknown) {\n  const res = await fetch(url, {\n    method,\n    headers: { 'Content-Type': 'application/json' },\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const json = await res.json().catch(() => ({}));\n  if (!res.ok) {\n    const message = json?.error?.message ?? 'Request failed';\n    throw res.status === 409 ? new ConflictError(message) : new Error(message);\n  }\n  return json;\n}\n\n/** A capacity CONFLICT can be retried with overrideCapacity after the admin confirms. */\ntype Pending = { message: string; retry: () => Promise<string> };\n\nexport function EnrollmentClient({ course, roster }: { course: CourseSummary; roster: RosterRow[] }) {\n  const router = useRouter();\n  const searchParams = useSearchParams();\n  const { showToast } = useToast();\n  const [toAdd, setToAdd] = useState<UserPickerOption[]>([]);\n  const [busy, setBusy] = useState(false);\n  const [pending, setPending] = useState<Pending | null>(null);\n  const isCore = course.kind === 'CORE';\n\n  const run = async (fn: (override: boolean) => Promise<string>) => {\n    setBusy(true);\n    try {\n      showToast({ message: await fn(false), severity: 'success' });\n      router.refresh();\n    } catch (error) {\n      const message = (error as Error).message;\n      if (error instanceof ConflictError && /is full/.test(message)) {\n        setPending({ message, retry: () => fn(true) });\n      } else {\n        showToast({ message, severity: 'error' });\n      }\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const confirmOverride = async () => {\n    if (!pending) return;\n    const { retry } = pending;\n    setPending(null);\n    setBusy(true);\n    try {\n      showToast({ message: await retry(), severity: 'success' });\n      router.refresh();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const addStudents = () =>\n    run(async (overrideCapacity) => {\n      const body = enrollStudentsSchema.parse({ studentIds: toAdd.map((s) => s.id), overrideCapacity });\n      const json = await send(`/api/courses/${course.id}/enrollments`, 'POST', body);\n      setToAdd([]);\n      return `Enrolled ${json.data.enrolled}, reactivated ${json.data.reactivated}`;\n    });\n\n  const setStatus = (row: RosterRow, status: 'ACTIVE' | 'DROPPED') =>\n    run(async (overrideCapacity) => {\n      await send(`/api/enrollments/${row.enrollmentId}`, 'PATCH', { status, overrideCapacity });\n      return `${row.student.name} ${status === 'DROPPED' ? 'dropped' : 'reactivated'}`;\n    });\n\n  const q = (searchParams.get('q') ?? '').toLowerCase();\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const filtered = roster.filter((r) => !q || r.student.name.toLowerCase().includes(q));\n  const visible = filtered.slice((page - 1) * pageSize, page * pageSize);\n\n  const columns: GridColDef[] = [\n    {\n      field: 'student',\n      headerName: 'Student',\n      flex: 1.5,\n      sortable: false,\n      renderCell: ({ row }) => <Link href={`/students/${row.student.id}`}>{row.student.name}</Link>,\n    },\n    {\n      field: 'admissionNumber',\n      headerName: 'Admission no.',\n      flex: 1,\n      sortable: false,\n      valueGetter: (_v, row) => row.student.admissionNumber ?? '—',\n    },\n    {\n      field: 'status',\n      headerName: 'Status',\n      flex: 0.8,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Chip size=\"small\" color={row.status === 'ACTIVE' ? 'success' : 'default'} label={row.status} />\n      ),\n    },\n    {\n      field: 'enrolledAt',\n      headerName: 'Enrolled',\n      flex: 1,\n      sortable: false,\n      valueGetter: (v) => new Date(v as string).toLocaleDateString(),\n    },\n    {\n      field: 'actions',\n      headerName: '',\n      width: 130,\n      sortable: false,\n      renderCell: ({ row }) =>\n        row.status === 'ACTIVE' ? (\n          <Button size=\"small\" color=\"error\" disabled={busy} onClick={() => setStatus(row, 'DROPPED')}>\n            Drop\n          </Button>\n        ) : (\n          <Button size=\"small\" disabled={busy} onClick={() => setStatus(row, 'ACTIVE')}>\n            Reactivate\n          </Button>\n        ),\n    },\n  ];\n\n  return (\n    <Box>\n      <PageHeader\n        title={`${course.code} · ${course.name}`}\n        description={`${course.enrolledCount}${course.capacity ? `/${course.capacity}` : ''} enrolled · ${course.kind}`}\n        breadcrumbs={[\n          { label: 'Administration' },\n          { label: 'Courses', href: '/admin/courses' },\n          { label: course.code, href: `/courses/${course.id}` },\n          { label: 'Enrollment' },\n        ]}\n      />\n\n      <Paper variant=\"outlined\" sx={{ p: 2, mb: 3 }}>\n        <Typography variant=\"subtitle1\" component=\"h2\" fontWeight={600} sx={{ mb: 1 }}>\n          Add students\n        </Typography>\n        {isCore && (\n          <Alert severity=\"info\" sx={{ mb: 2 }}>\n            Core course enrollment is managed via section{' '}\n            {course.section ? <Link href={`/admin/sections/${course.section.id}`}>{course.section.name}</Link> : '(none)'}.\n          </Alert>\n        )}\n        <Stack direction={{ xs: 'column', md: 'row' }} spacing={2} alignItems={{ md: 'center' }}>\n          <Box sx={{ flex: 1, ...(isCore ? { pointerEvents: 'none', opacity: 0.5 } : {}) }} aria-disabled={isCore}>\n            <UserPicker\n              label=\"Students\"\n              role=\"STUDENT\"\n              multiple\n              value={toAdd}\n              onChange={(v) => setToAdd((v as UserPickerOption[]) ?? [])}\n            />\n          </Box>\n          <Button variant=\"contained\" disabled={isCore || busy || toAdd.length === 0} onClick={addStudents}>\n            Enroll\n          </Button>\n        </Stack>\n      </Paper>\n\n      <DataTable\n        columns={columns}\n        rows={visible as never}\n        total={filtered.length}\n        getRowId={(row) => row.enrollmentId as string}\n      />\n\n      <ConfirmDialog\n        open={Boolean(pending)}\n        title=\"Course is full\"\n        description={`${pending?.message ?? ''} Enroll anyway and exceed capacity?`}\n        confirmLabel=\"Override capacity\"\n        onConfirm={confirmOverride}\n        onCancel={() => setPending(null)}\n      />\n    </Box>\n  );\n}\n"}}}
