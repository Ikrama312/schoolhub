{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg69vT3Sj9z64vXJXxy6V","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01J5idz364o263sb9Sdx42CM","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/tests/unit/DataTable.test.tsx","content":"import '@testing-library/jest-dom/vitest';\nimport { describe, expect, it, vi, beforeEach } from 'vitest';\nimport { render, screen, waitFor } from '@testing-library/react';\nimport userEvent from '@testing-library/user-event';\nimport type { GridColDef } from '@mui/x-data-grid';\nimport { DataTable } from '@/components/DataTable/DataTable';\n\n// MUI X DataGrid measures its container via ResizeObserver, which jsdom\n// doesn't implement — stub it so the grid can mount under Vitest/jsdom.\nclass ResizeObserverStub {\n  observe() {}\n  unobserve() {}\n  disconnect() {}\n}\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\n(global as any).ResizeObserver = ResizeObserverStub;\n\nconst push = vi.fn();\nlet search = '';\n\nvi.mock('next/navigation', () => ({\n  useRouter: () => ({ push }),\n  usePathname: () => '/students',\n  useSearchParams: () => new URLSearchParams(search),\n}));\n\nconst columns: GridColDef[] = [{ field: 'name', headerName: 'Name', sortable: true }];\nconst rows = [{ id: '1', name: 'Ada Lovelace' }];\n\nbeforeEach(() => {\n  push.mockClear();\n  search = '';\n});\n\ndescribe('DataTable', () => {\n  it('renders the given rows', () => {\n    render(<DataTable columns={columns} rows={rows} total={1} />);\n    expect(screen.getByText('Ada Lovelace')).toBeInTheDocument();\n  });\n\n  it('shows the empty state when there are no rows', () => {\n    render(<DataTable columns={columns} rows={[]} total={0} />);\n    expect(screen.getByText('No results')).toBeInTheDocument();\n  });\n\n  it('debounces the search box into a `q` URL param and resets to page 1', async () => {\n    const user = userEvent.setup();\n    render(<DataTable columns={columns} rows={rows} total={1} />);\n\n    await user.type(screen.getByLabelText('Search'), 'ada');\n\n    await waitFor(() => expect(push).toHaveBeenCalled(), { timeout: 1000 });\n    const lastCall = push.mock.calls.at(-1)?.[0] as string;\n    expect(lastCall).toContain('q=ada');\n    expect(lastCall).toContain('page=1');\n  });\n\n  it('reads the initial search value from the `q` URL param', () => {\n    search = 'q=existing';\n    render(<DataTable columns={columns} rows={rows} total={1} />);\n    expect(screen.getByLabelText('Search')).toHaveValue('existing');\n  });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":825,"cache_read_input_tokens":100871,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":825},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"43ee4874-357a-422b-8be6-0da1e9096cfe","uuid":"0da9cfbf-78ca-475a-9c76-8276de49c081","timestamp":"2026-10-16T15:30:22.737Z","request_id":"req_011Cg69vSpYA6MZWyaZPb2uC"}
