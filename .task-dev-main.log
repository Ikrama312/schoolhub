{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgrxmuzK2keRswQcUjc5E","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KiBNWiCRUbwMcQ6F7tM6vA","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/src/app/(app)/quizzes/[quizId]/take/QuizPlayer.tsx","content":"'use client';\n\nimport { useCallback, useEffect, useMemo, useRef, useState } from 'react';\nimport NextLink from 'next/link';\nimport { useRouter } from 'next/navigation';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Checkbox from '@mui/material/Checkbox';\nimport Chip from '@mui/material/Chip';\nimport FormControl from '@mui/material/FormControl';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormGroup from '@mui/material/FormGroup';\nimport FormLabel from '@mui/material/FormLabel';\nimport LinearProgress from '@mui/material/LinearProgress';\nimport Link from '@mui/material/Link';\nimport Paper from '@mui/material/Paper';\nimport Radio from '@mui/material/Radio';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport Typography from '@mui/material/Typography';\nimport FlagIcon from '@mui/icons-material/Flag';\nimport OutlinedFlagIcon from '@mui/icons-material/OutlinedFlag';\nimport { ConfirmDialog } from '@/components/ConfirmDialog/ConfirmDialog';\nimport { MarkdownView } from '@/components/MarkdownView/MarkdownView';\nimport { useToast } from '@/components/Toast/useToast';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { ANSWER_TEXT_MAX, type AnswerResponse } from '@/lib/validators/quiz';\nimport type { StudentAttempt, StudentQuiz } from '@/server/quiz/serializers';\nimport { useAutosave } from './useAutosave';\n\ntype Resp = AnswerResponse | null;\ntype Question = StudentAttempt['questions'][number];\n\nconst pts = (p: string) => p.replace(/\\.00$/, '');\nconst mmss = (ms: number) => {\n  const s = Math.max(0, Math.ceil(ms / 1000));\n  return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;\n};\n\nexport function isAnswered(r: Resp | undefined): boolean {\n  if (!r) return false;\n  if ('text' in r) return r.text.trim() !== '';\n  if ('optionIds' in r) return r.optionIds.length > 0;\n  return true;\n}\n\n// ---------------------------------------------------------------------------\n// Start screen (FR-12)\n// ---------------------------------------------------------------------------\n\nexport function StartScreen({\n  quiz,\n  timezone,\n  attempts,\n}: {\n  quiz: StudentQuiz;\n  timezone: string;\n  attempts: { id: string; attemptNumber: number; submittedAt: string | null }[];\n}) {\n  const router = useRouter();\n  const { showToast } = useToast();\n  const [confirm, setConfirm] = useState(false);\n  const canStart = quiz.isOpen && quiz.attemptsUsed < quiz.attemptLimit;\n  const minutes = quiz.timeLimitMinutes ? quiz.timeLimitMinutes + quiz.extraTimeMinutes : null;\n\n  const start = async () => {\n    const res = await fetch(`/api/quizzes/${quiz.id}/attempts`, { method: 'POST' });\n    if (!res.ok) {\n      const body = await res.json().catch(() => null);\n      showToast({ message: body?.error?.message ?? 'Could not start the quiz.', severity: 'error' });\n      setConfirm(false);\n      return;\n    }\n    router.refresh();\n  };\n\n  return (\n    <Paper variant=\"outlined\" sx={{ p: 3 }}>\n      <Stack spacing={2}>\n        {quiz.instructions && <MarkdownView source={quiz.instructions} />}\n        <Box component=\"dl\" sx={{ display: 'grid', gridTemplateColumns: 'max-content 1fr', columnGap: 2, rowGap: 0.5, m: 0 }}>\n          {[\n            ['Questions', String(quiz.questionCount)],\n            ['Total points', pts(quiz.totalPoints)],\n            ['Time limit', minutes ? `${minutes} minutes${quiz.extraTimeMinutes ? ` (incl. ${quiz.extraTimeMinutes} extra)` : ''}` : 'None'],\n            ['Attempts', `${quiz.attemptsUsed} used of ${quiz.attemptLimit}`],\n            ['Closes', formatInSchoolTz(quiz.availableUntil, 'EEE d MMM yyyy, HH:mm', timezone)],\n          ].map(([k, v]) => (\n            <Box key={k} sx={{ display: 'contents' }}>\n              <Typography component=\"dt\" variant=\"body2\" color=\"text.secondary\">\n                {k}\n              </Typography>\n              <Typography component=\"dd\" variant=\"body2\" sx={{ m: 0 }}>\n                {v}\n              </Typography>\n            </Box>\n          ))}\n        </Box>\n        {!quiz.isOpen && <Alert severity=\"info\">{new Date(quiz.availableFrom) > new Date() ? `This quiz opens ${formatInSchoolTz(quiz.availableFrom, 'EEE d MMM, HH:mm', timezone)}.` : 'This quiz is closed.'}</Alert>}\n        {quiz.isOpen && !canStart && <Alert severity=\"info\">You have used all your attempts.</Alert>}\n        {attempts.length > 0 && (\n          <Stack spacing={0.5}>\n            <Typography variant=\"subtitle2\" component=\"h2\">\n              Your attempts\n            </Typography>\n            {attempts.map((a) => (\n              <Link key={a.id} component={NextLink} href={`/quizzes/${quiz.id}/attempts/${a.id}`}>\n                Attempt {a.attemptNumber}\n                {a.submittedAt ? ` — submitted ${formatInSchoolTz(a.submittedAt, 'd MMM, HH:mm', timezone)}` : ''}\n              </Link>\n            ))}\n          </Stack>\n        )}\n        <Box>\n          <Button variant=\"contained\" disabled={!canStart} onClick={() => setConfirm(true)}>\n            Start attempt\n          </Button>\n        </Box>\n      </Stack>\n      <ConfirmDialog\n        open={confirm}\n        title=\"Start this attempt?\"\n        description={minutes ? `The ${minutes}-minute timer starts as soon as you start and keeps running if you leave the page.` : 'Your attempt starts now. Answers save automatically.'}\n        confirmLabel=\"Start\"\n        onConfirm={start}\n        onCancel={() => setConfirm(false)}\n      />\n    </Paper>\n  );\n}\n\n// ---------------------------------------------------------------------------\n// One question (NFR-3: native radio/checkbox inputs inside a fieldset)\n// ---------------------------------------------------------------------------\n\nfunction QuestionField({ q, index, value, onChange }: { q: Question; index: number; value: Resp | undefined; onChange: (r: Resp) => void }) {\n  const legendId = `q-${q.id}-legend`;\n  const r = (value ?? null) as Record<string, unknown> | null;\n  let input: React.ReactNode;\n  switch (q.type) {\n    case 'SINGLE_CHOICE':\n      input = (\n        <RadioGroup aria-labelledby={legendId} value={(r?.optionId as string) ?? ''} onChange={(_e, v) => onChange({ optionId: v })}>\n          {q.options?.map((o) => <FormControlLabel key={o.id} value={o.id} control={<Radio />} label={o.text} />)}\n        </RadioGroup>\n      );\n      break;\n    case 'TRUE_FALSE':\n      input = (\n        <RadioGroup aria-labelledby={legendId} value={r && typeof r.value === 'boolean' ? String(r.value) : ''} onChange={(_e, v) => onChange({ value: v === 'true' })}>\n          <FormControlLabel value=\"true\" control={<Radio />} label=\"True\" />\n          <FormControlLabel value=\"false\" control={<Radio />} label=\"False\" />\n        </RadioGroup>\n      );\n      break;\n    case 'MULTIPLE_CHOICE': {\n      const chosen = new Set((r?.optionIds as string[]) ?? []);\n      input = (\n        <FormGroup>\n          {q.options?.map((o) => (\n            <FormControlLabel\n              key={o.id}\n              label={o.text}\n              control={\n                <Checkbox\n                  checked={chosen.has(o.id)}\n                  onChange={(e) => {\n                    const next = new Set(chosen);\n                    if (e.target.checked) next.add(o.id);\n                    else next.delete(o.id);\n                    onChange({ optionIds: q.options!.map((x) => x.id).filter((id) => next.has(id)) });\n                  }}\n                />\n              }\n            />\n          ))}\n        </FormGroup>\n      );\n      break;\n    }\n    default:\n      input = (\n        <TextField\n          value={(r?.text as string) ?? ''}\n          onChange={(e) => onChange({ text: e.target.value })}\n          fullWidth\n          multiline={q.type === 'ESSAY'}\n          minRows={q.type === 'ESSAY' ? 6 : undefined}\n          slotProps={{ htmlInput: { maxLength: ANSWER_TEXT_MAX, 'aria-labelledby': legendId } }}\n          helperText={q.type === 'ESSAY' ? `${((r?.text as string) ?? '').length} / ${ANSWER_TEXT_MAX}` : undefined}\n        />\n      );\n  }\n  return (\n    <FormControl component=\"fieldset\" sx={{ width: '100%' }}>\n      <FormLabel component=\"legend\" id={legendId} sx={{ mb: 1, color: 'text.primary' }}>\n        <Typography variant=\"subtitle1\" component=\"span\" sx={{ fontWeight: 600 }}>\n          Question {index + 1}\n        </Typography>{' '}\n        <Typography variant=\"body2\" component=\"span\" color=\"text.secondary\">\n          ({pts(q.points)} {q.points === '1.00' ? 'point' : 'points'})\n        </Typography>\n      </FormLabel>\n      <Box sx={{ mb: 1 }}>\n        <MarkdownView source={q.prompt} />\n      </Box>\n      {input}\n    </FormControl>\n  );\n}\n\n// ---------------------------------------------------------------------------\n// Player (FR-13..FR-17, NFR-3)\n// ---------------------------------------------------------------------------\n\nconst STATUS_LABEL = { saved: 'All answers saved', saving: 'Saving…', offline: 'Offline — answers saved on this device', stopped: 'Submitted' } as const;\nconst STATUS_COLOR = { saved: 'success', saving: 'default', offline: 'warning', stopped: 'default' } as const;\n\nexport function QuizPlayer({ attempt, mode = 'live', onExitPreview }: { attempt: StudentAttempt; mode?: 'live' | 'preview'; onExitPreview?: () => void }) {\n  const router = useRouter();\n  const { showToast } = useToast();\n  const resultHref = `/quizzes/${attempt.quizId}/attempts/${attempt.id}`;\n  const done = useRef(false);\n  const goToResult = useCallback(() => {\n    if (done.current) return;\n    done.current = true;\n    router.push(resultHref);\n    router.refresh();\n  }, [router, resultHref]);\n\n  const { save, flush, status, restored } = useAutosave(attempt.id, mode, goToResult);\n  const [responses, setResponses] = useState<Record<string, Resp>>(() => Object.fromEntries(attempt.answers.map((a) => [a.questionId, a.response as Resp])));\n  // Queued (unsent) answers win over the server copy after a reload (FR-19, AC-2).\n  useEffect(() => {\n    if (Object.keys(restored).length) setResponses((r) => ({ ...r, ...restored }));\n  }, [restored]);\n\n  const [page, setPage] = useState(0);\n  const [flags, setFlags] = useState<Set<string>>(new Set());\n  const [confirm, setConfirm] = useState(false);\n  const [submitting, setSubmitting] = useState(false);\n\n  // Display-only timer corrected for client clock skew (ADR-4).\n  const skew = useMemo(() => new Date(attempt.serverNow).getTime() - Date.now(), [attempt.serverNow]);\n  const deadline = new Date(attempt.deadlineAt).getTime();\n  const [now, setNow] = useState(() => Date.now() + skew);\n  const [announce, setAnnounce] = useState('');\n  const announced = useRef(new Set<number>());\n  const remaining = deadline - now;\n\n  const submit = useCallback(\n    async (auto = false) => {\n      if (mode === 'preview') {\n        showToast({ message: 'Preview finished — nothing was recorded.', severity: 'info' });\n        onExitPreview?.();\n        return;\n      }\n      setSubmitting(true);\n      await flush();\n      if (done.current) return;\n      const res = await fetch(`/api/attempts/${attempt.id}/submit`, { method: 'POST' });\n      if (!res.ok && !auto) {\n        setSubmitting(false);\n        showToast({ message: 'Could not submit. Your answers are saved — try again.', severity: 'error' });\n        return;\n      }\n      goToResult();\n    },\n    [mode, flush, attempt.id, goToResult, showToast, onExitPreview],\n  );\n\n  useEffect(() => {\n    if (mode === 'preview') return;\n    const id = setInterval(() => setNow(Date.now() + skew), 1000);\n    return () => clearInterval(id);\n  }, [skew, mode]);\n\n  useEffect(() => {\n    for (const min of [5, 1]) {\n      if (remaining <= min * 60_000 && remaining > (min - 1) * 60_000 && !announced.current.has(min)) {\n        announced.current.add(min);\n        setAnnounce(`${min} minute${min > 1 ? 's' : ''} remaining`);\n      }\n    }\n    if (remaining <= 0 && mode === 'live' && !done.current && !submitting) void submit(true);\n  }, [remaining, mode, submit, submitting]);\n\n  const setAnswer = (qid: string, r: Resp) => {\n    setResponses((prev) => ({ ...prev, [qid]: r }));\n    save(qid, r);\n  };\n\n  const qs = attempt.questions;\n  const answeredCount = qs.filter((q) => isAnswered(responses[q.id])).length;\n  const unanswered = qs.length - answeredCount;\n  const visible = attempt.oneQuestionPerPage ? [qs[page]].filter(Boolean) : qs;\n  const timed = remaining < 365 * 24 * 3_600_000; // untimed attempts still end at availableUntil\n\n  return (\n    <Box>\n      <Paper elevation={2} sx={{ position: 'sticky', top: 0, zIndex: (t) => t.zIndex.appBar - 1, p: 2, mb: 2 }}>\n        <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'center', flexWrap: 'wrap' }} useFlexGap>\n          <Typography variant=\"h6\" component=\"h1\" sx={{ flex: 1, minWidth: 160 }}>\n            {attempt.quizTitle}\n            {mode === 'preview' && <Chip size=\"small\" label=\"Preview\" color=\"info\" sx={{ ml: 1 }} />}\n          </Typography>\n          {timed && (\n            <Typography\n              variant=\"h6\"\n              component=\"p\"\n              aria-label={`Time remaining ${mmss(remaining)}`}\n              sx={{ fontVariantNumeric: 'tabular-nums', color: remaining < 2 * 60_000 ? 'error.main' : 'text.primary', m: 0 }}\n            >\n              {mmss(remaining)}\n            </Typography>\n          )}\n          <Chip label={mode === 'preview' ? 'Not recorded' : STATUS_LABEL[status]} color={mode === 'preview' ? 'default' : STATUS_COLOR[status]} size=\"small\" />\n          <Button variant=\"contained\" onClick={() => setConfirm(true)} disabled={submitting}>\n            Submit\n          </Button>\n        </Stack>\n        <Box role=\"status\" aria-live=\"assertive\" sx={{ position: 'absolute', width: 1, height: 1, overflow: 'hidden', clip: 'rect(0 0 0 0)' }}>\n          {announce}\n        </Box>\n        <LinearProgress variant=\"determinate\" value={qs.length ? (answeredCount / qs.length) * 100 : 0} sx={{ mt: 1.5 }} aria-label={`${answeredCount} of ${qs.length} answered`} />\n      </Paper>\n\n      {attempt.oneQuestionPerPage && (\n        <Box component=\"nav\" aria-label=\"Question navigator\" sx={{ display: 'flex', flexWrap: 'wrap', gap: 1, mb: 2 }}>\n          {qs.map((q, i) => {\n            const flagged = flags.has(q.id);\n            return (\n              <Button\n                key={q.id}\n                size=\"small\"\n                variant={isAnswered(responses[q.id]) ? 'contained' : 'outlined'}\n                color={flagged ? 'warning' : 'primary'}\n                aria-current={i === page ? 'step' : undefined}\n                aria-label={`Question ${i + 1}, ${isAnswered(responses[q.id]) ? 'answered' : 'unanswered'}${flagged ? ', flagged' : ''}`}\n                onClick={() => setPage(i)}\n                sx={{ minWidth: 40, outline: i === page ? 2 : 0, outlineColor: 'primary.main', outlineOffset: 2 }}\n              >\n                {i + 1}\n              </Button>\n            );\n          })}\n        </Box>\n      )}\n\n      <Stack spacing={2}>\n        {visible.map((q) => {\n          const i = qs.indexOf(q);\n          return (\n            <Paper key={q.id} variant=\"outlined\" sx={{ p: 2 }}>\n              <QuestionField q={q} index={i} value={responses[q.id]} onChange={(r) => setAnswer(q.id, r)} />\n              <Box sx={{ mt: 1 }}>\n                <Button\n                  size=\"small\"\n                  startIcon={flags.has(q.id) ? <FlagIcon /> : <OutlinedFlagIcon />}\n                  aria-pressed={flags.has(q.id)}\n                  onClick={() =>\n                    setFlags((f) => {\n                      const n = new Set(f);\n                      if (n.has(q.id)) n.delete(q.id);\n                      else n.add(q.id);\n                      return n;\n                    })\n                  }\n                >\n                  {flags.has(q.id) ? 'Flagged for review' : 'Flag for review'}\n                </Button>\n              </Box>\n            </Paper>\n          );\n        })}\n      </Stack>\n\n      {attempt.oneQuestionPerPage && (\n        <Stack direction=\"row\" spacing={1} sx={{ mt: 2, justifyContent: 'space-between' }}>\n          <Button disabled={page === 0} onClick={() => setPage((p) => p - 1)}>\n            Previous\n          </Button>\n          <Button disabled={page >= qs.length - 1} onClick={() => setPage((p) => p + 1)}>\n            Next\n          </Button>\n        </Stack>\n      )}\n\n      <ConfirmDialog\n        open={confirm}\n        title=\"Submit your answers?\"\n        description={unanswered ? `You have ${unanswered} unanswered question${unanswered > 1 ? 's' : ''}. You can't change answers after submitting.` : \"All questions are answered. You can't change answers after submitting.\"}\n        confirmLabel=\"Submit\"\n        onConfirm={async () => {\n          setConfirm(false);\n          await submit();\n        }}\n        onCancel={() => setConfirm(false)}\n      />\n    </Box>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3761,"cache_read_input_tokens":266312,"cache_creation":{"ephemeral_5m_input_tokens":3761,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3eb50254-5396-4c9e-84e7-da065a5fc108","uuid":"79ad1383-5809-4088-80ff-3768165fb415","timestamp":"2026-11-09T07:31:24.480Z","request_id":"req_011Cgrxmua1XyTcuuswVFxuK","wire_tool_inputs":{"toolu_01KiBNWiCRUbwMcQ6F7tM6vA":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/src/app/(app)/quizzes/[quizId]/take/QuizPlayer.tsx","content":"'use client';\n\nimport { useCallback, useEffect, useMemo, useRef, useState } from 'react';\nimport NextLink from 'next/link';\nimport { useRouter } from 'next/navigation';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Checkbox from '@mui/material/Checkbox';\nimport Chip from '@mui/material/Chip';\nimport FormControl from '@mui/material/FormControl';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormGroup from '@mui/material/FormGroup';\nimport FormLabel from '@mui/material/FormLabel';\nimport LinearProgress from '@mui/material/LinearProgress';\nimport Link from '@mui/material/Link';\nimport Paper from '@mui/material/Paper';\nimport Radio from '@mui/material/Radio';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport Typography from '@mui/material/Typography';\nimport FlagIcon from '@mui/icons-material/Flag';\nimport OutlinedFlagIcon from '@mui/icons-material/OutlinedFlag';\nimport { ConfirmDialog } from '@/components/ConfirmDialog/ConfirmDialog';\nimport { MarkdownView } from '@/components/MarkdownView/MarkdownView';\nimport { useToast } from '@/components/Toast/useToast';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { ANSWER_TEXT_MAX, type AnswerResponse } from '@/lib/validators/quiz';\nimport type { StudentAttempt, StudentQuiz } from '@/server/quiz/serializers';\nimport { useAutosave } from './useAutosave';\n\ntype Resp = AnswerResponse | null;\ntype Question = StudentAttempt['questions'][number];\n\nconst pts = (p: string) => p.replace(/\\.00$/, '');\nconst mmss = (ms: number) => {\n  const s = Math.max(0, Math.ceil(ms / 1000));\n  return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;\n};\n\nexport function isAnswered(r: Resp | undefined): boolean {\n  if (!r) return false;\n  if ('text' in r) return r.text.trim() !== '';\n  if ('optionIds' in r) return r.optionIds.length > 0;\n  return true;\n}\n\n// ---------------------------------------------------------------------------\n// Start screen (FR-12)\n// ---------------------------------------------------------------------------\n\nexport function StartScreen({\n  quiz,\n  timezone,\n  attempts,\n}: {\n  quiz: StudentQuiz;\n  timezone: string;\n  attempts: { id: string; attemptNumber: number; submittedAt: string | null }[];\n}) {\n  const router = useRouter();\n  const { showToast } = useToast();\n  const [confirm, setConfirm] = useState(false);\n  const canStart = quiz.isOpen && quiz.attemptsUsed < quiz.attemptLimit;\n  const minutes = quiz.timeLimitMinutes ? quiz.timeLimitMinutes + quiz.extraTimeMinutes : null;\n\n  const start = async () => {\n    const res = await fetch(`/api/quizzes/${quiz.id}/attempts`, { method: 'POST' });\n    if (!res.ok) {\n      const body = await res.json().catch(() => null);\n      showToast({ message: body?.error?.message ?? 'Could not start the quiz.', severity: 'error' });\n      setConfirm(false);\n      return;\n    }\n    router.refresh();\n  };\n\n  return (\n    <Paper variant=\"outlined\" sx={{ p: 3 }}>\n      <Stack spacing={2}>\n        {quiz.instructions && <MarkdownView source={quiz.instructions} />}\n        <Box component=\"dl\" sx={{ display: 'grid', gridTemplateColumns: 'max-content 1fr', columnGap: 2, rowGap: 0.5, m: 0 }}>\n          {[\n            ['Questions', String(quiz.questionCount)],\n            ['Total points', pts(quiz.totalPoints)],\n            ['Time limit', minutes ? `${minutes} minutes${quiz.extraTimeMinutes ? ` (incl. ${quiz.extraTimeMinutes} extra)` : ''}` : 'None'],\n            ['Attempts', `${quiz.attemptsUsed} used of ${quiz.attemptLimit}`],\n            ['Closes', formatInSchoolTz(quiz.availableUntil, 'EEE d MMM yyyy, HH:mm', timezone)],\n          ].map(([k, v]) => (\n            <Box key={k} sx={{ display: 'contents' }}>\n              <Typography component=\"dt\" variant=\"body2\" color=\"text.secondary\">\n                {k}\n              </Typography>\n              <Typography component=\"dd\" variant=\"body2\" sx={{ m: 0 }}>\n                {v}\n              </Typography>\n            </Box>\n          ))}\n        </Box>\n        {!quiz.isOpen && <Alert severity=\"info\">{new Date(quiz.availableFrom) > new Date() ? `This quiz opens ${formatInSchoolTz(quiz.availableFrom, 'EEE d MMM, HH:mm', timezone)}.` : 'This quiz is closed.'}</Alert>}\n        {quiz.isOpen && !canStart && <Alert severity=\"info\">You have used all your attempts.</Alert>}\n        {attempts.length > 0 && (\n          <Stack spacing={0.5}>\n            <Typography variant=\"subtitle2\" component=\"h2\">\n              Your attempts\n            </Typography>\n            {attempts.map((a) => (\n              <Link key={a.id} component={NextLink} href={`/quizzes/${quiz.id}/attempts/${a.id}`}>\n                Attempt {a.attemptNumber}\n                {a.submittedAt ? ` — submitted ${formatInSchoolTz(a.submittedAt, 'd MMM, HH:mm', timezone)}` : ''}\n              </Link>\n            ))}\n          </Stack>\n        )}\n        <Box>\n          <Button variant=\"contained\" disabled={!canStart} onClick={() => setConfirm(true)}>\n            Start attempt\n          </Button>\n        </Box>\n      </Stack>\n      <ConfirmDialog\n        open={confirm}\n        title=\"Start this attempt?\"\n        description={minutes ? `The ${minutes}-minute timer starts as soon as you start and keeps running if you leave the page.` : 'Your attempt starts now. Answers save automatically.'}\n        confirmLabel=\"Start\"\n        onConfirm={start}\n        onCancel={() => setConfirm(false)}\n      />\n    </Paper>\n  );\n}\n\n// ---------------------------------------------------------------------------\n// One question (NFR-3: native radio/checkbox inputs inside a fieldset)\n// ---------------------------------------------------------------------------\n\nfunction QuestionField({ q, index, value, onChange }: { q: Question; index: number; value: Resp | undefined; onChange: (r: Resp) => void }) {\n  const legendId = `q-${q.id}-legend`;\n  const r = (value ?? null) as Record<string, unknown> | null;\n  let input: React.ReactNode;\n  switch (q.type) {\n    case 'SINGLE_CHOICE':\n      input = (\n        <RadioGroup aria-labelledby={legendId} value={(r?.optionId as string) ?? ''} onChange={(_e, v) => onChange({ optionId: v })}>\n          {q.options?.map((o) => <FormControlLabel key={o.id} value={o.id} control={<Radio />} label={o.text} />)}\n        </RadioGroup>\n      );\n      break;\n    case 'TRUE_FALSE':\n      input = (\n        <RadioGroup aria-labelledby={legendId} value={r && typeof r.value === 'boolean' ? String(r.value) : ''} onChange={(_e, v) => onChange({ value: v === 'true' })}>\n          <FormControlLabel value=\"true\" control={<Radio />} label=\"True\" />\n          <FormControlLabel value=\"false\" control={<Radio />} label=\"False\" />\n        </RadioGroup>\n      );\n      break;\n    case 'MULTIPLE_CHOICE': {\n      const chosen = new Set((r?.optionIds as string[]) ?? []);\n      input = (\n        <FormGroup>\n          {q.options?.map((o) => (\n            <FormControlLabel\n              key={o.id}\n              label={o.text}\n              control={\n                <Checkbox\n                  checked={chosen.has(o.id)}\n                  onChange={(e) => {\n                    const next = new Set(chosen);\n                    if (e.target.checked) next.add(o.id);\n                    else next.delete(o.id);\n                    onChange({ optionIds: q.options!.map((x) => x.id).filter((id) => next.has(id)) });\n                  }}\n                />\n              }\n            />\n          ))}\n        </FormGroup>\n      );\n      break;\n    }\n    default:\n      input = (\n        <TextField\n          value={(r?.text as string) ?? ''}\n          onChange={(e) => onChange({ text: e.target.value })}\n          fullWidth\n          multiline={q.type === 'ESSAY'}\n          minRows={q.type === 'ESSAY' ? 6 : undefined}\n          slotProps={{ htmlInput: { maxLength: ANSWER_TEXT_MAX, 'aria-labelledby': legendId } }}\n          helperText={q.type === 'ESSAY' ? `${((r?.text as string) ?? '').length} / ${ANSWER_TEXT_MAX}` : undefined}\n        />\n      );\n  }\n  return (\n    <FormControl component=\"fieldset\" sx={{ width: '100%' }}>\n      <FormLabel component=\"legend\" id={legendId} sx={{ mb: 1, color: 'text.primary' }}>\n        <Typography variant=\"subtitle1\" component=\"span\" sx={{ fontWeight: 600 }}>\n          Question {index + 1}\n        </Typography>{' '}\n        <Typography variant=\"body2\" component=\"span\" color=\"text.secondary\">\n          ({pts(q.points)} {q.points === '1.00' ? 'point' : 'points'})\n        </Typography>\n      </FormLabel>\n      <Box sx={{ mb: 1 }}>\n        <MarkdownView source={q.prompt} />\n      </Box>\n      {input}\n    </FormControl>\n  );\n}\n\n// ---------------------------------------------------------------------------\n// Player (FR-13..FR-17, NFR-3)\n// ---------------------------------------------------------------------------\n\nconst STATUS_LABEL = { saved: 'All answers saved', saving: 'Saving…', offline: 'Offline — answers saved on this device', stopped: 'Submitted' } as const;\nconst STATUS_COLOR = { saved: 'success', saving: 'default', offline: 'warning', stopped: 'default' } as const;\n\nexport function QuizPlayer({ attempt, mode = 'live', onExitPreview }: { attempt: StudentAttempt; mode?: 'live' | 'preview'; onExitPreview?: () => void }) {\n  const router = useRouter();\n  const { showToast } = useToast();\n  const resultHref = `/quizzes/${attempt.quizId}/attempts/${attempt.id}`;\n  const done = useRef(false);\n  const goToResult = useCallback(() => {\n    if (done.current) return;\n    done.current = true;\n    router.push(resultHref);\n    router.refresh();\n  }, [router, resultHref]);\n\n  const { save, flush, status, restored } = useAutosave(attempt.id, mode, goToResult);\n  const [responses, setResponses] = useState<Record<string, Resp>>(() => Object.fromEntries(attempt.answers.map((a) => [a.questionId, a.response as Resp])));\n  // Queued (unsent) answers win over the server copy after a reload (FR-19, AC-2).\n  useEffect(() => {\n    if (Object.keys(restored).length) setResponses((r) => ({ ...r, ...restored }));\n  }, [restored]);\n\n  const [page, setPage] = useState(0);\n  const [flags, setFlags] = useState<Set<string>>(new Set());\n  const [confirm, setConfirm] = useState(false);\n  const [submitting, setSubmitting] = useState(false);\n\n  // Display-only timer corrected for client clock skew (ADR-4).\n  const skew = useMemo(() => new Date(attempt.serverNow).getTime() - Date.now(), [attempt.serverNow]);\n  const deadline = new Date(attempt.deadlineAt).getTime();\n  const [now, setNow] = useState(() => Date.now() + skew);\n  const [announce, setAnnounce] = useState('');\n  const announced = useRef(new Set<number>());\n  const remaining = deadline - now;\n\n  const submit = useCallback(\n    async (auto = false) => {\n      if (mode === 'preview') {\n        showToast({ message: 'Preview finished — nothing was recorded.', severity: 'info' });\n        onExitPreview?.();\n        return;\n      }\n      setSubmitting(true);\n      await flush();\n      if (done.current) return;\n      const res = await fetch(`/api/attempts/${attempt.id}/submit`, { method: 'POST' });\n      if (!res.ok && !auto) {\n        setSubmitting(false);\n        showToast({ message: 'Could not submit. Your answers are saved — try again.', severity: 'error' });\n        return;\n      }\n      goToResult();\n    },\n    [mode, flush, attempt.id, goToResult, showToast, onExitPreview],\n  );\n\n  useEffect(() => {\n    if (mode === 'preview') return;\n    const id = setInterval(() => setNow(Date.now() + skew), 1000);\n    return () => clearInterval(id);\n  }, [skew, mode]);\n\n  useEffect(() => {\n    for (const min of [5, 1]) {\n      if (remaining <= min * 60_000 && remaining > (min - 1) * 60_000 && !announced.current.has(min)) {\n        announced.current.add(min);\n        setAnnounce(`${min} minute${min > 1 ? 's' : ''} remaining`);\n      }\n    }\n    if (remaining <= 0 && mode === 'live' && !done.current && !submitting) void submit(true);\n  }, [remaining, mode, submit, submitting]);\n\n  const setAnswer = (qid: string, r: Resp) => {\n    setResponses((prev) => ({ ...prev, [qid]: r }));\n    save(qid, r);\n  };\n\n  const qs = attempt.questions;\n  const answeredCount = qs.filter((q) => isAnswered(responses[q.id])).length;\n  const unanswered = qs.length - answeredCount;\n  const visible = attempt.oneQuestionPerPage ? [qs[page]].filter(Boolean) : qs;\n  const timed = remaining < 365 * 24 * 3_600_000; // untimed attempts still end at availableUntil\n\n  return (\n    <Box>\n      <Paper elevation={2} sx={{ position: 'sticky', top: 0, zIndex: (t) => t.zIndex.appBar - 1, p: 2, mb: 2 }}>\n        <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'center', flexWrap: 'wrap' }} useFlexGap>\n          <Typography variant=\"h6\" component=\"h1\" sx={{ flex: 1, minWidth: 160 }}>\n            {attempt.quizTitle}\n            {mode === 'preview' && <Chip size=\"small\" label=\"Preview\" color=\"info\" sx={{ ml: 1 }} />}\n          </Typography>\n          {timed && (\n            <Typography\n              variant=\"h6\"\n              component=\"p\"\n              aria-label={`Time remaining ${mmss(remaining)}`}\n              sx={{ fontVariantNumeric: 'tabular-nums', color: remaining < 2 * 60_000 ? 'error.main' : 'text.primary', m: 0 }}\n            >\n              {mmss(remaining)}\n            </Typography>\n          )}\n          <Chip label={mode === 'preview' ? 'Not recorded' : STATUS_LABEL[status]} color={mode === 'preview' ? 'default' : STATUS_COLOR[status]} size=\"small\" />\n          <Button variant=\"contained\" onClick={() => setConfirm(true)} disabled={submitting}>\n            Submit\n          </Button>\n        </Stack>\n        <Box role=\"status\" aria-live=\"assertive\" sx={{ position: 'absolute', width: 1, height: 1, overflow: 'hidden', clip: 'rect(0 0 0 0)' }}>\n          {announce}\n        </Box>\n        <LinearProgress variant=\"determinate\" value={qs.length ? (answeredCount / qs.length) * 100 : 0} sx={{ mt: 1.5 }} aria-label={`${answeredCount} of ${qs.length} answered`} />\n      </Paper>\n\n      {attempt.oneQuestionPerPage && (\n        <Box component=\"nav\" aria-label=\"Question navigator\" sx={{ display: 'flex', flexWrap: 'wrap', gap: 1, mb: 2 }}>\n          {qs.map((q, i) => {\n            const flagged = flags.has(q.id);\n            return (\n              <Button\n                key={q.id}\n                size=\"small\"\n                variant={isAnswered(responses[q.id]) ? 'contained' : 'outlined'}\n                color={flagged ? 'warning' : 'primary'}\n                aria-current={i === page ? 'step' : undefined}\n                aria-label={`Question ${i + 1}, ${isAnswered(responses[q.id]) ? 'answered' : 'unanswered'}${flagged ? ', flagged' : ''}`}\n                onClick={() => setPage(i)}\n                sx={{ minWidth: 40, outline: i === page ? 2 : 0, outlineColor: 'primary.main', outlineOffset: 2 }}\n              >\n                {i + 1}\n              </Button>\n            );\n          })}\n        </Box>\n      )}\n\n      <Stack spacing={2}>\n        {visible.map((q) => {\n          const i = qs.indexOf(q);\n          return (\n            <Paper key={q.id} variant=\"outlined\" sx={{ p: 2 }}>\n              <QuestionField q={q} index={i} value={responses[q.id]} onChange={(r) => setAnswer(q.id, r)} />\n              <Box sx={{ mt: 1 }}>\n                <Button\n                  size=\"small\"\n                  startIcon={flags.has(q.id) ? <FlagIcon /> : <OutlinedFlagIcon />}\n                  aria-pressed={flags.has(q.id)}\n                  onClick={() =>\n                    setFlags((f) => {\n                      const n = new Set(f);\n                      if (n.has(q.id)) n.delete(q.id);\n                      else n.add(q.id);\n                      return n;\n                    })\n                  }\n                >\n                  {flags.has(q.id) ? 'Flagged for review' : 'Flag for review'}\n                </Button>\n              </Box>\n            </Paper>\n          );\n        })}\n      </Stack>\n\n      {attempt.oneQuestionPerPage && (\n        <Stack direction=\"row\" spacing={1} sx={{ mt: 2, justifyContent: 'space-between' }}>\n          <Button disabled={page === 0} onClick={() => setPage((p) => p - 1)}>\n            Previous\n          </Button>\n          <Button disabled={page >= qs.length - 1} onClick={() => setPage((p) => p + 1)}>\n            Next\n          </Button>\n        </Stack>\n      )}\n\n      <ConfirmDialog\n        open={confirm}\n        title=\"Submit your answers?\"\n        description={unanswered ? `You have ${unanswered} unanswered question${unanswered > 1 ? 's' : ''}. You can't change answers after submitting.` : \"All questions are answered. You can't change answers after submitting.\"}\n        confirmLabel=\"Submit\"\n        onConfirm={async () => {\n          setConfirm(false);\n          await submit();\n        }}\n        onCancel={() => setConfirm(false)}\n      />\n    </Box>\n  );\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KiBNWiCRUbwMcQ6F7tM6vA","type":"tool_result","content":"File created successfully at: /Users/ikramaansari/Documents/forge/schoolhub/src/app/(app)/quizzes/[quizId]/take/QuizPlayer.tsx (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"3eb50254-5396-4c9e-84e7-da065a5fc108","uuid":"42250095-3515-4a7f-acdc-6d34ab9ca9bf","timestamp":"2026-11-09T07:31:24.542Z","tool_use_result":{"type":"create","filePath":"/Users/ikramaansari/Documents/forge/schoolhub/src/app/(app)/quizzes/[quizId]/take/QuizPlayer.tsx","content":"'use client';\n\nimport { useCallback, useEffect, useMemo, useRef, useState } from 'react';\nimport NextLink from 'next/link';\nimport { useRouter } from 'next/navigation';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Checkbox from '@mui/material/Checkbox';\nimport Chip from '@mui/material/Chip';\nimport FormControl from '@mui/material/FormControl';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormGroup from '@mui/material/FormGroup';\nimport FormLabel from '@mui/material/FormLabel';\nimport LinearProgress from '@mui/material/LinearProgress';\nimport Link from '@mui/material/Link';\nimport Paper from '@mui/material/Paper';\nimport Radio from '@mui/material/Radio';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport Typography from '@mui/material/Typography';\nimport FlagIcon from '@mui/icons-material/Flag';\nimport OutlinedFlagIcon from '@mui/icons-material/OutlinedFlag';\nimport { ConfirmDialog } from '@/components/ConfirmDialog/ConfirmDialog';\nimport { MarkdownView } from '@/components/MarkdownView/MarkdownView';\nimport { useToast } from '@/components/Toast/useToast';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { ANSWER_TEXT_MAX, type AnswerResponse } from '@/lib/validators/quiz';\nimport type { StudentAttempt, StudentQuiz } from '@/server/quiz/serializers';\nimport { useAutosave } from './useAutosave';\n\ntype Resp = AnswerResponse | null;\ntype Question = StudentAttempt['questions'][number];\n\nconst pts = (p: string) => p.replace(/\\.00$/, '');\nconst mmss = (ms: number) => {\n  const s = Math.max(0, Math.ceil(ms / 1000));\n  return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;\n};\n\nexport function isAnswered(r: Resp | undefined): boolean {\n  if (!r) return false;\n  if ('text' in r) return r.text.trim() !== '';\n  if ('optionIds' in r) return r.optionIds.length > 0;\n  return true;\n}\n\n// ---------------------------------------------------------------------------\n// Start screen (FR-12)\n// ---------------------------------------------------------------------------\n\nexport function StartScreen({\n  quiz,\n  timezone,\n  attempts,\n}: {\n  quiz: StudentQuiz;\n  timezone: string;\n  attempts: { id: string; attemptNumber: number; submittedAt: string | null }[];\n}) {\n  const router = useRouter();\n  const { showToast } = useToast();\n  const [confirm, setConfirm] = useState(false);\n  const canStart = quiz.isOpen && quiz.attemptsUsed < quiz.attemptLimit;\n  const minutes = quiz.timeLimitMinutes ? quiz.timeLimitMinutes + quiz.extraTimeMinutes : null;\n\n  const start = async () => {\n    const res = await fetch(`/api/quizzes/${quiz.id}/attempts`, { method: 'POST' });\n    if (!res.ok) {\n      const body = await res.json().catch(() => null);\n      showToast({ message: body?.error?.message ?? 'Could not start the quiz.', severity: 'error' });\n      setConfirm(false);\n      return;\n    }\n    router.refresh();\n  };\n\n  return (\n    <Paper variant=\"outlined\" sx={{ p: 3 }}>\n      <Stack spacing={2}>\n        {quiz.instructions && <MarkdownView source={quiz.instructions} />}\n        <Box component=\"dl\" sx={{ display: 'grid', gridTemplateColumns: 'max-content 1fr', columnGap: 2, rowGap: 0.5, m: 0 }}>\n          {[\n            ['Questions', String(quiz.questionCount)],\n            ['Total points', pts(quiz.totalPoints)],\n            ['Time limit', minutes ? `${minutes} minutes${quiz.extraTimeMinutes ? ` (incl. ${quiz.extraTimeMinutes} extra)` : ''}` : 'None'],\n            ['Attempts', `${quiz.attemptsUsed} used of ${quiz.attemptLimit}`],\n            ['Closes', formatInSchoolTz(quiz.availableUntil, 'EEE d MMM yyyy, HH:mm', timezone)],\n          ].map(([k, v]) => (\n            <Box key={k} sx={{ display: 'contents' }}>\n              <Typography component=\"dt\" variant=\"body2\" color=\"text.secondary\">\n                {k}\n              </Typography>\n              <Typography component=\"dd\" variant=\"body2\" sx={{ m: 0 }}>\n                {v}\n              </Typography>\n            </Box>\n          ))}\n        </Box>\n        {!quiz.isOpen && <Alert severity=\"info\">{new Date(quiz.availableFrom) > new Date() ? `This quiz opens ${formatInSchoolTz(quiz.availableFrom, 'EEE d MMM, HH:mm', timezone)}.` : 'This quiz is closed.'}</Alert>}\n        {quiz.isOpen && !canStart && <Alert severity=\"info\">You have used all your attempts.</Alert>}\n        {attempts.length > 0 && (\n          <Stack spacing={0.5}>\n            <Typography variant=\"subtitle2\" component=\"h2\">\n              Your attempts\n            </Typography>\n            {attempts.map((a) => (\n              <Link key={a.id} component={NextLink} href={`/quizzes/${quiz.id}/attempts/${a.id}`}>\n                Attempt {a.attemptNumber}\n                {a.submittedAt ? ` — submitted ${formatInSchoolTz(a.submittedAt, 'd MMM, HH:mm', timezone)}` : ''}\n              </Link>\n            ))}\n          </Stack>\n        )}\n        <Box>\n          <Button variant=\"contained\" disabled={!canStart} onClick={() => setConfirm(true)}>\n            Start attempt\n          </Button>\n        </Box>\n      </Stack>\n      <ConfirmDialog\n        open={confirm}\n        title=\"Start this attempt?\"\n        description={minutes ? `The ${minutes}-minute timer starts as soon as you start and keeps running if you leave the page.` : 'Your attempt starts now. Answers save automatically.'}\n        confirmLabel=\"Start\"\n        onConfirm={start}\n        onCancel={() => setConfirm(false)}\n      />\n    </Paper>\n  );\n}\n\n// ---------------------------------------------------------------------------\n// One question (NFR-3: native radio/checkbox inputs inside a fieldset)\n// ---------------------------------------------------------------------------\n\nfunction QuestionField({ q, index, value, onChange }: { q: Question; index: number; value: Resp | undefined; onChange: (r: Resp) => void }) {\n  const legendId = `q-${q.id}-legend`;\n  const r = (value ?? null) as Record<string, unknown> | null;\n  let input: React.ReactNode;\n  switch (q.type) {\n    case 'SINGLE_CHOICE':\n      input = (\n        <RadioGroup aria-labelledby={legendId} value={(r?.optionId as string) ?? ''} onChange={(_e, v) => onChange({ optionId: v })}>\n          {q.options?.map((o) => <FormControlLabel key={o.id} value={o.id} control={<Radio />} label={o.text} />)}\n        </RadioGroup>\n      );\n      break;\n    case 'TRUE_FALSE':\n      input = (\n        <RadioGroup aria-labelledby={legendId} value={r && typeof r.value === 'boolean' ? String(r.value) : ''} onChange={(_e, v) => onChange({ value: v === 'true' })}>\n          <FormControlLabel value=\"true\" control={<Radio />} label=\"True\" />\n          <FormControlLabel value=\"false\" control={<Radio />} label=\"False\" />\n        </RadioGroup>\n      );\n      break;\n    case 'MULTIPLE_CHOICE': {\n      const chosen = new Set((r?.optionIds as string[]) ?? []);\n      input = (\n        <FormGroup>\n          {q.options?.map((o) => (\n            <FormControlLabel\n              key={o.id}\n              label={o.text}\n              control={\n                <Checkbox\n                  checked={chosen.has(o.id)}\n                  onChange={(e) => {\n                    const next = new Set(chosen);\n                    if (e.target.checked) next.add(o.id);\n                    else next.delete(o.id);\n                    onChange({ optionIds: q.options!.map((x) => x.id).filter((id) => next.has(id)) });\n                  }}\n                />\n              }\n            />\n          ))}\n        </FormGroup>\n      );\n      break;\n    }\n    default:\n      input = (\n        <TextField\n          value={(r?.text as string) ?? ''}\n          onChange={(e) => onChange({ text: e.target.value })}\n          fullWidth\n          multiline={q.type === 'ESSAY'}\n          minRows={q.type === 'ESSAY' ? 6 : undefined}\n          slotProps={{ htmlInput: { maxLength: ANSWER_TEXT_MAX, 'aria-labelledby': legendId } }}\n          helperText={q.type === 'ESSAY' ? `${((r?.text as string) ?? '').length} / ${ANSWER_TEXT_MAX}` : undefined}\n        />\n      );\n  }\n  return (\n    <FormControl component=\"fieldset\" sx={{ width: '100%' }}>\n      <FormLabel component=\"legend\" id={legendId} sx={{ mb: 1, color: 'text.primary' }}>\n        <Typography variant=\"subtitle1\" component=\"span\" sx={{ fontWeight: 600 }}>\n          Question {index + 1}\n        </Typography>{' '}\n        <Typography variant=\"body2\" component=\"span\" color=\"text.secondary\">\n          ({pts(q.points)} {q.points === '1.00' ? 'point' : 'points'})\n        </Typography>\n      </FormLabel>\n      <Box sx={{ mb: 1 }}>\n        <MarkdownView source={q.prompt} />\n      </Box>\n      {input}\n    </FormControl>\n  );\n}\n\n// ---------------------------------------------------------------------------\n// Player (FR-13..FR-17, NFR-3)\n// ---------------------------------------------------------------------------\n\nconst STATUS_LABEL = { saved: 'All answers saved', saving: 'Saving…', offline: 'Offline — answers saved on this device', stopped: 'Submitted' } as const;\nconst STATUS_COLOR = { saved: 'success', saving: 'default', offline: 'warning', stopped: 'default' } as const;\n\nexport function QuizPlayer({ attempt, mode = 'live', onExitPreview }: { attempt: StudentAttempt; mode?: 'live' | 'preview'; onExitPreview?: () => void }) {\n  const router = useRouter();\n  const { showToast } = useToast();\n  const resultHref = `/quizzes/${attempt.quizId}/attempts/${attempt.id}`;\n  const done = useRef(false);\n  const goToResult = useCallback(() => {\n    if (done.current) return;\n    done.current = true;\n    router.push(resultHref);\n    router.refresh();\n  }, [router, resultHref]);\n\n  const { save, flush, status, restored } = useAutosave(attempt.id, mode, goToResult);\n  const [responses, setResponses] = useState<Record<string, Resp>>(() => Object.fromEntries(attempt.answers.map((a) => [a.questionId, a.response as Resp])));\n  // Queued (unsent) answers win over the server copy after a reload (FR-19, AC-2).\n  useEffect(() => {\n    if (Object.keys(restored).length) setResponses((r) => ({ ...r, ...restored }));\n  }, [restored]);\n\n  const [page, setPage] = useState(0);\n  const [flags, setFlags] = useState<Set<string>>(new Set());\n  const [confirm, setConfirm] = useState(false);\n  const [submitting, setSubmitting] = useState(false);\n\n  // Display-only timer corrected for client clock skew (ADR-4).\n  const skew = useMemo(() => new Date(attempt.serverNow).getTime() - Date.now(), [attempt.serverNow]);\n  const deadline = new Date(attempt.deadlineAt).getTime();\n  const [now, setNow] = useState(() => Date.now() + skew);\n  const [announce, setAnnounce] = useState('');\n  const announced = useRef(new Set<number>());\n  const remaining = deadline - now;\n\n  const submit = useCallback(\n    async (auto = false) => {\n      if (mode === 'preview') {\n        showToast({ message: 'Preview finished — nothing was recorded.', severity: 'info' });\n        onExitPreview?.();\n        return;\n      }\n      setSubmitting(true);\n      await flush();\n      if (done.current) return;\n      const res = await fetch(`/api/attempts/${attempt.id}/submit`, { method: 'POST' });\n      if (!res.ok && !auto) {\n        setSubmitting(false);\n        showToast({ message: 'Could not submit. Your answers are saved — try again.', severity: 'error' });\n        return;\n      }\n      goToResult();\n    },\n    [mode, flush, attempt.id, goToResult, showToast, onExitPreview],\n  );\n\n  useEffect(() => {\n    if (mode === 'preview') return;\n    const id = setInterval(() => setNow(Date.now() + skew), 1000);\n    return () => clearInterval(id);\n  }, [skew, mode]);\n\n  useEffect(() => {\n    for (const min of [5, 1]) {\n      if (remaining <= min * 60_000 && remaining > (min - 1) * 60_000 && !announced.current.has(min)) {\n        announced.current.add(min);\n        setAnnounce(`${min} minute${min > 1 ? 's' : ''} remaining`);\n      }\n    }\n    if (remaining <= 0 && mode === 'live' && !done.current && !submitting) void submit(true);\n  }, [remaining, mode, submit, submitting]);\n\n  const setAnswer = (qid: string, r: Resp) => {\n    setResponses((prev) => ({ ...prev, [qid]: r }));\n    save(qid, r);\n  };\n\n  const qs = attempt.questions;\n  const answeredCount = qs.filter((q) => isAnswered(responses[q.id])).length;\n  const unanswered = qs.length - answeredCount;\n  const visible = attempt.oneQuestionPerPage ? [qs[page]].filter(Boolean) : qs;\n  const timed = remaining < 365 * 24 * 3_600_000; // untimed attempts still end at availableUntil\n\n  return (\n    <Box>\n      <Paper elevation={2} sx={{ position: 'sticky', top: 0, zIndex: (t) => t.zIndex.appBar - 1, p: 2, mb: 2 }}>\n        <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'center', flexWrap: 'wrap' }} useFlexGap>\n          <Typography variant=\"h6\" component=\"h1\" sx={{ flex: 1, minWidth: 160 }}>\n            {attempt.quizTitle}\n            {mode === 'preview' && <Chip size=\"small\" label=\"Preview\" color=\"info\" sx={{ ml: 1 }} />}\n          </Typography>\n          {timed && (\n            <Typography\n              variant=\"h6\"\n              component=\"p\"\n              aria-label={`Time remaining ${mmss(remaining)}`}\n              sx={{ fontVariantNumeric: 'tabular-nums', color: remaining < 2 * 60_000 ? 'error.main' : 'text.primary', m: 0 }}\n            >\n              {mmss(remaining)}\n            </Typography>\n          )}\n          <Chip label={mode === 'preview' ? 'Not recorded' : STATUS_LABEL[status]} color={mode === 'preview' ? 'default' : STATUS_COLOR[status]} size=\"small\" />\n          <Button variant=\"contained\" onClick={() => setConfirm(true)} disabled={submitting}>\n            Submit\n          </Button>\n        </Stack>\n        <Box role=\"status\" aria-live=\"assertive\" sx={{ position: 'absolute', width: 1, height: 1, overflow: 'hidden', clip: 'rect(0 0 0 0)' }}>\n          {announce}\n        </Box>\n        <LinearProgress variant=\"determinate\" value={qs.length ? (answeredCount / qs.length) * 100 : 0} sx={{ mt: 1.5 }} aria-label={`${answeredCount} of ${qs.length} answered`} />\n      </Paper>\n\n      {attempt.oneQuestionPerPage && (\n        <Box component=\"nav\" aria-label=\"Question navigator\" sx={{ display: 'flex', flexWrap: 'wrap', gap: 1, mb: 2 }}>\n          {qs.map((q, i) => {\n            const flagged = flags.has(q.id);\n            return (\n              <Button\n                key={q.id}\n                size=\"small\"\n                variant={isAnswered(responses[q.id]) ? 'contained' : 'outlined'}\n                color={flagged ? 'warning' : 'primary'}\n                aria-current={i === page ? 'step' : undefined}\n                aria-label={`Question ${i + 1}, ${isAnswered(responses[q.id]) ? 'answered' : 'unanswered'}${flagged ? ', flagged' : ''}`}\n                onClick={() => setPage(i)}\n                sx={{ minWidth: 40, outline: i === page ? 2 : 0, outlineColor: 'primary.main', outlineOffset: 2 }}\n              >\n                {i + 1}\n              </Button>\n            );\n          })}\n        </Box>\n      )}\n\n      <Stack spacing={2}>\n        {visible.map((q) => {\n          const i = qs.indexOf(q);\n          return (\n            <Paper key={q.id} variant=\"outlined\" sx={{ p: 2 }}>\n              <QuestionField q={q} index={i} value={responses[q.id]} onChange={(r) => setAnswer(q.id, r)} />\n              <Box sx={{ mt: 1 }}>\n                <Button\n                  size=\"small\"\n                  startIcon={flags.has(q.id) ? <FlagIcon /> : <OutlinedFlagIcon />}\n                  aria-pressed={flags.has(q.id)}\n                  onClick={() =>\n                    setFlags((f) => {\n                      const n = new Set(f);\n                      if (n.has(q.id)) n.delete(q.id);\n                      else n.add(q.id);\n                      return n;\n                    })\n                  }\n                >\n                  {flags.has(q.id) ? 'Flagged for review' : 'Flag for review'}\n                </Button>\n              </Box>\n            </Paper>\n          );\n        })}\n      </Stack>\n\n      {attempt.oneQuestionPerPage && (\n        <Stack direction=\"row\" spacing={1} sx={{ mt: 2, justifyContent: 'space-between' }}>\n          <Button disabled={page === 0} onClick={() => setPage((p) => p - 1)}>\n            Previous\n          </Button>\n          <Button disabled={page >= qs.length - 1} onClick={() => setPage((p) => p + 1)}>\n            Next\n          </Button>\n        </Stack>\n      )}\n\n      <ConfirmDialog\n        open={confirm}\n        title=\"Submit your answers?\"\n        description={unanswered ? `You have ${unanswered} unanswered question${unanswered > 1 ? 's' : ''}. You can't change answers after submitting.` : \"All questions are answered. You can't change answers after submitting.\"}\n        confirmLabel=\"Submit\"\n        onConfirm={async () => {\n          setConfirm(false);\n          await submit();\n        }}\n        onCancel={() => setConfirm(false)}\n      />\n    </Box>\n  );\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01KiBNWiCRUbwMcQ6F7tM6vA","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
