{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013EcjHKnYv1pMPBkgEYxCpZ","type":"tool_result","content":"1\timport '@testing-library/jest-dom/vitest';\n2\timport { describe, expect, it, vi, afterEach } from 'vitest';\n3\timport { render, screen, act } from '@testing-library/react';\n4\timport { ToastProvider } from '@/components/Toast/ToastProvider';\n5\timport { useToast } from '@/components/Toast/useToast';\n6\t\n7\tfunction Trigger() {\n8\t  const { showToast } = useToast();\n9\t  return (\n10\t    <>\n11\t      <button onClick={() => showToast({ message: 'First toast', severity: 'success' })}>show-1</button>\n12\t      <button onClick={() => showToast({ message: 'Second toast', severity: 'error' })}>show-2</button>\n13\t    </>\n14\t  );\n15\t}\n16\t\n17\tfunction renderWithProvider() {\n18\t  return render(\n19\t    <ToastProvider>\n20\t      <Trigger />\n21\t    </ToastProvider>,\n22\t  );\n23\t}\n24\t\n25\tafterEach(() => {\n26\t  vi.useRealTimers();\n27\t});\n28\t\n29\tdescribe('useToast / ToastProvider', () => {\n30\t  it('throws when used outside a ToastProvider', () => {\n31\t    function Bare() {\n32\t      useToast();\n33\t      return null;\n34\t    }\n35\t    expect(() => render(<Bare />)).toThrow(/ToastProvider/);\n36\t  });\n37\t\n38\t  it('shows a toast with the given message and severity', () => {\n39\t    renderWithProvider();\n40\t    act(() => screen.getByText('show-1').click());\n41\t    expect(screen.getByText('First toast')).toBeInTheDocument();\n42\t  });\n43\t\n44\t  it('queues a second toast instead of showing both at once', () => {\n45\t    renderWithProvider();\n46\t    act(() => screen.getByText('show-1').click());\n47\t    act(() => screen.getByText('show-2').click());\n48\t    expect(screen.getByText('First toast')).toBeInTheDocument();\n49\t    expect(screen.queryByText('Second toast')).not.toBeInTheDocument();\n50\t  });\n51\t\n52\t  it('auto-hides after 5 seconds and advances the queue to the next toast', async () => {\n53\t    vi.useFakeTimers();\n54\t    renderWithProvider();\n55\t\n56\t    act(() => screen.getByText('show-1').click());\n57\t    act(() => screen.getByText('show-2').click());\n58\t    expect(screen.getByText('First toast')).toBeInTheDocument();\n59\t\n60\t    // 5s auto-hide + generous buffer for the exit transition.\n61\t    await act(async () => {\n62\t      await vi.advanceTimersByTimeAsync(5500);\n63\t    });\n64\t\n65\t    expect(screen.queryByText('First toast')).not.toBeInTheDocument();\n66\t    expect(screen.getByText('Second toast')).toBeInTheDocument();\n67\t  });\n68\t});\n69\t"}]},"parent_tool_use_id":null,"session_id":"fc5a5891-f2a4-4318-9097-fd5c829790c6","uuid":"7fab2cc0-382c-4462-a593-5806b0246d61","timestamp":"2026-10-16T15:35:53.777Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/tests/unit/useToast.test.tsx","content":"import '@testing-library/jest-dom/vitest';\nimport { describe, expect, it, vi, afterEach } from 'vitest';\nimport { render, screen, act } from '@testing-library/react';\nimport { ToastProvider } from '@/components/Toast/ToastProvider';\nimport { useToast } from '@/components/Toast/useToast';\n\nfunction Trigger() {\n  const { showToast } = useToast();\n  return (\n    <>\n      <button onClick={() => showToast({ message: 'First toast', severity: 'success' })}>show-1</button>\n      <button onClick={() => showToast({ message: 'Second toast', severity: 'error' })}>show-2</button>\n    </>\n  );\n}\n\nfunction renderWithProvider() {\n  return render(\n    <ToastProvider>\n      <Trigger />\n    </ToastProvider>,\n  );\n}\n\nafterEach(() => {\n  vi.useRealTimers();\n});\n\ndescribe('useToast / ToastProvider', () => {\n  it('throws when used outside a ToastProvider', () => {\n    function Bare() {\n      useToast();\n      return null;\n    }\n    expect(() => render(<Bare />)).toThrow(/ToastProvider/);\n  });\n\n  it('shows a toast with the given message and severity', () => {\n    renderWithProvider();\n    act(() => screen.getByText('show-1').click());\n    expect(screen.getByText('First toast')).toBeInTheDocument();\n  });\n\n  it('queues a second toast instead of showing both at once', () => {\n    renderWithProvider();\n    act(() => screen.getByText('show-1').click());\n    act(() => screen.getByText('show-2').click());\n    expect(screen.getByText('First toast')).toBeInTheDocument();\n    expect(screen.queryByText('Second toast')).not.toBeInTheDocument();\n  });\n\n  it('auto-hides after 5 seconds and advances the queue to the next toast', async () => {\n    vi.useFakeTimers();\n    renderWithProvider();\n\n    act(() => screen.getByText('show-1').click());\n    act(() => screen.getByText('show-2').click());\n    expect(screen.getByText('First toast')).toBeInTheDocument();\n\n    // 5s auto-hide + generous buffer for the exit transition.\n    await act(async () => {\n      await vi.advanceTimersByTimeAsync(5500);\n    });\n\n    expect(screen.queryByText('First toast')).not.toBeInTheDocument();\n    expect(screen.getByText('Second toast')).toBeInTheDocument();\n  });\n});\n","numLines":69,"startLine":1,"totalLines":69}}}
