Typography>\n            <Typography variant=\"body2\">Teachers: {teachers}</Typography>\n            {course.section && <Typography variant=\"body2\">Section {course.section.name}</Typography>}\n            {course.section?.room && <Typography variant=\"body2\">Room {course.section.room.name}</Typography>}\n          </Stack>\n        </Box>\n      </Paper>\n      <CourseTabs courseId={course.id} role={user.role} />\n      {children}\n    </Box>\n  );\n}\nsrc/components/ConfirmDialog:\nConfirmDialog.tsx\n\nsrc/components/DataTable:\nDataTable.tsx\n\nsrc/components/DateDisplay:\nDateDisplay.tsx\n\nsrc/components/EmptyState:\nEmptyState.tsx\n\nsrc/components/FormField:\nFormField.tsx\n\nsrc/components/LoadingSkeleton:\nLoadingSkeleton.tsx\n\nsrc/components/NotificationBell:\nNotificationBell.tsx\n\nsrc/components/PageHeader:\nPageHeader.tsx\n\nsrc/components/PasswordChecklist:\nindex.ts\nPasswordChecklist.tsx\nSetPasswordForm.tsx\n\nsrc/components/StatCard:\nStatCard.tsx\n\nsrc/components/Toast:\nToastProvider.tsx\nuseToast.ts\n\nsrc/components/UserAvatar:\nUserAvatar.tsx\n\nsrc/components/UserPicker:\nUserPicker.tsx","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014QyZc27wv6YzHwdRgviMEF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
