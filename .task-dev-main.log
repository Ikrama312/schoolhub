{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019NEVsNQSxdTq3upkq1fN4E","type":"tool_result","content":"      select: { id: true, status: true, archivedAt: true },\n    });\n  });\n}\n\nexport async function restoreUser(userId: string) {\n  return prisma.user.update({\n    where: { id: userId },\n    data: { archivedAt: null },\n    select: { id: true, status: true, archivedAt: true },\n  });\n}\n\n/** FR-31: clears exactly the two lockout fields that exist in the schema today. */\nexport async function unlockUser(userId: string) {\n  return prisma.user.update({\n    where: { id: userId },\n    data: { lockedUntil: null, failedLoginCount: 0 },\n    select: { id: true, lockedUntil: true, failedLoginCount: true },\n  });\n}\n\n/** FR-26: a fresh 7-day INVITE token (older unused ones are invalidated). Returns the raw token. */\nexport function createInviteToken(userId: string): Promise<string> {\n  return createToken(userId, 'INVITE', { days: 7 });\n}\n\n/**\n * FR-25/FR-27: issue an invite token and email the link. Call sites\n * (POST /api/users/:id/invite, createUser's sendInvite checkbox, CSV import)\n * keep the same {id, inviteSentAt} shape.\n */\nexport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n  const user = await prisma.user.findUnique({ where: { id: userId }, select: { email: true, firstName: true } });\n  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n  const raw = await createInviteToken(userId);\n  await sendAuthEmail(user, 'invite', authLink('invite', raw));\n  return { id: userId, inviteSentAt: new Date() };\n}\nsrc/server/services/auth.ts:6:import { consumeToken, createToken, verifyToken } from '@/server/auth/tokens';\nsrc/server/services/auth.ts:8:import { authLink, sendAuthEmail } from '@/server/auth/email';\nsrc/server/services/auth.ts:53:    const raw = await createToken(user.id, 'PASSWORD_RESET', { minutes: 60 });\nsrc/server/services/auth.ts:54:    await sendAuthEmail(user, 'password-reset', authLink('password-reset', raw));\nsrc/server/services/users.ts:4:import { createToken } from '@/server/auth/tokens';\nsrc/server/services/users.ts:5:import { authLink, sendAuthEmail } from '@/server/auth/email';\nsrc/server/services/users.ts:384:  return createToken(userId, 'INVITE', { days: 7 });\nsrc/server/services/users.ts:396:  await sendAuthEmail(user, 'invite', authLink('invite', raw));\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\nimport { formatInTimeZone } from 'date-fns-tz';\n\n/**\n * Formats a UTC date/ISO-string in the school's configured timezone\n * (SchoolSettings.timezone). pattern is a date-fns format string.\n */\nexport function formatInSchoolTz(\n  date: Date | string,\n  pattern: string,\n  timezone: string,\n): string {\n  const value = typeof date === 'string' ? new Date(date) : date;\n  return formatInTimeZone(value, timezone, pattern);\n}\nimport { cache } from 'react';\nimport { prisma } from '@/server/db';\n\nexport interface UpdateSchoolSettingsInput {\n  name?: string;\n  shortName?: string;\n  logoUrl?: string | null;\n  timezone?: string;\n  addressLine1?: string | null;\n  addressLine2?: string | null;\n  city?: string | null;\n  country?: string | null;\n  phone?: string | null;\n  email?: string | null;\n  website?: string | null;\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {\n  return prisma.schoolSettings.update({ where: { id: 'singleton' }, data: input });\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"1921163e-32be-4c5c-99f3-b230ef406493","uuid":"a4259427-1863-4f8f-b82d-7f7024b23679","timestamp":"2026-11-04T14:55:26.342Z",