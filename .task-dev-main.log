uiz/analytics.ts\"\n      ],\n      \"dependencies\": [\n        \"TASK-1\",\n        \"TASK-3\"\n      ],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\n        \"FR-26\",\n        \"FR-27\"\n      ]\n    },\n    {\n      \"id\": \"TASK-10\",\n      \"description\": \"maintenance.ts: autoSubmitExpiredAttempts(now) (IN_PROGRESS, deadlineAt < now-30s, cap 200, submitAttempt auto) and sendAfterCloseResultsReleased(now) (claim resultsReleasedAt null->now, notify only when count=1). Wire both into internal email dispatch route after sendDueReminders, each in own try/catch + logger.error.\",\n      \"files\": [\n        \"src/server/quiz/maintenance.ts\",\n        \"src/app/api/internal/email/dispatch/route.ts\"\n      ],\n      \"dependencies\": [\n        \"TASK-5\",\n        \"TASK-7\"\n      ],\n      \"estimateHours\": 1.5,\n      \"requirementIds\": [\n        \"FR-18\",\n        \"FR-30\",\n        \"FR-35\"\n      ]\n    },\n    {\n      \"id\": \"TASK-11\",\n      \"description\": \"Quiz & question CRUD route handlers (thin: withHandler -> requireUser/requireRole -> Zod -> one service call -> ok/paginated), shapes per api-contracts.json.\",\n      \"files\": [\n        \"src/app/api/courses/[id]/quizzes/route.ts\",\n        \"src/app/api/quizzes/[id]/route.ts\",\n        \"src/app/api/quizzes/[id]/questions/route.ts\",\n        \"src/app/api/quizzes/[id]/questions/reorder/route.ts\",\n        \"src/app/api/questions/[id]/route.ts\"\n      ],\n      \"dependencies\": [\n        \"TASK-2\",\n        \"TASK-8\"\n      ],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\n        \"FR-31\",\n        \"FR-6\",\n        \"FR-7\",\n        \"FR-9\",\n        \"FR-10\",\n        \"NFR-5\",\n        \"NFR-6\"\n      ]\n    },\n    {\n      \"id\": \"TASK-12\",\n      \"description\": \"Teacher action route handlers: regrade, release-results, analytics (?format=csv -> text/csv), accommodations PUT.\",\n      \"files\": [\n        \"src/app/api/quizzes/