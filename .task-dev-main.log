{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S1WLGNbgjvq5JiDVnGnyq6","type":"tool_result","content":"1\timport Card from '@mui/material/Card';\n2\timport CardContent from '@mui/material/CardContent';\n3\timport Stack from '@mui/material/Stack';\n4\timport Typography from '@mui/material/Typography';\n5\timport Chip from '@mui/material/Chip';\n6\timport Box from '@mui/material/Box';\n7\t\n8\texport interface StatCardProps {\n9\t  label: string;\n10\t  value: string | number;\n11\t  delta?: { value: string; direction: 'up' | 'down' | 'flat' };\n12\t  icon?: React.ReactNode;\n13\t}\n14\t\n15\tconst DELTA_COLOR: Record<'up' | 'down' | 'flat', 'success' | 'error' | 'default'> = {\n16\t  up: 'success',\n17\t  down: 'error',\n18\t  flat: 'default',\n19\t};\n20\t\n21\texport function StatCard({ label, value, delta, icon }: StatCardProps) {\n22\t  return (\n23\t    <Card variant=\"outlined\">\n24\t      <CardContent>\n25\t        <Stack direction=\"row\" alignItems=\"flex-start\" justifyContent=\"space-between\">\n26\t          <Stack spacing={0.5}>\n27\t            <Typography variant=\"body2\" color=\"text.secondary\">\n28\t              {label}\n29\t            </Typography>\n30\t            <Typography variant=\"h4\" fontWeight={600}>\n31\t              {value}\n32\t            </Typography>\n33\t            {delta && <Chip size=\"small\" label={delta.value} color={DELTA_COLOR[delta.direction]} />}\n34\t          </Stack>\n35\t          {icon && <Box sx={{ color: 'primary.main' }}>{icon}</Box>}\n36\t        </Stack>\n37\t      </CardContent>\n38\t    </Card>\n39\t  );\n40\t}\n41\t"}]},"parent_tool_use_id":null,"session_id":"43ee4874-357a-422b-8be6-0da1e9096cfe","uuid":"a200d89e-a286-4ed4-8ad3-985abe228412","timestamp":"2026-10-16T15:28:24.156Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/StatCard/StatCard.tsx","content":"import Card from '@mui/material/Card';\nimport CardContent from '@mui/material/CardContent';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Chip from '@mui/material/Chip';\nimport Box from '@mui/material/Box';\n\nexport interface StatCardProps {\n  label: string;\n  value: string | number;\n  delta?: { value: string; direction: 'up' | 'down' | 'flat' };\n  icon?: React.ReactNode;\n}\n\nconst DELTA_COLOR: Record<'up' | 'down' | 'flat', 'success' | 'error' | 'default'> = {\n  up: 'success',\n  down: 'error',\n  flat: 'default',\n};\n\nexport function StatCard({ label, value, delta, icon }: StatCardProps) {\n  return (\n    <Card variant=\"outlined\">\n      <CardContent>\n        <Stack direction=\"row\" alignItems=\"flex-start\" justifyContent=\"space-between\">\n          <Stack spacing={0.5}>\n            <Typography variant=\"body2\" color=\"text.secondary\">\n              {label}\n            </Typography>\n            <Typography variant=\"h4\" fontWeight={600}>\n              {value}\n            </Typography>\n            {delta && <Chip size=\"small\" label={delta.value} color={DELTA_COLOR[delta.direction]} />}\n          </Stack>\n          {icon && <Box sx={{ color: 'primary.main' }}>{icon}</Box>}\n        </Stack>\n      </CardContent>\n    </Card>\n  );\n}\n","numLines":41,"startLine":1,"totalLines":41}}}
