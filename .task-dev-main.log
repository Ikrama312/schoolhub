{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016AVwwBMUypxJ2tWog88Q4B","type":"tool_result","content":"1\timport { Prisma, type AssignmentStatus, type FileObject, type SubmissionType } from '@prisma/client';\n2\timport { prisma } from '@/server/db';\n3\timport { AppError } from '@/server/http';\n4\timport { audit } from '@/server/audit';\n5\timport { assertCanManageCourse, assertCanViewCourse } from '@/server/auth/course-access';\n6\timport { assertCanViewStudent, type AccessUser } from '@/server/auth/student-access';\n7\timport { canSeeDrafts, isVisible } from '@/server/content/visibility';\n8\timport { notify, notifyStudentAndParents } from '@/server/notifications/notify';\n9\timport { attachFiles, detachFiles } from '@/server/files/files-service';\n10\timport { extOf } from '@/server/files/validate';\n11\timport { readFile, saveFile } from '@/server/storage';\n12\timport { formatInSchoolTz } from '@/lib/dates';\n13\timport { logger } from '@/lib/logger';\n14\timport {\n15\t  assignmentInput,\n16\t  type AssignmentInput,\n17\t  type AssignmentPatch,\n18\t  type GradeInput,\n19\t  type OfflineGradeInput,\n20\t  type RubricCriterionValues,\n21\t} from '@/lib/validators/assignments';\n22\timport {\n23\t  computeFinalScore,\n24\t  dec,\n25\t  fixed2,\n26\t  lateDays as computeLateDays,\n27\t  maxRawScore,\n28\t  submissionChipStatus,\n29\t  type ChipStatus,\n30\t} from './grading-math';\n31\t\n32\t/**\n33\t * PRD-09 assignments service (system-design §2.2, NFR-8). All assignment/submission DB logic\n34\t * lives here; route handlers and server pages stay thin. \"now\" is always the server clock (NFR-2).\n35\t *\n36\t * Privacy (NFR-4): student/parent paths scope by resolveViewedStudent and every submission they\n37\t * receive goes through toStudentSubmission.\n38\t */\n39\t\n40\ttype Tx = Prisma.TransactionClient;\n41\ttype Group = 'UPCOMING' | 'MISSING' | 'SUBMITTED' | 'RETURNED' | 'CLOSED';\n42\t\n43\tconst fullName = (u: { firstName: string; lastName: string }) => `${u.firstName} ${u.lastName}`;\n44\tconst userRef = (u: { id: string; firstName: string; lastName: string } | null) => (u ? { id: u.id, name: fullName(u) } : null);\n45\tconst fileRef = (f: Pick<FileObject, 'id' | 'originalName' | 'mimeType' | 'sizeBytes'>) => ({\n46\t  id: f.id,\n47\t  filename: f.originalName,\n48\t  mimeType: f.mimeType,\n49\t  size: f.sizeBytes,\n50\t});\n51\tconst iso = (d: Date | null) => (d ? d.toISOString() : null);\n52\t/** Prisma.Decimal → \"14.40\" on the way out (NFR-1, D5). */\n53\texport const serializeDecimal = (d: Prisma.Decimal | null) => (d === null ? null : fixed2(d));\n54\t/** \"18.00\" → \"18\", \"14.40\" stays — for human copy like \"18/20\". */\n55\tconst pts = (d: Prisma.Decimal | string) => fixed2(d).replace(/\\.00$/, '');\n56\t\n57\texport async function getSchoolTimezone(): Promise<string> {\n58\t  return (await prisma.schoolSettings.findUnique({ where: { id: 'singleton' }, select: { timezone: true } }))?.timezone ?? 'UTC';\n59\t}\n60\t\n61\tconst notFound = () => new AppError('NOT_FOUND', 'Assignment not found');\n62\t\n63\t// ---------------------------------------------------------------------------\n64\t// Visibility (FR-13, FR-52, FR-60)\n65\t// ---------------------------------------------------------------------------\n66\t\n67\ttype VisibilityFields = { status: AssignmentStatus; availableFrom: Date | null; archivedAt: Date | null };\n68\t\n69\texport function isAssignmentVisible(a: VisibilityFields, now: Date): boolean {\n70\t  return !a.archivedAt && isVisible({ status: a.status, publishAt: a.availableFrom }, now);\n71\t}\n72\t\n73\texport function visibleWhere(now: Date): Prisma.AssignmentWhereInput {\n74\t  return { archivedAt: null, OR: [{ status: 'PUBLISHED' }, { status: 'SCHEDULED', availableFrom: { lte: now } }] };\n75\t}\n76\t\n77\t/** Visible, past due, not NO_SUBMISSION, and this student has no submission and no exemption. */\n78\texport function missingWhere(now: Date, studentId: string): Prisma.AssignmentWhereInput {\n79\t  return {\n80\t    AND: [\n81\t      visibleWhere(now),\n82\t      {\n83\t        dueAt: { lt: now },\n84\t        submissionType: { not: 'NO_SUBMISSION' },\n85\t        submissions: { none: { studentId } },\n86\t        exemptions: { none: { studentId } },\n87\t      },\n88\t    ],\n89\t  };\n90\t}\n91\t\n92\t/** Server-computed list group; first match wins (api-contracts StudentAssignmentRow). */\n93\tfunction groupOf(\n94\t  a: { dueAt: Date; submissionType: SubmissionType },\n95\t  sub: { status: string } | null,\n96\t  exempt: boolean,\n97\t  now: Date,\n98\t): Group {\n99\t  if (sub?.status === 'RETURNED') return 'RETURNED';\n100\t  if (sub) return 'SUBMITTED';\n101\t  if (a.dueAt > now) return 'UPCOMING';\n102\t  if (!exempt && a.submissionType !== 'NO_SUBMISSION') return 'MISSING';\n103\t  return 'CLOSED';\n104\t}\n105\t\n106\t// ---------------------------------------------------------------------------\n107\t// Serializers\n108\t// ---------------------------------------------------------------------------\n109\t\n110\tconst assignmentInclude = {\n111\t  course: { select: { id: true, name: true, teacherId: true, coTeacherIds: true } },\n112\t  rubric: { include: { criteria: { orderBy: { order: 'asc' } } } },\n113\t  attachments: { include: { file: true } },\n114\t} satisfies Prisma.AssignmentInclude;\n115\ttype FullAssignment = Prisma.AssignmentGetPayload<{ include: typeof assignmentInclude }>;\n116\ttype AssignmentRow = Prisma.AssignmentGetPayload<{ include: { course: { select: { name: true } } } }> | FullAssignment;\n117\t\n118\ttype Level = { label: string; points: string; description?: string };\n119\t\n120\tfunction toSummary(a: AssignmentRow) {\n121\t  return {\n122\t    id: a.id,\n123\t    courseId: a.courseId,\n124\t    courseName: a.course.name,\n125\t    title: a.title,\n126\t    submissionType: a.submissionType,\n127\t    maxPoints: fixed2(a.maxPoints),\n128\t    dueAt: a.dueAt.toISOString(),\n129\t    availableFrom: iso(a.availableFrom),\n130\t    status: a.status,\n131\t    archivedAt: iso(a.archivedAt),\n132\t    hasRubric: a.rubricId !== null,\n133\t  };\n134\t}\n135\texport type AssignmentSummary = ReturnType<typeof toSummary>;\n136\t\n137\tfunction toAssignment(a: FullAssignment) {\n138\t  return {\n139\t    ...toSummary(a),\n140\t    instructions: a.instructions,\n141\t    allowLate: a.allowLate,\n142\t    lateCutoffAt: iso(a.lateCutoffAt),\n143\t    latePenaltyPercentPerDay: fixed2(a.latePenaltyPercentPerDay),\n144\t    maxLatePenaltyPercent: fixed2(a.maxLatePenaltyPercent),\n145\t    maxFileCount: a.maxFileCount,\n146\t    allowExtraCredit: a.allowExtraCredit,\n147\t    rubric: a.rubric\n148\t      ? a.rubric.criteria.map((c) => ({\n149\t          id: c.id,\n150\t          order: c.order,\n151\t          title: c.title,\n152\t          description: c.description ?? '',\n153\t          maxPoints: fixed2(c.maxPoints),\n154\t          levels: (c.levels as Level[]).map((l) => ({ label: l.label, points: fixed2(l.points), description: l.description ?? '' })),\n155\t        }))\n156\t      : null,\n157\t    attachments: a.attachments.map((x) => fileRef(x.file)),\n158\t    createdAt: a.createdAt.toISOString(),\n159\t    updatedAt: a.updatedAt.toISOString(),\n160\t  };\n161\t}\n162\texport type AssignmentDto = ReturnType<typeof toAssignment>;\n163\t\n164\tconst submissionInclude = {\n165\t  student: { select: { id: true, firstName: true, lastName: true } },\n166\t  gradedBy: { select: { id: true, firstName: true, lastName: true } },\n167\t  files: { include: { file: true } },\n168\t} satisfies Prisma.SubmissionInclude;\n169\ttype FullSubmission = Prisma.SubmissionGetPayload<{ include: typeof submissionInclude }>;\n170\ttype RubricScore = { criterionId: string; points: string; comment?: string };\n171\t\n172\tfunction toSubmission(s: FullSubmission) {\n173\t  return {\n174\t    id: s.id,\n175\t    assignmentId: s.assignmentId,\n176\t    student: userRef(s.student)!,\n177\t    status: s.status,\n178\t    attemptNumber: s.attemptNumber,\n179\t    text: s.text,\n180\t    files: s.files.map((f) => fileRef(f.file)),\n181\t    submittedAt: s.submittedAt.toISOString(),\n182\t    isLate: s.isLate,\n183\t    lateDays: s.lateDays,\n184\t    rawScore: serializeDecimal(s.rawScore),\n185\t    penaltyPercent: serializeDecimal(s.penaltyPercent),\n186\t    finalScore: serializeDecimal(s.finalScore),\n187\t    rubricScores: (s.rubricScores as RubricScore[] | null) ?? null,\n188\t    feedback: s.feedback,\n189\t    gradedBy: userRef(s.gradedBy),\n190\t    gradedAt: iso(s.gradedAt),\n191\t    returnedAt: iso(s.returnedAt),\n192\t    history: undefined as SubmissionAttempt[] | undefined,\n193\t  };\n194\t}\n195\texport type SubmissionDto = ReturnType<typeof toSubmission>;\n196\texport type SubmissionAttempt = { attemptNumber: number; text: string | null; files: ReturnType<typeof fileRef>[]; submittedAt: string };\n197\t\n198\t/** FR-27, NFR-4: grade fields are null until RETURNED; history is never sent to students/parents. */\n199\texport function toStudentSubmission(s: SubmissionDto): SubmissionDto {\n200\t  const { history: _history, ...rest } = s;\n201\t  if (s.status === 'RETURNED') return rest as SubmissionDto;\n202\t  return {\n203\t    ...rest,\n204\t    rawScore: null,\n205\t    penaltyPercent: null,\n206\t    finalScore: null,\n207\t    feedback: null,\n208\t    rubricScores: null,\n209\t    gradedBy: null,\n210\t    gradedAt: null,\n211\t  } as SubmissionDto;\n212\t}\n213\t\n214\ttype SummarySub = { id: string; status: 'SUBMITTED' | 'RETURNED'; attemptNumber: number; submittedAt: Date; isLate: boolean; finalScore: Prisma.Decimal | null; returnedAt: Date | null };\n215\t\n216\tfunction toStudentRow(a: AssignmentRow, sub: SummarySub | null, exempt: boolean, now: Date, fullGrades = false) {\n217\t  return {\n218\t    assignment: toSummary(a),\n219\t    group: groupOf(a, sub, exempt, now),\n220\t    exempt,\n221\t    submission: sub\n222\t      ? {\n223\t          id: sub.id,\n224\t          status: sub.status,\n225\t          attemptNumber: sub.attemptNumber,\n226\t          submittedAt: sub.submittedAt.toISOString(),\n227\t          isLate: sub.isLate,\n228\t          finalScore: fullGrades || sub.status === 'RETURNED' ? serializeDecimal(sub.finalScore) : null,\n229\t          returnedAt: iso(sub.returnedAt),\n230\t        }\n231\t      : null,\n232\t  };\n233\t}\n234\texport type StudentAssignmentRow = ReturnType<typeof toStudentRow>;\n235\t\n236\tconst summarySubSelect = {\n237\t  id: true,\n238\t  status: true,\n239\t  attemptNumber: true,\n240\t  submittedAt: true,\n241\t  isLate: true,\n242\t  finalScore: true,\n243\t  returnedAt: true,\n244\t} satisfies Prisma.SubmissionSelect;\n245\t\n246\t// ---------------------------------------------------------------------------\n247\t// Viewer resolution (FR-18, FR-38, FR-57)\n248\t// ---------------------------------------------------------------------------\n249\t\n250\t/**\n251\t * STUDENT → self. PARENT → studentId must be a linked child; without one, the first linked child\n252\t * (preferring one ACTIVE in courseId when given). Anyone else → FORBIDDEN.\n253\t */\n254\texport async function resolveViewedStudent(user: AccessUser, studentId?: string, courseId?: string) {\n255\t  if (user.role === 'STUDENT') {\n256\t    if (studentId && studentId !== user.id) throw new AppError('FORBIDDEN', 'You can only view your own assignments.');\n257\t    return { studentId: user.id, children: [] as { id: string; name: string }[] };\n258\t  }\n259\t  if (user.role === 'PARENT') {\n260\t    const links = await prisma.parentStudentLink.findMany({\n261\t      where: { parentId: user.id },\n262\t      select: {\n263\t        student: {\n264\t          select: {\n265\t            id: true,\n266\t            firstName: true,\n267\t            lastName: true,\n268\t            enrollments: courseId ? { where: { courseId, status: 'ACTIVE' }, select: { id: true } } : undefined,\n269\t          },\n270\t        },\n271\t      },\n272\t      orderBy: [{ isPrimary: 'desc' }, { createdAt: 'asc' }],\n273\t    });\n274\t    const students = links.map((l) => l.student);\n275\t    const children = students.map((s) => userRef(s)!);\n276\t    if (studentId) {\n277\t      if (!children.some((c) => c.id === studentId)) throw new AppError('FORBIDDEN', 'That student is not linked to your account.');\n278\t      return { studentId, children };\n279\t    }\n280\t    const pick = (courseId ? students.find((s) => s.enrollments?.length) : undefined) ?? students[0];\n281\t    if (!pick) throw new AppError('FORBIDDEN', 'No linked students.');\n282\t    return { studentId: pick.id, children };\n283\t  }\n284\t  throw new AppError('FORBIDDEN', 'You do not have permission to view this.');\n285\t}\n286\t\n287\t// ---------------------------------------------------------------------------\n288\t// publishOnce (FR-42)\n289\t// ---------------------------------------------------------------------------\n290\t\n291\t/** Sends assignment.published exactly once, guarded by an atomic notifiedAt claim. */\n292\texport async function publishOnce(id: string, now = new Date()): Promise<void> {\n293\t  const a = await prisma.assignment.findUnique({\n294\t    where: { id },\n295\t    select: { id: true, title: true, courseId: true, status: true, availableFrom: true, archivedAt: true, notifiedAt: true, dueAt: true, course: { select: { name: true } } },\n296\t  });\n297\t  if (!a || a.notifiedAt || !isAssignmentVisible(a, now)) return;\n298\t  const { count } = await prisma.assignment.updateMany({ where: { id, notifiedAt: null }, data: { notifiedAt: now } });\n299\t  if (count !== 1) return;\n300\t  const [students, tz] = await Promise.all([\n301\t    prisma.enrollment.findMany({ where: { courseId: a.courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n302\t    getSchoolTimezone(),\n303\t  ]);\n304\t  await notify({\n305\t    type: 'assignment.published',\n306\t    userIds: students.map((s) => s.studentId),\n307\t    title: `New assignment: ${a.title}`,\n308\t    body: `${a.course.name} — due ${formatInSchoolTz(a.dueAt, 'EEE d MMM yyyy, HH:mm', tz)}`,\n309\t    link: `/courses/${a.courseId}/assignments/${a.id}`,\n310\t  });\n311\t}\n312\t\n313\t/** Read-path trigger for SCHEDULED rows that became visible (fire-and-forget, never fails the read). */\n314\tfunction publishNewlyVisible(rows: (VisibilityFields & { id: string; notifiedAt: Date | null })[], now: Date) {\n315\t  for (const a of rows) {\n316\t    if (a.status === 'SCHEDULED' && !a.notifiedAt && isAssignmentVisible(a, now)) {\n317\t      void publishOnce(a.id, now).catch((error) =>\n318\t        logger.error('publishOnce failed', { assignmentId: a.id, message: error instanceof Error ? error.message : String(error) }),\n319\t      );\n320\t    }\n321\t  }\n322\t}\n323\t\n324\t// ---------------------------------------------------------------------------\n325\t// Authoring: create / update / delete / duplicate (FR-11..FR-15, FR-49, FR-51)\n326\t// ---------------------------------------------------------------------------\n327\t\n328\tasync function loadFull(id: string, db: Tx = prisma): Promise<FullAssignment> {\n329\t  const a = await db.assignment.findUnique({ where: { id }, include: assignmentInclude });\n330\t  if (!a) throw notFound();\n331\t  return a;\n332\t}\n333\t\n334\tfunction scalarFields(input: AssignmentInput) {\n335\t  return {\n336\t    title: input.title,\n337\t    instructions: input.instructions,\n338\t    submissionType: input.submissionType,\n339\t    maxPoints: input.maxPoints,\n340\t    dueAt: input.dueAt,\n341\t    availableFrom: input.availableFrom ?? null,\n342\t    allowLate: input.allowLate,\n343\t    lateCutoffAt: input.allowLate ? input.lateCutoffAt ?? null : null,\n344\t    latePenaltyPercentPerDay: input.latePenaltyPercentPerDay,\n345\t    maxLatePenaltyPercent: input.maxLatePenaltyPercent,\n346\t    maxFileCount: input.maxFileCount,\n347\t    allowExtraCredit: input.allowExtraCredit,\n348\t    status: input.status,\n349\t  };\n350\t}\n351\t\n352\t/** FR-12: SCHEDULED needs availableFrom in the future, by the server clock (NFR-2). */\n353\tfunction assertSchedule(input: Pick<AssignmentInput, 'status' | 'availableFrom'>, now: Date) {\n354\t  if (input.status === 'SCHEDULED' && (!input.availableFrom || input.availableFrom <= now)) {\n355\t    throw new AppError('VALIDATION_ERROR', 'The scheduled time must be in the future.', {\n356\t      fieldErrors: { availableFrom: ['The scheduled time must be in the future.'] },\n357\t    });\n358\t  }\n359\t}\n360\t\n361\t/** Upsert criteria by id (keeps rubricScores' criterionIds valid), delete the rest. Returns the rubric id. */\n362\tasync function writeRubric(tx: Tx, rubricId: string | null, criteria: RubricCriterionValues[]): Promise<string> {\n363\t  const id = rubricId ?? (await tx.rubric.create({ data: {} })).id;\n364\t  const existing = rubricId ? await tx.rubricCriterion.findMany({ where: { rubricId }, select: { id: true } }) : [];\n365\t  const keep = new Set(criteria.map((c) => c.id).filter((cid): cid is string => !!cid && existing.some((e) => e.id === cid)));\n366\t  await tx.rubricCriterion.deleteMany({ where: { rubricId: id, id: { notIn: [...keep] } } });\n367\t  for (const [order, c] of criteria.entries()) {\n368\t    const data = {\n369\t      title: c.title,\n370\t      description: c.description || null,\n371\t      maxPoints: c.maxPoints,\n372\t      order,\n373\t      levels: c.levels as unknown as Prisma.InputJsonValue,\n374\t    };\n375\t    if (c.id && keep.has(c.id)) await tx.rubricCriterion.update({ where: { id: c.id }, data });\n376\t    else await tx.rubricCriterion.create({ data: { ...data, rubricId: id } });\n377\t  }\n378\t  return id;\n379\t}\n380\t\n381\tasync function assertFileContext(tx: Tx, fileIds: string[], context: string) {\n382\t  if (fileIds.length === 0) return;\n383\t  const wrong = await tx.fileObject.findMany({ where: { id: { in: fileIds }, context: { not: context } }, select: { id: true } });\n384\t  if (wrong.length) {\n385\t    throw new AppError('VALIDATION_ERROR', 'One or more files cannot be attached.', { fileIds: wrong.map((f) => f.id) });\n386\t  }\n387\t}\n388\t\n389\t/** Diff attachments: removed → detached (purge reclaims them), added → context-checked and attached. */\n390\tasync function setAttachments(tx: Tx, user: AccessUser, assignmentId: string, current: string[], next: string[]) {\n391\t  const wanted = [...new Set(next)];\n392\t  const removed = current.filter((id) => !wanted.includes(id));\n393\t  const added = wanted.filter((id) => !current.includes(id));\n394\t  if (removed.length) {\n395\t    await tx.assignmentAttachment.deleteMany({ where: { assignmentId, fileId: { in: removed } } });\n396\t    await detachFiles(tx, removed);\n397\t  }\n398\t  if (added.length) {\n399\t    await assertFileContext(tx, added, 'assignment');\n400\t    await attachFiles(tx, user, added, 'assignment', assignmentId);\n401\t    await tx.assignmentAttachment.createMany({ data: added.map((fileId) => ({ assignmentId, fileId })) });\n402\t  }\n403\t}\n404\t\n405\tasync function publishAfterCommit(id: string) {\n406\t  try {\n407\t    await publishOnce(id);\n408\t  } catch (error) {\n409\t    logger.error('publishOnce failed', { assignmentId: id, message: error instanceof Error ? error.message : String(error) });\n410\t  }\n411\t}\n412\t\n413\texport async function createAssignment(user: AccessUser, courseId: string, input: AssignmentInput, request?: Request) {\n414\t  await assertCanManageCourse(user, courseId);\n415\t  assertSchedule(input, new Date());\n416\t  const id = await prisma.$transaction(async (tx) => {\n417\t    const rubricId = input.rubric?.length ? await writeRubric(tx, null, input.rubric) : null;\n418\t    const a = await tx.assignment.create({ data: { ...scalarFields(input), courseId, rubricId, createdById: user.id } });\n419\t    await setAttachments(tx, user, a.id, [], input.attachmentFileIds);\n420\t    return a.id;\n421\t  });\n422\t  await audit({ actorId: user.id, action: 'assignment.create', entityType: 'Assignment', entityId: id, metadata: { courseId, status: input.status }, request });\n423\t  await publishAfterCommit(id);\n424\t  return toAssignment(await loadFull(id));\n425\t}\n426\t\n427\t/** Current row → validator input shape, so a PATCH is validated as a whole (same superRefine). */\n428\tfunction asInput(a: FullAssignment) {\n429\t  const dto = toAssignment(a);\n430\t  return {\n431\t    ...dto,\n432\t    rubric: dto.rubric?.map(({ order: _order, ...c }) => c) ?? null,\n433\t    attachmentFileIds: dto.attachments.map((f) => f.id),\n434\t  };\n435\t}\n436\t\n437\texport async function updateAssignment(user: AccessUser, id: string, patch: AssignmentPatch, request?: Request) {\n438\t  const existing = await loadFull(id);\n439\t  await assertCanManageCourse(user, existing.courseId);\n440\t  const merged = assignmentInput.parse({ ...asInput(existing), ...stripUndefined(patch) });\n441\t  const scheduleChanged =\n442\t    merged.status === 'SCHEDULED' &&\n443\t    (existing.status !== 'SCHEDULED' || existing.availableFrom?.getTime() !== merged.availableFrom?.getTime());\n444\t  if (scheduleChanged) assertSchedule(merged, new Date());\n445\t\n446\t  await prisma.$transaction(async (tx) => {\n447\t    let rubricId = existing.rubricId;\n448\t    if (patch.rubric !== undefined) {\n449\t      if (merged.rubric?.length) {\n450\t        rubricId = await writeRubric(tx, existing.rubricId, merged.rubric);\n451\t      } else if (existing.rubricId) {\n452\t        rubricId = null;\n453\t      }\n454\t    }\n455\t    await tx.assignment.update({ where: { id }, data: { ...scalarFields(merged), rubricId } });\n456\t    if (existing.rubricId && rubricId === null) await tx.rubric.delete({ where: { id: existing.rubricId } });\n457\t    if (patch.attachmentFileIds !== undefined) {\n458\t      await setAttachments(tx, user, id, existing.attachments.map((x) => x.fileId), merged.attachmentFileIds);\n459\t    }\n460\t  });\n461\t  await audit({\n462\t    actorId: user.id,\n463\t    action: 'assignment.update',\n464\t    entityType: 'Assignment',\n465\t    entityId: id,\n466\t    metadata: { fields: Object.keys(stripUndefined(patch)) },\n467\t    request,\n468\t  });\n469\t  await publishAfterCommit(id);\n470\t  const [a, submissionCount] = await Promise.all([loadFull(id), prisma.submission.count({ where: { assignmentId: id, attemptNumber: { gt: 0 } } })]);\n471\t  return { ...toAssignment(a), submissionCount };\n472\t}\n473\t\n474\tfunction stripUndefined<T extends object>(o: T): Partial<T> {\n475\t  return Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined)) as Partial<T>;\n476\t}\n477\t\n478\t/** FR-51: hard delete with no submissions, otherwise archive. */\n479\texport async function deleteOrArchiveAssignment(user: AccessUser, id: string, request?: Request) {\n480\t  const a = await loadFull(id);\n481\t  await assertCanManageCourse(user, a.courseId);\n482\t  const submissions = await prisma.submission.count({ where: { assignmentId: id } });\n483\t  let result: 'deleted' | 'archived';\n484\t  if (submissions === 0) {\n485\t    await prisma.$transaction(async (tx) => {\n486\t      await detachFiles(tx, a.attachments.map((x) => x.fileId));\n487\t      await tx.assignment.delete({ where: { id } });\n488\t      if (a.rubricId) await tx.rubric.delete({ where: { id: a.rubricId } });\n489\t    });\n490\t    result = 'deleted';\n491\t  } else {\n492\t    await prisma.assignment.update({ where: { id }, data: { archivedAt: a.archivedAt ?? new Date() } });\n493\t    result = 'archived';\n494\t  }\n495\t  await audit({ actorId: user.id, action: result === 'deleted' ? 'assignment.delete' : 'assignment.archive', entityType: 'Assignment', entityId: id, metadata: { courseId: a.courseId, title: a.title }, request });\n496\t  return { id, result };\n497\t}\n498\t\n499\t/** FR-15: copy as DRAFT; rubric as new rows; attachment bytes re-saved as new FileObjects (B2). */\n500\texport async function duplicateAssignment(user: AccessUser, id: string, courseIds: string[], request?: Request) {\n501\t  const src = await loadFull(id);\n502\t  await assertCanManageCourse(user, src.courseId);\n503\t  const targets = [...new Set(courseIds)];\n504\t  for (const courseId of targets) await assertCanManageCourse(user, courseId);\n505\t\n506\t  const input = assignmentInput.parse({ ...asInput(src), status: 'DRAFT' });\n507\t  const created: { courseId: string; assignmentId: string }[] = [];\n508\t  for (const courseId of targets) {\n509\t    // Bytes are copied outside the transaction; if it fails the copies stay unattached and the purge reclaims them.\n510\t    const fileIds: string[] = [];\n511\t    for (const { file } of src.attachments) {\n512\t      const saved = await saveFile(readFile(file.storageKey), { ext: extOf(file.originalName) });\n513\t      const copy = await prisma.fileObject.create({\n514\t        data: { ownerId: user.id, originalName: file.originalName, mimeType: file.mimeType, sizeBytes: saved.sizeBytes, storageKey: saved.storageKey, sha256: saved.sha256, context: 'assignment' },\n515\t      });\n516\t      fileIds.push(copy.id);\n517\t    }\n518\t    const assignmentId = await prisma.$transaction(async (tx) => {\n519\t      const rubricId = input.rubric?.length ? await writeRubric(tx, null, input.rubric.map(({ id: _id, ...c }) => c)) : null;\n520\t      const a = await tx.assignment.create({ data: { ...scalarFields(input), courseId, rubricId, createdById: user.id } });\n521\t      await setAttachments(tx, user, a.id, [], fileIds);\n522\t      return a.id;\n523\t    });\n524\t    created.push({ courseId, assignmentId });\n525\t    await audit({ actorId: user.id, action: 'assignment.duplicate', entityType: 'Assignment', entityId: assignmentId, metadata: { sourceId: id, courseId }, request });\n526\t  }\n527\t  return { created };\n528\t}\n529\t\n530\t/** Courses the user may author in, for the duplicate dialog. */\n531\texport async function listManagedCourses(user: AccessUser) {\n532\t  const where: Prisma.CourseWhereInput =\n533\t    user.role === 'ADMIN' ? { archivedAt: null } : { archivedAt: null, OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] };\n534\t  return prisma.course.findMany({ where, select: { id: true, name: true, code: true }, orderBy: { name: 'asc' } });\n535\t}\n536\t\n537\t// ---------------------------------------------------------------------------\n538\t// Submit (FR-22..FR-24, FR-53, FR-60)\n539\t// ---------------------------------------------------------------------------\n540\t\n541\tconst DEADLINE_PASSED = 'The deadline has passed and late submissions are closed.';\n542\tconst RETURNED_LOCKED = 'This submission has been returned and can no longer be changed.';\n543\t\n544\texport async function submit(user: AccessUser, assignmentId: string, input: { text?: string; fileIds: string[] }) {\n545\t  const now = new Date();\n546\t  const a = await prisma.assignment.findUnique({ where: { id: assignmentId } });\n547\t  // 1. visible\n548\t  if (!a || !isAssignmentVisible(a, now)) throw notFound();\n549\t  // 2. STUDENT, ACTIVE-enrolled\n550\t  if (user.role !== 'STUDENT') throw new AppError('FORBIDDEN', 'Only students can submit work.');\n551\t  const [enrolled, exempt] = await Promise.all([\n552\t    prisma.enrollment.findFirst({ where: { courseId: a.courseId, studentId: user.id, status: 'ACTIVE' }, select: { id: true } }),\n553\t    prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId, studentId: user.id } } }),\n554\t  ]);\n555\t  if (!enrolled) throw new AppError('FORBIDDEN', 'You are not enrolled in this course.');\n556\t  // 3. not exempt, takes submissions\n557\t  if (exempt) throw new AppError('VALIDATION_ERROR', 'You are exempt from this assignment.');\n558\t  if (a.submissionType === 'NO_SUBMISSION') throw new AppError('VALIDATION_ERROR', 'This assignment does not take online submissions.');\n559\t  // 4. deadline\n560\t  const open = now <= a.dueAt || (a.allowLate && (!a.lateCutoffAt || now <= a.lateCutoffAt));\n561\t  if (!open) throw new AppError('VALIDATION_ERROR', DEADLINE_PASSED);\n562\t  // 5. content matches the type\n563\t  const text = input.text?.trim() ? input.text : null;\n564\t  const fileIds = [...new Set(input.fileIds)];\n565\t  if (a.submissionType === 'ONLINE_TEXT' && (!text || fileIds.length)) throw new AppError('VALIDATION_ERROR', 'Enter your answer as text.');\n566\t  if (a.submissionType === 'FILE_UPLOAD' && fileIds.length === 0) throw new AppError('VALIDATION_ERROR', 'Attach at least one file.');\n567\t  if (a.submissionType === 'TEXT_AND_FILE' && !text && fileIds.length === 0) throw new AppError('VALIDATION_ERROR', 'Enter text or attach a file.');\n568\t  if (fileIds.length > a.maxFileCount) throw new AppError('VALIDATION_ERROR', `You can attach at most ${a.maxFileCount} files.`);\n569\t  const storedText = a.submissionType === 'FILE_UPLOAD' ? null : text;\n570\t\n571\t  const isLate = now > a.dueAt;\n572\t  const days = computeLateDays(now, a.dueAt);\n573\t\n574\t  const run = () =>\n575\t    prisma.$transaction(async (tx) => {\n576\t      const existing = await tx.submission.findUnique({\n577\t        where: { assignmentId_studentId: { assignmentId, studentId: user.id } },\n578\t        include: { files: { select: { fileId: true } } },\n579\t      });\n580\t      if (existing?.status === 'RETURNED') throw new AppError('CONFLICT', RETURNED_LOCKED);\n581\t      // 6. each file is mine, context 'submission', unattached or already on this submission (attachFiles checks the rest).\n582\t      await assertFileContext(tx, fileIds, 'submission');\n583\t\n584\t      let id: string;\n585\t      if (!existing) {\n586\t        id = (\n587\t          await tx.submission.create({\n588\t            data: { assignmentId, studentId: user.id, status: 'SUBMITTED', text: storedText, attemptNumber: 1, submittedAt: now, isLate, lateDays: days },\n589\t          })\n590\t        ).id;\n591\t      } else {\n592\t        id = existing.id;\n593\t        await tx.submissionHistory.create({\n594\t          data: { submissionId: id, attemptNumber: existing.attemptNumber, text: existing.text, fileIds: existing.files.map((f) => f.fileId), submittedAt: existing.submittedAt },\n595\t        });\n596\t        await tx.submission.update({\n597\t          where: { id },\n598\t          data: {\n599\t            text: storedText,\n600\t            attemptNumber: existing.attemptNumber + 1,\n601\t            submittedAt: now,\n602\t            isLate,\n603\t            lateDays: days,\n604\t            rawScore: null,\n605\t            penaltyPercent: null,\n606\t            finalScore: null,\n607\t            feedback: null,\n608\t            rubricScores: Prisma.DbNull,\n609\t            gradedById: null,\n610\t            gradedAt: null,\n611\t          },\n612\t        });\n613\t        // Old files stay attached to this submission id so history keeps its bytes (B1).\n614\t        await tx.submissionFile.deleteMany({ where: { submissionId: id } });\n615\t      }\n616\t      await attachFiles(tx, user, fileIds, 'submission', id);\n617\t      if (fileIds.length) await tx.submissionFile.createMany({ data: fileIds.map((fileId) => ({ submissionId: id, fileId })) });\n618\t      return { id, created: !existing };\n619\t    });\n620\t\n621\t  let result: { id: string; created: boolean };\n622\t  try {\n623\t    result = await run();\n624\t  } catch (error) {\n625\t    // Two concurrent first submits: the loser retries once as a resubmit.\n626\t    if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') result = await run();\n627\t    else throw error;\n628\t  }\n629\t  const sub = await prisma.submission.findUniqueOrThrow({ where: { id: result.id }, include: submissionInclude });\n630\t  return { submission: toStudentSubmission(toSubmission(sub)), created: result.created };\n631\t}\n632\t\n633\t// ---------------------------------------------------------------------------\n634\t// Grading (FR-30..FR-36, FR-56, FR-59)\n635\t// ---------------------------------------------------------------------------\n636\t\n637\ttype GradeTarget = {\n638\t  maxPoints: Prisma.Decimal;\n639\t  allowExtraCredit: boolean;\n640\t  rubric: { criteria: { id: string; title: string; maxPoints: Prisma.Decimal }[] } | null;\n641\t};\n642\t\n643\tconst invalid = (message: string) => new AppError('VALIDATION_ERROR', message);\n644\t\n645\t/** D7: with a rubric the server derives rawScore = Σ points; otherwise rawScore within maxRawScore (FR-36). */\n646\tfunction scoreFrom(a: GradeTarget, input: Pick<GradeInput, 'rawScore' | 'rubricScores'>) {\n647\t  const criteria = a.rubric?.criteria ?? [];\n648\t  if (criteria.length) {\n649\t    const scores = input.rubricScores ?? [];\n650\t    const byId = new Map(scores.map((s) => [s.criterionId, s]));\n651\t    if (byId.size !== scores.length) throw invalid('Each rubric criterion can be scored only once.');\n652\t    if (scores.some((s) => !criteria.some((c) => c.id === s.criterionId))) throw invalid('Unknown rubric criterion.');\n653\t    for (const c of criteria) {\n654\t      const s = byId.get(c.id);\n655\t      if (!s) throw invalid(`Score every rubric criterion (missing \"${c.title}\").`);\n656\t      if (dec(s.points).gt(dec(c.maxPoints))) throw invalid(`\"${c.title}\" is worth at most ${pts(c.maxPoints)} points.`);\n657\t    }\n658\t    const raw = scores.reduce((sum, s) => sum.plus(dec(s.points)), dec(0));\n659\t    const rubricScores: RubricScore[] = criteria.map((c) => {\n660\t      const s = byId.get(c.id)!;\n661\t      return { criterionId: c.id, points: s.points, ...(s.comment ? { comment: s.comment } : {}) };\n662\t    });\n663\t    return { raw: fixed2(raw), rubricScores: rubricScores as unknown as Prisma.InputJsonValue };\n664\t  }\n665\t  if (input.rawScore === undefined) throw invalid('Enter a raw score.');\n666\t  const max = maxRawScore(a.maxPoints, a.allowExtraCredit);\n667\t  if (dec(input.rawScore).gt(max)) throw invalid(`The raw score must be between 0 and ${pts(max.toString())}.`);\n668\t  return { raw: input.rawScore, rubricScores: Prisma.DbNull };\n669\t}\n670\t\n671\tconst gradingAssignmentSelect = {\n672\t  id: true,\n673\t  title: true,\n674\t  courseId: true,\n675\t  maxPoints: true,\n676\t  allowExtraCredit: true,\n677\t  course: { select: { name: true, teacherId: true, coTeacherIds: true } },\n678\t  rubric: { select: { criteria: { select: { id: true, title: true, maxPoints: true }, orderBy: { order: 'asc' } } } },\n679\t} satisfies Prisma.AssignmentSelect;\n680\ttype GradingAssignment = Prisma.AssignmentGetPayload<{ select: typeof gradingAssignmentSelect }>;\n681\t\n682\tasync function notifyReturned(a: GradingAssignment, studentId: string, finalScore: Prisma.Decimal | string | null) {\n683\t  await notifyStudentAndParents({\n684\t    type: 'assignment.returned',\n685\t    studentIds: [studentId],\n686\t    title: `Returned: ${a.title}`,\n687\t    body: `${a.course.name}: ${a.title} — ${finalScore === null ? '—' : pts(finalScore)}/${pts(a.maxPoints)}`,\n688\t    link: `/courses/${a.courseId}/assignments/${a.id}`,\n689\t  });\n690\t}\n691\t\n692\tasync function loadFullSubmission(id: string) {\n693\t  return prisma.submission.findUniqueOrThrow({ where: { id }, include: submissionInclude });\n694\t}\n695\t\n696\texport async function gradeSubmission(user: AccessUser, submissionId: string, input: GradeInput, request?: Request) {\n697\t  const sub = await prisma.submission.findUnique({\n698\t    where: { id: submissionId },\n699\t    select: { id: true, studentId: true, status: true, returnedAt: true, assignment: { select: gradingAssignmentSelect } },\n700\t  });\n701\t  if (!sub) throw new AppError('NOT_FOUND', 'Submission not found');\n702\t  const a = sub.assignment;\n703\t  await assertCanManageCourse(user, a.courseId);\n704\t  const { raw, rubricScores } = scoreFrom(a, input);\n705\t  const finalScore = computeFinalScore(raw, input.penaltyPercent).toFixed(2);\n706\t  const now = new Date();\n707\t  const returning = input.return && sub.status !== 'RETURNED';\n708\t\n709\t  await prisma.submission.update({\n710\t    where: { id: submissionId },\n711\t    data: {\n712\t      rawScore: raw,\n713\t      penaltyPercent: input.penaltyPercent,\n714\t      finalScore,\n715\t      rubricScores,\n716\t      feedback: input.feedback ?? null,\n717\t      gradedById: user.id,\n718\t      gradedAt: now,\n719\t      ...(returning ? { status: 'RETURNED' as const, returnedAt: now } : {}),\n720\t    },\n721\t  });\n722\t  await audit({ actorId: user.id, action: 'submission.grade', entityType: 'Submission', entityId: submissionId, metadata: { assignmentId: a.id, studentId: sub.studentId, finalScore }, request });\n723\t  if (returning) {\n724\t    await audit({ actorId: user.id, action: 'submission.return', entityType: 'Submission', entityId: submissionId, metadata: { assignmentId: a.id, studentId: sub.studentId }, request });\n725\t    await notifyReturned(a, sub.studentId, finalScore);\n726\t  }\n727\t  return toSubmission(await loadFullSubmission(submissionId));\n728\t}\n729\t\n730\t/** FR-32 \"Return all graded\". Default set = graded and not yet returned. */\n731\texport async function bulkReturn(user: AccessUser, assignmentId: string, submissionIds: string[] | undefined, request?: Request) {\n732\t  const a = await prisma.assignment.findUnique({ where: { id: assignmentId }, select: gradingAssignmentSelect });\n733\t  if (!a) throw notFound();\n734\t  await assertCanManageCourse(user, a.courseId);\n735\t\n736\t  const skipped: { submissionId: string; reason: 'NOT_GRADED' | 'ALREADY_RETURNED' | 'NOT_FOUND' }[] = [];\n737\t  const candidates = await prisma.submission.findMany({\n738\t    where: submissionIds ? { assignmentId, id: { in: submissionIds } } : { assignmentId, status: 'SUBMITTED', gradedAt: { not: null } },\n739\t    select: { id: true, studentId: true, status: true, gradedAt: true, finalScore: true },\n740\t  });\n741\t  if (submissionIds) {\n742\t    for (const id of new Set(submissionIds)) {\n743\t      const s = candidates.find((c) => c.id === id);\n744\t      if (!s) skipped.push({ submissionId: id, reason: 'NOT_FOUND' });\n745\t      else if (s.status === 'RETURNED') skipped.push({ submissionId: id, reason: 'ALREADY_RETURNED' });\n746\t      else if (!s.gradedAt) skipped.push({ submissionId: id, reason: 'NOT_GRADED' });\n747\t    }\n748\t  }\n749\t  const eligible = candidates.filter((s) => s.status === 'SUBMITTED' && s.gradedAt);\n750\t  const now = new Date();\n751\t  if (eligible.length) {\n752\t    await prisma.submission.updateMany({\n753\t      where: { id: { in: eligible.map((s) => s.id) }, status: 'SUBMITTED' },\n754\t      data: { status: 'RETURNED', returnedAt: now },\n755\t    });\n756\t  }\n757\t  for (const s of eligible) {\n758\t    await audit({ actorId: user.id, action: 'submission.return', entityType: 'Submission', entityId: s.id, metadata: { assignmentId, studentId: s.studentId, bulk: true }, request });\n759\t    await notifyReturned(a, s.studentId, s.finalScore);\n760\t  }\n761\t  return { returned: eligible.map((s) => s.id), skipped };\n762\t}\n763\t\n764\t/** FR-34, FR-8: attempt-0 submission for a student who did not submit. */\n765\texport async function gradeOffline(user: AccessUser, assignmentId: string, input: OfflineGradeInput, request?: Request) {\n766\t  const a = await prisma.assignment.findUnique({ where: { id: assignmentId }, select: gradingAssignmentSelect });\n767\t  if (!a) throw notFound();\n768\t  await assertCanManageCourse(user, a.courseId);\n769\t  const [enrolled, existing] = await Promise.all([\n770\t    prisma.enrollment.findFirst({ where: { courseId: a.courseId, studentId: input.studentId, status: 'ACTIVE' }, select: { id: true } }),\n771\t    prisma.submission.findUnique({ where: { assignmentId_studentId: { assignmentId, studentId: input.studentId } }, select: { id: true } }),\n772\t  ]);\n773\t  if (!enrolled) throw invalid('That student is not enrolled in this course.');\n774\t  if (existing) throw new AppError('CONFLICT', 'This student already has a submission; grade that one instead.');\n775\t  const { raw, rubricScores } = scoreFrom(a, input);\n776\t  const finalScore = computeFinalScore(raw, 0).toFixed(2);\n777\t  const now = new Date();\n778\t  const sub = await prisma.submission.create({\n779\t    data: {\n780\t      assignmentId,\n781\t      studentId: input.studentId,\n782\t      status: input.return ? 'RETURNED' : 'SUBMITTED',\n783\t      text: null,\n784\t      attemptNumber: 0,\n785\t      submittedAt: now,\n786\t      isLate: false,\n787\t      lateDays: 0,\n788\t      rawScore: raw,\n789\t      penaltyPercent: '0',\n790\t      finalScore,\n791\t      rubricScores,\n792\t      feedback: input.feedback ?? null,\n793\t      gradedById: user.id,\n794\t      gradedAt: now,\n795\t      returnedAt: input.return ? now : null,\n796\t    },\n797\t  });\n798\t  await audit({ actorId: user.id, action: 'submission.grade_offline', entityType: 'Submission', entityId: sub.id, metadata: { assignmentId, studentId: input.studentId, finalScore }, request });\n799\t  if (input.return) await notifyReturned(a, input.studentId, finalScore);\n800\t  return toSubmission(await loadFullSubmission(sub.id));\n801\t}\n802\t\n803\t/** FR-35: PUT upserts, DELETE removes; both idempotent. The row is the PRD-11 exclusion flag. */\n804\texport async function setExemption(\n805\t  user: AccessUser,\n806\t  assignmentId: string,\n807\t  studentId: string,\n808\t  exempt: boolean,\n809\t  reason?: string,\n810\t  request?: Request,\n811\t) {\n812\t  const a = await prisma.assignment.findUnique({ where: { id: assignmentId }, select: { courseId: true } });\n813\t  if (!a) throw notFound();\n814\t  await assertCanManageCourse(user, a.courseId);\n815\t  if (exempt) {\n816\t    const enrolled = await prisma.enrollment.findFirst({ where: { courseId: a.courseId, studentId, status: 'ACTIVE' }, select: { id: true } });\n817\t    if (!enrolled) throw invalid('That student is not enrolled in this course.');\n818\t    await prisma.gradeExemption.upsert({\n819\t      where: { assignmentId_studentId: { assignmentId, studentId } },\n820\t      update: { reason: reason ?? null },\n821\t      create: { assignmentId, studentId, reason: reason ?? null },\n822\t    });\n823\t  } else {\n824\t    await prisma.gradeExemption.deleteMany({ where: { assignmentId, studentId } });\n825\t  }\n826\t  await audit({ actorId: user.id, action: exempt ? 'assignment.exempt' : 'assignment.unexempt', entityType: 'Assignment', entityId: assignmentId, metadata: { studentId, reason }, request });\n827\t  return exempt ? { assignmentId, studentId, exempt: true as const, reason: reason ?? null } : { assignmentId, studentId, exempt: false as const };\n828\t}\n829\t\n830\t// ---------------------------------------------------------------------------\n831\t// Reads (FR-48, FR-50, FR-54, FR-55, FR-57, FR-58)\n832\t// ---------------------------------------------------------------------------\n833\t\n834\tasync function loadCourseForView(user: AccessUser, courseId: string) {\n835\t  await assertCanViewCourse(user, courseId);\n836\t  return prisma.course.findUniqueOrThrow({ where: { id: courseId }, select: { id: true, name: true, teacherId: true, coTeacherIds: true } });\n837\t}\n838\t\n839\texport async function listCourseAssignments(user: AccessUser, courseId: string, studentId?: string) {\n840\t  const course = await loadCourseForView(user, courseId);\n841\t  const now = new Date();\n842\t\n843\t  if (canSeeDrafts(user, course)) {\n844\t    const [assignments, roster] = await Promise.all([\n845\t      prisma.assignment.findMany({ where: { courseId }, include: { course: { select: { name: true } } }, orderBy: { dueAt: 'asc' } }),\n846\t      prisma.enrollment.findMany({ where: { courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n847\t    ]);\n848\t    const active = new Set(roster.map((r) => r.studentId));\n849\t    const ids = assignments.map((a) => a.id);\n850\t    const [subs, exemptions] = await Promise.all([\n851\t      prisma.submission.findMany({ where: { assignmentId: { in: ids } }, select: { assignmentId: true, studentId: true, status: true, gradedAt: true, attemptNumber: true } }),\n852\t      prisma.gradeExemption.findMany({ where: { assignmentId: { in: ids } }, select: { assignmentId: true, studentId: true } }),\n853\t    ]);\n854\t    const items = assignments.map((a) => {\n855\t      const mine = subs.filter((s) => s.assignmentId === a.id && active.has(s.studentId));\n856\t      const exempt = new Set(exemptions.filter((e) => e.assignmentId === a.id && active.has(e.studentId)).map((e) => e.studentId));\n857\t      const submittedIds = new Set(mine.map((s) => s.studentId));\n858\t      const pastDue = isAssignmentVisible(a, now) && a.dueAt < now && a.submissionType !== 'NO_SUBMISSION';\n859\t      return {\n860\t        ...toSummary(a),\n861\t        counts: {\n862\t          enrolled: active.size,\n863\t          submitted: mine.filter((s) => s.attemptNumber > 0).length,\n864\t          graded: mine.filter((s) => s.gradedAt).length,\n865\t          returned: mine.filter((s) => s.status === 'RETURNED').length,\n866\t          exempt: exempt.size,\n867\t          missing: pastDue ? [...active].filter((id) => !submittedIds.has(id) && !exempt.has(id)).length : 0,\n868\t        },\n869\t      };\n870\t    });\n871\t    return { view: 'manager' as const, items };\n872\t  }\n873\t\n874\t  const viewed = await resolveViewedStudent(user, studentId, courseId);\n875\t  const assignments = await prisma.assignment.findMany({\n876\t    where: { courseId, ...visibleWhere(now) },\n877\t    include: {\n878\t      course: { select: { name: true } },\n879\t      submissions: { where: { studentId: viewed.studentId }, select: summarySubSelect },\n880\t      exemptions: { where: { studentId: viewed.studentId }, select: { studentId: true } },\n881\t    },\n882\t    orderBy: { dueAt: 'asc' },\n883\t  });\n884\t  publishNewlyVisible(assignments, now);\n885\t  return {\n886\t    view: 'student' as const,\n887\t    studentId: viewed.studentId,\n888\t    children: viewed.children,\n889\t    items: assignments.map((a) => toStudentRow(a, a.submissions[0] ?? null, a.exemptions.length > 0, now)),\n890\t  };\n891\t}\n892\t\n893\texport async function getAssignment(user: AccessUser, id: string, studentId?: string) {\n894\t  const a = await loadFull(id);\n895\t  await assertCanViewCourse(user, a.courseId);\n896\t  const now = new Date();\n897\t  const serverNow = now.toISOString();\n898\t  if (canSeeDrafts(user, a.course)) {\n899\t    const submissionCount = await prisma.submission.count({ where: { assignmentId: id, attemptNumber: { gt: 0 } } });\n900\t    return { assignment: toAssignment(a), canManage: true as const, submissionCount, serverNow, submission: null, exempt: false, studentId: null };\n901\t  }\n902\t  if (!isAssignmentVisible(a, now)) throw notFound();\n903\t  publishNewlyVisible([a], now);\n904\t  const viewed = await resolveViewedStudent(user, studentId, a.courseId);\n905\t  const [sub, exemption] = await Promise.all([\n906\t    prisma.submission.findUnique({ where: { assignmentId_studentId: { assignmentId: id, studentId: viewed.studentId } }, include: submissionInclude }),\n907\t    prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: id, studentId: viewed.studentId } } }),\n908\t  ]);\n909\t  return {\n910\t    assignment: toAssignment(a),\n911\t    canManage: false as const,\n912\t    submissionCount: undefined,\n913\t    serverNow,\n914\t    submission: sub ? toStudentSubmission(toSubmission(sub)) : null,\n915\t    exempt: !!exemption,\n916\t    studentId: viewed.studentId,\n917\t  };\n918\t}\n919\t\n920\texport type RosterRow = {\n921\t  student: { id: string; name: string };\n922\t  chipStatus: ChipStatus;\n923\t  exempt: boolean;\n924\t  submission: {\n925\t    id: string;\n926\t    status: 'SUBMITTED' | 'RETURNED';\n927\t    attemptNumber: number;\n928\t    submittedAt: string;\n929\t    isLate: boolean;\n930\t    lateDays: number;\n931\t    finalScore: string | null;\n932\t    gradedAt: string | null;\n933\t    returnedAt: string | null;\n934\t  } | null;\n935\t};\n936\t\n937\t/** FR-54: every ACTIVE enrollee, submitted or not. */\n938\texport async function listGradingRoster(\n939\t  user: AccessUser,\n940\t  assignmentId: string,\n941\t  query: { sort: 'name' | 'submittedAt'; status?: ChipStatus },\n942\t  page: { skip: number; take: number },\n943\t) {\n944\t  const a = await prisma.assignment.findUnique({ where: { id: assignmentId }, select: { courseId: true } });\n945\t  if (!a) throw notFound();\n946\t  await assertCanManageCourse(user, a.courseId);\n947\t  const [roster, subs, exemptions] = await Promise.all([\n948\t    prisma.enrollment.findMany({\n949\t      where: { courseId: a.courseId, status: 'ACTIVE' },\n950\t      select: { student: { select: { id: true, firstName: true, lastName: true } } },\n951\t      orderBy: [{ student: { lastName: 'asc' } }, { student: { firstName: 'asc' } }],\n952\t    }),\n953\t    prisma.submission.findMany({\n954\t      where: { assignmentId },\n955\t      select: { id: true, studentId: true, status: true, attemptNumber: true, submittedAt: true, isLate: true, lateDays: true, finalScore: true, gradedAt: true, returnedAt: true },\n956\t    }),\n957\t    prisma.gradeExemption.findMany({ where: { assignmentId }, select: { studentId: true } }),\n958\t  ]);\n959\t  const exempt = new Set(exemptions.map((e) => e.studentId));\n960\t  let rows: RosterRow[] = roster.map(({ student }) => {\n961\t    const s = subs.find((x) => x.studentId === student.id) ?? null;\n962\t    const isExempt = exempt.has(student.id);\n963\t    return {\n964\t      student: userRef(student)!,\n965\t      chipStatus: submissionChipStatus({ exempt: isExempt, submission: s }),\n966\t      exempt: isExempt,\n967\t      submission: s\n968\t        ? {\n969\t            id: s.id,\n970\t            status: s.status,\n971\t            attemptNumber: s.attemptNumber,\n972\t            submittedAt: s.submittedAt.toISOString(),\n973\t            isLate: s.isLate,\n974\t            lateDays: s.lateDays,\n975\t            finalScore: serializeDecimal(s.finalScore),\n976\t            gradedAt: iso(s.gradedAt),\n977\t            returnedAt: iso(s.returnedAt),\n978\t          }\n979\t        : null,\n980\t    };\n981\t  });\n982\t  if (query.status) rows = rows.filter((r) => r.chipStatus === query.status);\n983\t  if (query.sort === 'submittedAt') {\n984\t    rows.sort((x, y) => (x.submission?.submittedAt ?? '￿').localeCompare(y.submission?.submittedAt ?? '￿'));\n985\t  }\n986\t  return { items: rows.slice(page.skip, page.skip + page.take), total: rows.length };\n987\t}\n988\t\n989\t/** FR-55: submitter, linked parent, or course manager (history only for managers); anyone else NOT_FOUND. */\n990\texport async function getSubmission(user: AccessUser, submissionId: string) {\n991\t  const sub = await prisma.submission.findUnique({\n992\t    where: { id: submissionId },\n993\t    include: {\n994\t      ...submissionInclude,\n995\t      history: { orderBy: { attemptNumber: 'asc' } },\n996\t      assignment: { select: { status: true, availableFrom: true, archivedAt: true, course: { select: { teacherId: true, coTeacherIds: true } } } },\n997\t    },\n998\t  });\n999\t  const missing = new AppError('NOT_FOUND', 'Submission not found');\n1000\t  if (!sub) throw missing;\n1001\t  if (canSeeDrafts(user, sub.assignment.course)) {\n1002\t    const fileIds = [...new Set(sub.history.flatMap((h) => h.fileIds))];\n1003\t    const files = fileIds.length ? await prisma.fileObject.findMany({ where: { id: { in: fileIds } } }) : [];\n1004\t    const dto = toSubmission(sub);\n1005\t    dto.history = sub.history.map((h) => ({\n1006\t      attemptNumber: h.attemptNumber,\n1007\t      text: h.text,\n1008\t      files: h.fileIds.map((fid) => files.find((f) => f.id === fid)).filter((f): f is FileObject => !!f).map(fileRef),\n1009\t      submittedAt: h.submittedAt.toISOString(),\n1010\t    }));\n1011\t    return dto;\n1012\t  }\n1013\t  if (!isAssignmentVisible(sub.assignment, new Date())) throw missing;\n1014\t  const own = user.role === 'STUDENT' && sub.studentId === user.id;\n1015\t  const parent =\n1016\t    user.role === 'PARENT' &&\n1017\t    !!(await prisma.parentStudentLink.findFirst({ where: { parentId: user.id, studentId: sub.studentId }, select: { id: true } }));\n1018\t  if (!own && !parent) throw missing;\n1019\t  return toStudentSubmission(toSubmission(sub));\n1020\t}\n1021\t\n1022\t/** Rows for one student across ACTIVE enrollments (optionally one course). */\n1023\tasync function studentRows(studentId: string, courseId: string | undefined, now: Date, fullGradesFor: (courseId: string) => boolean = () => false) {\n1024\t  const enrollments = await prisma.enrollment.findMany({\n1025\t    where: { studentId, status: 'ACTIVE' },\n1026\t    select: { course: { select: { id: true, name: true, teacherId: true, coTeacherIds: true } } },\n1027\t    orderBy: { course: { name: 'asc' } },\n1028\t  });\n1029\t  const courses = enrollments.map((e) => e.course);\n1030\t  const courseIds = courses.map((c) => c.id).filter((id) => !courseId || id === courseId);\n1031\t  const assignments = await prisma.assignment.findMany({\n1032\t    where: { courseId: { in: courseIds }, ...visibleWhere(now) },\n1033\t    include: {\n1034\t      course: { select: { name: true } },\n1035\t      submissions: { where: { studentId }, select: summarySubSelect },\n1036\t      exemptions: { where: { studentId }, select: { studentId: true } },\n1037\t    },\n1038\t    orderBy: { dueAt: 'asc' },\n1039\t  });\n1040\t  publishNewlyVisible(assignments, now);\n1041\t  return {\n1042\t    courses,\n1043\t    rows: assignments.map((a) => ({\n1044\t      ...toStudentRow(a, a.submissions[0] ?? null, a.exemptions.length > 0, now, fullGradesFor(a.courseId)),\n1045\t      canManage: fullGradesFor(a.courseId),\n1046\t    })),\n1047\t  };\n1048\t}\n1049\t\n1050\tconst TO_GRADE_LIMIT = 200;\n1051\t\n1052\texport async function listMyAssignments(user: AccessUser, query: { studentId?: string; tab?: Exclude<Group, 'CLOSED'>; courseId?: string }) {\n1053\t  if (user.role === 'TEACHER' || user.role === 'ADMIN') {\n1054\t    const subs = await prisma.submission.findMany({\n1055\t      where: {\n1056\t        status: 'SUBMITTED',\n1057\t        gradedAt: null,\n1058\t        attemptNumber: { gt: 0 },\n1059\t        assignment: {\n1060\t          archivedAt: null,\n1061\t          ...(query.courseId ? { courseId: query.courseId } : {}),\n1062\t          ...(user.role === 'TEACHER' ? { course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] } } : {}),\n1063\t        },\n1064\t      },\n1065\t      select: {\n1066\t        id: true,\n1067\t        submittedAt: true,\n1068\t        isLate: true,\n1069\t        student: { select: { id: true, firstName: true, lastName: true } },\n1070\t        assignment: { include: { course: { select: { name: true } } } },\n1071\t      },\n1072\t      orderBy: { submittedAt: 'asc' },\n1073\t      // ponytail: capped list, add pagination if a teacher ever has > 200 ungraded submissions.\n1074\t      take: TO_GRADE_LIMIT,\n1075\t    });\n1076\t    return {\n1077\t      view: 'toGrade' as const,\n1078\t      items: subs.map((s) => ({\n1079\t        submissionId: s.id,\n1080\t        assignment: toSummary(s.assignment),\n1081\t        student: userRef(s.student)!,\n1082\t        submittedAt: s.submittedAt.toISOString(),\n1083\t        isLate: s.isLate,\n1084\t      })),\n1085\t    };\n1086\t  }\n1087\t\n1088\t  const viewed = await resolveViewedStudent(user, query.studentId);\n1089\t  const now = new Date();\n1090\t  const { courses, rows } = await studentRows(viewed.studentId, query.courseId, now);\n1091\t  const items = rows\n1092\t    .map(({ canManage: _c, ...r }) => r)\n1093\t    // Tab omitted → all rows (the page groups them client-side).\n1094\t    .filter((r) => !query.tab || r.group === query.tab);\n1095\t  return {\n1096\t    view: 'student' as const,\n1097\t    studentId: viewed.studentId,\n1098\t    children: viewed.children,\n1099\t    courses: courses.map((c) => ({ id: c.id, name: c.name })),\n1100\t    items,\n1101\t  };\n1102\t}\n1103\t\n1104\t/** FR-58 / D8: per course, managers get full grade fields, everyone else the serializer. */\n1105\texport async function listStudentAssignments(user: AccessUser, studentId: string, courseId?: string) {\n1106\t  await assertCanViewStudent(user, studentId);\n1107\t  const student = await prisma.user.findFirst({ where: { id: studentId, role: 'STUDENT' }, select: { id: true, firstName: true, lastName: true } });\n1108\t  if (!student) throw new AppError('NOT_FOUND', 'Student not found');\n1109\t  const now = new Date();\n1110\t  const enrollments = await prisma.enrollment.findMany({\n1111\t    where: { studentId, status: 'ACTIVE' },\n1112\t    select: { course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n1113\t  });\n1114\t  const managed = new Set(enrollments.filter((e) => canSeeDrafts(user, e.course)).map((e) => e.course.id));\n1115\t  const { rows } = await studentRows(studentId, courseId, now, (cid) => managed.has(cid));\n1116\t  return { student: userRef(student)!, items: rows };\n1117\t}\n1118\t"}]},"parent_tool_use_id":null,"session_id":"c6f85ae0-4ad4-4d10-b797-6ff9d3e2b1f5","uuid":"827e0f6e-5a87-452c-9d0e-c8398be34d45","timestamp":"2026-11-09T12:15:50.206Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/assignments/assignments-service.ts","content":"import { Prisma, type AssignmentStatus, type FileObject, type SubmissionType } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { assertCanManageCourse, assertCanViewCourse } from '@/server/auth/course-access';\nimport { assertCanViewStudent, type AccessUser } from '@/server/auth/student-access';\nimport { canSeeDrafts, isVisible } from '@/server/content/visibility';\nimport { notify, notifyStudentAndParents } from '@/server/notifications/notify';\nimport { attachFiles, detachFiles } from '@/server/files/files-service';\nimport { extOf } from '@/server/files/validate';\nimport { readFile, saveFile } from '@/server/storage';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { logger } from '@/lib/logger';\nimport {\n  assignmentInput,\n  type AssignmentInput,\n  type AssignmentPatch,\n  type GradeInput,\n  type OfflineGradeInput,\n  type RubricCriterionValues,\n} from '@/lib/validators/assignments';\nimport {\n  computeFinalScore,\n  dec,\n  fixed2,\n  lateDays as computeLateDays,\n  maxRawScore,\n  submissionChipStatus,\n  type ChipStatus,\n} from './grading-math';\n\n/**\n * PRD-09 assignments service (system-design §2.2, NFR-8). All assignment/submission DB logic\n * lives here; route handlers and server pages stay thin. \"now\" is always the server clock (NFR-2).\n *\n * Privacy (NFR-4): student/parent paths scope by resolveViewedStudent and every submission they\n * receive goes through toStudentSubmission.\n */\n\ntype Tx = Prisma.TransactionClient;\ntype Group = 'UPCOMING' | 'MISSING' | 'SUBMITTED' | 'RETURNED' | 'CLOSED';\n\nconst fullName = (u: { firstName: string; lastName: string }) => `${u.firstName} ${u.lastName}`;\nconst userRef = (u: { id: string; firstName: string; lastName: string } | null) => (u ? { id: u.id, name: fullName(u) } : null);\nconst fileRef = (f: Pick<FileObject, 'id' | 'originalName' | 'mimeType' | 'sizeBytes'>) => ({\n  id: f.id,\n  filename: f.originalName,\n  mimeType: f.mimeType,\n  size: f.sizeBytes,\n});\nconst iso = (d: Date | null) => (d ? d.toISOString() : null);\n/** Prisma.Decimal → \"14.40\" on the way out (NFR-1, D5). */\nexport const serializeDecimal = (d: Prisma.Decimal | null) => (d === null ? null : fixed2(d));\n/** \"18.00\" → \"18\", \"14.40\" stays — for human copy like \"18/20\". */\nconst pts = (d: Prisma.Decimal | string) => fixed2(d).replace(/\\.00$/, '');\n\nexport async function getSchoolTimezone(): Promise<string> {\n  return (await prisma.schoolSettings.findUnique({ where: { id: 'singleton' }, select: { timezone: true } }))?.timezone ?? 'UTC';\n}\n\nconst notFound = () => new AppError('NOT_FOUND', 'Assignment not found');\n\n// ---------------------------------------------------------------------------\n// Visibility (FR-13, FR-52, FR-60)\n// ---------------------------------------------------------------------------\n\ntype VisibilityFields = { status: AssignmentStatus; availableFrom: Date | null; archivedAt: Date | null };\n\nexport function isAssignmentVisible(a: VisibilityFields, now: Date): boolean {\n  return !a.archivedAt && isVisible({ status: a.status, publishAt: a.availableFrom }, now);\n}\n\nexport function visibleWhere(now: Date): Prisma.AssignmentWhereInput {\n  return { archivedAt: null, OR: [{ status: 'PUBLISHED' }, { status: 'SCHEDULED', availableFrom: { lte: now } }] };\n}\n\n/** Visible, past due, not NO_SUBMISSION, and this student has no submission and no exemption. */\nexport function missingWhere(now: Date, studentId: string): Prisma.AssignmentWhereInput {\n  return {\n    AND: [\n      visibleWhere(now),\n      {\n        dueAt: { lt: now },\n        submissionType: { not: 'NO_SUBMISSION' },\n        submissions: { none: { studentId } },\n        exemptions: { none: { studentId } },\n      },\n    ],\n  };\n}\n\n/** Server-computed list group; first match wins (api-contracts StudentAssignmentRow). */\nfunction groupOf(\n  a: { dueAt: Date; submissionType: SubmissionType },\n  sub: { status: string } | null,\n  exempt: boolean,\n  now: Date,\n): Group {\n  if (sub?.status === 'RETURNED') return 'RETURNED';\n  if (sub) return 'SUBMITTED';\n  if (a.dueAt > now) return 'UPCOMING';\n  if (!exempt && a.submissionType !== 'NO_SUBMISSION') return 'MISSING';\n  return 'CLOSED';\n}\n\n// ---------------------------------------------------------------------------\n// Serializers\n// ---------------------------------------------------------------------------\n\nconst assignmentInclude = {\n  course: { select: { id: true, name: true, teacherId: true, coTeacherIds: true } },\n  rubric: { include: { criteria: { orderBy: { order: 'asc' } } } },\n  attachments: { include: { file: true } },\n} satisfies Prisma.AssignmentInclude;\ntype FullAssignment = Prisma.AssignmentGetPayload<{ include: typeof assignmentInclude }>;\ntype AssignmentRow = Prisma.AssignmentGetPayload<{ include: { course: { select: { name: true } } } }> | FullAssignment;\n\ntype Level = { label: string; points: string; description?: string };\n\nfunction toSummary(a: AssignmentRow) {\n  return {\n    id: a.id,\n    courseId: a.courseId,\n    courseName: a.course.name,\n    title: a.title,\n    submissionType: a.submissionType,\n    maxPoints: fixed2(a.maxPoints),\n    dueAt: a.dueAt.toISOString(),\n    availableFrom: iso(a.availableFrom),\n    status: a.status,\n    archivedAt: iso(a.archivedAt),\n    hasRubric: a.rubricId !== null,\n  };\n}\nexport type AssignmentSummary = ReturnType<typeof toSummary>;\n\nfunction toAssignment(a: FullAssignment) {\n  return {\n    ...toSummary(a),\n    instructions: a.instructions,\n    allowLate: a.allowLate,\n    lateCutoffAt: iso(a.lateCutoffAt),\n    latePenaltyPercentPerDay: fixed2(a.latePenaltyPercentPerDay),\n    maxLatePenaltyPercent: fixed2(a.maxLatePenaltyPercent),\n    maxFileCount: a.maxFileCount,\n    allowExtraCredit: a.allowExtraCredit,\n    rubric: a.rubric\n      ? a.rubric.criteria.map((c) => ({\n          id: c.id,\n          order: c.order,\n          title: c.title,\n          description: c.description ?? '',\n          maxPoints: fixed2(c.maxPoints),\n          levels: (c.levels as Level[]).map((l) => ({ label: l.label, points: fixed2(l.points), description: l.description ?? '' })),\n        }))\n      : null,\n    attachments: a.attachments.map((x) => fileRef(x.file)),\n    createdAt: a.createdAt.toISOString(),\n    updatedAt: a.updatedAt.toISOString(),\n  };\n}\nexport type AssignmentDto = ReturnType<typeof toAssignment>;\n\nconst submissionInclude = {\n  student: { select: { id: true, firstName: true, lastName: true } },\n  gradedBy: { select: { id: true, firstName: true, lastName: true } },\n  files: { include: { file: true } },\n} satisfies Prisma.SubmissionInclude;\ntype FullSubmission = Prisma.SubmissionGetPayload<{ include: typeof submissionInclude }>;\ntype RubricScore = { criterionId: string; points: string; comment?: string };\n\nfunction toSubmission(s: FullSubmission) {\n  return {\n    id: s.id,\n    assignmentId: s.assignmentId,\n    student: userRef(s.student)!,\n    status: s.status,\n    attemptNumber: s.attemptNumber,\n    text: s.text,\n    files: s.files.map((f) => fileRef(f.file)),\n    submittedAt: s.submittedAt.toISOString(),\n    isLate: s.isLate,\n    lateDays: s.lateDays,\n    rawScore: serializeDecimal(s.rawScore),\n    penaltyPercent: serializeDecimal(s.penaltyPercent),\n    finalScore: serializeDecimal(s.finalScore),\n    rubricScores: (s.rubricScores as RubricScore[] | null) ?? null,\n    feedback: s.feedback,\n    gradedBy: userRef(s.gradedBy),\n    gradedAt: iso(s.gradedAt),\n    returnedAt: iso(s.returnedAt),\n    history: undefined as SubmissionAttempt[] | undefined,\n  };\n}\nexport type SubmissionDto = ReturnType<typeof toSubmission>;\nexport type SubmissionAttempt = { attemptNumber: number; text: string | null; files: ReturnType<typeof fileRef>[]; submittedAt: string };\n\n/** FR-27, NFR-4: grade fields are null until RETURNED; history is never sent to students/parents. */\nexport function toStudentSubmission(s: SubmissionDto): SubmissionDto {\n  const { history: _history, ...rest } = s;\n  if (s.status === 'RETURNED') return rest as SubmissionDto;\n  return {\n    ...rest,\n    rawScore: null,\n    penaltyPercent: null,\n    finalScore: null,\n    feedback: null,\n    rubricScores: null,\n    gradedBy: null,\n    gradedAt: null,\n  } as SubmissionDto;\n}\n\ntype SummarySub = { id: string; status: 'SUBMITTED' | 'RETURNED'; attemptNumber: number; submittedAt: Date; isLate: boolean; finalScore: Prisma.Decimal | null; returnedAt: Date | null };\n\nfunction toStudentRow(a: AssignmentRow, sub: SummarySub | null, exempt: boolean, now: Date, fullGrades = false) {\n  return {\n    assignment: toSummary(a),\n    group: groupOf(a, sub, exempt, now),\n    exempt,\n    submission: sub\n      ? {\n          id: sub.id,\n          status: sub.status,\n          attemptNumber: sub.attemptNumber,\n          submittedAt: sub.submittedAt.toISOString(),\n          isLate: sub.isLate,\n          finalScore: fullGrades || sub.status === 'RETURNED' ? serializeDecimal(sub.finalScore) : null,\n          returnedAt: iso(sub.returnedAt),\n        }\n      : null,\n  };\n}\nexport type StudentAssignmentRow = ReturnType<typeof toStudentRow>;\n\nconst summarySubSelect = {\n  id: true,\n  status: true,\n  attemptNumber: true,\n  submittedAt: true,\n  isLate: true,\n  finalScore: true,\n  returnedAt: true,\n} satisfies Prisma.SubmissionSelect;\n\n// ---------------------------------------------------------------------------\n// Viewer resolution (FR-18, FR-38, FR-57)\n// ---------------------------------------------------------------------------\n\n/**\n * STUDENT → self. PARENT → studentId must be a linked child; without one, the first linked child\n * (preferring one ACTIVE in courseId when given). Anyone else → FORBIDDEN.\n */\nexport async function resolveViewedStudent(user: AccessUser, studentId?: string, courseId?: string) {\n  if (user.role === 'STUDENT') {\n    if (studentId && studentId !== user.id) throw new AppError('FORBIDDEN', 'You can only view your own assignments.');\n    return { studentId: user.id, children: [] as { id: string; name: string }[] };\n  }\n  if (user.role === 'PARENT') {\n    const links = await prisma.parentStudentLink.findMany({\n      where: { parentId: user.id },\n      select: {\n        student: {\n          select: {\n            id: true,\n            firstName: true,\n            lastName: true,\n            enrollments: courseId ? { where: { courseId, status: 'ACTIVE' }, select: { id: true } } : undefined,\n          },\n        },\n      },\n      orderBy: [{ isPrimary: 'desc' }, { createdAt: 'asc' }],\n    });\n    const students = links.map((l) => l.student);\n    const children = students.map((s) => userRef(s)!);\n    if (studentId) {\n      if (!children.some((c) => c.id === studentId)) throw new AppError('FORBIDDEN', 'That student is not linked to your account.');\n      return { studentId, children };\n    }\n    const pick = (courseId ? students.find((s) => s.enrollments?.length) : undefined) ?? students[0];\n    if (!pick) throw new AppError('FORBIDDEN', 'No linked students.');\n    return { studentId: pick.id, children };\n  }\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this.');\n}\n\n// ---------------------------------------------------------------------------\n// publishOnce (FR-42)\n// ---------------------------------------------------------------------------\n\n/** Sends assignment.published exactly once, guarded by an atomic notifiedAt claim. */\nexport async function publishOnce(id: string, now = new Date()): Promise<void> {\n  const a = await prisma.assignment.findUnique({\n    where: { id },\n    select: { id: true, title: true, courseId: true, status: true, availableFrom: true, archivedAt: true, notifiedAt: true, dueAt: true, course: { select: { name: true } } },\n  });\n  if (!a || a.notifiedAt || !isAssignmentVisible(a, now)) return;\n  const { count } = await prisma.assignment.updateMany({ where: { id, notifiedAt: null }, data: { notifiedAt: now } });\n  if (count !== 1) return;\n  const [students, tz] = await Promise.all([\n    prisma.enrollment.findMany({ where: { courseId: a.courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n    getSchoolTimezone(),\n  ]);\n  await notify({\n    type: 'assignment.published',\n    userIds: students.map((s) => s.studentId),\n    title: `New assignment: ${a.title}`,\n    body: `${a.course.name} — due ${formatInSchoolTz(a.dueAt, 'EEE d MMM yyyy, HH:mm', tz)}`,\n    link: `/courses/${a.courseId}/assignments/${a.id}`,\n  });\n}\n\n/** Read-path trigger for SCHEDULED rows that became visible (fire-and-forget, never fails the read). */\nfunction publishNewlyVisible(rows: (VisibilityFields & { id: string; notifiedAt: Date | null })[], now: Date) {\n  for (const a of rows) {\n    if (a.status === 'SCHEDULED' && !a.notifiedAt && isAssignmentVisible(a, now)) {\n      void publishOnce(a.id, now).catch((error) =>\n        logger.error('publishOnce failed', { assignmentId: a.id, message: error instanceof Error ? error.message : String(error) }),\n      );\n    }\n  }\n}\n\n// ---------------------------------------------------------------------------\n// Authoring: create / update / delete / duplicate (FR-11..FR-15, FR-49, FR-51)\n// ---------------------------------------------------------------------------\n\nasync function loadFull(id: string, db: Tx = prisma): Promise<FullAssignment> {\n  const a = await db.assignment.findUnique({ where: { id }, include: assignmentInclude });\n  if (!a) throw notFound();\n  return a;\n}\n\nfunction scalarFields(input: AssignmentInput) {\n  return {\n    title: input.title,\n    instructions: input.instructions,\n    submissionType: input.submissionType,\n    maxPoints: input.maxPoints,\n    dueAt: input.dueAt,\n    availableFrom: input.availableFrom ?? null,\n    allowLate: input.allowLate,\n    lateCutoffAt: input.allowLate ? input.lateCutoffAt ?? null : null,\n    latePenaltyPercentPerDay: input.latePenaltyPercentPerDay,\n    maxLatePenaltyPercent: input.maxLatePenaltyPercent,\n    maxFileCount: input.maxFileCount,\n    allowExtraCredit: input.allowExtraCredit,\n    status: input.status,\n  };\n}\n\n/** FR-12: SCHEDULED needs availableFrom in the future, by the server clock (NFR-2). */\nfunction assertSchedule(input: Pick<AssignmentInput, 'status' | 'availableFrom'>, now: Date) {\n  if (input.status === 'SCHEDULED' && (!input.availableFrom || input.availableFrom <= now)) {\n    throw new AppError('VALIDATION_ERROR', 'The scheduled time must be in the future.', {\n      fieldErrors: { availableFrom: ['The scheduled time must be in the future.'] },\n    });\n  }\n}\n\n/** Upsert criteria by id (keeps rubricScores' criterionIds valid), delete the rest. Returns the rubric id. */\nasync function writeRubric(tx: Tx, rubricId: string | null, criteria: RubricCriterionValues[]): Promise<string> {\n  const id = rubricId ?? (await tx.rubric.create({ data: {} })).id;\n  const existing = rubricId ? await tx.rubricCriterion.findMany({ where: { rubricId }, select: { id: true } }) : [];\n  const keep = new Set(criteria.map((c) => c.id).filter((cid): cid is string => !!cid && existing.some((e) => e.id === cid)));\n  await tx.rubricCriterion.deleteMany({ where: { rubricId: id, id: { notIn: [...keep] } } });\n  for (const [order, c] of criteria.entries()) {\n    const data = {\n      title: c.title,\n      description: c.description || null,\n      maxPoints: c.maxPoints,\n      order,\n      levels: c.levels as unknown as Prisma.InputJsonValue,\n    };\n    if (c.id && keep.has(c.id)) await tx.rubricCriterion.update({ where: { id: c.id }, data });\n    else await tx.rubricCriterion.create({ data: { ...data, rubricId: id } });\n  }\n  return id;\n}\n\nasync function assertFileContext(tx: Tx, fileIds: string[], context: string) {\n  if (fileIds.length === 0) return;\n  const wrong = await tx.fileObject.findMany({ where: { id: { in: fileIds }, context: { not: context } }, select: { id: true } });\n  if (wrong.length) {\n    throw new AppError('VALIDATION_ERROR', 'One or more files cannot be attached.', { fileIds: wrong.map((f) => f.id) });\n  }\n}\n\n/** Diff attachments: removed → detached (purge reclaims them), added → context-checked and attached. */\nasync function setAttachments(tx: Tx, user: AccessUser, assignmentId: string, current: string[], next: string[]) {\n  const wanted = [...new Set(next)];\n  const removed = current.filter((id) => !wanted.includes(id));\n  const added = wanted.filter((id) => !current.includes(id));\n  if (removed.length) {\n    await tx.assignmentAttachment.deleteMany({ where: { assignmentId, fileId: { in: removed } } });\n    await detachFiles(tx, removed);\n  }\n  if (added.length) {\n    await assertFileContext(tx, added, 'assignment');\n    await attachFiles(tx, user, added, 'assignment', assignmentId);\n    await tx.assignmentAttachment.createMany({ data: added.map((fileId) => ({ assignmentId, fileId })) });\n  }\n}\n\nasync function publishAfterCommit(id: string) {\n  try {\n    await publishOnce(id);\n  } catch (error) {\n    logger.error('publishOnce failed', { assignmentId: id, message: error instanceof Error ? error.message : String(error) });\n  }\n}\n\nexport async function createAssignment(user: AccessUser, courseId: string, input: AssignmentInput, request?: Request) {\n  await assertCanManageCourse(user, courseId);\n  assertSchedule(input, new Date());\n  const id = await prisma.$transaction(async (tx) => {\n    const rubricId = input.rubric?.length ? await writeRubric(tx, null, input.rubric) : null;\n    const a = await tx.assignment.create({ data: { ...scalarFields(input), courseId, rubricId, createdById: user.id } });\n    await setAttachments(tx, user, a.id, [], input.attachmentFileIds);\n    return a.id;\n  });\n  await audit({ actorId: user.id, action: 'assignment.create', entityType: 'Assignment', entityId: id, metadata: { courseId, status: input.status }, request });\n  await publishAfterCommit(id);\n  return toAssignment(await loadFull(id));\n}\n\n/** Current row → validator input shape, so a PATCH is validated as a whole (same superRefine). */\nfunction asInput(a: FullAssignment) {\n  const dto = toAssignment(a);\n  return {\n    ...dto,\n    rubric: dto.rubric?.map(({ order: _order, ...c }) => c) ?? null,\n    attachmentFileIds: dto.attachments.map((f) => f.id),\n  };\n}\n\nexport async function updateAssignment(user: AccessUser, id: string, patch: AssignmentPatch, request?: Request) {\n  const existing = await loadFull(id);\n  await assertCanManageCourse(user, existing.courseId);\n  const merged = assignmentInput.parse({ ...asInput(existing), ...stripUndefined(patch) });\n  const scheduleChanged =\n    merged.status === 'SCHEDULED' &&\n    (existing.status !== 'SCHEDULED' || existing.availableFrom?.getTime() !== merged.availableFrom?.getTime());\n  if (scheduleChanged) assertSchedule(merged, new Date());\n\n  await prisma.$transaction(async (tx) => {\n    let rubricId = existing.rubricId;\n    if (patch.rubric !== undefined) {\n      if (merged.rubric?.length) {\n        rubricId = await writeRubric(tx, existing.rubricId, merged.rubric);\n      } else if (existing.rubricId) {\n        rubricId = null;\n      }\n    }\n    await tx.assignment.update({ where: { id }, data: { ...scalarFields(merged), rubricId } });\n    if (existing.rubricId && rubricId === null) await tx.rubric.delete({ where: { id: existing.rubricId } });\n    if (patch.attachmentFileIds !== undefined) {\n      await setAttachments(tx, user, id, existing.attachments.map((x) => x.fileId), merged.attachmentFileIds);\n    }\n  });\n  await audit({\n    actorId: user.id,\n    action: 'assignment.update',\n    entityType: 'Assignment',\n    entityId: id,\n    metadata: { fields: Object.keys(stripUndefined(patch)) },\n    request,\n  });\n  await publishAfterCommit(id);\n  const [a, submissionCount] = await Promise.all([loadFull(id), prisma.submission.count({ where: { assignmentId: id, attemptNumber: { gt: 0 } } })]);\n  return { ...toAssignment(a), submissionCount };\n}\n\nfunction stripUndefined<T extends object>(o: T): Partial<T> {\n  return Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined)) as Partial<T>;\n}\n\n/** FR-51: hard delete with no submissions, otherwise archive. */\nexport async function deleteOrArchiveAssignment(user: AccessUser, id: string, request?: Request) {\n  const a = await loadFull(id);\n  await assertCanManageCourse(user, a.courseId);\n  const submissions = await prisma.submission.count({ where: { assignmentId: id } });\n  let result: 'deleted' | 'archived';\n  if (submissions === 0) {\n    await prisma.$transaction(async (tx) => {\n      await detachFiles(tx, a.attachments.map((x) => x.fileId));\n      await tx.assignment.delete({ where: { id } });\n      if (a.rubricId) await tx.rubric.delete({ where: { id: a.rubricId } });\n    });\n    result = 'deleted';\n  } else {\n    await prisma.assignment.update({ where: { id }, data: { archivedAt: a.archivedAt ?? new Date() } });\n    result = 'archived';\n  }\n  await audit({ actorId: user.id, action: result === 'deleted' ? 'assignment.delete' : 'assignment.archive', entityType: 'Assignment', entityId: id, metadata: { courseId: a.courseId, title: a.title }, request });\n  return { id, result };\n}\n\n/** FR-15: copy as DRAFT; rubric as new rows; attachment bytes re-saved as new FileObjects (B2). */\nexport async function duplicateAssignment(user: AccessUser, id: string, courseIds: string[], request?: Request) {\n  const src = await loadFull(id);\n  await assertCanManageCourse(user, src.courseId);\n  const targets = [...new Set(courseIds)];\n  for (const courseId of targets) await assertCanManageCourse(user, courseId);\n\n  const input = assignmentInput.parse({ ...asInput(src), status: 'DRAFT' });\n  const created: { courseId: string; assignmentId: string }[] = [];\n  for (const courseId of targets) {\n    // Bytes are copied outside the transaction; if it fails the copies stay unattached and the purge reclaims them.\n    const fileIds: string[] = [];\n    for (const { file } of src.attachments) {\n      const saved = await saveFile(readFile(file.storageKey), { ext: extOf(file.originalName) });\n      const copy = await prisma.fileObject.create({\n        data: { ownerId: user.id, originalName: file.originalName, mimeType: file.mimeType, sizeBytes: saved.sizeBytes, storageKey: saved.storageKey, sha256: saved.sha256, context: 'assignment' },\n      });\n      fileIds.push(copy.id);\n    }\n    const assignmentId = await prisma.$transaction(async (tx) => {\n      const rubricId = input.rubric?.length ? await writeRubric(tx, null, input.rubric.map(({ id: _id, ...c }) => c)) : null;\n      const a = await tx.assignment.create({ data: { ...scalarFields(input), courseId, rubricId, createdById: user.id } });\n      await setAttachments(tx, user, a.id, [], fileIds);\n      return a.id;\n    });\n    created.push({ courseId, assignmentId });\n    await audit({ actorId: user.id, action: 'assignment.duplicate', entityType: 'Assignment', entityId: assignmentId, metadata: { sourceId: id, courseId }, request });\n  }\n  return { created };\n}\n\n/** Courses the user may author in, for the duplicate dialog. */\nexport async function listManagedCourses(user: AccessUser) {\n  const where: Prisma.CourseWhereInput =\n    user.role === 'ADMIN' ? { archivedAt: null } : { archivedAt: null, OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] };\n  return prisma.course.findMany({ where, select: { id: true, name: true, code: true }, orderBy: { name: 'asc' } });\n}\n\n// ---------------------------------------------------------------------------\n// Submit (FR-22..FR-24, FR-53, FR-60)\n// ---------------------------------------------------------------------------\n\nconst DEADLINE_PASSED = 'The deadline has passed and late submissions are closed.';\nconst RETURNED_LOCKED = 'This submission has been returned and can no longer be changed.';\n\nexport async function submit(user: AccessUser, assignmentId: string, input: { text?: string; fileIds: string[] }) {\n  const now = new Date();\n  const a = await prisma.assignment.findUnique({ where: { id: assignmentId } });\n  // 1. visible\n  if (!a || !isAssignmentVisible(a, now)) throw notFound();\n  // 2. STUDENT, ACTIVE-enrolled\n  if (user.role !== 'STUDENT') throw new AppError('FORBIDDEN', 'Only students can submit work.');\n  const [enrolled, exempt] = await Promise.all([\n    prisma.enrollment.findFirst({ where: { courseId: a.courseId, studentId: user.id, status: 'ACTIVE' }, select: { id: true } }),\n    prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId, studentId: user.id } } }),\n  ]);\n  if (!enrolled) throw new AppError('FORBIDDEN', 'You are not enrolled in this course.');\n  // 3. not exempt, takes submissions\n  if (exempt) throw new AppError('VALIDATION_ERROR', 'You are exempt from this assignment.');\n  if (a.submissionType === 'NO_SUBMISSION') throw new AppError('VALIDATION_ERROR', 'This assignment does not take online submissions.');\n  // 4. deadline\n  const open = now <= a.dueAt || (a.allowLate && (!a.lateCutoffAt || now <= a.lateCutoffAt));\n  if (!open) throw new AppError('VALIDATION_ERROR', DEADLINE_PASSED);\n  // 5. content matches the type\n  const text = input.text?.trim() ? input.text : null;\n  const fileIds = [...new Set(input.fileIds)];\n  if (a.submissionType === 'ONLINE_TEXT' && (!text || fileIds.length)) throw new AppError('VALIDATION_ERROR', 'Enter your answer as text.');\n  if (a.submissionType === 'FILE_UPLOAD' && fileIds.length === 0) throw new AppError('VALIDATION_ERROR', 'Attach at least one file.');\n  if (a.submissionType === 'TEXT_AND_FILE' && !text && fileIds.length === 0) throw new AppError('VALIDATION_ERROR', 'Enter text or attach a file.');\n  if (fileIds.length > a.maxFileCount) throw new AppError('VALIDATION_ERROR', `You can attach at most ${a.maxFileCount} files.`);\n  const storedText = a.submissionType === 'FILE_UPLOAD' ? null : text;\n\n  const isLate = now > a.dueAt;\n  const days = computeLateDays(now, a.dueAt);\n\n  const run = () =>\n    prisma.$transaction(async (tx) => {\n      const existing = await tx.submission.findUnique({\n        where: { assignmentId_studentId: { assignmentId, studentId: user.id } },\n        include: { files: { select: { fileId: true } } },\n      });\n      if (existing?.status === 'RETURNED') throw new AppError('CONFLICT', RETURNED_LOCKED);\n      // 6. each file is mine, context 'submission', unattached or already on this submission (attachFiles checks the rest).\n      await assertFileContext(tx, fileIds, 'submission');\n\n      let id: string;\n      if (!existing) {\n        id = (\n          await tx.submission.create({\n            data: { assignmentId, studentId: user.id, status: 'SUBMITTED', text: storedText, attemptNumber: 1, submittedAt: now, isLate, lateDays: days },\n          })\n        ).id;\n      } else {\n        id = existing.id;\n        await tx.submissionHistory.create({\n          data: { submissionId: id, attemptNumber: existing.attemptNumber, text: existing.text, fileIds: existing.files.map((f) => f.fileId), submittedAt: existing.submittedAt },\n        });\n        await tx.submission.update({\n          where: { id },\n          data: {\n            text: storedText,\n            attemptNumber: existing.attemptNumber + 1,\n            submittedAt: now,\n            isLate,\n            lateDays: days,\n            rawScore: null,\n            penaltyPercent: null,\n            finalScore: null,\n            feedback: null,\n            rubricScores: Prisma.DbNull,\n            gradedById: null,\n            gradedAt: null,\n          },\n        });\n        // Old files stay attached to this submission id so history keeps its bytes (B1).\n        await tx.submissionFile.deleteMany({ where: { submissionId: id } });\n      }\n      await attachFiles(tx, user, fileIds, 'submission', id);\n      if (fileIds.length) await tx.submissionFile.createMany({ data: fileIds.map((fileId) => ({ submissionId: id, fileId })) });\n      return { id, created: !existing };\n    });\n\n  let result: { id: string; created: boolean };\n  try {\n    result = await run();\n  } catch (error) {\n    // Two concurrent first submits: the loser retries once as a resubmit.\n    if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') result = await run();\n    else throw error;\n  }\n  const sub = await prisma.submission.findUniqueOrThrow({ where: { id: result.id }, include: submissionInclude });\n  return { submission: toStudentSubmission(toSubmission(sub)), created: result.created };\n}\n\n// ---------------------------------------------------------------------------\n// Grading (FR-30..FR-36, FR-56, FR-59)\n// ---------------------------------------------------------------------------\n\ntype GradeTarget = {\n  maxPoints: Prisma.Decimal;\n  allowExtraCredit: boolean;\n  rubric: { criteria: { id: string; title: string; maxPoints: Prisma.Decimal }[] } | null;\n};\n\nconst invalid = (message: string) => new AppError('VALIDATION_ERROR', message);\n\n/** D7: with a rubric the server derives rawScore = Σ points; otherwise rawScore within maxRawScore (FR-36). */\nfunction scoreFrom(a: GradeTarget, input: Pick<GradeInput, 'rawScore' | 'rubricScores'>) {\n  const criteria = a.rubric?.criteria ?? [];\n  if (criteria.length) {\n    const scores = input.rubricScores ?? [];\n    const byId = new Map(scores.map((s) => [s.criterionId, s]));\n    if (byId.size !== scores.length) throw invalid('Each rubric criterion can be scored only once.');\n    if (scores.some((s) => !criteria.some((c) => c.id === s.criterionId))) throw invalid('Unknown rubric criterion.');\n    for (const c of criteria) {\n      const s = byId.get(c.id);\n      if (!s) throw invalid(`Score every rubric criterion (missing \"${c.title}\").`);\n      if (dec(s.points).gt(dec(c.maxPoints))) throw invalid(`\"${c.title}\" is worth at most ${pts(c.maxPoints)} points.`);\n    }\n    const raw = scores.reduce((sum, s) => sum.plus(dec(s.points)), dec(0));\n    const rubricScores: RubricScore[] = criteria.map((c) => {\n      const s = byId.get(c.id)!;\n      return { criterionId: c.id, points: s.points, ...(s.comment ? { comment: s.comment } : {}) };\n    });\n    return { raw: fixed2(raw), rubricScores: rubricScores as unknown as Prisma.InputJsonValue };\n  }\n  if (input.rawScore === undefined) throw invalid('Enter a raw score.');\n  const max = maxRawScore(a.maxPoints, a.allowExtraCredit);\n  if (dec(input.rawScore).gt(max)) throw invalid(`The raw score must be between 0 and ${pts(max.toString())}.`);\n  return { raw: input.rawScore, rubricScores: Prisma.DbNull };\n}\n\nconst gradingAssignmentSelect = {\n  id: true,\n  title: true,\n  courseId: true,\n  maxPoints: true,\n  allowExtraCredit: true,\n  course: { select: { name: true, teacherId: true, coTeacherIds: true } },\n  rubric: { select: { criteria: { select: { id: true, title: true, maxPoints: true }, orderBy: { order: 'asc' } } } },\n} satisfies Prisma.AssignmentSelect;\ntype GradingAssignment = Prisma.AssignmentGetPayload<{ select: typeof gradingAssignmentSelect }>;\n\nasync function notifyReturned(a: GradingAssignment, studentId: string, finalScore: Prisma.Decimal | string | null) {\n  await notifyStudentAndParents({\n    type: 'assignment.returned',\n    studentIds: [studentId],\n    title: `Returned: ${a.title}`,\n    body: `${a.course.name}: ${a.title} — ${finalScore === null ? '—' : pts(finalScore)}/${pts(a.maxPoints)}`,\n    link: `/courses/${a.courseId}/assignments/${a.id}`,\n  });\n}\n\nasync function loadFullSubmission(id: string) {\n  return prisma.submission.findUniqueOrThrow({ where: { id }, include: submissionInclude });\n}\n\nexport async function gradeSubmission(user: AccessUser, submissionId: string, input: GradeInput, request?: Request) {\n  const sub = await prisma.submission.findUnique({\n    where: { id: submissionId },\n    select: { id: true, studentId: true, status: true, returnedAt: true, assignment: { select: gradingAssignmentSelect } },\n  });\n  if (!sub) throw new AppError('NOT_FOUND', 'Submission not found');\n  const a = sub.assignment;\n  await assertCanManageCourse(user, a.courseId);\n  const { raw, rubricScores } = scoreFrom(a, input);\n  const finalScore = computeFinalScore(raw, input.penaltyPercent).toFixed(2);\n  const now = new Date();\n  const returning = input.return && sub.status !== 'RETURNED';\n\n  await prisma.submission.update({\n    where: { id: submissionId },\n    data: {\n      rawScore: raw,\n      penaltyPercent: input.penaltyPercent,\n      finalScore,\n      rubricScores,\n      feedback: input.feedback ?? null,\n      gradedById: user.id,\n      gradedAt: now,\n      ...(returning ? { status: 'RETURNED' as const, returnedAt: now } : {}),\n    },\n  });\n  await audit({ actorId: user.id, action: 'submission.grade', entityType: 'Submission', entityId: submissionId, metadata: { assignmentId: a.id, studentId: sub.studentId, finalScore }, request });\n  if (returning) {\n    await audit({ actorId: user.id, action: 'submission.return', entityType: 'Submission', entityId: submissionId, metadata: { assignmentId: a.id, studentId: sub.studentId }, request });\n    await notifyReturned(a, sub.studentId, finalScore);\n  }\n  return toSubmission(await loadFullSubmission(submissionId));\n}\n\n/** FR-32 \"Return all graded\". Default set = graded and not yet returned. */\nexport async function bulkReturn(user: AccessUser, assignmentId: string, submissionIds: string[] | undefined, request?: Request) {\n  const a = await prisma.assignment.findUnique({ where: { id: assignmentId }, select: gradingAssignmentSelect });\n  if (!a) throw notFound();\n  await assertCanManageCourse(user, a.courseId);\n\n  const skipped: { submissionId: string; reason: 'NOT_GRADED' | 'ALREADY_RETURNED' | 'NOT_FOUND' }[] = [];\n  const candidates = await prisma.submission.findMany({\n    where: submissionIds ? { assignmentId, id: { in: submissionIds } } : { assignmentId, status: 'SUBMITTED', gradedAt: { not: null } },\n    select: { id: true, studentId: true, status: true, gradedAt: true, finalScore: true },\n  });\n  if (submissionIds) {\n    for (const id of new Set(submissionIds)) {\n      const s = candidates.find((c) => c.id === id);\n      if (!s) skipped.push({ submissionId: id, reason: 'NOT_FOUND' });\n      else if (s.status === 'RETURNED') skipped.push({ submissionId: id, reason: 'ALREADY_RETURNED' });\n      else if (!s.gradedAt) skipped.push({ submissionId: id, reason: 'NOT_GRADED' });\n    }\n  }\n  const eligible = candidates.filter((s) => s.status === 'SUBMITTED' && s.gradedAt);\n  const now = new Date();\n  if (eligible.length) {\n    await prisma.submission.updateMany({\n      where: { id: { in: eligible.map((s) => s.id) }, status: 'SUBMITTED' },\n      data: { status: 'RETURNED', returnedAt: now },\n    });\n  }\n  for (const s of eligible) {\n    await audit({ actorId: user.id, action: 'submission.return', entityType: 'Submission', entityId: s.id, metadata: { assignmentId, studentId: s.studentId, bulk: true }, request });\n    await notifyReturned(a, s.studentId, s.finalScore);\n  }\n  return { returned: eligible.map((s) => s.id), skipped };\n}\n\n/** FR-34, FR-8: attempt-0 submission for a student who did not submit. */\nexport async function gradeOffline(user: AccessUser, assignmentId: string, input: OfflineGradeInput, request?: Request) {\n  const a = await prisma.assignment.findUnique({ where: { id: assignmentId }, select: gradingAssignmentSelect });\n  if (!a) throw notFound();\n  await assertCanManageCourse(user, a.courseId);\n  const [enrolled, existing] = await Promise.all([\n    prisma.enrollment.findFirst({ where: { courseId: a.courseId, studentId: input.studentId, status: 'ACTIVE' }, select: { id: true } }),\n    prisma.submission.findUnique({ where: { assignmentId_studentId: { assignmentId, studentId: input.studentId } }, select: { id: true } }),\n  ]);\n  if (!enrolled) throw invalid('That student is not enrolled in this course.');\n  if (existing) throw new AppError('CONFLICT', 'This student already has a submission; grade that one instead.');\n  const { raw, rubricScores } = scoreFrom(a, input);\n  const finalScore = computeFinalScore(raw, 0).toFixed(2);\n  const now = new Date();\n  const sub = await prisma.submission.create({\n    data: {\n      assignmentId,\n      studentId: input.studentId,\n      status: input.return ? 'RETURNED' : 'SUBMITTED',\n      text: null,\n      attemptNumber: 0,\n      submittedAt: now,\n      isLate: false,\n      lateDays: 0,\n      rawScore: raw,\n      penaltyPercent: '0',\n      finalScore,\n      rubricScores,\n      feedback: input.feedback ?? null,\n      gradedById: user.id,\n      gradedAt: now,\n      returnedAt: input.return ? now : null,\n    },\n  });\n  await audit({ actorId: user.id, action: 'submission.grade_offline', entityType: 'Submission', entityId: sub.id, metadata: { assignmentId, studentId: input.studentId, finalScore }, request });\n  if (input.return) await notifyReturned(a, input.studentId, finalScore);\n  return toSubmission(await loadFullSubmission(sub.id));\n}\n\n/** FR-35: PUT upserts, DELETE removes; both idempotent. The row is the PRD-11 exclusion flag. */\nexport async function setExemption(\n  user: AccessUser,\n  assignmentId: string,\n  studentId: string,\n  exempt: boolean,\n  reason?: string,\n  request?: Request,\n) {\n  const a = await prisma.assignment.findUnique({ where: { id: assignmentId }, select: { courseId: true } });\n  if (!a) throw notFound();\n  await assertCanManageCourse(user, a.courseId);\n  if (exempt) {\n    const enrolled = await prisma.enrollment.findFirst({ where: { courseId: a.courseId, studentId, status: 'ACTIVE' }, select: { id: true } });\n    if (!enrolled) throw invalid('That student is not enrolled in this course.');\n    await prisma.gradeExemption.upsert({\n      where: { assignmentId_studentId: { assignmentId, studentId } },\n      update: { reason: reason ?? null },\n      create: { assignmentId, studentId, reason: reason ?? null },\n    });\n  } else {\n    await prisma.gradeExemption.deleteMany({ where: { assignmentId, studentId } });\n  }\n  await audit({ actorId: user.id, action: exempt ? 'assignment.exempt' : 'assignment.unexempt', entityType: 'Assignment', entityId: assignmentId, metadata: { studentId, reason }, request });\n  return exempt ? { assignmentId, studentId, exempt: true as const, reason: reason ?? null } : { assignmentId, studentId, exempt: false as const };\n}\n\n// ---------------------------------------------------------------------------\n// Reads (FR-48, FR-50, FR-54, FR-55, FR-57, FR-58)\n// ---------------------------------------------------------------------------\n\nasync function loadCourseForView(user: AccessUser, courseId: string) {\n  await assertCanViewCourse(user, courseId);\n  return prisma.course.findUniqueOrThrow({ where: { id: courseId }, select: { id: true, name: true, teacherId: true, coTeacherIds: true } });\n}\n\nexport async function listCourseAssignments(user: AccessUser, courseId: string, studentId?: string) {\n  const course = await loadCourseForView(user, courseId);\n  const now = new Date();\n\n  if (canSeeDrafts(user, course)) {\n    const [assignments, roster] = await Promise.all([\n      prisma.assignment.findMany({ where: { courseId }, include: { course: { select: { name: true } } }, orderBy: { dueAt: 'asc' } }),\n      prisma.enrollment.findMany({ where: { courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n    ]);\n    const active = new Set(roster.map((r) => r.studentId));\n    const ids = assignments.map((a) => a.id);\n    const [subs, exemptions] = await Promise.all([\n      prisma.submission.findMany({ where: { assignmentId: { in: ids } }, select: { assignmentId: true, studentId: true, status: true, gradedAt: true, attemptNumber: true } }),\n      prisma.gradeExemption.findMany({ where: { assignmentId: { in: ids } }, select: { assignmentId: true, studentId: true } }),\n    ]);\n    const items = assignments.map((a) => {\n      const mine = subs.filter((s) => s.assignmentId === a.id && active.has(s.studentId));\n      const exempt = new Set(exemptions.filter((e) => e.assignmentId === a.id && active.has(e.studentId)).map((e) => e.studentId));\n      const submittedIds = new Set(mine.map((s) => s.studentId));\n      const pastDue = isAssignmentVisible(a, now) && a.dueAt < now && a.submissionType !== 'NO_SUBMISSION';\n      return {\n        ...toSummary(a),\n        counts: {\n          enrolled: active.size,\n          submitted: mine.filter((s) => s.attemptNumber > 0).length,\n          graded: mine.filter((s) => s.gradedAt).length,\n          returned: mine.filter((s) => s.status === 'RETURNED').length,\n          exempt: exempt.size,\n          missing: pastDue ? [...active].filter((id) => !submittedIds.has(id) && !exempt.has(id)).length : 0,\n        },\n      };\n    });\n    return { view: 'manager' as const, items };\n  }\n\n  const viewed = await resolveViewedStudent(user, studentId, courseId);\n  const assignments = await prisma.assignment.findMany({\n    where: { courseId, ...visibleWhere(now) },\n    include: {\n      course: { select: { name: true } },\n      submissions: { where: { studentId: viewed.studentId }, select: summarySubSelect },\n      exemptions: { where: { studentId: viewed.studentId }, select: { studentId: true } },\n    },\n    orderBy: { dueAt: 'asc' },\n  });\n  publishNewlyVisible(assignments, now);\n  return {\n    view: 'student' as const,\n    studentId: viewed.studentId,\n    children: viewed.children,\n    items: assignments.map((a) => toStudentRow(a, a.submissions[0] ?? null, a.exemptions.length > 0, now)),\n  };\n}\n\nexport async function getAssignment(user: AccessUser, id: string, studentId?: string) {\n  const a = await loadFull(id);\n  await assertCanViewCourse(user, a.courseId);\n  const now = new Date();\n  const serverNow = now.toISOString();\n  if (canSeeDrafts(user, a.course)) {\n    const submissionCount = await prisma.submission.count({ where: { assignmentId: id, attemptNumber: { gt: 0 } } });\n    return { assignment: toAssignment(a), canManage: true as const, submissionCount, serverNow, submission: null, exempt: false, studentId: null };\n  }\n  if (!isAssignmentVisible(a, now)) throw notFound();\n  publishNewlyVisible([a], now);\n  const viewed = await resolveViewedStudent(user, studentId, a.courseId);\n  const [sub, exemption] = await Promise.all([\n    prisma.submission.findUnique({ where: { assignmentId_studentId: { assignmentId: id, studentId: viewed.studentId } }, include: submissionInclude }),\n    prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: id, studentId: viewed.studentId } } }),\n  ]);\n  return {\n    assignment: toAssignment(a),\n    canManage: false as const,\n    submissionCount: undefined,\n    serverNow,\n    submission: sub ? toStudentSubmission(toSubmission(sub)) : null,\n    exempt: !!exemption,\n    studentId: viewed.studentId,\n  };\n}\n\nexport type RosterRow = {\n  student: { id: string; name: string };\n  chipStatus: ChipStatus;\n  exempt: boolean;\n  submission: {\n    id: string;\n    status: 'SUBMITTED' | 'RETURNED';\n    attemptNumber: number;\n    submittedAt: string;\n    isLate: boolean;\n    lateDays: number;\n    finalScore: string | null;\n    gradedAt: string | null;\n    returnedAt: string | null;\n  } | null;\n};\n\n/** FR-54: every ACTIVE enrollee, submitted or not. */\nexport async function listGradingRoster(\n  user: AccessUser,\n  assignmentId: string,\n  query: { sort: 'name' | 'submittedAt'; status?: ChipStatus },\n  page: { skip: number; take: number },\n) {\n  const a = await prisma.assignment.findUnique({ where: { id: assignmentId }, select: { courseId: true } });\n  if (!a) throw notFound();\n  await assertCanManageCourse(user, a.courseId);\n  const [roster, subs, exemptions] = await Promise.all([\n    prisma.enrollment.findMany({\n      where: { courseId: a.courseId, status: 'ACTIVE' },\n      select: { student: { select: { id: true, firstName: true, lastName: true } } },\n      orderBy: [{ student: { lastName: 'asc' } }, { student: { firstName: 'asc' } }],\n    }),\n    prisma.submission.findMany({\n      where: { assignmentId },\n      select: { id: true, studentId: true, status: true, attemptNumber: true, submittedAt: true, isLate: true, lateDays: true, finalScore: true, gradedAt: true, returnedAt: true },\n    }),\n    prisma.gradeExemption.findMany({ where: { assignmentId }, select: { studentId: true } }),\n  ]);\n  const exempt = new Set(exemptions.map((e) => e.studentId));\n  let rows: RosterRow[] = roster.map(({ student }) => {\n    const s = subs.find((x) => x.studentId === student.id) ?? null;\n    const isExempt = exempt.has(student.id);\n    return {\n      student: userRef(student)!,\n      chipStatus: submissionChipStatus({ exempt: isExempt, submission: s }),\n      exempt: isExempt,\n      submission: s\n        ? {\n            id: s.id,\n            status: s.status,\n            attemptNumber: s.attemptNumber,\n            submittedAt: s.submittedAt.toISOString(),\n            isLate: s.isLate,\n            lateDays: s.lateDays,\n            finalScore: serializeDecimal(s.finalScore),\n            gradedAt: iso(s.gradedAt),\n            returnedAt: iso(s.returnedAt),\n          }\n        : null,\n    };\n  });\n  if (query.status) rows = rows.filter((r) => r.chipStatus === query.status);\n  if (query.sort === 'submittedAt') {\n    rows.sort((x, y) => (x.submission?.submittedAt ?? '￿').localeCompare(y.submission?.submittedAt ?? '￿'));\n  }\n  return { items: rows.slice(page.skip, page.skip + page.take), total: rows.length };\n}\n\n/** FR-55: submitter, linked parent, or course manager (history only for managers); anyone else NOT_FOUND. */\nexport async function getSubmission(user: AccessUser, submissionId: string) {\n  const sub = await prisma.submission.findUnique({\n    where: { id: submissionId },\n    include: {\n      ...submissionInclude,\n      history: { orderBy: { attemptNumber: 'asc' } },\n      assignment: { select: { status: true, availableFrom: true, archivedAt: true, course: { select: { teacherId: true, coTeacherIds: true } } } },\n    },\n  });\n  const missing = new AppError('NOT_FOUND', 'Submission not found');\n  if (!sub) throw missing;\n  if (canSeeDrafts(user, sub.assignment.course)) {\n    const fileIds = [...new Set(sub.history.flatMap((h) => h.fileIds))];\n    const files = fileIds.length ? await prisma.fileObject.findMany({ where: { id: { in: fileIds } } }) : [];\n    const dto = toSubmission(sub);\n    dto.history = sub.history.map((h) => ({\n      attemptNumber: h.attemptNumber,\n      text: h.text,\n      files: h.fileIds.map((fid) => files.find((f) => f.id === fid)).filter((f): f is FileObject => !!f).map(fileRef),\n      submittedAt: h.submittedAt.toISOString(),\n    }));\n    return dto;\n  }\n  if (!isAssignmentVisible(sub.assignment, new Date())) throw missing;\n  const own = user.role === 'STUDENT' && sub.studentId === user.id;\n  const parent =\n    user.role === 'PARENT' &&\n    !!(await prisma.parentStudentLink.findFirst({ where: { parentId: user.id, studentId: sub.studentId }, select: { id: true } }));\n  if (!own && !parent) throw missing;\n  return toStudentSubmission(toSubmission(sub));\n}\n\n/** Rows for one student across ACTIVE enrollments (optionally one course). */\nasync function studentRows(studentId: string, courseId: string | undefined, now: Date, fullGradesFor: (courseId: string) => boolean = () => false) {\n  const enrollments = await prisma.enrollment.findMany({\n    where: { studentId, status: 'ACTIVE' },\n    select: { course: { select: { id: true, name: true, teacherId: true, coTeacherIds: true } } },\n    orderBy: { course: { name: 'asc' } },\n  });\n  const courses = enrollments.map((e) => e.course);\n  const courseIds = courses.map((c) => c.id).filter((id) => !courseId || id === courseId);\n  const assignments = await prisma.assignment.findMany({\n    where: { courseId: { in: courseIds }, ...visibleWhere(now) },\n    include: {\n      course: { select: { name: true } },\n      submissions: { where: { studentId }, select: summarySubSelect },\n      exemptions: { where: { studentId }, select: { studentId: true } },\n    },\n    orderBy: { dueAt: 'asc' },\n  });\n  publishNewlyVisible(assignments, now);\n  return {\n    courses,\n    rows: assignments.map((a) => ({\n      ...toStudentRow(a, a.submissions[0] ?? null, a.exemptions.length > 0, now, fullGradesFor(a.courseId)),\n      canManage: fullGradesFor(a.courseId),\n    })),\n  };\n}\n\nconst TO_GRADE_LIMIT = 200;\n\nexport async function listMyAssignments(user: AccessUser, query: { studentId?: string; tab?: Exclude<Group, 'CLOSED'>; courseId?: string }) {\n  if (user.role === 'TEACHER' || user.role === 'ADMIN') {\n    const subs = await prisma.submission.findMany({\n      where: {\n        status: 'SUBMITTED',\n        gradedAt: null,\n        attemptNumber: { gt: 0 },\n        assignment: {\n          archivedAt: null,\n          ...(query.courseId ? { courseId: query.courseId } : {}),\n          ...(user.role === 'TEACHER' ? { course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] } } : {}),\n        },\n      },\n      select: {\n        id: true,\n        submittedAt: true,\n        isLate: true,\n        student: { select: { id: true, firstName: true, lastName: true } },\n        assignment: { include: { course: { select: { name: true } } } },\n      },\n      orderBy: { submittedAt: 'asc' },\n      // ponytail: capped list, add pagination if a teacher ever has > 200 ungraded submissions.\n      take: TO_GRADE_LIMIT,\n    });\n    return {\n      view: 'toGrade' as const,\n      items: subs.map((s) => ({\n        submissionId: s.id,\n        assignment: toSummary(s.assignment),\n        student: userRef(s.student)!,\n        submittedAt: s.submittedAt.toISOString(),\n        isLate: s.isLate,\n      })),\n    };\n  }\n\n  const viewed = await resolveViewedStudent(user, query.studentId);\n  const now = new Date();\n  const { courses, rows } = await studentRows(viewed.studentId, query.courseId, now);\n  const items = rows\n    .map(({ canManage: _c, ...r }) => r)\n    // Tab omitted → all rows (the page groups them client-side).\n    .filter((r) => !query.tab || r.group === query.tab);\n  return {\n    view: 'student' as const,\n    studentId: viewed.studentId,\n    children: viewed.children,\n    courses: courses.map((c) => ({ id: c.id, name: c.name })),\n    items,\n  };\n}\n\n/** FR-58 / D8: per course, managers get full grade fields, everyone else the serializer. */\nexport async function listStudentAssignments(user: AccessUser, studentId: string, courseId?: string) {\n  await assertCanViewStudent(user, studentId);\n  const student = await prisma.user.findFirst({ where: { id: studentId, role: 'STUDENT' }, select: { id: true, firstName: true, lastName: true } });\n  if (!student) throw new AppError('NOT_FOUND', 'Student not found');\n  const now = new Date();\n  const enrollments = await prisma.enrollment.findMany({\n    where: { studentId, status: 'ACTIVE' },\n    select: { course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n  });\n  const managed = new Set(enrollments.filter((e) => canSeeDrafts(user, e.course)).map((e) => e.course.id));\n  const { rows } = await studentRows(studentId, courseId, now, (cid) => managed.has(cid));\n  return { student: userRef(student)!, items: rows };\n}\n","numLines":1118,"startLine":1,"totalLines":1118}},"tool_result_meta":[{"id":"toolu_016AVwwBMUypxJ2tWog88Q4B","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
