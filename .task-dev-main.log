{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg69QSGDRn7SMqH1VdR8k","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019EVLyeEdBLw3qq2aHEevFL","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/LoadingSkeleton/LoadingSkeleton.tsx","content":"import Stack from '@mui/material/Stack';\nimport Skeleton from '@mui/material/Skeleton';\n\nexport interface LoadingSkeletonProps {\n  variant: 'table' | 'card' | 'form';\n  rows?: number;\n}\n\nexport function LoadingSkeleton({ variant, rows = 5 }: LoadingSkeletonProps) {\n  if (variant === 'table') {\n    return (\n      <Stack spacing={1}>\n        {Array.from({ length: rows }).map((_, index) => (\n          <Skeleton key={index} variant=\"rectangular\" height={40} />\n        ))}\n      </Stack>\n    );\n  }\n\n  if (variant === 'card') {\n    return <Skeleton variant=\"rounded\" height={140} />;\n  }\n\n  return (\n    <Stack spacing={2}>\n      {Array.from({ length: rows }).map((_, index) => (\n        <Skeleton key={index} variant=\"rounded\" height={56} />\n      ))}\n    </Stack>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1221,"cache_read_input_tokens":87391,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1221},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab594185-c31c-412a-a5f0-563328d811ca","uuid":"78540a78-e083-461a-8b1b-d31609a76c3d","timestamp":"2026-10-16T15:23:33.897Z","request_id":"req_011Cg69QRrez4aqXPijTfYUu"}
