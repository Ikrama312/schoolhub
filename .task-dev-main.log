{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Y7KsgMmjH8sU6gEkoybiV","type":"tool_result","content":"96\texport function QuizSettingsPanel({\n97\t  quiz,\n98\t  timezone,\n99\t  accommodations,\n100\t  onSaved,\n101\t}: {\n102\t  quiz: ManagerQuiz;\n103\t  timezone: string;\n104\t  accommodations: AccommodationRow[];\n105\t  onSaved: () => void;\n106\t}) {\n107\t  const { showToast } = useToast();\n108\t  const toWall = (iso: string) => toZonedTime(iso, timezone);\n109\t  const [v, setV] = useState({\n110\t    title: quiz.title,\n111\t    instructions: quiz.instructions,\n112\t    isPractice: quiz.isPractice,\n113\t    availableFrom: toWall(quiz.availableFrom) as Date | null,\n114\t    availableUntil: toWall(quiz.availableUntil) as Date | null,\n115\t    timeLimitMinutes: quiz.timeLimitMinutes == null ? '' : String(quiz.timeLimitMinutes),\n116\t    maxAttempts: String(quiz.maxAttempts),\n117\t    scoringPolicy: quiz.scoringPolicy,\n118\t    shuffleQuestions: quiz.shuffleQuestions,\n119\t    shuffleOptions: quiz.shuffleOptions,\n120\t    oneQuestionPerPage: quiz.oneQuestionPerPage,\n121\t    resultsVisibility: quiz.resultsVisibility,\n122\t    showCorrectAnswers: quiz.showCorrectAnswers,\n123\t  });\n124\t  const [errors, setErrors] = useState<FieldErrors>({});\n125\t  const [saving, setSaving] = useState(false);\n126\t  const set = <K extends keyof typeof v>(k: K, val: (typeof v)[K]) => setV((s) => ({ ...s, [k]: val }));\n127\t\n128\t  const save = async () => {\n129\t    const input = {\n130\t      ...v,\n131\t      availableFrom: v.availableFrom ? fromZonedTime(v.availableFrom, timezone).toISOString() : undefined,\n132\t      availableUntil: v.availableUntil ? fromZonedTime(v.availableUntil, timezone).toISOString() : undefined,\n133\t      timeLimitMinutes: v.timeLimitMinutes.trim() === '' ? null : v.timeLimitMinutes,\n134\t    };\n135\t    const parsed = quizSettingsSchema.safeParse(input);\n136\t    if (!parsed.success) {\n137\t      setErrors(zodErrors(parsed.error.issues));\n138\t      return;\n139\t    }\n140\t    setErrors({});\n141\t    setSaving(true);\n142\t    const res = await fetch(`/api/quizzes/${quiz.id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(input) });\n143\t    setSaving(false);\n144\t    if (!res.ok) {\n145\t      const body = await res.json().catch(() => null);\n146\t      const fe = body?.error?.details?.fieldErrors as Record<string, string[]> | undefined;\n147\t      if (fe) setErrors(Object.fromEntries(Object.entries(fe).map(([k, m]) => [k, m[0]])));\n148\t      showToast({ message: body?.error?.message ?? 'Could not save settings.', severity: 'error' });\n149\t      return;\n150\t    }\n151\t    showToast({ message: 'Settings saved', severity: 'success' });\n152\t    onSaved();\n153\t  };\n154\t\n155\t  const picker = (name: string, helper: string) => ({ textField: { fullWidth: true, error: !!errors[name], helperText: errors[name] ?? helper } });\n156\t  const sw = (k: 'isPractice' | 'shuffleQuestions' | 'shuffleOptions' | 'oneQuestionPerPage' | 'showCorrectAnswers', label: string) => (\n157\t    <FormControlLabel control={<Switch checked={v[k]} onChange={(e) => set(k, e.target.checked)} />} label={label} />\n158\t  );\n159\t\n160\t  return (\n161\t    <Stack spacing={3}>\n162\t      <Paper variant=\"outlined\" sx={{ p: 2 }}>\n163\t        <Stack spacing={2}>\n164\t          <Typography variant=\"h6\" component=\"h2\">\n165\t            Settings\n166\t          </Typography>\n167\t          <TextField label=\"Title\" value={v.title} onChange={(e) => set('title', e.target.value)} required fullWidth error={!!errors.title} helperText={errors.title} slotProps={{ htmlInput: { maxLength: TITLE_MAX } }} />\n168\t          <MarkdownEditor label=\"Instructions\" value={v.instructions} onChange={(x) => set('instructions', x)} maxLength={INSTRUCTIONS_MAX} minRows={3} error={errors.instructions} />\n169\t          <Stack direction={{ 