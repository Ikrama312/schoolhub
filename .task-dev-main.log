{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GRKEgXM4hwrWToH8STjr5E","type":"tool_result","content":"1\t{\n2\t  \"ticketId\": \"SH-7\",\n3\t  \"timestamp\": \"2026-11-06T06:45:00Z\",\n4\t  \"phase\": \"architect\",\n5\t  \"version\": \"1.0\",\n6\t  \"conventions\": {\n7\t    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-10 forbids renaming routes)\",\n8\t    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/attendance.ts) → resource assert → attendance-service → ok()/paginated(). Every helper comes from src/server/http.ts (system-design §3.1).\",\n9\t    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n10\t    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"total\": \"int\" } },\n11\t    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n12\t    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },\n13\t    \"validationErrorDetails\": \"A ZodError maps to VALIDATION_ERROR with details = zod flatten() { formErrors, fieldErrors }. Service-raised NFR-3 roster errors use details { invalidStudentIds: string[] } or { missingStudentIds: string[] }.\",\n14\t    \"dates\": \"Date-only values are 'yyyy-MM-dd' strings interpreted in SchoolSettings.timezone. Timestamps are ISO 8601 UTC. Display uses formatInSchoolTz (ADR-5).\",\n15\t    \"ids\": \"All ids are cuid strings.\",\n16\t    \"requirementIds\": [\"FR-35\", \"FR-36\", \"NFR-7\", \"NFR-8\"]\n17\t  },\n18\t  \"sharedSchemas\": {\n19\t    \"DateOnly\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n20\t    \"AttendanceStatus\": { \"type\": \"string\", \"enum\": [\"PRESENT\", \"ABSENT\", \"LATE\", \"EXCUSED\"] },\n21\t    \"AttendanceMode\": { \"type\": \"string\", \"enum\": [\"PER_PERIOD\", \"DAILY_HOMEROOM\", \"BOTH\"] },\n22\t    \"RegisterKey\": {\n23\t      \"description\": \"Zod union registerQuery (C6). Course variant or section (daily) variant; exactly one (FR-2).\",\n24\t      \"oneOf\": [\n25\t        { \"type\": \"object\", \"required\": [\"courseId\", \"date\", \"periodId\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" }, \"periodId\": { \"type\": \"string\" } } },\n26\t        { \"type\": \"object\", \"required\": [\"sectionId\", \"date\"], \"properties\": { \"sectionId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } }\n27\t      ]\n28\t    },\n29\t    \"RegisterRecordInput\": {\n30\t      \"description\": \"Zod registerRecord (C6). minutesLate is required (1–240) iff status = LATE and forbidden otherwise (superRefine). EXCUSED is ADMIN-only, checked in the service (FR-10).\",\n31\t      \"type\": \"object\",\n32\t      \"required\": [\"studentId\", \"status\"],\n33\t      \"properties\": {\n34\t        \"studentId\": { \"type\": \"string\" },\n35\t        \"status\": { \"$ref\": \"#/sharedSchemas/AttendanceStatus\" },\n36\t        \"minutesLate\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 240 },\n37\t        \"note\": { \"type\": \"string\", \"maxLength\": 500 }\n38\t      }\n39\t    },\n40\t    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n41\t    \"Register\": {\n42\t      \"description\": \"Returned by GET and PUT /api/attendance/register.\",\n43\t      \"type\": \"object\",\n44\t      \"properties\": {\n45\t        \"key\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n46\t        \"header\": { \"type\": \"object\", \"properties\": { \"courseName\": { \"type\": \"string|null\" }, \"sectionName\": { \"type\": \"string\" }, \"periodName\": { \"type\": \"string|null\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } },\n47\t        \"sessionId\": { \"type\": \"string|null\", \"description\": \"null when no register has been saved yet\" },\n48\t        \"students\": {\n49\t          \"type\": \"array\",\n50\t          \"description\": \"Roster active on the date, sorted by last name (FR-9, NFR-3)\",\n51\t          \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" }, \"avatarUrl\": { \"type\": \"string|null\" } } }\n52\t        },\n53\t        \"records\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" }, \"description\": \"Existing records; empty for a new register (nothing preselected, FR-9)\" },\n54\t        \"takenBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n55\t        \"updatedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n56\t        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n57\t        \"readOnly\": { \"type\": \"boolean\" },\n58\t        \"readOnlyReason\": { \"type\": \"string|null\", \"description\": \"e.g. 'Teachers can edit registers up to 14 days after the register date' (FR-19)\" },\n59\t        \"canExcuse\": { \"type\": \"boolean\", \"description\": \"true only for ADMIN (FR-10)\" }\n60\t      }\n61\t    },\n62\t    \"StatusCounts\": { \"type\": \"object\", \"properties\": { \"records\": { \"type\": \"integer\" }, \"present\": { \"type\": \"integer\" }, \"absent\": { \"type\": \"integer\" }, \"late\": { \"type\": \"integer\" }, \"excused\": { \"type\": \"integer\" }, \"rate\": { \"type\": \"number|null\", \"description\": \"(P+L+E)/records×100, 1 dp; null when records = 0 (FR-28)\" } } },\n63\t    \"StudentSummaryRow\": {\n64\t      \"allOf\": [\n65\t        { \"type\": \"object\", \"properties\": { \"studentId\": { \"type\": \"string\" }, \"studentName\": { \"type\": \"string\" }, \"sectionName\": { \"type\": \"string|null\" }, \"gradeLevelName\": { \"type\": \"string|null\" } } },\n66\t        { \"$ref\": \"#/sharedSchemas/StatusCounts\" }\n67\t      ]\n68\t    }\n69\t  },\n70\t  \"endpoints\": [\n71\t    {\n72\t      \"method\": \"GET\",\n73\t      \"path\": \"/api/attendance/today\",\n74\t      \"description\": \"The teacher's meetings for today in the school timezone (getScheduleForDate) joined with today's sessions, with the current slot flagged. Includes daily homeroom entries when attendanceMode is DAILY_HOMEROOM or BOTH. Guard: requireRole('TEACHER','ADMIN'). An ADMIN gets [] meetings plus no homeroom entries unless they are a homeroom teacher.\",\n75\t      \"requestSchema\": { \"query\": {} },\n76\t      \"responseSchema\": {\n77\t        \"data\": {\n78\t          \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" },\n79\t          \"meetings\": {\n80\t            \"type\": \"array\",\n81\t            \"items\": {\n82\t              \"kind\": \"'course'\",\n83\t              \"courseId\": \"string\",\n84\t              \"courseName\": \"string\",\n85\t              \"sectionName\": \"string\",\n86\t              \"periodId\": \"string\",\n87\t              \"periodName\": \"string\",\n88\t              \"startTime\": \"HH:mm\",\n89\t              \"endTime\": \"HH:mm\",\n90\t              \"isCurrent\": \"boolean\",\n91\t              \"taken\": \"null | { at: ISO date-time, by: UserRef }\"\n92\t            }\n93\t          },\n94\t          \"dailyRegisters\": {\n95\t            \"type\": \"array\",\n96\t            \"items\": { \"kind\": \"'section'\", \"sectionId\": \"string\", \"sectionName\": \"string\", \"taken\": \"null | { at, by: UserRef }\" }\n97\t          }\n98\t        }\n99\t      },\n100\t      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],\n101\t      \"requirementIds\": [\"FR-6\", \"FR-7\", \"FR-35\"]\n102\t    },\n103\t    {\n104\t      \"method\": \"GET\",\n105\t      \"path\": \"/api/attendance/register\",\n106\t      \"description\": \"Load a course register (?courseId=&date=&periodId=) or daily register (?sectionId=&date=). Guard: requireUser, then assertCanManageCourse or assertCanManageSection (ADMIN or homeroom teacher). Future dates → 400; TEACHER more than 14 days back → 403 for opening (canOpen). Past the edit window → readOnly = true with readOnlyReason.\",\n107\t      \"requestSchema\": { \"query\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" } },\n108\t      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n109\t      \"errors\": [\"VALIDATION_ERROR (bad key, future date)\", \"FORBIDDEN (no access, outside 14-day open window)\", \"NOT_FOUND (course/section/period)\"],\n110\t      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-19\", \"FR-35\", \"NFR-3\", \"NFR-7\"]\n111\t    },\n112\t    {\n113\t      \"method\": \"PUT\",\n114\t      \"path\": \"/api/attendance/register\",\n115\t      \"description\": \"Create or update the session and all records in one transaction (system-design §3.2). Records must cover the whole active roster and only roster students. After commit: audit('attendance.record.update') per changed status, and notifyStudentAndParents per transition into ABSENT/LATE or ABSENT→PRESENT (corrected). Re-saving unchanged statuses sends nothing. Idempotent: a P2002 race on the partial unique index re-reads the session rather than returning CONFLICT.\",\n116\t      \"requestSchema\": {\n117\t        \"body\": {\n118\t          \"description\": \"Zod registerPutBody = RegisterKey & { records }\",\n119\t          \"allOf\": [\n120\t            { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n121\t            { \"type\": \"object\", \"required\": [\"records\"], \"properties\": { \"records\": { \"type\": \"array\", \"minItems\": 1, \"uniqueBy\": \"studentId\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" } } } }\n122\t          ]\n123\t        }\n124\t      },\n125\t      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n126\t      \"errors\": [\n127\t        \"VALIDATION_ERROR (schema; future date; studentId not active on date → details.invalidStudentIds; roster not fully marked → details.missingStudentIds)\",\n128\t        \"FORBIDDEN (no access; TEACHER past 14-day edit window; EXCUSED by non-ADMIN)\",\n129\t        \"NOT_FOUND\"\n130\t      ],\n131\t      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"FR-35\", \"FR-36\", \"NFR-1\", \"NFR-3\", \"NFR-5\", \"NFR-7\"]\n132\t    },\n133\t    {\n134\t      \"method\": \"GET\",\n135\t      \"path\": \"/api/students/{studentId}/attendance\",\n136\t      \"description\": \"Student attendance tab data in one indexed query. Guard: requireUser + assertCanViewStudent (parent → linked students, student → self, teacher/admin per existing rules). Session kind follows attendanceMode (course sessions for PER_PERIOD/BOTH, section sessions for DAILY_HOMEROOM). `note` is omitted from rows for STUDENT and PARENT. from/to default to the current month; summaries always cover the current term and academic year regardless of from/to.\",\n137\t      \"requestSchema\": { \"path\": { \"studentId\": \"string\" }, \"query\": { \"from\": \"DateOnly?\", \"to\": \"DateOnly?\" } },\n138\t      \"responseSchema\": {\n139\t        \"data\": {\n140\t          \"summary\": { \"term\": { \"$ref\": \"#/sharedSchemas/StatusCounts\", \"termName\": \"string|null\" }, \"year\": { \"$ref\": \"#/sharedSchemas/StatusCounts\" } },\n141\t          \"calendar\": { \"type\": \"array\", \"items\": { \"date\": \"DateOnly\", \"colour\": \"'success'|'warning'|'error'|'default'\", \"present\": \"int\", \"absent\": \"int\", \"late\": \"int\", \"excused\": \"int\" } },\n142\t          \"records\": {\n143\t            \"type\": \"array\",\n144\t            \"items\": { \"id\": \"string\", \"date\": \"DateOnly\", \"periodName\": \"string|null\", \"courseName\": \"string|null\", \"sectionName\": \"string|null\", \"status\": \"AttendanceStatus\", \"minutesLate\": \"int|null\", \"note\": \"string|null (absent key for STUDENT/PARENT)\" }\n145\t          }\n146\t        }\n147\t      },\n148\t      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n149\t      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-35\", \"NFR-1\", \"NFR-7\"]\n150\t    },\n151\t    {\n152\t      \"method\": \"GET\",\n153\t      \"path\": \"/api/courses/{courseId}/attendance\",\n154\t      \"description\": \"Course attendance matrix: the last 20 sessions by date (columns) × enrolled students (ACTIVE, plus DROPPED students with records) with P/A/L/E cells and per-student rate. Guard: requireUser + assertCanManageCourse.\",\n155\t      \"requestSchema\": { \"path\": { \"courseId\": \"string\" }, \"query\": {} },\n156\t      \"responseSchema\": {\n157\t        \"data\": {\n158\t          \"sessions\": { \"type\": \"array\", \"items\": { \"sessionId\": \"string\", \"date\": \"DateOnly\", \"periodId\": \"string\", \"periodName\": \"string\" } },\n159\t          \"students\": {\n160\t            \"type\": \"array\",\n161\t            \"items\": { \"studentId\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"enrollmentStatus\": \"'ACTIVE'|'DROPPED'\", \"cells\": \"{ [sessionId]: AttendanceStatus }\", \"rate\": \"number|null\" }\n162\t          }\n163\t        }\n164\t      },\n165\t      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n166\t      \"requirementIds\": [\"FR-28\", \"FR-29\", \"FR-35\", \"NFR-7\"]\n167\t    },\n168\t    {\n169\t      \"method\": \"GET\",\n170\t      \"path\": \"/api/admin/attendance/overview\",\n171\t      \"description\": \"Today overview: expected meetings (getSchoolScheduleForDate + homeroom sections when mode includes daily) vs taken sessions, the school-wide rate for the date, and missing registers (no session and period.startTime + 15 min ≤ now in school tz; only computed when date is today). Guard: requireRole('ADMIN').\",\n172\t      \"requestSchema\": { \"query\": { \"date\": \"DateOnly? (default school today; future → 400)\" } },\n173\t      \"responseSchema\": {\n174\t        \"data\": {\n175\t          \"date\": \"DateOnly\",\n176\t          \"expected\": \"int\",\n177\t          \"taken\": \"int\",\n178\t          \"rate\": \"number|null\",\n179\t          \"missing\": {\n180\t            \"type\": \"array\",\n181\t            \"items\": { \"courseId\": \"string\", \"courseName\": \"string\", \"sectionName\": \"string\", \"periodId\": \"string\", \"periodName\": \"string\", \"startTime\": \"HH:mm\", \"teacher\": \"UserRef\" }\n182\t          }\n183\t        }\n184\t      },\n185\t      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n186\t      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-35\", \"NFR-7\"]\n187\t    },\n188\t    {\n189\t      \"method\": \"GET\",\n190\t      \"path\": \"/api/admin/attendance/report\",\n191\t      \"description\": \"Per-student summary over the filtered range (groupBy studentId, status). JSON is paginated (pageSize ≤ 100). With ?format=csv returns every row as text/csv (Content-Disposition: attachment; filename=attendance-report-<from>-<to>.csv) via toCsv, with columns: Student, Section, Grade, Records, Present, Absent, Late, Excused, Rate. Guard: requireRole('ADMIN').\",\n192\t      \"requestSchema\": {\n193\t        \"query\": {\n194\t          \"from\": \"DateOnly (required)\",\n195\t          \"to\": \"DateOnly (required, ≥ from, range ≤ 366 days)\",\n196\t          \"gradeLevelId\": \"string?\",\n197\t          \"sectionId\": \"string?\",\n198\t          \"courseId\": \"string?\",\n199\t          \"status\": \"AttendanceStatus? (only students with ≥1 record of this status)\",\n200\t          \"format\": \"'csv'?\",\n201\t          \"page\": \"int? (default 1, ignored for csv)\",\n202\t          \"pageSize\": \"int? (default 20, max 100, ignored for csv)\"\n203\t        }\n204\t      },\n205\t      \"responseSchema\": {\n206\t        \"json\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" } }, \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n207\t        \"csv\": \"text/csv; charset=utf-8\"\n208\t      },\n209\t      \"errors\": [\"VALIDATION_ERROR (range > 366 days, to < from)\", \"FORBIDDEN\"],\n210\t      \"requirementIds\": [\"FR-32\", \"FR-35\", \"FR-36\", \"NFR-8\"]\n211\t    },\n212\t    {\n213\t      \"method\": \"GET\",\n214\t      \"path\": \"/api/admin/attendance/below-threshold\",\n215\t      \"description\": \"Students whose year-to-date rate is below SchoolSettings.attendanceAlertThreshold, sorted by rate ascending. Paginated (pageSize ≤ 100). Guard: requireRole('ADMIN').\",\n216\t      \"requestSchema\": { \"query\": { \"page\": \"int?\", \"pageSize\": \"int? (max 100)\" } },\n217\t      \"responseSchema\": {\n218\t        \"data\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" }, { \"href\": \"/students/<id>/attendance\" }] } },\n219\t        \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\", \"threshold\": \"int\" }\n220\t      },\n221\t      \"errors\": [\"FORBIDDEN\"],\n222\t      \"requirementIds\": [\"FR-33\", \"FR-35\", \"NFR-8\"]\n223\t    },\n224\t    {\n225\t      \"method\": \"POST\",\n226\t      \"path\": \"/api/admin/attendance/remind\",\n227\t      \"description\": \"Send 'attendance.register_missing' to the course teacher (notify, link /attendance/take/<courseId>?date=&periodId=), then audit('attendance.remind'). Guard: requireRole('ADMIN'). Returns 200 even if the notification fails to enqueue, because notify never throws.\",\n228\t      \"requestSchema\": { \"body\": { \"type\": \"object\", \"required\": [\"courseId\", \"periodId\", \"date\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"periodId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } } },\n229\t      \"responseSchema\": { \"data\": { \"reminded\": { \"$ref\": \"#/sharedSchemas/UserRef\" } } },\n230\t      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND (course/period)\"],\n231\t      \"requirementIds\": [\"FR-23\", \"FR-31\", \"FR-35\"]\n232\t    },\n233\t    {\n234\t      \"method\": \"PATCH\",\n235\t      \"path\": \"/api/settings/school\",\n236\t      \"description\": \"Minimal school settings update for this PRD: only the attendance fields (FR-5 default; the user may override this). Built on updateSchoolSettings() and writes audit('school_settings.update', { old, new }). Guard: requireRole('ADMIN'). Unknown keys are rejected (strict schema) so this route cannot widen scope.\",\n237\t      \"requestSchema\": {\n238\t        \"body\": {\n239\t          \"description\": \"Zod attendanceSettingsPatch (strict). At least one field.\",\n240\t          \"type\": \"object\",\n241\t          \"minProperties\": 1,\n242\t          \"additionalProperties\": false,\n243\t          \"properties\": { \"attendanceMode\": { \"$ref\": \"#/sharedSchemas/AttendanceMode\" }, \"attendanceAlertThreshold\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 } }\n244\t        }\n245\t      },\n246\t      \"responseSchema\": { \"data\": { \"attendanceMode\": \"AttendanceMode\", \"attendanceAlertThreshold\": \"int\" } },\n247\t      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n248\t      \"requirementIds\": [\"FR-4\", \"FR-5\", \"NFR-8\"]\n249\t    }\n250\t  ],\n251\t  \"status\": \"complete\"\n252\t}\n253\t"}]},"parent_tool_use_id":null,"session_id":"7fe1befa-2c95-4276-8d14-955b8d55df5c","uuid":"4250826b-fe28-44a5-a4a4-e185d04ec20d","timestamp":"2026-11-06T05:39:55.061Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-7\",\n  \"timestamp\": \"2026-11-06T06:45:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-10 forbids renaming routes)\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/attendance.ts) → resource assert → attendance-service → ok()/paginated(). Every helper comes from src/server/http.ts (system-design §3.1).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },\n    \"validationErrorDetails\": \"A ZodError maps to VALIDATION_ERROR with details = zod flatten() { formErrors, fieldErrors }. Service-raised NFR-3 roster errors use details { invalidStudentIds: string[] } or { missingStudentIds: string[] }.\",\n    \"dates\": \"Date-only values are 'yyyy-MM-dd' strings interpreted in SchoolSettings.timezone. Timestamps are ISO 8601 UTC. Display uses formatInSchoolTz (ADR-5).\",\n    \"ids\": \"All ids are cuid strings.\",\n    \"requirementIds\": [\"FR-35\", \"FR-36\", \"NFR-7\", \"NFR-8\"]\n  },\n  \"sharedSchemas\": {\n    \"DateOnly\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n    \"AttendanceStatus\": { \"type\": \"string\", \"enum\": [\"PRESENT\", \"ABSENT\", \"LATE\", \"EXCUSED\"] },\n    \"AttendanceMode\": { \"type\": \"string\", \"enum\": [\"PER_PERIOD\", \"DAILY_HOMEROOM\", \"BOTH\"] },\n    \"RegisterKey\": {\n      \"description\": \"Zod union registerQuery (C6). Course variant or section (daily) variant; exactly one (FR-2).\",\n      \"oneOf\": [\n        { \"type\": \"object\", \"required\": [\"courseId\", \"date\", \"periodId\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" }, \"periodId\": { \"type\": \"string\" } } },\n        { \"type\": \"object\", \"required\": [\"sectionId\", \"date\"], \"properties\": { \"sectionId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } }\n      ]\n    },\n    \"RegisterRecordInput\": {\n      \"description\": \"Zod registerRecord (C6). minutesLate is required (1–240) iff status = LATE and forbidden otherwise (superRefine). EXCUSED is ADMIN-only, checked in the service (FR-10).\",\n      \"type\": \"object\",\n      \"required\": [\"studentId\", \"status\"],\n      \"properties\": {\n        \"studentId\": { \"type\": \"string\" },\n        \"status\": { \"$ref\": \"#/sharedSchemas/AttendanceStatus\" },\n        \"minutesLate\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 240 },\n        \"note\": { \"type\": \"string\", \"maxLength\": 500 }\n      }\n    },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n    \"Register\": {\n      \"description\": \"Returned by GET and PUT /api/attendance/register.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"key\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n        \"header\": { \"type\": \"object\", \"properties\": { \"courseName\": { \"type\": \"string|null\" }, \"sectionName\": { \"type\": \"string\" }, \"periodName\": { \"type\": \"string|null\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } },\n        \"sessionId\": { \"type\": \"string|null\", \"description\": \"null when no register has been saved yet\" },\n        \"students\": {\n          \"type\": \"array\",\n          \"description\": \"Roster active on the date, sorted by last name (FR-9, NFR-3)\",\n          \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" }, \"avatarUrl\": { \"type\": \"string|null\" } } }\n        },\n        \"records\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" }, \"description\": \"Existing records; empty for a new register (nothing preselected, FR-9)\" },\n        \"takenBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"readOnly\": { \"type\": \"boolean\" },\n        \"readOnlyReason\": { \"type\": \"string|null\", \"description\": \"e.g. 'Teachers can edit registers up to 14 days after the register date' (FR-19)\" },\n        \"canExcuse\": { \"type\": \"boolean\", \"description\": \"true only for ADMIN (FR-10)\" }\n      }\n    },\n    \"StatusCounts\": { \"type\": \"object\", \"properties\": { \"records\": { \"type\": \"integer\" }, \"present\": { \"type\": \"integer\" }, \"absent\": { \"type\": \"integer\" }, \"late\": { \"type\": \"integer\" }, \"excused\": { \"type\": \"integer\" }, \"rate\": { \"type\": \"number|null\", \"description\": \"(P+L+E)/records×100, 1 dp; null when records = 0 (FR-28)\" } } },\n    \"StudentSummaryRow\": {\n      \"allOf\": [\n        { \"type\": \"object\", \"properties\": { \"studentId\": { \"type\": \"string\" }, \"studentName\": { \"type\": \"string\" }, \"sectionName\": { \"type\": \"string|null\" }, \"gradeLevelName\": { \"type\": \"string|null\" } } },\n        { \"$ref\": \"#/sharedSchemas/StatusCounts\" }\n      ]\n    }\n  },\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/today\",\n      \"description\": \"The teacher's meetings for today in the school timezone (getScheduleForDate) joined with today's sessions, with the current slot flagged. Includes daily homeroom entries when attendanceMode is DAILY_HOMEROOM or BOTH. Guard: requireRole('TEACHER','ADMIN'). An ADMIN gets [] meetings plus no homeroom entries unless they are a homeroom teacher.\",\n      \"requestSchema\": { \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" },\n          \"meetings\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"kind\": \"'course'\",\n              \"courseId\": \"string\",\n              \"courseName\": \"string\",\n              \"sectionName\": \"string\",\n              \"periodId\": \"string\",\n              \"periodName\": \"string\",\n              \"startTime\": \"HH:mm\",\n              \"endTime\": \"HH:mm\",\n              \"isCurrent\": \"boolean\",\n              \"taken\": \"null | { at: ISO date-time, by: UserRef }\"\n            }\n          },\n          \"dailyRegisters\": {\n            \"type\": \"array\",\n            \"items\": { \"kind\": \"'section'\", \"sectionId\": \"string\", \"sectionName\": \"string\", \"taken\": \"null | { at, by: UserRef }\" }\n          }\n        }\n      },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-6\", \"FR-7\", \"FR-35\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Load a course register (?courseId=&date=&periodId=) or daily register (?sectionId=&date=). Guard: requireUser, then assertCanManageCourse or assertCanManageSection (ADMIN or homeroom teacher). Future dates → 400; TEACHER more than 14 days back → 403 for opening (canOpen). Past the edit window → readOnly = true with readOnlyReason.\",\n      \"requestSchema\": { \"query\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" } },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\"VALIDATION_ERROR (bad key, future date)\", \"FORBIDDEN (no access, outside 14-day open window)\", \"NOT_FOUND (course/section/period)\"],\n      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-19\", \"FR-35\", \"NFR-3\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Create or update the session and all records in one transaction (system-design §3.2). Records must cover the whole active roster and only roster students. After commit: audit('attendance.record.update') per changed status, and notifyStudentAndParents per transition into ABSENT/LATE or ABSENT→PRESENT (corrected). Re-saving unchanged statuses sends nothing. Idempotent: a P2002 race on the partial unique index re-reads the session rather than returning CONFLICT.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod registerPutBody = RegisterKey & { records }\",\n          \"allOf\": [\n            { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n            { \"type\": \"object\", \"required\": [\"records\"], \"properties\": { \"records\": { \"type\": \"array\", \"minItems\": 1, \"uniqueBy\": \"studentId\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" } } } }\n          ]\n        }\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\n        \"VALIDATION_ERROR (schema; future date; studentId not active on date → details.invalidStudentIds; roster not fully marked → details.missingStudentIds)\",\n        \"FORBIDDEN (no access; TEACHER past 14-day edit window; EXCUSED by non-ADMIN)\",\n        \"NOT_FOUND\"\n      ],\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"FR-35\", \"FR-36\", \"NFR-1\", \"NFR-3\", \"NFR-5\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/{studentId}/attendance\",\n      \"description\": \"Student attendance tab data in one indexed query. Guard: requireUser + assertCanViewStudent (parent → linked students, student → self, teacher/admin per existing rules). Session kind follows attendanceMode (course sessions for PER_PERIOD/BOTH, section sessions for DAILY_HOMEROOM). `note` is omitted from rows for STUDENT and PARENT. from/to default to the current month; summaries always cover the current term and academic year regardless of from/to.\",\n      \"requestSchema\": { \"path\": { \"studentId\": \"string\" }, \"query\": { \"from\": \"DateOnly?\", \"to\": \"DateOnly?\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"summary\": { \"term\": { \"$ref\": \"#/sharedSchemas/StatusCounts\", \"termName\": \"string|null\" }, \"year\": { \"$ref\": \"#/sharedSchemas/StatusCounts\" } },\n          \"calendar\": { \"type\": \"array\", \"items\": { \"date\": \"DateOnly\", \"colour\": \"'success'|'warning'|'error'|'default'\", \"present\": \"int\", \"absent\": \"int\", \"late\": \"int\", \"excused\": \"int\" } },\n          \"records\": {\n            \"type\": \"array\",\n            \"items\": { \"id\": \"string\", \"date\": \"DateOnly\", \"periodName\": \"string|null\", \"courseName\": \"string|null\", \"sectionName\": \"string|null\", \"status\": \"AttendanceStatus\", \"minutesLate\": \"int|null\", \"note\": \"string|null (absent key for STUDENT/PARENT)\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-35\", \"NFR-1\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/{courseId}/attendance\",\n      \"description\": \"Course attendance matrix: the last 20 sessions by date (columns) × enrolled students (ACTIVE, plus DROPPED students with records) with P/A/L/E cells and per-student rate. Guard: requireUser + assertCanManageCourse.\",\n      \"requestSchema\": { \"path\": { \"courseId\": \"string\" }, \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"sessions\": { \"type\": \"array\", \"items\": { \"sessionId\": \"string\", \"date\": \"DateOnly\", \"periodId\": \"string\", \"periodName\": \"string\" } },\n          \"students\": {\n            \"type\": \"array\",\n            \"items\": { \"studentId\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"enrollmentStatus\": \"'ACTIVE'|'DROPPED'\", \"cells\": \"{ [sessionId]: AttendanceStatus }\", \"rate\": \"number|null\" }\n          }\n        }\n      },\n      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-28\", \"FR-29\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/overview\",\n      \"description\": \"Today overview: expected meetings (getSchoolScheduleForDate + homeroom sections when mode includes daily) vs taken sessions, the school-wide rate for the date, and missing registers (no session and period.startTime + 15 min ≤ now in school tz; only computed when date is today). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"date\": \"DateOnly? (default school today; future → 400)\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": \"DateOnly\",\n          \"expected\": \"int\",\n          \"taken\": \"int\",\n          \"rate\": \"number|null\",\n          \"missing\": {\n            \"type\": \"array\",\n            \"items\": { \"courseId\": \"string\", \"courseName\": \"string\", \"sectionName\": \"string\", \"periodId\": \"string\", \"periodName\": \"string\", \"startTime\": \"HH:mm\", \"teacher\": \"UserRef\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/report\",\n      \"description\": \"Per-student summary over the filtered range (groupBy studentId, status). JSON is paginated (pageSize ≤ 100). With ?format=csv returns every row as text/csv (Content-Disposition: attachment; filename=attendance-report-<from>-<to>.csv) via toCsv, with columns: Student, Section, Grade, Records, Present, Absent, Late, Excused, Rate. Guard: requireRole('ADMIN').\",\n      \"requestSchema\": {\n        \"query\": {\n          \"from\": \"DateOnly (required)\",\n          \"to\": \"DateOnly (required, ≥ from, range ≤ 366 days)\",\n          \"gradeLevelId\": \"string?\",\n          \"sectionId\": \"string?\",\n          \"courseId\": \"string?\",\n          \"status\": \"AttendanceStatus? (only students with ≥1 record of this status)\",\n          \"format\": \"'csv'?\",\n          \"page\": \"int? (default 1, ignored for csv)\",\n          \"pageSize\": \"int? (default 20, max 100, ignored for csv)\"\n        }\n      },\n      \"responseSchema\": {\n        \"json\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" } }, \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n        \"csv\": \"text/csv; charset=utf-8\"\n      },\n      \"errors\": [\"VALIDATION_ERROR (range > 366 days, to < from)\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-32\", \"FR-35\", \"FR-36\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/below-threshold\",\n      \"description\": \"Students whose year-to-date rate is below SchoolSettings.attendanceAlertThreshold, sorted by rate ascending. Paginated (pageSize ≤ 100). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"page\": \"int?\", \"pageSize\": \"int? (max 100)\" } },\n      \"responseSchema\": {\n        \"data\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" }, { \"href\": \"/students/<id>/attendance\" }] } },\n        \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\", \"threshold\": \"int\" }\n      },\n      \"errors\": [\"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-35\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/attendance/remind\",\n      \"description\": \"Send 'attendance.register_missing' to the course teacher (notify, link /attendance/take/<courseId>?date=&periodId=), then audit('attendance.remind'). Guard: requireRole('ADMIN'). Returns 200 even if the notification fails to enqueue, because notify never throws.\",\n      \"requestSchema\": { \"body\": { \"type\": \"object\", \"required\": [\"courseId\", \"periodId\", \"date\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"periodId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } } },\n      \"responseSchema\": { \"data\": { \"reminded\": { \"$ref\": \"#/sharedSchemas/UserRef\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND (course/period)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-31\", \"FR-35\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/settings/school\",\n      \"description\": \"Minimal school settings update for this PRD: only the attendance fields (FR-5 default; the user may override this). Built on updateSchoolSettings() and writes audit('school_settings.update', { old, new }). Guard: requireRole('ADMIN'). Unknown keys are rejected (strict schema) so this route cannot widen scope.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod attendanceSettingsPatch (strict). At least one field.\",\n          \"type\": \"object\",\n          \"minProperties\": 1,\n          \"additionalProperties\": false,\n          \"properties\": { \"attendanceMode\": { \"$ref\": \"#/sharedSchemas/AttendanceMode\" }, \"attendanceAlertThreshold\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 } }\n        }\n      },\n      \"responseSchema\": { \"data\": { \"attendanceMode\": \"AttendanceMode\", \"attendanceAlertThreshold\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-4\", \"FR-5\", \"NFR-8\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n","numLines":253,"startLine":1,"totalLines":253}},"tool_result_meta":[{"id":"toolu_01GRKEgXM4hwrWToH8STjr5E","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
