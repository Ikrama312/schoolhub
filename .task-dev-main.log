 \"path\": \"src/components/content/VideoEmbed.tsx\",\n      \"taskId\": \"TASK-14\",\n      \"operation\": \"CREATE\"\n    },\n    {\n      \"path\": \"src/components/ConfirmDialog/ConfirmDialog.tsx\",\n      \"taskId\": \"TASK-14\",\n      \"operation\": \"MODIFY\"\n    },\n    {\n      \"path\": \"tests/unit/markdown-view.test.tsx\",\n      \"taskId\": \"TASK-14\",\n      \"operation\": \"CREATE\"\n    },\n    {\n      \"path\": \"src/app/(app)/courses/[courseId]/content/page.tsx\",\n      \"taskId\": \"TASK-15\",\n      \"operation\": \"CREATE\"\n    },\n    {\n      \"path\": \"src/app/(app)/courses/[courseId]/content/ContentOutline.tsx\",\n      \"taskId\": \"TASK-15\",\n      \"operation\": \"CREATE\"\n    },\n    {\n      \"path\": \"src/config/course-tabs.ts\",\n      \"taskId\": \"TASK-15\",\n      \"operation\": \"MODIFY\"\n    },\n    {\n      \"path\": \"src/app/(app)/courses/[courseId]/lessons/[lessonId]/edit/page.tsx\",\n      \"taskId\": \"TASK-16\",\n      \"operation\": \"CREATE\"\n    },\n    {\n      \"path\": \"src/app/(app)/courses/[courseId]/lessons/[lessonId]/edit/LessonEditor.tsx\",\n      \"taskId\": \"TASK-16\",\n      \"operation\": \"CREATE\"\n    },\n    {\n      \"path\": \"src/app/(app)/courses/[courseId]/lessons/[lessonId]/page.tsx\",\n      \"taskId\": \"TASK-17\",\n      \"operation\": \"CREATE\"\n    },\n    {\n      \"path\": \"src/app/(app)/courses/[courseId]/lessons/[lessonId]/LessonViewerActions.tsx\",\n      \"taskId\": \"TASK-17\",\n      \"operation\": \"CREATE\"\n    },\n    {\n      \"path\": \"next.config.js\",\n      \"taskId\": \"TASK-17\",\n      \"operation\": \"MODIFY\"\n    },\n    {\n      \"path\": \"src/app/(app)/students/[id]/learning/page.tsx\",\n      \"taskId\": \"TASK-18\",\n      \"operation\": \"CREATE\"\n    },\n    {\n      \"path\": \"src/config/student-tabs.ts\",\n      \"taskId\": \"TASK-18\",\n      \"operation\": \"MODIFY\"\n    },\n    {\n      \"path\": \"src/lib/validators/settings.ts\",\n      