del User {\n82:  notifications           Notification[]\n83:  notificationPreferences NotificationPreference[]\n90:}\n109:}\n119:}\n127:}\n145:}\n162:}\n182:}\n202:}\n219:}\n238:}\n252:}\n267:}\n279:}\n286:/// <50ms) and listNotifications()'s own-rows-newest-first query.\n287:model Notification {\n300:}\n306:model NotificationPreference {\n315:}\n324:model EmailOutbox {\n331:  status        EmailStatus @default(PENDING)\n340:}\n349:enum CourseKind {\n352:}\n354:enum EnrollmentStatus {\n357:}\n378:}\n392:}\n418:}\n434:}\nmodel Notification {\n  id        String    @id @default(cuid())\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  title     String\n  body      String?\n  link      String?\n  readAt    DateTime?\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n\n  @@index([userId, readAt, createdAt])\n}\nmodel NotificationPreference {\n  userId    String\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  inApp     Boolean  @default(true)\n  email     Boolean  @default(true)\n  updatedAt DateTime @updatedAt\n\n  @@id([userId, type])\n}\nmodel NotificationPreference {\n  userId    String\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  inApp     Boolean  @default(true)\n  email     Boolean  @default(true)\n  updatedAt DateTime @updatedAt\n\n  @@id([userId, type])\n}\nmodel EmailOutbox {\n  id            String      @id @default(cuid())\n  toEmail       String\n  toName        String?\n  subject       String\n  html          String\n  text          String\n  status        EmailStatus @default(PENDING)\n  attempts      Int         @default(0)\n  lastError     String?\n  nextAttemptAt DateTime    @default(now())\n  sentAt        DateTime?\n  createdAt     DateTime    @default(now())\n  updatedAt     DateTime    @updatedAt\n\n  @@index([status, next