false\n},\n\"status\": {\n\"$ref\": \"#/sharedSchemas/AssignmentStatus\"\n},\n\"rubric\": {\n\"type\": \"array\",\n\"nullable\": true,\n\"items\": {\n\"$ref\": \"#/sharedSchemas/RubricCriterionInput\"\n},\n\"description\": \"null/omitted = no rubric. On PATCH, null removes the rubric.\"\n},\n\"attachmentFileIds\": {\n\"type\": \"array\",\n\"maxItems\": 10,\n\"items\": {\n\"type\": \"string\"\n},\n\"description\": \"Uploads from POST /api/files {context:'assignment'} owned by the caller. On PATCH this is the full new set; removed ids are detached.\"\n}\n}\n},\n\"Assignment\": {\n\"type\": \"object\",\n\"properties\": {\n\"id\": {\n\"type\": \"string\"\n},\n\"courseId\": {\n\"type\": \"string\"\n},\n\"courseName\": {\n\"type\": \"string\"\n},\n\"title\": {\n\"type\": \"string\"\n},\n\"instructions\": {\n\"type\": \"string\"\n},\n\"submissionType\": {\n\"$ref\": \"#/sharedSchemas/SubmissionType\"\n},\n\"maxPoints\": {\n\"$ref\": \"#/sharedSchemas/Decimal\"\n},\n\"dueAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\"\n},\n\"availableFrom\": {\n\"type\": \"string\",\n\"format\": \"date-time\",\n\"nullable\": true\n},\n\"allowLate\": {\n\"type\": \"boolean\"\n},\n\"lateCutoffAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\",\n\"nullable\": true\n},\n\"latePenaltyPercentPerDay\": {\n\"$ref\": \"#/sharedSchemas/Decimal\"\n},\n\"maxLatePenaltyPercent\": {\n\"$ref\": \"#/sharedSchemas/Decimal\"\n},\n\"maxFileCount\": {\n\"type\": \"integer\"\n},\n\"allowExtraCredit\": {\n\"type\": \"boolean\"\n},\n\"status\": {\n\"$ref\": \"#/sharedSchemas/AssignmentStatus\"\n},\n\"archivedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\",\n\"nullable\": true,\n\"description\": \"Managers only; always null for students/parents (archived is NOT_FOUND for them).\"\n},\n\"rubric\": {\n\"type\": \"array\",\n\"nullable\": true,\n\"items\": {\n\"$ref\": \"#/sharedSchemas/RubricCriterion\"\n}\n},\n\"attachments\": {\n\"type\": \"array\",\n\"items\": {\n\"$ref\": \"#/sharedSchemas/FileRef\"\n}\n},\n\"createdAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\"\n},\n\"updatedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\"\n}\n}\n},\n\"AssignmentSummary\": {\n\"description\": \"List row: Assignment minus instructions, rubric and attachments, plus hasRubric.\",\n\"type\": \"object\",\n\"properties\": {\n\"id\": {\n\"type\": \"string\"\n},\n\"courseId\": {\n\"type\": \"string\"\n},\n\"courseName\": {\n\"type\": \"string\"\n},\n\"title\": {\n\"type\": \"string\"\n},\n\"submissionType\": {\n\"$ref\": \"#/sharedSchemas/SubmissionType\"\n},\n\"maxPoints\": {\n\"$ref\": \"#/sharedSchemas/Decimal\"\n},\n\"dueAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\"\n},\n\"availableFrom\": {\n\"type\": \"string\",\n\"format\": \"date-time\",\n\"nullable\": true\n},\n\"status\": {\n\"$ref\": \"#/sharedSchemas/AssignmentStatus\"\n},\n\"archivedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\",\n\"nullable\": true\n},\n\"hasRubric\": {\n\"type\": \"boolean\"\n}\n}\n},\n\"ManagerCounts\": {\n\"type\": \"object\",\n\"properties\": {\n\"enrolled\": {\n\"type\": \"integer\",\n\"description\": \"ACTIVE enrollments\"\n},\n\"submitted\": {\n\"type\": \"integer\"\n},\n\"graded\": {\n\"type\": \"integer\"\n},\n\"returned\": {\n\"type\": \"integer\"\n},\n\"exempt\": {\n\"type\": \"integer\"\n},\n\"missing\": {\n\"type\": \"integer\",\n\"description\": \"missingWhere: visible, past due, not NO_SUBMISSION, no submission, not exempt (FR-35, FR-60)\"\n}\n}\n},\n\"Submission\": {\n\"description\": \"Full (manager) shape. Student/parent responses get the same shape through toStudentSubmission: grade fields null until RETURNED, history omitted.\",\n\"type\": \"object\",\n\"properties\": {\n\"id\": {\n\"type\": \"string\"\n},\n\"assignmentId\": {\n\"type\": \"string\"\n},\n\"student\": {\n\"$ref\": \"#/sharedSchemas/UserRef\"\n},\n\"status\": {\n\"$ref\": \"#/sharedSchemas/SubmissionStatus\"\n},\n\"attemptNumber\": {\n\"type\": \"integer\",\n\"description\": \"0 = offline grade (FR-8)\"\n},\n\"text\": {\n\"type\": \"string\",\n\"nullable\": true\n},\n\"files\": {\n\"type\": \"array\",\n\"items\": {\n\"$ref\": \"#/sharedSchemas/FileRef\"\n}\n},\n\"submittedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\"\n},\n\"isLate\": {\n\"type\": \"boolean\"\n},\n\"lateDays\": {\n\"type\": \"integer\"\n},\n\"rawScore\": {\n\"$ref\": \"#/sharedSchemas/Decimal\",\n\"nullable\": true\n},\n\"penaltyPercent\": {\n\"$ref\": \"#/sharedSchemas/Decimal\",\n\"nullable\": true\n},\n\"finalScore\": {\n\"$ref\": \"#/sharedSchemas/Decimal\",\n\"nullable\": true\n},\n\"rubricScores\": {\n\"type\": \"array\",\n\"nullable\": true,\n\"items\": {\n\"$ref\": \"#/sharedSchemas/RubricScore\"\n}\n},\n\"feedback\": {\n\"type\": \"string\",\n\"nullable\": true,\n\"description\": \"Markdown\"\n},\n\"gradedBy\": {\n\"$ref\": \"#/sharedSchemas/UserRef\",\n\"nullable\": true\n},\n\"gradedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\",\n\"nullable\": true\n},\n\"returnedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\",\n\"nullable\": true\n},\n\"history\": {\n\"type\": \"array\",\n\"items\": {\n\"$ref\": \"#/sharedSchemas/SubmissionAttempt\"\n},\n\"description\": \"Managers only (FR-55). Oldest first.\"\n}\n}\n},\n\"SubmissionAttempt\": {\n\"type\": \"object\",\n\"properties\": {\n\"attemptNumber\": {\n\"type\": \"integer\"\n},\n\"text\": {\n\"type\": \"string\",\n\"nullable\": true\n},\n\"files\": {\n\"type\": \"array\",\n\"items\": {\n\"$ref\": \"#/sharedSchemas/FileRef\"\n}\n},\n\"submittedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\"\n}\n}\n},\n\"RubricScore\": {\n\"type\": \"object\",\n\"required\": [\n\"criterionId\",\n\"points\"\n],\n\"properties\": {\n\"criterionId\": {\n\"type\": \"string\"\n},\n\"points\": {\n\"$ref\": \"#/sharedSchemas/Decimal\"\n},\n\"comment\": {\n\"type\": \"string\",\n\"maxLength\": 2000\n}\n}\n},\n\"GradeInput\": {\n\"description\": \"Zod gradeInput. With a rubric: rubricScores required, each criterion exactly once, 0 \\u2264 points \\u2264 criterion.maxPoints, server sets rawScore = \\u03a3 points and ignores any client rawScore (D7). Without a rubric: rawScore required, 0 \\u2264 rawScore \\u2264 maxPoints (\\u00d71.2 if allowExtraCredit) (FR-36). finalScore is always computed server-side (FR-31).\",\n\"type\": \"object\",\n\"required\": [\n\"penaltyPercent\"\n],\n\"properties\": {\n\"rawScore\": {\n\"$ref\": \"#/sharedSchemas/Decimal\"\n},\n\"penaltyPercent\": {\n\"description\": \"0\\u2013100; UI prefills grading-math.defaultPenalty\",\n\"$ref\": \"#/sharedSchemas/Decimal\"\n},\n\"feedback\": {\n\"type\": \"string\",\n\"maxLength\": 10000\n},\n\"rubricScores\": {\n\"type\": \"array\",\n\"items\": {\n\"$ref\": \"#/sharedSchemas/RubricScore\"\n}\n},\n\"return\": {\n\"type\": \"boolean\",\n\"default\": false,\n\"description\": \"'Save & return' in one transaction (D6).\"\n}\n}\n},\n\"StudentAssignmentRow\": {\n\"description\": \"Row for student/parent li\n== endpoints\n[\n{\n\"method\": \"GET\",\n\"path\": \"/api/courses/{courseId}/assignments\",\n\"description\": \"Role-shaped list for the course Assignments tab. Auth: requireUser + assertCanViewCourse. Managers (canSeeDrafts) get every status incl. archived, with counts (one groupBy). Students/parents get only visibleWhere(now) assignments with their own submission state; parents pass studentId (resolveViewedStudent; defaults to the only linked child). Read path fires publishOnce for newly visible SCHEDULED rows (fire-and-forget, FR-42). Sorted by dueAt asc.\",\n\"query\": {\n\"studentId\": {\n\"type\": \"string\",\n\"description\": \"PARENT only; must be a linked child\"\n}\n},\n\"requestSchema\": {},\n\"responseSchema\": {\n\"description\": \"{ data: ... }\",\n\"oneOf\": [\n{\n\"title\": \"manager\",\n\"type\": \"object\",\n\"properties\": {\n\"view\": {\n\"const\": \"manager\"\n},\n\"items\": {\n\"type\": \"array\",\n\"items\": {\n\"allOf\": [\n{\n\"$ref\": \"#/sharedSchemas/AssignmentSummary\"\n}\n],\n\"properties\": {\n\"counts\": {\n\"$ref\": \"#/sharedSchemas/ManagerCounts\"\n}\n}\n}\n}\n}\n},\n{\n\"title\": \"student/parent\",\n\"type\": \"object\",\n\"properties\": {\n\"view\": {\n\"const\": \"student\"\n},\n\"studentId\": {\n\"type\": \"string\"\n},\n\"items\": {\n\"type\": \"array\",\n\"items\": {\n\"$ref\": \"#/sharedSchemas/StudentAssignmentRow\"\n}\n}\n}\n}\n]\n},\n\"errors\": [\n\"UNAUTHENTICATED\",\n\"FORBIDDEN (not in course / studentId not linked)\",\n\"NOT_FOUND (course)\"\n],\n\"requirementIds\": [\n\"FR-48\",\n\"FR-17\",\n\"FR-18\",\n\"FR-13\",\n\"FR-42\",\n\"FR-52\",\n\"NFR-4\"\n]\n},\n{\n\"method\": \"POST\",\n\"path\": \"/api/courses/{courseId}/assignments\",\n\"description\": \"Create an assignment with optional rubric and attachments in one transaction. Auth: assertCanManageCourse. After commit, if visible now \\u2192 publishOnce (assignment.published to ACTIVE-enrolled students). Audit assignment.create.\",\n\"requestSchema\": {\n\"$ref\": \"#/sharedSchemas/AssignmentInput\"\n},\n\"responseSchema\": {\n\"description\": \"201 { data: Assignment }\",\n\"$ref\": \"#/sharedSchemas/Assignment\"\n},\n\"errors\": [\n\"VALIDATION_ERROR (Zod; 'Rubric totals {sum} points but the assignment is worth {maxPoints}.'; SCHEDULED with availableFrom \\u2264 now; attachment not owned/wrong context)\",\n\"FORBIDDEN\",\n\"NOT_FOUND (course)\"\n],\n\"requirementIds\": [\n\"FR-49\",\n\"FR-7\",\n\"FR-9\",\n\"FR-11\",\n\"FR-12\",\n\"FR-42\",\n\"FR-59\"\n]\n},\n{\n\"method\": \"GET\",\n\"path\": \"/api/assignments/{assignmentId}\",\n\"description\": \"Assignment detail. Auth: requireUser + assertCanViewCourse. Non-managers get NOT_FOUND unless isAssignmentVisible. Students/parents also get their own submission (toStudentSubmission) and exemption flag. serverNow lets the client offset its countdown (display only, FR-19).\",\n\"query\": {\n\"studentId\": {\n\"type\": \"string\",\n\"description\": \"PARENT only; must be a linked child\"\n}\n},\n\"requestSchema\": {},\n\"responseSchema\": {\n\"type\": \"object\",\n\"properties\": {\n\"assignment\": {\n\"$ref\": \"#/sharedSchemas/Assignment\"\n},\n\"canManage\": {\n\"type\": \"boolean\"\n},\n\"submission\": {\n\"$ref\": \"#/sharedSchemas/Submission\",\n\"nullable\": true,\n\"description\": \"Student/parent only; serializer applied. Absent for managers.\"\n},\n\"exempt\": {\n\"type\": \"boolean\",\n\"description\": \"Student/parent only\"\n},\n\"submissionCount\": {\n\"type\": \"integer\",\n\"description\": \"Managers only; drives the FR-14 edit warning\"\n},\n\"serverNow\": {\n\"type\": \"string\",\n\"format\": \"date-time\"\n}\n}\n},\n\"errors\": [\n\"UNAUTHENTICATED\",\n\"FORBIDDEN\",\n\"NOT_FOUND\"\n],\n\"requirementIds\": [\n\"FR-50\",\n\"FR-19\",\n\"FR-26\",\n\"FR-27\",\n\"FR-13\",\n\"FR-52\",\n\"NFR-2\",\n\"NFR-4\"\n]\n},\n{\n\"method\": \"PATCH\",\n\"path\": \"/api/assignments/{assignmentId}\",\n\"description\": \"Update an assignment. Auth: assertCanManageCourse. Body is a partial AssignmentInput (same superRefine on the merged result). attachmentFileIds is the full new set (removed files detached). If it becomes visible and notifiedAt is null \\u2192 publishOnce. Client shows the FR-14 'review grades' banner if maxPoints changed and submissionCount > 0. Audit assignment.update.\",\n\"requestSchema\": {\n\"description\": \"Partial<AssignmentInput>\",\n\"$ref\": \"#/sharedSchemas/AssignmentInput\"\n},\n\"responseSchema\": {\n\"$ref\": \"#/sharedSchemas/Assignment\"\n},\n\"errors\": [\n\"VALIDATION_ERROR\",\n\"FORBIDDEN\",\n\"NOT_FOUND\"\n],\n\"requirementIds\": [\n\"FR-51\",\n\"FR-12\",\n\"FR-14\",\n\"FR-11\",\n\"FR-42\",\n\"FR-59\"\n]\n},\n{\n\"method\": \"DELETE\",\n\"path\": \"/api/assignments/{assignmentId}\",\n\"description\": \"Hard delete (with rubric, attachments detached) when there are 0 submissions; otherwise set archivedAt. Auth: assertCanManageCourse. Audit assignment.delete | assignment.archive.\",\n\"requestSchema\": {},\n\"responseSchema\": {\n\"type\": \"object\",\n\"properties\": {\n\"id\": {\n\"type\": \"string\"\n},\n\"result\": {\n\"type\": \"string\",\n\"enum\": [\n\"deleted\",\n\"archived\"\n]\n}\n}\n},\n\"errors\": [\n\"FORBIDDEN\",\n\"NOT_FOUND\"\n],\n\"requirementIds\": [\n\"FR-51\",\n\"FR-52\",\n\"FR-59\"\n]\n},\n{\n\"method\": \"POST\",\n\"path\": \"/api/assignments/{assignmentId}/duplicate\",\n\"description\": \"Copy as DRAFT to each target course. Auth: manage source course and assertCanManageCourse for every target (all checked before any write). Rubric copied as new rows; attachments re-saved as new FileObjects (context 'assignment'); same dueAt, availableFrom/lateCutoffAt keep offsets; notifiedAt null. One transaction per target. Audit assignment.duplicate.\",\n\"requestSchema\": {\n\"type\": \"object\",\n\"required\": [\n\"courseIds\"\n],\n\"properties\": {\n\"courseIds\": {\n\"type\": \"array\",\n\"minItems\": 1,\n\"items\": {\n\"type\": \"string\"\n}\n}\n}\n},\n\"responseSchema\": {\n\"description\": \"201\",\n\"type\": \"object\",\n\"properties\": {\n\"created\": {\n\"type\": \"array\",\n\"items\": {\n\"type\": \"object\",\n\"properties\": {\n\"courseId\": {\n\"type\": \"string\"\n},\n\"assignmentId\": {\n\"type\": \"string\"\n}\n}\n}\n}\n}\n},\n\"errors\": [\n\"VALIDATION_ERROR\",\n\"FORBIDDEN (any target not managed)\",\n\"NOT_FOUND\"\n],\n\"requirementIds\": [\n\"FR-15\",\n\"FR-59\"\n]\n},\n{\n\"method\": \"GET\",\n\"path\": \"/api/assignments/{assignmentId}/submissions\",\n\"description\": \"Grading roster: every ACTIVE-enrolled student, including those who have not submitted, with chip status, exemption and submission summary. Auth: assertCanManageCourse. Paginated (pageSize \\u2264 100). Sort by name (default) or submittedAt; optional chip filter.\",\n\"query\": {\n\"page\": {\n\"type\": \"integer\",\n\"default\": 1\n},\n\"pageSize\": {\n\"type\": \"integer\",\n\"maximum\": 100,\n\"default\": 100\n},\n\"sort\": {\n\"type\": \"string\",\n\"enum\": [\n\"name\",\n\"submittedAt\"\n],\n\"default\": \"name\"\n},\n\"status\": {\n\"$ref\": \"#/sharedSchemas/ChipStatus\"\n}\n},\n\"requestSchema\": {},\n\"responseSchema\": {\n\"description\": \"paginated envelope; data[] items:\",\n\"type\": \"object\",\n\"properties\": {\n\"student\": {\n\"$ref\": \"#/sharedSchemas/UserRef\"\n},\n\"chipStatus\": {\n\"$ref\": \"#/sharedSchemas/ChipStatus\"\n},\n\"exempt\": {\n\"type\": \"boolean\"\n},\n\"submission\": {\n\"type\": \"object\",\n\"nullable\": true,\n\"properties\": {\n\"id\": {\n\"type\": \"string\"\n},\n\"status\": {\n\"$ref\": \"#/sharedSchemas/SubmissionStatus\"\n},\n\"attemptNumber\": {\n\"type\": \"integer\"\n},\n\"submittedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\"\n},\n\"isLate\": {\n\"type\": \"boolean\"\n},\n\"lateDays\": {\n\"type\": \"integer\"\n},\n\"finalScore\": {\n\"$ref\": \"#/sharedSchemas/Decimal\",\n\"nullable\": true\n},\n\"gradedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\",\n\"nullable\": true\n},\n\"returnedAt\": {\n\"type\": \"string\",\n\"format\": \"date-time\",\n\"nullable\": true\n}\n}\n}\n}\n},\n\"errors\": [\n\"FORBIDDEN\",\n\"NOT_FOUND\"\n],\n\"requirementIds\": [\n\"FR-54\",\n\"FR-28\",\n\"FR-35\"\n]\n},\n{\n\"method\": \"POST\",\n\"path\": \"/api/assignments/{assignmentId}/submissions\",\n\"description\": \"Submit or resubmit. Auth: requireRole STUDENT. Server-clock checks in order (first failure wins): visible \\u2192 ACTIVE-enrolled \\u2192 not exempt and type \\u2260 NO_SUBMISSION \\u2192 deadline/late cutoff \\u2192 content matches type and fileIds \\u2264 maxFileCount \\u2192 each file owned by caller, context 'submission', unattached or already on this submission. Resubmit (status SUBMITTED, incl. attempt-0 offline row) snapshots SubmissionHistory, increments attemptNumber, clears grade fields. Returns 201 on first submit, 200 on resubmit.\",\n\"requestSchema\": {\n\"type\": \"object\",\n\"properties\": {\n\"text\": {\n\"type\": \"string\",\n\"maxLength\": 50000\n},\n\"fileIds\": {\n\"type\": \"array\",\n\"maxItems\": 10,\n\"items\": {\n\"type\": \"string\"\n},\n\"default\": []\n}\n}\n},\n\"responseSchema\": {\n\"description\": \"Receipt: toStudentSubmission shape (grade fields null).\",\n\"$ref\": \"#/sharedSchemas/Submission\"\n},\n\"errors\": [\n\"NOT_FOUND (assignment not visible)\",\n\"FORBIDDEN (not STUDENT / not ACTIVE-enrolled)\",\n\"VALIDATION_ERROR (exempt; NO_SUBMISSION; 'The deadline has passed and late submissions are closed.'; missing text/files for type; too many files; file not yours / wrong context)\",\n\"CONFLICT ('This submission has been returned and can no longer be changed.')\"\n],\n\"requirementIds\": [\n\"FR-53\",\n\"FR-22\",\n\"FR-23\",\n\"FR-24\",\n\"FR-35\",\n\"FR-60\",\n\"FR-7\",\n\"NFR-2\",\n\"FR-59\"\n]\n},\n{\n\"method\": \"POST\",\n\"path\": \"/api/assignments/{assignmentId}/return\",\n\"description\": \"Bulk 'Return all graded'. Auth: assertCanManageCourse. Default set = gradedAt != null AND status SUBMITTED. Supplied ids that are ungraded/already returned/not in this assignment are skipped and reported. One updateMany, then notifyStudentAndParents(assignment.returned) per student and one audit row per submissio\n== reusedEndpoints\n[\n{\n\"method\": \"POST\",\n\"path\": \"/api/files\",\n\"note\": \"Unchanged. Clients upload with context 'assignment' (authoring) or 'submission' (student) before referencing fileIds.\",\n\"requirementIds\": [\n\"FR-9\",\n\"FR-20\",\n\"FR-47\"\n]\n},\n{\n\"method\": \"GET\",\n\"path\": \"/api/files/{id}?inline=1\",\n\"note\": \"Unchanged handler; new resolvers assignmentResolver/submissionResolver in src/server/files/contexts.ts. Header change D11 (X-Frame-Options SAMEORIGIN for this path only) enables PDF iframe preview.\",\n\"requirementIds\": [\n\"FR-29\",\n\"FR-47\",\n\"NFR-4\"\n]\n},\n{\n\"method\": \"POST\",\n\"path\": \"/api/internal/email/dispatch\",\n\"note\": \"Unchanged contract; now also calls sendDueReminders(now) on every request (due_soon, missing).\",\n\"requirementIds\": [\n\"FR-43\",\n\"FR-45\",\n\"FR-6\"\n]\n}\n]\n== status\n\"complete\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WsfKpxjiYjFQGTvBF2awtk","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
