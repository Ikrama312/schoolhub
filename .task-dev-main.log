{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FcgzhhFWf7X8TC1AKz3SNW","type":"tool_result","content":"/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'system.test': {\n    label: 'Test notification',\n    description: 'Test messages sent by an administrator.',\n    category: 'SYSTEM',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  // PRD-07 attendance (FR-20, FR-23).\n  'attendance.absent': {\n    label: 'Marked absent',\n    description: 'A student was marked absent from a class or the daily register.',\n    category: 'ATTENDANCE',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.late': {\n    label: 'Marked late',\n    description: 'A student was marked late.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.corrected': {\n    label: 'Attendance corrected',\n    description: 'An absence was corrected to present.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.register_missing': {\n    label: 'Register not taken',\n    description: 'An administrator reminded you to take a register.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['TEACHER'],\n  },\n  // PRD-08 course content (FR-38). Scheduled lessons never notify (FR-39).\n  'content.lesson_published': {\n    label: 'New lesson published',\n    description: 'A teacher published a new lesson in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  // PRD-09 assignments (FR-42..FR-46).\n  'assignment.published': {\n    label: 'New assignment',\n    description: 'A teacher published an assignment in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.due_soon': {\n    label: 'Assignment due soon',\n    description: 'An assignment you have not submitted is due within 24 hours.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.returned': {\n    label: 'Assignment returned',\n    description: 'Graded work was returned with a score and feedback.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  'assignment.missing': {\n    label: 'Missing assignment',\n    description: 'Your child has not submitted an assignment that was due over 24 hours ago.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['PARENT'],\n  },\n  // PRD-10 quizzes (FR-29, FR-30). results_released defaults to email like assignment grading (A5).\n  'quiz.published': {\n    label: 'New quiz',\n    description: 'A teacher published a quiz in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'quiz.results_released': {\n    label: 'Quiz results released',\n    description: 'Results for a quiz you took are now available.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  // PRD-11 gradebook (FR-38). grade.posted fires once per student per manual item (A9).\n  'grade.posted': {\n    label: 'Grade posted',\n    description: 'A teacher entered a grade for an in-class or offline item.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  'report_card.published': {\n    label: 'Report card published',\n    description: 'A term report card is available to view and print.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n} as const satisfies Record<string, NotificationTypeDef>;\n\nexport type NotificationType = keyof typeof NOTIFICATION_TYPES;\n\nconst entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n\nexport function getTypeDef(type: string): NotificationTypeDef | undefined {\n  return Object.prototype.hasOwnProperty.call(NOTIFICATION_TYPES, type)\n    ? (NOTIFICATION_TYPES as Record<string, NotificationTypeDef>)[type]\n    : undefined;\n}\n\n/** Types a role may see and configure (FR-28, FR-37): role match, not emailOnly. */\nexport function visibleTypesFor(role: Role): NotificationType[] {\n  return entries.filter(([, def]) => def.roles.includes(role) && !def.emailOnly).map(([key]) => key);\n}\n\n/** Type keys in a category, for the FR-34 list filter. */\nexport function typesInCategory(category: NotificationCategory): NotificationType[] {\n  return entries.filter(([, def]) => def.category === category).map(([key]) => key);\n}\n\nexport function categoryOf(type: string): NotificationCategory | null {\n  return getTypeDef(type)?.category ?? null;\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { BODY_MAX, isSafeRelativeLink, TITLE_MAX } from '@/lib/validators/notifications';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\nimport { resolvePrefs } from './preferences';\nimport { NOTIFICATION_TYPES, type NotificationType } from './types';\n\nexport interface NotifyInput {\n  type: NotificationType;\n  userIds: string[];\n  title: string;\n  body?: string;\n  link?: string;\n  email?: { subject?: string; template: 'generic-notification'; data?: Record<string, unknown> };\n}\n\nfunction truncate(value: string, max: number, field: string, type: string): string {\n  if (value.length <= max) return value;\n  logger.warn('Notification field truncated', { field, type, length: value.length, max });\n  return value.slice(0, max);\n}\n\n/**\n * Single producer entry point (FR-6..11). Writes in-app rows and enqueues\n * emails per resolved preferences. NEVER throws — failures are logged.\n * Call after your transaction commits.\n */\nexport async function notify(input: NotifyInput): Promise<void> {\n  try {\n    const def = NOTIFICATION_TYPES[input.type];\n    const userIds = [...new Set(input.userIds)];\n    if (!def || userIds.length === 0) return;\n\n    const title = truncate(input.title, TITLE_MAX, 'title', input.type);\n    const body = input.body == null ? null : truncate(input.body, BODY_MAX, 'body', input.type);\n    let link: string | null = input.link ?? null;\n    if (link !== null && !isSafeRelativeLink(link)) {\n      logger.warn('Notification link dropped (not a safe relative path)', { type: input.type });\n      link = null;\n    }\n\n    const [users, prefRows] = await Promise.all([\n      prisma.user.findMany({\n        where: { id: { in: userIds }, status: { notIn: ['DISABLED', 'ARCHIVED'] }, archivedAt: null },\n        select: { id: true, email: true, firstName: true },\n      }),\n      prisma.notificationPreference.findMany({ where: { userId: { in: userIds }, type: input.type } }),\n    ]);\n    const prefByUser = new Map(prefRows.map((r) => [r.userId, r]));\n\n    const inAppIds: string[] = [];\n    const emailTo: { email: string; firstName: string }[] = [];\n    for (const user of users) {\n      const prefs = resolvePrefs(def, prefByUser.get(user.id));\n      if (prefs.inApp) inAppIds.push(user.id);\n      if (prefs.email && input.email && user.email) emailTo.push(user);\n    }\n\n    if (inAppIds.length) {\n      await prisma.notification.createMany({\n        data: inAppIds.map((userId) => ({ userId, type: input.type, title, body, link })),\n      });\n    }\n\n    if (emailTo.length && input.email) {\n      // Rendered once per call (ADR-6): generic emails carry no per-recipient greeting.\n      const school = await getEmailSchool();\n      const { html, text } = await renderEmail(\n        input.email.template,\n        { title, body, link, ...(input.email.data ?? {}) },\n        school,\n      );\n      const subject = input.email.subject ?? title;\n      await prisma.emailOutbox.createMany({\n        data: emailTo.map((u) => ({ toEmail: u.email, toName: u.firstName, subject, html, text })),\n      });\n    }\n  } catch (error) {\n    logger.error('notify() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nimport type { FileObject } from '@prisma/client';\nimport { registerBuiltInContexts } from './contexts';\n\n/**\n * File access registry (PRD-08 FR-9, NFR-1). Every download goes through\n * canAccessFile. Later PRDs call registerFileAccess for their own contexts.\n */\n\nexport interface FileAccessUser {\n  id: string;\n  role: string;\n}\n\nexport type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\n\n/** Resolvers receive null for anonymous callers; only return true for null if the context is public. */\nexport type FileAccessResolver = (user: FileAccessUser | null, file: FileAccessFile) => boolean | Promise<boolean>;\n\nconst registry = new Map<string, FileAccessResolver>();\n\nexport function registerFileAccess(context: string, resolver: FileAccessResolver): void {\n  registry.set(context, resolver);\n}\n\nconst ownerOrAdmin = (user: FileAccessUser | null, file: FileAccessFile) =>\n  user !== null && (user.role === 'ADMIN' || user.id === file.ownerId);\n\nlet builtInsRegistered = false;\n\n/**\n * Dispatch order: (1) unattached -> owner/ADMIN; (2) registered resolver;\n * (3) unknown context -> owner/ADMIN. Anonymous is denied except where a\n * resolver explicitly accepts null. Resolver errors deny.\n */\nexport async function canAccessFile(user: FileAccessUser | null, file: FileAccessFile): Promise<boolean> {\n  // Lazy so the circular import with contexts.ts never hits an uninitialised registry,\n  // and no caller can forget to load the built-in contexts.\n  if (!builtInsRegistered) {\n    builtInsRegistered = true;\n    registerBuiltInContexts(registerFileAccess);\n  }\n  if (file.contextId === null) return ownerOrAdmin(user, file);\n  const resolver = registry.get(file.context);\n  if (!resolver) return ownerOrAdmin(user, file);\n  try {\n    return (await resolver(user, file)) === true;\n  } catch {\n    return false;\n  }\n}\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport { isAssignmentVisible } from '@/server/assignments/assignments-service';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'assignment' (PRD-09 FR-47): the caller can view the course and (unless they manage it) the assignment is visible. */\nexport const assignmentResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const a = await prisma.assignment.findUnique({\n    where: { id: file.contextId },\n    select: { status: true, availableFrom: true, archivedAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n  });\n  if (!a) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], a.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, a.course) || isAssignmentVisible(a, new Date());\n};\n\n/**\n * 'submission' (PRD-09 FR-47, NFR-4): the submitting student, their linked parents, or a course\n * manager (ADMIN / teacher / co-teacher). Everyone else, including other students, is denied.\n */\nexport const submissionResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const sub = await prisma.submission.findUnique({\n    where: { id: file.contextId },\n    select: { studentId: true, assignment: { select: { course: { select: { teacherId: true, coTeacherIds: true } } } } },\n  });\n  if (!sub) return false;\n  if (sub.studentId === user.id) return true;\n  if (canSeeDrafts(user, sub.assignment.course)) return true;\n  if (user.role !== 'PARENT') return false;\n  const link = await prisma.parentStudentLink.findFirst({ where: { parentId: user.id, studentId: sub.studentId }, select: { id: true } });\n  return link !== null;\n};\n\n/** 'quiz' (PRD-10 FR-39): a course manager, or a course viewer once the quiz is PUBLISHED/CLOSED (images live only in prompts). */\nexport const quizResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const q = await prisma.quiz.findUnique({\n    where: { id: file.contextId },\n    select: { status: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n  });\n  if (!q) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], q.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, q.course) || q.status !== 'DRAFT';\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n  register('assignment', assignmentResolver);\n  register('submission', submissionResolver);\n  register('quiz', quizResolver);\n}\nimport { prisma } from '@/server/db';\nimport { ANSWER_GRACE_MS } from './grading';\nimport { submitAttempt } from './attempt-service';\nimport { notifyResultsReleased } from './quiz-service';\nimport { syncQuizGrades } from '@/server/gradebook/gradebook-sync';\n\n/**\n * PRD-10 maintenance (FR-18, FR-30, FR-35), run by the internal dispatch cron on every call.\n * Both passes are idempotent across concurrent calls.\n */\n\nconst BATCH = 200;\n\n/** IN_PROGRESS attempts past deadline + grace → auto-submit (≤ 200 per call; lazy path covers the rest). */\nexport async function autoSubmitExpiredAttempts(now = new Date()): Promise<number> {\n  const expired = await prisma.quizAttempt.findMany({\n    where: { status: 'IN_PROGRESS', deadlineAt: { lt: new Date(now.getTime() - ANSWER_GRACE_MS) } },\n    select: { id: true },\n    orderBy: { deadlineAt: 'asc' },\n    take: BATCH,\n  });\n  let submitted = 0;\n  for (const a of expired) if (await submitAttempt(a.id, { auto: true }, now)) submitted++;\n  return submitted;\n}\n\n/** A6: AFTER_CLOSE quizzes past close are claimed via resultsReleasedAt null → now; only the claimer notifies. */\nexport async function sendAfterCloseResultsReleased(now = new Date()): Promise<number> {\n  const due = await prisma.quiz.findMany({\n    where: { resultsVisibility: 'AFTER_CLOSE', availableUntil: { lte: now }, resultsReleasedAt: null, status: { not: 'DRAFT' } },\n    select: { id: true },\n    take: BATCH,\n  });\n  let sent = 0;\n  for (const q of due) {\n    const { count } = await prisma.quiz.updateMany({ where: { id: q.id, resultsReleasedAt: null }, data: { resultsReleasedAt: now } });\n    if (count !== 1) continue;\n    await syncQuizGrades(q.id, now); // PRD-11 FR-7 (R1)\n    await notifyResultsReleased(q.id);\n    sent++;\n  }\n  return sent;\n}\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\nimport { sendDueReminders } from '@/server/assignments/reminders';\nimport { autoSubmitExpiredAttempts, sendAfterCloseResultsReleased } from '@/server/quiz/maintenance';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n  try {\n    const reminders = await sendDueReminders(new Date());\n    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n  } catch (error) {\n    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  // PRD-10 FR-18/FR-30/FR-35: every request, each isolated; both idempotent.\n  try {\n    const submitted = await autoSubmitExpiredAttempts(new Date());\n    if (submitted) logger.info('Expired quiz attempts auto-submitted', { submitted });\n  } catch (error) {\n    logger.error('Quiz auto-submit failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n  try {\n    const released = await sendAfterCloseResultsReleased(new Date());\n    if (released) logger.info('Quiz results released after close', { released });\n  } catch (error) {\n    logger.error('Quiz results release failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n  { key: 'quizzes', label: 'Quizzes', href: (id) => `/courses/${id}/quizzes`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n  // PRD-11 FR-18 / FR-28\n  { key: 'gradebook', label: 'Gradebook', href: (id) => `/courses/${id}/gradebook`, roles: ['ADMIN', 'TEACHER'] },\n  { key: 'grades', label: 'Grades', href: (id) => `/courses/${id}/grades`, roles: ['STUDENT', 'PARENT'] },\n];\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\nimport AssignmentOutlinedIcon from '@mui/icons-material/AssignmentOutlined';\nimport GradingOutlinedIcon from '@mui/icons-material/GradingOutlined';\nimport WorkspacePremiumOutlinedIcon from '@mui/icons-material/WorkspacePremiumOutlined';\nimport StraightenOutlinedIcon from '@mui/icons-material/StraightenOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Assignments', href: '/assignments', icon: AssignmentOutlinedIcon, roles: ['STUDENT', 'PARENT', 'TEACHER', 'ADMIN'] },\n  { label: 'Grades', href: '/grades', icon: GradingOutlinedIcon, roles: ['STUDENT', 'PARENT'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Report cards', href: '/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Grading scales', href: '/admin/grading-scales', icon: StraightenOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Report cards', href: '/admin/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"98a511c8-0f94-422f-bce3-9c853eb574ca","uuid":"c6fa46c7-e7ea-4f8c-b906-fa0830693ae3","timestamp":"2026-11-09T16:39:16.212Z","tool_use_result":{"stdout":"/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'system.test': {\n    label: 'Test notification',\n    description: 'Test messages sent by an administrator.',\n    category: 'SYSTEM',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  // PRD-07 attendance (FR-20, FR-23).\n  'attendance.absent': {\n    label: 'Marked absent',\n    description: 'A student was marked absent from a class or the daily register.',\n    category: 'ATTENDANCE',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.late': {\n    label: 'Marked late',\n    description: 'A student was marked late.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.corrected': {\n    label: 'Attendance corrected',\n    description: 'An absence was corrected to present.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.register_missing': {\n    label: 'Register not taken',\n    description: 'An administrator reminded you to take a register.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['TEACHER'],\n  },\n  // PRD-08 course content (FR-38). Scheduled lessons never notify (FR-39).\n  'content.lesson_published': {\n    label: 'New lesson published',\n    description: 'A teacher published a new lesson in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  // PRD-09 assignments (FR-42..FR-46).\n  'assignment.published': {\n    label: 'New assignment',\n    description: 'A teacher published an assignment in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.due_soon': {\n    label: 'Assignment due soon',\n    description: 'An assignment you have not submitted is due within 24 hours.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.returned': {\n    label: 'Assignment returned',\n    description: 'Graded work was returned with a score and feedback.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  'assignment.missing': {\n    label: 'Missing assignment',\n    description: 'Your child has not submitted an assignment that was due over 24 hours ago.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['PARENT'],\n  },\n  // PRD-10 quizzes (FR-29, FR-30). results_released defaults to email like assignment grading (A5).\n  'quiz.published': {\n    label: 'New quiz',\n    description: 'A teacher published a quiz in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'quiz.results_released': {\n    label: 'Quiz results released',\n    description: 'Results for a quiz you took are now available.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  // PRD-11 gradebook (FR-38). grade.posted fires once per student per manual item (A9).\n  'grade.posted': {\n    label: 'Grade posted',\n    description: 'A teacher entered a grade for an in-class or offline item.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  'report_card.published': {\n    label: 'Report card published',\n    description: 'A term report card is available to view and print.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n} as const satisfies Record<string, NotificationTypeDef>;\n\nexport type NotificationType = keyof typeof NOTIFICATION_TYPES;\n\nconst entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n\nexport function getTypeDef(type: string): NotificationTypeDef | undefined {\n  return Object.prototype.hasOwnProperty.call(NOTIFICATION_TYPES, type)\n    ? (NOTIFICATION_TYPES as Record<string, NotificationTypeDef>)[type]\n    : undefined;\n}\n\n/** Types a role may see and configure (FR-28, FR-37): role match, not emailOnly. */\nexport function visibleTypesFor(role: Role): NotificationType[] {\n  return entries.filter(([, def]) => def.roles.includes(role) && !def.emailOnly).map(([key]) => key);\n}\n\n/** Type keys in a category, for the FR-34 list filter. */\nexport function typesInCategory(category: NotificationCategory): NotificationType[] {\n  return entries.filter(([, def]) => def.category === category).map(([key]) => key);\n}\n\nexport function categoryOf(type: string): NotificationCategory | null {\n  return getTypeDef(type)?.category ?? null;\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { BODY_MAX, isSafeRelativeLink, TITLE_MAX } from '@/lib/validators/notifications';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\nimport { resolvePrefs } from './preferences';\nimport { NOTIFICATION_TYPES, type NotificationType } from './types';\n\nexport interface NotifyInput {\n  type: NotificationType;\n  userIds: string[];\n  title: string;\n  body?: string;\n  link?: string;\n  email?: { subject?: string; template: 'generic-notification'; data?: Record<string, unknown> };\n}\n\nfunction truncate(value: string, max: number, field: string, type: string): string {\n  if (value.length <= max) return value;\n  logger.warn('Notification field truncated', { field, type, length: value.length, max });\n  return value.slice(0, max);\n}\n\n/**\n * Single producer entry point (FR-6..11). Writes in-app rows and enqueues\n * emails per resolved preferences. NEVER throws — failures are logged.\n * Call after your transaction commits.\n */\nexport async function notify(input: NotifyInput): Promise<void> {\n  try {\n    const def = NOTIFICATION_TYPES[input.type];\n    const userIds = [...new Set(input.userIds)];\n    if (!def || userIds.length === 0) return;\n\n    const title = truncate(input.title, TITLE_MAX, 'title', input.type);\n    const body = input.body == null ? null : truncate(input.body, BODY_MAX, 'body', input.type);\n    let link: string | null = input.link ?? null;\n    if (link !== null && !isSafeRelativeLink(link)) {\n      logger.warn('Notification link dropped (not a safe relative path)', { type: input.type });\n      link = null;\n    }\n\n    const [users, prefRows] = await Promise.all([\n      prisma.user.findMany({\n        where: { id: { in: userIds }, status: { notIn: ['DISABLED', 'ARCHIVED'] }, archivedAt: null },\n        select: { id: true, email: true, firstName: true },\n      }),\n      prisma.notificationPreference.findMany({ where: { userId: { in: userIds }, type: input.type } }),\n    ]);\n    const prefByUser = new Map(prefRows.map((r) => [r.userId, r]));\n\n    const inAppIds: string[] = [];\n    const emailTo: { email: string; firstName: string }[] = [];\n    for (const user of users) {\n      const prefs = resolvePrefs(def, prefByUser.get(user.id));\n      if (prefs.inApp) inAppIds.push(user.id);\n      if (prefs.email && input.email && user.email) emailTo.push(user);\n    }\n\n    if (inAppIds.length) {\n      await prisma.notification.createMany({\n        data: inAppIds.map((userId) => ({ userId, type: input.type, title, body, link })),\n      });\n    }\n\n    if (emailTo.length && input.email) {\n      // Rendered once per call (ADR-6): generic emails carry no per-recipient greeting.\n      const school = await getEmailSchool();\n      const { html, text } = await renderEmail(\n        input.email.template,\n        { title, body, link, ...(input.email.data ?? {}) },\n        school,\n      );\n      const subject = input.email.subject ?? title;\n      await prisma.emailOutbox.createMany({\n        data: emailTo.map((u) => ({ toEmail: u.email, toName: u.firstName, subject, html, text })),\n      });\n    }\n  } catch (error) {\n    logger.error('notify() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nimport type { FileObject } from '@prisma/client';\nimport { registerBuiltInContexts } from './contexts';\n\n/**\n * File access registry (PRD-08 FR-9, NFR-1). Every download goes through\n * canAccessFile. Later PRDs call registerFileAccess for their own contexts.\n */\n\nexport interface FileAccessUser {\n  id: string;\n  role: string;\n}\n\nexport type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\n\n/** Resolvers receive null for anonymous callers; only return true for null if the context is public. */\nexport type FileAccessResolver = (user: FileAccessUser | null, file: FileAccessFile) => boolean | Promise<boolean>;\n\nconst registry = new Map<string, FileAccessResolver>();\n\nexport function registerFileAccess(context: string, resolver: FileAccessResolver): void {\n  registry.set(context, resolver);\n}\n\nconst ownerOrAdmin = (user: FileAccessUser | null, file: FileAccessFile) =>\n  user !== null && (user.role === 'ADMIN' || user.id === file.ownerId);\n\nlet builtInsRegistered = false;\n\n/**\n * Dispatch order: (1) unattached -> owner/ADMIN; (2) registered resolver;\n * (3) unknown context -> owner/ADMIN. Anonymous is denied except where a\n * resolver explicitly accepts null. Resolver errors deny.\n */\nexport async function canAccessFile(user: FileAccessUser | null, file: FileAccessFile): Promise<boolean> {\n  // Lazy so the circular import with contexts.ts never hits an uninitialised registry,\n  // and no caller can forget to load the built-in contexts.\n  if (!builtInsRegistered) {\n    builtInsRegistered = true;\n    registerBuiltInContexts(registerFileAccess);\n  }\n  if (file.contextId === null) return ownerOrAdmin(user, file);\n  const resolver = registry.get(file.context);\n  if (!resolver) return ownerOrAdmin(user, file);\n  try {\n    return (await resolver(user, file)) === true;\n  } catch {\n    return false;\n  }\n}\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport { isAssignmentVisible } from '@/server/assignments/assignments-service';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'assignment' (PRD-09 FR-47): the caller can view the course and (unless they manage it) the assignment is visible. */\nexport const assignmentResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const a = await prisma.assignment.findUnique({\n    where: { id: file.contextId },\n    select: { status: true, availableFrom: true, archivedAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n  });\n  if (!a) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], a.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, a.course) || isAssignmentVisible(a, new Date());\n};\n\n/**\n * 'submission' (PRD-09 FR-47, NFR-4): the submitting student, their linked parents, or a course\n * manager (ADMIN / teacher / co-teacher). Everyone else, including other students, is denied.\n */\nexport const submissionResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const sub = await prisma.submission.findUnique({\n    where: { id: file.contextId },\n    select: { studentId: true, assignment: { select: { course: { select: { teacherId: true, coTeacherIds: true } } } } },\n  });\n  if (!sub) return false;\n  if (sub.studentId === user.id) return true;\n  if (canSeeDrafts(user, sub.assignment.course)) return true;\n  if (user.role !== 'PARENT') return false;\n  const link = await prisma.parentStudentLink.findFirst({ where: { parentId: user.id, studentId: sub.studentId }, select: { id: true } });\n  return link !== null;\n};\n\n/** 'quiz' (PRD-10 FR-39): a course manager, or a course viewer once the quiz is PUBLISHED/CLOSED (images live only in prompts). */\nexport const quizResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const q = await prisma.quiz.findUnique({\n    where: { id: file.contextId },\n    select: { status: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n  });\n  if (!q) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], q.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, q.course) || q.status !== 'DRAFT';\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n  register('assignment', assignmentResolver);\n  register('submission', submissionResolver);\n  register('quiz', quizResolver);\n}\nimport { prisma } from '@/server/db';\nimport { ANSWER_GRACE_MS } from './grading';\nimport { submitAttempt } from './attempt-service';\nimport { notifyResultsReleased } from './quiz-service';\nimport { syncQuizGrades } from '@/server/gradebook/gradebook-sync';\n\n/**\n * PRD-10 maintenance (FR-18, FR-30, FR-35), run by the internal dispatch cron on every call.\n * Both passes are idempotent across concurrent calls.\n */\n\nconst BATCH = 200;\n\n/** IN_PROGRESS attempts past deadline + grace → auto-submit (≤ 200 per call; lazy path covers the rest). */\nexport async function autoSubmitExpiredAttempts(now = new Date()): Promise<number> {\n  const expired = await prisma.quizAttempt.findMany({\n    where: { status: 'IN_PROGRESS', deadlineAt: { lt: new Date(now.getTime() - ANSWER_GRACE_MS) } },\n    select: { id: true },\n    orderBy: { deadlineAt: 'asc' },\n    take: BATCH,\n  });\n  let submitted = 0;\n  for (const a of expired) if (await submitAttempt(a.id, { auto: true }, now)) submitted++;\n  return submitted;\n}\n\n/** A6: AFTER_CLOSE quizzes past close are claimed via resultsReleasedAt null → now; only the claimer notifies. */\nexport async function sendAfterCloseResultsReleased(now = new Date()): Promise<number> {\n  const due = await prisma.quiz.findMany({\n    where: { resultsVisibility: 'AFTER_CLOSE', availableUntil: { lte: now }, resultsReleasedAt: null, status: { not: 'DRAFT' } },\n    select: { id: true },\n    take: BATCH,\n  });\n  let sent = 0;\n  for (const q of due) {\n    const { count } = await prisma.quiz.updateMany({ where: { id: q.id, resultsReleasedAt: null }, data: { resultsReleasedAt: now } });\n    if (count !== 1) continue;\n    await syncQuizGrades(q.id, now); // PRD-11 FR-7 (R1)\n    await notifyResultsReleased(q.id);\n    sent++;\n  }\n  return sent;\n}\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\nimport { sendDueReminders } from '@/server/assignments/reminders';\nimport { autoSubmitExpiredAttempts, sendAfterCloseResultsReleased } from '@/server/quiz/maintenance';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n  try {\n    const reminders = await sendDueReminders(new Date());\n    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n  } catch (error) {\n    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  // PRD-10 FR-18/FR-30/FR-35: every request, each isolated; both idempotent.\n  try {\n    const submitted = await autoSubmitExpiredAttempts(new Date());\n    if (submitted) logger.info('Expired quiz attempts auto-submitted', { submitted });\n  } catch (error) {\n    logger.error('Quiz auto-submit failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n  try {\n    const released = await sendAfterCloseResultsReleased(new Date());\n    if (released) logger.info('Quiz results released after close', { released });\n  } catch (error) {\n    logger.error('Quiz results release failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n  { key: 'quizzes', label: 'Quizzes', href: (id) => `/courses/${id}/quizzes`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n  // PRD-11 FR-18 / FR-28\n  { key: 'gradebook', label: 'Gradebook', href: (id) => `/courses/${id}/gradebook`, roles: ['ADMIN', 'TEACHER'] },\n  { key: 'grades', label: 'Grades', href: (id) => `/courses/${id}/grades`, roles: ['STUDENT', 'PARENT'] },\n];\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\nimport AssignmentOutlinedIcon from '@mui/icons-material/AssignmentOutlined';\nimport GradingOutlinedIcon from '@mui/icons-material/GradingOutlined';\nimport WorkspacePremiumOutlinedIcon from '@mui/icons-material/WorkspacePremiumOutlined';\nimport StraightenOutlinedIcon from '@mui/icons-material/StraightenOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Assignments', href: '/assignments', icon: AssignmentOutlinedIcon, roles: ['STUDENT', 'PARENT', 'TEACHER', 'ADMIN'] },\n  { label: 'Grades', href: '/grades', icon: GradingOutlinedIcon, roles: ['STUDENT', 'PARENT'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Report cards', href: '/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Grading scales', href: '/admin/grading-scales', icon: StraightenOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Report cards', href: '/admin/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FcgzhhFWf7X8TC1AKz3SNW","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgsgdVv8xqR7ogsveD8nJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013vrHEEh62SW686nxDUgZrS","name":"Bash","input":{"command":"cd \"/Users/ikramaansari/Documents/React Projects/schoolhub\" && cat src/server/notifications/preferences.ts src/server/files/files-service.ts | head -150; grep -n \"getSchoolTimezone\" -r src | head; ls prisma prisma/migrations | tail -8","description":"Read preferences, files service, find timezone helper"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11551,"cache_read_input_tokens":89626,"cache_creation":{"ephemeral_5m_input_tokens":11551,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98a511c8-0f94-422f-bce3-9c853eb574ca","uuid":"913ec2f7-a3db-4199-8415-791e7c32fa30","timestamp":"2026-11-09T16:39:18.760Z","request_id":"req_011CgsgdVhjD13Va86EnK3L3","wire_tool_inputs":{"toolu_013vrHEEh62SW686nxDUgZrS":{"command":"cd \"/Users/ikramaansari/Documents/React Projects/schoolhub\" && cat src/server/notifications/preferences.ts src/server/files/files-service.ts | head -150; grep -n \"getSchoolTimezone\" -r src | head; ls prisma prisma/migrations | tail -8","description":"Read preferences, files service, find timezone helper"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013vrHEEh62SW686nxDUgZrS","type":"tool_result","content":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { UpdatePreferenceBody } from '@/lib/validators/notifications';\nimport {\n  getTypeDef,\n  NOTIFICATION_TYPES,\n  visibleTypesFor,\n  type NotificationCategory,\n  type NotificationTypeDef,\n  type Role,\n} from './types';\n\nexport interface ResolvedPrefs {\n  inApp: boolean;\n  email: boolean;\n}\n\n/** FR-7: mandatory in-app always wins; missing row → in-app on, email = registry default. Pure. */\nexport function resolvePrefs(\n  def: Pick<NotificationTypeDef, 'mandatoryInApp' | 'defaultEmail'>,\n  row?: { inApp: boolean; email: boolean } | null,\n): ResolvedPrefs {\n  return { inApp: def.mandatoryInApp || (row?.inApp ?? true), email: row?.email ?? def.defaultEmail };\n}\n\nexport interface NotificationPreferenceItem extends ResolvedPrefs {\n  type: string;\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  mandatoryInApp: boolean;\n}\n\nfunction toItem(type: string, def: NotificationTypeDef, row?: { inApp: boolean; email: boolean } | null) {\n  return {\n    type,\n    label: def.label,\n    description: def.description,\n    category: def.category,\n    mandatoryInApp: def.mandatoryInApp,\n    ...resolvePrefs(def, row),\n  } satisfies NotificationPreferenceItem;\n}\n\n/** FR-37: role-visible, non-emailOnly types merged with the user's rows. */\nexport async function getPreferencesFor(user: { id: string; role: Role }): Promise<NotificationPreferenceItem[]> {\n  const types = visibleTypesFor(user.role);\n  const rows = await prisma.notificationPreference.findMany({ where: { userId: user.id, type: { in: types } } });\n  const byType = new Map(rows.map((r) => [r.type, r]));\n  return types.map((type) => toItem(type, NOTIFICATION_TYPES[type], byType.get(type)));\n}\n\n/** FR-38: rejects unknown / emailOnly / role-invisible types and inApp:false on mandatory types. */\nexport async function updatePreference(\n  user: { id: string; role: Role },\n  body: UpdatePreferenceBody,\n): Promise<NotificationPreferenceItem> {\n  const def = getTypeDef(body.type);\n  if (!def || def.emailOnly || !def.roles.includes(user.role)) {\n    throw new AppError('VALIDATION_ERROR', 'Unknown notification type', { type: body.type });\n  }\n  if (def.mandatoryInApp && !body.inApp) {\n    throw new AppError('VALIDATION_ERROR', 'In-app notifications for this type are required by the school', {\n      type: body.type,\n    });\n  }\n  const row = await prisma.notificationPreference.upsert({\n    where: { userId_type: { userId: user.id, type: body.type } },\n    update: { inApp: body.inApp, email: body.email },\n    create: { userId: user.id, type: body.type, inApp: body.inApp, email: body.email },\n  });\n  return toItem(body.type, def, row);\n}\nimport { Readable } from 'node:stream';\nimport type { ReadableStream as NodeWebReadableStream } from 'node:stream/web';\nimport type { FileObject, Prisma } from '@prisma/client';\n// @ts-expect-error -- ponytail: busboy ships without types and comes transitively via next (ADR-2); add @types/busboy if it becomes a direct dep.\nimport busboy from 'busboy';\nimport { fileTypeFromBuffer } from 'file-type';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { rateLimit } from '@/server/rate-limit';\nimport { env } from '@/lib/env';\nimport { deleteFile, readFile, saveFile } from '@/server/storage';\nimport { canAccessFile, type FileAccessUser } from './access';\nimport { checkType, extOf, maxBytesFor, sanitizeFilename } from './validate';\n\n/**\n * File business logic (PRD-08 FR-3, FR-8, FR-11, FR-17, FR-46, NFR-3, NFR-5).\n * Route handlers in src/app/api/files stay thin.\n */\n\nconst HEAD_BYTES = 4100;\nconst MULTIPART_SLACK = 64 * 1024;\nconst CONTEXT_RE = /^[a-z][a-z0-9_-]{0,39}$/;\nconst UPLOADS_PER_HOUR = 60;\n\nexport interface FileSummary {\n  id: string;\n  originalName: string;\n  mimeType: string;\n  sizeBytes: number;\n}\n\nexport const toSummary = (f: Pick<FileObject, 'id' | 'originalName' | 'mimeType' | 'sizeBytes'>): FileSummary => ({\n  id: f.id,\n  originalName: f.originalName,\n  mimeType: f.mimeType,\n  sizeBytes: f.sizeBytes,\n});\n\nfunction maxUploadMb(): number {\n  const fromProcess = Number(process.env.MAX_UPLOAD_MB);\n  return Number.isInteger(fromProcess) && fromProcess > 0 ? fromProcess : env.MAX_UPLOAD_MB;\n}\n\n/** Lets busboy reach 'close' after we stop reading a part (the async iterator's 'readable' listener blocks resume()). */\nfunction drain(stream: Readable): void {\n  stream.removeAllListeners('readable');\n  stream.resume();\n}\n\nconst tooBig = (maxBytes: number) =>\n  new AppError('VALIDATION_ERROR', `File exceeds ${Math.round(maxBytes / (1024 * 1024))} MB.`);\n\n/** Streams one file part to disk: sniff the head, then hash+count while writing (NFR-5). */\nasync function storePart(\n  user: FileAccessUser,\n  context: string,\n  filename: string,\n  stream: Readable & { truncated?: boolean },\n  maxBytes: number,\n): Promise<FileSummary> {\n  const originalName = sanitizeFilename(filename);\n  const ext = extOf(originalName);\n\n  // Peek the first HEAD_BYTES without buffering the rest.\n  const iterator = stream[Symbol.asyncIterator]() as AsyncIterator<Buffer>;\n  const headChunks: Buffer[] = [];\n  let headLength = 0;\n  let done = false;\n  while (headLength < HEAD_BYTES) {\n    const next = await iterator.next();\n    if (next.done) {\n      done = true;\n      break;\n    }\n    headChunks.push(next.value);\n    headLength += next.value.length;\nsrc/app/(app)/assignments/page.tsx:11:import { getSchoolTimezone, listMyAssignments } from '@/server/assignments/assignments-service';\nsrc/app/(app)/assignments/page.tsx:29:  const timezone = await getSchoolTimezone();\nsrc/app/(app)/students/[id]/assignments/p