{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Yc3aKVnF4WYmEE1oDktPp","type":"tool_result","content":"import { Readable } from 'node:stream';\nimport type { ReadableStream as NodeWebReadableStream } from 'node:stream/web';\nimport type { FileObject, Prisma } from '@prisma/client';\n// @ts-expect-error -- ponytail: busboy ships without types and comes transitively via next (ADR-2); add @types/busboy if it becomes a direct dep.\nimport busboy from 'busboy';\nimport { fileTypeFromBuffer } from 'file-type';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { rateLimit } from '@/server/rate-limit';\nimport { env } from '@/lib/env';\nimport { deleteFile, readFile, saveFile } from '@/server/storage';\nimport { canAccessFile, type FileAccessUser } from './access';\nimport { checkType, extOf, maxBytesFor, sanitizeFilename } from './validate';\n\n/**\n * File business logic (PRD-08 FR-3, FR-8, FR-11, FR-17, FR-46, NFR-3, NFR-5).\n * Route handlers in src/app/api/files stay thin.\n */\n\nconst HEAD_BYTES = 4100;\nconst MULTIPART_SLACK = 64 * 1024;\nconst CONTEXT_RE = /^[a-z][a-z0-9_-]{0,39}$/;\nconst UPLOADS_PER_HOUR = 60;\n\nexport interface FileSummary {\n  id: string;\n  originalName: string;\n  mimeType: string;\n  sizeBytes: number;\n}\n\nexport const toSummary = (f: Pick<FileObject, 'id' | 'originalName' | 'mimeType' | 'sizeBytes'>): FileSummary => ({\n  id: f.id,\n  originalName: f.originalName,\n  mimeType: f.mimeType,\n  sizeBytes: f.sizeBytes,\n});\n\nfunction maxUploadMb(): number {\n  const fromProcess = Number(process.env.MAX_UPLOAD_MB);\n  return Number.isInteger(fromProcess) && fromProcess > 0 ? fromProcess : env.MAX_UPLOAD_MB;\n}\n\n/** Lets busboy reach 'close' after we stop reading a part (the async iterator's 'readable' listener blocks resume()). */\nfunction drain(stream: Readable): void {\n  stream.removeAllListeners('readable');\n  stream.resume();\n}\n\nconst tooBig = (maxBytes: number) =>\n  new AppError('VALIDATION_ERROR', `File exceeds ${Math.round(maxBytes / (1024 * 1024))} MB.`);\n\n/** Streams one file part to disk: sniff the head, then hash+count while writing (NFR-5). */\nasync function storePart(\n  user: FileAccessUser,\n  context: string,\n  filename: string,\n  stream: Readable & { truncated?: boolean },\n  maxBytes: number,\n): Promise<FileSummary> {\n  const originalName = sanitizeFilename(filename);\n  const ext = extOf(originalName);\n\n  // Peek the first HEAD_BYTES without buffering the rest.\n  const iterator = stream[Symbol.asyncIterator]() as AsyncIterator<Buffer>;\n  const headChunks: Buffer[] = [];\n  let headLength = 0;\n  let done = false;\n  while (headLength < HEAD_BYTES) {\n    const next = await iterator.next();\n    if (next.done) {\n      done = true;\n      break;\n    }\n    headChunks.push(next.value);\n    headLength += next.value.length;\n  }\n  const head = Buffer.concat(headChunks);\n  const sniffed = head.length ? (await fileTypeFromBuffer(head))?.mime : undefined;\n  const check = checkType(ext, sniffed, context, head);\n  if (!check.ok) {\n    drain(stream);\n    throw new AppError('VALIDATION_ERROR', check.error);\n  }\n  if (head.length === 0) {\n    throw new AppError('VALIDATION_ERROR', 'File is empty.');\n  }\n\n  async function* body() {\n    let total = head.length;\n    if (total > maxBytes) throw tooBig(maxBytes);\n    yield head;\n    if (!done) {\n      for (let next = await iterator.next(); !next.done; next = await iterator.next()) {\n        total += next.value.length;\n        // Per-context cap (logo 2 MB) is enforced here mid-stream; saveFile unlinks the tmp file.\n        if (total > maxBytes) throw tooBig(maxBytes);\n        yield next.value;\n      }\n    }\n    // busboy stops emitting at limits.fileSize and marks the stream truncated.\n    if (stream.truncated) throw tooBig(maxBytes);\n  }\n\n  const saved = await saveFile(Readable.from(body()), { ext });\n  const row = await prisma.fileObject.create({\n    data: {\n      ownerId: user.id,\n      originalName,\n      mimeType: check.mime,\n      sizeBytes: saved.sizeBytes,\n      storageKey: saved.storageKey,\n      sha256: saved.sha256,\n      context,\n      contextId: null,\n    },\n  });\n  return toSummary(row);\n}\n\n/** POST /api/files: multipart with a `context` field BEFORE the `file` part (ADR-2). */\nexport async function uploadFile(user: FileAccessUser, request: Request): Promise<FileSummary> {\n  const limit = rateLimit(`upload:${user.id}`, UPLOADS_PER_HOUR, 3_600_000);\n  if (!limit.ok) {\n    throw new AppError('RATE_LIMITED', 'Too many uploads. Try again later.', {\n      retryAfterSeconds: Math.ceil(limit.retryAfterMs / 1000),\n    });\n  }\n\n  const contentType = request.headers.get('content-type') ?? '';\n  if (!contentType.startsWith('multipart/form-data') || !request.body) {\n    throw new AppError('VALIDATION_ERROR', 'Expected multipart/form-data.');\n  }\n  const globalMax = maxBytesFor('lesson', maxUploadMb());\n  const declared = Number(request.headers.get('content-length'));\n  if (Number.isFinite(declared) && declared > globalMax + MULTIPART_SLACK) throw tooBig(globalMax);\n\n  return new Promise<FileSummary>((resolve, reject) => {\n    let context: string | null = null;\n    let work: Promise<FileSummary> | null = null;\n    let parser: ReturnType<typeof busboy>;\n    try {\n      parser = busboy({\n        headers: { 'content-type': contentType },\n        limits: { files: 1, fields: 5, fileSize: globalMax },\n      });\n    } catch {\n      reject(new AppError('VALIDATION_ERROR', 'Malformed multipart body.'));\n      return;\n    }\n\n    parser.on('field', (name: string, value: string) => {\n      if (name === 'context') context = value;\n    });\n\n    parser.on('file', (_name: string, stream: Readable & { truncated?: boolean }, info: { filename?: string }) => {\n      if (work) {\n        drain(stream);\n        return;\n      }\n      if (!context || !CONTEXT_RE.test(context)) {\n        drain(stream);\n        work = Promise.reject(new AppError('VALIDATION_ERROR', 'A valid context field must precede the file.'));\n        work.catch(() => undefined);\n        return;\n      }\n      work = storePart(user, context, info.filename ?? 'file', stream, maxBytesFor(context, maxUploadMb()));\n      // On failure keep draining so busboy reaches 'close' and the promise settles.\n      work.catch(() => drain(stream));\n    });\n\n    parser.on('error', () => reject(new AppError('VALIDATION_ERROR', 'Malformed multipart body.')));\n    parser.on('close', () => {\n      if (!work) reject(new AppError('VALIDATION_ERROR', 'No file was uploaded.'));\n      else work.then(resolve, reject);\n    });\n\n    Readable.fromWeb(request.body as unknown as NodeWebReadableStream).on('error', reject).pipe(parser);\n  });\n}\n\n/** Loads the row and runs the registry; denial is NOT_FOUND before any bytes are read (FR-9, NFR-1). */\nexport async function getFileForDownload(user: FileAccessUser | null, id: string) {\n  const file = await prisma.fileObject.findUnique({ where: { id } });\n  if (!file || !(await canAccessFile(user, file))) throw new AppError('NOT_FOUND', 'File not found');\n  return { file, stream: readFile(file.storageKey) };\n}\n\n/** FR-11: owner or ADMIN, only while unattached. Row first, then bytes. */\nexport async function deleteUnattachedFile(user: FileAccessUser, id: string, request?: Request): Promise<void> {\n  const file = await prisma.fileObject.findUnique({ where: { id } });\n  if (!file || (user.role !== 'ADMIN' && file.ownerId !== user.id)) throw new AppError('NOT_FOUND', 'File not found');\n  if (file.contextId !== null) throw new AppError('CONFLICT', 'File is attached and cannot be deleted.');\n  await prisma.fileObject.delete({ where: { id } });\n  await deleteFile(file.storageKey);\n  if (file.ownerId !== user.id) {\n    await audit({\n      actorId: user.id,\n      action: 'file.delete',\n      entityType: 'FileObject',\n      entityId: id,\n      metadata: { ownerId: file.ownerId, originalName: file.originalName },\n      request,\n    });\n  }\n}\n\ntype Tx = Prisma.TransactionClient;\n\n/**\n * FR-17: attach files to (context, contextId). Each must be the caller's\n * (any for ADMIN) and either unattached or already on this same record.\n */\nexport async function attachFiles(\n  tx: Tx,\n  user: FileAccessUser,\n  fileIds: string[],\n  context: string,\n  contextId: string,\n): Promise<void> {\n  const ids = [...new Set(fileIds)];\n  if (ids.length === 0) return;\n  const files = await tx.fileObject.findMany({\n    where: { id: { in: ids } },\n    select: { id: true, ownerId: true, context: true, contextId: true },\n  });\n  const eligible = files.filter(\n    (f) =>\n      (user.role === 'ADMIN' || f.ownerId === user.id) &&\n      (f.contextId === null || (f.contextId === contextId && f.context === context)),\n  );\n  if (eligible.length !== ids.length) {\n    throw new AppError('VALIDATION_ERROR', 'One or more files cannot be attached.', {\n      fileIds: ids.filter((id) => !eligible.some((f) => f.id === id)),\n    });\n  }\n  await tx.fileObject.updateMany({ where: { id: { in: ids } }, data: { context, contextId } });\n}\n\n/** D5: detached files get contextId null and are purged 24 h later. */\nexport async function detachFiles(tx: Tx, fileIds: string[]): Promise<void> {\n  if (fileIds.length === 0) return;\n  await tx.fileObject.updateMany({ where: { id: { in: fileIds } }, data: { contextId: null } });\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { deleteFile } from '@/server/storage';\n\nconst DAY_MS = 24 * 60 * 60_000;\nconst BATCH = 500;\n\n/**\n * FR-12: delete unattached files (contextId null) older than 24 h -- abandoned\n * uploads, detached attachments, removed inline images, replaced logos.\n * Bytes first, then rows. One batch per call; the daily run catches the rest.\n */\nexport async function purgeOrphanFiles(now: Date = new Date()): Promise<number> {\n  const orphans = await prisma.fileObject.findMany({\n    where: { contextId: null, createdAt: { lt: new Date(now.getTime() - DAY_MS) } },\n    select: { id: true, storageKey: true },\n    take: BATCH,\n  });\n  const deleted: string[] = [];\n  for (const file of orphans) {\n    try {\n      await deleteFile(file.storageKey);\n      deleted.push(file.id);\n    } catch (error) {\n      logger.error('Orphan file delete failed', { id: file.id, message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  // ponytail: a file attached in the ms between findMany and here keeps its row but loses its bytes;\n  // wrap in a row lock if attaching day-old uploads ever becomes common.\n  const { count } = await prisma.fileObject.deleteMany({ where: { id: { in: deleted }, contextId: null } });\n  logger.info('Purged orphan files', { count });\n  return count;\n}\nimport { AppError, apiError, ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { uploadFile } from '@/server/files/files-service';\n\nexport const runtime = 'nodejs';\nexport const dynamic = 'force-dynamic';\n\n/**\n * POST /api/files: multipart upload with `context` before `file` (FR-3..FR-7).\n * '/api/files/' is public in middleware (D1), so requireUser is mandatory here.\n */\nexport const POST = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  try {\n    return ok(await uploadFile(user, request), { status: 201 });\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'RATE_LIMITED') {\n      const res = apiError(error.code, error.message, error.details);\n      const seconds = (error.details as { retryAfterSeconds?: number } | undefined)?.retryAfterSeconds ?? 3600;\n      res.headers.set('Retry-After', String(seconds));\n      return res;\n    }\n    throw error;\n  }\n});\nimport { Readable } from 'node:stream';\nimport { ok, withHandler } from '@/server/http';\nimport { getCurrentUser, requireUser } from '@/server/auth/requireRole';\nimport { deleteUnattachedFile, getFileForDownload } from '@/server/files/files-service';\n\nexport const runtime = 'nodejs';\nexport const dynamic = 'force-dynamic';\n\ntype Ctx = { params: { id: string } };\n\n/**\n * GET /api/files/:id (FR-8, FR-9, FR-41). Anonymous callers reach this (D1);\n * canAccessFile decides, and a denial is 404 before any bytes are read.\n */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await getCurrentUser();\n  const { file, stream } = await getFileForDownload(user, params.id);\n\n  const wantInline = new URL(request.url).searchParams.get('inline') === '1';\n  const inlineOk = file.mimeType.startsWith('image/') || file.mimeType === 'application/pdf';\n  const disposition = wantInline && inlineOk ? 'inline' : 'attachment';\n\n  const headers = new Headers({\n    'Content-Type': file.mimeType,\n    'Content-Length': String(file.sizeBytes),\n    'X-Content-Type-Options': 'nosniff',\n    'Content-Disposition': `${disposition}; filename*=UTF-8''${encodeURIComponent(file.originalName)}`,\n    'Cache-Control': file.context === 'logo' ? 'public, max-age=3600' : 'private, no-store',\n  });\n  if (file.mimeType === 'image/svg+xml') {\n    headers.set('Content-Security-Policy', \"default-src 'none'; style-src 'unsafe-inline'\");\n  }\n  return new Response(Readable.toWeb(stream) as ReadableStream, { status: 200, headers });\n});\n\n/** DELETE /api/files/:id: owner or ADMIN, only while unattached (FR-11). */\nexport const DELETE = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  await deleteUnattachedFile(user, params.id, request);\n  return ok({ id: params.id });\n});\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\nimport { z } from 'zod';\nimport { parseVideoUrl } from '@/lib/video';\n\n/**\n * PRD-08 content validation (FR-16, FR-23, FR-27, FR-28). Shared by the\n * lesson editor and every content handler. Access rules live in the service.\n */\n\nexport const CONTENT_STATUSES = ['DRAFT', 'SCHEDULED', 'PUBLISHED'] as const;\nexport const contentStatus = z.enum(CONTENT_STATUSES);\n\nexport const MODULE_TITLE_MAX = 120;\nexport const LESSON_TITLE_MAX = 150;\nexport const MARKDOWN_MAX = 100_000;\n\nconst id = z.string().min(1);\nconst publishAt = z.coerce.date().nullable().optional();\n\nconst httpUrl = z\n  .string()\n  .trim()\n  .url('Enter a valid URL')\n  .refine((u) => /^https?:\\/\\//i.test(u), 'Only http(s) links are allowed');\n\nconst videoUrl = z\n  .string()\n  .trim()\n  .refine((u) => u === '' || parseVideoUrl(u) !== null, 'Only YouTube or Vimeo URLs are supported')\n  .transform((u) => (u === '' ? null : u))\n  .nullable()\n  .optional();\n\n/** FR-28: SCHEDULED needs a future publishAt. Applied to every schema with status. */\nfunction scheduleRule(val: { status?: string; publishAt?: Date | null }, ctx: z.RefinementCtx) {\n  if (val.status !== 'SCHEDULED') return;\n  if (!val.publishAt) {\n    ctx.addIssue({ code: 'custom', path: ['publishAt'], message: 'Choose a date and time to schedule' });\n  } else if (val.publishAt.getTime() <= Date.now()) {\n    ctx.addIssue({ code: 'custom', path: ['publishAt'], message: 'The scheduled time must be in the future' });\n  }\n}\n\nconst moduleFields = {\n  title: z.string().trim().min(1, 'Title is required').max(MODULE_TITLE_MAX),\n  description: z.string().trim().max(2000).nullable().optional(),\n  status: contentStatus.optional(),\n  publishAt,\n};\n\nexport const moduleCreate = z.object(moduleFields).strict().superRefine(scheduleRule);\nexport const moduleUpdate = z.object(moduleFields).partial().strict().superRefine(scheduleRule);\n\nconst lessonFields = {\n  title: z.string().trim().min(1, 'Title is required').max(LESSON_TITLE_MAX),\n  contentMarkdown: z.string().max(MARKDOWN_MAX),\n  estimatedMinutes: z.number().int().min(1).max(600).nullable(),\n  videoUrl,\n  attachments: z.array(z.object({ fileId: id }).strict()).max(50),\n  links: z\n    .array(z.object({ title: z.string().trim().min(1).max(200), url: httpUrl }).strict())\n    .max(50),\n  status: contentStatus,\n  publishAt,\n};\n\nexport const lessonCreate = z\n  .object({ title: lessonFields.title })\n  .strict();\nexport const lessonUpdate = z.object(lessonFields).partial().strict().superRefine(scheduleRule);\n\n/** FR-23: the full ordering of the course. */\nexport const reorderSchema = z\n  .object({ modules: z.array(z.object({ id, lessonIds: z.array(id) }).strict()) })\n  .strict();\n\nexport const progressSchema = z.object({ completed: z.boolean() }).strict();\n\nexport type ModuleCreateInput = z.infer<typeof moduleCreate>;\nexport type ModuleUpdateInput = z.infer<typeof moduleUpdate>;\nexport type LessonCreateInput = z.infer<typeof lessonCreate>;\nexport type LessonUpdateInput = z.infer<typeof lessonUpdate>;\nexport type ReorderInput = z.infer<typeof reorderSchema>;\nimport type { ContentStatus } from '@prisma/client';\n\n/**\n * Single source of truth for content visibility (PRD-08 FR-18, FR-19, FR-44).\n * Pure: evaluated at read time, no background job. Used by list, get,\n * prev/next, file access, progress and the Learning tab.\n */\n\nexport interface Publishable {\n  status: ContentStatus;\n  publishAt: Date | null;\n}\n\nexport function isVisible(item: Publishable, now: Date): boolean {\n  if (item.status === 'PUBLISHED') return true;\n  return item.status === 'SCHEDULED' && item.publishAt !== null && item.publishAt.getTime() <= now.getTime();\n}\n\n/** A lesson is visible to students/parents only when it AND its module are visible. */\nexport function isLessonVisible(lesson: Publishable, module: Publishable, now: Date): boolean {\n  return isVisible(module, now) && isVisible(lesson, now);\n}\n\n/** ADMIN, or the course's teacher/co-teacher, see drafts and scheduled items. */\nexport function canSeeDrafts(\n  user: { id: string; role: string },\n  course: { teacherId: string; coTeacherIds: string[] },\n): boolean {\n  if (user.role === 'ADMIN') return true;\n  return user.role === 'TEACHER' && (course.teacherId === user.id || course.coTeacherIds.includes(user.id));\n}\n/**\n * Video URL parsing (PRD-08 FR-30). Shared by the Zod validator and the\n * viewer. Only ever emits the two privacy-enhanced origins allowed by the\n * CSP frame-src in next.config.js.\n */\nexport interface ParsedVideo {\n  provider: 'youtube' | 'vimeo';\n  id: string;\n}\n\nconst YT_ID = /^[A-Za-z0-9_-]{6,20}$/;\nconst VIMEO_ID = /^\\d{1,12}$/;\n\nexport function parseVideoUrl(raw: string): ParsedVideo | null {\n  let url: URL;\n  try {\n    url = new URL(raw.trim());\n  } catch {\n    return null;\n  }\n  if (url.protocol !== 'https:' && url.protocol !== 'http:') return null;\n  const host = url.hostname.toLowerCase().replace(/^(www\\.|m\\.)/, '');\n  const firstSegment = url.pathname.split('/').filter(Boolean)[0] ?? '';\n\n  if (host === 'youtube.com' && url.pathname === '/watch') {\n    const id = url.searchParams.get('v') ?? '';\n    return YT_ID.test(id) ? { provider: 'youtube', id } : null;\n  }\n  if (host === 'youtu.be') {\n    return YT_ID.test(firstSegment) ? { provider: 'youtube', id: firstSegment } : null;\n  }\n  if (host === 'vimeo.com') {\n    return VIMEO_ID.test(firstSegment) ? { provider: 'vimeo', id: firstSegment } : null;\n  }\n  return null;\n}\n\nexport function embedUrl(video: ParsedVideo): string {\n  return video.provider === 'youtube'\n    ? `https://www.youtube-nocookie.com/embed/${video.id}`\n    : `https://player.vimeo.com/video/${video.id}`;\n}\n94:  'content.lesson_published': {","is_error":false}]},"parent_tool_use_id":null,"session_id":"ccfb151c-4d24-4e75-9641-dd0f996cf75f","uuid":"2af41ae4-4386-4976-b399-0fd4da83e1be","timestamp":"2026-11-07T01:41:41.805Z","tool_use_result":{"stdout":"import { Readable } from 'node:stream';\nimport type { ReadableStream as NodeWebReadableStream } from 'node:stream/web';\nimport type { FileObject, Prisma } from '@prisma/client';\n// @ts-expect-error -- ponytail: busboy ships without types and comes transitively via next (ADR-2); add @types/busboy if it becomes a direct dep.\nimport busboy from 'busboy';\nimport { fileTypeFromBuffer } from 'file-type';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { rateLimit } from '@/server/rate-limit';\nimport { env } from '@/lib/env';\nimport { deleteFile, readFile, saveFile } from '@/server/storage';\nimport { canAccessFile, type FileAccessUser } from './access';\nimport { checkType, extOf, maxBytesFor, sanitizeFilename } from './validate';\n\n/**\n * File business logic (PRD-08 FR-3, FR-8, FR-11, FR-17, FR-46, NFR-3, NFR-5).\n * Route handlers in src/app/api/files stay thin.\n */\n\nconst HEAD_BYTES = 4100;\nconst MULTIPART_SLACK = 64 * 1024;\nconst CONTEXT_RE = /^[a-z][a-z0-9_-]{0,39}$/;\nconst UPLOADS_PER_HOUR = 60;\n\nexport interface FileSummary {\n  id: string;\n  originalName: string;\n  mimeType: string;\n  sizeBytes: number;\n}\n\nexport const toSummary = (f: Pick<FileObject, 'id' | 'originalName' | 'mimeType' | 'sizeBytes'>): FileSummary => ({\n  id: f.id,\n  originalName: f.originalName,\n  mimeType: f.mimeType,\n  sizeBytes: f.sizeBytes,\n});\n\nfunction maxUploadMb(): number {\n  const fromProcess = Number(process.env.MAX_UPLOAD_MB);\n  return Number.isInteger(fromProcess) && fromProcess > 0 ? fromProcess : env.MAX_UPLOAD_MB;\n}\n\n/** Lets busboy reach 'close' after we stop reading a part (the async iterator's 'readable' listener blocks resume()). */\nfunction drain(stream: Readable): void {\n  stream.removeAllListeners('readable');\n  stream.resume();\n}\n\nconst tooBig = (maxBytes: number) =>\n  new AppError('VALIDATION_ERROR', `File exceeds ${Math.round(maxBytes / (1024 * 1024))} MB.`);\n\n/** Streams one file part to disk: sniff the head, then hash+count while writing (NFR-5). */\nasync function storePart(\n  user: FileAccessUser,\n  context: string,\n  filename: string,\n  stream: Readable & { truncated?: boolean },\n  maxBytes: number,\n): Promise<FileSummary> {\n  const originalName = sanitizeFilename(filename);\n  const ext = extOf(originalName);\n\n  // Peek the first HEAD_BYTES without buffering the rest.\n  const iterator = stream[Symbol.asyncIterator]() as AsyncIterator<Buffer>;\n  const headChunks: Buffer[] = [];\n  let headLength = 0;\n  let done = false;\n  while (headLength < HEAD_BYTES) {\n    const next = await iterator.next();\n    if (next.done) {\n      done = true;\n      break;\n    }\n    headChunks.push(next.value);\n    headLength += next.value.length;\n  }\n  const head = Buffer.concat(headChunks);\n  const sniffed = head.length ? (await fileTypeFromBuffer(head))?.mime : undefined;\n  const check = checkType(ext, sniffed, context, head);\n  if (!check.ok) {\n    drain(stream);\n    throw new AppError('VALIDATION_ERROR', check.error);\n  }\n  if (head.length === 0) {\n    throw new AppError('VALIDATION_ERROR', 'File is empty.');\n  }\n\n  async function* body() {\n    let total = head.length;\n    if (total > maxBytes) throw tooBig(maxBytes);\n    yield head;\n    if (!done) {\n      for (let next = await iterator.next(); !next.done; next = await iterator.next()) {\n        total += next.value.length;\n        // Per-context cap (logo 2 MB) is enforced here mid-stream; saveFile unlinks the tmp file.\n        if (total > maxBytes) throw tooBig(maxBytes);\n        yield next.value;\n      }\n    }\n    // busboy stops emitting at limits.fileSize and marks the stream truncated.\n    if (stream.truncated) throw tooBig(maxBytes);\n  }\n\n  const saved = await saveFile(Readable.from(body()), { ext });\n  const row = await prisma.fileObject.create({\n    data: {\n      ownerId: user.id,\n      originalName,\n      mimeType: check.mime,\n      sizeBytes: saved.sizeBytes,\n      storageKey: saved.storageKey,\n      sha256: saved.sha256,\n      context,\n      contextId: null,\n    },\n  });\n  return toSummary(row);\n}\n\n/** POST /api/files: multipart with a `context` field BEFORE the `file` part (ADR-2). */\nexport async function uploadFile(user: FileAccessUser, request: Request): Promise<FileSummary> {\n  const limit = rateLimit(`upload:${user.id}`, UPLOADS_PER_HOUR, 3_600_000);\n  if (!limit.ok) {\n    throw new AppError('RATE_LIMITED', 'Too many uploads. Try again later.', {\n      retryAfterSeconds: Math.ceil(limit.retryAfterMs / 1000),\n    });\n  }\n\n  const contentType = request.headers.get('content-type') ?? '';\n  if (!contentType.startsWith('multipart/form-data') || !request.body) {\n    throw new AppError('VALIDATION_ERROR', 'Expected multipart/form-data.');\n  }\n  const globalMax = maxBytesFor('lesson', maxUploadMb());\n  const declared = Number(request.headers.get('content-length'));\n  if (Number.isFinite(declared) && declared > globalMax + MULTIPART_SLACK) throw tooBig(globalMax);\n\n  return new Promise<FileSummary>((resolve, reject) => {\n    let context: string | null = null;\n    let work: Promise<FileSummary> | null = null;\n    let parser: ReturnType<typeof busboy>;\n    try {\n      parser = busboy({\n        headers: { 'content-type': contentType },\n        limits: { files: 1, fields: 5, fileSize: globalMax },\n      });\n    } catch {\n      reject(new AppError('VALIDATION_ERROR', 'Malformed multipart body.'));\n      return;\n    }\n\n    parser.on('field', (name: string, value: string) => {\n      if (name === 'context') context = value;\n    });\n\n    parser.on('file', (_name: string, stream: Readable & { truncated?: boolean }, info: { filename?: string }) => {\n      if (work) {\n        drain(stream);\n        return;\n      }\n      if (!context || !CONTEXT_RE.test(context)) {\n        drain(stream);\n        work = Promise.reject(new AppError('VALIDATION_ERROR', 'A valid context field must precede the file.'));\n        work.catch(() => undefined);\n        return;\n      }\n      work = storePart(user, context, info.filename ?? 'file', stream, maxBytesFor(context, maxUploadMb()));\n      // On failure keep draining so busboy reaches 'close' and the promise settles.\n      work.catch(() => drain(stream));\n    });\n\n    parser.on('error', () => reject(new AppError('VALIDATION_ERROR', 'Malformed multipart body.')));\n    parser.on('close', () => {\n      if (!work) reject(new AppError('VALIDATION_ERROR', 'No file was uploaded.'));\n      else work.then(resolve, reject);\n    });\n\n    Readable.fromWeb(request.body as unknown as NodeWebReadableStream).on('error', reject).pipe(parser);\n  });\n}\n\n/** Loads the row and runs the registry; denial is NOT_FOUND before any bytes are read (FR-9, NFR-1). */\nexport async function getFileForDownload(user: FileAccessUser | null, id: string) {\n  const file = await prisma.fileObject.findUnique({ where: { id } });\n  if (!file || !(await canAccessFile(user, file))) throw new AppError('NOT_FOUND', 'File not found');\n  return { file, stream: readFile(file.storageKey) };\n}\n\n/** FR-11: owner or ADMIN, only while unattached. Row first, then bytes. */\nexport async function deleteUnattachedFile(user: FileAccessUser, id: string, request?: Request): Promise<void> {\n  const file = await prisma.fileObject.findUnique({ where: { id } });\n  if (!file || (user.role !== 'ADMIN' && file.ownerId !== user.id)) throw new AppError('NOT_FOUND', 'File not found');\n  if (file.contextId !== null) throw new AppError('CONFLICT', 'File is attached and cannot be deleted.');\n  await prisma.fileObject.delete({ where: { id } });\n  await deleteFile(file.storageKey);\n  if (file.ownerId !== user.id) {\n    await audit({\n      actorId: user.id,\n      action: 'file.delete',\n      entityType: 'FileObject',\n      entityId: id,\n      metadata: { ownerId: file.ownerId, originalName: file.originalName },\n      request,\n    });\n  }\n}\n\ntype Tx = Prisma.TransactionClient;\n\n/**\n * FR-17: attach files to (context, contextId). Each must be the caller's\n * (any for ADMIN) and either unattached or already on this same record.\n */\nexport async function attachFiles(\n  tx: Tx,\n  user: FileAccessUser,\n  fileIds: string[],\n  context: string,\n  contextId: string,\n): Promise<void> {\n  const ids = [...new Set(fileIds)];\n  if (ids.length === 0) return;\n  const files = await tx.fileObject.findMany({\n    where: { id: { in: ids } },\n    select: { id: true, ownerId: true, context: true, contextId: true },\n  });\n  const eligible = files.filter(\n    (f) =>\n      (user.role === 'ADMIN' || f.ownerId === user.id) &&\n      (f.contextId === null || (f.contextId === contextId && f.context === context)),\n  );\n  if (eligible.length !== ids.length) {\n    throw new AppError('VALIDATION_ERROR', 'One or more files cannot be attached.', {\n      fileIds: ids.filter((id) => !eligible.some((f) => f.id === id)),\n    });\n  }\n  await tx.fileObject.updateMany({ where: { id: { in: ids } }, data: { context, contextId } });\n}\n\n/** D5: detached files get contextId null and are purged 24 h later. */\nexport async function detachFiles(tx: Tx, fileIds: string[]): Promise<void> {\n  if (fileIds.length === 0) return;\n  await tx.fileObject.updateMany({ where: { id: { in: fileIds } }, data: { contextId: null } });\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { deleteFile } from '@/server/storage';\n\nconst DAY_MS = 24 * 60 * 60_000;\nconst BATCH = 500;\n\n/**\n * FR-12: delete unattached files (contextId null) older than 24 h -- abandoned\n * uploads, detached attachments, removed inline images, replaced logos.\n * Bytes first, then rows. One batch per call; the daily run catches the rest.\n */\nexport async function purgeOrphanFiles(now: Date = new Date()): Promise<number> {\n  const orphans = await prisma.fileObject.findMany({\n    where: { contextId: null, createdAt: { lt: new Date(now.getTime() - DAY_MS) } },\n    select: { id: true, storageKey: true },\n    take: BATCH,\n  });\n  const deleted: string[] = [];\n  for (const file of orphans) {\n    try {\n      await deleteFile(file.storageKey);\n      deleted.push(file.id);\n    } catch (error) {\n      logger.error('Orphan file delete failed', { id: file.id, message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  // ponytail: a file attached in the ms between findMany and here keeps its row but loses its bytes;\n  // wrap in a row lock if attaching day-old uploads ever becomes common.\n  const { count } = await prisma.fileObject.deleteMany({ where: { id: { in: deleted }, contextId: null } });\n  logger.info('Purged orphan files', { count });\n  return count;\n}\nimport { AppError, apiError, ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { uploadFile } from '@/server/files/files-service';\n\nexport const runtime = 'nodejs';\nexport const dynamic = 'force-dynamic';\n\n/**\n * POST /api/files: multipart upload with `context` before `file` (FR-3..FR-7).\n * '/api/files/' is public in middleware (D1), so requireUser is mandatory here.\n */\nexport const POST = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  try {\n    return ok(await uploadFile(user, request), { status: 201 });\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'RATE_LIMITED') {\n      const res = apiError(error.code, error.message, error.details);\n      const seconds = (error.details as { retryAfterSeconds?: number } | undefined)?.retryAfterSeconds ?? 3600;\n      res.headers.set('Retry-After', String(seconds));\n      return res;\n    }\n    throw error;\n  }\n});\nimport { Readable } from 'node:stream';\nimport { ok, withHandler } from '@/server/http';\nimport { getCurrentUser, requireUser } from '@/server/auth/requireRole';\nimport { deleteUnattachedFile, getFileForDownload } from '@/server/files/files-service';\n\nexport const runtime = 'nodejs';\nexport const dynamic = 'force-dynamic';\n\ntype Ctx = { params: { id: string } };\n\n/**\n * GET /api/files/:id (FR-8, FR-9, FR-41). Anonymous callers reach this (D1);\n * canAccessFile decides, and a denial is 404 before any bytes are read.\n */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await getCurrentUser();\n  const { file, stream } = await getFileForDownload(user, params.id);\n\n  const wantInline = new URL(request.url).searchParams.get('inline') === '1';\n  const inlineOk = file.mimeType.startsWith('image/') || file.mimeType === 'application/pdf';\n  const disposition = wantInline && inlineOk ? 'inline' : 'attachment';\n\n  const headers = new Headers({\n    'Content-Type': file.mimeType,\n    'Content-Length': String(file.sizeBytes),\n    'X-Content-Type-Options': 'nosniff',\n    'Content-Disposition': `${disposition}; filename*=UTF-8''${encodeURIComponent(file.originalName)}`,\n    'Cache-Control': file.context === 'logo' ? 'public, max-age=3600' : 'private, no-store',\n  });\n  if (file.mimeType === 'image/svg+xml') {\n    headers.set('Content-Security-Policy', \"default-src 'none'; style-src 'unsafe-inline'\");\n  }\n  return new Response(Readable.toWeb(stream) as ReadableStream, { status: 200, headers });\n});\n\n/** DELETE /api/files/:id: owner or ADMIN, only while unattached (FR-11). */\nexport const DELETE = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  await deleteUnattachedFile(user, params.id, request);\n  return ok({ id: params.id });\n});\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\nimport { z } from 'zod';\nimport { parseVideoUrl } from '@/lib/video';\n\n/**\n * PRD-08 content validation (FR-16, FR-23, FR-27, FR-28). Shared by the\n * lesson editor and every content handler. Access rules live in the service.\n */\n\nexport const CONTENT_STATUSES = ['DRAFT', 'SCHEDULED', 'PUBLISHED'] as const;\nexport const contentStatus = z.enum(CONTENT_STATUSES);\n\nexport const MODULE_TITLE_MAX = 120;\nexport const LESSON_TITLE_MAX = 150;\nexport const MARKDOWN_MAX = 100_000;\n\nconst id = z.string().min(1);\nconst publishAt = z.coerce.date().nullable().optional();\n\nconst httpUrl = z\n  .string()\n  .trim()\n  .url('Enter a valid URL')\n  .refine((u) => /^https?:\\/\\//i.test(u), 'Only http(s) links are allowed');\n\nconst videoUrl = z\n  .string()\n  .trim()\n  .refine((u) => u === '' || parseVideoUrl(u) !== null, 'Only YouTube or Vimeo URLs are supported')\n  .transform((u) => (u === '' ? null : u))\n  .nullable()\n  .optional();\n\n/** FR-28: SCHEDULED needs a future publishAt. Applied to every schema with status. */\nfunction scheduleRule(val: { status?: string; publishAt?: Date | null }, ctx: z.RefinementCtx) {\n  if (val.status !== 'SCHEDULED') return;\n  if (!val.publishAt) {\n    ctx.addIssue({ code: 'custom', path: ['publishAt'], message: 'Choose a date and time to schedule' });\n  } else if (val.publishAt.getTime() <= Date.now()) {\n    ctx.addIssue({ code: 'custom', path: ['publishAt'], message: 'The scheduled time must be in the future' });\n  }\n}\n\nconst moduleFields = {\n  title: z.string().trim().min(1, 'Title is required').max(MODULE_TITLE_MAX),\n  description: z.string().trim().max(2000).nullable().optional(),\n  status: contentStatus.optional(),\n  publishAt,\n};\n\nexport const moduleCreate = z.object(moduleFields).strict().superRefine(scheduleRule);\nexport const moduleUpdate = z.object(moduleFields).partial().strict().superRefine(scheduleRule);\n\nconst lessonFields = {\n  title: z.string().trim().min(1, 'Title is required').max(LESSON_TITLE_MAX),\n  contentMarkdown: z.string().max(MARKDOWN_MAX),\n  estimatedMinutes: z.number().int().min(1).max(600).nullable(),\n  videoUrl,\n  attachments: z.array(z.object({ fileId: id }).strict()).max(50),\n  links: z\n    .array(z.object({ title: z.string().trim().min(1).max(200), url: httpUrl }).strict())\n    .max(50),\n  status: contentStatus,\n  publishAt,\n};\n\nexport const lessonCreate = z\n  .object({ title: lessonFields.title })\n  .strict();\nexport const lessonUpdate = z.object(lessonFields).partial().strict().superRefine(scheduleRule);\n\n/** FR-23: the full ordering of the course. */\nexport const reorderSchema = z\n  .object({ modules: z.array(z.object({ id, lessonIds: z.array(id) }).strict()) })\n  .strict();\n\nexport const progressSchema = z.object({ completed: z.boolean() }).strict();\n\nexport type ModuleCreateInput = z.infer<typeof moduleCreate>;\nexport type ModuleUpdateInput = z.infer<typeof moduleUpdate>;\nexport type LessonCreateInput = z.infer<typeof lessonCreate>;\nexport type LessonUpdateInput = z.infer<typeof lessonUpdate>;\nexport type ReorderInput = z.infer<typeof reorderSchema>;\nimport type { ContentStatus } from '@prisma/client';\n\n/**\n * Single source of truth for content visibility (PRD-08 FR-18, FR-19, FR-44).\n * Pure: evaluated at read time, no background job. Used by list, get,\n * prev/next, file access, progress and the Learning tab.\n */\n\nexport interface Publishable {\n  status: ContentStatus;\n  publishAt: Date | null;\n}\n\nexport function isVisible(item: Publishable, now: Date): boolean {\n  if (item.status === 'PUBLISHED') return true;\n  return item.status === 'SCHEDULED' && item.publishAt !== null && item.publishAt.getTime() <= now.getTime();\n}\n\n/** A lesson is visible to students/parents only when it AND its module are visible. */\nexport function isLessonVisible(lesson: Publishable, module: Publishable, now: Date): boolean {\n  return isVisible(module, now) && isVisible(lesson, now);\n}\n\n/** ADMIN, or the course's teacher/co-teacher, see drafts and scheduled items. */\nexport function canSeeDrafts(\n  user: { id: string; role: string },\n  course: { teacherId: string; coTeacherIds: string[] },\n): boolean {\n  if (user.role === 'ADMIN') return true;\n  return user.role === 'TEACHER' && (course.teacherId === user.id || course.coTeacherIds.includes(user.id));\n}\n/**\n * Video URL parsing (PRD-08 FR-30). Shared by the Zod validator and the\n * viewer. Only ever emits the two privacy-enhanced origins allowed by the\n * CSP frame-src in next.config.js.\n */\nexport interface ParsedVideo {\n  provider: 'youtube' | 'vimeo';\n  id: string;\n}\n\nconst YT_ID = /^[A-Za-z0-9_-]{6,20}$/;\nconst VIMEO_ID = /^\\d{1,12}$/;\n\nexport function parseVideoUrl(raw: string): ParsedVideo | null {\n  let url: URL;\n  try {\n    url = new URL(raw.trim());\n  } catch {\n    return null;\n  }\n  if (url.protocol !== 'https:' && url.protocol !== 'http:') return null;\n  const host = url.hostname.toLowerCase().replace(/^(www\\.|m\\.)/, '');\n  const firstSegment = url.pathname.split('/').filter(Boolean)[0] ?? '';\n\n  if (host === 'youtube.com' && url.pathname === '/watch') {\n    const id = url.searchParams.get('v') ?? '';\n    return YT_ID.test(id) ? { provider: 'youtube', id } : null;\n  }\n  if (host === 'youtu.be') {\n    return YT_ID.test(firstSegment) ? { provider: 'youtube', id: firstSegment } : null;\n  }\n  if (host === 'vimeo.com') {\n    return VIMEO_ID.test(firstSegment) ? { provider: 'vimeo', id: firstSegment } : null;\n  }\n  return null;\n}\n\nexport function embedUrl(video: ParsedVideo): string {\n  return video.provider === 'youtube'\n    ? `https://www.youtube-nocookie.com/embed/${video.id}`\n    : `https://player.vimeo.com/video/${video.id}`;\n}\n94:  'content.lesson_published': {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018Yc3aKVnF4WYmEE1oDktPp","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
