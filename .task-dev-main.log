{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgi5nLK4sux1bFDQYYAv3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015pVtJeMhJgQzRrkYzEdvdR","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/email/transport.ts","content":"import type { Transporter } from 'nodemailer';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\n\nexport interface MailMessage {\n  to: string;\n  toName?: string | null;\n  subject: string;\n  html: string;\n  text: string;\n}\n\nlet smtp: Transporter | null = null;\n\nasync function getSmtp(): Promise<Transporter> {\n  if (smtp) return smtp;\n  if (!env.SMTP_HOST) throw new Error('SMTP_HOST is not set');\n  const nodemailer = await import('nodemailer');\n  smtp = nodemailer.createTransport({\n    host: env.SMTP_HOST,\n    port: env.SMTP_PORT ?? 587,\n    secure: env.SMTP_SECURE ?? false,\n    auth: env.SMTP_USER ? { user: env.SMTP_USER, pass: env.SMTP_PASS } : undefined,\n  });\n  return smtp;\n}\n\n/**\n * FR-21: EMAIL_TRANSPORT='smtp' → Nodemailer; anything else → console.\n * Config errors throw here so the dispatcher records a retryable failure.\n */\nexport async function sendMail(message: MailMessage): Promise<void> {\n  if (env.EMAIL_TRANSPORT !== 'smtp') {\n    logger.info('Email (console transport)', { to: message.to, subject: message.subject, text: message.text });\n    return;\n  }\n  if (!env.EMAIL_FROM) throw new Error('EMAIL_FROM is not set');\n  const transport = await getSmtp();\n  await transport.sendMail({\n    from: env.EMAIL_FROM,\n    to: message.toName ? { name: message.toName, address: message.to } : message.to,\n    subject: message.subject,\n    html: message.html,\n    text: message.text,\n    headers: { 'List-Unsubscribe': `<${env.APP_URL.replace(/\\/$/, '')}/account/notifications>` },\n  });\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4309,"cache_read_input_tokens":103012,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4309},"output_tokens":47,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1921163e-32be-4c5c-99f3-b230ef406493","uuid":"a1805682-af09-475e-acda-1862cd5190cd","timestamp":"2026-11-04T14:57:04.735Z","request_id":"req_011Cgi5nKwVZjZyt3XE5Uhw4","wire_tool_inputs":{"toolu_015pVtJeMhJgQzRrkYzEdvdR":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/email/transport.ts","content":"import type { Transporter } from 'nodemailer';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\n\nexport interface MailMessage {\n  to: string;\n  toName?: string | null;\n  subject: string;\n  html: string;\n  text: string;\n}\n\nlet smtp: Transporter | null = null;\n\nasync function getSmtp(): Promise<Transporter> {\n  if (smtp) return smtp;\n  if (!env.SMTP_HOST) throw new Error('SMTP_HOST is not set');\n  const nodemailer = await import('nodemailer');\n  smtp = nodemailer.createTransport({\n    host: env.SMTP_HOST,\n    port: env.SMTP_PORT ?? 587,\n    secure: env.SMTP_SECURE ?? false,\n    auth: env.SMTP_USER ? { user: env.SMTP_USER, pass: env.SMTP_PASS } : undefined,\n  });\n  return smtp;\n}\n\n/**\n * FR-21: EMAIL_TRANSPORT='smtp' → Nodemailer; anything else → console.\n * Config errors throw here so the dispatcher records a retryable failure.\n */\nexport async function sendMail(message: MailMessage): Promise<void> {\n  if (env.EMAIL_TRANSPORT !== 'smtp') {\n    logger.info('Email (console transport)', { to: message.to, subject: message.subject, text: message.text });\n    return;\n  }\n  if (!env.EMAIL_FROM) throw new Error('EMAIL_FROM is not set');\n  const transport = await getSmtp();\n  await transport.sendMail({\n    from: env.EMAIL_FROM,\n    to: message.toName ? { name: message.toName, address: message.to } : message.to,\n    subject: message.subject,\n    html: message.html,\n    text: message.text,\n    headers: { 'List-Unsubscribe': `<${env.APP_URL.replace(/\\/$/, '')}/account/notifications>` },\n  });\n}\n"}}}
