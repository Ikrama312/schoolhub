ht-core\": \"1.47.2\",\n    \"@mui/x-internals\": \"9.1.0\"\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01YCGMCwthY1W3AssfXwWJBu","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
