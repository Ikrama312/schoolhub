{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CKjEbsbBQMCKHcGjf5gHNp","type":"tool_result","content":"1\t=== src/server/http.ts\n2\timport { NextResponse } from 'next/server';\n3\timport { Prisma } from '@prisma/client';\n4\timport { ZodError, type ZodTypeAny, type output } from 'zod';\n5\timport { logger } from '@/lib/logger';\n6\t\n7\t/**\n8\t * The one chokepoint every route handler goes through. Nothing here should\n9\t * be reimplemented per-route — new endpoints import from this module, they\n10\t * don't hand-roll envelopes, pagination clamping or error mapping.\n11\t */\n12\t\n13\texport type ApiErrorCode =\n14\t  | 'VALIDATION_ERROR'\n15\t  | 'NOT_FOUND'\n16\t  | 'CONFLICT'\n17\t  | 'INTERNAL'\n18\t  | 'RATE_LIMITED'\n19\t  | 'UNAUTHENTICATED'\n20\t  | 'FORBIDDEN'\n21\t  | 'INVALID_TOKEN';\n22\t\n23\tconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n24\t  VALIDATION_ERROR: 400,\n25\t  NOT_FOUND: 404,\n26\t  CONFLICT: 409,\n27\t  INTERNAL: 500,\n28\t  RATE_LIMITED: 429,\n29\t  UNAUTHENTICATED: 401,\n30\t  FORBIDDEN: 403,\n31\t  INVALID_TOKEN: 410,\n32\t};\n33\t\n34\t/** Throw this from a handler for a known, intentional failure. */\n35\texport class AppError extends Error {\n36\t  code: ApiErrorCode;\n37\t  details?: unknown;\n38\t\n39\t  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n40\t    super(message);\n41\t    this.code = code;\n42\t    this.details = details;\n43\t  }\n44\t}\n45\t\n46\texport function ok<T>(data: T, init?: ResponseInit) {\n47\t  return NextResponse.json({ data }, init);\n48\t}\n49\t\n50\texport function paginated<T>(\n51\t  data: T[],\n52\t  meta: { page: number; pageSize: number; total: number },\n53\t  init?: ResponseInit,\n54\t) {\n55\t  return NextResponse.json({ data, meta }, init);\n56\t}\n57\t\n58\texport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n59\t  return NextResponse.json(\n60\t    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n61\t    { status: ERROR_STATUS[code] },\n62\t  );\n63\t}\n64\t\n65\t/**\n66\t * Wraps a route handler, mapping thrown errors to the shared envelope:\n67\t * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n68\t * AppError -> its own code/status\n69\t * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n70\t * anything else -> INTERNAL (500), stack logged, never returned to client\n71\t */\n72\texport function withHandler<Args extends unknown[]>(\n73\t  fn: (...args: Args) => Promise<Response>,\n74\t) {\n75\t  return async (...args: Args): Promise<Response> => {\n76\t    try {\n77\t      return await fn(...args);\n78\t    } catch (error) {\n79\t      if (error instanceof ZodError) {\n80\t        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n81\t      }\n82\t\n83\t      if (error instanceof AppError) {\n84\t        return apiError(error.code, error.message, error.details);\n85\t      }\n86\t\n87\t      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n88\t        if (error.code === 'P2002') {\n89\t          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n90\t        }\n91\t        if (error.code === 'P2025') {\n92\t          return apiError('NOT_FOUND', 'Resource not found');\n93\t        }\n94\t      }\n95\t\n96\t      logger.error('Unhandled error in route handler', {\n97\t        message: error instanceof Error ? error.message : String(error),\n98\t        stack: error instanceof Error ? error.stack : undefined,\n99\t      });\n100\t      return apiError('INTERNAL', 'Internal server error');\n101\t    }\n102\t  };\n103\t}\n104\t\n105\texport interface PaginationParams {\n106\t  page: number;\n107\t  pageSize: number;\n108\t  skip: number;\n109\t  take: number;\n110\t}\n111\t\n112\tconst MAX_PAGE_SIZE = 100;\n113\t\n114\texport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n115\t  const rawPage = Number(searchParams.get('page'));\n116\t  const rawPageSize = Number(searchParams.get('pageSize'));\n117\t\n118\t  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n119\t  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n120\t  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n121\t\n122\t  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n123\t}\n124\t\n125\t// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\n126\texport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n127\t  const json = await request.json().catch(() => ({}));\n128\t  return schema.parse(json);\n129\t}\n130\t\n131\t/** First x-forwarded-for entry (the client, behind our proxy), or null. */\n132\texport function getClientIp(request: Request): string | null {\n133\t  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n134\t}\n135\t\n136\texport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n137\t  return schema.parse(Object.fromEntries(searchParams.entries()));\n138\t}\n139\t=== src/server/auth/requireRole.ts\n140\timport { cache } from 'react';\n141\timport { headers } from 'next/headers';\n142\timport { redirect } from 'next/navigation';\n143\timport { AppError } from '@/server/http';\n144\timport { auth } from '@/server/auth/auth';\n145\timport type { Role } from '@/config/navigation';\n146\t\n147\t/**\n148\t * Single chokepoint for server-side authorization (FR-28, FR-29, ADR-2).\n149\t * Route handlers use requireUser/requireRole (throw AppError → 401/403 via\n150\t * withHandler); server pages/layouts use requirePageUser/requirePageRole\n151\t * (redirect to /login or /forbidden).\n152\t */\n153\texport interface SessionUser {\n154\t  id: string;\n155\t  role: Role;\n156\t  firstName: string;\n157\t  lastName: string;\n158\t  email: string;\n159\t}\n160\t\n161\texport const getCurrentUser = cache(async (): Promise<SessionUser | null> => {\n162\t  const user = (await auth())?.user;\n163\t  if (!user?.id) return null;\n164\t  return { id: user.id, role: user.role, firstName: user.firstName, lastName: user.lastName, email: user.email };\n165\t});\n166\t\n167\ttype Check = { user: SessionUser } | { error: 'UNAUTHENTICATED' | 'FORBIDDEN' };\n168\t\n169\tasync function resolve(roles: Role[]): Promise<Check> {\n170\t  const user = await getCurrentUser();\n171\t  if (!user) return { error: 'UNAUTHENTICATED' };\n172\t  if (roles.length && !roles.includes(user.role)) return { error: 'FORBIDDEN' };\n173\t  return { user };\n174\t}\n175\t\n176\texport async function requireRole(...roles: Role[]): Promise<SessionUser> {\n177\t  const result = await resolve(roles);\n178\t  if ('user' in result) return result.user;\n179\t  throw result.error === 'UNAUTHENTICATED'\n180\t    ? new AppError('UNAUTHENTICATED', 'You must be signed in.')\n181\t    : new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n182\t}\n183\t\n184\texport async function requireUser(): Promise<SessionUser> {\n185\t  return requireRole();\n186\t}\n187\t\n188\texport async function requirePageRole(...roles: Role[]): Promise<SessionUser> {\n189\t  const result = await resolve(roles);\n190\t  if ('user' in result) return result.user;\n191\t  if (result.error === 'FORBIDDEN') redirect('/forbidden');\n192\t  const callbackUrl = headers().get('x-pathname') ?? '/dashboard';\n193\t  redirect(`/login?callbackUrl=${encodeURIComponent(callbackUrl)}`);\n194\t}\n195\t\n196\texport async function requirePageUser(): Promise<SessionUser> {\n197\t  return requirePageRole();\n198\t}\n199\t=== src/server/auth/course-access.ts\n200\timport { prisma } from '@/server/db';\n201\timport { AppError } from '@/server/http';\n202\timport type { AccessUser } from '@/server/auth/student-access';\n203\t\n204\t/**\n205\t * PRD-05 FR-18. `user` is whatever requireRole(...) resolved (NFR-7 stand-in\n206\t * until PRD-01 lands). NOT_FOUND for a missing course, FORBIDDEN otherwise.\n207\t */\n208\t\n209\tasync function loadCourse(courseId: string) {\n210\t  const course = await prisma.course.findUnique({\n211\t    where: { id: courseId },\n212\t    select: { id: true, teacherId: true, coTeacherIds: true },\n213\t  });\n214\t  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n215\t  return course;\n216\t}\n217\t\n218\tfunction teaches(user: AccessUser, course: { teacherId: string; coTeacherIds: string[] }) {\n219\t  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n220\t}\n221\t\n222\tconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n223\t\n224\texport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n225\t  const course = await loadCourse(courseId);\n226\t\n227\t  switch (user.role) {\n228\t    case 'ADMIN':\n229\t      return;\n230\t    case 'TEACHER':\n231\t      if (teaches(user, course)) return;\n232\t      throw forbidden();\n233\t    case 'STUDENT': {\n234\t      const enrollment = await prisma.enrollment.findFirst({\n235\t        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n236\t        select: { id: true },\n237\t      });\n238\t      if (enrollment) return;\n239\t      throw forbidden();\n240\t    }\n241\t    case 'PARENT': {\n242\t      const enrollment = await prisma.enrollment.findFirst({\n243\t        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n244\t        select: { id: true },\n245\t      });\n246\t      if (enrollment) return;\n247\t      throw forbidden();\n248\t    }\n249\t    default:\n250\t      throw forbidden();\n251\t  }\n252\t}\n253\t\n254\t/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\n255\texport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n256\t  const course = await loadCourse(courseId);\n257\t  if (user.role === 'ADMIN') return;\n258\t  if (user.role === 'TEACHER' && teaches(user, course)) return;\n259\t  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');\n260\t}\n261\t=== src/server/auth/student-access.ts\n262\timport { prisma } from '@/server/db';\n263\timport { AppError } from '@/server/http';\n264\timport type { Role } from '@/config/navigation';\n265\t\n266\texport interface AccessUser {\n267\t  id: string;\n268\t  role: Role;\n269\t}\n270\t\n271\texport type AccessibleStudentIds = 'ALL' | string[];\n272\t\n273\t/**\n274\t * FR-17: resolves which student ids `user` may see.\n275\t * - ADMIN: \"ALL\" (every student)\n276\t * - STUDENT: only themselves\n277\t * - PARENT: students linked via ParentStudentLink (component 6)\n278\t * - TEACHER (PRD-05 FR-22): students ACTIVE in courses they teach or\n279\t *   co-teach, plus members of sections they are homeroom teacher of.\n280\t */\n281\texport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n282\t  switch (user.role) {\n283\t    case 'ADMIN':\n284\t      return 'ALL';\n285\t    case 'STUDENT':\n286\t      return [user.id];\n287\t    case 'PARENT': {\n288\t      const links = await prisma.parentStudentLink.findMany({\n289\t        where: { parentId: user.id },\n290\t        select: { studentId: true },\n291\t      });\n292\t      return links.map((link) => link.studentId);\n293\t    }\n294\t    case 'TEACHER': {\n295\t      const [enrolled, members] = await Promise.all([\n296\t        prisma.enrollment.findMany({\n297\t          where: {\n298\t            status: 'ACTIVE',\n299\t            course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] },\n300\t          },\n301\t          select: { studentId: true },\n302\t          distinct: ['studentId'],\n303\t        }),\n304\t        prisma.sectionMember.findMany({\n305\t          where: { section: { homeroomTeacherId: user.id } },\n306\t          select: { studentId: true },\n307\t        }),\n308\t      ]);\n309\t      return [...new Set([...enrolled, ...members].map((row) => row.studentId))];\n310\t    }\n311\t    default:\n312\t      return [];\n313\t  }\n314\t}\n315\t\n316\t/**\n317\t * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n318\t * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n319\t * not allowed to see this particular studentId -- NOT_FOUND rather than\n320\t * FORBIDDEN so existence of another family's student is never revealed.\n321\t * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n322\t * ADMIN; TEACHER is denied students outside their courses/homeroom).\n323\t */\n324\texport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n325\t  const accessible = await getAccessibleStudentIds(user);\n326\t\n327\t  if (accessible === 'ALL') return;\n328\t\n329\t  if (accessible.includes(studentId)) return;\n330\t\n331\t  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n332\t    throw new AppError('NOT_FOUND', 'Resource not found');\n333\t  }\n334\t\n335\t  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n336\t}\n337\t=== src/server/rate-limit.ts\n338\t// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\n339\tconst hits = new Map<string, number[]>();\n340\t\n341\t/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\n342\texport function rateLimit(\n343\t  key: string,\n344\t  limit: number,\n345\t  windowMs: number,\n346\t  now: number = Date.now(),\n347\t): { ok: boolean; retryAfterMs: number } {\n348\t  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n349\t  if (recent.length >= limit) {\n350\t    hits.set(key, recent);\n351\t    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n352\t  }\n353\t  recent.push(now);\n354\t  hits.set(key, recent);\n355\t  return { ok: true, retryAfterMs: 0 };\n356\t}\n357\t\n358\texport function __resetRateLimits(): void {\n359\t  hits.clear();\n360\t}\n361\t=== src/server/audit.ts\n362\timport type { Prisma } from '@prisma/client';\n363\timport { prisma } from '@/server/db';\n364\timport { getClientIp } from '@/server/http';\n365\timport { logger } from '@/lib/logger';\n366\t\n367\texport interface AuditInput {\n368\t  actorId?: string | null;\n369\t  action: string;\n370\t  entityType?: string;\n371\t  entityId?: string;\n372\t  metadata?: Record<string, unknown>;\n373\t  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n374\t  request?: Request;\n375\t}\n376\t\n377\t// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\n378\tconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n379\t\n380\t/**\n381\t * Insert-only audit trail, the single writer of AuditLog rows. Every write\n382\t * endpoint calls this after a successful mutation with action\n383\t * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n384\t * write must not fail the request it's recording, so errors are logged\n385\t * and swallowed.\n386\t */\n387\texport async function audit(input: AuditInput): Promise<void> {\n388\t  try {\n389\t    const metadata = input.metadata\n390\t      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n391\t      : undefined;\n392\t    await prisma.auditLog.create({\n393\t      data: {\n394\t        actorId: input.actorId ?? null,\n395\t        action: input.action,\n396\t        entityType: input.entityType,\n397\t        entityId: input.entityId,\n398\t        metadata: metadata as Prisma.InputJsonValue | undefined,\n399\t        ip: input.request ? getClientIp(input.request) : null,\n400\t      },\n401\t    });\n402\t  } catch (error) {\n403\t    logger.error('Failed to write audit log', {\n404\t      action: input.action,\n405\t      error: error instanceof Error ? error.message : String(error),\n406\t    });\n407\t  }\n408\t}\n409\t=== src/lib/env.ts\n410\timport { z } from 'zod';\n411\t\n412\t/**\n413\t * Fail-fast env validation. Runs once at module load (startup boundary) —\n414\t * anything importing this module gets a readable error naming every\n415\t * missing/invalid variable instead of an undefined-at-runtime surprise.\n416\t */\n417\tconst envSchema = z.object({\n418\t  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n419\t  APP_URL: z.string().min(1, 'APP_URL is required'),\n420\t  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n421\t  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n422\t\n423\t  // Email (PRD-04). EMAIL_TRANSPORT defaults to 'console' so dev/test never\n424\t  // need real SMTP creds; the smtp branch (src/server/email/transport.ts)\n425\t  // only reads SMTP_*/EMAIL_FROM when EMAIL_TRANSPORT='smtp'.\n426\t  EMAIL_TRANSPORT: z.enum(['smtp', 'console']).default('console'),\n427\t  SMTP_HOST: z.string().optional(),\n428\t  SMTP_PORT: z.coerce.number().int().optional(),\n429\t  SMTP_USER: z.string().optional(),\n430\t  SMTP_PASS: z.string().optional(),\n431\t  SMTP_SECURE: z.coerce.boolean().optional(),\n432\t  EMAIL_FROM: z.string().optional(),\n433\t  // Bearer token for POST /api/internal/email/dispatch (NFR-8). Optional so\n434\t  // existing .env files don't break; left unset, the route rejects every\n435\t  // request (fail-safe, not fail-open).\n436\t  CRON_SECRET: z.string().optional(),\n437\t});\n438\t\n439\tfunction loadEnv() {\n440\t  const parsed = envSchema.safeParse(process.env);\n441\t  if (!parsed.success) {\n442\t    const issues = parsed.error.issues\n443\t      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n444\t      .join('\\n');\n445\t    throw new Error(`Invalid environment variables:\\n${issues}`);\n446\t  }\n447\t  return parsed.data;\n448\t}\n449\t\n450\texport const env = loadEnv();\n451\texport type Env = z.infer<typeof envSchema>;\n452\t=== src/lib/logger.ts\n453\ttype LogMeta = Record<string, unknown> | undefined;\n454\ttype Level = 'info' | 'warn' | 'error';\n455\t\n456\tconst isProd = process.env.NODE_ENV === 'production';\n457\t\n458\tfunction write(level: Level, message: string, meta?: LogMeta) {\n459\t  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n460\t\n461\t  if (isProd) {\n462\t    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n463\t    return;\n464\t  }\n465\t\n466\t  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n467\t}\n468\t\n469\texport const logger = {\n470\t  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n471\t  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n472\t  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n473\t};\n474\t=== src/lib/dates.ts\n475\timport { formatInTimeZone } from 'date-fns-tz';\n476\t\n477\t/**\n478\t * Formats a UTC date/ISO-string in the school's configured timezone\n479\t * (SchoolSettings.timezone). pattern is a date-fns format string.\n480\t */\n481\texport function formatInSchoolTz(\n482\t  date: Date | string,\n483\t  pattern: string,\n484\t  timezone: string,\n485\t): string {\n486\t  const value = typeof date === 'string' ? new Date(date) : date;\n487\t  return formatInTimeZone(value, timezone, pattern);\n488\t}\n489\t\n490\t/** ISO weekday (1=Mon … 7=Sun) and 'HH:mm' wall clock in the school timezone. Never the browser's. */\n491\texport function schoolNow(now: Date, tz: string): { isoDay: number; hhmm: string } {\n492\t  return { isoDay: Number(formatInSchoolTz(now, 'i', tz)), hhmm: formatInSchoolTz(now, 'HH:mm', tz) };\n493\t}\n494\t\n495\t/** The period running at hhmm ([start, end)) and the next one to start after hhmm. */\n496\texport function nowAndNext<P extends { startTime: string; endTime: string }>(\n497\t  periods: P[],\n498\t  hhmm: string,\n499\t): { now: P | null; next: P | null } {\n500\t  const sorted = [...periods].sort((a, b) => a.startTime.localeCompare(b.startTime));\n501\t  return {\n502\t    now: sorted.find((p) => p.startTime <= hhmm && hhmm < p.endTime) ?? null,\n503\t    next: sorted.find((p) => p.startTime > hhmm) ?? null,\n504\t  };\n505\t}\n506\t\n507\t/** ISO weekday labels, index 1=Mon … 7=Sun (index 0 unused). */\n508\texport const ISO_DAY_NAMES = ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];\n509\t=== src/config/public-routes.ts\n510\t/**\n511\t * Paths reachable without a session (FR-12). A trailing '/' means prefix\n512\t * match. There is deliberately no sign-up path: accounts are admin-created.\n513\t */\n514\texport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n515\t// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n516\texport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/'];\n517\t\n518\texport function isPublicPath(pathname: string): boolean {\n519\t  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n520\t    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n521\t  );\n522\t}\n523\t=== src/config/course-tabs.ts\n524\timport { ALL_ROLES, type Role } from './navigation';\n525\t\n526\texport interface CourseTab {\n527\t  key: string;\n528\t  label: string;\n529\t  href: (courseId: string) => string;\n530\t  roles: Role[];\n531\t}\n532\t\n533\t/**\n534\t * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n535\t * assignments, gradebook...) register their tab here.\n536\t */\n537\texport const courseTabs: CourseTab[] = [\n538\t  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n539\t  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n540\t  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n541\t];\n542\t=== src/config/student-tabs.ts\n543\timport { ALL_ROLES, type Role } from './navigation';\n544\t\n545\texport interface StudentTab {\n546\t  key: string;\n547\t  label: string;\n548\t  href: (studentId: string) => string;\n549\t  roles: Role[];\n550\t}\n551\t\n552\t/** Extension point for the student detail page; later PRDs register their tab here. */\n553\texport const studentTabs: StudentTab[] = [\n554\t  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n555\t  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\n556\t];\n557\t=== src/config/navigation.ts\n558\timport type { ComponentType } from 'react';\n559\timport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\n560\timport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\n561\timport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\n562\timport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\n563\timport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\n564\timport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\n565\timport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\n566\t\n567\texport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n568\t\n569\texport interface NavItem {\n570\t  label: string;\n571\t  href: string;\n572\t  icon: ComponentType;\n573\t  roles: Role[];\n574\t  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n575\t  group?: string;\n576\t}\n577\t\n578\t// Exported (PRD-04 TASK-3) so route handlers can call\n579\t// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n580\t// requireUser() -- see system-design.md's Component 12.\n581\texport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n582\t\n583\t/**\n584\t * Sidebar source of truth. A later PRD that adds a page adds its entry here\n585\t * instead of hard-coding links in the shell.\n586\t */\n587\texport const navigation: NavItem[] = [\n588\t  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n589\t  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n590\t  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n591\t  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n592\t  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n593\t  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n594\t  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n595\t  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n596\t];\n597\t\n598\texport function navigationForRole(role: Role): NavItem[] {\n599\t  return navigation.filter((item) => item.roles.includes(role));\n600\t}\n601\t=== src/server/notifications/types.ts\n602\t/**\n603\t * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n604\t * imports, so validators and client pages can import it. Later PRDs add keys\n605\t * to NOTIFICATION_TYPES; there is no runtime registration API.\n606\t */\n607\texport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n608\t\n609\tconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n610\t\n611\texport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\n612\texport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n613\t\n614\texport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n615\t  ACCOUNT: 'Account',\n616\t  ACADEMIC: 'Academic',\n617\t  ATTENDANCE: 'Attendance',\n618\t  COMMUNICATION: 'Communication',\n619\t  FINANCE: 'Finance',\n620\t  SYSTEM: 'System',\n621\t};\n622\t\n623\texport type NotificationTypeDef = {\n624\t  label: string;\n625\t  description: string;\n626\t  category: NotificationCategory;\n627\t  defaultEmail: boolean;\n628\t  mandatoryInApp: boolean;\n629\t  roles: readonly Role[];\n630\t  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n631\t  emailOnly?: true;\n632\t};\n633\t\n634\texport const NOTIFICATION_TYPES = {\n635\t  'account.invite': {\n636\t    label: 'Account invitation',\n637\t    description: 'Invitation to set up your SchoolHub account.',\n638\t    category: 'ACCOUNT',\n639\t    defaultEmail: true,\n640\t    mandatoryInApp: false,\n641\t    emailOnly: true,\n642\t    roles: ALL,\n643\t  },\n644\t  'account.password_reset': {\n645\t    label: 'Password reset',\n646\t    description: 'Link to reset your password.',\n647\t    category: 'ACCOUNT',\n648\t    defaultEmail: true,\n649\t    mandatoryInApp: false,\n650\t    emailOnly: true,\n651\t    roles: ALL,\n652\t  },\n653\t  'system.test': {\n654\t    label: 'Test notification',\n655\t    description: 'Test messages sent by an administrator.',\n656\t    category: 'SYSTEM',\n657\t    defaultEmail: true,\n658\t    mandatoryInApp: false,\n659\t    roles: ALL,\n660\t  },\n661\t  // PRD-07 attendance (FR-20, FR-23).\n662\t  'attendance.absent': {\n663\t    label: 'Marked absent',\n664\t    description: 'A student was marked absent from a class or the daily register.',\n665\t    category: 'ATTENDANCE',\n666\t    defaultEmail: true,\n667\t    mandatoryInApp: true,\n668\t    roles: ['PARENT', 'STUDENT'],\n669\t  },\n670\t  'attendance.late': {\n671\t    label: 'Marked late',\n672\t    description: 'A student was marked late.',\n673\t    category: 'ATTENDANCE',\n674\t    defaultEmail: false,\n675\t    mandatoryInApp: false,\n676\t    roles: ['PARENT', 'STUDENT'],\n677\t  },\n678\t  'attendance.corrected': {\n679\t    label: 'Attendance corrected',\n680\t    description: 'An absence was corrected to present.',\n681\t    category: 'ATTENDANCE',\n682\t    defaultEmail: false,\n683\t    mandatoryInApp: false,\n684\t    roles: ['PARENT', 'STUDENT'],\n685\t  },\n686\t  'attendance.register_missing': {\n687\t    label: 'Register not taken',\n688\t    description: 'An administrator reminded you to take a register.',\n689\t    category: 'ATTENDANCE',\n690\t    defaultEmail: false,\n691\t    mandatoryInApp: false,\n692\t    roles: ['TEACHER'],\n693\t  },\n694\t} as const satisfies Record<string, NotificationTypeDef>;\n695\t\n696\texport type NotificationType = keyof typeof NOTIFICATION_TYPES;\n697\t\n698\tconst entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n699\t\n700\texport function getTypeDef(type: string): NotificationTypeDef | undefined {\n701\t  return Object.prototype.hasOwnProperty.call(NOTIFICATION_TYPES, type)\n702\t    ? (NOTIFICATION_TYPES as Record<string, NotificationTypeDef>)[type]\n703\t    : undefined;\n704\t}\n705\t\n706\t/** Types a role may see and configure (FR-28, FR-37): role match, not emailOnly. */\n707\texport function visibleTypesFor(role: Role): NotificationType[] {\n708\t  return entries.filter(([, def]) => def.roles.includes(role) && !def.emailOnly).map(([key]) => key);\n709\t}\n710\t\n711\t/** Type keys in a category, for the FR-34 list filter. */\n712\texport function typesInCategory(category: NotificationCategory): NotificationType[] {\n713\t  return entries.filter(([, def]) => def.category === category).map(([key]) => key);\n714\t}\n715\t\n716\texport function categoryOf(type: string): NotificationCategory | null {\n717\t  return getTypeDef(type)?.category ?? null;\n718\t}\n719\t=== src/server/notifications/notify.ts\n720\timport { prisma } from '@/server/db';\n721\timport { logger } from '@/lib/logger';\n722\timport { BODY_MAX, isSafeRelativeLink, TITLE_MAX } from '@/lib/validators/notifications';\n723\timport { getEmailSchool, renderEmail } from '@/server/email/render';\n724\timport { resolvePrefs } from './preferences';\n725\timport { NOTIFICATION_TYPES, type NotificationType } from './types';\n726\t\n727\texport interface NotifyInput {\n728\t  type: NotificationType;\n729\t  userIds: string[];\n730\t  title: string;\n731\t  body?: string;\n732\t  link?: string;\n733\t  email?: { subject?: string; template: 'generic-notification'; data?: Record<string, unknown> };\n734\t}\n735\t\n736\tfunction truncate(value: string, max: number, field: string, type: string): string {\n737\t  if (value.length <= max) return value;\n738\t  logger.warn('Notification field truncated', { field, type, length: value.length, max });\n739\t  return value.slice(0, max);\n740\t}\n741\t\n742\t/**\n743\t * Single producer entry point (FR-6..11). Writes in-app rows and enqueues\n744\t * emails per resolved preferences. NEVER throws — failures are logged.\n745\t * Call after your transaction commits.\n746\t */\n747\texport async function notify(input: NotifyInput): Promise<void> {\n748\t  try {\n749\t    const def = NOTIFICATION_TYPES[input.type];\n750\t    const userIds = [...new Set(input.userIds)];\n751\t    if (!def || userIds.length === 0) return;\n752\t\n753\t    const title = truncate(input.title, TITLE_MAX, 'title', input.type);\n754\t    const body = input.body == null ? null : truncate(input.body, BODY_MAX, 'body', input.type);\n755\t    let link: string | null = input.link ?? null;\n756\t    if (link !== null && !isSafeRelativeLink(link)) {\n757\t      logger.warn('Notification link dropped (not a safe relative path)', { type: input.type });\n758\t      link = null;\n759\t    }\n760\t\n761\t    const [users, prefRows] = await Promise.all([\n762\t      prisma.user.findMany({\n763\t        where: { id: { in: userIds }, status: { notIn: ['DISABLED', 'ARCHIVED'] }, archivedAt: null },\n764\t        select: { id: true, email: true, firstName: true },\n765\t      }),\n766\t      prisma.notificationPreference.findMany({ where: { userId: { in: userIds }, type: input.type } }),\n767\t    ]);\n768\t    const prefByUser = new Map(prefRows.map((r) => [r.userId, r]));\n769\t\n770\t    const inAppIds: string[] = [];\n771\t    const emailTo: { email: string; firstName: string }[] = [];\n772\t    for (const user of users) {\n773\t      const prefs = resolvePrefs(def, prefByUser.get(user.id));\n774\t      if (prefs.inApp) inAppIds.push(user.id);\n775\t      if (prefs.email && input.email && user.email) emailTo.push(user);\n776\t    }\n777\t\n778\t    if (inAppIds.length) {\n779\t      await prisma.notification.createMany({\n780\t        data: inAppIds.map((userId) => ({ userId, type: input.type, title, body, link })),\n781\t      });\n782\t    }\n783\t\n784\t    if (emailTo.length && input.email) {\n785\t      // Rendered once per call (ADR-6): generic emails carry no per-recipient greeting.\n786\t      const school = await getEmailSchool();\n787\t      const { html, text } = await renderEmail(\n788\t        input.email.template,\n789\t        { title, body, link, ...(input.email.data ?? {}) },\n790\t        school,\n791\t      );\n792\t      const subject = input.email.subject ?? title;\n793\t      await prisma.emailOutbox.createMany({\n794\t        data: emailTo.map((u) => ({ toEmail: u.email, toName: u.firstName, subject, html, text })),\n795\t      });\n796\t    }\n797\t  } catch (error) {\n798\t    logger.error('notify() failed', {\n799\t      type: input.type,\n800\t      message: error instanceof Error ? error.message : String(error),\n801\t    });\n802\t  }\n803\t}\n804\t\n805\t/** Students ∪ their linked parents, deduped (FR-12). Pure. */\n806\texport function expandStudentRecipients(\n807\t  studentIds: string[],\n808\t  links: { studentId: string; parentId: string }[],\n809\t): string[] {\n810\t  const students = new Set(studentIds);\n811\t  const ids = new Set(studentIds);\n812\t  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n813\t  return [...ids];\n814\t}\n815\t\n816\t/** notify() for students and every parent linked to them (FR-12). Never throws. */\n817\texport async function notifyStudentAndParents(\n818\t  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n819\t): Promise<void> {\n820\t  try {\n821\t    const { studentIds, ...rest } = input;\n822\t    const links = await prisma.parentStudentLink.findMany({\n823\t      where: { studentId: { in: studentIds } },\n824\t      select: { studentId: true, parentId: true },\n825\t    });\n826\t    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n827\t  } catch (error) {\n828\t    logger.error('notifyStudentAndParents() failed', {\n829\t      type: input.type,\n830\t      message: error instanceof Error ? error.message : String(error),\n831\t    });\n832\t  }\n833\t}\n834\t=== .env.example\n835\t# Postgres connection string used by Prisma. Matches docker-compose.yml's\n836\t# schoolhub/schoolhub/schoolhub db/user/password on localhost:5432.\n837\tDATABASE_URL=\"postgresql://schoolhub:schoolhub@localhost:5432/schoolhub?schema=public\"\n838\t\n839\t# Public base URL of the app (used for absolute links, e.g. in emails later).\n840\tAPP_URL=\"http://localhost:3000\"\n841\t\n842\t# Secret used to sign auth sessions (wired up by a later PRD). Generate with\n843\t# `openssl rand -base64 32` for real environments.\n844\tAUTH_SECRET=\"dev-secret-change-me\"\n845\t\n846\t# Standard Node environment flag. One of: development | test | production.\n847\tNODE_ENV=\"development\"\n848\t\n849\t# Outbound email (PRD-04). \"console\" (default) logs subject/recipient/text\n850\t# instead of sending — fine for dev/test. Switch to \"smtp\" and fill in the\n851\t# SMTP_* vars below for a real mail server.\n852\tEMAIL_TRANSPORT=\"console\"\n853\tSMTP_HOST=\"\"\n854\tSMTP_PORT=\"587\"\n855\tSMTP_USER=\"\"\n856\tSMTP_PASS=\"\"\n857\tSMTP_SECURE=\"false\"\n858\tEMAIL_FROM=\"SchoolHub <no-reply@schoolhub.test>\"\n859\t\n860\t# Bearer token POST /api/internal/email/dispatch requires in its\n861\t# Authorization header. Generate with `openssl rand -base64 32` for real\n862\t# environments.\n863\tCRON_SECRET=\"dev-secret-change-me\"\n864\t"}]},"parent_tool_use_id":null,"session_id":"34574e28-0591-42df-96fb-64403ec6dad4","uuid":"2a32edd4-eed0-4031-80b7-88fa2a5f3c9a","timestamp":"2026-11-06T21:32:37.276Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/.claude/projects/-Users-ikramaansari-Documents-forge-schoolhub/34574e28-0591-42df-96fb-64403ec6dad4/tool-results/b857db248.txt","content":"=== src/server/http.ts\nimport { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\n// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\nexport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\n/** First x-forwarded-for entry (the client, behind our proxy), or null. */\nexport function getClientIp(request: Request): string | null {\n  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n}\n\nexport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\n=== src/server/auth/requireRole.ts\nimport { cache } from 'react';\nimport { headers } from 'next/headers';\nimport { redirect } from 'next/navigation';\nimport { AppError } from '@/server/http';\nimport { auth } from '@/server/auth/auth';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side authorization (FR-28, FR-29, ADR-2).\n * Route handlers use requireUser/requireRole (throw AppError → 401/403 via\n * withHandler); server pages/layouts use requirePageUser/requirePageRole\n * (redirect to /login or /forbidden).\n */\nexport interface SessionUser {\n  id: string;\n  role: Role;\n  firstName: string;\n  lastName: string;\n  email: string;\n}\n\nexport const getCurrentUser = cache(async (): Promise<SessionUser | null> => {\n  const user = (await auth())?.user;\n  if (!user?.id) return null;\n  return { id: user.id, role: user.role, firstName: user.firstName, lastName: user.lastName, email: user.email };\n});\n\ntype Check = { user: SessionUser } | { error: 'UNAUTHENTICATED' | 'FORBIDDEN' };\n\nasync function resolve(roles: Role[]): Promise<Check> {\n  const user = await getCurrentUser();\n  if (!user) return { error: 'UNAUTHENTICATED' };\n  if (roles.length && !roles.includes(user.role)) return { error: 'FORBIDDEN' };\n  return { user };\n}\n\nexport async function requireRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  throw result.error === 'UNAUTHENTICATED'\n    ? new AppError('UNAUTHENTICATED', 'You must be signed in.')\n    : new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n}\n\nexport async function requireUser(): Promise<SessionUser> {\n  return requireRole();\n}\n\nexport async function requirePageRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  if (result.error === 'FORBIDDEN') redirect('/forbidden');\n  const callbackUrl = headers().get('x-pathname') ?? '/dashboard';\n  redirect(`/login?callbackUrl=${encodeURIComponent(callbackUrl)}`);\n}\n\nexport async function requirePageUser(): Promise<SessionUser> {\n  return requirePageRole();\n}\n=== src/server/auth/course-access.ts\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { AccessUser } from '@/server/auth/student-access';\n\n/**\n * PRD-05 FR-18. `user` is whatever requireRole(...) resolved (NFR-7 stand-in\n * until PRD-01 lands). NOT_FOUND for a missing course, FORBIDDEN otherwise.\n */\n\nasync function loadCourse(courseId: string) {\n  const course = await prisma.course.findUnique({\n    where: { id: courseId },\n    select: { id: true, teacherId: true, coTeacherIds: true },\n  });\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  return course;\n}\n\nfunction teaches(user: AccessUser, course: { teacherId: string; coTeacherIds: string[] }) {\n  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n}\n\nconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n\nexport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n\n  switch (user.role) {\n    case 'ADMIN':\n      return;\n    case 'TEACHER':\n      if (teaches(user, course)) return;\n      throw forbidden();\n    case 'STUDENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    case 'PARENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    default:\n      throw forbidden();\n  }\n}\n\n/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\nexport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER' && teaches(user, course)) return;\n  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');\n}\n=== src/server/auth/student-access.ts\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\nexport interface AccessUser {\n  id: string;\n  role: Role;\n}\n\nexport type AccessibleStudentIds = 'ALL' | string[];\n\n/**\n * FR-17: resolves which student ids `user` may see.\n * - ADMIN: \"ALL\" (every student)\n * - STUDENT: only themselves\n * - PARENT: students linked via ParentStudentLink (component 6)\n * - TEACHER (PRD-05 FR-22): students ACTIVE in courses they teach or\n *   co-teach, plus members of sections they are homeroom teacher of.\n */\nexport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n  switch (user.role) {\n    case 'ADMIN':\n      return 'ALL';\n    case 'STUDENT':\n      return [user.id];\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({\n        where: { parentId: user.id },\n        select: { studentId: true },\n      });\n      return links.map((link) => link.studentId);\n    }\n    case 'TEACHER': {\n      const [enrolled, members] = await Promise.all([\n        prisma.enrollment.findMany({\n          where: {\n            status: 'ACTIVE',\n            course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] },\n          },\n          select: { studentId: true },\n          distinct: ['studentId'],\n        }),\n        prisma.sectionMember.findMany({\n          where: { section: { homeroomTeacherId: user.id } },\n          select: { studentId: true },\n        }),\n      ]);\n      return [...new Set([...enrolled, ...members].map((row) => row.studentId))];\n    }\n    default:\n      return [];\n  }\n}\n\n/**\n * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n * not allowed to see this particular studentId -- NOT_FOUND rather than\n * FORBIDDEN so existence of another family's student is never revealed.\n * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN; TEACHER is denied students outside their courses/homeroom).\n */\nexport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n  const accessible = await getAccessibleStudentIds(user);\n\n  if (accessible === 'ALL') return;\n\n  if (accessible.includes(studentId)) return;\n\n  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n    throw new AppError('NOT_FOUND', 'Resource not found');\n  }\n\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n}\n=== src/server/rate-limit.ts\n// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\nconst hits = new Map<string, number[]>();\n\n/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\nexport function rateLimit(\n  key: string,\n  limit: number,\n  windowMs: number,\n  now: number = Date.now(),\n): { ok: boolean; retryAfterMs: number } {\n  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n  if (recent.length >= limit) {\n    hits.set(key, recent);\n    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n  }\n  recent.push(now);\n  hits.set(key, recent);\n  return { ok: true, retryAfterMs: 0 };\n}\n\nexport function __resetRateLimits(): void {\n  hits.clear();\n}\n=== src/server/audit.ts\nimport type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { getClientIp } from '@/server/http';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n  request?: Request;\n}\n\n// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\nconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    const metadata = input.metadata\n      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n      : undefined;\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: metadata as Prisma.InputJsonValue | undefined,\n        ip: input.request ? getClientIp(input.request) : null,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n=== src/lib/env.ts\nimport { z } from 'zod';\n\n/**\n * Fail-fast env validation. Runs once at module load (startup boundary) —\n * anything importing this module gets a readable error naming every\n * missing/invalid variable instead of an undefined-at-runtime surprise.\n */\nconst envSchema = z.object({\n  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n  APP_URL: z.string().min(1, 'APP_URL is required'),\n  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n\n  // Email (PRD-04). EMAIL_TRANSPORT defaults to 'console' so dev/test never\n  // need real SMTP creds; the smtp branch (src/server/email/transport.ts)\n  // only reads SMTP_*/EMAIL_FROM when EMAIL_TRANSPORT='smtp'.\n  EMAIL_TRANSPORT: z.enum(['smtp', 'console']).default('console'),\n  SMTP_HOST: z.string().optional(),\n  SMTP_PORT: z.coerce.number().int().optional(),\n  SMTP_USER: z.string().optional(),\n  SMTP_PASS: z.string().optional(),\n  SMTP_SECURE: z.coerce.boolean().optional(),\n  EMAIL_FROM: z.string().optional(),\n  // Bearer token for POST /api/internal/email/dispatch (NFR-8). Optional so\n  // existing .env files don't break; left unset, the route rejects every\n  // request (fail-safe, not fail-open).\n  CRON_SECRET: z.string().optional(),\n});\n\nfunction loadEnv() {\n  const parsed = envSchema.safeParse(process.env);\n  if (!parsed.success) {\n    const issues = parsed.error.issues\n      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n      .join('\\n');\n    throw new Error(`Invalid environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\nexport const env = loadEnv();\nexport type Env = z.infer<typeof envSchema>;\n=== src/lib/logger.ts\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};\n=== src/lib/dates.ts\nimport { formatInTimeZone } from 'date-fns-tz';\n\n/**\n * Formats a UTC date/ISO-string in the school's configured timezone\n * (SchoolSettings.timezone). pattern is a date-fns format string.\n */\nexport function formatInSchoolTz(\n  date: Date | string,\n  pattern: string,\n  timezone: string,\n): string {\n  const value = typeof date === 'string' ? new Date(date) : date;\n  return formatInTimeZone(value, timezone, pattern);\n}\n\n/** ISO weekday (1=Mon … 7=Sun) and 'HH:mm' wall clock in the school timezone. Never the browser's. */\nexport function schoolNow(now: Date, tz: string): { isoDay: number; hhmm: string } {\n  return { isoDay: Number(formatInSchoolTz(now, 'i', tz)), hhmm: formatInSchoolTz(now, 'HH:mm', tz) };\n}\n\n/** The period running at hhmm ([start, end)) and the next one to start after hhmm. */\nexport function nowAndNext<P extends { startTime: string; endTime: string }>(\n  periods: P[],\n  hhmm: string,\n): { now: P | null; next: P | null } {\n  const sorted = [...periods].sort((a, b) => a.startTime.localeCompare(b.startTime));\n  return {\n    now: sorted.find((p) => p.startTime <= hhmm && hhmm < p.endTime) ?? null,\n    next: sorted.find((p) => p.startTime > hhmm) ?? null,\n  };\n}\n\n/** ISO weekday labels, index 1=Mon … 7=Sun (index 0 unused). */\nexport const ISO_DAY_NAMES = ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];\n=== src/config/public-routes.ts\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\n=== src/config/course-tabs.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\n=== src/config/student-tabs.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/** Extension point for the student detail page; later PRDs register their tab here. */\nexport const studentTabs: StudentTab[] = [\n  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\n];\n=== src/config/navigation.ts\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\n=== src/server/notifications/types.ts\n/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'system.test': {\n    label: 'Test notification',\n    description: 'Test messages sent by an administrator.',\n    category: 'SYSTEM',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  // PRD-07 attendance (FR-20, FR-23).\n  'attendance.absent': {\n    label: 'Marked absent',\n    description: 'A student was marked absent from a class or the daily register.',\n    category: 'ATTENDANCE',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.late': {\n    label: 'Marked late',\n    description: 'A student was marked late.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.corrected': {\n    label: 'Attendance corrected',\n    description: 'An absence was corrected to present.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.register_missing': {\n    label: 'Register not taken',\n    description: 'An administrator reminded you to take a register.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['TEACHER'],\n  },\n} as const satisfies Record<string, NotificationTypeDef>;\n\nexport type NotificationType = keyof typeof NOTIFICATION_TYPES;\n\nconst entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n\nexport function getTypeDef(type: string): NotificationTypeDef | undefined {\n  return Object.prototype.hasOwnProperty.call(NOTIFICATION_TYPES, type)\n    ? (NOTIFICATION_TYPES as Record<string, NotificationTypeDef>)[type]\n    : undefined;\n}\n\n/** Types a role may see and configure (FR-28, FR-37): role match, not emailOnly. */\nexport function visibleTypesFor(role: Role): NotificationType[] {\n  return entries.filter(([, def]) => def.roles.includes(role) && !def.emailOnly).map(([key]) => key);\n}\n\n/** Type keys in a category, for the FR-34 list filter. */\nexport function typesInCategory(category: NotificationCategory): NotificationType[] {\n  return entries.filter(([, def]) => def.category === category).map(([key]) => key);\n}\n\nexport function categoryOf(type: string): NotificationCategory | null {\n  return getTypeDef(type)?.category ?? null;\n}\n=== src/server/notifications/notify.ts\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { BODY_MAX, isSafeRelativeLink, TITLE_MAX } from '@/lib/validators/notifications';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\nimport { resolvePrefs } from './preferences';\nimport { NOTIFICATION_TYPES, type NotificationType } from './types';\n\nexport interface NotifyInput {\n  type: NotificationType;\n  userIds: string[];\n  title: string;\n  body?: string;\n  link?: string;\n  email?: { subject?: string; template: 'generic-notification'; data?: Record<string, unknown> };\n}\n\nfunction truncate(value: string, max: number, field: string, type: string): string {\n  if (value.length <= max) return value;\n  logger.warn('Notification field truncated', { field, type, length: value.length, max });\n  return value.slice(0, max);\n}\n\n/**\n * Single producer entry point (FR-6..11). Writes in-app rows and enqueues\n * emails per resolved preferences. NEVER throws — failures are logged.\n * Call after your transaction commits.\n */\nexport async function notify(input: NotifyInput): Promise<void> {\n  try {\n    const def = NOTIFICATION_TYPES[input.type];\n    const userIds = [...new Set(input.userIds)];\n    if (!def || userIds.length === 0) return;\n\n    const title = truncate(input.title, TITLE_MAX, 'title', input.type);\n    const body = input.body == null ? null : truncate(input.body, BODY_MAX, 'body', input.type);\n    let link: string | null = input.link ?? null;\n    if (link !== null && !isSafeRelativeLink(link)) {\n      logger.warn('Notification link dropped (not a safe relative path)', { type: input.type });\n      link = null;\n    }\n\n    const [users, prefRows] = await Promise.all([\n      prisma.user.findMany({\n        where: { id: { in: userIds }, status: { notIn: ['DISABLED', 'ARCHIVED'] }, archivedAt: null },\n        select: { id: true, email: true, firstName: true },\n      }),\n      prisma.notificationPreference.findMany({ where: { userId: { in: userIds }, type: input.type } }),\n    ]);\n    const prefByUser = new Map(prefRows.map((r) => [r.userId, r]));\n\n    const inAppIds: string[] = [];\n    const emailTo: { email: string; firstName: string }[] = [];\n    for (const user of users) {\n      const prefs = resolvePrefs(def, prefByUser.get(user.id));\n      if (prefs.inApp) inAppIds.push(user.id);\n      if (prefs.email && input.email && user.email) emailTo.push(user);\n    }\n\n    if (inAppIds.length) {\n      await prisma.notification.createMany({\n        data: inAppIds.map((userId) => ({ userId, type: input.type, title, body, link })),\n      });\n    }\n\n    if (emailTo.length && input.email) {\n      // Rendered once per call (ADR-6): generic emails carry no per-recipient greeting.\n      const school = await getEmailSchool();\n      const { html, text } = await renderEmail(\n        input.email.template,\n        { title, body, link, ...(input.email.data ?? {}) },\n        school,\n      );\n      const subject = input.email.subject ?? title;\n      await prisma.emailOutbox.createMany({\n        data: emailTo.map((u) => ({ toEmail: u.email, toName: u.firstName, subject, html, text })),\n      });\n    }\n  } catch (error) {\n    logger.error('notify() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n=== .env.example\n# Postgres connection string used by Prisma. Matches docker-compose.yml's\n# schoolhub/schoolhub/schoolhub db/user/password on localhost:5432.\nDATABASE_URL=\"postgresql://schoolhub:schoolhub@localhost:5432/schoolhub?schema=public\"\n\n# Public base URL of the app (used for absolute links, e.g. in emails later).\nAPP_URL=\"http://localhost:3000\"\n\n# Secret used to sign auth sessions (wired up by a later PRD). Generate with\n# `openssl rand -base64 32` for real environments.\nAUTH_SECRET=\"dev-secret-change-me\"\n\n# Standard Node environment flag. One of: development | test | production.\nNODE_ENV=\"development\"\n\n# Outbound email (PRD-04). \"console\" (default) logs subject/recipient/text\n# instead of sending — fine for dev/test. Switch to \"smtp\" and fill in the\n# SMTP_* vars below for a real mail server.\nEMAIL_TRANSPORT=\"console\"\nSMTP_HOST=\"\"\nSMTP_PORT=\"587\"\nSMTP_USER=\"\"\nSMTP_PASS=\"\"\nSMTP_SECURE=\"false\"\nEMAIL_FROM=\"SchoolHub <no-reply@schoolhub.test>\"\n\n# Bearer token POST /api/internal/email/dispatch requires in its\n# Authorization header. Generate with `openssl rand -base64 32` for real\n# environments.\nCRON_SECRET=\"dev-secret-change-me\"\n","numLines":864,"startLine":1,"totalLines":864}},"tool_result_meta":[{"id":"toolu_01CKjEbsbBQMCKHcGjf5gHNp","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
