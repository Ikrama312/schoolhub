{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0194J7fiRUwxCnwNpDu6qbjf","type":"tool_result","content":"'use client';\n\nimport Link from 'next/link';\nimport { usePathname } from 'next/navigation';\nimport Tab from '@mui/material/Tab';\nimport Tabs from '@mui/material/Tabs';\nimport { courseTabs } from '@/config/course-tabs';\nimport type { Role } from '@/config/navigation';\n\nexport function CourseTabs({ courseId, role }: { courseId: string; role: Role }) {\n  const pathname = usePathname();\n  const tabs = courseTabs.filter((t) => t.roles.includes(role));\n  // Longest matching href wins so /courses/x/roster doesn't also match Overview.\n  const active = tabs\n    .filter((t) => pathname === t.href(courseId) || pathname.startsWith(`${t.href(courseId)}/`))\n    .sort((a, b) => b.href(courseId).length - a.href(courseId).length)[0];\n\n  return (\n    <Tabs value={active?.key ?? false} variant=\"scrollable\" scrollButtons=\"auto\" sx={{ mb: 3 }} aria-label=\"Course sections\">\n      {tabs.map((t) => (\n        <Tab key={t.key} value={t.key} label={t.label} component={Link} href={t.href(courseId)} />\n      ))}\n    </Tabs>\n  );\n}\nsrc/app/(app)/courses/[courseId]/attendance:\nCourseAttendanceMatrix.tsx\npage.tsx\n\nsrc/app/(app)/students/[id]:\nattendance\ncourses\n\nsrc/app/(app)/students/[id]/attendance:\npage.tsx\nStudentAttendanceClient.tsx\n\nsrc/app/(app)/students/[id]/courses:\npage.tsx\nimport { notFound, redirect } from 'next/navigation';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getCourseMatrix } from '@/server/attendance/attendance-service';\nimport { CourseAttendanceMatrix } from './CourseAttendanceMatrix';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course \"Attendance\" tab — FR-29. TEACHER/ADMIN; assertCanManageCourse inside the service. */\nexport default async function CourseAttendancePage({ params }: { params: { courseId: string } }) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  let matrix: Awaited<ReturnType<typeof getCourseMatrix>>;\n  try {\n    matrix = await getCourseMatrix(user, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  return <CourseAttendanceMatrix courseId={params.courseId} matrix={matrix} />;\n}\n'use client';\n\nimport { useState } from 'react';\nimport Dialog from '@mui/material/Dialog';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogContentText from '@mui/material/DialogContentText';\nimport DialogActions from '@mui/material/DialogActions';\nimport Button from '@mui/material/Button';\nimport CircularProgress from '@mui/material/CircularProgress';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  title: string;\n  description?: string;\n  destructive?: boolean;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  onConfirm: () => void | Promise<void>;\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}: ConfirmDialogProps) {\n  const [pending, setPending] = useState(false);\n\n  const handleConfirm = async () => {\n    setPending(true);\n    try {\n      await onConfirm();\n    } finally {\n      setPending(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n      {description && (\n        <DialogContent>\n          <DialogContentText>{description}</DialogContentText>\n        </DialogContent>\n      )}\n      <DialogActions>\n        <Button onClick={onCancel} disabled={pending}>\n          {cancelLabel}\n        </Button>\n        <Button\n          onClick={handleConfirm}\n          color={destructive ? 'error' : 'primary'}\n          variant=\"contained\"\n          disabled={pending}\n          startIcon={pending ? <CircularProgress size={16} color=\"inherit\" /> : undefined}\n        >\n          {confirmLabel}\n        </Button>\n      </DialogActions>\n    </Dialog>\n  );\n}\n'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport TextField from '@mui/material/TextField';\nimport InputAdornment from '@mui/material/InputAdornment';\nimport SearchIcon from '@mui/icons-material/Search';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface DataTableProps {\n  columns: GridColDef[];\n  rows: readonly Record<string, unknown>[];\n  total: number;\n  loading?: boolean;\n  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n  getRowId?: (row: Record<string, unknown>) => string | number;\n}\n\n/**\n * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n * from (and written to) URL query params, a debounced search box, and the\n * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n * params change — this component owns no fetch logic of its own.\n */\nexport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const sortField = searchParams.get('sort') ?? undefined;\n  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n\n  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n\n  const updateParams = useCallback(\n    (updates: Record<string, string | undefined>) => {\n      const next = new URLSearchParams(searchParams.toString());\n      for (const [key, value] of Object.entries(updates)) {\n        if (value === undefined || value === '') {\n          next.delete(key);\n        } else {\n          next.set(key, value);\n        }\n      }\n      router.push(`${pathname}?${next.toString()}`);\n    },\n    [pathname, router, searchParams],\n  );\n\n  // Debounce search -> URL param, resetting to page 1.\n  useEffect(() => {\n    const handle = setTimeout(() => {\n      if (searchInput !== (searchParams.get('q') ?? '')) {\n        updateParams({ q: searchInput || undefined, page: '1' });\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [searchInput]);\n\n  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n\n  return (\n    <Box>\n      <TextField\n        value={searchInput}\n        onChange={(event) => setSearchInput(event.target.value)}\n        placeholder=\"Search…\"\n        size=\"small\"\n        sx={{ mb: 2, maxWidth: 320 }}\n        slotProps={{\n          input: {\n            startAdornment: (\n              <InputAdornment position=\"start\">\n                <SearchIcon fontSize=\"small\" />\n              </InputAdornment>\n            ),\n          },\n          htmlInput: { 'aria-label': 'Search' },\n        }}\n      />\n      <DataGrid\n        autoHeight\n        columns={columns}\n        rows={rows}\n        rowCount={total}\n        loading={loading}\n        getRowId={getRowId}\n        paginationMode=\"server\"\n        sortingMode=\"server\"\n        paginationModel={{ page: page - 1, pageSize }}\n        onPaginationModelChange={(model) =>\n          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n        }\n        sortModel={sortModel}\n        onSortModelChange={(model) =>\n          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n        }\n        pageSizeOptions={[10, 20, 50, 100]}\n        slots={{\n          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n        }}\n        disableRowSelectionOnClick\n      />\n    </Box>\n  );\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      spacing={1.5}\n      sx={{ alignItems: 'center', justifyContent: 'center', py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface DateDisplayProps {\n  date: Date | string;\n  pattern?: string;\n  timezone: string;\n}\n\nconst DEFAULT_PATTERN = 'MMM d, yyyy h:mm a';\n\n/** Renders a UTC date formatted in the school's timezone. */\nexport function DateDisplay({ date, pattern = DEFAULT_PATTERN, timezone }: DateDisplayProps) {\n  return <span>{formatInSchoolTz(date, pattern, timezone)}</span>;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"80a968fd-48d7-4da9-a01e-aaa2035d3ca9","uuid":"a92b9c35-a1ba-43a3-9e3e-546e0d115616","timestamp":"2026-11-09T05:36:13.789Z","tool_use_result":{"stdout":"'use client';\n\nimport Link from 'next/link';\nimport { usePathname } from 'next/navigation';\nimport Tab from '@mui/material/Tab';\nimport Tabs from '@mui/material/Tabs';\nimport { courseTabs } from '@/config/course-tabs';\nimport type { Role } from '@/config/navigation';\n\nexport function CourseTabs({ courseId, role }: { courseId: string; role: Role }) {\n  const pathname = usePathname();\n  const tabs = courseTabs.filter((t) => t.roles.includes(role));\n  // Longest matching href wins so /courses/x/roster doesn't also match Overview.\n  const active = tabs\n    .filter((t) => pathname === t.href(courseId) || pathname.startsWith(`${t.href(courseId)}/`))\n    .sort((a, b) => b.href(courseId).length - a.href(courseId).length)[0];\n\n  return (\n    <Tabs value={active?.key ?? false} variant=\"scrollable\" scrollButtons=\"auto\" sx={{ mb: 3 }} aria-label=\"Course sections\">\n      {tabs.map((t) => (\n        <Tab key={t.key} value={t.key} label={t.label} component={Link} href={t.href(courseId)} />\n      ))}\n    </Tabs>\n  );\n}\nsrc/app/(app)/courses/[courseId]/attendance:\nCourseAttendanceMatrix.tsx\npage.tsx\n\nsrc/app/(app)/students/[id]:\nattendance\ncourses\n\nsrc/app/(app)/students/[id]/attendance:\npage.tsx\nStudentAttendanceClient.tsx\n\nsrc/app/(app)/students/[id]/courses:\npage.tsx\nimport { notFound, redirect } from 'next/navigation';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getCourseMatrix } from '@/server/attendance/attendance-service';\nimport { CourseAttendanceMatrix } from './CourseAttendanceMatrix';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course \"Attendance\" tab — FR-29. TEACHER/ADMIN; assertCanManageCourse inside the service. */\nexport default async function CourseAttendancePage({ params }: { params: { courseId: string } }) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  let matrix: Awaited<ReturnType<typeof getCourseMatrix>>;\n  try {\n    matrix = await getCourseMatrix(user, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  return <CourseAttendanceMatrix courseId={params.courseId} matrix={matrix} />;\n}\n'use client';\n\nimport { useState } from 'react';\nimport Dialog from '@mui/material/Dialog';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogContentText from '@mui/material/DialogContentText';\nimport DialogActions from '@mui/material/DialogActions';\nimport Button from '@mui/material/Button';\nimport CircularProgress from '@mui/material/CircularProgress';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  title: string;\n  description?: string;\n  destructive?: boolean;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  onConfirm: () => void | Promise<void>;\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}: ConfirmDialogProps) {\n  const [pending, setPending] = useState(false);\n\n  const handleConfirm = async () => {\n    setPending(true);\n    try {\n      await onConfirm();\n    } finally {\n      setPending(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n      {description && (\n        <DialogContent>\n          <DialogContentText>{description}</DialogContentText>\n        </DialogContent>\n      )}\n      <DialogActions>\n        <Button onClick={onCancel} disabled={pending}>\n          {cancelLabel}\n        </Button>\n        <Button\n          onClick={handleConfirm}\n          color={destructive ? 'error' : 'primary'}\n          variant=\"contained\"\n          disabled={pending}\n          startIcon={pending ? <CircularProgress size={16} color=\"inherit\" /> : undefined}\n        >\n          {confirmLabel}\n        </Button>\n      </DialogActions>\n    </Dialog>\n  );\n}\n'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport TextField from '@mui/material/TextField';\nimport InputAdornment from '@mui/material/InputAdornment';\nimport SearchIcon from '@mui/icons-material/Search';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface DataTableProps {\n  columns: GridColDef[];\n  rows: readonly Record<string, unknown>[];\n  total: number;\n  loading?: boolean;\n  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n  getRowId?: (row: Record<string, unknown>) => string | number;\n}\n\n/**\n * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n * from (and written to) URL query params, a debounced search box, and the\n * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n * params change — this component owns no fetch logic of its own.\n */\nexport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const sortField = searchParams.get('sort') ?? undefined;\n  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n\n  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n\n  const updateParams = useCallback(\n    (updates: Record<string, string | undefined>) => {\n      const next = new URLSearchParams(searchParams.toString());\n      for (const [key, value] of Object.entries(updates)) {\n        if (value === undefined || value === '') {\n          next.delete(key);\n        } else {\n          next.set(key, value);\n        }\n      }\n      router.push(`${pathname}?${next.toString()}`);\n    },\n    [pathname, router, searchParams],\n  );\n\n  // Debounce search -> URL param, resetting to page 1.\n  useEffect(() => {\n    const handle = setTimeout(() => {\n      if (searchInput !== (searchParams.get('q') ?? '')) {\n        updateParams({ q: searchInput || undefined, page: '1' });\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [searchInput]);\n\n  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n\n  return (\n    <Box>\n      <TextField\n        value={searchInput}\n        onChange={(event) => setSearchInput(event.target.value)}\n        placeholder=\"Search…\"\n        size=\"small\"\n        sx={{ mb: 2, maxWidth: 320 }}\n        slotProps={{\n          input: {\n            startAdornment: (\n              <InputAdornment position=\"start\">\n                <SearchIcon fontSize=\"small\" />\n              </InputAdornment>\n            ),\n          },\n          htmlInput: { 'aria-label': 'Search' },\n        }}\n      />\n      <DataGrid\n        autoHeight\n        columns={columns}\n        rows={rows}\n        rowCount={total}\n        loading={loading}\n        getRowId={getRowId}\n        paginationMode=\"server\"\n        sortingMode=\"server\"\n        paginationModel={{ page: page - 1, pageSize }}\n        onPaginationModelChange={(model) =>\n          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n        }\n        sortModel={sortModel}\n        onSortModelChange={(model) =>\n          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n        }\n        pageSizeOptions={[10, 20, 50, 100]}\n        slots={{\n          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n        }}\n        disableRowSelectionOnClick\n      />\n    </Box>\n  );\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      spacing={1.5}\n      sx={{ alignItems: 'center', justifyContent: 'center', py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface DateDisplayProps {\n  date: Date | string;\n  pattern?: string;\n  timezone: string;\n}\n\nconst DEFAULT_PATTERN = 'MMM d, yyyy h:mm a';\n\n/** Renders a UTC date formatted in the school's timezone. */\nexport function DateDisplay({ date, pattern = DEFAULT_PATTERN, timezone }: DateDisplayProps) {\n  return <span>{formatInSchoolTz(date, pattern, timezone)}</span>;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0194J7fiRUwxCnwNpDu6qbjf","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
