a(email = '') {\n  return z\n    .object({\n      currentPassword: z.string().min(1, 'Enter your current password'),\n      newPassword: z.string(),\n      confirm: z.string(),\n    })\n    .superRefine(refineNewPassword('newPassword', email));\n}\n\nexport const changePasswordSchema = changePasswordFormSchema();\n\nexport type SignInInput = z.infer<typeof signInSchema>;\nexport type AcceptInviteInput = z.infer<typeof acceptInviteSchema>;\nexport type ResetPasswordInput = z.infer<typeof resetPasswordSchema>;\nexport type ChangePasswordInput = z.infer<typeof changePasswordSchema>;\nexport type SetPasswordValues = z.infer<ReturnType<typeof setPasswordSchema>>;\n","structuredPatch":[{"oldStart":3,"oldLines":7,"newStart":3,"newLines":8,"lines":[" /**","  * Client-safe auth validators (FR-2, FR-8, FR-17). No fs / server imports:","  * the login/invite/reset/security forms import this directly. The","- * common-password rule lives server-side in src/server/auth/password-policy.ts.","+ * common-password rule and the real \"not your email\" check run server-side","+ * in src/server/auth/password-policy.ts (the API body doesn't carry the email).","  */"," "," export const emailField = z.string().trim().toLowerCase().email('Enter a valid email address');"]},{"oldStart":15,"oldLines":11,"newStart":16,"newLines":11,"lines":["   notEmail: boolean;"," }"," ","-export const PASSWORD_RULE_LABELS: Record<keyof PasswordCheckResult, string> = {","-  length: '10 to 128 characters',","-  letter: 'At least one letter',","-  digit: 'At least one number',","-  notEmail: 'Not the same as your email',","+export const PASSWORD_RULES: Record<keyof PasswordCheckResult, { label: string; error: string }> = {","+  length: { label: '10 to 128 characters', error: 'Password must be 10 to 128 characters.' },","+  letter: { label: 'At least one letter', error: 'Password must contain at least one letter.' },","+  digit: { label: 'At least one number', error: 'Password must contain at least one number.' 