{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgrwQqbSSWCnZxWczoneN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LDi2Vbwb6Xc1tkQj3cK3yR","name":"Read","input":{"file_path":"/Users/ikramaansari/.claude/projects/-Users-ikramaansari-Documents-forge-schoolhub/3eb50254-5396-4c9e-84e7-da065a5fc108/tool-results/bmujzz0gp.txt"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1026,"cache_read_input_tokens":55898,"cache_creation":{"ephemeral_5m_input_tokens":1026,"ephemeral_1h_input_tokens":0},"output_tokens":42,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3eb50254-5396-4c9e-84e7-da065a5fc108","uuid":"cac06b2c-e98f-4d6a-bc1a-90296ab0e5d7","timestamp":"2026-11-09T07:12:34.017Z","request_id":"req_011CgrwQqPHijnKsnhQVyvTp","wire_tool_inputs":{"toolu_01LDi2Vbwb6Xc1tkQj3cK3yR":{"file_path":"/Users/ikramaansari/.claude/projects/-Users-ikramaansari-Documents-forge-schoolhub/3eb50254-5396-4c9e-84e7-da065a5fc108/tool-results/bmujzz0gp.txt"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LDi2Vbwb6Xc1tkQj3cK3yR","type":"tool_result","content":"1\t{\n2\t  \"ticketId\": \"SH-10\",\n3\t  \"timestamp\": \"2026-11-09T13:00:00Z\",\n4\t  \"phase\": \"architect\",\n5\t  \"version\": \"1.0\",\n6\t\n7\t  \"conventions\": {\n8\t    \"basePath\": \"/api. This is the existing project convention; there is no /api/v1 prefix (system-design §3.3).\",\n9\t    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/quiz.ts) → one call into src/server/quiz/*-service.ts → ok()/paginated(). All of these come from src/server/http.ts. Handlers contain no logic (NFR-6, NFR-7).\",\n10\t    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n11\t    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int ≥ 1, default 1\", \"pageSize\": \"int 1–100, default 20 (parsePagination)\", \"total\": \"int\" } },\n12\t    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n13\t    \"errorCodes\": {\n14\t      \"VALIDATION_ERROR\": \"400. Zod failure (details = zod flatten()) or a service rule failure such as canPublish problems, points > question points, or step ≠ 0.5.\",\n15\t      \"UNAUTHENTICATED\": \"401. No session, or a bad cron secret on the internal route.\",\n16\t      \"NOT_FOUND\": \"404. The resource is missing OR the caller cannot access it. Existence is never revealed, so FORBIDDEN is not used for quiz resources (NFR-5).\",\n17\t      \"CONFLICT\": \"409. Answer write after deadlineAt + 30 s, a closed or not-yet-open quiz, attempt limit reached, edit lock (quiz has attempts), delete with attempts, an invalid status transition, or a write to a non-IN_PROGRESS attempt.\",\n18\t      \"INTERNAL\": \"500. Logged with logger.error and never detailed to the client.\"\n19\t    },\n20\t    \"createdStatus\": \"POST endpoints that create a resource return 201 via ok(x, {status: 201}). Every other success returns 200.\",\n21\t    \"decimals\": \"points, score, maxScore, pointsAwarded, totalPoints and the analytics averages are serialized as strings with 2 decimals by fixed2 from @/server/assignments/grading-math (e.g. \\\"2.00\\\"). Input decimals accept number | string. Percentages are numbers rounded to 1 decimal.\",\n22\t    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client time (ADR-4). The UI displays times in SchoolSettings.timezone (NFR-6).\",\n23\t    \"ids\": \"cuid strings. Option ids inside Question.options are short cuids generated by the builder and stay stable across edits.\",\n24\t    \"studentPrivacy\": \"Every quiz, attempt or result returned to a STUDENT or PARENT is built only by the allow-listing serializers in src/server/quiz/serializers.ts (toStudentQuiz, toStudentAttempt, toStudentResult). `correct` and `explanation` appear only inside StudentResult.questions[] and only when resultsVisible && showCorrectAnswers. Scores appear only when resultsVisible. Student-path Prisma selects never load `correct` or `explanation` (NFR-1, ADR-5).\",\n25\t    \"lazyAutoSubmit\": \"GET /api/attempts/:id, POST /api/quizzes/:id/attempts, the course list and the teacher grade/list loads call ensureNotExpired first. So an IN_PROGRESS attempt past deadlineAt is always returned already submitted (FR-18).\",\n26\t    \"noEndpointByDesign\": [\n27\t      \"getStudentQuizScore(quizId, studentId) → {score, maxScore, percent, isPractice, attemptsCounted} | null is a TypeScript export of attempt-service.ts for PRD-11. It has no HTTP route (FR-22, FR-33, system-design §4.7).\",\n28\t      \"The grading workspace, the analytics page and the builder's accommodations table are server pages. They call the services directly, after requirePageRole and assertCanManageCourse. Only their writes go through the routes below (system-design §3.4).\",\n29\t      \"Preview mode (FR-8) calls no attempt endpoint (A10).\"\n30\t    ],\n31\t    \"requirementIds\": [\"FR-31\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\", \"NFR-7\"]\n32\t  },\n33\t\n34\t  \"sharedSchemas\": {\n35\t    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^\\\\d+\\\\.\\\\d{2}$\", \"description\": \"Output form. Input form is number | string.\" },\n36\t    \"QuizStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"PUBLISHED\", \"CLOSED\"] },\n37\t    \"QuestionType\": { \"type\": \"string\", \"enum\": [\"SINGLE_CHOICE\", \"MULTIPLE_CHOICE\", \"TRUE_FALSE\", \"SHORT_ANSWER\", \"ESSAY\"] },\n38\t    \"ResultsVisibility\": { \"type\": \"string\", \"enum\": [\"IMMEDIATELY\", \"AFTER_CLOSE\", \"MANUAL\"] },\n39\t    \"AttemptStatus\": { \"type\": \"string\", \"enum\": [\"IN_PROGRESS\", \"SUBMITTED\", \"NEEDS_GRADING\", \"GRADED\"] },\n40\t    \"ScoringPolicy\": { \"type\": \"string\", \"enum\": [\"HIGHEST\", \"LATEST\", \"AVERAGE\"] },\n41\t    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"name\": \"string\" } },\n42\t    \"Option\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"text\": \"string (non-empty)\" } },\n43\t    \"Correct\": {\n44\t      \"description\": \"Keyed by Question.type (FR-2). Manager-only, except as described in conventions.studentPrivacy.\",\n45\t      \"oneOf\": {\n46\t        \"SINGLE_CHOICE\": { \"optionId\": \"string (must be one of options[].id)\" },\n47\t        \"MULTIPLE_CHOICE\": { \"optionIds\": \"string[] (≥ 1, each in options[].id)\" },\n48\t        \"TRUE_FALSE\": { \"value\": \"boolean\" },\n49\t        \"SHORT_ANSWER\": { \"accepted\": \"string[] (1–10, non-empty)\" },\n50\t        \"ESSAY\": { \"guidance\": \"string?\" }\n51\t      }\n52\t    },\n53\t    \"AnswerResponse\": {\n54\t      \"description\": \"answerResponseSchema. A type-agnostic union, so the autosave path doesn't load the Question (NFR-2). A shape that doesn't match the question's type grades as 0 / incorrect at submit.\",\n55\t      \"oneOf\": [\n56\t        { \"optionId\": \"string\" },\n57\t        { \"optionIds\": \"string[]\" },\n58\t        { \"value\": \"boolean\" },\n59\t        { \"text\": \"string (≤ 10,000 chars)\" }\n60\t      ]\n61\t    },\n62\t    \"QuizSettingsInput\": {\n63\t      \"description\": \"quizSettingsSchema (FR-2, FR-6). Cross-field rules run in superRefine: availableUntil > availableFrom, and timeLimitMinutes ≤ the window length in minutes. On PATCH, both rules are checked against the stored values merged with the patch.\",\n64\t      \"properties\": {\n65\t        \"title\": \"string (trimmed, non-empty)\",\n66\t        \"instructions\": \"string (Markdown, default \\\"\\\")\",\n67\t        \"isPractice\": \"boolean (default false)\",\n68\t        \"availableFrom\": \"ISO datetime\",\n69\t        \"availableUntil\": \"ISO datetime\",\n70\t        \"timeLimitMinutes\": \"int 1–300 | null (null = untimed)\",\n71\t        \"maxAttempts\": \"int 1–10 (default 1)\",\n72\t        \"scoringPolicy\": \"ScoringPolicy (default HIGHEST)\",\n73\t        \"shuffleQuestions\": \"boolean (default false)\",\n74\t        \"shuffleOptions\": \"boolean (default false)\",\n75\t        \"oneQuestionPerPage\": \"boolean (default false)\",\n76\t        \"resultsVisibility\": \"ResultsVisibility (default AFTER_CLOSE)\",\n77\t        \"showCorrectAnswers\": \"boolean (default true)\"\n78\t      }\n79\t    },\n80\t    \"QuestionInput\": {\n81\t      \"description\": \"questionSchema, a z.discriminatedUnion on type (FR-2, FR-7). points 0.5–100 in steps of 0.5. options has 2–8 entries for SINGLE_CHOICE/MULTIPLE_CHOICE and is absent for the other types. prompt is non-empty Markdown and may embed a file uploaded with context 'quiz' (FR-39).\",\n82\t      \"properties\": {\n83\t        \"type\": \"QuestionType\",\n84\t        \"prompt\": \"string (Markdown)\",\n85\t        \"points\": \"number | string\",\n86\t        \"options\": \"Option[] | undefined\",\n87\t        \"correct\": \"Correct (shape keyed by type)\",\n88\t        \"explanation\": \"string | null\",\n89\t        \"caseSensitive\": \"boolean (SHORT_ANSWER only, default false)\"\n90\t      }\n91\t    },\n92\t    \"ManagerQuestion\": {\n93\t      \"properties\": {\n94\t        \"id\": \"string\", \"quizId\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\",\n95\t        \"order\": \"int\", \"options\": \"Option[] | null\", \"correct\": \"Correct\", \"explanation\": \"string | null\", \"caseSensitive\": \"boolean\"\n96\t      }\n97\t    },\n98\t    \"ManagerQuiz\": {\n99\t      \"description\": \"Full quiz, including answers. Returned only to managers (assertCanManageCourse).\",\n100\t      \"properties\": {\n101\t        \"id\": \"string\", \"courseId\": \"string\",\n102\t        \"...\": \"every QuizSettingsInput field, resolved\",\n103\t        \"status\": \"QuizStatus\",\n104\t        \"resultsReleasedAt\": \"ISO datetime | null\",\n105\t        \"createdById\": \"string\", \"createdAt\": \"ISO datetime\", \"updatedAt\": \"ISO datetime\",\n106\t        \"questions\": \"ManagerQuestion[] (sorted by order)\",\n107\t        \"totalPoints\": \"Decimal (Σ points, FR-8)\",\n108\t        \"attemptCount\": \"int\",\n109\t        \"locked\": \"boolean (attemptCount > 0, edit lock FR-10)\",\n110\t        \"publishProblems\": \"string[] (canPublish(questions); empty means publishable, FR-9)\"\n111\t      }\n112\t    },\n113\t    \"StudentQuiz\": {\n114\t      \"description\": \"toStudentQuiz. Allow-listed, with no questions and no `correct` (NFR-1). Drives the start screen (FR-12).\",\n115\t      \"properties\": {\n116\t        \"id\": \"string\", \"courseId\": \"string\", \"title\": \"string\", \"instructions\": \"string\", \"isPractice\": \"boolean\",\n117\t        \"status\": \"QuizStatus (DRAFT is never returned to a non-manager; that case is NOT_FOUND)\",\n118\t        \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\",\n119\t        \"timeLimitMinutes\": \"int | null\", \"oneQuestionPerPage\": \"boolean\", \"resultsVisibility\": \"ResultsVisibility\",\n120\t        \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n121\t        \"extraTimeMinutes\": \"int (caller's accommodation, 0 if none; 0 for parents)\",\n122\t        \"attemptLimit\": \"int (attemptLimit(maxAttempts, extraAttempts), FR-23)\",\n123\t        \"attemptsUsed\": \"int (caller's own attempts; 0 for parents)\",\n124\t        \"inProgressAttemptId\": \"string | null (Resume target, FR-19)\",\n125\t        \"isOpen\": \"boolean (PUBLISHED && availableFrom ≤ now < availableUntil)\"\n126\t      }\n127\t    },\n128\t    \"StudentQuestion\": {\n129\t      \"description\": \"A question as shown in the player. It never contains correct, explanation or caseSensitive.\",\n130\t      \"properties\": { \"id\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\", \"options\": \"Option[] | null (in seededShuffle(options, attempt.id) order when shuffleOptions, FR-13)\" }\n131\t    },\n132\t    \"StudentAttempt\": {\n133\t      \"description\": \"toStudentAttempt. Returned while status = IN_PROGRESS (FR-13, FR-14, FR-19).\",\n134\t      \"properties\": {\n135\t        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\", \"status\": \"\\\"IN_PROGRESS\\\"\",\n136\t        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime (always set: untimed attempts use availableUntil)\",\n137\t        \"serverNow\": \"ISO datetime (lets the display-only timer correct for client clock skew, ADR-4)\",\n138\t        \"oneQuestionPerPage\": \"boolean\",\n139\t        \"questions\": \"StudentQuestion[] (in the frozen questionOrder)\",\n140\t        \"answers\": \"{ questionId: string, response: AnswerResponse | null, savedAt: ISO datetime }[] (no grading fields)\"\n141\t      }\n142\t    },\n143\t    \"StudentResult\": {\n144\t      \"description\": \"toStudentResult. Returned for a submitted attempt to its owner or a linked parent (FR-20, FR-21). When resultsVisible = false, every score field is null and questions is null; the UI shows 'Submitted — results will be available later.'\",\n145\t      \"properties\": {\n146\t        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\",\n147\t        \"status\": \"\\\"SUBMITTED\\\" | \\\"NEEDS_GRADING\\\" | \\\"GRADED\\\"\",\n148\t        \"startedAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime\", \"autoSubmitted\": \"boolean\",\n149\t        \"resultsVisible\": \"boolean\",\n150\t        \"awaitingGrading\": \"boolean (status ≠ GRADED)\",\n151\t        \"score\": \"Decimal | null (only when resultsVisible && status = GRADED)\",\n152\t        \"maxScore\": \"Decimal\",\n153\t        \"percent\": \"number | null (same condition as score)\",\n154\t        \"questions\": \"null | { id, type, prompt, points: Decimal, options: Option[] | null, response: AnswerResponse | null, pendingReview: boolean (needsReview, A8), pointsAwarded: Decimal | null (null when pendingReview), isCorrect: boolean | null, feedback: string | null, correct?: Correct (only if showCorrectAnswers), explanation?: string | null (only if showCorrectAnswers) }[] (in questionOrder)\"\n155\t      }\n156\t    },\n157\t    \"ManagerAnswer\": {\n158\t      \"properties\": {\n159\t        \"questionId\": \"string\", \"response\": \"AnswerResponse | null\", \"pointsAwarded\": \"Decimal | null\", \"isCorrect\": \"boolean | null\",\n160\t        \"feedback\": \"string | null\", \"gradedById\": \"string | null\", \"needsReview\": \"boolean (derived, A8)\", \"updatedAt\": \"ISO datetime\"\n161\t      }\n162\t    },\n163\t    \"ManagerAttempt\": {\n164\t      \"description\": \"The full attempt for a course manager (FR-24).\",\n165\t      \"properties\": {\n166\t        \"id\": \"string\", \"quizId\": \"string\", \"student\": \"UserRef\", \"attemptNumber\": \"int\", \"status\": \"AttemptStatus\",\n167\t        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime | null\", \"autoSubmitted\": \"boolean\",\n168\t        \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\",\n169\t        \"questionOrder\": \"string[]\",\n170\t        \"questions\": \"ManagerQuestion[] (in questionOrder)\",\n171\t        \"answers\": \"ManagerAnswer[]\"\n172\t      }\n173\t    }\n174\t  },\n175\t\n176\t  \"endpoints\": [\n177\t    {\n178\t      \"method\": \"GET\",\n179\t      \"path\": \"/api/courses/:id/quizzes\",\n180\t      \"description\": \"Role-shaped, paginated course Quizzes tab list (FR-11). Access: assertCanViewCourse. Managers see every status. Students and parents see only PUBLISHED and CLOSED quizzes. Sorted by availableFrom desc. Runs ensureNotExpired on the caller's own IN_PROGRESS attempts before computing groups.\",\n181\t      \"auth\": \"view course\",\n182\t      \"requestSchema\": {\n183\t        \"params\": { \"id\": \"courseId (cuid)\" },\n184\t        \"query\": { \"page\": \"int?\", \"pageSize\": \"int? ≤ 100\" }\n185\t      },\n186\t      \"responseSchema\": {\n187\t        \"envelope\": \"paginated\",\n188\t        \"item\": {\n189\t          \"oneOf\": {\n190\t            \"manager\": {\n191\t              \"role\": \"\\\"MANAGER\\\"\",\n192\t              \"id\": \"string\", \"title\": \"string\", \"status\": \"QuizStatus\", \"isPractice\": \"boolean\",\n193\t              \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\", \"timeLimitMinutes\": \"int | null\",\n194\t              \"resultsVisibility\": \"ResultsVisibility\", \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n195\t              \"attemptCount\": \"int\", \"averagePercent\": \"number | null (submitted+graded attempts)\", \"needsGradingCount\": \"int (attempts with status NEEDS_GRADING)\"\n196\t            },\n197\t            \"student\": {\n198\t              \"role\": \"\\\"STUDENT\\\"\",\n199\t              \"quiz\": \"StudentQuiz\",\n200\t              \"group\": \"\\\"UPCOMING\\\" | \\\"AVAILABLE\\\" | \\\"COMPLETED\\\" | \\\"MISSED\\\". UPCOMING = now < availableFrom. AVAILABLE = isOpen && (attemptsUsed < attemptLimit || inProgressAttemptId). COMPLETED = ≥ 1 submitted attempt and not AVAILABLE. MISSED = now ≥ availableUntil with 0 attempts (A2).\",\n201\t              \"latestResult\": \"{ attemptId: string, status: AttemptStatus, score: Decimal | null, maxScore: Decimal, percent: number | null } | null (scores null unless resultsVisible)\"\n202\t            },\n203\t            \"parent\": {\n204\t              \"role\": \"\\\"PARENT\\\"\",\n205\t              \"student\": \"UserRef (linked child enrolled in the course; one row per child × quiz)\",\n206\t              \"quiz\": \"StudentQuiz\",\n207\t              \"results\": \"{ attemptId: string, attemptNumber: int, submittedAt: ISO datetime, score: Decimal | null, maxScore: Decimal, percent: number | null }[] (only attempts where resultsVisible, read-only)\"\n208\t            }\n209\t          }\n210\t        }\n211\t      },\n212\t      \"errors\": [\"NOT_FOUND (course not visible)\"],\n213\t      \"requirementIds\": [\"FR-11\", \"FR-31\", \"FR-33\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\"]\n214\t    },\n215\t    {\n216\t      \"method\": \"POST\",\n217\t      \"path\": \"/api/courses/:id/quizzes\",\n218\t      \"description\": \"Creates a DRAFT quiz. The /quizzes/new page sends defaults and then redirects to /edit (FR-6). createdById = caller. Returns 201.\",\n219\t      \"auth\": \"manage course\",\n220\t      \"requestSchema\": {\n221\t        \"params\": { \"id\": \"courseId\" },\n222\t        \"body\": \"QuizSettingsInput with title, availableFrom and availableUntil required; every other field optional (FR-1 defaults)\"\n223\t      },\n224\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\", \"status\": 201 },\n225\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (cannot manage course)\"],\n226\t      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-31\", \"FR-34\"]\n227\t    },\n228\t    {\n229\t      \"method\": \"GET\",\n230\t      \"path\": \"/api/quizzes/:id\",\n231\t      \"description\": \"Manager: ManagerQuiz, the full quiz including correct answers. STUDENT (ACTIVE enrollee) or PARENT (linked to an enrollee): toStudentQuiz, with no questions and never `correct`. A DRAFT quiz is NOT_FOUND for non-managers.\",\n232\t      \"auth\": \"view course\",\n233\t      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n234\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"ManagerQuiz\", \"StudentQuiz\"] } },\n235\t      \"errors\": [\"NOT_FOUND\"],\n236\t      \"requirementIds\": [\"FR-12\", \"FR-31\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n237\t    },\n238\t    {\n239\t      \"method\": \"PATCH\",\n240\t      \"path\": \"/api/quizzes/:id\",\n241\t      \"description\": \"Updates settings and/or the status transition. Allowed transitions are DRAFT→PUBLISHED and PUBLISHED→CLOSED only (A9); any other change is CONFLICT. Publishing runs canPublish: if there are problems it returns VALIDATION_ERROR with details {problems: string[]} (FR-9). Otherwise it does a conditional updateMany where status = DRAFT, and only if that updated a row is notify('quiz.published') sent, after commit, to ACTIVE enrollees (FR-29). resultsReleasedAt cannot be set here; use release-results.\",\n242\t      \"auth\": \"manage course\",\n243\t      \"requestSchema\": {\n244\t        \"params\": { \"id\": \"quizId\" },\n245\t        \"body\": \"Partial<QuizSettingsInput> & { status?: \\\"PUBLISHED\\\" | \\\"CLOSED\\\" } (at least one key)\"\n246\t      },\n247\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\" },\n248\t      \"errors\": [\"VALIDATION_ERROR (schema, cross-field rule, or publish problems)\", \"CONFLICT (invalid status transition)\", \"NOT_FOUND\"],\n249\t      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-9\", \"FR-29\", \"FR-31\"]\n250\t    },\n251\t    {\n252\t      \"method\": \"DELETE\",\n253\t      \"path\": \"/api/quizzes/:id\",\n254\t      \"description\": \"Deletes the quiz (questions and accommodations cascade). Allowed only while no attempt exists.\",\n255\t      \"auth\": \"manage course\",\n256\t      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n257\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n258\t      \"errors\": [\"CONFLICT (quiz has attempts)\", \"NOT_FOUND\"],\n259\t      \"requirementIds\": [\"FR-31\"]\n260\t    },\n261\t    {\n262\t      \"method\": \"POST\",\n263\t      \"path\": \"/api/quizzes/:id/questions\",\n264\t      \"description\": \"Adds a question at order = max + 1. The builder's Duplicate action is this call with a copied body (FR-7). Edit lock: CONFLICT when the quiz has attempts (FR-10). Returns 201.\",\n265\t      \"auth\": \"manage course\",\n266\t      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"QuestionInput\" },\n267\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\", \"status\": 201 },\n268\t      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n269\t      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n270\t    },\n271\t    {\n272\t      \"method\": \"POST\",\n273\t      \"path\": \"/api/quizzes/:id/questions/reorder\",\n274\t      \"description\": \"Rewrites Question.order to match the given list, in one transaction. The list must be exactly the quiz's question ids (a permutation), otherwise VALIDATION_ERROR. Blocked by the edit lock.\",\n275\t      \"auth\": \"manage course\",\n276\t      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": { \"questionIds\": \"string[]\" } },\n277\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion[] (new order)\" },\n278\t      \"errors\": [\"VALIDATION_ERROR (not a permutation)\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n279\t      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n280\t    },\n281\t    {\n282\t      \"method\": \"PATCH\",\n283\t      \"path\": \"/api/questions/:id\",\n284\t      \"description\": \"Edits a question. Without attempts, any QuestionInput field can change; the result is re-validated as a whole against the type's schema. With attempts (edit lock, FR-10), only prompt and explanation can change, plus correct.accepted and caseSensitive for SHORT_ANSWER. Any other key gives CONFLICT with the message 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.' Editing never triggers a regrade (A3).\",\n285\t      \"auth\": \"manage course (of the question's quiz)\",\n286\t      \"requestSchema\": { \"params\": { \"id\": \"questionId\" }, \"body\": \"Partial<QuestionInput>\" },\n287\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\" },\n288\t      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n289\t      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n290\t    },\n291\t    {\n292\t      \"method\": \"DELETE\",\n293\t      \"path\": \"/api/questions/:id\",\n294\t      \"description\": \"Deletes a question and closes the gap in order. Blocked by the edit lock.\",\n295\t      \"auth\": \"manage course\",\n296\t      \"requestSchema\": { \"params\": { \"id\": \"questionId\" } },\n297\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n298\t      \"errors\": [\"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n299\t      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n300\t    },\n301\t    {\n302\t      \"method\": \"POST\",\n303\t      \"path\": \"/api/quizzes/:id/regrade\",\n304\t      \"description\": \"In one transaction: re-runs gradeAnswer on every answer with gradedById = null across submitted attempts (manual grades always win, A8), runs recomputeAttempt on each attempt, then writes audit('quiz.regrade').\",\n305\t      \"auth\": \"manage course\",\n306\t      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n307\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"attemptCount\": \"int\", \"changedAnswerCount\": \"int\" } },\n308\t      \"errors\": [\"NOT_FOUND\"],\n309\t      \"requirementIds\": [\"FR-10\", \"FR-25\", \"FR-38\"]\n310\t    },\n311\t    {\n312\t      \"method\": \"POST\",\n313\t      \"path\": \"/api/quizzes/:id/release-results\",\n314\t      \"description\": \"MANUAL visibility only. Runs updateMany({id, resultsVisibility: MANUAL, resultsReleasedAt: null} → now). If that updated a row, it calls notifyStudentAndParents('quiz.results_released') for every student with a submitted attempt, then audit('quiz.release_results'). A repeat call is a no-op that returns the existing timestamp. A non-MANUAL quiz is CONFLICT.\",\n315\t      \"auth\": \"manage course\",\n316\t      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n317\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"resultsReleasedAt\": \"ISO datetime\", \"notified\": \"boolean (false on repeat)\" } },\n318\t      \"errors\": [\"CONFLICT (resultsVisibility ≠ MANUAL)\", \"NOT_FOUND\"],\n319\t      \"requirementIds\": [\"FR-20\", \"FR-30\", \"FR-38\"]\n320\t    },\n321\t    {\n322\t      \"method\": \"GET\",\n323\t      \"path\": \"/api/quizzes/:id/analytics\",\n324\t      \"description\": \"Quiz analytics computed in memory over submitted attempts (FR-26, FR-27). With ?format=csv it returns text/csv (Content-Disposition: attachment; filename=\\\"quiz-<id>-attempts.csv\\\"), built with toCsv. CSV columns: student, attemptNumber, score, then one points column per question in quiz order.\",\n325\t      \"auth\": \"manage course\",\n326\t      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"query\": { \"format\": \"\\\"json\\\" | \\\"csv\\\" (default json)\" } },\n327\t      \"responseSchema\": {\n328\t        \"envelope\": \"data (json) | raw text/csv\",\n329\t        \"data\": {\n330\t          \"summary\": { \"attempts\": \"int\", \"average\": \"Decimal | null\", \"median\": \"Decimal | null\", \"highest\": \"Decimal | null\", \"lowest\": \"Decimal | null\", \"averageTimeSeconds\": \"int | null\" },\n331\t          \"histogram\": \"{ bucket: \\\"0–10\\\" | … | \\\"90–100\\\", count: int }[10] (by percent; 100% goes in the last bucket)\",\n332\t          \"questions\": \"{ questionId, order: int, type: QuestionType, prompt, points: Decimal, percentCorrect: number | null, averagePoints: Decimal | null, optionDistribution: { optionId, text, count: int, isCorrect: boolean }[] | null (choice types only), mostChosenWrongOptionId: string | null }[]\"\n333\t        }\n334\t      },\n335\t      \"errors\": [\"VALIDATION_ERROR (bad format)\", \"NOT_FOUND\"],\n336\t      \"requirementIds\": [\"FR-26\", \"FR-27\"]\n337\t    },\n338\t    {\n339\t      \"method\": \"PUT\",\n340\t      \"path\": \"/api/quizzes/:id/accommodations/:studentId\",\n341\t      \"description\": \"Upserts the QuizAccommodation for one ACTIVE enrollee, then writes audit('quiz.accommodation'). It applies only to attempts started afterwards, because deadlineAt is frozen at start (A7). Sending {0, 0} keeps the row; that is equivalent to no accommodation.\",\n342\t      \"auth\": \"manage course\",\n343\t      \"requestSchema\": {\n344\t        \"params\": { \"id\": \"quizId\", \"studentId\": \"userId (must be ACTIVE enrolled in the course)\" },\n345\t        \"body\": { \"extraTimeMinutes\": \"int 0–300\", \"extraAttempts\": \"int 0–5\" }\n346\t      },\n347\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"quizId\": \"string\", \"studentId\": \"string\", \"extraTimeMinutes\": \"int\", \"extraAttempts\": \"int\" } },\n348\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (quiz or student not in course)\"],\n349\t      \"requirementIds\": [\"FR-28\", \"FR-2\", \"FR-23\", \"FR-38\"]\n350\t    },\n351\t    {\n352\t      \"method\": \"POST\",\n353\t      \"path\": \"/api/quizzes/:id/attempts\",\n354\t      \"description\": \"STUDENT start or resume (system-design §4.2). Requires the quiz to be PUBLISHED with availableFrom ≤ now < availableUntil, else CONFLICT. An existing IN_PROGRESS attempt goes through ensureNotExpired and is returned with 200 (resume, FR-19). Otherwise, attempt count ≥ attemptLimit is CONFLICT (FR-23). Otherwise the attempt is created with id pre-generated, questionOrder frozen (seededShuffle by id when shuffleQuestions) and deadlineAt = computeDeadline(...), and returned with 201. A P2002 race on the partial unique index re-reads and returns the IN_PROGRESS attempt with 200.\",\n355\t      \"auth\": \"role STUDENT + view course (ACTIVE enrollee)\",\n356\t      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n357\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentAttempt\", \"status\": \"201 created | 200 resumed\" },\n358\t      \"errors\": [\"CONFLICT (quiz not open | attempt limit reached)\", \"NOT_FOUND (quiz not visible)\", \"FORBIDDEN is not used; a non-STUDENT gets NOT_FOUND\"],\n359\t      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-19\", \"FR-23\", \"FR-28\", \"FR-32\", \"NFR-1\"]\n360\t    },\n361\t    {\n362\t      \"method\": \"GET\",\n363\t      \"path\": \"/api/attempts/:id\",\n364\t      \"description\": \"Calls ensureNotExpired first (FR-18), then assertCanAccessAttempt (FR-34). Owner: StudentAttempt while IN_PROGRESS, otherwise StudentResult. Linked PARENT: StudentResult, and only if the attempt is submitted and resultsVisible, else NOT_FOUND. Course manager: ManagerAttempt. Any other caller gets NOT_FOUND.\",\n365\t      \"auth\": \"owner | linked parent (read-only) | course manager\",\n366\t      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" } },\n367\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"StudentAttempt\", \"StudentResult\", \"ManagerAttempt\"] } },\n368\t      \"errors\": [\"NOT_FOUND\"],\n369\t      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-24\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n370\t    },\n371\t    {\n372\t      \"method\": \"PUT\",\n373\t      \"path\": \"/api/attempts/:id/answers/:questionId\",\n374\t      \"description\": \"Autosave hot path (system-design §4.3, NFR-2): one attempt read, no Quiz or Question load, then one QuizAnswer upsert on the (attemptId, questionId) PK. Checks: studentId ≠ caller → NOT_FOUND; questionId ∉ questionOrder → NOT_FOUND; status ≠ IN_PROGRESS → CONFLICT; now > deadlineAt + 30 s → submitAttempt(id, {auto: true}) then CONFLICT 'Time is up' (FR-16). Idempotent, so localStorage replays are safe (FR-15). response: null clears the answer.\",\n375\t      \"auth\": \"owner (STUDENT)\",\n376\t      \"requestSchema\": {\n377\t        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId\" },\n378\t        \"body\": { \"response\": \"AnswerResponse | null\" }\n379\t      },\n380\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"questionId\": \"string\", \"savedAt\": \"ISO datetime\" }, \"note\": \"Carries no grading data (NFR-1). On 409 the client stops its queue, clears localStorage['quiz-attempt:<id>'] and routes to the result page.\" },\n381\t      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (not in progress | past deadline + grace)\", \"NOT_FOUND\"],\n382\t      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-32\", \"NFR-2\", \"NFR-1\"]\n383\t    },\n384\t    {\n385\t      \"method\": \"POST\",\n386\t      \"path\": \"/api/attempts/:id/submit\",\n387\t      \"description\": \"Runs submitAttempt(id, {auto: false}) (system-design §4.4). The IN_PROGRESS → SUBMITTED claim is atomic; missing answers are created as null, every answer is auto-graded, then recomputeAttempt sets status NEEDS_GRADING or GRADED (FR-17). An already-submitted attempt returns its current state with 200 (idempotent, no error). A submit after the deadline still succeeds as a manual submit; nothing is lost because the answers were already saved.\",\n388\t      \"auth\": \"owner (STUDENT)\",\n389\t      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" }, \"body\": \"none\" },\n390\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentResult\" },\n391\t      \"errors\": [\"NOT_FOUND\"],\n392\t      \"requirementIds\": [\"FR-17\", \"FR-25\", \"FR-32\", \"NFR-1\"]\n393\t    },\n394\t    {\n395\t      \"method\": \"PUT\",\n396\t      \"path\": \"/api/attempts/:id/answers/:questionId/grade\",\n397\t      \"description\": \"Manual grade or override (FR-24). The attempt must be submitted (not IN_PROGRESS), else CONFLICT. pointsAwarded must be ≤ question.points and a multiple of 0.5, else VALIDATION_ERROR. Sets pointsAwarded, isCorrect = (pointsAwarded == question.points), feedback and gradedById = caller, upserting the answer row if it is missing. Then recomputeAttempt (FR-25), and audit('quizAnswer.grade') after commit. No notification is sent (FR-30). The body field is named pointsAwarded per the PRD API table (system-design §3.2 calls it `points`; manualGradeSchema should use pointsAwarded).\",\n398\t      \"auth\": \"manage course\",\n399\t      \"requestSchema\": {\n400\t        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId (must be in questionOrder)\" },\n401\t        \"body\": { \"pointsAwarded\": \"number | string, ≥ 0, step 0.5\", \"feedback\": \"string | null (optional)\" }\n402\t      },\n403\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"answer\": \"ManagerAnswer\", \"attempt\": { \"id\": \"string\", \"status\": \"AttemptStatus\", \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\" } } },\n404\t      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (attempt in progress)\", \"NOT_FOUND\"],\n405\t      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-4\", \"FR-38\"]\n406\t    },\n407\t    {\n408\t      \"method\": \"POST\",\n409\t      \"path\": \"/api/internal/email/dispatch\",\n410\t      \"description\": \"EXISTING cron route. The request/response contract is unchanged: Bearer CRON_SECRET in, ok(dispatchEmails result) out. Changed behaviour only: after sendDueReminders(now), it also runs autoSubmitExpiredAttempts(now) (IN_PROGRESS with deadlineAt < now − 30 s, ≤ 200 per call) and sendAfterCloseResultsReleased(now) (atomic resultsReleasedAt claim, A6). Each runs in its own try/catch with logger.error, on every request, and both are idempotent.\",\n411\t      \"auth\": \"cron secret\",\n412\t      \"requestSchema\": { \"headers\": { \"authorization\": \"Bearer <CRON_SECRET>\" }, \"body\": \"none\" },\n413\t      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"unchanged dispatchEmails() result\" },\n414\t      \"errors\": [\"UNAUTHENTICATED\"],\n415\t      \"requirementIds\": [\"FR-18\", \"FR-30\", \"FR-35\"]\n416\t    }\n417\t  ],\n418\t\n419\t  \"reusedUnchanged\": [\n420\t    \"POST /api/files and GET /api/files/:id serve question-prompt images with the new 'quiz' file context and resolver (manager, or course viewer once the quiz is PUBLISHED). The route contracts don't change (FR-39, system-design §3.5).\"\n421\t  ],\n422\t\n423\t  \"status\": \"complete\"\n424\t}\n425\t"}]},"parent_tool_use_id":null,"session_id":"3eb50254-5396-4c9e-84e7-da065a5fc108","uuid":"e0b37667-4cc6-4397-8f5f-b1e6dac83cbd","timestamp":"2026-11-09T07:12:34.363Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/.claude/projects/-Users-ikramaansari-Documents-forge-schoolhub/3eb50254-5396-4c9e-84e7-da065a5fc108/tool-results/bmujzz0gp.txt","content":"{\n  \"ticketId\": \"SH-10\",\n  \"timestamp\": \"2026-11-09T13:00:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api. This is the existing project convention; there is no /api/v1 prefix (system-design §3.3).\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/quiz.ts) → one call into src/server/quiz/*-service.ts → ok()/paginated(). All of these come from src/server/http.ts. Handlers contain no logic (NFR-6, NFR-7).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int ≥ 1, default 1\", \"pageSize\": \"int 1–100, default 20 (parsePagination)\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": \"400. Zod failure (details = zod flatten()) or a service rule failure such as canPublish problems, points > question points, or step ≠ 0.5.\",\n      \"UNAUTHENTICATED\": \"401. No session, or a bad cron secret on the internal route.\",\n      \"NOT_FOUND\": \"404. The resource is missing OR the caller cannot access it. Existence is never revealed, so FORBIDDEN is not used for quiz resources (NFR-5).\",\n      \"CONFLICT\": \"409. Answer write after deadlineAt + 30 s, a closed or not-yet-open quiz, attempt limit reached, edit lock (quiz has attempts), delete with attempts, an invalid status transition, or a write to a non-IN_PROGRESS attempt.\",\n      \"INTERNAL\": \"500. Logged with logger.error and never detailed to the client.\"\n    },\n    \"createdStatus\": \"POST endpoints that create a resource return 201 via ok(x, {status: 201}). Every other success returns 200.\",\n    \"decimals\": \"points, score, maxScore, pointsAwarded, totalPoints and the analytics averages are serialized as strings with 2 decimals by fixed2 from @/server/assignments/grading-math (e.g. \\\"2.00\\\"). Input decimals accept number | string. Percentages are numbers rounded to 1 decimal.\",\n    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client time (ADR-4). The UI displays times in SchoolSettings.timezone (NFR-6).\",\n    \"ids\": \"cuid strings. Option ids inside Question.options are short cuids generated by the builder and stay stable across edits.\",\n    \"studentPrivacy\": \"Every quiz, attempt or result returned to a STUDENT or PARENT is built only by the allow-listing serializers in src/server/quiz/serializers.ts (toStudentQuiz, toStudentAttempt, toStudentResult). `correct` and `explanation` appear only inside StudentResult.questions[] and only when resultsVisible && showCorrectAnswers. Scores appear only when resultsVisible. Student-path Prisma selects never load `correct` or `explanation` (NFR-1, ADR-5).\",\n    \"lazyAutoSubmit\": \"GET /api/attempts/:id, POST /api/quizzes/:id/attempts, the course list and the teacher grade/list loads call ensureNotExpired first. So an IN_PROGRESS attempt past deadlineAt is always returned already submitted (FR-18).\",\n    \"noEndpointByDesign\": [\n      \"getStudentQuizScore(quizId, studentId) → {score, maxScore, percent, isPractice, attemptsCounted} | null is a TypeScript export of attempt-service.ts for PRD-11. It has no HTTP route (FR-22, FR-33, system-design §4.7).\",\n      \"The grading workspace, the analytics page and the builder's accommodations table are server pages. They call the services directly, after requirePageRole and assertCanManageCourse. Only their writes go through the routes below (system-design §3.4).\",\n      \"Preview mode (FR-8) calls no attempt endpoint (A10).\"\n    ],\n    \"requirementIds\": [\"FR-31\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\", \"NFR-7\"]\n  },\n\n  \"sharedSchemas\": {\n    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^\\\\d+\\\\.\\\\d{2}$\", \"description\": \"Output form. Input form is number | string.\" },\n    \"QuizStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"PUBLISHED\", \"CLOSED\"] },\n    \"QuestionType\": { \"type\": \"string\", \"enum\": [\"SINGLE_CHOICE\", \"MULTIPLE_CHOICE\", \"TRUE_FALSE\", \"SHORT_ANSWER\", \"ESSAY\"] },\n    \"ResultsVisibility\": { \"type\": \"string\", \"enum\": [\"IMMEDIATELY\", \"AFTER_CLOSE\", \"MANUAL\"] },\n    \"AttemptStatus\": { \"type\": \"string\", \"enum\": [\"IN_PROGRESS\", \"SUBMITTED\", \"NEEDS_GRADING\", \"GRADED\"] },\n    \"ScoringPolicy\": { \"type\": \"string\", \"enum\": [\"HIGHEST\", \"LATEST\", \"AVERAGE\"] },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"name\": \"string\" } },\n    \"Option\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"text\": \"string (non-empty)\" } },\n    \"Correct\": {\n      \"description\": \"Keyed by Question.type (FR-2). Manager-only, except as described in conventions.studentPrivacy.\",\n      \"oneOf\": {\n        \"SINGLE_CHOICE\": { \"optionId\": \"string (must be one of options[].id)\" },\n        \"MULTIPLE_CHOICE\": { \"optionIds\": \"string[] (≥ 1, each in options[].id)\" },\n        \"TRUE_FALSE\": { \"value\": \"boolean\" },\n        \"SHORT_ANSWER\": { \"accepted\": \"string[] (1–10, non-empty)\" },\n        \"ESSAY\": { \"guidance\": \"string?\" }\n      }\n    },\n    \"AnswerResponse\": {\n      \"description\": \"answerResponseSchema. A type-agnostic union, so the autosave path doesn't load the Question (NFR-2). A shape that doesn't match the question's type grades as 0 / incorrect at submit.\",\n      \"oneOf\": [\n        { \"optionId\": \"string\" },\n        { \"optionIds\": \"string[]\" },\n        { \"value\": \"boolean\" },\n        { \"text\": \"string (≤ 10,000 chars)\" }\n      ]\n    },\n    \"QuizSettingsInput\": {\n      \"description\": \"quizSettingsSchema (FR-2, FR-6). Cross-field rules run in superRefine: availableUntil > availableFrom, and timeLimitMinutes ≤ the window length in minutes. On PATCH, both rules are checked against the stored values merged with the patch.\",\n      \"properties\": {\n        \"title\": \"string (trimmed, non-empty)\",\n        \"instructions\": \"string (Markdown, default \\\"\\\")\",\n        \"isPractice\": \"boolean (default false)\",\n        \"availableFrom\": \"ISO datetime\",\n        \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int 1–300 | null (null = untimed)\",\n        \"maxAttempts\": \"int 1–10 (default 1)\",\n        \"scoringPolicy\": \"ScoringPolicy (default HIGHEST)\",\n        \"shuffleQuestions\": \"boolean (default false)\",\n        \"shuffleOptions\": \"boolean (default false)\",\n        \"oneQuestionPerPage\": \"boolean (default false)\",\n        \"resultsVisibility\": \"ResultsVisibility (default AFTER_CLOSE)\",\n        \"showCorrectAnswers\": \"boolean (default true)\"\n      }\n    },\n    \"QuestionInput\": {\n      \"description\": \"questionSchema, a z.discriminatedUnion on type (FR-2, FR-7). points 0.5–100 in steps of 0.5. options has 2–8 entries for SINGLE_CHOICE/MULTIPLE_CHOICE and is absent for the other types. prompt is non-empty Markdown and may embed a file uploaded with context 'quiz' (FR-39).\",\n      \"properties\": {\n        \"type\": \"QuestionType\",\n        \"prompt\": \"string (Markdown)\",\n        \"points\": \"number | string\",\n        \"options\": \"Option[] | undefined\",\n        \"correct\": \"Correct (shape keyed by type)\",\n        \"explanation\": \"string | null\",\n        \"caseSensitive\": \"boolean (SHORT_ANSWER only, default false)\"\n      }\n    },\n    \"ManagerQuestion\": {\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\",\n        \"order\": \"int\", \"options\": \"Option[] | null\", \"correct\": \"Correct\", \"explanation\": \"string | null\", \"caseSensitive\": \"boolean\"\n      }\n    },\n    \"ManagerQuiz\": {\n      \"description\": \"Full quiz, including answers. Returned only to managers (assertCanManageCourse).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\",\n        \"...\": \"every QuizSettingsInput field, resolved\",\n        \"status\": \"QuizStatus\",\n        \"resultsReleasedAt\": \"ISO datetime | null\",\n        \"createdById\": \"string\", \"createdAt\": \"ISO datetime\", \"updatedAt\": \"ISO datetime\",\n        \"questions\": \"ManagerQuestion[] (sorted by order)\",\n        \"totalPoints\": \"Decimal (Σ points, FR-8)\",\n        \"attemptCount\": \"int\",\n        \"locked\": \"boolean (attemptCount > 0, edit lock FR-10)\",\n        \"publishProblems\": \"string[] (canPublish(questions); empty means publishable, FR-9)\"\n      }\n    },\n    \"StudentQuiz\": {\n      \"description\": \"toStudentQuiz. Allow-listed, with no questions and no `correct` (NFR-1). Drives the start screen (FR-12).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\", \"title\": \"string\", \"instructions\": \"string\", \"isPractice\": \"boolean\",\n        \"status\": \"QuizStatus (DRAFT is never returned to a non-manager; that case is NOT_FOUND)\",\n        \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int | null\", \"oneQuestionPerPage\": \"boolean\", \"resultsVisibility\": \"ResultsVisibility\",\n        \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n        \"extraTimeMinutes\": \"int (caller's accommodation, 0 if none; 0 for parents)\",\n        \"attemptLimit\": \"int (attemptLimit(maxAttempts, extraAttempts), FR-23)\",\n        \"attemptsUsed\": \"int (caller's own attempts; 0 for parents)\",\n        \"inProgressAttemptId\": \"string | null (Resume target, FR-19)\",\n        \"isOpen\": \"boolean (PUBLISHED && availableFrom ≤ now < availableUntil)\"\n      }\n    },\n    \"StudentQuestion\": {\n      \"description\": \"A question as shown in the player. It never contains correct, explanation or caseSensitive.\",\n      \"properties\": { \"id\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\", \"options\": \"Option[] | null (in seededShuffle(options, attempt.id) order when shuffleOptions, FR-13)\" }\n    },\n    \"StudentAttempt\": {\n      \"description\": \"toStudentAttempt. Returned while status = IN_PROGRESS (FR-13, FR-14, FR-19).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\", \"status\": \"\\\"IN_PROGRESS\\\"\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime (always set: untimed attempts use availableUntil)\",\n        \"serverNow\": \"ISO datetime (lets the display-only timer correct for client clock skew, ADR-4)\",\n        \"oneQuestionPerPage\": \"boolean\",\n        \"questions\": \"StudentQuestion[] (in the frozen questionOrder)\",\n        \"answers\": \"{ questionId: string, response: AnswerResponse | null, savedAt: ISO datetime }[] (no grading fields)\"\n      }\n    },\n    \"StudentResult\": {\n      \"description\": \"toStudentResult. Returned for a submitted attempt to its owner or a linked parent (FR-20, FR-21). When resultsVisible = false, every score field is null and questions is null; the UI shows 'Submitted — results will be available later.'\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\",\n        \"status\": \"\\\"SUBMITTED\\\" | \\\"NEEDS_GRADING\\\" | \\\"GRADED\\\"\",\n        \"startedAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime\", \"autoSubmitted\": \"boolean\",\n        \"resultsVisible\": \"boolean\",\n        \"awaitingGrading\": \"boolean (status ≠ GRADED)\",\n        \"score\": \"Decimal | null (only when resultsVisible && status = GRADED)\",\n        \"maxScore\": \"Decimal\",\n        \"percent\": \"number | null (same condition as score)\",\n        \"questions\": \"null | { id, type, prompt, points: Decimal, options: Option[] | null, response: AnswerResponse | null, pendingReview: boolean (needsReview, A8), pointsAwarded: Decimal | null (null when pendingReview), isCorrect: boolean | null, feedback: string | null, correct?: Correct (only if showCorrectAnswers), explanation?: string | null (only if showCorrectAnswers) }[] (in questionOrder)\"\n      }\n    },\n    \"ManagerAnswer\": {\n      \"properties\": {\n        \"questionId\": \"string\", \"response\": \"AnswerResponse | null\", \"pointsAwarded\": \"Decimal | null\", \"isCorrect\": \"boolean | null\",\n        \"feedback\": \"string | null\", \"gradedById\": \"string | null\", \"needsReview\": \"boolean (derived, A8)\", \"updatedAt\": \"ISO datetime\"\n      }\n    },\n    \"ManagerAttempt\": {\n      \"description\": \"The full attempt for a course manager (FR-24).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"student\": \"UserRef\", \"attemptNumber\": \"int\", \"status\": \"AttemptStatus\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime | null\", \"autoSubmitted\": \"boolean\",\n        \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\",\n        \"questionOrder\": \"string[]\",\n        \"questions\": \"ManagerQuestion[] (in questionOrder)\",\n        \"answers\": \"ManagerAnswer[]\"\n      }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Role-shaped, paginated course Quizzes tab list (FR-11). Access: assertCanViewCourse. Managers see every status. Students and parents see only PUBLISHED and CLOSED quizzes. Sorted by availableFrom desc. Runs ensureNotExpired on the caller's own IN_PROGRESS attempts before computing groups.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId (cuid)\" },\n        \"query\": { \"page\": \"int?\", \"pageSize\": \"int? ≤ 100\" }\n      },\n      \"responseSchema\": {\n        \"envelope\": \"paginated\",\n        \"item\": {\n          \"oneOf\": {\n            \"manager\": {\n              \"role\": \"\\\"MANAGER\\\"\",\n              \"id\": \"string\", \"title\": \"string\", \"status\": \"QuizStatus\", \"isPractice\": \"boolean\",\n              \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\", \"timeLimitMinutes\": \"int | null\",\n              \"resultsVisibility\": \"ResultsVisibility\", \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n              \"attemptCount\": \"int\", \"averagePercent\": \"number | null (submitted+graded attempts)\", \"needsGradingCount\": \"int (attempts with status NEEDS_GRADING)\"\n            },\n            \"student\": {\n              \"role\": \"\\\"STUDENT\\\"\",\n              \"quiz\": \"StudentQuiz\",\n              \"group\": \"\\\"UPCOMING\\\" | \\\"AVAILABLE\\\" | \\\"COMPLETED\\\" | \\\"MISSED\\\". UPCOMING = now < availableFrom. AVAILABLE = isOpen && (attemptsUsed < attemptLimit || inProgressAttemptId). COMPLETED = ≥ 1 submitted attempt and not AVAILABLE. MISSED = now ≥ availableUntil with 0 attempts (A2).\",\n              \"latestResult\": \"{ attemptId: string, status: AttemptStatus, score: Decimal | null, maxScore: Decimal, percent: number | null } | null (scores null unless resultsVisible)\"\n            },\n            \"parent\": {\n              \"role\": \"\\\"PARENT\\\"\",\n              \"student\": \"UserRef (linked child enrolled in the course; one row per child × quiz)\",\n              \"quiz\": \"StudentQuiz\",\n              \"results\": \"{ attemptId: string, attemptNumber: int, submittedAt: ISO datetime, score: Decimal | null, maxScore: Decimal, percent: number | null }[] (only attempts where resultsVisible, read-only)\"\n            }\n          }\n        }\n      },\n      \"errors\": [\"NOT_FOUND (course not visible)\"],\n      \"requirementIds\": [\"FR-11\", \"FR-31\", \"FR-33\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Creates a DRAFT quiz. The /quizzes/new page sends defaults and then redirects to /edit (FR-6). createdById = caller. Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId\" },\n        \"body\": \"QuizSettingsInput with title, availableFrom and availableUntil required; every other field optional (FR-1 defaults)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (cannot manage course)\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-31\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Manager: ManagerQuiz, the full quiz including correct answers. STUDENT (ACTIVE enrollee) or PARENT (linked to an enrollee): toStudentQuiz, with no questions and never `correct`. A DRAFT quiz is NOT_FOUND for non-managers.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"ManagerQuiz\", \"StudentQuiz\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-31\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Updates settings and/or the status transition. Allowed transitions are DRAFT→PUBLISHED and PUBLISHED→CLOSED only (A9); any other change is CONFLICT. Publishing runs canPublish: if there are problems it returns VALIDATION_ERROR with details {problems: string[]} (FR-9). Otherwise it does a conditional updateMany where status = DRAFT, and only if that updated a row is notify('quiz.published') sent, after commit, to ACTIVE enrollees (FR-29). resultsReleasedAt cannot be set here; use release-results.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\" },\n        \"body\": \"Partial<QuizSettingsInput> & { status?: \\\"PUBLISHED\\\" | \\\"CLOSED\\\" } (at least one key)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\" },\n      \"errors\": [\"VALIDATION_ERROR (schema, cross-field rule, or publish problems)\", \"CONFLICT (invalid status transition)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-9\", \"FR-29\", \"FR-31\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Deletes the quiz (questions and accommodations cascade). Allowed only while no attempt exists.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (quiz has attempts)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions\",\n      \"description\": \"Adds a question at order = max + 1. The builder's Duplicate action is this call with a copied body (FR-7). Edit lock: CONFLICT when the quiz has attempts (FR-10). Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"QuestionInput\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions/reorder\",\n      \"description\": \"Rewrites Question.order to match the given list, in one transaction. The list must be exactly the quiz's question ids (a permutation), otherwise VALIDATION_ERROR. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": { \"questionIds\": \"string[]\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion[] (new order)\" },\n      \"errors\": [\"VALIDATION_ERROR (not a permutation)\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Edits a question. Without attempts, any QuestionInput field can change; the result is re-validated as a whole against the type's schema. With attempts (edit lock, FR-10), only prompt and explanation can change, plus correct.accepted and caseSensitive for SHORT_ANSWER. Any other key gives CONFLICT with the message 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.' Editing never triggers a regrade (A3).\",\n      \"auth\": \"manage course (of the question's quiz)\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" }, \"body\": \"Partial<QuestionInput>\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Deletes a question and closes the gap in order. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/regrade\",\n      \"description\": \"In one transaction: re-runs gradeAnswer on every answer with gradedById = null across submitted attempts (manual grades always win, A8), runs recomputeAttempt on each attempt, then writes audit('quiz.regrade').\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"attemptCount\": \"int\", \"changedAnswerCount\": \"int\" } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-10\", \"FR-25\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/release-results\",\n      \"description\": \"MANUAL visibility only. Runs updateMany({id, resultsVisibility: MANUAL, resultsReleasedAt: null} → now). If that updated a row, it calls notifyStudentAndParents('quiz.results_released') for every student with a submitted attempt, then audit('quiz.release_results'). A repeat call is a no-op that returns the existing timestamp. A non-MANUAL quiz is CONFLICT.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"resultsReleasedAt\": \"ISO datetime\", \"notified\": \"boolean (false on repeat)\" } },\n      \"errors\": [\"CONFLICT (resultsVisibility ≠ MANUAL)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-20\", \"FR-30\", \"FR-38\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id/analytics\",\n      \"description\": \"Quiz analytics computed in memory over submitted attempts (FR-26, FR-27). With ?format=csv it returns text/csv (Content-Disposition: attachment; filename=\\\"quiz-<id>-attempts.csv\\\"), built with toCsv. CSV columns: student, attemptNumber, score, then one points column per question in quiz order.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"query\": { \"format\": \"\\\"json\\\" | \\\"csv\\\" (default json)\" } },\n      \"responseSchema\": {\n        \"envelope\": \"data (json) | raw text/csv\",\n        \"data\": {\n          \"summary\": { \"attempts\": \"int\", \"average\": \"Decimal | null\", \"median\": \"Decimal | null\", \"highest\": \"Decimal | null\", \"lowest\": \"Decimal | null\", \"averageTimeSeconds\": \"int | null\" },\n          \"histogram\": \"{ bucket: \\\"0–10\\\" | … | \\\"90–100\\\", count: int }[10] (by percent; 100% goes in the last bucket)\",\n          \"questions\": \"{ questionId, order: int, type: QuestionType, prompt, points: Decimal, percentCorrect: number | null, averagePoints: Decimal | null, optionDistribution: { optionId, text, count: int, isCorrect: boolean }[] | null (choice types only), mostChosenWrongOptionId: string | null }[]\"\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR (bad format)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-26\", \"FR-27\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/quizzes/:id/accommodations/:studentId\",\n      \"description\": \"Upserts the QuizAccommodation for one ACTIVE enrollee, then writes audit('quiz.accommodation'). It applies only to attempts started afterwards, because deadlineAt is frozen at start (A7). Sending {0, 0} keeps the row; that is equivalent to no accommodation.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\", \"studentId\": \"userId (must be ACTIVE enrolled in the course)\" },\n        \"body\": { \"extraTimeMinutes\": \"int 0–300\", \"extraAttempts\": \"int 0–5\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"quizId\": \"string\", \"studentId\": \"string\", \"extraTimeMinutes\": \"int\", \"extraAttempts\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (quiz or student not in course)\"],\n      \"requirementIds\": [\"FR-28\", \"FR-2\", \"FR-23\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/attempts\",\n      \"description\": \"STUDENT start or resume (system-design §4.2). Requires the quiz to be PUBLISHED with availableFrom ≤ now < availableUntil, else CONFLICT. An existing IN_PROGRESS attempt goes through ensureNotExpired and is returned with 200 (resume, FR-19). Otherwise, attempt count ≥ attemptLimit is CONFLICT (FR-23). Otherwise the attempt is created with id pre-generated, questionOrder frozen (seededShuffle by id when shuffleQuestions) and deadlineAt = computeDeadline(...), and returned with 201. A P2002 race on the partial unique index re-reads and returns the IN_PROGRESS attempt with 200.\",\n      \"auth\": \"role STUDENT + view course (ACTIVE enrollee)\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentAttempt\", \"status\": \"201 created | 200 resumed\" },\n      \"errors\": [\"CONFLICT (quiz not open | attempt limit reached)\", \"NOT_FOUND (quiz not visible)\", \"FORBIDDEN is not used; a non-STUDENT gets NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-19\", \"FR-23\", \"FR-28\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attempts/:id\",\n      \"description\": \"Calls ensureNotExpired first (FR-18), then assertCanAccessAttempt (FR-34). Owner: StudentAttempt while IN_PROGRESS, otherwise StudentResult. Linked PARENT: StudentResult, and only if the attempt is submitted and resultsVisible, else NOT_FOUND. Course manager: ManagerAttempt. Any other caller gets NOT_FOUND.\",\n      \"auth\": \"owner | linked parent (read-only) | course manager\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"StudentAttempt\", \"StudentResult\", \"ManagerAttempt\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-24\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId\",\n      \"description\": \"Autosave hot path (system-design §4.3, NFR-2): one attempt read, no Quiz or Question load, then one QuizAnswer upsert on the (attemptId, questionId) PK. Checks: studentId ≠ caller → NOT_FOUND; questionId ∉ questionOrder → NOT_FOUND; status ≠ IN_PROGRESS → CONFLICT; now > deadlineAt + 30 s → submitAttempt(id, {auto: true}) then CONFLICT 'Time is up' (FR-16). Idempotent, so localStorage replays are safe (FR-15). response: null clears the answer.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId\" },\n        \"body\": { \"response\": \"AnswerResponse | null\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"questionId\": \"string\", \"savedAt\": \"ISO datetime\" }, \"note\": \"Carries no grading data (NFR-1). On 409 the client stops its queue, clears localStorage['quiz-attempt:<id>'] and routes to the result page.\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (not in progress | past deadline + grace)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-32\", \"NFR-2\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/attempts/:id/submit\",\n      \"description\": \"Runs submitAttempt(id, {auto: false}) (system-design §4.4). The IN_PROGRESS → SUBMITTED claim is atomic; missing answers are created as null, every answer is auto-graded, then recomputeAttempt sets status NEEDS_GRADING or GRADED (FR-17). An already-submitted attempt returns its current state with 200 (idempotent, no error). A submit after the deadline still succeeds as a manual submit; nothing is lost because the answers were already saved.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentResult\" },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-17\", \"FR-25\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId/grade\",\n      \"description\": \"Manual grade or override (FR-24). The attempt must be submitted (not IN_PROGRESS), else CONFLICT. pointsAwarded must be ≤ question.points and a multiple of 0.5, else VALIDATION_ERROR. Sets pointsAwarded, isCorrect = (pointsAwarded == question.points), feedback and gradedById = caller, upserting the answer row if it is missing. Then recomputeAttempt (FR-25), and audit('quizAnswer.grade') after commit. No notification is sent (FR-30). The body field is named pointsAwarded per the PRD API table (system-design §3.2 calls it `points`; manualGradeSchema should use pointsAwarded).\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId (must be in questionOrder)\" },\n        \"body\": { \"pointsAwarded\": \"number | string, ≥ 0, step 0.5\", \"feedback\": \"string | null (optional)\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"answer\": \"ManagerAnswer\", \"attempt\": { \"id\": \"string\", \"status\": \"AttemptStatus\", \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (attempt in progress)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-4\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING cron route. The request/response contract is unchanged: Bearer CRON_SECRET in, ok(dispatchEmails result) out. Changed behaviour only: after sendDueReminders(now), it also runs autoSubmitExpiredAttempts(now) (IN_PROGRESS with deadlineAt < now − 30 s, ≤ 200 per call) and sendAfterCloseResultsReleased(now) (atomic resultsReleasedAt claim, A6). Each runs in its own try/catch with logger.error, on every request, and both are idempotent.\",\n      \"auth\": \"cron secret\",\n      \"requestSchema\": { \"headers\": { \"authorization\": \"Bearer <CRON_SECRET>\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"unchanged dispatchEmails() result\" },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-18\", \"FR-30\", \"FR-35\"]\n    }\n  ],\n\n  \"reusedUnchanged\": [\n    \"POST /api/files and GET /api/files/:id serve question-prompt images with the new 'quiz' file context and resolver (manager, or course viewer once the quiz is PUBLISHED). The route contracts don't change (FR-39, system-design §3.5).\"\n  ],\n\n  \"status\": \"complete\"\n}\n","numLines":425,"startLine":1,"totalLines":425}},"tool_result_meta":[{"id":"toolu_01LDi2Vbwb6Xc1tkQj3cK3yR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
