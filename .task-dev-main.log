{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019W2Eaf4a2ueQWLK4ZgteDb","type":"tool_result","content":"import { prisma } from '@/server/db';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { getCurrentAcademicYear } from '@/server/services/academicYears';\nimport { isCopyTargetYear, listSections } from '@/server/sections/sections-service';\nimport { SectionsClient } from './SectionsClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /admin/sections — PRD-05 FR-2/FR-3/FR-6. */\nexport default async function SectionsPage() {\n  await requirePageRole('ADMIN');\n  const [years, gradeLevels, rooms, current] = await Promise.all([\n    prisma.academicYear.findMany({ orderBy: { startDate: 'asc' } }),\n    prisma.gradeLevel.findMany({ where: { archivedAt: null }, orderBy: { order: 'asc' } }),\n    prisma.room.findMany({ where: { archivedAt: null }, orderBy: { name: 'asc' } }),\n    getCurrentAcademicYear(),\n  ]);\n  const initial = await listSections({}, { skip: 0, take: 20 });\n\n  return (\n    <SectionsClient\n      years={years.map((y) => ({ id: y.id, name: y.name, isCurrent: y.isCurrent, isCopyTarget: isCopyTargetYear(y) }))}\n      currentYearId={current?.id ?? null}\n      gradeLevels={gradeLevels.map((g) => ({ id: g.id, name: g.name }))}\n      rooms={rooms.map((r) => ({ id: r.id, name: r.name }))}\n      initialRows={JSON.parse(JSON.stringify(initial.rows))}\n      initialTotal={initial.total}\n    />\n  );\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" alignItems=\"flex-start\" justifyContent=\"space-between\" spacing={2}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" fontWeight={600}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      alignItems=\"center\"\n      justifyContent=\"center\"\n      spacing={1.5}\n      sx={{ py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}\n'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport TextField from '@mui/material/TextField';\nimport InputAdornment from '@mui/material/InputAdornment';\nimport SearchIcon from '@mui/icons-material/Search';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface DataTableProps {\n  columns: GridColDef[];\n  rows: readonly Record<string, unknown>[];\n  total: number;\n  loading?: boolean;\n  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n  getRowId?: (row: Record<string, unknown>) => string | number;\n}\n\n/**\n * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n * from (and written to) URL query params, a debounced search box, and the\n * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n * params change — this component owns no fetch logic of its own.\n */\nexport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const sortField = searchParams.get('sort') ?? undefined;\n  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n\n  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n\n  const updateParams = useCallback(\n    (updates: Record<string, string | undefined>) => {\n      const next = new URLSearchParams(searchParams.toString());\n      for (const [key, value] of Object.entries(updates)) {\n        if (value === undefined || value === '') {\n          next.delete(key);\n        } else {\n          next.set(key, value);\n        }\n      }\n      router.push(`${pathname}?${next.toString()}`);\n    },\n    [pathname, router, searchParams],\n  );\n\n  // Debounce search -> URL param, resetting to page 1.\n  useEffect(() => {\n    const handle = setTimeout(() => {\n      if (searchInput !== (searchParams.get('q') ?? '')) {\n        updateParams({ q: searchInput || undefined, page: '1' });\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [searchInput]);\n\n  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n\n  return (\n    <Box>\n      <TextField\n        value={searchInput}\n        onChange={(event) => setSearchInput(event.target.value)}\n        placeholder=\"Search…\"\n        size=\"small\"\n        sx={{ mb: 2, maxWidth: 320 }}\n        InputProps={{\n          startAdornment: (\n            <InputAdornment position=\"start\">\n              <SearchIcon fontSize=\"small\" />\n            </InputAdornment>\n          ),\n        }}\n        inputProps={{ 'aria-label': 'Search' }}\n      />\n      <DataGrid\n        autoHeight\n        columns={columns}\n        rows={rows}\n        rowCount={total}\n        loading={loading}\n        getRowId={getRowId}\n        paginationMode=\"server\"\n        sortingMode=\"server\"\n        paginationModel={{ page: page - 1, pageSize }}\n        onPaginationModelChange={(model) =>\n          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n        }\n        sortModel={sortModel}\n        onSortModelChange={(model) =>\n          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n        }\n        pageSizeOptions={[10, 20, 50, 100]}\n        slots={{\n          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n        }}\n        disableRowSelectionOnClick\n      />\n    </Box>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport { ok, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { archiveUser } from '@/server/services/users';\n\n/** POST /api/users/:id/archive — ADMIN only (FR-13, FR-14). Same self/last-admin guard as /status. */\nexport const POST = withHandler(async (_request: Request, { params }: { params: { id: string } }) => {\n  const actor = await requireRole('ADMIN');\n  const user = await archiveUser(actor.id, params.id);\n  await audit({ actorId: actor.id, action: 'user.archived', entityType: 'User', entityId: params.id });\n  return ok(user);\n});\nimport { z } from 'zod';\nimport { ok, paginated, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { createUser, listUsers } from '@/server/services/users';\nimport { createUserSchema, ROLE_VALUES } from '@/lib/validators/users';\n\nconst listQuerySchema = z.object({\n  role: z.string().optional(),\n  status: z.enum(['ACTIVE', 'INVITED', 'DISABLED', 'ARCHIVED']).optional(),\n  gradeLevelId: z.string().optional(),\n  q: z.string().optional(),\n  includeArchived: z.enum(['true', 'false']).optional(),\n});\n\n/** GET/POST /api/users — ADMIN only (FR-2, FR-3, FR-6..FR-10, NFR-2). */\nexport const GET = withHandler(async (request: Request) => {\n  await requireRole('ADMIN');\n\n  const url = new URL(request.url);\n  const query = parseQuery(url.searchParams, listQuerySchema);\n  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n\n  const roleFilter = query.role\n    ? query.role\n        .split(',')\n        .map((value) => value.trim())\n        .filter((value): value is (typeof ROLE_VALUES)[number] => ROLE_VALUES.includes(value as never))\n    : undefined;\n\n  const { rows, total } = await listUsers(\n    {\n      role: roleFilter,\n      status: query.status,\n      gradeLevelId: query.gradeLevelId,\n      q: query.q,\n      includeArchived: query.includeArchived === 'true',\n    },\n    { skip, take },\n  );\n\n  return paginated(rows, { page, pageSize, total });\n});\n\nexport const POST = withHandler(async (request: Request) => {\n  const actor = await requireRole('ADMIN');\n  const json = await request.json();\n  const input = createUserSchema.parse(json);\n\n  const user = await createUser(input);\n  await audit({ actorId: actor.id, action: 'user.created', entityType: 'User', entityId: user.id });\n\n  return ok(user, { status: 201 });\n});\n  return json;\n}\n\ninterface FormState {\n  id?: string;\n  gradeLevelId: string;\n  name: string;\n  homeroomTeacher: UserPickerOption | null;\n  roomId: string;\n  capacity: string;\n}\nconst emptyForm: FormState = { gradeLevelId: '', name: '', homeroomTeacher: null, roomId: '', capacity: '30' };\n\nexport function SectionsClient({\n  years,\n  currentYearId,\n  gradeLevels,\n  rooms,\n  initialRows,\n  initialTotal,\n}: {\n  years: YearOption[];\n  currentYearId: string | null;\n  gradeLevels: Option[];\n  rooms: Option[];\n  initialRows: SectionRow[];\n  initialTotal: number;\n}) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  const { showToast } = useToast();\n  const yearId = searchParams.get('academicYearId') ?? currentYearId ?? '';\n\n  const [rows, setRows] = useState(initialRows);\n  const [total, setTotal] = useState(initialTotal);\n  const [loading, setLoading] = useState(false);\n  const [form, setForm] = useState<FormState | null>(null);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [saving, setSaving] = useState(false);\n  const [toDelete, setToDelete] = useState<SectionRow | null>(null);\n  const [confirmCopy, setConfirmCopy] = useState(false);\n\n  const copyTarget = years.find((y) => y.isCopyTarget && y.id !== yearId) ?? null;\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const params = new URLSearchParams(searchParams.toString());\n      if (yearId) params.set('academicYearId', yearId);\n      const json = await send(`/api/sections?${params.toString()}`, 'GET');\n      setRows(json.data);\n      setTotal(json.meta.total);\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setLoading(false);\n    }\n  }, [searchParams, yearId, showToast]);\n\n  useEffect(() => {\n    void load();\n  }, [load]);\n\n  const setYear = (id: string) => {\n    const next = new URLSearchParams(searchParams.toString());\n    next.set('academicYearId', id);\n    next.set('page', '1');\n    router.push(`${pathname}?${next.toString()}`);\n  };\n\n  const openEdit = (row: SectionRow) =>\n    setForm({\n      id: row.id,\n      gradeLevelId: row.gradeLevelId,\n      name: row.name,\n      homeroomTeacher: row.homeroomTeacher\n        ? { id: row.homeroomTeacher.id, name: row.homeroomTeacher.name, email: '', role: 'TEACHER' }\n        : null,\n      roomId: row.roomId ?? '',\n      capacity: String(row.capacity),\n    });\n\n  const save = async () => {\n    if (!form) return;\n    const payload = {\n      academicYearId: yearId,\n      gradeLevelId: form.gradeLevelId,\n      name: form.name,\n      homeroomTeacherId: form.homeroomTeacher?.id ?? null,\n      roomId: form.roomId || null,\n      capacity: form.capacity,\n    };\n    const parsed = sectionInputSchema.safeParse(payload);\n    if (!parsed.success) {\n      const fieldErrors = parsed.error.flatten().fieldErrors;\n      setErrors(Object.fromEntries(Object.entries(fieldErrors).map(([k, v]) => [k, v?.[0] ?? ''])));\n      return;\n    }\n    setErrors({});\n    setSaving(true);\n    try {\n      if (form.id) {\n        const { academicYearId: _ignored, ...update } = parsed.data;\n        await send(`/api/sections/${form.id}`, 'PATCH', update);\n      } else {\n        await send('/api/sections', 'POST', parsed.data);\n      }\n      showToast({ message: form.id ? 'Section updated' : 'Section created', severity: 'success' });\n      setForm(null);\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const remove = async () => {\n    if (!toDelete) return;\n    try {\n      await send(`/api/sections/${toDelete.id}`, 'DELETE');\n      showToast({ message: `Section ${toDelete.name} deleted`, severity: 'success' });\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setToDelete(null);\n    }\n  };\n\n  const copy = async () => {\n    if (!copyTarget) return;\n    try {\n      const json = await send('/api/sections/copy-to-year', 'POST', { fromYearId: yearId, toYearId: copyTarget.id });\n      const skipped = json.data.skipped as { name: string; reason: string }[];\n      showToast({\n        message: `Copied ${json.data.created} section(s) to ${copyTarget.name}.${\n          skipped.length ? ` Skipped: ${skipped.map((s) => `${s.name} (${s.reason})`).join(', ')}` : ''\n        }`,\n        severity: skipped.length ? 'warning' : 'success',","is_error":false}]},"parent_tool_use_id":null,"session_id":"653415d5-c55b-4ee5-8732-58d466d2d849","uuid":"e3c5418b-5487-4123-be58-6e0006bc1e0c","timestamp":"2026-11-04T07:07:39.327Z","tool_use_result":{"stdout":"import { prisma } from '@/server/db';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { getCurrentAcademicYear } from '@/server/services/academicYears';\nimport { isCopyTargetYear, listSections } from '@/server/sections/sections-service';\nimport { SectionsClient } from './SectionsClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /admin/sections — PRD-05 FR-2/FR-3/FR-6. */\nexport default async function SectionsPage() {\n  await requirePageRole('ADMIN');\n  const [years, gradeLevels, rooms, current] = await Promise.all([\n    prisma.academicYear.findMany({ orderBy: { startDate: 'asc' } }),\n    prisma.gradeLevel.findMany({ where: { archivedAt: null }, orderBy: { order: 'asc' } }),\n    prisma.room.findMany({ where: { archivedAt: null }, orderBy: { name: 'asc' } }),\n    getCurrentAcademicYear(),\n  ]);\n  const initial = await listSections({}, { skip: 0, take: 20 });\n\n  return (\n    <SectionsClient\n      years={years.map((y) => ({ id: y.id, name: y.name, isCurrent: y.isCurrent, isCopyTarget: isCopyTargetYear(y) }))}\n      currentYearId={current?.id ?? null}\n      gradeLevels={gradeLevels.map((g) => ({ id: g.id, name: g.name }))}\n      rooms={rooms.map((r) => ({ id: r.id, name: r.name }))}\n      initialRows={JSON.parse(JSON.stringify(initial.rows))}\n      initialTotal={initial.total}\n    />\n  );\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" alignItems=\"flex-start\" justifyContent=\"space-between\" spacing={2}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" fontWeight={600}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      alignItems=\"center\"\n      justifyContent=\"center\"\n      spacing={1.5}\n      sx={{ py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}\n'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport TextField from '@mui/material/TextField';\nimport InputAdornment from '@mui/material/InputAdornment';\nimport SearchIcon from '@mui/icons-material/Search';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface DataTableProps {\n  columns: GridColDef[];\n  rows: readonly Record<string, unknown>[];\n  total: number;\n  loading?: boolean;\n  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n  getRowId?: (row: Record<string, unknown>) => string | number;\n}\n\n/**\n * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n * from (and written to) URL query params, a debounced search box, and the\n * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n * params change — this component owns no fetch logic of its own.\n */\nexport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const sortField = searchParams.get('sort') ?? undefined;\n  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n\n  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n\n  const updateParams = useCallback(\n    (updates: Record<string, string | undefined>) => {\n      const next = new URLSearchParams(searchParams.toString());\n      for (const [key, value] of Object.entries(updates)) {\n        if (value === undefined || value === '') {\n          next.delete(key);\n        } else {\n          next.set(key, value);\n        }\n      }\n      router.push(`${pathname}?${next.toString()}`);\n    },\n    [pathname, router, searchParams],\n  );\n\n  // Debounce search -> URL param, resetting to page 1.\n  useEffect(() => {\n    const handle = setTimeout(() => {\n      if (searchInput !== (searchParams.get('q') ?? '')) {\n        updateParams({ q: searchInput || undefined, page: '1' });\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [searchInput]);\n\n  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n\n  return (\n    <Box>\n      <TextField\n        value={searchInput}\n        onChange={(event) => setSearchInput(event.target.value)}\n        placeholder=\"Search…\"\n        size=\"small\"\n        sx={{ mb: 2, maxWidth: 320 }}\n        InputProps={{\n          startAdornment: (\n            <InputAdornment position=\"start\">\n              <SearchIcon fontSize=\"small\" />\n            </InputAdornment>\n          ),\n        }}\n        inputProps={{ 'aria-label': 'Search' }}\n      />\n      <DataGrid\n        autoHeight\n        columns={columns}\n        rows={rows}\n        rowCount={total}\n        loading={loading}\n        getRowId={getRowId}\n        paginationMode=\"server\"\n        sortingMode=\"server\"\n        paginationModel={{ page: page - 1, pageSize }}\n        onPaginationModelChange={(model) =>\n          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n        }\n        sortModel={sortModel}\n        onSortModelChange={(model) =>\n          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n        }\n        pageSizeOptions={[10, 20, 50, 100]}\n        slots={{\n          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n        }}\n        disableRowSelectionOnClick\n      />\n    </Box>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport { ok, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { archiveUser } from '@/server/services/users';\n\n/** POST /api/users/:id/archive — ADMIN only (FR-13, FR-14). Same self/last-admin guard as /status. */\nexport const POST = withHandler(async (_request: Request, { params }: { params: { id: string } }) => {\n  const actor = await requireRole('ADMIN');\n  const user = await archiveUser(actor.id, params.id);\n  await audit({ actorId: actor.id, action: 'user.archived', entityType: 'User', entityId: params.id });\n  return ok(user);\n});\nimport { z } from 'zod';\nimport { ok, paginated, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { createUser, listUsers } from '@/server/services/users';\nimport { createUserSchema, ROLE_VALUES } from '@/lib/validators/users';\n\nconst listQuerySchema = z.object({\n  role: z.string().optional(),\n  status: z.enum(['ACTIVE', 'INVITED', 'DISABLED', 'ARCHIVED']).optional(),\n  gradeLevelId: z.string().optional(),\n  q: z.string().optional(),\n  includeArchived: z.enum(['true', 'false']).optional(),\n});\n\n/** GET/POST /api/users — ADMIN only (FR-2, FR-3, FR-6..FR-10, NFR-2). */\nexport const GET = withHandler(async (request: Request) => {\n  await requireRole('ADMIN');\n\n  const url = new URL(request.url);\n  const query = parseQuery(url.searchParams, listQuerySchema);\n  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n\n  const roleFilter = query.role\n    ? query.role\n        .split(',')\n        .map((value) => value.trim())\n        .filter((value): value is (typeof ROLE_VALUES)[number] => ROLE_VALUES.includes(value as never))\n    : undefined;\n\n  const { rows, total } = await listUsers(\n    {\n      role: roleFilter,\n      status: query.status,\n      gradeLevelId: query.gradeLevelId,\n      q: query.q,\n      includeArchived: query.includeArchived === 'true',\n    },\n    { skip, take },\n  );\n\n  return paginated(rows, { page, pageSize, total });\n});\n\nexport const POST = withHandler(async (request: Request) => {\n  const actor = await requireRole('ADMIN');\n  const json = await request.json();\n  const input = createUserSchema.parse(json);\n\n  const user = await createUser(input);\n  await audit({ actorId: actor.id, action: 'user.created', entityType: 'User', entityId: user.id });\n\n  return ok(user, { status: 201 });\n});\n  return json;\n}\n\ninterface FormState {\n  id?: string;\n  gradeLevelId: string;\n  name: string;\n  homeroomTeacher: UserPickerOption | null;\n  roomId: string;\n  capacity: string;\n}\nconst emptyForm: FormState = { gradeLevelId: '', name: '', homeroomTeacher: null, roomId: '', capacity: '30' };\n\nexport function SectionsClient({\n  years,\n  currentYearId,\n  gradeLevels,\n  rooms,\n  initialRows,\n  initialTotal,\n}: {\n  years: YearOption[];\n  currentYearId: string | null;\n  gradeLevels: Option[];\n  rooms: Option[];\n  initialRows: SectionRow[];\n  initialTotal: number;\n}) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  const { showToast } = useToast();\n  const yearId = searchParams.get('academicYearId') ?? currentYearId ?? '';\n\n  const [rows, setRows] = useState(initialRows);\n  const [total, setTotal] = useState(initialTotal);\n  const [loading, setLoading] = useState(false);\n  const [form, setForm] = useState<FormState | null>(null);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [saving, setSaving] = useState(false);\n  const [toDelete, setToDelete] = useState<SectionRow | null>(null);\n  const [confirmCopy, setConfirmCopy] = useState(false);\n\n  const copyTarget = years.find((y) => y.isCopyTarget && y.id !== yearId) ?? null;\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const params = new URLSearchParams(searchParams.toString());\n      if (yearId) params.set('academicYearId', yearId);\n      const json = await send(`/api/sections?${params.toString()}`, 'GET');\n      setRows(json.data);\n      setTotal(json.meta.total);\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setLoading(false);\n    }\n  }, [searchParams, yearId, showToast]);\n\n  useEffect(() => {\n    void load();\n  }, [load]);\n\n  const setYear = (id: string) => {\n    const next = new URLSearchParams(searchParams.toString());\n    next.set('academicYearId', id);\n    next.set('page', '1');\n    router.push(`${pathname}?${next.toString()}`);\n  };\n\n  const openEdit = (row: SectionRow) =>\n    setForm({\n      id: row.id,\n      gradeLevelId: row.gradeLevelId,\n      name: row.name,\n      homeroomTeacher: row.homeroomTeacher\n        ? { id: row.homeroomTeacher.id, name: row.homeroomTeacher.name, email: '', role: 'TEACHER' }\n        : null,\n      roomId: row.roomId ?? '',\n      capacity: String(row.capacity),\n    });\n\n  const save = async () => {\n    if (!form) return;\n    const payload = {\n      academicYearId: yearId,\n      gradeLevelId: form.gradeLevelId,\n      name: form.name,\n      homeroomTeacherId: form.homeroomTeacher?.id ?? null,\n      roomId: form.roomId || null,\n      capacity: form.capacity,\n    };\n    const parsed = sectionInputSchema.safeParse(payload);\n    if (!parsed.success) {\n      const fieldErrors = parsed.error.flatten().fieldErrors;\n      setErrors(Object.fromEntries(Object.entries(fieldErrors).map(([k, v]) => [k, v?.[0] ?? ''])));\n      return;\n    }\n    setErrors({});\n    setSaving(true);\n    try {\n      if (form.id) {\n        const { academicYearId: _ignored, ...update } = parsed.data;\n        await send(`/api/sections/${form.id}`, 'PATCH', update);\n      } else {\n        await send('/api/sections', 'POST', parsed.data);\n      }\n      showToast({ message: form.id ? 'Section updated' : 'Section created', severity: 'success' });\n      setForm(null);\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const remove = async () => {\n    if (!toDelete) return;\n    try {\n      await send(`/api/sections/${toDelete.id}`, 'DELETE');\n      showToast({ message: `Section ${toDelete.name} deleted`, severity: 'success' });\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setToDelete(null);\n    }\n  };\n\n  const copy = async () => {\n    if (!copyTarget) return;\n    try {\n      const json = await send('/api/sections/copy-to-year', 'POST', { fromYearId: yearId, toYearId: copyTarget.id });\n      const skipped = json.data.skipped as { name: string; reason: string }[];\n      showToast({\n        message: `Copied ${json.data.created} section(s) to ${copyTarget.name}.${\n          skipped.length ? ` Skipped: ${skipped.map((s) => `${s.name} (${s.reason})`).join(', ')}` : ''\n        }`,\n        severity: skipped.length ? 'warning' : 'success',","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019W2Eaf4a2ueQWLK4ZgteDb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
