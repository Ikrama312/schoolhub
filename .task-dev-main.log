 parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { copySectionsToYear } from '@/server/sections/sections-service';\nimport { copyToYearSchema } from '@/lib/validators/sections';\n\n/** POST /api/sections/copy-to-year — ADMIN, structural copy only (FR-6, NFR-6). */\nexport const POST = withHandler(async (request: Request) => {\n  const actor = requireRole('ADMIN');\n  const input = await parseBody(request, copyToYearSchema);\n  return ok(await copySectionsToYear(input, actor.id), { status: 201 });\n});\nEOF\ncat > \"students/[id]/move-section/route.ts\" <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { moveStudent } from '@/server/sections/sections-service';\nimport { moveSectionSchema } from '@/lib/validators/sections';\n\n/** POST /api/students/:id/move-section — ADMIN, one transaction (FR-9). */\nexport const POST = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const actor = requireRole('ADMIN');\n  const input = await parseBody(request, moveSectionSchema);\n  return ok(await moveStudent(params.id, input, actor.id));\n});\nEOF\ncat > courses/route.ts <<'EOF'\nimport { ok, paginated, parseBody, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { createCourse, listCourses } from '@/server/courses/courses-service';\nimport { courseInputSchema, coursesListQuerySchema } from '@/lib/validators/courses';\n\n/** GET /api/courses (any role, scoped in the service) · POST /api/courses (ADMIN) — FR-13/FR-14. */\nexport const GET = withHandler(async (request: Request) => {\n  const user = requireRole(...ALL_ROLES);\n  const url = new URL(request.url);\n  const query = parseQuery(url.searchParams, coursesListQuerySchema);\n  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n  const { rows, total } = await listCourses(user, query, { skip, take });\n  return paginated(rows, { page, pageSize, total });\n});\n\nexport const POST = withHandler(async (request: Request) => {\n  const actor = requireRole('ADMIN');\n  const input = await parseBody(request, courseInputSchema);\n  return ok(await createCourse(input, actor.id), { status: 201 });\n});\nEOF\ncat > \"courses/[id]/route.ts\" <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { getCourse, updateCourse } from '@/server/courses/courses-service';\nimport { courseUpdateSchema } from '@/lib/validators/courses';\n\ntype Ctx = { params: { id: string } };\n\n/** GET /api/courses/:id (assertCanViewCourse) · PATCH (ADMIN) — FR-14/FR-16/FR-18. */\nexport const GET = withHandler(async (_request: Request, { params }: Ctx) => {\n  const user = requireRole(...ALL_ROLES);\n  await assertCanViewCourse(user, params.id);\n  return ok(await getCourse(params.id));\n});\n\nexport const PATCH = withHandler(async (request: Request, { params }: Ctx) => {\n  const actor = requireRole('ADMIN');\n  const input = await parseBody(request, courseUpdateSchema);\n  return ok(await updateCourse(params.id, input, actor.id));\n});\nEOF\ncat > \"courses/[id]/roster/route.ts\" <<'EOF'\nimport { paginated, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { getCourseRoster } from '@/server/courses/courses-service';\nimport { rosterQuerySchema } from '@/lib/validators/courses';\n\n/** GET /api/courses/:id/roster — same getCourseRoster as the Roster tab (FR-17, NFR-4; PARENT refused there). */\nexport const GET = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const user = requireRole(...ALL_ROLES);\n  await assertCanViewCourse(user, params.id);\n  const url = new URL(request.url);\n  const query = parseQuery(url.searchParams, rosterQuerySchema);\n  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n  const { rows, total } = await getCourseRoster(params.id, user.role, query, { skip, take });\n  return paginated(rows, { page, pageSize, total });\n});\nEOF\ncat > \"courses/[id]/enrollments/route.ts\" <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { enrollStudentsInCourse } from '@/server/courses/courses-service';\nimport { enrollStudentsSchema } from '@/lib/validators/sections';\n\n/** POST /api/courses/:id/enrollments — ADMIN; refused for CORE courses (FR-15). */\nexport const POST = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const actor = requireRole('ADMIN');\n  const input = await parseBody(request, enrollStudentsSchema);\n  return ok(await enrollStudentsInCourse(params.id, input, actor.id), { status: 201 });\n});\nEOF\ncat > \"enrollments/[id]/route.ts\" <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { setEnrollmentStatus } from '@/server/courses/courses-service';\nimport { enrollmentStatusSchema } from '@/lib/validators/courses';\n\n/** PATCH /api/enrollments/:id — ADMIN; drop or reactivate (FR-12/FR-15). */\nexport const PATCH = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const actor = requireRole('ADMIN');\n  const input = await parseBody(request, enrollmentStatusSchema);\n  return ok(await setEnrollmentStatus(params.id, input, actor.id));\n});\nEOF\ncat > me/courses/route.ts <<'EOF'\nimport { ok, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { listMyCourses } from '@/server/courses/courses-service';\n\n/** GET /api/me/courses — any role (FR-19). */\nexport const GET = withHandler(async () => {\n  const user = requireRole(...ALL_ROLES);\n  return ok(await listMyCourses(user));\n});\nEOF\ncd ../../.. && npx tsc --noEmit 2>&1 | grep \"error TS\" | grep -c . ","description":"Write section/course API routes and typecheck"}}}
