{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UMvWJUWw1MCL8RAL5tN8kj","type":"tool_result","content":"1\timport { prisma } from '@/server/db';\n2\timport { AppError } from '@/server/http';\n3\timport type { Role } from '@/config/navigation';\n4\t\n5\texport interface AccessUser {\n6\t  id: string;\n7\t  role: Role;\n8\t}\n9\t\n10\texport type AccessibleStudentIds = 'ALL' | string[];\n11\t\n12\t/**\n13\t * FR-17: resolves which student ids `user` may see.\n14\t * - ADMIN: \"ALL\" (every student)\n15\t * - STUDENT: only themselves\n16\t * - PARENT: students linked via ParentStudentLink (component 6)\n17\t * - TEACHER: [] until PRD-05 adds section/course relations -- this function\n18\t *   is the one place PRD-05 extends, per FR-17's own contract.\n19\t */\n20\texport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n21\t  switch (user.role) {\n22\t    case 'ADMIN':\n23\t      return 'ALL';\n24\t    case 'STUDENT':\n25\t      return [user.id];\n26\t    case 'PARENT': {\n27\t      const links = await prisma.parentStudentLink.findMany({\n28\t        where: { parentId: user.id },\n29\t        select: { studentId: true },\n30\t      });\n31\t      return links.map((link) => link.studentId);\n32\t    }\n33\t    case 'TEACHER':\n34\t    default:\n35\t      return [];\n36\t  }\n37\t}\n38\t\n39\t/**\n40\t * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n41\t * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n42\t * not allowed to see this particular studentId -- NOT_FOUND rather than\n43\t * FORBIDDEN so existence of another family's student is never revealed.\n44\t * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n45\t * ADMIN, and TEACHER is denied everything until PRD-05).\n46\t */\n47\texport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n48\t  const accessible = await getAccessibleStudentIds(user);\n49\t\n50\t  if (accessible === 'ALL') return;\n51\t\n52\t  if (accessible.includes(studentId)) return;\n53\t\n54\t  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n55\t    throw new AppError('NOT_FOUND', 'Resource not found');\n56\t  }\n57\t\n58\t  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n59\t}\n60\t"}]},"parent_tool_use_id":null,"session_id":"e93ce62f-466e-4ebf-a57c-8fec1a196fdd","uuid":"889617e1-420d-4ec0-84df-86cf7b7dae93","timestamp":"2026-10-19T09:57:07.403Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/auth/student-access.ts","content":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\nexport interface AccessUser {\n  id: string;\n  role: Role;\n}\n\nexport type AccessibleStudentIds = 'ALL' | string[];\n\n/**\n * FR-17: resolves which student ids `user` may see.\n * - ADMIN: \"ALL\" (every student)\n * - STUDENT: only themselves\n * - PARENT: students linked via ParentStudentLink (component 6)\n * - TEACHER: [] until PRD-05 adds section/course relations -- this function\n *   is the one place PRD-05 extends, per FR-17's own contract.\n */\nexport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n  switch (user.role) {\n    case 'ADMIN':\n      return 'ALL';\n    case 'STUDENT':\n      return [user.id];\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({\n        where: { parentId: user.id },\n        select: { studentId: true },\n      });\n      return links.map((link) => link.studentId);\n    }\n    case 'TEACHER':\n    default:\n      return [];\n  }\n}\n\n/**\n * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n * not allowed to see this particular studentId -- NOT_FOUND rather than\n * FORBIDDEN so existence of another family's student is never revealed.\n * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN, and TEACHER is denied everything until PRD-05).\n */\nexport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n  const accessible = await getAccessibleStudentIds(user);\n\n  if (accessible === 'ALL') return;\n\n  if (accessible.includes(studentId)) return;\n\n  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n    throw new AppError('NOT_FOUND', 'Resource not found');\n  }\n\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n}\n","numLines":60,"startLine":1,"totalLines":60}}}
