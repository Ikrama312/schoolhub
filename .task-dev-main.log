s.code, color: s.color }))}\n      sections={sections}\n      initialRows={JSON.parse(JSON.stringify(initial.rows))}\n      initialTotal={initial.total}\n    />\n  );\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01KfTzVbAAMUxQXU1Vhkiog7","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgT62dNaevcY6traWh5Yw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YYknDPw1SZ2beMZXD3UUnR","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/(app)/admin/courses/CoursesClient.tsx","content":"'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport Link from 'next/link';\nimport { usePathname, useRouter, useSearchParams } from 'next/navigation';\nimport type { GridColDef } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Dialog from '@mui/material/Dialog';\nimport DialogActions from '@mui/material/DialogActions';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport IconButton from '@mui/material/IconButton';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport Switch from '@mui/material/Switch';\nimport TextField from '@mui/material/TextField';\nimport Tooltip from '@mui/material/Tooltip';\nimport AddIcon from '@mui/icons-material/Add';\nimport EditOutlinedIcon from '@mui/icons-material/EditOutlined';\nimport { DataTable } from '@/components/DataTable/DataTable';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { UserPicker, type UserPickerOption } from '@/components/UserPicker/UserPicker';\nimport { useToast } from '@/components/Toast/useToast';\nimport { courseInputSchema, courseUpdateSchema, defaultCourseCode, defaultCourseName } from '@/lib/validators/courses';\n\ninterface Option {\n  id: string;\n  name: string;\n}\ninterface SubjectOption extends Option {\n  code: string;\n  color: string;\n}\ninterface SectionOption extends Option {\n  academicYearId: string;\n  gradeLevelId: string;\n}\nexport interface CourseRow {\n  id: string;\n  code: string;\n  name: string;\n  kind: 'CORE' | 'ELECTIVE';\n  subjectId: string;\n  sectionId: string | null;\n  capacity: number | null;\n  description: string | null;\n  archivedAt: string | null;\n  subject: SubjectOption;\n  section: Option | null;\n  teacher: Option;\n  coTeachers: Option[];\n  enrolledCount: number;\n}\n\nasync function send(url: string, method: string, body?: unknown) {\n  const res = await fetch(url, {\n    method,\n    headers: { 'Content-Type': 'application/json' },\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const json = await res.json().catch(() => ({}));\n  if (!res.ok) throw new Error(json?.error?.message ?? 'Request failed');\n  return json;\n}\n\nconst asPickerOption = (u: Option): UserPickerOption => ({ id: u.id, name: u.name, email: '', role: 'TEACHER' });\n\ninterface FormState {\n  id?: string;\n  subjectId: string;\n  sectionId: string;\n  teacher: UserPickerOption | null;\n  coTeachers: UserPickerOption[];\n  name: string;\n  code: string;\n  kind: 'CORE' | 'ELECTIVE';\n  capacity: string;\n  description: string;\n  archived: boolean;\n}\nconst emptyForm: FormState = {\n  subjectId: '',\n  sectionId: '',\n  teacher: null,\n  coTeachers: [],\n  name: '',\n  code: '',\n  kind: 'CORE',\n  capacity: '',\n  description: '',\n  archived: false,\n};\n\nexport function CoursesClient({\n  years,\n  currentYearId,\n  gradeLevels,\n  subjects,\n  sections,\n  initialRows,\n  initialTotal,\n}: {\n  years: (Option & { isCurrent: boolean })[];\n  currentYearId: string | null;\n  gradeLevels: Option[];\n  subjects: SubjectOption[];\n  sections: SectionOption[];\n  initialRows: CourseRow[];\n  initialTotal: number;\n}) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  const { showToast } = useToast();\n  const yearId = searchParams.get('academicYearId') ?? currentYearId ?? '';\n\n  const [rows, setRows] = useState(initialRows);\n  const [total, setTotal] = useState(initialTotal);\n  const [loading, setLoading] = useState(false);\n  const [teacherFilter, setTeacherFilter] = useState<UserPickerOption | null>(null);\n  const [form, setForm] = useState<FormState | null>(null);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [saving, setSaving] = useState(false);\n\n  const yearSections = sections.filter((s) => s.academicYearId === yearId);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const params = new URLSearchParams(searchParams.toString());\n      if (yearId) params.set('academicYearId', yearId);\n      const json = await send(`/api/courses?${params.toString()}`, 'GET');\n      setRows(json.data);\n      setTotal(json.meta.total);\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setLoading(false);\n    }\n  }, [searchParams, yearId, showToast]);\n\n  useEffect(() => {\n    void load();\n  }, [load]);\n\n  const setFilter = (key: string, value: string | undefined) => {\n    const next = new URLSearchParams(searchParams.toString());\n    if (value) next.set(key, value);\n    else next.delete(key);\n    next.set('page', '1');\n    router.push(`${pathname}?${next.toString()}`);\n  };\n\n  /** Auto-fill name/code from subject + section until the admin types their own. */\n  const withDefaults = (next: FormState, prev: FormState): FormState => {\n    if (next.id) return next;\n    const subject = subjects.find((s) => s.id === next.subjectId);\n    if (!subject) return next;\n    const sectionName = (id: string) => yearSections.find((s) => s.id === id)?.name ?? null;\n    const prevSubject = subjects.find((s) => s.id === prev.subjectId);\n    const prevName = prevSubject ? defaultCourseName(prevSubject.name, sectionName(prev.sectionId)) : '';\n    const prevCode = prevSubject ? defaultCourseCode(prevSubject.code, sectionName(prev.sectionId)) : '';\n    return {\n      ...next,\n      name: !prev.name || prev.name === prevName ? defaultCourseName(subject.name, sectionName(next.sectionId)) : next.name,\n      code: !prev.code || prev.code === prevCode ? defaultCourseCode(subject.code, sectionName(next.sectionId)) : next.code,\n    };\n  };\n  const patchForm = (patch: Partial<FormState>) => form && setForm(withDefaults({ ...form, ...patch }, form));\n\n  const openEdit = (row: CourseRow) => {\n    setErrors({});\n    setForm({\n      id: row.id,\n      subjectId: row.subjectId,\n      sectionId: row.sectionId ?? '',\n      teacher: asPickerOption(row.teacher),\n      coTeachers: row.coTeachers.map(asPickerOption),\n      name: row.name,\n      code: row.code,\n      kind: row.kind,\n      capacity: row.capacity == null ? '' : String(row.capacity),\n      description: row.description ?? '',\n      archived: Boolean(row.archivedAt),\n    });\n  };\n\n  const save = async () => {\n    if (!form) return;\n    const common = {\n      subjectId: form.subjectId,\n      teacherId: form.teacher?.id ?? '',\n      coTeacherIds: form.coTeachers.map((t) => t.id),\n      name: form.name,\n      code: form.code,\n      capacity: form.capacity,\n      description: form.description,\n    };\n    const parsed = form.id\n      ? courseUpdateSchema.safeParse({ ...common, archived: form.archived })\n      : courseInputSchema.safeParse({ ...common, academicYearId: yearId, sectionId: form.sectionId, kind: form.kind });\n    if (!parsed.success) {\n      const fieldErrors = parsed.error.flatten().fieldErrors as Record<string, string[] | undefined>;\n      setErrors(Object.fromEntries(Object.entries(fieldErrors).map(([k, v]) => [k, v?.[0] ?? ''])));\n      return;\n    }\n    setErrors({});\n    setSaving(true);\n    try {\n      if (form.id) await send(`/api/courses/${form.id}`, 'PATCH', parsed.data);\n      else await send('/api/courses', 'POST', parsed.data);\n      showToast({ message: form.id ? 'Course updated' : 'Course created', severity: 'success' });\n      setForm(null);\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const columns: GridColDef[] = [\n    {\n      field: 'code',\n      headerName: 'Code',\n      flex: 1,\n      renderCell: ({ row }) => <Link href={`/admin/courses/${row.id}/enrollment`}>{row.code}</Link>,\n    },\n    { field: 'name', headerName: 'Name', flex: 1.5 },\n    {\n      field: 'subject',\n      headerName: 'Subject',\n      flex: 1,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Chip size=\"small\" label={row.subject.name} sx={{ bgcolor: row.subject.color, color: '#fff' }} />\n      ),\n    },\n    { field: 'section', headerName: 'Section', flex: 0.8, sortable: false, valueGetter: (_v, row) => row.section?.name ?? '—' },\n    { field: 'teacher', headerName: 'Teacher', flex: 1.2, sortable: false, valueGetter: (_v, row) => row.teacher.name },\n    { field: 'enrolledCount', headerName: 'Enrolled', flex: 0.7 },\n    {\n      field: 'kind',\n      headerName: 'Kind',\n      flex: 0.8,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Stack direction=\"row\" spacing={0.5} sx={{ alignItems: 'center', height: '100%' }}>\n          <Chip size=\"small\" variant=\"outlined\" label={row.kind} />\n          {row.archivedAt && <Chip size=\"small\" label=\"Archived\" />}\n        </Stack>\n      ),\n    },\n    {\n      field: 'actions',\n      headerName: '',\n      width: 60,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Tooltip title=\"Edit\">\n          <IconButton size=\"small\" aria-label={`Edit ${row.code}`} onClick={() => openEdit(row)}>\n            <EditOutlinedIcon fontSize=\"small\" />\n          </IconButton>\n        </Tooltip>\n      ),\n    },\n  ];\n\n  const filterSelect = (key: string, label: string, options: Option[], minWidth = 160) => (\n    <TextField\n      select\n      size=\"small\"\n      label={label}\n      value={searchParams.get(key) ?? ''}\n      onChange={(e) => setFilter(key, e.target.value || undefined)}\n      sx={{ minWidth }}\n    >\n      <MenuItem value=\"\">All</MenuItem>\n      {options.map((o) => (\n        <MenuItem key={o.id} value={o.id}>\n          {o.name}\n        </MenuItem>\n      ))}\n    </TextField>\n  );\n\n  return (\n    <Box>\n      <PageHeader\n        title=\"Courses\"\n        breadcrumbs={[{ label: 'Administration' }, { label: 'Courses' }]}\n        actions={\n          <Button\n            variant=\"contained\"\n            startIcon={<AddIcon />}\n            disabled={!yearId}\n            onClick={() => {\n              setErrors({});\n              setForm(emptyForm);\n            }}\n          >\n            New course\n          </Button>\n        }\n      />\n\n      <Stack direction={{ xs: 'column', md: 'row' }} spacing={2} sx={{ mb: 2, flexWrap: 'wrap' }} useFlexGap>\n        <TextField\n          select\n          size=\"small\"\n          label=\"Academic year\"\n          value={yearId}\n          onChange={(e) => setFilter('academicYearId', e.target.value)}\n          sx={{ minWidth: 200 }}\n        >\n          {years.map((y) => (\n            <MenuItem key={y.id} value={y.id}>\n              {y.name}\n              {y.isCurrent ? ' (current)' : ''}\n            </MenuItem>\n          ))}\n        </TextField>\n        {filterSelect('gradeLevelId', 'Grade', gradeLevels)}\n        {filterSelect('subjectId', 'Subject', subjects)}\n        {filterSelect('kind', 'Kind', [\n          { id: 'CORE', name: 'Core' },\n          { id: 'ELECTIVE', name: 'Elective' },\n        ], 130)}\n        <Box sx={{ minWidth: 240 }}>\n          <UserPicker\n            label=\"Teacher\"\n            role=\"TEACHER\"\n            value={teacherFilter}\n            onChange={(v) => {\n              const teacher = (v as UserPickerOption | null) ?? null;\n              setTeacherFilter(teacher);\n              setFilter('teacherId', teacher?.id);\n            }}\n          />\n        </Box>\n        <FormControlLabel\n          control={\n            <Switch\n              checked={searchParams.get('includeArchived') === 'true'}\n              onChange={(e) => setFilter('includeArchived', e.target.checked ? 'true' : undefined)}\n            />\n          }\n          label=\"Show archived\"\n        />\n      </Stack>\n\n      <DataTable columns={columns} rows={rows as never} total={total} loading={loading} />\n\n      <Dialog open={Boolean(form)} onClose={() => setForm(null)} fullWidth maxWidth=\"sm\">\n        <DialogTitle>{form?.id ? 'Edit course' : 'New course'}</DialogTitle>\n        {form && (\n          <DialogContent>\n            <Stack spacing={2} sx={{ mt: 1 }}>\n              <TextField\n                select\n                label=\"Kind\"\n                value={form.kind}\n                disabled={Boolean(form.id)}\n                onChange={(e) => patchForm({ kind: e.target.value as FormState['kind'] })}\n                helperText={form.id ? 'Kind cannot change after creation.' : undefined}\n              >\n                <MenuItem value=\"CORE\">Core (section-wide)</MenuItem>\n                <MenuItem value=\"ELECTIVE\">Elective (direct enrollment)</MenuItem>\n              </TextField>\n              <TextField\n                select\n                label=\"Subject\"\n                value={form.subjectId}\n                onChange={(e) => patchForm({ subjectId: e.target.value })}\n                error={Boolean(errors.subjectId)}\n                helperText={errors.subjectId}\n              >\n                {subjects.map((s) => (\n                  <MenuItem key={s.id} value={s.id}>\n                    {s.name}\n                  </MenuItem>\n                ))}\n              </TextField>\n              <TextField\n                select\n                label={form.kind === 'CORE' ? 'Section' : 'Section (optional)'}\n                value={form.sectionId}\n                disabled={Boolean(form.id)}\n                onChange={(e) => patchForm({ sectionId: e.target.value })}\n                error={Boolean(errors.sectionId)}\n                helperText={errors.sectionId ?? (form.id ? 'Section cannot change after creation.' : undefined)}\n              >\n                <MenuItem value=\"\">None</MenuItem>\n                {yearSections.map((s) => (\n                  <MenuItem key={s.id} value={s.id}>\n                    {s.name}\n                  </MenuItem>\n                ))}\n              </TextField>\n              <UserPicker\n                label=\"Teacher\"\n                role=\"TEACHER\"\n                value={form.teacher}\n                onChange={(v) => patchForm({ teacher: (v as UserPickerOption | null) ?? null })}\n                error={Boolean(errors.teacherId)}\n                helperText={errors.teacherId}\n              />\n              <UserPicker\n                label=\"Co-teachers\"\n                role=\"TEACHER\"\n                multiple\n                value={form.coTeachers}\n                onChange={(v) => patchForm({ coTeachers: (v as UserPickerOption[]) ?? [] })}\n                error={Boolean(errors.coTeacherIds)}\n                helperText={errors.coTeacherIds ?? 'Up to 3'}\n              />\n              <TextField\n                label=\"Name\"\n                value={form.name}\n                onChange={(e) => patchForm({ name: e.target.value })}\n                error={Boolean(errors.name)}\n                helperText={errors.name}\n              />\n              <TextField\n                label=\"Code\"\n                value={form.code}\n                onChange={(e) => patchForm({ code: e.target.value.toUpperCase() })}\n                error={Boolean(errors.code)}\n                helperText={errors.code ?? 'Unique within the academic year'}\n              />\n              <TextField\n                label=\"Capacity\"\n                type=\"number\"\n                value={form.capacity}\n                onChange={(e) => patchForm({ capacity: e.target.value })}\n                error={Boolean(errors.capacity)}\n                helperText={errors.capacity ?? 'Leave blank for no limit'}\n                slotProps={{ htmlInput: { min: 1 } }}\n              />\n              <TextField\n                label=\"Description\"\n                multiline\n                minRows={2}\n                value={form.description}\n                onChange={(e) => patchForm({ description: e.target.value })}\n              />\n              {form.id && (\n                <FormControlLabel\n                  control={<Switch checked={form.archived} onChange={(e) => patchForm({ archived: e.target.checked })} />}\n                  label=\"Archived\"\n                />\n              )}\n            </Stack>\n          </DialogContent>\n        )}\n        <DialogActions>\n          <Button onClick={() => setForm(null)} disabled={saving}>\n            Cancel\n          </Button>\n          <Button variant=\"contained\" onClick={save} disabled={saving}>\n            Save\n          </Button>\n        </DialogActions>\n      </Dialog>\n    </Box>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":624,"cache_read_input_tokens":104700,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":624},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"54bd42a3-8a1d-4cdc-9b8c-eac7d8beec43","timestamp":"2026-10-27T16:52:04.536Z","request_id":"req_011CgT62d8BxuaxKnv7TwaFV","wire_tool_inputs":{"toolu_01YYknDPw1SZ2beMZXD3UUnR":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/(app)/admin/courses/CoursesClient.tsx","content":"'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport Link from 'next/link';\nimport { usePathname, useRouter, useSearchParams } from 'next/navigation';\nimport type { GridColDef } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Dialog from '@mui/material/Dialog';\nimport DialogActions from '@mui/material/DialogActions';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport IconButton from '@mui/material/IconButton';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport Switch from '@mui/material/Switch';\nimport TextField from '@mui/material/TextField';\nimport Tooltip from '@mui/material/Tooltip';\nimport AddIcon from '@mui/icons-material/Add';\nimport EditOutlinedIcon from '@mui/icons-material/EditOutlined';\nimport { DataTable } from '@/components/DataTable/DataTable';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { UserPicker, type UserPickerOption } from '@/components/UserPicker/UserPicker';\nimport { useToast } from '@/components/Toast/useToast';\nimport { courseInputSchema, courseUpdateSchema, defaultCourseCode, defaultCourseName } from '@/lib/validators/courses';\n\ninterface Option {\n  id: string;\n  name: string;\n}\ninterface SubjectOption extends Option {\n  code: string;\n  color: string;\n}\ninterface SectionOption extends Option {\n  academicYearId: string;\n  gradeLevelId: string;\n}\nexport interface CourseRow {\n  id: string;\n  code: string;\n  name: string;\n  kind: 'CORE' | 'ELECTIVE';\n  subjectId: string;\n  sectionId: string | null;\n  capacity: number | null;\n  description: string | null;\n  archivedAt: string | null;\n  subject: SubjectOption;\n  section: Option | null;\n  teacher: Option;\n  coTeachers: Option[];\n  enrolledCount: number;\n}\n\nasync function send(url: string, method: string, body?: unknown) {\n  const res = await fetch(url, {\n    method,\n    headers: { 'Content-Type': 'application/json' },\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const json = await res.json().catch(() => ({}));\n  if (!res.ok) throw new Error(json?.error?.message ?? 'Request failed');\n  return json;\n}\n\nconst asPickerOption = (u: Option): UserPickerOption => ({ id: u.id, name: u.name, email: '', role: 'TEACHER' });\n\ninterface FormState {\n  id?: string;\n  subjectId: string;\n  sectionId: string;\n  teacher: UserPickerOption | null;\n  coTeachers: UserPickerOption[];\n  name: string;\n  code: string;\n  kind: 'CORE' | 'ELECTIVE';\n  capacity: string;\n  description: string;\n  archived: boolean;\n}\nconst emptyForm: FormState = {\n  subjectId: '',\n  sectionId: '',\n  teacher: null,\n  coTeachers: [],\n  name: '',\n  code: '',\n  kind: 'CORE',\n  capacity: '',\n  description: '',\n  archived: false,\n};\n\nexport function CoursesClient({\n  years,\n  currentYearId,\n  gradeLevels,\n  subjects,\n  sections,\n  initialRows,\n  initialTotal,\n}: {\n  years: (Option & { isCurrent: boolean })[];\n  currentYearId: string | null;\n  gradeLevels: Option[];\n  subjects: SubjectOption[];\n  sections: SectionOption[];\n  initialRows: CourseRow[];\n  initialTotal: number;\n}) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  const { showToast } = useToast();\n  const yearId = searchParams.get('academicYearId') ?? currentYearId ?? '';\n\n  const [rows, setRows] = useState(initialRows);\n  const [total, setTotal] = useState(initialTotal);\n  const [loading, setLoading] = useState(false);\n  const [teacherFilter, setTeacherFilter] = useState<UserPickerOption | null>(null);\n  const [form, setForm] = useState<FormState | null>(null);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [saving, setSaving] = useState(false);\n\n  const yearSections = sections.filter((s) => s.academicYearId === yearId);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const params = new URLSearchParams(searchParams.toString());\n      if (yearId) params.set('academicYearId', yearId);\n      const json = await send(`/api/courses?${params.toString()}`, 'GET');\n      setRows(json.data);\n      setTotal(json.meta.total);\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setLoading(false);\n    }\n  }, [searchParams, yearId, showToast]);\n\n  useEffect(() => {\n    void load();\n  }, [load]);\n\n  const setFilter = (key: string, value: string | undefined) => {\n    const next = new URLSearchParams(searchParams.toString());\n    if (value) next.set(key, value);\n    else next.delete(key);\n    next.set('page', '1');\n    router.push(`${pathname}?${next.toString()}`);\n  };\n\n  /** Auto-fill name/code from subject + section until the admin types their own. */\n  const withDefaults = (next: FormState, prev: FormState): FormState => {\n    if (next.id) return next;\n    const subject = subjects.find((s) => s.id === next.subjectId);\n    if (!subject) return next;\n    const sectionName = (id: string) => yearSections.find((s) => s.id === id)?.name ?? null;\n    const prevSubject = subjects.find((s) => s.id === prev.subjectId);\n    const prevName = prevSubject ? defaultCourseName(prevSubject.name, sectionName(prev.sectionId)) : '';\n    const prevCode = prevSubject ? defaultCourseCode(prevSubject.code, sectionName(prev.sectionId)) : '';\n    return {\n      ...next,\n      name: !prev.name || prev.name === prevName ? defaultCourseName(subject.name, sectionName(next.sectionId)) : next.name,\n      code: !prev.code || prev.code === prevCode ? defaultCourseCode(subject.code, sectionName(next.sectionId)) : next.code,\n    };\n  };\n  const patchForm = (patch: Partial<FormState>) => form && setForm(withDefaults({ ...form, ...patch }, form));\n\n  const openEdit = (row: CourseRow) => {\n    setErrors({});\n    setForm({\n      id: row.id,\n      subjectId: row.subjectId,\n      sectionId: row.sectionId ?? '',\n      teacher: asPickerOption(row.teacher),\n      coTeachers: row.coTeachers.map(asPickerOption),\n      name: row.name,\n      code: row.code,\n      kind: row.kind,\n      capacity: row.capacity == null ? '' : String(row.capacity),\n      description: row.description ?? '',\n      archived: Boolean(row.archivedAt),\n    });\n  };\n\n  const save = async () => {\n    if (!form) return;\n    const common = {\n      subjectId: form.subjectId,\n      teacherId: form.teacher?.id ?? '',\n      coTeacherIds: form.coTeachers.map((t) => t.id),\n      name: form.name,\n      code: form.code,\n      capacity: form.capacity,\n      description: form.description,\n    };\n    const parsed = form.id\n      ? courseUpdateSchema.safeParse({ ...common, archived: form.archived })\n      : courseInputSchema.safeParse({ ...common, academicYearId: yearId, sectionId: form.sectionId, kind: form.kind });\n    if (!parsed.success) {\n      const fieldErrors = parsed.error.flatten().fieldErrors as Record<string, string[] | undefined>;\n      setErrors(Object.fromEntries(Object.entries(fieldErrors).map(([k, v]) => [k, v?.[0] ?? ''])));\n      return;\n    }\n    setErrors({});\n    setSaving(true);\n    try {\n      if (form.id) await send(`/api/courses/${form.id}`, 'PATCH', parsed.data);\n      else await send('/api/courses', 'POST', parsed.data);\n      showToast({ message: form.id ? 'Course updated' : 'Course created', severity: 'success' });\n      setForm(null);\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const columns: GridColDef[] = [\n    {\n      field: 'code',\n      headerName: 'Code',\n      flex: 1,\n      renderCell: ({ row }) => <Link href={`/admin/courses/${row.id}/enrollment`}>{row.code}</Link>,\n    },\n    { field: 'name', headerName: 'Name', flex: 1.5 },\n    {\n      field: 'subject',\n      headerName: 'Subject',\n      flex: 1,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Chip size=\"small\" label={row.subject.name} sx={{ bgcolor: row.subject.color, color: '#fff' }} />\n      ),\n    },\n    { field: 'section', headerName: 'Section', flex: 0.8, sortable: false, valueGetter: (_v, row) => row.section?.name ?? '—' },\n    { field: 'teacher', headerName: 'Teacher', flex: 1.2, sortable: false, valueGetter: (_v, row) => row.teacher.name },\n    { field: 'enrolledCount', headerName: 'Enrolled', flex: 0.7 },\n    {\n      field: 'kind',\n      headerName: 'Kind',\n      flex: 0.8,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Stack direction=\"row\" spacing={0.5} sx={{ alignItems: 'center', height: '100%' }}>\n          <Chip size=\"small\" variant=\"outlined\" label={row.kind} />\n          {row.archivedAt && <Chip size=\"small\" label=\"Archived\" />}\n        </Stack>\n      ),\n    },\n    {\n      field: 'actions',\n      headerName: '',\n      width: 60,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Tooltip title=\"Edit\">\n          <IconButton size=\"small\" aria-label={`Edit ${row.code}`} onClick={() => openEdit(row)}>\n            <EditOutlinedIcon fontSize=\"small\" />\n          </IconButton>\n        </Tooltip>\n      ),\n    },\n  ];\n\n  const filterSelect = (key: string, label: string, options: Option[], minWidth = 160) => (\n    <TextField\n      select\n      size=\"small\"\n      label={label}\n      value={searchParams.get(key) ?? ''}\n      onChange={(e) => setFilter(key, e.target.value || undefined)}\n      sx={{ minWidth }}\n    >\n      <MenuItem value=\"\">All</MenuItem>\n      {options.map((o) => (\n        <MenuItem key={o.id} value={o.id}>\n          {o.name}\n        </MenuItem>\n      ))}\n    </TextField>\n  );\n\n  return (\n    <Box>\n      <PageHeader\n        title=\"Courses\"\n        breadcrumbs={[{ label: 'Administration' }, { label: 'Courses' }]}\n        actions={\n          <Button\n            variant=\"contained\"\n            startIcon={<AddIcon />}\n            disabled={!yearId}\n            onClick={() => {\n              setErrors({});\n              setForm(emptyForm);\n            }}\n          >\n            New course\n          </Button>\n        }\n      />\n\n      <Stack direction={{ xs: 'column', md: 'row' }} spacing={2} sx={{ mb: 2, flexWrap: 'wrap' }} useFlexGap>\n        <TextField\n          select\n          size=\"small\"\n          label=\"Academic year\"\n          value={yearId}\n          onChange={(e) => setFilter('academicYearId', e.target.value)}\n          sx={{ minWidth: 200 }}\n        >\n          {years.map((y) => (\n            <MenuItem key={y.id} value={y.id}>\n              {y.name}\n              {y.isCurrent ? ' (current)' : ''}\n            </MenuItem>\n          ))}\n        </TextField>\n        {filterSelect('gradeLevelId', 'Grade', gradeLevels)}\n        {filterSelect('subjectId', 'Subject', subjects)}\n        {filterSelect('kind', 'Kind', [\n          { id: 'CORE', name: 'Core' },\n          { id: 'ELECTIVE', name: 'Elective' },\n        ], 130)}\n        <Box sx={{ minWidth: 240 }}>\n          <UserPicker\n            label=\"Teacher\"\n            role=\"TEACHER\"\n            value={teacherFilter}\n            onChange={(v) => {\n              const teacher = (v as UserPickerOption | null) ?? null;\n              setTeacherFilter(teacher);\n              setFilter('teacherId', teacher?.id);\n            }}\n          />\n        </Box>\n        <FormControlLabel\n          control={\n            <Switch\n              checked={searchParams.get('includeArchived') === 'true'}\n              onChange={(e) => setFilter('includeArchived', e.target.checked ? 'true' : undefined)}\n            />\n          }\n          label=\"Show archived\"\n        />\n      </Stack>\n\n      <DataTable columns={columns} rows={rows as never} total={total} loading={loading} />\n\n      <Dialog open={Boolean(form)} onClose={() => setForm(null)} fullWidth maxWidth=\"sm\">\n        <DialogTitle>{form?.id ? 'Edit course' : 'New course'}</DialogTitle>\n        {form && (\n          <DialogContent>\n            <Stack spacing={2} sx={{ mt: 1 }}>\n              <TextField\n                select\n                label=\"Kind\"\n                value={form.kind}\n                disabled={Boolean(form.id)}\n                onChange={(e) => patchForm({ kind: e.target.value as FormState['kind'] })}\n                helperText={form.id ? 'Kind cannot change after creation.' : undefined}\n              >\n                <MenuItem value=\"CORE\">Core (section-wide)</MenuItem>\n                <MenuItem value=\"ELECTIVE\">Elective (direct enrollment)</MenuItem>\n              </TextField>\n              <TextField\n                select\n                label=\"Subject\"\n                value={form.subjectId}\n                onChange={(e) => patchForm({ subjectId: e.target.value })}\n                error={Boolean(errors.subjectId)}\n                helperText={errors.subjectId}\n              >\n                {subjects.map((s) => (\n                  <MenuItem key={s.id} value={s.id}>\n                    {s.name}\n                  </MenuItem>\n                ))}\n              </TextField>\n              <TextField\n                select\n                label={form.kind === 'CORE' ? 'Section' : 'Section (optional)'}\n                value={form.sectionId}\n                disabled={Boolean(form.id)}\n                onChange={(e) => patchForm({ sectionId: e.target.value })}\n                error={Boolean(errors.sectionId)}\n                helperText={errors.sectionId ?? (form.id ? 'Section cannot change after creation.' : undefined)}\n              >\n                <MenuItem value=\"\">None</MenuItem>\n                {yearSections.map((s) => (\n                  <MenuItem key={s.id} value={s.id}>\n                    {s.name}\n                  </MenuItem>\n                ))}\n              </TextField>\n              <UserPicker\n                label=\"Teacher\"\n                role=\"TEACHER\"\n                value={form.teacher}\n                onChange={(v) => patchForm({ teacher: (v as UserPickerOption | null) ?? null })}\n                error={Boolean(errors.teacherId)}\n                helperText={errors.teacherId}\n              />\n              <UserPicker\n                label=\"Co-teachers\"\n                role=\"TEACHER\"\n                multiple\n                value={form.coTeachers}\n                onChange={(v) => patchForm({ coTeachers: (v as UserPickerOption[]) ?? [] })}\n                error={Boolean(errors.coTeacherIds)}\n                helperText={errors.coTeacherIds ?? 'Up to 3'}\n              />\n              <TextField\n                label=\"Name\"\n                value={form.name}\n                onChange={(e) => patchForm({ name: e.target.value })}\n                error={Boolean(errors.name)}\n                helperText={errors.name}\n              />\n              <TextField\n                label=\"Code\"\n                value={form.code}\n                onChange={(e) => patchForm({ code: e.target.value.toUpperCase() })}\n                error={Boolean(errors.code)}\n                helperText={errors.code ?? 'Unique within the academic year'}\n              />\n              <TextField\n                label=\"Capacity\"\n                type=\"number\"\n                value={form.capacity}\n                onChange={(e) => patchForm({ capacity: e.target.value })}\n                error={Boolean(errors.capacity)}\n                helperText={errors.capacity ?? 'Leave blank for no limit'}\n                slotProps={{ htmlInput: { min: 1 } }}\n              />\n              <TextField\n                label=\"Description\"\n                multiline\n                minRows={2}\n                value={form.description}\n                onChange={(e) => patchForm({ description: e.target.value })}\n              />\n              {form.id && (\n                <FormControlLabel\n                  control={<Switch checked={form.archived} onChange={(e) => patchForm({ archived: e.target.checked })} />}\n                  label=\"Archived\"\n                />\n              )}\n            </Stack>\n          </DialogContent>\n        )}\n        <DialogActions>\n          <Button onClick={() => setForm(null)} disabled={saving}>\n            Cancel\n          </Button>\n          <Button variant=\"contained\" onClick={save} disabled={saving}>\n            Save\n          </Button>\n        </DialogActions>\n      </Dialog>\n    </Box>\n  );\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YYknDPw1SZ2beMZXD3UUnR","type":"tool_result","content":"File created successfully at: /Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/(app)/admin/courses/CoursesClient.tsx (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"d3efc663-ed37-4bc8-9345-de916511df8c","timestamp":"2026-10-27T16:52:04.833Z","tool_use_result":{"type":"create","filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/(app)/admin/courses/CoursesClient.tsx","content":"'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport Link from 'next/link';\nimport { usePathname, useRouter, useSearchParams } from 'next/navigation';\nimport type { GridColDef } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Dialog from '@mui/material/Dialog';\nimport DialogActions from '@mui/material/DialogActions';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport IconButton from '@mui/material/IconButton';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport Switch from '@mui/material/Switch';\nimport TextField from '@mui/material/TextField';\nimport Tooltip from '@mui/material/Tooltip';\nimport AddIcon from '@mui/icons-material/Add';\nimport EditOutlinedIcon from '@mui/icons-material/EditOutlined';\nimport { DataTable } from '@/components/DataTable/DataTable';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { UserPicker, type UserPickerOption } from '@/components/UserPicker/UserPicker';\nimport { useToast } from '@/components/Toast/useToast';\nimport { courseInputSchema, courseUpdateSchema, defaultCourseCode, defaultCourseName } from '@/lib/validators/courses';\n\ninterface Option {\n  id: string;\n  name: string;\n}\ninterface SubjectOption extends Option {\n  code: string;\n  color: string;\n}\ninterface SectionOption extends Option {\n  academicYearId: string;\n  gradeLevelId: string;\n}\nexport interface CourseRow {\n  id: string;\n  code: string;\n  name: string;\n  kind: 'CORE' | 'ELECTIVE';\n  subjectId: string;\n  sectionId: string | null;\n  capacity: number | null;\n  description: string | null;\n  archivedAt: string | null;\n  subject: SubjectOption;\n  section: Option | null;\n  teacher: Option;\n  coTeachers: Option[];\n  enrolledCount: number;\n}\n\nasync function send(url: string, method: string, body?: unknown) {\n  const res = await fetch(url, {\n    method,\n    headers: { 'Content-Type': 'application/json' },\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const json = await res.json().catch(() => ({}));\n  if (!res.ok) throw new Error(json?.error?.message ?? 'Request failed');\n  return json;\n}\n\nconst asPickerOption = (u: Option): UserPickerOption => ({ id: u.id, name: u.name, email: '', role: 'TEACHER' });\n\ninterface FormState {\n  id?: string;\n  subjectId: string;\n  sectionId: string;\n  teacher: UserPickerOption | null;\n  coTeachers: UserPickerOption[];\n  name: string;\n  code: string;\n  kind: 'CORE' | 'ELECTIVE';\n  capacity: string;\n  description: string;\n  archived: boolean;\n}\nconst emptyForm: FormState = {\n  subjectId: '',\n  sectionId: '',\n  teacher: null,\n  coTeachers: [],\n  name: '',\n  code: '',\n  kind: 'CORE',\n  capacity: '',\n  description: '',\n  archived: false,\n};\n\nexport function CoursesClient({\n  years,\n  currentYearId,\n  gradeLevels,\n  subjects,\n  sections,\n  initialRows,\n  initialTotal,\n}: {\n  years: (Option & { isCurrent: boolean })[];\n  currentYearId: string | null;\n  gradeLevels: Option[];\n  subjects: SubjectOption[];\n  sections: SectionOption[];\n  initialRows: CourseRow[];\n  initialTotal: number;\n}) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  const { showToast } = useToast();\n  const yearId = searchParams.get('academicYearId') ?? currentYearId ?? '';\n\n  const [rows, setRows] = useState(initialRows);\n  const [total, setTotal] = useState(initialTotal);\n  const [loading, setLoading] = useState(false);\n  const [teacherFilter, setTeacherFilter] = useState<UserPickerOption | null>(null);\n  const [form, setForm] = useState<FormState | null>(null);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [saving, setSaving] = useState(false);\n\n  const yearSections = sections.filter((s) => s.academicYearId === yearId);\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const params = new URLSearchParams(searchParams.toString());\n      if (yearId) params.set('academicYearId', yearId);\n      const json = await send(`/api/courses?${params.toString()}`, 'GET');\n      setRows(json.data);\n      setTotal(json.meta.total);\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setLoading(false);\n    }\n  }, [searchParams, yearId, showToast]);\n\n  useEffect(() => {\n    void load();\n  }, [load]);\n\n  const setFilter = (key: string, value: string | undefined) => {\n    const next = new URLSearchParams(searchParams.toString());\n    if (value) next.set(key, value);\n    else next.delete(key);\n    next.set('page', '1');\n    router.push(`${pathname}?${next.toString()}`);\n  };\n\n  /** Auto-fill name/code from subject + section until the admin types their own. */\n  const withDefaults = (next: FormState, prev: FormState): FormState => {\n    if (next.id) return next;\n    const subject = subjects.find((s) => s.id === next.subjectId);\n    if (!subject) return next;\n    const sectionName = (id: string) => yearSections.find((s) => s.id === id)?.name ?? null;\n    const prevSubject = subjects.find((s) => s.id === prev.subjectId);\n    const prevName = prevSubject ? defaultCourseName(prevSubject.name, sectionName(prev.sectionId)) : '';\n    const prevCode = prevSubject ? defaultCourseCode(prevSubject.code, sectionName(prev.sectionId)) : '';\n    return {\n      ...next,\n      name: !prev.name || prev.name === prevName ? defaultCourseName(subject.name, sectionName(next.sectionId)) : next.name,\n      code: !prev.code || prev.code === prevCode ? defaultCourseCode(subject.code, sectionName(next.sectionId)) : next.code,\n    };\n  };\n  const patchForm = (patch: Partial<FormState>) => form && setForm(withDefaults({ ...form, ...patch }, form));\n\n  const openEdit = (row: CourseRow) => {\n    setErrors({});\n    setForm({\n      id: row.id,\n      subjectId: row.subjectId,\n      sectionId: row.sectionId ?? '',\n      teacher: asPickerOption(row.teacher),\n      coTeachers: row.coTeachers.map(asPickerOption),\n      name: row.name,\n      code: row.code,\n      kind: row.kind,\n      capacity: row.capacity == null ? '' : String(row.capacity),\n      description: row.description ?? '',\n      archived: Boolean(row.archivedAt),\n    });\n  };\n\n  const save = async () => {\n    if (!form) return;\n    const common = {\n      subjectId: form.subjectId,\n      teacherId: form.teacher?.id ?? '',\n      coTeacherIds: form.coTeachers.map((t) => t.id),\n      name: form.name,\n      code: form.code,\n      capacity: form.capacity,\n      description: form.description,\n    };\n    const parsed = form.id\n      ? courseUpdateSchema.safeParse({ ...common, archived: form.archived })\n      : courseInputSchema.safeParse({ ...common, academicYearId: yearId, sectionId: form.sectionId, kind: form.kind });\n    if (!parsed.success) {\n      const fieldErrors = parsed.error.flatten().fieldErrors as Record<string, string[] | undefined>;\n      setErrors(Object.fromEntries(Object.entries(fieldErrors).map(([k, v]) => [k, v?.[0] ?? ''])));\n      return;\n    }\n    setErrors({});\n    setSaving(true);\n    try {\n      if (form.id) await send(`/api/courses/${form.id}`, 'PATCH', parsed.data);\n      else await send('/api/courses', 'POST', parsed.data);\n      showToast({ message: form.id ? 'Course updated' : 'Course created', severity: 'success' });\n      setForm(null);\n      await load();\n    } catch (error) {\n      showToast({ message: (error as Error).message, severity: 'error' });\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const columns: GridColDef[] = [\n    {\n      field: 'code',\n      headerName: 'Code',\n      flex: 1,\n      renderCell: ({ row }) => <Link href={`/admin/courses/${row.id}/enrollment`}>{row.code}</Link>,\n    },\n    { field: 'name', headerName: 'Name', flex: 1.5 },\n    {\n      field: 'subject',\n      headerName: 'Subject',\n      flex: 1,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Chip size=\"small\" label={row.subject.name} sx={{ bgcolor: row.subject.color, color: '#fff' }} />\n      ),\n    },\n    { field: 'section', headerName: 'Section', flex: 0.8, sortable: false, valueGetter: (_v, row) => row.section?.name ?? '—' },\n    { field: 'teacher', headerName: 'Teacher', flex: 1.2, sortable: false, valueGetter: (_v, row) => row.teacher.name },\n    { field: 'enrolledCount', headerName: 'Enrolled', flex: 0.7 },\n    {\n      field: 'kind',\n      headerName: 'Kind',\n      flex: 0.8,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Stack direction=\"row\" spacing={0.5} sx={{ alignItems: 'center', height: '100%' }}>\n          <Chip size=\"small\" variant=\"outlined\" label={row.kind} />\n          {row.archivedAt && <Chip size=\"small\" label=\"Archived\" />}\n        </Stack>\n      ),\n    },\n    {\n      field: 'actions',\n      headerName: '',\n      width: 60,\n      sortable: false,\n      renderCell: ({ row }) => (\n        <Tooltip title=\"Edit\">\n          <IconButton size=\"small\" aria-label={`Edit ${row.code}`} onClick={() => openEdit(row)}>\n            <EditOutlinedIcon fontSize=\"small\" />\n          </IconButton>\n        </Tooltip>\n      ),\n    },\n  ];\n\n  const filterSelect = (key: string, label: string, options: Option[], minWidth = 160) => (\n    <TextField\n      select\n      size=\"small\"\n      label={label}\n      value={searchParams.get(key) ?? ''}\n      onChange={(e) => setFilter(key, e.target.value || undefined)}\n      sx={{ minWidth }}\n    >\n      <MenuItem value=\"\">All</MenuItem>\n      {options.map((o) => (\n        <MenuItem key={o.id} value={o.id}>\n          {o.name}\n        </MenuItem>\n      ))}\n    </TextField>\n  );\n\n  return (\n    <Box>\n      <PageHeader\n        title=\"Courses\"\n        breadcrumbs={[{ label: 'Administration' }, { label: 'Courses' }]}\n        actions={\n          <Button\n            variant=\"contained\"\n            startIcon={<AddIcon />}\n            disabled={!yearId}\n            onClick={() => {\n              setErrors({});\n              setForm(emptyForm);\n            }}\n          >\n            New course\n          </Button>\n        }\n      />\n\n      <Stack direction={{ xs: 'column', md: 'row' }} spacing={2} sx={{ mb: 2, flexWrap: 'wrap' }} useFlexGap>\n        <TextField\n          select\n          size=\"small\"\n          label=\"Academic year\"\n          value={yearId}\n          onChange={(e) => setFilter('academicYearId', e.target.value)}\n          sx={{ minWidth: 200 }}\n        >\n          {years.map((y) => (\n            <MenuItem key={y.id} value={y.id}>\n              {y.name}\n              {y.isCurrent ? ' (current)' : ''}\n            </MenuItem>\n          ))}\n        </TextField>\n        {filterSelect('gradeLevelId', 'Grade', gradeLevels)}\n        {filterSelect('subjectId', 'Subject', subjects)}\n        {filterSelect('kind', 'Kind', [\n          { id: 'CORE', name: 'Core' },\n          { id: 'ELECTIVE', name: 'Elective' },\n        ], 130)}\n        <Box sx={{ minWidth: 240 }}>\n          <UserPicker\n            label=\"Teacher\"\n            role=\"TEACHER\"\n            value={teacherFilter}\n            onChange={(v) => {\n              const teacher = (v as UserPickerOption | null) ?? null;\n              setTeacherFilter(teacher);\n              setFilter('teacherId', teacher?.id);\n            }}\n          />\n        </Box>\n        <FormControlLabel\n          control={\n            <Switch\n              checked={searchParams.get('includeArchived') === 'true'}\n              onChange={(e) => setFilter('includeArchived', e.target.checked ? 'true' : undefined)}\n            />\n          }\n          label=\"Show archived\"\n        />\n      </Stack>\n\n      <DataTable columns={columns} rows={rows as never} total={total} loading={loading} />\n\n      <Dialog open={Boolean(form)} onClose={() => setForm(null)} fullWidth maxWidth=\"sm\">\n        <DialogTitle>{form?.id ? 'Edit course' : 'New course'}</DialogTitle>\n        {form && (\n          <DialogContent>\n            <Stack spacing={2} sx={{ mt: 1 }}>\n              <TextField\n                select\n                label=\"Kind\"\n                value={form.kind}\n                disabled={Boolean(form.id)}\n                onChange={(e) => patchForm({ kind: e.target.value as FormState['kind'] })}\n                helperText={form.id ? 'Kind cannot change after creation.' : undefined}\n              >\n                <MenuItem value=\"CORE\">Core (section-wide)</MenuItem>\n                <MenuItem value=\"ELECTIVE\">Elective (direct enrollment)</MenuItem>\n              </TextField>\n              <TextField\n                select\n                label=\"Subject\"\n                value={form.subjectId}\n                onChange={(e) => patchForm({ subjectId: e.target.value })}\n                error={Boolean(errors.subjectId)}\n                helperText={errors.subjectId}\n              >\n                {subjects.map((s) => (\n                  <MenuItem key={s.id} value={s.id}>\n                    {s.name}\n                  </MenuItem>\n                ))}\n              </TextField>\n              <TextField\n                select\n                label={form.kind === 'CORE' ? 'Section' : 'Section (optional)'}\n                value={form.sectionId}\n                disabled={Boolean(form.id)}\n                onChange={(e) => patchForm({ sectionId: e.target.value })}\n                error={Boolean(errors.sectionId)}\n                helperText={errors.sectionId ?? (form.id ? 'Section cannot change after creation.' : undefined)}\n              >\n                <MenuItem value=\"\">None</MenuItem>\n                {yearSections.map((s) => (\n                  <MenuItem key={s.id} value={s.id}>\n                    {s.name}\n                  </MenuItem>\n                ))}\n              </TextField>\n              <UserPicker\n                label=\"Teacher\"\n                role=\"TEACHER\"\n                value={form.teacher}\n                onChange={(v) => patchForm({ teacher: (v as UserPickerOption | null) ?? null })}\n                error={Boolean(errors.teacherId)}\n                helperText={errors.teacherId}\n              />\n              <UserPicker\n                label=\"Co-teachers\"\n                role=\"TEACHER\"\n                multiple\n                value={form.coTeachers}\n                onChange={(v) => patchForm({ coTeachers: (v as UserPickerOption[]) ?? [] })}\n                error={Boolean(errors.coTeacherIds)}\n                helperText={errors.coTeacherIds ?? 'Up to 3'}\n              />\n              <TextField\n                label=\"Name\"\n                value={form.name}\n                onChange={(e) => patchForm({ name: e.target.value })}\n                error={Boolean(errors.name)}\n                helperText={errors.name}\n              />\n              <TextField\n                label=\"Code\"\n                value={form.code}\n                onChange={(e) => patchForm({ code: e.target.value.toUpperCase() })}\n                error={Boolean(errors.code)}\n                helperText={errors.code ?? 'Unique within the academic year'}\n              />\n              <TextField\n                label=\"Capacity\"\n                type=\"number\"\n                value={form.capacity}\n                onChange={(e) => patchForm({ capacity: e.target.value })}\n                error={Boolean(errors.capacity)}\n                helperText={errors.capacity ?? 'Leave blank for no limit'}\n                slotProps={{ htmlInput: { min: 1 } }}\n              />\n              <TextField\n                label=\"Description\"\n                multiline\n                minRows={2}\n                value={form.description}\n                onChange={(e) => patchForm({ description: e.target.value })}\n              />\n              {form.id && (\n                <FormControlLabel\n                  control={<Switch checked={form.archived} onChange={(e) => patchForm({ archived: e.target.checked })} />}\n                  label=\"Archived\"\n                />\n              )}\n            </Stack>\n          </DialogContent>\n        )}\n        <DialogActions>\n          <Button onClick={() => setForm(null)} disabled={saving}>\n            Cancel\n          </Button>\n          <Button variant=\"contained\" onClick={save} disabled={saving}>\n            Save\n          </Button>\n        </DialogActions>\n      </Dialog>\n    </Box>\n  );\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01YYknDPw1SZ2beMZXD3UUnR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
