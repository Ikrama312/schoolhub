\n        \"TASK-7\"\n      ],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\n        \"FR-16\",\n        \"FR-17\",\n        \"FR-18\",\n        \"NFR-4\",\n        \"NFR-1\"\n      ]\n    },\n    {\n      \"id\": \"TASK-16\",\n      \"description\": \"/my-courses page: server component calling courses-service.listMyCourses(requireRole(...ALL_ROLES)); MUI Card grid (Grid responsive) — TEACHER: name, section, enrolled count; STUDENT: name, teacher; PARENT: same cards grouped under each child's name; EmptyState when none. Cards link to /courses/[courseId].\",\n      \"files\": [\n        \"src/app/(app)/my-courses/page.tsx\"\n      ],\n      \"dependencies\": [\n        \"TASK-7\"\n      ],\n      \"estimateHours\": 1.5,\n      \"requirementIds\": [\n        \"FR-19\",\n        \"NFR-1\"\n      ]\n    },\n    {\n      \"id\": \"TASK-17\",\n      \"description\": \"Student 'Courses' tab: register { key: 'courses', label: 'Courses', href: id => `/students/${id}/courses`, roles: ALL_ROLES } in student-tabs.ts; students/[id]/courses/page.tsx gates with assertCanViewStudent (existing) and renders section + homeroom teacher and a table of this year's courses with teacher and enrollment status from courses-service.getStudentCourses.\",\n      \"files\": [\n        \"src/config/student-tabs.ts\",\n        \"src/app/(app)/students/[id]/courses/page.tsx\"\n      ],\n      \"dependencies\": [\n        \"TASK-5\",\n        \"TASK-7\"\n      ],\n      \"estimateHours\": 1.5,\n      \"requirementIds\": [\n        \"FR-21\",\n        \"FR-22\",\n        \"NFR-1\"\n      ]\n    },\n    {\n      \"id\": \"TASK-18\",\n      \"description\": \"Unit tests: course-validators.test.ts covers the CORE-requires-section refinement, >3 co-teachers rejection, code uppercasing, capacity bounds; course-access.test.ts mocks @/server/db prisma (vi.mock) and covers assertCanViewCourse per role (incl. PARENT via linked child, DROPPED student denied), assertCanManageCourse, and getAccessibleStudentIds TEACHER branch.\",\n      \"files\": [\n        \"tests/unit/course-validators.test.ts\",\n        \"tests/unit/course-access.test.ts\"\n      ],\n      \"dependencies\": [\n        \"TASK-2\",\n        \"TASK-5\"\n      ],\n      \"estimateHours\": 1.5,\n      \"requirementIds\": [\n        \"FR-14\",\n        \"FR-18\",\n        \"FR-22\",\n        \"NFR-5\"\n      ]\n    },\n    {\n      \"id\": \"TASK-19\",\n      \"description\": \"Playwright e2e: as ADMIN create a section, create core courses, add a student -> enrolled in each core course, remove -> enrollments DROPPED, capacity-full CONFLICT toast; open /courses/[id] roster; sidebar shows Administration > Sections/Courses. Run `npm run lint && npm run typecheck && npm run test` to keep existing suites green.\",\n      \"files\": [\n        \"tests/e2e/classes-enrollment.spec.ts\"\n      ],\n      \"dependencies\": [\n        \"TASK-10\",\n        \"TASK-11\",\n        \"TASK-12\",\n        \"TASK-15\"\n      ],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\n        \"FR-4\",\n        \"FR-5\",\n        \"FR-7\",\n        \"FR-8\",\n        \"FR-11\",\n        \"FR-20\",\n        \"NFR-5\"\n      ]\n    }\n  ],\n  \"fileStructure\": {\n    \"prisma/\": [\n      \"schema.prisma\"\n    ],\n    \"prisma/migrations/20261027000000_classes_enrollment/\": [\n      \"migration.sql\"\n    ],\n    \"src/lib/validators/\": [\n      \"sections.ts\",\n      \"courses.ts\"\n    ],\n    \"src/server/enrollment/\": [\n      \"roster-engine.ts\"\n    ],\n    \"tests/unit/\": [\n      \"roster-engine.test.ts\",\n      \"course-validators.test.ts\",\n      \"course-access.test.ts\"\n    ],\n    \"src/server/auth/\": [\n      \"course-access.ts\",\n      \"student-access.ts\"\n    ],\n    \"src/server/sections/\": [\n      \"sections-service.ts\"\n    ],\n    \"src/server/courses/\": [\n      \"courses-service.ts\"\n    ],\n    \"src/app/api/sections/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/sections/[id]/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/sections/[id]/members/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/sections/[id]/members/[studentId]/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/sections/[id]/core-courses/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/sections/copy-to-year/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/students/[id]/move-section/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/courses/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/courses/[id]/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/courses/[id]/roster/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/courses/[id]/enrollments/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/enrollments/[id]/\": [\n      \"route.ts\"\n    ],\n    \"src/app/api/me/courses/\": [\n      \"route.ts\"\n    ],\n    \"src/config/\": [\n      \"navigation.ts\",\n      \"course-tabs.ts\",\n      \"student-tabs.ts\"\n    ],\n    \"src/app/(app)/\": [\n      \"shell.tsx\"\n    ],\n    \"src/app/(app)/admin/sections/\": [\n      \"page.tsx\",\n      \"SectionsClient.tsx\"\n    ],\n    \"src/app/(app)/admin/sections/[id]/\": [\n      \"page.tsx\",\n      \"SectionDetailClient.tsx\"\n    ],\n    \"src/app/(app)/admin/courses/\": [\n      \"page.tsx\",\n      \"CoursesClient.tsx\"\n    ],\n    \"src/app/(app)/admin/courses/[id]/enrollment/\": [\n      \"page.tsx\",\n      \"EnrollmentClient.tsx\"\n    ],\n    \"src/app/(app)/courses/[courseId]/\": [\n      \"layout.tsx\",\n      \"CourseTabs.tsx\",\n      \"page.tsx\"\n    ],\n    \"src/app/(app)/courses/[courseId]/roster/\": [\n      \"page.tsx\"\n    ],\n    \"src/app/(app)/my-courses/\": [\n      \"page.tsx\"\n    ],\n    \"src/app/(app)/students/[id]/courses/\": [\n      \"page.tsx\"\n    ],\n    \"tests/e2e/\": [\n      \"classes-enrollment.spec.ts\"\n    ]\n  },\n  \"totalEstimateHours\": 45.5,\n  \"nxpPatterns\": [],\n  \"status\": \"complete\"\n}{\n  \"ticketId\": \"abcd-05\",\n  \"ti