{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M2Ns8EDebGuWUtiXzjgutc","type":"tool_result","content":"import { z } from 'zod';\n\n/**\n * Section validation (PRD-05 FR-3/FR-23), shared by the /admin/sections\n * dialogs and the /api/sections* handlers.\n */\n\nconst optionalId = z.preprocess((v) => (v === '' ? null : v), z.string().min(1).nullable().optional());\n\nexport const sectionCapacitySchema = z.coerce\n  .number()\n  .int('Capacity must be a whole number')\n  .min(1, 'Capacity must be at least 1')\n  .max(60, 'Capacity must be at most 60');\n\nexport const sectionInputSchema = z.object({\n  academicYearId: z.string().min(1, 'Academic year is required'),\n  gradeLevelId: z.string().min(1, 'Grade level is required'),\n  name: z.string().trim().min(1, 'Name is required').max(40),\n  homeroomTeacherId: optionalId,\n  roomId: optionalId,\n  capacity: sectionCapacitySchema.default(30),\n});\nexport type SectionInput = z.infer<typeof sectionInputSchema>;\n\n/** academicYearId is immutable after creation. */\nexport const sectionUpdateSchema = sectionInputSchema.omit({ academicYearId: true }).partial();\nexport type SectionUpdateInput = z.infer<typeof sectionUpdateSchema>;\n\nexport const enrollStudentsSchema = z.object({\n  studentIds: z.array(z.string().min(1)).min(1, 'Pick at least one student'),\n  overrideCapacity: z.boolean().optional().default(false),\n});\nexport type EnrollStudentsInput = z.infer<typeof enrollStudentsSchema>;\n\nexport const moveSectionSchema = z.object({\n  toSectionId: z.string().min(1, 'Destination section is required'),\n  overrideCapacity: z.boolean().optional().default(false),\n});\nexport type MoveSectionInput = z.infer<typeof moveSectionSchema>;\n\nexport const coreCoursesSchema = z.object({\n  items: z\n    .array(z.object({ subjectId: z.string().min(1), teacherId: z.string().min(1, 'Teacher is required') }))\n    .min(1, 'Pick at least one subject')\n    .refine((items) => new Set(items.map((i) => i.subjectId)).size === items.length, {\n      message: 'Each subject may appear only once',\n    }),\n});\nexport type CoreCoursesInput = z.infer<typeof coreCoursesSchema>;\n\nexport const copyToYearSchema = z\n  .object({ fromYearId: z.string().min(1), toYearId: z.string().min(1) })\n  .refine((v) => v.fromYearId !== v.toYearId, { message: 'Target year must differ', path: ['toYearId'] });\nexport type CopyToYearInput = z.infer<typeof copyToYearSchema>;\n\nexport const sectionsListQuerySchema = z.object({\n  academicYearId: z.string().optional(),\n  gradeLevelId: z.string().optional(),\n  q: z.string().optional(),\n  sort: z.enum(['name', 'gradeLevel', 'memberCount']).optional().default('gradeLevel'),\n  order: z.enum(['asc', 'desc']).optional().default('asc'),\n});\nexport type SectionsListQuery = z.infer<typeof sectionsListQuerySchema>;\nimport { z } from 'zod';\n\n/**\n * Course/enrollment validation (PRD-05 FR-14/FR-23), shared by the\n * /admin/courses dialog and the /api/courses* handlers. The\n * \"section required iff CORE\" rule is ONE refinement here (Decision 3).\n */\n\nexport const COURSE_KINDS = ['CORE', 'ELECTIVE'] as const;\nexport const ENROLLMENT_STATUSES = ['ACTIVE', 'DROPPED'] as const;\n\nconst nullableText = z.preprocess((v) => (v === '' ? null : v), z.string().nullable().optional());\nconst nullableId = z.preprocess((v) => (v === '' ? null : v), z.string().min(1).nullable().optional());\n\nexport const courseCodeSchema = z\n  .string()\n  .trim()\n  .min(1, 'Code is required')\n  .max(30)\n  .transform((v) => v.toUpperCase());\n\nconst courseCapacitySchema = z.preprocess(\n  (v) => (v === '' || v === undefined ? null : v),\n  z.coerce.number().int('Capacity must be a whole number').min(1, 'Capacity must be at least 1').nullable(),\n);\n\nconst coTeacherIdsSchema = z.array(z.string().min(1)).max(3, 'At most 3 co-teachers').default([]);\n\nconst courseBase = z.object({\n  academicYearId: z.string().min(1, 'Academic year is required'),\n  subjectId: z.string().min(1, 'Subject is required'),\n  sectionId: nullableId,\n  teacherId: z.string().min(1, 'Teacher is required'),\n  coTeacherIds: coTeacherIdsSchema,\n  name: z.string().trim().min(1, 'Name is required').max(120),\n  code: courseCodeSchema,\n  kind: z.enum(COURSE_KINDS).default('CORE'),\n  capacity: courseCapacitySchema.optional(),\n  description: nullableText,\n});\n\nexport const courseInputSchema = courseBase.refine((v) => v.kind !== 'CORE' || Boolean(v.sectionId), {\n  message: 'Section is required for core courses',\n  path: ['sectionId'],\n});\nexport type CourseInput = z.infer<typeof courseInputSchema>;\n\n/** academicYearId/sectionId/kind are immutable after creation. */\nexport const courseUpdateSchema = courseBase\n  .omit({ academicYearId: true, sectionId: true, kind: true })\n  .extend({ coTeacherIds: z.array(z.string().min(1)).max(3, 'At most 3 co-teachers'), archived: z.boolean() })\n  .partial();\nexport type CourseUpdateInput = z.infer<typeof courseUpdateSchema>;\n\nexport const enrollmentStatusSchema = z.object({\n  status: z.enum(ENROLLMENT_STATUSES),\n  overrideCapacity: z.boolean().optional().default(false),\n});\nexport type EnrollmentStatusInput = z.infer<typeof enrollmentStatusSchema>;\n\nconst boolFlag = z.enum(['true', 'false']).optional().transform((v) => v === 'true');\n\nexport const coursesListQuerySchema = z.object({\n  academicYearId: z.string().optional(),\n  gradeLevelId: z.string().optional(),\n  subjectId: z.string().optional(),\n  teacherId: z.string().optional(),\n  sectionId: z.string().optional(),\n  kind: z.enum(COURSE_KINDS).optional(),\n  includeArchived: boolFlag,\n  q: z.string().optional(),\n  sort: z.enum(['code', 'name', 'enrolledCount']).optional().default('code'),\n  order: z.enum(['asc', 'desc']).optional().default('asc'),\n});\nexport type CoursesListQuery = z.infer<typeof coursesListQuerySchema>;\n\nexport const rosterQuerySchema = z.object({\n  status: z.enum(['ACTIVE', 'DROPPED', 'ALL']).optional().default('ACTIVE'),\n  q: z.string().optional(),\n});\nexport type RosterQuery = z.infer<typeof rosterQuerySchema>;\n\n/** FR-14 defaults: \"<Subject> – <Section>\" / \"<SUBJECTCODE>-<SECTION>\". */\nexport function defaultCourseName(subjectName: string, sectionName?: string | null): string {\n  return sectionName ? `${subjectName} – ${sectionName}` : subjectName;\n}\n\nexport function defaultCourseCode(subjectCode: string, sectionName?: string | null): string {\n  const base = subjectCode.trim().toUpperCase();\n  return sectionName ? `${base}-${sectionName.trim().toUpperCase().replace(/\\s+/g, '')}` : base;\n}\nimport type { Prisma } from '@prisma/client';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\n\n/**\n * Roster Enrollment Engine (PRD-05 FR-7..FR-12, NFR-3). Every function\n * takes the caller's transaction client first and never opens its own\n * transaction (ADR-1). Writes are batched (one createMany + one\n * updateMany per call), never per-row loops.\n *\n * Capacity is checked for every affected course BEFORE any write, so a\n * CONFLICT never leaves a half-applied enroll (and audit() — which writes\n * outside the tx — only runs after the writes succeeded).\n */\n\nexport type Tx = Prisma.TransactionClient;\n\nexport interface EnrollOptions {\n  overrideCapacity?: boolean;\n  actorId?: string | null;\n}\n\nexport interface EnrollResult {\n  enrolled: number;\n  reactivated: number;\n  alreadyActive: number;\n}\n\nexport interface CapacityCheck {\n  sectionId?: string;\n  courseId?: string;\n  addingCount: number;\n  overrideCapacity?: boolean;\n}\n\n/** FR-11: the one shared capacity guard. Message pattern \"Section 7A is full (30/30).\" */\nexport async function checkCapacityOrThrow(tx: Tx, check: CapacityCheck): Promise<void> {\n  if (check.overrideCapacity || check.addingCount <= 0) return;\n\n  if (check.sectionId) {\n    const section = await tx.section.findUnique({\n      where: { id: check.sectionId },\n      select: { name: true, capacity: true, _count: { select: { members: true } } },\n    });\n    if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n    const current = section._count.members;\n    if (current + check.addingCount > section.capacity) {\n      throw new AppError('CONFLICT', `Section ${section.name} is full (${current}/${section.capacity}).`);\n    }\n  }\n\n  if (check.courseId) {\n    const course = await tx.course.findUnique({\n      where: { id: check.courseId },\n      select: { code: true, capacity: true },\n    });\n    if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n    if (course.capacity === null) return;\n    const current = await tx.enrollment.count({ where: { courseId: check.courseId, status: 'ACTIVE' } });\n    if (current + check.addingCount > course.capacity) {\n      throw new AppError('CONFLICT', `Course ${course.code} is full (${current}/${course.capacity}).`);\n    }\n  }\n}\n\n/**\n * Reactivate-or-create for (courseIds × studentIds): DROPPED rows flip back\n * to ACTIVE (droppedAt cleared), missing rows are created, ACTIVE rows are\n * counted and left alone. Shared by section core-course enrollment and\n * direct elective enrollment (courses-service).\n */\nexport async function enrollStudentsInCourses(\n  tx: Tx,\n  courseIds: string[],\n  studentIds: string[],\n  options: EnrollOptions = {},\n): Promise<EnrollResult> {\n  const result: EnrollResult = { enrolled: 0, reactivated: 0, alreadyActive: 0 };\n  const students = [...new Set(studentIds)];\n  if (courseIds.length === 0 || students.length === 0) return result;\n\n  const existing = await tx.enrollment.findMany({\n    where: { courseId: { in: courseIds }, studentId: { in: students } },\n    select: { id: true, courseId: true, studentId: true, status: true },\n  });\n  const byPair = new Map(existing.map((row) => [`${row.courseId}:${row.studentId}`, row]));\n\n  const toCreate: { courseId: string; studentId: string }[] = [];\n  const toReactivate: string[] = [];\n  const addingPerCourse = new Map<string, number>();\n\n  for (const courseId of courseIds) {\n    for (const studentId of students) {\n      const row = byPair.get(`${courseId}:${studentId}`);\n      if (row?.status === 'ACTIVE') {\n        result.alreadyActive += 1;\n        continue;\n      }\n      if (row) toReactivate.push(row.id);\n      else toCreate.push({ courseId, studentId });\n      addingPerCourse.set(courseId, (addingPerCourse.get(courseId) ?? 0) + 1);\n    }\n  }\n\n  for (const [courseId, addingCount] of addingPerCourse) {\n    await checkCapacityOrThrow(tx, { courseId, addingCount, overrideCapacity: options.overrideCapacity });\n  }\n\n  if (toCreate.length > 0) {\n    const created = await tx.enrollment.createMany({ data: toCreate, skipDuplicates: true });\n    result.enrolled = created.count;\n  }\n  if (toReactivate.length > 0) {\n    const updated = await tx.enrollment.updateMany({\n      where: { id: { in: toReactivate } },\n      data: { status: 'ACTIVE', droppedAt: null },\n    });\n    result.reactivated = updated.count;\n  }\n\n  if (result.enrolled + result.reactivated > 0) {\n    await audit({\n      actorId: options.actorId,\n      action: 'enrollment.enroll',\n      entityType: 'Enrollment',\n      metadata: { courseIds, studentIds: students, ...result },\n    });\n  }\n  return result;\n}\n\n/** FR-7/FR-10: enroll students in every non-archived CORE course of a section. */\nexport async function enrollSectionCoreCourses(\n  tx: Tx,\n  sectionId: string,\n  studentIds: string[],\n  options: EnrollOptions = {},\n): Promise<EnrollResult> {\n  const courses = await tx.course.findMany({\n    where: { sectionId, kind: 'CORE', archivedAt: null },\n    select: { id: true },\n  });\n  return enrollStudentsInCourses(\n    tx,\n    courses.map((c) => c.id),\n    studentIds,\n    options,\n  );\n}\n\n/** FR-8: ACTIVE -> DROPPED on this section's CORE courses only; electives untouched. */\nexport async function dropSectionCoreCourses(\n  tx: Tx,\n  sectionId: string,\n  studentIds: string[],\n  options: Pick<EnrollOptions, 'actorId'> = {},\n): Promise<number> {\n  if (studentIds.length === 0) return 0;\n  const { count } = await tx.enrollment.updateMany({\n    where: { studentId: { in: studentIds }, status: 'ACTIVE', course: { sectionId, kind: 'CORE' } },\n    data: { status: 'DROPPED', droppedAt: new Date() },\n  });\n  if (count > 0) {\n    await audit({\n      actorId: options.actorId,\n      action: 'enrollment.drop',\n      entityType: 'Enrollment',\n      metadata: { sectionId, studentIds, dropped: count },\n    });\n  }\n  return count;\n}\n\n/** FR-9: drop source CORE enrollments, then enroll destination CORE — inside the caller's tx. */\nexport async function moveStudentSection(\n  tx: Tx,\n  studentId: string,\n  fromSectionId: string,\n  toSectionId: string,\n  options: EnrollOptions = {},\n): Promise<{ dropped: number; enrollments: EnrollResult }> {\n  const dropped = await dropSectionCoreCourses(tx, fromSectionId, [studentId], options);\n  const enrollments = await enrollSectionCoreCourses(tx, toSectionId, [studentId], options);\n  return { dropped, enrollments };\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"a6e489fc-abc2-4cf6-8575-95ca4cd13810","uuid":"3ab46cb8-333e-45d8-a497-3802a5106654","timestamp":"2026-10-27T16:43:12.330Z","tool_use_result":{"stdout":"import { z } from 'zod';\n\n/**\n * Section validation (PRD-05 FR-3/FR-23), shared by the /admin/sections\n * dialogs and the /api/sections* handlers.\n */\n\nconst optionalId = z.preprocess((v) => (v === '' ? null : v), z.string().min(1).nullable().optional());\n\nexport const sectionCapacitySchema = z.coerce\n  .number()\n  .int('Capacity must be a whole number')\n  .min(1, 'Capacity must be at least 1')\n  .max(60, 'Capacity must be at most 60');\n\nexport const sectionInputSchema = z.object({\n  academicYearId: z.string().min(1, 'Academic year is required'),\n  gradeLevelId: z.string().min(1, 'Grade 