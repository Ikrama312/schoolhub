rt interface SelectOption {\n52\t  value: string;\n53\t  label: string;\n54\t}\n55\t\n56\texport function SelectFormField<TFieldValues extends FieldValues>({\n57\t  name,\n58\t  control,\n59\t  label,\n60\t  helperText,\n61\t  options,\n62\t}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n63\t  return (\n64\t    <Controller\n65\t      name={name}\n66\t      control={control}\n67\t      render={({ field, fieldState }) => (\n68\t        <TextField\n69\t          {...field}\n70\t          select\n71\t          label={label}\n72\t          error={Boolean(fieldState.error)}\n73\t          helperText={fieldState.error?.message ?? helperText}\n74\t          fullWidth\n75\t        >\n76\t          {options.map((option) => (\n77\t            <MenuItem key={option.value} value={option.value}>\n78\t              {option.label}\n79\t            </MenuItem>\n80\t          ))}\n81\t        </TextField>\n82\t      )}\n83\t    />\n84\t  );\n85\t}\n86\t\n87\texport function AutocompleteFormField<TFieldValues extends FieldValues>({\n88\t  name,\n89\t  control,\n90\t  label,\n91\t  helperText,\n92\t  options,\n93\t}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n94\t  return (\n95\t    <Controller\n96\t      name={name}\n97\t      control={control}\n98\t      render={({ field, fieldState }) => (\n99\t        <Autocomplete\n100\t          options={options}\n101\t          getOptionLabel={(option) => option.label}\n102\t          isOptionEqualToValue={(option, value) => option.value === value.value}\n103\t          value={options.find((option) => option.value === field.value) ?? null}\n104\t          onChange={(_event, value) => field.onChange(value?.value ?? null)}\n105\t          renderInput={(params) => (\n106\t            <TextField\n107\t              {...params}\n108\t              label={label}\n109\t              error={Boolean(fieldState.error)}\n110\t              helperText={fieldState.error?.message ?? helperText}\n111\t            />\n112\t          )}\n113\t        />\n114\t      )}\n115\t    />\n116\t  );\n117\t}\n118\t\n119\texport function CheckboxFormField<TFieldValues extends FieldValues>({\n120\t  name,\n121\t  control,\n122\t  label,\n123\t}: BaseProps<TFieldValues>) {\n124\t  return (\n125\t    <Controller\n126\t      name={name}\n127\t      control={control}\n128\t      render={({ field }) => (\n129\t        <FormControlLabel\n130\t          control={<Checkbox checked={Boolean(field.value)} onChange={(e) => field.onChange(e.target.checked)} />}\n131\t          label={label}\n132\t        />\n133\t      )}\n134\t    />\n135\t  );\n136\t}\n137\t\n138\texport function SwitchFormField<TFieldValues extends FieldValues>({\n139\t  name,\n140\t  control,\n141\t  label,\n142\t}: BaseProps<TFieldValues>) {\n143\t  return (\n144\t    <Controller\n145\t      name={name}\n146\t      control={control}\n147\t      render={({ field }) => (\n148\t        <FormControlLabel\n149\t          control={<Switch checked={Boolean(field.value)} onChange={(e) => field.onChange(e.target.checked)} />}\n150\t          label={label}\n151\t        />\n152\t      )}\n153\t    />\n154\t  );\n155\t}\n156\t\n157\texport function RadioGroupFormField<TFieldValues extends FieldValues>({\n158\t  name,\n159\t  control,\n160\t  label,\n161\t  helperText,\n162\t  options,\n163\t}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n164\t  return (\n165\t    <Controller\n166\t      name={name}\n167\t      control={control}\n168\t      render={({ field, fieldState }) => (\n169\t        <FormControl error={Boolean(fieldState.error)}>\n170\t          <FormLabel>{label}</FormLabel>\n171\t          <RadioGroup {...field} value={field.value ?? ''}>\n172\t            {options.map((option) => (\n173\t              <FormControlLabel key={option.value} value={option.value} control={<Radio />} label={option.label} />\n174\t            ))}\n175\t          </RadioGroup>\n176\t          <FormHelperText>{fieldState.error?.message ?? helperText}</FormHelperText>\n177\t        </FormControl>\n178\t      )}\n179\t    />\n180\t  );\n181\t}\n182\t\n183\texport function DatePickerFormField<TFieldValues extends FieldValues>({\n184\t  name,\n185\t  control,\n186\t  label,\n187\t  helperText,\n188\t}: BaseProps<TFieldValues>) {\n189\t  return (\n190\t    <Controller\n191\t      name={name}\n192\t      control={control}\n193\t      render={({ field, fieldState }) => (\n194\t        <DatePicker\n195\t          label={label}\n196\t          value={field.value ?? null}\n197\t          onChange={field.onChange}\n198\t          slotProps={{\n199\t            textField: {\n200\t              error: Boolean(fieldState.error),\n201\t              helperText: fieldState.error?.message ?? helperText,\n202\t              fullWidth: true,\n203\t            },\n204\t          }}\n205\t        />\n206\t      )}\n207\t    />\n208\t  );\n209\t}\n210\t\n211\texport function DateTimePickerFormField<TFieldValues extends FieldValues>({\n212\t  name,\n213\t  control,\n214\t  label,\n215\t  helperText,\n216\t}: BaseProps<TFieldValues>) {\n217\t  return (\n218\t    <Controller\n219\t      name={name}\n220\t      control={control}\n221\t      render={({ field, fieldState }) => (\n222\t        <DateTimePicker\n223\t          label={label}\n224\t          value={field.value ?? null}\n225\t          onChange={field.onChange}\n226\t          slotProps={{\n227\t            textField: {\n228\t              error: Boolean(fieldState.error),\n229\t              helperText: fieldState.error?.message ?? helperText,\n230\t              fullWidth: true,\n231\t            },\n232\t          }}\n233\t        />\n234\t      )}\n235\t    />\n236\t  );\n237\t}\n238\t"}]},"parent_tool_use_id":null,"session_id":"58cb2461-07a2-4908-85eb-953f83a6620f","uuid":"c86fff09-6cc5-4939-925a-79520e7e22c2","timestamp":"2026-10-19T09:41:50.590Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/FormField/FormField.tsx","content":"'use client';\n\nimport { Controller, type Control, type FieldValues, type Path } from 'react-hook-form';\nimport TextField, { type TextFieldProps } from '@mui/material/TextField';\nimport MenuItem from '@mui/material/MenuItem';\nimport Checkbox from '@mui/material/Checkbox';\nimport Switch from '@mui/material/Switch';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormControl from '@mui/material/FormControl';\nimport FormLabel from '@mui/material/FormLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Radio from '@mui/material/Radio';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { DateTimePicker } from '@mui/x-date-pickers/DateTimePicker';\n\ninterface BaseProps<TFieldValues extends FieldValues> {\n  name: Path<TFieldValues>;\n  control: Control<TFieldValues>;\n  label: string;\n  helperText?: string;\n}\n\n/** Plain text / number / etc. MUI TextField bound via Controller. */\nexport function TextFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  ...rest\n}: BaseProps<TFieldValues> & Omit<TextFieldProps, 'name' | 'label' | 'error' | 'helperText'>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          {...rest}\n          label={label}\n          error={Boolean(fieldState.error)}\n          helperText={fieldState.error?.message ?? helperText}\n          fullWidth\n        />\n      )}\n    />\n  );\n}\n\nexport interface SelectOption {\n  value: string;\n  label: string;\n}\n\nexport function SelectFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  options,\n}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          select\n          label={label}\n          error={Boolean(fieldState.error)}\n          helperText={fieldState.error?.message ?? helperText}\n          fullWidth\n        >\n          {options.map((option) => (\n            <MenuItem key={option.value} value={option.value}>\n              {option.label}\n            </MenuItem>\n          ))}\n        </TextField>\n      )}\n    />\n  );\n}\n\nexport function AutocompleteFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  options,\n}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <Autocomplete\n          options={options}\n          getOptionLabel={(option) => option.label}\n          isOptionEqualToValue={(option, value) => option.value === value.value}\n          value={options.find((option) => option.value === field.value) ?? null}\n          onChange={(_event, value) => field.onChange(value?.value ?? null)}\n          renderInput={(params) => (\n            <TextField\n              {...params}\n              label={label}\n              error={Boolean(fieldState.error)}\n              helperText={fieldState.error?.message ?? helperText}\n            />\n          )}\n        />\n      )}\n    />\n  );\n}\n\nexport function CheckboxFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n}: BaseProps<TFieldValues>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field }) => (\n        <FormControlLabel\n          control={<Checkbox checked={Boolean(field.value)} onChange={(e) => field.onChange(e.target.checked)} />}\n          label={label}\n        />\n      )}\n    />\n  );\n}\n\nexport function SwitchFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n}: BaseProps<TFieldValues>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field }) => (\n        <FormControlLabel\n          control={<Switch checked={Boolean(field.value)} onChange={(e) => field.onChange(e.target.checked)} />}\n          label={label}\n        />\n      )}\n    />\n  );\n}\n\nexport function RadioGroupFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  options,\n}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <FormControl error={Boolean(fieldState.error)}>\n          <FormLabel>{label}</FormLabel>\n          <RadioGroup {...field} value={field.value ?? ''}>\n            {options.map((option) => (\n              <FormControlLabel key={option.value} value={option.value} control={<Radio />} label={option.label} />\n            ))}\n          </RadioGroup>\n          <FormHelperText>{fieldState.error?.message ?? helperText}</FormHelperText>\n        </FormControl>\n      )}\n    />\n  );\n}\n\nexport function DatePickerFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n}: BaseProps<TFieldValues>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <DatePicker\n          label={label}\n          value={field.value ?? null}\n          onChange={field.onChange}\n          slotProps={{\n            textField: {\n              error: Boolean(fieldState.error),\n              helperText: fieldState.error?.message ?? helperText,\n              fullWidth: true,\n            },\n          }}\n        />\n      )}\n    />\n  );\n}\n\nexport function DateTimePickerFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n}: BaseProps<TFieldValues>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <DateTimePicker\n          label={label}\n          value={field.value ?? null}\n          onChange={field.onChange}\n          slotProps={{\n            textField: {\n              error: Boolean(fieldState.error),\n              helperText: fieldState.error?.message ?? helperText,\n              fullWidth: true,\n            },\n          }}\n        />\n      )}\n    />\n  );\n}\n","numLines":238,"startLine":1,"totalLines":238}}}
