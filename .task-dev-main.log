{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TUCSwb8H4UWiwkcoTNubRF","type":"tool_result","content":"415\t      },\n416\t    },\n417\t    select: { id: true, name: true, capacity: true },\n418\t    orderBy: { name: 'asc' },\n419\t  });\n420\t}\n421\t\n422\texport type SlotTarget =\n423\t  | { kind: 'section'; sectionId: string }\n424\t  | { kind: 'teacher'; userId: string }\n425\t  | { kind: 'room'; roomId: string }\n426\t  | { kind: 'student'; studentId: string };\n427\t\n428\tfunction slotWhere(target: SlotTarget): Prisma.TimetableSlotWhereInput {\n429\t  switch (target.kind) {\n430\t    case 'section':\n431\t      return { course: { sectionId: target.sectionId } };\n432\t    case 'teacher':\n433\t      return { course: { OR: [{ teacherId: target.userId }, { coTeacherIds: { has: target.userId } }] } };\n434\t    case 'room':\n435\t      return { roomId: target.roomId };\n436\t    case 'student':\n437\t      return { course: { enrollments: { some: { studentId: target.studentId, status: 'ACTIVE' } } } };\n438\t  }\n439\t}\n440\t\n441\tasync function loadView(target: SlotTarget | null, academicYearId: string | null) {\n442\t  const [periods, days, slots] = await Promise.all([\n443\t    listPeriods(),\n444\t    loadDays(),\n445\t    target && academicYearId\n446\t      ? prisma.timetableSlot.findMany({ where: { academicYearId, ...slotWhere(target) }, include: slotInclude })\n447\t      : Promise.resolve([] as ExpandedSlot[]),\n448\t  ]);\n449\t  return { periods, days, slots };\n450\t}\n451\t\n452\texport type TimetableViewData = Awaited<ReturnType<typeof loadView>>;\n453\t\n454\t/** Everything the grid needs in one response (NFR-2). */\n455\texport function getTimetable(view: TimetableViewKind, id: string, academicYearId: string) {\n456\t  const target: SlotTarget =\n457\t    view === 'section' ? { kind: 'section', sectionId: id } : view === 'teacher' ? { kind: 'teacher', userId: id } : { kind: 'room', roomId: id };\n458\t  return loadView(target, academicYearId);\n459\t}\n460\t\n461\t/** FR-35 / D8. ADMIN any view; TEACHER own teacher view or sections they homeroom/teach; else FORBIDDEN. */\n462\texport async function assertCanViewTimetable(user: { id: string; role: Role }, view: TimetableViewKind, id: string) {\n463\t  if (user.role === 'ADMIN') return;\n464\t  if (user.role === 'TEACHER') {\n465\t    if (view === 'teacher' && id === user.id) return;\n466\t    if (view === 'section') {\n467\t      const section = await prisma.section.findFirst({\n468\t        where: {\n469\t          id,\n470\t          OR: [\n471\t            { homeroomTeacherId: user.id },\n472\t            { courses: { some: { archivedAt: null, OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] } } },\n473\t          ],\n474\t        },\n475\t        select: { id: true },\n476\t      });\n477\t      if (section) return;\n478\t    }\n479\t  }\n480\t  throw new AppError('FORBIDDEN', 'You do not have permission to view this timetable.');\n481\t}\n482\t\n483\tasync function currentYearId() {\n484\t  const year = await prisma.academicYear.findFirst({ where: { isCurrent: true }, select: { id: true } });\n485\t  return year?.id ?? null;\n486\t}\n487\t\n488\tasync function schoolTimezone() {\n489\t  const settings = await prisma.schoolSettings.findUnique({ where: { id: 'singleton' }, select: { timezone: true } });\n490\t  return settings?.timezone ?? 'UTC';\n491\t}\n492\t\n493\texport type PersonalTarget = { kind: 'teacher'; userId: string } | { kind: 'student'; studentId: string };\n494\t\n495\t/**\n496\t * FR-25/FR-38 access, shared by GET /api/me/timetable and the /timetable page (NFR-7).\n497\t * null = no personal timetable (ADMIN, D5; or a parent with no linked child).\n498\t */\n499\texport async function resolvePersonalTarget(\n500\t  user: { id: string; role: Role },\n501\t  studentId?: string,\n502\t): Promise<PersonalTarget | null> {\n503\t  switch (user.role) {\n504\t    case 'TEACHER':\n505\t      return { kind: 'teacher', userId: user.id };\n506\t    case 'STUDENT':\n507\t      if (studentId && studentId !== user.id) throw new AppError('FORBIDDEN', 'You can only view your own timetable.');\n508\t      return { kind: 'student', studentId: user.id };\n509\t    case 'PARENT': {\n510\t      const links = await prisma.parentStudentLink.findMany({ where: { parentId: user.id }, select: { studentId: true } });\n511\t      if (studentId) {\n512\t        if (!links.some((l) => l.studentId === studentId)) {\n513\t          throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n514\t        }\n515\t        return { kind: 'student', studentId };\n516\t      }\n517\t      if (links.length > 1) throw new AppError('VALIDATION_ERROR', 'studentId is required when you have more than one child.');\n518\t      return links.length ? { kind: 'student', studentId: links[0].studentId } : null;\n519\t    }\n520\t    default:\n521\t      return null;\n522\t  }\n523\t}\n524\t\n525\t/** Teacher (incl. co-taught) or student (ACTIVE enrollments) week; year defaults to the current one. */\n526\texport async function getPersonalTimetable(target: PersonalTarget | null, academicYearId?: string) {\n527\t  return loadView(target, academicYearId ?? (await currentYearId()));\n528\t}\n529\t\n530\t// ---------------------------------------------------------------------------\n531\t// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n532\t// ---------------------------------------------------------------------------\n533\t\n534\texport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\n535\texport interface ScheduleEntry {\n536\t  period: ExpandedSlot['period'];\n537\t  course: ExpandedSlot['course'];\n538\t  room: ExpandedSlot['room'];\n539\t}\n540\t\n541\t/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\n542\texport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n543\t  let slotTarget: SlotTarget | null;\n544\t  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n545\t  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n546\t  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n547\t  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n548\t\n549\t  const { isoDay } = schoolNow(date, await schoolTimezone());\n550\t  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n551\t  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n552\t  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n553\t\n554\t  const academicYearId = await currentYearId();\n555\t  if (!academicYearId) return [];\n556\t  const slots = await prisma.timetableSlot.findMany({\n557\t    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n558\t    include: slotInclude,\n559\t    orderBy: { period: { order: 'asc' } },\n560\t  });\n561\t  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n562\t}\n563\t\n564\t/** The entry running at `now` in the school timezone, else null. */\n565\texport async function getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null> {\n566\t  const [schedule, tz] = await Promise.all([getScheduleForDate(user, now), schoolTimezone()]);\n567\t  const { hhmm } = schoolNow(now, tz);\n568\t  return schedule.find((s) => s.period.startTime <= hhmm && hhmm < s.period.endTime) ?? null;\n569\t}\n570\t\n571\tfunction stripUndefined<T extends object>(obj: T) {\n572\t  return Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== undefined)) as Partial<T>;\n573\t}\n574\t"}]},"parent_tool_use_id":null,"session_id":"7fe1befa-2c95-4276-8d14-955b8d55df5c","uuid":"ba47c330-5059-4a46-8586-bfbb9b1b7d72","timestamp":"2026-11-06T05:40:14.804Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/src/server/timetable/timetable-service.ts","content":"      },\n    },\n    select: { id: true, name: true, capacity: true },\n    orderBy: { name: 'asc' },\n  });\n}\n\nexport type SlotTarget =\n  | { kind: 'section'; sectionId: string }\n  | { kind: 'teacher'; userId: string }\n  | { kind: 'room'; roomId: string }\n  | { kind: 'student'; studentId: string };\n\nfunction slotWhere(target: SlotTarget): Prisma.TimetableSlotWhereInput {\n  switch (target.kind) {\n    case 'section':\n      return { course: { sectionId: target.sectionId } };\n    case 'teacher':\n      return { course: { OR: [{ teacherId: target.userId }, { coTeacherIds: { has: target.userId } }] } };\n    case 'room':\n      return { roomId: target.roomId };\n    case 'student':\n      return { course: { enrollments: { some: { studentId: target.studentId, status: 'ACTIVE' } } } };\n  }\n}\n\nasync function loadView(target: SlotTarget | null, academicYearId: string | null) {\n  const [periods, days, slots] = await Promise.all([\n    listPeriods(),\n    loadDays(),\n    target && academicYearId\n      ? prisma.timetableSlot.findMany({ where: { academicYearId, ...slotWhere(target) }, include: slotInclude })\n      : Promise.resolve([] as ExpandedSlot[]),\n  ]);\n  return { periods, days, slots };\n}\n\nexport type TimetableViewData = Awaited<ReturnType<typeof loadView>>;\n\n/** Everything the grid needs in one response (NFR-2). */\nexport function getTimetable(view: TimetableViewKind, id: string, academicYearId: string) {\n  const target: SlotTarget =\n    view === 'section' ? { kind: 'section', sectionId: id } : view === 'teacher' ? { kind: 'teacher', userId: id } : { kind: 'room', roomId: id };\n  return loadView(target, academicYearId);\n}\n\n/** FR-35 / D8. ADMIN any view; TEACHER own teacher view or sections they homeroom/teach; else FORBIDDEN. */\nexport async function assertCanViewTimetable(user: { id: string; role: Role }, view: TimetableViewKind, id: string) {\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER') {\n    if (view === 'teacher' && id === user.id) return;\n    if (view === 'section') {\n      const section = await prisma.section.findFirst({\n        where: {\n          id,\n          OR: [\n            { homeroomTeacherId: user.id },\n            { courses: { some: { archivedAt: null, OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] } } },\n          ],\n        },\n        select: { id: true },\n      });\n      if (section) return;\n    }\n  }\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this timetable.');\n}\n\nasync function currentYearId() {\n  const year = await prisma.academicYear.findFirst({ where: { isCurrent: true }, select: { id: true } });\n  return year?.id ?? null;\n}\n\nasync function schoolTimezone() {\n  const settings = await prisma.schoolSettings.findUnique({ where: { id: 'singleton' }, select: { timezone: true } });\n  return settings?.timezone ?? 'UTC';\n}\n\nexport type PersonalTarget = { kind: 'teacher'; userId: string } | { kind: 'student'; studentId: string };\n\n/**\n * FR-25/FR-38 access, shared by GET /api/me/timetable and the /timetable page (NFR-7).\n * null = no personal timetable (ADMIN, D5; or a parent with no linked child).\n */\nexport async function resolvePersonalTarget(\n  user: { id: string; role: Role },\n  studentId?: string,\n): Promise<PersonalTarget | null> {\n  switch (user.role) {\n    case 'TEACHER':\n      return { kind: 'teacher', userId: user.id };\n    case 'STUDENT':\n      if (studentId && studentId !== user.id) throw new AppError('FORBIDDEN', 'You can only view your own timetable.');\n      return { kind: 'student', studentId: user.id };\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({ where: { parentId: user.id }, select: { studentId: true } });\n      if (studentId) {\n        if (!links.some((l) => l.studentId === studentId)) {\n          throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n        }\n        return { kind: 'student', studentId };\n      }\n      if (links.length > 1) throw new AppError('VALIDATION_ERROR', 'studentId is required when you have more than one child.');\n      return links.length ? { kind: 'student', studentId: links[0].studentId } : null;\n    }\n    default:\n      return null;\n  }\n}\n\n/** Teacher (incl. co-taught) or student (ACTIVE enrollments) week; year defaults to the current one. */\nexport async function getPersonalTimetable(target: PersonalTarget | null, academicYearId?: string) {\n  return loadView(target, academicYearId ?? (await currentYearId()));\n}\n\n// ---------------------------------------------------------------------------\n// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n// ---------------------------------------------------------------------------\n\nexport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\nexport interface ScheduleEntry {\n  period: ExpandedSlot['period'];\n  course: ExpandedSlot['course'];\n  room: ExpandedSlot['room'];\n}\n\n/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\nexport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n  let slotTarget: SlotTarget | null;\n  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n\n  const { isoDay } = schoolNow(date, await schoolTimezone());\n  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n\n  const academicYearId = await currentYearId();\n  if (!academicYearId) return [];\n  const slots = await prisma.timetableSlot.findMany({\n    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n    include: slotInclude,\n    orderBy: { period: { order: 'asc' } },\n  });\n  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n}\n\n/** The entry running at `now` in the school timezone, else null. */\nexport async function getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null> {\n  const [schedule, tz] = await Promise.all([getScheduleForDate(user, now), schoolTimezone()]);\n  const { hhmm } = schoolNow(now, tz);\n  return schedule.find((s) => s.period.startTime <= hhmm && hhmm < s.period.endTime) ?? null;\n}\n\nfunction stripUndefined<T extends object>(obj: T) {\n  return Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== undefined)) as Partial<T>;\n}\n","numLines":160,"startLine":415,"totalLines":574}},"tool_result_meta":[{"id":"toolu_01TUCSwb8H4UWiwkcoTNubRF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
