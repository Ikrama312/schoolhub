'@/server/http';\nimport { getAccessibleStudentIds } from '@/server/auth/student-access';\nimport { getStudentGrades, type StudentGrades } from '@/server/gradebook/student-grades-service';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { GradesClient } from './GradesClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /grades — PRD-11 FR-27. STUDENT sees self; PARENT picks a linked child. */\nexport default async function GradesPage({ searchParams }: { searchParams: { studentId?: string } }) {\n  const user = await requirePageRole('STUDENT', 'PARENT');\n  const accessible = await getAccessibleStudentIds(user);\n  const ids = accessible === 'ALL' ? [] : accessible;\n  const children = await prisma.user.findMany({\n    where: { id: { in: ids }, role: 'STUDENT' },\n    select: { id: true, firstName: true, lastName: true },\n    orderBy: [{ firstName: 'asc' }, { lastName: 'asc' }],\n  });\n  if (!children.length) {\n    return (\n      <>\n        <PageHeader title=\"Grades\" />\n        <EmptyState title=\"No linked students\" description=\"Ask the school office to link your account to your child.\" />\n      </>\n    );\n  }\n  const studentId = searchParams.studentId && children.some((c) => c.id === searchParams.studentId) ? searchParams.studentId : children[0].id;\n  let data: StudentGrades;\n  try {\n    data = await getStudentGrades(user, studentId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  return (\n    <>\n      <PageHeader title=\"Grades\" description={user.role === 'PARENT' ? undefined : 'Your current standing in each course.'} />\n      <GradesClient\n        key={studentId}\n        initial={JSON.parse(JSON.stringify(data))}\n        children={user.role === 'PARENT' ? children.map((c) => ({ id: c.id, name: `${c.firstName} ${c.lastName}` })) : []}\n      />\n    </>\n  );\n}\nEOF\ncat > \"src/app/(app)/grades/GradesClient.tsx\" <<'EOF'\n'use client';\n\nimport { usePathname, useRouter } from 'next/navigation';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport { StudentGradesView } from '@/components/gradebook/StudentGradesView';\nimport type { StudentGrades } from '@/server/gradebook/student-grades-service';\n\n/** FR-27: parent child selector (empty for students) above the shared grades view. */\nexport function GradesClient({ initial, children }: { initial: StudentGrades; children: { id: string; name: string }[] }) {\n  const router = useRouter();\n  const pathname = usePathname();\n  return (\n    <Stack spacing={2}>\n      {children.length > 1 && (\n        <TextField select size=\"small\" label=\"Child\" value={initial.student.id} onChange={(e) => router.push(`${pathname}?studentId=${e.target.value}`)} sx={{ maxWidth: 280 }}>\n          {children.map((c) => (\n            <MenuItem key={c.id} value={c.id}>\n              {c.name}\n            </MenuItem>\n          ))}\n        </TextField>\n      )}\n      <StudentGradesView initial={initial} />\n    </Stack>\n  );\n}\nEOF\ncat > \"src/app/(app)/courses/[courseId]/grades/page.tsx\" <<'EOF'\nimport { notFound, redirect } from 'next/navigation';\nimport { prisma } from '@/server/db';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getStudentGrades, type StudentGrades } from '@/server/gradebook/student-grades-service';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { StudentGradesView } from '@/components/gradebook/StudentGradesView';\nimport { GradesClient } from '../../../grades/GradesClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course \"Grades\" tab — PRD-11 FR-28: this course's items only. The course layout gates view access. */\nexport default async function CourseGradesPage({ params, searchParams }: { params: { courseId: string }; searchParams: { studentId?: string } }) {\n  const user = await requirePageRole('STUDENT', 'PARENT');\n  const children =\n    user.role === 'PARENT'\n      ? await prisma.user.findMany({\n          where: { studentLinks: { some: { parentId: user.id } }, enrollments: { some: { courseId: params.courseId, status: 'ACTIVE' } } },\n          select: { id: true, firstName: true, lastName: true },\n          orderBy: { firstName: 'asc' },\n        })\n      : [];\n  if (user.role === 'PARENT' && !children.length) return <EmptyState title=\"No linked students in this course\" />;\n  const studentId = user.role === 'STUDENT' ? user.id : children.find((c) => c.id === searchParams.studentId)?.id ?? children[0].id;\n  let data: StudentGrades;\n  try {\n    data = await getStudentGrades(user, studentId, undefined, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const initial = JSON.parse(JSON.stringify(data));\n  if (user.role === 'PARENT') return <GradesClient key={studentId} initial={initial} children={children.map((c) => ({ id: c.id, name: `${c.firstName} ${c.lastName}` }))} />;\n  return <StudentGradesView initial={initial} courseId={params.courseId} />;\n}\nEOF\nnpx tsc --noEmit | head; npx eslint \"src/app/(app)/grades\" \"src/app/(app)/courses/[courseId]/grades\" src/components/gradebook \"src/app/(app)/admin/grading-scales\" 2>&1 | tail -15","description":"Write student/parent grade pages; typecheck and lint"}}}
