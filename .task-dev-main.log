tedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id              String           @id @default(cuid())\n  name            String           @unique\n  shortName       String           @unique\n  order           Int              @unique\n  archivedAt      DateTime?\n  createdAt       DateTime         @default(now())\n  updatedAt       DateTime         @updatedAt\n  studentProfiles StudentProfile[]\n  sections        Section[]\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n  courses     Course[]\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n  sections   Section[]\n}\n\n/// In-app notification (PRD-04 FR-1). type is a key from the compile-time\n/// registry (src/server/notifications/types.ts) rather than an enum/FK, so\n/// later PRDs register new keys without a migration. category is resolved\n/// from the registry at read time (src/server/notifications/list.ts), not\n/// stored here. The composite index backs both getUnreadCount() (NFR-3,\n/// <50ms) and listNotifications()'s own-rows-newest-first query.\nmodel Notification {\n  id        String    @id @default(cuid())\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  title     String\n  body      String?\n  link      String?\n  readAt    DateTime?\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n\n  @@index([userId, readAt, createdAt])\n}\n\n/// Per-user, per-type override of the registry's defaultEmail/mandatoryInApp\n/// defaults (PRD-04 FR-3). Composite PK instead of a surrogate id/unique\n/// index -- there is exactly one row per (userId, type) by construction\n/// (notify.ts and the preferences PUT route both upsert on it).\nmodel NotificationPreference {\n  userId    String\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  inApp     Boolean  @default(true)\n  email     Boolean  @default(true)\n  updatedAt DateTime @updatedAt\n\n  @@id([userId, type])\n}\n\n/// Durable outbox row the dispatcher claims and sends (PRD-04 FR-1/FR-5).\n/// No FK to User -- toEmail/toName are a point-in-time snapshot (matches\n/// the PRD's schema block exactly) so a later email change or user deletion\n/// never blocks a queued send. updatedAt doubles as the \"flipped to\n/// SENDING\" timestamp the >10-minute stuck-row recovery checks (NFR-4) --\n/// Prisma's @updatedAt already bumps it on that status-flip UPDATE, so no\n/// separate column is needed.\nmodel EmailOutbox {\n  id            String      @id @default(cuid())\n  toEmail       String\n  toName        String?\n  subject       String\n  html          String\n  text          String\n  status        EmailStatus @default(PENDING)\n  attempts      Int         @default(0)\n  lastError     String?\n  nextAttemptAt DateTime    @default(now())\n  sentAt        DateTime?\n  createdAt     DateTime    @default(now())\n  updatedAt     DateTime    @updatedAt\n\n  @@index([status, nextAttemptAt])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-05 Classes & Enrollment (FR-1). Shapes match the PRD schema block\n// exactly; business rules (capacity, CORE auto-enroll, homeroom-once-per-year)\n// live in src/server/enrollment/roster-engine.ts and the sections/courses\n// services, not here.\n// ---------------------------------------------------------------------------\n\nenum CourseKind {\n  CORE\n  ELECTIVE\n}\n\nenum EnrollmentStatus {\n  ACTIVE\n  DROPPED\n}\n\n/// Homeroom group, e.g. \"7A\". capacity is 1-60 (validated in zod).\nmodel Section {\n  id                String          @id @default(cuid())\n  academicYearId    String\n  academicYear      AcademicYear    @relation(fields: [academicYearId], references: [id])\n  gradeLevelId      String\n  gradeLevel        GradeLevel      @relation(fields: [gradeLevelId], references: [id])\n  name              String\n  homeroomTeacherId String?\n  homeroomTeacher   User?           @relation(\"HomeroomTeacher\", fields: [homeroomTeacherId], references: [id])\n  roomId            String?\n  room              Room?           @relation(fields: [roomId], references: [id])\n  capacity          Int             @default(30)\n  createdAt         DateTime        @default(now())\n  updatedAt         DateTime        @updatedAt\n  members           SectionMember[]\n  courses           Course[]\n\n  @@unique([academicYearId, name])\n}\n\n/// academicYearId is denormalised so the DB enforces one section per\n/// student per year (NFR-2).\nmodel SectionMember {\n  id             String   @id @default(cuid())\n  sectionId      String\n  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n  studentId      String\n  student        User     @relation(fields: [studentId], references: [id])\n  joinedAt       DateTime @default(now())\n  academicYearId String\n\n  @@unique([studentId, academicYearId])\n}\n\n/// sectionId is null for cross-section electives. coTeacherIds is a plain\n/// String[] exactly per FR-1 (queried with `has`), max 3 enforced in zod.\nmodel Course {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])\n  subjectId      String\n  subject        Subject      @relation(fields: [subjectId], references: [id])\n  sectionId      String?\n  section        Section?     @relation(fields: [sectionId], references: [id])\n  teacherId      String\n  teacher        User         @relation(\"CourseTeacher\", fields: [teacherId], references: [id])\n  coTeacherIds   String[]     @default([])\n  name           String\n  code           String\n  kind           CourseKind   @default(CORE)\n  description    String?\n  capacity       Int?\n  archivedAt     DateTime?\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n  enrollments    Enrollment[]\n\n  @@unique([academicYearId, code])\n}\n\n/// DROPPED rows are kept (never deleted) so later PRDs' attendance/grades\n/// history stays attached (FR-12).\nmodel Enrollment {\n  id         String           @id @default(cuid())\n  courseId   String\n  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  studentId  String\n  student    User             @relation(fields: [studentId], references: [id])\n  status     EnrollmentStatus @default(ACTIVE)\n  enrolledAt DateTime         @default(now())\n  droppedAt  DateTime?\n\n  @@unique([courseId, studentId])\n  @@index([studentId, status])\n}\n     114 prisma/seed.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LnEqW49PC8T581bAgaXy4t","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
