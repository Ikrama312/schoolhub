{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016xhVxB7PRbEW25pJbpnzuw","type":"tool_result","content":"import { z } from 'zod';\nimport { ok, paginated, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { createUser, listUsers } from '@/server/services/users';\nimport { createUserSchema, ROLE_VALUES } from '@/lib/validators/users';\n\nconst listQuerySchema = z.object({\n  role: z.string().optional(),\n  status: z.enum(['ACTIVE', 'INVITED', 'DISABLED', 'ARCHIVED']).optional(),\n  gradeLevelId: z.string().optional(),\n  q: z.string().optional(),\n  includeArchived: z.enum(['true', 'false']).optional(),\n});\n\n/** GET/POST /api/users — ADMIN only (FR-2, FR-3, FR-6..FR-10, NFR-2). */\nexport const GET = withHandler(async (request: Request) => {\n  requireRole('ADMIN');\n\n  const url = new URL(request.url);\n  const query = parseQuery(url.searchParams, listQuerySchema);\n  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n\n  const roleFilter = query.role\n    ? query.role\n        .split(',')\n        .map((value) => value.trim())\n        .filter((value): value is (typeof ROLE_VALUES)[number] => ROLE_VALUES.includes(value as never))\n    : undefined;\n\n  const { rows, total } = await listUsers(\n    {\n      role: roleFilter,\n      status: query.status,\n      gradeLevelId: query.gradeLevelId,\n      q: query.q,\n      includeArchived: query.includeArchived === 'true',\n    },\n    { skip, take },\n  );\n\n  return paginated(rows, { page, pageSize, total });\n});\n\nexport const POST = withHandler(async (request: Request) => {\n  const actor = requireRole('ADMIN');\n  const json = await request.json();\n  const input = createUserSchema.parse(json);\n\n  const user = await createUser(input);\n  await audit({ actorId: actor.id, action: 'user.created', entityType: 'User', entityId: user.id });\n\n  return ok(user, { status: 201 });\n});\nimport { ok, withHandler, AppError } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { getUserDetail, updateUser } from '@/server/services/users';\nimport { updateUserSchema } from '@/lib/validators/users';\n\n/** GET/PATCH /api/users/:id — ADMIN only (FR-8, FR-9, FR-10, FR-11). */\nexport const GET = withHandler(async (_request: Request, { params }: { params: { id: string } }) => {\n  requireRole('ADMIN');\n  const detail = await getUserDetail(params.id);\n  return ok(detail);\n});\n\nexport const PATCH = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const actor = requireRole('ADMIN');\n  const json = await request.json();\n\n  // FR-9: role is immutable — reject outright if the client sends a\n  // different one rather than silently dropping it, so the form's \"role\n  // is read-only on edit\" convention is also a real server-side guarantee.\n  if ('role' in json) {\n    const existing = await getUserDetail(params.id);\n    if (json.role !== existing.role) {\n      throw new AppError('VALIDATION_ERROR', 'Role cannot be changed after a user is created.');\n    }\n  }\n\n  const input = updateUserSchema.parse(json);\n  const user = await updateUser(params.id, input);\n  await audit({\n    actorId: actor.id,\n    action: 'user.updated',\n    entityType: 'User',\n    entityId: params.id,\n    metadata: { fields: Object.keys(input) },\n  });\n\n  return ok(user);\n});\nimport { z } from 'zod';\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { listUsers } from '@/server/services/users';\nimport { ROLE_VALUES } from '@/lib/validators/users';\n\nconst querySchema = z.object({\n  role: z.enum(ROLE_VALUES).optional(),\n  q: z.string().optional(),\n});\n\nconst SEARCH_ROW_CAP = 20;\n\n/** GET /api/users/search — ADMIN/TEACHER only, picker search (FR-28). Excludes archived, capped to 20 rows. */\nexport const GET = withHandler(async (request: Request) => {\n  requireRole('ADMIN', 'TEACHER');\n\n  const url = new URL(request.url);\n  const query = parseQuery(url.searchParams, querySchema);\n\n  const { rows } = await listUsers(\n    { role: query.role ? [query.role] : undefined, q: query.q, includeArchived: false },\n    { skip: 0, take: SEARCH_ROW_CAP },\n  );\n\n  return ok(\n    rows.map((row) => ({\n      id: row.id,\n      name: `${row.firstName} ${row.lastName}`,\n      email: row.email,\n      role: row.role,\n    })),\n  );\n});\nimport { ok, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { listLinksForParent } from '@/server/services/userLinks';\n\n/** GET /api/me/children — PARENT only (FR-26). */\nexport const GET = withHandler(async () => {\n  const actor = requireRole('PARENT');\n  const links = await listLinksForParent(actor.id);\n\n  const children = await Promise.all(\n    links.map(async (link) => {\n      const { prisma } = await import('@/server/db');\n      const profile = await prisma.studentProfile.findUnique({\n        where: { userId: link.studentId },\n        include: { gradeLevel: true },\n      });\n      return {\n        id: link.studentId,\n        name: `${link.student.firstName} ${link.student.lastName}`,\n        gradeLevelName: profile?.gradeLevel.name ?? null,\n        admissionNumber: profile?.admissionNumber ?? null,\n      };\n    }),\n  );\n\n  return ok(children);\n});\nimport { z } from 'zod';\n\n/**\n * Single source of truth for user/profile validation (FR-10, FR-19, FR-20).\n * Reused as: the React Hook Form resolver for the create/edit Stepper, the\n * CSV row validator for the import preview grid (client), and the\n * server-side re-validator in /api/users/import (never trusts the client).\n */\n\nexport const PHONE_REGEX = /^\\+?[0-9 ()-]{7,20}$/;\nconst EMAIL_REGEX = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst STRICT_DATE_REGEX = /^\\d{4}-\\d{2}-\\d{2}$/;\n\nfunction emptyToUndefined(value: unknown) {\n  return value === '' || value === null ? undefined : value;\n}\n\nexport const phoneSchema = z.string().regex(PHONE_REGEX, 'Phone must look like +1 555-123-4567');\nexport const optionalPhoneSchema = z.preprocess(emptyToUndefined, phoneSchema.optional());\n\nexport const requiredEmailSchema = z.string().regex(EMAIL_REGEX, 'Invalid email address');\nexport const optionalEmailSchema = z.preprocess(emptyToUndefined, requiredEmailSchema.optional());\n\n/** Parses a strict YYYY-MM-DD string (CSV / date-only API input) into a Date. */\nexport function strictDateSchema(label: string) {\n  return z\n    .string()\n    .regex(STRICT_DATE_REGEX, `${label} must be in YYYY-MM-DD format`)\n    .refine((value) => !Number.isNaN(Date.parse(value)), `${label} is not a valid date`)\n    .transform((value) => new Date(`${value}T00:00:00.000Z`));\n}\n\nexport function calculateAgeYears(dateOfBirth: Date, asOf: Date = new Date()): number {\n  let age = asOf.getUTCFullYear() - dateOfBirth.getUTCFullYear();\n  const monthDiff = asOf.getUTCMonth() - dateOfBirth.getUTCMonth();\n  if (monthDiff < 0 || (monthDiff === 0 && asOf.getUTCDate() < dateOfBirth.getUTCDate())) {\n    age -= 1;\n  }\n  return age;\n}\n\n/** FR-10: a student's date of birth must make them between 3 and 21 years old. */\nexport function isValidStudentAge(dateOfBirth: Date): boolean {\n  const age = calculateAgeYears(dateOfBirth);\n  return age >= 3 && age <= 21;\n}\n\nexport const GENDER_VALUES = ['FEMALE', 'MALE', 'OTHER', 'UNDISCLOSED'] as const;\nexport const GUARDIAN_RELATIONSHIP_VALUES = ['MOTHER', 'FATHER', 'GUARDIAN', 'GRANDPARENT', 'OTHER'] as const;\nexport const ROLE_VALUES = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'] as const;\n\nconst studentDobSchema = z.coerce\n  .date()\n  .refine(isValidStudentAge, { message: 'Student must be between 3 and 21 years old' });\n\n// ---- Form / API body schemas (role-specific profile shapes) ----\n\nexport const studentProfileSchema = z.object({\n  dateOfBirth: studentDobSchema,\n  gender: z.enum(GENDER_VALUES).default('UNDISCLOSED'),\n  gradeLevelId: z.string().min(1, 'Grade level is required'),\n  enrollmentDate: z.coerce.date().default(() => new Date()),\n  addressLine1: z.string().optional(),\n  city: z.string().optional(),\n  medicalNotes: z.string().optional(),\n  emergencyContact: z.string().optional(),\n  emergencyPhone: optionalPhoneSchema,\n});\nexport type StudentProfileInput = z.infer<typeof studentProfileSchema>;\n\nexport const teacherProfileSchema = z.object({\n  title: z.string().optional(),\n  qualifications: z.string().optional(),\n  hireDate: z.coerce.date().optional(),\n});\nexport type TeacherProfileInput = z.infer<typeof teacherProfileSchema>;\n\nexport const parentProfileSchema = z.object({\n  occupation: z.string().optional(),\n  address: z.string().optional(),\nConfirmDialog.test.tsx\nDataTable.test.tsx\ndates.test.ts\nenv.test.ts\neslint-no-restricted-imports.test.ts\nhttp.test.ts\nuseToast.test.tsx\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}'],\n  },\n});\nimport { describe, expect, it, vi } from 'vitest';\nimport { z, ZodError } from 'zod';\nimport { Prisma } from '@prisma/client';\nimport { AppError, ok, paginated, apiError, withHandler, parsePagination, parseBody, parseQuery } from '@/server/http';\n\nvi.mock('@/lib/logger', () => ({\n  logger: { info: vi.fn(), warn: vi.fn(), error: vi.fn() },\n}));\n\ndescribe('ok/paginated/apiError envelopes', () => {\n  it('ok() wraps the payload in { data }', async () => {\n    const res = ok({ foo: 'bar' });\n    expect(res.status).toBe(200);\n    expect(await res.json()).toEqual({ data: { foo: 'bar' } });\n  });\n\n  it('paginated() includes data + meta', async () => {\n    const res = paginated([1, 2], { page: 1, pageSize: 20, total: 2 });\n    expect(await res.json()).toEqual({ data: [1, 2], meta: { page: 1, pageSize: 20, total: 2 } });\n  });\n\n  it('apiError() maps each code to its documented status', async () => {\n    expect((await apiError('VALIDATION_ERROR', 'bad')).status).toBe(400);\n    expect((await apiError('NOT_FOUND', 'missing')).status).toBe(404);\n    expect((await apiError('CONFLICT', 'dupe')).status).toBe(409);\n    expect((await apiError('INTERNAL', 'boom')).status).toBe(500);\n    const res = apiError('NOT_FOUND', 'missing', { id: '1' });\n    expect(await res.json()).toEqual({ error: { code: 'NOT_FOUND', message: 'missing', details: { id: '1' } } });\n  });\n});\n\ndescribe('withHandler error mapping', () => {\n  it('maps ZodError to VALIDATION_ERROR (400)', async () => {\n    const handler = withHandler(async () => {\n      z.object({ name: z.string() }).parse({});\n      throw new Error('unreachable');\n    });\n    const res = await handler();\n    expect(res.status).toBe(400);\n    expect((await res.json()).error.code).toBe('VALIDATION_ERROR');\n  });\n\n  it('maps AppError to its own code/status', async () => {\n    const handler = withHandler(async () => {\n      throw new AppError('CONFLICT', 'already exists');\n    });\n    const res = await handler();\n    expect(res.status).toBe(409);\n    expect((await res.json()).error).toEqual({ code: 'CONFLICT', message: 'already exists' });\n  });\n\n  it('maps Prisma P2002 to CONFLICT', async () => {\n    const handler = withHandler(async () => {\n      throw new Prisma.PrismaClientKnownRequestError('Unique constraint failed', {\n        code: 'P2002',\n        clientVersion: '5.20.0',\n        meta: { target: ['email'] },\n      });\n    });\n    const res = await handler();\n    expect(res.status).toBe(409);\n    expect((await res.