{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01687vxbkVFobe2HphRf9Qg8","type":"tool_result","content":"78\t  });\n79\t\n80\t  const year = await prisma.academicYear.upsert({\n81\t    where: { name: '2026-2027' },\n82\t    update: { isCurrent: true },\n83\t    create: {\n84\t      name: '2026-2027',\n85\t      startDate: new Date('2026-08-17'),\n86\t      endDate: new Date('2027-06-11'),\n87\t      isCurrent: true,\n88\t    },\n89\t  });\n90\t\n91\t  const semesters: { name: string; startDate: string; endDate: string; order: number }[] = [\n92\t    { name: 'Semester 1', startDate: '2026-08-17', endDate: '2027-01-15', order: 1 },\n93\t    { name: 'Semester 2', startDate: '2027-01-18', endDate: '2027-06-11', order: 2 },\n94\t  ];\n95\t  for (const term of semesters) {\n96\t    await prisma.term.upsert({\n97\t      where: { academicYearId_name: { academicYearId: year.id, name: term.name } },\n98\t      update: {},\n99\t      create: {\n100\t        academicYearId: year.id,\n101\t        name: term.name,\n102\t        startDate: new Date(term.startDate),\n103\t        endDate: new Date(term.endDate),\n104\t        order: term.order,\n105\t      },\n106\t    });\n107\t  }\n108\t\n109\t  const gradeLevels = [\n110\t    { name: 'Grade 6', shortName: 'G6', order: 1 },\n111\t    { name: 'Grade 7', shortName: 'G7', order: 2 },\n112\t    { name: 'Grade 8', shortName: 'G8', order: 3 },\n113\t  ];\n114\t  for (const grade of gradeLevels) {\n115\t    await prisma.gradeLevel.upsert({ where: { name: grade.name }, update: {}, create: grade });\n116\t  }\n117\t\n118\t  const subjects = [\n119\t    { name: 'Mathematics', code: 'MATH', color: '#4F46E5' },\n120\t    { name: 'English Language Arts', code: 'ELA', color: '#0EA5E9' },\n121\t    { name: 'Science', code: 'SCI', color: '#16A34A' },\n122\t    { name: 'Social Studies', code: 'SOC', color: '#D97706' },\n123\t    { name: 'Physical Education', code: 'PE', color: '#DC2626' },\n124\t    { name: 'Art', code: 'ART', color: '#9333EA' },\n125\t  ];\n126\t  for (const subject of subjects) {\n127\t    await prisma.subject.upsert({ where: { code: subject.code }, update: {}, create: subject });\n128\t  }\n129\t\n130\t  const rooms = [\n131\t    { name: 'Room 101', building: 'Main Building', capacity: 30 },\n132\t    { name: 'Room 102', building: 'Main Building', capacity: 28 },\n133\t    { name: 'Science Lab A', building: 'Science Wing', capacity: 24 },\n134\t    { name: 'Gymnasium', building: 'Athletics Building', capacity: 120 },\n135\t    { name: 'Art Studio', building: 'Main Building', capacity: 20 },\n136\t  ];\n137\t  for (const room of rooms) {\n138\t    await prisma.room.upsert({ where: { name: room.name }, update: {}, create: room });\n139\t  }\n140\t\n141\t  await seedUsers();\n142\t\n143\t  // PRD-04 FR-40: 3 system.test notifications (1 read, 2 unread) per demo user.\n144\t  // Users are owned by another PRD's seed, so a missing one is skipped, never created.\n145\t  for (const email of ['student@schoolhub.test', 'parent@schoolhub.test']) {\n146\t    const user = await prisma.user.findUnique({ where: { email }, select: { id: true } });\n147\t    if (!user) {\n148\t      console.log(`Seed: ${email} not found, skipping demo notifications`);\n149\t      continue;\n150\t    }\n151\t    const existing = await prisma.notification.count({ where: { userId: user.id, type: 'system.test' } });\n152\t    if (existing > 0) continue;\n153\t    await prisma.notification.createMany({\n154\t      data: [\n155\t        { title: 'Welcome to SchoolHub', body: 'Your notifications will appear here.', readAt: new Date() },\n156\t        { title: 'Check your dashboard', body: 'See what is new this week.', readAt: null },\n157\t        { title: 'Notification preferences', body: 'Choose how you hear about activity.', readAt: null },\n158\t      ].map((n) => ({ ...n, userId: user.id, type: 'system.test', link: '/dashboard' })),\n159\t    });\n160\t  }\n161\t}\n162\t\n163\tasync function disconnectAll() {\n164\t  await prisma.$disconnect();\n165\t  // The auth services use the app's shared client (src/server/db.ts).\n166\t  await (await import('../src/server/db')).prisma.$disconnect();\n167\t}\n168\t\n169\tmain()\n170\t  .then(disconnectAll)\n171\t  .catch(async (error) => {\n172\t    console.error(error);\n173\t    await disconnectAll();\n174\t    process.exit(1);\n175\t  });\n176\t"}]},"parent_tool_use_id":null,"session_id":"7fe1befa-2c95-4276-8d14-955b8d55df5c","uuid":"ea33cfd5-1a01-4d7a-8c03-bd9bcba6bac0","timestamp":"2026-11-06T05:40:41.397Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/prisma/seed.ts","content":"  });\n\n  const year = await prisma.academicYear.upsert({\n    where: { name: '2026-2027' },\n    update: { isCurrent: true },\n    create: {\n      name: '2026-2027',\n      startDate: new Date('2026-08-17'),\n      endDate: new Date('2027-06-11'),\n      isCurrent: true,\n    },\n  });\n\n  const semesters: { name: string; startDate: string; endDate: string; order: number }[] = [\n    { name: 'Semester 1', startDate: '2026-08-17', endDate: '2027-01-15', order: 1 },\n    { name: 'Semester 2', startDate: '2027-01-18', endDate: '2027-06-11', order: 2 },\n  ];\n  for (const term of semesters) {\n    await prisma.term.upsert({\n      where: { academicYearId_name: { academicYearId: year.id, name: term.name } },\n      update: {},\n      create: {\n        academicYearId: year.id,\n        name: term.name,\n        startDate: new Date(term.startDate),\n        endDate: new Date(term.endDate),\n        order: term.order,\n      },\n    });\n  }\n\n  const gradeLevels = [\n    { name: 'Grade 6', shortName: 'G6', order: 1 },\n    { name: 'Grade 7', shortName: 'G7', order: 2 },\n    { name: 'Grade 8', shortName: 'G8', order: 3 },\n  ];\n  for (const grade of gradeLevels) {\n    await prisma.gradeLevel.upsert({ where: { name: grade.name }, update: {}, create: grade });\n  }\n\n  const subjects = [\n    { name: 'Mathematics', code: 'MATH', color: '#4F46E5' },\n    { name: 'English Language Arts', code: 'ELA', color: '#0EA5E9' },\n    { name: 'Science', code: 'SCI', color: '#16A34A' },\n    { name: 'Social Studies', code: 'SOC', color: '#D97706' },\n    { name: 'Physical Education', code: 'PE', color: '#DC2626' },\n    { name: 'Art', code: 'ART', color: '#9333EA' },\n  ];\n  for (const subject of subjects) {\n    await prisma.subject.upsert({ where: { code: subject.code }, update: {}, create: subject });\n  }\n\n  const rooms = [\n    { name: 'Room 101', building: 'Main Building', capacity: 30 },\n    { name: 'Room 102', building: 'Main Building', capacity: 28 },\n    { name: 'Science Lab A', building: 'Science Wing', capacity: 24 },\n    { name: 'Gymnasium', building: 'Athletics Building', capacity: 120 },\n    { name: 'Art Studio', building: 'Main Building', capacity: 20 },\n  ];\n  for (const room of rooms) {\n    await prisma.room.upsert({ where: { name: room.name }, update: {}, create: room });\n  }\n\n  await seedUsers();\n\n  // PRD-04 FR-40: 3 system.test notifications (1 read, 2 unread) per demo user.\n  // Users are owned by another PRD's seed, so a missing one is skipped, never created.\n  for (const email of ['student@schoolhub.test', 'parent@schoolhub.test']) {\n    const user = await prisma.user.findUnique({ where: { email }, select: { id: true } });\n    if (!user) {\n      console.log(`Seed: ${email} not found, skipping demo notifications`);\n      continue;\n    }\n    const existing = await prisma.notification.count({ where: { userId: user.id, type: 'system.test' } });\n    if (existing > 0) continue;\n    await prisma.notification.createMany({\n      data: [\n        { title: 'Welcome to SchoolHub', body: 'Your notifications will appear here.', readAt: new Date() },\n        { title: 'Check your dashboard', body: 'See what is new this week.', readAt: null },\n        { title: 'Notification preferences', body: 'Choose how you hear about activity.', readAt: null },\n      ].map((n) => ({ ...n, userId: user.id, type: 'system.test', link: '/dashboard' })),\n    });\n  }\n}\n\nasync function disconnectAll() {\n  await prisma.$disconnect();\n  // The auth services use the app's shared client (src/server/db.ts).\n  await (await import('../src/server/db')).prisma.$disconnect();\n}\n\nmain()\n  .then(disconnectAll)\n  .catch(async (error) => {\n    console.error(error);\n    await disconnectAll();\n    process.exit(1);\n  });\n","numLines":99,"startLine":78,"totalLines":176}},"tool_result_meta":[{"id":"toolu_01687vxbkVFobe2HphRf9Qg8","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
