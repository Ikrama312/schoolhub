ed app shell: permanent/collapsible sidebar Drawer (256px/64px, localStorage-persisted) that forks to a temporary Drawer below 1024px, AppBar/Toolbar top bar with SchoolSettings branding + theme toggle + notification-bell/user-menu placeholders (auth slot only), role-filtered nav config, and the empty student-tabs extension point.\",\n      \"files\": [\"src/app/(app)/layout.tsx\", \"src/config/navigation.ts\", \"src/config/student-tabs.ts\"],\n      \"dependencies\": [\"TASK-4\", \"TASK-7\", \"TASK-12\"],\n      \"estimateHours\": 5,\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-32\", \"FR-33\", \"FR-35\", \"NFR-4\"]\n    },\n    {\n      \"id\": \"TASK-16\",\n      \"description\": \"/dashboard page rendering PageHeader 'Welcome to SchoolHub' and an EmptyState noting dashboards arrive in a later release.\",\n      \"files\": [\"src/app/(app)/dashboard/page.tsx\"],\n      \"dependencies\": [\"TASK-15\", \"TASK-8\"],\n      \"estimateHours\": 1,\n      \"requirementIds\": [\"FR-34\", \"NFR-2\"]\n    },\n    {\n      \"id\": \"TASK-17\",\n      \"description\": \"Public layout (header with logo/school name/Sign-in button, footer with SchoolSettings-sourced address/phone/email) and the / landing page (hero, tagline, Sign-in CTA).\",\n      \"files\": [\"src/app/(public)/layout.tsx\", \"src/app/(public)/page.tsx\"],\n      \"dependencies\": [\"TASK-4\", \"TASK-7\"],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\"FR-36\", \"FR-37\"]\n    },\n    {\n      \"id\": \"TASK-18\",\n      \"description\": \"App-wide error/status pages: not-found.tsx, error.tsx (Try again -> reset()), global-error.tsx, and /forbidden (403 slot with link back to /dashboard, reserved for later auth PRDs).\",\n      \"files\": [\"src/app/not-found.tsx\", \"src/app/error.tsx\", \"src/app/global-error.tsx\", \"src/app/forbidden/page.tsx\"],\n      \"dependencies\": [\"TASK-7\"],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\"FR-38\", \"FR-39\"]\n    },\n    {\n      \"id\": \"TASK-19\",\n      \"description\": \"Add the ESLint no-restricted-imports rule banning the fixed list of non-MUI UI/styling libraries (fails the build), and add security headers (X-Content-Type-Options, Referrer-Policy, X-Frame-Options, CSP) via next.config.js's headers().\",\n      \"files\": [\".eslintrc.json\", \"next.config.js\"],\n      \"dependencies\": [\"TASK-1\"],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\"FR-19\", \"NFR-1\", \"NFR-5\", \"NFR-8\"]\n    },\n    {\n      \"id\": \"TASK-20\",\n      \"description\": \"Test harness configs: Vitest (unit/component) and Playwright (e2e) setup so npm run test / test:e2e are runnable.\",\n      \"files\": [\"vitest.config.ts\", \"playwright.config.ts\"],\n      \"dependencies\": [\"TASK-1\"],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\"NFR-6\", \"NFR-8\"]\n    },\n    {\n      \"id\": \"TASK-21\",\n      \"description\": \"Unit tests for the API layer and env validation: withHandler's branch coverage (ZodError/AppError/Prisma codes/else), parsePagination clamping, parseBody/parseQuery, and env.ts's per-variable failure messages.\",\n      \"files\": [\"tests/unit/http.test.ts\", \"tests/unit/env.test.ts\"],\n      \"dependencies\": [\"TASK-20\", \"TASK-5\", \"TASK-2\"],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\"NFR-6\"]\n    },\n    {\n      \"id\": \"TASK-22\",\n      \"description\": \"Unit/component tests for design-system pieces: formatInSchoolTz, DataTable pagination/sort/search behaviour, ConfirmDialog async confirm, useToast queueing/auto-hide.\",\n      \"files\": [\"tests/unit/dates.test.ts\", \"tests/unit/DataTable.test.tsx\", \"tests/unit/ConfirmDialog.test.tsx\", \"tests/unit/useToast.test.tsx\"],\n      \"dependencies\": [\"TASK-20\", \"TASK-9\", \"TASK-10\", \"TASK-13\"],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\"NFR-6\"]\n    },\n    {\n      \"id\": \"TASK-23\",\n      \"description\": \"Unit test asserting the ESLint no-restricted-imports rule actually flags each banned import.\",\n      \"files\": [\"tests/unit/eslint-no-restricted-imports.test.ts\"],\n      \"dependencies\": [\"TASK-20\", \"TASK-19\"],\n      \"estimateHours\": 1,\n      \"requirementIds\": [\"NFR-6\"]\n    },\n    {\n      \"id\": \"TASK-24\",\n      \"description\": \"Playwright e2e + @axe-core/playwright scenarios on / and /dashboard asserting zero serious/critical accessibility violations.\",\n      \"files\": [\"tests/e2e/landing.spec.ts\", \"tests/e2e/dashboard.spec.ts\"],\n      \"dependencies\": [\"TASK-20\", \"TASK-16\", \"TASK-17\"],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\"NFR-3\", \"NFR-6\"]\n    }\n  ],\n\n  \"fileStructure\": {\n    \"./\": [\"package.json\", \"tsconfig.json\", \".eslintrc.json\", \".prettierrc.json\", \"next.config.js\", \"docker-compose.yml\", \".env.example\", \"vitest.config.ts\", \"playwright.config.ts\"],\n    \"prisma/\": [\"schema.prisma\", \"seed.ts\"],\n    \"src/lib/\": [\"env.ts\", \"logger.ts\", \"dates.ts\"],\n    \"src/server/\": [\"db.ts\", \"http.ts\"],\n    \"src/theme/\": [\"theme.ts\"],\n    \"src/config/\": [\"navigation.ts\", \"student-tabs.ts\"],\n    \"src/components/\": [\"PageHeader/\", \"EmptyState/\", \"DataTable/\", \"ConfirmDialog/\", \"Toast/\", \"FormField/\", \"StatCard/\", \"UserAvatar/\", \"DateDisplay/\", \"LoadingSkeleton/\"],\n    \"src/app/\": [\"layout.tsx\", \"not-found.tsx\", \"error.tsx\", \"global-error.tsx\", \"forbidden/\", \"api/health/\", \"(app)/\", \"(public)/\"],\n    \"tests/unit/\": [\"http.test.ts\", \"env.test.ts\", \"dates.test.ts\", \"DataTable.test.tsx\", \"ConfirmDialog.test.tsx\", \"useToast.test.tsx\", \"eslint-no-restricted-imports.test.ts\"],\n    \"tests/e2e/\": [\"landing.spec.ts\", \"dashboard.spec.ts\"]\n  },\n\n  \"totalEstimateHours\": 59,\n  \"nxpPatterns\": [],\n  \"status\": \"complete\"\n}\n","numLines":219,"startLine":1,"totalLines":219}}}
