{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RPY9dzACC3PxhLWu2693EK","type":"tool_result","content":"1\tgenerator client {\n2\t  provider = \"prisma-client-js\"\n3\t}\n4\t\n5\tdatasource db {\n6\t  provider = \"postgresql\"\n7\t  url      = env(\"DATABASE_URL\")\n8\t}\n9\t\n10\tenum Role {\n11\t  ADMIN\n12\t  TEACHER\n13\t  STUDENT\n14\t  PARENT\n15\t}\n16\t\n17\tenum UserStatus {\n18\t  ACTIVE\n19\t  INVITED\n20\t  DISABLED\n21\t  ARCHIVED\n22\t}\n23\t\n24\tenum AuthTokenType {\n25\t  INVITE\n26\t  PASSWORD_RESET\n27\t}\n28\t\n29\t/// Every authenticated person. passwordHash is nullable because an INVITED\n30\t/// user has no password until they accept their invite (TASK-8's\n31\t/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n32\tmodel User {\n33\t  id                String      @id @default(cuid())\n34\t  email             String      @unique\n35\t  passwordHash      String?\n36\t  firstName         String\n37\t  lastName          String\n38\t  role              Role\n39\t  status            UserStatus  @default(INVITED)\n40\t  failedLoginCount  Int         @default(0)\n41\t  lockedUntil       DateTime?\n42\t  lastLoginAt       DateTime?\n43\t  passwordChangedAt DateTime?\n44\t  createdAt         DateTime    @default(now())\n45\t  updatedAt         DateTime    @updatedAt\n46\t  authTokens        AuthToken[]\n47\t  auditLogs         AuditLog[]\n48\t}\n49\t\n50\t/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n51\t/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n52\t/// user. One shared shape for both token types; src/server/auth/tokens.ts\n53\t/// is the single producer/consumer.\n54\tmodel AuthToken {\n55\t  id        String        @id @default(cuid())\n56\t  userId    String\n57\t  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n58\t  type      AuthTokenType\n59\t  tokenHash String        @unique\n60\t  expiresAt DateTime\n61\t  usedAt    DateTime?\n62\t  createdAt DateTime      @default(now())\n63\t\n64\t  @@index([userId, type])\n65\t}\n66\t\n67\t/// Insert-only audit trail written exclusively through src/server/audit.ts's\n68\t/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n69\t/// non-existent email can still be recorded.\n70\tmodel AuditLog {\n71\t  id         String   @id @default(cuid())\n72\t  actorId    String?\n73\t  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n74\t  action     String\n75\t  entityType String?\n76\t  entityId   String?\n77\t  metadata   Json?\n78\t  ip         String?\n79\t  createdAt  DateTime @default(now())\n80\t\n81\t  @@index([actorId])\n82\t  @@index([action])\n83\t}\n84\t\n85\t/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n86\t/// info. Later PRDs read this for top-bar branding and public footer; no\n87\t/// other PRD should add a second row or a second settings model.\n88\tmodel SchoolSettings {\n89\t  id           String   @id @default(\"singleton\")\n90\t  name         String   @default(\"SchoolHub Academy\")\n91\t  shortName    String   @default(\"SchoolHub\")\n92\t  logoUrl      String?\n93\t  timezone     String   @default(\"UTC\")\n94\t  addressLine1 String?\n95\t  addressLine2 String?\n96\t  city         String?\n97\t  country      String?\n98\t  phone        String?\n99\t  email        String?\n100\t  website      String?\n101\t  createdAt    DateTime @default(now())\n102\t  updatedAt    DateTime @updatedAt\n103\t}\n104\t\n105\t/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n106\t/// at a time -- enforced in src/server/services/academicYears.ts's\n107\t/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n108\t/// express \"exactly one true\" as a simple unique index).\n109\tmodel AcademicYear {\n110\t  id        String   @id @default(cuid())\n111\t  name      String   @unique\n112\t  startDate DateTime @db.Date\n113\t  endDate   DateTime @db.Date\n114\t  isCurrent Boolean  @default(false)\n115\t  createdAt DateTime @default(now())\n116\t  updatedAt DateTime @updatedAt\n117\t  terms     Term[]\n118\t}\n119\t\n120\t/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n121\t/// Restrict means the year can't be deleted while it still has terms --\n122\t/// the service layer checks this first to return a friendly 409 instead of\n123\t/// a raw FK error.\n124\tmodel Term {\n125\t  id             String       @id @default(cuid())\n126\t  academicYearId String\n127\t  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n128\t  name           String\n129\t  startDate      DateTime     @db.Date\n130\t  endDate        DateTime     @db.Date\n131\t  order          Int\n132\t  createdAt      DateTime     @default(now())\n133\t  updatedAt      DateTime     @updatedAt\n134\t\n135\t  @@unique([academicYearId, name])\n136\t  @@unique([academicYearId, order])\n137\t}\n138\t\n139\t/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n140\t/// reference grade levels, so they're archived instead of deleted.\n141\tmodel GradeLevel {\n142\t  id         String    @id @default(cuid())\n143\t  name       String    @unique\n144\t  shortName  String    @unique\n145\t  order      Int       @unique\n146\t  archivedAt DateTime?\n147\t  createdAt  DateTime  @default(now())\n148\t  updatedAt  DateTime  @updatedAt\n149\t}\n150\t\n151\t/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n152\t/// the service layer, not the DB) so the unique constraint catches\n153\t/// case-insensitive duplicates like \"math\" vs \"MATH\".\n154\tmodel Subject {\n155\t  id          String    @id @default(cuid())\n156\t  name        String\n157\t  code        String    @unique\n158\t  description String?\n159\t  color       String    @default(\"#4F46E5\")\n160\t  archivedAt  DateTime?\n161\t  createdAt   DateTime  @default(now())\n162\t  updatedAt   DateTime  @updatedAt\n163\t}\n164\t\n165\t/// A physical room classes are scheduled in.\n166\tmodel Room {\n167\t  id         String    @id @default(cuid())\n168\t  name       String    @unique\n169\t  building   String?\n170\t  capacity   Int?\n171\t  archivedAt DateTime?\n172\t  createdAt  DateTime  @default(now())\n173\t  updatedAt  DateTime  @updatedAt\n174\t}\n175\t"}]},"parent_tool_use_id":null,"session_id":"b784be86-9b15-4d20-b52f-af56b319547e","uuid":"5ec19b87-b60d-4b67-8a4d-55fb290da705","timestamp":"2026-10-19T08:43:09.014Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/prisma/schema.prisma","content":"generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  shortName  String    @unique\n  order      Int       @unique\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n","numLines":175,"startLine":1,"totalLines":175}}}
