{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MSdueSYwejqQWdnGXrcZn1","type":"tool_result","content":"=== src/server/services/settings.ts\nimport { cache } from 'react';\nimport type { AttendanceMode } from '@prisma/client';\nimport { prisma } from '@/server/db';\n\nexport interface UpdateSchoolSettingsInput {\n  name?: string;\n  shortName?: string;\n  logoUrl?: string | null;\n  timezone?: string;\n  addressLine1?: string | null;\n  addressLine2?: string | null;\n  city?: string | null;\n  country?: string | null;\n  phone?: string | null;\n  email?: string | null;\n  website?: string | null;\n  /** PRD-07 FR-4/FR-5 */\n  attendanceMode?: AttendanceMode;\n  attendanceAlertThreshold?: number;\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {\n  return prisma.schoolSettings.update({ where: { id: 'singleton' }, data: input });\n}\n=== src/app/api/settings/school/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { prisma } from '@/server/db';\nimport { updateSchoolSettings } from '@/server/services/settings';\nimport { attendanceSettingsPatch } from '@/lib/validators/attendance';\n\n/** PATCH /api/settings/school — ADMIN; attendance fields only (PRD-07 FR-4/FR-5, strict body). */\nexport const PATCH = withHandler(async (request: Request) => {\n  const user = await requireRole('ADMIN');\n  const patch = await parseBody(request, attendanceSettingsPatch);\n  const old = await prisma.schoolSettings.upsert({ where: { id: 'singleton' }, update: {}, create: { id: 'singleton' } });\n  const updated = await updateSchoolSettings(patch);\n  const pick = (s: typeof old) => ({ attendanceMode: s.attendanceMode, attendanceAlertThreshold: s.attendanceAlertThreshold });\n  await audit({\n    actorId: user.id,\n    action: 'school_settings.update',\n    entityType: 'SchoolSettings',\n    entityId: 'singleton',\n    metadata: { old: pick(old), new: pick(updated) },\n    request,\n  });\n  return ok(pick(updated));\n});\n=== src/app/api/internal/email/dispatch/route.ts\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\n=== src/server/email/templates/BaseLayout.tsx\nimport * as React from 'react';\nimport { Body, Container, Head, Hr, Html, Img, Link, Preview, Section, Text } from '@react-email/components';\nimport type { SchoolSettings } from '@prisma/client';\n\nexport type EmailSchool = Pick<SchoolSettings, 'name' | 'shortName' | 'logoUrl' | 'addressLine1' | 'addressLine2'>;\n\nexport interface BaseLayoutProps {\n  school: EmailSchool;\n  appUrl: string;\n  preview: string;\n  children: React.ReactNode;\n}\n\nconst main = { backgroundColor: '#f4f5f7', fontFamily: 'Helvetica, Arial, sans-serif', margin: 0, padding: '24px 0' };\nconst container = { backgroundColor: '#ffffff', borderRadius: 8, margin: '0 auto', maxWidth: 560, padding: 32 };\nconst muted = { color: '#6b7280', fontSize: 12, lineHeight: '18px', margin: '4px 0' };\n\n/** FR-14: school header, content, footer with address + preferences link + fixed sentence. All text is JSX-escaped (NFR-7). */\nexport function BaseLayout({ school, appUrl, preview, children }: BaseLayoutProps) {\n  const address = [school.addressLine1, school.addressLine2].filter(Boolean).join(', ');\n  return (\n    <Html lang=\"en\">\n      <Head />\n      <Preview>{preview}</Preview>\n      <Body style={main}>\n        <Container style={container}>\n          <Section style={{ marginBottom: 24 }}>\n            {school.logoUrl && <Img src={school.logoUrl} alt={school.shortName} height={40} style={{ marginBottom: 8 }} />}\n            <Text style={{ fontSize: 18, fontWeight: 700, margin: 0 }}>{school.name}</Text>\n          </Section>\n          {children}\n          <Hr style={{ borderColor: '#e5e7eb', margin: '32px 0 16px' }} />\n          {address && <Text style={muted}>{address}</Text>}\n          <Text style={muted}>\n            <Link href={`${appUrl}/account/notifications`} style={{ color: '#6b7280', textDecoration: 'underline' }}>\n              Manage email preferences\n            </Link>\n          </Text>\n          <Text style={muted}>You are receiving this because you have a SchoolHub account.</Text>\n        </Container>\n      </Body>\n    </Html>\n  );\n}\n\nexport const buttonStyle = {\n  backgroundColor: '#4f46e5',\n  borderRadius: 6,\n  color: '#ffffff',\n  display: 'inline-block',\n  fontSize: 14,\n  fontWeight: 600,\n  padding: '12px 20px',\n  textDecoration: 'none',\n};\nexport const textStyle = { fontSize: 14, lineHeight: '22px', color: '#111827' };\n=== src/components/ConfirmDialog/ConfirmDialog.tsx\n'use client';\n\nimport { useState } from 'react';\nimport Dialog from '@mui/material/Dialog';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogContentText from '@mui/material/DialogContentText';\nimport DialogActions from '@mui/material/DialogActions';\nimport Button from '@mui/material/Button';\nimport CircularProgress from '@mui/material/CircularProgress';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  title: string;\n  description?: string;\n  destructive?: boolean;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  onConfirm: () => void | Promise<void>;\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}: ConfirmDialogProps) {\n  const [pending, setPending] = useState(false);\n\n  const handleConfirm = async () => {\n    setPending(true);\n    try {\n      await onConfirm();\n    } finally {\n      setPending(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n      {description && (\n        <DialogContent>\n          <DialogContentText>{description}</DialogContentText>\n        </DialogContent>\n      )}\n      <DialogActions>\n        <Button onClick={onCancel} disabled={pending}>\n          {cancelLabel}\n        </Button>\n        <Button\n          onClick={handleConfirm}\n          color={destructive ? 'error' : 'primary'}\n          variant=\"contained\"\n          disabled={pending}\n          startIcon={pending ? <CircularProgress size={16} color=\"inherit\" /> : undefined}\n        >\n          {confirmLabel}\n        </Button>\n      </DialogActions>\n    </Dialog>\n  );\n}\n=== src/app/(app)/courses/[courseId]/layout.tsx\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { AppError } from '@/server/http';\nimport { getCourse } from '@/server/courses/courses-service';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { CourseTabs } from './CourseTabs';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course home shell — PRD-05 FR-16/FR-18. Gate once here; tabs inherit it. */\nexport default async function CourseLayout({\n  params,\n  children,\n}: {\n  params: { courseId: string };\n  children: React.ReactNode;\n}) {\n  const user = await requirePageRole(...ALL_ROLES);\n  try {\n    await assertCanViewCourse(user, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const course = await getCourse(params.courseId);\n  const teachers = [course.teacher, ...course.coTeachers].map((t) => t.name).join(', ');\n\n  return (\n    <Box>\n      <Paper variant=\"outlined\" sx={{ mb: 2, overflow: 'hidden' }}>\n        <Box sx={{ height: 8, bgcolor: course.subject.color }} />\n        <Box sx={{ p: 2 }}>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {course.name}\n          </Typography>\n          <Stack direction=\"row\" spacing={2} sx={{ mt: 0.5, flexWrap: 'wrap', color: 'text.secondary' }} useFlexGap>\n            <Typography variant=\"body2\">{course.code}</Typography>\n            <Typography variant=\"body2\">Teachers: {teachers}</Typography>\n            {course.section && <Typography variant=\"body2\">Section {course.section.name}</Typography>}\n            {course.section?.room && <Typography variant=\"body2\">Room {course.section.room.name}</Typography>}\n          </Stack>\n        </Box>\n      </Paper>\n      <CourseTabs courseId={course.id} role={user.role} />\n      {children}\n    </Box>\n  );\n}\n=== src/app/(app)/courses/[courseId]/roster/page.tsx\nimport Link from 'next/link';\nimport { notFound } from 'next/navigation';\nimport Chip from '@mui/material/Chip';\nimport List from '@mui/material/List';\nimport ListItem from '@mui/material/ListItem';\nimport ListItemText from '@mui/material/ListItemText';\nimport Paper from '@mui/material/Paper';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableContainer from '@mui/material/TableContainer';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { getCourseRoster, type RosterEntry } from '@/server/courses/courses-service';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { ALL_ROLES } from '@/config/navigation';\n\nexport const dynamic = 'force-dynamic';\n\n/** Roster tab — FR-17 / NFR-4: same getCourseRoster as the API; PARENT has no roster. */\nexport default async function CourseRosterPage({ params }: { params: { courseId: string } }) {\n  const user = await requirePageRole(...ALL_ROLES);\n  if (user.role === 'PARENT') notFound();\n  const { rows } = await getCourseRoster(params.courseId, user.role);\n\n  if (rows.length === 0) return <EmptyState title=\"No students enrolled\" />;\n\n  if (user.role === 'STUDENT') {\n    return (\n      <Paper variant=\"outlined\">\n        <List dense aria-label=\"Classmates\">\n          {(rows as { name: string }[]).map((r, i) => (\n            <ListItem key={i}>\n              <ListItemText primary={r.name} />\n            </ListItem>\n          ))}\n        </List>\n      </Paper>\n    );\n  }\n\n  return (\n    <TableContainer component={Paper} variant=\"outlined\">\n      <Table size=\"small\" aria-label=\"Course roster\">\n        <TableHead>\n          <TableRow>\n            <TableCell>Student</TableCell>\n            <TableCell>Admission no.</TableCell>\n            <TableCell>Status</TableCell>\n            <TableCell>Enrolled</TableCell>\n          </TableRow>\n        </TableHead>\n        <TableBody>\n          {(rows as RosterEntry[]).map((r) => (\n            <TableRow key={r.enrollmentId}>\n              <TableCell>\n                <Link href={r.student.profileUrl}>{r.student.name}</Link>\n              </TableCell>\n              <TableCell>{r.student.admissionNumber ?? '—'}</TableCell>\n              <TableCell>\n                <Chip size=\"small\" color={r.status === 'ACTIVE' ? 'success' : 'default'} label={r.status} />\n              </TableCell>\n              <TableCell>{r.enrolledAt.toLocaleDateString()}</TableCell>\n            </TableRow>\n          ))}\n        </TableBody>\n      </Table>\n    </TableContainer>\n  );\n}\n=== src/app/(app)/students/[id]/courses/page.tsx\nimport Link from 'next/link';\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Chip from '@mui/material/Chip';\nimport Paper from '@mui/material/Paper';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableContainer from '@mui/material/TableContainer';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanViewStudent } from '@/server/auth/student-access';\nimport { AppError } from '@/server/http';\nimport { getStudentCourses } from '@/server/courses/courses-service';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { ALL_ROLES } from '@/config/navigation';\n\nexport const dynamic = 'force-dynamic';\n\n/** Student \"Courses\" tab — PRD-05 FR-21/FR-22. */\nexport default async function StudentCoursesPage({ params }: { params: { id: string } }) {\n  const user = await requirePageRole(...ALL_ROLES);\n  try {\n    await assertCanViewStudent(user, params.id);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const { academicYear, section, courses } = await getStudentCourses(params.id);\n\n  return (\n    <Box>\n      <PageHeader title=\"Courses\" description={academicYear ? academicYear.name : 'No current academic year'} />\n      <Paper variant=\"outlined\" sx={{ p: 2, mb: 2 }}>\n        <Typography variant=\"body2\">\n          <strong>Section:</strong> {section?.name ?? '—'}\n          {'  ·  '}\n          <strong>Homeroom teacher:</strong> {section?.homeroomTeacher?.name ?? '—'}\n        </Typography>\n      </Paper>\n      {courses.length === 0 ? (\n        <EmptyState title=\"No courses this year\" />\n      ) : (\n        <TableContainer component={Paper} variant=\"outlined\">\n          <Table size=\"small\" aria-label=\"Student courses\">\n            <TableHead>\n              <TableRow>\n                <TableCell>Course</TableCell>\n                <TableCell>Code</TableCell>\n                <TableCell>Teacher</TableCell>\n                <TableCell>Kind</TableCell>\n                <TableCell>Status</TableCell>\n              </TableRow>\n            </TableHead>\n            <TableBody>\n              {courses.map((c) => (\n                <TableRow key={c.enrollmentId}>\n                  <TableCell>\n                    <Box component=\"span\" sx={{ display: 'inline-block', width: 10, height: 10, borderRadius: '50%', bgcolor: c.subjectColor, mr: 1 }} />\n                    <Link href={`/courses/${c.courseId}`}>{c.name}</Link>\n                  </TableCell>\n                  <TableCell>{c.code}</TableCell>\n                  <TableCell>{c.teacher.name}</TableCell>\n                  <TableCell>{c.kind}</TableCell>\n                  <TableCell>\n                    <Chip size=\"small\" color={c.status === 'ACTIVE' ? 'success' : 'default'} label={c.status} />\n                  </TableCell>\n                </TableRow>\n              ))}\n            </TableBody>\n          </Table>\n        </TableContainer>\n      )}\n    </Box>\n  );\n}\n=== next.config.js\n/** @type {import('next').NextConfig} */\nconst securityHeaders = [\n  { key: 'X-Content-Type-Options', value: 'nosniff' },\n  { key: 'Referrer-Policy', value: 'strict-origin-when-cross-origin' },\n  { key: 'X-Frame-Options', value: 'DENY' },\n  {\n    key: 'Content-Security-Policy',\n    value: \"default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self';\",\n  },\n];\n\nconst nextConfig = {\n  reactStrictMode: true,\n  async headers() {\n    return [\n      {\n        source: '/:path*',\n        headers: securityHeaders,\n      },\n    ];\n  },\n};\n\nmodule.exports = nextConfig;\n=== vitest.config.ts\nimport { defineConfig } from 'vitest/config.js';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\n=== .gitignore\ncat: .gitignore: No such file or directory\n=== src/server/db.ts\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\nattendance\ncourses","is_error":false}]},"parent_tool_use_id":null,"session_id":"34574e28-0591-42df-96fb-64403ec6dad4","uuid":"21b4f929-ff13-4bef-9026-3d7bdcc0c606","timestamp":"2026-11-06T21:32:42.363Z","tool_use_result":{"stdout":"=== src/server/services/settings.ts\nimport { cache } from 'react';\nimport type { AttendanceMode } from '@prisma/client';\nimport { prisma } from '@/server/db';\n\nexport interface UpdateSchoolSettingsInput {\n  name?: string;\n  shortName?: string;\n  logoUrl?: string | null;\n  timezone?: string;\n  addressLine1?: string | null;\n  addressLine2?: string | null;\n  city?: string | null;\n  country?: string | null;\n  phone?: string | null;\n  email?: string | null;\n  website?: string | null;\n  /** PRD-07 FR-4/FR-5 */\n  attendanceMode?: AttendanceMode;\n  attendanceAlertThreshold?: number;\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {\n  return prisma.schoolSettings.update({ where: { id: 'singleton' }, data: input });\n}\n=== src/app/api/settings/school/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { prisma } from '@/server/db';\nimport { updateSchoolSettings } from '@/server/services/settings';\nimport { attendanceSettingsPatch } from '@/lib/validators/attendance';\n\n/** PATCH /api/settings/school — ADMIN; attendance fields only (PRD-07 FR-4/FR-5, strict body). */\nexport const PATCH = withHandler(async (request: Request) => {\n  const user = await requireRole('ADMIN');\n  const patch = await parseBody(request, attendanceSettingsPatch);\n  const old = await prisma.schoolSettings.upsert({ where: { id: 'singleton' }, update: {}, create: { id: 'singleton' } });\n  const updated = await updateSchoolSettings(patch);\n  const pick = (s: typeof old) => ({ attendanceMode: s.attendanceMode, attendanceAlertThreshold: s.attendanceAlertThreshold });\n  await audit({\n    actorId: user.id,\n    action: 'school_settings.update',\n    entityType: 'SchoolSettings',\n    entityId: 'singleton',\n    metadata: { old: pick(old), new: pick(updated) },\n    request,\n  });\n  return ok(pick(updated));\n});\n=== src/app/api/internal/email/dispatch/route.ts\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\n=== src/server/email/templates/BaseLayout.tsx\nimport * as React from 'react';\nimport { Body, Container, Head, Hr, Html, Img, Link, Preview, Section, Text } from '@react-email/components';\nimport type { SchoolSettings } from '@prisma/client';\n\nexport type EmailSchool = Pick<SchoolSettings, 'name' | 'shortName' | 'logoUrl' | 'addressLine1' | 'addressLine2'>;\n\nexport interface BaseLayoutProps {\n  school: EmailSchool;\n  appUrl: string;\n  preview: string;\n  children: React.ReactNode;\n}\n\nconst main = { backgroundColor: '#f4f5f7', fontFamily: 'Helvetica, Arial, sans-serif', margin: 0, padding: '24px 0' };\nconst container = { backgroundColor: '#ffffff', borderRadius: 8, margin: '0 auto', maxWidth: 560, padding: 32 };\nconst muted = { color: '#6b7280', fontSize: 12, lineHeight: '18px', margin: '4px 0' };\n\n/** FR-14: school header, content, footer with address + preferences link + fixed sentence. All text is JSX-escaped (NFR-7). */\nexport function BaseLayout({ school, appUrl, preview, children }: BaseLayoutProps) {\n  const address = [school.addressLine1, school.addressLine2].filter(Boolean).join(', ');\n  return (\n    <Html lang=\"en\">\n      <Head />\n      <Preview>{preview}</Preview>\n      <Body style={main}>\n        <Container style={container}>\n          <Section style={{ marginBottom: 24 }}>\n            {school.logoUrl && <Img src={school.logoUrl} alt={school.shortName} height={40} style={{ marginBottom: 8 }} />}\n            <Text style={{ fontSize: 18, fontWeight: 700, margin: 0 }}>{school.name}</Text>\n          </Section>\n          {children}\n          <Hr style={{ borderColor: '#e5e7eb', margin: '32px 0 16px' }} />\n          {address && <Text style={muted}>{address}</Text>}\n          <Text style={muted}>\n            <Link href={`${appUrl}/account/notifications`} style={{ color: '#6b7280', textDecoration: 'underline' }}>\n              Manage email preferences\n            </Link>\n          </Text>\n          <Text style={muted}>You are receiving this because you have a SchoolHub account.</Text>\n        </Container>\n      </Body>\n    </Html>\n  );\n}\n\nexport const buttonStyle = {\n  backgroundColor: '#4f46e5',\n  borderRadius: 6,\n  color: '#ffffff',\n  display: 'inline-block',\n  fontSize: 14,\n  fontWeight: 600,\n  padding: '12px 20px',\n  textDecoration: 'none',\n};\nexport const textStyle = { fontSize: 14, lineHeight: '22px', color: '#111827' };\n=== src/components/ConfirmDialog/ConfirmDialog.tsx\n'use client';\n\nimport { useState } from 'react';\nimport Dialog from '@mui/material/Dialog';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogContentText from '@mui/material/DialogContentText';\nimport DialogActions from '@mui/material/DialogActions';\nimport Button from '@mui/material/Button';\nimport CircularProgress from '@mui/material/CircularProgress';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  title: string;\n  description?: string;\n  destructive?: boolean;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  onConfirm: () => void | Promise<void>;\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}: ConfirmDialogProps) {\n  const [pending, setPending] = useState(false);\n\n  const handleConfirm = async () => {\n    setPending(true);\n    try {\n      await onConfirm();\n    } finally {\n      setPending(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n      {description && (\n        <DialogContent>\n          <DialogContentText>{description}</DialogContentText>\n        </DialogContent>\n      )}\n      <DialogActions>\n        <Button onClick={onCancel} disabled={pending}>\n          {cancelLabel}\n        </Button>\n        <Button\n          onClick={handleConfirm}\n          color={destructive ? 'error' : 'primary'}\n          variant=\"contained\"\n          disabled={pending}\n          startIcon={pending ? <CircularProgress size={16} color=\"inherit\" /> : undefined}\n        >\n          {confirmLabel}\n        </Button>\n      </DialogActions>\n    </Dialog>\n  );\n}\n=== src/app/(app)/courses/[courseId]/layout.tsx\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { AppError } from '@/server/http';\nimport { getCourse } from '@/server/courses/courses-service';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { CourseTabs } from './CourseTabs';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course home shell — PRD-05 FR-16/FR-18. Gate once here; tabs inherit it. */\nexport default async function CourseLayout({\n  params,\n  children,\n}: {\n  params: { courseId: string };\n  children: React.ReactNode;\n}) {\n  const user = await requirePageRole(...ALL_ROLES);\n  try {\n    await assertCanViewCourse(user, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const course = await getCourse(params.courseId);\n  const teachers = [course.teacher, ...course.coTeachers].map((t) => t.name).join(', ');\n\n  return (\n    <Box>\n      <Paper variant=\"outlined\" sx={{ mb: 2, overflow: 'hidden' }}>\n        <Box sx={{ height: 8, bgcolor: course.subject.color }} />\n        <Box sx={{ p: 2 }}>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {course.name}\n          </Typography>\n          <Stack direction=\"row\" spacing={2} sx={{ mt: 0.5, flexWrap: 'wrap', color: 'text.secondary' }} useFlexGap>\n            <Typography variant=\"body2\">{course.code}</Typography>\n            <Typography variant=\"body2\">Teachers: {teachers}</Typography>\n            {course.section && <Typography variant=\"body2\">Section {course.section.name}</Typography>}\n            {course.section?.room && <Typography variant=\"body2\">Room {course.section.room.name}</Typography>}\n          </Stack>\n        </Box>\n      </Paper>\n      <CourseTabs courseId={course.id} role={user.role} />\n      {children}\n    </Box>\n  );\n}\n=== src/app/(app)/courses/[courseId]/roster/page.tsx\nimport Link from 'next/link';\nimport { notFound } from 'next/navigation';\nimport Chip from '@mui/material/Chip';\nimport List from '@mui/material/List';\nimport ListItem from '@mui/material/ListItem';\nimport ListItemText from '@mui/material/ListItemText';\nimport Paper from '@mui/material/Paper';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableContainer from '@mui/material/TableContainer';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { getCourseRoster, type RosterEntry } from '@/server/courses/courses-service';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { ALL_ROLES } from '@/config/navigation';\n\nexport const dynamic = 'force-dynamic';\n\n/** Roster tab — FR-17 / NFR-4: same getCourseRoster as the API; PARENT has no roster. */\nexport default async function CourseRosterPage({ params }: { params: { courseId: string } }) {\n  const user = await requirePageRole(...ALL_ROLES);\n  if (user.role === 'PARENT') notFound();\n  const { rows } = await getCourseRoster(params.courseId, user.role);\n\n  if (rows.length === 0) return <EmptyState title=\"No students enrolled\" />;\n\n  if (user.role === 'STUDENT') {\n    return (\n      <Paper variant=\"outlined\">\n        <List dense aria-label=\"Classmates\">\n          {(rows as { name: string }[]).map((r, i) => (\n            <ListItem key={i}>\n              <ListItemText primary={r.name} />\n            </ListItem>\n          ))}\n        </List>\n      </Paper>\n    );\n  }\n\n  return (\n    <TableContainer component={Paper} variant=\"outlined\">\n      <Table size=\"small\" aria-label=\"Course roster\">\n        <TableHead>\n          <TableRow>\n            <TableCell>Student</TableCell>\n            <TableCell>Admission no.</TableCell>\n            <TableCell>Status</TableCell>\n            <TableCell>Enrolled</TableCell>\n          </TableRow>\n        </TableHead>\n        <TableBody>\n          {(rows as RosterEntry[]).map((r) => (\n            <TableRow key={r.enrollmentId}>\n              <TableCell>\n                <Link href={r.student.profileUrl}>{r.student.name}</Link>\n              </TableCell>\n              <TableCell>{r.student.admissionNumber ?? '—'}</TableCell>\n              <TableCell>\n                <Chip size=\"small\" color={r.status === 'ACTIVE' ? 'success' : 'default'} label={r.status} />\n              </TableCell>\n              <TableCell>{r.enrolledAt.toLocaleDateString()}</TableCell>\n            </TableRow>\n          ))}\n        </TableBody>\n      </Table>\n    </TableContainer>\n  );\n}\n=== src/app/(app)/students/[id]/courses/page.tsx\nimport Link from 'next/link';\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Chip from '@mui/material/Chip';\nimport Paper from '@mui/material/Paper';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableContainer from '@mui/material/TableContainer';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanViewStudent } from '@/server/auth/student-access';\nimport { AppError } from '@/server/http';\nimport { getStudentCourses } from '@/server/courses/courses-service';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { ALL_ROLES } from '@/config/navigation';\n\nexport const dynamic = 'force-dynamic';\n\n/** Student \"Courses\" tab — PRD-05 FR-21/FR-22. */\nexport default async function StudentCoursesPage({ params }: { params: { id: string } }) {\n  const user = await requirePageRole(...ALL_ROLES);\n  try {\n    await assertCanViewStudent(user, params.id);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const { academicYear, section, courses } = await getStudentCourses(params.id);\n\n  return (\n    <Box>\n      <PageHeader title=\"Courses\" description={academicYear ? academicYear.name : 'No current academic year'} />\n      <Paper variant=\"outlined\" sx={{ p: 2, mb: 2 }}>\n        <Typography variant=\"body2\">\n          <strong>Section:</strong> {section?.name ?? '—'}\n          {'  ·  '}\n          <strong>Homeroom teacher:</strong> {section?.homeroomTeacher?.name ?? '—'}\n        </Typography>\n      </Paper>\n      {courses.length === 0 ? (\n        <EmptyState title=\"No courses this year\" />\n      ) : (\n        <TableContainer component={Paper} variant=\"outlined\">\n          <Table size=\"small\" aria-label=\"Student courses\">\n            <TableHead>\n              <TableRow>\n                <TableCell>Course</TableCell>\n                <TableCell>Code</TableCell>\n                <TableCell>Teacher</TableCell>\n                <TableCell>Kind</TableCell>\n                <TableCell>Status</TableCell>\n              </TableRow>\n            </TableHead>\n            <TableBody>\n              {courses.map((c) => (\n                <TableRow key={c.enrollmentId}>\n                  <TableCell>\n                    <Box component=\"span\" sx={{ display: 'inline-block', width: 10, height: 10, borderRadius: '50%', bgcolor: c.subjectColor, mr: 1 }} />\n                    <Link href={`/courses/${c.courseId}`}>{c.name}</Link>\n                  </TableCell>\n                  <TableCell>{c.code}</TableCell>\n                  <TableCell>{c.teacher.name}</TableCell>\n                  <TableCell>{c.kind}</TableCell>\n                  <TableCell>\n                    <Chip size=\"small\" color={c.status === 'ACTIVE' ? 'success' : 'default'} label={c.status} />\n                  </TableCell>\n                </TableRow>\n              ))}\n            </TableBody>\n          </Table>\n        </TableContainer>\n      )}\n    </Box>\n  );\n}\n=== next.config.js\n/** @type {import('next').NextConfig} */\nconst securityHeaders = [\n  { key: 'X-Content-Type-Options', value: 'nosniff' },\n  { key: 'Referrer-Policy', value: 'strict-origin-when-cross-origin' },\n  { key: 'X-Frame-Options', value: 'DENY' },\n  {\n    key: 'Content-Security-Policy',\n    value: \"default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self';\",\n  },\n];\n\nconst nextConfig = {\n  reactStrictMode: true,\n  async headers() {\n    return [\n      {\n        source: '/:path*',\n        headers: securityHeaders,\n      },\n    ];\n  },\n};\n\nmodule.exports = nextConfig;\n=== vitest.config.ts\nimport { defineConfig } from 'vitest/config.js';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\n=== .gitignore\ncat: .gitignore: No such file or directory\n=== src/server/db.ts\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\nattendance\ncourses","