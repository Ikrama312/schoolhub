{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CTphyJNpxKDXsZUetQojLj","type":"tool_result","content":"1\timport { prisma } from '@/server/db';\n2\timport { logger } from '@/lib/logger';\n3\t\n4\texport interface AuditInput {\n5\t  actorId?: string | null;\n6\t  action: string;\n7\t  entityType?: string;\n8\t  entityId?: string;\n9\t  metadata?: Record<string, unknown>;\n10\t}\n11\t\n12\t/**\n13\t * Insert-only audit trail, the single writer of AuditLog rows. Every write\n14\t * endpoint calls this after a successful mutation with action\n15\t * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n16\t * write must not fail the request it's recording, so errors are logged\n17\t * and swallowed.\n18\t */\n19\texport async function audit(input: AuditInput): Promise<void> {\n20\t  try {\n21\t    await prisma.auditLog.create({\n22\t      data: {\n23\t        actorId: input.actorId ?? null,\n24\t        action: input.action,\n25\t        entityType: input.entityType,\n26\t        entityId: input.entityId,\n27\t        metadata: input.metadata,\n28\t      },\n29\t    });\n30\t  } catch (error) {\n31\t    logger.error('Failed to write audit log', {\n32\t      action: input.action,\n33\t      error: error instanceof Error ? error.message : String(error),\n34\t    });\n35\t  }\n36\t}\n37\t"}]},"parent_tool_use_id":null,"session_id":"26ce942b-d6a7-4ab5-ac09-e89a7a8e3024","uuid":"ccae43c9-9d85-457b-9dc2-201460e3ad46","timestamp":"2026-10-20T07:06:59.642Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/audit.ts","content":"import { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n}\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: input.metadata,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n","numLines":37,"startLine":1,"totalLines":37}}}
