{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SSiRzB3cWmGiCXYcpehsrw","type":"tool_result","content":"src/server/audit.ts\nsrc/server/auth/requireRole.ts\nsrc/server/auth/student-access.ts\nsrc/server/csv.ts\nsrc/server/db.ts\nsrc/server/http.ts\nsrc/server/services/academicYears.ts\nsrc/server/services/dateRange.ts\nsrc/server/services/gradeLevels.ts\nsrc/server/services/rooms.ts\nsrc/server/services/settings.ts\nsrc/server/services/subjects.ts\nsrc/server/services/terms.ts\nsrc/server/services/userImport.ts\nsrc/server/services/userLinks.ts\nsrc/server/services/users.ts\n---app api---\nsrc/app/api\nsrc/app/api/academic-years\nsrc/app/api/academic-years/[id]\nsrc/app/api/academic-years/[id]/set-current\nsrc/app/api/academic-years/[id]/terms\nsrc/app/api/audit-logs\nsrc/app/api/grade-levels\nsrc/app/api/grade-levels/[id]\nsrc/app/api/health\nsrc/app/api/me\nsrc/app/api/me/children\nsrc/app/api/me/profile\nsrc/app/api/rooms\nsrc/app/api/rooms/[id]\nsrc/app/api/settings\nsrc/app/api/settings/school\nsrc/app/api/students\nsrc/app/api/students/[id]\nsrc/app/api/students/[id]/parents\nsrc/app/api/subjects\nsrc/app/api/subjects/[id]\nsrc/app/api/terms\nsrc/app/api/terms/[id]\nsrc/app/api/terms/reorder\nsrc/app/api/users\nsrc/app/api/users/[id]\nsrc/app/api/users/[id]/archive\nsrc/app/api/users/[id]/invite\nsrc/app/api/users/[id]/restore\nsrc/app/api/users/[id]/status\nsrc/app/api/users/[id]/unlock\nsrc/app/api/users/export\nsrc/app/api/users/import\nsrc/app/api/users/search\n---http---\nimport { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }","is_error":false}]},"parent_tool_use_id":null,"session_id":"49ee9d9e-3a83-47f8-b022-a5bdaa2f8cda","uuid":"d326d44c-adfa-47ca-924b-ed7e97f28c6a","timestamp":"2026-10-20T06:46:24.373Z","tool_use_result":{"stdout":"src/server/audit.ts\nsrc/server/auth/requireRole.ts\nsrc/server/auth/student-access.ts\nsrc/server/csv.ts\nsrc/server/db.ts\nsrc/server/http.ts\nsrc/server/services/academicYears.ts\nsrc/server/services/dateRange.ts\nsrc/server/services/gradeLevels.ts\nsrc/server/services/rooms.ts\nsrc/server/services/settings.ts\nsrc/server/services/subjects.ts\nsrc/server/services/terms.ts\nsrc/server/services/userImport.ts\nsrc/server/services/userLinks.ts\nsrc/server/services/users.ts\n---app api---\nsrc/app/api\nsrc/app/api/academic-years\nsrc/app/api/academic-years/[id]\nsrc/app/api/academic-years/[id]/set-current\nsrc/app/api/academic-years/[id]/terms\nsrc/app/api/audit-logs\nsrc/app/api/grade-levels\nsrc/app/api/grade-levels/[id]\nsrc/app/api/health\nsrc/app/api/me\nsrc/app/api/me/children\nsrc/app/api/me/profile\nsrc/app/api/rooms\nsrc/app/api/rooms/[id]\nsrc/app/api/settings\nsrc/app/api/settings/school\nsrc/app/api/students\nsrc/app/api/students/[id]\nsrc/app/api/students/[id]/parents\nsrc/app/api/subjects\nsrc/app/api/subjects/[id]\nsrc/app/api/terms\nsrc/app/api/terms/[id]\nsrc/app/api/terms/reorder\nsrc/app/api/users\nsrc/app/api/users/[id]\nsrc/a