    </Box>\n  );\n}\nEOF\nnpx tsc --noEmit 2>&1 | head -20","description":"Create admin attendance page and tabs, typecheck"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3986,"cache_read_input_tokens":208472,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3986},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7fe1befa-2c95-4276-8d14-955b8d55df5c","uuid":"531e5382-d768-4c33-bda4-f34eb7e91c74","timestamp":"2026-11-06T05:51:05.645Z","request_id":"req_011Cgm9iVCywrLkqexLKtFAJ","wire_tool_inputs":{"toolu_01KZatJmGdirJsbc1bPFNfAC":{"command":"cd /Users/ikramaansari/Documents/forge/schoolhub && D=\"src/app/(app)/admin/attendance\" && mkdir -p \"$D\"\ncat > \"$D/ReportTab.tsx\" <<'EOF'\n'use client';\n\nimport { useState } from 'react';\nimport { DataGrid, type GridColDef, type GridPaginationModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport { useToast } from '@/components/Toast/useToast';\nimport { ATTENDANCE_STATUSES, reportFilters } from '@/lib/validators/attendance';\nimport type { StudentSummaryRow } from '@/server/attendance/attendance-service';\n\nexport interface ReportOptions {\n  gradeLevels: { id: string; name: string }[];\n  sections: { id: string; name: string }[];\n  courses: { id: string; name: string }[];\n}\n\nconst columns: GridColDef[] = [\n  { field: 'studentName', headerName: 'Student', flex: 1, minWidth: 160, sortable: false },\n  { field: 'sectionName', headerName: 'Section', width: 100, sortable: false },\n  { field: 'gradeLevelName', headerName: 'Grade', width: 100, sortable: false },\n  { field: 'records', headerName: 'Records', width: 90, type: 'number', sortable: false },\n  { field: 'present', headerName: 'Present', width: 90, type: 'number', sortable: false },\n  { field: 'absent', headerName: 'Absent', width: 90, type: 'number', sortable: false },\n  { field: 'late', headerName: 'Late', width: 80, type: 'number', sortable: false },\n  { field: 'excused', headerName: 'Excused', width: 90, type: 'number', sortable: false },\n  { field: 'rate', headerName: 'Rate', width: 90, type: 'number', sortable: false, valueFormatter: (v: number | null) => (v === null ? '—' : `${v}%`) },\n];\n\n/** FR-32: filter form → paginated per-student summary; Export CSV uses the same filters. */\nexport function ReportTab({ options, today, monthStart }: { options: ReportOptions; today: string; monthStart: string }) {\n  const { showToast } = useToast();\n  const [filters, setFilters] = useState({ from: monthStart, to: today, gradeLevelId: '', sectionId: '', courseId: '', status: '' });\n  const [rows, setRows] = useState<StudentSummaryRow[]>([]);\n  const [total, setTotal] = useState(0);\n  const [loading, setLoading] = useState(false);\n  const [paging, setPaging] = useState<GridPaginationModel>({ page: 0, pageSize: 20 });\n\n  const query = () => new URLSearchParams(Object.entries(filters).filter(([, v]) => v) as [string, string][]);\n\n  async function run(model = paging) {\n    const parsed = reportFilters.safeParse(Object.fromEntries(query()));\n    if (!parsed.success) {\n      showToast({ message: parsed.error.issues[0]?.message ?? 'Check the filters.', severity: 'error' });\n      return;\n    }\n    setLoading(true);\n    try {\n      const qs = query();\n      qs.set('page', String(model.page + 1));\n      qs.set('pageSize', String(model.pageSize));\n      const res = await fetch(`/api/admin/attendance/report?${qs}`);\n      const json = await res.json();\n      if (!res.ok) throw new Error(json?.error?.message ?? 'Could not load the report.');\n      setRows(json.data);\n      setTotal(json.meta.total);\n    } catch (e) {\n      showToast({ message: e instanceof Error ? e.message : 'Could not load the report.', severity: 'error' });\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  const set = (field: keyof typeof filters) => (e: React.ChangeEvent<HTMLInputElement>) => setFilters({ ...filters, [field]: e.target.value });\n  const select = (field: 'gradeLevelId' | 'sectionId' | 'courseId', label: string, items: { id: string; name: string }[]) => (\n    <TextField select size=\"small\" label={label} value={filters[field]} onChange={set(field)} sx={{ minWidth: 150 }}>\n      <MenuItem value=\"\">All</MenuItem>\n      {items.map((i) => (\n        <MenuItem key={i.id} value={i.id}>\n          {i.name}\n        </MenuItem>\n      ))}\n    </TextField>\n  );\n\n  return (\n    <Box>\n      <Stack direction=\"row\" spacing={2} useFlexGap sx={{ flexWrap: 'wrap', mb: 2 }}>\n        <TextField type=\"date\" size=\"small\" label=\"From\" value={filters.from} onChange={set('from')} slotProps={{ inputLabel: { shrink: true } }} />\n        <TextField type=\"date\" size=\"small\" label=\"To\" value={filters.to} onChange={set('to')} slotProps={{ inputLabel: { shrink: true } }} />\n        {select('gradeLevelId', 'Grade', options.gradeLevels)}\n        {select('sectionId', 'Section', options.sections)}\n        {select('courseId', 'Course', options.courses)}\n        <TextField select size=\"small\" label=\"Has status\" value={filters.status} onChange={set('status')} sx={{ minWidth: 140 }}>\n          <MenuItem value=\"\">Any</MenuItem>\n          {ATTENDANCE_STATUSES.map((s) => (\n            <MenuItem key={s} value={s}>\n              {s}\n            </MenuItem>\n          ))}\n        </TextField>\n        <Button variant=\"contained\" onClick={() => { const m = { ...paging, page: 0 }; setPaging(m); void run(m); }}>\n          Run report\n        </Button>\n        <Button component=\"a\" variant=\"outlined\" href={`/api/admin/attendance/report?${query()}&format=csv`}>\n          Export CSV\n        </Button>\n      </Stack>\n      <DataGrid\n        autoHeight\n        rows={rows}\n        columns={columns}\n        rowCount={total}\n        loading={loading}\n        getRowId={(r) => r.studentId}\n        paginationMode=\"server\"\n        paginationModel={paging}\n        onPaginationModelChange={(m) => { setPaging(m); void run(m); }}\n        pageSizeOptions={[20, 50, 100]}\n        disableRowSelectionOnClick\n        disableColumnMenu\n      />\n    </Box>\n  );\n}\nEOF\ncat > \"$D/AdminAttendanceClient.tsx\" <<'EOF'\n'use client';\n\nimport { useState } from 'react';\nimport NextLink from 'next/link';\nimport { useRouter } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Card from '@mui/material/Card';\nimport CardContent from '@mui/material/CardContent';\nimport Link from '@mui/material/Link';\nimport MenuItem from '@mui/material/MenuItem';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Tab from '@mui/material/Tab';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableContainer from '@mui/material/TableContainer';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport Tabs from '@mui/material/Tabs';\nimport TextField from '@mui/material/TextField';\nimport Typography from '@mui/material/Typography';\nimport { StatCard } from '@/components/StatCard/StatCard';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { useToast } from '@/components/Toast/useToast';\nimport { ATTENDANCE_MODES, attendanceSettingsPatch } from '@/lib/validators/attendance';\nimport type { getBelowThreshold, getOverview } from '@/server/attendance/attendance-service';\nimport { ReportTab, type ReportOptions } from './ReportTab';\n\ntype Overview = Awaited<ReturnType<typeof getOverview>>;\ntype Below = Awaited<ReturnType<typeof getBelowThreshold>>;\n\nconst MODE_LABELS: Record<(typeof ATTENDANCE_MODES)[number], string> = {\n  PER_PERIOD: 'Per period',\n  DAILY_HOMEROOM: 'Daily homeroom',\n  BOTH: 'Both',\n};\n\nconst pct = (rate: number | null) => (rate === null ? '—' : `${rate}%`);\n\nexport interface AdminAttendanceProps {\n  overview: Overview;\n  below: Below;\n  settings: { attendanceMode: (typeof ATTENDANCE_MODES)[number]; attendanceAlertThreshold: number };\n  options: ReportOptions;\n  today: string;\n  monthStart: string;\n}\n\n/** FR-5, FR-30 to FR-33: Today, Report, Below threshold and Settings on one page. */\nexport function AdminAttendanceClient({ overview, below, settings, options, today, monthStart }: AdminAttendanceProps) {\n  const router = useRouter();\n  const { showToast } = useToast();\n  const [tab, setTab] = useState('today');\n  const [reminding, setReminding] = useState<string | null>(null);\n  const [form, setForm] = useState({ attendanceMode: settings.attendanceMode, attendanceAlertThreshold: String(settings.attendanceAlertThreshold) });\n  const [savingSettings, setSavingSettings] = useState(false);\n\n  async function remind(m: Overview['missing'][number]) {\n    const id = `${m.courseId}|${m.periodId}`;\n    setReminding(id);\n    try {\n      const res = await fetch('/api/admin/attendance/remind', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ courseId: m.courseId, periodId: m.periodId, date: overview.date }),\n      });\n      const json = await res.json().catch(() => ({}));\n      if (!res.ok) throw new Error(json?.error?.message ?? 'Could not send the reminder.');\n      showToast({ message: `Reminder sent to ${json.data.reminded.name}`, severity: 'success' });\n    } catch (e) {\n      showToast({ message: e instanceof Error ? e.message : 'Could not send the reminder.', severity: 'error' });\n    } finally {\n      setReminding(null);\n    }\n  }\n\n  async function saveSettings() {\n    const parsed = attendanceSettingsPatch.safeParse({ attendanceMode: form.attendanceMode, attendanceAlertThreshold: Number(form.attendanceAlertThreshold) });\n    if (!parsed.success) {\n      showToast({ message: 'Threshold must be a whole number from 0 to 100.', severity: 'error' });\n      return;\n    }\n    setSavingSettings(true);\n    try {\n      const res = await fetch('/api/settings/school', {\n        method: 'PATCH',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(parsed.data),\n      });\n      const json = await res.json().catch(() => ({}));\n      if (!res.ok) throw new Error(json?.error?.message ?? 'Could not save settings.');\n      showToast({ message: 'Attendance settings saved', severity: 'success' });\n      router.refresh();\n    } catch (e) {\n      showToast({ message: e instanceof Error ? e.message : 'Could not save settings.', severity: 'error' });\n    } finally {\n      setSavingSettings(false);\n    }\n  }\n\n  return (\n    <Box>\n      <Tabs value={tab} onChange={(_, v) => setTab(v)} variant=\"scrollable\" scrollButtons=\"auto\" sx={{ mb: 3 }} aria-label=\"Attendance admin\">\n        <Tab value=\"today\" label=\"Today\" />\n        <Tab value=\"report\" label=\"Report\" />\n        <Tab value=\"below\" label={`Below threshold (${below.rows.length})`} />\n        <Tab value=\"settings\" label=\"Settings\" />\n      </Tabs>\n\n      {tab === 'today' && (\n        <Box>\n          <Box sx={{ display: 'grid', gridTemplateColumns: { xs: 'repeat(2, 1fr)', md: 'repeat(4, 1fr)' }, gap: 2, mb: 3 }}>\n            <StatCard label=\"Registers expected\" value={overview.expected} />\n            <StatCard label=\"Registers taken\" value={overview.taken} />\n            <StatCard label=\"Missing\" value={overview.missing.length} />\n            <StatCard label=\"Attendance today\" value={pct(overview.rate)} />\n          </Box>\n          <Typography variant=\"h6\" sx={{ mb: 1 }}>\n            Missing registers\n          </Typography>\n          {overview.missing.length === 0 ? (\n            <EmptyState title=\"No missing registers\" description=\"Registers count as missing 15 minutes after the period starts.\" />\n          ) : (\n            <Stack spacing={1}>\n              {overview.missing.map((m) => (\n                <Paper key={`${m.courseId}|${m.periodId}`} variant=\"outlined\" sx={{ p: 2 }}>\n                  <Stack direction=\"row\" spacing={2} useFlexGap sx={{ alignItems: 'center', flexWrap: 'wrap' }}>\n                    <Box sx={{ flexGrow: 1 }}>\n                      <Typography sx={{ fontWeight: 600 }}>\n                        {m.courseName}\n                        {m.sectionName && ` – ${m.sectionName}`}\n                      </Typography>\n                      <Typography variant=\"body2\" color=\"text.secondary\">\n                        {m.periodName} · {m.startTime} · {m.teacher.name}\n                      </Typography>\n                    </Box>\n                    <Button variant=\"outlined\" onClick={() => remind(m)} disabled={reminding === `${m.courseId}|${m.periodId}`}>\n                      Remind teacher\n                    </Button>\n                  </Stack>\n                </Paper>\n              ))}\n            </Stack>\n          )}\n        </Box>\n      )}\n\n      {tab === 'report' && <ReportTab options={options} today={today} monthStart={monthStart} />}\n\n      {tab === 'below' && (\n        <Box>\n          <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mb: 2 }}>\n            Students whose year-to-date attendance is below {below.threshold}%.\n          </Typography>\n          {below.rows.length === 0 ? (\n            <EmptyState title=\"Nobody is below the threshold\" />\n          ) : (\n            <TableContainer component={Paper} variant=\"outlined\">\n              <Table size=\"small\" aria-label=\"Students below the attendance threshold\">\n                <TableHead>\n                  <TableRow>\n                    <TableCell>Student</TableCell>\n                    <TableCell>Section</TableCell>\n                    <TableCell>Grade</TableCell>\n                    <TableCell align=\"right\">Absent</TableCell>\n                    <TableCell align=\"right\">Late</TableCell>\n                    <TableCell align=\"right\">Rate</TableCell>\n                  </TableRow>\n                </TableHead>\n                <TableBody>\n                  {below.rows.map((r) => (\n                    <TableRow key={r.studentId}>\n                      <TableCell>\n                        <Link component={NextLink} href={r.href}>\n                          {r.studentName}\n                        </Link>\n                      </TableCell>\n                      <TableCell>{r.sectionName ?? '—'}</TableCell>\n                      <TableCell>{r.gradeLevelName ?? '—'}</TableCell>\n                      <TableCell align=\"right\">{r.absent}</TableCell>\n                      <TableCell align=\"right\">{r.late}</TableCell>\n                      <TableCell align=\"right\">{pct(r.rate)}</TableCell>\n                    </TableRow>\n                  ))}\n                </TableBody>\n              </Table>\n            </TableContainer>\n          )}\n        </Box>\n      )}\n\n      {tab === 'settings' && (\n        <Card variant=\"outlined\" sx={{ maxWidth: 480 }}>\n          <CardContent>\n            <Typography variant=\"h6\" sx={{ mb: 2 }}>\n              Attendance settings\n            </Typography>\n            <Stack spacing={2}>\n              <TextField\n                select\n                label=\"Attendance mode\"\n                value={form.attendanceMode}\n                onChange={(e) => setForm({ ...form, attendanceMode: e.target.value as typeof form.attendanceMode })}\n              >\n                {ATTENDANCE_MODES.map((m) => (\n                  <MenuItem key={m} value={m}>\n                    {MODE_LABELS[m]}\n                  </MenuItem>\n                ))}\n              </TextField>\n              <TextField\n                type=\"number\"\n                label=\"Alert threshold (%)\"\n                value={form.attendanceAlertThreshold}\n                onChange={(e) => setForm({ ...form, attendanceAlertThreshold: e.target.value })}\n                slotProps={{ htmlInput: { min: 0, max: 100 } }}\n              />\n              <Box>\n                <Button variant=\"contained\" onClick={saveSettings} disabled={savingSettings}>\n                  Save settings\n                </Button>\n              </Box>\n            </Stack>\n          </CardContent>\n        </Card>\n      )}\n    </Box>\n  );\n}\nEOF\ncat > \"$D/page.tsx\" <<'EOF'\nimport Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { prisma } from '@/server/db';\nimport { getSchoolSettings } from '@/server/services/settings';\nimport { getAttendanceSettings, getBelowThreshold, getOverview } from '@/server/attendance/attendance-service';\nimport { schoolToday } from '@/server/attendance/attendance-rules';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { AdminAttendanceClient } from './AdminAttendanceClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /admin/attendance — ADMIN (FR-5, FR-30 to FR-33). */\nexport default async function AdminAttendancePage() {\n  await requirePageRole('ADMIN');\n  const { timezone } = await getSchoolSettings();\n  const today = schoolToday(new Date(), timezone);\n  const current = { academicYear: { isCurrent: true } };\n  const [overview, below, settings, gradeLevels, sections, courses] = await Promise.all([\n    getOverview(),\n    getBelowThreshold(),\n    getAttendanceSettings(),\n    prisma.gradeLevel.findMany({ where: { archivedAt: null }, select: { id: true, name: true }, orderBy: { order: 'asc' } }),\n    prisma.section.findMany({ where: current, select: { id: true, name: true }, orderBy: { name: 'asc' } }),\n    prisma.course.findMany({ where: { ...current, archivedAt: null }, select: { id: true, name: true }, orderBy: { name: 'asc' } }),\n  ]);\n\n  return (\n    <Box>\n      <PageHeader title=\"Attendance\" description=\"Today's registers, reports and settings\" />\n      <AdminAttendanceClient\n        overview={overview}\n        below={below}\n        settings={settings}\n        options={{ gradeLevels, sections, courses }}\n        today={today}\n        monthStart={`${today.slice(0, 8)}01`}\n      />\n    </Box>\n  );\n}\nEOF\nnpx tsc --noEmit 2>&1 | head -20","description":"Create admin attendance page and tabs, typecheck"}},"wire_ingest_context":{"toolu_01KZatJmGdirJsbc1bPFNfAC":{"cwd":"/Users/ikramaansari/Documents/forge/schoolhub"}}}
