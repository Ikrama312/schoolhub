{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rn5qmoSqSoTYaxdQrd5PN1","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/http.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"24b2a9c9-4488-41ba-bad0-91baebb96cfb","uuid":"2e1c9433-6f0d-4681-b228-afcc100f373b","timestamp":"2026-11-04T06:47:13.683Z","tool_use_result":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/http.ts","oldString":"export function parseQuery<","newString":"/** First x-forwarded-for entry (the client, behind our proxy), or null. */\nexport function getClientIp(request: Request): string | null {\n  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n}\n\nexport function parseQuery<","originalFile":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\n// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\nexport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\nexport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\n","structuredPatch":[{"oldStart":127,"oldLines":6,"newStart":127,"newLines":11,"lines":["   return schema.parse(json);"," }"," ","+/** First x-forwarded-for entry (the client, behind our proxy), or null. */","+export function getClientIp(request: Request): string | null {","+  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;","+}","+"," export function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {","   return schema.parse(Object.fromEntries(searchParams.entries()));"," }"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01Rn5qmoSqSoTYaxdQrd5PN1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghSPtca6UPhzfVHn6rEf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01738CPUAKereQpHm8VpkSm6","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/tests/unit/rate-limit.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { rateLimit, __resetRateLimits } from '@/server/rate-limit';\nimport { getClientIp } from '@/server/http';\n\ndescribe('rateLimit', () => {\n  beforeEach(() => __resetRateLimits());\n\n  it('allows up to the limit then blocks with retryAfterMs', () => {\n    for (let i = 0; i < 3; i += 1) expect(rateLimit('k', 3, 1000, 100 + i).ok).toBe(true);\n    const blocked = rateLimit('k', 3, 1000, 500);\n    expect(blocked.ok).toBe(false);\n    expect(blocked.retryAfterMs).toBe(600); // first hit at 100 expires at 1100\n  });\n\n  it('slides the window', () => {\n    rateLimit('k', 2, 1000, 0);\n    rateLimit('k', 2, 1000, 500);\n    expect(rateLimit('k', 2, 1000, 999).ok).toBe(false);\n    expect(rateLimit('k', 2, 1000, 1001).ok).toBe(true); // hit at 0 aged out\n  });\n\n  it('isolates keys', () => {\n    rateLimit('a', 1, 1000, 0);\n    expect(rateLimit('a', 1, 1000, 1).ok).toBe(false);\n    expect(rateLimit('b', 1, 1000, 1).ok).toBe(true);\n  });\n});\n\ndescribe('getClientIp', () => {\n  it('takes the first x-forwarded-for entry, trimmed', () => {\n    expect(getClientIp(new Request('http://x', { headers: { 'x-forwarded-for': ' 1.2.3.4 , 10.0.0.1' } }))).toBe('1.2.3.4');\n  });\n\n  it('returns null without the header', () => {\n    expect(getClientIp(new Request('http://x'))).toBeNull();\n  });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1665,"cache_read_input_tokens":128698,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1665},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"24b2a9c9-4488-41ba-bad0-91baebb96cfb","uuid":"e05e796b-eb8e-47bf-bfbe-42426e74e394","timestamp":"2026-11-04T06:47:18.916Z","request_id":"req_011CghSPtMSiMatEKFT98JvC","wire_tool_inputs":{"toolu_01738CPUAKereQpHm8VpkSm6":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/tests/unit/rate-limit.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { rateLimit, __resetRateLimits } from '@/server/rate-limit';\nimport { getClientIp } from '@/server/http';\n\ndescribe('rateLimit', () => {\n  beforeEach(() => __resetRateLimits());\n\n  it('allows up to the limit then blocks with retryAfterMs', () => {\n    for (let i = 0; i < 3; i += 1) expect(rateLimit('k', 3, 1000, 100 + i).ok).toBe(true);\n    const blocked = rateLimit('k', 3, 1000, 500);\n    expect(blocked.ok).toBe(false);\n    expect(blocked.retryAfterMs).toBe(600); // first hit at 100 expires at 1100\n  });\n\n  it('slides the window', () => {\n    rateLimit('k', 2, 1000, 0);\n    rateLimit('k', 2, 1000, 500);\n    expect(rateLimit('k', 2, 1000, 999).ok).toBe(false);\n    expect(rateLimit('k', 2, 1000, 1001).ok).toBe(true); // hit at 0 aged out\n  });\n\n  it('isolates keys', () => {\n    rateLimit('a', 1, 1000, 0);\n    expect(rateLimit('a', 1, 1000, 1).ok).toBe(false);\n    expect(rateLimit('b', 1, 1000, 1).ok).toBe(true);\n  });\n});\n\ndescribe('getClientIp', () => {\n  it('takes the first x-forwarded-for entry, trimmed', () => {\n    expect(getClientIp(new Request('http://x', { headers: { 'x-forwarded-for': ' 1.2.3.4 , 10.0.0.1' } }))).toBe('1.2.3.4');\n  });\n\n  it('returns null without the header', () => {\n    expect(getClientIp(new Request('http://x'))).toBeNull();\n  });\n});\n"}}}
