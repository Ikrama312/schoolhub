});\n});\n","numLines":19,"startLine":1,"totalLines":19}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G35RQCmcsDwu6VtHx97Ltt","type":"tool_result","content":"1\timport { prisma } from '@/server/db';\n2\timport { ok, withHandler } from '@/server/http';\n3\t\n4\tconst DB_CHECK_BUDGET_MS = 2000;\n5\t\n6\tasync function timeout(ms: number): Promise<never> {\n7\t  return new Promise((_, reject) => {\n8\t    setTimeout(() => reject(new Error('db check timed out')), ms);\n9\t  });\n10\t}\n11\t\n12\texport const GET = withHandler(async () => {\n13\t  try {\n14\t    await Promise.race([prisma.$queryRaw`SELECT 1`, timeout(DB_CHECK_BUDGET_MS)]);\n15\t    return ok({ status: 'ok', db: 'ok', time: new Date().toISOString() });\n16\t  } catch {\n17\t    // 503, not the generic INTERNAL/500 shape — FR-16 requires this exact\n18\t    // status+body pair for a failed liveness check.\n19\t    return ok(\n20\t      { status: 'error', db: 'error', time: new Date().toISOString() },\n21\t      { status: 503 },\n22\t    );\n23\t  }\n24\t});\n25\t"}]},"parent_tool_use_id":null,"session_id":"b784be86-9b15-4d20-b52f-af56b319547e","uuid":"c85e6992-c59a-4f9a-8fe5-623ff41bc6eb","timestamp":"2026-10-19T08:54:00.313Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/api/health/route.ts","content":"import { prisma } from '@/server/db';\nimport { ok, withHandler } from '@/server/http';\n\nconst DB_CHECK_BUDGET_MS = 2000;\n\nasync function timeout(ms: number): Promise<never> {\n  return new Promise((_, reject) => {\n    setTimeout(() => reject(new Error('db check timed out')), ms);\n  });\n}\n\nexport const GET = withHandler(async () => {\n  try {\n    await Promise.race([prisma.$queryRaw`SELECT 1`, timeout(DB_CHECK_BUDGET_MS)]);\n    return ok({ status: 'ok', db: 'ok', time: new Date().toISOString() });\n  } catch {\n    // 503, not the generic INTERNAL/500 shape — FR-16 requires this exact\n    // status+body pair for a failed liveness check.\n    return ok(\n      { status: 'error', db: 'error', time: new Date().toISOString() },\n      { status: 503 },\n    );\n  }\n});\n","numLines":25,"startLine":1,"totalLines":25}}}
