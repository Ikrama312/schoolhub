{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017NJKcVt9MjAY6oXta43yrk","type":"tool_result","content":"1\timport { addDays, differenceInCalendarDays, format } from 'date-fns';\n2\timport { Prisma, type AcademicYear, type Term } from '@prisma/client';\n3\timport { prisma } from '@/server/db';\n4\timport { AppError } from '@/server/http';\n5\timport { rangesOverlap } from './dateRange';\n6\t\n7\texport interface TermInput {\n8\t  name: string;\n9\t  startDate: Date;\n10\t  endDate: Date;\n11\t}\n12\t\n13\texport type GeneratePattern = 'SEMESTERS' | 'TRIMESTERS' | 'QUARTERS';\n14\t\n15\tconst PATTERN_CONFIG: Record<GeneratePattern, { count: number; label: string }> = {\n16\t  SEMESTERS: { count: 2, label: 'Semester' },\n17\t  TRIMESTERS: { count: 3, label: 'Trimester' },\n18\t  QUARTERS: { count: 4, label: 'Quarter' },\n19\t};\n20\t\n21\tfunction assertValidRange(startDate: Date, endDate: Date) {\n22\t  if (endDate <= startDate) {\n23\t    throw new AppError('VALIDATION_ERROR', 'End date must be after start date.');\n24\t  }\n25\t}\n26\t\n27\tfunction assertInsideYear(year: Pick<AcademicYear, 'startDate' | 'endDate'>, startDate: Date, endDate: Date) {\n28\t  if (startDate < year.startDate) {\n29\t    throw new AppError('VALIDATION_ERROR', `Term must start on or after ${format(year.startDate, 'yyyy-MM-dd')}.`);\n30\t  }\n31\t  if (endDate > year.endDate) {\n32\t    throw new AppError('VALIDATION_ERROR', `Term must end on or before ${format(year.endDate, 'yyyy-MM-dd')}.`);\n33\t  }\n34\t}\n35\t\n36\tfunction assertNoSiblingOverlap(\n37\t  siblings: Pick<Term, 'name' | 'startDate' | 'endDate'>[],\n38\t  startDate: Date,\n39\t  endDate: Date,\n40\t) {\n41\t  const conflict = siblings.find((term) => rangesOverlap({ startDate, endDate }, term));\n42\t  if (conflict) {\n43\t    throw new AppError('VALIDATION_ERROR', `Dates overlap with ${conflict.name}.`);\n44\t  }\n45\t}\n46\t\n47\texport async function createTerm(academicYearId: string, input: TermInput) {\n48\t  assertValidRange(input.startDate, input.endDate);\n49\t  return prisma.$transaction(\n50\t    async (tx) => {\n51\t      const year = await tx.academicYear.findUniqueOrThrow({ where: { id: academicYearId } });\n52\t      assertInsideYear(year, input.startDate, input.endDate);\n53\t      const siblings = await tx.term.findMany({ where: { academicYearId } });\n54\t      assertNoSiblingOverlap(siblings, input.startDate, input.endDate);\n55\t      const maxOrder = siblings.reduce((max, term) => Math.max(max, term.order), 0);\n56\t      return tx.term.create({\n57\t        data: { academicYearId, name: input.name, startDate: input.startDate, endDate: input.endDate, order: maxOrder + 1 },\n58\t      });\n59\t    },\n60\t    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n61\t  );\n62\t}\n63\t\n64\texport async function updateTerm(id: string, input: Partial<TermInput> & { order?: number }) {\n65\t  return prisma.$transaction(\n66\t    async (tx) => {\n67\t      const existing = await tx.term.findUniqueOrThrow({ where: { id } });\n68\t      const year = await tx.academicYear.findUniqueOrThrow({ where: { id: existing.academicYearId } });\n69\t      const startDate = input.startDate ?? existing.startDate;\n70\t      const endDate = input.endDate ?? existing.endDate;\n71\t      assertValidRange(startDate, endDate);\n72\t      assertInsideYear(year, startDate, endDate);\n73\t      const siblings = await tx.term.findMany({\n74\t        where: { academicYearId: existing.academicYearId, id: { not: id } },\n75\t      });\n76\t      assertNoSiblingOverlap(siblings, startDate, endDate);\n77\t      return tx.term.update({\n78\t        where: { id },\n79\t        data: { name: input.name ?? existing.name, startDate, endDate, order: input.order ?? existing.order },\n80\t      });\n81\t    },\n82\t    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n83\t  );\n84\t}\n85\t\n86\texport async function deleteTerm(id: string) {\n87\t  await prisma.term.delete({ where: { id } });\n88\t}\n89\t\n90\t/**\n91\t * Persists a new term order for one academic year. Writes negative\n92\t * placeholder orders first so the @@unique([academicYearId, order])\n93\t * constraint never collides with an order value still held by another\n94\t * term mid-swap.\n95\t */\n96\texport async function reorderTerms(academicYearId: string, termIds: string[]) {\n97\t  return prisma.$transaction(async (tx) => {\n98\t    for (const [index, id] of termIds.entries()) {\n99\t      await tx.term.updateMany({ where: { id, academicYearId }, data: { order: -(index + 1) } });\n100\t    }\n101\t    for (const [index, id] of termIds.entries()) {\n102\t      await tx.term.updateMany({ where: { id, academicYearId }, data: { order: index + 1 } });\n103\t    }\n104\t    return tx.term.findMany({ where: { academicYearId }, orderBy: { order: 'asc' } });\n105\t  });\n106\t}\n107\t\n108\t/**\n109\t * Splits the year's date range into `count` contiguous, equal-length terms,\n110\t * named \"<Label> 1\", \"<Label> 2\"... Earlier terms absorb the remainder day\n111\t * when the range doesn't divide evenly, so every day of the year is covered\n112\t * with no gap or overlap. Only allowed when the year has zero terms.\n113\t */\n114\texport async function generateTerms(academicYearId: string, pattern: GeneratePattern) {\n115\t  return prisma.$transaction(async (tx) => {\n116\t    const year = await tx.academicYear.findUniqueOrThrow({ where: { id: academicYearId } });\n117\t    const existingCount = await tx.term.count({ where: { academicYearId } });\n118\t    if (existingCount > 0) {\n119\t      throw new AppError('CONFLICT', 'Generate terms is only available when the year has no terms.');\n120\t    }\n121\t\n122\t    const { count, label } = PATTERN_CONFIG[pattern];\n123\t    const totalDays = differenceInCalendarDays(year.endDate, year.startDate) + 1;\n124\t    const base = Math.floor(totalDays / count);\n125\t    const remainder = totalDays % coun