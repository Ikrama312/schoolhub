onst DRAWER_WIDTH_COLLAPSED = 64;\n38\tconst COLLAPSE_STORAGE_KEY = 'schoolhub.sidebar.collapsed';\n39\t\n40\t// Placeholder user until PRD-01 wires real auth (FR-33's \"for later wiring\" note).\n41\tconst PLACEHOLDER_USER: { id: string; name: string; role: Role } = {\n42\t  id: 'placeholder-user',\n43\t  name: 'Guest User',\n44\t  role: 'ADMIN',\n45\t};\n46\t\n47\texport interface AppShellProps {\n48\t  schoolShortName: string;\n49\t  children: React.ReactNode;\n50\t}\n51\t\n52\tconst DESKTOP_BREAKPOINT_PX = 1024;\n53\t\n54\texport function AppShell({ schoolShortName, children }: AppShellProps) {\n55\t  const theme = useTheme();\n56\t  const { mode, setMode } = useColorScheme();\n57\t  const pathname = usePathname();\n58\t  // FR-31/NFR-4 fix the fork at exactly 1024px — MUI's own \"lg\" breakpoint\n59\t  // (1200px) doesn't match that, so this uses an explicit media query.\n60\t  const isDesktop = useMediaQuery(`(min-width:${DESKTOP_BREAKPOINT_PX}px)`);\n61\t\n62\t  const [collapsed, setCollapsed] = useState(false);\n63\t  const [mobileOpen, setMobileOpen] = useState(false);\n64\t  const [menuAnchor, setMenuAnchor] = useState<HTMLElement | null>(null);\n65\t\n66\t  useEffect(() => {\n67\t    const stored = window.localStorage.getItem(COLLAPSE_STORAGE_KEY);\n68\t    if (stored === 'true') setCollapsed(true);\n69\t  }, []);\n70\t\n71\t  const toggleCollapsed = () => {\n72\t    setCollapsed((prev) => {\n73\t      const next = !prev;\n74\t      window.localStorage.setItem(COLLAPSE_STORAGE_KEY, String(next));\n75\t      return next;\n76\t    });\n77\t  };\n78\t\n79\t  const drawerWidth = collapsed ? DRAWER_WIDTH_COLLAPSED : DRAWER_WIDTH_EXPANDED;\n80\t  const items = navigationForRole(PLACEHOLDER_USER.role);\n81\t\n82\t  const navList = (\n83\t    <List sx={{ pt: 1 }}>\n84\t      {items.map((item) => {\n85\t        const Icon = item.icon;\n86\t        const active = pathname === item.href || pathname.startsWith(`${item.href}/`);\n87\t        const button = (\n88\t    