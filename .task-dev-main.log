st PATCH = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const patch = await parseBody(request, quizPatchSchema);\n  return ok(await updateQuiz(user, params.id, patch, request));\n});\n\n/** DELETE /api/quizzes/:id — only without attempts. */\nexport const DELETE = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  return ok(await deleteQuiz(user, params.id, request));\n});\nEOF\ncat > 'quizzes/[id]/questions/route.ts' <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { addQuestion } from '@/server/quiz/quiz-service';\nimport { questionSchema } from '@/lib/validators/quiz';\n\n/** POST /api/quizzes/:id/questions — add (and Duplicate) behind the edit lock (FR-7, FR-10). */\nexport const POST = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  const input = await parseBody(request, questionSchema);\n  return ok(await addQuestion(user, params.id, input), { status: 201 });\n});\nEOF\ncat > 'quizzes/[id]/questions/reorder/route.ts' <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { reorderQuestions } from '@/server/quiz/quiz-service';\nimport { reorderSchema } from '@/lib/validators/quiz';\n\n/** POST /api/quizzes/:id/questions/reorder — full permutation (FR-7). */\nexport const POST = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  const { questionIds } = await parseBody(request, reorderSchema);\n  return ok(await reorderQuestions(user, params.id, questionIds));\n});\nEOF\ncat > 'questions/[id]/route.ts' <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { deleteQuestion, updateQuestion } from '@/server/quiz/quiz-service';\nimport { questionPatchSchema } from '@/lib/validators/quiz';\n\ntype Ctx = { params: { id: string } };\n\n/** PATCH /api/questions/:id — edit, limited by the edit lock (FR-7, FR-10). */\nexport const PATCH = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const patch = await parseBody(request, questionPatchSchema);\n  return ok(await updateQuestion(user, params.id, patch));\n});\n\n/** DELETE /api/questions/:id — blocked by the edit lock. */\nexport const DELETE = withHandler(async (_request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  return ok(await deleteQuestion(user, params.id));\n});\nEOF\ncat > 'quizzes/[id]/regrade/route.ts' <<'EOF'\nimport { ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { regradeQuiz } from '@/server/quiz/quiz-service';\n\n/** POST /api/quizzes/:id/regrade — re-run auto-grading; manual grades win (FR-10, FR-38). */\nexport const POST = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  return ok(await regradeQuiz(user, params.id, request));\n});\nEOF\ncat > 'quizzes/[id]/release-results/route.ts' <<'EOF'\nimport { ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { releaseResults } from '@/server/quiz/quiz-service';\n\n/** POST /api/quizzes/:id/release-results — MANUAL visibility only; repeat is a no-op (FR-20, FR-30). */\nexport const POST = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  return ok(await releaseResults(user, params.id, request));\n});\nEOF\ncat > 'quizzes/[id]/analytics/route.ts' <<'EOF'\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { analyticsCsv, getQuizAnalytics } from '@/server/quiz/analytics';\nimport { analyticsQuery } from '@/lib/validators/quiz';\n\n/** GET /api/quizzes/:id/analytics[?format=csv] (FR-26, FR-27). */\nexport const GET = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  const { format } = parseQuery(new URL(request.url).searchParams, analyticsQuery);\n  if (format === 'json') return ok(await getQuizAnalytics(user, params.id));\n  return new Response(await analyticsCsv(user, params.id), {\n    headers: {\n      'Content-Type': 'text/csv; charset=utf-8',\n      'Content-Disposition': `attachment; filename=\"quiz-${params.id}-attempts.csv\"`,\n    },\n  });\n});\nEOF\ncat > 'quizzes/[id]/accommodations/[studentId]/route.ts' <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { upsertAccommodation } from '@/server/quiz/quiz-service';\nimport { accommodationSchema } from '@/lib/validators/quiz';\n\n/** PUT /api/quizzes/:id/accommodations/:studentId — applies to attempts started afterwards (FR-28, A7). */\nexport const PUT = withHandler(async (request: Request, { params }: { params: { id: string; studentId: string } }) => {\n  const user = await requireUser();\n  const input = await parseBody(request, accommodationSchema);\n  return ok(await upsertAccommodation(user, params.id, params.studentId, input, request));\n});\nEOF\ncat > 'quizzes/[id]/attempts/route.ts' <<'EOF'\nimport { ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { startOrResumeAttempt } from '@/server/quiz/attempt-service';\n\n/** POST /api/quizzes/:id/attempts — STUDENT start (201) or resume (200) (FR-13, FR-19, FR-23). */\nexport const POST = withHandler(async (_request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  const { attempt, created } = await startOrResumeAttempt(user, params.id);\n  return ok(attempt, { status: created ? 201 : 200 });\n});\nEOF\ncat > 'attempts/[id]/route.ts' <<'EOF'\nimport { ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { getAttempt } from '@/server/quiz/attempt-service';\n\n/** GET /api/attempts/:id — lazy auto-submit, then role-shaped (FR-18, FR-21, FR-34). */\nexport const GET = withHandler(async (_request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  return ok(await getAttempt(user, params.id));\n});\nEOF\ncat > 'attempts/[id]/answers/[questionId]/route.ts' <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { saveAnswer } from '@/server/quiz/attempt-service';\nimport { answerResponseSchema } from '@/lib/validators/quiz';\n\nexport const dynamic = 'force-dynamic';\n\n/** PUT /api/attempts/:id/answers/:questionId — autosave hot path; no grading data back (FR-15, FR-16, NFR-2). */\nexport const PUT = withHandler(async (request: Request, { params }: { params: { id: string; questionId: string } }) => {\n  const user = await requireUser();\n  const { response } = await parseBody(request, answerResponseSchema);\n  return ok(await saveAnswer(user, params.id, params.questionId, response));\n});\nEOF\ncat > 'attempts/[id]/submit/route.ts' <<'EOF'\nimport { ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { submitForStudent } from '@/server/quiz/attempt-service';\n\n/** POST /api/attempts/:id/submit — idempotent; returns StudentResult (FR-17). */\nexport const POST = withHandler(async (_request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  return ok(await submitForStudent(user, params.id));\n});\nEOF\ncat > 'attempts/[id]/answers/[questionId]/grade/route.ts' <<'EOF'\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { gradeAnswerManually } from '@/server/quiz/attempt-service';\nimport { manualGradeSchema } from '@/lib/validators/quiz';\n\n/** PUT /api/attempts/:id/answers/:questionId/grade — manual grade / override (FR-24, FR-25, FR-38). */\nexport const PUT = withHandler(async (request: Request, { params }: { params: { id: string; questionId: string } }) => {\n  const user = await requireUser();\n  const input = await parseBody(request, manualGradeSchema);\n  return ok(await gradeAnswerManually(user, params.id, params.questionId, input, request));\n});\nEOF\ncd ../../.. && npx tsc --noEmit 2>&1 | head -20","description":"Create quiz/attempt route handlers and typecheck"}}}
