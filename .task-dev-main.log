his to build the post-login callbackUrl.\n  const headers = new Headers(req.headers);\n  headers.set('x-pathname', pathname + search);\n  return NextResponse.next({ request: { headers } });\n});\n\nexport const config = {\n  matcher: ['/((?!_next/static|_next/image|favicon.ico|.*\\\\.[a-zA-Z0-9]+$).*)'],\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7002,"cache_read_input_tokens":78924,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7002},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"46abff3e-324d-47c1-a451-e45bcb70c7c7","uuid":"431fb790-9004-4de9-9b12-ef9201199672","timestamp":"2026-11-04T06:50:31.761Z","request_id":"req_011CghSgArai8tDYjRSeVDtF","wire_tool_inputs":{"toolu_01EWc3RH54te28ht5AGBohv1":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/middleware.ts","content":"import NextAuth from 'next-auth';\nimport { NextResponse } from 'next/server';\nimport { authConfig } from '@/server/auth/auth.config';\nimport { isPublicPath } from '@/config/public-routes';\n\n/**\n * Edge gate (FR-12, NFR-7). Edge-safe: authConfig only, no Prisma/bcrypt.\n * This is a convenience redirect; requireRole()/requirePageRole() remain\n * the real authorization check on every handler and page.\n */\nconst { auth } = NextAuth(authConfig);\n\n// Auth.js's own endpoints (signin/signout/callback/csrf/session) carry their own CSRF token.\nconst AUTHJS_ENDPOINT = /^\\/api\\/auth\\/(signin|signout|callback|csrf|session|providers)(\\/|$)/;\n\nfunction jsonError(code: 'FORBIDDEN' | 'UNAUTHENTICATED', message: string, status: number) {\n  return NextResponse.json({ error: { code, message } }, { status });\n}\n\nexport default auth((req) => {\n  const { pathname, search, or