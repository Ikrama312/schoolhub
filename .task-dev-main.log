{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KoKAQJKcVaFjRrPbMdHNBr","type":"tool_result","content":"1\timport { cache } from 'react';\n2\timport { Prisma } from '@prisma/client';\n3\timport { prisma } from '@/server/db';\n4\timport { AppError } from '@/server/http';\n5\timport { rangesOverlap } from './dateRange';\n6\timport { getSchoolSettings } from './settings';\n7\timport { formatInSchoolTz } from '@/lib/dates';\n8\t\n9\texport interface AcademicYearInput {\n10\t  name: string;\n11\t  startDate: Date;\n12\t  endDate: Date;\n13\t}\n14\t\n15\tfunction assertValidRange(startDate: Date, endDate: Date) {\n16\t  if (endDate <= startDate) {\n17\t    throw new AppError('VALIDATION_ERROR', 'End date must be after start date.');\n18\t  }\n19\t}\n20\t\n21\tasync function assertNoOverlap(\n22\t  tx: Prisma.TransactionClient,\n23\t  range: { startDate: Date; endDate: Date },\n24\t  excludeId?: string,\n25\t) {\n26\t  const others = await tx.academicYear.findMany({\n27\t    where: excludeId ? { id: { not: excludeId } } : undefined,\n28\t  });\n29\t  const conflict = others.find((year) => rangesOverlap(range, year));\n30\t  if (conflict) {\n31\t    throw new AppError('VALIDATION_ERROR', `Dates overlap with ${conflict.name}.`);\n32\t  }\n33\t}\n34\t\n35\texport async function listAcademicYears() {\n36\t  return prisma.academicYear.findMany({\n37\t    orderBy: { startDate: 'asc' },\n38\t    include: { terms: { orderBy: { order: 'asc' } } },\n39\t  });\n40\t}\n41\t\n42\texport async function createAcademicYear(input: AcademicYearInput) {\n43\t  assertValidRange(input.startDate, input.endDate);\n44\t  return prisma.$transaction(\n45\t    async (tx) => {\n46\t      await assertNoOverlap(tx, input);\n47\t      return tx.academicYear.create({ data: input });\n48\t    },\n49\t    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n50\t  );\n51\t}\n52\t\n53\texport async function updateAcademicYear(id: string, input: Partial<AcademicYearInput>) {\n54\t  return prisma.$transaction(\n55\t    async (tx) => {\n56\t      const existing = await tx.academicYear.findUniqueOrThrow({ where: { id } });\n57\t      const startDate = input.startDate ?? existing.startDate;\n58\t      const endDate = input.endDate ?? existing.endDate;\n59\t      assertValidRange(startDate, endDate);\n60\t      await assertNoOverlap(tx, { startDate, endDate }, id);\n61\t      return tx.academicYear.update({\n62\t        where: { id },\n63\t        data: { name: input.name ?? existing.name, startDate, endDate },\n64\t      });\n65\t    },\n66\t    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n67\t  );\n68\t}\n69\t\n70\t/** Sets isCurrent = true on `id` and false on every other year, atomically. */\n71\texport async function setCurrentAcademicYear(id: string) {\n72\t  const [, updated] = await prisma.$transaction([\n73\t    prisma.academicYear.updateMany({ where: { id: { not: id } }, data: { isCurrent: false } }),\n74\t    prisma.academicYear.update({ where: { id }, data: { isCurrent: true } }),\n75\t  ]);\n76\t  return updated;\n77\t}\n78\t\n79\texport async function deleteAcademicYear(id: string) {\n80\t  const termCount = await prisma.term.count({ where: { academicYearId: id } });\n81\t  if (termCount > 0) {\n82\t    throw new AppError('CONFLICT', 'In use — cannot delete.');\n83\t  }\n84\t  await prisma.academicYear.delete({ where: { id } });\n85\t}\n86\t\n87\t/** The one place the rest of the app reads \"the current academic year\" from. */\n88\texport const getCurrentAcademicYear = cache(async () => {\n89\t  return prisma.academicYear.findFirst({\n90\t    where: { isCurrent: true },\n91\t    include: { terms: { orderBy: { order: 'asc' } } },\n92\t  });\n93\t});\n94\t\n95\t/** Returns the term whose range contains `date` (school-timezone calendar day), or null. */\n96\texport async function getCurrentTerm(date: Date = new Date()) {\n97\t  const settings = await getSchoolSettings();\n98\t  const dayKey = formatInSchoolTz(date, 'yyyy-MM-dd', settings.timezone);\n99\t  const asOf = new Date(`${dayKey}T00:00:00.000Z`);\n100\t  return prisma.term.findFirst({\n101\t    where: { startDate: { lte: asOf }, endDate: { gte: asOf } },\n102\t  });\n103\t}\n104\t"}]},"parent_tool_use_id":null,"session_id":"a1a784f8-378b-420c-a5fd-aba631abc12f","uuid":"90a50ecf-dee5-443d-8a38-fba5fac930a0","timestamp":"2026-10-19T08:57:53.243Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/services/academicYears.ts","content":"import { cache } from 'react';\nimport { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { rangesOverlap } from './dateRange';\nimport { getSchoolSettings } from './settings';\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface AcademicYearInput {\n  name: string;\n  startDate: Date;\n  endDate: Date;\n}\n\nfunction assertValidRange(startDate: Date, endDate: Date) {\n  if (endDate <= startDate) {\n    throw new AppError('VALIDATION_ERROR', 'End date must be after start date.');\n  }\n}\n\nasync function assertNoOverlap(\n  tx: Prisma.TransactionClient,\n  range: { startDate: Date; endDate: Date },\n  excludeId?: string,\n) {\n  const others = await tx.academicYear.findMany({\n    where: excludeId ? { id: { not: excludeId } } : undefined,\n  });\n  const conflict = others.find((year) => rangesOverlap(range, year));\n  if (conflict) {\n    throw new AppError('VALIDATION_ERROR', `Dates overlap with ${conflict.name}.`);\n  }\n}\n\nexport async function listAcademicYears() {\n  return prisma.academicYear.findMany({\n    orderBy: { startDate: 'asc' },\n    include: { terms: { orderBy: { order: 'asc' } } },\n  });\n}\n\nexport async function createAcademicYear(input: AcademicYearInput) {\n  assertValidRange(input.startDate, input.endDate);\n  return prisma.$transaction(\n    async (tx) => {\n      await assertNoOverlap(tx, input);\n      return tx.academicYear.create({ data: input });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\nexport async function updateAcademicYear(id: string, input: Partial<AcademicYearInput>) {\n  return prisma.$transaction(\n    async (tx) => {\n      const existing = await tx.academicYear.findUniqueOrThrow({ where: { id } });\n      const startDate = input.startDate ?? existing.startDate;\n      const endDate = input.endDate ?? existing.endDate;\n      assertValidRange(startDate, endDate);\n      await assertNoOverlap(tx, { startDate, endDate }, id);\n      return tx.academicYear.update({\n        where: { id },\n        data: { name: input.name ?? existing.name, startDate, endDate },\n      });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\n/** Sets isCurrent = true on `id` and false on every other year, atomically. */\nexport async function setCurrentAcademicYear(id: string) {\n  const [, updated] = await prisma.$transaction([\n    prisma.academicYear.updateMany({ where: { id: { not: id } }, data: { isCurrent: false } }),\n    prisma.academicYear.update({ where: { id }, data: { isCurrent: true } }),\n  ]);\n  return updated;\n}\n\nexport async function deleteAcademicYear(id: string) {\n  const termCount = await prisma.term.count({ where: { academicYearId: id } });\n  if (termCount > 0) {\n    throw new AppError('CONFLICT', 'In use — cannot delete.');\n  }\n  await prisma.academicYear.delete({ where: { id } });\n}\n\n/** The one place the rest of the app reads \"the current academic year\" from. */\nexport const getCurrentAcademicYear = cache(async () => {\n  return prisma.academicYear.findFirst({\n    where: { isCurrent: true },\n    include: { terms: { orderBy: { order: 'asc' } } },\n  });\n});\n\n/** Returns the term whose range contains `date` (school-timezone calendar day), or null. */\nexport async function getCurrentTerm(date: Date = new Date()) {\n  const settings = 