s                                     (NEW — GET/POST)\n        [id]/route.ts                                (NEW — PATCH)\n      subjects/\n        route.ts                                     (NEW — GET/POST)\n        [id]/route.ts                                (NEW — PATCH)\n      rooms/\n        route.ts                                     (NEW — GET/POST)\n        [id]/route.ts                                (NEW — PATCH)\n\n    (app)/\n      shell.tsx                                      (MODIFY — render \"Administration\" group header)\n      admin/\n        layout.tsx                                   (NEW — mounts NoCurrentYearBanner on every admin page)\n        settings/school/\n          page.tsx                                    (NEW)\n          SchoolSettingsForm.tsx                       (NEW)\n        academic-years/\n          page.tsx                                     (NEW — list)\n          AcademicYearDialog.tsx                        (NEW — create/edit)\n          [id]/\n            page.tsx                                    (NEW — detail: terms list)\n            TermDialog.tsx                                (NEW — create/edit term)\n            GenerateTermsDialog.tsx                        (NEW — semesters/trimesters/quarters)\n        grade-levels/\n          page.tsx                                       (NEW)\n          GradeLevelDialog.tsx                            (NEW)\n        subjects/\n          page.tsx                                        (NEW)\n          SubjectDialog.tsx                                (NEW)\n          subjectColors.ts                                 (NEW — 12-swatch palette constants)\n        rooms/\n          page.tsx                                         (NEW)\n          RoomDialog.tsx                                    (NEW)\n\n  components/\n    NoCurrentYearBanner/NoCurrentYearBanner.tsx          (NEW)\n\n  config/\n    navigation.ts                                        (MODIFY — add Administrat