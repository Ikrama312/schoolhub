ar has zero terms. Earlier terms get the extra day when the range doesn't divide evenly.\",\n      \"requestSchema\": { \"pattern\": \"'SEMESTERS' | 'TRIMESTERS' | 'QUARTERS'\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] },\n      \"requirementIds\": [\"FR-14\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/terms/:id\",\n      \"description\": \"Update a term's name/dates/order. Re-validates range and sibling-overlap rules.\",\n      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\", \"order\": \"int?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/terms/:id\",\n      \"description\": \"Delete a term.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n      \"requirementIds\": [\"FR-12\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/terms/reorder\",\n      \"description\": \"Persist a new term order for one academic year (drag handle or up/down buttons).\",\n      \"requestSchema\": { \"academicYearId\": \"string\", \"termIds\": \"string[]\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"order\": \"int\" } ] },\n      \"requirementIds\": [\"FR-13\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/grade-levels\",\n      \"description\": \"List grade levels ordered by `order`. ?includeArchived=true includes archived rows.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-15\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/grade-levels\",\n      \"description\": \"Create a grade level.\",\n      \"requestSchema\": { \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" } },\n      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/grade-levels/:id\",\n      \"description\": \"Update fields, reorder, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n      \"requestSchema\": { \"name\": \"string?\", \"shortName\": \"string?\", \"order\": \"int?\", \"archived\": \"boolean?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } },\n      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/subjects\",\n      \"description\": \"List subjects, searchable by name/code via ?q=.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string(hex)\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/subjects\",\n      \"description\": \"Create a subject. Code is normalised upper-case; duplicate code returns CONFLICT (409) with field error 'Code already used by <subject>.'\",\n      \"requestSchema\": { \"name\": \"string\", \"code\": \"string (2-10 chars, normalised upper-c