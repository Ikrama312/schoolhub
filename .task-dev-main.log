{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N2heqfwmWJQDSYFDY6GJTo","type":"tool_result","content":"'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface DateDisplayProps {\n  date: Date | string;\n  pattern?: string;\n  timezone: string;\n}\n\nconst DEFAULT_PATTERN = 'MMM d, yyyy h:mm a';\n\n/** Renders a UTC date formatted in the school's timezone. */\nexport function DateDisplay({ date, pattern = DEFAULT_PATTERN, timezone }: DateDisplayProps) {\n  return <span>{formatInSchoolTz(date, pattern, timezone)}</span>;\n}\n187:model SchoolSettings {\n192:  timezone     String   @default(\"UTC\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"5dbdfa6e-7bde-4dda-8db5-9221892dc859","uuid":"2dd60582-b00c-4a64-b875-f3d816d92fa7","timestamp":"2026-11-04T06:54:10.248Z","tool_use_result":{"stdout":"'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface DateDisplayProps {\n  date: Date | string;\n  pattern?: string;\n  timezone: string;\n}\n\nconst DEFAULT_PATTERN = 'MMM d, yyyy h:mm a';\n\n/** Renders a UTC date formatted in the school's timezone. */\nexport function DateDisplay({ date, pattern = DEFAULT_PATTERN, timezone }: DateDisplayProps) {\n  return <span>{formatInSchoolTz(date, pattern, timezone)}</span>;\n}\n187:model SchoolSettings {\n192:  timezone     String   @default(\"UTC\")","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01N2heqfwmWJQDSYFDY6GJTo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
