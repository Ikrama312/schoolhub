tedAt      DateTime     @default(now())\n412-  updatedAt      DateTime     @updatedAt\n413-  enrollments    Enrollment[]\n414-\n415-  @@unique([academicYearId, code])\n416-}\n417-\n418-/// DROPPED rows are kept (never deleted) so later PRDs' attendance/grades\n419-/// history stays attached (FR-12).\nimport { test, expect } from '@playwright/test';\nimport AxeBuilder from '@axe-core/playwright';\n\ntest.describe('dashboard page (/dashboard)', () => {\n  test('renders the welcome header and empty state', async ({ page }) => {\n    await page.goto('/dashboard');\n    await expect(page.getByRole('heading', { level: 1, name: /welcome to schoolhub/i })).toBeVisible();\n  });\n\n  test('has zero serious/critical accessibility violations', async ({ page }) => {\n    await page.goto('/dashboard');\n    const results = await new AxeBuilder({ page }).analyze();\n    const seriousOrCritical = results.violations.filter(\n      (v) => v.impact === 'serious' || v.impact === 'critical',\n    );\n    expect(seriousOrCritical).toEqual([]);\n  });\n});\nimport { defineConfig } from '@playwright/test';\n\nexport default defineConfig({\n  testDir: './tests/e2e',\n  fullyParallel: true,\n  reporter: 'list',\n  use: {\n    baseURL: process.env.APP_URL ?? 'http://localhost:3000',\n  },\n  webServer: {\n    command: 'npm run start',\n    url: process.env.APP_URL ?? 'http://localhost:3000',\n    reuseExistingServer: !process.env.CI,\n    timeout: 60_000,\n  },\n});","is_error":false}]},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"a3a7fdf7-a56d-4ecb-95d8-224993460a48","timestamp":"2026-10-27T16:50:10.622Z","tool_use_result":{"stdout":"  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = det