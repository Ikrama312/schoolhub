{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EmZaTrPsnay6NbFqK7FRoo","type":"tool_result","content":"1\timport { NextResponse } from 'next/server';\n2\timport { Prisma } from '@prisma/client';\n3\timport { ZodError, type ZodSchema } from 'zod';\n4\timport { logger } from '@/lib/logger';\n5\t\n6\t/**\n7\t * The one chokepoint every route handler goes through. Nothing here should\n8\t * be reimplemented per-route — new endpoints import from this module, they\n9\t * don't hand-roll envelopes, pagination clamping or error mapping.\n10\t */\n11\t\n12\texport type ApiErrorCode = 'VALIDATION_ERROR' | 'NOT_FOUND' | 'CONFLICT' | 'INTERNAL';\n13\t\n14\tconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n15\t  VALIDATION_ERROR: 400,\n16\t  NOT_FOUND: 404,\n17\t  CONFLICT: 409,\n18\t  INTERNAL: 500,\n19\t};\n20\t\n21\t/** Throw this from a handler for a known, intentional failure. */\n22\texport class AppError extends Error {\n23\t  code: ApiErrorCode;\n24\t  details?: unknown;\n25\t\n26\t  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n27\t    super(message);\n28\t    this.code = code;\n29\t    this.details = details;\n30\t  }\n31\t}\n32\t\n33\texport function ok<T>(data: T, init?: ResponseInit) {\n34\t  return NextResponse.json({ data }, init);\n35\t}\n36\t\n37\texport function paginated<T>(\n38\t  data: T[],\n39\t  meta: { page: number; pageSize: number; total: number },\n40\t  init?: ResponseInit,\n41\t) {\n42\t  return NextResponse.json({ data, meta }, init);\n43\t}\n44\t\n45\texport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n46\t  return NextResponse.json(\n47\t    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n48\t    { status: ERROR_STATUS[code] },\n49\t  );\n50\t}\n51\t\n52\t/**\n53\t * Wraps a route handler, mapping thrown errors to the shared envelope:\n54\t * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n55\t * AppError -> its own code/status\n56\t * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n57\t * anything else -> INTERNAL (500), stack logged, never returned to client\n58\t */\n59\texport function withHandler<Args extends unknown[]>(\n60\t  fn: (...args: Args) => Promise<Response>,\n61\t) {\n62\t  return async (...args: Args): Promise<Response> => {\n63\t    try {\n64\t      return await fn(...args);\n65\t    } catch (error) {\n66\t      if (error instanceof ZodError) {\n67\t        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n68\t      }\n69\t\n70\t      if (error instanceof AppError) {\n71\t        return apiError(error.code, error.message, error.details);\n72\t      }\n73\t\n74\t      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n75\t        if (error.code === 'P2002') {\n76\t          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n77\t        }\n78\t        if (error.code === 'P2025') {\n79\t          return apiError('NOT_FOUND', 'Resource not found');\n80\t        }\n81\t      }\n82\t\n83\t      logger.error('Unhandled error in route handler', {\n84\t        message: error instanceof Error ? error.message : String(error),\n85\t        stack: error instanceof Error ? error.stack : undefined,\n86\t      });\n87\t      return apiError('INTERNAL', 'Internal server error');\n88\t    }\n89\t  };\n90\t}\n91\t\n92\texport interface PaginationParams {\n93\t  page: number;\n94\t  pageSize: number;\n95\t  skip: number;\n96\t  take: number;\n97\t}\n98\t\n99\tconst MAX_PAGE_SIZE = 100;\n100\t\n101\texport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n102\t  const rawPage = Number(searchParams.get('page'));\n103\t  const rawPageSize = Number(searchParams.get('pageSize'));\n104\t\n105\t  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n106\t  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n107\t  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n108\t\n109\t  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n110\t}\n111\t\n112\texport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n113\t  const json = await request.json().catch(() => ({}));\n114\t  return schema.parse(json);\n115\t}\n116\t\n117\texport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n118\t  return schema.parse(Object.fromEntries(searchParams.entries()));\n119\t}\n120\t"}]},"parent_tool_use_id":null,"session_id":"2d7986f6-7c6d-43da-8db5-71c576fc7697","uuid":"bc601b7b-6089-467a-a4c6-5543c0b6d3de","timestamp":"2026-10-16T16:48:39.716Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/http.ts","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode = 'VALIDATION_ERROR' | 'NOT_FOUND' | 'CONFLICT' | 'INTERNAL';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\nexport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\nexport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\n","numLines":120,"startLine":1,"totalLines":120}}}
