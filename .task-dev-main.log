{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CW8dPeWPwGSZcJ46G42Qqw","type":"tool_result","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\nexport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\nexport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n}\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: input.metadata,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side role checks on write endpoints.\n *\n * PRD-01 (real auth/session) has not landed in this workspace yet, so\n * there is no session to read. This returns the same ADMIN placeholder\n * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n * and throws FORBIDDEN when that role isn't in the allowed list. Every\n * write endpoint in this PRD calls requireRole() instead of checking role\n * itself, so wiring up a real session later is a one-file change here\n * instead of touching every route.\n */\nconst PLACEHOLDER_USER = { id: 'placeholder-user', role: 'ADMIN' as Role };\n\nexport function requireRole(...roles: Role[]): { id: string; role: Role } {\n  if (!roles.includes(PLACEHOLDER_USER.role)) {\n    throw new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n  }\n  return PLACEHOLDER_USER;\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\nexport interface AccessUser {\n  id: string;\n  role: Role;\n}\n\nexport type AccessibleStudentIds = 'ALL' | string[];\n\n/**\n * FR-17: resolves which student ids `user` may see.\n * - ADMIN: \"ALL\" (every student)\n * - STUDENT: only themselves\n * - PARENT: students linked via ParentStudentLink (component 6)\n * - TEACHER: [] until PRD-05 adds section/course relations -- this function\n *   is the one place PRD-05 extends, per FR-17's own contract.\n */\nexport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n  switch (user.role) {\n    case 'ADMIN':\n      return 'ALL';\n    case 'STUDENT':\n      return [user.id];\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({\n        where: { parentId: user.id },\n        select: { studentId: true },\n      });\n      return links.map((link) => link.studentId);\n    }\n    case 'TEACHER':\n    default:\n      return [];\n  }\n}\n\n/**\n * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n * not allowed to see this particular studentId -- NOT_FOUND rather than\n * FORBIDDEN so existence of another family's student is never revealed.\n * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN, and TEACHER is denied everything until PRD-05).\n */\nexport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n  const accessible = await getAccessibleStudentIds(user);\n\n  if (accessible === 'ALL') return;\n\n  if (accessible.includes(studentId)) return;\n\n  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n    throw new AppError('NOT_FOUND', 'Resource not found');\n  }\n\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n}\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\nimport type { Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Extension point for the (future) student detail page. Empty until a later\n * PRD registers a tab — this PRD only establishes the contract.\n */\nexport const studentTabs: StudentTab[] = [];","is_error":false}]},"parent_tool_use_id":null,"session_id":"020b7a6e-6236-4f8d-a760-9a7fb50fdcce","uuid":"80a898f7-da38-4559-8d2e-910df002de7d","timestamp":"2026-10-27T16:37:24.234Z","tool_use_result":{"stdout":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function