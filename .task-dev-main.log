ls + @typescript-eslint/recommended) and Prettier configs, base next.config.js.\",\n      \"files\": [\"package.json\", \"tsconfig.json\", \".eslintrc.json\", \".prettierrc.json\", \"next.config.js\"],\n      \"dependencies\": [],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\"FR-1\", \"FR-2\", \"FR-3\", \"NFR-7\", \"NFR-8\"]\n    },\n    {\n      \"id\": \"TASK-2\",\n      \"description\": \"Local Postgres 16 via docker-compose, .env.example covering every required var, and Zod-validated env.ts fail-fast startup boundary.\",\n      \"files\": [\"docker-compose.yml\", \".env.example\", \"src/lib/env.ts\"],\n      \"dependencies\": [\"TASK-1\"],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\"FR-4\", \"FR-5\", \"FR-6\", \"NFR-7\"]\n    },\n    {\n      \"id\": \"TASK-3\",\n      \"description\": \"Prisma client singleton cached on globalThis to survive dev hot-reload, plus the structured logger (JSON in prod, readable in dev) consumed by withHandler's INTERNAL branch.\",\n      \"files\": [\"src/server/db.ts\", \"src/lib/logger.ts\"],\n      \"dependencies\": [\"TASK-2\"],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\"FR-8\", \"FR-40\"]\n    },\n    {\n      \"id\": \"TASK-4\",\n      \"description\": \"Prisma schema defining the singleton SchoolSettings model, plus an idempotent (upsert-based) seed script.\",\n      \"files\": [\"prisma/schema.prisma\", \"prisma/seed.ts\"],\n      \"dependencies\": [\"TASK-3\"],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\"FR-7\", \"FR-9\"]\n    },\n    {\n      \"id\": \"TASK-5\",\n      \"description\": \"Centralized API helpers: ok(), paginated(), apiError() with status-code table, withHandler() error-boundary mapping (ZodError/AppError/Prisma P2002/P2025/else), parsePagination(), parseBody()/parseQuery(). The one chokepoint every route must go through.\",\n      \"files\": [\"src/server/http.ts\"],\n      \"dependencies\": [\"TASK-3\"],\n      \"estimateHours\": 4,\n      \"requirementIds\": [\"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\"]\n    },\n    {\n      \"id\": \"TASK-6\",\n      \"description\": \"GET /api/health route handler: SELECT 1 against Prisma with a 2000ms budget, wrapped in withHandler, returning the ok()/apiError() envelope.\",\n      \"files\": [\"src/app/api/health/route.ts\"],\n      \"dependencies\": [\"TASK-3\", \"TASK-5\"],\n      \"estimateHours\": 1,\n      \"requirementIds\": [\"FR-16\"]\n    },\n    {\n      \"id\": \"TASK-7\",\n      \"description\": \"MUI v9 theme (cssVariables, light/dark colorSchemes) and the root layout provider tree (AppRouterCacheProvider -> ThemeProvider -> CssBaseline -> LocalizationProvider, InitColorSchemeScript) that every page inherits server-rendered, no client flash.\",\n      \"files\": [\"src/theme/theme.ts\", \"src/app/layout.tsx\"],\n      \"dependencies\": [\"TASK-1\"],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"NFR-2\"]\n    },\n    {\n      \"id\": \"TASK-8\",\n      \"description\": \"Shared PageHeader (title/description/breadcrumbs/actions slot) and EmptyState (icon/title/description/action) components.\",\n      \"files\": [\"src/components/PageHeader/PageHeader.tsx\", \"src/components/EmptyState/EmptyState.tsx\"],\n      \"dependencies\": [\"TASK-7\"],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\"FR-20\", \"FR-22\"]\n    },\n    {\n      \"id\": \"TASK-9\",\n      \"description\": \"Shared DataTable wrapping MUI X DataGrid with server-side pagination/sorting reading rowCount/total from the paginated() envelope, debounced search, empty/loading states, URL-synced query params.\",\n      \"files\": [\"src/components/DataTable/DataTable.tsx\"],\n      \"dependencies\": [\"TASK-7\"],\n      \"estimateHours\": 4,\n      \"requirementIds\": [\"FR-21\"]\n    },\n    {\n      \"id\": \"TASK-10\",\n      \"description\": \"Shared ConfirmDialog (destructive variant, async onConfirm with pending spinner) and the useToast()/ToastProvider pair (single queued Snackbar+Alert, 5s auto-hide).\",\n      \"files\": [\"src/components/ConfirmDialog/ConfirmDialog.tsx\", \"src/components/Toast/ToastProvider.tsx\", \"src/components/Toast/useToast.ts\"],\n      \"dependencies\": [\"TASK-7\"],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\"FR-23\", \"FR-24\"]\n    },\n    {\n      \"id\": \"TASK-11\",\n      \"description\": \"Shared FormField helpers binding React Hook Form Controller to MUI TextField/Select/Autocomplete/Checkbox/Switch/RadioGroup/DatePicker-DateTimePicker, wiring label/helperText/error.\",\n      \"files\": [\"src/components/FormField/FormField.tsx\"],\n      \"dependencies\": [\"TASK-7\"],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\"FR-25\"]\n    },\n    {\n      \"id\": \"TASK-12\",\n      \"description\": \"Shared StatCard (label/value/delta chip/icon) and UserAvatar (initials on deterministic colour from user id) components.\",\n      \"files\": [\"src/components/StatCard/StatCard.tsx\", \"src/components/UserAvatar/UserAvatar.tsx\"],\n      \"dependencies\": [\"TASK-7\"],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\"FR-26\", \"FR-27\"]\n    },\n    {\n      \"id\": \"TASK-13\",\n      \"description\": \"formatInSchoolTz(date, pattern) util plus the shared DateDisplay component that renders a UTC date in the school timezone.\",\n      \"files\": [\"src/lib/dates.ts\", \"src/components/DateDisplay/DateDisplay.tsx\"],\n      \"dependencies\": [\"TASK-7\"],\n      \"estimateHours\": 2,\n      \"requirementIds\": [\"FR-28\"]\n    },\n    {\n      \"id\": \"TASK-14\",\n      \"description\": \"Shared LoadingSkeleton component with table/card/form MUI Skeleton variants.\",\n      \"files\": [\"src/components/LoadingSkeleton/LoadingSkeleton.tsx\"],\n      \"dependencies\": [\"TASK-7\"],\n      \"estimateHours\": 1,\n      \"requirementIds\": [\"FR-29\"]\n    },\n    {\n      \"id\": \"TASK-15\",\n      \"description\": \"Authenticat