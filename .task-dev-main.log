{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RK1WBZnHadKk1o3YYPbrbY","type":"tool_result","content":"1\timport { z } from 'zod';\n2\t\n3\t/**\n4\t * Fail-fast env validation. Runs once at module load (startup boundary) —\n5\t * anything importing this module gets a readable error naming every\n6\t * missing/invalid variable instead of an undefined-at-runtime surprise.\n7\t */\n8\tconst envSchema = z.object({\n9\t  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n10\t  APP_URL: z.string().min(1, 'APP_URL is required'),\n11\t  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n12\t  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n13\t});\n14\t\n15\tfunction loadEnv() {\n16\t  const parsed = envSchema.safeParse(process.env);\n17\t  if (!parsed.success) {\n18\t    const issues = parsed.error.issues\n19\t      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n20\t      .join('\\n');\n21\t    throw new Error(`Invalid environment variables:\\n${issues}`);\n22\t  }\n23\t  return parsed.data;\n24\t}\n25\t\n26\texport const env = loadEnv();\n27\texport type Env = z.infer<typeof envSchema>;\n28\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"2977597c-bf8f-4ff2-b802-6b362e2dcfe8","timestamp":"2026-10-20T06:17:26.750Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/lib/env.ts","content":"import { z } from 'zod';\n\n/**\n * Fail-fast env validation. Runs once at module load (startup boundary) —\n * anything importing this module gets a readable error naming every\n * missing/invalid variable instead of an undefined-at-runtime surprise.\n */\nconst envSchema = z.object({\n  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n  APP_URL: z.string().min(1, 'APP_URL is required'),\n  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n});\n\nfunction loadEnv() {\n  const parsed = envSchema.safeParse(process.env);\n  if (!parsed.success) {\n    const issues = parsed.error.issues\n      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n      .join('\\n');\n    throw new Error(`Invalid environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\nexport const env = loadEnv();\nexport type Env = z.infer<typeof envSchema>;\n","numLines":28,"startLine":1,"totalLines":28}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JKVdSy2BykzsTzbp8PxVHe","type":"tool_result","content":"1\t# Postgres connection string used by Prisma. Matches docker-compose.yml's\n2\t# schoolhub/schoolhub/schoolhub db/user/password on localhost:5432.\n3\tDATABASE_URL=\"postgresql://schoolhub:schoolhub@localhost:5432/schoolhub?schema=public\"\n4\t\n5\t# Public base URL of the app (used for absolute links, e.g. in emails later).\n6\tAPP_URL=\"http://localhost:3000\"\n7\t\n8\t# Secret used to sign auth sessions (wired up by a later PRD). Generate with\n9\t# `openssl rand -base64 32` for real environments.\n10\tAUTH_SECRET=\"dev-secret-change-me\"\n11\t\n12\t# Standard Node environment flag. One of: development | test | production.\n13\tNODE_ENV=\"development\"\n14\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"7d2eca65-c823-4805-8d21-f3b366aae6cd","timestamp":"2026-10-20T06:17:26.751Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/.env.example","content":"# Postgres connection string used by Prisma. Matches docker-compose.yml's\n# schoolhub/schoolhub/schoolhub db/user/password on localhost:5432.\nDATABASE_URL=\"postgresql://schoolhub:schoolhub@localhost:5432/schoolhub?schema=public\"\n\n# Public base URL of the app (used for absolute links, e.g. in emails later).\nAPP_URL=\"http://localhost:3000\"\n\n# Secret used to sign auth sessions (wired up by a later PRD). Generate with\n# `openssl rand -base64 32` for real environments.\nAUTH_SECRET=\"dev-secret-change-me\"\n\n# Standard Node environment flag. One of: development | test | production.\nNODE_ENV=\"development\"\n","numLines":14,"startLine":1,"totalLines":14}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J6p3t2pipVSvcRYZwwz5hH","type":"tool_result","content":"1\timport { PrismaClient } from '@prisma/client';\n2\t\n3\t/**\n4\t * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n5\t * re-evaluates this module on every edit; without the cache that creates a\n6\t * new PrismaClient (and a new Postgres connection pool) each time until the\n7\t * db runs out of connections. Standard Next.js + Prisma pattern.\n8\t */\n9\tconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n10\t\n11\texport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n12\t\n13\tif (process.env.NODE_ENV !== 'production') {\n14\t  globalForPrisma.prisma = prisma;\n15\t}\n16\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"fcda4e42-5c75-4208-9659-9ad62a06a563","timestamp":"2026-10-20T06:17:26.753Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/db.ts","content":"import { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\n","numLines":16,"startLine":1,"totalLines":16}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011QqLBZq3ZgUtgiEGsCeiTW","type":"tool_result","content":"1\timport type { ComponentType } from 'react';\n2\timport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\n3\t\n4\texport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n5\t\n6\texport interface NavItem {\n7\t  label: string;\n8\t  href: string;\n9\t  icon: ComponentType;\n10\t  roles: Role[];\n11\t}\n12\t\n13\tconst ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n14\t\n15\t/**\n16\t * Sidebar source of truth. A later PRD that adds a page adds its entry here\n17\t * instead of hard-coding links in the shell.\n18\t */\n19\texport const navigation: NavItem[] = [\n20\t  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n21\t];\n22\t\n23\texport function navigationForRole(role: Role): NavItem[] {\n24\t  return navigation.filter((item) => item.roles.includes(role));\n25\t}\n26\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"cb2eb4b7-433f-46f0-88d4-948d97790fc7","timestamp":"2026-10-20T06:17:26.754Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/config/navigation.ts","content":"import type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n}\n\nconst ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\n","numLines":26,"startLine":1,"totalLines":26}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011kfBv6s77xtixDR94D4132","type":"tool_result","content":"1\timport type { Prisma, Role, UserStatus } from '@prisma/client';\n2\timport { prisma } from '@/server/db';\n3\timport { AppError } from '@/server/http';\n4\timport { logger } from '@/lib/logger';\n5\timport { linkParentToStudentTx } from '@/server/services/userLinks';\n6\timport {\n7\t  studentProfileSchema,\n8\t  teacherProfileSchema,\n9\t  parentProfileSchema,\n10\t  type CreateUserInput,\n11\t  type UpdateUserInput,\n12\t} from '@/lib/validators/users';\n13\t\n14\ttype TxClient = Prisma.TransactionClient;\n15\t\n16\t/**\n17\t * Core user service (component 2, FR-1..FR-14/FR-31). Every write endpoint\n18\t * under /api/users and /api/me goes through here instead of touching\n19\t * prisma.user directly, so the role-immutability, self/last-admin and\n20\t * admission/employee-number invariants live in exactly one place.\n21\t */\n22\t\n23\t// ---- number generators (FR-1) ----\n24\t// ponytail: zero-padded(4) string ordering breaks past 9999 of either kind\n25\t// in one year/ever; widen the pad or switch to a sequence table if a school\n26\t// actually enrolls that many students/teachers.\n27\t\n28\tasync function generateAdmissionNumber(tx: TxClient): Promise<string> {\n29\t  const prefix = `S${new Date().getUTCFullYear()}-`;\n30\t  const last = await tx.studentProfile.findFirst({\n31\t    where: { admissionNumber: { startsWith: prefix } },\n32\t    orderBy: { admissionNumber: 'desc' },\n33\t  });\n34\t  const next = last ? parseInt(last.admissionNumber.slice(prefix.length), 10) + 1 : 1;\n35\t  return `${prefix}${String(next).padStart(4, '0')}`;\n36\t}\n37\t\n38\tasync function generateEmployeeNumber(tx: TxClient): Promise<string> {\n39\t  const prefix = 'T-';\n40\t  const last = await tx.teacherProfile.findFirst({\n41\t    where: { employeeNumber: { startsWith: prefix } },\n42\t    orderBy: { employeeNumber: 'desc' },\n43\t  });\n44\t  const next = last ? parseInt(last.employeeNumber.slice(prefix.length), 10) + 1 : 1;\n45\t  return `${prefix}${String(next).padStart(4, '0')}`;\n46\t}\n47\t\n48\t// ---- shared read shaping ----\n49\t\n50\tconst detailInclude = {\n51\t  studentProfile: { include: { gradeLevel: true } },\n52\t  teacherProfile: true,\n53\t  parentProfile: true,\n54\t} satisfies Prisma.UserInclude;\n55\t\n56\ttype UserWithProfile = Prisma.UserGetPayload<{ include: typeof detailInclude }>;\n57\t\n58\tfunction buildProfile(user: UserWithProfile): Record<string, unknown> | null {\n59\t  if (user.role === 'STUDENT' && user.studentProfile) {\n60\t    const { userId: _userId, gradeLevel, ...rest } = user.studentProfile;\n61\t    return { ...rest, gradeLevelName: gradeLevel?.name ?? null };\n62\t  }\n63\t  if (user.role === 'TEACHER' && user.teacherProfile) {\n64\t    const { userId: _userId, ...rest } = user.teacherProfile;\n65\t    return rest;\n66\t  }\n67\t  if (user.role === 'PARENT' && user.parentProfile) {\n68\t    const { userId: _userId, ...rest } = user.parentProfile;\n69\t    return rest;\n70\t  }\n71\t  return null;\n72\t}\n73\t\n74\tfunction toUserDto(user: UserWithProfile) {\n75\t  return {\n76\t    id: user.id,\n77\t    firstName: user.firstName,\n78\t    lastName: user.lastName,\n79\t    email: user.email,\n80\t    role: user.role,\n81\t    status: user.status,\n82\t    phone: user.phone,\n83\t    profile: buildProfile(user),\n84\t  };\n85\t}\n86\t\n87\tasync function getUserWithProfile(tx: TxClient | typeof prisma, id: string) {\n88\t  const user = await tx.user.findUnique({ where: { id }, include: detailInclude });\n89\t  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n90\t  return toUserDto(user);\n91\t}\n92\t\n93\tfunction pick<T extends object>(obj: T, keys: (keyof T)[]): Partial<T> {\n94\t  const out: Partial<T> = {};\n95\t  for (const key of keys) {\n96\t    if (obj[key] !== undefined) out[key] = obj[key];\n97\t  }\n98\t  return out;\n99\t}\n100\t\n101\tconst STUDENT_PROFILE_KEYS = [\n102\t  'dateOfBirth',\n103\t  'gender',\n104\t  'gradeLevelId',\n105\t  'enrollmentDate',\n106\t  'addressLine1',\n107\t  'city',\n108\t  'medicalNotes',\n109\t  'emergencyContact',\n110\t  'emergencyPhone',\n111\t] as const;\n112\tconst TEACHER_PROFILE_KEYS = ['title', 'qualifications', 'hireDate'] as const;\n113\tconst PARENT_PROFILE_KEYS = ['occupation', 'address'] as const;\n114\t\n115\t// ---- create / update (FR-1, FR-6..FR-10, FR-15, FR-16) ----\n116\t\n117\texport async function createUser(input: CreateUserInput) {\n118\t  const userId = await prisma.$transaction(async (tx) => {\n119\t    const user = await tx.user.create({\n120\t      data: {\n121\t        firstName: input.firstName,\n122\t        lastName: input.lastName,\n123\t        email: input.email,\n124\t        phone: input.phone,\n125\t        role: input.role,\n126\t        status: 'INVITED',\n127\t      },\n128\t    });\n129\t\n130\t    if (input.role === 'STUDENT') {\n131\t      const profile = studentProfileSchema.parse(input.profile ?? {});\n132\t      const admissionNumber = await generateAdmissionNumber(tx);\n133\t      await tx.studentProfile.create({ data: { userId: user.id, admissionNumber, ...profile } });\n134\t    } else if (input.role === 'TEACHER') {\n135\t      const profile = teacherProfileSchema.parse(input.profile ?? {});\n136\t      const employeeNumber = await generateEmployeeNumber(tx);\n137\t      await tx.teacherProfile.create({ data: { userId: user.id, employeeNumber, ...profile } });\n138\t    } else if (input.role === 'PARENT') {\n139\t      const profile = parentProfileSchema.parse(input.profile ?? {});\n140\t      await tx.parentProfile.create({ data: { userId: user.id, ...profile } });\n141\t    }\n142\t\n143\t    for (const link of input.links ?? []) {\n144\t      if (input.role === 'STUDENT') {\n145\t        await linkParentToStudentTx(tx, {\n146\t          studentId: user.id,\n147\t          parentId: link.linkedUserId,\n148\t          relationship: link.relationship,\n149\t          isPrimary: link.isPrimary,\n150\t        });\n151\t      } else if (input.role === 'PARENT') {\n152\t        await linkParentToStudentTx(tx, {\n153\t          studentId: link.linkedUserId,\n154\t          parentId: user.id,\n155\t          relationship: link.relationship,\n156\t          isPrimary: link.isPrimary,\n157\t        });\n158\t      }\n159\t    }\n160\t\n161\t    return user.id;\n162\t  });\n163\t\n164\t  if (input.sendInvite) {\n165\t    await sendInvite(userId);\n166\t  }\n167\t\n168\t  return getUserWithProfile(prisma, userId);\n169\t}\n170\t\n171\texport async function updateUser(id: string, input: UpdateUserInput) {\n172\t  return prisma.$transaction(async (tx) => {\n173\t    const existing = await tx.user.findUniqueOrThrow({ where: { id } });\n174\t    const emailChanged = input.email !== undefined && input.email !== existing.email;\n175\t\n176\t    await tx.user.update({\n177\t      where: { id },\n178\t      data: {\n179\t        firstName: input.firstName,\n180\t        lastName: input.lastName,\n181\t        email: input.email,\n182\t        phone: input.phone,\n183\t      },\n184\t    });\n185\t\n186\t    if (input.profile) {\n187\t      if (existing.role === 'STUDENT') {\n188\t        const data = pick(input.profile, STUDENT_PROFILE_KEYS);\n189\t        if (Object.keys(data).length > 0) {\n190\t          await tx.studentProfile.update({ where: { userId: id }, data });\n191\t        }\n192\t      } else if (existing.role === 'TEACHER') {\n193\t        const data = pick(input.profile, TEACHER_PROFILE_KEYS);\n194\t        if (Object.keys(data).length > 0) {\n195\t          await tx.teacherProfile.update({ where: { userId: id }, data });\n196\t        }\n197\t      } else if (existing.role === 'PARENT') {\n198\t        const data = pick(input.profile, PARENT_PROFILE_KEYS);\n199\t        if (Object.keys(data).length > 0) {\n200\t          await tx.parentProfile.update({ where: { userId: id }, data });\n201\t        }\n202\t      }\n203\t    }\n204\t\n205\t    if (emailChanged) {\n206\t      // FR-8: a stale invite link must not activate the old address.\n207\t      await tx.authToken.updateMany({\n208\t        where: { userId: id, type: 'INVITE', usedAt: null },\n209\t        data: { usedAt: new Date() },\n210\t      });\n211\t    }\n212\t\n213\t    return getUserWithProfile(tx, id);\n214\t  });\n215\t}\n216\t\n217\t// ---- list / detail (FR-2, FR-3, FR-11, NFR-2) ----\n218\t\n219\texport interface ListUsersFilters {\n220\t  role?: Role[];\n221\t  status?: UserStatus;\n222\t  gradeLevelId?: string;\n223\t  q?: string;\n224\t  includeArchived?: boolean;\n225\t}\n226\t\n227\tfunction searchClauses(q: string): Prisma.UserWhereInput[] {\n228\t  return [\n229\t    { firstName: { contains: q, mode: 'insensitive' } },\n230\t    { lastName: { contains: q, mode: 'insensitive' } },\n231\t    { email: { contains: q, mode: 'insensitive' } },\n232\t    { studentProfile: { admissionNumber: { contains: q, mode: 'insensitive' } } },\n233\t    { teacherProfile: { employeeNumber: { contains: q, mode: 'insensitive' } } },\n234\t  ];\n235\t}\n236\t\n237\texport async function listUsers(filters: ListUsersFilters, pagination: { skip: number; take: number }) {\n238\t  const where: Prisma.UserWhereInput = {\n239\t    ...(filters.role && filters.role.length > 0 ? { role: { in: filters.role } } : {}),\n240\t    ...(filters.status ? { status: filters.status } : {}),\n241\t    ...(filters.includeArchived ? {} : { archivedAt: null }),\n242\t    ...(filters.gradeLevelId ? { studentProfile: { gradeLevelId: filters.gradeLevelId } } : {}),\n243\t    ...(filters.q ? { OR: searchClauses(filters.q) } : {}),\n244\t  };\n245\t\n246\t  // Ordered by (lastName, firstName) to use the composite index (NFR-2).\n247\t  const [rows, total] = await Promise.all([\n248\t    prisma.user.findMany({\n249\t      where,\n250\t      include: { studentProfile: { include: { gradeLevel: true } } },\n251\t      orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }],\n252\t      skip: pagination.skip,\n253\t      take: pagination.take,\n254\t    }),\n255\t    prisma.user.count({ where }),\n256\t  ]);\n257\t\n258\t  return {\n259\t    rows: rows.map((row) => ({\n260\t      id: row.id,\n261\t      firstName: row.firstName,\n262\t      lastName: row.lastName,\n263\t      email: row.email,\n264\t      role: row.role,\n265\t      status: row.status,\n266\t      gradeLevelId: row.studentProfile?.gradeLevelId ?? null,\n267\t      gradeLevelName: row.studentProfile?.gradeLevel.name ?? null,\n268\t      lastLoginAt: row.lastLoginAt,\n269\t      lockedUntil: row.lockedUntil,\n270\t    })),\n271\t    total,\n272\t  };\n273\t}\n274\t\n275\texport async function getUserDetail(id: string) {\n276\t  const user = await prisma.user.findUnique({\n277\t    where: { id },\n278\t    include: {\n279\t      ...detailInclude,\n280\t      parentLinks: { include: { student: { select: { id: true, firstName: true, lastName: true } } } },\n281\t      studentLinks: { include: { parent: { select: { id: true, firstName: true, lastName: true } } } },\n282\t    },\n283\t  });\n284\t  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n285\t\n286\t  const familyLinks =\n287\t    user.role === 'STUDENT'\n288\t      ? user.studentLinks.map((link) => ({\n289\t          id: link.id,\n290\t          linkedUserId: link.parentId,\n291\t          linkedUserName: `${link.parent.firstName} ${link.parent.lastName}`,\n292\t          relationship: link.relationship,\n293\t          isPrimary: link.isPrimary,\n294\t        }))\n295\t      : user.role === 'PARENT'\n296\t        ? user.parentLinks.map((link) => ({\n297\t            id: link.id,\n298\t            linkedUserId: link.studentId,\n299\t            linkedUserName: `${link.student.firstName} ${link.student.lastName}`,\n300\t            relationship: link.relationship,\n301\t            isPrimary: link.isPrimary,\n302\t          }))\n303\t        : [];\n304\t\n305\t  const recentAuditLogs = await prisma.auditLog.findMany({\n306\t    where: { OR: [{ actorId: id }, { entityId: id }] },\n307\t    orderBy: { createdAt: 'desc' },\n308\t    take: 20,\n309\t  });\n310\t\n311\t  return {\n312\t    ...toUserDto(user),\n313\t    lastLoginAt: user.lastLoginAt,\n314\t    familyLinks,\n315\t    recentAuditLogs: recentAuditLogs.map((log) => ({\n316\t      id: log.id,\n317\t      action: log.action,\n318\t      actorId: log.actorId,\n319\t      entityType: log.entityType,\n320\t      entityId: log.entityId,\n321\t      createdAt: log.createdAt,\n322\t    })),\n323\t  };\n324\t}\n325\t\n326\t// ---- status / archive / unlock (FR-12, FR-13, FR-14, FR-31) ----\n327\t\n328\t/** Self-disable and last-active-admin guards shared by setUserStatus/archiveUser. */\n329\tasync function assertNotSelfOrLastAdmin(tx: TxClient, actorId: string, userId: string) {\n330\t  if (actorId === userId) {\n331\t    throw new AppError('VALIDATION_ERROR', 'You cannot disable your own account.');\n332\t  }\n333\t  const target = await tx.user.findUniqueOrThrow({ where: { id: userId } });\n334\t  if (target.role === 'ADMIN') {\n335\t    const activeAdmins = await tx.user.count({\n336\t      where: { role: 'ADMIN', status: 'ACTIVE', archivedAt: null, id: { not: userId } },\n337\t    });\n338\t    if (activeAdmins === 0) {\n339\t      throw new AppError('VALIDATION_ERROR', 'At least one active admin is required.');\n340\t    }\n341\t  }\n342\t}\n343\t\n344\texport async function setUserStatus(actorId: string, userId: string, status: 'ACTIVE' | 'DISABLED') {\n345\t  return prisma.$transaction(async (tx) => {\n346\t    if (status === 'DISABLED') {\n347\t      await assertNotSelfOrLastAdmin(tx, actorId, userId);\n348\t    }\n349\t    return tx.user.update({ where: { id: userId }, data: { status }, select: { id: true, status: true } });\n350\t  });\n351\t}\n352\t\n353\texport async function archiveUser(actorId: string, userId: string) {\n354\t  return prisma.$transaction(async (tx) => {\n355\t    await assertNotSelfOrLastAdmin(tx, actorId, userId);\n356\t    return tx.user.update({\n357\t      where: { id: userId },\n358\t      data: { status: 'DISABLED', archivedAt: new Date() },\n359\t      select: { id: true, status: true, archivedAt: true },\n360\t    });\n361\t  });\n362\t}\n363\t\n364\texport async function restoreUser(userId: string) {\n365\t  return prisma.user.update({\n366\t    where: { id: userId },\n367\t    data: { archivedAt: null },\n368\t    select: { id: true, status: true, archivedAt: true },\n369\t  });\n370\t}\n371\t\n372\t/** FR-31: clears exactly the two lockout fields that exist in the schema today. */\n373\texport async function unlockUser(userId: string) {\n374\t  return prisma.user.update({\n375\t    where: { id: userId },\n376\t    data: { lockedUntil: null, failedLoginCount: 0 },\n377\t    select: { id: true, lockedUntil: true, failedLoginCount: true },\n378\t  });\n379\t}\n380\t\n381\t/**\n382\t * FR-7/FR-12 sequencing dependency (see system-design.md Overview/Component\n383\t * 20): PRD-01's real auth/session has not landed, so this is a stubbed\n384\t * no-op behind the same placeholder convention requireRole.ts establishes.\n385\t * Call sites (POST /api/users/:id/invite, createUser's sendInvite checkbox)\n386\t * do not change when PRD-01 lands and makes this real.\n387\t */\n388\texport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n389\t  logger.info('sendInvite stub called (PRD-01 auth not landed yet)', { userId });\n390\t  return { id: userId, inviteSentAt: new Date() };\n391\t}\n392\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"dd1fd2be-9d97-4ecc-9865-998a3433a816","timestamp":"2026-10-20T06:17:26.755Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/services/users.ts","content":"import type { Prisma, Role, UserStatus } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { logger } from '@/lib/logger';\nimport { linkParentToStudentTx } from '@/server/services/userLinks';\nimport {\n  studentProfileSchema,\n  teacherProfileSchema,\n  parentProfileSchema,\n  type CreateUserInput,\n  type UpdateUserInput,\n} from '@/lib/validators/users';\n\ntype TxClient = Prisma.TransactionClient;\n\n/**\n * Core user service (component 2, FR-1..FR-14/FR-31). Every write endpoint\n * under /api/users and /api/me goes through here instead of touching\n * prisma.user directly, so the role-immutability, self/last-admin and\n * admission/employee-number invariants live in exactly one place.\n */\n\n// ---- number generators (FR-1) ----\n// ponytail: zero-padded(4) string ordering breaks past 9999 of either kind\n// in one year/ever; widen the pad or switch to a sequence table if a school\n// actually enrolls that many students/teachers.\n\nasync function generateAdmissionNumber(tx: TxClient): Promise<string> {\n  const prefix = `S${new Date().getUTCFullYear()}-`;\n  const last = await tx.studentProfile.findFirst({\n    where: { admissionNumber: { startsWith: prefix } },\n    orderBy: { admissionNumber: 'desc' },\n  });\n  const next = last ? parseInt(last.admissionNumber.slice(prefix.length), 10) + 1 : 1;\n  return `${prefix}${String(next).padStart(4, '0')}`;\n}\n\nasync function generateEmployeeNumber(tx: TxClient): Promise<string> {\n  const prefix = 'T-';\n  const last = await tx.teacherProfile.findFirst({\n    where: { employeeNumber: { startsWith: prefix } },\n    orderBy: { employeeNumber: 'desc' },\n  });\n  const next = last ? parseInt(last.employeeNumber.slice(prefix.length), 10) + 1 : 1;\n  return `${prefix}${String(next).padStart(4, '0')}`;\n}\n\n// ---- shared read shaping ----\n\nconst detailInclude = {\n  studentProfile: { include: { gradeLevel: true } },\n  teacherProfile: true,\n  parentProfile: true,\n} satisfies Prisma.UserInclude;\n\ntype UserWithProfile = Prisma.UserGetPayload<{ include: typeof detailInclude }>;\n\nfunction buildProfile(user: UserWithProfile): Record<string, unknown> | null {\n  if (user.role === 'STUDENT' && user.studentProfile) {\n    const { userId: _userId, gradeLevel, ...rest } = user.studentProfile;\n    return { ...rest, gradeLevelName: gradeLevel?.name ?? null };\n  }\n  if (user.role === 'TEACHER' && user.teacherProfile) {\n    const { userId: _userId, ...rest } = user.teacherProfile;\n    return rest;\n  }\n  if (user.role === 'PARENT' && user.parentProfile) {\n    const { userId: _userId, ...rest } = user.parentProfile;\n    return rest;\n  }\n  return null;\n}\n\nfunction toUserDto(user: UserWithProfile) {\n  return {\n    id: user.id,\n    firstName: user.firstName,\n    lastName: user.lastName,\n    email: user.email,\n    role: user.role,\n    status: user.status,\n    phone: user.phone,\n    profile: buildProfile(user),\n  };\n}\n\nasync function getUserWithProfile(tx: TxClient | typeof prisma, id: string) {\n  const user = await tx.user.findUnique({ where: { id }, include: detailInclude });\n  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n  return toUserDto(user);\n}\n\nfunction pick<T extends object>(obj: T, keys: (keyof T)[]): Partial<T> {\n  const out: Partial<T> = {};\n  for (const key of keys) {\n    if (obj[key] !== undefined) out[key] = obj[key];\n  }\n  return out;\n}\n\nconst STUDENT_PROFILE_KEYS = [\n  'dateOfBirth',\n  'gender',\n  'gradeLevelId',\n  'enrollmentDate',\n  'addressLine1',\n  'city',\n  'medicalNotes',\n  'emergencyContact',\n  'emergencyPhone',\n] as const;\nconst TEACHER_PROFILE_KEYS = ['title', 'qualifications', 'hireDate'] as const;\nconst PARENT_PROFILE_KEYS = ['occupation', 'address'] as const;\n\n// ---- create / update (FR-1, FR-6..FR-10, FR-15, FR-16) ----\n\nexport async function createUser(input: CreateUserInput) {\n  const userId = await prisma.$transaction(async (tx) => {\n    const user = await tx.user.create({\n      data: {\n        firstName: input.firstName,\n        lastName: input.lastName,\n        email: input.email,\n        phone: input.phone,\n        role: input.role,\n        status: 'INVITED',\n      },\n    });\n\n    if (input.role === 'STUDENT') {\n      const profile = studentProfileSchema.parse(input.profile ?? {});\n      const admissionNumber = await generateAdmissionNumber(tx);\n      await tx.studentProfile.create({ data: { userId: user.id, admissionNumber, ...profile } });\n    } else if (input.role === 'TEACHER') {\n      const profile = teacherProfileSchema.parse(input.profile ?? {});\n      const employeeNumber = await generateEmployeeNumber(tx);\n      await tx.teacherProfile.create({ data: { userId: user.id, employeeNumber, ...profile } });\n    } else if (input.role === 'PARENT') {\n      const profile = parentProfileSchema.parse(input.profile ?? {});\n      await tx.parentProfile.create({ data: { userId: user.id, ...profile } });\n    }\n\n    for (const link of input.links ?? []) {\n      if (input.role === 'STUDENT') {\n        await linkParentToStudentTx(tx, {\n          studentId: user.id,\n          parentId: link.linkedUserId,\n          relationship: link.relationship,\n          isPrimary: link.isPrimary,\n        });\n      } else if (input.role === 'PARENT') {\n        await linkParentToStudentTx(tx, {\n          studentId: link.linkedUserId,\n          parentId: user.id,\n          relationship: link.relationship,\n          isPrimary: link.isPrimary,\n        });\n      }\n    }\n\n    return user.id;\n  });\n\n  if (input.sendInvite) {\n    await sendInvite(userId);\n  }\n\n  return getUserWithProfile(prisma, userId);\n}\n\nexport async function updateUser(id: string, input: UpdateUserInput) {\n  return prisma.$transaction(async (tx) => {\n    const existing = await tx.user.findUniqueOrThrow({ where: { id } });\n    const emailChanged = input.email !== undefined && input.email !== existing.email;\n\n    await tx.user.update({\n      where: { id },\n      data: {\n        firstName: input.firstName,\n        lastName: input.lastName,\n        email: input.email,\n        phone: input.phone,\n      },\n    });\n\n    if (input.profile) {\n      if (existing.role === 'STUDENT') {\n        const data = pick(input.profile, STUDENT_PROFILE_KEYS);\n        if (Object.keys(data).length > 0) {\n          await tx.studentProfile.update({ where: { userId: id }, data });\n        }\n      } else if (existing.role === 'TEACHER') {\n        const data = pick(input.profile, TEACHER_PROFILE_KEYS);\n        if (Object.keys(data).length > 0) {\n          await tx.teacherProfile.update({ where: { userId: id }, data });\n        }\n      } else if (existing.role === 'PARENT') {\n        const data = pick(input.profile, PARENT_PROFILE_KEYS);\n        if (Object.keys(data).length > 0) {\n          await tx.parentProfile.update({ where: { userId: id }, data });\n        }\n      }\n    }\n\n    if (emailChanged) {\n      // FR-8: a stale invite link must not activate the old address.\n      await tx.authToken.updateMany({\n        where: { userId: id, type: 'INVITE', usedAt: null },\n        data: { usedAt: new Date() },\n      });\n    }\n\n    return getUserWithProfile(tx, id);\n  });\n}\n\n// ---- list / detail (FR-2, FR-3, FR-11, NFR-2) ----\n\nexport interface ListUsersFilters {\n  role?: Role[];\n  status?: UserStatus;\n  gradeLevelId?: string;\n  q?: string;\n  includeArchived?: boolean;\n}\n\nfunction searchClauses(q: string): Prisma.UserWhereInput[] {\n  return [\n    { firstName: { contains: q, mode: 'insensitive' } },\n    { lastName: { contains: q, mode: 'insensitive' } },\n    { email: { contains: q, mode: 'insensitive' } },\n    { studentProfile: { admissionNumber: { contains: q, mode: 'insensitive' } } },\n    { teacherProfile: { employeeNumber: { contains: q, mode: 'insensitive' } } },\n  ];\n}\n\nexport async function listUsers(filters: ListUsersFilters, pagination: { skip: number; take: number }) {\n  const where: Prisma.UserWhereInput = {\n    ...(filters.role && filters.role.length > 0 ? { role: { in: filters.role } } : {}),\n    ...(filters.status ? { status: filters.status } : {}),\n    ...(filters.includeArchived ? {} : { archivedAt: null }),\n    ...(filters.gradeLevelId ? { studentProfile: { gradeLevelId: filters.gradeLevelId } } : {}),\n    ...(filters.q ? { OR: searchClauses(filters.q) } : {}),\n  };\n\n  // Ordered by (lastName, firstName) to use the composite index (NFR-2).\n  const [rows, total] = await Promise.all([\n    prisma.user.findMany({\n      where,\n      include: { studentProfile: { include: { gradeLevel: true } } },\n      orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }],\n      skip: pagination.skip,\n      take: pagination.take,\n    }),\n    prisma.user.count({ where }),\n  ]);\n\n  return {\n    rows: rows.map((row) => ({\n      id: row.id,\n      firstName: row.firstName,\n      lastName: row.lastName,\n      email: row.email,\n      role: row.role,\n      status: row.status,\n      gradeLevelId: row.studentProfile?.gradeLevelId ?? null,\n      gradeLevelName: row.studentProfile?.gradeLevel.name ?? null,\n      lastLoginAt: row.lastLoginAt,\n      lockedUntil: row.lockedUntil,\n    })),\n    total,\n  };\n}\n\nexport async function getUserDetail(id: string) {\n  const user = await prisma.user.findUnique({\n    where: { id },\n    include: {\n      ...detailInclude,\n      parentLinks: { include: { student: { select: { id: true, firstName: true, lastName: true } } } },\n      studentLinks: { include: { parent: { select: { id: true, firstName: true, lastName: true } } } },\n    },\n  });\n  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n\n  const familyLinks =\n    user.role === 'STUDENT'\n      ? user.studentLinks.map((link) => ({\n          id: link.id,\n          linkedUserId: link.parentId,\n          linkedUserName: `${link.parent.firstName} ${link.parent.lastName}`,\n          relationship: link.relationship,\n          isPrimary: link.isPrimary,\n        }))\n      : user.role === 'PARENT'\n        ? user.parentLinks.map((link) => ({\n            id: link.id,\n            linkedUserId: link.studentId,\n            linkedUserName: `${link.student.firstName} ${link.student.lastName}`,\n            relationship: link.relationship,\n            isPrimary: link.isPrimary,\n          }))\n        : [];\n\n  const recentAuditLogs = await prisma.auditLog.findMany({\n    where: { OR: [{ actorId: id }, { entityId: id }] },\n    orderBy: { createdAt: 'desc' },\n    take: 20,\n  });\n\n  return {\n    ...toUserDto(user),\n    lastLoginAt: user.lastLoginAt,\n    familyLinks,\n    recentAuditLogs: recentAuditLogs.map((log) => ({\n      id: log.id,\n      action: log.action,\n      actorId: log.actorId,\n      entityType: log.entityType,\n      entityId: log.entityId,\n      createdAt: log.createdAt,\n    })),\n  };\n}\n\n// ---- status / archive / unlock (FR-12, FR-13, FR-14, FR-31) ----\n\n/** Self-disable and last-active-admin guards shared by setUserStatus/archiveUser. */\nasync function assertNotSelfOrLastAdmin(tx: TxClient, actorId: string, userId: string) {\n  if (actorId === userId) {\n    throw new AppError('VALIDATION_ERROR', 'You cannot disable your own account.');\n  }\n  const target = await tx.user.findUniqueOrThrow({ where: { id: userId } });\n  if (target.role === 'ADMIN') {\n    const activeAdmins = await tx.user.count({\n      where: { role: 'ADMIN', status: 'ACTIVE', archivedAt: null, id: { not: userId } },\n    });\n    if (activeAdmins === 0) {\n      throw new AppError('VALIDATION_ERROR', 'At least one active admin is required.');\n    }\n  }\n}\n\nexport async function setUserStatus(actorId: string, userId: string, status: 'ACTIVE' | 'DISABLED') {\n  return prisma.$transaction(async (tx) => {\n    if (status === 'DISABLED') {\n      await assertNotSelfOrLastAdmin(tx, actorId, userId);\n    }\n    return tx.user.update({ where: { id: userId }, data: { status }, select: { id: true, status: true } });\n  });\n}\n\nexport async function archiveUser(actorId: string, userId: string) {\n  return prisma.$transaction(async (tx) => {\n    await assertNotSelfOrLastAdmin(tx, actorId, userId);\n    return tx.user.update({\n      where: { id: userId },\n      data: { status: 'DISABLED', archivedAt: new Date() },\n      select: { id: true, status: true, archivedAt: true },\n    });\n  });\n}\n\nexport async function restoreUser(userId: string) {\n  return prisma.user.update({\n    where: { id: userId },\n    data: { archivedAt: null },\n    select: { id: true, status: true, archivedAt: true },\n  });\n}\n\n/** FR-31: clears exactly the two lockout fields that exist in the schema today. */\nexport async function unlockUser(userId: string) {\n  return prisma.user.update({\n    where: { id: userId },\n    data: { lockedUntil: null, failedLoginCount: 0 },\n    select: { id: true, lockedUntil: true, failedLoginCount: true },\n  });\n}\n\n/**\n * FR-7/FR-12 sequencing dependency (see system-design.md Overview/Component\n * 20): PRD-01's real auth/session has not landed, so this is a stubbed\n * no-op behind the same placeholder convention requireRole.ts establishes.\n * Call sites (POST /api/users/:id/invite, createUser's sendInvite checkbox)\n * do not change when PRD-01 lands and makes this real.\n */\nexport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n  logger.info('sendInvite stub called (PRD-01 auth not landed yet)', { userId });\n  return { id: userId, inviteSentAt: new Date() };\n}\n","numLines":392,"startLine":1,"totalLines":392}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BGd8YetQtYbRsMmgwwLN3c","type":"tool_result","content":"1\timport { AppError } from '@/server/http';\n2\timport type { Role } from '@/config/navigation';\n3\t\n4\t/**\n5\t * Single chokepoint for server-side role checks on write endpoints.\n6\t *\n7\t * PRD-01 (real auth/session) has not landed in this workspace yet, so\n8\t * there is no session to read. This returns the same ADMIN placeholder\n9\t * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n10\t * and throws FORBIDDEN when that role isn't in the allowed list. Every\n11\t * write endpoint in this PRD calls requireRole() instead of checking role\n12\t * itself, so wiring up a real session later is a one-file change here\n13\t * instead of touching every route.\n14\t */\n15\tconst PLACEHOLDER_USER = { id: 'placeholder-user', role: 'ADMIN' as Role };\n16\t\n17\texport function requireRole(...roles: Role[]): { id: string; role: Role } {\n18\t  if (!roles.includes(PLACEHOLDER_USER.role)) {\n19\t    throw new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n20\t  }\n21\t  return PLACEHOLDER_USER;\n22\t}\n23\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"e3271b0f-8344-4477-a52a-e166a548215e","timestamp":"2026-10-20T06:17:26.756Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/auth/requireRole.ts","content":"import { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side role checks on write endpoints.\n *\n * PRD-01 (real auth/session) has not landed in this workspace yet, so\n * there is no session to read. This returns the same ADMIN placeholder\n * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n * and throws FORBIDDEN when that role isn't in the allowed list. Every\n * write endpoint in this PRD calls requireRole() instead of checking role\n * itself, so wiring up a real session later is a one-file change here\n * instead of touching every route.\n */\nconst PLACEHOLDER_USER = { id: 'placeholder-user', role: 'ADMIN' as Role };\n\nexport function requireRole(...roles: Role[]): { id: string; role: Role } {\n  if (!roles.includes(PLACEHOLDER_USER.role)) {\n    throw new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n  }\n  return PLACEHOLDER_USER;\n}\n","numLines":23,"startLine":1,"totalLines":23}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016AKqSYXeuLYuVnePSD8egb","type":"tool_result","content":"1\timport { NextResponse } from 'next/server';\n2\timport { Prisma } from '@prisma/client';\n3\timport { ZodError, type ZodSchema } from 'zod';\n4\timport { logger } from '@/lib/logger';\n5\t\n6\t/**\n7\t * The one chokepoint every route handler goes through. Nothing here should\n8\t * be reimplemented per-route — new endpoints import from this module, they\n9\t * don't hand-roll envelopes, pagination clamping or error mapping.\n10\t */\n11\t\n12\texport type ApiErrorCode =\n13\t  | 'VALIDATION_ERROR'\n14\t  | 'NOT_FOUND'\n15\t  | 'CONFLICT'\n16\t  | 'INTERNAL'\n17\t  | 'RATE_LIMITED'\n18\t  | 'UNAUTHENTICATED'\n19\t  | 'FORBIDDEN'\n20\t  | 'INVALID_TOKEN';\n21\t\n22\tconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n23\t  VALIDATION_ERROR: 400,\n24\t  NOT_FOUND: 404,\n25\t  CONFLICT: 409,\n26\t  INTERNAL: 500,\n27\t  RATE_LIMITED: 429,\n28\t  UNAUTHENTICATED: 401,\n29\t  FORBIDDEN: 403,\n30\t  INVALID_TOKEN: 410,\n31\t};\n32\t\n33\t/** Throw this from a handler for a known, intentional failure. */\n34\texport class AppError extends Error {\n35\t  code: ApiErrorCode;\n36\t  details?: unknown;\n37\t\n38\t  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n39\t    super(message);\n40\t    this.code = code;\n41\t    this.details = details;\n42\t  }\n43\t}\n44\t\n45\texport function ok<T>(data: T, init?: ResponseInit) {\n46\t  return NextResponse.json({ data }, init);\n47\t}\n48\t\n49\texport function paginated<T>(\n50\t  data: T[],\n51\t  meta: { page: number; pageSize: number; total: number },\n52\t  init?: ResponseInit,\n53\t) {\n54\t  return NextResponse.json({ data, meta }, init);\n55\t}\n56\t\n57\texport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n58\t  return NextResponse.json(\n59\t    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n60\t    { status: ERROR_STATUS[code] },\n61\t  );\n62\t}\n63\t\n64\t/**\n65\t * Wraps a route handler, mapping thrown errors to the shared envelope:\n66\t * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n67\t * AppError -> its own code/status\n68\t * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n69\t * anything else -> INTERNAL (500), stack logged, never returned to client\n70\t */\n71\texport function withHandler<Args extends unknown[]>(\n72\t  fn: (...args: Args) => Promise<Response>,\n73\t) {\n74\t  return async (...args: Args): Promise<Response> => {\n75\t    try {\n76\t      return await fn(...args);\n77\t    } catch (error) {\n78\t      if (error instanceof ZodError) {\n79\t        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n80\t      }\n81\t\n82\t      if (error instanceof AppError) {\n83\t        return apiError(error.code, error.message, error.details);\n84\t      }\n85\t\n86\t      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n87\t        if (error.code === 'P2002') {\n88\t          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n89\t        }\n90\t        if (error.code === 'P2025') {\n91\t          return apiError('NOT_FOUND', 'Resource not found');\n92\t        }\n93\t      }\n94\t\n95\t      logger.error('Unhandled error in route handler', {\n96\t        message: error instanceof Error ? error.message : String(error),\n97\t        stack: error instanceof Error ? error.stack : undefined,\n98\t      });\n99\t      return apiError('INTERNAL', 'Internal server error');\n100\t    }\n101\t  };\n102\t}\n103\t\n104\texport interface PaginationParams {\n105\t  page: number;\n106\t  pageSize: number;\n107\t  skip: number;\n108\t  take: number;\n109\t}\n110\t\n111\tconst MAX_PAGE_SIZE = 100;\n112\t\n113\texport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n114\t  const rawPage = Number(searchParams.get('page'));\n115\t  const rawPageSize = Number(searchParams.get('pageSize'));\n116\t\n117\t  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n118\t  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n119\t  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n120\t\n121\t  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n122\t}\n123\t\n124\texport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n125\t  const json = await request.json().catch(() => ({}));\n126\t  return schema.parse(json);\n127\t}\n128\t\n129\texport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n130\t  return schema.parse(Object.fromEntries(searchParams.entries()));\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"6f9ee0f5-f56a-4da4-91da-854d6a95f92f","timestamp":"2026-10-20T06:17:26.756Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/http.ts","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\nexport async function parseBody<T>(request: Request, schema: ZodSchema<T>): Promise<T> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\nexport function parseQuery<T>(searchParams: URLSearchParams, schema: ZodSchema<T>): T {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\n","numLines":132,"startLine":1,"totalLines":132}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jvhdh1Ahjrv7qdLRpmnNrq","type":"tool_result","content":"1\tgenerator client {\n2\t  provider = \"prisma-client-js\"\n3\t}\n4\t\n5\tdatasource db {\n6\t  provider = \"postgresql\"\n7\t  url      = env(\"DATABASE_URL\")\n8\t}\n9\t\n10\tenum Role {\n11\t  ADMIN\n12\t  TEACHER\n13\t  STUDENT\n14\t  PARENT\n15\t}\n16\t\n17\tenum UserStatus {\n18\t  ACTIVE\n19\t  INVITED\n20\t  DISABLED\n21\t  ARCHIVED\n22\t}\n23\t\n24\tenum AuthTokenType {\n25\t  INVITE\n26\t  PASSWORD_RESET\n27\t}\n28\t\n29\tenum Gender {\n30\t  FEMALE\n31\t  MALE\n32\t  OTHER\n33\t  UNDISCLOSED\n34\t}\n35\t\n36\tenum GuardianRelationship {\n37\t  MOTHER\n38\t  FATHER\n39\t  GUARDIAN\n40\t  GRANDPARENT\n41\t  OTHER\n42\t}\n43\t\n44\t/// Every authenticated person. passwordHash is nullable because an INVITED\n45\t/// user has no password until they accept their invite (TASK-8's\n46\t/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n47\t/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n48\t/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n49\t/// field shared by every role, archivedAt backs FR-13's archive/restore\n50\t/// (separate from status so a DISABLED-but-not-archived user stays distinct\n51\t/// from an archived one).\n52\tmodel User {\n53\t  id                String      @id @default(cuid())\n54\t  email             String      @unique\n55\t  passwordHash      String?\n56\t  firstName         String\n57\t  lastName          String\n58\t  phone             String?\n59\t  role              Role\n60\t  status            UserStatus  @default(INVITED)\n61\t  failedLoginCount  Int         @default(0)\n62\t  lockedUntil       DateTime?\n63\t  lastLoginAt       DateTime?\n64\t  passwordChangedAt DateTime?\n65\t  archivedAt        DateTime?\n66\t  createdAt         DateTime    @default(now())\n67\t  updatedAt         DateTime    @updatedAt\n68\t  authTokens        AuthToken[]\n69\t  auditLogs         AuditLog[]\n70\t  studentProfile    StudentProfile?\n71\t  teacherProfile    TeacherProfile?\n72\t  parentProfile     ParentProfile?\n73\t  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")\n74\t  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")\n75\t\n76\t  @@index([lastName, firstName, email])\n77\t}\n78\t\n79\t/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n80\t/// only -- enforced in the service layer (src/server/services/users.ts,\n81\t/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\n82\tmodel StudentProfile {\n83\t  userId           String     @id\n84\t  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n85\t  admissionNumber  String     @unique\n86\t  dateOfBirth      DateTime   @db.Date\n87\t  gender           Gender     @default(UNDISCLOSED)\n88\t  gradeLevelId     String\n89\t  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n90\t  enrollmentDate   DateTime   @db.Date\n91\t  addressLine1     String?\n92\t  city             String?\n93\t  medicalNotes     String?\n94\t  emergencyContact String?\n95\t  emergencyPhone   String?\n96\t}\n97\t\n98\t/// Teacher-specific fields (FR-1).\n99\tmodel TeacherProfile {\n100\t  userId         String    @id\n101\t  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n102\t  employeeNumber String    @unique\n103\t  title          String?\n104\t  qualifications String?\n105\t  hireDate       DateTime? @db.Date\n106\t}\n107\t\n108\t/// Parent-specific fields (FR-1).\n109\tmodel ParentProfile {\n110\t  userId     String  @id\n111\t  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n112\t  occupation String?\n113\t  address    String?\n114\t}\n115\t\n116\t/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n117\t/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n118\t/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n119\t/// transaction invariants rather than DB constraints.\n120\tmodel ParentStudentLink {\n121\t  id           String               @id @default(cuid())\n122\t  parentId     String\n123\t  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n124\t  studentId    String\n125\t  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n126\t  relationship GuardianRelationship\n127\t  isPrimary    Boolean              @default(false)\n128\t  createdAt    DateTime             @default(now())\n129\t\n130\t  @@unique([parentId, studentId])\n131\t  @@index([studentId])\n132\t}\n133\t\n134\t/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n135\t/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n136\t/// user. One shared shape for both token types; src/server/auth/tokens.ts\n137\t/// is the single producer/consumer.\n138\tmodel AuthToken {\n139\t  id        String        @id @default(cuid())\n140\t  userId    String\n141\t  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n142\t  type      AuthTokenType\n143\t  tokenHash String        @unique\n144\t  expiresAt DateTime\n145\t  usedAt    DateTime?\n146\t  createdAt DateTime      @default(now())\n147\t\n148\t  @@index([userId, type])\n149\t}\n150\t\n151\t/// Insert-only audit trail written exclusively through src/server/audit.ts's\n152\t/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n153\t/// non-existent email can still be recorded.\n154\tmodel AuditLog {\n155\t  id         String   @id @default(cuid())\n156\t  actorId    String?\n157\t  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n158\t  action     String\n159\t  entityType String?\n160\t  entityId   String?\n161\t  metadata   Json?\n162\t  ip         String?\n163\t  createdAt  DateTime @default(now())\n164\t\n165\t  @@index([actorId])\n166\t  @@index([action])\n167\t}\n168\t\n169\t/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n170\t/// info. Later PRDs read this for top-bar branding and public footer; no\n171\t/// other PRD should add a second row or a second settings model.\n172\tmodel SchoolSettings {\n173\t  id           String   @id @default(\"singleton\")\n174\t  name         String   @default(\"SchoolHub Academy\")\n175\t  shortName    String   @default(\"SchoolHub\")\n176\t  logoUrl      String?\n177\t  timezone     String   @default(\"UTC\")\n178\t  addressLine1 String?\n179\t  addressLine2 String?\n180\t  city         String?\n181\t  country      String?\n182\t  phone        String?\n183\t  email        String?\n184\t  website      String?\n185\t  createdAt    DateTime @default(now())\n186\t  updatedAt    DateTime @updatedAt\n187\t}\n188\t\n189\t/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n190\t/// at a time -- enforced in src/server/services/academicYears.ts's\n191\t/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n192\t/// express \"exactly one true\" as a simple unique index).\n193\tmodel AcademicYear {\n194\t  id        String   @id @default(cuid())\n195\t  name      String   @unique\n196\t  startDate DateTime @db.Date\n197\t  endDate   DateTime @db.Date\n198\t  isCurrent Boolean  @default(false)\n199\t  createdAt DateTime @default(now())\n200\t  updatedAt DateTime @updatedAt\n201\t  terms     Term[]\n202\t}\n203\t\n204\t/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n205\t/// Restrict means the year can't be deleted while it still has terms --\n206\t/// the service layer checks this first to return a friendly 409 instead of\n207\t/// a raw FK error.\n208\tmodel Term {\n209\t  id             String       @id @default(cuid())\n210\t  academicYearId String\n211\t  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n212\t  name           String\n213\t  startDate      DateTime     @db.Date\n214\t  endDate        DateTime     @db.Date\n215\t  order          Int\n216\t  createdAt      DateTime     @default(now())\n217\t  updatedAt      DateTime     @updatedAt\n218\t\n219\t  @@unique([academicYearId, name])\n220\t  @@unique([academicYearId, order])\n221\t}\n222\t\n223\t/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n224\t/// reference grade levels, so they're archived instead of deleted.\n225\tmodel GradeLevel {\n226\t  id              String           @id @default(cuid())\n227\t  name            String           @unique\n228\t  shortName       String           @unique\n229\t  order           Int              @unique\n230\t  archivedAt      DateTime?\n231\t  createdAt       DateTime         @default(now())\n232\t  updatedAt       DateTime         @updatedAt\n233\t  studentProfiles StudentProfile[]\n234\t}\n235\t\n236\t/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n237\t/// the service layer, not the DB) so the unique constraint catches\n238\t/// case-insensitive duplicates like \"math\" vs \"MATH\".\n239\tmodel Subject {\n240\t  id          String    @id @default(cuid())\n241\t  name        String\n242\t  code        String    @unique\n243\t  description String?\n244\t  color       String    @default(\"#4F46E5\")\n245\t  archivedAt  DateTime?\n246\t  createdAt   DateTime  @default(now())\n247\t  updatedAt   DateTime  @updatedAt\n248\t}\n249\t\n250\t/// A physical room classes are scheduled in.\n251\tmodel Room {\n252\t  id         String    @id @default(cuid())\n253\t  name       String    @unique\n254\t  building   String?\n255\t  capacity   Int?\n256\t  archivedAt DateTime?\n257\t  createdAt  DateTime  @default(now())\n258\t  updatedAt  DateTime  @updatedAt\n259\t}\n260\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"9186f3c3-8c4e-4c7e-b178-71e4f2396e02","timestamp":"2026-10-20T06:17:26.759Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/prisma/schema.prisma","content":"generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\nenum Gender {\n  FEMALE\n  MALE\n  OTHER\n  UNDISCLOSED\n}\n\nenum GuardianRelationship {\n  MOTHER\n  FATHER\n  GUARDIAN\n  GRANDPARENT\n  OTHER\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n/// field shared by every role, archivedAt backs FR-13's archive/restore\n/// (separate from status so a DISABLED-but-not-archived user stays distinct\n/// from an archived one).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  phone             String?\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  archivedAt        DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n  studentProfile    StudentProfile?\n  teacherProfile    TeacherProfile?\n  parentProfile     ParentProfile?\n  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")\n  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")\n\n  @@index([lastName, firstName, email])\n}\n\n/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n/// only -- enforced in the service layer (src/server/services/users.ts,\n/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\nmodel StudentProfile {\n  userId           String     @id\n  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  admissionNumber  String     @unique\n  dateOfBirth      DateTime   @db.Date\n  gender           Gender     @default(UNDISCLOSED)\n  gradeLevelId     String\n  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n  enrollmentDate   DateTime   @db.Date\n  addressLine1     String?\n  city             String?\n  medicalNotes     String?\n  emergencyContact String?\n  emergencyPhone   String?\n}\n\n/// Teacher-specific fields (FR-1).\nmodel TeacherProfile {\n  userId         String    @id\n  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  employeeNumber String    @unique\n  title          String?\n  qualifications String?\n  hireDate       DateTime? @db.Date\n}\n\n/// Parent-specific fields (FR-1).\nmodel ParentProfile {\n  userId     String  @id\n  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  occupation String?\n  address    String?\n}\n\n/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n/// transaction invariants rather than DB constraints.\nmodel ParentStudentLink {\n  id           String               @id @default(cuid())\n  parentId     String\n  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n  studentId    String\n  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n  relationship GuardianRelationship\n  isPrimary    Boolean              @default(false)\n  createdAt    DateTime             @default(now())\n\n  @@unique([parentId, studentId])\n  @@index([studentId])\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id              String           @id @default(cuid())\n  name            String           @unique\n  shortName       String           @unique\n  order           Int              @unique\n  archivedAt      DateTime?\n  createdAt       DateTime         @default(now())\n  updatedAt       DateTime         @updatedAt\n  studentProfiles StudentProfile[]\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n","numLines":260,"startLine":1,"totalLines":260}}}
