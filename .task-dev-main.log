{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KZWdZPz72Wkrks5YNUyWRV","type":"tool_result","content":"1\t{\n2\t  \"ticketId\": \"abcd-04\",\n3\t  \"timestamp\": \"2026-10-20T06:01:00Z\",\n4\t  \"phase\": \"architect\",\n5\t  \"version\": \"1.0\",\n6\t\n7\t  \"note\": \"Derived from system-design.md's Component Breakdown/Data Flow (Components 3, 8, 11, 15, 16, 17) and 04-notifications.md's 'API' table, which fully specifies method/path/role/notes for all endpoints (the table's 'POST /api/notifications/:id/read · /unread' row is two endpoints) — 11 endpoints total, not the 12 mentioned in system-design.md's prose; the PRD table and FR-21's own endpoint list both enumerate 11, confirmed by direct count. Two items carried forward, unresolved here because they are sequencing/confirmation items for dev-planning, not contract-shape questions: (1) every non-ADMIN, non-CRON_SECRET endpoint below calls requireRole(...ALL_ROLES) as the stand-in for a real requireUser() per system-design.md's Overview/Component 12 finding — src/server/auth/permissions.ts does not exist yet (confirmed: only requireRole.ts's ADMIN-placeholder and student-access.ts are present in src/server/auth/), so 'own notifications only' / 'own preferences only' scoping is written against the request's userId param today and must be swapped to the real session identity when PRD-01 lands, not re-derived; ALL_ROLES itself is a local const in src/config/navigation.ts today, not exported — dev-planning needs to export it (or import the four literals) for route call sites to use it; (2) list/count responses use the real paginated()/ok() shapes from src/server/http.ts (data + nested meta for lists, data for single resources), confirmed directly against src/server/http.ts and the existing src/app/api/users/route.ts pattern rather than assumed.\",\n8\t\n9\t  \"conventions\": {\n10\t    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n11\t    \"listEnvelope\": { \"data\": \"[...]\", \"meta\": { \"page\": 1, \"pageSize\": 20, \"total\": 0 } },\n12\t    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n13\t    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\", \"INVALID_TOKEN (410)\"],\n14\t    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100), per src/server/http.ts parsePagination()\",\n15\t    \"auth\": \"Own-row routes call requireRole(...ALL_ROLES) (placeholder for PRD-01's requireUser(); see note). ADMIN-only routes call requireRole('ADMIN') directly — already real today via src/server/auth/requireRole.ts. POST /api/internal/email/dispatch checks Authorization: Bearer ${CRON_SECRET} itself, not requireRole (NFR-8).\",\n16\t    \"security\": \"Notification.link values are validated server-side as '/'-prefixed relative paths before any write that sets them (NFR-5); this is a notify()-time invariant (Component 3), not re-validated at the read endpoints below.\"\n17\t  },\n18\t\n19\t  \"endpoints\": [\n20\t    {\n21\t      \"method\": \"GET\",\n22\t      \"path\": \"/api/notifications\",\n23\t      \"description\": \"Any role. Own notifications only (userId scoped server-side). Backs both the /notifications page (paginated, filterable) and, with pageSize=10 and no filters, the bell popover's recent-10 list — one implementation (Component 11), not two query paths.\",\n24\t      \"requestSchema\": { \"unread\": \"boolean?\", \"category\": \"\\\"ACCOUNT\\\"|\\\"ACADEMIC\\\"|\\\"ATTENDANCE\\\"|\\\"COMMUNICATION\\\"|\\\"FINANCE\\\"|\\\"SYSTEM\\\"?\", \"page\": \"int? (default 1)\", \"pageSize\": \"int? (default 20, max 100)\" },\n25\t      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"type\": \"string\", \"category\": \"string\", \"title\": \"string\", \"body\": \"string|null\", \"link\": \"string|null\", \"readAt\": \"datetime|null\", \"createdAt\": \"datetime\" } ], \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n26\t      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n27\t    },\n28\t    {\n29\t      \"method\": \"GET\",\n30\t      \"path\": \"/api/notifications/unread-count\",\n31\t      \"description\": \"Any role. Own count only. Backed by the Notification(userId, readAt, createdAt) composite index; must respond under 50ms (NFR-3). Polled by the bell every 30s while the tab is visible.\",\n32\t      \"requestSchema\": {},\n33\t      \"responseSchema\": { \"data\": { \"count\": \"int\" } },\n34\t      \"requirementIds\": [\"FR-14\", \"FR-21\", \"NFR-3\", \"NFR-7\"]\n35\t    },\n36\t    {\n37\t      \"method\": \"POST\",\n38\t      \"path\": \"/api/notifications/:id/read\",\n39\t      \"description\": \"Owner only (the notification's userId must match the caller). Sets readAt=now if not already set; idempotent. NOT_FOUND if the id doesn't belong to the caller (never reveals another user's notification exists).\",\n40\t      \"requestSchema\": {},\n41\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"readAt\": \"datetime\" } },\n42\t      \"requirementIds\": [\"FR-15\", \"FR-21\", \"NFR-7\"]\n43\t    },\n44\t    {\n45\t      \"method\": \"POST\",\n46\t      \"path\": \"/api/notifications/:id/unread\",\n47\t      \"description\": \"Owner only. Clears readAt. Same ownership/NOT_FOUND rule as /read.\",\n48\t      \"requestSchema\": {},\n49\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"readAt\": null } },\n50\t      \"requirementIds\": [\"FR-16\", \"FR-21\", \"NFR-7\"]\n51\t    },\n52\t    {\n53\t      \"method\": \"POST\",\n54\t      \"path\": \"/api/notifications/read-all\",\n55\t      \"description\": \"Any role. Sets readAt=now on every unread Notification row owned by the caller (bulk UPDATE, not per-row). Backs the popover footer's 'Mark all as read' and the /notifications page's bulk action.\",\n56\t      \"requestSchema\": {},\n57\t      \"responseSchema\": { \"data\": { \"updatedCount\": \"int\" } },\n58\t      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n59\t    },\n60\t    {\n61\t      \"method\": \"GET\",\n62\t      \"path\": \"/api/me/notification-preferences\",\n63\t      \"description\": \"Any role. Returns the caller's NotificationPreference rows merged with Component 2's registry defaults for every type visible to the caller's role (so the client never has to do the merge).\",\n64\t      \"requestSchema\": {},\n65\t      \"responseSchema\": { \"data\": [ { \"type\": \"string\", \"category\": \"string\", \"label\": \"string\", \"description\": \"string\", \"mandatoryInApp\": \"boolean\", \"inApp\": \"boolean\", \"email\": \"boolean\" } ] },\n66\t      \"requirementIds\": [\"FR-18\", \"FR-21\", \"NFR-7\"]\n67\t    },\n68\t    {\n69\t      \"method\": \"PUT\",\n70\t      \"path\": \"/api/me/notification-preferences\",\n71\t      \"description\": \"Any role. Upserts one {type, inApp, email} preference row for the caller. Rejects inApp=false for mandatoryInApp types with VALIDATION_ERROR (FR-22), independent of the disabled-Switch client affordance.\",\n72\t      \"requestSchema\": { \"type\": \"string (registry key, required)\", \"inApp\": \"boolean\", \"email\": \"boolean\" },\n73\t      \"responseSchema\": { \"data\": { \"type\": \"string\", \"inApp\": \"boolean\", \"email\": \"boolean\" } },\n74\t      \"requirementIds\": [\"FR-19\", \"FR-21\", \"FR-22\", \"NFR-7\"]\n75\t    },\n76\t    {\n77\t      \"method\": \"POST\",\n78\t      \"path\": \"/api/internal/email/dispatch\",\n79\t      \"description\": \"Requires Authorization: Bearer ${CRON_SECRET}; 401 via the standard error envelope on mismatch (NFR-8), not requireRole. Runs Component 8's dispatchEmails() once (recovers stuck SENDING rows, claims and sends a batch, applies retry backoff, runs the daily purge check). Called by an external scheduler or the npm run worker:email loop script.\",\n80\t      \"requestSchema\": { \"batchSize\": \"int? (default 50)\" },\n81\t      \"responseSchema\": { \"data\": { \"sent\": \"int\", \"failed\": \"int\", \"retried\": \"int\" } },\n82\t      \"requirementIds\": [\"FR-10\", \"FR-11\", \"FR-12\", \"FR-17\", \"FR-21\", \"NFR-4\", \"NFR-8\"]\n83\t    },\n84\t    {\n85\t      \"method\": \"GET\",\n86\t      \"path\": \"/api/admin/email-log\",\n87\t      \"description\": \"ADMIN only. Paginated EmailOutbox rows (created/recipient/subject/status/attempts/lastError), filterable by status.\",\n88\t      \"requestSchema\": { \"status\": \"\\\"PENDING\\\"|\\\"SENDING\\\"|\\\"SENT\\\"|\\\"FAILED\\\"?\", \"page\": \"int? (default 1)\", \"pageSize\": \"int? (default 20, max 100)\" },\n89\t      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"createdAt\": \"datetime\", \"recipient\": \"string\", \"subject\": \"string\", \"status\": \"string\", \"attempts\": \"int\", \"lastError\": \"string|null\", \"nextAttemptAt\": \"datetime|null\" } ], \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n90\t      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-7\"]\n91\t    },\n92\t    {\n93\t      \"method\": \"POST\",\n94\t      \"path\": \"/api/admin/email-log/:id/retry\",\n95\t      \"description\": \"ADMIN only. Resets the row to attempts=0, status=PENDING, nextAttemptAt=now — the same shape Component 8's dispatcher expects on its next pass; this endpoint does not send anything itself.\",\n96\t      \"requestSchema\": {},\n97\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"PENDING\", \"attempts\": 0, \"nextAttemptAt\": \"datetime\" } },\n98\t      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-7\"]\n99\t    },\n100\t    {\n101\t      \"method\": \"POST\",\n102\t      \"path\": \"/api/admin/notifications/test\",\n103\t      \"description\": \"ADMIN only. Calls Component 3's notify({ type: 'system.test', userIds: [caller.id], ... }) so the admin receives one in-app notification (and, per their own preferences, one EmailOutbox row) to verify delivery end to end.\",\n104\t      \"requestSchema\": {},\n105\t      \"responseSchema\": { \"data\": { \"queued\": true } },\n106\t      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-7\"]\n107\t    }\n108\t  ],\n109\t  \"status\": \"complete\"\n110\t}\n111\t"}]},"parent_tool_use_id":null,"session_id":"26ce942b-d6a7-4ab5-ac09-e89a7a8e3024","uuid":"9bf66dde-f7c8-475b-b7fb-9f9e2e6bfca8","timestamp":"2026-10-20T07:00:36.836Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"abcd-04\",\n  \"timestamp\": \"2026-10-20T06:01:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md's Component Breakdown/Data Flow (Components 3, 8, 11, 15, 16, 17) and 04-notifications.md's 'API' table, which fully specifies method/path/role/notes for all endpoints (the table's 'POST /api/notifications/:id/read · /unread' row is two endpoints) — 11 endpoints total, not the 12 mentioned in system-design.md's prose; the PRD table and FR-21's own endpoint list both enumerate 11, confirmed by direct count. Two items carried forward, unresolved here because they are sequencing/confirmation items for dev-planning, not contract-shape questions: (1) every non-ADMIN, non-CRON_SECRET endpoint below calls requireRole(...ALL_ROLES) as the stand-in for a real requireUser() per system-design.md's Overview/Component 12 finding — src/server/auth/permissions.ts does not exist yet (confirmed: only requireRole.ts's ADMIN-placeholder and student-access.ts are present in src/server/auth/), so 'own notifications only' / 'own preferences only' scoping is written against the request's userId param today and must be swapped to the real session identity when PRD-01 lands, not re-derived; ALL_ROLES itself is a local const in src/config/navigation.ts today, not exported — dev-planning needs to export it (or import the four literals) for route call sites to use it; (2) list/count responses use the real paginated()/ok() shapes from src/server/http.ts (data + nested meta for lists, data for single resources), confirmed directly against src/server/http.ts and the existing src/app/api/users/route.ts pattern rather than assumed.\",\n\n  \"conventions\": {\n    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n    \"listEnvelope\": { \"data\": \"[...]\", \"meta\": { \"page\": 1, \"pageSize\": 20, \"total\": 0 } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\", \"INVALID_TOKEN (410)\"],\n    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100), per src/server/http.ts parsePagination()\",\n    \"auth\": \"Own-row routes call requireRole(...ALL_ROLES) (placeholder for PRD-01's requireUser(); see note). ADMIN-only routes call requireRole('ADMIN') directly — already real today via src/server/auth/requireRole.ts. POST /api/internal/email/dispatch checks Authorization: Bearer ${CRON_SECRET} itself, not requireRole (NFR-8).\",\n    \"security\": \"Notification.link values are validated server-side as '/'-prefixed relative paths before any write that sets them (NFR-5); this is a notify()-time invariant (Component 3), not re-validated at the read endpoints below.\"\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/notifications\",\n      \"description\": \"Any role. Own notifications only (userId scoped server-side). Backs both the /notifications page (paginated, filterable) and, with pageSize=10 and no filters, the bell popover's recent-10 list — one implementation (Component 11), not two query paths.\",\n      \"requestSchema\": { \"unread\": \"boolean?\", \"category\": \"\\\"ACCOUNT\\\"|\\\"ACADEMIC\\\"|\\\"ATTENDANCE\\\"|\\\"COMMUNICATION\\\"|\\\"FINANCE\\\"|\\\"SYSTEM\\\"?\", \"page\": \"int? (default 1)\", \"pageSize\": \"int? (default 20, max 100)\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"type\": \"string\", \"category\": \"string\", \"title\": \"string\", \"body\": \"string|null\", \"link\": \"string|null\", \"readAt\": \"datetime|null\", \"createdAt\": \"datetime\" } ], \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/notifications/unread-count\",\n      \"description\": \"Any role. Own count only. Backed by the Notification(userId, readAt, createdAt) composite index; must respond under 50ms (NFR-3). Polled by the bell every 30s while the tab is visible.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"count\": \"int\" } },\n      \"requirementIds\": [\"FR-14\", \"FR-21\", \"NFR-3\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/:id/read\",\n      \"description\": \"Owner only (the notification's userId must match the caller). Sets readAt=now if not already set; idempotent. NOT_FOUND if the id doesn't belong to the caller (never reveals another user's notification exists).\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"readAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-15\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/:id/unread\",\n      \"description\": \"Owner only. Clears readAt. Same ownership/NOT_FOUND rule as /read.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"readAt\": null } },\n      \"requirementIds\": [\"FR-16\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/read-all\",\n      \"description\": \"Any role. Sets readAt=now on every unread Notification row owned by the caller (bulk UPDATE, not per-row). Backs the popover footer's 'Mark all as read' and the /notifications page's bulk action.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"updatedCount\": \"int\" } },\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/notification-preferences\",\n      \"description\": \"Any role. Returns the caller's NotificationPreference rows merged with Component 2's registry defaults for every type visible to the caller's role (so the client never has to do the merge).\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"type\": \"string\", \"category\": \"string\", \"label\": \"string\", \"description\": \"string\", \"mandatoryInApp\": \"boolean\", \"inApp\": \"boolean\", \"email\": \"boolean\" } ] },\n      \"requirementIds\": [\"FR-18\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/me/notification-preferences\",\n      \"description\": \"Any role. Upserts one {type, inApp, email} preference row for the caller. Rejects inApp=false for mandatoryInApp types with VALIDATION_ERROR (FR-22), independent of the disabled-Switch client affordance.\",\n      \"requestSchema\": { \"type\": \"string (registry key, required)\", \"inApp\": \"boolean\", \"email\": \"boolean\" },\n      \"responseSchema\": { \"data\": { \"type\": \"string\", \"inApp\": \"boolean\", \"email\": \"boolean\" } },\n      \"requirementIds\": [\"FR-19\", \"FR-21\", \"FR-22\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"Requires Authorization: Bearer ${CRON_SECRET}; 401 via the standard error envelope on mismatch (NFR-8), not requireRole. Runs Component 8's dispatchEmails() once (recovers stuck SENDING rows, claims and sends a batch, applies retry backoff, runs the daily purge check). Called by an external scheduler or the npm run worker:email loop script.\",\n      \"requestSchema\": { \"batchSize\": \"int? (default 50)\" },\n      \"responseSchema\": { \"data\": { \"sent\": \"int\", \"failed\": \"int\", \"retried\": \"int\" } },\n      \"requirementIds\": [\"FR-10\", \"FR-11\", \"FR-12\", \"FR-17\", \"FR-21\", \"NFR-4\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/email-log\",\n      \"description\": \"ADMIN only. Paginated EmailOutbox rows (created/recipient/subject/status/attempts/lastError), filterable by status.\",\n      \"requestSchema\": { \"status\": \"\\\"PENDING\\\"|\\\"SENDING\\\"|\\\"SENT\\\"|\\\"FAILED\\\"?\", \"page\": \"int? (default 1)\", \"pageSize\": \"int? (default 20, max 100)\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"createdAt\": \"datetime\", \"recipient\": \"string\", \"subject\": \"string\", \"status\": \"string\", \"attempts\": \"int\", \"lastError\": \"string|null\", \"nextAttemptAt\": \"datetime|null\" } ], \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/email-log/:id/retry\",\n      \"description\": \"ADMIN only. Resets the row to attempts=0, status=PENDING, nextAttemptAt=now — the same shape Component 8's dispatcher expects on its next pass; this endpoint does not send anything itself.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"PENDING\", \"attempts\": 0, \"nextAttemptAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/notifications/test\",\n      \"description\": \"ADMIN only. Calls Component 3's notify({ type: 'system.test', userIds: [caller.id], ... }) so the admin receives one in-app notification (and, per their own preferences, one EmailOutbox row) to verify delivery end to end.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"queued\": true } },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-7\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n","numLines":111,"startLine":1,"totalLines":111}}}
