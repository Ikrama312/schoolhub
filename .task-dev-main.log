{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B6j4r1tTqvHhiwedNmGLwp","type":"tool_result","content":"import { beforeEach, describe, expect, it, vi } from 'vitest';\nimport { AppError } from '@/server/http';\nimport {\n  checkCapacityOrThrow,\n  dropSectionCoreCourses,\n  enrollSectionCoreCourses,\n  moveStudentSection,\n  type Tx,\n} from '@/server/enrollment/roster-engine';\n\nvi.mock('@/server/audit', () => ({ audit: vi.fn() }));\nvi.mock('@/lib/logger', () => ({ logger: { info: vi.fn(), warn: vi.fn(), error: vi.fn() } }));\n\nfunction fakeTx() {\n  const tx = {\n    section: { findUnique: vi.fn() },\n    course: { findUnique: vi.fn(), findMany: vi.fn() },\n    enrollment: {\n      count: vi.fn().mockResolvedValue(0),\n      findMany: vi.fn().mockResolvedValue([]),\n      createMany: vi.fn(async ({ data }: { data: unknown[] }) => ({ count: data.length })),\n      updateMany: vi.fn(async () => ({ count: 1 })),\n    },\n  };\n  return { tx, asTx: tx as unknown as Tx };\n}\n\ndescribe('checkCapacityOrThrow', () => {\n  it('throws CONFLICT with the section message when full', async () => {\n    const { tx, asTx } = fakeTx();\n    tx.section.findUnique.mockResolvedValue({ name: '7A', capacity: 30, _count: { members: 30 } });\n    const err = await checkCapacityOrThrow(asTx, { sectionId: 's1', addingCount: 1 }).catch((e) => e);\n    expect(err).toBeInstanceOf(AppError);\n    expect(err.code).toBe('CONFLICT');\n    expect(err.message).toBe('Section 7A is full (30/30).');\n  });\n\n  it('throws CONFLICT with the course message when full', async () => {\n    const { tx, asTx } = fakeTx();\n    tx.course.findUnique.mockResolvedValue({ code: 'MATH-7A', capacity: 30 });\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}'],\n  },\n});\nConfirmDialog.test.tsx\nDataTable.test.tsx\ndates.test.ts\nenv.test.ts\neslint-no-restricted-imports.test.ts\nhttp.test.ts\nroster-engine.test.ts\nuseToast.test.tsx","is_error":false}]},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"67cc01d2-141d-46b3-b62a-e00ae741c992","timestamp":"2026-10-27T16:53:54.288Z","tool_use_result":{"stdout":"import { beforeEach, describe, expect, it, vi } from 'vitest';\nimport { AppError } from '@/server/http';\nimport {\n  checkCapacityOrThrow,\n  dropSectionCoreCourses,\n  enrollSectionCoreCourses,\n  moveStudentSection,\n  type Tx,\n} from '@/server/enrollment/roster-engine';\n\nvi.mock('@/server/audit', () => ({ audit: vi.fn() }));\nvi.mock('@/lib/logger', () => ({ logger: { info: vi.fn(), warn: vi.fn(), error: vi.fn() } }));\n\nfunction fakeTx() {\n  const tx = {\n    section: { findUnique: vi.fn() },\n    course: { findUnique: vi.fn(), findMany: vi.fn() },\n    enrollment: {\n      count: vi.fn().mockResolvedValue(0),\n      findMany: vi.fn().mockResolvedValue([]),\n      createMany: vi.fn(async ({ data }: { data: unknown[] }) => ({ count: data.length })),\n      updateMany: vi.fn(async () => ({ count: 1 })),\n    },\n  };\n  return { tx, asTx: tx as unknown as Tx };\n}\n\ndescribe('checkCapacityOrThrow', () => {\n  it('throws CONFLICT with the section message when full', async () => {\n    const { tx, asTx } = fakeTx();\n    tx.section.findUnique.mockResolvedValue({ name: '7A', capacity: 30, _count: { members: 30 } });\n    const err = await checkCapacityOrThrow(asTx, { sectionId: 's1', addingCount: 1 }).catch((e) => e);\n    expect(err).toBeInstanceOf(AppError);\n    expect(err.code).toBe('CONFLICT');\n    expect(err.message).toBe('Section 7A is full (30/30).');\n  });\n\n  it('throws CONFLICT with the course message when full', async () => {\n    const { tx, asTx } = fakeTx();\n    tx.course.findUnique.mockResolvedValue({ code: 'MATH-7A', capacity: 30 });\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}'],\n  },\n});\nConfirmDialog.test.tsx\nDataTable.test.tsx\ndates.test.ts\nenv.test.ts\neslint-no-restricted-imports.test.ts\nhttp.test.ts\nroster-engine.test.ts\nuseToast.test.tsx","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01B6j4r1tTqvHhiwedNmGLwp","permission_decision":{"decision":"accept","source":"config","reason