ose={handleClose} severity={current.severity ?? 'info'} variant=\"filled\" sx={{ width: '100%' }}>\n            {current.message}\n          </Alert>\n        ) : undefined}\n      </Snackbar>\n    </ToastContext.Provider>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2567,"cache_read_input_tokens":84824,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2567},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab594185-c31c-412a-a5f0-563328d811ca","uuid":"f807fd4e-df7d-449f-8f4e-3fcbf6d25732","timestamp":"2026-10-16T15:23:03.226Z","request_id":"req_011Cg69PcdXWAMxnrpHPWtT6"}
