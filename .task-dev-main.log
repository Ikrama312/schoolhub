> (\n              <ListItemButton key={c.id} component={NextLink} href={`/report-cards/${c.id}/print`} divider>\n                <ListItemText primary={`${c.term.name} — ${c.term.academicYear}`} secondary={c.publishedAt ? `Published ${c.publishedAt.slice(0, 10)}` : 'Not published'} />\n                <Chip size=\"small\" label={c.status === 'PUBLISHED' ? 'Published' : 'Draft'} color={c.status === 'PUBLISHED' ? 'success' : 'warning'} />\n              </ListItemButton>\n            ))}\n          </List>\n        </Paper>\n      )}\n    </>\n  );\n}\nEOF\nnpx tsc --noEmit | head; npx eslint \"src/app/(app)/report-cards\" \"src/app/(app)/admin\" \"src/app/(app)/students\" src/components/report-cards src/components/gradebook \"src/app/(app)/grades\" \"src/app/(app)/courses\" 2>&1 | tail -10","description":"Write review, homeroom list, student tab pages; typecheck/lint","timeout":300000}}}
