us: ERROR_STATUS[code] },\n61\t  );\n62\t}\n63\t\n64\t/**\n65\t * Wraps a route handler, mapping thrown errors to the shared envelope:\n66\t * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n67\t * AppError -> its own code/status\n68\t * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n69\t * anything else -> INTERNAL (500), stack logged, never returned to client\n70\t */\n71\texport function withHandler<Args extends unknown[]>(\n72\t  fn: (...args: Args) => Promise<Response>,\n73\t) {\n74\t  return async (...args: Args): Promise<Response> => {\n75\t    try {\n76\t      return await fn(...args);\n77\t    } catch (error) {\n78\t      if (error instanceof ZodError) {\n79\t        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n80\t      }\n81\t\n82\t      if (error instanceof AppError) {\n83\t        return apiError(error.code, error.message, error.details);\n84\t      }\n85\t\n86\t      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n87\t        if (error.code === 'P2002') {\n88\t          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n89\t        }\n90\t        if (error.code === 'P2025') {\n91\t          return apiError('NOT_FOUND', 'Resource not found');\n92\t        }\n93\t      }\n94\t\n95\t      logger.error('Unhandled error in route handler', {\n96\t        message: error instanceof Error ? error.message : String(error),\n97\t        stack: error instanceof Error ? error.stack : undefined,\n98\t      });\n99\t      return apiError('INTERNAL', 'Internal server error');\n100\t    }\n101\t  };\n102\t}\n103\t\n104\texport interface PaginationParams {\n105\t  page: number;\n106\t  pageSize: number;\n107\t  skip: number;\n108\t  take: number;\n109\t}\n110\t\n111\tconst MAX_PAGE_SIZE = 100;\n112\t\n113\texport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n114\t  const rawPage = Number(searchParams.get('page'));\n115\t  const rawPageSize