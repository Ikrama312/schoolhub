{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghSPtca6UPhzfVHn6rEf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01N3iru3cGjA5QwpEV5iR7to","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/rate-limit.ts","content":"// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\nconst hits = new Map<string, number[]>();\n\n/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\nexport function rateLimit(\n  key: string,\n  limit: number,\n  windowMs: number,\n  now: number = Date.now(),\n): { ok: boolean; retryAfterMs: number } {\n  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n  if (recent.length >= limit) {\n    hits.set(key, recent);\n    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n  }\n  recent.push(now);\n  hits.set(key, recent);\n  return { ok: true, retryAfterMs: 0 };\n}\n\nexport function __resetRateLimits(): void {\n  hits.clear();\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1665,"cache_read_input_tokens":128698,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1665},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"24b2a9c9-4488-41ba-bad0-91baebb96cfb","uuid":"afb6e865-fde1-487f-ac04-99131239faf8","timestamp":"2026-11-04T06:47:11.616Z","request_id":"req_011CghSPtMSiMatEKFT98JvC","wire_tool_inputs":{"toolu_01N3iru3cGjA5QwpEV5iR7to":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/rate-limit.ts","content":"// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\nconst hits = new Map<string, number[]>();\n\n/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\nexport function rateLimit(\n  key: string,\n  limit: number,\n  windowMs: number,\n  now: number = Date.now(),\n): { ok: boolean; retryAfterMs: number } {\n  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n  if (recent.length >= limit) {\n    hits.set(key, recent);\n    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n  }\n  recent.push(now);\n  hits.set(key, recent);\n  return { ok: true, retryAfterMs: 0 };\n}\n\nexport function __resetRateLimits(): void {\n  hits.clear();\n}\n"}}}
