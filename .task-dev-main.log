 row + one row per record) from an array of\n * flat objects, in the given column order. Every cell goes through\n * escapeCsvCell -- callers never concatenate CSV by hand.\n */\nexport function toCsv<T extends object>(columns: { key: string; header: string }[], rows: T[]): string {\n  const headerLine = columns.map((c) => escapeCsvCell(c.header)).join(',');\n  const lines = rows.map((row) =>\n    columns.map((c) => escapeCsvCell((row as Record<string, unknown>)[c.key])).join(','),\n  );\n  return [headerLine, ...lines].join('\\r\\n');\n}\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\nimport { cache } from 'react';\nimport { headers } from 'next/headers';\nimport { redirect } from 'next/navigation';\nimport { AppError } from '@/server/http';\nimport { auth } from '@/server/auth/auth';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side authorization (FR-28, FR-29, ADR-2).\n * Route handlers use requireUser/requireRole (throw AppError → 401/403 via\n * withHandler); server pages/layouts use requirePageUser/requirePageRole\n * (redirect to /login or /forbidden).\n */\nexport interface SessionUser {\n  id: string;\n  role: Role;\n  firstName: string;\n  lastName: string;\n  email: string;\n}\n\nexport const getCurrentUser = cache(async (): Promise<SessionUser | null> => {\n  const user = (await auth())?.user;\n  if (!user?.id) return null;\n  return { id: user.id, role: user.role, firstName: user.firstName, lastName: user.lastName, email: user.email };\n});\n\ntype Check = { user: SessionUser } | { error: 'UNAUTHENTICATED' | 'FORBIDDEN' };\n\nasync function resolve(roles: Role[]): Promise<Check> {\n  const user = await getCurrentUser();\n  if (!user) return { error: 'UNAUTHENTICATED' };\n  if (roles.length && !roles.includes(user.role)) return { error: 'FORBIDDEN' };\n  return { user };\n}\n\nexport async function requireRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  throw result.error === 'UNAUTHENTICATED'\n    ? new AppError('UNAUTHENTICATED', 'You must be signed in.')\n    : new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n}\n\nexport async function requireUser(): Promise<SessionUser> {\n  return requireRole();\n}\n\nexport async function requirePageRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  if (result.error === 'FORBIDDEN') redirect('/forbidden');\n  const callbackUrl = headers().get('x-pathname') ?? '/dashboard';\n  redirect(`/login?callbackUrl=${encodeURIComponent(callbackUrl)}`);\n}\n\nexport async function requirePageUser(): Promise<SessionUser> {\n  return requirePageRole();\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { AccessUser } from '@/server/auth/student-access';\n\n/**\n * PRD-05 FR-18. `user` is whatever requireRole(...) resolved (NFR-7 stand-in\n * until PRD-01 lands). NOT_FOUND for a missing course, FORBIDDEN otherwise.\n */\n\nasync function loadCourse(courseId: string) {\n  const course = await prisma.course.findUnique({\n    where: { id: courseId },\n    select: { id: true, teacherId: true, coTeacherIds: true },\n  });\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  return course;\n}\n\nfunction teaches(user: AccessUser, course: { teacherId: string; coTeacherIds: string[] }) {\n  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n}\n\nconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n\nexport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n\n  switch (user.role) {\n    case 'ADMIN':\n      return;\n    case 'TEACHER':\n      if (teaches(user, course)) return;\n      throw forbidden();\n    case 'STUDENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    case 'PARENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    default:\n      throw forbidden();\n  }\n}\n\n/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\nexport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER' && teaches(user, course)) return;\n  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\nexport interface AccessUser {\n  id: string;\n  role: Role;\n}\n\nexport type AccessibleStudentIds = 'ALL' | string[];\n\n/**\n * FR-17: resolves which student ids `user` may see.\n * - ADMIN: \"ALL\" (every student)\n * - STUDENT: only themselves\n * - PARENT: students linked via ParentStudentLink (component 6)\n * - TEACHER (PRD-05 FR-22): students ACTIVE in courses they teach or\n *   co-teach, plus members of sections they are homeroom teacher of.\n */\nexport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n  switch (user.role) {\n    case 'ADMIN':\n      return 'ALL';\n    case 'STUDENT':\n      return [user.id];\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({\n        where: { parentId: user.id },\n        select: { studentId: true },\n      });\n      return links.map((link) => link.studentId);\n    }\n    case 'TEACHER': {\n      const [enrolled, members] = await Promise.all([\n        prisma.enrollment.findMany({\n          where: {\n            status: 'ACTIVE',\n            course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] },\n          },\n          select: { studentId: true },\n          distinct: ['studentId'],\n        }),\n        prisma.sectionMember.findMany({\n          where: { section: { homeroomTeacherId: user.id } },\n          select: { studentId: true },\n        }),\n      ]);\n      return [...new Set([...enrolled, ...members].map((row) => row.studentId))];\n    }\n    default:\n      return [];\n  }\n}\n\n/**\n * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n * not allowed to see this particular studentId -- NOT_FOUND rather than\n * FORBIDDEN so existence of another family's student is never revealed.\n * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN; TEACHER is denied students outside their courses/homeroom).\n */\nexport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n  const accessible = await getAccessibleStudentIds(user);\n\n  if (accessible === 'ALL') return;\n\n  if (accessible.includes(studentId)) return;\n\n  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n    throw new AppError('NOT_FOUND', 'Resource not found');\n  }\n\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n}\n// Pure and isomorphic (ADR-7): imported by the grading UI for the live preview and by the\n// service for the stored value. No Prisma client import. Decimal comes from Prisma's browser\n// runtime, which bundles decimal.js, so no new dependency is needed (ADR-1); decimal.js itself is\n// only a transitive devDependency here and would not be installed in production.\nimport { Decimal } from '@prisma/client/runtime/index-browser.js';\n\nexport { Decimal };\nexport type DecimalValue = string | number | { toString(): string };\n\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\nexport const dec = (v: DecimalValue) => new Decimal(typeof v === 'number' ? v : v.toString());\n\n/** \"14.40\" — the wire and storage form (NFR-1, D5). */\nexport const fixed2 = (v: DecimalValue) => dec(v).toDecimalPlaces(2, Decimal.ROUND_HALF_UP).toFixed(2);\n\n/**\n * FR-23: ceil(elapsed / 24 h) on UTC instants, so a DST change in the school timezone does not\n * matter and exactly 24 h late is 1 day (NFR-9). On time (≤ dueAt) is 0.\n */\nexport function lateDays(submittedAt: Date, dueAt: Date): number {\n  const ms = submittedAt.getTime() - dueAt.getTime();\n  return ms <= 0 ? 0 : Math.ceil(ms / DAY_MS);\n}\n\n/** FR-30: min(lateDays × perDay, max), the pre-filled penalty percent. */\nexport function defaultPenalty(days: number, perDay: DecimalValue, max: DecimalValue): Decimal {\n  return Decimal.min(dec(perDay).mul(days), dec(max));\n}\n\n/** FR-31: raw × (1 − pct/100), rounded half-up to 2 dp. */\nexport function computeFinalScore(raw: DecimalValue, penaltyPercent: DecimalValue): Decimal {\n  return dec(raw)\n    .mul(new Decimal(100).minus(dec(penaltyPercent)))\n    .div(100)\n    .toDecimalPlaces(2, Decimal.ROUND_HALF_UP);\n}\n\n/** FR-11: Σ criterion maxPoints. */\nexport function rubricTotal(criteria: readonly { maxPoints: DecimalValue }[]): Decimal {\n  return criteria.reduce((sum, c) => sum.plus(dec(c.maxPoints)), new Decimal(0));\n}\n\n/** FR-36: maxPoints, or 120 % of it when extra credit is allowed (raw score only). */\nexport function maxRawScore(maxPoints: DecimalValue, allowExtraCredit: boolean): Decimal {\n  return allowExtraCredit ? dec(maxPoints).mul('1.2') : dec(maxPoints);\n}\n\nexport type ChipStatus = 'NOT_SUBMITTED' | 'SUBMITTED' | 'LATE' | 'GRADED' | 'RETURNED' | 'EXEMPT';\n\n/** FR-28 roster chip. Exempt wins; then the most advanced state of the submission. */\nexport function submissionChipStatus(row: {\n  exempt: boolean;\n  submission: { status: 'SUBMITTED' | 'RETURNED'; gradedAt: Date | string | null; isLate: boolean } | null;\n}): ChipStatus {\n  if (row.exempt) return 'EXEMPT';\n  const s = row.submission;\n  if (!s) return 'NOT_SUBMITTED';\n  if (s.status === 'RETURNED') return 'RETURNED';\n  if (s.gradedAt) return 'GRADED';\n  return s.isLate ? 'LATE' : 'SUBMITTED';\n}\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012NUoqFjFwFim5UEkeqQuZ1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgsLXs3PAjhoJUKFs7GQb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JpZoi2PcUKD4uCqhUFCCKq","name":"Bash","input":{"command":"cd \"/Users/ikramaansari/Documents/React Projects/schoolhub\" && cat src/server/notifications/types.ts src/server/notifications/notify.ts src/config/*.ts src/lib/validators/assignments.ts","description":"Read notifications, config, assignment validators"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8010,"cache_read_input_tokens":106794,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8010},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c6f85ae0-4ad4-4d10-b797-6ff9d3e2b1f5","uuid":"392c9f11-8ae7-4b13-a6dd-44717710f601","timestamp":"2026-11-09T12:15:46.297Z","request_id":"req_011CgsLXrpUqXUiYf5nMNP8j","wire_tool_inputs":{"toolu_01JpZoi2PcUKD4uCqhUFCCKq":{"command":"cd \"/Users/ikramaansari/Documents/React Projects/schoolhub\" && cat src/server/notifications/types.ts src/server/notifications/notify.ts src/config/*.ts src/lib/validators/assignments.ts","description":"Read notifications, config, assignment validators"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JpZoi2PcUKD4uCqhUFCCKq","type":"tool_result","content":"/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'system.test': {\n    label: 'Test notification',\n    description: 'Test messages sent by an administrator.',\n    category: 'SYSTEM',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  // PRD-07 attendance (FR-20, FR-23).\n  'attendance.absent': {\n    label: 'Marked absent',\n    description: 'A student was marked absent from a class or the daily register.',\n    category: 'ATTENDANCE',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.late': {\n    label: 'Marked late',\n    description: 'A student was marked late.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.corrected': {\n    label: 'Attendance corrected',\n    description: 'An absence was corrected to present.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.register_missing': {\n    label: 'Register not taken',\n    description: 'An administrator reminded you to take a register.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['TEACHER'],\n  },\n  // PRD-08 course content (FR-38). Scheduled lessons never notify (FR-39).\n  'content.lesson_published': {\n    label: 'New lesson published',\n    description: 'A teacher published a new lesson in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  // PRD-09 assignments (FR-42..FR-46).\n  'assignment.published': {\n    label: 'New assignment',\n    description: 'A teacher published an assignment in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.due_soon': {\n    label: 'Assignment due soon',\n    description: 'An assignment you have not submitted is due within 24 hours.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.returned': {\n    label: 'Assignment returned',\n    description: 'Graded work was returned with a score and feedback.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  'assignment.missing': {\n    label: 'Missing assignment',\n    description: 'Your child has not submitted an assignment that was due over 24 hours ago.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['PARENT'],\n  },\n  // PRD-10 quizzes (FR-29, FR-30). results_released defaults to email like assignment grading (A5).\n  'quiz.published': {\n    label: 'New quiz',\n    description: 'A teacher published a quiz in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'quiz.results_released': {\n    label: 'Quiz results released',\n    description: 'Results for a quiz you took are now available.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n} as const satisfies Record<string, NotificationTypeDef>;\n\nexport type NotificationType = keyof typeof NOTIFICATION_TYPES;\n\nconst entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n\nexport function getTypeDef(type: string): NotificationTypeDef | undefined {\n  return Object.prototype.hasOwnProperty.call(NOTIFICATION_TYPES, type)\n    ? (NOTIFICATION_TYPES as Record<string, NotificationTypeDef>)[type]\n    : undefined;\n}\n\n/** Types a role may see and configure (FR-28, FR-37): role match, not emailOnly. */\nexport function visibleTypesFor(role: Role): NotificationType[] {\n  return entries.filter(([, def]) => def.roles.includes(role) && !def.emailOnly).map(([key]) => key);\n}\n\n/** Type keys in a category, for the FR-34 list filter. */\nexport function typesInCategory(category: NotificationCategory): NotificationType[] {\n  return entries.filter(([, def]) => def.category === category).map(([key]) => key);\n}\n\nexport function categoryOf(type: string): NotificationCategory | null {\n  return getTypeDef(type)?.category ?? null;\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { BODY_MAX, isSafeRelativeLink, TITLE_MAX } from '@/lib/validators/notifications';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\nimport { resolvePrefs } from './preferences';\nimport { NOTIFICATION_TYPES, type NotificationType } from './types';\n\nexport interface NotifyInput {\n  type: NotificationType;\n  userIds: string[];\n  title: string;\n  body?: string;\n  link?: string;\n  email?: { subject?: string; template: 'generic-notification'; data?: Record<string, unknown> };\n}\n\nfunction truncate(value: string, max: number, field: string, type: string): string {\n  if (value.length <= max) return value;\n  logger.warn('Notification field truncated', { field, type, length: value.length, max });\n  return value.slice(0, max);\n}\n\n/**\n * Single producer entry point (FR-6..11). Writes in-app rows and enqueues\n * emails per resolved preferences. NEVER throws — failures are logged.\n * Call after your transaction commits.\n */\nexport async function notify(input: NotifyInput): Promise<void> {\n  try {\n    const def = NOTIFICATION_TYPES[input.type];\n    const userIds = [...new Set(input.userIds)];\n    if (!def || userIds.length === 0) return;\n\n    const title = truncate(input.title, TITLE_MAX, 'title', input.type);\n    const body = input.body == null ? null : truncate(input.body, BODY_MAX, 'body', input.type);\n    let link: string | null = input.link ?? null;\n    if (link !== null && !isSafeRelativeLink(link)) {\n      logger.warn('Notification link dropped (not a safe relative path)', { type: input.type });\n      link = null;\n    }\n\n    const [users, prefRows] = await Promise.all([\n      prisma.user.findMany({\n        where: { id: { in: userIds }, status: { notIn: ['DISABLED', 'ARCHIVED'] }, archivedAt: null },\n        select: { id: true, email: true, firstName: true },\n      }),\n      prisma.notificationPreference.findMany({ where: { userId: { in: userIds }, type: input.type } }),\n    ]);\n    const prefByUser = new Map(prefRows.map((r) => [r.userId, r]));\n\n    const inAppIds: string[] = [];\n    const emailTo: { email: string; firstName: string }[] = [];\n    for (const user of users) {\n      const prefs = resolvePrefs(def, prefByUser.get(user.id));\n      if (prefs.inApp) inAppIds.push(user.id);\n      if (prefs.email && input.email && user.email) emailTo.push(user);\n    }\n\n    if (inAppIds.length) {\n      await prisma.notification.createMany({\n        data: inAppIds.map((userId) => ({ userId, type: input.type, title, body, link })),\n      });\n    }\n\n    if (emailTo.length && input.email) {\n      // Rendered once per call (ADR-6): generic emails carry no per-recipient greeting.\n      const school = await getEmailSchool();\n      const { html, text } = await renderEmail(\n        input.email.template,\n        { title, body, link, ...(input.email.data ?? {}) },\n        school,\n      );\n      const subject = input.email.subject ?? title;\n      await prisma.emailOutbox.createMany({\n        data: emailTo.map((u) => ({ toEmail: u.email, toName: u.firstName, subject, html, text })),\n      });\n    }\n  } catch (error) {\n    logger.error('notify() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n  { key: 'quizzes', label: 'Quizzes', href: (id) => `/courses/${id}/quizzes`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\nimport AssignmentOutlinedIcon from '@mui/icons-material/AssignmentOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Assignments', href: '/assignments', icon: AssignmentOutlinedIcon, roles: ['STUDENT', 'PARENT', 'TEACHER', 'ADMIN'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/** Extension point for the student detail page; later PRDs register their tab here. */\nexport const studentTabs: StudentTab[] = [\n  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\n  // PRD-09 FR-41. No tab bar renders studentTabs yet, so the page is reachable by URL only.\n  { key: 'assignments', label: 'Assignments', href: (id) => `/students/${id}/assignments`, roles: ALL_ROLES },\n];\nimport { z } from 'zod';\nimport { dec, fixed2, rubricTotal } from '@/server/assignments/grading-math';\n\n/**\n * PRD-09 validation (FR-7, system-design §2.6). Shared by the forms and every assignment handler.\n * Decimals come in as number | string and leave as a 2 dp string (\"14.40\", NFR-1). No schema\n * carries a client \"now\" (NFR-2): rules that need the clock (SCHEDULED in the future, deadlines)\n * live in the service.\n */\n\nexport const SUBMISSION_TYPES = ['ONLINE_TEXT', 'FILE_UPLOAD', 'TEXT_AND_FILE', 'NO_SUBMISSION'] as const;\nexport const ASSIGNMENT_STATUSES = ['DRAFT', 'SCHEDULED', 'PUBLISHED'] as const;\nexport const CHIP_STATUSES = ['NOT_SUBMITTED', 'SUBMITTED', 'LATE', 'GRADED', 'RETURNED', 'EXEMPT'] as const;\nexport const STUDENT_TABS = ['UPCOMING', 'MISSING', 'SUBMITTED', 'RETURNED'] as const;\n\nexport const TITLE_MAX = 150;\nexport const INSTRUCTIONS_MAX = 50_000;\nexport const SUBMISSION_TEXT_MAX = 50_000;\nexport const FEEDBACK_MAX = 10_000;\n\nconst id = z.string().min(1);\n\n/** number | \"12.5\" within [min, max], at most 2 dp → \"12.50\". */\nconst decimal = (min: number, max: number, label: string) =>\n  z\n    .union([z.number(), z.string().trim().min(1, `${label} is required`)])\n    .refine((v) => /^-?\\d+(\\.\\d{1,2})?$/.test(String(v)), `${label} must be a number with at most 2 decimals`)\n    .refine((v) => {\n      const d = dec(v);\n      return d.gte(min) && d.lte(max);\n    }, `${label} must be between ${min} and ${max}`)\n    .transform((v) => fixed2(v));\n\nconst instant = z.coerce.date({ invalid_type_error: 'Enter a valid date and time' });\n\nexport const rubricLevelInput = z.object({\n  label: z.string().trim().min(1, 'Level label is required').max(100),\n  points: decimal(0, 1000, 'Level points'),\n  description: z.string().trim().max(1000).optional().default(''),\n});\n\nexport const rubricCriterionInput = z\n  .object({\n    id: id.optional(),\n    title: z.string().trim().min(1, 'Criterion title is required').max(TITLE_MAX),\n    description: z.string().trim().max(1000).optional().default(''),\n    maxPoints: decimal(0, 1000, 'Criterion points'),\n    levels: z.array(rubricLevelInput).min(1, 'Add at least one level').max(10),\n  })\n  .superRefine((c, ctx) => {\n    c.levels.forEach((l, i) => {\n      if (dec(l.points).gt(dec(c.maxPoints))) {\n        ctx.addIssue({ code: 'custom', path: ['levels', i, 'points'], message: 'Level points exceed the criterion maximum' });\n      }\n    });\n  });\n\nexport const rubricSumMessage = (sum: string, maxPoints: string) =>\n  `Rubric totals ${sum} points but the assignment is worth ${maxPoints}.`;\n\nconst trimZeros = (s: string) => dec(s).toString();\n\nexport const assignmentFields = z.object({\n  title: z.string().trim().min(1, 'Title is required').max(TITLE_MAX),\n  instructions: z.string().max(INSTRUCTIONS_MAX).default(''),\n  submissionType: z.enum(SUBMISSION_TYPES),\n  maxPoints: decimal(0, 1000, 'Max points'),\n  dueAt: instant,\n  availableFrom: instant.nullable().optional(),\n  allowLate: z.boolean().default(false),\n  lateCutoffAt: instant.nullable().optional(),\n  latePenaltyPercentPerDay: decimal(0, 100, 'Penalty per day').default(0),\n  maxLatePenaltyPercent: decimal(0, 100, 'Maximum penalty').default(0),\n  maxFileCount: z.coerce.number().int().min(1).max(10).default(3),\n  allowExtraCredit: z.boolean().default(false),\n  status: z.enum(ASSIGNMENT_STATUSES),\n  rubric: z.array(rubricCriterionInput).max(20).nullable().optional(),\n  attachmentFileIds: z.array(id).max(10).default([]),\n});\n\ntype AssignmentShape = z.output<typeof assignmentFields>;\n\n/** FR-7 lateCutoffAt > dueAt; FR-11 rubric Σ = maxPoints. Applied to create and to the merged PATCH result. */\nexport function assignmentRules(val: Partial<AssignmentShape>, ctx: z.RefinementCtx) {\n  if (val.lateCutoffAt && val.dueAt && val.lateCutoffAt.getTime() <= val.dueAt.getTime()) {\n    ctx.addIssue({ code: 'custom', path: ['lateCutoffAt'], message: 'The late cutoff must be after the due date' });\n  }\n  if (val.status === 'SCHEDULED' && !val.availableFrom) {\n    ctx.addIssue({ code: 'custom', path: ['availableFrom'], message: 'Choose when the assignment becomes available' });\n  }\n  if (val.rubric && val.rubric.length > 0 && val.maxPoints !== undefined) {\n    const sum = rubricTotal(val.rubric);\n    if (!sum.eq(dec(val.maxPoints))) {\n      ctx.addIssue({ code: 'custom', path: ['rubric'], message: rubricSumMessage(sum.toString(), trimZeros(val.maxPoints)) });\n    }\n  }\n}\n\nexport const assignmentInput = assignmentFields.superRefine(assignmentRules);\nexport const assignmentPatch = assignmentFields.partial();\nexport type AssignmentInput = z.output<typeof assignmentInput>;\nexport type AssignmentFormValues = z.input<typeof assignmentInput>;\nexport type AssignmentPatch = z.output<typeof assignmentPatch>;\nexport type RubricCriterionValues = z.output<typeof rubricCriterionInput>;\n\nexport const submissionInput = z.object({\n  text: z.string().max(SUBMISSION_TEXT_MAX).optional(),\n  fileIds: z.array(id).max(10).default([]),\n});\n\nexport const rubricScoreInput = z.object({\n  criterionId: id,\n  points: decimal(0, 1000, 'Points'),\n  comment: z.string().max(2000).optional(),\n});\n\nconst gradeFields = {\n  rawScore: decimal(0, 1200, 'Raw score').optional(),\n  feedback: z.string().max(FEEDBACK_MAX).optional(),\n  rubricScores: z.array(rubricScoreInput).max(20).optional(),\n  return: z.boolean().default(false),\n};\n\nexport const gradeInput = z.object({ ...gradeFields, penaltyPercent: decimal(0, 100, 'Penalty') });\nexport const offlineGradeInput = z.object({ ...gradeFields, studentId: id });\nexport type GradeInput = z.output<typeof gradeInput>;\nexport type OfflineGradeInput = z.output<typeof offlineGradeInput>;\n\nexport const bulkReturnInput = z.object({ submissionIds: z.array(id).max(500).optional() });\nexport const duplicateInput = z.object({ courseIds: z.array(id).min(1, 'Choose at least one course').max(50) });\nexport const exemptionInput = z.object({ reason: z.string().trim().max(500).optional() });\n\nexport const meAssignmentsQuery = z.object({\n  studentId: id.optional(),\n  tab: z.enum(STUDENT_TABS).optional(),\n  courseId: id.optional(),\n});\n\nexport const studentQuery = z.object({ studentId: id.optional() });\n\nexport const rosterQuery = z.object({\n  sort: z.enum(['name', 'submittedAt']).default('name'),\n  status: z.enum(CHIP_STATUSES).optional(),\n});","is_error":false}]},"parent_tool_use_id":null,"session_id":"c6f85ae0-4ad4-4d10-b797-6ff9d3e2b1f5","uuid":"184e24c4-7143-401c-accd-32a8232c9e2a","timestamp":"2026-11-09T12:15:46.441Z","tool_use_result":{"stdout":"/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'system.test': {\n    label: 'Test notification',\n    description: 'Test messages sent by an administrator.',\n    category: 'SYSTEM',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  // PRD-07 attendance (FR-20, FR-23).\n  'attendance.absent': {\n    label: 'Marked absent',\n    description: 'A student was marked absent from a class or the daily register.',\n    category: 'ATTENDANCE',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.late': {\n    label: 'Marked late',\n    description: 'A student was marked late.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.corrected': {\n    label: 'Attendance corrected',\n    description: 'An absence was corrected to present.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.register_missing': {\n    label: 'Register not taken',\n    description: 'An administrator reminded you to take a register.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['TEACHER'],\n  },\n  // PRD-08 course content (FR-38). Scheduled lessons never notify (FR-39).\n  'content.lesson_published': {\n    label: 'New lesson published',\n    description: 'A teacher published a new lesson in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  // PRD-09 assignments (FR-42..FR-46).\n  'assignment.published': {\n    label: 'New assignment',\n    description: 'A teacher published an assignment in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.due_soon': {\n    label: 'Assignment due soon',\n    description: 'An assignment you have not submitted is due within 24 hours.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.returned': {\n    label: 'Assignment returned',\n    description: 'Graded work was returned with a score and feedback.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  'assignment.missing': {\n    label: 'Missing assignment',\n    description: 'Your child has not submitted an assignment that was due over 24 hours ago.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['PARENT'],\n  },\n  // PRD-10 quizzes (FR-29, FR-30). results_released defaults to email like assignment grading (A5).\n  'quiz.published': {\n    label: 'New quiz',\n    description: 'A teacher published a quiz in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'quiz.results_released': {\n    label: 'Quiz results released',\n    description: 'Results for a quiz you took are now available.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n} as const satisfies Record<string, NotificationTypeDef>;\n\nexport type NotificationType = keyof typeof NOTIFICATION_TYPES;\n\nconst entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n\nexport function getTypeDef(type: string): NotificationTypeDef | undefined {\n  return Object.prototype.hasOwnProperty.call(NOTIFICATION_TYPES, type)\n    ? (NOTIFICATION_TYPES as Record<string, NotificationTypeDef>)[type]\n    : undefined;\n}\n\n/** Types a role may see and configure (FR-28, FR-37): role match, not emailOnly. */\nexport function visibleTypesFor(role: Role): NotificationType[] {\n  return entries.filter(([, def]) => def.roles.includes(role) && !def.emailOnly).map(([key]) => key);\n}\n\n/** Type keys in a category, for the FR-34 list filter. */\nexport function typesInCategory(category: NotificationCategory): NotificationType[] {\n  return entries.filter(([, def]) => def.category === category).map(([key]) => key);\n}\n\nexport function categoryOf(type: string): NotificationCategory | null {\n  return getTypeDef(type)?.category ?? null;\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { BODY_MAX, isSafeRelativeLink, TITLE_MAX } from '@/lib/validators/notifications';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\nimport { resolvePrefs } from './preferences';\nimport { NOTIFICATION_TYPES, type NotificationType } from './types';\n\nexport interface NotifyInput {\n  type: NotificationType;\n  userIds: string[];\n  title: string;\n  body?: string;\n  link?: string;\n  email?: { subject?: string; template: 'generic-notification'; data?: Record<string, unknown> };\n}\n\nfunction truncate(value: string, max: number, field: string, type: string): string {\n  if (value.length <= max) return value;\n  logger.warn('Notification field truncated', { field, type, length: value.length, max });\n  return value.slice(0, max);\n}\n\n/**\n * Single producer entry point (FR-6..11). Writes in-app rows and enqueues\n * emails per resolved preferences. NEVER throws — failures are logged.\n * Call after your transaction commits.\n */\nexport async function notify(input: NotifyInput): Promise<void> {\n  try {\n    const def = NOTIFICATION_TYPES[input.type];\n    const userIds = [...new Set(input.userIds)];\n    if (!def || userIds.length === 0) return;\n\n    const title = truncate(input.title, TITLE_MAX, 'title', input.type);\n    const body = input.body == null ? null : truncate(input.body, BODY_MAX, 'body', input.type);\n    let link: string | null = input.link ?? null;\n    if (link !== null && !isSafeRelativeLink(link)) {\n      logger.warn('Notification link dropped (not a safe relative path)', { type: input.type });\n      link = null;\n    }\n\n    const [users, prefRows] = await Promise.all([\n      prisma.user.findMany({\n        where: { id: { in: userIds }, status: { notIn: ['DISABLED', 'ARCHIVED'] }, archivedAt: null },\n        select: { id: true, email: true, firstName: true },\n      }),\n      prisma.notificationPreference.findMany({ where: { userId: { in: userIds }, type: input.type } }),\n    ]);\n    const prefByUser = new Map(prefRows.map((r) => [r.userId, r]));\n\n    const inAppIds: string[] = [];\n    const emailTo: { email: string; firstName: string }[] = [];\n    for (const user of users) {\n      const prefs = resolvePrefs(def, prefByUser.get(user.id));\n      if (prefs.inApp) inAppIds.push(user.id);\n      if (prefs.email && input.email && user.email) emailTo.push(user);\n    }\n\n    if (inAppIds.length) {\n      await prisma.notification.createMany({\n        data: inAppIds.map((userId) => ({ userId, type: input.type, title, body, link })),\n      });\n    }\n\n    if (emailTo.length && input.email) {\n      // Rendered once per call (ADR-6): generic emails carry no per-recipient greeting.\n      const school = await getEmailSchool();\n      const { html, text } = await renderEmail(\n        input.email.template,\n        { title, body, link, ...(input.email.data ?? {}) },\n        school,\n      );\n      const subject = input.email.subject ?? title;\n      await prisma.emailOutbox.createMany({\n        data: emailTo.map((u) => ({ toEmail: u.email, toName: u.firstName, subject, html, text })),\n      });\n    }\n  } catch (error) {\n    logger.error('notify() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n  { key: 'quizzes', label: 'Quizzes', href: (id) => `/courses/${id}/quizzes`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\nimport AssignmentOutlinedIcon from '@mui/icons-material/AssignmentOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Assignments', href: '/assignments', icon: AssignmentOutlinedIcon, roles: ['STUDENT', 'PARENT', 'TEACHER', 'ADMIN'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/** Extension point for the student detail page; later PRDs register their tab here. */\nexport const studentTabs: StudentTab[] = [\n  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\n  // PRD-09 FR-41. No tab bar renders studentTabs yet, so the page is reachable by URL only.\n  { key: 'assignments', label: 'Assignments', href: (id) => `/students/${id}/assignments`, roles: ALL_ROLES },\n];\nimport { z } from 'zod';\nimport { dec, fixed2, rubricTotal } from '@/server/assignments/grading-math';\n\n/**\n * PRD-09 validation (FR-7, system-design §2.6). Shared by the forms and every assignment handler.\n * Decimals come in as number | string and leave as a 2 dp string (\"14.40\", NFR-1). No schema\n * carries a client \"now\" (NFR-2): rules that need the clock (SCHEDULED in the future, deadlines)\n * live in the service.\n */\n\nexport const SUBMISSION_TYPES = ['ONLINE_TEXT', 'FILE_UPLOAD', 'TEXT_AND_FILE', 'NO_SUBMISSION'] as const;\nexport const ASSIGNMENT_STATUSES = ['DRAFT', 'SCHEDULED', 'PUBLISHED'] as const;\nexport const CHIP_STATUSES = ['NOT_SUBMITTED', 'SUBMITTED', 'LATE', 'GRADED', 'RETURNED', 'EXEMPT'] as const;\nexport const STUDENT_TABS = ['UPCOMING', 'MISSING', 'SUBMITTED', 'RETURNED'] as const;\n\nexport const TITLE_MAX = 150;\nexport const INSTRUCTIONS_MAX = 50_000;\nexport const SUBMISSION_TEXT_MAX = 50_000;\nexport const FEEDBACK_MAX = 10_000;\n\nconst id = z.string().min(1);\n\n/** number | \"12.5\" within [min, max], at most 2 dp → \"12.50\". */\nconst decimal = (min: number, max: number, label: string) =>\n  z\n    .union([z.number(), z.string().trim().min(1, `${label} is required`)])\n    .refine((v) => /^-?\\d+(\\.\\d{1,2})?$/.test(String(v)), `${label} must be a number with at most 2 decimals`)\n    .refine((v) => {\n      const d = dec(v);\n      return d.gte(min) && d.lte(max);\n    }, `${label} must be between ${min} and ${max}`)\n    .transform((v) => fixed2(v));\n\nconst instant = z.coerce.date({ invalid_type_error: 'Enter a valid date and time' });\n\nexport const rubricLevelInput = z.object({\n  label: z.string().trim().min(1, 'Level label is required').max(100),\n  points: decimal(0, 1000, 'Level points'),\n  description: z.string().trim().max(1000).optional().default(''),\n});\n\nexport const rubricCriterionInput = z\n  .object({\n    id: id.optional(),\n    title: z.string().trim().min(1, 'Criterion title is required').max(TITLE_MAX),\n    description: z.string().trim().max(1000).optional().default(''),\n    maxPoints: decimal(0, 1000, 'Criterion points'),\n    levels: z.array(rubricLevelInput).min(1, 'Add at least one level').max(10),\n  })\n  .superRefine((c, ctx) => {\n    c.levels.forEach((l, i) => {\n      if (dec(l.points).gt(dec(c.maxPoints))) {\n        ctx.addIssue({ code: 'custom', path: ['levels', i, 'points'], message: 'Level points exceed the criterion maximum' });\n      }\n    });\n  });\n\nexport const rubricSumMessage = (sum: string, maxPoints: string) =>\n  `Rubric totals ${sum} points but the assignment is worth ${maxPoints}.`;\n\nconst trimZeros = (s: string) => dec(s).toString();\n\nexport const assignmentFields = z.object({\n  title: z.string().trim().min(1, 'Title is required').max(TITLE_MAX),\n  instructions: z.string().max(INSTRUCTIONS_MAX).default(''),\n  submissionType: z.enum(SUBMISSION_TYPES),\n  maxPoints: decimal(0, 1000, 'Max points'),\n  dueAt: instant,\n  availableFrom: instant.nullable().optional(),\n  allowLate: z.boolean().default(false),\n  lateCutoffAt: instant.nullable().optional(),\n  latePenaltyPercentPerDay: decimal(0, 100, 'Penalty per day').default(0),\n  maxLatePenaltyPercent: decimal(0, 100, 'Maximum penalty').default(0),\n  maxFileCount: z.coerce.number().int().min(1).max(10).default(3),\n  allowExtraCredit: z.boolean().default(false),\n  status: z.enum(ASSIGNMENT_STATUSES),\n  rubric: z.array(rubricCriterionInput).max(20).nullable().optional(),\n  attachmentFileIds: z.array(id).max(10).default([]),\n});\n\ntype AssignmentShape = z.output<typeof assignmentFields>;\n\n/** FR-7 lateCutoffAt > dueAt; FR-11 rubric Σ = maxPoints. Applied to create and to the merged PATCH result. */\nexport function assignmentRules(val: Partial<AssignmentShape>, ctx: z.RefinementCtx) {\n  if (val.lateCutoffAt && val.dueAt && val.lateCutoffAt.getTime() <= val.dueAt.getTime()) {\n    ctx.addIssue({ code: 'custom', path: ['lateCutoffAt'], message: 'The late cutoff must be after the due date' });\n  }\n  if (val.status === 'SCHEDULED' && !val.availableFrom) {\n    ctx.addIssue({ code: 'custom', path: ['availableFrom'], message: 'Choose when the assignment becomes available' });\n  }\n  if (val.rubric && val.rubric.length > 0 && val.maxPoints !== undefined) {\n    const sum = rubricTotal(val.rubric);\n    if (!sum.eq(dec(val.maxPoints))) {\n      ctx.addIssue({ code: 'custom', path: ['rubric'], message: rubricSumMessage(sum.toString(), trimZeros(val.maxPoints)) });\n    }\n  }\n}\n\nexport const assignmentInput = assignmentFields.superRefine(assignmentRules);\nexport const assignmentPatch = assignmentFields.partial();\nexport type AssignmentInput = z.output<typeof assignmentInput>;\nexport type AssignmentFormValues = z.input<typeof assignmentInput>;\nexport type AssignmentPatch = z.output<typeof assignmentPatch>;\nexport type RubricCriterionValues = z.output<typeof rubricCriterionInput>;\n\nexport const submissionInput = z.object({\n  text: z.string().max(SUBMISSION_TEXT_MAX).optional(),\n  fileIds: z.array(id).max(10).default([]),\n});\n\nexport const rubricScoreInput = z.object({\n  criterionId: id,\n  points: decimal(0, 1000, 'Points'),\n  comment: z.string().max(2000).optional(),\n});\n\nconst gradeFields = {\n  rawScore: decimal(0, 1200, 'Raw score').optional(),\n  feedback: z.string().max(FEEDBACK_MAX).optional(),\n  rubricScores: z.array(rubricScoreInput).max(20).optional(),\n  return: z.boolean().default(false),\n};\n\nexport const gradeInput = z.object({ ...gradeFields, penaltyPercent: decimal(0, 100, 'Penalty') });\nexport const offlineGradeInput = z.object({ ...gradeFields, studentId: id });\nexport type GradeInput = z.output<typeof gradeInput>;\nexport type OfflineGradeInput = z.output<typeof offlineGradeInput>;\n\nexport const bulkReturnInput = z.object({ submissionIds: z.array(id).max(500).optional() });\nexport const duplicateInput = z.object({ courseIds: z.array(id).min(1, 'Choose at least one course').max(50) });\nexport const exemptionInput = z.object({ reason: z.string().trim().max(500).optional() });\n\nexport const meAssignmentsQuery = z.object({\n  studentId: id.optional(),\n  tab: z.enum(STUDENT_TABS).optional(),\n  courseId: id.optional(),\n});\n\nexport const studentQuery = z.object({ studentId: id.optional() });\n\nexport const rosterQuery = z.object({\n  sort: z.enum(['name', 'submittedAt']).default('name'),\n  status: z.enum(CHIP_STATUSES).optional(),\n});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JpZoi2PcUKD4uCqhUFCCKq","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
