{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012TxADmgtnafmRbJ3k2F34f","type":"tool_result","content":"1\timport { PrismaClient } from '@prisma/client';\n2\t\n3\tconst prisma = new PrismaClient();\n4\t\n5\t/**\n6\t * Idempotent: upsert on the fixed \"singleton\" id, so re-running the seed\n7\t * never creates a duplicate SchoolSettings row.\n8\t */\n9\tasync function main() {\n10\t  await prisma.schoolSettings.upsert({\n11\t    where: { id: 'singleton' },\n12\t    update: {},\n13\t    create: {\n14\t      id: 'singleton',\n15\t      name: 'SchoolHub Academy',\n16\t      shortName: 'SchoolHub',\n17\t      timezone: 'America/New_York',\n18\t      city: 'Springfield',\n19\t      country: 'USA',\n20\t      phone: '+1 555 0100',\n21\t      email: 'office@schoolhub.test',\n22\t    },\n23\t  });\n24\t\n25\t  const year = await prisma.academicYear.upsert({\n26\t    where: { name: '2026-2027' },\n27\t    update: { isCurrent: true },\n28\t    create: {\n29\t      name: '2026-2027',\n30\t      startDate: new Date('2026-08-17'),\n31\t      endDate: new Date('2027-06-11'),\n32\t      isCurrent: true,\n33\t    },\n34\t  });\n35\t\n36\t  const semesters: { name: string; startDate: string; endDate: string; order: number }[] = [\n37\t    { name: 'Semester 1', startDate: '2026-08-17', endDate: '2027-01-15', order: 1 },\n38\t    { name: 'Semester 2', startDate: '2027-01-18', endDate: '2027-06-11', order: 2 },\n39\t  ];\n40\t  for (const term of semesters) {\n41\t    await prisma.term.upsert({\n42\t      where: { academicYearId_name: { academicYearId: year.id, name: term.name } },\n43\t      update: {},\n44\t      create: {\n45\t        academicYearId: year.id,\n46\t        name: term.name,\n47\t        startDate: new Date(term.startDate),\n48\t        endDate: new Date(term.endDate),\n49\t        order: term.order,\n50\t      },\n51\t    });\n52\t  }\n53\t\n54\t  const gradeLevels = [\n55\t    { name: 'Grade 6', shortName: 'G6', order: 1 },\n56\t    { name: