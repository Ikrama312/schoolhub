{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JqH6fSi2eFLtCKp8PPXts3","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { useCallback, useMemo, useRef, useState } from 'react';\n4\timport Snackbar from '@mui/material/Snackbar';\n5\timport Alert from '@mui/material/Alert';\n6\timport { ToastContext, type ToastOptions } from './useToast';\n7\t\n8\tconst AUTO_HIDE_MS = 5000;\n9\t\n10\tinterface QueuedToast extends ToastOptions {\n11\t  key: number;\n12\t}\n13\t\n14\t/**\n15\t * Single Snackbar+Alert, one toast visible at a time. New toasts queue up;\n16\t * the next one shows only after the current one has fully exited (avoids\n17\t * overlapping animations / stacked toasts).\n18\t */\n19\texport function ToastProvider({ children }: { children: React.ReactNode }) {\n20\t  const [queue, setQueue] = useState<QueuedToast[]>([]);\n21\t  const [open, setOpen] = useState(false);\n22\t  const nextKey = useRef(0);\n23\t\n24\t  const showToast = useCallback((options: ToastOptions) => {\n25\t    nextKey.current += 1;\n26\t    setQueue((prev) => [...prev, { ...options, key: nextKey.current }]);\n27\t    setOpen(true);\n28\t  }, []);\n29\t\n30\t  const current = queue[0];\n31\t\n32\t  const handleClose = (_event?: unknown, reason?: string) => {\n33\t    if (reason === 'clickaway') return;\n34\t    setOpen(false);\n35\t  };\n36\t\n37\t  const handleExited = () => {\n38\t    setQueue((prev) => prev.slice(1));\n39\t  };\n40\t\n41\t  const value = useMemo(() => ({ showToast }), [showToast]);\n42\t\n43\t  return (\n44\t    <ToastContext.Provider value={value}>\n45\t      {children}\n46\t      <Snackbar\n47\t        key={current?.key}\n48\t        open={open && Boolean(current)}\n49\t        autoHideDuration={AUTO_HIDE_MS}\n50\t        onClose={handleClose}\n51\t        TransitionProps={{ onExited: handleExited }}\n52\t        anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}\n53\t      >\n54\t        {current ? (\n55\t          <Alert onClose={handleClose} severity={current.severity ?? 'info'} variant=\"filled\" sx={{ width: '100%' }}>\n56\t            {current.message}\n57\t          </Alert>\n58\t        ) : undefined}\n59\t      </Snackbar>\n60\t    </ToastContext.Provider>\n61\t  );\n62\t}\n63\t"}]},"parent_tool_use_id":null,"session_id":"43ee4874-357a-422b-8be6-0da1e9096cfe","uuid":"12d69ced-f1fa-40ae-bee9-128e0f39f462","timestamp":"2026-10-16T15:28:19.848Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/Toast/ToastProvider.tsx","content":"'use client';\n\nimport { useCallback, useMemo, useRef, useState } from 'react';\nimport Snackbar from '@mui/material/Snackbar';\nimport Alert from '@mui/material/Alert';\nimport { ToastContext, type ToastOptions } from './useToast';\n\nconst AUTO_HIDE_MS = 5000;\n\ninterface QueuedToast extends ToastOptions {\n  key: number;\n}\n\n/**\n * Single Snackbar+Alert, one toast visible at a time. New toasts queue up;\n * the next one shows only after the current one has fully exited (avoids\n * overlapping animations / stacked toasts).\n */\nexport function ToastProvider({ children }: { children: React.ReactNode }) {\n  const [queue, setQueue] = useState<QueuedToast[]>([]);\n  const [open, setOpen] = useState(false);\n  const nextKey = useRef(0);\n\n  const showToast = useCallback((options: ToastOptions) => {\n    nextKey.current += 1;\n    setQueue((prev) => [...prev, { ...options, key: nextKey.current }]);\n    setOpen(true);\n  }, []);\n\n  const current = queue[0];\n\n  const handleClose = (_event?: unknown, reason?: string) => {\n    if (reason === 'clickaway') return;\n    setOpen(false);\n  };\n\n  const handleExited = () => {\n    setQueue((prev) => prev.slice(1));\n  };\n\n  const value = useMemo(() => ({ showToast }), [showToast]);\n\n  return (\n    <ToastContext.Provider value={value}>\n      {children}\n      <Snackbar\n        key={current?.key}\n        open={open && Boolean(current)}\n        autoHideDuration={AUTO_HIDE_MS}\n        onClose={handleClose}\n        TransitionProps={{ onExited: handleExited }}\n        anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}\n      >\n        {current ? (\n          <Alert onClose={handleClose} severity={current.severity ?? 'info'} variant=\"filled\" sx={{ width: '100%' }}>\n            {current.message}\n          </Alert>\n        ) : undefined}\n      </Snackbar>\n    </ToastContext.Provider>\n  );\n}\n","numLines":63,"startLine":1,"totalLines":63}}}
