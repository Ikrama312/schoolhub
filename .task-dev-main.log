owToast({ message: json?.error?.message ?? 'Could not duplicate.', severity: 'error' });\n185\t      return;\n186\t    }\n187\t    showToast({ message: `Copied as a draft to ${dupTargets.length} course${dupTargets.length === 1 ? '' : 's'}`, severity: 'success' });\n188\t    setDupOpen(false);\n189\t    setDupTargets([]);\n190\t  }\n191\t\n192\t  async function remove() {\n193\t    if (!initial) return;\n194\t    const res = await fetch(`/api/assignments/${initial.id}`, { method: 'DELETE' });\n195\t    const json = await res.json().catch(() => ({}));\n196\t    setDeleteOpen(false);\n197\t    if (!res.ok) {\n198\t      showToast({ message: json?.error?.message ?? 'Could not delete.', severity: 'error' });\n199\t      return;\n200\t    }\n201\t    showToast({ message: json.data.result === 'archived' ? 'Assignment archived' : 'Assignment deleted', severity: 'success' });\n202\t    router.push(`/courses/${courseId}/assignments`);\n203\t    router.refresh();\n204\t  }\n205\t\n206\t  const submitAs = (status: Status) => handleSubmit((v) => save(v, status));\n207\t  const err = (name: keyof FormValues) => formState.errors[name]?.message;\n208\t  const pickerSlot = (name: keyof FormValues, helper?: string) => ({\n209\t    textField: { fullWidth: true, error: !!err(name), helperText: err(name) ?? helper },\n210\t  });\n211\t\n212\t  return (\n213\t    <Box component=\"form\" noValidate onSubmit={(e) => e.preventDefault()}>\n214\t      {reviewBanner && (\n215\t        <Alert severity=\"info\" sx={{ mb: 2 }} action={<Button component={NextLink} href={`/courses/${courseId}/assignments/${initial?.id}/grade`} color=\"inherit\" size=\"small\">Review grades</Button>}>\n216\t          Max points changed. Existing scores were kept — review grades for this assignment.\n217\t        </Alert>\n218\t      )}\n219\t      {editingWithWork && (\n220\t        <Alert severity=\"warning\" sx={{ mb: 2 }}>\n221\t          {submissionCount} student{submissionCount === 1 ? ' has' : 's have'} alread