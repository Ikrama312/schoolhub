{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JkVVY2WfiKXJcBq2usdBNk","type":"tool_result","content":"1\timport Avatar from '@mui/material/Avatar';\n2\t\n3\texport interface UserAvatarProps {\n4\t  userId: string;\n5\t  name: string;\n6\t  size?: number;\n7\t}\n8\t\n9\tconst PALETTE = ['#4F46E5', '#0EA5E9', '#15803D', '#B45309', '#B91C1C', '#7C3AED', '#0D9488'];\n10\t\n11\tfunction colorForId(id: string): string {\n12\t  let hash = 0;\n13\t  for (let i = 0; i < id.length; i += 1) {\n14\t    hash = (hash * 31 + id.charCodeAt(i)) | 0;\n15\t  }\n16\t  return PALETTE[Math.abs(hash) % PALETTE.length];\n17\t}\n18\t\n19\tfunction initialsFor(name: string): string {\n20\t  const parts = name.trim().split(/\\s+/).filter(Boolean);\n21\t  if (parts.length === 0) return '?';\n22\t  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n23\t  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n24\t}\n25\t\n26\t/** Avatar with initials on a deterministic background colour derived from userId. */\n27\texport function UserAvatar({ userId, name, size = 32 }: UserAvatarProps) {\n28\t  return (\n29\t    <Avatar sx={{ bgcolor: colorForId(userId), width: size, height: size, fontSize: size * 0.4 }}>\n30\t      {initialsFor(name)}\n31\t    </Avatar>\n32\t  );\n33\t}\n34\t"}]},"parent_tool_use_id":null,"session_id":"58cb2461-07a2-4908-85eb-953f83a6620f","uuid":"f42a605a-7a71-4afd-8ba7-8bf3b23717ed","timestamp":"2026-10-19T09:41:49.590Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/UserAvatar/UserAvatar.tsx","content":"import Avatar from '@mui/material/Avatar';\n\nexport interface UserAvatarProps {\n  userId: string;\n  name: string;\n  size?: number;\n}\n\nconst PALETTE = ['#4F46E5', '#0EA5E9', '#15803D', '#B45309', '#B91C1C', '#7C3AED', '#0D9488'];\n\nfunction colorForId(id: string): string {\n  let hash = 0;\n  for (let i = 0; i < id.length; i += 1) {\n    hash = (hash * 31 + id.charCodeAt(i)) | 0;\n  }\n  return PALETTE[Math.abs(hash) % PALETTE.length];\n}\n\nfunction initialsFor(name: string): string {\n  const parts = name.trim().split(/\\s+/).filter(Boolean);\n  if (parts.length === 0) return '?';\n  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n}\n\n/** Avatar with initials on a deterministic background colour derived from userId. */\nexport function UserAvatar({ userId, name, size = 32 }: UserAvatarProps) {\n  return (\n    <Avatar sx={{ bgcolor: colorForId(userId), width: size, height: size, fontSize: size * 0.4 }}>\n      {initialsFor(name)}\n    </Avatar>\n  );\n}\n","numLines":34,"startLine":1,"totalLines":34}}}
