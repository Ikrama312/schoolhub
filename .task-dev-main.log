{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VY1tQytPgDtLTqefr9JYEH","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { useState } from 'react';\n4\timport Dialog from '@mui/material/Dialog';\n5\timport DialogTitle from '@mui/material/DialogTitle';\n6\timport DialogContent from '@mui/material/DialogContent';\n7\timport DialogContentText from '@mui/material/DialogContentText';\n8\timport DialogActions from '@mui/material/DialogActions';\n9\timport Button from '@mui/material/Button';\n10\timport CircularProgress from '@mui/material/CircularProgress';\n11\t\n12\texport interface ConfirmDialogProps {\n13\t  open: boolean;\n14\t  title: string;\n15\t  description?: string;\n16\t  destructive?: boolean;\n17\t  confirmLabel?: string;\n18\t  cancelLabel?: string;\n19\t  onConfirm: () => void | Promise<void>;\n20\t  onCancel: () => void;\n21\t}\n22\t\n23\texport function ConfirmDialog({\n24\t  open,\n25\t  title,\n26\t  description,\n27\t  destructive,\n28\t  confirmLabel = 'Confirm',\n29\t  cancelLabel = 'Cancel',\n30\t  onConfirm,\n31\t  onCancel,\n32\t}: ConfirmDialogProps) {\n33\t  const [pending, setPending] = useState(false);\n34\t\n35\t  const handleConfirm = async () => {\n36\t    setPending(true);\n37\t    try {\n38\t      await onConfirm();\n39\t    } finally {\n40\t      setPending(false);\n41\t    }\n42\t  };\n43\t\n44\t  return (\n45\t    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n46\t      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n47\t      {description && (\n48\t        <DialogContent>\n49\t          <DialogContentText>{description}</DialogContentText>\n50\t        </DialogContent>\n51\t      )}\n52\t      <DialogActions>\n53\t        <Button onClick={onCancel} disabled={pending}>\n54\t          {cancelLabel}\n55\t        </Button>\n56\t        <Button\n57\t          onClick={handleConfirm}\n58\t          color={destructive ? 'error' : 'primary'}\n59\t          variant=\"contained\"\n60\t          disabled={pending}\n61\t          startIcon={pending ? <CircularProgress size={16} color=\"inherit\" /> : undefined}\n62\t        >\n63\t          {confirmLabel}\n64\t        </Button>\n65\t      </DialogActions>\n66\t    </Dialog>\n67\t  );\n68\t}\n69\t"}]},"parent_tool_use_id":null,"session_id":"a1a784f8-378b-420c-a5fd-aba631abc12f","uuid":"15d8c67e-1926-4978-9a64-4f48bc51a65c","timestamp":"2026-10-19T08:58:03.818Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/ConfirmDialog/ConfirmDialog.tsx","content":"'use client';\n\nimport { useState } from 'react';\nimport Dialog from '@mui/material/Dialog';\nimport DialogTitle from '@mui/material/DialogTitle';\nimport DialogContent from '@mui/material/DialogContent';\nimport DialogContentText from '@mui/material/DialogContentText';\nimport DialogActions from '@mui/material/DialogActions';\nimport Button from '@mui/material/Button';\nimport CircularProgress from '@mui/material/CircularProgress';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  title: string;\n  description?: string;\n  destructive?: boolean;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  onConfirm: () => void | Promise<void>;\n  onCancel: () => void;\n}\n\nexport function ConfirmDialog({\n  open,\n  title,\n  description,\n  destructive,\n  confirmLabel = 'Confirm',\n  cancelLabel = 'Cancel',\n  onConfirm,\n  onCancel,\n}: ConfirmDialogProps) {\n  const [pending, setPending] = useState(false);\n\n  const handleConfirm = async () => {\n    setPending(true);\n    try {\n      await onConfirm();\n    } finally {\n      setPending(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onClose={pending ? undefined : onCancel} aria-labelledby=\"confirm-dialog-title\">\n      <DialogTitle id=\"confirm-dialog-title\">{title}</DialogTitle>\n      {description && (\n        <DialogContent>\n          <DialogContentText>{description}</DialogContentText>\n        </DialogContent>\n      )}\n      <DialogActions>\n        <Button onClick={onCancel} disabled={pending}>\n          {cancelLabel}\n        </Button>\n        <Button\n          onClick={handleConfirm}\n          color={destructive ? 'error' : 'primary'}\n          variant=\"contained\"\n          disabled={pending}\n          startIcon={pending ? <CircularProgress size={16} color=\"inherit\" /> : undefined}\n        >\n          {confirmLabel}\n        </Button>\n      </DialogActions>\n    </Dialog>\n  );\n}\n","numLines":69,"startLine":1,"totalLines":69}}}
