ostgreSQL database \"schoolhub\", schema \"public\" at \"localhost:5433\"\n\n5 migrations found in prisma/migrations\n\nDatabase schema is up to date!\nsrc/app/(app)/admin/sections/page.tsx:2:import { requirePageRole } from '@/server/auth/requireRole';\nsrc/app/(app)/admin/sections/page.tsx:11:  await requirePageRole('ADMIN');\nsrc/app/(app):\naccount\nadmin\ncourses\ndashboard\nlayout.tsx\nmy-courses\nnotifications\nshell.tsx\nstudents\n\nsrc/app/(app)/admin/courses:\n[id]\nCoursesClient.tsx\npage.tsx\n\nsrc/app/(app)/admin/email-log:\nEmailLogTable.tsx\npage.tsx\n\nsrc/app/(app)/admin/sections:\n[id]\npage.tsx\nSectionsClient.tsx\n\nsrc/app/(app)/courses/[courseId]:\nCourseTabs.tsx\nlayout.tsx\npage.tsx\nroster\n\nsrc/app/(app)/students/[id]:\ncourses\n\nsrc/components/ConfirmDialog:\nConfirmDialog.tsx\n\nsrc/components/DataTable:\nDataTable.tsx\n\nsrc/components/DateDisplay:\nDateDisplay.tsx\n\nsrc/components/EmptyState:\nEmptyState.tsx\n\nsrc/components/FormField:\nFormField.tsx\n\nsrc/components/LoadingSkeleton:\nLoadingSkeleton.tsx\n\nsrc/components/NotificationBell:\nNotificationBell.tsx\n\nsrc/components/PageHeader:\nPageHeader.tsx\n\nsrc/components/PasswordChecklist:\nindex.ts\nPasswordChecklist.tsx\nSetPasswordForm.tsx\n\nsrc/components/StatCard:\nStatCard.tsx\n\nsrc/components/Toast:\nToastProvider.tsx\nuseToast.ts\n\nsrc/components/UserAvatar:\nUserAvatar.tsx\n\nsrc/components/UserPicker:\nUserPicker.tsx","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Q3e1k1DJxCK6ZFv4PBNgJh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
