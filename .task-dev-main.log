{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NfQttVCZ5jFwpFcx2HqWSe","type":"tool_result","content":"1\t{\n2\t  \"ticketId\": \"SH-11\",\n3\t  \"timestamp\": \"2026-11-09T17:45:00Z\",\n4\t  \"phase\": \"architect\",\n5\t  \"version\": \"1.0\",\n6\t\n7\t  \"conventions\": {\n8\t    \"basePath\": \"/api (existing SchoolHub convention, not /api/v1; route files live under src/app/api/**/route.ts). Requirement: FR-39, NFR-9.\",\n9\t    \"handlerPipeline\": \"withHandler → requireUser/requireRole → Zod schema from src/lib/validators/gradebook.ts → service in src/server/gradebook/ or src/server/report-cards/ → ok(data) / ok(data, {status: 201}). Requirement: FR-39, NFR-6.\",\n10\t    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. None of these endpoints is paginated: the largest list (report cards for one term, up to ~600 rows) must be complete so 'Publish all' / 'Print all' can act on the full filtered list.\",\n11\t    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } } from src/server/http.ts. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, INTERNAL 500.\",\n12\t    \"decimals\": \"Input: number | string with at most 2 decimals (same `decimal(min,max,label)` helper pattern as validators/assignments.ts). Output: points and weights are 2 dp strings via fixed2 (\\\"18.00\\\"). Computed percents are 1 dp strings rounded half-up once (\\\"78.0\\\"), or null when nothing counts. Requirement: NFR-1, FR-13.\",\n13\t    \"dates\": \"ISO 8601 UTC strings. Clients render with DateDisplay in SchoolSettings.timezone. Requirement: NFR-10.\",\n14\t    \"accessTerms\": \"manage = assertCanManageCourse (ADMIN, or TEACHER who teaches the course). view course = assertCanViewCourse. view student = assertCanViewStudent (self, linked parent, teacher of the student, homeroom teacher, ADMIN). Unauthorised access to a specific entity returns NOT_FOUND where the existing assert does so. Requirement: NFR-6, FR-39.\",\n15\t    \"privacy\": \"Student/parent-facing responses (GET /api/students/:id/grades, GET /api/report-cards with studentId, GET /api/report-cards/:id) never include hidden items, unreleased scores, updatedById or unpublished cards. Requirement: NFR-5, FR-42, FR-37.\"\n16\t  },\n17\t\n18\t  \"components\": {\n19\t    \"Decimal2In\": { \"oneOf\": [{ \"type\": \"number\" }, { \"type\": \"string\", \"pattern\": \"^\\\\d+(\\\\.\\\\d{1,2})?$\" }] },\n20\t    \"Decimal2Out\": { \"type\": \"string\", \"pattern\": \"^-?\\\\d+\\\\.\\\\d{2}$\", \"example\": \"18.00\" },\n21\t    \"Percent1Out\": { \"type\": [\"string\", \"null\"], \"pattern\": \"^\\\\d+\\\\.\\\\d$\", \"example\": \"78.0\" },\n22\t    \"Band\": {\n23\t      \"type\": \"object\",\n24\t      \"required\": [\"letter\", \"minPercent\"],\n25\t      \"properties\": {\n26\t        \"letter\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 5 },\n27\t        \"minPercent\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 100 },\n28\t        \"gpa\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 10, \"description\": \"Stored only, never computed (NFR-13).\" },\n29\t        \"descriptor\": { \"type\": \"string\", \"maxLength\": 100 }\n30\t      }\n31\t    },\n32\t    \"Bands\": {\n33\t      \"type\": \"array\",\n34\t      \"minItems\": 1,\n35\t      \"items\": { \"$ref\": \"#/components/Band\" },\n36\t      \"description\": \"bandsSchema: minPercent strictly descending, last band minPercent = 0, letters unique (case-sensitive). Server re-sorts nothing; out-of-order input is a VALIDATION_ERROR. Requirement: FR-16.\"\n37\t    },\n38\t    \"GradingScale\": {\n39\t      \"type\": \"object\",\n40\t      \"properties\": {\n41\t        \"id\": { \"type\": \"string\" },\n42\t        \"name\": { \"type\": \"string\" },\n43\t        \"isDefault\": { \"type\": \"boolean\" },\n44\t        \"bands\": { \"$ref\": \"#/components/Bands\" },\n45\t        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n46\t        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n47\t      }\n48\t    },\n49\t    \"GradeCategory\": {\n50\t      \"type\": \"object\",\n51\t      \"properties\": {\n52\t        \"id\": { \"type\": \"string\" },\n53\t        \"name\": { \"type\": \"string\" },\n54\t        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },\n55\t        \"dropLowest\": { \"type\": \"integer\", \"minimum\": 0 },\n56\t        \"order\": { \"type\": \"integer\" }\n57\t      }\n58\t    },\n59\t    \"GradeItem\": {\n60\t      \"type\": \"object\",\n61\t      \"properties\": {\n62\t        \"id\": { \"type\": \"string\" },\n63\t        \"courseId\": { \"type\": \"string\" },\n64\t        \"termId\": { \"type\": \"string\" },\n65\t        \"categoryId\": { \"type\": [\"string\", \"null\"] },\n66\t        \"title\": { \"type\": \"string\" },\n67\t        \"maxPoints\": { \"$ref\": \"#/components/Decimal2Out\" },\n68\t        \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n69\t        \"source\": { \"enum\": [\"ASSIGNMENT\", \"QUIZ\", \"MANUAL\"] },\n70\t        \"sourceId\": { \"type\": [\"string\", \"null\"] },\n71\t        \"isVisible\": { \"type\": \"boolean\" }\n72\t      }\n73\t    },\n74\t    \"Grade\": {\n75\t      \"type\": \"object\",\n76\t      \"description\": \"Teacher-facing grade cell. A student with no Grade row is returned as score null, excused false, missing false.\",\n77\t      \"properties\": {\n78\t        \"gradeItemId\": { \"type\": \"string\" },\n79\t        \"studentId\": { \"type\": \"string\" },\n80\t        \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },\n81\t        \"excused\": { \"type\": \"boolean\" },\n82\t        \"missing\": { \"type\": \"boolean\" },\n83\t        \"comment\": { \"type\": [\"string\", \"null\"] },\n84\t        \"updatedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n85\t      }\n86\t    },\n87\t    \"TermOverride\": {\n88\t      \"type\": \"object\",\n89\t      \"properties\": {\n90\t        \"percent\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },\n91\t        \"letter\": { \"type\": [\"string\", \"null\"] },\n92\t        \"teacherComment\": { \"type\": [\"string\", \"null\"] }\n93\t      }\n94\t    },\n95\t    \"CategoryResult\": {\n96\t      \"type\": \"object\",\n97\t      \"description\": \"id null = implicit 'Uncategorised' bucket (weight 0 when the course has categories, A8).\",\n98\t      \"properties\": {\n99\t        \"id\": { \"type\": [\"string\", \"null\"] },\n100\t        \"name\": { \"type\": \"string\" },\n101\t        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },\n102\t        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n103\t        \"earned\": { \"$ref\": \"#/components/Decimal2Out\" },\n104\t        \"possible\": { \"$ref\": \"#/components/Decimal2Out\" },\n105\t        \"droppedItemIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n106\t      }\n107\t    },\n108\t    \"StudentTermResult\": {\n109\t      \"type\": \"object\",\n110\t      \"description\": \"Output of grade-calc.computeStudentTerm, the single shared calculation (FR-10–FR-15). percent/letter are final (override applied); computed* are pre-override.\",\n111\t      \"properties\": {\n112\t        \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/CategoryResult\" } },\n113\t        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n114\t        \"letter\": { \"type\": [\"string\", \"null\"] },\n115\t        \"descriptor\": { \"type\": [\"string\", \"null\"] },\n116\t        \"computedPercent\": { \"$ref\": \"#/components/Percent1Out\" },\n117\t        \"computedLetter\": { \"type\": [\"string\", \"null\"] },\n118\t        \"overridden\": { \"type\": \"boolean\" },\n119\t        \"override\": { \"oneOf\": [{ \"$ref\": \"#/components/TermOverride\" }, { \"type\": \"null\" }] }\n120\t      }\n121\t    },\n122\t    \"TermRef\": {\n123\t      \"type\": \"object\",\n124\t      \"properties\": {\n125\t        \"id\": { \"type\": \"string\" },\n126\t        \"name\": { \"type\": \"string\" },\n127\t        \"startDate\": { \"type\": \"string\", \"format\": \"date\" },\n128\t        \"endDate\": { \"type\": \"string\", \"format\": \"date\" },\n129\t        \"isCurrent\": { \"type\": \"boolean\" }\n130\t      }\n131\t    },\n132\t    \"ReportCardSnapshotV1\": {\n133\t      \"type\": \"object\",\n134\t      \"description\": \"snapshotSchema in src/server/report-cards/snapshot.ts. Frozen at generation; never recomputed on read or print (FR-31).\",\n135\t      \"properties\": {\n136\t        \"v\": { \"const\": 1 },\n137\t        \"school\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"logoUrl\": { \"type\": [\"string\", \"null\"] } } },\n138\t        \"student\": { \"type\": \"object\", \"properties\": {\n139\t          \"name\": { \"type\": \"string\" }, \"admissionNumber\": { \"type\": [\"string\", \"null\"] },\n140\t          \"gradeLevel\": { \"type\": \"string\" }, \"section\": { \"type\": \"string\" }, \"homeroomTeacher\": { \"type\": [\"string\", \"null\"] } } },\n141\t        \"term\": { \"type\": \"object\", \"properties\": {\n142\t          \"name\": { \"type\": \"string\" }, \"startDate\": { \"type\": \"string\", \"format\": \"date\" },\n143\t          \"endDate\": { \"type\": \"string\", \"format\": \"date\" }, \"academicYear\": { \"type\": \"string\" } } },\n144\t        \"courses\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": {\n145\t          \"subject\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"teacher\": { \"type\": [\"string\", \"null\"] },\n146\t          \"percent\": { \"$ref\": \"#/components/Percent1Out\" }, \"letter\": { \"type\": [\"string\", \"null\"] },\n147\t          \"descriptor\": { \"type\": [\"string\", \"null\"] }, \"teacherComment\": { \"type\": [\"string\", \"null\"] },\n148\t          \"scaleName\": { \"type\": \"string\" } } } },\n149\t        \"attendance\": { \"type\": \"object\", \"properties\": {\n150\t          \"rate\": { \"type\": [\"string\", \"null\"], \"description\": \"Same formula as the existing attendance getReport consumers (B13).\" },\n151\t          \"absences\": { \"type\": \"integer\" }, \"lates\": { \"type\": \"integer\" },\n152\t          \"counts\": { \"type\": \"object\", \"additionalProperties\": { \"type\": \"integer\" } } } },\n153\t        \"scale\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },\n154\t        \"extraScales\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },\n155\t          \"description\": \"Course-specific scales used by any course on the card, for the legend.\" }\n156\t      }\n157\t    }\n158\t  },\n159\t\n160\t  \"endpoints\": [\n161\t    {\n162\t      \"method\": \"GET\",\n163\t      \"path\": \"/api/grading-scales\",\n164\t      \"description\": \"List all grading scales, default first then by name. Any authenticated user (requireUser).\",\n165\t      \"auth\": \"any authenticated user\",\n166\t      \"requestSchema\": {},\n167\t      \"responseSchema\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradingScale\" } },\n168\t      \"errors\": [\"UNAUTHENTICATED\"],\n169\t      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-39\"]\n170\t    },\n171\t    {\n172\t      \"method\": \"POST\",\n173\t      \"path\": \"/api/grading-scales\",\n174\t      \"description\": \"Create a scale (scaleSchema). If isDefault is true, the other scales' isDefault is cleared in the same transaction. If no scale exists yet, the new scale becomes the default whatever isDefault says. The partial unique index grading_scale_one_default is the backstop. Audit gradingScale.create. Returns 201.\",\n175\t      \"auth\": \"ADMIN\",\n176\t      \"requestSchema\": {\n177\t        \"type\": \"object\",\n178\t        \"required\": [\"name\", \"bands\"],\n179\t        \"properties\": {\n180\t          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n181\t          \"isDefault\": { \"type\": \"boolean\", \"default\": false },\n182\t          \"bands\": { \"$ref\": \"#/components/Bands\" }\n183\t        }\n184\t      },\n185\t      \"responseSchema\": { \"$ref\": \"#/components/GradingScale\" },\n186\t      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n187\t      \"requirementIds\": [\"FR-16\", \"FR-39\", \"NFR-13\"]\n188\t    },\n189\t    {\n190\t      \"method\": \"PATCH\",\n191\t      \"path\": \"/api/grading-scales/:id\",\n192\t      \"description\": \"Partial update. isDefault: true clears the other defaults in a transaction. isDefault: false on the current default is a VALIDATION_ERROR (make another scale default instead), so exactly one default always exists. Published report cards keep their embedded legend. Audit gradingScale.update with {old, new}.\",\n193\t      \"auth\": \"ADMIN\",\n194\t      \"requestSchema\": {\n195\t        \"type\": \"object\",\n196\t        \"minProperties\": 1,\n197\t        \"properties\": {\n198\t          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n199\t          \"isDefault\": { \"type\": \"boolean\" },\n200\t          \"bands\": { \"$ref\": \"#/components/Bands\" }\n201\t        }\n202\t      },\n203\t      \"responseSchema\": { \"$ref\": \"#/components/GradingScale\" },\n204\t      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n205\t      \"requirementIds\": [\"FR-16\", \"FR-39\"]\n206\t    },\n207\t    {\n208\t      \"method\": \"DELETE\",\n209\t      \"path\": \"/api/grading-scales/:id\",\n210\t      \"description\": \"Delete a scale. CONFLICT if it is the default or any Course.gradingScaleId references it (details: { courseCount }) (A11). Audit gradingScale.delete.\",\n211\t      \"auth\": \"ADMIN\",\n212\t      \"requestSchema\": {},\n213\t      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" } } },\n214\t      \"errors\": [\"CONFLICT\", \"FORBIDDEN\", \"NOT_FOUND\"],\n215\t      \"requirementIds\": [\"FR-16\", \"FR-39\"]\n216\t    },\n217\t    {\n218\t      \"method\": \"GET\",\n219\t      \"path\": \"/api/courses/:id/grade-categories\",\n220\t      \"description\": \"The course's categories ordered by `order`, plus its scale setting. gradingScaleId null means the school default; effectiveScale is the scale actually used.\",\n221\t      \"auth\": \"view course\",\n222\t      \"requestSchema\": {},\n223\t      \"responseSchema\": {\n224\t        \"type\": \"object\",\n225\t        \"properties\": {\n226\t          \"gradingScaleId\": { \"type\": [\"string\", \"null\"] },\n227\t          \"effectiveScale\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n228\t          \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeCategory\" } }\n229\t        }\n230\t      },\n231\t      \"errors\": [\"NOT_FOUND\", \"FORBIDDEN\"],\n232\t      \"requirementIds\": [\"FR-17\", \"FR-2\", \"FR-39\"]\n233\t    },\n234\t    {\n235\t      \"method\": \"PUT\",\n236\t      \"path\": \"/api/courses/:id/grade-categories\",\n237\t      \"description\": \"Replace the full category list in one transaction: rows with an id are updated, rows without one are created, and existing categories missing from the list are deleted (GradeItem/Assignment/Quiz.categoryId → null via SetNull). A non-empty list must total exactly 100 using dec(sum).eq(100); otherwise VALIDATION_ERROR with details { sum: \\\"90.00\\\" } so the UI can show 'Weights total 90 / 100'. An empty list is allowed (the course then uses points totals, FR-12). Names are unique within the request (case-insensitive). Ids must belong to this course (else VALIDATION_ERROR). If gradingScaleId is present it is set too (null = school default; an unknown id is VALIDATION_ERROR). Audit gradeCategories.replace with {old, new}. Returns the same shape as GET.\",\n238\t      \"auth\": \"manage\",\n239\t      \"requestSchema\": {\n240\t        \"type\": \"object\",\n241\t        \"required\": [\"categories\"],\n242\t        \"properties\": {\n243\t          \"categories\": {\n244\t            \"type\": \"array\",\n245\t            \"maxItems\": 20,\n246\t            \"items\": {\n247\t              \"type\": \"object\",\n248\t              \"required\": [\"name\", \"weightPercent\", \"order\"],\n249\t              \"properties\": {\n250\t                \"id\": { \"type\": \"string\" },\n251\t                \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 60 },\n252\t                \"weightPercent\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"minimum\": 0, \"maximum\": 100 },\n253\t                \"dropLowest\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 50, \"default\": 0 },\n254\t                \"order\": { \"type\": \"integer\", \"minimum\": 0 }\n255\t              }\n256\t            }\n257\t          },\n258\t          \"gradingScaleId\": { \"type\": [\"string\", \"null\"] }\n259\t        }\n260\t      },\n261\t      \"responseSchema\": { \"$ref\": \"#/endpoints/4/responseSchema\" },\n262\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n263\t      \"requirementIds\": [\"FR-17\", \"FR-40\", \"FR-2\", \"FR-12\", \"NFR-1\", \"NFR-4\"]\n264\t    },\n265\t    {\n266\t      \"method\": \"GET\",\n267\t      \"path\": \"/api/courses/:id/gradebook\",\n268\t      \"description\": \"Full gradebook for one term in one denormalised payload, loaded with the batched load.ts queries plus the submission/attempt lookups, and computed in memory (NFR-2: 35×80 < 800 ms). Query: termId (optional; defaults to the term containing today in the course's academic year, else the first term). format=csv returns text/csv (Content-Disposition: attachment; filename=\\\"<courseCode>-<termName>-gradebook.csv\\\") built with toCsv: columns Last name, First name, one per item ('<title> (/<max>)', cell = score | EX | M | blank), one per category average, Term %, Letter. That is the grid as displayed: same row order, and hidden items included as the teacher sees them. Students are active enrollments sorted by lastName, firstName. Items are sorted by category order, then dueAt (nulls last), then title. Each grade cell carries isLate and submissionId/attemptId for the late icon and click-through.\",\n269\t      \"auth\": \"manage\",\n270\t      \"requestSchema\": {\n271\t        \"query\": {\n272\t          \"termId\": { \"type\": \"string\" },\n273\t          \"format\": { \"enum\": [\"json\", \"csv\"], \"default\": \"json\" }\n274\t        }\n275\t      },\n276\t      \"responseSchema\": {\n277\t        \"type\": \"object\",\n278\t        \"properties\": {\n279\t          \"course\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n280\t          \"term\": { \"$ref\": \"#/components/TermRef\" },\n281\t          \"terms\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/TermRef\" } },\n282\t          \"scale\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },\n283\t          \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeCategory\" } },\n284\t          \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeItem\" } },\n285\t          \"rows\": {\n286\t            \"type\": \"array\",\n287\t            \"items\": {\n288\t              \"type\": \"object\",\n289\t              \"properties\": {\n290\t                \"student\": { \"type\": \"object\", \"properties\": {\n291\t                  \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" },\n292\t                  \"admissionNumber\": { \"type\": [\"string\", \"null\"] } } },\n293\t                \"cells\": {\n294\t                  \"type\": \"object\",\n295\t                  \"description\": \"Keyed by gradeItemId; every item has a cell.\",\n296\t                  \"additionalProperties\": {\n297\t                    \"allOf\": [{ \"$ref\": \"#/components/Grade\" }],\n298\t                    \"properties\": {\n299\t                      \"isLate\": { \"type\": \"boolean\" },\n300\t                      \"submissionId\": { \"type\": [\"string\", \"null\"], \"description\": \"ASSIGNMENT items: link to the existing submission grading page (FR-21).\" },\n301\t                      \"attemptId\": { \"type\": [\"string\", \"null\"], \"description\": \"QUIZ items: the attempt the score came from, by scoring policy.\" }\n302\t                    }\n303\t                  }\n304\t                },\n305\t                \"result\": { \"$ref\": \"#/components/StudentTermResult\" }\n306\t              }\n307\t            }\n308\t          }\n309\t        }\n310\t      },\n311\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n312\t      \"requirementIds\": [\"FR-18\", \"FR-19\", \"FR-21\", \"FR-24\", \"FR-25\", \"FR-15\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"NFR-2\", \"NFR-8\"]\n313\t    },\n314\t    {\n315\t      \"method\": \"POST\",\n316\t      \"path\": \"/api/courses/:id/grade-items\",\n317\t      \"description\": \"Create a MANUAL grade item (manualItemSchema). categoryId must belong to the course. termId must be a term of the course's academic year. Returns 201.\",\n318\t      \"auth\": \"manage\",\n319\t      \"requestSchema\": {\n320\t        \"type\": \"object\",\n321\t        \"required\": [\"title\", \"maxPoints\", \"termId\"],\n322\t        \"properties\": {\n323\t          \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 200 },\n324\t          \"categoryId\": { \"type\": [\"string\", \"null\"] },\n325\t          \"maxPoints\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"exclusiveMinimum\": 0, \"maximum\": 1000 },\n326\t          \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n327\t          \"termId\": { \"type\": \"string\" }\n328\t        }\n329\t      },\n330\t      \"responseSchema\": { \"$ref\": \"#/components/GradeItem\" },\n331\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n332\t      \"requirementIds\": [\"FR-22\", \"FR-39\"]\n333\t    },\n334\t    {\n335\t      \"method\": \"PATCH\",\n336\t      \"path\": \"/api/grade-items/:id\",\n337\t      \"description\": \"Update an item (itemPatchSchema). MANUAL items accept every field. ASSIGNMENT/QUIZ items accept only isVisible; any other field is a VALIDATION_ERROR ('Edit this item at its source'). isVisible: false hides the item from students/parents and removes it from calculation (FR-24). Sync changes isVisible only on source visibility transitions, so a teacher's hide survives source re-saves (A7). Lowering maxPoints below an existing score on a MANUAL item is a VALIDATION_ERROR.\",\n338\t      \"auth\": \"manage (via the item's course)\",\n339\t      \"requestSchema\": {\n340\t        \"type\": \"object\",\n341\t        \"minProperties\": 1,\n342\t        \"properties\": {\n343\t          \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 200 },\n344\t          \"categoryId\": { \"type\": [\"string\", \"null\"] },\n345\t          \"maxPoints\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"exclusiveMinimum\": 0, \"maximum\": 1000 },\n346\t          \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n347\t          \"termId\": { \"type\": \"string\" },\n348\t          \"isVisible\": { \"type\": \"boolean\" }\n349\t        }\n350\t      },\n351\t      \"responseSchema\": { \"$ref\": \"#/components/GradeItem\" },\n352\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n353\t      \"requirementIds\": [\"FR-9\", \"FR-24\", \"FR-22\", \"NFR-5\"]\n354\t    },\n355\t    {\n356\t      \"method\": \"DELETE\",\n357\t      \"path\": \"/api/grade-items/:id\",\n358\t      \"description\": \"Delete a MANUAL item; its grades cascade. Non-MANUAL items are a VALIDATION_ERROR, because deleting the source deletes them (FR-4). Audit gradeItem.delete with the item and its grades as `old`.\",\n359\t      \"auth\": \"manage (via the item's course)\",\n360\t      \"requestSchema\": {},\n361\t      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" } } },\n362\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n363\t      \"requirementIds\": [\"FR-9\", \"FR-22\", \"NFR-4\"]\n364\t    },\n365\t    {\n366\t      \"method\": \"POST\",\n367\t      \"path\": \"/api/grade-items/:id/mark-missing\",\n368\t      \"description\": \"Column action 'Set all ungraded to missing'. Requires item.dueAt to be set and now > dueAt (A5); otherwise VALIDATION_ERROR. For every actively enrolled student whose grade has score null, excused false and missing false (including students with no Grade row), sets missing = true in one transaction. Allowed on any source: it only touches rows with no score, so it never overrides a synced score (FR-9). A later sync that writes a score makes it count normally. One audit row grade.markMissing with { itemId, studentIds }. No notifications.\",\n369\t      \"auth\": \"manage (via the item's course)\",\n370\t      \"requestSchema\": {},\n371\t      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"updatedCount\": { \"type\": \"integer\" }, \"studentIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } } },\n372\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n373\t      \"requirementIds\": [\"FR-24\", \"FR-10\", \"NFR-4\", \"NFR-10\"]\n374\t    },\n375\t    {\n376\t      \"method\": \"PUT\",\n377\t      \"path\": \"/api/grade-items/:id/grades/:studentId\",\n378\t      \"description\": \"Upsert one grade cell (gradePutSchema; at least one field). MANUAL items: all fields; score must satisfy 0 ≤ score ≤ maxPoints. Grid keys map to E → {excused: true}, M → {missing: true}, Delete → {score: null, excused: false, missing: false}. ASSIGNMENT/QUIZ items: comment only; any other field is a VALIDATION_ERROR (FR-9). studentId must be actively enrolled in the item's course (else NOT_FOUND). Audit grade.update with {old, new} for every change. After commit, if the item is MANUAL and score went from null to a value, notifyStudentAndParents('grade.posted') once (A9). Returns the saved cell plus the student's recomputed term result so the grid refreshes the category and term columns.\",\n379\t      \"auth\": \"manage (via the item's course)\",\n380\t      \"requestSchema\": {\n381\t        \"type\": \"object\",\n382\t        \"minProperties\": 1,\n383\t        \"properties\": {\n384\t          \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2In\" }, { \"type\": \"null\" }] },\n385\t          \"excused\": { \"type\": \"boolean\" },\n386\t          \"missing\": { \"type\": \"boolean\" },\n387\t          \"comment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }\n388\t        }\n389\t      },\n390\t      \"responseSchema\": {\n391\t        \"type\": \"object\",\n392\t        \"properties\": {\n393\t          \"grade\": { \"$ref\": \"#/components/Grade\" },\n394\t          \"result\": { \"$ref\": \"#/components/StudentTermResult\" }\n395\t        }\n396\t      },\n397\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n398\t      \"requirementIds\": [\"FR-20\", \"FR-9\", \"FR-19\", \"FR-38\", \"NFR-4\", \"NFR-1\"]\n399\t    },\n400\t    {\n401\t      \"method\": \"PUT\",\n402\t      \"path\": \"/api/courses/:id/term-overrides/:studentId\",\n403\t      \"description\": \"Upsert a TermGradeOverride (termOverrideSchema). termId must be a term of the course's year. letter must exist in the course's effective scale (else VALIDATION_ERROR). Percent-only re-derives the letter from the scale (A12). Letter-only keeps the computed percent (FR-14, AC-6). Setting all three to null clears the override but keeps the row. studentId must be enrolled (else NOT_FOUND). Audit termOverride.upsert with {old, new}. Returns the override and the recomputed result.\",\n404\t      \"auth\": \"manage\",\n405\t      \"requestSchema\": {\n406\t        \"type\": \"object\",\n407\t        \"required\": [\"termId\"],\n408\t        \"properties\": {\n409\t          \"termId\": { \"type\": \"string\" },\n410\t          \"percent\": { \"oneOf\": [{ \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"minimum\": 0, \"maximum\": 100 }, { \"type\": \"null\" }] },\n411\t          \"letter\": { \"type\": [\"string\", \"null\"], \"maxLength\": 5 },\n412\t          \"teacherComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }\n413\t        }\n414\t      },\n415\t      \"responseSchema\": {\n416\t        \"type\": \"object\",\n417\t        \"properties\": {\n418\t          \"override\": { \"$ref\": \"#/components/TermOverride\" },\n419\t          \"result\": { \"$ref\": \"#/components/StudentTermResult\" }\n420\t        }\n421\t      },\n422\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n423\t      \"requirementIds\": [\"FR-23\", \"FR-14\", \"NFR-4\"]\n424\t    },\n425\t    {\n426\t      \"method\": \"GET\",\n427\t      \"path\": \"/api/students/:id/grades\",\n428\t      \"description\": \"Student/parent grades view for one term (default: current term). Optional courseId limits the response to one course (course Grades tab, FR-28). Only visible items are loaded (filtered in the query), and the calculation runs over those items, so totals match what is shown. Grade rows only ever hold released scores (sync gating), so no further score filtering is needed. Courses are the student's active enrollments in the term's academic year, ordered by course name. colour: ≥ 80 success (green), 60–79.9 warning (amber), < 60 error (red), null when percent is null. Whitelist serializer: no updatedById, no hidden items, no submission/attempt ids.\",\n429\t      \"auth\": \"view student\",\n430\t      \"requestSchema\": {\n431\t        \"query\": {\n432\t          \"termId\": { \"type\": \"string\" },\n433\t          \"courseId\": { \"type\": \"string\" }\n434\t        }\n435\t      },\n436\t      \"responseSchema\": {\n437\t        \"type\": \"object\",\n438\t        \"properties\": {\n439\t          \"student\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" } } },\n440\t          \"term\": { \"$ref\": \"#/components/TermRef\" },\n441\t          \"terms\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/TermRef\" } },\n442\t          \"courses\": {\n443\t            \"type\": \"array\",\n444\t            \"items\": {\n445\t              \"type\": \"object\",\n446\t              \"properties\": {\n447\t                \"course\": { \"type\": \"object\", \"properties\": {\n448\t                  \"id\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"teacherName\": { \"type\": [\"string\", \"null\"] } } },\n449\t                \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n450\t                \"letter\": { \"type\": [\"string\", \"null\"] },\n451\t                \"descriptor\": { \"type\": [\"string\", \"null\"] },\n452\t                \"colour\": { \"enum\": [\"success\", \"warning\", \"error\", null] },\n453\t                \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/CategoryResult\" } },\n454\t                \"items\": {\n455\t                  \"type\": \"array\",\n456\t                  \"items\": {\n457\t                    \"type\": \"object\",\n458\t                    \"properties\": {\n459\t                      \"id\": { \"type\": \"string\" },\n460\t                      \"title\": { \"type\": \"string\" },\n461\t                      \"categoryId\": { \"type\": [\"string\", \"null\"] },\n462\t                      \"categoryName\": { \"type\": \"string\" },\n463\t                      \"maxPoints\": { \"$ref\": \"#/components/Decimal2Out\" },\n464\t                      \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n465\t                      \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },\n466\t                      \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n467\t                      \"comment\": { \"type\": [\"string\", \"null\"] },\n468\t                      \"missing\": { \"type\": \"boolean\" },\n469\t                      \"excused\": { \"type\": \"boolean\" },\n470\t                      \"dropped\": { \"type\": \"boolean\" }\n471\t                    }\n472\t                  }\n473\t                }\n474\t              }\n475\t            }\n476\t          }\n477\t        }\n478\t      },\n479\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n480\t      \"requirementIds\": [\"FR-42\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-15\", \"NFR-5\", \"NFR-6\"]\n481\t    },\n482\t    {\n483\t      \"method\": \"GET\",\n484\t      \"path\": \"/api/report-cards\",\n485\t      \"description\": \"Two modes. (A) Without studentId: the admin/homeroom roster for a term. termId is required; gradeLevelId and sectionId are optional filters. ADMIN sees all sections. A TEACHER is limited to sections where Section.homeroomTeacherId = user (filters outside those return an empty list). Other roles get FORBIDDEN. Returns one row per active student in scope, including students with no card yet (status NOT_GENERATED), sorted by section then lastName. Warnings are computed in the same batched pass (NFR-3). (B) With studentId: the student's cards across terms (termId optional filter), newest term first, for the Report cards tab (FR-36). Access is view student. STUDENT/PARENT get PUBLISHED cards only. ADMIN and the student's teachers get all.\",\n486\t      \"auth\": \"(A) ADMIN, homeroom TEACHER; (B) view student\",\n487\t      \"requestSchema\": {\n488\t        \"query\": {\n489\t          \"termId\": { \"type\": \"string\", \"description\": \"Required in mode A.\" },\n490\t          \"gradeLevelId\": { \"type\": \"string\" },\n491\t          \"sectionId\": { \"type\": \"string\" },\n492\t          \"studentId\": { \"type\": \"string\" }\n493\t        }\n494\t      },\n495\t      \"responseSchema\": {\n496\t        \"oneOf\": [\n497\t          {\n498\t            \"title\": \"RosterRow[] (mode A)\",\n499\t            \"type\": \"array\",\n500\t            \"items\": {\n501\t              \"type\": \"object\",\n502\t              \"properties\": {\n503\t                \"student\": { \"type\": \"object\", \"properties\": {\n504\t                  \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" },\n505\t                  \"admissionNumber\": { \"type\": [\"string\", \"null\"] },\n506\t                  \"gradeLevel\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n507\t                  \"section\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } } },\n508\t                \"status\": { \"enum\": [\"NOT_GENERATED\", \"DRAFT\", \"PUBLISHED\"] },\n509\t                \"reportCard\": { \"oneOf\": [{ \"type\": \"null\" }, { \"type\": \"object\", \"properties\": {\n510\t                  \"id\": { \"type\": \"string\" }, \"generatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n511\t                  \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n512\t                  \"hasHomeroomComment\": { \"type\": \"boolean\" }, \"hasPrincipalComment\": { \"type\": \"boolean\" } } }] },\n513\t                \"warnings\": {\n514\t                  \"type\": \"array\",\n515\t                  \"items\": {\n516\t                    \"type\": \"object\",\n517\t                    \"properties\": {\n518\t                      \"type\": { \"enum\": [\"UNGRADED_ITEMS\", \"MISSING_TEACHER_COMMENT\"] },\n519\t                      \"courseId\": { \"type\": \"string\" },\n520\t                      \"courseCode\": { \"type\": \"string\" },\n521\t                      \"count\": { \"type\": \"integer\", \"description\": \"UNGRADED_ITEMS: visible, past-due items with no score that are neither missing nor excused.\" }\n522\t                    }\n523\t                  }\n524\t                }\n525\t              }\n526\t            }\n527\t          },\n528\t          {\n529\t            \"title\": \"StudentCard[] (mode B)\",\n530\t            \"type\": \"array\",\n531\t            \"items\": {\n532\t              \"type\": \"object\",\n533\t              \"properties\": {\n534\t                \"id\": { \"type\": \"string\" },\n535\t                \"term\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"academicYear\": { \"type\": \"string\" } } },\n536\t                \"status\": { \"enum\": [\"DRAFT\", \"PUBLISHED\"] },\n537\t                \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n538\t              }\n539\t            }\n540\t          }\n541\t        ]\n542\t      },\n543\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n544\t      \"requirementIds\": [\"FR-29\", \"FR-33\", \"FR-36\", \"FR-37\", \"NFR-3\", \"NFR-5\", \"NFR-6\"]\n545\t    },\n546\t    {\n547\t      \"method\": \"POST\",\n548\t      \"path\": \"/api/report-cards/generate\",\n549\t      \"description\": \"Build or refresh snapshots (generateSchema). Students not enrolled in the term's academic year are skipped. Missing cards are created as DRAFT (createMany skipDuplicates). Existing DRAFT cards get a new snapshot and generatedAt via updateMany WHERE status = 'DRAFT'. PUBLISHED cards are never touched (FR-31, AC-8). Comments on existing drafts are preserved. Batched loads, in-memory calc, writes in chunks of 100 (NFR-3: 600 × 8 < 30 s).\",\n550\t      \"auth\": \"ADMIN\",\n551\t      \"requestSchema\": {\n552\t        \"type\": \"object\",\n553\t        \"required\": [\"termId\", \"studentIds\"],\n554\t        \"properties\": {\n555\t          \"termId\": { \"type\": \"string\" },\n556\t          \"studentIds\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } }\n557\t        }\n558\t      },\n559\t      \"responseSchema\": {\n560\t        \"type\": \"object\",\n561\t        \"properties\": {\n562\t          \"created\": { \"type\": \"integer\" },\n563\t          \"refreshed\": { \"type\": \"integer\" },\n564\t          \"skippedPublished\": { \"type\": \"integer\" },\n565\t          \"skippedNotEnrolled\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n566\t        }\n567\t      },\n568\t      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n569\t      \"requirementIds\": [\"FR-30\", \"FR-31\", \"NFR-3\"]\n570\t    },\n571\t    {\n572\t      \"method\": \"GET\",\n573\t      \"path\": \"/api/report-cards/:id\",\n574\t      \"description\": \"One card for the review and print pages. assertCanViewReportCard: ADMIN; a TEACHER who teaches any course of the student or is their homeroom teacher; the STUDENT themselves or a linked PARENT only when status = PUBLISHED. Everyone else gets NOT_FOUND, so a 7B student cannot tell that Sam's card exists (FR-37, AC-7). The body comes from the snapshot only and is never recomputed. permissions tells the review page which fields to enable. publishedById is omitted for STUDENT/PARENT.\",\n575\t      \"auth\": \"assertCanViewReportCard\",\n576\t      \"requestSchema\": {},\n577\t      \"responseSchema\": {\n578\t        \"type\": \"object\",\n579\t        \"properties\": {\n580\t          \"id\": { \"type\": \"string\" },\n581\t          \"studentId\": { \"type\": \"string\" },\n582\t          \"termId\": { \"type\": \"string\" },\n583\t          \"status\": { \"enum\": [\"DRAFT\", \"PUBLISHED\"] },\n584\t          \"snapshot\": { \"$ref\": \"#/components/ReportCardSnapshotV1\" },\n585\t          \"homeroomComment\": { \"type\": [\"string\", \"null\"] },\n586\t          \"principalComment\": { \"type\": [\"string\", \"null\"] },\n587\t          \"generatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n588\t          \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n589\t          \"publishedById\": { \"type\": [\"string\", \"null\"] },\n590\t          \"permissions\": { \"type\": \"object\", \"properties\": {\n591\t            \"canEditHomeroomComment\": { \"type\": \"boolean\" },\n592\t            \"canEditPrincipalComment\": { \"type\": \"boolean\" },\n593\t            \"canPublish\": { \"type\": \"boolean\" } } }\n594\t        }\n595\t      },\n596\t      \"errors\": [\"NOT_FOUND\"],\n597\t      \"requirementIds\": [\"FR-37\", \"FR-32\", \"FR-35\", \"FR-36\", \"NFR-5\", \"NFR-11\"]\n598\t    },\n599\t    {\n600\t      \"method\": \"PATCH\",\n601\t      \"path\": \"/api/report-cards/:id\",\n602\t      \"description\": \"Edit comments (reportCardPatchSchema). Access is checked per field: homeroomComment needs ADMIN or the homeroom teacher of the student's section; principalComment needs ADMIN only. A field the caller may not edit is FORBIDDEN. Callers who cannot view the card get NOT_FOUND. Only DRAFT cards can be edited; PUBLISHED returns CONFLICT ('Unpublish to edit') (A13). Returns the same shape as GET.\",\n603\t      \"auth\": \"ADMIN; homeroom TEACHER (homeroomComment only)\",\n604\t      \"requestSchema\": {\n605\t        \"type\": \"object\",\n606\t        \"minProperties\": 1,\n607\t        \"properties\": {\n608\t          \"homeroomComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 },\n609\t          \"principalComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }\n610\t        }\n611\t      },\n612\t      \"responseSchema\": { \"$ref\": \"#/endpoints/16/responseSchema\" },\n613\t      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n614\t      \"requirementIds\": [\"FR-32\", \"FR-33\", \"NFR-6\"]\n615\t    },\n616\t    {\n617\t      \"method\": \"POST\",\n618\t      \"path\": \"/api/report-cards/publish\",\n619\t      \"description\": \"Publish one card or a bulk filtered list (publishSchema). Only DRAFT cards change: updateMany WHERE id IN ids AND status = 'DRAFT' sets status PUBLISHED, publishedAt = now and publishedById = user. Ids that are unknown or already published are returned in skippedIds. Audit reportCard.publish. After commit, notify report_card.published (defaultEmail true) to the student and linked parents for each published card.\",\n620\t      \"auth\": \"ADMIN\",\n621\t      \"requestSchema\": {\n622\t        \"type\": \"object\",\n623\t        \"required\": [\"ids\"],\n624\t        \"properties\": {\n625\t          \"ids\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } }\n626\t        }\n627\t      },\n628\t      \"responseSchema\": {\n629\t        \"type\": \"object\",\n630\t        \"properties\": {\n631\t          \"publishedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n632\t          \"skippedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n633\t        }\n634\t      },\n635\t      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n636\t      \"requirementIds\": [\"FR-34\", \"FR-38\"]\n637\t    },\n638\t    {\n639\t      \"method\": \"POST\",\n640\t      \"path\": \"/api/report-cards/unpublish\",\n641\t      \"description\": \"Unpublish (unpublishSchema; reason required). PUBLISHED cards return to DRAFT and publishedAt/publishedById are cleared (A13). Others are returned in skippedIds. One audit row reportCard.unpublish per card with {old, new, reason}. No notification.\",\n642\t      \"auth\": \"ADMIN\",\n643\t      \"requestSchema\": {\n644\t        \"type\": \"object\",\n645\t        \"required\": [\"ids\", \"reason\"],\n646\t        \"properties\": {\n647\t          \"ids\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } },\n648\t          \"reason\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 500 }\n649\t        }\n650\t      },\n651\t      \"responseSchema\": {\n652\t        \"type\": \"object\",\n653\t        \"properties\": {\n654\t          \"unpublishedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n655\t          \"skippedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n656\t        }\n657\t      },\n658\t      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n659\t      \"requirementIds\": [\"FR-34\", \"NFR-4\"]\n660\t    }\n661\t  ],\n662\t\n663\t  \"nonHttpContracts\": [\n664\t    { \"kind\": \"notification\", \"name\": \"grade.posted\", \"recipients\": \"STUDENT + linked PARENTs\", \"defaultEmail\": false, \"payload\": { \"courseId\": \"string\", \"gradeItemId\": \"string\", \"itemTitle\": \"string\" }, \"requirementIds\": [\"FR-38\"] },\n665\t    { \"kind\": \"notification\", \"name\": \"report_card.published\", \"recipients\": \"STUDENT + linked PARENTs\", \"defaultEmail\": true, \"payload\": { \"reportCardId\": \"string\", \"termName\": \"string\" }, \"requirementIds\": [\"FR-34\", \"FR-38\"] },\n666\t    { \"kind\": \"npm-script\", \"name\": \"gradebook:backfill\", \"command\": \"tsx scripts/gradebook-backfill.ts\", \"output\": \"logger.info summary { items, grades } and exit 0; idempotent\", \"requirementIds\": [\"FR-8\"] },\n667\t    { \"kind\": \"page\", \"name\": \"/report-cards/[id]/print and /report-cards/print?termId=&gradeLevelId=&sectionId=\", \"note\": \"Server components call report-card-service directly (no extra API). Same access as GET /api/report-cards/:id; bulk print renders PUBLISHED cards only.\", \"requirementIds\": [\"FR-35\", \"NFR-11\"] }\n668\t  ],\n669\t\n670\t  \"status\": \"complete\"\n671\t}\n672\t"}]},"parent_tool_use_id":null,"session_id":"c6f85ae0-4ad4-4d10-b797-6ff9d3e2b1f5","uuid":"2cb40e68-4555-4267-b6ce-0a6641a50e93","timestamp":"2026-11-09T12:15:29.089Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-11\",\n  \"timestamp\": \"2026-11-09T17:45:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api (existing SchoolHub convention, not /api/v1; route files live under src/app/api/**/route.ts). Requirement: FR-39, NFR-9.\",\n    \"handlerPipeline\": \"withHandler → requireUser/requireRole → Zod schema from src/lib/validators/gradebook.ts → service in src/server/gradebook/ or src/server/report-cards/ → ok(data) / ok(data, {status: 201}). Requirement: FR-39, NFR-6.\",\n    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. None of these endpoints is paginated: the largest list (report cards for one term, up to ~600 rows) must be complete so 'Publish all' / 'Print all' can act on the full filtered list.\",\n    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } } from src/server/http.ts. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, INTERNAL 500.\",\n    \"decimals\": \"Input: number | string with at most 2 decimals (same `decimal(min,max,label)` helper pattern as validators/assignments.ts). Output: points and weights are 2 dp strings via fixed2 (\\\"18.00\\\"). Computed percents are 1 dp strings rounded half-up once (\\\"78.0\\\"), or null when nothing counts. Requirement: NFR-1, FR-13.\",\n    \"dates\": \"ISO 8601 UTC strings. Clients render with DateDisplay in SchoolSettings.timezone. Requirement: NFR-10.\",\n    \"accessTerms\": \"manage = assertCanManageCourse (ADMIN, or TEACHER who teaches the course). view course = assertCanViewCourse. view student = assertCanViewStudent (self, linked parent, teacher of the student, homeroom teacher, ADMIN). Unauthorised access to a specific entity returns NOT_FOUND where the existing assert does so. Requirement: NFR-6, FR-39.\",\n    \"privacy\": \"Student/parent-facing responses (GET /api/students/:id/grades, GET /api/report-cards with studentId, GET /api/report-cards/:id) never include hidden items, unreleased scores, updatedById or unpublished cards. Requirement: NFR-5, FR-42, FR-37.\"\n  },\n\n  \"components\": {\n    \"Decimal2In\": { \"oneOf\": [{ \"type\": \"number\" }, { \"type\": \"string\", \"pattern\": \"^\\\\d+(\\\\.\\\\d{1,2})?$\" }] },\n    \"Decimal2Out\": { \"type\": \"string\", \"pattern\": \"^-?\\\\d+\\\\.\\\\d{2}$\", \"example\": \"18.00\" },\n    \"Percent1Out\": { \"type\": [\"string\", \"null\"], \"pattern\": \"^\\\\d+\\\\.\\\\d$\", \"example\": \"78.0\" },\n    \"Band\": {\n      \"type\": \"object\",\n      \"required\": [\"letter\", \"minPercent\"],\n      \"properties\": {\n        \"letter\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 5 },\n        \"minPercent\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 100 },\n        \"gpa\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 10, \"description\": \"Stored only, never computed (NFR-13).\" },\n        \"descriptor\": { \"type\": \"string\", \"maxLength\": 100 }\n      }\n    },\n    \"Bands\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": { \"$ref\": \"#/components/Band\" },\n      \"description\": \"bandsSchema: minPercent strictly descending, last band minPercent = 0, letters unique (case-sensitive). Server re-sorts nothing; out-of-order input is a VALIDATION_ERROR. Requirement: FR-16.\"\n    },\n    \"GradingScale\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"isDefault\": { \"type\": \"boolean\" },\n        \"bands\": { \"$ref\": \"#/components/Bands\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      }\n    },\n    \"GradeCategory\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"dropLowest\": { \"type\": \"integer\", \"minimum\": 0 },\n        \"order\": { \"type\": \"integer\" }\n      }\n    },\n    \"GradeItem\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"courseId\": { \"type\": \"string\" },\n        \"termId\": { \"type\": \"string\" },\n        \"categoryId\": { \"type\": [\"string\", \"null\"] },\n        \"title\": { \"type\": \"string\" },\n        \"maxPoints\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"source\": { \"enum\": [\"ASSIGNMENT\", \"QUIZ\", \"MANUAL\"] },\n        \"sourceId\": { \"type\": [\"string\", \"null\"] },\n        \"isVisible\": { \"type\": \"boolean\" }\n      }\n    },\n    \"Grade\": {\n      \"type\": \"object\",\n      \"description\": \"Teacher-facing grade cell. A student with no Grade row is returned as score null, excused false, missing false.\",\n      \"properties\": {\n        \"gradeItemId\": { \"type\": \"string\" },\n        \"studentId\": { \"type\": \"string\" },\n        \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },\n        \"excused\": { \"type\": \"boolean\" },\n        \"missing\": { \"type\": \"boolean\" },\n        \"comment\": { \"type\": [\"string\", \"null\"] },\n        \"updatedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n      }\n    },\n    \"TermOverride\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"percent\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },\n        \"letter\": { \"type\": [\"string\", \"null\"] },\n        \"teacherComment\": { \"type\": [\"string\", \"null\"] }\n      }\n    },\n    \"CategoryResult\": {\n      \"type\": \"object\",\n      \"description\": \"id null = implicit 'Uncategorised' bucket (weight 0 when the course has categories, A8).\",\n      \"properties\": {\n        \"id\": { \"type\": [\"string\", \"null\"] },\n        \"name\": { \"type\": \"string\" },\n        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n        \"earned\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"possible\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"droppedItemIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n      }\n    },\n    \"StudentTermResult\": {\n      \"type\": \"object\",\n      \"description\": \"Output of grade-calc.computeStudentTerm, the single shared calculation (FR-10–FR-15). percent/letter are final (override applied); computed* are pre-override.\",\n      \"properties\": {\n        \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/CategoryResult\" } },\n        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n        \"letter\": { \"type\": [\"string\", \"null\"] },\n        \"descriptor\": { \"type\": [\"string\", \"null\"] },\n        \"computedPercent\": { \"$ref\": \"#/components/Percent1Out\" },\n        \"computedLetter\": { \"type\": [\"string\", \"null\"] },\n        \"overridden\": { \"type\": \"boolean\" },\n        \"override\": { \"oneOf\": [{ \"$ref\": \"#/components/TermOverride\" }, { \"type\": \"null\" }] }\n      }\n    },\n    \"TermRef\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"startDate\": { \"type\": \"string\", \"format\": \"date\" },\n        \"endDate\": { \"type\": \"string\", \"format\": \"date\" },\n        \"isCurrent\": { \"type\": \"boolean\" }\n      }\n    },\n    \"ReportCardSnapshotV1\": {\n      \"type\": \"object\",\n      \"description\": \"snapshotSchema in src/server/report-cards/snapshot.ts. Frozen at generation; never recomputed on read or print (FR-31).\",\n      \"properties\": {\n        \"v\": { \"const\": 1 },\n        \"school\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"logoUrl\": { \"type\": [\"string\", \"null\"] } } },\n        \"student\": { \"type\": \"object\", \"properties\": {\n          \"name\": { \"type\": \"string\" }, \"admissionNumber\": { \"type\": [\"string\", \"null\"] },\n          \"gradeLevel\": { \"type\": \"string\" }, \"section\": { \"type\": \"string\" }, \"homeroomTeacher\": { \"type\": [\"string\", \"null\"] } } },\n        \"term\": { \"type\": \"object\", \"properties\": {\n          \"name\": { \"type\": \"string\" }, \"startDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"endDate\": { \"type\": \"string\", \"format\": \"date\" }, \"academicYear\": { \"type\": \"string\" } } },\n        \"courses\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": {\n          \"subject\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"teacher\": { \"type\": [\"string\", \"null\"] },\n          \"percent\": { \"$ref\": \"#/components/Percent1Out\" }, \"letter\": { \"type\": [\"string\", \"null\"] },\n          \"descriptor\": { \"type\": [\"string\", \"null\"] }, \"teacherComment\": { \"type\": [\"string\", \"null\"] },\n          \"scaleName\": { \"type\": \"string\" } } } },\n        \"attendance\": { \"type\": \"object\", \"properties\": {\n          \"rate\": { \"type\": [\"string\", \"null\"], \"description\": \"Same formula as the existing attendance getReport consumers (B13).\" },\n          \"absences\": { \"type\": \"integer\" }, \"lates\": { \"type\": \"integer\" },\n          \"counts\": { \"type\": \"object\", \"additionalProperties\": { \"type\": \"integer\" } } } },\n        \"scale\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },\n        \"extraScales\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },\n          \"description\": \"Course-specific scales used by any course on the card, for the legend.\" }\n      }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/grading-scales\",\n      \"description\": \"List all grading scales, default first then by name. Any authenticated user (requireUser).\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradingScale\" } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-39\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/grading-scales\",\n      \"description\": \"Create a scale (scaleSchema). If isDefault is true, the other scales' isDefault is cleared in the same transaction. If no scale exists yet, the new scale becomes the default whatever isDefault says. The partial unique index grading_scale_one_default is the backstop. Audit gradingScale.create. Returns 201.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"name\", \"bands\"],\n        \"properties\": {\n          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n          \"isDefault\": { \"type\": \"boolean\", \"default\": false },\n          \"bands\": { \"$ref\": \"#/components/Bands\" }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/components/GradingScale\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-16\", \"FR-39\", \"NFR-13\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/grading-scales/:id\",\n      \"description\": \"Partial update. isDefault: true clears the other defaults in a transaction. isDefault: false on the current default is a VALIDATION_ERROR (make another scale default instead), so exactly one default always exists. Published report cards keep their embedded legend. Audit gradingScale.update with {old, new}.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"properties\": {\n          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n          \"isDefault\": { \"type\": \"boolean\" },\n          \"bands\": { \"$ref\": \"#/components/Bands\" }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/components/GradingScale\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-16\", \"FR-39\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/grading-scales/:id\",\n      \"description\": \"Delete a scale. CONFLICT if it is the default or any Course.gradingScaleId references it (details: { courseCount }) (A11). Audit gradingScale.delete.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" } } },\n      \"errors\": [\"CONFLICT\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-16\", \"FR-39\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/grade-categories\",\n      \"description\": \"The course's categories ordered by `order`, plus its scale setting. gradingScaleId null means the school default; effectiveScale is the scale actually used.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"gradingScaleId\": { \"type\": [\"string\", \"null\"] },\n          \"effectiveScale\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n          \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeCategory\" } }\n        }\n      },\n      \"errors\": [\"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-17\", \"FR-2\", \"FR-39\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/courses/:id/grade-categories\",\n      \"description\": \"Replace the full category list in one transaction: rows with an id are updated, rows without one are created, and existing categories missing from the list are deleted (GradeItem/Assignment/Quiz.categoryId → null via SetNull). A non-empty list must total exactly 100 using dec(sum).eq(100); otherwise VALIDATION_ERROR with details { sum: \\\"90.00\\\" } so the UI can show 'Weights total 90 / 100'. An empty list is allowed (the course then uses points totals, FR-12). Names are unique within the request (case-insensitive). Ids must belong to this course (else VALIDATION_ERROR). If gradingScaleId is present it is set too (null = school default; an unknown id is VALIDATION_ERROR). Audit gradeCategories.replace with {old, new}. Returns the same shape as GET.\",\n      \"auth\": \"manage\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"categories\"],\n        \"properties\": {\n          \"categories\": {\n            \"type\": \"array\",\n            \"maxItems\": 20,\n            \"items\": {\n              \"type\": \"object\",\n              \"required\": [\"name\", \"weightPercent\", \"order\"],\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 60 },\n                \"weightPercent\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"minimum\": 0, \"maximum\": 100 },\n                \"dropLowest\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 50, \"default\": 0 },\n                \"order\": { \"type\": \"integer\", \"minimum\": 0 }\n              }\n            }\n          },\n          \"gradingScaleId\": { \"type\": [\"string\", \"null\"] }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/endpoints/4/responseSchema\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-17\", \"FR-40\", \"FR-2\", \"FR-12\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/gradebook\",\n      \"description\": \"Full gradebook for one term in one denormalised payload, loaded with the batched load.ts queries plus the submission/attempt lookups, and computed in memory (NFR-2: 35×80 < 800 ms). Query: termId (optional; defaults to the term containing today in the course's academic year, else the first term). format=csv returns text/csv (Content-Disposition: attachment; filename=\\\"<courseCode>-<termName>-gradebook.csv\\\") built with toCsv: columns Last name, First name, one per item ('<title> (/<max>)', cell = score | EX | M | blank), one per category average, Term %, Letter. That is the grid as displayed: same row order, and hidden items included as the teacher sees them. Students are active enrollments sorted by lastName, firstName. Items are sorted by category order, then dueAt (nulls last), then title. Each grade cell carries isLate and submissionId/attemptId for the late icon and click-through.\",\n      \"auth\": \"manage\",\n      \"requestSchema\": {\n        \"query\": {\n          \"termId\": { \"type\": \"string\" },\n          \"format\": { \"enum\": [\"json\", \"csv\"], \"default\": \"json\" }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"course\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n          \"term\": { \"$ref\": \"#/components/TermRef\" },\n          \"terms\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/TermRef\" } },\n          \"scale\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },\n          \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeCategory\" } },\n          \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeItem\" } },\n          \"rows\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"student\": { \"type\": \"object\", \"properties\": {\n                  \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" },\n                  \"admissionNumber\": { \"type\": [\"string\", \"null\"] } } },\n                \"cells\": {\n                  \"type\": \"object\",\n                  \"description\": \"Keyed by gradeItemId; every item has a cell.\",\n                  \"additionalProperties\": {\n                    \"allOf\": [{ \"$ref\": \"#/components/Grade\" }],\n                    \"properties\": {\n                      \"isLate\": { \"type\": \"boolean\" },\n                      \"submissionId\": { \"type\": [\"string\", \"null\"], \"description\": \"ASSIGNMENT items: link to the existing submission grading page (FR-21).\" },\n                      \"attemptId\": { \"type\": [\"string\", \"null\"], \"description\": \"QUIZ items: the attempt the score came from, by scoring policy.\" }\n                    }\n                  }\n                },\n                \"result\": { \"$ref\": \"#/components/StudentTermResult\" }\n              }\n            }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-18\", \"FR-19\", \"FR-21\", \"FR-24\", \"FR-25\", \"FR-15\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"NFR-2\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/grade-items\",\n      \"description\": \"Create a MANUAL grade item (manualItemSchema). categoryId must belong to the course. termId must be a term of the course's academic year. Returns 201.\",\n      \"auth\": \"manage\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"title\", \"maxPoints\", \"termId\"],\n        \"properties\": {\n          \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 200 },\n          \"categoryId\": { \"type\": [\"string\", \"null\"] },\n          \"maxPoints\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"exclusiveMinimum\": 0, \"maximum\": 1000 },\n          \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n          \"termId\": { \"type\": \"string\" }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/components/GradeItem\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-22\", \"FR-39\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/grade-items/:id\",\n      \"description\": \"Update an item (itemPatchSchema). MANUAL items accept every field. ASSIGNMENT/QUIZ items accept only isVisible; any other field is a VALIDATION_ERROR ('Edit this item at its source'). isVisible: false hides the item from students/parents and removes it from calculation (FR-24). Sync changes isVisible only on source visibility transitions, so a teacher's hide survives source re-saves (A7). Lowering maxPoints below an existing score on a MANUAL item is a VALIDATION_ERROR.\",\n      \"auth\": \"manage (via the item's course)\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"properties\": {\n          \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 200 },\n          \"categoryId\": { \"type\": [\"string\", \"null\"] },\n          \"maxPoints\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"exclusiveMinimum\": 0, \"maximum\": 1000 },\n          \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n          \"termId\": { \"type\": \"string\" },\n          \"isVisible\": { \"type\": \"boolean\" }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/components/GradeItem\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-9\", \"FR-24\", \"FR-22\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/grade-items/:id\",\n      \"description\": \"Delete a MANUAL item; its grades cascade. Non-MANUAL items are a VALIDATION_ERROR, because deleting the source deletes them (FR-4). Audit gradeItem.delete with the item and its grades as `old`.\",\n      \"auth\": \"manage (via the item's course)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-9\", \"FR-22\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/grade-items/:id/mark-missing\",\n      \"description\": \"Column action 'Set all ungraded to missing'. Requires item.dueAt to be set and now > dueAt (A5); otherwise VALIDATION_ERROR. For every actively enrolled student whose grade has score null, excused false and missing false (including students with no Grade row), sets missing = true in one transaction. Allowed on any source: it only touches rows with no score, so it never overrides a synced score (FR-9). A later sync that writes a score makes it count normally. One audit row grade.markMissing with { itemId, studentIds }. No notifications.\",\n      \"auth\": \"manage (via the item's course)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"updatedCount\": { \"type\": \"integer\" }, \"studentIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-24\", \"FR-10\", \"NFR-4\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/grade-items/:id/grades/:studentId\",\n      \"description\": \"Upsert one grade cell (gradePutSchema; at least one field). MANUAL items: all fields; score must satisfy 0 ≤ score ≤ maxPoints. Grid keys map to E → {excused: true}, M → {missing: true}, Delete → {score: null, excused: false, missing: false}. ASSIGNMENT/QUIZ items: comment only; any other field is a VALIDATION_ERROR (FR-9). studentId must be actively enrolled in the item's course (else NOT_FOUND). Audit grade.update with {old, new} for every change. After commit, if the item is MANUAL and score went from null to a value, notifyStudentAndParents('grade.posted') once (A9). Returns the saved cell plus the student's recomputed term result so the grid refreshes the category and term columns.\",\n      \"auth\": \"manage (via the item's course)\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"properties\": {\n          \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2In\" }, { \"type\": \"null\" }] },\n          \"excused\": { \"type\": \"boolean\" },\n          \"missing\": { \"type\": \"boolean\" },\n          \"comment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"grade\": { \"$ref\": \"#/components/Grade\" },\n          \"result\": { \"$ref\": \"#/components/StudentTermResult\" }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-20\", \"FR-9\", \"FR-19\", \"FR-38\", \"NFR-4\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/courses/:id/term-overrides/:studentId\",\n      \"description\": \"Upsert a TermGradeOverride (termOverrideSchema). termId must be a term of the course's year. letter must exist in the course's effective scale (else VALIDATION_ERROR). Percent-only re-derives the letter from the scale (A12). Letter-only keeps the computed percent (FR-14, AC-6). Setting all three to null clears the override but keeps the row. studentId must be enrolled (else NOT_FOUND). Audit termOverride.upsert with {old, new}. Returns the override and the recomputed result.\",\n      \"auth\": \"manage\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"termId\"],\n        \"properties\": {\n          \"termId\": { \"type\": \"string\" },\n          \"percent\": { \"oneOf\": [{ \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"minimum\": 0, \"maximum\": 100 }, { \"type\": \"null\" }] },\n          \"letter\": { \"type\": [\"string\", \"null\"], \"maxLength\": 5 },\n          \"teacherComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"override\": { \"$ref\": \"#/components/TermOverride\" },\n          \"result\": { \"$ref\": \"#/components/StudentTermResult\" }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-23\", \"FR-14\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/:id/grades\",\n      \"description\": \"Student/parent grades view for one term (default: current term). Optional courseId limits the response to one course (course Grades tab, FR-28). Only visible items are loaded (filtered in the query), and the calculation runs over those items, so totals match what is shown. Grade rows only ever hold released scores (sync gating), so no further score filtering is needed. Courses are the student's active enrollments in the term's academic year, ordered by course name. colour: ≥ 80 success (green), 60–79.9 warning (amber), < 60 error (red), null when percent is null. Whitelist serializer: no updatedById, no hidden items, no submission/attempt ids.\",\n      \"auth\": \"view student\",\n      \"requestSchema\": {\n        \"query\": {\n          \"termId\": { \"type\": \"string\" },\n          \"courseId\": { \"type\": \"string\" }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"student\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" } } },\n          \"term\": { \"$ref\": \"#/components/TermRef\" },\n          \"terms\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/TermRef\" } },\n          \"courses\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"course\": { \"type\": \"object\", \"properties\": {\n                  \"id\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"teacherName\": { \"type\": [\"string\", \"null\"] } } },\n                \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n                \"letter\": { \"type\": [\"string\", \"null\"] },\n                \"descriptor\": { \"type\": [\"string\", \"null\"] },\n                \"colour\": { \"enum\": [\"success\", \"warning\", \"error\", null] },\n                \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/CategoryResult\" } },\n                \"items\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"id\": { \"type\": \"string\" },\n                      \"title\": { \"type\": \"string\" },\n                      \"categoryId\": { \"type\": [\"string\", \"null\"] },\n                      \"categoryName\": { \"type\": \"string\" },\n                      \"maxPoints\": { \"$ref\": \"#/components/Decimal2Out\" },\n                      \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                      \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },\n                      \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n                      \"comment\": { \"type\": [\"string\", \"null\"] },\n                      \"missing\": { \"type\": \"boolean\" },\n                      \"excused\": { \"type\": \"boolean\" },\n                      \"dropped\": { \"type\": \"boolean\" }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-42\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-15\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/report-cards\",\n      \"description\": \"Two modes. (A) Without studentId: the admin/homeroom roster for a term. termId is required; gradeLevelId and sectionId are optional filters. ADMIN sees all sections. A TEACHER is limited to sections where Section.homeroomTeacherId = user (filters outside those return an empty list). Other roles get FORBIDDEN. Returns one row per active student in scope, including students with no card yet (status NOT_GENERATED), sorted by section then lastName. Warnings are computed in the same batched pass (NFR-3). (B) With studentId: the student's cards across terms (termId optional filter), newest term first, for the Report cards tab (FR-36). Access is view student. STUDENT/PARENT get PUBLISHED cards only. ADMIN and the student's teachers get all.\",\n      \"auth\": \"(A) ADMIN, homeroom TEACHER; (B) view student\",\n      \"requestSchema\": {\n        \"query\": {\n          \"termId\": { \"type\": \"string\", \"description\": \"Required in mode A.\" },\n          \"gradeLevelId\": { \"type\": \"string\" },\n          \"sectionId\": { \"type\": \"string\" },\n          \"studentId\": { \"type\": \"string\" }\n        }\n      },\n      \"responseSchema\": {\n        \"oneOf\": [\n          {\n            \"title\": \"RosterRow[] (mode A)\",\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"student\": { \"type\": \"object\", \"properties\": {\n                  \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" },\n                  \"admissionNumber\": { \"type\": [\"string\", \"null\"] },\n                  \"gradeLevel\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n                  \"section\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } } },\n                \"status\": { \"enum\": [\"NOT_GENERATED\", \"DRAFT\", \"PUBLISHED\"] },\n                \"reportCard\": { \"oneOf\": [{ \"type\": \"null\" }, { \"type\": \"object\", \"properties\": {\n                  \"id\": { \"type\": \"string\" }, \"generatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n                  \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                  \"hasHomeroomComment\": { \"type\": \"boolean\" }, \"hasPrincipalComment\": { \"type\": \"boolean\" } } }] },\n                \"warnings\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"type\": { \"enum\": [\"UNGRADED_ITEMS\", \"MISSING_TEACHER_COMMENT\"] },\n                      \"courseId\": { \"type\": \"string\" },\n                      \"courseCode\": { \"type\": \"string\" },\n                      \"count\": { \"type\": \"integer\", \"description\": \"UNGRADED_ITEMS: visible, past-due items with no score that are neither missing nor excused.\" }\n                    }\n                  }\n                }\n              }\n            }\n          },\n          {\n            \"title\": \"StudentCard[] (mode B)\",\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"term\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"academicYear\": { \"type\": \"string\" } } },\n                \"status\": { \"enum\": [\"DRAFT\", \"PUBLISHED\"] },\n                \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n              }\n            }\n          }\n        ]\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-29\", \"FR-33\", \"FR-36\", \"FR-37\", \"NFR-3\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/report-cards/generate\",\n      \"description\": \"Build or refresh snapshots (generateSchema). Students not enrolled in the term's academic year are skipped. Missing cards are created as DRAFT (createMany skipDuplicates). Existing DRAFT cards get a new snapshot and generatedAt via updateMany WHERE status = 'DRAFT'. PUBLISHED cards are never touched (FR-31, AC-8). Comments on existing drafts are preserved. Batched loads, in-memory calc, writes in chunks of 100 (NFR-3: 600 × 8 < 30 s).\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"termId\", \"studentIds\"],\n        \"properties\": {\n          \"termId\": { \"type\": \"string\" },\n          \"studentIds\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"created\": { \"type\": \"integer\" },\n          \"refreshed\": { \"type\": \"integer\" },\n          \"skippedPublished\": { \"type\": \"integer\" },\n          \"skippedNotEnrolled\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/report-cards/:id\",\n      \"description\": \"One card for the review and print pages. assertCanViewReportCard: ADMIN; a TEACHER who teaches any course of the student or is their homeroom teacher; the STUDENT themselves or a linked PARENT only when status = PUBLISHED. Everyone else gets NOT_FOUND, so a 7B student cannot tell that Sam's card exists (FR-37, AC-7). The body comes from the snapshot only and is never recomputed. permissions tells the review page which fields to enable. publishedById is omitted for STUDENT/PARENT.\",\n      \"auth\": \"assertCanViewReportCard\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": { \"type\": \"string\" },\n          \"studentId\": { \"type\": \"string\" },\n          \"termId\": { \"type\": \"string\" },\n          \"status\": { \"enum\": [\"DRAFT\", \"PUBLISHED\"] },\n          \"snapshot\": { \"$ref\": \"#/components/ReportCardSnapshotV1\" },\n          \"homeroomComment\": { \"type\": [\"string\", \"null\"] },\n          \"principalComment\": { \"type\": [\"string\", \"null\"] },\n          \"generatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n          \"publishedById\": { \"type\": [\"string\", \"null\"] },\n          \"permissions\": { \"type\": \"object\", \"properties\": {\n            \"canEditHomeroomComment\": { \"type\": \"boolean\" },\n            \"canEditPrincipalComment\": { \"type\": \"boolean\" },\n            \"canPublish\": { \"type\": \"boolean\" } } }\n        }\n      },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-37\", \"FR-32\", \"FR-35\", \"FR-36\", \"NFR-5\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/report-cards/:id\",\n      \"description\": \"Edit comments (reportCardPatchSchema). Access is checked per field: homeroomComment needs ADMIN or the homeroom teacher of the student's section; principalComment needs ADMIN only. A field the caller may not edit is FORBIDDEN. Callers who cannot view the card get NOT_FOUND. Only DRAFT cards can be edited; PUBLISHED returns CONFLICT ('Unpublish to edit') (A13). Returns the same shape as GET.\",\n      \"auth\": \"ADMIN; homeroom TEACHER (homeroomComment only)\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"properties\": {\n          \"homeroomComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 },\n          \"principalComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/endpoints/16/responseSchema\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n      \"requirementIds\": [\"FR-32\", \"FR-33\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/report-cards/publish\",\n      \"description\": \"Publish one card or a bulk filtered list (publishSchema). Only DRAFT cards change: updateMany WHERE id IN ids AND status = 'DRAFT' sets status PUBLISHED, publishedAt = now and publishedById = user. Ids that are unknown or already published are returned in skippedIds. Audit reportCard.publish. After commit, notify report_card.published (defaultEmail true) to the student and linked parents for each published card.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"ids\"],\n        \"properties\": {\n          \"ids\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"publishedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n          \"skippedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-34\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/report-cards/unpublish\",\n      \"description\": \"Unpublish (unpublishSchema; reason required). PUBLISHED cards return to DRAFT and publishedAt/publishedById are cleared (A13). Others are returned in skippedIds. One audit row reportCard.unpublish per card with {old, new, reason}. No notification.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"ids\", \"reason\"],\n        \"properties\": {\n          \"ids\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } },\n          \"reason\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 500 }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"unpublishedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n          \"skippedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-34\", \"NFR-4\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    { \"kind\": \"notification\", \"name\": \"grade.posted\", \"recipients\": \"STUDENT + linked PARENTs\", \"defaultEmail\": false, \"payload\": { \"courseId\": \"string\", \"gradeItemId\": \"string\", \"itemTitle\": \"string\" }, \"requirementIds\": [\"FR-38\"] },\n    { \"kind\": \"notification\", \"name\": \"report_card.published\", \"recipients\": \"STUDENT + linked PARENTs\", \"defaultEmail\": true, \"payload\": { \"reportCardId\": \"string\", \"termName\": \"string\" }, \"requirementIds\": [\"FR-34\", \"FR-38\"] },\n    { \"kind\": \"npm-script\", \"name\": \"gradebook:backfill\", \"command\": \"tsx scripts/gradebook-backfill.ts\", \"output\": \"logger.info summary { items, grades } and exit 0; idempotent\", \"requirementIds\": [\"FR-8\"] },\n    { \"kind\": \"page\", \"name\": \"/report-cards/[id]/print and /report-cards/print?termId=&gradeLevelId=&sectionId=\", \"note\": \"Server components call report-card-service directly (no extra API). Same access as GET /api/report-cards/:id; bulk print renders PUBLISHED cards only.\", \"requirementIds\": [\"FR-35\", \"NFR-11\"] }\n  ],\n\n  \"status\": \"complete\"\n}\n","numLines":672,"startLine":1,"totalLines":672}},"tool_result_meta":[{"id":"toolu_01NfQttVCZ5jFwpFcx2HqWSe","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
