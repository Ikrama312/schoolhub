oStudentTx(tx, input));\n}","originalFile":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { GuardianRelationship } from '@prisma/client';\n\nconst MAX_PARENTS_PER_STUDENT = 4;\n\nexport interface LinkParentToStudentInput {\n  studentId: string;\n  parentId: string;\n  relationship: GuardianRelationship;\n  isPrimary: boolean;\n}\n\n/**\n * The one writer of ParentStudentLink rows (FR-15/FR-16), called from the\n * student form, the parent form and the student-detail \"Family\" card alike\n * so the two invariants below are enforced exactly once:\n * - a student may have at most 4 linked parents\n * - at most one link per student is isPrimary (setting one clears the rest)\n */\nexport async function linkParentToStudent(input: LinkParentToStudentInput) {\n  return prisma.$transaction(async (tx) => {\n    const existingCount = await tx.parentStudentLink.count({ where: { studentId: input.studentId } });\n    if (existingCount >= MAX_PARENTS_PER_STUDENT) {\n      throw new AppError('VALIDATION_ERROR', `A student can have at most ${MAX_PARENTS_PER_STUDENT} linked parents.`);\n    }\n\n    if (input.isPrimary) {\n      await tx.parentStudentLink.updateMany({\n        where: { studentId: input.studentId },\n        data: { isPrimary: false },\n      });\n    }\n\n    return tx.parentStudentLink.create({\n      data: {\n        studentId: input.studentId,\n        parentId: input.parentId,\n        relationship: input.relationship,\n        isPrimary: input.isPrimary,\n      },\n    });\n  });\n}\n\nexport async function unlinkParentFromStudent(studentId: string, parentId: string) {\n  return prisma.parentStudentLink.deleteMany({ where: { studentId, parentId } });\n}\n\nexport async function listLinksForStudent(studentId: string) {\n  return prisma.parentStudentLink.findMany({\n    where: { studentId },\n    include: { parent: { select: { id: true, firstName: true, lastName: true } } },\n  });\n}\n\nexport async function listLinksForParent(parentId: string) {\n  return prisma.parentStudentLink.findMany({\n    where: { parentId },\n    include: { student: { select: { id: true, firstName: true, lastName: true } } },\n  });\n}\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":6,"lines":[" import { prisma } from '@/server/db';"," import { AppError } from '@/server/http';","-import type { GuardianRelationship } from '@prisma/client';","+import type { GuardianRelationship, Prisma } from '@prisma/client';"," "," const MAX_PARENTS_PER_STUDENT = 4;"," "]},{"oldStart":11,"oldLines":38,"newStart":11,"newLines":45,"lines":["   isPrimary: boolean;"," }"," ","+type TxClient = Prisma.TransactionClient;","+"," /**","- * The one writer of ParentStudentLink rows (FR-15/FR-16), called from the","- * student form, the parent form and the student-detail \"Family\" card alike","- * so the two invariants below are enforced exactly once:","+ * The invariant logic (FR-15/FR-16), operating on a caller-supplied","+ * transaction client. Callers that already hold an open transaction (e.g.","+ * users.ts's createUser, which writes the User + profile + links","+ * atomically) call this directly with their own `tx`; standalone callers","+ * use `linkParentToStudent` below, which opens its own transaction.","  * - a student may have at most 4 linked parents","  * - at most one link per student is isPrimary (setting one clears the rest)","  */","-export async function linkParentToStudent(input: LinkParentToStudentInput) {","-  return prisma.$transaction(async (tx) => {","-    const existingCount = await tx.parentStudentLink.count({ where: { studentId: input.studentId } });","-    if (existingCount >= MAX_PARENTS_PER_STUDENT) {","-      throw new AppError('VALIDATION_ERROR', `A student can have at most ${MAX_PARENTS_PER_STUDENT} linked parents.`);","-    }","+export async function linkParentToStudentTx(tx: TxClient, input: LinkParentToStudentInput) {","+  const existingCount = await tx.parentStudent