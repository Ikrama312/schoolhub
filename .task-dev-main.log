{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GnwzzT1Y4Pj2VabYQyCdAM","type":"tool_result","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\n// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\nexport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\n/** First x-forwarded-for entry (the client, behind our proxy), or null. */\nexport function getClientIp(request: Request): string | null {\n  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n}\n\nexport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\nimport type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { getClientIp } from '@/server/http';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n  request?: Request;\n}\n\n// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\nconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    const metadata = input.metadata\n      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n      : undefined;\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: metadata as Prisma.InputJsonValue | undefined,\n        ip: input.request ? getClientIp(input.request) : null,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nimport { formatInTimeZone } from 'date-fns-tz';\n\n/**\n * Formats a UTC date/ISO-string in the school's configured timezone\n * (SchoolSettings.timezone). pattern is a date-fns format string.\n */\nexport function formatInSchoolTz(\n  date: Date | string,\n  pattern: string,\n  timezone: string,\n): string {\n  const value = typeof date === 'string' ? new Date(date) : date;\n  return formatInTimeZone(value, timezone, pattern);\n}\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};\nsrc/server/audit.ts\nsrc/server/csv.ts\nsrc/server/db.ts\nsrc/server/http.ts\nsrc/server/rate-limit.ts\n\nsrc/lib/validators:\nauth.ts\ncourses.ts\nnotifications.ts\nsections.ts\nusers.ts\n\nsrc/server/auth:\nauth.config.ts\nauth.ts\ncommon-passwords.txt\ncourse-access.ts\ncredentials.ts\nemail.ts\npassword-policy.ts\nrequireRole.ts\nstudent-access.ts\ntokens.ts\n\nsrc/server/courses:\ncourses-service.ts\n\nsrc/server/email:\nadmin.ts\nbackoff.ts\ndispatch.ts\noutbox.ts\nrender.ts\ntemplates\ntransport.ts\n\nsrc/server/enrollment:\nroster-engine.ts\n\nsrc/server/notifications:\nnotify.ts\npreferences.ts\npurge.ts\nservice.ts\ntypes.ts\n\nsrc/server/sections:\nsections-service.ts\n\nsrc/server/services:\nacademicYears.ts\nauth.ts\ndateRange.ts\ngradeLevels.ts\nrooms.ts\nsettings.ts\nsubjects.ts\nterms.ts\nuserImport.ts\nuserLinks.ts\nusers.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n];\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/** Extension point for the student detail page; later PRDs register their tab here. */\nexport const studentTabs: StudentTab[] = [\n  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n];","is_error":false}]},"parent_tool_use_id":null,"session_id":"df25e571-0ce8-4c8c-9cc6-c89019e911c3","uuid":"eb3ba735-8f66-47b5-9573-db721f842fce","timestamp":"2026-11-05T05:23:52.921Z","tool_use_result":{"stdout":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\n// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\nexport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\n/** First x-forwarded-for entry (the client, behind our proxy), or null. */\nexport function getClientIp(request: Request): string | null {\n  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n}\n\nexport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\nimport type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { getClientIp } from '@/server/http';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n  request?: Request;\n}\n\n// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\nconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    const metadata = input.metadata\n      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n      : undefined;\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: metadata as Prisma.InputJsonValue | undefined,\n        ip: input.request ? getClientIp(input.request) : null,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nimport { formatInTimeZone } from 'date-fns-tz';\n\n/**\n * Formats a UTC date/ISO-string in the school's configured timezone\n * (SchoolSettings.timezone). pattern is a date-fns format string.\n */\nexport function formatInSchoolTz(\n  date: Date | string,\n  pattern: string,\n  timezone: string,\n): string {\n  const value = typeof date === 'string' ? new Date(date) : date;\n  return formatInTimeZone(value, timezone, pattern);\n}\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};\nsrc/server/audit.ts\nsrc/server/csv.ts\nsrc/server/db.ts\nsrc/server/http.ts\nsrc/server/rate-limit.ts\n\nsrc/lib/validators:\nauth.ts\ncourses.ts\nnotifications.ts\nsections.ts\nusers.ts\n\nsrc/server/auth:\nauth.config.ts\nauth.ts\ncommon-passwords.txt\ncourse-access.ts\ncredentials.ts\nemail.ts\npassword-policy.ts\nrequireRole.ts\nstudent-access.ts\ntokens.ts\n\nsrc/server/courses:\ncourses-service.ts\n\nsrc/server/email:\nadmin.ts\nbackoff.ts\ndispatch.ts\noutbox.ts\nrender.ts\ntemplates\ntransport.ts\n\nsrc/server/enrollment:\nroster-engine.ts\n\nsrc/server/notifications:\nnotify.ts\npreferences.ts\npurge.ts\nservice.ts\ntypes.ts\n\nsrc/server/sections:\nsections-service.ts\n\nsrc/server/services:\nacademicYears.ts\nauth.ts\ndateRange.ts\ngradeLevels.ts\nrooms.ts\nsettings.ts\nsubjects.ts\nterms.ts\nuserImport.ts\nuserLinks.ts\nusers.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\