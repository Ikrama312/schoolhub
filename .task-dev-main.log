lay order from the full id list (index 0 → order 1). The id set must equal the existing set exactly, else 400. Two-phase write in one transaction. Audited as period.reorder.\",\n177\t      \"auth\": \"requireRole('ADMIN')\",\n178\t      \"requestSchema\": {\n179\t        \"body\": { \"periodIds\": { \"type\": \"array\", \"items\": \"string\", \"minItems\": 1, \"uniqueItems\": true } },\n180\t        \"zod\": \"periodReorderSchema\"\n181\t      },\n182\t      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } } },\n183\t      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n184\t      \"requirementIds\": [\"FR-33\", \"FR-5\", \"FR-40\"]\n185\t    },\n186\t    {\n187\t      \"method\": \"GET\",\n188\t      \"path\": \"/api/school-days\",\n189\t      \"routeFile\": \"src/app/api/school-days/route.ts\",\n190\t      \"description\": \"All 7 days, Mon→Sun, each with slotCount (all academic years) so the confirm dialog can show how many slots switching a day off will remove.\",\n191\t      \"auth\": \"requireUser (any role)\",\n192\t      \"requestSchema\": {},\n193\t      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDayWithCount\" }, \"length\": 7 } },\n194\t      \"errors\": [\"UNAUTHENTICATED\"],\n195\t      \"requirementIds\": [\"FR-34\", \"FR-7\"]\n196\t    },\n197\t    {\n198\t      \"method\": \"PUT\",\n199\t      \"path\": \"/api/school-days\",\n200\t      \"routeFile\": \"src/app/api/school-days/route.ts\",\n201\t      \"description\": \"Replace all 7 teaching flags. In one transaction, deletes every slot (all years) on days switching true→false, then updates the rows. Audited as schoolDay.update { changed, deletedSlotCount }.\",\n202\t      \"auth\": \"requireRole('ADMIN')\",\n203\t      \"requestSchema\": {\n204\t        \"body\": { \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDay\" }, \"length\": 7, \"note\": \"unique dayOfWeek 1–7\" } },\n205\t        \"zod\": \"schoolDaysSchema\"\n206\t      },\n207\t      \"responseSchema\": {\n208\t        \"data\": {\n209\t          \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDayWithCount\" } },\n210\t          \"deletedSlotCount\": \"integer\"\n211\t        }\n212\t      },\n213\t      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n214\t      \"requirementIds\": [\"FR-34\", \"FR-7\", \"FR-40\"]\n215\t    },\n216\t    {\n217\t      \"method\": \"GET\",\n218\t      \"path\": \"/api/timetable\",\n219\t      \"routeFile\": \"src/app/api/timetable/route.ts\",\n220\t      \"description\": \"Timetable for one section, teacher or room in one academic year. Teacher view includes co-taught courses. Access via assertCanViewTimetable: ADMIN any view; TEACHER only view=teacher&id=self, or view=section for sections they are homeroom teacher of or teach/co-teach a non-archived course in (D8); everyone else 403.\",\n221\t      \"auth\": \"requireUser + assertCanViewTimetable\",\n222\t      \"requestSchema\": {\n223\t        \"query\": {\n224\t          \"view\": { \"type\": \"string\", \"enum\": [\"section\", \"teacher\", \"room\"] },\n225\t          \"id\": { \"type\": \"string\" },\n226\t          \"academicYearId\": { \"type\": \"string\" }\n227\t        },\n228\t        \"zod\": \"timetableQuerySchema\"\n229\t      },\n230\t      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },\n231\t      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n232\t      \"requirementIds\": [\"FR-35\", \"FR-15\", \"FR-16\", \"NFR-2\", \"NFR-7\"]\n233\t    },\n234\t    {\n235\t      \"method\": \"GET\",\n236\t      \"path\": \"/api/timetable/availability\",\n237\t      \"routeFile\": \"src/app/api/timetable/availability/route.ts\",\n238\t      \"description\": \"Clash preview for dragging a course: for every teaching-day × period cell in the course's academic year, the clash messages that placing it there would produce. Only cells with clashes are returned. The course's own slots are ignored. roomId (D2) enables the ROOM rule for that room; omitted → ROOM rule skipped. Fixed query count (NFR-3).\",\n239\t      \"auth\": \"requireRole('ADMIN')\",\n240\t      \"requestSchema\": {\n241\t        \"query\": {\n242\t          \"courseId\": { \"type\": \"string\" },\n243\t          \"roomId\": { \"type\": \"string\", \"optional\": true }\n244\t        },\n245\t        \"zod\": \"availabilityQuerySchema\"\n246\t      },\n247\t      \"responseSchema\": {\n248\t        \"data\": {\n249\t          \"type\": \"object\",\n250\t          \"additionalProperties\": { \"type\": \"array\", \"items\": \"string\" },\n251\t          \"keyFormat\": \"<dayOfWeek>-<periodId>\",\n252\t          \"example\": { \"1-clx0p2\": [\"Clash: Mr Smith already teaches MATH-7B on Monday, Period 2.\"] }\n253\t        }\n254\t      },\n255\t      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n256\t      \"requirementIds\": [\"FR-36\", \"FR-19\", \"NFR-3\"]\n257\t    },\n258\t    {\n259\t      \"method\": \"GET\",\n260\t      \"path\": \"/api/timetable/free-rooms\",\n261\t      \"routeFile\": \"src/app/api/timetable/free-rooms/route.ts\",\n262\t      \"description\": \"Non-archived rooms with no slot at (academicYearId, dayOfWeek, periodId), ordered by name. excludeSlotId keeps the slot's own current room in the list. Added by design decision D1 to resolve intake blocker FR-21.\",\n263\t      \"auth\": \"requireRole('ADMIN')\",\n264\t      \"requestSchema\": {\n265\t        \"query\": {\n266\t          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"coerce\": true },\n267\t          \"periodId\": { \"type\": \"string\" },\n268\t          \"academicYearId\": { \"type\": \"string\" },\n269\t          \"excludeSlotId\": { \"type\": \"string\", \"optional\": true }\n270\t        },\n271\t        \"zod\": \"freeRoomsQuerySchema\"\n272\t      },\n273\t      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Room\" } } },\n274\t      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n275\t      \"requirementIds\": [\"FR-21\"]\n276\t    },\n277\t    {\n278\t      \"method\": \"POST\",\n279\t      \"path\": \"/api/timetable/slots\",\n280\t      \"routeFile\": \"src/app/api/timetable/slots/route.ts\",\n281\t      \"description\": \"Place a course in a cell. SERIALIZABLE transaction with retry on P2034: validateSlot runs inside it; any clash → 409 with every clash, nothing saved. academicYearId = course.academicYearId. Archived course or archived roomId → 400. Audited after commit as timetableSlot.create.\",\n282\t      \"auth\": \"requireRole('ADMIN')\",\n283\t      \"requestSchema\": {\n284\t        \"body\": {\n285\t          \"courseId\": { \"type\": \"string\" },\n286\t          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },\n287\t          \"periodId\": { \"type\": \"string\" },\n288\t          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }\n289\t        },\n290\t        \"zod\": \"slotCreateSchema\"\n291\t      },\n292\t      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },\n293\t      \"errorResponses\": {\n294\t        \"409\": {\n295\t          \"error\": {\n296\t            \"code\": \"CONFLICT\",\n297\t            \"message\": \"<first clash message>[ (+N more)]\",\n298\t            \"details\": { \"clashes\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Clash\" } } }\n299\t          }\n300\t        }\n301\t      },\n302\t      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n303\t      \"requirementIds\": [\"FR-37\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-17\", \"FR-20\", \"FR-40\", \"NFR-1\"]\n304\t    },\n305\t    {\n306\t      \"method\": \"PATCH\",\n307\t      \"path\": \"/api/timetable/slots/{id}\",\n308\t      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",\n309\t      \"description\": \"Move a slot and/or change its room. The patch is merged over the existing slot and re-validated with the slot itself excluded. A room-only patch (FR-21) uses the same path. Same transaction, 409 shape and audit (timetableSlot.update with from/to) as POST.\",\n310\t      \"auth\": \"requireRole('ADMIN')\",\n311\t      \"requestSchema\": {\n312\t        \"params\": { \"id\": \"string\" },\n313\t        \"body\": {\n314\t          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"optional\": true },\n315\t          \"periodId\": { \"type\": \"string\", \"optional\": true },\n316\t          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }\n317\t        },\n318\t        \"constraint\": \"at least one key\",\n319\t        \"zod\": \"slotUpdateSchema\"\n320\t      },\n321\t      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },\n322\t      \"errorResponses\": { \"409\": \"same as POST /api/timetable/slots\" },\n323\t      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n324\t      \"requirementIds\": [\"FR-37\", \"FR-14\", \"FR-18\", \"FR-20\", \"FR-21\", \"FR-40\", \"NFR-1\"]\n325\t    },\n326\t    {\n327\t      \"method\": \"DELETE\",\n328\t      \"path\": \"/api/timetable/slots/{id}\",\n329\t      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",\n330\t      \"description\": \"Remove a slot. Audited as timetableSlot.delete.\",\n331\t      \"auth\": \"requireRole('ADMIN')\",\n332\t      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n333\t      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n334\t      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n335\t      \"requirementIds\": [\"FR-37\", \"FR-18\", \"FR-40\"]\n336\t    },\n337\t    {\n338\t      \"method\": \"GET\",\n339\t      \"path\": \"/api/me/timetable\",\n340\t      \"routeFile\": \"src/app/api/me/timetable/route.ts\",\n341\t      \"description\": \"The caller's personal timetable. TEACHER → own (incl. co-taught). STUDENT → self; a studentId other than self → 403. PARENT → studentId required when >1 linked children, defaults to the only child, must pass assertCanViewStudent else 403. ADMIN → { periods, days, slots: [] } (D5). academicYearId defaults to the current AcademicYear.\",\n342\t      \"auth\": \"requireUser + role-specific checks above\",\n343\t      \"requestSchema\": {\n344\t        \"query\": {\n345\t          \"studentId\": { \"type\": \"string\", \"optional\": true },\n346\t          \"academicYearId\": { \"type\": \"string\", \"optional\": true }\n347\t        },\n348\t        \"zod\": \"meTimetableQuerySchema\"\n349\t      },\n350\t      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },\n351\t      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n352\t      \"requirementIds\": [\"FR-38\", \"FR-24\", \"FR-25\", \"FR-27\", \"NFR-7\"]\n353\t    }\n354\t  ],\n355\t\n356\t  \"nonHttpContracts\": [\n357\t    {\n358\t      \"name\": \"getScheduleForDate\",\n359\t      \"module\": \"src/server/timetable/timetable-service.ts\",\n360\t      \"signature\": \"getScheduleForDate(target: { userId: string; role: Role } | { sectionId: string }, date: Date): Promise<{ period: Period; course: TimetableSlotExpanded['course']; room: Room | null }[]>\",\n361\t      \"behaviour\": \"Weekday from SchoolSettings.timezone. [] if the day is not teaching. Ordered by period.order. PARENT target → [].\",\n362\t      \"requirementIds\": [\"FR-30\", \"FR-45\", \"NFR-15\"]\n363\t    },\n364\t    {\n365\t      \"name\": \"getCurrentSlot\",\n366\t      \"module\": \"src/server/timetable/timetable-service.ts\",\n367\t      \"signature\": \"getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null>\",\n368\t      \"behaviour\": \"Entry whose period has startTime <= hhmm < endTime in the school timezone, else null.\",\n369\t      \"requirementIds\": [\"FR-31\", \"FR-45\"]\n370\t    },\n371\t    {\n372\t      \"name\": \"validateSlot\",\n373\t      \"module\": \"src/server/timetable/timetable-service.ts\",\n374\t      \"signature\": \"validateSlot(input: { courseId; dayOfWeek; periodId; roomId: string | null; excludeSlotId?: string }, db?: Prisma.TransactionClient): Promise<Clash[]>\",\n375\t      \"behaviour\": \"Returns ALL clashes; excludeSlotId removes the moving slot from comparison.\",\n376\t      \"requirementIds\": [\"FR-14\"]\n377\t    }\n378\t  ],\n379\t\n380\t  \"status\": \"complete\"\n381\t}\n382\t"}]},"parent_tool_use_id":null,"session_id":"df25e571-0ce8-4c8c-9cc6-c89019e911c3","uuid":"b4ed4173-f14e-4f61-9d76-d5d35b82c337","timestamp":"2026-11-05T05:23:45.715Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-6\",\n  \"timestamp\": \"2026-11-05T06:20:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-9 forbids renaming routes)\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"errorEnvelope\": { \"error\": { \"code\": \"string\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409\n    },\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (Zod from src/lib/validators/timetable.ts) → timetable-service → ok(), all from src/server/http.ts. No new error codes. Prisma P2002 (the @@unique backstop) is already mapped to 409 by withHandler.\",\n    \"statusCodes\": \"POST create → 201 via ok(data, { status: 201 }); everything else 200. DELETE returns { data: { id } }.\",\n    \"academicYear\": \"academicYearId is never accepted on slot writes; it is derived from course.academicYearId (FR-37).\",\n    \"requirementIds\": [\"NFR-7\", \"NFR-8\", \"NFR-9\", \"FR-39\"]\n  },\n\n  \"sharedSchemas\": {\n    \"PeriodKind\": { \"type\": \"string\", \"enum\": [\"CLASS\", \"BREAK\", \"LUNCH\", \"ASSEMBLY\"] },\n    \"HHMM\": { \"type\": \"string\", \"pattern\": \"^([01]\\\\d|2[0-3]):[0-5]\\\\d$\", \"note\": \"24-hour, school timezone\" },\n    \"Period\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\", \"startTime\", \"endTime\", \"kind\", \"order\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 50 },\n        \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n        \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n        \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\" },\n        \"order\": { \"type\": \"integer\" }\n      }\n    },\n    \"SchoolDay\": {\n      \"type\": \"object\",\n      \"required\": [\"dayOfWeek\", \"isTeaching\"],\n      \"properties\": {\n        \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"note\": \"ISO 1=Mon … 7=Sun\" },\n        \"isTeaching\": { \"type\": \"boolean\" }\n      }\n    },\n    \"SchoolDayWithCount\": {\n      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/SchoolDay\" }],\n      \"properties\": { \"slotCount\": { \"type\": \"integer\", \"note\": \"slots on this day across ALL academic years (D3)\" } }\n    },\n    \"TimetableSlot\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"academicYearId\", \"courseId\", \"dayOfWeek\", \"periodId\", \"roomId\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"academicYearId\": { \"type\": \"string\" },\n        \"courseId\": { \"type\": \"string\" },\n        \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },\n        \"periodId\": { \"type\": \"string\" },\n        \"roomId\": { \"type\": [\"string\", \"null\"] }\n      }\n    },\n    \"TimetableSlotExpanded\": {\n      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/TimetableSlot\" }],\n      \"properties\": {\n        \"course\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"id\": { \"type\": \"string\" },\n            \"code\": { \"type\": \"string\" },\n            \"name\": { \"type\": \"string\" },\n            \"sectionId\": { \"type\": [\"string\", \"null\"] },\n            \"subject\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"color\": { \"type\": [\"string\", \"null\"] } } },\n            \"teacher\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" } } },\n            \"section\": { \"type\": [\"object\", \"null\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } }\n          }\n        },\n        \"room\": { \"type\": [\"object\", \"null\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n        \"period\": { \"$ref\": \"#/sharedSchemas/Period\" }\n      }\n    },\n    \"TimetableView\": {\n      \"type\": \"object\",\n      \"required\": [\"periods\", \"days\", \"slots\"],\n      \"note\": \"Everything the grid needs in one response (NFR-2).\",\n      \"properties\": {\n        \"periods\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } },\n        \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDay\" } },\n        \"slots\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } }\n      }\n    },\n    \"Clash\": {\n      \"type\": \"object\",\n      \"required\": [\"rule\", \"message\"],\n      \"properties\": {\n        \"rule\": { \"type\": \"string\", \"enum\": [\"TEACHER\", \"ROOM\", \"SECTION\", \"STUDENT\", \"PERIOD_KIND\", \"NON_TEACHING_DAY\"] },\n        \"message\": { \"type\": \"string\", \"note\": \"exact FR wording, see system-design.md §3.3\" }\n      }\n    },\n    \"Room\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\"],\n      \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"capacity\": { \"type\": [\"integer\", \"null\"] } }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/periods\",\n      \"routeFile\": \"src/app/api/periods/route.ts\",\n      \"description\": \"All periods ordered by `order` ascending.\",\n      \"auth\": \"requireUser (any role)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-33\", \"FR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/periods\",\n      \"routeFile\": \"src/app/api/periods/route.ts\",\n      \"description\": \"Create a period. order = max(order)+1. Rejects endTime <= startTime (Zod) and any overlap with another period (service: \\\"Overlaps '<name>' (<s>–<e>).\\\"). Audited as period.create.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": {\n          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 50 },\n          \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n          \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n          \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\" }\n        },\n        \"zod\": \"periodSchema\"\n      },\n      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/Period\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-5\", \"FR-6\", \"FR-40\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/periods/{id}\",\n      \"routeFile\": \"src/app/api/periods/[id]/route.ts\",\n      \"description\": \"Partial update. The service re-validates end>start and overlap against the merged row (self excluded). Audited as period.update.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"string\" },\n        \"body\": {\n          \"name\": { \"type\": \"string\", \"optional\": true },\n          \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\", \"optional\": true },\n          \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\", \"optional\": true },\n          \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\", \"optional\": true }\n        },\n        \"zod\": \"periodUpdateSchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Period\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-33\", \"FR-6\", \"FR-40\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/periods/{id}\",\n      \"routeFile\": \"src/app/api/periods/[id]/route.ts\",\n      \"description\": \"Delete a period. Refused with 409 if any timetable slot references it. Audited as period.delete.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n      \"errorResponses\": {\n        \"409\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Period has N timetable slots. Remove them first.\", \"details\": { \"slotCount\": \"integer\" } } }\n      },\n      \"errors\": [\"CONFLICT\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-33\", \"FR-8\", \"FR-40\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/periods/reorder\",\n      \"routeFile\": \"src/app/api/periods/reorder/route.ts\",\n      \"description\": \"Set display order from the full id list (index 0 → order 1). The id set must equal the existing set exactly, else 400. Two-phase write in one transaction. Audited as period.reorder.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": { \"periodIds\": { \"type\": \"array\", \"items\": \"string\", \"minItems\": 1, \"uniqueItems\": true } },\n        \"zod\": \"periodReorderSchema\"\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-5\", \"FR-40\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/school-days\",\n      \"routeFile\": \"src/app/api/school-days/route.ts\",\n      \"description\": \"All 7 days, Mon→Sun, each with slotCount (all academic years) so the confirm dialog can show how many slots switching a day off will remove.\",\n      \"auth\": \"requireUser (any role)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDayWithCount\" }, \"length\": 7 } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-34\", \"FR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/school-days\",\n      \"routeFile\": \"src/app/api/school-days/route.ts\",\n      \"description\": \"Replace all 7 teaching flags. In one transaction, deletes every slot (all years) on days switching true→false, then updates the rows. Audited as schoolDay.update { changed, deletedSlotCount }.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": { \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDay\" }, \"length\": 7, \"note\": \"unique dayOfWeek 1–7\" } },\n        \"zod\": \"schoolDaysSchema\"\n      },\n      \"responseSchema\": {\n        \"data\": {\n          \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDayWithCount\" } },\n          \"deletedSlotCount\": \"integer\"\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-34\", \"FR-7\", \"FR-40\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/timetable\",\n      \"routeFile\": \"src/app/api/timetable/route.ts\",\n      \"description\": \"Timetable for one section, teacher or room in one academic year. Teacher view includes co-taught courses. Access via assertCanViewTimetable: ADMIN any view; TEACHER only view=teacher&id=self, or view=section for sections they are homeroom teacher of or teach/co-teach a non-archived course in (D8); everyone else 403.\",\n      \"auth\": \"requireUser + assertCanViewTimetable\",\n      \"requestSchema\": {\n        \"query\": {\n          \"view\": { \"type\": \"string\", \"enum\": [\"section\", \"teacher\", \"room\"] },\n          \"id\": { \"type\": \"string\" },\n          \"academicYearId\": { \"type\": \"string\" }\n        },\n        \"zod\": \"timetableQuerySchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-35\", \"FR-15\", \"FR-16\", \"NFR-2\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/timetable/availability\",\n      \"routeFile\": \"src/app/api/timetable/availability/route.ts\",\n      \"description\": \"Clash preview for dragging a course: for every teaching-day × period cell in the course's academic year, the clash messages that placing it there would produce. Only cells with clashes are returned. The course's own slots are ignored. roomId (D2) enables the ROOM rule for that room; omitted → ROOM rule skipped. Fixed query count (NFR-3).\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"query\": {\n          \"courseId\": { \"type\": \"string\" },\n          \"roomId\": { \"type\": \"string\", \"optional\": true }\n        },\n        \"zod\": \"availabilityQuerySchema\"\n      },\n      \"responseSchema\": {\n        \"data\": {\n          \"type\": \"object\",\n          \"additionalProperties\": { \"type\": \"array\", \"items\": \"string\" },\n          \"keyFormat\": \"<dayOfWeek>-<periodId>\",\n          \"example\": { \"1-clx0p2\": [\"Clash: Mr Smith already teaches MATH-7B on Monday, Period 2.\"] }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-36\", \"FR-19\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/timetable/free-rooms\",\n      \"routeFile\": \"src/app/api/timetable/free-rooms/route.ts\",\n      \"description\": \"Non-archived rooms with no slot at (academicYearId, dayOfWeek, periodId), ordered by name. excludeSlotId keeps the slot's own current room in the list. Added by design decision D1 to resolve intake blocker FR-21.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"query\": {\n          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"coerce\": true },\n          \"periodId\": { \"type\": \"string\" },\n          \"academicYearId\": { \"type\": \"string\" },\n          \"excludeSlotId\": { \"type\": \"string\", \"optional\": true }\n        },\n        \"zod\": \"freeRoomsQuerySchema\"\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Room\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-21\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/timetable/slots\",\n      \"routeFile\": \"src/app/api/timetable/slots/route.ts\",\n      \"description\": \"Place a course in a cell. SERIALIZABLE transaction with retry on P2034: validateSlot runs inside it; any clash → 409 with every clash, nothing saved. academicYearId = course.academicYearId. Archived course or archived roomId → 400. Audited after commit as timetableSlot.create.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": {\n          \"courseId\": { \"type\": \"string\" },\n          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },\n          \"periodId\": { \"type\": \"string\" },\n          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }\n        },\n        \"zod\": \"slotCreateSchema\"\n      },\n      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },\n      \"errorResponses\": {\n        \"409\": {\n          \"error\": {\n            \"code\": \"CONFLICT\",\n            \"message\": \"<first clash message>[ (+N more)]\",\n            \"details\": { \"clashes\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Clash\" } } }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n      \"requirementIds\": [\"FR-37\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-17\", \"FR-20\", \"FR-40\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/timetable/slots/{id}\",\n      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",\n      \"description\": \"Move a slot and/or change its room. The patch is merged over the existing slot and re-validated with the slot itself excluded. A room-only patch (FR-21) uses the same path. Same transaction, 409 shape and audit (timetableSlot.update with from/to) as POST.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"string\" },\n        \"body\": {\n          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"optional\": true },\n          \"periodId\": { \"type\": \"string\", \"optional\": true },\n          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }\n        },\n        \"constraint\": \"at least one key\",\n        \"zod\": \"slotUpdateSchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },\n      \"errorResponses\": { \"409\": \"same as POST /api/timetable/slots\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n      \"requirementIds\": [\"FR-37\", \"FR-14\", \"FR-18\", \"FR-20\", \"FR-21\", \"FR-40\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/timetable/slots/{id}\",\n      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",\n      \"description\": \"Remove a slot. Audited as timetableSlot.delete.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-37\", \"FR-18\", \"FR-40\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/timetable\",\n      \"routeFile\": \"src/app/api/me/timetable/route.ts\",\n      \"description\": \"The caller's personal timetable. TEACHER → own (incl. co-taught). STUDENT → self; a studentId other than self → 403. PARENT → studentId required when >1 linked children, defaults to the only child, must pass assertCanViewStudent else 403. ADMIN → { periods, days, slots: [] } (D5). academicYearId defaults to the current AcademicYear.\",\n      \"auth\": \"requireUser + role-specific checks above\",\n      \"requestSchema\": {\n        \"query\": {\n          \"studentId\": { \"type\": \"string\", \"optional\": true },\n          \"academicYearId\": { \"type\": \"string\", \"optional\": true }\n        },\n        \"zod\": \"meTimetableQuerySchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-38\", \"FR-24\", \"FR-25\", \"FR-27\", \"NFR-7\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    {\n      \"name\": \"getScheduleForDate\",\n      \"module\": \"src/server/timetable/timetable-service.ts\",\n      \"signature\": \"getScheduleForDate(target: { userId: string; role: Role } | { sectionId: string }, date: Date): Promise<{ period: Period; course: TimetableSlotExpanded['course']; room: Room | null }[]>\",\n      \"behaviour\": \"Weekday from SchoolSettings.timezone. [] if the day is not teaching. Ordered by period.order. PARENT target → [].\",\n      \"requirementIds\": [\"FR-30\", \"FR-45\", \"NFR-15\"]\n    },\n    {\n      \"name\": \"getCurrentSlot\",\n      \"module\": \"src/server/timetable/timetable-service.ts\",\n      \"signature\": \"getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null>\",\n      \"behaviour\": \"Entry whose period has startTime <= hhmm < endTime in the school timezone, else null.\",\n      \"requirementIds\": [\"FR-31\", \"FR-45\"]\n    },\n    {\n      \"name\": \"validateSlot\",\n      \"module\": \"src/server/timetable/timetable-service.ts\",\n      \"signature\": \"validateSlot(input: { courseId; dayOfWeek; periodId; roomId: string | null; excludeSlotId?: string }, db?: Prisma.TransactionClient): Promise<Clash[]>\",\n      \"behaviour\": \"Returns ALL clashes; excludeSlotId re