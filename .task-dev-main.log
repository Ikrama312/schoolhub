{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015esjJpVx6MszXrLKWpZTvr","type":"tool_result","content":"1\t{\n2\t  \"ticketId\": \"abcd-02\",\n3\t  \"timestamp\": \"2026-10-19T13:30:00Z\",\n4\t  \"phase\": \"architect\",\n5\t  \"version\": \"1.0\",\n6\t\n7\t  \"note\": \"arch-design-system did not leave a system-design.md for this ticket (not found anywhere under artifacts/architect/ for ticketId abcd-02 — see handoff-to-dev-planning.json blockers). Contracts below are derived directly from artifacts/intake/requirements.json and the source PRD's explicit API table (02-academic-structure.md, section 'API'), which fully specify method/path/role/body for every endpoint.\",\n8\t\n9\t  \"conventions\": {\n10\t    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n11\t    \"listEnvelope\": { \"data\": \"[...]\", \"page\": 1, \"pageSize\": 20, \"total\": 0 },\n12\t    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n13\t    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\"],\n14\t    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100)\",\n15\t    \"sorting\": \"?sort=field&order=asc|desc\",\n16\t    \"search\": \"?q=\",\n17\t    \"auth\": \"GET endpoints: any signed-in user. All write endpoints (POST/PATCH/DELETE): requireRole('ADMIN') server-side, 403 on non-admin.\",\n18\t    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action <entity>.create|update|archive|delete.\"\n19\t  },\n20\t\n21\t  \"endpoints\": [\n22\t    {\n23\t      \"method\": \"GET\",\n24\t      \"path\": \"/api/settings/school\",\n25\t      \"description\": \"Return the single SchoolSettings record.\",\n26\t      \"requestSchema\": {},\n27\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string (IANA zone)\" } },\n28\t      \"requirementIds\": [\"FR-2\", \"FR-5\", \"NFR-6\"]\n29\t    },\n30\t    {\n31\t      \"method\": \"PATCH\",\n32\t      \"path\": \"/api/settings/school\",\n33\t      \"description\": \"Update one or more SchoolSettings fields. Writes audit entry settings.school.update with changed field names in metadata.\",\n34\t      \"requestSchema\": { \"name\": \"string?\", \"logoUrl\": \"string(url)?\", \"address\": \"string?\", \"contactEmail\": \"string?\", \"contactPhone\": \"string?\", \"timezone\": \"string (IANA zone)?\" },\n35\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string\" } },\n36\t      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"NFR-6\", \"NFR-7\"]\n37\t    },\n38\t    {\n39\t      \"method\": \"GET\",\n40\t      \"path\": \"/api/academic-years\",\n41\t      \"description\": \"List academic years including their terms, ordered by term order.\",\n42\t      \"requestSchema\": {},\n43\t      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\", \"terms\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] } ] },\n44\t      \"requirementIds\": [\"FR-6\", \"FR-10\", \"FR-11\", \"NFR-6\"]\n45\t    },\n46\t    {\n47\t      \"method\": \"POST\",\n48\t      \"path\": \"/api/academic-years\",\n49\t      \"description\": \"Create an academic year. Validates endDate after startDate and no date-range overlap with any other year, inside a transaction.\",\n50\t      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },\n51\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },\n52\t      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n53\t    },\n54\t    {\n55\t      \"method\": \"PATCH\",\n56\t      \"path\": \"/api/academic-years/:id\",\n57\t      \"description\": \"Update an academic year's name/dates; re-validates the overlap rule.\",\n58\t      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\" },\n59\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },\n60\t      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n61\t    },\n62\t    {\n63\t      \"method\": \"POST\",\n64\t      \"path\": \"/api/academic-years/:id/set-current\",\n65\t      \"description\": \"Set isCurrent = true on this year and false on every other year, inside one transaction. Confirm dialog gates this on the client.\",\n66\t      \"requestSchema\": {},\n67\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"isCurrent\": true } },\n68\t      \"requirementIds\": [\"FR-8\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n69\t    },\n70\t    {\n71\t      \"method\": \"DELETE\",\n72\t      \"path\": \"/api/academic-years/:id\",\n73\t      \"description\": \"Delete an academic year. Returns CONFLICT (409) if it has terms or is referenced elsewhere.\",\n74\t      \"requestSchema\": {},\n75\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n76\t      \"requirementIds\": [\"FR-9\", \"NFR-6\", \"NFR-7\"]\n77\t    },\n78\t    {\n79\t      \"method\": \"POST\",\n80\t      \"path\": \"/api/academic-years/:id/terms\",\n81\t      \"description\": \"Create a term under this academic year. Validates term dates fall inside the year's range and do not overlap sibling terms; order auto-assigns as max+1.\",\n82\t      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },\n83\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },\n84\t      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n85\t    },\n86\t    {\n87\t      \"method\": \"POST\",\n88\t      \"path\": \"/api/academic-years/:id/terms/generate\",\n89\t      \"description\": \"Split the year's date range into equal consecutive, named, contiguous terms. Only allowed when the year has zero terms. Earlier terms get the extra day when the range doesn't divide evenly.\",\n90\t      \"requestSchema\": { \"pattern\": \"'SEMESTERS' | 'TRIMESTERS' | 'QUARTERS'\" },\n91\t      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] },\n92\t      \"requirementIds\": [\"FR-14\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n93\t    },\n94\t    {\n95\t      \"method\": \"PATCH\",\n96\t      \"path\": \"/api/terms/:id\",\n97\t      \"description\": \"Update a term's name/dates/order. Re-validates range and sibling-overlap rules.\",\n98\t      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\", \"order\": \"int?\" },\n99\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },\n100\t      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n101\t    },\n102\t    {\n103\t      \"method\": \"DELETE\",\n104\t      \"path\": \"/api/terms/:id\",\n105\t      \"description\": \"Delete a term.\",\n106\t      \"requestSchema\": {},\n107\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n108\t      \"requirementIds\": [\"FR-12\", \"NFR-6\", \"NFR-7\"]\n109\t    },\n