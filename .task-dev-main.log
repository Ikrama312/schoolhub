MobileOpen(false)}\n          ModalProps={{ keepMounted: true }}\n          sx={{ [`& .MuiDrawer-paper`]: { width: DRAWER_WIDTH_EXPANDED, boxSizing: 'border-box' } }}\n        >\n          <Toolbar />\n          {navList}\n        </Drawer>\n      )}\n\n      <Box\n        component=\"main\"\n        sx={{\n          flexGrow: 1,\n          p: 3,\n          width: isDesktop ? `calc(100% - ${drawerWidth}px)` : '100%',\n        }}\n      >\n        <Toolbar />\n        {children}\n      </Box>\n    </Box>\n  );\n}\nsrc/app/api/auth/[...nextauth]/:\nroute.ts\n\nsrc/app/api/auth/accept-invite/:\nroute.ts\n\nsrc/app/api/auth/forgot-password/:\nroute.ts\n\nsrc/app/api/auth/reset-password/:\nroute.ts\n20:  | 'INVALID_TOKEN';\n30:  INVALID_TOKEN: 410,\n60:    { status: ERROR_STATUS[code] },\n67: * AppError -> its own code/status","is_error":false}]},"parent_tool_use_id":null,"session_id":"f2906e1d-ad0e-4bbc-bb8a-30196499bfbf","uuid":"6186bf90-c077-4097-be4c-d8cc2a6eeaa9","timestamp":"2026-11-05T16:34:33.919Z","tool_use_result":{"stdout":"import { ok, parseBody, withHandler } from '@/server/http';\nimport { forgotPasswordSchema } from '@/lib/validators/auth';\nimport { requestPasswordReset } from '@/server/services/auth';\n\n/** POST /api/auth/forgot-password — public; always the same 200 body, 429 per IP (FR-19). */\nexport const POST = withHandler(async (request: Request) => {\n  const body = await parseBody(request, forgotPasswordSchema);\n  return ok(await requestPasswordReset(body, request));\n});\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { acceptInviteSchema } from '@/lib/validators/auth';\nimport { acceptInvite } from '@/server/services/auth';\n\n/** POST /api/auth/accept-invite — public; activates an invited account (FR-16). */\nexport const POST = withHandler(async (request: Request) => {\n  const body = await parseBody(request, acceptInviteSchema);\n  return ok(await acceptInvite(body, request));\n});\nimport { ok, parseBody, withHandler 