);\n\n  it('NON_TEACHING_DAY rejects a non-teaching day', () => {\n    const c = clashesForCell(course(), null, { ...cell, dayLabel: 'Saturday', isTeaching: false }, [], none);\n    expect(c).toEqual([{ rule: 'NON_TEACHING_DAY', message: 'Saturday is not a teaching day.' }]);\n  });\n\n  it('TEACHER: same main teacher', () => {\n    const c = clashesForCell(course(), null, cell, [slot('a', { code: 'MATH-7B', teacherId: 'tom' })], none, { teacherNames: names });\n    expect(c).toEqual([{ rule: 'TEACHER', message: 'Clash: Tom Smith already teaches MATH-7B on Monday, Period 2.' }]);\n  });\n\n  it('TEACHER: co-teacher of the new course is the other course teacher', () => {\n    const c = clashesForCell(\n      course({ coTeacherIds: ['ann'] }),\n      null,\n      cell,\n      [slot('a', { code: 'SCI-7B', teacherId: 'ann' })],\n      none,\n      { teacherNames: names },\n    );\n    expect(c.map((x) => x.message)).toEqual(['Clash: Ann Lee already teaches SCI-7B on Monday, Period 2.']);\n  });\n\n  it('TEACHER: co-teacher on both sides', () => {\n    const c = clashesForCell(\n      course({ coTeacherIds: ['bob'] }),\n      null,\n      cell,\n      [slot('a', { code: 'ART-7B', coTeacherIds: ['bob'] })],\n      none,\n      { teacherNames: names },\n    );\n    expect(c.map((x) => x.message)).toEqual(['Clash: Bob Ray already teaches ART-7B on Monday, Period 2.']);\n  });\n\n  it('ROOM: same room clashes, null room skips the rule', () => {\n    const others = [slot('a', {}, 'r1', 'Room 101')];\n    expect(clashesForCell(course(), 'r1', cell, others, none)).toEqual([\n      { rule: 'ROOM', message: 'Clash: Room 101 is used by X-a on Monday, Period 2.' },\n    ]);\n    expect(clashesForCell(course(), null, cell, others, none)).toEqual([]);\n  });\n\n  it('SECTION: same section clashes, null section skips the rule', () => {\n    const others = [slot('a', { sectionId: '7a', sectionName: '7A', subjectName: 'Science' })];\n    expect(clashesForCell(course(), null, cell, others, none)).toEqual([\n      { rule: 'SECTION', message: 'Clash: 7A already has Science on Monday, Period 2.' },\n    ]);\n    expect(clashesForCell(course({ sectionId: null }), null, cell, others, none)).toEqual([]);\n  });\n\n  it('STUDENT: reports the overlap count', () => {\n    const c = clashesForCell(course({ sectionId: null, code: 'ROBOTICS' }), null, cell, [slot('a', { code: 'ART-7B' })], new Map([['course-a', 3]]));\n    expect(c).toEqual([{ rule: 'STUDENT', message: 'Clash: 3 students in ROBOTICS also take ART-7B at this time.' }]);\n  });\n\n  it('returns every clash, in rule order', () => {\n    const c = clashesForCell(\n      course(),\n      'r1',\n      { dayLabel: 'Sunday', period: { name: 'Break', kind: 'BREAK' }, isTeaching: false },\n      [slot('a', { teacherId: 'tom', sectionId: '7a', sectionName: '7A' }, 'r1', 'Room 101')],\n      new Map([['course-a', 2]]),\n      { teacherNames: names },\n    );\n    expect(c.map((x) => x.rule)).toEqual(['PERIOD_KIND', 'NON_TEACHING_DAY', 'TEACHER', 'ROOM', 'SECTION', 'STUDENT']);\n  });\n\n  it('excludes the moving slot itself', () => {\n    const self = slot('self', { teacherId: 'tom', sectionId: '7a' }, 'r1');\n    expect(clashesForCell(course(), 'r1', cell, [self], none, { excludeSlotId: 'self' })).toEqual([]);\n    expect(clashesForCell(course(), 'r1', cell, [self], none)).not.toEqual([]);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01A8H81cTA9t731EmLae8WGH","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjE6DoLufUNzrdqH1hVp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UwfQVW7DCs2rJ9y2GwiBgd","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/tests/unit/timetable-time.test.ts","content":"import { describe, expect, it } from 'vitest';\nimport { nowAndNext, schoolNow } from '@/lib/dates';\nimport { periodsOverlap } from '@/server/timetable/clash-rules';\nimport { periodSchema, periodUpdateSchema } from '@/lib/validators/timetable';\n\nconst p = (startTime: string, endTime: string) => ({ startTime, endTime });\n\ndescribe('periodsOverlap', () => {\n  it('detects overlap and treats touching ends as free ([start, end))', () => {\n    expect(periodsOverlap(p('08:00', '08:45'), p('08:30', '09:00'))).toBe(true);\n    expect(periodsOverlap(p('08:00', '09:00'), p('08:10', '08:20'))).toBe(true);\n    expect(periodsOverlap(p('08:00', '08:45'), p('08:45', '09:30'))).toBe(false);\n    expect(periodsOverlap(p('09:35', '09:55'), p('08:00', '08:45'))).toBe(false);\n  });\n});\n\ndescribe('periodSchema', () => {\n  const base = { name: 'Period 1', kind: 'CLASS' as const };\n  it('requires end after start and HH:MM format', () => {\n    expect(periodSchema.safeParse({ ...base, startTime: '08:00', endTime: '08:45' }).success).toBe(true);\n    expect(periodSchema.safeParse({ ...base, startTime: '08:45', endTime: '08:45' }).success).toBe(false);\n    expect(periodSchema.safeParse({ ...base, startTime: '09:00', endTime: '08:00' }).success).toBe(false);\n    expect(periodSchema.safeParse({ ...base, startTime: '8:00', endTime: '24:00' }).success).toBe(false);\n  });\n  it('partial update checks order only when both times are present', () => {\n    expect(periodUpdateSchema.safeParse({ endTime: '07:00' }).success).toBe(true);\n    expect(periodUpdateSchema.safeParse({ startTime: '10:00', endTime: '09:00' }).success).toBe(false);\n  });\n});\n\ndescribe('schoolNow', () => {\n  const instant = new Date('2026-11-04T17:30:00Z'); // Wednesday in UTC\n\n  it('UTC', () => {\n    expect(schoolNow(instant, 'UTC')).toEqual({ isoDay: 3, hhmm: '17:30' });\n  });\n  it('America/Los_Angeles', () => {\n    expect(schoolNow(instant, 'America/Los_Angeles')).toEqual({ isoDay: 3, hhmm: '09:30' });\n  });\n  it('Asia/Kolkata', () => {\n    expect(schoolNow(instant, 'Asia/Kolkata')).toEqual({ isoDay: 3, hhmm: '23:00' });\n  });\n  it('uses the school weekday when it differs from UTC (date line)', () => {\n    const lateUtcSunday = new Date('2026-11-08T20:00:00Z'); // Sunday 20:00 UTC\n    expect(schoolNow(lateUtcSunday, 'UTC').isoDay).toBe(7);\n    expect(schoolNow(lateUtcSunday, 'Asia/Kolkata')).toEqual({ isoDay: 1, hhmm: '01:30' });\n    const earlyUtcMonday = new Date('2026-11-09T03:00:00Z');\n    expect(schoolNow(earlyUtcMonday, 'America/Los_Angeles')).toEqual({ isoDay: 7, hhmm: '19:00' });\n  });\n});\n\ndescribe('nowAndNext', () => {\n  const periods = [p('08:50', '09:35'), p('08:00', '08:45'), p('09:35', '09:55')];\n\n  it('finds the running and the next period', () => {\n    expect(nowAndNext(periods, '08:10')).toEqual({ now: p('08:00', '08:45'), next: p('08:50', '09:35') });\n  });\n  it('end is exclusive', () => {\n    expect(nowAndNext(periods, '09:35')).toEqual({ now: p('09:35', '09:55'), next: null });\n  });\n  it('between periods and outside the day', () => {\n    expect(nowAndNext(periods, '08:47')).toEqual({ now: null, next: p('08:50', '09:35') });\n    expect(nowAndNext(periods, '07:00')).toEqual({ now: null, next: p('08:00', '08:45') });\n    expect(nowAndNext(periods, '18:00')).toEqual({ now: null, next: null });\n  });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3083,"cache_read_input_tokens":104992,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3083},"outpu