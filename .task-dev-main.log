herId: user.id }, { coTeacherIds: { has: user.id } }] },\n          },\n          select: { studentId: true },\n          distinct: ['studentId'],\n        }),\n        prisma.sectionMember.findMany({\n          where: { section: { homeroomTeacherId: user.id } },\n          select: { studentId: true },\n        }),\n      ]);\n      return [...new Set([...enrolled, ...members].map((row) => row.studentId))];\n    }\n    default:\n      return [];\n  }\n}","originalFile":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\nexport interface AccessUser {\n  id: string;\n  role: Role;\n}\n\nexport type AccessibleStudentIds = 'ALL' | string[];\n\n/**\n * FR-17: resolves which student ids `user` may see.\n * - ADMIN: \"ALL\" (every student)\n * - STUDENT: only themselves\n * - PARENT: students linked via ParentStudentLink (component 6)\n * - TEACHER: [] until PRD-05 adds section/course relations -- this function\n *   is the one place PRD-05 extends, per FR-17's own contract.\n */\nexport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n  switch (user.role) {\n    case 'ADMIN':\n      return 'ALL';\n    case 'STUDENT':\n      return [user.id];\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({\n        where: { parentId: user.id },\n        select: { studentId: true },\n      });\n      return links.map((link) => link.studentId);\n    }\n    case 'TEACHER':\n    default:\n      return [];\n  }\n}\n\n/**\n * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n * not allowed to see this particular studentId -- NOT_FOUND rather than\n * FORBIDDEN so existence of another family's student is never revealed.\n * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN, and TEACHER is denied everything until PRD-05).\n */\nexport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n  const accessible = await getAccessibleStudentIds(user);\n\n  if (accessible === 'ALL') return;\n\n  if (accessible.includes(studentId)) return;\n\n  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n    throw new AppError('NOT_FOUND', 'Resource not found');\n  }\n\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n}\n","structuredPatch":[{"oldStart":14,"oldLines":8,"newStart":14,"newLines":8,"lines":["  * - ADMIN: \"ALL\" (every student)","  * - STUDENT: only themselves","  * - PARENT: students linked via ParentStudentLink (component 6)","- * - TEACHER: [] until PRD-05 adds section/course relations -- this function","- *   is the one place PRD-05 extends, per FR-17's own contract.","+ * - TEACHER (PRD-05 FR-22): students ACTIVE in courses they teach or","+ *   co-teach, plus members of sections they are homeroom teacher of.","  */"," export async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {","   switch (user.role) {"]},{"oldStart":30,"oldLines":7,"newStart":30,"newLines":23,"lines":["       });","       return links.map((link) => link.studentId);","     }","-    case 'TEACHER':","+    case 'TEACHER': {","+      const [enrolled, members] = await Promise.all([","+        prisma.enrollment.findMany({","+          where: {","+            status: 'ACTIVE',","+            course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] },","+          },","+          select: { studentId: true },","+          distinct: ['studentId'],","+        }),","+        prisma.sectionMember.findMany({","+          where: { section: { homeroomTeacherId: user.id } },","+          select: { studentId: true },","+        }),","+      ]);","+      return [...new Set([...enrolled, ...members].map((row) => row.studentId))];","+    }","     default:","       return [];","   }"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_014pcGKMrUx3e4TvQDSJF81c","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
