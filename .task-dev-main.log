\n/**\n * Fail-fast env validation. Runs once at module load (startup boundary) —\n * anything importing this module gets a readable error naming every\n * missing/invalid variable instead of an undefined-at-runtime surprise.\n */\nconst envSchema = z.object({\n  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n  APP_URL: z.string().min(1, 'APP_URL is required'),\n  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n});\n\nfunction loadEnv() {\n  const parsed = envSchema.safeParse(process.env);\n  if (!parsed.success) {\n    const issues = parsed.error.issues\n      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n      .join('\\n');\n    throw new Error(`Invalid environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\nexport const env = loadEnv();\nexport type Env = z.infer<typeof envSchema>;\n","structuredPatch":[{"oldStart":10,"oldLines":6,"newStart":10,"newLines":21,"lines":["   APP_URL: z.string().min(1, 'APP_URL is required'),","   AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),","   NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),","+","+  // Email (PRD-04). EMAIL_TRANSPORT defaults to 'console' so dev/test never","+  // need real SMTP creds; the smtp branch (src/server/email/transport.ts)","+  // only reads SMTP_*/EMAIL_FROM when EMAIL_TRANSPORT='smtp'.","+  EMAIL_TRANSPORT: z.enum(['smtp', 'console']).default('console'),","+  SMTP_HOST: z.string().optional(),","+  SMTP_PORT: z.coerce.number().int().optional(),","+  SMTP_USER: z.string().optional(),","+  SMTP_PASS: z.string().optional(),","+  SMTP_SECURE: z.coerce.boolean().optional(),","+  EMAIL_FROM: z.string().optional(),","+  // Bearer token for POST /api/internal/email/dispatch (NFR-8). Optional so","+  // existing .env files don't break; left unset, the route rejects every","+  // request (fail-safe, not fail-open).","+  CRON_SECRET: z.string().optional(),"," });"," "," function loadEnv() {"]}],"userModified":false,"replaceAll":false}}
