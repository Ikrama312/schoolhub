{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012XPnS7zt9gJbbQd8FV3feu","type":"tool_result","content":"['ticketId', 'timestamp', 'phase', 'version', 'conventions', 'sharedSchemas', 'endpoints', 'nonHttpContracts', 'status']\n{\"method\": \"GET\", \"path\": \"/api/notifications\", \"routeFile\": \"src/app/api/notifications/route.ts\", \"description\": \"Paginated list of the caller's own notifications, newest first. 'unread=true' gives readAt IS NULL, and 'category' gives type IN typesInCategory(category).\", \"auth\": \"requireUser\", \"requestSchema\": {\"query\": {\"unread\": {\"type\": \"string\", \"enum\": [\"true\", \"false\"], \"optional\": true}, \"category\": {\"type\": \"string\", \"enum\": [\"ACCOUNT\", \"ACADEMIC\", \"ATTENDANCE\", \"COMMUNICATION\", \"FINANCE\", \"SYSTEM\"], \"optional\": true}, \"page\": {\"type\": \"integer\", \"minimum\": 1, \"default\": 1}, \"pageSize\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20}}}, \"responseSchema\": {\"data\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/sharedSchemas/Notification\"}}, \"meta\": {\"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\"}}, \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\"], \"requirementIds\": [\"FR-34\", \"FR-24\", \"FR-26\", \"NFR-11\"]}\n\n{\"method\": \"GET\", \"path\": \"/api/notifications/unread-count\", \"routeFile\": \"src/app/api/notifications/unread-count/route.ts\", \"description\": \"Count of the caller's unread notifications. It is index-only on [userId, readAt, createdAt], with a target under 50 ms, and the bell polls it every 30 s while the tab is visible.\", \"auth\": \"requireUser\", \"requestSchema\": {}, \"responseSchema\": {\"data\": {\"type\": \"object\", \"required\": [\"count\"], \"properties\": {\"count\": {\"type\": \"integer\", \"minimum\": 0}}}}, \"errors\": [\"UNAUTHENTICATED\"], \"requirementIds\": [\"FR-35\", \"FR-22\", \"FR-23\", \"NFR-2\"]}\n\n{\"method\": \"POST\", \"path\": \"/api/notifications/read-all\", \"routeFile\": \"src/app/api/notifications/read-all/route.ts\", \"description\": \"Sets readAt = now on all of the caller's unread notifications. It is idempotent.\", \"auth\": \"requireUser\", \"requestSchema\": {}, \"responseSchema\": {\"data\": {\"type\": \"object\", \"required\": [\"count\"], \"properties\": {\"count\": {\"type\": \"integer\", \"description\": \"rows updated\"}}}}, \"errors\": [\"UNAUTHENTICATED\"], \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]}\n\n{\"method\": \"POST\", \"path\": \"/api/notifications/{id}/read\", \"routeFile\": \"src/app/api/notifications/[id]/read/route.ts\", \"description\": \"Marks one notification read. It runs updateMany({ id, userId: me.id }), and a count of 0 returns 404 NOT_FOUND, so it never reveals other users' rows.\", \"auth\": \"requireUser (owner only)\", \"requestSchema\": {\"params\": {\"id\": {\"type\": \"string\"}}}, \"responseSchema\": {\"data\": {\"type\": \"object\", \"required\": [\"id\"], \"properties\": {\"id\": {\"type\": \"string\"}}}}, \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"], \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]}\n\n{\"method\": \"POST\", \"path\": \"/api/notifications/{id}/unread\", \"routeFile\": \"src/app/api/notifications/[id]/unread/route.ts\", \"description\": \"Marks one notification unread (readAt = null). Same owner scoping and 404 rule as /read.\", \"auth\": \"requireUser (owner only)\", \"requestSchema\": {\"params\": {\"id\": {\"type\": \"string\"}}}, \"responseSchema\": {\"data\": {\"type\": \"object\", \"required\": [\"id\"], \"properties\": {\"id\": {\"type\": \"string\"}}}}, \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"], \"requirementIds\": [\"FR-36\", \"FR-26\"]}\n\n{\"method\": \"GET\", \"path\": \"/api/me/notification-preferences\", \"routeFile\": \"src/app/api/me/notification-preferences/route.ts\", \"description\": \"Returns visibleTypesFor(me.role) (registry types with the caller's role, excluding emai