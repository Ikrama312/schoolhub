{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgBQ62WEdN6siHn1VkAdh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HAt2TNrMrcaFSs7pad56aV","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/api/me/profile/route.ts","content":"import { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { prisma } from '@/server/db';\nimport { meProfileSchema } from '@/lib/validators/users';\n\n/**\n * PATCH /api/me/profile — any authenticated user, self only (FR-27). A\n * narrower mutation path than /api/users/:id: only phone (+ occupation/\n * address for PARENT) are editable here; name/email/role are read-only.\n */\nexport const PATCH = withHandler(async (request: Request) => {\n  const actor = requireRole('ADMIN', 'TEACHER', 'STUDENT', 'PARENT');\n  const input = await parseBody(request, meProfileSchema);\n\n  await prisma.user.update({ where: { id: actor.id }, data: { phone: input.phone } });\n\n  if (actor.role === 'PARENT') {\n    await prisma.parentProfile.update({\n      where: { userId: actor.id },\n      data: {\n        ...(input.occupation !== undefined ? { occupation: input.occupation } : {}),\n        ...(input.address !== undefined ? { address: input.address } : {}),\n      },\n    });\n  }\n\n  const user = await prisma.user.findUniqueOrThrow({\n    where: { id: actor.id },\n    include: { parentProfile: true },\n  });\n\n  return ok({\n    id: user.id,\n    firstName: user.firstName,\n    lastName: user.lastName,\n    email: user.email,\n    role: user.role,\n    phone: user.phone,\n    occupation: user.parentProfile?.occupation ?? null,\n    address: user.parentProfile?.address ?? null,\n  });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2888,"cache_read_input_tokens":129525