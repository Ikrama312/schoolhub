{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LCrnpJAkEmqTMGuarFnyqb","type":"tool_result","content":"'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport TextField from '@mui/material/TextField';\nimport InputAdornment from '@mui/material/InputAdornment';\nimport SearchIcon from '@mui/icons-material/Search';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface DataTableProps {\n  columns: GridColDef[];\n  rows: readonly Record<string, unknown>[];\n  total: number;\n  loading?: boolean;\n  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n  getRowId?: (row: Record<string, unknown>) => string | number;\n}\n\n/**\n * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n * from (and written to) URL query params, a debounced search box, and the\n * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n * params change — this component owns no fetch logic of its own.\n */\nexport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const sortField = searchParams.get('sort') ?? undefined;\n  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n\n  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n\n  const updateParams = useCallback(\n    (updates: Record<string, string | undefined>) => {\n      const next = new URLSearchParams(searchParams.toString());\n      for (const [key, value] of Object.entries(updates)) {\n        if (value === undefined || value === '') {\n          next.delete(key);\n        } else {\n          next.set(key, value);\n        }\n      }\n      router.push(`${pathname}?${next.toString()}`);\n    },\n    [pathname, router, searchParams],\n  );\n\n  // Debounce search -> URL param, resetting to page 1.\n  useEffect(() => {\n    const handle = setTimeout(() => {\n      if (searchInput !== (searchParams.get('q') ?? '')) {\n        updateParams({ q: searchInput || undefined, page: '1' });\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [searchInput]);\n\n  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n\n  return (\n    <Box>\n      <TextField\n        value={searchInput}\n        onChange={(event) => setSearchInput(event.target.value)}\n        placeholder=\"Search…\"\n        size=\"small\"\n        sx={{ mb: 2, maxWidth: 320 }}\n        slotProps={{\n          input: {\n            startAdornment: (\n              <InputAdornment position=\"start\">\n                <SearchIcon fontSize=\"small\" />\n              </InputAdornment>\n            ),\n          },\n          htmlInput: { 'aria-label': 'Search' },\n        }}\n      />\n      <DataGrid\n        autoHeight\n        columns={columns}\n        rows={rows}\n        rowCount={total}\n        loading={loading}\n        getRowId={getRowId}\n        paginationMode=\"server\"\n        sortingMode=\"server\"\n        paginationModel={{ page: page - 1, pageSize }}\n        onPaginationModelChange={(model) =>\n          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n        }\n        sortModel={sortModel}\n        onSortModelChange={(model) =>\n          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n        }\n        pageSizeOptions={[10, 20, 50, 100]}\n        slots={{\n          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n        }}\n        disableRowSelectionOnClick\n      />\n    </Box>\n  );\n}\nimport Card from '@mui/material/Card';\nimport CardContent from '@mui/material/CardContent';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Chip from '@mui/material/Chip';\nimport Box from '@mui/material/Box';\n\nexport interface StatCardProps {\n  label: string;\n  value: string | number;\n  delta?: { value: string; direction: 'up' | 'down' | 'flat' };\n  icon?: React.ReactNode;\n}\n\nconst DELTA_COLOR: Record<'up' | 'down' | 'flat', 'success' | 'error' | 'default'> = {\n  up: 'success',\n  down: 'error',\n  flat: 'default',\n};\n\nexport function StatCard({ label, value, delta, icon }: StatCardProps) {\n  return (\n    <Card variant=\"outlined\">\n      <CardContent>\n        <Stack direction=\"row\" sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n          <Stack spacing={0.5}>\n            <Typography variant=\"body2\" color=\"text.secondary\">\n              {label}\n            </Typography>\n            <Typography variant=\"h4\" sx={{ fontWeight: 600 }}>\n              {value}\n            </Typography>\n            {delta && <Chip size=\"small\" label={delta.value} color={DELTA_COLOR[delta.direction]} />}\n          </Stack>\n          {icon && <Box sx={{ color: 'primary.main' }}>{icon}</Box>}\n        </Stack>\n      </CardContent>\n    </Card>\n  );\n}\nimport Avatar from '@mui/material/Avatar';\n\nexport interface UserAvatarProps {\n  userId: string;\n  name: string;\n  size?: number;\n}\n\nconst PALETTE = ['#4F46E5', '#0EA5E9', '#15803D', '#B45309', '#B91C1C', '#7C3AED', '#0D9488'];\n\nfunction colorForId(id: string): string {\n  let hash = 0;\n  for (let i = 0; i < id.length; i += 1) {\n    hash = (hash * 31 + id.charCodeAt(i)) | 0;\n  }\n  return PALETTE[Math.abs(hash) % PALETTE.length];\n}\n\nfunction initialsFor(name: string): string {\n  const parts = name.trim().split(/\\s+/).filter(Boolean);\n  if (parts.length === 0) return '?';\n  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n}\n\n/** Avatar with initials on a deterministic background colour derived from userId. */\nexport function UserAvatar({ userId, name, size = 32 }: UserAvatarProps) {\n  return (\n    <Avatar sx={{ bgcolor: colorForId(userId), width: size, height: size, fontSize: size * 0.4 }}>\n      {initialsFor(name)}\n    </Avatar>\n  );\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      spacing={1.5}\n      sx={{ alignItems: 'center', justifyContent: 'center', py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"7fe1befa-2c95-4276-8d14-955b8d55df5c","uuid":"d8f1a120-a768-4600-89dd-41aaa3f9d066","timestamp":"2026-11-06T05:40:30.140Z","tool_use_result":{"stdout":"'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport TextField from '@mui/material/TextField';\nimport InputAdornment from '@mui/material/InputAdornment';\nimport SearchIcon from '@mui/icons-material/Search';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface DataTableProps {\n  columns: GridColDef[];\n  rows: readonly Record<string, unknown>[];\n  total: number;\n  loading?: boolean;\n  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n  getRowId?: (row: Record<string, unknown>) => string | number;\n}\n\n/**\n * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n * from (and written to) URL query params, a debounced search box, and the\n * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n * params change — this component owns no fetch logic of its own.\n */\nexport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const sortField = searchParams.get('sort') ?? undefined;\n  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n\n  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n\n  const updateParams = useCallback(\n    (updates: Record<string, string | undefined>) => {\n      const next = new URLSearchParams(searchParams.toString());\n      for (const [key, value] of Object.entries(updates)) {\n        if (value === undefined || value === '') {\n          next.delete(key);\n        } else {\n          next.set(key, value);\n        }\n      }\n      router.push(`${pathname}?${next.toString()}`);\n    },\n    [pathname, router, searchParams],\n  );\n\n  // Debounce search -> URL param, resetting to page 1.\n  useEffect(() => {\n    const handle = setTimeout(() => {\n      if (searchInput !== (searchParams.get('q') ?? '')) {\n        updateParams({ q: searchInput || undefined, page: '1' });\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [searchInput]);\n\n  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n\n  return (\n    <Box>\n      <TextField\n        value={searchInput}\n        onChange={(event) => setSearchInput(event.target.value)}\n        placeholder=\"Search…\"\n        size=\"small\"\n        sx={{ mb: 2, maxWidth: 320 }}\n        slotProps={{\n          input: {\n            startAdornment: (\n              <InputAdornment position=\"start\">\n                <SearchIcon fontSize=\"small\" />\n              </InputAdornment>\n            ),\n          },\n          htmlInput: { 'aria-label': 'Search' },\n        }}\n      />\n      <DataGrid\n        autoHeight\n        columns={columns}\n        rows={rows}\n        rowCount={total}\n        loading={loading}\n        getRowId={getRowId}\n        paginationMode=\"server\"\n        sortingMode=\"server\"\n        paginationModel={{ page: page - 1, pageSize }}\n        onPaginationModelChange={(model) =>\n          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n        }\n        sortModel={sortModel}\n        onSortModelChange={(model) =>\n          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n        }\n        pageSizeOptions={[10, 20, 50, 100]}\n        slots={{\n          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n        }}\n        disableRowSelectionOnClick\n      />\n    </Box>\n  );\n}\nimport Card from '@mui/material/Card';\nimport CardContent from '@mui/material/CardContent';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Chip from '@mui/material/Chip';\nimport Box from '@mui/material/Box';\n\nexport interface StatCardProps {\n  label: string;\n  value: string | number;\n  delta?: { value: string; direction: 'up' | 'down' | 'flat' };\n  icon?: React.ReactNode;\n}\n\nconst DELTA_COLOR: Record<'up' | 'down' | 'flat', 'success' | 'error' | 'default'> = {\n  up: 'success',\n  down: 'error',\n  flat: 'default',\n};\n\nexport function StatCard({ label, value, delta, icon }: StatCardProps) {\n  return (\n    <Card variant=\"outlined\">\n      <CardContent>\n        <Stack direction=\"row\" sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n          <Stack spacing={0.5}>\n            <Typography variant=\"body2\" color=\"text.secondary\">\n              {label}\n            </Typography>\n            <Typography variant=\"h4\" sx={{ fontWeight: 600 }}>\n              {value}\n            </Typography>\n            {delta && <Chip size=\"small\" label={delta.value} color={DELTA_COLOR[delta.direction]} />}\n          </Stack>\n          {icon && <Box sx={{ color: 'primary.main' }}>{icon}</Box>}\n        </Stack>\n      </CardContent>\n    </Card>\n  );\n}\nimport Avatar from '@mui/material/Avatar';\n\nexport interface UserAvatarProps {\n  userId: string;\n  name: string;\n  size?: number;\n}\n\nconst PALETTE = ['#4F46E5', '#0EA5E9', '#15803D', '#B45309', '#B91C1C', '#7C3AED', '#0D9488'];\n\nfunction colorForId(id: string): string {\n  let hash = 0;\n  for (let i = 0; i < id.length; i += 1) {\n    hash = (hash * 31 + id.charCodeAt(i)) | 0;\n  }\n  return PALETTE[Math.abs(hash) % PALETTE.length];\n}\n\nfunction initialsFor(name: string): string {\n  const parts = name.trim().split(/\\s+/).filter(Boolean);\n  if (parts.length === 0) return '?';\n  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n}\n\n/** Avatar with initials on a deterministic background colour derived from userId. */\nexport function UserAvatar({ userId, name, size = 32 }: UserAvatarProps) {\n  return (\n    <Avatar sx={{ bgcolor: colorForId(userId), width: size, height: size, fontSize: size * 0.4 }}>\n      {initialsFor(name)}\n    </Avatar>\n  );\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      spacing={1.5}\n      sx={{ alignItems: 'center', justifyContent: 'center', py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LCrnpJAkEmqTMGuarFnyqb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
