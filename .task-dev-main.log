{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F1wr2qkWextiJRWkZfBKLa","type":"tool_result","content":"{\n  \"ticketId\": \"SH-12\",\n  \"timestamp\": \"2026-11-09T19:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the SH-11 contracts that were here before.\",\n    \"basePath\": \"/api (the existing SchoolHub convention, not /api/v1). Route files are src/app/api/**/route.ts. Requirement: FR-34.\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with a Zod schema from src/lib/validators/announcements.ts → one call into src/server/announcements/announcements-service.ts → ok(data) / ok(data, {status: 201}) / paginated(data, meta). No business logic in routes. Requirements: FR-34, FR-36, NFR-8.\",\n    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. Paginated endpoints return { \\\"data\\\": [...], \\\"meta\\\": { page, pageSize, total } } via paginated() in src/server/http.ts. Requirement: FR-34.\",\n    \"pagination\": \"?page (≥1, default 1) & ?pageSize (default 20, max 100 via parsePagination; GET /api/announcements/manage clamps to 50 because it computes live reach per row). Requirements: FR-17, FR-23, FR-31.\",\n    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } }. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, RATE_LIMITED 429, INTERNAL 500. Requirement: FR-34.\",\n    \"accessErrors\": \"Targeting violations on create, update and preview return 403 FORBIDDEN (AC-3). STUDENT/PARENT on ADMIN/TEACHER routes get 403 from requireRole (FR-11). Callers who may not see a specific announcement (non-member, non-author, or not yet visible) get 404 NOT_FOUND on detail, ack, stats, remind, PATCH and archive, so its existence is not leaked (system-design A10). Requirements: NFR-3, NFR-6.\",\n    \"dates\": \"All timestamps are ISO 8601 UTC strings. The composer converts SchoolSettings.timezone input to UTC before sending. Clients display with formatInSchoolTz. Requirement: NFR-7.\",\n    \"visibility\": \"visible = status ∈ {SCHEDULED, PUBLISHED} ∧ publishAt ≤ now ∧ (expiresAt null ∨ expiresAt > now), evaluated at read time. Requirements: FR-16, NFR-6.\",\n    \"sanitisation\": \"`body` is raw Markdown, rendered client-side only through MarkdownView (rehype-sanitize). `excerpt` is plain text from toPlainText and must be rendered as escaped text. Requirement: NFR-4.\"\n  },\n\n  \"components\": {\n    \"AudienceRow\": {\n      \"description\": \"Generic audience row (FR-8). refId is required unless the type is SCHOOL or STAFF. For ROLE it must be a Role value. For GRADE_LEVEL, SECTION and COURSE, at least one include flag must be true. Requirements: FR-1, FR-3..FR-6.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"type\": { \"enum\": [\"SCHOOL\", \"STAFF\", \"ROLE\", \"GRADE_LEVEL\", \"SECTION\", \"COURSE\"] },\n        \"refId\": { \"type\": [\"string\", \"null\"], \"description\": \"GradeLevel.id | Section.id | Course.id | Role value\" },\n        \"includeStudents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeParents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeTeachers\": { \"type\": \"boolean\", \"default\": true }\n      },\n      \"required\": [\"type\"]\n    },\n    \"AnnouncementInput\": {\n      \"description\": \"Body of POST /api/announcements. Mirrors announcementInputSchema. Requirements: FR-2, FR-13, FR-15, FR-16.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150, \"description\": \"Trimmed\" },\n        \"body\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 20000, \"description\": \"Markdown\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"minItems\": 0, \"maxItems\": 20 },\n        \"pinned\": { \"type\": \"boolean\", \"default\": false },\n        \"requiresAck\": { \"type\": \"boolean\", \"default\": false },\n        \"isPublic\": { \"type\": \"boolean\", \"default\": false, \"description\": \"ADMIN only. true from a TEACHER → 403 (FR-10)\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"], \"description\": \"FileObject id uploaded with context 'announcement'\" },\n        \"attachmentFileIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"maxItems\": 10, \"default\": [] },\n        \"mode\": { \"enum\": [\"draft\", \"publish\", \"schedule\"] },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Required and > now when mode = schedule. Ignored for publish (set to now)\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Must be > (publishAt ?? now)\" }\n      },\n      \"required\": [\"title\", \"body\", \"audiences\", \"mode\"]\n    },\n    \"AnnouncementPatch\": {\n      \"description\": \"AnnouncementInput with every field optional (announcementPatchSchema). audiences, when present, replaces all rows. Requirements: FR-12, FR-29.\",\n      \"type\": \"object\",\n      \"allOf\": [{ \"$ref\": \"#/components/AnnouncementInput\" }],\n      \"required\": []\n    },\n    \"Author\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\"] }\n      },\n      \"required\": [\"id\", \"name\", \"role\"]\n    },\n    \"Attachment\": {\n      \"description\": \"Download via the existing GET /api/files/:id, gated by the 'announcement' file context (FR-30).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"description\": \"FileObject id\" },\n        \"name\": { \"type\": \"string\" },\n        \"mimeType\": { \"type\": \"string\" },\n        \"size\": { \"type\": \"integer\" }\n      },\n      \"required\": [\"id\", \"name\"]\n    },\n    \"FeedItem\": {\n      \"description\": \"Feed card DTO. Requirements: FR-17, FR-18, FR-22, NFR-5.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"excerpt\": { \"type\": \"string\", \"maxLength\": 200, \"description\": \"Plain text (toPlainText(body, 200))\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"pinned\": { \"type\": \"boolean\", \"description\": \"true only for the ≤3 items lifted to the top of page 1\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"Audience chips, e.g. 'Grade 7 · Parents'\" },\n        \"attachmentCount\": { \"type\": \"integer\" },\n        \"unread\": { \"type\": \"boolean\", \"description\": \"No AnnouncementRead.readAt for the caller. UI shows a dot with visually hidden text 'Unread'\" },\n        \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"forChildren\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" } } }, \"description\": \"PARENT callers only; empty otherwise. The linked children that put the parent in a GRADE_LEVEL, SECTION or COURSE audience ('For Sam')\" }\n      },\n      \"required\": [\"id\", \"title\", \"excerpt\", \"author\", \"publishAt\", \"pinned\", \"requiresAck\", \"labels\", \"attachmentCount\", \"unread\", \"forChildren\"]\n    },\n    \"AnnouncementDetail\": {\n      \"description\": \"Full record for detail and edit. Requirements: FR-13, FR-19, FR-20.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown. Render only via MarkdownView\" },\n        \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n        \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"description\": \"Returned only when canEdit; [] otherwise\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n        \"pinned\": { \"type\": \"boolean\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"isPublic\": { \"type\": \"boolean\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"attachments\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/Attachment\" } },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"myRead\": { \"type\": [\"object\", \"null\"], \"properties\": { \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" } }, \"description\": \"null when the caller is not an audience member (for example an admin outside the audience)\" },\n        \"canEdit\": { \"type\": \"boolean\", \"description\": \"ADMIN, or the author while not ARCHIVED\" },\n        \"canViewStats\": { \"type\": \"boolean\", \"description\": \"ADMIN or the author\" }\n      },\n      \"required\": [\"id\", \"title\", \"body\", \"status\", \"displayStatus\", \"author\", \"labels\", \"pinned\", \"requiresAck\", \"isPublic\", \"attachments\", \"canEdit\", \"canViewStats\"]\n    },\n    \"AudienceCounts\": {\n      \"description\": \"Requirements: FR-14, FR-15.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"total\": { \"type\": \"integer\" },\n        \"byRole\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"STUDENT\": { \"type\": \"integer\" },\n            \"PARENT\": { \"type\": \"integer\" },\n            \"TEACHER\": { \"type\": \"integer\" },\n            \"ADMIN\": { \"type\": \"integer\" }\n          },\n          \"required\": [\"STUDENT\", \"PARENT\", \"TEACHER\", \"ADMIN\"]\n        }\n      },\n      \"required\": [\"total\", \"byRole\"]\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Feed for the caller (any authenticated role). Only visible announcements whose audience includes the caller, resolved with audiences.some(audienceWhere(keys)) and never by expanding recipients (NFR-2). Page 1 starts with up to 3 pinned items (newest first, pinned=true), followed by the page of remaining items in publishAt desc, id desc order. meta.total excludes those lifted pins. Extra pinned items appear in date order with pinned=false (A4). With courseId, the caller must pass assertCanViewCourse (else 404) and results are limited to rows with a COURSE audience for that course. Expired, scheduled-future, draft and archived items are never returned.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {\n        \"query\": {\n          \"tab\": { \"enum\": [\"all\", \"unread\", \"ack\"], \"default\": \"all\", \"description\": \"unread = no readAt; ack = requiresAck and not acknowledged by the caller\" },\n          \"courseId\": { \"type\": \"string\", \"description\": \"Optional. Course 'Announcements' tab\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/FeedItem\" } },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (bad query)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (courseId the caller cannot view)\"],\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-21\", \"FR-22\", \"FR-34\", \"NFR-2\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Create an announcement. assertCanTarget(user, audiences, isPublic) runs first. A TEACHER may target only COURSE rows for courses where they are teacherId or in coTeacherIds, and SECTION rows for the section they homeroom. Anything else, or isPublic=true, returns 403. For mode publish or schedule, zero resolved recipients returns 400 VALIDATION_ERROR (details.reason='NO_RECIPIENTS'). Drafts may have zero recipients. A single transaction writes the announcement, audience rows and attachment rows and calls attachFiles. mode=publish sets status PUBLISHED and publishAt=now, then claimAndNotify sends announcement.published exactly once (generic-notification email, 300-character plain-text body, 'Read announcement' link to /announcements/:id, mandatoryInApp = requiresAck). mode=schedule sets status SCHEDULED and does not notify. mode=draft sets status DRAFT.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/components/AnnouncementInput\" } },\n      \"responseSchema\": {\n        \"status\": 201,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod: title > 150, body > 20,000, schedule without a future publishAt, expiresAt ≤ publishAt; or NO_RECIPIENTS on publish/schedule)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT; teacher targeting SCHOOL/STAFF/ROLE/GRADE_LEVEL, a foreign course or section, or isPublic)\", \"404 NOT_FOUND (coverFileId or attachment not owned by the caller or not uploaded)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-13\", \"FR-15\", \"FR-16\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/unread-count\",\n      \"description\": \"Sidebar badge count. Uses the same where clause as the feed's 'all' tab plus reads.none{userId, readAt not null}. Polled every 30 seconds, only while the page is visible.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-32\", \"FR-34\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/preview-audience\",\n      \"description\": \"Live recipient count for the composer ('Will reach 412 people: 180 students, 214 parents, 18 teachers'). assertCanTarget(user, audiences, false) runs first, so teachers cannot probe the size of audiences they cannot target. Then countAudienceByRole. ACTIVE, non-archived users only, deduplicated. The client debounces calls by 400 ms.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"body\": {\n          \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"maxItems\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AudienceCounts\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role, or teacher targeting violation)\"],\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-10\", \"FR-14\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/manage\",\n      \"description\": \"Manage list with no visibility filter, so it includes drafts, scheduled, expired and archived items. TEACHER sees authorId = me; ADMIN sees all. Ordered by updatedAt desc. reach, readPct and ackPct are computed live against the current resolveAudienceUserIds, and reads from users who have left the audience are excluded. Percentages are integers rounded half-up; they are null when reach is 0, and ackPct is null when requiresAck is false.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"], \"description\": \"Optional filter on displayStatus\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 50, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n                \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n                \"author\": { \"$ref\": \"#/components/Author\" },\n                \"audienceSummary\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"audienceLabels(rows)\" },\n                \"pinned\": { \"type\": \"boolean\" },\n                \"requiresAck\": { \"type\": \"boolean\" },\n                \"isPublic\": { \"type\": \"boolean\" },\n                \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"reach\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n              },\n              \"required\": [\"id\", \"title\", \"status\", \"displayStatus\", \"author\", \"audienceSummary\", \"reach\", \"readPct\", \"ackPct\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Detail. Allowed for ADMIN, the author (any status), or an audience member while the announcement is visible. Everyone else gets 404, including members before publishAt or after expiry. For audience members only, the call upserts AnnouncementRead.readAt and keeps the first readAt. The edit page (/announcements/:id/edit) uses the same endpoint and reads audiences from it when canEdit.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (missing, or not visible to the caller)\"],\n      \"requirementIds\": [\"FR-19\", \"FR-30\", \"FR-34\", \"NFR-4\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Update. Allowed for the author or ADMIN; others get 404. A non-admin editing an ARCHIVED row gets 409 CONFLICT (archive is terminal for authors). If audiences or isPublic is in the patch, assertCanTarget re-runs on the resulting values. audiences, when sent, replaces all rows. attachmentFileIds, when sent, re-syncs attachments (attaches new ones, detaches removed ones). A transition from DRAFT to publish or schedule re-checks for zero recipients and, for publish, calls claimAndNotify. Edits to an already-notified announcement, including audience changes, never re-notify, because notifiedAt is never cleared. An ADMIN editing someone else's announcement writes audit('announcement.update'). mode=draft on a PUBLISHED row returns 409 (unpublishing is done by archiving).\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"body\": { \"$ref\": \"#/components/AnnouncementPatch\" }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod or NO_RECIPIENTS)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role or targeting violation)\", \"404 NOT_FOUND (not author/admin)\", \"409 CONFLICT (author editing ARCHIVED; PUBLISHED → draft)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-15\", \"FR-27\", \"FR-29\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/archive\",\n      \"description\": \"Archive: sets status ARCHIVED. Allowed for the author or ADMIN; others get 404. Idempotent: archiving an already-archived row returns 200 with the current record. An ADMIN archiving someone else's announcement writes audit('announcement.archive').\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"id\": \"string\", \"status\": \"ARCHIVED\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/ack\",\n      \"description\": \"Acknowledge. Requires a visible announcement and audience membership; otherwise 404. A row with requiresAck=false returns 409. Upserts AnnouncementRead, sets acknowledgedAt once and also sets readAt if it was empty. Repeat calls are idempotent and return the original acknowledgedAt. The UI shows 'Acknowledged on 14 Sep' in the school timezone.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"readAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not visible or not a member)\", \"409 CONFLICT (requiresAck=false)\"],\n      \"requirementIds\": [\"FR-20\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id/stats\",\n      \"description\": \"Per-announcement stats. Allowed for the author or ADMIN; others get 404. Recipients come from the live resolveAudienceUserIds, left-joined to AnnouncementRead. The counts always describe the full audience, while the filter applies only to the rows. With format=csv, the response is text/csv with Content-Disposition: attachment; filename=\\\"announcement-<id>-recipients.csv\\\", built by toCsv from src/server/csv.ts with the columns Name, Role, Read at and Acknowledged at, dates in the school timezone, and the filter applied. Rows are sorted by name.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"query\": {\n          \"filter\": { \"enum\": [\"unread\", \"unacked\"], \"description\": \"Optional. unacked is only meaningful when requiresAck\" },\n          \"format\": { \"enum\": [\"csv\"], \"description\": \"Optional\" }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"counts\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"recipients\": { \"type\": \"integer\" },\n                \"read\": { \"type\": \"integer\" },\n                \"acknowledged\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"Rounded half-up; null when recipients is 0\" },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"null when !requiresAck or recipients is 0. AC-5: 30/50 → 60\" }\n              }\n            },\n            \"requiresAck\": { \"type\": \"boolean\" },\n            \"lastRemindedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n            \"rows\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"userId\": { \"type\": \"string\" },\n                  \"name\": { \"type\": \"string\" },\n                  \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"] },\n                  \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                  \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n                }\n              }\n            }\n          }\n        },\n        \"csvVariant\": \"200 text/csv; charset=utf-8 (no JSON envelope)\"\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND (not author/admin)\"],\n      \"requirementIds\": [\"FR-24\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/remind\",\n      \"description\": \"Send a reminder to recipients who have not acknowledged. Allowed for the author or ADMIN; others get 404. The announcement must have requiresAck and be visible; otherwise 409. The throttle is claimed atomically: updateMany where lastRemindedAt is null or ≤ now − 24h sets lastRemindedAt = now. If no row is claimed, the response is 429 RATE_LIMITED with details.retryAfter (ISO, lastRemindedAt + 24h). Otherwise it calls notify('announcement.reminder', mandatoryInApp) for recipients minus acknowledged users. If nobody is left to remind, it still claims the throttle and returns notified: 0. AC-5: 50 recipients with 30 acknowledged → notified 20.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"notified\": { \"type\": \"integer\" }, \"remindedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\", \"409 CONFLICT (!requiresAck or not visible)\", \"429 RATE_LIMITED { details: { retryAfter } }\"],\n      \"requirementIds\": [\"FR-25\", \"FR-26\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/public/news\",\n      \"description\": \"Public news for the future PRD-18 website. No authentication. The path is added to PUBLIC_API_PATHS in src/config/public-routes.ts. Rate-limited by client IP with the existing src/server/rate-limit.ts, which returns 429 RATE_LIMITED. Returns isPublic ∧ visible announcements, newest first. The DTO deliberately omits author identity, audience and read data. Cover images and attachments are served through GET /api/files/:id, which the 'announcement' file resolver allows anonymously only for public, visible announcements.\",\n      \"auth\": \"none (public)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"excerpt\": { \"type\": \"string\", \"maxLength\": 200 },\n                \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown; consumers must sanitise (MarkdownView)\" },\n                \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n                \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n                \"attachments\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } }\n              },\n              \"required\": [\"id\", \"title\", \"excerpt\", \"body\", \"publishAt\", \"attachments\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"429 RATE_LIMITED\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-34\", \"NFR-4\", \"NFR-9\"]\n    }\n  ],\n\n  \"internalHooks\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"Existing endpoint, gated by CRON_SECRET; its contract is unchanged. It gains an isolated publishDueAnnouncements(now) pass (findMany SCHEDULED ∧ notifiedAt null ∧ publishAt ≤ now, take 50 → claimAndNotify each). The pass is idempotent under concurrent runs. The response may add an 'announcementsPublished' integer next to the existing counters.\",\n      \"requirementIds\": [\"FR-27\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/files/:id\",\n      \"description\": \"Existing endpoint; its contract is unchanged. It gains the new 'announcement' access context: allowed for anyone (including anonymous callers) if isPublic ∧ visible; otherwise for ADMIN, the author, or a member while visible; otherwise denied.\",\n      \"requirementIds\": [\"FR-30\", \"NFR-6\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"98a511c8-0f94-422f-bce3-9c853eb574ca","uuid":"ec412b7d-30d6-4ac9-b91b-b6ee382e3d4e","timestamp":"2026-11-09T16:39:06.786Z","tool_use_result":{"stdout":"{\n  \"ticketId\": \"SH-12\",\n  \"timestamp\": \"2026-11-09T19:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the SH-11 contracts that were here before.\",\n    \"basePath\": \"/api (the existing SchoolHub convention, not /api/v1). Route files are src/app/api/**/route.ts. Requirement: FR-34.\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with a Zod schema from src/lib/validators/announcements.ts → one call into src/server/announcements/announcements-service.ts → ok(data) / ok(data, {status: 201}) / paginated(data, meta). No business logic in routes. Requirements: FR-34, FR-36, NFR-8.\",\n    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. Paginated endpoints return { \\\"data\\\": [...], \\\"meta\\\": { page, pageSize, total } } via paginated() in src/server/http.ts. Requirement: FR-34.\",\n    \"pagination\": \"?page (≥1, default 1) & ?pageSize (default 20, max 100 via parsePagination; GET /api/announcements/manage clamps to 50 because it computes live reach per row). Requirements: FR-17, FR-23, FR-31.\",\n    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } }. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, RATE_LIMITED 429, INTERNAL 500. Requirement: FR-34.\",\n    \"accessErrors\": \"Targeting violations on create, update and preview return 403 FORBIDDEN (AC-3). STUDENT/PARENT on ADMIN/TEACHER routes get 403 from requireRole (FR-11). Callers who may not see a specific announcement (non-member, non-author, or not yet visible) get 404 NOT_FOUND on detail, ack, stats, remind, PATCH and archive, so its existence is not leaked (system-design A10). Requirements: NFR-3, NFR-6.\",\n    \"dates\": \"All timestamps are ISO 8601 UTC strings. The composer converts SchoolSettings.timezone input to UTC before sending. Clients display with formatInSchoolTz. Requirement: NFR-7.\",\n    \"visibility\": \"visible = status ∈ {SCHEDULED, PUBLISHED} ∧ publishAt ≤ now ∧ (expiresAt null ∨ expiresAt > now), evaluated at read time. Requirements: FR-16, NFR-6.\",\n    \"sanitisation\": \"`body` is raw Markdown, rendered client-side only through MarkdownView (rehype-sanitize). `excerpt` is plain text from toPlainText and must be rendered as escaped text. Requirement: NFR-4.\"\n  },\n\n  \"components\": {\n    \"AudienceRow\": {\n      \"description\": \"Generic audience row (FR-8). refId is required unless the type is SCHOOL or STAFF. For ROLE it must be a Role value. For GRADE_LEVEL, SECTION and COURSE, at least one include flag must be true. Requirements: FR-1, FR-3..FR-6.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"type\": { \"enum\": [\"SCHOOL\", \"STAFF\", \"ROLE\", \"GRADE_LEVEL\", \"SECTION\", \"COURSE\"] },\n        \"refId\": { \"type\": [\"string\", \"null\"], \"description\": \"GradeLevel.id | Section.id | Course.id | Role value\" },\n        \"includeStudents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeParents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeTeachers\": { \"type\": \"boolean\", \"default\": true }\n      },\n      \"required\": [\"type\"]\n    },\n    \"AnnouncementInput\": {\n      \"description\": \"Body of POST /api/announcements. Mirrors announcementInputSchema. Requirements: FR-2, FR-13, FR-15, FR-16.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150, \"description\": \"Trimmed\" },\n        \"body\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 20000, \"description\": \"Markdown\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"minItems\": 0, \"maxItems\": 20 },\n        \"pinned\": { \"type\": \"boolean\", \"default\": false },\n        \"requiresAck\": { \"type\": \"boolean\", \"default\": false },\n        \"isPublic\": { \"type\": \"boolean\", \"default\": false, \"description\": \"ADMIN only. true from a TEACHER → 403 (FR-10)\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"], \"description\": \"FileObject id uploaded with context 'announcement'\" },\n        \"attachmentFileIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"maxItems\": 10, \"default\": [] },\n        \"mode\": { \"enum\": [\"draft\", \"publish\", \"schedule\"] },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Required and > now when mode = schedule. Ignored for publish (set to now)\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Must be > (publishAt ?? now)\" }\n      },\n      \"required\": [\"title\", \"body\", \"audiences\", \"mode\"]\n    },\n    \"AnnouncementPatch\": {\n      \"description\": \"AnnouncementInput with every field optional (announcementPatchSchema). audiences, when present, replaces all rows. Requirements: FR-12, FR-29.\",\n      \"type\": \"object\",\n      \"allOf\": [{ \"$ref\": \"#/components/AnnouncementInput\" }],\n      \"required\": []\n    },\n    \"Author\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\"] }\n      },\n      \"required\": [\"id\", \"name\", \"role\"]\n    },\n    \"Attachment\": {\n      \"description\": \"Download via the existing GET /api/files/:id, gated by the 'announcement' file context (FR-30).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"description\": \"FileObject id\" },\n        \"name\": { \"type\": \"string\" },\n        \"mimeType\": { \"type\": \"string\" },\n        \"size\": { \"type\": \"integer\" }\n      },\n      \"required\": [\"id\", \"name\"]\n    },\n    \"FeedItem\": {\n      \"description\": \"Feed card DTO. Requirements: FR-17, FR-18, FR-22, NFR-5.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"excerpt\": { \"type\": \"string\", \"maxLength\": 200, \"description\": \"Plain text (toPlainText(body, 200))\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"pinned\": { \"type\": \"boolean\", \"description\": \"true only for the ≤3 items lifted to the top of page 1\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"Audience chips, e.g. 'Grade 7 · Parents'\" },\n        \"attachmentCount\": { \"type\": \"integer\" },\n        \"unread\": { \"type\": \"boolean\", \"description\": \"No AnnouncementRead.readAt for the caller. UI shows a dot with visually hidden text 'Unread'\" },\n        \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"forChildren\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" } } }, \"description\": \"PARENT callers only; empty otherwise. The linked children that put the parent in a GRADE_LEVEL, SECTION or COURSE audience ('For Sam')\" }\n      },\n      \"required\": [\"id\", \"title\", \"excerpt\", \"author\", \"publishAt\", \"pinned\", \"requiresAck\", \"labels\", \"attachmentCount\", \"unread\", \"forChildren\"]\n    },\n    \"AnnouncementDetail\": {\n      \"description\": \"Full record for detail and edit. Requirements: FR-13, FR-19, FR-20.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown. Render only via MarkdownView\" },\n        \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n        \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"description\": \"Returned only when canEdit; [] otherwise\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n        \"pinned\": { \"type\": \"boolean\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"isPublic\": { \"type\": \"boolean\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"attachments\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/Attachment\" } },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"myRead\": { \"type\": [\"object\", \"null\"], \"properties\": { \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" } }, \"description\": \"null when the caller is not an audience member (for example an admin outside the audience)\" },\n        \"canEdit\": { \"type\": \"boolean\", \"description\": \"ADMIN, or the author while not ARCHIVED\" },\n        \"canViewStats\": { \"type\": \"boolean\", \"description\": \"ADMIN or the author\" }\n      },\n      \"required\": [\"id\", \"title\", \"body\", \"status\", \"displayStatus\", \"author\", \"labels\", \"pinned\", \"requiresAck\", \"isPublic\", \"attachments\", \"canEdit\", \"canViewStats\"]\n    },\n    \"AudienceCounts\": {\n      \"description\": \"Requirements: FR-14, FR-15.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"total\": { \"type\": \"integer\" },\n        \"byRole\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"STUDENT\": { \"type\": \"integer\" },\n            \"PARENT\": { \"type\": \"integer\" },\n            \"TEACHER\": { \"type\": \"integer\" },\n            \"ADMIN\": { \"type\": \"integer\" }\n          },\n          \"required\": [\"STUDENT\", \"PARENT\", \"TEACHER\", \"ADMIN\"]\n        }\n      },\n      \"required\": [\"total\", \"byRole\"]\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Feed for the caller (any authenticated role). Only visible announcements whose audience includes the caller, resolved with audiences.some(audienceWhere(keys)) and never by expanding recipients (NFR-2). Page 1 starts with up to 3 pinned items (newest first, pinned=true), followed by the page of remaining items in publishAt desc, id desc order. meta.total excludes those lifted pins. Extra pinned items appear in date order with pinned=false (A4). With courseId, the caller must pass assertCanViewCourse (else 404) and results are limited to rows with a COURSE audience for that course. Expired, scheduled-future, draft and archived items are never returned.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {\n        \"query\": {\n          \"tab\": { \"enum\": [\"all\", \"unread\", \"ack\"], \"default\": \"all\", \"description\": \"unread = no readAt; ack = requiresAck and not acknowledged by the caller\" },\n          \"courseId\": { \"type\": \"string\", \"description\": \"Optional. Course 'Announcements' tab\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/FeedItem\" } },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (bad query)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (courseId the caller cannot view)\"],\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-21\", \"FR-22\", \"FR-34\", \"NFR-2\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Create an announcement. assertCanTarget(user, audiences, isPublic) runs first. A TEACHER may target only COURSE rows for courses where they are teacherId or in coTeacherIds, and SECTION rows for the section they homeroom. Anything else, or isPublic=true, returns 403. For mode publish or schedule, zero resolved recipients returns 400 VALIDATION_ERROR (details.reason='NO_RECIPIENTS'). Drafts may have zero recipients. A single transaction writes the announcement, audience rows and attachment rows and calls attachFiles. mode=publish sets status PUBLISHED and publishAt=now, then claimAndNotify sends announcement.published exactly once (generic-notification email, 300-character plain-text body, 'Read announcement' link to /announcements/:id, mandatoryInApp = requiresAck). mode=schedule sets status SCHEDULED and does not notify. mode=draft sets status DRAFT.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/components/AnnouncementInput\" } },\n      \"responseSchema\": {\n        \"status\": 201,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod: title > 150, body > 20,000, schedule without a future publishAt, expiresAt ≤ publishAt; or NO_RECIPIENTS on publish/schedule)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT; teacher targeting SCHOOL/STAFF/ROLE/GRADE_LEVEL, a foreign course or section, or isPublic)\", \"404 NOT_FOUND (coverFileId or attachment not owned by the caller or not uploaded)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-13\", \"FR-15\", \"FR-16\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/unread-count\",\n      \"description\": \"Sidebar badge count. Uses the same where clause as the feed's 'all' tab plus reads.none{userId, readAt not null}. Polled every 30 seconds, only while the page is visible.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-32\", \"FR-34\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/preview-audience\",\n      \"description\": \"Live recipient count for the composer ('Will reach 412 people: 180 students, 214 parents, 18 teachers'). assertCanTarget(user, audiences, false) runs first, so teachers cannot probe the size of audiences they cannot target. Then countAudienceByRole. ACTIVE, non-archived users only, deduplicated. The client debounces calls by 400 ms.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"body\": {\n          \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"maxItems\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AudienceCounts\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role, or teacher targeting violation)\"],\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-10\", \"FR-14\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/manage\",\n      \"description\": \"Manage list with no visibility filter, so it includes drafts, scheduled, expired and archived items. TEACHER sees authorId = me; ADMIN sees all. Ordered by updatedAt desc. reach, readPct and ackPct are computed live against the current resolveAudienceUserIds, and reads from users who have left the audience are excluded. Percentages are integers rounded half-up; they are null when reach is 0, and ackPct is null when requiresAck is false.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"], \"description\": \"Optional filter on displayStatus\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 50, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n                \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n                \"author\": { \"$ref\": \"#/components/Author\" },\n                \"audienceSummary\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"audienceLabels(rows)\" },\n                \"pinned\": { \"type\": \"boolean\" },\n                \"requiresAck\": { \"type\": \"boolean\" },\n                \"isPublic\": { \"type\": \"boolean\" },\n                \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"reach\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n              },\n              \"required\": [\"id\", \"title\", \"status\", \"displayStatus\", \"author\", \"audienceSummary\", \"reach\", \"readPct\", \"ackPct\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Detail. Allowed for ADMIN, the author (any status), or an audience member while the announcement is visible. Everyone else gets 404, including members before publishAt or after expiry. For audience members only, the call upserts AnnouncementRead.readAt and keeps the first readAt. The edit page (/announcements/:id/edit) uses the same endpoint and reads audiences from it when canEdit.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (missing, or not visible to the caller)\"],\n      \"requirementIds\": [\"FR-19\", \"FR-30\", \"FR-34\", \"NFR-4\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Update. Allowed for the author or ADMIN; others get 404. A non-admin editing an ARCHIVED row gets 409 CONFLICT (archive is terminal for authors). If audiences or isPublic is in the patch, assertCanTarget re-runs on the resulting values. audiences, when sent, replaces all rows. attachmentFileIds, when sent, re-syncs attachments (attaches new ones, detaches removed ones). A transition from DRAFT to publish or schedule re-checks for zero recipients and, for publish, calls claimAndNotify. Edits to an already-notified announcement, including audience changes, never re-notify, because notifiedAt is never cleared. An ADMIN editing someone else's announcement writes audit('announcement.update'). mode=draft on a PUBLISHED row returns 409 (unpublishing is done by archiving).\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"body\": { \"$ref\": \"#/components/AnnouncementPatch\" }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod or NO_RECIPIENTS)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role or targeting violation)\", \"404 NOT_FOUND (not author/admin)\", \"409 CONFLICT (author editing ARCHIVED; PUBLISHED → draft)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-15\", \"FR-27\", \"FR-29\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/archive\",\n      \"description\": \"Archive: sets status ARCHIVED. Allowed for the author or ADMIN; others get 404. Idempotent: archiving an already-archived row returns 200 with the current record. An ADMIN archiving someone else's announcement writes audit('announcement.archive').\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"id\": \"string\", \"status\": \"ARCHIVED\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/ack\",\n      \"description\": \"Acknowledge. Requires a visible announcement and audience membership; otherwise 404. A row with requiresAck=false returns 409. Upserts AnnouncementRead, sets acknowledgedAt once and also sets readAt if it was empty. Repeat calls are idempotent and return the original acknowledgedAt. The UI shows 'Acknowledged on 14 Sep' in the school timezone.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"readAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not visible or not a member)\", \"409 CONFLICT (requiresAck=false)\"],\n      \"requirementIds\": [\"FR-20\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id/stats\",\n      \"description\": \"Per-announcement stats. Allowed for the author or ADMIN; others get 404. Recipients come from the live resolveAudienceUserIds, left-joined to AnnouncementRead. The counts always describe the full audience, while the filter applies only to the rows. With format=csv, the response is text/csv with Content-Disposition: attachment; filename=\\\"announcement-<id>-recipients.csv\\\", built by toCsv from src/server/csv.ts with the columns Name, Role, Read at and Acknowledged at, dates in the school timezone, and the filter applied. Rows are sorted by name.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"query\": {\n          \"filter\": { \"enum\": [\"unread\", \"unacked\"], \"description\": \"Optional. unacked is only meaningful when requiresAck\" },\n          \"format\": { \"enum\": [\"csv\"], \"description\": \"Optional\" }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"counts\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"recipients\": { \"type\": \"integer\" },\n                \"read\": { \"type\": \"integer\" },\n                \"acknowledged\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"Rounded half-up; null when recipients is 0\" },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"null when !requiresAck or recipients is 0. AC-5: 30/50 → 60\" }\n              }\n            },\n            \"requiresAck\": { \"type\": \"boolean\" },\n            \"lastRemindedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n            \"rows\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"userId\": { \"type\": \"string\" },\n                  \"name\": { \"type\": \"string\" },\n                  \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"] },\n                  \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                  \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n                }\n              }\n            }\n          }\n        },\n        \"csvVariant\": \"200 text/csv; charset=utf-8 (no JSON envelope)\"\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND (not author/admin)\"],\n      \"requirementIds\": [\"FR-24\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/remind\",\n      \"description\": \"Send a reminder to recipients who have not acknowledged. Allowed for the author or ADMIN; others get 404. The announcement must have requiresAck and be visible; otherwise 409. The throttle is claimed atomically: updateMany where lastRemindedAt is null or ≤ now − 24h sets lastRemindedAt = now. If no row is claimed, the response is 429 RATE_LIMITED with details.retryAfter (ISO, lastRemindedAt + 24h). Otherwise it calls notify('announcement.reminder', mandatoryInApp) for recipients minus acknowledged users. If nobody is left to remind, it still claims the throttle and returns notified: 0. AC-5: 50 recipients with 30 acknowledged → notified 20.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"notified\": { \"type\": \"integer\" }, \"remindedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\", \"409 CONFLICT (!requiresAck or not visible)\", \"429 RATE_LIMITED { details: { retryAfter } }\"],\n      \"requirementIds\": [\"FR-25\", \"FR-26\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/public/news\",\n      \"description\": \"Public news for the future PRD-18 website. No authentication. The path is added to PUBLIC_API_PATHS in src/config/public-routes.ts. Rate-limited by client IP with the existing src/server/rate-limit.ts, which returns 429 RATE_LIMITED. Returns isPublic ∧ visible announcements, newest first. The DTO deliberately omits author identity, audience and read data. Cover images and attachments are served through GET /api/files/:id, which the 'announcement' file resolver allows anonymously only for public, visible announcements.\",\n      \"auth\": \"none (public)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"excerpt\": { \"type\": \"string\", \"maxLength\": 200 },\n                \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown; consumers must sanitise (MarkdownView)\" },\n                \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n                \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n                \"attachments\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } }\n              },\n              \"required\": [\"id\", \"title\", \"excerpt\", \"body\", \"publishAt\", \"attachments\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"429 RATE_LIMITED\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-34\", \"NFR-4\", \"NFR-9\"]\n    }\n  ],\n\n  \"internalHooks\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"Existing endpoint, gated by CRON_SECRET; its contract is unchanged. It gains an isolated publishDueAnnouncements(now) pass (findMany SCHEDULED ∧ notifiedAt null ∧ publishAt ≤ now, take 50 → claimAndNotify each). The pass is idempotent under concurrent runs. The response may add an 'announcementsPublished' integer next to the existing counters.\",\n      \"requirementIds\": [\"FR-27\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/files/:id\",\n      \"description\": \"Existing endpoint; its contract is unchanged. It gains the new 'announcement' access context: allowed for anyone (including anonymous callers) if isPublic ∧ visible; otherwise for ADMIN, the author, or a member while visible; otherwise denied.\",\n      \"requirementIds\": [\"FR-30\", \"NFR-6\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01F1wr2qkWextiJRWkZfBKLa","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgsgcfZ2ydNioDw2tsNYK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0141yeUWZpUqEwr8dwRZ214J","name":"Bash","input":{"command":"cd \"/Users/ikramaansari/Documents/React Projects/schoolhub\" && cat artifacts/intake/requirements.json","description":"Read requirements"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15672,"cache_read_input_tokens":41855,"cache_creation":{"ephemeral_5m_input_tokens":15672,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98a511c8-0f94-422f-bce3-9c853eb574ca","uuid":"b21bcd1c-c42a-401e-89c5-c5516c38c592","timestamp":"2026-11-09T16:39:07.199Z","request_id":"req_011CgsgcfEgqhdWXxHem4MQe","wire_tool_inputs":{"toolu_0141yeUWZpUqEwr8dwRZ214J":{"command":"cd \"/Users/ikramaansari/Documents/React Projects/schoolhub\" && cat artifacts/intake/requirements.json","description":"Read requirements"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0141yeUWZpUqEwr8dwRZ214J","type":"tool_result","content":"{\n  \"ticketId\": \"SH-12\",\n  \"timestamp\": \"2026-11-09T18:00:00Z\",\n  \"phase\": \"intake\",\n  \"version\": \"1.0\",\n  \"prdTitle\": \"PRD-12: Announcements & News\",\n  \"prdTicketRef\": \"SCH-012 (PRD header). The pipeline ticket is SH-12.\",\n  \"runMode\": \"--brownfield --tech-stack react\",\n  \"brownfieldFindings\": [\n    \"prisma/schema.prisma has no Announcement, AnnouncementAudience, AnnouncementAttachment or AnnouncementRead models and no AnnouncementStatus or AudienceType enums. They need a new migration, plus back-relations on User (authored announcements, reads) and FileObject (announcement attachments).\",\n    \"The audience-resolution data already exists: User.status/archivedAt (ACTIVE, non-archived filter), StudentProfile.gradeLevelId, ParentStudentLink(parentId, studentId), Section.homeroomTeacherId and gradeLevelId, SectionMember(studentId, academicYearId), Course.teacherId + coTeacherIds String[] + sectionId + academicYearId, and Enrollment.status (ACTIVE).\",\n    \"File access registry: src/server/files/access.ts exports registerFileAccess(context, resolver). Built-in contexts are registered in src/server/files/contexts.ts. Resolvers receive null for anonymous callers, which is what the public-announcement case needs.\",\n    \"Notification types live in src/server/notifications/types.ts with {category, mandatoryInApp, ...}. COMMUNICATION is already a category. notify() is in src/server/notifications/notify.ts.\",\n    \"The 'generic-notification' email template is already registered in src/server/email/render.ts.\",\n    \"The maintenance run is POST /api/internal/email/dispatch (CRON_SECRET-gated). It calls dispatchEmails, sendDueReminders and the quiz maintenance passes. publishDueAnnouncements() should be added there, following src/server/quiz/maintenance.ts (batched and idempotent).\",\n    \"src/config/public-routes.ts has PUBLIC_API_PATHS. '/api/public/news' must be added (FR-8 / API table).\",\n    \"src/config/course-tabs.ts is where the course 'Announcements' tab goes (FR-5.4). src/config/navigation.ts NavItem has no badge field, so the unread-count badge needs a small extension. src/components/NotificationBell/NotificationBell.tsx already shows a Badge-and-poll pattern to reuse.\",\n    \"Shared components are in src/components/<Name>/ (MarkdownEditor, MarkdownView, FileUpload, FileList, DataTable, ConfirmDialog, UserPicker, EmptyState, PageHeader, StatCard, Toast/useToast), not in src/components/shared/ as the platform context says. Reuse them where they are.\",\n    \"src/server/csv.ts already handles CSV export (FR-6.2). src/server/rate-limit.ts exists, but the 24h reminder throttle is a per-announcement business rule, not a rate limit.\",\n    \"Seed personas: Tom (teacher@), Sam (student@), Pat (parent@). Course lookups by code (MATH-7A) go through findCourse and skip when the course is missing. Neither prisma/seed.ts nor the scripts create 7A/7B/6A sections or ParentStudentLink rows. Seed announcements that target Grade 7, MATH-7A or 6A must follow the same skip-if-missing pattern.\"\n  ],\n  \"functionalRequirements\": [\n    {\"id\": \"FR-1\", \"description\": \"Add enums AnnouncementStatus (DRAFT, SCHEDULED, PUBLISHED, ARCHIVED) and AudienceType (SCHOOL, STAFF, ROLE, GRADE_LEVEL, SECTION, COURSE), plus the models Announcement, AnnouncementAudience, AnnouncementAttachment and AnnouncementRead (composite PK announcementId+userId), exactly as specified, in a new prisma migration.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 Data model\"},\n    {\"id\": \"FR-2\", \"description\": \"Validate title ≤ 150 chars and body (Markdown) ≤ 20,000 chars in a shared Zod schema at src/lib/validators/announcements.ts.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 Data model (field comments); Platform Context › Validation\"},\n    {\"id\": \"FR-3\", \"description\": \"resolveAudienceUserIds(audiences) in src/server/announcements/audience.ts returns the deduplicated ids of ACTIVE, non-archived users. SCHOOL = everyone, STAFF = ADMIN + TEACHER, ROLE = users whose role is refId.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1\"},\n    {\"id\": \"FR-4\", \"description\": \"GRADE_LEVEL audience: students whose profile grade level is refId (includeStudents), their linked parents (includeParents), and teachers of current-year courses in sections of that grade level (includeTeachers).\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1\"},\n    {\"id\": \"FR-5\", \"description\": \"SECTION audience: section members, their parents, the homeroom teacher and the teachers of the section's courses, each gated by the same include flags. 'Section members' is taken to mean current academic-year SectionMember rows.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-2.1\"},\n    {\"id\": \"FR-6\", \"description\": \"COURSE audience: students with ACTIVE enrollment, their parents, and the course teacher plus co-teachers (Course.coTeacherIds), each gated by the include flags.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1\"},\n    {\"id\": \"FR-7\", \"description\": \"isUserInAudience(user, audiences) answers membership for one user through targeted SQL/Prisma joins, without loading every recipient. It must agree with resolveAudienceUserIds.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.2; NFR Performance; Test Requirements › Integration\"},\n    {\"id\": \"FR-8\", \"description\": \"The audience service is generic (no announcement-specific coupling) so PRD-14 calendar events can reuse it.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.3\"},\n    {\"id\": \"FR-9\", \"description\": \"ADMIN may target any audience type and set isPublic.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1\"},\n    {\"id\": \"FR-10\", \"description\": \"TEACHER may target only COURSE audiences for courses they manage (teacher or co-teacher) and SECTION audiences for the section they homeroom. Any other audience, or isPublic=true, is rejected server-side with 403 FORBIDDEN.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.2; NFR Security; AC-3\"},\n    {\"id\": \"FR-11\", \"description\": \"STUDENT and PARENT cannot create announcements (403).\", \"confidence\": \"HIGH\", \"source\": \"FR-3.3\"},\n    {\"id\": \"FR-12\", \"description\": \"Authors may edit their own announcements, and admins may edit or archive any. Archiving sets status ARCHIVED. When an admin changes someone else's announcement, write an AuditLog row through audit().\", \"confidence\": \"HIGH\", \"source\": \"FR-3.4; API table (archive); Platform Context › audit()\"},\n    {\"id\": \"FR-13\", \"description\": \"The composer pages /announcements/new and /announcements/[id]/edit have: title, body (the PRD-08 MarkdownEditor), optional cover image, attachments, an audience builder (rows of type → entity picker → include students/parents/teachers checkboxes), pinned, requires acknowledgement, public (admins only), publish now / schedule (publishAt) / save draft, and an expiry date.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.1\"},\n    {\"id\": \"FR-14\", \"description\": \"A live recipient count next to the audience builder ('Will reach 412 people: 180 students, 214 parents, 18 teachers'), computed by POST /api/announcements/preview-audience, which returns counts by role.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.2; API table\"},\n    {\"id\": \"FR-15\", \"description\": \"Publishing (now or scheduled) with zero resolved recipients is refused with a VALIDATION_ERROR. Drafts may have zero recipients.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-4.3\"},\n    {\"id\": \"FR-16\", \"description\": \"Scheduling sets status SCHEDULED with publishAt. An announcement becomes visible once publishAt <= now, evaluated at read time, so a cron is not needed for visibility.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.1; AC-4\"},\n    {\"id\": \"FR-17\", \"description\": \"Feed /announcements (GET /api/announcements) for all roles: published, non-expired announcements whose audience includes the user. Up to 3 pinned show first, then newest. Unread items show a dot. Filter tabs: All / Unread / Requires acknowledgement. Paginated per platform conventions.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.1; API table\"},\n    {\"id\": \"FR-18\", \"description\": \"A feed card shows the cover thumbnail, title, author and role, date, audience chips (e.g. 'Grade 7 · Parents'), a 200-character plain-text excerpt and the attachment count.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.2\"},\n    {\"id\": \"FR-19\", \"description\": \"Detail /announcements/[id] (GET /api/announcements/:id; allowed for audience members, the author and ADMIN) shows the full sanitised body and attachments, and upserts AnnouncementRead.readAt on open.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.3; API table\"},\n    {\"id\": \"FR-20\", \"description\": \"When requiresAck is set, an 'I acknowledge' button calls POST /api/announcements/:id/ack (audience members only) and stores acknowledgedAt. The button then reads 'Acknowledged on 14 Sep', shown in the school timezone.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.3; API table\"},\n    {\"id\": \"FR-21\", \"description\": \"A course 'Announcements' tab (registered in src/config/course-tabs.ts) lists announcements whose audience includes that course (GET /api/announcements?courseId=).\", \"confidence\": \"HIGH\", \"source\": \"FR-5.4; API table\"},\n    {\"id\": \"FR-22\", \"description\": \"In the parent feed, an item with a grade, section or course audience is labelled with the linked child it relates to ('For Sam').\", \"confidence\": \"HIGH\", \"source\": \"FR-5.5; AC-8\"},\n    {\"id\": \"FR-23\", \"description\": \"Manage view /announcements/manage (GET /api/announcements/manage): teachers see the announcements they authored, admins see all, including expired and archived ones. Columns: status, audience summary, reach, read %, and acknowledged % when required.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1; AC-6; API table\"},\n    {\"id\": \"FR-24\", \"description\": \"A per-announcement stats page (GET /api/announcements/:id/stats; author or ADMIN) shows counts and a recipient table (name, role, read at, acknowledged at) with Unread / Not acknowledged filters and CSV export via ?format=csv.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.2; API table; AC-5\"},\n    {\"id\": \"FR-25\", \"description\": \"'Send reminder' (POST /api/announcements/:id/remind; author or ADMIN) notifies only recipients who have not acknowledged (type announcement.reminder). A second reminder within 24 hours is refused. A refused reminder returns 429 RATE_LIMITED or 409 CONFLICT; the architect picks one.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-6.2; AC-5\"},\n    {\"id\": \"FR-26\", \"description\": \"Register the notification type announcement.published (category COMMUNICATION, default email true, mandatoryInApp true when requiresAck) and the type announcement.reminder in src/server/notifications/types.ts.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.1; FR-6.2\"},\n    {\"id\": \"FR-27\", \"description\": \"Send announcement.published exactly once, when the announcement first becomes visible: immediately on publish-now, or by publishDueAnnouncements() in the maintenance run for scheduled ones. notifiedAt is set atomically to keep this idempotent.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.1; AC-4; Test Requirements › Integration\"},\n    {\"id\": \"FR-28\", \"description\": \"The email uses the generic-notification template with the title, the first 300 characters of the body as plain text, and a 'Read announcement' button linking to /announcements/[id].\", \"confidence\": \"HIGH\", \"source\": \"FR-7.2\"},\n    {\"id\": \"FR-29\", \"description\": \"Editing the audience after publish does not re-notify.\", \"confidence\": \"HIGH\", \"source\": \"API table (PATCH notes)\"},\n    {\"id\": \"FR-30\", \"description\": \"Register file access context 'announcement'. Access is allowed for audience members, the author and admins, and for everyone, including anonymous users, when the announcement is isPublic and published. This covers the cover image and attachments.\", \"confidence\": \"HIGH\", \"source\": \"FR-8.1\"},\n    {\"id\": \"FR-31\", \"description\": \"getPublicNews({ page }) returns public, published, non-expired announcements. GET /api/public/news exposes it without authentication and is added to public-routes.ts.\", \"confidence\": \"HIGH\", \"source\": \"FR-8.2; API table; AC-7\"},\n    {\"id\": \"FR-32\", \"description\": \"Add an 'Announcements' sidebar entry for all roles, with an unread count badge from GET /api/announcements/unread-count.\", \"confidence\": \"HIGH\", \"source\": \"FR-9.1; API table\"},\n    {\"id\": \"FR-33\", \"description\": \"TEACHER and ADMIN see a 'New announcement' button on the feed.\", \"confidence\": \"HIGH\", \"source\": \"FR-9.1\"},\n    {\"id\": \"FR-34\", \"description\": \"REST endpoints exactly as listed in the PRD API table: GET/POST /api/announcements, GET unread-count, GET/PATCH /:id, POST /:id/archive, POST /:id/ack, POST preview-audience, GET manage, GET /:id/stats, POST /:id/remind, GET /api/public/news. Each uses thin Zod handlers and the platform response/error shapes.\", \"confidence\": \"HIGH\", \"source\": \"API table; Platform Context › Code layout\"},\n    {\"id\": \"FR-35\", \"description\": \"Seed 6 announcements: school-wide welcome (pinned, public), Grade 7 parents field-trip consent (requires ack), MATH-7A homework club (by Tom), staff meeting (STAFF), sports day notice scheduled 2 days ahead (public), and an expired exam timetable notice.\", \"confidence\": \"HIGH\", \"source\": \"Seed Data\"},\n    {\"id\": \"FR-36\", \"description\": \"Services go in src/server/announcements/ (announcements-service.ts and audience.ts), following the PRD-05 feature-subdirectory precedent.\", \"confidence\": \"HIGH\", \"source\": \"FR-2 heading; Platform Context › Code layout\"}\n  ],\n  \"nonFunctionalRequirements\": [\n    {\"id\": \"NFR-1\", \"description\": \"UI component rule: use only Material UI (@mui/material 9.5.0, icons, MUI X). Look up every component through the mui-mcp server (useMuiDocs → fetchDocs) before use. No banned libraries (Tailwind, shadcn, Radix, notistack, etc.). Toasts go through useToast(), confirmations use Dialog, pickers use Autocomplete, and Markdown renders to MUI components. If mui-mcp is unreachable, report a blocker. QA must verify there are no banned imports.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › UI component rule (item 6)\"},\n    {\"id\": \"NFR-2\", \"description\": \"Performance: the feed query for a parent with 3 children returns in under 200 ms with 2,000 announcements. Membership is resolved through SQL joins on audience rows, never by loading all recipients.\", \"confidence\": \"HIGH\", \"source\": \"NFR 1 Performance\"},\n    {\"id\": \"NFR-3\", \"description\": \"Security: every handler and server page enforces access server-side. A teacher who submits a SCHOOL audience gets 403.\", \"confidence\": \"HIGH\", \"source\": \"NFR 2 Security; AC-3; Platform Context › requireRole\"},\n    {\"id\": \"NFR-4\", \"description\": \"Security: sanitise Markdown bodies as in PRD-08 (react-markdown + rehype-sanitize through the existing MarkdownView), including excerpts and the plain-text email body.\", \"confidence\": \"HIGH\", \"source\": \"NFR 2 Security\"},\n    {\"id\": \"NFR-5\", \"description\": \"Accessibility: unread dots carry screen-reader text 'Unread'.\", \"confidence\": \"HIGH\", \"source\": \"NFR 3 Accessibility\"},\n    {\"id\": \"NFR-6\", \"description\": \"Privacy: users only see announcements whose audience includes them. Detail, ack, file and stats endpoints return 403/404 to non-members. Scheduled and expired items are hidden from feeds and from non-author detail.\", \"confidence\": \"HIGH\", \"source\": \"Goal 2; FR-5.1; API table roles\"},\n    {\"id\": \"NFR-7\", \"description\": \"Store timestamps in UTC. publishAt, expiresAt and the 'Acknowledged on' date are interpreted and displayed in SchoolSettings.timezone.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › conventions; Assumptions\"},\n    {\"id\": \"NFR-8\", \"description\": \"Brownfield: reuse the existing services and components (notify, audit, registerFileAccess, csv, MarkdownEditor/View, FileUpload, DataTable, UserPicker, useToast). Don't re-scaffold or rename existing routes or models. Keep lint, typecheck and existing tests passing.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context; Constraints\"},\n    {\"id\": \"NFR-9\", \"description\": \"Scope: no comments or reactions, no translation, no SMS. Don't implement the PRD-18 public website pages; only expose getPublicNews and /api/public/news.\", \"confidence\": \"HIGH\", \"source\": \"Out of Scope; Constraints\"},\n    {\"id\": \"NFR-10\", \"description\": \"Tests: unit tests for audience resolution per type and flag combination and for teacher permission rules. Integration tests that isUserInAudience matches resolveAudienceUserIds for every seed user (property-style) and that scheduled publish notification is idempotent. A Playwright e2e test: admin composes a targeted announcement with ack, parent reads and acknowledges, admin sees stats.\", \"confidence\": \"HIGH\", \"source\": \"Test Requirements\"},\n    {\"id\": \"NFR-11\", \"description\": \"Use logger from src/lib/logger.ts, never console.log, in new code. The existing seed file's console.log convention may stay as it is.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › conventions\"}\n  ],\n  \"acceptanceCriteria\": [\n    {\"id\": \"AC-1\", \"text\": \"Admin targets GRADE_LEVEL Grade 7 with parents only. The preview shows only Grade 7 parents, and after publishing only they see it.\", \"traces\": [\"FR-4\", \"FR-14\", \"FR-17\"]},\n    {\"id\": \"AC-2\", \"text\": \"Tom targets COURSE MATH-7A. MATH-7A students, their parents and Tom see it. A 7B student does not.\", \"traces\": [\"FR-6\", \"FR-10\", \"FR-17\"]},\n    {\"id\": \"AC-3\", \"text\": \"Tom targets SCHOOL via the API and gets 403.\", \"traces\": [\"FR-10\", \"NFR-3\"]},\n    {\"id\": \"AC-4\", \"text\": \"An announcement scheduled for 07:00 tomorrow is invisible until 07:00. Its notification is sent once, by the first maintenance run after 07:00.\", \"traces\": [\"FR-16\", \"FR-27\"]},\n    {\"id\": \"AC-5\", \"text\": \"With requiresAck, 50 recipients and 30 acknowledged: stats show 60% acknowledged, the reminder notifies exactly 20 users, and a second reminder within 24h is refused.\", \"traces\": [\"FR-24\", \"FR-25\"]},\n    {\"id\": \"AC-6\", \"text\": \"An expired announcement is absent from feeds but present in the author's manage view.\", \"traces\": [\"FR-17\", \"FR-23\"]},\n    {\"id\": \"AC-7\", \"text\": \"GET /api/public/news returns public announcements without auth and omits non-public ones.\", \"traces\": [\"FR-31\"]},\n    {\"id\": \"AC-8\", \"text\": \"Pat has Sam (7A) and a child in 6A. A 6A section announcement is labelled 'For <6A child's name>' in Pat's feed.\", \"traces\": [\"FR-22\", \"FR-5\"]}\n  ],\n  \"overallConfidencePct\": 94,\n  \"clarificationLog\": [\n    {\n      \"round\": 1,\n      \"questions\": [\n        \"FR-5: Do 'section members' mean only current academic-year SectionMember rows?\",\n        \"FR-15: Can a draft be saved with zero recipients, with the zero-recipient refusal applied only at publish/schedule time?\",\n        \"FR-25: Should a refused second reminder within 24h return 429 RATE_LIMITED or 409 CONFLICT? And how is the last reminder time stored (a new column such as Announcement.lastRemindedAt, or derived from Notification rows)?\",\n        \"FR-1 vs FR-25: The FR-1 schema has no field for the reminder throttle. Is adding a nullable column acceptable?\",\n        \"FR-17: If more than 3 announcements are pinned, do the extra ones fall back into the newest-first list?\",\n        \"AC-8 / seed: The seed creates no 6A section and no ParentStudentLink rows. Should the seed (or the e2e/integration fixture) create the 6A child linked to Pat?\",\n        \"FR-12: Can an author edit an announcement after it is archived, or is archive terminal?\"\n      ],\n      \"unresolved\": [\n        \"FR-5 section membership scope: defaulting to current academic year.\",\n        \"FR-15 draft with zero recipients: defaulting to allowed; refusal only on publish/schedule.\",\n        \"FR-25 reminder throttle status code and storage: architect decides. Suggested: a nullable lastRemindedAt column and 429 RATE_LIMITED.\",\n        \"FR-17 overflow pins: defaulting to the extra pinned items flowing into newest-first order.\",\n        \"AC-8 fixture: the test fixture creates the 6A child and the Pat link if the seed lacks them.\",\n        \"FR-12 archived edits: defaulting to archive being terminal for authors, with admins still able to edit.\"\n      ]\n    }\n  ],\n  \"status\": \"complete\"\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"98a511c8-0f94-422f-bce3-9c853eb574ca","uuid":"52cf98c4-bfe5-44cd-89bb-d020d688b461","timestamp":"2026-11-09T16:39:07.272Z","tool_use_result":{"stdout":"{\n  \"ticketId\": \"SH-12\",\n  \"timestamp\": \"2026-11-09T18:00:00Z\",\n  \"phase\": \"intake\",\n  \"version\": \"1.0\",\n  \"prdTitle\": \"PRD-12: Announcements & News\",\n  \"prdTicketRef\": \"SCH-012 (PRD header). The pipeline ticket is SH-12.\",\n  \"runMode\": \"--brownfield --tech-stack react\",\n  \"brownfieldFindings\": [\n    \"prisma/schema.prisma has no Announcement, AnnouncementAudience, AnnouncementAttachment or AnnouncementRead models and no AnnouncementStatus or AudienceType enums. They need a new migration, plus back-relations on User (authored announcements, reads) and FileObject (announcement attachments).\",\n    \"The audience-resolution data already exists: User.status/archivedAt (ACTIVE, non-archived filter), StudentProfile.gradeLevelId, ParentStudentLink(parentId, studentId), Section.homeroomTeacherId and gradeLevelId, SectionMember(studentId, academicYearId), Course.teacherId + coTeacherIds String[] + sectionId + academicYearId, and Enrollment.status (ACTIVE).\",\n    \"File access registry: src/server/files/access.ts exports registerFileAccess(context, resolver). Built-in contexts are registered in src/server/files/contexts.ts. Resolvers receive null for anonymous callers, which is what the public-announcement case needs.\",\n    \"Notification types live in src/server/notifications/types.ts with {category, mandatoryInApp, ...}. COMMUNICATION is already a category. notify() is in src/server/notifications/notify.ts.\",\n    \"The 'generic-notification' email template is already registered in src/server/email/render.ts.\",\n    \"The maintenance run is POST /api/internal/email/dispatch (CRON_SECRET-gated). It calls dispatchEmails, sendDueReminders and the quiz maintenance passes. publishDueAnnouncements() should be added there, following src/server/quiz/maintenance.ts (batched and idempotent).\",\n    \"src/config/public-routes.ts has PUBLIC_API_PATHS. '/api/public/news' must be added (FR-8 / API table).\",\n    \"src/config/course-tabs.ts is where the course 'Announcements' tab goes (FR-5.4). src/config/navigation.ts NavItem has no badge field, so the unread-count badge needs a small extension. src/components/NotificationBell/NotificationBell.tsx already shows a Badge-and-poll pattern to reuse.\",\n    \"Shared components are in src/components/<Name>/ (MarkdownEditor, MarkdownView, FileUpload, FileList, DataTable, ConfirmDialog, UserPicker, EmptyState, PageHeader, StatCard, Toast/useToast), not in src/components/shared/ as the platform context says. Reuse them where they are.\",\n    \"src/server/csv.ts already handles CSV export (FR-6.2). src/server/rate-limit.ts exists, but the 24h reminder throttle is a per-announcement business rule, not a rate limit.\",\n    \"Seed personas: Tom (teacher@), Sam (student@), Pat (parent@). Course lookups by code (MATH-7A) go through findCourse and skip when the course is missing. Neither prisma/seed.ts nor the scripts create 7A/7B/6A sections or ParentStudentLink rows. Seed announcements that target Grade 7, MATH-7A or 6A must follow the same skip-if-missing pattern.\"\n  ],\n  \"functionalRequirements\": [\n    {\"id\": \"FR-1\", \"description\": \"Add enums AnnouncementStatus (DRAFT, SCHEDULED, PUBLISHED, ARCHIVED) and AudienceType (SCHOOL, STAFF, ROLE, GRADE_LEVEL, SECTION, COURSE), plus the models Announcement, AnnouncementAudience, AnnouncementAttachment and AnnouncementRead (composite PK announcementId+userId), exactly as specified, in a new prisma migration.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 Data model\"},\n    {\"id\": \"FR-2\", \"description\": \"Validate title ≤ 150 chars and body (Markdown) ≤ 20,000 chars in a shared Zod schema at src/lib/validators/announcements.ts.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 Data model (field comments); Platform Context › Validation\"},\n    {\"id\": \"FR-3\", \"description\": \"resolveAudienceUserIds(audiences) in src/server/announcements/audience.ts returns the deduplicated ids of ACTIVE, non-archived users. SCHOOL = everyone, STAFF = ADMIN + TEACHER, ROLE = users whose role is refId.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1\"},\n    {\"id\": \"FR-4\", \"description\": \"GRADE_LEVEL audience: students whose profile grade level is refId (includeStudents), their linked parents (includeParents), and teachers of current-year courses in sections of that grade level (includeTeachers).\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1\"},\n    {\"id\": \"FR-5\", \"description\": \"SECTION audience: section members, their parents, the homeroom teacher and the teachers of the section's courses, each gated by the same include flags. 'Section members' is taken to mean current academic-year SectionMember rows.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-2.1\"},\n    {\"id\": \"FR-6\", \"description\": \"COURSE audience: students with ACTIVE enrollment, their parents, and the course teacher plus co-teachers (Course.coTeacherIds), each gated by the include flags.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1\"},\n    {\"id\": \"FR-7\", \"description\": \"isUserInAudience(user, audiences) answers membership for one user through targeted SQL/Prisma joins, without loading every recipient. It must agree with resolveAudienceUserIds.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.2; NFR Performance; Test Requirements › Integration\"},\n    {\"id\": \"FR-8\", \"description\": \"The audience service is generic (no announcement-specific coupling) so PRD-14 calendar events can reuse it.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.3\"},\n    {\"id\": \"FR-9\", \"description\": \"ADMIN may target any audience type and set isPublic.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1\"},\n    {\"id\": \"FR-10\", \"description\": \"TEACHER may target only COURSE audiences for courses they manage (teacher or co-teacher) and SECTION audiences for the section they homeroom. Any other audience, or isPublic=true, is rejected server-side with 403 FORBIDDEN.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.2; NFR Security; AC-3\"},\n    {\"id\": \"FR-11\", \"description\": \"STUDENT and PARENT cannot create announcements (403).\", \"confidence\": \"HIGH\", \"source\": \"FR-3.3\"},\n    {\"id\": \"FR-12\", \"description\": \"Authors may edit their own announcements, and admins may edit or archive any. Archiving sets status ARCHIVED. When an admin changes someone else's announcement, write an AuditLog row through audit().\", \"confidence\": \"HIGH\", \"source\": \"FR-3.4; API table (archive); Platform Context › audit()\"},\n    {\"id\": \"FR-13\", \"description\": \"The composer pages /announcements/new and /announcements/[id]/edit have: title, body (the PRD-08 MarkdownEditor), optional cover image, attachments, an audience builder (rows of type → entity picker → include students/parents/teachers checkboxes), pinned, requires acknowledgement, public (admins only), publish now / schedule (publishAt) / save draft, and an expiry date.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.1\"},\n    {\"id\": \"FR-14\", \"description\": \"A live recipient count next to the audience builder ('Will reach 412 people: 180 students, 214 parents, 18 teachers'), computed by POST /api/announcements/preview-audience, which returns counts by role.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.2; API table\"},\n    {\"id\": \"FR-15\", \"description\": \"Publishing (now or scheduled) with zero resolved recipients is refused with a VALIDATION_ERROR. Drafts may have zero recipients.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-4.3\"},\n    {\"id\": \"FR-16\", \"description\": \"Scheduling sets status SCHEDULED with publishAt. An announcement becomes visible once publishAt <= now, evaluated at read time, so a cron is not needed for visibility.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.1; AC-4\"},\n    {\"id\": \"FR-17\", \"description\": \"Feed /announcements (GET /api/announcements) for all roles: published, non-expired announcements whose audience includes the user. Up to 3 pinned show first, then newest. Unread items show a dot. Filter tabs: All / Unread / Requires acknowledgement. Paginated per platform conventions.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.1; API table\"},\n    {\"id\": \"FR-18\", \"description\": \"A feed card shows the cover thumbnail, title, author and role, date, audience chips (e.g. 'Grade 7 · Parents'), a 200-character plain-text excerpt and the attachment count.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.2\"},\n    {\"id\": \"FR-19\", \"description\": \"Detail /announcements/[id] (GET /api/announcements/:id; allowed for audience members, the author and ADMIN) shows the full sanitised body and attachments, and upserts AnnouncementRead.readAt on open.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.3; API table\"},\n    {\"id\": \"FR-20\", \"description\": \"When requiresAck is set, an 'I acknowledge' button calls POST /api/announcements/:id/ack (audience members only) and stores acknowledgedAt. The button then reads 'Acknowledged on 14 Sep', shown in the school timezone.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.3; API table\"},\n    {\"id\": \"FR-21\", \"description\": \"A course 'Announcements' tab (registered in src/config/course-tabs.ts) lists announcements whose audience includes that course (GET /api/announcements?courseId=).\", \"confidence\": \"HIGH\", \"source\": \"FR-5.4; API table\"},\n    {\"id\": \"FR-22\", \"description\": \"In the parent feed, an item with a grade, section or course audience is labelled with the linked child it relates to ('For Sam').\", \"confidence\": \"HIGH\", \"source\": \"FR-5.5; AC-8\"},\n    {\"id\": \"FR-23\", \"description\": \"Manage view /announcements/manage (GET /api/announcements/manage): teachers see the announcements they authored, admins see all, including expired and archived ones. Columns: status, audience summary, reach, read %, and acknowledged % when required.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1; AC-6; API table\"},\n    {\"id\": \"FR-24\", \"description\": \"A per-announcement stats page (GET /api/announcements/:id/stats; author or ADMIN) shows counts and a recipient table (name, role, read at, acknowledged at) with Unread / Not acknowledged filters and CSV export via ?format=csv.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.2; API table; AC-5\"},\n    {\"id\": \"FR-25\", \"description\": \"'Send reminder' (POST /api/announcements/:id/remind; author or ADMIN) notifies only recipients who have not acknowledged (type announcement.reminder). A second reminder within 24 hours is refused. A refused reminder returns 429 RATE_LIMITED or 409 CONFLICT; the architect picks one.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-6.2; AC-5\"},\n    {\"id\": \"FR-26\", \"description\": \"Register the notification type announcement.published (category COMMUNICATION, default email true, mandatoryInApp true when requiresAck) and the type announcement.reminder in src/server/notifications/types.ts.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.1; FR-6.2\"},\n    {\"id\": \"FR-27\", \"description\": \"Send announcement.published exactly once, when the announcement first becomes visible: immediately on publish-now, or by publishDueAnnouncements() in the maintenance run for scheduled ones. notifiedAt is set atomically to keep this idempotent.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.1; AC-4; Test Requirements › Integration\"},\n    {\"id\": \"FR-28\", \"description\": \"The email uses the generic-notification template with the title, the first 300 characters of the body as plain text, and a 'Read announcement' button linking to /announcements/[id].\", \"confidence\": \"HIGH\", \"source\": \"FR-7.2\"},\n    {\"id\": \"FR-29\", \"description\": \"Editing the audience after publish does not re-notify.\", \"confidence\": \"HIGH\", \"source\": \"API table (PATCH notes)\"},\n    {\"id\": \"FR-30\", \"description\": \"Register file access context 'announcement'. Access is allowed for audience members, the author and admins, and for everyone, including anonymous users, when the announcement is isPublic and published. This covers the cover image and attachments.\", \"confidence\": \"HIGH\", \"source\": \"FR-8.1\"},\n    {\"id\": \"FR-31\", \"description\": \"getPublicNews({ page }) returns public, published, non-expired announcements. GET /api/public/news exposes it without authentication and is added to public-routes.ts.\", \"confidence\": \"HIGH\", \"source\": \"FR-8.2; API table; AC-7\"},\n    {\"id\": \"FR-32\", \"description\": \"Add an 'Announcements' sidebar entry for all roles, with an unread count badge from GET /api/announcements/unread-count.\", \"confidence\": \"HIGH\", \"source\": \"FR-9.1; API table\"},\n    {\"id\": \"FR-33\", \"description\": \"TEACHER and ADMIN see a 'New announcement' button on the feed.\", \"confidence\": \"HIGH\", \"source\": \"FR-9.1\"},\n    {\"id\": \"FR-34\", \"description\": \"REST endpoints exactly as listed in the PRD API table: GET/POST /api/announcements, GET unread-count, GET/PATCH /:id, POST /:id/archive, POST /:id/ack, POST preview-audience, GET manage, GET /:id/stats, POST /:id/remind, GET /api/public/news. Each uses thin Zod handlers and the platform response/error shapes.\", \"confidence\": \"HIGH\", \"source\": \"API table; Platform Context › Code layout\"},\n    {\"id\": \"FR-35\", \"description\": \"Seed 6 announcements: school-wide welcome (pinned, public), Grade 7 parents field-trip consent (requires ack), MATH-7A homework club (by Tom), staff meeting (STAFF), sports day notice scheduled 2 days ahead (public), and an expired exam timetable notice.\", \"confidence\": \"HIGH\", \"source\": \"Seed Data\"},\n    {\"id\": \"FR-36\", \"description\": \"Services go in src/server/announcements/ (announcements-service.ts and audience.ts), following the PRD-05 feature-subdirectory precedent.\", \"confidence\": \"HIGH\", \"source\": \"FR-2 heading; Platform Context › Code layout\"}\n  ],\n  \"nonFunctionalRequirements\": [\n    {\"id\": \"NFR-1\", \"description\": \"UI component rule: use only Material UI (@mui/material 9.5.0, icons, MUI X). Look up every component through the mui-mcp server (useMuiDocs → fetchDocs) before use. No banned libraries (Tailwind, shadcn, Radix, notistack, etc.). Toasts go through useToast(), confirmations use Dialog, pickers use Autocomplete, and Markdown renders to MUI components. If mui-mcp is unreachable, report a blocker. QA must verify there are no banned imports.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › UI component rule (item 6)\"},\n    {\"id\": \"NFR-2\", \"description\": \"Performance: the feed query for a parent with 3 children returns in under 200 ms with 2,000 announcements. Membership is resolved through SQL joins on audience rows, never by loading all recipients.\", \"confidence\": \"HIGH\", \"source\": \"NFR 1 Performance\"},\n    {\"id\": \"NFR-3\", \"description\": \"Security: every handler and server page enforces access server-side. A teacher who submits a SCHOOL audience gets 403.\", \"confidence\": \"HIGH\", \"source\": \"NFR 2 Security; AC-3; Platform Context › requireRole\"},\n    {\"id\": \"NFR-4\", \"description\": \"Security: sanitise Markdown bodies as in PRD-08 (react-markdown + rehype-sanitize through the existing MarkdownView), including excerpts and the plain-text email body.\", \"confidence\": \"HIGH\", \"source\": \"NFR 2 Security\"},\n    {\"id\": \"NFR-5\", \"description\": \"Accessibility: unread dots carry screen-reader text 'Unread'.\", \"confidence\": \"HIGH\", \"source\": \"NFR 3 Accessibility\"},\n    {\"id\": \"NFR-6\", \"description\": \"Privacy: users only see announcements whose audience includes them. Detail, ack, file and stats endpoints return 403/404 to non-members. Scheduled and expired items are hidden from feeds and from non-author detail.\", \"confidence\": \"HIGH\", \"source\": \"Goal 2; FR-5.1; API table roles\"},\n    {\"id\": \"NFR-7\", \"description\": \"Store timestamps in UTC. publishAt, expiresAt and the 'Acknowledged on' date are interpreted and displayed in SchoolSettings.timezone.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › conventions; Assumptions\"},\n    {\"id\": \"NFR-8\", \"description\": \"Brownfield: reuse the existing services and components (notify, audit, registerFileAccess, csv, MarkdownEditor/View, FileUpload, DataTable, UserPicker, useToast). Don't re-scaffold or rename existing routes or models. Keep lint, typecheck and existing tests passing.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context; Constraints\"},\n    {\"id\": \"NFR-9\", \"description\": \"Scope: no comments or reactions, no translation, no SMS. Don't implement the PRD-18 public website pages; only expose getPublicNews and /api/public/news.\", \"confidence\": \"HIGH\", \"source\": \"Out of Scope; Constraints\"},\n    {\"id\": \"NFR-10\", \"description\": \"Tests: unit tests for audience resolution per type and flag combination and for teacher permission rules. Integration tests that isUserInAudience matches resolveAudienceUserIds for every seed user (property-style) and that scheduled publish notification is idempotent. A Playwright e2e test: admin composes a targeted announcement with ack, parent reads and acknowledges, admin sees stats.\", \"confidence\": \"HIGH\", \"source\": \"Test Requirements\"},\n    {\"id\": \"NFR-11\", \"description\": \"Use logger from src/lib/logger.ts, never console.log, in new code. The existing seed file's console.log convention may stay as it is.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › conventions\"}\n  ],\n  \"acceptanceCriteria\": [\n    {\"id\": \"AC-1\", \"text\": \"Admin targets GRADE_LEVEL Grade 7 with parents only. The preview shows only Grade 7 parents, and after publishing only they see it.\", \"traces\": [\"FR-4\", \"FR-14\", \"FR-17\"]},\n    {\"id\": \"AC-2\", \"text\": \"Tom targets COURSE MATH-7A. MATH-7A students, their parents and Tom see it. A 7B student does not.\", \"traces\": [\"FR-6\", \"FR-10\", \"FR-17\"]},\n    {\"id\": \"AC-3\", \"text\": \"Tom targets SCHOOL via the API and gets 403.\", \"traces\": [\"FR-10\", \"NFR-3\"]},\n    {\"id\": \"AC-4\", \"text\": \"An announcement scheduled for 07:00 tomorrow is invisible until 07:00. Its notification is sent once, by the first maintenance run after 07:00.\", \"traces\": [\"FR-16\", \"FR-27\"]},\n    {\"id\": \"AC-5\", \"text\": \"With requiresAck, 50 recipients and 30 acknowledged: stats show 60% acknowledged, the reminder notifies exactly 20 users, and a second reminder within 24h is refused.\", \"traces\": [\"FR-24\", \"FR-25\"]},\n    {\"id\": \"AC-6\", \"text\": \"An expired announcement is absent from feeds but present in the author's manage view.\", \"traces\": [\"FR-17\", \"FR-23\"]},\n    {\"id\": \"AC-7\", \"text\": \"GET /api/public/news returns public announcements without auth and omits non-public ones.\", \"traces\": [\"FR-31\"]},\n    {\"id\": \"AC-8\", \"text\": \"Pat has Sam (7A) and a child in 6A. A 6A section announcement is labelled 'For <6A child's name>' in Pat's feed.\", \"traces\": [\"FR-22\", \"FR-5\"]}\n  ],\n  \"overallConfidencePct\": 94,\n  \"clarificationLog\": [\n    {\n      \"round\": 1,\n      \"questions\": [\n        \"FR-5: Do 'section members' mean only current academic-year SectionMember rows?\",\n        \"FR-15: Can a draft be saved with zero recipients, with the zero-recipient refusal applied only at publish/schedule time?\",\n        \"FR-25: Should a refused second reminder within 24h return 429 RATE_LIMITED or 409 CONFLICT? And how is the last reminder time stored (a new column such as Announcement.lastRemindedAt, or derived from Notification rows)?\",\n        \"FR-1 vs FR-25: The FR-1 schema has no field for the reminder throttle. Is adding a nullable column acceptable?\",\n        \"FR-17: If more than 3 announcements are pinned, do the extra ones fall back into the newest-first list?\",\n        \"AC-8 / seed: The seed creates no 6A section and no ParentStudentLink rows. Should the seed (or the e2e/integration fixture) create the 6A child linked to Pat?\",\n        \"FR-12: Can an author edit an announcement after it is archived, or is archive terminal?\"\n      ],\n      \"unresolved\": [\n        \"FR-5 section membership scope: defaulting to current academic year.\",\n        \"FR-15 draft with zero recipients: defaulting to allowed; refusal only on publish/schedule.\",\n        \"FR-25 reminder throttle status code and storage: architect decides. Suggested: a nullable lastRemindedAt column and 429 RATE_LIMITED.\",\n        \"FR-17 overflow pins: defaulting to the extra pinned items flowing into newest-first order.\",\n        \"AC-8 fixture: the test fixture creates the 6A child and the Pat link if the seed lacks them.\",\n        \"FR-12 archived edits: defaulting to archive being terminal for authors, with admins still able to edit.\"\n      ]\n    }\n  ],\n  \"status\": \"complete\"\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0141yeUWZpUqEwr8dwRZ214J","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
