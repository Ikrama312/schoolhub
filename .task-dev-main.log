Bell/': ['NotificationBell.tsx'], 'src/config/': ['public-routes.ts'], 'src/lib/validators/': ['notifications.ts'], 'src/server/auth/': ['email.ts', 'tokens.ts'], 'src/server/email/': ['admin.ts', 'backoff.ts', 'dispatch.ts', 'outbox.ts', 'render.ts', 'transport.ts'], 'src/server/email/templates/': ['BaseLayout.tsx', 'GenericNotification.tsx', 'Invite.tsx', 'PasswordReset.tsx'], 'src/server/notifications/': ['notify.ts', 'preferences.ts', 'purge.ts', 'service.ts', 'types.ts'], 'src/server/services/': ['users.ts'], 'tests/e2e/': ['notifications.spec.ts'], 'tests/integration/': ['email-dispatch.test.ts'], 'tests/unit/': ['notifications.test.ts']}, 'totalEstimateHours': 36.5, 'nxpPatterns': [], 'notes': ['Preconditions for dev: mui-mcp (useMuiDocs → fetchDocs) must be reachable before UI tasks TASK-14..17 (NFR-10 hard stop).', 'Migration directory name is fixed to 20261104120000_notifications_email so the ownership matrix path is exact.', 'No new dependencies; schema.prisma, env.ts, .env.example, navigation.ts and package.json stay untouched.', 'NFR-17 is a scope exclusion and intentionally has no task.', 'Replaces stale abcd-1 dev-planning artifacts.'], 'status': 'complete'}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QfHKwGBSDu9CcvJeCjHSp5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
