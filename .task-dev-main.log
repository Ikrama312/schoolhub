eration\": \"MODIFY\"\n    },\n    {\n      \"path\": \"src/config/navigation.ts\",\n      \"taskId\": \"TASK-17\",\n      \"operation\": \"MODIFY\"\n    },\n    {\n      \"path\": \"prisma/seed.ts\",\n      \"taskId\": \"TASK-18\",\n      \"operation\": \"MODIFY\"\n    },\n    {\n      \"path\": \"tests/e2e/attendance.spec.ts\",\n      \"taskId\": \"TASK-19\",\n      \"operation\": \"CREATE\"\n    }\n  ]\n}# File Structure: SH-7 · PRD-07 Attendance Tracking\n\nPhase: dev-planning · 2026-11-06 · `+` = CREATE, `~` = MODIFY (owning task in brackets)\n\n> This file replaces the stale SH-1 plan. Slug names follow the existing tree: the API uses `[id]`,\n> student pages use `[id]` and course pages use `[courseId]`.\n\n```\nprisma/\n├── ~ schema.prisma                                   [TASK-1]\n├── ~ seed.ts                                         [TASK-18]\n└── migrations/\n    └── 20261107000000_attendance/\n        └── + migration.sql                           [TASK-1]  (CHECK + 2 partial unique idx)\n\nsrc/\n├── lib/validators/\n│   └── + attendance.ts                               [TASK-2]\n├── server/\n│   ├── attendance/\n│   │   ├── + attendance-rules.ts                     [TASK-5]  (pure, no DB)\n│   │   └── + attendance-service.ts                   [TASK-7]\n│   ├── notifications/\n│   │   └── ~ types.ts                                [TASK-3]  (+4 type keys)\n│   ├── services/\n│   │   └── ~ settings.ts                             [TASK-4]  (+attendance fields)\n│   └── timetable/\n│       └── ~ timetable-service.ts                    [TASK-6]  (+getSchoolScheduleForDate)\n├── config/\n│   ├── ~ student-tabs.ts                             [TASK-17]\n│   ├── ~ course-tabs.ts                              [TASK-17]\n│   └── ~ navigation.ts                               [TASK-17]\n└── app/\n    ├── api/\n    │   ├── attendance/\n    │   │   ├── today/+ route.ts                      [TASK-9]\n    │   │   └── register/+ route.ts                   [TASK-9]  (GET + PUT)\n    │   ├── students/[id]/attendance/+ route.ts       [TASK-10]\n    │   ├── courses/[id]/attendance/+ route.ts        [TASK-10]\n    │   ├── admin/attendance/\n    │   │   ├── overview/+ route.ts                   [TASK-11]\n    │   │   ├── report/+ route.ts                     [TASK-11]\n    │   │   ├── below-threshold/+ route.ts            [TASK-11]\n    │   │   └── remind/+ route.ts                     [TASK-11]\n    │   └── settings/school/+ route.ts                [TASK-4]  (PATCH)\n    └── (app)/\n        ├── attendance/take/\n        │   ├── + page.tsx                            [TASK-13]\n        │   ├── + DateNav.tsx                         [TASK-13]  (client DatePicker)\n        │   ├── + RegisterForm.tsx                    [TASK-12]  (client, shared)\n        │   ├── [courseId]/+ page.tsx                 [TASK-13]\n        │   └── section/[sectionId]/+ page.tsx        [TASK-13]\n        ├── students/[id]/attendance/\n        │   ├── + page.tsx                            [TASK-14]\n        │   └── + StudentAttendanceClient.tsx         [TASK-14]\n        ├── courses/[courseId]/attendance/\n        │   ├── + page.tsx                            [TASK-15]\n        │   └── + CourseAttendanceMatrix.tsx          [TASK-15]\n        └── admin/attendance/\n            ├── + page.tsx                            [TASK-16]\n            ├── + AdminAttendanceClient.tsx           [TASK-16]  (Tabs: Today, Below threshold, Settings)\n            └── + ReportTab.tsx                       [TASK-16]\n\ntests/\n├── unit/+ attendance-rules.test.ts                   [TASK-5]\n├── integration/+ attendance-service.test.ts          [TASK-8]\n└── e2e/+ attendance.spec.ts                          [TASK-19]\n```\n\nReused and not modified: `src/server/{http,audit,csv}.ts`, `src/server/auth/*`, `src/server/notifications/notify.ts`,\n`src/lib/dates.ts` and `src/components/{DataTable,StatCard,UserAvatar,PageHeader,EmptyState,DateDisplay,LoadingSkeleton,Toast}`.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01L7s99LjnNWgNLE3FEDaXVE","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
