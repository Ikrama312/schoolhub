        sx={{ justifyContent: collapsed && isDesktop ? 'center' : 'flex-start' }}\n91\t          >\n92\t            <ListItemIcon sx={{ minWidth: collapsed && isDesktop ? 0 : 40, justifyContent: 'center' }}>\n93\t              <Icon />\n94\t            </ListItemIcon>\n95\t            {!(collapsed && isDesktop) && <ListItemText primary={item.label} />}\n96\t          </ListItemButton>\n97\t        );\n98\t        return collapsed && isDesktop ? (\n99\t          <Tooltip key={item.href} title={item.label} placement=\"right\">\n100\t            {button}\n101\t          </Tooltip>\n102\t        ) : (\n103\t          button\n104\t        );\n105\t      })}\n106\t    </List>\n107\t  );\n108\t\n109\t  return (\n110\t    <Box sx={{ display: 'flex', minHeight: '100vh' }}>\n111\t      <AppBar\n112\t        position=\"fixed\"\n113\t        sx={{\n114\t          zIndex: (t) => t.zIndex.drawer + 1,\n115\t          ...(isDesktop\n116\t            ? { width: `calc(100% - ${drawerWidth}px)`, ml: `${drawerWidth}px` }\n117\t            : {}),\n118\t        }}\n119\t      >\n120\t        <Toolbar sx={{ gap: 1 }}>\n121\t          {!isDesktop && (\n122\t            <IconButton\n123\t              color=\"inherit\"\n124\t              aria-label=\"Open navigation\"\n125\t              edge=\"start\"\n126\t              onClick={() => setMobileOpen(true)}\n127\t            >\n128\t              <MenuIcon />\n129\t            </IconButton>\n130\t          )}\n131\t          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n132\t            {schoolShortName}\n133\t          </Typography>\n134\t\n135\t          <Tooltip title=\"Notifications\">\n136\t            <IconButton color=\"inherit\" aria-label=\"Notifications\">\n137\t              <Badge badgeContent={0} color=\"error\">\n138\t                <NotificationsNoneIcon />\n139\t              </Badge>\n140\t            </IconButton>\n141\t          </Tooltip>\n142\t\n143\t          <Tooltip title={mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}>\n144\t            <IconButton\n145\t              color=\"inherit\"\n146\t              aria-label=\"Toggle color mode\"\n147\t              onClick={() => setMode(mode === 'dark' ? 'light' : 'dark')}\n148\t            >\n149\t              {mode === 'dark' ? <LightModeIcon /> : <DarkModeIcon />}\n150\t            </IconButton>\n151\t          </Tooltip>\n152\t\n153\t          <IconButton onClick={(event) => setMenuAnchor(event.currentTarget)} aria-label=\"User menu\">\n154\t            <UserAvatar userId={PLACEHOLDER_USER.id} name={PLACEHOLDER_USER.name} size={32} />\n155\t          </IconButton>\n156\t          <Menu anchorEl={menuAnchor} open={Boolean(menuAnchor)} onClose={() => setMenuAnchor(null)}>\n157\t            <Box sx={{ px: 2, py: 1 }}>\n158\t              <Typography variant=\"subtitle2\">{PLACEHOLDER_USER.name}</Typography>\n159\t              <Chip size=\"small\" label={PLACEHOLDER_USER.role} sx={{ mt: 0.5 }} />\n160\t            </Box>\n161\t            <Divider />\n162\t            <MenuItem onClick={() => setMenuAnchor(null)}>\n163\t              <PersonOutlineIcon fontSize=\"small\" sx={{ mr: 1 }} /> Profile\n164\t            </MenuItem>\n165\t            <MenuItem onClick={() => setMenuAnchor(null)}>\n166\t              <LogoutIcon fontSize=\"small\" sx={{ mr: 1 }} /> Sign out\n167\t            </MenuItem>\n168\t          </Menu>\n169\t        </Toolbar>\n170\t      </AppBar>\n171\t\n172\t      {isDesktop ? (\n173\t        <Drawer\n174\t          variant=\"permanent\"\n175\t          sx={{\n176\t            width: drawerWidth,\n177\t            flexShrink: 0,\n178\t            [`& .MuiDrawer-paper`]: { width: drawerWidth, boxSizing: 'border-box', overflowX: 'hidden' },\n179\t          }}\n180\t        >\n181\t          <Toolbar />\n182\t          {navList}\n183\t          <Box sx={{ mt: 'auto', display: 'flex', justifyContent: 'flex-end', p: 1 }}>\n184\t            <IconButton onClick={toggleCollapsed} aria-lab