{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013z2hcoZVgcU7MdVZSSB1tN","type":"tool_result","content":"1\timport { ok, withHandler, AppError } from '@/server/http';\n2\timport { requireRole } from '@/server/auth/requireRole';\n3\timport { audit } from '@/server/audit';\n4\timport { getUserDetail, updateUser } from '@/server/services/users';\n5\timport { updateUserSchema } from '@/lib/validators/users';\n6\t\n7\t/** GET/PATCH /api/users/:id — ADMIN only (FR-8, FR-9, FR-10, FR-11). */\n8\texport const GET = withHandler(async (_request: Request, { params }: { params: { id: string } }) => {\n9\t  requireRole('ADMIN');\n10\t  const detail = await getUserDetail(params.id);\n11\t  return ok(detail);\n12\t});\n13\t\n14\texport const PATCH = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n15\t  const actor = requireRole('ADMIN');\n16\t  const json = await request.json();\n17\t\n18\t  // FR-9: role is immutable — reject outright if the client sends a\n19\t  // different one rather than silently dropping it, so the form's \"role\n20\t  // is read-only on edit\" convention is also a real server-side guarantee.\n21\t  if ('role' in json) {\n22\t    const existing = await getUserDetail(params.id);\n23\t    if (json.role !== existing.role) {\n24\t      throw new AppError('VALIDATION_ERROR', 'Role cannot be changed after a user is created.');\n25\t    }\n26\t  }\n27\t\n28\t  const input = updateUserSchema.parse(json);\n29\t  const user = await updateUser(params.id, input);\n30\t  await audit({\n31\t    actorId: actor.id,\n32\t    action: 'user.updated',\n33\t    entityType: 'User',\n34\t    entityId: params.id,\n35\t    metadata: { fields: Object.keys(input) },\n36\t  });\n37\t\n38\t  return ok(user);\n39\t});\n40\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"a46f79ba-5203-4efe-acc5-0c10dfb256a6","timestamp":"2026-10-20T06:17:32.248Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/api/users/[id]/route.ts","content":"import { ok, withHandler, AppError } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { getUserDetail, updateUser } from '@/server/services/users';\nimport { updateUserSchema } from '@/lib/validators/users';\n\n/** GET/PATCH /api/users/:id — ADMIN only (FR-8, FR-9, FR-10, FR-11). */\nexport const GET = withHandler(async (_request: Request, { params }: { params: { id: string } }) => {\n  requireRole('ADMIN');\n  const detail = await getUserDetail(params.id);\n  return ok(detail);\n});\n\nexport const PATCH = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const actor = requireRole('ADMIN');\n  const json = await request.json();\n\n  // FR-9: role is immutable — reject outright if the client sends a\n  // different one rather than silently dropping it, so the form's \"role\n  // is read-only on edit\" convention is also a real server-side guarantee.\n  if ('role' in json) {\n    const existing = await getUserDetail(params.id);\n    if (json.role !== existing.role) {\n      throw new AppError('VALIDATION_ERROR', 'Role cannot be changed after a user is created.');\n    }\n  }\n\n  const input = updateUserSchema.parse(json);\n  const user = await updateUser(params.id, input);\n  await audit({\n    actorId: actor.id,\n    action: 'user.updated',\n    entityType: 'User',\n    entityId: params.id,\n    metadata: { fields: Object.keys(input) },\n  });\n\n  return ok(user);\n});\n","numLines":40,"startLine":1,"totalLines":40}}}
