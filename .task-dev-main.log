e: {}, create: room });\n  }\n\n  // PRD-04 FR-40: 3 system.test notifications (1 read, 2 unread) per demo user.\n  // Users are owned by another PRD's seed, so a missing one is skipped, never created.\n  for (const email of ['student@schoolhub.test', 'parent@schoolhub.test']) {\n    const user = await prisma.user.findUnique({ where: { email }, select: { id: true } });\n    if (!user) {\n      console.log(`Seed: ${email} not found, skipping demo notifications`);\n      continue;\n    }\n    const existing = await prisma.notification.count({ where: { userId: user.id, type: 'system.test' } });\n    if (existing > 0) continue;\n    await prisma.notification.createMany({\n      data: [\n        { title: 'Welcome to SchoolHub', body: 'Your notifications will appear here.', readAt: new Date() },\n        { title: 'Check your dashboard', body: 'See what is new this week.', readAt: null },\n        { title: 'Notification preferences', body: 'Choose how you hear about activity.', readAt: null },\n      ].map((n) => ({ ...n, userId: user.id, type: 'system.test', link: '/dashboard' })),\n    });\n  }\n}\n\nmain()\n  .then(async () => {\n    await prisma.$disconnect();\n  })\n  .catch(async (error) => {\n    console.error(error);\n    await prisma.$disconnect();\n    process.exit(1);\n  });\n59:model User {\n60-  id                      String                   @id @default(cuid())\n61-  email                   String                   @unique\n62-  passwordHash            String?\n63-  firstName               String\n64-  lastName                String\n65-  phone                   String?\n66-  role                    Role\n67-  status                  UserStatus               @default(INVITED)\n68-  failedLoginCount        Int                      @default(0)\n69-  lockedUntil             DateTime?\n70-  lastLoginAt             DateTime?\n71-  passwordChangedAt       DateTime?\n72-  archivedAt              DateTime?\n73-  createdAt               DateTime                 @default(now())\n74-  updatedAt               DateTime                 @updatedAt\n75-  authTokens              AuthToken[]\n76-  auditLogs               AuditLog[]\n77-  studentProfile          StudentProfile?\n78-  teacherProfile          TeacherProfile?\n79-  parentProfile           ParentProfile?\n80-  parentLinks             ParentStudentLink[]      @relation(\"ParentLinks\")\n81-  studentLinks            ParentStudentLink[]      @relation(\"StudentLinks\")\n82-  notifications           Notification[]\n83-  notificationPreferences NotificationPreference[]\n84-  homeroomSections        Section[]                @relation(\"HomeroomTeacher\")\n85-  sectionMemberships      SectionMember[]\n86-  taughtCourses           Course[]                 @relation(\"CourseTeacher\")\n87-  enrollments             Enrollment[]\n88-\n89-  @@index([lastName, firstName, email])\n90-}\n91-\n92-/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n93-/// only -- enforced in the service layer (src/server/services/users.ts,\n94-/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\n95-model StudentProfile {\n96-  userId           String     @id\n97-  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n98-  admissionNumber  String     @unique\n99-  dateOfBirth      DateTime   @db.Date\n100-  gender           Gender     @default(UNDISCLOSED)\n101-  gradeLevelId     String\n102-  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n103-  enrollmentDate   DateTime   @db.Date\n104-  addressLine1     String?\n20261019000000_init\n20261019151500_user_management_profiles\n20261027000000_classes_enrollment\n20261104000000_auth_reconcile\n20261104120000_notifications_email\n20261105000000_timetable\nmigration_lock.toml","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0116sKwVmHJeSuANtGxhuSuV","permission_decision":{"decision":"acc