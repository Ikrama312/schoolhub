es\": [\n        \"TASK-2\"\n      ],\n      \"estimateHours\": 1,\n      \"requirementIds\": [\n        \"FR-41\",\n        \"NFR-6\",\n        \"NFR-18\"\n      ]\n    },\n    {\n      \"id\": \"TASK-4\",\n      \"description\": \"Email templates with @react-email/components (BaseLayout header/footer with manage-preferences link and fixed sentence; Invite; PasswordReset; GenericNotification) and render.ts TEMPLATES + async renderEmail(template, data, school) \\u2192 {html,text}. No dangerouslySetInnerHTML.\",\n      \"files\": [\n        \"src/server/email/templates/BaseLayout.tsx\",\n        \"src/server/email/templates/Invite.tsx\",\n        \"src/server/email/templates/PasswordReset.tsx\",\n        \"src/server/email/templates/GenericNotification.tsx\",\n        \"src/server/email/render.ts\"\n      ],\n      \"dependencies\": [],\n      \"estimateHours\": 3,\n      \"requirementIds\": [\n        \"FR-13\",\n        \"FR-14\",\n        \"FR-15\",\n        \"NFR-7\"\n      ]\n    },\n    {\n      \"id\": \"TASK-5\",\n      \"description\": \"Pure backoff table (BACKOFF_MIN=[1,5,15,60,240], nextRetry) and transport sendMail: lazy Nodemailer when EMAIL_TRANSPORT=smtp with EMAIL_FROM + List-Unsubscribe header, else console transport; missing SMTP_HOST/EMAIL_FROM throws inside sendMail\",\n      \"files\": [\n        \"src/server/email/backoff.ts\",\n        \"src/server/email/transport.ts\"\n      ],\n      \"dependencies\": [],\n      \"estimateHours\": 1.5,\n      \"requirementIds\": [\n        \"FR-18\",\n        \"FR-21\",\n        \"NFR-9\"\n      ]\n    },\n    {\n      \"id\": \"TASK-6\",\n      \"description\": \"Outbox enqueue + auth email seam: enqueueEmail(); sendAuthEmail body renders invite/password-reset and enqueues (signature/callers unchanged, still throws, raw link no longer logged); export INVITE_TTL={days:7} from tokens.ts and use it at users.ts:384\",\n      \"files\": [\n        \"src/server/email/outbox.ts\",\n        \"src/server/auth/email.