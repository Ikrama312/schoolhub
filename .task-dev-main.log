{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011QKcrVt6FZmtBqTjr1Q5WE","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub-prds/tests/unit/useToast.test.tsx has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fc5a5891-f2a4-4318-9097-fd5c829790c6","uuid":"2ef46f58-8961-44a7-ae8a-00b162d700f9","timestamp":"2026-10-16T15:36:20.929Z","tool_use_result":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/tests/unit/useToast.test.tsx","oldString":"    vi.useFakeTimers();\n    renderWithProvider();","newString":"    // MUI's exit transition schedules its final step via requestAnimationFrame;\n    // fake it alongside setTimeout so advancing timers actually flushes onExited.\n    vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout', 'requestAnimationFrame', 'cancelAnimationFrame'] });\n    renderWithProvider();","originalFile":"import '@testing-library/jest-dom/vitest';\nimport { describe, expect, it, vi, afterEach } from 'vitest';\nimport { render, screen, act } from '@testing-library/react';\nimport { ToastProvider } from '@/components/Toast/ToastProvider';\nimport { useToast } from '@/components/Toast/useToast';\n\nfunction Trigger() {\n  const { showToast } = useToast();\n  return (\n    <>\n      <button onClick={() => showToast({ message: 'First toast', severity: 'success' })}>show-1</button>\n      <button onClick={() => showToast({ message: 'Second toast', severity: 'error' })}>show-2</button>\n    </>\n  );\n}\n\nfunction renderWithProvider() {\n  return render(\n    <ToastProvider>\n      <Trigger />\n    </ToastProvider>,\n  );\n}\n\nafterEach(() => {\n  vi.useRealTimers();\n});\n\ndescribe('useToast / ToastProvider', () => {\n  it('throws when used outside a ToastProvider', () => {\n    function Bare() {\n      useToast();\n      return null;\n    }\n    expect(() => render(<Bare />)).toThrow(/ToastProvider/);\n  });\n\n  it('shows a toast with the given message and severity', () => {\n    renderWithProvider();\n    act(() => screen.getByText('show-1').click());\n    expect(screen.getByText('First toast')).toBeInTheDocument();\n  });\n\n  it('queues a second toast instead of showing both at once', () => {\n    renderWithProvider();\n    act(() => screen.getByText('show-1').click());\n    act(() => screen.getByText('show-2').click());\n    expect(screen.getByText('First toast')).toBeInTheDocument();\n    expect(screen.queryByText('Second toast')).not.toBeInTheDocument();\n  });\n\n  it('auto-hides after 5 seconds and advances the queue to the next toast', async () => {\n    vi.useFakeTimers();\n    renderWithProvider();\n\n    act(() => screen.getByText('show-1').click());\n    act(() => screen.getByText('show-2').click());\n    expect(screen.getByText('First toast')).toBeInTheDocument();\n\n    // 5s auto-hide + generous buffer for the exit transition.\n    await act(async () => {\n      await vi.advanceTimersByTimeAsync(5500);\n    });\n\n    expect(screen.queryByText('First toast')).not.toBeInTheDocument();\n    expect(screen.getByText('Second toast')).toBeInTheDocument();\n  });\n});\n","structuredPatch":[{"oldStart":50,"oldLines":7,"newStart":50,"newLines":9,"lines":["   });"," ","   it('auto-hides after 5 seconds and advances the queue to the next toast', async () => {","-    vi.useFakeTimers();","+    // MUI's exit transition schedules its final step via requestAnimationFrame;","+    // fake it alongside setTimeout so advancing timers actually flushes onExited.","+    vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout', 'requestAnimationFrame', 'cancelAnimationFrame'] });","     renderWithProvider();"," ","     act(() => screen.getByText('show-1').click());"]}],"userModified":false,"replaceAll":false}}
