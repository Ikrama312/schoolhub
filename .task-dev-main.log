{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PNvoakwqHmk64tHwG6Q7Uu","type":"tool_result","content":"1\timport Avatar from '@mui/material/Avatar';\n2\t\n3\texport interface UserAvatarProps {\n4\t  userId: string;\n5\t  name: string;\n6\t  size?: number;\n7\t}\n8\t\n9\tconst PALETTE = ['#4F46E5', '#0EA5E9', '#15803D', '#B45309', '#B91C1C', '#7C3AED', '#0D9488'];\n10\t\n11\tfunction colorForId(id: string): string {\n12\t  let hash = 0;\n13\t  for (let i = 0; i < id.length; i += 1) {\n14\t    hash = (hash * 31 + id.charCodeAt(i)) | 0;\n15\t  }\n16\t  return PALETTE[Math.abs(hash) % PALETTE.length];\n17\t}\n18\t\n19\tfunction initialsFor(name: string): string {\n20\t  const parts = name.trim().split(/\\s+/).filter(Boolean);\n21\t  if (parts.length === 0) return '?';\n22\t  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n23\t  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n24\t}\n25\t\n26\t/** Avatar with initials on a deterministic background colour derived from userId. */\n27\texport function UserAvatar({ userId, name, size = 32 }: UserAvatarProps) {\n28\t  return (\n29\t    <Avatar sx={{ bgcolor: colorForId(userId), width: size, height: size, fontSize: size * 0.4 }}>\n30\t      {initialsFor(name)}\n31\t    </Avatar>\n32\t  );\n33\t}\n34\t"}]},"parent_tool_use_id":null,"session_id":"97520f4c-ae80-4db0-b68a-6ea625258a9f","uuid":"1df079cd-14cf-464e-9b9d-d62f5db71c0a","timestamp":"2026-10-16T17:40:50.306Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/UserAvatar/UserAvatar.tsx","content":"import Avatar from '@mui/material/Avatar';\n\nexport interface UserAvatarProps {\n  userId: string;\n  name: string;\n  size?: number;\n}\n\nconst PALETTE = ['#4F46E5', '#0EA5E9', '#15803D', '#B45309', '#B91C1C', '#7C3AED', '#0D9488'];\n\nfunction colorForId(id: string): string {\n  let hash = 0;\n  for (let i = 0; i < id.length; i += 1) {\n    hash = (hash * 31 + id.charCodeAt(i)) | 0;\n  }\n  return PALETTE[Math.abs(hash) % PALETTE.length];\n}\n\nfunction initialsFor(name: string): string {\n  const parts = name.trim().split(/\\s+/).filter(Boolean);\n  if (parts.length === 0) return '?';\n  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n}\n\n/** Avatar with initials on a deterministic background colour derived from userId. */\nexport function UserAvatar({ userId, name, size = 32 }: UserAvatarProps) {\n  return (\n    <Avatar sx={{ bgcolor: colorForId(userId), width: size, height: size, fontSize: size * 0.4 }}>\n      {initialsFor(name)}\n    </Avatar>\n  );\n}\n","numLines":34,"startLine":1,"totalLines":34}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019L5YK7aSM853u4Ju2LZhs6","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { Controller, type Control, type FieldValues, type Path } from 'react-hook-form';\n4\timport TextField, { type TextFieldProps } from '@mui/material/TextField';\n5\timport MenuItem from '@mui/material/MenuItem';\n6\timport Checkbox from '@mui/material/Checkbox';\n7\timport Switch from '@mui/material/Switch';\n8\timport FormControlLabel from '@mui/material/FormControlLabel';\n9\timport FormControl from '@mui/material/FormControl';\n10\timport FormLabel from '@mui/material/FormLabel';\n11\timport FormHelperText from '@mui/material/FormHelperText';\n12\timport RadioGroup from '@mui/material/RadioGroup';\n13\timport Radio from '@mui/material/Radio';\n14\timport Autocomplete from '@mui/material/Autocomplete';\n15\timport { DatePicker } from '@mui/x-date-pickers/DatePicker';\n16\timport { DateTimePicker } from '@mui/x-date-pickers/DateTimePicker';\n17\t\n18\tinterface BaseProps<TFieldValues extends FieldValues> {\n19\t  name: Path<TFieldValues>;\n20\t  control: Control<TFieldValues>;\n21\t  label: string;\n22\t  helperText?: string;\n23\t}\n24\t\n25\t/** Plain text / number / etc. MUI TextField bound via Controller. */\n26\texport function TextFormField<TFieldValues extends FieldValues>({\n27\t  name,\n28\t  control,\n29\t  label,\n30\t  helperText,\n31\t  ...rest\n32\t}: BaseProps<TFieldValues> & Omit<TextFieldProps, 'name' | 'label' | 'error' | 'helperText'>) {\n33\t  return (\n34\t    <Controller\n35\t      name={name}\n36\t      control={control}\n37\t      render={({ field, fieldState }) => (\n38\t        <TextField\n39\t          {...field}\n40\t          {...rest}\n41\t          label={label}\n42\t          error={Boolean(fieldState.error)}\n43\t          helperText={fieldState.error?.message ?? helperText}\n44\t          fullWidth\n45\t        />\n46\t      )}\n47\t    />\n48\t  );\n49\t}\n50\t\n51\texport interface SelectOption {\n52\t  value: string;\n53\t  label: string;\n54\t}\n55\t\n56\texport function SelectFormField<TFieldValues extends FieldValues>({\n57\t  name,\n58\t  control,\n59\t  label,\n60\t  helperText,\n61\t  options,\n62\t}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n63\t  return (\n64\t    <Controller\n65\t      name={name}\n66\t      control={control}\n67\t      render={({ field, fieldState }) => (\n68\t        <TextField\n69\t          {...field}\n70\t          select\n71\t          label={label}\n72\t          error={Boolean(fieldState.error)}\n73\t          helperText={fieldState.error?.message ?? helperText}\n74\t          fullWidth\n75\t        >\n76\t          {options.map((option) => (\n77\t            <MenuItem key={option.value} value={option.value}>\n78\t              {option.label}\n79\t            </MenuItem>\n80\t          ))}\n81\t        </TextField>\n82\t      )}\n83\t    />\n84\t  );\n85\t}\n86\t\n87\texport function AutocompleteFormField<TFieldValues extends FieldValues>({\n88\t  name,\n89\t  control,\n90\t  label,\n91\t  helperText,\n92\t  options,\n93\t}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n94\t  return (\n95\t    <Controller\n96\t      name={name}\n97\t      control={control}\n98\t      render={({ field, fieldState }) => (\n99\t        <Autocomplete\n100\t          options={options}\n101\t          getOptionLabel={(option) => option.label}\n102\t          isOptionEqualToValue={(option, value) => option.value === value.value}\n103\t          value={options.find((option) => option.value === field.value) ?? null}\n104\t          onChange={(_event, value) => field.onChange(value?.value ?? null)}\n105\t          renderInput={(params) => (\n106\t            <TextField\n107\t              {...params}\n108\t              label={label}\n109\t              error={Boolean(fieldState.error)}\n110\t              helperText={fieldState.error?.message ?? helperText}\n111\t            />\n112\t          )}\n113\t        />\n114\t      )}\n115\t    />\n116\t  );\n117\t}\n118\t\n119\texport function CheckboxFormField<TFieldValues extends FieldValues>({\n120\t  name,\n121\t  control,\n122\t  label,\n123\t}: BaseProps<TFieldValues>) {\n124\t  return (\n125\t    <Controller\n126\t      name={name}\n127\t      control={control}\n128\t      render={({ field }) => (\n129\t        <FormControlLabel\n130\t          control={<Checkbox checked={Boolean(field.value)} onChange={(e) => field.onChange(e.target.checked)} />}\n131\t          label={label}\n132\t        />\n133\t      )}\n134\t    />\n135\t  );\n136\t}\n137\t\n138\texport function SwitchFormField<TFieldValues extends FieldValues>({\n139\t  name,\n140\t  control,\n141\t  label,\n142\t}: BaseProps<TFieldValues>) {\n143\t  return (\n144\t    <Controller\n145\t      name={name}\n146\t      control={control}\n147\t      render={({ field }) => (\n148\t        <FormControlLabel\n149\t          control={<Switch checked={Boolean(field.value)} onChange={(e) => field.onChange(e.target.checked)} />}\n150\t          label={label}\n151\t        />\n152\t      )}\n153\t    />\n154\t  );\n155\t}\n156\t\n157\texport function RadioGroupFormField<TFieldValues extends FieldValues>({\n158\t  name,\n159\t  control,\n160\t  label,\n161\t  helperText,\n162\t  options,\n163\t}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n164\t  return (\n165\t    <Controller\n166\t      name={name}\n167\t      control={control}\n168\t      render={({ field, fieldState }) => (\n169\t        <FormControl error={Boolean(fieldState.error)}>\n170\t          <FormLabel>{label}</FormLabel>\n171\t          <RadioGroup {...field} value={field.value ?? ''}>\n172\t            {options.map((option) => (\n173\t              <FormControlLabel key={option.value} value={option.value} control={<Radio />} label={option.label} />\n174\t            ))}\n175\t          </RadioGroup>\n176\t          <FormHelperText>{fieldState.error?.message ?? helperText}</FormHelperText>\n177\t        </FormControl>\n178\t      )}\n179\t    />\n180\t  );\n181\t}\n182\t\n183\texport function DatePickerFormField<TFieldValues extends FieldValues>({\n184\t  name,\n185\t  control,\n186\t  label,\n187\t  helperText,\n188\t}: BaseProps<TFieldValues>) {\n189\t  return (\n190\t    <Controller\n191\t      name={name}\n192\t      control={control}\n193\t      render={({ field, fieldState }) => (\n194\t        <DatePicker\n195\t          label={label}\n196\t          value={field.value ?? null}\n197\t          onChange={field.onChange}\n198\t          slotProps={{\n199\t            textField: {\n200\t              error: Boolean(fieldState.error),\n201\t              helperText: fieldState.error?.message ?? helperText,\n202\t              fullWidth: true,\n203\t            },\n204\t          }}\n205\t        />\n206\t      )}\n207\t    />\n208\t  );\n209\t}\n210\t\n211\texport function DateTimePickerFormField<TFieldValues extends FieldValues>({\n212\t  name,\n213\t  control,\n214\t  label,\n215\t  helperText,\n216\t}: BaseProps<TFieldValues>) {\n217\t  return (\n218\t    <Controller\n219\t      name={name}\n220\t      control={control}\n221\t      render={({ field, fieldState }) => (\n222\t        <DateTimePicker\n223\t          label={label}\n224\t          value={field.value ?? null}\n225\t          onChange={field.onChange}\n226\t          slotProps={{\n227\t            textField: {\n228\t              error: Boolean(fieldState.error),\n229\t              helperText: fieldState.error?.message ?? helperText,\n230\t              fullWidth: true,\n231\t            },\n232\t          }}\n233\t        />\n234\t      )}\n235\t    />\n236\t  );\n237\t}\n238\t"}]},"parent_tool_use_id":null,"session_id":"97520f4c-ae80-4db0-b68a-6ea625258a9f","uuid":"d7ada852-7e1b-4da0-af1f-1e04bddf51b5","timestamp":"2026-10-16T17:40:50.308Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/FormField/FormField.tsx","content":"'use client';\n\nimport { Controller, type Control, type FieldValues, type Path } from 'react-hook-form';\nimport TextField, { type TextFieldProps } from '@mui/material/TextField';\nimport MenuItem from '@mui/material/MenuItem';\nimport Checkbox from '@mui/material/Checkbox';\nimport Switch from '@mui/material/Switch';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormControl from '@mui/material/FormControl';\nimport FormLabel from '@mui/material/FormLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Radio from '@mui/material/Radio';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { DateTimePicker } from '@mui/x-date-pickers/DateTimePicker';\n\ninterface BaseProps<TFieldValues extends FieldValues> {\n  name: Path<TFieldValues>;\n  control: Control<TFieldValues>;\n  label: string;\n  helperText?: string;\n}\n\n/** Plain text / number / etc. MUI TextField bound via Controller. */\nexport function TextFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  ...rest\n}: BaseProps<TFieldValues> & Omit<TextFieldProps, 'name' | 'label' | 'error' | 'helperText'>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          {...rest}\n          label={label}\n          error={Boolean(fieldState.error)}\n          helperText={fieldState.error?.message ?? helperText}\n          fullWidth\n        />\n      )}\n    />\n  );\n}\n\nexport interface SelectOption {\n  value: string;\n  label: string;\n}\n\nexport function SelectFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  options,\n}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          select\n          label={label}\n          error={Boolean(fieldState.error)}\n          helperText={fieldState.error?.message ?? helperText}\n          fullWidth\n        >\n          {options.map((option) => (\n            <MenuItem key={option.value} value={option.value}>\n              {option.label}\n            </MenuItem>\n          ))}\n        </TextField>\n      )}\n    />\n  );\n}\n\nexport function AutocompleteFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  options,\n}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <Autocomplete\n          options={options}\n          getOptionLabel={(option) => option.label}\n          isOptionEqualToValue={(option, value) => option.value === value.value}\n          value={options.find((option) => option.value === field.value) ?? null}\n          onChange={(_event, value) => field.onChange(value?.value ?? null)}\n          renderInput={(params) => (\n            <TextField\n              {...params}\n              label={label}\n              error={Boolean(fieldState.error)}\n              helperText={fieldState.error?.message ?? helperText}\n            />\n          )}\n        />\n      )}\n    />\n  );\n}\n\nexport function CheckboxFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n}: BaseProps<TFieldValues>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field }) => (\n        <FormControlLabel\n          control={<Checkbox checked={Boolean(field.value)} onChange={(e) => field.onChange(e.target.checked)} />}\n          label={label}\n        />\n      )}\n    />\n  );\n}\n\nexport function SwitchFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n}: BaseProps<TFieldValues>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field }) => (\n        <FormControlLabel\n          control={<Switch checked={Boolean(field.value)} onChange={(e) => field.onChange(e.target.checked)} />}\n          label={label}\n        />\n      )}\n    />\n  );\n}\n\nexport function RadioGroupFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  options,\n}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <FormControl error={Boolean(fieldState.error)}>\n          <FormLabel>{label}</FormLabel>\n          <RadioGroup {...field} value={field.value ?? ''}>\n            {options.map((option) => (\n              <FormControlLabel key={option.value} value={option.value} control={<Radio />} label={option.label} />\n            ))}\n          </RadioGroup>\n          <FormHelperText>{fieldState.error?.message ?? helperText}</FormHelperText>\n        </FormControl>\n      )}\n    />\n  );\n}\n\nexport function DatePickerFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n}: BaseProps<TFieldValues>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <DatePicker\n          label={label}\n          value={field.value ?? null}\n          onChange={field.onChange}\n          slotProps={{\n            textField: {\n              error: Boolean(fieldState.error),\n              helperText: fieldState.error?.message ?? helperText,\n              fullWidth: true,\n            },\n          }}\n        />\n      )}\n    />\n  );\n}\n\nexport function DateTimePickerFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n}: BaseProps<TFieldValues>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <DateTimePicker\n          label={label}\n          value={field.value ?? null}\n          onChange={field.onChange}\n          slotProps={{\n            textField: {\n              error: Boolean(fieldState.error),\n              helperText: fieldState.error?.message ?? helperText,\n              fullWidth: true,\n            },\n          }}\n        />\n      )}\n    />\n  );\n}\n","numLines":238,"startLine":1,"totalLines":238}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QRQDjBdTggsTPRFET4Pcza","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { createContext, useContext } from 'react';\n4\timport type { AlertColor } from '@mui/material/Alert';\n5\t\n6\texport interface ToastOptions {\n7\t  message: string;\n8\t  severity?: AlertColor;\n9\t}\n10\t\n11\texport interface ToastContextValue {\n12\t  showToast: (options: ToastOptions) => void;\n13\t}\n14\t\n15\texport const ToastContext = createContext<ToastContextValue | null>(null);\n16\t\n17\texport function useToast(): ToastContextValue {\n18\t  const ctx = useContext(ToastContext);\n19\t  if (!ctx) {\n20\t    throw new Error('useToast must be used within a ToastProvider');\n21\t  }\n22\t  return ctx;\n23\t}\n24\t"}]},"parent_tool_use_id":null,"session_id":"97520f4c-ae80-4db0-b68a-6ea625258a9f","uuid":"8d6cfc5f-5744-496e-8ad5-e995bb883a1a","timestamp":"2026-10-16T17:40:50.310Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/components/Toast/useToast.ts","content":"'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\n","numLines":24,"startLine":1,"totalLines":24}}}
