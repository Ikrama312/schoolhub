{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013qjPpYiHqgmSoUHJjEoQ9a","type":"tool_result","content":"1\timport { z } from 'zod';\n2\t\n3\t/**\n4\t * Fail-fast env validation. Runs once at module load (startup boundary) —\n5\t * anything importing this module gets a readable error naming every\n6\t * missing/invalid variable instead of an undefined-at-runtime surprise.\n7\t */\n8\tconst envSchema = z.object({\n9\t  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n10\t  APP_URL: z.string().min(1, 'APP_URL is required'),\n11\t  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n12\t  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n13\t});\n14\t\n15\tfunction loadEnv() {\n16\t  const parsed = envSchema.safeParse(process.env);\n17\t  if (!parsed.success) {\n18\t    const issues = parsed.error.issues\n19\t      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n20\t      .join('\\n');\n21\t    throw new Error(`Invalid environment variables:\\n${issues}`);\n22\t  }\n23\t  return parsed.data;\n24\t}\n25\t\n26\texport const env = loadEnv();\n27\texport type Env = z.infer<typeof envSchema>;\n28\t"}]},"parent_tool_use_id":null,"session_id":"97520f4c-ae80-4db0-b68a-6ea625258a9f","uuid":"7b72d4aa-32e1-4e90-b8a6-c1de4c9eedf8","timestamp":"2026-10-16T17:36:44.013Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/lib/env.ts","content":"import { z } from 'zod';\n\n/**\n * Fail-fast env validation. Runs once at module load (startup boundary) —\n * anything importing this module gets a readable error naming every\n * missing/invalid variable instead of an undefined-at-runtime surprise.\n */\nconst envSchema = z.object({\n  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n  APP_URL: z.string().min(1, 'APP_URL is required'),\n  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n});\n\nfunction loadEnv() {\n  const parsed = envSchema.safeParse(process.env);\n  if (!parsed.success) {\n    const issues = parsed.error.issues\n      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n      .join('\\n');\n    throw new Error(`Invalid environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\nexport const env = loadEnv();\nexport type Env = z.infer<typeof envSchema>;\n","numLines":28,"startLine":1,"totalLines":28}}}
