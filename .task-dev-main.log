\"items\": {\"$ref\": \"#/sharedSchemas/EmailLogItem\"}}, \"meta\": {\"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\"}}, \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"], \"requirementIds\": [\"FR-39\", \"FR-31\", \"NFR-8\"]}\n\n{\"method\": \"POST\", \"path\": \"/api/admin/email-log/{id}/retry\", \"routeFile\": \"src/app/api/admin/email-log/[id]/retry/route.ts\", \"description\": \"Resets a FAILED row with updateMany({ id, status: FAILED }, { attempts: 0, status: PENDING, nextAttemptAt: now, lastError: null }). A count of 0 (missing or not FAILED) returns 404 NOT_FOUND, so a double click is harmless.\", \"auth\": \"requireRole('ADMIN')\", \"requestSchema\": {\"params\": {\"id\": {\"type\": \"string\"}}}, \"responseSchema\": {\"data\": {\"type\": \"object\", \"required\": [\"id\", \"status\"], \"properties\": {\"id\": {\"type\": \"string\"}, \"status\": {\"const\": \"PENDING\"}}}}, \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"], \"requirementIds\": [\"FR-32\", \"FR-39\", \"NFR-8\"]}\n\n{\"method\": \"POST\", \"path\": \"/api/admin/notifications/test\", \"routeFile\": \"src/app/api/admin/notifications/test/route.ts\", \"description\": \"Calls notify({ type: 'system.test', userIds: [me.id], title: 'Test notification', link: '/dashboard', email: { template: 'generic-notification' } }) for the calling admin. notify() never throws, so the route always returns 200 once auth passes.\", \"auth\": \"requireRole('ADMIN')\", \"requestSchema\": {}, \"responseSchema\": {\"data\": {\"type\": \"object\", \"required\": [\"ok\"], \"properties\": {\"ok\": {\"const\": true}}}}, \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"], \"requirementIds\": [\"FR-33\", \"FR-4\", \"FR-6\", \"NFR-8\", \"NFR-16\"]}\n\n{\"method\": \"POST\", \"path\": \"/api/internal/email/dispatch\", \"routeFile\": \"src/app/api/internal/email/dispatch/route.ts\", \"description\": \"The cron entry point. It runs dispatchEmails({ batchSize: 50 }), then t