{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XNV5UfJFCTG9PCS2n3Hfuj","type":"tool_result","content":"1\timport { PrismaClient } from '@prisma/client';\n2\t\n3\tconst prisma = new PrismaClient();\n4\t\n5\t/**\n6\t * Idempotent: upsert on the fixed \"singleton\" id, so re-running the seed\n7\t * never creates a duplicate SchoolSettings row.\n8\t */\n9\tasync function main() {\n10\t  await prisma.schoolSettings.upsert({\n11\t    where: { id: 'singleton' },\n12\t    update: {},\n13\t    create: {\n14\t      id: 'singleton',\n15\t      name: 'SchoolHub Academy',\n16\t      shortName: 'SchoolHub',\n17\t      timezone: 'America/New_York',\n18\t      city: 'Springfield',\n19\t      country: 'USA',\n20\t      phone: '+1 555 0100',\n21\t      email: 'office@schoolhub.test',\n22\t    },\n23\t  });\n24\t\n25\t  const year = await prisma.academicYear.upsert({\n26\t    where: { name: '2026-2027' },\n27\t    update: { isCurrent: true },\n28\t    create: {\n29\t      name: '2026-2027',\n30\t      startDate: new Date('2026-08-17'),\n31\t      endDate: new Date('2027-06-11'),\n32\t      isCurrent: true,\n33\t    },\n34\t  });\n35\t\n36\t  const semesters: { name: string; startDate: string; endDate: string; order: number }[] = [\n37\t    { name: 'Semester 1', startDate: '2026-08-17', endDate: '2027-01-15', order: 1 },\n38\t    { name: 'Semester 2', startDate: '2027-01-18', endDate: '2027-06-11', order: 2 },\n39\t  ];\n40\t  for (const term of semesters) {\n41\t    await prisma.term.upsert({\n42\t      where: { academicYearId_name: { academicYearId: year.id, name: term.name } },\n43\t      update: {},\n44\t      create: {\n45\t        academicYearId: year.id,\n46\t        name: term.name,\n47\t        startDate: new Date(term.startDate),\n48\t        endDate: new Date(term.endDate),\n49\t        order: term.order,\n50\t      },\n51\t    });\n52\t  }\n53\t\n54\t  const gradeLevels = [\n55\t    { name: 'Grade 6', shortName: 'G6', order: 1 },\n56\t    { name: 'Grade 7', shortName: 'G7', order: 2 },\n57\t    { name: 'Grade 8', shortName: 'G8', order: 3 },\n58\t  ];\n59\t  for (const grade of gradeLevels) {\n60\t    await prisma.gradeLevel.upsert({ where: { name: grade.name }, update: {}, create: grade });\n61\t  }\n62\t\n63\t  const subjects = [\n64\t    { name: 'Mathematics', code: 'MATH', color: '#4F46E5' },\n65\t    { name: 'English Language Arts', code: 'ELA', color: '#0EA5E9' },\n66\t    { name: 'Science', code: 'SCI', color: '#16A34A' },\n67\t    { name: 'Social Studies', code: 'SOC', color: '#D97706' },\n68\t    { name: 'Physical Education', code: 'PE', color: '#DC2626' },\n69\t    { name: 'Art', code: 'ART', color: '#9333EA' },\n70\t  ];\n71\t  for (const subject of subjects) {\n72\t    await prisma.subject.upsert({ where: { code: subject.code }, update: {}, create: subject });\n73\t  }\n74\t\n75\t  const rooms = [\n76\t    { name: 'Room 101', building: 'Main Building', capacity: 30 },\n77\t    { name: 'Room 102', building: 'Main Building', capacity: 28 },\n78\t    { name: 'Science Lab A', building: 'Science Wing', capacity: 24 },\n79\t    { name: 'Gymnasium', building: 'Athletics Building', capacity: 120 },\n80\t    { name: 'Art Studio', building: 'Main Building', capacity: 20 },\n81\t  ];\n82\t  for (const room of rooms) {\n83\t    await prisma.room.upsert({ where: { name: room.name }, update: {}, create: room });\n84\t  }\n85\t}\n86\t\n87\tmain()\n88\t  .then(async () => {\n89\t    await prisma.$disconnect();\n90\t  })\n91\t  .catch(async (error) => {\n92\t    console.error(error);\n93\t    await prisma.$disconnect();\n94\t    process.exit(1);\n95\t  });\n96\t"}]},"parent_tool_use_id":null,"session_id":"26ce942b-d6a7-4ab5-ac09-e89a7a8e3024","uuid":"d993da8b-da47-44cb-a92a-ead5533a664c","timestamp":"2026-10-20T07:03:02.627Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/prisma/seed.ts","content":"import { PrismaClient } from '@prisma/client';\n\nconst prisma = new PrismaClient();\n\n/**\n * Idempotent: upsert on the fixed \"singleton\" id, so re-running the seed\n * never creates a duplicate SchoolSettings row.\n */\nasync function main() {\n  await prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: {\n      id: 'singleton',\n      name: 'SchoolHub Academy',\n      shortName: 'SchoolHub',\n      timezone: 'America/New_York',\n      city: 'Springfield',\n      country: 'USA',\n      phone: '+1 555 0100',\n      email: 'office@schoolhub.test',\n    },\n  });\n\n  const year = await prisma.academicYear.upsert({\n    where: { name: '2026-2027' },\n    update: { isCurrent: true },\n    create: {\n      name: '2026-2027',\n      startDate: new Date('2026-08-17'),\n      endDate: new Date('2027-06-11'),\n      isCurrent: true,\n    },\n  });\n\n  const semesters: { name: string; startDate: string; endDate: string; order: number }[] = [\n    { name: 'Semester 1', startDate: '2026-08-17', endDate: '2027-01-15', order: 1 },\n    { name: 'Semester 2', startDate: '2027-01-18', endDate: '2027-06-11', order: 2 },\n  ];\n  for (const term of semesters) {\n    await prisma.term.upsert({\n      where: { academicYearId_name: { academicYearId: year.id, name: term.name } },\n      update: {},\n      create: {\n        academicYearId: year.id,\n        name: term.name,\n        startDate: new Date(term.startDate),\n        endDate: new Date(term.endDate),\n        order: term.order,\n      },\n    });\n  }\n\n  const gradeLevels = [\n    { name: 'Grade 6', shortName: 'G6', order: 1 },\n    { name: 'Grade 7', shortName: 'G7', order: 2 },\n    { name: 'Grade 8', shortName: 'G8', order: 3 },\n  ];\n  for (const grade of gradeLevels) {\n    await prisma.gradeLevel.upsert({ where: { name: grade.name }, update: {}, create: grade });\n  }\n\n  const subjects = [\n    { name: 'Mathematics', code: 'MATH', color: '#4F46E5' },\n    { name: 'English Language Arts', code: 'ELA', color: '#0EA5E9' },\n    { name: 'Science', code: 'SCI', color: '#16A34A' },\n    { name: 'Social Studies', code: 'SOC', color: '#D97706' },\n    { name: 'Physical Education', code: 'PE', color: '#DC2626' },\n    { name: 'Art', code: 'ART', color: '#9333EA' },\n  ];\n  for (const subject of subjects) {\n    await prisma.subject.upsert({ where: { code: subject.code }, update: {}, create: subject });\n  }\n\n  const rooms = [\n    { name: 'Room 101', building: 'Main Building', capacity: 30 },\n    { name: 'Room 102', building: 'Main Building', capacity: 28 },\n    { name: 'Science Lab A', building: 'Science Wing', capacity: 24 },\n    { name: 'Gymnasium', building: 'Athletics Building', capacity: 120 },\n    { name: 'Art Studio', building: 'Main Building', capacity: 20 },\n  ];\n  for (const room of rooms) {\n    await prisma.room.upsert({ where: { name: room.name }, update: {}, create: room });\n  }\n}\n\nmain()\n  .then(async () => {\n    await prisma.$disconnect();\n  })\n  .catch(async (error) => {\n    console.error(error);\n    await prisma.$disconnect();\n    process.exit(1);\n  });\n","numLines":96,"startLine":1,"totalLines":96}}}
