{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KcZvN8P5BzUukKg9UXg9sM","type":"tool_result","content":"1\timport { Prisma } from '@prisma/client';\n2\timport { prisma } from '@/server/db';\n3\timport { AppError } from '@/server/http';\n4\timport { audit } from '@/server/audit';\n5\timport { getCurrentAcademicYear } from '@/server/services/academicYears';\n6\timport {\n7\t  checkCapacityOrThrow,\n8\t  dropSectionCoreCourses,\n9\t  enrollSectionCoreCourses,\n10\t  moveStudentSection,\n11\t  type EnrollResult,\n12\t  type Tx,\n13\t} from '@/server/enrollment/roster-engine';\n14\timport type {\n15\t  CopyToYearInput,\n16\t  EnrollStudentsInput,\n17\t  MoveSectionInput,\n18\t  SectionInput,\n19\t  SectionsListQuery,\n20\t  SectionUpdateInput,\n21\t} from '@/lib/validators/sections';\n22\t\n23\t/** Sections CRUD + membership (PRD-05 FR-2..FR-9, FR-12, FR-24, NFR-2, NFR-6). */\n24\t\n25\texport function personName(user: { firstName: string; lastName: string }): string {\n26\t  return `${user.firstName} ${user.lastName}`;\n27\t}\n28\t\n29\tconst personSelect = { id: true, firstName: true, lastName: true } as const;\n30\t\n31\tconst sectionInclude = {\n32\t  gradeLevel: { select: { id: true, name: true, order: true } },\n33\t  homeroomTeacher: { select: personSelect },\n34\t  room: { select: { id: true, name: true } },\n35\t  _count: { select: { members: true, courses: true } },\n36\t} satisfies Prisma.SectionInclude;\n37\t\n38\ttype SectionRow = Prisma.SectionGetPayload<{ include: typeof sectionInclude }>;\n39\t\n40\tfunction toSection(row: SectionRow) {\n41\t  const { _count, homeroomTeacher, ...rest } = row;\n42\t  return {\n43\t    ...rest,\n44\t    homeroomTeacher: homeroomTeacher ? { id: homeroomTeacher.id, name: personName(homeroomTeacher) } : null,\n45\t    memberCount: _count.members,\n46\t    courseCount: _count.courses,\n47\t  };\n48\t}\n49\texport type SectionDto = ReturnType<typeof toSection>;\n50\t\n51\tasync function resolveYearId(academicYearId?: string): Promise<string | null> {\n52\t  if (academicYearId) return academicYearId;\n53\t  const current = await getCurrentAcademicYear();\n54\t  return current?.id ?? null;\n55\t}\n56\t\n57\texport async function listSections(query: Partial<SectionsListQuery>, page: { skip: number; take: number }) {\n58\t  const academicYearId = await resolveYearId(query.academicYearId);\n59\t  if (!academicYearId) return { rows: [] as SectionDto[], total: 0, academicYearId: null };\n60\t\n61\t  const where: Prisma.SectionWhereInput = {\n62\t    academicYearId,\n63\t    ...(query.gradeLevelId ? { gradeLevelId: query.gradeLevelId } : {}),\n64\t    ...(query.q ? { name: { contains: query.q, mode: 'insensitive' } } : {}),\n65\t  };\n66\t  const order = query.order ?? 'asc';\n67\t  const orderBy: Prisma.SectionOrderByWithRelationInput[] =\n68\t    query.sort === 'name'\n69\t      ? [{ name: order }]\n70\t      : query.sort === 'memberCount'\n71\t        ? [{ members: { _count: order } }, { name: 'asc' }]\n72\t        : [{ gradeLevel: { order } }, { name: 'asc' }];\n73\t\n74\t  const [rows, total] = await Promise.all([\n75\t    prisma.section.findMany({ where, include: sectionInclude, orderBy, skip: page.skip, take: page.take }),\n76\t    prisma.section.count({ where }),\n77\t  ]);\n78\t  return { rows: rows.map(toSection), total, academicYearId };\n79\t}\n80\t\n81\texport async function getSection(id: string) {\n82\t  const row = await prisma.section.findUnique({\n83\t    where: { id },\n84\t    include: {\n85\t      ...sectionInclude,\n86\t      academicYear: { select: { id: true, name: true } },\n87\t      members: {\n88\t        include: {\n89\t          student: { select: { ...personSelect, email: true, studentProfile: { select: { admissionNumber: true } } } },\n90\t        },\n91\t        orderBy: [{ student: { lastName: 'asc' } }, { student: { firstName: 'asc' } }],\n92\t      },\n93\t      courses: {\n94\t        include: { subject: { select: { id: true, name: true, code: true, color: true } }, teacher: { select: personSelect } },\n95\t        orderBy: { code: 'asc' },\n96\t      },\n97\t    },\n98\t  });\n99\t  if (!row) throw new AppError('NOT_FOUND', 'Section not found');\n100\t  const { members, courses, academicYear, ...rest } = row;\n101\t  return {\n102\t    ...toSection(rest as SectionRow),\n103\t    academicYear,\n104\t    members: members.map((m) => ({\n105\t      id: m.student.id,\n106\t      name: personName(m.student),\n107\t      email: m.student.email,\n108\t      admissionNumber: m.student.studentProfile?.admissionNumber ?? null,\n109\t      joinedAt: m.joinedAt,\n110\t    })),\n111\t    courses: courses.map((c) => ({\n112\t      id: c.id,\n113\t      name: c.name,\n114\t      code: c.code,\n115\t      kind: c.kind,\n116\t      archivedAt: c.archivedAt,\n117\t      subject: c.subject,\n118\t      teacher: { id: c.teacher.id, name: personName(c.teacher) },\n119\t    })),\n120\t  };\n121\t}\n122\t\n123\tasync function assertTeacher(tx: Tx, teacherId: string) {\n124\t  const teacher = await tx.user.findUnique({ where: { id: teacherId }, select: { role: true } });\n125\t  if (!teacher || teacher.role !== 'TEACHER') {\n126\t    throw new AppError('VALIDATION_ERROR', 'Homeroom teacher must be a teacher.');\n127\t  }\n128\t}\n129\t\n130\t/** Decision 3: one homeroom section per teacher per year, checked inside the write tx. */\n131\tasync function assertHomeroomAvailable(tx: Tx, academicYearId: string, teacherId: string, excludeId?: string) {\n132\t  const clash = await tx.section.findFirst({\n133\t    where: { academicYearId, homeroomTeacherId: teacherId, ...(excludeId ? { id: { not: excludeId } } : {}) },\n134\t    select: { name: true },\n135\t  });\n136\t  if (clash) {\n137\t    throw new AppError('CONFLICT', `This teacher is already homeroom teacher of section ${clash.name} this year.`);\n138\t  }\n139\t}\n140\t"}]},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"35e393f8-fdcf-4b71-acd8-9b3b4d48423d","timestamp":"2026-10-27T16:49:42.507Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/sections/sections-service.ts","content":"import { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { getCurrentAcademicYear } from '@/server/services/academicYears';\nimport {\n  checkCapacityOrThrow,\n  dropSectionCoreCourses,\n  enrollSectionCoreCourses,\n  moveStudentSection,\n  type EnrollResult,\n  type Tx,\n} from '@/server/enrollment/roster-engine';\nimport type {\n  CopyToYearInput,\n  EnrollStudentsInput,\n  MoveSectionInput,\n  SectionInput,\n  SectionsListQuery,\n  SectionUpdateInput,\n} from '@/lib/validators/sections';\n\n/** Sections CRUD + membership (PRD-05 FR-2..FR-9, FR-12, FR-24, NFR-2, NFR-6). */\n\nexport function personName(user: { firstName: string; lastName: string }): string {\n  return `${user.firstName} ${user.lastName}`;\n}\n\nconst personSelect = { id: true, firstName: true, lastName: true } as const;\n\nconst sectionInclude = {\n  gradeLevel: { select: { id: true, name: true, order: true } },\n  homeroomTeacher: { select: personSelect },\n  room: { select: { id: true, name: true } },\n  _count: { select: { members: true, courses: true } },\n} satisfies Prisma.SectionInclude;\n\ntype SectionRow = Prisma.SectionGetPayload<{ include: typeof sectionInclude }>;\n\nfunction toSection(row: SectionRow) {\n  const { _count, homeroomTeacher, ...rest } = row;\n  return {\n    ...rest,\n    homeroomTeacher: homeroomTeacher ? { id: homeroomTeacher.id, name: personName(homeroomTeacher) } : null,\n    memberCount: _count.members,\n    courseCount: _count.courses,\n  };\n}\nexport type SectionDto = ReturnType<typeof toSection>;\n\nasync function resolveYearId(academicYearId?: string): Promise<string | null> {\n  if (academicYearId) return academicYearId;\n  const current = await getCurrentAcademicYear();\n  return current?.id ?? null;\n}\n\nexport async function listSections(query: Partial<SectionsListQuery>, page: { skip: number; take: number }) {\n  const academicYearId = await resolveYearId(query.academicYearId);\n  if (!academicYearId) return { rows: [] as SectionDto[], total: 0, academicYearId: null };\n\n  const where: Prisma.SectionWhereInput = {\n    academicYearId,\n    ...(query.gradeLevelId ? { gradeLevelId: query.gradeLevelId } : {}),\n    ...(query.q ? { name: { contains: query.q, mode: 'insensitive' } } : {}),\n  };\n  const order = query.order ?? 'asc';\n  const orderBy: Prisma.SectionOrderByWithRelationInput[] =\n    query.sort === 'name'\n      ? [{ name: order }]\n      : query.sort === 'memberCount'\n        ? [{ members: { _count: order } }, { name: 'asc' }]\n        : [{ gradeLevel: { order } }, { name: 'asc' }];\n\n  const [rows, total] = await Promise.all([\n    prisma.section.findMany({ where, include: sectionInclude, orderBy, skip: page.skip, take: page.take }),\n    prisma.section.count({ where }),\n  ]);\n  return { rows: rows.map(toSection), total, academicYearId };\n}\n\nexport async function getSection(id: string) {\n  const row = await prisma.section.findUnique({\n    where: { id },\n    include: {\n      ...sectionInclude,\n      academicYear: { select: { id: true, name: true } },\n      members: {\n        include: {\n          student: { select: { ...personSelect, email: true, studentProfile: { select: { admissionNumber: true } } } },\n        },\n        orderBy: [{ student: { lastName: 'asc' } }, { student: { firstName: 'asc' } }],\n      },\n      courses: {\n        include: { subject: { select: { id: true, name: true, code: true, color: true } }, teacher: { select: personSelect } },\n        orderBy: { code: 'asc' },\n      },\n    },\n  });\n  if (!row) throw new AppError('NOT_FOUND', 'Section not found');\n  const { members, courses, academicYear, ...rest } = row;\n  return {\n    ...toSection(rest as SectionRow),\n    academicYear,\n    members: members.map((m) => ({\n      id: m.student.id,\n      name: personName(m.student),\n      email: m.student.email,\n      admissionNumber: m.student.studentProfile?.admissionNumber ?? null,\n      joinedAt: m.joinedAt,\n    })),\n    courses: courses.map((c) => ({\n      id: c.id,\n      name: c.name,\n      code: c.code,\n      kind: c.kind,\n      archivedAt: c.archivedAt,\n      subject: c.subject,\n      teacher: { id: c.teacher.id, name: personName(c.teacher) },\n    })),\n  };\n}\n\nasync function assertTeacher(tx: Tx, teacherId: string) {\n  const teacher = await tx.user.findUnique({ where: { id: teacherId }, select: { role: true } });\n  if (!teacher || teacher.role !== 'TEACHER') {\n    throw new AppError('VALIDATION_ERROR', 'Homeroom teacher must be a teacher.');\n  }\n}\n\n/** Decision 3: one homeroom section per teacher per year, checked inside the write tx. */\nasync function assertHomeroomAvailable(tx: Tx, academicYearId: string, teacherId: string, excludeId?: string) {\n  const clash = await tx.section.findFirst({\n    where: { academicYearId, homeroomTeacherId: teacherId, ...(excludeId ? { id: { not: excludeId } } : {}) },\n    select: { name: true },\n  });\n  if (clash) {\n    throw new AppError('CONFLICT', `This teacher is already homeroom teacher of section ${clash.name} this year.`);\n  }\n}\n","numLines":140,"startLine":1,"totalLines":412}},"tool_result_meta":[{"id":"toolu_01KcZvN8P5BzUukKg9UXg9sM","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
