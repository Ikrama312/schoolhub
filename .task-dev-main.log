{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011nP87rD77qxyX58dDDaXTq","type":"tool_result","content":"'use client';\n\nimport Box from '@mui/material/Box';\nimport AppBar from '@mui/material/AppBar';\nimport Toolbar from '@mui/material/Toolbar';\nimport Drawer from '@mui/material/Drawer';\nimport List from '@mui/material/List';\nimport ListItemButton from '@mui/material/ListItemButton';\nimport ListItemIcon from '@mui/material/ListItemIcon';\nimport ListItemText from '@mui/material/ListItemText';\nimport ListSubheader from '@mui/material/ListSubheader';\nimport { Fragment, useEffect, useState } from 'react';\nimport IconButton from '@mui/material/IconButton';\nimport Typography from '@mui/material/Typography';\nimport Tooltip from '@mui/material/Tooltip';\nimport Avatar from '@mui/material/Avatar';\nimport Menu from '@mui/material/Menu';\nimport MenuItem from '@mui/material/MenuItem';\nimport Divider from '@mui/material/Divider';\nimport Chip from '@mui/material/Chip';\nimport Badge from '@mui/material/Badge';\nimport useMediaQuery from '@mui/material/useMediaQuery';\nimport { useTheme, useColorScheme } from '@mui/material/styles';\nimport Link from 'next/link';\nimport { usePathname } from 'next/navigation';\nimport MenuIcon from '@mui/icons-material/Menu';\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\nimport ChevronRightIcon from '@mui/icons-material/ChevronRight';\nimport LightModeIcon from '@mui/icons-material/LightMode';\nimport DarkModeIcon from '@mui/icons-material/DarkMode';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport PersonOutlineIcon from '@mui/icons-material/PersonOutlineOutlined';\nimport LogoutIcon from '@mui/icons-material/Logout';\nimport { navigationForRole, type Role } from '@/config/navigation';\nimport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\n\nconst DRAWER_WIDTH_EXPANDED = 256;\nconst DRAWER_WIDTH_COLLAPSED = 64;\nconst COLLAPSE_STORAGE_KEY = 'schoolhub.sidebar.collapsed';\n\n// Placeholder user until PRD-01 wires real auth (FR-33's \"for later wiring\" note).\nconst PLACEHOLDER_USER: { id: string; name: string; role: Role } = {\n  id: 'placeholder-user',\n  name: 'Guest User',\n  role: 'ADMIN',\n};\n\nexport interface AppShellProps {\n  schoolShortName: string;\n  children: React.ReactNode;\n}\n\nconst DESKTOP_BREAKPOINT_PX = 1024;\n\nexport function AppShell({ schoolShortName, children }: AppShellProps) {\n  const theme = useTheme();\n  const { mode, setMode } = useColorScheme();\n  const pathname = usePathname();\n  // FR-31/NFR-4 fix the fork at exactly 1024px — MUI's own \"lg\" breakpoint\n  // (1200px) doesn't match that, so this uses an explicit media query.\n  const isDesktop = useMediaQuery(`(min-width:${DESKTOP_BREAKPOINT_PX}px)`);\n\n  const [collapsed, setCollapsed] = useState(false);\n  const [mobileOpen, setMobileOpen] = useState(false);\n  const [menuAnchor, setMenuAnchor] = useState<HTMLElement | null>(null);\n\n  useEffect(() => {\n    const stored = window.localStorage.getItem(COLLAPSE_STORAGE_KEY);\n    if (stored === 'true') setCollapsed(true);\n  }, []);\n\n  const toggleCollapsed = () => {\n    setCollapsed((prev) => {\n      const next = !prev;\n      window.localStorage.setItem(COLLAPSE_STORAGE_KEY, String(next));\n      return next;\n    });\n  };\n\n  const drawerWidth = collapsed ? DRAWER_WIDTH_COLLAPSED : DRAWER_WIDTH_EXPANDED;\n  const items = navigationForRole(PLACEHOLDER_USER.role);\n\n  const navList = (\n    <List sx={{ pt: 1 }}>\n      {items.map((item, index) => {\n        const Icon = item.icon;\n        // Subheader above the first item of each consecutive group run; hidden when collapsed.\n        const showGroup =\n          item.group && item.group !== items[index - 1]?.group && !(collapsed && isDesktop);\n        const active = pathname === item.href || pathname.startsWith(`${item.href}/`);\n        const button = (\n          <ListItemButton\n            key={item.href}\n            component={Link}\n            href={item.href}\n            selected={active}\n            onClick={() => setMobileOpen(false)}\n            sx={{ justifyContent: collapsed && isDesktop ? 'center' : 'flex-start' }}\n          >\n            <ListItemIcon sx={{ minWidth: collapsed && isDesktop ? 0 : 40, justifyContent: 'center' }}>\n              <Icon />\n            </ListItemIcon>\n            {!(collapsed && isDesktop) && <ListItemText primary={item.label} />}\n          </ListItemButton>\n        );\n        return (\n          <Fragment key={item.href}>\n            {showGroup && (\n              <ListSubheader disableSticky sx={{ lineHeight: 2.5, bgcolor: 'transparent' }}>\n                {item.group}\n              </ListSubheader>\n            )}\n            {collapsed && isDesktop ? (\n              <Tooltip title={item.label} placement=\"right\">\n                {button}\n              </Tooltip>\n            ) : (\n              button\n            )}\n          </Fragment>\n        );\n      })}\n    </List>\n  );\n\n  return (\n    <Box sx={{ display: 'flex', minHeight: '100vh' }}>\n      <AppBar\n        position=\"fixed\"\n        sx={{\n          zIndex: (t) => t.zIndex.drawer + 1,\n          ...(isDesktop\n            ? { width: `calc(100% - ${drawerWidth}px)`, ml: `${drawerWidth}px` }\n            : {}),\n        }}\n      >\n        <Toolbar sx={{ gap: 1 }}>\n          {!isDesktop && (\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Open navigation\"\n              edge=\"start\"\n              onClick={() => setMobileOpen(true)}\n            >\n              <MenuIcon />\n            </IconButton>\n          )}\n          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n            {schoolShortName}\n          </Typography>\n\n          <Tooltip title=\"Notifications\">\n            <IconButton color=\"inherit\" aria-label=\"Notifications\">\n              <Badge badgeContent={0} color=\"error\">\n                <NotificationsNoneIcon />\n              </Badge>\n            </IconButton>\n          </Tooltip>\n\n          <Tooltip title={mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}>\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Toggle color mode\"\n              onClick={() => setMode(mode === 'dark' ? 'light' : 'dark')}\n            >\n              {mode === 'dark' ? <LightModeIcon /> : <DarkModeIcon />}\n            </IconButton>\n          </Tooltip>\n\n          <IconButton onClick={(event) => setMenuAnchor(event.currentTarget)} aria-label=\"User menu\">\n            <UserAvatar userId={PLACEHOLDER_USER.id} name={PLACEHOLDER_USER.name} size={32} />\n          </IconButton>\n          <Menu anchorEl={menuAnchor} open={Boolean(menuAnchor)} onClose={() => setMenuAnchor(null)}>\n            <Box sx={{ px: 2, py: 1 }}>\n              <Typography variant=\"subtitle2\">{PLACEHOLDER_USER.name}</Typography>\n              <Chip size=\"small\" label={PLACEHOLDER_USER.role} sx={{ mt: 0.5 }} />\n            </Box>\n            <Divider />\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <PersonOutlineIcon fontSize=\"small\" sx={{ mr: 1 }} /> Profile\n            </MenuItem>\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <LogoutIcon fontSize=\"small\" sx={{ mr: 1 }} /> Sign out\n            </MenuItem>\n          </Menu>\n        </Toolbar>\n      </AppBar>\n\n      {isDesktop ? (\n        <Drawer\n          variant=\"permanent\"\n          sx={{\n            width: drawerWidth,\n            flexShrink: 0,\n            [`& .MuiDrawer-paper`]: { width: drawerWidth, boxSizing: 'border-box', overflowX: 'hidden' },\n          }}\n        >\n          <Toolbar />\n          {navList}\n          <Box sx={{ mt: 'auto', display: 'flex', justifyContent: 'flex-end', p: 1 }}>\n            <IconButton onClick={toggleCollapsed} aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}>\n              {collapsed ? <ChevronRightIcon /> : <ChevronLeftIcon />}\n            </IconButton>\n          </Box>\n        </Drawer>\n      ) : (\n        <Drawer\n          variant=\"temporary\"\n          open={mobileOpen}\n          onClose={() => setMobileOpen(false)}\n          ModalProps={{ keepMounted: true }}\n          sx={{ [`& .MuiDrawer-paper`]: { width: DRAWER_WIDTH_EXPANDED, boxSizing: 'border-box' } }}\n        >\n          <Toolbar />\n          {navList}\n        </Drawer>\n      )}\n\n      <Box\n        component=\"main\"\n        sx={{\n          flexGrow: 1,\n          p: 3,\n          width: isDesktop ? `calc(100% - ${drawerWidth}px)` : '100%',\n        }}\n      >\n        <Toolbar />\n        {children}\n      </Box>\n    </Box>\n  );\n}\n'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport TextField from '@mui/material/TextField';\nimport InputAdornment from '@mui/material/InputAdornment';\nimport SearchIcon from '@mui/icons-material/Search';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface DataTableProps {\n  columns: GridColDef[];\n  rows: readonly Record<string, unknown>[];\n  total: number;\n  loading?: boolean;\n  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n  getRowId?: (row: Record<string, unknown>) => string | number;\n}\n\n/**\n * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n * from (and written to) URL query params, a debounced search box, and the\n * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n * params change — this component owns no fetch logic of its own.\n */\nexport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const sortField = searchParams.get('sort') ?? undefined;\n  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n\n  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n\n  const updateParams = useCallback(\n    (updates: Record<string, string | undefined>) => {\n      const next = new URLSearchParams(searchParams.toString());\n      for (const [key, value] of Object.entries(updates)) {\n        if (value === undefined || value === '') {\n          next.delete(key);\n        } else {\n          next.set(key, value);\n        }\n      }\n      router.push(`${pathname}?${next.toString()}`);\n    },\n    [pathname, router, searchParams],\n  );\n\n  // Debounce search -> URL param, resetting to page 1.\n  useEffect(() => {\n    const handle = setTimeout(() => {\n      if (searchInput !== (searchParams.get('q') ?? '')) {\n        updateParams({ q: searchInput || undefined, page: '1' });\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [searchInput]);\n\n  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n\n  return (\n    <Box>\n      <TextField\n        value={searchInput}\n        onChange={(event) => setSearchInput(event.target.value)}\n        placeholder=\"Search…\"\n        size=\"small\"\n        sx={{ mb: 2, maxWidth: 320 }}\n        InputProps={{\n          startAdornment: (\n            <InputAdornment position=\"start\">\n              <SearchIcon fontSize=\"small\" />\n            </InputAdornment>\n          ),\n        }}\n        inputProps={{ 'aria-label': 'Search' }}\n      />\n      <DataGrid\n        autoHeight\n        columns={columns}\n        rows={rows}\n        rowCount={total}\n        loading={loading}\n        getRowId={getRowId}\n        paginationMode=\"server\"\n        sortingMode=\"server\"\n        paginationModel={{ page: page - 1, pageSize }}\n        onPaginationModelChange={(model) =>\n          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n        }\n        sortModel={sortModel}\n        onSortModelChange={(model) =>\n          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n        }\n        pageSizeOptions={[10, 20, 50, 100]}\n        slots={{\n          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n        }}\n        disableRowSelectionOnClick\n      />\n    </Box>\n  );\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" alignItems=\"flex-start\" justifyContent=\"space-between\" spacing={2}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" fontWeight={600}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      alignItems=\"center\"\n      justifyContent=\"center\"\n      spacing={1.5}\n      sx={{ py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\n{\n  \"root\": true,\n  \"extends\": [\"next/core-web-vitals\", \"plugin:@typescript-eslint/recommended\"],\n  \"parser\": \"@typescript-eslint/parser\",\n  \"rules\": {\n    \"@typescript-eslint/no-unused-vars\": [\n      \"error\",\n      { \"argsIgnorePattern\": \"^_\", \"varsIgnorePattern\": \"^_\", \"destructuredArrayIgnorePattern\": \"^_\" }\n    ],\n    \"no-restricted-imports\": [\n      \"error\",\n      {\n        \"paths\": [\n          { \"name\": \"tailwindcss\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"name\": \"lucide-react\", \"message\": \"Use @mui/icons-material instead.\" },\n          { \"name\": \"next-themes\", \"message\": \"Use MUI cssVariables colorSchemes + useColorScheme() instead.\" },\n          { \"name\": \"@tanstack/react-table\", \"message\": \"Use the shared DataTable (MUI X DataGrid) instead.\" },\n          { \"name\": \"recharts\", \"message\": \"Use @mui/x-charts instead.\" },\n          { \"name\": \"react-select\", \"message\": \"Use MUI Autocomplete instead.\" },\n          { \"name\": \"react-datepicker\", \"message\": \"Use @mui/x-date-pickers instead.\" },\n          { \"name\": \"sonner\", \"message\": \"Use the shared useToast()/ToastProvider instead.\" },\n          { \"name\": \"notistack\", \"message\": \"Use the shared useToast()/ToastProvider instead.\" },\n          { \"name\": \"antd\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"name\": \"react-bootstrap\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" }\n        ],\n        \"patterns\": [\n          { \"group\": [\"@radix-ui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"group\": [\"@headlessui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"group\": [\"@fullcalendar/*\"], \"message\": \"Use @mui/x-scheduler (later PRD) instead.\" },\n          { \"group\": [\"@chakra-ui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" }\n        ]\n      }\n    ]\n  },\n  \"overrides\": [\n    {\n      \"files\": [\"src/**/*.{ts,tsx}\"],\n      \"parserOptions\": { \"project\": \"./tsconfig.json\" },\n      \"rules\": {\n        \"@typescript-eslint/no-floating-promises\": \"error\"\n      }\n    },\n    {\n      \"files\": [\"src/server/email/templates/**\"],\n      \"rules\": {\n        \"no-restricted-imports\": \"off\"\n      }\n    }\n  ]\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"1921163e-32be-4c5c-99f3-b230ef406493","uuid":"124f3332-4372-4473-bfbc-824ff908c1df","timestamp":"2026-11-04T14:55:32.264Z","tool_use_result":{"stdout":"'use client';\n\nimport Box from '@mui/material/Box';\nimport AppBar from '@mui/material/AppBar';\nimport Toolbar from '@mui/material/Toolbar';\nimport Drawer from '@mui/material/Drawer';\nimport List from '@mui/material/List';\nimport ListItemButton from '@mui/material/ListItemButton';\nimport ListItemIcon from '@mui/material/ListItemIcon';\nimport ListItemText from '@mui/material/ListItemText';\nimport ListSubheader from '@mui/material/ListSubheader';\nimport { Fragment, useEffect, useState } from 'react';\nimport IconButton from '@mui/material/IconButton';\nimport Typography from '@mui/material/Typography';\nimport Tooltip from '@mui/material/Tooltip';\nimport Avatar from '@mui/material/Avatar';\nimport Menu from '@mui/material/Menu';\nimport MenuItem from '@mui/material/MenuItem';\nimport Divider from '@mui/material/Divider';\nimport Chip from '@mui/material/Chip';\nimport Badge from '@mui/material/Badge';\nimport useMediaQuery from '@mui/material/useMediaQuery';\nimport { useTheme, useColorScheme } from '@mui/material/styles';\nimport Link from 'next/link';\nimport { usePathname } from 'next/navigation';\nimport MenuIcon from '@mui/icons-material/Menu';\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\nimport ChevronRightIcon from '@mui/icons-material/ChevronRight';\nimport LightModeIcon from '@mui/icons-material/LightMode';\nimport DarkModeIcon from '@mui/icons-material/DarkMode';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport PersonOutlineIcon from '@mui/icons-material/PersonOutlineOutlined';\nimport LogoutIcon from '@mui/icons-material/Logout';\nimport { navigationForRole, type Role } from '@/config/navigation';\nimport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\n\nconst DRAWER_WIDTH_EXPANDED = 256;\nconst DRAWER_WIDTH_COLLAPSED = 64;\nconst COLLAPSE_STORAGE_KEY = 'schoolhub.sidebar.collapsed';\n\n// Placeholder user until PRD-01 wires real auth (FR-33's \"for later wiring\" note).\nconst PLACEHOLDER_USER: { id: string; name: string; role: Role } = {\n  id: 'placeholder-user',\n  name: 'Guest User',\n  role: 'ADMIN',\n};\n\nexport interface AppShellProps {\n  schoolShortName: string;\n  children: React.ReactNode;\n}\n\nconst DESKTOP_BREAKPOINT_PX = 1024;\n\nexport function AppShell({ schoolShortName, children }: AppShellProps) {\n  const theme = useTheme();\n  const { mode, setMode } = useColorScheme();\n  const pathname = usePathname();\n  // FR-31/NFR-4 fix the fork at exactly 1024px — MUI's own \"lg\" breakpoint\n  // (1200px) doesn't match that, so this uses an explicit media query.\n  const isDesktop = useMediaQuery(`(min-width:${DESKTOP_BREAKPOINT_PX}px)`);\n\n  const [collapsed, setCollapsed] = useState(false);\n  const [mobileOpen, setMobileOpen] = useState(false);\n  const [menuAnchor, setMenuAnchor] = useState<HTMLElement | null>(null);\n\n  useEffect(() => {\n    const stored = window.localStorage.getItem(COLLAPSE_STORAGE_KEY);\n    if (stored === 'true') setCollapsed(true);\n  }, []);\n\n  const toggleCollapsed = () => {\n    setCollapsed((prev) => {\n      const next = !prev;\n      window.localStorage.setItem(COLLAPSE_STORAGE_KEY, String(next));\n      return next;\n    });\n  };\n\n  const drawerWidth = collapsed ? DRAWER_WIDTH_COLLAPSED : DRAWER_WIDTH_EXPANDED;\n  const items = navigationForRole(PLACEHOLDER_USER.role);\n\n  const navList = (\n    <List sx={{ pt: 1 }}>\n      {items.map((item, index) => {\n        const Icon = item.icon;\n        // Subheader above the first item of each consecutive group run; hidden when collapsed.\n        const showGroup =\n          item.group && item.group !== items[index - 1]?.group && !(collapsed && isDesktop);\n        const active = pathname === item.href || pathname.startsWith(`${item.href}/`);\n        const button = (\n          <ListItemButton\n            key={item.href}\n            component={Link}\n            href={item.href}\n            selected={active}\n            onClick={() => setMobileOpen(false)}\n            sx={{ justifyContent: collapsed && isDesktop ? 'center' : 'flex-start' }}\n          >\n            <ListItemIcon sx={{ minWidth: collapsed && isDesktop ? 0 : 40, justifyContent: 'center' }}>\n              <Icon />\n            </ListItemIcon>\n            {!(collapsed && isDesktop) && <ListItemText primary={item.label} />}\n          </ListItemButton>\n        );\n        return (\n          <Fragment key={item.href}>\n            {showGroup && (\n              <ListSubheader disableSticky sx={{ lineHeight: 2.5, bgcolor: 'transparent' }}>\n                {item.group}\n              </ListSubheader>\n            )}\n            {collapsed && isDesktop ? (\n              <Tooltip title={item.label} placement=\"right\">\n                {button}\n              </Tooltip>\n            ) : (\n              button\n            )}\n          </Fragment>\n        );\n      })}\n    </List>\n  );\n\n  return (\n    <Box sx={{ display: 'flex', minHeight: '100vh' }}>\n      <AppBar\n        position=\"fixed\"\n        sx={{\n          zIndex: (t) => t.zIndex.drawer + 1,\n          ...(isDesktop\n            ? { width: `calc(100% - ${drawerWidth}px)`, ml: `${drawerWidth}px` }\n            : {}),\n        }}\n      >\n        <Toolbar sx={{ gap: 1 }}>\n          {!isDesktop && (\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Open navigation\"\n              edge=\"start\"\n              onClick={() => setMobileOpen(true)}\n            >\n              <MenuIcon />\n            </IconButton>\n          )}\n          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n            {schoolShortName}\n          </Typography>\n\n          <Tooltip title=\"Notifications\">\n            <IconButton color=\"inherit\" aria-label=\"Notifications\">\n              <Badge badgeContent={0} color=\"error\">\n                <NotificationsNoneIcon />\n              </Badge>\n            </IconButton>\n          </Tooltip>\n\n          <Tooltip title={mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}>\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Toggle color mode\"\n              onClick={() => setMode(mode === 'dark' ? 'light' : 'dark')}\n            >\n              {mode === 'dark' ? <LightModeIcon /> : <DarkModeIcon />}\n            </IconButton>\n          </Tooltip>\n\n          <IconButton onClick={(event) => setMenuAnchor(event.currentTarget)} aria-label=\"User menu\">\n            <UserAvatar userId={PLACEHOLDER_USER.id} name={PLACEHOLDER_USER.name} size={32} />\n          </IconButton>\n          <Menu anchorEl={menuAnchor} open={Boolean(menuAnchor)} onClose={() => setMenuAnchor(null)}>\n            <Box sx={{ px: 2, py: 1 }}>\n              <Typography variant=\"subtitle2\">{PLACEHOLDER_USER.name}</Typography>\n              <Chip size=\"small\" label={PLACEHOLDER_USER.role} sx={{ mt: 0.5 }} />\n            </Box>\n            <Divider />\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <PersonOutlineIcon fontSize=\"small\" sx={{ mr: 1 }} /> Profile\n            </MenuItem>\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <LogoutIcon fontSize=\"small\" sx={{ mr: 1 }} /> Sign out\n            </MenuItem>\n          </Menu>\n        </Toolbar>\n      </AppBar>\n\n      {isDesktop ? (\n        <Drawer\n          variant=\"permanent\"\n          sx={{\n            width: drawerWidth,\n            flexShrink: 0,\n            [`& .MuiDrawer-paper`]: { width: drawerWidth, boxSizing: 'border-box', overflowX: 'hidden' },\n          }}\n        >\n          <Toolbar />\n          {navList}\n          <Box sx={{ mt: 'auto', display: 'flex', justifyContent: 'flex-end', p: 1 }}>\n            <IconButton onClick={toggleCollapsed} aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}>\n              {collapsed ? <ChevronRightIcon /> : <ChevronLeftIcon />}\n            </IconButton>\n          </Box>\n        </Drawer>\n      ) : (\n        <Drawer\n          variant=\"temporary\"\n          open={mobileOpen}\n          onClose={() => setMobileOpen(false)}\n          ModalProps={{ keepMounted: true }}\n          sx={{ [`& .MuiDrawer-paper`]: { width: DRAWER_WIDTH_EXPANDED, boxSizing: 'border-box' } }}\n        >\n          <Toolbar />\n          {navList}\n        </Drawer>\n      )}\n\n      <Box\n        component=\"main\"\n        sx={{\n          flexGrow: 1,\n          p: 3,\n          width: isDesktop ? `calc(100% - ${drawerWidth}px)` : '100%',\n        }}\n      >\n        <Toolbar />\n        {children}\n      </Box>\n    </Box>\n  );\n}\n'use client';\n\nimport { useCallback, useEffect, useState } from 'react';\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { DataGrid, type GridColDef, type GridSortModel } from '@mui/x-data-grid';\nimport Box from '@mui/material/Box';\nimport TextField from '@mui/material/TextField';\nimport InputAdornment from '@mui/material/InputAdornment';\nimport SearchIcon from '@mui/icons-material/Search';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nconst SEARCH_DEBOUNCE_MS = 300;\n\nexport interface DataTableProps {\n  columns: GridColDef[];\n  rows: readonly Record<string, unknown>[];\n  total: number;\n  loading?: boolean;\n  /** Row id field name, defaults to \"id\" (DataGrid's own default). */\n  getRowId?: (row: Record<string, unknown>) => string | number;\n}\n\n/**\n * Thin wrapper around MUI X DataGrid: server-side pagination/sorting read\n * from (and written to) URL query params, a debounced search box, and the\n * shared EmptyState for the no-rows overlay. Callers refetch when the URL\n * params change — this component owns no fetch logic of its own.\n */\nexport function DataTable({ columns, rows, total, loading, getRowId }: DataTableProps) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n\n  const page = Math.max(1, Number(searchParams.get('page')) || 1);\n  const pageSize = Math.min(100, Number(searchParams.get('pageSize')) || 20);\n  const sortField = searchParams.get('sort') ?? undefined;\n  const sortOrder = (searchParams.get('order') as 'asc' | 'desc' | null) ?? undefined;\n\n  const [searchInput, setSearchInput] = useState(searchParams.get('q') ?? '');\n\n  const updateParams = useCallback(\n    (updates: Record<string, string | undefined>) => {\n      const next = new URLSearchParams(searchParams.toString());\n      for (const [key, value] of Object.entries(updates)) {\n        if (value === undefined || value === '') {\n          next.delete(key);\n        } else {\n          next.set(key, value);\n        }\n      }\n      router.push(`${pathname}?${next.toString()}`);\n    },\n    [pathname, router, searchParams],\n  );\n\n  // Debounce search -> URL param, resetting to page 1.\n  useEffect(() => {\n    const handle = setTimeout(() => {\n      if (searchInput !== (searchParams.get('q') ?? '')) {\n        updateParams({ q: searchInput || undefined, page: '1' });\n      }\n    }, SEARCH_DEBOUNCE_MS);\n    return () => clearTimeout(handle);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [searchInput]);\n\n  const sortModel: GridSortModel = sortField ? [{ field: sortField, sort: sortOrder ?? 'asc' }] : [];\n\n  return (\n    <Box>\n      <TextField\n        value={searchInput}\n        onChange={(event) => setSearchInput(event.target.value)}\n        placeholder=\"Search…\"\n        size=\"small\"\n        sx={{ mb: 2, maxWidth: 320 }}\n        InputProps={{\n          startAdornment: (\n            <InputAdornment position=\"start\">\n              <SearchIcon fontSize=\"small\" />\n            </InputAdornment>\n          ),\n        }}\n        inputProps={{ 'aria-label': 'Search' }}\n      />\n      <DataGrid\n        autoHeight\n        columns={columns}\n        rows={rows}\n        rowCount={total}\n        loading={loading}\n        getRowId={getRowId}\n        paginationMode=\"server\"\n        sortingMode=\"server\"\n        paginationModel={{ page: page - 1, pageSize }}\n        onPaginationModelChange={(model) =>\n          updateParams({ page: String(model.page + 1), pageSize: String(model.pageSize) })\n        }\n        sortModel={sortModel}\n        onSortModelChange={(model) =>\n          updateParams({ sort: model[0]?.field, order: model[0]?.sort ?? undefined })\n        }\n        pageSizeOptions={[10, 20, 50, 100]}\n        slots={{\n          noRowsOverlay: () => <EmptyState title=\"No results\" description=\"Nothing matches yet.\" />,\n        }}\n        disableRowSelectionOnClick\n      />\n    </Box>\n  );\n}\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" alignItems=\"flex-start\" justifyContent=\"space-between\" spacing={2}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" fontWeight={600}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      alignItems=\"center\"\n      justifyContent=\"center\"\n      spacing={1.5}\n      sx={{ py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {\n  message: string;\n  severity?: AlertColor;\n}\n\nexport interface ToastContextValue {\n  showToast: (options: ToastOptions) => void;\n}\n\nexport const ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function useToast(): ToastContextValue {\n  const ctx = useContext(ToastContext);\n  if (!ctx) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return ctx;\n}\n{\n  \"root\": true,\n  \"extends\": [\"next/core-web-vitals\", \"plugin:@typescript-eslint/recommended\"],\n  \"parser\": \"@typescript-eslint/parser\",\n  \"rules\": {\n    \"@typescript-eslint/no-unused-vars\": [\n      \"error\",\n      { \"argsIgnorePattern\": \"^_\", \"varsIgnorePattern\": \"^_\", \"destructuredArrayIgnorePattern\": \"^_\" }\n    ],\n    \"no-restricted-imports\": [\n      \"error\",\n      {\n        \"paths\": [\n          { \"name\": \"tailwindcss\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"name\": \"lucide-react\", \"message\": \"Use @mui/icons-material instead.\" },\n          { \"name\": \"next-themes\", \"message\": \"Use MUI cssVariables colorSchemes + useColorScheme() instead.\" },\n          { \"name\": \"@tanstack/react-table\", \"message\": \"Use the shared DataTable (MUI X DataGrid) instead.\" },\n          { \"name\": \"recharts\", \"message\": \"Use @mui/x-charts instead.\" },\n          { \"name\": \"react-select\", \"message\": \"Use MUI Autocomplete instead.\" },\n          { \"name\": \"react-datepicker\", \"message\": \"Use @mui/x-date-pickers instead.\" },\n          { \"name\": \"sonner\", \"message\": \"Use the shared useToast()/ToastProvider instead.\" },\n          { \"name\": \"notistack\", \"message\": \"Use the shared useToast()/ToastProvider instead.\" },\n          { \"name\": \"antd\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"name\": \"react-bootstrap\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" }\n        ],\n        \"patterns\": [\n          { \"group\": [\"@radix-ui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"group\": [\"@headlessui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"group\": [\"@fullcalendar/*\"], \"message\": \"Use @mui/x-scheduler (later PRD) instead.\" },\n          { \"group\": [\"@chakra-ui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" }\n        ]\n      }\n    ]\n  },\n  \"overrides\": [\n    {\n      \"files\": [\"src/**/*.{ts,tsx}\"],\n      \"parserOptions\": { \"project\": \"./tsconfig.json\" },\n      \"rules\": {\n        \"@typescript-eslint/no-floating-promises\": \"error\"\n      }\n    },\n    {\n      \"files\": [\"src/server/email/templates/**\"],\n      \"rules\": {\n        \"no-restricted-imports\": \"off\"\n      }\n    }\n  ]\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_011nP87rD77qxyX58dDDaXTq","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
