{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014fVBDpHQF7BaGiH2XcEeL3","type":"tool_result","content":"1\timport { z } from 'zod';\n2\t\n3\t/**\n4\t * Fail-fast env validation. Runs once at module load (startup boundary) —\n5\t * anything importing this module gets a readable error naming every\n6\t * missing/invalid variable instead of an undefined-at-runtime surprise.\n7\t */\n8\tconst envSchema = z.object({\n9\t  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n10\t  APP_URL: z.string().min(1, 'APP_URL is required'),\n11\t  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n12\t  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n13\t\n14\t  // Email (PRD-04). EMAIL_TRANSPORT defaults to 'console' so dev/test never\n15\t  // need real SMTP creds; the smtp branch (src/server/email/transport.ts)\n16\t  // only reads SMTP_*/EMAIL_FROM when EMAIL_TRANSPORT='smtp'.\n17\t  EMAIL_TRANSPORT: z.enum(['smtp', 'console']).default('console'),\n18\t  SMTP_HOST: z.string().optional(),\n19\t  SMTP_PORT: z.coerce.number().int().optional(),\n20\t  SMTP_USER: z.string().optional(),\n21\t  SMTP_PASS: z.string().optional(),\n22\t  SMTP_SECURE: z.coerce.boolean().optional(),\n23\t  EMAIL_FROM: z.string().optional(),\n24\t  // Bearer token for POST /api/internal/email/dispatch (NFR-8). Optional so\n25\t  // existing .env files don't break; left unset, the route rejects every\n26\t  // request (fail-safe, not fail-open).\n27\t  CRON_SECRET: z.string().optional(),\n28\t});\n29\t\n30\tfunction loadEnv() {\n31\t  const parsed = envSchema.safeParse(process.env);\n32\t  if (!parsed.success) {\n33\t    const issues = parsed.error.issues\n34\t      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n35\t      .join('\\n');\n36\t    throw new Error(`Invalid environment variables:\\n${issues}`);\n37\t  }\n38\t  return parsed.data;\n39\t}\n40\t\n41\texport const env = loadEnv();\n42\texport type Env = z.infer<typeof envSchema>;\n43\t"}]},"parent_tool_use_id":null,"session_id":"49ee9d9e-3a83-47f8-b022-a5bdaa2f8cda","uuid":"875c6cf4-ef6c-459a-87b3-25329999fb84","timestamp":"2026-10-20T06:46:21.743Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/lib/env.ts","content":"import { z } from 'zod';\n\n/**\n * Fail-fast env validation. Runs once at module load (startup boundary) —\n * anything importing this module gets a readable error naming every\n * missing/invalid variable instead of an undefined-at-runtime surprise.\n */\nconst envSchema = z.object({\n  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n  APP_URL: z.string().min(1, 'APP_URL is required'),\n  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n\n  // Email (PRD-04). EMAIL_TRANSPORT defaults to 'console' so dev/test never\n  // need real SMTP creds; the smtp branch (src/server/email/transport.ts)\n  // only reads SMTP_*/EMAIL_FROM when EMAIL_TRANSPORT='smtp'.\n  EMAIL_TRANSPORT: z.enum(['smtp', 'console']).default('console'),\n  SMTP_HOST: z.string().optional(),\n  SMTP_PORT: z.coerce.number().int().optional(),\n  SMTP_USER: z.string().optional(),\n  SMTP_PASS: z.string().optional(),\n  SMTP_SECURE: z.coerce.boolean().optional(),\n  EMAIL_FROM: z.string().optional(),\n  // Bearer token for POST /api/internal/email/dispatch (NFR-8). Optional so\n  // existing .env files don't break; left unset, the route rejects every\n  // request (fail-safe, not fail-open).\n  CRON_SECRET: z.string().optional(),\n});\n\nfunction loadEnv() {\n  const parsed = envSchema.safeParse(process.env);\n  if (!parsed.success) {\n    const issues = parsed.error.issues\n      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n      .join('\\n');\n    throw new Error(`Invalid environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\nexport const env = loadEnv();\nexport type Env = z.infer<typeof envSchema>;\n","numLines":43,"startLine":1,"totalLines":43}}}
