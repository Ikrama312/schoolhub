{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cpjj3RNuzh3sbRrYGjzAYP","type":"tool_result","content":"1\timport { prisma } from '@/server/db';\n2\timport { AppError } from '@/server/http';\n3\timport type { GuardianRelationship, Prisma } from '@prisma/client';\n4\t\n5\tconst MAX_PARENTS_PER_STUDENT = 4;\n6\t\n7\texport interface LinkParentToStudentInput {\n8\t  studentId: string;\n9\t  parentId: string;\n10\t  relationship: GuardianRelationship;\n11\t  isPrimary: boolean;\n12\t}\n13\t\n14\ttype TxClient = Prisma.TransactionClient;\n15\t\n16\t/**\n17\t * The invariant logic (FR-15/FR-16), operating on a caller-supplied\n18\t * transaction client. Callers that already hold an open transaction (e.g.\n19\t * users.ts's createUser, which writes the User + profile + links\n20\t * atomically) call this directly with their own `tx`; standalone callers\n21\t * use `linkParentToStudent` below, which opens its own transaction.\n22\t * - a student may have at most 4 linked parents\n23\t * - at most one link per student is isPrimary (setting one clears the rest)\n24\t */\n25\texport async function linkParentToStudentTx(tx: TxClient, input: LinkParentToStudentInput) {\n26\t  const existingCount = await tx.parentStudentLink.count({ where: { studentId: input.studentId } });\n27\t  if (existingCount >= MAX_PARENTS_PER_STUDENT) {\n28\t    throw new AppError('VALIDATION_ERROR', `A student can have at most ${MAX_PARENTS_PER_STUDENT} linked parents.`);\n29\t  }\n30\t\n31\t  if (input.isPrimary) {\n32\t    await tx.parentStudentLink.updateMany({\n33\t      where: { studentId: input.studentId },\n34\t      data: { isPrimary: false },\n35\t    });\n36\t  }\n37\t\n38\t  return tx.parentStudentLink.create({\n39\t    data: {\n40\t      studentId: input.studentId,\n41\t      parentId: input.parentId,\n42\t      relationship: input.relationship,\n43\t      isPrimary: input.isPrimary,\n44\t    },\n45\t  });\n46\t}\n47\t\n48\t/** Standalone entry point (student form / parent form / Family card, FR-15). */\n49\texport async function linkParentToStudent(input: LinkParentToStudentInput) {\n50\t  return prisma.$transaction((tx) => linkParentToStudentTx(tx, input));\n51\t}\n52\t\n53\texport async function unlinkParentFromStudent(studentId: string, parentId: string) {\n54\t  return prisma.parentStudentLink.deleteMany({ where: { studentId, parentId } });\n55\t}\n56\t\n57\texport async function listLinksForStudent(studentId: string) {\n58\t  return prisma.parentStudentLink.findMany({\n59\t    where: { studentId },\n60\t    include: { parent: { select: { id: true, firstName: true, lastName: true } } },\n61\t  });\n62\t}\n63\t\n64\texport async function listLinksForParent(parentId: string) {\n65\t  return prisma.parentStudentLink.findMany({\n66\t    where: { parentId },\n67\t    include: { student: { select: { id: true, firstName: true, lastName: true } } },\n68\t  });\n69\t}\n70\t"}]},"parent_tool_use_id":null,"session_id":"bb2b8c62-3325-431e-93eb-03c63909bc5e","uuid":"03d396b1-f390-4cfb-afaf-fa3b76aa66cf","timestamp":"2026-10-19T09:47:25.319Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/services/userLinks.ts","content":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { GuardianRelationship, Prisma } from '@prisma/client';\n\nconst MAX_PARENTS_PER_STUDENT = 4;\n\nexport interface LinkParentToStudentInput {\n  studentId: string;\n  parentId: string;\n  relationship: GuardianRelationship;\n  isPrimary: boolean;\n}\n\ntype TxClient = Prisma.TransactionClient;\n\n/**\n * The invariant logic (FR-15/FR-16), operating on a caller-supplied\n * transaction client. Callers that already hold an open transaction (e.g.\n * users.ts's createUser, which writes the User + profile + links\n * atomically) call this directly with their own `tx`; standalone callers\n * use `linkParentToStudent` below, which opens its own transaction.\n * - a student may have at most 4 linked parents\n * - at most one link per student is isPrimary (setting one clears the rest)\n */\nexport async function linkParentToStudentTx(tx: TxClient, input: LinkParentToStudentInput) {\n  const existingCount = await tx.parentStudentLink.count({ where: { studentId: input.studentId } });\n  if (existingCount >= MAX_PARENTS_PER_STUDENT) {\n    throw new AppError('VALIDATION_ERROR', `A student can have at most ${MAX_PARENTS_PER_STUDENT} linked parents.`);\n  }\n\n  if (input.isPrimary) {\n    await tx.parentStudentLink.updateMany({\n      where: { studentId: input.studentId },\n      data: { isPrimary: false },\n    });\n  }\n\n  return tx.parentStudentLink.create({\n    data: {\n      studentId: input.studentId,\n      parentId: input.parentId,\n      relationship: input.relationship,\n      isPrimary: input.isPrimary,\n    },\n  });\n}\n\n/** Standalone entry point (student form / parent form / Family card, FR-15). */\nexport async function linkParentToStudent(input: LinkParentToStudentInput) {\n  return prisma.$transaction((tx) => linkParentToStudentTx(tx, input));\n}\n\nexport async function unlinkParentFromStudent(studentId: string, parentId: string) {\n  return prisma.parentStudentLink.deleteMany({ where: { studentId, parentId } });\n}\n\nexport async function listLinksForStudent(studentId: string) {\n  return prisma.parentStudentLink.findMany({\n    where: { studentId },\n    include: { parent: { select: { id: true, firstName: true, lastName: true } } },\n  });\n}\n\nexport async function listLinksForParent(parentId: string) {\n  return prisma.parentStudentLink.findMany({\n    where: { parentId },\n    include: { student: { select: { id: true, firstName: true, lastName: true } } },\n  });\n}\n","numLines":70,"startLine":1,"totalLines":70}}}
