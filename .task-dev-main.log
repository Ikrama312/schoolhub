{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgBQ73SpJYBcLjHVKWyqb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TwqAipzyqD9gVwWP7z3Mmp","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/api/users/import/route.ts","content":"import { z } from 'zod';\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { importUsers } from '@/server/services/userImport';\nimport { toCsv } from '@/server/csv';\n\nconst bodySchema = z.object({\n  type: z.enum(['STUDENTS', 'TEACHERS']),\n  rows: z.array(z.record(z.unknown())),\n  sendInvites: z.boolean().default(false),\n});\n\nconst ERROR_REPORT_COLUMNS = [\n  { key: 'rowIndex', header: 'Row' },\n  { key: 'result', header: 'Result' },\n  { key: 'reason', header: 'Reason' },\n];\n\n/**\n * POST /api/users/import — ADMIN only (FR-18, FR-20..FR-23, NFR-3). Thin\n * dispatch onto component 9's batch transaction (src/server/services/\n * userImport.ts); this route only adds the error-report CSV (component 10)\n * and the audit write.\n */\nexport const POST = withHandler(async (request: Request) => {\n  const actor = requireRole('ADMIN');\n  const input = await parseBody(request, bodySchema);\n\n  const summary = await importUsers(input.type, input.rows, input.sendInvites);\n\n  const failedRows = summary.rowResults.filter((row) => row.result === 'error');\n  const errorReportCsvUrl =\n    failedRows.length > 0\n      ? `data:text/csv;base64,${Buffer.from(toCsv(ERROR_REPORT_COLUMNS, failedRows)).toString('base64')}`\n      : null;\n\n  await audit({\n    actorId: actor.id,\n    action: 'user.imported',\n    entityType: 'User',\n    metadata: { type: input.type, ...summary, errorReportCsvUrl: undefined },\n  });\n\n  return ok({ ...summary, errorReportCsvUrl });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":672,"cache_read_input_tokens":133221,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":672},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e93ce62f-466e-4ebf-a57c-8fec1a196fdd","uuid":"044ec7e6-85fe-420b-baa7-9b8bcc4a78cd","timestamp":"2026-10-19T09:58:58.040Z","request_id":"req_011CgBQ72yJLSnKx6FdGGt8C"}
