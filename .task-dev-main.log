ing .env files don't break; left unset, the route rejects every\n  // request (fail-safe, not fail-open).\n  CRON_SECRET: z.string().optional(),\n});\n\nfunction loadEnv() {\n  const parsed = envSchema.safeParse(process.env);\n  if (!parsed.success) {\n    const issues = parsed.error.issues\n      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n      .join('\\n');\n    throw new Error(`Invalid environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\nexport const env = loadEnv();\nexport type Env = z.infer<typeof envSchema>;\n","structuredPatch":[{"oldStart":25,"oldLines":6,"newStart":25,"newLines":10,"lines":["   // existing .env files don't break; left unset, the route rejects every","   // request (fail-safe, not fail-open).","   CRON_SECRET: z.string().optional(),","+","+  // File storage (PRD-08 FR-2/FR-4). Local disk only, outside public/ (NFR-11).","+  UPLOAD_DIR: z.string().min(1).default('./uploads'),","+  MAX_UPLOAD_MB: z.coerce.number().int().positive().default(25),"," });"," "," function loadEnv() {"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01YWDW8EmK2zqE6ZhUCttCaF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
