{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01943cAbJjdZ7pBtCA1Zp9Sz","type":"tool_result","content":"140\t\n141\texport async function createSection(input: SectionInput, actorId?: string | null) {\n142\t  const section = await prisma.$transaction(async (tx) => {\n143\t    if (input.homeroomTeacherId) {\n144\t      await assertTeacher(tx, input.homeroomTeacherId);\n145\t      await assertHomeroomAvailable(tx, input.academicYearId, input.homeroomTeacherId);\n146\t    }\n147\t    return tx.section.create({\n148\t      data: {\n149\t        academicYearId: input.academicYearId,\n150\t        gradeLevelId: input.gradeLevelId,\n151\t        name: input.name,\n152\t        homeroomTeacherId: input.homeroomTeacherId ?? null,\n153\t        roomId: input.roomId ?? null,\n154\t        capacity: input.capacity,\n155\t      },\n156\t      include: sectionInclude,\n157\t    });\n158\t  });\n159\t  await audit({ actorId, action: 'section.create', entityType: 'Section', entityId: section.id });\n160\t  return toSection(section);\n161\t}\n162\t\n163\texport async function updateSection(id: string, input: SectionUpdateInput, actorId?: string | null) {\n164\t  const section = await prisma.$transaction(async (tx) => {\n165\t    const existing = await tx.section.findUnique({ where: { id }, include: { _count: { select: { members: true } } } });\n166\t    if (!existing) throw new AppError('NOT_FOUND', 'Section not found');\n167\t    if (input.homeroomTeacherId && input.homeroomTeacherId !== existing.homeroomTeacherId) {\n168\t      await assertTeacher(tx, input.homeroomTeacherId);\n169\t      await assertHomeroomAvailable(tx, existing.academicYearId, input.homeroomTeacherId, id);\n170\t    }\n171\t    if (input.capacity !== undefined && input.capacity < existing._count.members) {\n172\t      throw new AppError(\n173\t        'VALIDATION_ERROR',\n174\t        `Capacity cannot be lower than the current member count (${existing._count.members}).`,\n175\t      );\n176\t    }\n177\t    return tx.section.update({\n178\t      where: { id },\n179\t      data: {\n180\t        gradeLevelId: input.gradeLevelId,\n181\t        name: input.name,\n182\t        homeroomTeacherId: input.homeroomTeacherId,\n183\t        roomId: input.roomId,\n184\t        capacity: input.capacity,\n185\t      },\n186\t      include: sectionInclude,\n187\t    });\n188\t  });\n189\t  await audit({\n190\t    actorId,\n191\t    action: 'section.update',\n192\t    entityType: 'Section',\n193\t    entityId: id,\n194\t    metadata: { fields: Object.keys(input) },\n195\t  });\n196\t  return toSection(section);\n197\t}\n198\t\n199\texport async function deleteSection(id: string, actorId?: string | null) {\n200\t  await prisma.$transaction(async (tx) => {\n201\t    const section = await tx.section.findUnique({\n202\t      where: { id },\n203\t      include: { _count: { select: { members: true, courses: true } } },\n204\t    });\n205\t    if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n206\t    if (section._count.members > 0 || section._count.courses > 0) {\n207\t      throw new AppError('CONFLICT', `Section ${section.name} still has members or courses.`);\n208\t    }\n209\t    await tx.section.delete({ where: { id } });\n210\t  });\n211\t  await audit({ actorId, action: 'section.delete', entityType: 'Section', entityId: id });\n212\t  return { id };\n213\t}\n214\t\n215\t/** FR-4 picker: STUDENTs of the section's grade level with no section this year. */\n216\texport async function listEligibleStudents(sectionId: string) {\n217\t  const section = await prisma.section.findUnique({\n218\t    where: { id: sectionId },\n219\t    select: { gradeLevelId: true, academicYearId: true },\n220\t  });\n221\t  if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n222\t  const students = await prisma.user.findMany({\n223\t    where: {\n224\t      role: 'STUDENT',\n225\t      archivedAt: null,\n226\t      studentProfile: { gradeLevelId: section.gradeLevelId },\n227\t      sectionMemberships: { none: { academicYearId: section.academicYearId } },\n228\t    },\n229\t    select: { ...personSelect, email: true, studentProfile: { select: { admissionNumber: true } } },\n230\t    orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }],\n231\t  });\n232\t  return students.map((s) => ({\n233\t    id: s.id,\n234\t    name: personName(s),\n235\t    email: s.email,\n236\t    admissionNumber: s.studentProfile?.admissionNumber ?? null,\n237\t  }));\n238\t}\n239\t\n240\tasync function loadSectionWithYear(tx: Tx, sectionId: string) {\n241\t  const section = await tx.section.findUnique({\n242\t    where: { id: sectionId },\n243\t    include: { academicYear: { select: { name: true } } },\n244\t  });\n245\t  if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n246\t  return section;\n247\t}\n248\t\n249\tasync function alreadyInSectionError(tx: Tx, studentIds: string[], academicYearId: string, yearName: string) {\n250\t  const clash = await tx.sectionMember.findFirst({\n251\t    where: { studentId: { in: studentIds }, academicYearId },\n252\t    include: { student: { select: personSelect }, section: { select: { name: true } } },\n253\t  });\n254\t  if (!clash) return null;\n255\t  return new AppError(\n256\t    'CONFLICT',\n257\t    `${personName(clash.student)} is already in section ${clash.section.name} for ${yearName}.`,\n258\t  );\n259\t}\n260\t\n261\texport async function addMembers(sectionId: string, input: EnrollStudentsInput, actorId?: string | null) {\n262\t  const studentIds = [...new Set(input.studentIds)];\n263\t  const result = await prisma.$transaction(async (tx) => {\n264\t    const section = await loadSectionWithYear(tx, sectionId);\n265\t\n266\t    const students = await tx.user.findMany({\n267\t      where: { id: { in: studentIds }, role: 'STUDENT' },\n268\t      select: { id: true, studentProfile: { select: { gradeLevelId: true } } },\n269\t    });\n270\t    if (students.length !== studentIds.length) {\n271\t      throw new AppError('VALIDATION_ERROR', 'Every selected user must be a student.');\n272\t    }\n273\t    if (students.some((s) => s.studentProfile?.gradeLevelId !== section.gradeLevelId)) {\n274\t      throw new AppError('VALIDATION_ERROR', \"Every student must be in the section's grade level.\");\n275\t    }\n276\t\n277\t    const clash = await alreadyInSectionError(tx, studentIds, section.academicYearId, section.academicYear.name);\n278\t    if (clash) throw clash;\n279\t\n280\t    await checkCapacityOrThrow(tx, { sectionId, addingCount: studentIds.length, overrideCapacity: input.overrideCapacity });\n281\t\n282\t    try {\n283\t      await tx.sectionMember.createMany({\n284\t        data: studentIds.map((studentId) => ({ sectionId, studentId, academicYearId: section.academicYearId })),\n285\t      });\n286\t    } catch (error) {\n287\t      // NFR-2: the DB unique constraint is the real guard if a concurrent add won the race.\n288\t      if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') {\n289\t        throw new AppError('CONFLICT', `A selected student is already in a section for ${section.academicYear.name}.`);\n290\t      }\n291\t      throw error;\n292\t    }\n293\t\n294\t    const enrollments = await enrollSectionCoreCourses(tx, sectionId, studentIds, {\n295\t      overrideCapacity: input.overrideCapacity,\n296\t      actorId,\n297\t    });\n298\t    return { added: studentIds.length, enrollments };\n299\t  });\n300\t  await audit({\n301\t    actorId,\n302\t    action: 'section.member.add',\n303\t    entityType: 'Section',\n304\t    entityId: sectionId,\n305\t    metadata: { studentIds },\n306\t  });\n307\t  return result;\n308\t}\n309\t\n310\texport async function removeMember(sectionId: string, studentId: string, actorId?: string | null) {\n311\t  const droppedEnrollments = await prisma.$transaction(async (tx) => {\n312\t    const { count } = await tx.sectionMember.deleteMany({ where: { sectionId, studentId } });\n313\t    if (count === 0) throw new AppError('NOT_FOUND', 'Student is not a member of this section');\n314\t    return dropSectionCoreCourses(tx, sectionId, [studentId], { actorId });\n315\t  });\n316\t  await audit({\n317\t    actorId,\n318\t    action: 'section.member.remove',\n319\t    entityType: 'Section',\n320\t    entityId: sectionId,\n321\t    metadata: { studentId },\n322\t  });\n323\t  return { removed: true as const, droppedEnrollments };\n324\t}\n325\t\n326\t/** FR-9: one transaction — membership switch + drop source CORE + enroll destination CORE. */\n327\texport async function moveStudent(studentId: string, input: MoveSectionInput, actorId?: string | null) {\n328\t  const result = await prisma.$transaction(async (tx) => {\n329\t    const to = await loadSectionWithYear(tx, input.toSectionId);\n330\t    const membership = await tx.sectionMember.findUnique({\n331\t      where: { studentId_academicYearId: { studentId, academicYearId: to.academicYearId } },\n332\t    });\n333\t    if (!membership) {\n334\t      throw new AppError('NOT_FOUND', `Student has no section in ${to.academicYear.name}.`);\n335\t    }\n336\t    if (membership.sectionId === to.id) {\n337\t      throw new AppError('VALIDATION_ERROR', `Student is already in section ${to.name}.`);\n338\t    }\n339\t    await checkCapacityOrThrow(tx, { sectionId: to.id, addingCount: 1, overrideCapacity: input.overrideCapacity });\n340\t\n341\t    await tx.sectionMember.update({ where: { id: membership.id }, data: { sectionId: to.id, joinedAt: new Date() } });\n342\t    const moved = await moveStudentSection(tx, studentId, membership.sectionId, to.id, {\n343\t      overrideCapacity: input.overrideCapacity,\n344\t      actorId,\n345\t    });\n346\t    return { fromSectionId: membership.sectionId, toSectionId: to.id, ...moved };\n347\t  });\n348\t  await audit({\n349\t    actorId,\n350\t    action: 'section.member.move',\n351\t    entityType: 'User',\n352\t    entityId: studentId,\n353\t    metadata: { fromSectionId: result.fromSectionId, toSectionId: result.toSectionId },\n354\t  });\n355\t  return result as { fromSectionId: string; toSectionId: string; dropped: number; enrollments: EnrollResult };\n356\t}\n357\t\n358\t/** A future (starts after today), non-current year that sections can be copied into. */\n359\texport function isCopyTargetYear(year: { isCurrent: boolean; startDate: Date }, now = new Date()): boolean {\n360\t  return !year.isCurrent && year.startDate > now;\n361\t}\n362\t\n363\t/** FR-6 / NFR-6: structural copy only — no members, teachers or courses. */\n364\texport async function copySectionsToYear(input: CopyToYearInput, actorId?: string | null) {\n365\t  const [fromYear, toYear] = await Promise.all([\n366\t    prisma.academicYear.findUnique({ where: { id: input.fromYearId } }),\n367\t    prisma.academicYear.findUnique({ where: { id: input.toYearId } }),\n368\t  ]);\n369\t  if (!fromYear || !toYear) throw new AppError('NOT_FOUND', 'Academic year not found');\n370\t  if (!isCopyTargetYear(toYear)) {\n371\t    throw new AppError('VALIDATION_ERROR', 'Sections can only be copied into a future, non-current academic year.');\n372\t  }\n373\t\n374\t  const [sections, gradeLevels, existing] = await Promise.all([\n375\t    prisma.section.findMany({ where: { academicYearId: fromYear.id }, include: { gradeLevel: true } }),\n376\t    prisma.gradeLevel.findMany({ where: { archivedAt: null }, orderBy: { order: 'asc' } }),\n377\t    prisma.section.findMany({ where: { academicYearId: toYear.id }, select: { name: true } }),\n378\t  ]);\n379\t  const takenNames = new Set(existing.map((s) => s.name));\n380\t\n381\t  const skipped: { name: string; reason: string }[] = [];\n382\t  const data: Prisma.SectionCreateManyInput[] = [];\n383\t  for (const section of sections) {\n384\t    const next = gradeLevels.find((g) => g.order > section.gradeLevel.order);\n385\t    if (!next) {\n386\t      skipped.push({ name: section.name, reason: 'no next grade level' });\n387\t    } else if (takenNames.has(section.name)) {\n388\t      skipped.push({ name: section.name, reason: 'name already exists in target year' });\n389\t    } else {\n390\t      takenNames.add(section.name);\n391\t      data.push({\n392\t        academicYearId: toYear.id,\n393\t        gradeLevelId: next.id,\n394\t        name: section.name,\n395\t        roomId: section.roomId,\n396\t        capacity: section.capacity,\n397\t      });\n398\t    }\n399\t  }\n400\t\n401\t  const { count } = data.length ? await prisma.section.createMany({ data }) : { count: 0 };\n402\t  if (count > 0) {\n403\t    await audit({\n404\t      actorId,\n405\t      action: 'section.create',\n406\t      entityType: 'Section',\n407\t      metadata: { copiedFrom: fromYear.id, toYearId: toYear.id, names: data.map((d) => d.name) },\n408\t    });\n409\t  }\n410\t  return { created: count, skipped };\n411\t}\n412\t"}]},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"64040a1f-b164-4327-bff0-6d2d54c063e1","timestamp":"2026-10-27T16:49:46.537Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/sections/sections-service.ts","content":"\nexport async function createSection(input: SectionInput, actorId?: string | null) {\n  const section = await prisma.$transaction(async (tx) => {\n    if (input.homeroomTeacherId) {\n      await assertTeacher(tx, input.homeroomTeacherId);\n      await assertHomeroomAvailable(tx, input.academicYearId, input.homeroomTeacherId);\n    }\n    return tx.section.create({\n      data: {\n        academicYearId: input.academicYearId,\n        gradeLevelId: input.gradeLevelId,\n        name: input.name,\n        homeroomTeacherId: input.homeroomTeacherId ?? null,\n        roomId: input.roomId ?? null,\n        capacity: input.capacity,\n      },\n      include: sectionInclude,\n    });\n  });\n  await audit({ actorId, action: 'section.create', entityType: 'Section', entityId: section.id });\n  return toSection(section);\n}\n\nexport async function updateSection(id: string, input: SectionUpdateInput, actorId?: string | null) {\n  const section = await prisma.$transaction(async (tx) => {\n    const existing = await tx.section.findUnique({ where: { id }, include: { _count: { select: { members: true } } } });\n    if (!existing) throw new AppError('NOT_FOUND', 'Section not found');\n    if (input.homeroomTeacherId && input.homeroomTeacherId !== existing.homeroomTeacherId) {\n      await assertTeacher(tx, input.homeroomTeacherId);\n      await assertHomeroomAvailable(tx, existing.academicYearId, input.homeroomTeacherId, id);\n    }\n    if (input.capacity !== undefined && input.capacity < existing._count.members) {\n      throw new AppError(\n        'VALIDATION_ERROR',\n        `Capacity cannot be lower than the current member count (${existing._count.members}).`,\n      );\n    }\n    return tx.section.update({\n      where: { id },\n      data: {\n        gradeLevelId: input.gradeLevelId,\n        name: input.name,\n        homeroomTeacherId: input.homeroomTeacherId,\n        roomId: input.roomId,\n        capacity: input.capacity,\n      },\n      include: sectionInclude,\n    });\n  });\n  await audit({\n    actorId,\n    action: 'section.update',\n    entityType: 'Section',\n    entityId: id,\n    metadata: { fields: Object.keys(input) },\n  });\n  return toSection(section);\n}\n\nexport async function deleteSection(id: string, actorId?: string | null) {\n  await prisma.$transaction(async (tx) => {\n    const section = await tx.section.findUnique({\n      where: { id },\n      include: { _count: { select: { members: true, courses: true } } },\n    });\n    if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n    if (section._count.members > 0 || section._count.courses > 0) {\n      throw new AppError('CONFLICT', `Section ${section.name} still has members or courses.`);\n    }\n    await tx.section.delete({ where: { id } });\n  });\n  await audit({ actorId, action: 'section.delete', entityType: 'Section', entityId: id });\n  return { id };\n}\n\n/** FR-4 picker: STUDENTs of the section's grade level with no section this year. */\nexport async function listEligibleStudents(sectionId: string) {\n  const section = await prisma.section.findUnique({\n    where: { id: sectionId },\n    select: { gradeLevelId: true, academicYearId: true },\n  });\n  if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n  const students = await prisma.user.findMany({\n    where: {\n      role: 'STUDENT',\n      archivedAt: null,\n      studentProfile: { gradeLevelId: section.gradeLevelId },\n      sectionMemberships: { none: { academicYearId: section.academicYearId } },\n    },\n    select: { ...personSelect, email: true, studentProfile: { select: { admissionNumber: true } } },\n    orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }],\n  });\n  return students.map((s) => ({\n    id: s.id,\n    name: personName(s),\n    email: s.email,\n    admissionNumber: s.studentProfile?.admissionNumber ?? null,\n  }));\n}\n\nasync function loadSectionWithYear(tx: Tx, sectionId: string) {\n  const section = await tx.section.findUnique({\n    where: { id: sectionId },\n    include: { academicYear: { select: { name: true } } },\n  });\n  if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n  return section;\n}\n\nasync function alreadyInSectionError(tx: Tx, studentIds: string[], academicYearId: string, yearName: string) {\n  const clash = await tx.sectionMember.findFirst({\n    where: { studentId: { in: studentIds }, academicYearId },\n    include: { student: { select: personSelect }, section: { select: { name: true } } },\n  });\n  if (!clash) return null;\n  return new AppError(\n    'CONFLICT',\n    `${personName(clash.student)} is already in section ${clash.section.name} for ${yearName}.`,\n  );\n}\n\nexport async function addMembers(sectionId: string, input: EnrollStudentsInput, actorId?: string | null) {\n  const studentIds = [...new Set(input.studentIds)];\n  const result = await prisma.$transaction(async (tx) => {\n    const section = await loadSectionWithYear(tx, sectionId);\n\n    const students = await tx.user.findMany({\n      where: { id: { in: studentIds }, role: 'STUDENT' },\n      select: { id: true, studentProfile: { select: { gradeLevelId: true } } },\n    });\n    if (students.length !== studentIds.length) {\n      throw new AppError('VALIDATION_ERROR', 'Every selected user must be a student.');\n    }\n    if (students.some((s) => s.studentProfile?.gradeLevelId !== section.gradeLevelId)) {\n      throw new AppError('VALIDATION_ERROR', \"Every student must be in the section's grade level.\");\n    }\n\n    const clash = await alreadyInSectionError(tx, studentIds, section.academicYearId, section.academicYear.name);\n    if (clash) throw clash;\n\n    await checkCapacityOrThrow(tx, { sectionId, addingCount: studentIds.length, overrideCapacity: input.overrideCapacity });\n\n    try {\n      await tx.sectionMember.createMany({\n        data: studentIds.map((studentId) => ({ sectionId, studentId, academicYearId: section.academicYearId })),\n      });\n    } catch (error) {\n      // NFR-2: the DB unique constraint is the real guard if a concurrent add won the race.\n      if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') {\n        throw new AppError('CONFLICT', `A selected student is already in a section for ${section.academicYear.name}.`);\n      }\n      throw error;\n    }\n\n    const enrollments = await enrollSectionCoreCourses(tx, sectionId, studentIds, {\n      overrideCapacity: input.overrideCapacity,\n      actorId,\n    });\n    return { added: studentIds.length, enrollments };\n  });\n  await audit({\n    actorId,\n    action: 'section.member.add',\n    entityType: 'Section',\n    entityId: sectionId,\n    metadata: { studentIds },\n  });\n  return result;\n}\n\nexport async function removeMember(sectionId: string, studentId: string, actorId?: string | null) {\n  const droppedEnrollments = await prisma.$transaction(async (tx) => {\n    const { count } = await tx.sectionMember.deleteMany({ where: { sectionId, studentId } });\n    if (count === 0) throw new AppError('NOT_FOUND', 'Student is not a member of this section');\n    return dropSectionCoreCourses(tx, sectionId, [studentId], { actorId });\n  });\n  await audit({\n    actorId,\n    action: 'section.member.remove',\n    entityType: 'Section',\n    entityId: sectionId,\n    metadata: { studentId },\n  });\n  return { removed: true as const, droppedEnrollments };\n}\n\n/** FR-9: one transaction — membership switch + drop source CORE + enroll destination CORE. */\nexport async function moveStudent(studentId: string, input: MoveSectionInput, actorId?: string | null) {\n  const result = await prisma.$transaction(async (tx) => {\n    const to = await loadSectionWithYear(tx, input.toSectionId);\n    const membership = await tx.sectionMember.findUnique({\n      where: { studentId_academicYearId: { studentId, academicYearId: to.academicYearId } },\n    });\n    if (!membership) {\n      throw new AppError('NOT_FOUND', `Student has no section in ${to.academicYear.name}.`);\n    }\n    if (membership.sectionId === to.id) {\n      throw new AppError('VALIDATION_ERROR', `Student is already in section ${to.name}.`);\n    }\n    await checkCapacityOrThrow(tx, { sectionId: to.id, addingCount: 1, overrideCapacity: input.overrideCapacity });\n\n    await tx.sectionMember.update({ where: { id: membership.id }, data: { sectionId: to.id, joinedAt: new Date() } });\n    const moved = await moveStudentSection(tx, studentId, membership.sectionId, to.id, {\n      overrideCapacity: input.overrideCapacity,\n      actorId,\n    });\n    return { fromSectionId: membership.sectionId, toSectionId: to.id, ...moved };\n  });\n  await audit({\n    actorId,\n    action: 'section.member.move',\n    entityType: 'User',\n    entityId: studentId,\n    metadata: { fromSectionId: result.fromSectionId, toSectionId: result.toSectionId },\n  });\n  return result as { fromSectionId: string; toSectionId: string; dropped: number; enrollments: EnrollResult };\n}\n\n/** A future (starts after today), non-current year that sections can be copied into. */\nexport function isCopyTargetYear(year: { isCurrent: boolean; startDate: Date }, now = new Date()): boolean {\n  return !year.isCurrent && year.startDate > now;\n}\n\n/** FR-6 / NFR-6: structural copy only — no members, teachers or courses. */\nexport async function copySectionsToYear(input: CopyToYearInput, actorId?: string | null) {\n  const [fromYear, toYear] = await Promise.all([\n    prisma.academicYear.findUnique({ where: { id: input.fromYearId } }),\n    prisma.academicYear.findUnique({ where: { id: input.toYearId } }),\n  ]);\n  if (!fromYear || !toYear) throw new AppError('NOT_FOUND', 'Academic year not found');\n  if (!isCopyTargetYear(toYear)) {\n    throw new AppError('VALIDATION_ERROR', 'Sections can only be copied into a future, non-current academic year.');\n  }\n\n  const [sections, gradeLevels, existing] = await Promise.all([\n    prisma.section.findMany({ where: { academicYearId: fromYear.id }, include: { gradeLevel: true } }),\n    prisma.gradeLevel.findMany({ where: { archivedAt: null }, orderBy: { order: 'asc' } }),\n    prisma.section.findMany({ where: { academicYearId: toYear.id }, select: { name: true } }),\n  ]);\n  const takenNames = new Set(existing.map((s) => s.name));\n\n  const skipped: { name: string; reason: string }[] = [];\n  const data: Prisma.SectionCreateManyInput[] = [];\n  for (const section of sections) {\n    const next = gradeLevels.find((g) => g.order > section.gradeLevel.order);\n    if (!next) {\n      skipped.push({ name: section.name, reason: 'no next grade level' });\n    } else if (takenNames.has(section.name)) {\n      skipped.push({ name: section.name, reason: 'name already exists in target year' });\n    } else {\n      takenNames.add(section.name);\n      data.push({\n        academicYearId: toYear.id,\n        gradeLevelId: next.id,\n        name: section.name,\n        roomId: section.roomId,\n        capacity: section.capacity,\n      });\n    }\n  }\n\n  const { count } = data.length ? await prisma.section.createMany({ data }) : { count: 0 };\n  if (count > 0) {\n    await audit({\n      actorId,\n      action: 'section.create',\n      entityType: 'Section',\n      metadata: { copiedFrom: fromYear.id, toYearId: toYear.id, names: data.map((d) => d.name) },\n    });\n  }\n  return { created: count, skipped };\n}\n","numLines":273,"startLine":140,"totalLines":412}},"tool_result_meta":[{"id":"toolu_01943cAbJjdZ7pBtCA1Zp9Sz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
