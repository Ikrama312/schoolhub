{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgi5sFPYrS6vV1tftAe5P","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PiCD87fzcbFsGihGYL2g3v","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/email/dispatch.ts","content":"import { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { nextRetry } from './backoff';\nimport { sendMail } from './transport';\n\nconst STUCK_AFTER_MS = 10 * 60_000;\n\ninterface ClaimedRow {\n  id: string;\n  toEmail: string;\n  toName: string | null;\n  subject: string;\n  html: string;\n  text: string;\n  attempts: number;\n}\n\n/**\n * FR-17/18, NFR-4/5. Recovers stuck SENDING rows, claims a batch in one\n * autocommit statement (FOR UPDATE SKIP LOCKED, so concurrent dispatchers\n * never share a row and no lock is held during SMTP), then sends sequentially.\n */\nexport async function dispatchEmails({ batchSize = 50 }: { batchSize?: number } = {}): Promise<{\n  sent: number;\n  failed: number;\n  retried: number;\n}> {\n  // NFR-5: a crash mid-send leaves SENDING; attempts unchanged (not proven to be a send failure).\n  await prisma.emailOutbox.updateMany({\n    where: { status: 'SENDING', updatedAt: { lt: new Date(Date.now() - STUCK_AFTER_MS) } },\n    data: { status: 'PENDING' },\n  });\n\n  // Columns are timestamp(3) without tz holding UTC, hence AT TIME ZONE 'UTC'.\n  const claimed = await prisma.$queryRaw<ClaimedRow[]>`\n    UPDATE \"EmailOutbox\"\n    SET \"status\" = 'SENDING'::\"EmailStatus\", \"updatedAt\" = (now() AT TIME ZONE 'UTC')\n    WHERE \"id\" IN (\n      SELECT \"id\" FROM \"EmailOutbox\"\n      WHERE \"status\" = 'PENDING'::\"EmailStatus\" AND \"nextAttemptAt\" <= (now() AT TIME ZONE 'UTC')\n      ORDER BY \"nextAttemptAt\"\n      LIMIT ${batchSize}\n      FOR UPDATE SKIP LOCKED\n    )\n    RETURNING \"id\", \"toEmail\", \"toName\", \"subject\", \"html\", \"text\", \"attempts\"`;\n\n  const result = { sent: 0, failed: 0, retried: 0 };\n  for (const row of claimed) {\n    try {\n      await sendMail({ to: row.toEmail, toName: row.toName, subject: row.subject, html: row.html, text: row.text });\n      await prisma.emailOutbox.update({ where: { id: row.id }, data: { status: 'SENT', sentAt: new Date() } });\n      result.sent++;\n    } catch (error) {\n      const attempts = row.attempts + 1;\n      const decision = nextRetry(attempts);\n      const lastError = (error instanceof Error ? error.message : String(error)).slice(0, 1000);\n      await prisma.emailOutbox.update({ where: { id: row.id }, data: { attempts, lastError, ...decision } });\n      if (decision.status === 'FAILED') {\n        result.failed++;\n        logger.warn('Email permanently failed', { id: row.id, attempts });\n      } else {\n        result.retried++;\n      }\n    }\n  }\n  return result;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":416,"cache_read_input_tokens":114949,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":416},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1921163e-32be-4c5c-99f3-b230ef406493","uuid":"f446ac65-2c6d-46fe-adb5-0790ed47dde9","timestamp":"2026-11-04T14:58:20.022Z","request_id":"req_011Cgi5sF7Aqr51uUe77ghth","wire_tool_inputs":{"toolu_01PiCD87fzcbFsGihGYL2g3v":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/email/dispatch.ts","content":"import { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { nextRetry } from './backoff';\nimport { sendMail } from './transport';\n\nconst STUCK_AFTER_MS = 10 * 60_000;\n\ninterface ClaimedRow {\n  id: string;\n  toEmail: string;\n  toName: string | null;\n  subject: