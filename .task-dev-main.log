m '@mui/material/MenuItem';\nimport Divider from '@mui/material/Divider';\nimport Chip from '@mui/material/Chip';\nimport Badge from '@mui/material/Badge';\nimport useMediaQuery from '@mui/material/useMediaQuery';\nimport { useTheme, useColorScheme } from '@mui/material/styles';\nimport Link from 'next/link';\nimport { usePathname } from 'next/navigation';\nimport MenuIcon from '@mui/icons-material/Menu';\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\nimport ChevronRightIcon from '@mui/icons-material/ChevronRight';\nimport LightModeIcon from '@mui/icons-material/LightMode';\nimport DarkModeIcon from '@mui/icons-material/DarkMode';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport PersonOutlineIcon from '@mui/icons-material/PersonOutline';\nimport LogoutIcon from '@mui/icons-material/Logout';\nimport { navigationForRole, type Role } from '@/config/navigation';\nimport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\n\nconst DRAWER_WIDTH_EXPANDED = 256;\nconst DRAWER_WIDTH_COLLAPSED = 64;\nconst COLLAPSE_STORAGE_KEY = 'schoolhub.sidebar.collapsed';\n\n// Placeholder user until PRD-01 wires real auth (FR-33's \"for later wiring\" note).\nconst PLACEHOLDER_USER: { id: string; name: string; role: Role } = {\n  id: 'placeholder-user',\n  name: 'Guest User',\n  role: 'ADMIN',\n};\n\nexport interface AppShellProps {\n  schoolShortName: string;\n  children: React.ReactNode;\n}\n\nexport function AppShell({ schoolShortName, children }: AppShellProps) {\n  const theme = useTheme();\n  const { mode, setMode } = useColorScheme();\n  const pathname = usePathname();\n  const isDesktop = useMediaQuery(theme.breakpoints.up('lg'));\n\n  const [collapsed, setCollapsed] = useState(false);\n  const [mobileOpen, setMobileOpen] = useState(false);\n  const [menuAnchor, setMenuAnchor] = useState<HTMLElement | null>(null);\n\n  useEffect(() => {\n    const stored = window.localStorage.getItem(COLLAPSE_STORAGE_KEY);\n    if (stored