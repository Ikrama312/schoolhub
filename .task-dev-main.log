{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015mhBhQ7FdYfURfAQ4gW6oR","type":"tool_result","content":"1\timport { Prisma } from '@prisma/client';\n2\timport { prisma } from '@/server/db';\n3\timport { AppError } from '@/server/http';\n4\timport { audit } from '@/server/audit';\n5\timport { getCurrentAcademicYear } from '@/server/services/academicYears';\n6\timport { listLinksForParent } from '@/server/services/userLinks';\n7\timport type { AccessUser } from '@/server/auth/student-access';\n8\timport type { Role } from '@/config/navigation';\n9\timport { personName } from '@/server/sections/sections-service';\n10\timport {\n11\t  checkCapacityOrThrow,\n12\t  enrollStudentsInCourses,\n13\t  type EnrollResult,\n14\t  type Tx,\n15\t} from '@/server/enrollment/roster-engine';\n16\timport { defaultCourseCode, defaultCourseName } from '@/lib/validators/courses';\n17\timport type {\n18\t  CourseInput,\n19\t  CoursesListQuery,\n20\t  CourseUpdateInput,\n21\t  EnrollmentStatusInput,\n22\t  RosterQuery,\n23\t} from '@/lib/validators/courses';\n24\timport type { CoreCoursesInput, EnrollStudentsInput } from '@/lib/validators/sections';\n25\t\n26\t/** Courses CRUD, rosters and enrollment (PRD-05 FR-5, FR-10..FR-21, FR-24, NFR-4). */\n27\t\n28\tconst personSelect = { id: true, firstName: true, lastName: true } as const;\n29\tconst person = (u: { id: string; firstName: string; lastName: string }) => ({ id: u.id, name: personName(u) });\n30\t\n31\tconst courseInclude = {\n32\t  subject: { select: { id: true, name: true, code: true, color: true } },\n33\t  section: { select: { id: true, name: true, room: { select: { id: true, name: true } } } },\n34\t  teacher: { select: personSelect },\n35\t  _count: { select: { enrollments: { where: { status: 'ACTIVE' } } } },\n36\t} satisfies Prisma.CourseInclude;\n37\t\n38\ttype CourseRow = Prisma.CourseGetPayload<{ include: typeof courseInclude }>;\n39\t\n40\t/** coTeacherIds is a plain String[] (FR-1), so names come from one batched lookup. */\n41\tasync function toCourses(rows: CourseRow[]) {\n42\t  const ids = [...new Set(rows.flatMap((r) => r.coTeacherIds))];\n43\t  const users = ids.length ? await prisma.user.findMany({ where: { id: { in: ids } }, select: personSelect }) : [];\n44\t  const byId = new Map(users.map((u) => [u.id, person(u)]));\n45\t  return rows.map(({ _count, teacher, ...rest }) => ({\n46\t    ...rest,\n47\t    teacher: person(teacher),\n48\t    coTeachers: rest.coTeacherIds.map((id) => byId.get(id)).filter((u): u is { id: string; name: string } => !!u),\n49\t    enrolledCount: _count.enrollments,\n50\t  }));\n51\t}\n52\texport type CourseDto = Awaited<ReturnType<typeof toCourses>>[number];\n53\t\n54\tconst teachesWhere = (userId: string): Prisma.CourseWhereInput => ({\n55\t  OR: [{ teacherId: userId }, { coTeacherIds: { has: userId } }],\n56\t});\n57\t\n58\tfunction codeConflict(error: unknown, code?: string): never {\n59\t  if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') {\n60\t    throw new AppError('CONFLICT', code ? `Course code ${code} already exists this year.` : 'A course code already exists this year.');\n61\t  }\n62\t  throw error;\n63\t}\n64\t\n65\tasync function assertTeachers(tx: Tx, ids: string[]) {\n66\t  const unique = [...new Set(ids)];\n67\t  if (unique.length === 0) return;\n68\t  const count = await tx.user.count({ where: { id: { in: unique }, role: 'TEACHER' } });\n69\t  if (count !== unique.length) throw new AppError('VALIDATION_ERROR', 'Teachers and co-teachers must be teachers.');\n70\t}\n71\t\n72\tasync function assertStudents(tx: Tx, ids: string[]) {\n73\t  const count = await tx.user.count({ where: { id: { in: ids }, role: 'STUDENT' } });\n74\t  if (count !== ids.length) throw new AppError('VALIDATION_ERROR', 'Every selected user must be a student.');\n75\t}\n76\t\n77\tasync function resolveYearId(academicYearId?: string) {\n78\t  if (academicYearId) return academicYearId;\n79\t  return (await getCurrentAcademicYear())?.id ?? null;\n80\t}\n81\t\n82\t// ---------------------------------------------------------------------------\n83\t// Reads\n84\t// ---------------------------------------------------------------------------\n85\t\n86\t/** FR-13 list, scoped per role here rather than by client filter. */\n87\texport async function listCourses(\n88\t  user: AccessUser,\n89\t  query: Partial<CoursesListQuery>,\n90\t  page: { skip: number; take: number },\n91\t) {\n92\t  const academicYearId = await resolveYearId(query.academicYearId);\n93\t  if (!academicYearId) return { rows: [] as CourseDto[], total: 0 };\n94\t\n95\t  const and: Prisma.CourseWhereInput[] = [{ academicYearId }];\n96\t  if (query.gradeLevelId) and.push({ section: { gradeLevelId: query.gradeLevelId } });\n97\t  if (query.subjectId) and.push({ subjectId: query.subjectId });\n98\t  if (query.teacherId) and.push(teachesWhere(query.teacherId));\n99\t  if (query.kind) and.push({ kind: query.kind });\n100\t  if (query.sectionId) and.push({ sectionId: query.sectionId });\n101\t  if (!(query.includeArchived && user.role === 'ADMIN')) and.push({ archivedAt: null });\n102\t  if (query.q) {\n103\t    and.push({\n104\t      OR: [{ name: { contains: query.q, mode: 'insensitive' } }, { code: { contains: query.q, mode: 'insensitive' } }],\n105\t    });\n106\t  }\n107\t  if (user.role === 'TEACHER') and.push(teachesWhere(user.id));\n108\t  if (user.role === 'STUDENT') and.push({ enrollments: { some: { studentId: user.id, status: 'ACTIVE' } } });\n109\t  if (user.role === 'PARENT') {\n110\t    and.push({ enrollments: { some: { status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } } } });\n111\t  }\n112\t\n113\t  const order = query.order ?? 'asc';\n114\t  // ponytail: enrolledCount sort counts all enrollment rows (Prisma can't order by a filtered _count); fine while DROPPED rows are rare.\n115\t  const orderBy: Prisma.CourseOrderByWithRelationInput =\n116\t    query.sort === 'name' ? { name: order } : query.sort === 'enrolledCount' ? { enrollments: { _count: order } } : { code: order };\n117\t\n118\t  const where: Prisma.CourseWhereInput = { AND: and };\n119\t  const [rows, total] = await Promise.all([\n120\t    prisma.course.findMany({ where, include: courseInclude, orderBy, skip: page.skip, take: page.take }),\n121\t    prisma.course.count({ where }),\n122\t  ]);\n123\t  return { rows: await toCourses(rows), total };\n124\t}\n125\t\n126\texport async function getCourse(id: string) {\n127\t  const row = await prisma.course.findUnique({ where: { id }, include: courseInclude });\n128\t  if (!row) throw new AppError('NOT_FOUND', 'Course not found');\n129\t  const [course] = await toCourses([row]);\n130\t  return course;\n131\t}\n132\t\n133\texport interface RosterEntry {\n134\t  enrollmentId: string;\n135\t  status: 'ACTIVE' | 'DROPPED';\n136\t  enrolledAt: Date;\n137\t  droppedAt: Date | null;\n138\t  student: { id: string; name: string; avatarUrl: string | null; admissionNumber: string | null; profileUrl: string };\n139\t}\n140\t\n141\t/**\n142\t * NFR-4: the single roster implementation behind the Roster tab and\n143\t * GET /api/courses/:id/roster. STUDENT gets names only, ACTIVE only;\n144\t * PARENT is refused. Callers must have passed assertCanViewCourse first.\n145\t */\n146\texport async function getCourseRoster(\n147\t  courseId: string,\n148\t  viewerRole: Role,\n149\t  query: Partial<RosterQuery> = {},\n150\t  page?: { skip: number; take: number },\n151\t): Promise<{ rows: RosterEntry[] | { name: string }[]; total: number }> {\n152\t  if (viewerRole === 'PARENT') throw new AppError('FORBIDDEN', 'Parents cannot view course rosters.');\n153\t  const fullView = viewerRole === 'ADMIN' || viewerRole === 'TEACHER';\n154\t  const status = fullView ? (query.status ?? 'ACTIVE') : 'ACTIVE';\n155\t\n156\t  const where: Prisma.EnrollmentWhereInput = {\n157\t    courseId,\n158\t    ...(status === 'ALL' ? {} : { status }),\n159\t    ...(query.q\n160\t      ? {\n161\t          student: {\n162\t            OR: [\n163\t              { firstName: { contains: query.q, mode: 'insensitive' } },\n164\t              { lastName: { contains: query.q, mode: 'insensitive' } },\n165\t            ],\n166\t          },\n167\t        }\n168\t      : {}),\n169\t  };\n170\t  const orderBy: Prisma.EnrollmentOrderByWithRelationInput[] = [\n171\t    { student: { lastName: 'asc' } },\n172\t    { student: { firstName: 'asc' } },\n173\t  ];\n174\t\n175\t  if (!fullView) {\n176\t    const [rows, total] = await Promise.all([\n177\t      prisma.enrollment.findMany({\n178\t        where,\n179\t        orderBy,\n180\t        select: { student: { select: { firstName: true, lastName: true } } },\n181\t        ...page,\n182\t      }),\n183\t      prisma.enrollment.count({ where }),\n184\t    ]);\n185\t    return { rows: rows.map((r) => ({ name: personName(r.student) })), total };\n186\t  }\n187\t\n188\t  const [rows, total] = await Promise.all([\n189\t    prisma.enrollment.findMany({\n190\t      where,\n191\t      orderBy,\n192\t      include: { student: { select: { ...personSelect, studentProfile: { select: { admissionNumber: true } } } } },\n193\t      ...page,\n194\t    }),\n195\t    prisma.enrollment.count({ where }),\n196\t  ]);\n197\t  return {\n198\t    rows: rows.map((r) => ({\n199\t      enrollmentId: r.id,\n200\t      status: r.status,\n201\t      enrolledAt: r.enrolledAt,\n202\t      droppedAt: r.droppedAt,\n203\t      student: {\n204\t        id: r.student.id,\n205\t        name: personName(r.student),\n206\t        avatarUrl: null,\n207\t        admissionNumber: r.student.studentProfile?.admissionNumber ?? null,\n208\t        profileUrl: `/students/${r.student.id}`,\n209\t      },\n210\t    })),\n211\t    total,\n212\t  };\n213\t}\n214\t\n215\t/** FR-19 / GET /api/me/courses: current year, non-archived. ADMIN gets an empty list. */\n216\texport async function listMyCourses(user: AccessUser) {\n217\t  const year = await getCurrentAcademicYear();\n218\t  if (!year || user.role === 'ADMIN') return [];\n219\t  const base: Prisma.CourseWhereInput = { academicYearId: year.id, archivedAt: null };\n220\t\n221\t  if (user.role === 'TEACHER') {\n222\t    const rows = await prisma.course.findMany({\n223\t      where: { ...base, ...teachesWhere(user.id) },\n224\t      include: courseInclude,\n225\t      orderBy: { code: 'asc' },\n226\t    });\n227\t    return rows.map((c) => ({\n228\t      id: c.id,\n229\t      name: c.name,\n230\t      code: c.code,\n231\t      subjectColor: c.subject.color,\n232\t      section: c.section ? { id: c.section.id, name: c.section.name } : null,\n233\t      enrolledCount: c._count.enrollments,\n234\t    }));\n235\t  }\n236\t\n237\t  const studentCourses = (studentIds: string[]) =>\n238\t    prisma.course.findMany({\n239\t      where: { ...base, enrollments: { some: { studentId: { in: studentIds }, status: 'ACTIVE' } } },\n240\t      include: {\n241\t        subject: { select: { color: true } },\n242\t        teacher: { select: personSelect },\n243\t        enrollments: { where: { studentId: { in: studentIds }, status: 'ACTIVE' }, select: { studentId: true } },\n244\t      },\n245\t      orderBy: { code: 'asc' },\n246\t    });\n247\t  type StudentCourseRow = Awaited<ReturnType<typeof studentCourses>>[number];\n248\t  const card = (c: StudentCourseRow) => ({\n249\t    id: c.id,\n250\t    name: c.name,\n251\t    code: c.code,\n252\t    subjectColor: c.subject.color,\n253\t    teacher: person(c.teacher),\n254\t  });\n255\t\n256\t  if (user.role === 'STUDENT') return (await studentCourses([user.id])).map(card);\n257\t\n258\t  // PARENT: one query over all linked children, grouped by child.\n259\t  const links = await listLinksForParent(user.id);\n260\t  const childIds = links.map((l) => l.studentId);\n261\t  const courses = childIds.length ? await studentCourses(childIds) : [];\n262\t  return links.map((link) => ({\n263\t    child: { id: link.studentId, name: personName(link.student) },\n264\t    courses: courses.filter((c) => c.enrollments.some((e) => e.studentId === link.studentId)).map(card),\n265\t  }));\n266\t}\n267\t\n268\t/** FR-21: this year's section + courses for a student (caller gates with assertCanViewStudent). */\n269\texport async function getStudentCourses(studentId: string) {\n270\t  const year = await getCurrentAcademicYear();\n271\t  if (!year) return { academicYear: null, section: null, courses: [] };\n272\t\n273\t  const [membership, enrollments] = await Promise.all([\n274\t    prisma.sectionMember.findUnique({\n275\t      where: { studentId_academicYearId: { studentId, academicYearId: year.id } },\n276\t      include: { section: { select: { id: true, name: true, homeroomTeacher: { select: personSelect } } } },\n277\t    }),\n278\t    prisma.enrollment.findMany({\n279\t      where: { studentId, course: { academicYearId: year.id } },\n280\t      include: {\n281\t        course: {\n282\t          select: {\n283\t            id: true,\n284\t            name: true,\n285\t            code: true,\n286\t            kind: true,\n287\t            subject: { select: { color: true } },\n288\t            teacher: { select: personSelect },\n289\t          },\n290\t        },\n291\t      },\n292\t      orderBy: [{ status: 'asc' }, { course: { code: 'asc' } }],\n293\t    }),\n294\t  ]);\n295\t\n296\t  return {\n297\t    academicYear: { id: year.id, name: year.name },\n298\t    section: membership\n299\t      ? {\n300\t          id: membership.section.id,\n301\t          name: membership.section.name,\n302\t          homeroomTeacher: membership.section.homeroomTeacher ? person(membership.section.homeroomTeacher) : null,\n303\t        }\n304\t      : null,\n305\t    courses: enrollments.map((e) => ({\n306\t      enrollmentId: e.id,\n307\t      courseId: e.course.id,\n308\t      name: e.course.name,\n309\t      code: e.course.code,\n310\t      kind: e.course.kind,\n311\t      subjectColor: e.course.subject.color,\n312\t      teacher: person(e.course.teacher),\n313\t      status: e.status,\n314\t      droppedAt: e.droppedAt,\n315\t    })),\n316\t  };\n317\t}\n318\t\n319\t// ---------------------------------------------------------------------------\n320\t// Writes\n321\t// ---------------------------------------------------------------------------\n322\t\n323\t/** FR-14 + FR-10: a new CORE course enrolls the section's current members in the same tx. */\n324\texport async function createCourse(input: CourseInput, actorId?: string | null) {\n325\t  const { course, enrollments } = await prisma\n326\t    .$transaction(async (tx) => {\n327\t      await assertTeachers(tx, [input.teacherId, ...input.coTeacherIds]);\n328\t      const subject = await tx.subject.findUnique({ where: { id: input.subjectId }, select: { archivedAt: true } });\n329\t      if (!subject || subject.archivedAt) throw new AppError('VALIDATION_ERROR', 'Subject must be an active subject.');\n330\t      if (input.sectionId) {\n331\t        const section = await tx.section.findUnique({ where: { id: input.sectionId }, select: { academicYearId: true } });\n332\t        if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n333\t        if (section.academicYearId !== input.academicYearId) {\n334\t          throw new AppError('VALIDATION_ERROR', 'Section belongs to a different academic year.');\n335\t        }\n336\t      }\n337\t\n338\t      const course = await tx.course.create({\n339\t        data: {\n340\t          academicYearId: input.academicYearId,\n341\t          subjectId: input.subjectId,\n342\t          sectionId: input.sectionId ?? null,\n343\t          teacherId: input.teacherId,\n344\t          coTeacherIds: input.coTeacherIds,\n345\t          name: input.name,\n346\t          code: input.code,\n347\t          kind: input.kind,\n348\t          capacity: input.capacity ?? null,\n349\t          description: input.description ?? null,\n350\t        },\n351\t        include: courseInclude,\n352\t      });\n353\t\n354\t      let enrollments: EnrollResult | null = null;\n355\t      if (course.kind === 'CORE' && course.sectionId) {\n356\t        const members = await tx.sectionMember.findMany({ where: { sectionId: course.sectionId }, select: { studentId: true } });\n357\t        enrollments = await enrollStudentsInCourses(\n358\t          tx,\n359\t          [course.id],\n360\t          members.map((m) => m.studentId),\n361\t          { actorId },\n362\t        );\n363\t      }\n364\t      return { course, enrollments };\n365\t    })\n366\t    .catch((error) => codeConflict(error, input.code));\n367\t\n368\t  await audit({ actorId, action: 'course.create', entityType: 'Course', entityId: course.id, metadata: { enrollments } });\n369\t  return (await toCourses([course]))[0];\n370\t}\n371\t\n372\t/** FR-5: one CORE course per item, default name/code, every current member enrolled — one tx. */\n373\texport async function createCoreCourses(sectionId: string, input: CoreCoursesInput, actorId?: string | null) {\n374\t  const result = await prisma\n375\t    .$transaction(async (tx) => {\n376\t      const section = await tx.section.findUnique({\n377\t        where: { id: sectionId },\n378\t        include: { members: { select: { studentId: true } } },\n379\t      });\n380\t      if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n381\t\n382\t      const subjectIds = input.items.map((i) => i.subjectId);\n383\t      const subjects = await tx.subject.findMany({ where: { id: { in: subjectIds }, archivedAt: null } });\n384\t      if (subjects.length !== subjectIds.length) {\n385\t        throw new AppError('VALIDATION_ERROR', 'Every subject must be an active subject.');\n386\t      }\n387\t      await assertTeachers(\n388\t        tx,\n389\t        input.items.map((i) => i.teacherId),\n390\t      );\n391\t      const subjectById = new Map(subjects.map((s) => [s.id, s]));\n392\t\n393\t      const created = await tx.course.createManyAndReturn({\n394\t        data: input.items.map((item) => {\n395\t          const subject = subjectById.get(item.subjectId)!;\n396\t          return {\n397\t            academicYearId: section.academicYearId,\n398\t            subjectId: subject.id,\n399\t            sectionId: section.id,\n400\t            teacherId: item.teacherId,\n401\t            name: defaultCourseName(subject.name, section.name),\n402\t            code: defaultCourseCode(subject.code, section.name),\n403\t            kind: 'CORE' as const,\n404\t          };\n405\t        }),\n406\t        select: { id: true },\n407\t      });\n408\t      const courseIds = created.map((c) => c.id);\n409\t      const enrollments = await enrollStudentsInCourses(\n410\t        tx,\n411\t        courseIds,\n412\t        section.members.map((m) => m.studentId),\n413\t        { actorId },\n414\t      );\n415\t      const rows = await tx.course.findMany({ where: { id: { in: courseIds } }, include: courseInclude, orderBy: { code: 'asc' } });\n416\t      return { rows, enrollmentsCreated: enrollments.enrolled + enrollments.reactivated };\n417\t    })\n418\t    .catch((error) => codeConflict(error));\n419\t\n420\t  await audit({\n421\t    actorId,\n422\t    action: 'course.create',\n423\t    entityType: 'Course',\n424\t    metadata: { sectionId, courseIds: result.rows.map((r) => r.id), enrollmentsCreated: result.enrollmentsCreated },\n425\t  });\n426\t  return { courses: await toCourses(result.rows), enrollmentsCreated: result.enrollmentsCreated };\n427\t}\n428\t\n429\texport async function updateCourse(id: string, input: CourseUpdateInput, actorId?: string | null) {\n430\t  const { archived, ...fields } = input;\n431\t  const course = await prisma\n432\t    .$transaction(async (tx) => {\n433\t      const existing = await tx.course.findUnique({ where: { id }, include: courseInclude });\n434\t      if (!existing) throw new AppError('NOT_FOUND', 'Course not found');\n435\t      await assertTeachers(tx, [...(fields.teacherId ? [fields.teacherId] : []), ...(fields.coTeacherIds ?? [])]);\n436\t      if (fields.capacity != null && fields.capacity < existing._count.enrollments) {\n437\t        throw new AppError(\n438\t          'VALIDATION_ERROR',\n439\t          `Capacity cannot be lower than the current enrolled count (${existing._count.enrollments}).`,\n440\t        );\n441\t      }\n442\t      return tx.course.update({\n443\t        where: { id },\n444\t        data: {\n445\t          subjectId: fields.subjectId,\n446\t          teacherId: fields.teacherId,\n447\t          coTeacherIds: fields.coTeacherIds,\n448\t          name: fields.name,\n449\t          code: fields.code,\n450\t          capacity: fields.capacity,\n451\t          description: fields.description,\n452\t          ...(archived === undefined ? {} : { archivedAt: archived ? (existing.archivedAt ?? new Date()) : null }),\n453\t        },\n454\t        include: courseInclude,\n455\t      });\n456\t    })\n457\t    .catch((error) => codeConflict(error, fields.code));\n458\t\n459\t  const action = archived === true ? 'course.archive' : archived === false ? 'course.unarchive' : 'course.update';\n460\t  await audit({ actorId, action, entityType: 'Course', entityId: id, metadata: { fields: Object.keys(input) } });\n461\t  return (await toCourses([course]))[0];\n462\t}\n463\t\n464\t/** FR-15: direct (elective) enrollment; CORE membership is owned by the section. */\n465\texport async function enrollStudentsInCourse(courseId: string, input: EnrollStudentsInput, actorId?: string | null) {\n466\t  const studentIds = [...new Set(input.studentIds)];\n467\t  return prisma.$transaction(async (tx) => {\n468\t    const course = await tx.course.findUnique({ where: { id: courseId }, include: { section: { select: { name: true } } } });\n469\t    if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n470\t    if (course.kind === 'CORE') {\n471\t      throw new AppError('CONFLICT', `Core course enrollment is managed via section ${course.section?.name ?? '(none)'}.`);\n472\t    }\n473\t    await assertStudents(tx, studentIds);\n474\t    return enrollStudentsInCourses(tx, [courseId], studentIds, { overrideCapacity: input.overrideCapacity, actorId });\n475\t  });\n476\t}\n477\t\n478\t/** FR-12/FR-15: drop keeps the row (history); reactivate re-checks capacity. */\n479\texport async function setEnrollmentStatus(id: string, input: EnrollmentStatusInput, actorId?: string | null) {\n480\t  const enrollment = await prisma.$transaction(async (tx) => {\n481\t    const existing = await tx.enrollment.findUnique({ where: { id } });\n482\t    if (!existing) throw new AppError('NOT_FOUND', 'Enrollment not found');\n483\t    if (existing.status === input.status) return null;\n484\t    if (input.status === 'ACTIVE') {\n485\t      await checkCapacityOrThrow(tx, { courseId: existing.courseId, addingCount: 1, overrideCapacity: input.overrideCapacity });\n486\t    }\n487\t    return tx.enrollment.update({\n488\t      where: { id },\n489\t      data: { status: input.status, droppedAt: input.status === 'DROPPED' ? new Date() : null },\n490\t    });\n491\t  });\n492\t\n493\t  if (enrollment) {\n494\t    await audit({\n495\t      actorId,\n496\t      action: input.status === 'DROPPED' ? 'enrollment.drop' : 'enrollment.reactivate',\n497\t      entityType: 'Enrollment',\n498\t      entityId: id,\n499\t    });\n500\t  }\n501\t  const row = await prisma.enrollment.findUniqueOrThrow({\n502\t    where: { id },\n503\t    include: { student: { select: { ...personSelect, studentProfile: { select: { admissionNumber: true } } } } },\n504\t  });\n505\t  return {\n506\t    id: row.id,\n507\t    courseId: row.courseId,\n508\t    studentId: row.studentId,\n509\t    student: {\n510\t      id: row.student.id,\n511\t      name: personName(row.student),\n512\t      avatarUrl: null,\n513\t      admissionNumber: row.student.studentProfile?.admissionNumber ?? null,\n514\t    },\n515\t    status: row.status,\n516\t    enrolledAt: row.enrolledAt,\n517\t    droppedAt: row.droppedAt,\n518\t  };\n519\t}\n520\t"}]},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"f83f5495-28e8-48ac-ba0d-a3916ea795ac","timestamp":"2026-10-27T16:49:42.092Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/courses/courses-service.ts","content":"import { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { getCurrentAcademicYear } from '@/server/services/academicYears';\nimport { listLinksForParent } from '@/server/services/userLinks';\nimport type { AccessUser } from '@/server/auth/student-access';\nimport type { Role } from '@/config/navigation';\nimport { personName } from '@/server/sections/sections-service';\nimport {\n  checkCapacityOrThrow,\n  enrollStudentsInCourses,\n  type EnrollResult,\n  type Tx,\n} from '@/server/enrollment/roster-engine';\nimport { defaultCourseCode, defaultCourseName } from '@/lib/validators/courses';\nimport type {\n  CourseInput,\n  CoursesListQuery,\n  CourseUpdateInput,\n  EnrollmentStatusInput,\n  RosterQuery,\n} from '@/lib/validators/courses';\nimport type { CoreCoursesInput, EnrollStudentsInput } from '@/lib/validators/sections';\n\n/** Courses CRUD, rosters and enrollment (PRD-05 FR-5, FR-10..FR-21, FR-24, NFR-4). */\n\nconst personSelect = { id: true, firstName: true, lastName: true } as const;\nconst person = (u: { id: string; firstName: string; lastName: string }) => ({ id: u.id, name: personName(u) });\n\nconst courseInclude = {\n  subject: { select: { id: true, name: true, code: true, color: true } },\n  section: { select: { id: true, name: true, room: { select: { id: true, name: true } } } },\n  teacher: { select: personSelect },\n  _count: { select: { enrollments: { where: { status: 'ACTIVE' } } } },\n} satisfies Prisma.CourseInclude;\n\ntype CourseRow = Prisma.CourseGetPayload<{ include: typeof courseInclude }>;\n\n/** coTeacherIds is a plain String[] (FR-1), so names come from one batched lookup. */\nasync function toCourses(rows: CourseRow[]) {\n  const ids = [...new Set(rows.flatMap((r) => r.coTeacherIds))];\n  const users = ids.length ? await prisma.user.findMany({ where: { id: { in: ids } }, select: personSelect }) : [];\n  const byId = new Map(users.map((u) => [u.id, person(u)]));\n  return rows.map(({ _count, teacher, ...rest }) => ({\n    ...rest,\n    teacher: person(teacher),\n    coTeachers: rest.coTeacherIds.map((id) => byId.get(id)).filter((u): u is { id: string; name: string } => !!u),\n    enrolledCount: _count.enrollments,\n  }));\n}\nexport type CourseDto = Awaited<ReturnType<typeof toCourses>>[number];\n\nconst teachesWhere = (userId: string): Prisma.CourseWhereInput => ({\n  OR: [{ teacherId: userId }, { coTeacherIds: { has: userId } }],\n});\n\nfunction codeConflict(error: unknown, code?: string): never {\n  if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') {\n    throw new AppError('CONFLICT', code ? `Course code ${code} already exists this year.` : 'A course code already exists this year.');\n  }\n  throw error;\n}\n\nasync function assertTeachers(tx: Tx, ids: string[]) {\n  const unique = [...new Set(ids)];\n  if (unique.length === 0) return;\n  const count = await tx.user.count({ where: { id: { in: unique }, role: 'TEACHER' } });\n  if (count !== unique.length) throw new AppError('VALIDATION_ERROR', 'Teachers and co-teachers must be teachers.');\n}\n\nasync function assertStudents(tx: Tx, ids: string[]) {\n  const count = await tx.user.count({ where: { id: { in: ids }, role: 'STUDENT' } });\n  if (count !== ids.length) throw new AppError('VALIDATION_ERROR', 'Every selected user must be a student.');\n}\n\nasync function resolveYearId(academicYearId?: string) {\n  if (academicYearId) return academicYearId;\n  return (await getCurrentAcademicYear())?.id ?? null;\n}\n\n// ---------------------------------------------------------------------------\n// Reads\n// ---------------------------------------------------------------------------\n\n/** FR-13 list, scoped per role here rather than by client filter. */\nexport async function listCourses(\n  user: AccessUser,\n  query: Partial<CoursesListQuery>,\n  page: { skip: number; take: number },\n) {\n  const academicYearId = await resolveYearId(query.academicYearId);\n  if (!academicYearId) return { rows: [] as CourseDto[], total: 0 };\n\n  const and: Prisma.CourseWhereInput[] = [{ academicYearId }];\n  if (query.gradeLevelId) and.push({ section: { gradeLevelId: query.gradeLevelId } });\n  if (query.subjectId) and.push({ subjectId: query.subjectId });\n  if (query.teacherId) and.push(teachesWhere(query.teacherId));\n  if (query.kind) and.push({ kind: query.kind });\n  if (query.sectionId) and.push({ sectionId: query.sectionId });\n  if (!(query.includeArchived && user.role === 'ADMIN')) and.push({ archivedAt: null });\n  if (query.q) {\n    and.push({\n      OR: [{ name: { contains: query.q, mode: 'insensitive' } }, { code: { contains: query.q, mode: 'insensitive' } }],\n    });\n  }\n  if (user.role === 'TEACHER') and.push(teachesWhere(user.id));\n  if (user.role === 'STUDENT') and.push({ enrollments: { some: { studentId: user.id, status: 'ACTIVE' } } });\n  if (user.role === 'PARENT') {\n    and.push({ enrollments: { some: { status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } } } });\n  }\n\n  const order = query.order ?? 'asc';\n  // ponytail: enrolledCount sort counts all enrollment rows (Prisma can't order by a filtered _count); fine while DROPPED rows are rare.\n  const orderBy: Prisma.CourseOrderByWithRelationInput =\n    query.sort === 'name' ? { name: order } : query.sort === 'enrolledCount' ? { enrollments: { _count: order } } : { code: order };\n\n  const where: Prisma.CourseWhereInput = { AND: and };\n  const [rows, total] = await Promise.all([\n    prisma.course.findMany({ where, include: courseInclude, orderBy, skip: page.skip, take: page.take }),\n    prisma.course.count({ where }),\n  ]);\n  return { rows: await toCourses(rows), total };\n}\n\nexport async function getCourse(id: string) {\n  const row = await prisma.course.findUnique({ where: { id }, include: courseInclude });\n  if (!row) throw new AppError('NOT_FOUND', 'Course not found');\n  const [course] = await toCourses([row]);\n  return course;\n}\n\nexport interface RosterEntry {\n  enrollmentId: string;\n  status: 'ACTIVE' | 'DROPPED';\n  enrolledAt: Date;\n  droppedAt: Date | null;\n  student: { id: string; name: string; avatarUrl: string | null; admissionNumber: string | null; profileUrl: string };\n}\n\n/**\n * NFR-4: the single roster implementation behind the Roster tab and\n * GET /api/courses/:id/roster. STUDENT gets names only, ACTIVE only;\n * PARENT is refused. Callers must have passed assertCanViewCourse first.\n */\nexport async function getCourseRoster(\n  courseId: string,\n  viewerRole: Role,\n  query: Partial<RosterQuery> = {},\n  page?: { skip: number; take: number },\n): Promise<{ rows: RosterEntry[] | { name: string }[]; total: number }> {\n  if (viewerRole === 'PARENT') throw new AppError('FORBIDDEN', 'Parents cannot view course rosters.');\n  const fullView = viewerRole === 'ADMIN' || viewerRole === 'TEACHER';\n  const status = fullView ? (query.status ?? 'ACTIVE') : 'ACTIVE';\n\n  const where: Prisma.EnrollmentWhereInput = {\n    courseId,\n    ...(status === 'ALL' ? {} : { status }),\n    ...(query.q\n      ? {\n          student: {\n            OR: [\n              { firstName: { contains: query.q, mode: 'insensitive' } },\n              { lastName: { contains: query.q, mode: 'insensitive' } },\n            ],\n          },\n        }\n      : {}),\n  };\n  const orderBy: Prisma.EnrollmentOrderByWithRelationInput[] = [\n    { student: { lastName: 'asc' } },\n    { student: { firstName: 'asc' } },\n  ];\n\n  if (!fullView) {\n    const [rows, total] = await Promise.all([\n      prisma.enrollment.findMany({\n        where,\n        orderBy,\n        select: { student: { select: { firstName: true, lastName: true } } },\n        ...page,\n      }),\n      prisma.enrollment.count({ where }),\n    ]);\n    return { rows: rows.map((r) => ({ name: personName(r.student) })), total };\n  }\n\n  const [rows, total] = await Promise.all([\n    prisma.enrollment.findMany({\n      where,\n      orderBy,\n      include: { student: { select: { ...personSelect, studentProfile: { select: { admissionNumber: true } } } } },\n      ...page,\n    }),\n    prisma.enrollment.count({ where }),\n  ]);\n  return {\n    rows: rows.map((r) => ({\n      enrollmentId: r.id,\n      status: r.status,\n      enrolledAt: r.enrolledAt,\n      droppedAt: r.droppedAt,\n      student: {\n        id: r.student.id,\n        name: personName(r.student),\n        avatarUrl: null,\n        admissionNumber: r.student.studentProfile?.admissionNumber ?? null,\n        profileUrl: `/students/${r.student.id}`,\n      },\n    })),\n    total,\n  };\n}\n\n/** FR-19 / GET /api/me/courses: current year, non-archived. ADMIN gets an empty list. */\nexport async function listMyCourses(user: AccessUser) {\n  const year = await getCurrentAcademicYear();\n  if (!year || user.role === 'ADMIN') return [];\n  const base: Prisma.CourseWhereInput = { academicYearId: year.id, archivedAt: null };\n\n  if (user.role === 'TEACHER') {\n    const rows = await prisma.course.findMany({\n      where: { ...base, ...teachesWhere(user.id) },\n      include: courseInclude,\n      orderBy: { code: 'asc' },\n    });\n    return rows.map((c) => ({\n      id: c.id,\n      name: c.name,\n      code: c.code,\n      subjectColor: c.subject.color,\n      section: c.section ? { id: c.section.id, name: c.section.name } : null,\n      enrolledCount: c._count.enrollments,\n    }));\n  }\n\n  const studentCourses = (studentIds: string[]) =>\n    prisma.course.findMany({\n      where: { ...base, enrollments: { some: { studentId: { in: studentIds }, status: 'ACTIVE' } } },\n      include: {\n        subject: { select: { color: true } },\n        teacher: { select: personSelect },\n        enrollments: { where: { studentId: { in: studentIds }, status: 'ACTIVE' }, select: { studentId: true } },\n      },\n      orderBy: { code: 'asc' },\n    });\n  type StudentCourseRow = Awaited<ReturnType<typeof studentCourses>>[number];\n  const card = (c: StudentCourseRow) => ({\n    id: c.id,\n    name: c.name,\n    code: c.code,\n    subjectColor: c.subject.color,\n    teacher: person(c.teacher),\n  });\n\n  if (user.role === 'STUDENT') return (await studentCourses([user.id])).map(card);\n\n  // PARENT: one query over all linked children, grouped by child.\n  const links = await listLinksForParent(user.id);\n  const childIds = links.map((l) => l.studentId);\n  const courses = childIds.length ? await studentCourses(childIds) : [];\n  return links.map((link) => ({\n    child: { id: link.studentId, name: personName(link.student) },\n    courses: courses.filter((c) => c.enrollments.some((e) => e.studentId === link.studentId)).map(card),\n  }));\n}\n\n/** FR-21: this year's section + courses for a student (caller gates with assertCanViewStudent). */\nexport async function getStudentCourses(studentId: string) {\n  const year = await getCurrentAcademicYear();\n  if (!year) return { academicYear: null, section: null, courses: [] };\n\n  const [membership, enrollments] = await Promise.all([\n    prisma.sectionMember.findUnique({\n      where: { studentId_academicYearId: { studentId, academicYearId: year.id } },\n      include: { section: { select: { id: true, name: true, homeroomTeacher: { select: personSelect } } } },\n    }),\n    prisma.enrollment.findMany({\n      where: { studentId, course: { academicYearId: year.id } },\n      include: {\n        course: {\n          select: {\n            id: true,\n            name: true,\n            code: true,\n            kind: true,\n            subject: { select: { color: true } },\n            teacher: { select: personSelect },\n          },\n        },\n      },\n      orderBy: [{ status: 'asc' }, { course: { code: 'asc' } }],\n    }),\n  ]);\n\n  return {\n    academicYear: { id: year.id, name: year.name },\n    section: membership\n      ? {\n          id: membership.section.id,\n          name: membership.section.name,\n          homeroomTeacher: membership.section.homeroomTeacher ? person(membership.section.homeroomTeacher) : null,\n        }\n      : null,\n    courses: enrollments.map((e) => ({\n      enrollmentId: e.id,\n      courseId: e.course.id,\n      name: e.course.name,\n      code: e.course.code,\n      kind: e.course.kind,\n      subjectColor: e.course.subject.color,\n      teacher: person(e.course.teacher),\n      status: e.status,\n      droppedAt: e.droppedAt,\n    })),\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Writes\n// ---------------------------------------------------------------------------\n\n/** FR-14 + FR-10: a new CORE course enrolls the section's current members in the same tx. */\nexport async function createCourse(input: CourseInput, actorId?: string | null) {\n  const { course, enrollments } = await prisma\n    .$transaction(async (tx) => {\n      await assertTeachers(tx, [input.teacherId, ...input.coTeacherIds]);\n      const subject = await tx.subject.findUnique({ where: { id: input.subjectId }, select: { archivedAt: true } });\n      if (!subject || subject.archivedAt) throw new AppError('VALIDATION_ERROR', 'Subject must be an active subject.');\n      if (input.sectionId) {\n        const section = await tx.section.findUnique({ where: { id: input.sectionId }, select: { academicYearId: true } });\n        if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n        if (section.academicYearId !== input.academicYearId) {\n          throw new AppError('VALIDATION_ERROR', 'Section belongs to a different academic year.');\n        }\n      }\n\n      const course = await tx.course.create({\n        data: {\n          academicYearId: input.academicYearId,\n          subjectId: input.subjectId,\n          sectionId: input.sectionId ?? null,\n          teacherId: input.teacherId,\n          coTeacherIds: input.coTeacherIds,\n          name: input.name,\n          code: input.code,\n          kind: input.kind,\n          capacity: input.capacity ?? null,\n          description: input.description ?? null,\n        },\n        include: courseInclude,\n      });\n\n      let enrollments: EnrollResult | null = null;\n      if (course.kind === 'CORE' && course.sectionId) {\n        const members = await tx.sectionMember.findMany({ where: { sectionId: course.sectionId }, select: { studentId: true } });\n        enrollments = await enrollStudentsInCourses(\n          tx,\n          [course.id],\n          members.map((m) => m.studentId),\n          { actorId },\n        );\n      }\n      return { course, enrollments };\n    })\n    .catch((error) => codeConflict(error, input.code));\n\n  await audit({ actorId, action: 'course.create', entityType: 'Course', entityId: course.id, metadata: { enrollments } });\n  return (await toCourses([course]))[0];\n}\n\n/** FR-5: one CORE course per item, default name/code, every current member enrolled — one tx. */\nexport async function createCoreCourses(sectionId: string, input: CoreCoursesInput, actorId?: string | null) {\n  const result = await prisma\n    .$transaction(async (tx) => {\n      const section = await tx.section.findUnique({\n        where: { id: sectionId },\n        include: { members: { select: { studentId: true } } },\n      });\n      if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n\n      const subjectIds = input.items.map((i) => i.subjectId);\n      const subjects = await tx.subject.findMany({ where: { id: { in: subjectIds }, archivedAt: null } });\n      if (subjects.length !== subjectIds.length) {\n        throw new AppError('VALIDATION_ERROR', 'Every subject must be an active subject.');\n      }\n      await assertTeachers(\n        tx,\n        input.items.map((i) => i.teacherId),\n      );\n      const subjectById = new Map(subjects.map((s) => [s.id, s]));\n\n      const created = await tx.course.createManyAndReturn({\n        data: input.items.map((item) => {\n          const subject = subjectById.get(item.subjectId)!;\n          return {\n            academicYearId: section.academicYearId,\n            subjectId: subject.id,\n            sectionId: section.id,\n            teacherId: item.teacherId,\n            name: defaultCourseName(subject.name, section.name),\n            code: defaultCourseCode(subject.code, section.name),\n            kind: 'CORE' as const,\n          };\n        }),\n        select: { id: true },\n      });\n      const courseIds = created.map((c) => c.id);\n      const enrollments = await enrollStudentsInCourses(\n        tx,\n        courseIds,\n        section.members.map((m) => m.studentId),\n        { actorId },\n      );\n      const rows = await tx.course.findMany({ where: { id: { in: courseIds } }, include: courseInclude, orderBy: { code: 'asc' } });\n      return { rows, enrollmentsCreated: enrollments.enrolled + enrollments.reactivated };\n    })\n    .catch((error) => codeConflict(error));\n\n  await audit({\n    actorId,\n    action: 'course.create',\n    entityType: 'Course',\n    metadata: { sectionId, courseIds: result.rows.map((r) => r.id), enrollmentsCreated: result.enrollmentsCreated },\n  });\n  return { courses: await toCourses(result.rows), enrollmentsCreated: result.enrollmentsCreated };\n}\n\nexport async function updateCourse(id: string, input: CourseUpdateInput, actorId?: string | null) {\n  const { archived, ...fields } = input;\n  const course = await prisma\n    .$transaction(async (tx) => {\n      const existing = await tx.course.findUnique({ where: { id }, include: courseInclude });\n      if (!existing) throw new AppError('NOT_FOUND', 'Course not found');\n      await assertTeachers(tx, [...(fields.teacherId ? [fields.teacherId] : []), ...(fields.coTeacherIds ?? [])]);\n      if (fields.capacity != null && fields.capacity < existing._count.enrollments) {\n        throw new AppError(\n          'VALIDATION_ERROR',\n          `Capacity cannot be lower than the current enrolled count (${existing._count.enrollments}).`,\n        );\n      }\n      return tx.course.update({\n        where: { id },\n        data: {\n          subjectId: fields.subjectId,\n          teacherId: fields.teacherId,\n          coTeacherIds: fields.coTeacherIds,\n          name: fields.name,\n          code: fields.code,\n          capacity: fields.capacity,\n          description: fields.description,\n          ...(archived === undefined ? {} : { archivedAt: archived ? (existing.archivedAt ?? new Date()) : null }),\n        },\n        include: courseInclude,\n      });\n    })\n    .catch((error) => codeConflict(error, fields.code));\n\n  const action = archived === true ? 'course.archive' : archived === false ? 'course.unarchive' : 'course.update';\n  await audit({ actorId, action, entityType: 'Course', entityId: id, metadata: { fields: Object.keys(input) } });\n  return (await toCourses([course]))[0];\n}\n\n/** FR-15: direct (elective) enrollment; CORE membership is owned by the section. */\nexport async function enrollStudentsInCourse(courseId: string, input: EnrollStudentsInput, actorId?: string | null) {\n  const studentIds = [...new Set(input.studentIds)];\n  return prisma.$transaction(async (tx) => {\n    const course = await tx.course.findUnique({ where: { id: courseId }, include: { section: { select: { name: true } } } });\n    if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n    if (course.kind === 'CORE') {\n      throw new AppError('CONFLICT', `Core course enrollment is managed via section ${course.section?.name ?? '(none)'}.`);\n    }\n    await assertStudents(tx, studentIds);\n    return enrollStudentsInCourses(tx, [courseId], studentIds, { overrideCapacity: input.overrideCapacity, actorId });\n  });\n}\n\n/** FR-12/FR-15: drop keeps the row (history); reactivate re-checks capacity. */\nexport async function setEnrollmentStatus(id: string, input: EnrollmentStatusInput, actorId?: string | null) {\n  const enrollment = await prisma.$transaction(async (tx) => {\n    const existing = await tx.enrollment.findUnique({ where: { id } });\n    if (!existing) throw new AppError('NOT_FOUND', 'Enrollment not found');\n    if (existing.status === input.status) return null;\n    if (input.status === 'ACTIVE') {\n      await checkCapacityOrThrow(tx, { courseId: existing.courseId, addingCount: 1, overrideCapacity: input.overrideCapacity });\n    }\n    return tx.enrollment.update({\n      where: { id },\n      data: { status: input.status, droppedAt: input.status === 'DROPPED' ? new Date() : null },\n    });\n  });\n\n  if (enrollment) {\n    await audit({\n      actorId,\n      action: input.status === 'DROPPED' ? 'enrollment.drop' : 'enrollment.reactivate',\n      entityType: 'Enrollment',\n      entityId: id,\n    });\n  }\n  const row = await prisma.enrollment.findUniqueOrThrow({\n    where: { id },\n    include: { student: { select: { ...personSelect, studentProfile: { select: { admissionNumber: true } } } } },\n  });\n  return {\n    id: row.id,\n    courseId: row.courseId,\n    studentId: row.studentId,\n    student: {\n      id: row.student.id,\n      name: personName(row.student),\n      avatarUrl: null,\n      admissionNumber: row.student.studentProfile?.admissionNumber ?? null,\n    },\n    status: row.status,\n    enrolledAt: row.enrolledAt,\n    droppedAt: row.droppedAt,\n  };\n}\n","numLines":520,"startLine":1,"totalLines":520}},"tool_result_meta":[{"id":"toolu_015mhBhQ7FdYfURfAQ4gW6oR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
