{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgnTdHn6zgsZ4VYawnWqF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KBXMMQ4Jm2PjqZkNDq8ZZj","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/src/server/content/visibility.ts","content":"import type { ContentStatus } from '@prisma/client';\n\n/**\n * Single source of truth for content visibility (PRD-08 FR-18, FR-19, FR-44).\n * Pure: evaluated at read time, no background job. Used by list, get,\n * prev/next, file access, progress and the Learning tab.\n */\n\nexport interface Publishable {\n  status: ContentStatus;\n  publishAt: Date | null;\n}\n\nexport function isVisible(item: Publishable, now: Date): boolean {\n  if (item.status === 'PUBLISHED') return true;\n  return item.status === 'SCHEDULED' && item.publishAt !== null && item.publishAt.getTime() <= now.getTime();\n}\n\n/** A lesson is visible to students/parents only when it AND its module are visible. */\nexport function isLessonVisible(lesson: Publishable, module: Publishable, now: Date): boolean {\n  return isVisible(module, now) && isVisible(lesson, now);\n}\n\n/** ADMIN, or the course's teacher/co-teacher, see drafts and scheduled items. */\nexport function canSeeDrafts(\n  user: { id: string; role: string },\n  course: { teacherId: string; coTeacherIds: string[] },\n): boolean {\n  if (user.role === 'ADMIN') return true;\n  return user.role === 'TEACHER' && (course.teacherId === user.id || course.coTeacherIds.includes(user.id));\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1786,"cache_read_input_tokens":123275,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1786},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"34574e28-0591-42df-96fb-64403ec6dad4","uuid":"4f81414f-96a1-4886-a0aa-988d1a31f8ba","timestamp":"2026-11-06T22:25:51.747Z","request_id":"req_011CgnTdHYxhvqocxEMpJ6tc","wire_tool_inputs":{"toolu_01KBXMMQ4Jm2PjqZkNDq8ZZj":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/src/server/content/visibility.ts","content":"import type { ContentStatus } from '@prisma/client';\n\n/**\n * Single source of truth for content visibility (PRD-08 FR-18, FR-19, FR-44).\n * Pure: evaluated at read time, no background job. Used by list, get,\n * prev/next, file access, progress and the Learning tab.\n */\n\nexport interface Publishable {\n  status: ContentStatus;\n  publishAt: Date | null;\n}\n\nexport function isVisible(item: Publishable, now: Date): boolean {\n  if (item.status === 'PUBLISHED') return true;\n  return item.status === 'SCHEDULED' && item.publishAt !== null && item.publishAt.getTime() <= now.getTime();\n}\n\n/** A lesson is visible to students/parents only when it AND its module are visible. */\nexport function isLessonVisible(lesson: Publishable, module: Publishable, now: Date): boolean {\n  return isVisible(module, now) && isVisible(lesson, now);\n}\n\n/** ADMIN, or the course's teacher/co-teacher, see drafts and scheduled items. */\nexport function canSeeDrafts(\n  user: { id: string; role: string },\n  course: { teacherId: string; coTeacherIds: string[] },\n): boolean {\n  if (user.role === 'ADMIN') return true;\n  return user.role === 'TEACHER' && (course.teacherId === user.id || course.coTeacherIds.includes(user.id));\n}\n"}}}
