{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017PYGKL5qQEWhvCVYvzVEA1","type":"tool_result","content":"1\timport { describe, expect, it } from 'vitest';\n2\timport { formatInSchoolTz } from '@/lib/dates';\n3\t\n4\tdescribe('formatInSchoolTz', () => {\n5\t  const utcDate = '2024-01-15T17:30:00.000Z';\n6\t\n7\t  it('formats a UTC ISO string in the given timezone', () => {\n8\t    expect(formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York')).toBe('2024-01-15 12:30');\n9\t  });\n10\t\n11\t  it('formats a Date object the same way as an equivalent ISO string', () => {\n12\t    const asDate = new Date(utcDate);\n13\t    expect(formatInSchoolTz(asDate, 'yyyy-MM-dd HH:mm', 'America/New_York')).toBe(\n14\t      formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York'),\n15\t    );\n16\t  });\n17\t\n18\t  it('produces a different wall-clock time for a different timezone', () => {\n19\t    const inTokyo = formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'Asia/Tokyo');\n20\t    const inNewYork = formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York');\n21\t    expect(inTokyo).not.toBe(inNewYork);\n22\t    expect(inTokyo).toBe('2024-01-16 02:30');\n23\t  });\n24\t\n25\t  it('respects the given date-fns pattern', () => {\n26\t    expect(formatInSchoolTz(utcDate, 'MMM d, yyyy', 'UTC')).toBe('Jan 15, 2024');\n27\t  });\n28\t});\n29\t"}]},"parent_tool_use_id":null,"session_id":"b784be86-9b15-4d20-b52f-af56b319547e","uuid":"945c4858-e6ac-4979-aac3-03d8b8fdd841","timestamp":"2026-10-19T08:54:00.309Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/tests/unit/dates.test.ts","content":"import { describe, expect, it } from 'vitest';\nimport { formatInSchoolTz } from '@/lib/dates';\n\ndescribe('formatInSchoolTz', () => {\n  const utcDate = '2024-01-15T17:30:00.000Z';\n\n  it('formats a UTC ISO string in the given timezone', () => {\n    expect(formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York')).toBe('2024-01-15 12:30');\n  });\n\n  it('formats a Date object the same way as an equivalent ISO string', () => {\n    const asDate = new Date(utcDate);\n    expect(formatInSchoolTz(asDate, 'yyyy-MM-dd HH:mm', 'America/New_York')).toBe(\n      formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York'),\n    );\n  });\n\n  it('produces a different wall-clock time for a different timezone', () => {\n    const inTokyo = formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'Asia/Tokyo');\n    const inNewYork = formatInSchoolTz(utcDate, 'yyyy-MM-dd HH:mm', 'America/New_York');\n    expect(inTokyo).not.toBe(inNewYork);\n    expect(inTokyo).toBe('2024-01-16 02:30');\n  });\n\n  it('respects the given date-fns pattern', () => {\n    expect(formatInSchoolTz(utcDate, 'MMM d, yyyy', 'UTC')).toBe('Jan 15, 2024');\n  });\n});\n","numLines":29,"startLine":1,"totalLines":29}}}
