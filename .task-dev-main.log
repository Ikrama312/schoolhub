{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N2Ssva4yziDeY1Bfet9KqC","type":"tool_result","content":"import bcrypt from 'bcrypt';\nimport { CredentialsSignin } from 'next-auth';\nimport type { Role } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { audit } from '@/server/audit';\nimport { getClientIp } from '@/server/http';\nimport { rateLimit } from '@/server/rate-limit';\nimport { signInSchema } from '@/lib/validators/auth';\n\n/** Error code surfaces to the login form via signIn(..., {redirect:false}).code (FR-5, FR-7). */\nexport class AuthError extends CredentialsSignin {\n  constructor(code: string) {\n    super(code);\n    this.code = code;\n  }\n}\n\nexport const MAX_FAILED_LOGINS = 5;\nexport const LOCKOUT_MS = 15 * 60_000;\nconst LOGIN_RATE_LIMIT = 10;\nconst LOGIN_RATE_WINDOW_MS = 5 * 60_000;\n\n// Compared against when the user is missing / has no hash, so every path costs one bcrypt compare (NFR-3).\nconst DUMMY_HASH = bcrypt.hashSync('schoolhub-dummy-password-never-matches', 12);\n\n/** FR-6: given the failure count after this attempt, the values to persist. */\nexport function computeLockout(count: number, now: Date): { failedLoginCount: number; lockedUntil: Date | null } {\n  if (count >= MAX_FAILED_LOGINS) return { failedLoginCount: 0, lockedUntil: new Date(now.getTime() + LOCKOUT_MS) };\n  return { failedLoginCount: count, lockedUntil: null };\n}\n\nexport interface AuthorizedUser {\n  id: string;\n  email: string;\n  firstName: string;\n  lastName: string;\n  role: Role;\n}\n\nexport async function authorizeCredentials(input: unknown, request: Request): Promise<AuthorizedUser> {\n  const ip = getClientIp(request);\n  const fail = async (reason: string, email: string | null, actorId: string | null = null): Promise<never> => {\n    await audit({ actorId, action: 'auth.login.failure', entityType: 'User', entityId: actorId ?? undefined, metadata: { email, reason }, request });\n    throw new AuthError(reason);\n  };\n\n  if (!rateLimit(`login:ip:${ip ?? 'unknown'}`, LOGIN_RATE_LIMIT, LOGIN_RATE_WINDOW_MS).ok) {\n    return fail('rate_limited', null);\n  }\n\n  const parsed = signInSchema.safeParse(input);\n  if (!parsed.success) return fail('invalid', null);\n  const { email, password } = parsed.data;\n\n  const user = await prisma.user.findUnique({ where: { email } });\n  const passwordOk = await bcrypt.compare(password, user?.passwordHash ?? DUMMY_HASH);\n  const now = new Date();\n\n  if (!user) return fail('invalid', email);\n  if (user.status === 'DISABLED') return fail('disabled', email, user.id);\n  if (user.status !== 'ACTIVE' || user.archivedAt) return fail('invalid', email, user.id);\n  if (user.lockedUntil && user.lockedUntil > now) {\n    return fail(`locked:${Math.ceil((user.lockedUntil.getTime() - now.getTime()) / 60_000)}`, email, user.id);\n  }\n\n  if (!passwordOk || !user.passwordHash) {\n    // ponytail: concurrent failures can overshoot the count by one before the lock lands; harmless.\n    const { failedLoginCount } = await prisma.user.update({\n      where: { id: user.id },\n      data: { failedLoginCount: { increment: 1 } },\n      select: { failedLoginCount: true },\n    });\n    const lock = computeLockout(failedLoginCount, now);\n    if (lock.lockedUntil) {\n      await prisma.user.update({ where: { id: user.id }, data: lock });\n      await audit({ actorId: user.id, action: 'auth.lockout', entityType: 'User', entityId: user.id, metadata: { email }, request });\n      return fail(`locked:${LOCKOUT_MS / 60_000}`, email, user.id);\n    }\n    return fail('invalid', email, user.id);\n  }\n\n  await prisma.user.update({ where: { id: user.id }, data: { failedLoginCount: 0, lockedUntil: null, lastLoginAt: now } });\n  await audit({ actorId: user.id, action: 'auth.login.success', entityType: 'User', entityId: user.id, request });\n  return { id: user.id, email: user.email, firstName: user.firstName, lastName: user.lastName, role: user.role };\n}\nimport bcrypt from 'bcrypt';\nimport { prisma } from '@/server/db';\nimport { audit } from '@/server/audit';\nimport { AppError, getClientIp } from '@/server/http';\nimport { rateLimit } from '@/server/rate-limit';\nimport { consumeToken, createToken, verifyToken } from '@/server/auth/tokens';\nimport { assertPasswordAllowed } from '@/server/auth/password-policy';\nimport { authLink, sendAuthEmail } from '@/server/auth/email';\n\n/**\n * Auth services (C9), Node only. Audit metadata is always explicit and never\n * carries passwords, hashes or raw tokens (FR-31).\n */\n\nconst BCRYPT_COST = 12;\nconst HOUR_MS = 60 * 60_000;\nexport const RESET_REQUESTED_MESSAGE = \"If an account exists for that email, we've sent a reset link.\";\nconst INVALID_LINK = 'This link is invalid or has expired.';\n\n/** FR-16: set the first password from an invite and activate the account. */\nexport async function acceptInvite(input: { token: string; password: string }, request?: Request) {\n  const verified = await verifyToken(input.token, 'INVITE');\n  if (!verified) throw new AppError('INVALID_TOKEN', INVALID_LINK);\n  const { token, user } = verified;\n  assertPasswordAllowed(input.password, user.email);\n  const passwordHash = await bcrypt.hash(input.password, BCRYPT_COST);\n\n  await prisma.$transaction(async (tx) => {\n    await consumeToken(token.id, tx);\n    await tx.user.update({\n      where: { id: user.id },\n      data: { passwordHash, status: 'ACTIVE', passwordChangedAt: new Date() },\n    });\n  });\n  await audit({ actorId: user.id, action: 'auth.invite.accepted', entityType: 'User', entityId: user.id, request });\n  return { email: user.email };\n}\n\n/** FR-19/FR-20: always the same response, whether or not the account exists. */\nexport async function requestPasswordReset(input: { email: string }, request?: Request) {\n  const ip = request ? getClientIp(request) : null;\n  if (!rateLimit(`forgot:ip:${ip ?? 'unknown'}`, 10, HOUR_MS).ok) {\n    throw new AppError('RATE_LIMITED', 'Too many requests. Wait a few minutes and try again.');\n  }\n  const response = { message: RESET_REQUESTED_MESSAGE };\n  if (!rateLimit(`forgot:email:${input.email}`, 3, HOUR_MS).ok) return response;\n\n  const user = await prisma.user.findUnique({\n    where: { email: input.email },\n    select: { id: true, email: true, firstName: true, status: true, archivedAt: true },\n  });\n  if (user && user.status === 'ACTIVE' && !user.archivedAt) {\n    const raw = await createToken(user.id, 'PASSWORD_RESET', { minutes: 60 });\n    await sendAuthEmail(user, 'password-reset', authLink('password-reset', raw));\n    await audit({ actorId: user.id, action: 'auth.password.reset_requested', entityType: 'User', entityId: user.id, request });\n  }\n  return response;\n}\n\n/** FR-21: set a new password from a reset link; also clears any lockout. */\nexport async function resetPassword(input: { token: string; password: string }, request?: Request) {\n  const verified = await verifyToken(input.token, 'PASSWORD_RESET');\n  if (!verified) throw new AppError('INVALID_TOKEN', INVALID_LINK);\n  const { token, user } = verified;\n  assertPasswordAllowed(input.password, user.email);\n  const passwordHash = await bcrypt.hash(input.password, BCRYPT_COST);\n\n  await prisma.$transaction(async (tx) => {\n    await consumeToken(token.id, tx);\n    await tx.user.update({\n      where: { id: user.id },\n      data: { passwordHash, passwordChangedAt: new Date(), failedLoginCount: 0, lockedUntil: null },\n    });\n  });\n  await audit({ actorId: user.id, action: 'auth.password.reset', entityType: 'User', entityId: user.id, request });\n  return { ok: true as const };\n}\n\n/** FR-23: signed-in change; caller refreshes its own session's authTime afterwards. */\nexport async function changePassword(\n  user: { id: string },\n  input: { currentPassword: string; newPassword: string },\n  request?: Request,\n) {\n  const existing = await prisma.user.findUnique({ where: { id: user.id }, select: { email: true, passwordHash: true } });\n  if (!existing) throw new AppError('UNAUTHENTICATED', 'You must be signed in.');\n  const currentOk = existing.passwordHash ? await bcrypt.compare(input.currentPassword, existing.passwordHash) : false;\n  if (!currentOk) {\n    throw new AppError('VALIDATION_ERROR', 'Current password is incorrect.', {\n      fieldErrors: { currentPassword: ['Current password is incorrect.'] },\n    });\n  }\n  assertPasswordAllowed(input.newPassword, existing.email);\n  const passwordHash = await bcrypt.hash(input.newPassword, BCRYPT_COST);\n  await prisma.user.update({ where: { id: user.id }, data: { passwordHash, passwordChangedAt: new Date() } });\n  await audit({ actorId: user.id, action: 'auth.password.changed', entityType: 'User', entityId: user.id, request });\n  return { ok: true as const };\n}\n118:export async function createUser(input: CreateUserInput) {\n172:export async function updateUser(id: string, input: UpdateUserInput) {\n220:export interface ListUsersFilters {\n238:export async function listUsers(filters: ListUsersFilters, pagination: { skip: number; take: number }) {\n276:export async function getUserDetail(id: string) {\n345:export async function setUserStatus(actorId: string, userId: string, status: 'ACTIVE' | 'DISABLED') {\n354:export async function archiveUser(actorId: string, userId: string) {\n365:export async function restoreUser(userId: string) {\n374:export async function unlockUser(userId: string) {\n383:export function createInviteToken(userId: string): Promise<string> {\n392:export async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n395:  const raw = await createInviteToken(userId);\nsrc/server/auth/email.ts:8:export type AuthEmailKind = 'invite' | 'password-reset';\nsrc/server/auth/email.ts:16:export function authLink(kind: AuthEmailKind, rawToken: string): string {\nsrc/server/auth/email.ts:26:export async function sendAuthEmail(\nsrc/server/rate-limit.ts:5:export function rateLimit(\nsrc/server/rate-limit.ts:21:export function __resetRateLimits(): void {\nsrc/lib/logger.ts:17:export const logger = {\nsrc/components/Toast/ToastProvider.tsx:19:export function ToastProvider({ children }: { children: React.ReactNode }) {\nsrc/components/Toast/useToast.ts:6:export interface ToastOptions {\nsrc/components/Toast/useToast.ts:11:export interface ToastContextValue {\nsrc/components/Toast/useToast.ts:15:export const ToastContext = createContext<ToastContextValue | null>(null);\nsrc/components/Toast/useToast.ts:17:export function useToast(): ToastContextValue {\nsrc/components:\nConfirmDialog\nDataTable\nDateDisplay\nEmptyState\nFormField\nLoadingSkeleton\nNotificationBell\nPageHeader\nPasswordChecklist\nStatCard\nToast\nUserAvatar\nUserPicker\n\nsrc/lib:\ndates.ts\nenv.ts\nlogger.ts\nvalidators","is_error":false}]},"parent_tool_use_id":null,"session_id":"3418fb08-df3a-4486-bb21-2c26927907e3","uuid":"cab1ed4e-ab8f-4e3f-8a30-a91e376bb9f4","timestamp":"2026-11-05T06:59:33.350Z","tool_use_result":{"stdout":"import bcrypt from 'bcrypt';\nimport { CredentialsSignin } from 'next-auth';\nimport type { Role } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { audit } from '@/server/audit';\nimport { getClientIp } from '@/server/http';\nimport { rateLimit } from '@/server/rate-limit';\nimport { signInSchema } from '@/lib/validators/auth';\n\n/** Error code surfaces to the login form via signIn(..., {redirect:false}).code (FR-5, FR-7). */\nexport class AuthError extends CredentialsSignin {\n  constructor(code: string) {\n    super(code);\n    this.code = code;\n  }\n}\n\nexport const MAX_FAILED_LOGINS = 5;\nexport const LOCKOUT_MS = 15 * 60_000;\nconst LOGIN_RATE_LIMIT = 10;\nconst LOGIN_RATE_WINDOW_MS = 5 * 60_000;\n\n// Compared against when the user is missing / has no hash, so every path costs one bcrypt compare (NFR-3).\nconst DUMMY_HASH = bcrypt.hashSync('schoolhub-dummy-password-never-matches', 12);\n\n/** FR-6: given the failure count after this attempt, the values to persist. */\nexport function computeLockout(count: number, now: Date): { failedLoginCount: number; lockedUntil: Date | null } {\n  if (count >= MAX_FAILED_LOGINS) return { failedLoginCount: 0, lockedUntil: new Date(now.getTime() + LOCKOUT_MS) };\n  return { failedLoginCount: count, lockedUntil: null };\n}\n\nexport interface AuthorizedUser {\n  id: string;\n  email: string;\n  firstName: string;\n  lastName: string;\n  role: Role;\n}\n\nexport async function authorizeCredentials(input: unknown, request: Request): Promise<AuthorizedUser> {\n  const ip = getClientIp(request);\n  const fail = async (reason: string, email: string | null, actorId: string | null = null): Promise<never> => {\n    await audit({ actorId, action: 'auth.login.failure', entityType: 'User', entityId: actorId ?? undefined, metadata: { email, reason }, request });\n    throw new AuthError(reason);\n  };\n\n  if (!rateLimit(`login:ip:${ip ?? 'unknown'}`, LOGIN_RATE_LIMIT, LOGIN_RATE_WINDOW_MS).ok) {\n    return fail('rate_limited', null);\n  }\n\n  const parsed = signInSchema.safeParse(input);\n  if (!parsed.success) return fail('invalid', null);\n  const { email, password } = parsed.data;\n\n  const user = await prisma.user.findUnique({ where: { email } });\n  const passwordOk = await bcrypt.compare(password, user?.passwordHash ?? DUMMY_HASH);\n  const now = new Date();\n\n  if (!user) return fail('invalid', email);\n  if (user.status === 'DISABLED') return fail('disabled', email, user.id);\n  if (user.status !== 'ACTIVE' || user.archivedAt) return fail('invalid', email, user.id);\n  if (user.lockedUntil && user.lockedUntil > now) {\n    return fail(`locked:${Math.ceil((user.lockedUntil.getTime() - now.getTime()) / 60_000)}`, email, user.id);\n  }\n\n  if (!passwordOk || !user.passwordHash) {\n    // ponytail: concurrent failures can overshoot the count by one before the lock lands; harmless.\n    const { failedLoginCount } = await prisma.user.update({\n      where: { id: user.id },\n      data: { failedLoginCount: { increment: 1 } },\n      select: { failedLoginCount: true },\n    });\n    const lock = computeLockout(failedLoginCount, now);\n    if (lock.lockedUntil) {\n      await prisma.user.update({ where: { id: user.id }, data: lock });\n      await audit({ actorId: user.id, action: 'auth.lockout', entityType: 'User', entityId: user.id, metadata: { email }, request });\n      return fail(`locked:${LOCKOUT_MS / 60_000}`, email, user.id);\n    }\n    return fail('invalid', email, user.id);\n  }\n\n  await prisma.user.update({ where: { id: user.id }, data: { failedLoginCount: 0, lockedUntil: null, lastLoginAt: now } });\n  await audit({ actorId: user.id, action: 'auth.login.success', entityType: 'User', entityId: user.id, request });\n  return { id: user.id, email: user.email, firstName: user.firstName, lastName: user.lastName, role: user.role };\n}\nimport bcrypt from 'bcrypt';\nimport { prisma } from '@/server/db';\nimport { audit } from '@/server/audit';\nimport { AppError, getClientIp } from '@/server/http';\nimport { rateLimit } from '@/server/rate-limit';\nimport { consumeToken, createToken, verifyToken } from '@/server/auth/tokens';\nimport { assertPasswordAllowed } from '@/server/auth/password-policy';\nimport { authLink, sendAuthEmail } from '@/server/auth/email';\n\n/**\n * Auth services (C9), Node only. Audit metadata is always explicit and never\n * carries passwords, hashes or raw tokens (FR-31).\n */\n\nconst BCRYPT_COST = 12;\nconst HOUR_MS = 60 * 60_000;\nexport const RESET_REQUESTED_MESSAGE = \"If an account exists for that email, we've sent a reset link.\";\nconst INVALID_LINK = 'This link is invalid or has expired.';\n\n/** FR-16: set the first password from an invite and activate the account. */\nexport async function acceptInvite(input: { token: string; password: string }, request?: Request) {\n  const verified = await verifyToken(input.token, 'INVITE');\n  if (!verified) throw new AppError('INVALID_TOKEN', INVALID_LINK);\n  const { token, user } = verified;\n  assertPasswordAllowed(input.password, user.email);\n  const passwordHash = await bcrypt.hash(input.password, BCRYPT_COST);\n\n  await prisma.$transaction(async (tx) => {\n    await consumeToken(token.id, tx);\n    await tx.user.update({\n      where: { id: user.id },\n      data: { passwordHash, status: 'ACTIVE', passwordChangedAt: new Date() },\n    });\n  });\n  await audit({ actorId: user.id, action: 'auth.invite.accepted', entityType: 'User', entityId: user.id, request });\n  return { email: user.email };\n}\n\n/** FR-19/FR-20: always the same response, whether or not the account exists. */\nexport async function requestPasswordReset(input: { email: string }, request?: Request) {\n  const ip = request ? getClientIp(request) : null;\n  if (!rateLimit(`forgot:ip:${ip ?? 'unknown'}`, 10, HOUR_MS).ok) {\n    throw new AppError('RATE_LIMITED', 'Too many requests. Wait a few minutes and try again.');\n  }\n  const response = { message: RESET_REQUESTED_MESSAGE };\n  if (!rateLimit(`forgot:email:${input.email}`, 3, HOUR_MS).ok) return response;\n\n  const user = await prisma.user.findUnique({\n    where: { email: input.email },\n    select: { id: true, email: true, firstName: true, status: true, archivedAt: true },\n  });\n  if (user && user.status === 'ACTIVE' && !user.archivedAt) {\n    const raw = await createToken(user.id, 'PASSWORD_RESET', { minutes: 60 });\n    await sendAuthEmail(user, 'password-reset', authLink('password-reset', raw));\n    await audit({ actorId: user.id, action: 'auth.password.reset_requested', entityType: 'User', entityId: user.id, request });\n  }\n  return response;\n}\n\n/** FR-21: set a new password from a reset link; also clears any lockout. */\nexport async function resetPassword(input: { token: string; password: string }, request?: Request) {\n  const verified = await verifyToken(input.token, 'PASSWORD_RESET');\n  if (!verified) throw new AppError('INVALID_TOKEN', INVALID_LINK);\n  const { token, user } = verified;\n  assertPasswordAllowed(input.password, user.email);\n  const passwordHash = await bcrypt.hash(input.password, BCRYPT_COST);\n\n  await prisma.$transaction(async (tx) => {\n    await consumeToken(token.id, tx);\n    await tx.user.update({\n      where: { id: user.id },\n      data: { passwordHash, passwordChangedAt: new Date(), failedLoginCount: 0, lockedUntil: null },\n    });\n  });\n  await audit({ actorId: user.id, action: 'auth.password.reset', entityType: 'User', entityId: user.id, request });\n  return { ok: true as const };\n}\n\n/** FR-23: signed-in change; caller refreshes its own session's authTime afterwards. */\nexport async function changePassword(\n  user: { id: string },\n  input: { currentPassword: string; newPassword: string },\n  request?: Request,\n) {\n  const existing = await prisma.user.findUnique({ where: { id: user.id }, select: { email: true, passwordHash: true } });\n  if (!existing) throw new AppError('UNAUTHENTICATED', 'You must be signed in.');\n  const currentOk = existing.passwordHash ? await bcrypt.compare(input.currentPassword, existing.passwordHash) : false;\n  if (!currentOk) {\n    throw new AppError('VALIDATION_ERROR', 'Current password is incorrect.', {\n      fieldErrors: { currentPassword: ['Current password is incorrect.'] },\n    });\n  }\n  assertPasswordAllowed(input.newPassword, existing.email);\n  const passwordHash = await bcrypt.hash(input.newPassword, BCRYPT_COST);\n  await prisma.user.update({ where: { id: user.id }, data: { passwordHash, passwordChangedAt: new Date() } });\n  await audit({ actorId: user.id, action: 'auth.password.changed', entityType: 'User', entityId: user.id, request });\n  return { ok: true as const };\n}\n118:export async function createUser(input: CreateUserInput) {\n172:export async function updateUser(id: string, input: UpdateUserInput) {\n220:export interface ListUsersFilters {\n238:export async function listUsers(filters: ListUsersFilters, pagination: { skip: number; take: number }) {\n276:export async function getUserDetail(id: string) {\n345:export async function setUserStatus(actorId: string, userId: string, status: 'ACTIVE' | 'DISABLED') {\n354:export async function archiveUser(actorId: string, userId: string) {\n365:export async function restoreUser(userId: string) {\n374:export async function unlockUser(userId: string) {\n383:export function createInviteToken(userId: string): Promise<string> {\n392:export async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n395:  const raw = await createInviteToken(userId);\nsrc/server/auth/email.ts:8:export type AuthEmailKind = 'invite' | 'password-reset';\nsrc/server/auth/email.ts:16:export function authLink(kind: AuthEmailKind, rawToken: string): string {\nsrc/server/auth/email.ts:26:export async function sendAuthEmail(\nsrc/server/rate-limit.ts:5:export function rateLimit(\nsrc/server/rate-limit.ts:21:export function __resetRateLimits(): void {\nsrc/lib/logger.ts:17:export const logger = {\nsrc/components/Toast/ToastProvider.tsx:19:export function ToastProvider({ children }: { children: React.ReactNode }) {\nsrc/components/Toast/useToast.ts:6:export interface ToastOptions {\nsrc/components/Toast/useToast.ts:11:export interface ToastContextValue {\nsrc/components/Toast/useToast.ts:15:export const ToastContext = createContext<ToastContextValue | null>(null);\nsrc/components/Toast/useToast.ts:17:export function useToast(): ToastContextValue {\nsrc/components:\nConfirmDialog\nDataTable\nDateDisplay\nEmptyState\nFormField\nLoadingSkeleton\nNotificationBell\nPageHeader\nPasswordChecklist\nStatCard\nToast\nUserAvatar\nUserPicker\n\nsrc/lib:\ndates.ts\nenv.ts\nlogger.ts\nvalidators","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01N2Ssva4yziDeY1Bfet9KqC","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
