{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gn7CqTtSuxmcZJ3SsMV7KP","type":"tool_result","content":"60\t    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n61\t    { status: ERROR_STATUS[code] },\n62\t  );\n63\t}\n64\t\n65\t/**\n66\t * Wraps a route handler, mapping thrown errors to the shared envelope:\n67\t * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n68\t * AppError -> its own code/status\n69\t * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n70\t * anything else -> INTERNAL (500), stack logged, never returned to client\n71\t */\n72\texport function withHandler<Args extends unknown[]>(\n73\t  fn: (...args: Args) => Promise<Response>,\n74\t) {\n75\t  return async (...args: Args): Promise<Response> => {\n76\t    try {\n77\t      return await fn(...args);\n78\t    } catch (error) {\n79\t      if (error instanceof ZodError) {\n80\t        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n81\t      }\n82\t\n83\t      if (error instanceof AppError) {\n84\t        return apiError(error.code, error.message, error.details);\n85\t      }\n86\t\n87\t      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n88\t        if (error.code === 'P2002') {\n89\t          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n90\t        }\n91\t        if (error.code === 'P2025') {\n92\t          return apiError('NOT_FOUND', 'Resource not found');\n93\t        }\n94\t      }\n95\t\n96\t      logger.error('Unhandled error in route handler', {\n97\t        message: error instanceof Error ? error.message : String(error),\n98\t        stack: error instanceof Error ? error.stack : undefined,\n99\t      });\n100\t      return apiError('INTERNAL', 'Internal server error');\n101\t    }\n102\t  };\n103\t}\n104\t\n105\texport interface PaginationParams {\n106\t  page: number;\n107\t  pageSize: number;\n108\t  skip: number;\n109\t  take: number;\n110\t}\n111\t\n112\tconst MAX_PAGE_SIZE = 100;\n113\t\n114\texport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n115\t  const rawPage = Number(searchParams.get('page'));\n116\t  const rawPageSize = Number(searchParams.get('pageSize'));\n117\t\n118\t  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n119\t  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n120\t  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n121\t\n122\t  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n123\t}\n124\t\n125\t// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\n126\texport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n127\t  const json = await request.json().catch(() => ({}));\n128\t  return schema.parse(json);\n129\t}\n130\t\n131\t/** First x-forwarded-for entry (the client, behind our proxy), or null. */\n132\texport function getClientIp(request: Request): string | null {\n133\t  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n134\t}\n135\t\n136\texport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n137\t  return schema.parse(Object.fromEntries(searchParams.entries()));\n138\t}\n139\t=== src/server/auth/course-access.ts\n140\timport { prisma } from '@/server/db';\n141\timport { AppError } from '@/server/http';\n142\timport type { AccessUser } from '@/server/auth/student-access';\n143\t\n144\t/**\n145\t * PRD-05 FR-18. `user` is whatever requireRole(...) resolved (NFR-7 stand-in\n146\t * until PRD-01 lands). NOT_FOUND for a missing course, FORBIDDEN otherwise.\n147\t */\n148\t\n149\tasync function loadCourse(courseId: string) {\n150\t  const course = await prisma.course.findUnique({\n151\t    where: { id: courseId },\n152\t    select: { id: true, teacherId: true, coTeacherIds: true },\n153\t  });\n154\t  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n155\t  return course;\n156\t}\n157\t\n158\tfunction teaches(user: AccessUser, course: { teacherId: string; coTeacherIds: string[] }) {\n159\t  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n160\t}\n161\t\n162\tconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n163\t\n164\texport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n165\t  const course = await loadCourse(courseId);\n166\t\n167\t  switch (user.role) {\n168\t    case 'ADMIN':\n169\t      return;\n170\t    case 'TEACHER':\n171\t      if (teaches(user, course)) return;\n172\t      throw forbidden();\n173\t    case 'STUDENT': {\n174\t      const enrollment = await prisma.enrollment.findFirst({\n175\t        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n176\t        select: { id: true },\n177\t      });\n178\t      if (enrollment) return;\n179\t      throw forbidden();\n180\t    }\n181\t    case 'PARENT': {\n182\t      const enrollment = await prisma.enrollment.findFirst({\n183\t        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n184\t        select: { id: true },\n185\t      });\n186\t      if (enrollment) return;\n187\t      throw forbidden();\n188\t    }\n189\t    default:\n190\t      throw forbidden();\n191\t  }\n192\t}\n193\t\n194\t/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\n195\texport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n196\t  const course = await loadCourse(courseId);\n197\t  if (user.role === 'ADMIN') return;\n198\t  if (user.role === 'TEACHER' && teaches(user, course)) return;\n199\t  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');\n200\t}\n201\t=== src/server/auth/requireRole.ts\n202\timport { cache } from 'react';\n203\timport { headers } from 'next/headers';\n204\timport { redirect } from 'next/navigation';\n205\timport { AppError } from '@/server/http';\n206\timport { auth } from '@/server/auth/auth';\n207\timport type { Role } from '@/config/navigation';\n208\t\n209\t/**\n210\t * Single chokepoint for server-side authorization (FR-28, FR-29, ADR-2).\n211\t * Route handlers use requireUser/requireRole (throw AppError → 401/403 via\n212\t * withHandler); server pages/layouts use requirePageUser/requirePageRole\n213\t * (redirect to /login or /forbidden).\n214\t */\n215\texport interface SessionUser {\n216\t  id: string;\n217\t  role: Role;\n218\t  firstName: string;\n219\t  lastName: string;\n220\t  email: string;\n221\t}\n222\t\n223\texport const getCurrentUser = cache(async (): Promise<SessionUser | null> => {\n224\t  const user = (await auth())?.user;\n225\t  if (!user?.id) return null;\n226\t  return { id: user.id, role: user.role, firstName: user.firstName, lastName: user.lastName, email: user.email };\n227\t});\n228\t\n229\ttype Check = { user: SessionUser } | { error: 'UNAUTHENTICATED' | 'FORBIDDEN' };\n230\t\n231\tasync function resolve(roles: Role[]): Promise<Check> {\n232\t  const user = await getCurrentUser();\n233\t  if (!user) return { error: 'UNAUTHENTICATED' };\n234\t  if (roles.length && !roles.includes(user.role)) return { error: 'FORBIDDEN' };\n235\t  return { user };\n236\t}\n237\t\n238\texport async function requireRole(...roles: Role[]): Promise<SessionUser> {\n239\t  const result = await resolve(roles);\n240\t  if ('user' in result) return result.user;\n241\t  throw result.error === 'UNAUTHENTICATED'\n242\t    ? new AppError('UNAUTHENTICATED', 'You must be signed in.')\n243\t    : new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n244\t}\n245\t\n246\texport async function requireUser(): Promise<SessionUser> {\n247\t  return requireRole();\n248\t}\n249\t\n250\texport async function requirePageRole(...roles: Role[]): Promise<SessionUser> {\n251\t  const result = await resolve(roles);\n252\t  if ('user' in result) return result.user;\n253\t  if (result.error === 'FORBIDDEN') redirect('/forbidden');\n254\t  const callbackUrl = headers().get('x-pathname') ?? '/dashboard';\n255\t  redirect(`/login?callbackUrl=${encodeURIComponent(callbackUrl)}`);\n256\t}\n257\t\n258\texport async function requirePageUser(): Promise<SessionUser> {\n259\t  return requirePageRole();\n260\t}\n261\t=== src/server/auth/student-access.ts\n262\timport { prisma } from '@/server/db';\n263\timport { AppError } from '@/server/http';\n264\timport type { Role } from '@/config/navigation';\n265\t\n266\texport interface AccessUser {\n267\t  id: string;\n268\t  role: Role;\n269\t}\n270\t\n271\texport type AccessibleStudentIds = 'ALL' | string[];\n272\t\n273\t/**\n274\t * FR-17: resolves which student ids `user` may see.\n275\t * - ADMIN: \"ALL\" (every student)\n276\t * - STUDENT: only themselves\n277\t * - PARENT: students linked via ParentStudentLink (component 6)\n278\t * - TEACHER (PRD-05 FR-22): students ACTIVE in courses they teach or\n279\t *   co-teach, plus members of sections they are homeroom teacher of.\n280\t */\n281\texport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n282\t  switch (user.role) {\n283\t    case 'ADMIN':\n284\t      return 'ALL';\n285\t    case 'STUDENT':\n286\t      return [user.id];\n287\t    case 'PARENT': {\n288\t      const links = await prisma.parentStudentLink.findMany({\n289\t        where: { parentId: user.id },\n290\t        select: { studentId: true },\n291\t      });\n292\t      return links.map((link) => link.studentId);\n293\t    }\n294\t    case 'TEACHER': {\n295\t      const [enrolled, members] = await Promise.all([\n296\t        prisma.enrollment.findMany({\n297\t          where: {\n298\t            status: 'ACTIVE',\n299\t            course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] },\n300\t          },\n301\t          select: { studentId: true },\n302\t          distinct: ['studentId'],\n303\t        }),\n304\t        prisma.sectionMember.findMany({\n305\t          where: { section: { homeroomTeacherId: user.id } },\n306\t          select: { studentId: true },\n307\t        }),\n308\t      ]);\n309\t      return [...new Set([...enrolled, ...members].map((row) => row.studentId))];\n310\t    }\n311\t    default:\n312\t      return [];\n313\t  }\n314\t}\n315\t\n316\t/**\n317\t * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n318\t * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n319\t * not allowed to see this particular studentId -- NOT_FOUND rather than\n320\t * FORBIDDEN so existence of another family's student is never revealed.\n321\t * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n322\t * ADMIN; TEACHER is denied students outside their courses/homeroom).\n323\t */\n324\texport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n325\t  const accessible = await getAccessibleStudentIds(user);\n326\t\n327\t  if (accessible === 'ALL') return;\n328\t\n329\t  if (accessible.includes(studentId)) return;\n330\t\n331\t  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n332\t    throw new AppError('NOT_FOUND', 'Resource not found');\n333\t  }\n334\t\n335\t  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n336\t}\n337\t=== src/server/assignments/grading-math.ts\n338\t// Pure and isomorphic (ADR-7): imported by the grading UI for the live preview and by the\n339\t// service for the stored value. No Prisma client import. Decimal comes from Prisma's browser\n340\t// runtime, which bundles decimal.js, so no new dependency is needed (ADR-1); decimal.js itself is\n341\t// only a transitive devDependency here and would not be installed in production.\n342\timport { Decimal } from '@prisma/client/runtime/index-browser.js';\n343\t\n344\texport { Decimal };\n345\texport type DecimalValue = string | number | { toString(): string };\n346\t\n347\tconst DAY_MS = 24 * 60 * 60 * 1000;\n348\t\n349\texport const dec = (v: DecimalValue) => new Decimal(typeof v === 'number' ? v : v.toString());\n350\t\n351\t/** \"14.40\" — the wire and storage form (NFR-1, D5). */\n352\texport const fixed2 = (v: DecimalValue) => dec(v).toDecimalPlaces(2, Decimal.ROUND_HALF_UP).toFixed(2);\n353\t\n354\t/**\n355\t * FR-23: ceil(elapsed / 24 h) on UTC instants, so a DST change in the school timezone does not\n356\t * matter and exactly 24 h late is 1 day (NFR-9). On time (≤ dueAt) is 0.\n357\t */\n358\texport function lateDays(submittedAt: Date, dueAt: Date): number {\n359\t  const ms = submittedAt.getTime() - dueAt.getTime();\n360\t  return ms <= 0 ? 0 : Math.ceil(ms / DAY_MS);\n361\t}\n362\t\n363\t/** FR-30: min(lateDays × perDay, max), the pre-filled penalty percent. */\n364\texport function defaultPenalty(days: number, perDay: DecimalValue, max: DecimalValue): Decimal {\n365\t  return Decimal.min(dec(perDay).mul(days), dec(max));\n366\t}\n367\t\n368\t/** FR-31: raw × (1 − pct/100), rounded half-up to 2 dp. */\n369\texport function computeFinalScore(raw: DecimalValue, penaltyPercent: DecimalValue): Decimal {\n370\t  return dec(raw)\n371\t    .mul(new Decimal(100).minus(dec(penaltyPercent)))\n372\t    .div(100)\n373\t    .toDecimalPlaces(2, Decimal.ROUND_HALF_UP);\n374\t}\n375\t\n376\t/** FR-11: Σ criterion maxPoints. */\n377\texport function rubricTotal(criteria: readonly { maxPoints: DecimalValue }[]): Decimal {\n378\t  return criteria.reduce((sum, c) => sum.plus(dec(c.maxPoints)), new Decimal(0));\n379\t}\n380\t\n381\t/** FR-36: maxPoints, or 120 % of it when extra credit is allowed (raw score only). */\n382\texport function maxRawScore(maxPoints: DecimalValue, allowExtraCredit: boolean): Decimal {\n383\t  return allowExtraCredit ? dec(maxPoints).mul('1.2') : dec(maxPoints);\n384\t}\n385\t\n386\texport type ChipStatus = 'NOT_SUBMITTED' | 'SUBMITTED' | 'LATE' | 'GRADED' | 'RETURNED' | 'EXEMPT';\n387\t\n388\t/** FR-28 roster chip. Exempt wins; then the most advanced state of the submission. */\n389\texport function submissionChipStatus(row: {\n390\t  exempt: boolean;\n391\t  submission: { status: 'SUBMITTED' | 'RETURNED'; gradedAt: Date | string | null; isLate: boolean } | null;\n392\t}): ChipStatus {\n393\t  if (row.exempt) return 'EXEMPT';\n394\t  const s = row.submission;\n395\t  if (!s) return 'NOT_SUBMITTED';\n396\t  if (s.status === 'RETURNED') return 'RETURNED';\n397\t  if (s.gradedAt) return 'GRADED';\n398\t  return s.isLate ? 'LATE' : 'SUBMITTED';\n399\t}\n400\t=== src/server/audit.ts\n401\timport type { Prisma } from '@prisma/client';\n402\timport { prisma } from '@/server/db';\n403\timport { getClientIp } from '@/server/http';\n404\timport { logger } from '@/lib/logger';\n405\t\n406\texport interface AuditInput {\n407\t  actorId?: string | null;\n408\t  action: string;\n409\t  entityType?: string;\n410\t  entityId?: string;\n411\t  metadata?: Record<string, unknown>;\n412\t  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n413\t  request?: Request;\n414\t}\n415\t\n416\t// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\n417\tconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n418\t\n419\t/**\n420\t * Insert-only audit trail, the single writer of AuditLog rows. Every write\n421\t * endpoint calls this after a successful mutation with action\n422\t * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n423\t * write must not fail the request it's recording, so errors are logged\n424\t * and swallowed.\n425\t */\n426\texport async function audit(input: AuditInput): Promise<void> {\n427\t  try {\n428\t    const metadata = input.metadata\n429\t      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n430\t      : undefined;\n431\t    await prisma.auditLog.create({\n432\t      data: {\n433\t        actorId: input.actorId ?? null,\n434\t        action: input.action,\n435\t        entityType: input.entityType,\n436\t        entityId: input.entityId,\n437\t        metadata: metadata as Prisma.InputJsonValue | undefined,\n438\t        ip: input.request ? getClientIp(input.request) : null,\n439\t      },\n440\t    });\n441\t  } catch (error) {\n442\t    logger.error('Failed to write audit log', {\n443\t      action: input.action,\n444\t      error: error instanceof Error ? error.message : String(error),\n445\t    });\n446\t  }\n447\t}\n448\t=== src/server/csv.ts\n449\t/**\n450\t * Single choke point for every CSV-generation path in the app (bulk\n451\t * \"Export CSV\", the import error report). NFR-4: a cell starting with\n452\t * =, +, - or @ is prefixed with a leading apostrophe to neutralise\n453\t * formula injection when the file is opened in a spreadsheet tool.\n454\t */\n455\tconst FORMULA_PREFIX_CHARS = ['=', '+', '-', '@'];\n456\t\n457\texport function escapeCsvCell(value: unknown): string {\n458\t  if (value === null || value === undefined) return '';\n459\t  let cell = String(value);\n460\t\n461\t  if (FORMULA_PREFIX_CHARS.includes(cell[0])) {\n462\t    cell = `'${cell}`;\n463\t  }\n464\t\n465\t  if (/[\",\\n\\r]/.test(cell)) {\n466\t    cell = `\"${cell.replace(/\"/g, '\"\"')}\"`;\n467\t  }\n468\t\n469\t  return cell;\n470\t}\n471\t\n472\t/**\n473\t * Builds a CSV string (header row + one row per record) from an array of\n474\t * flat objects, in the given column order. Every cell goes through\n475\t * escapeCsvCell -- callers never concatenate CSV by hand.\n476\t */\n477\texport function toCsv<T extends object>(columns: { key: string; header: string }[], rows: T[]): string {\n478\t  const headerLine = columns.map((c) => escapeCsvCell(c.header)).join(',');\n479\t  const lines = rows.map((row) =>\n480\t    columns.map((c) => escapeCsvCell((row as Record<string, unknown>)[c.key])).join(','),\n481\t  );\n482\t  return [headerLine, ...lines].join('\\r\\n');\n483\t}\n484\t=== src/server/notifications/types.ts\n485\t/**\n486\t * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n487\t * imports, so validators and client pages can import it. Later PRDs add keys\n488\t * to NOTIFICATION_TYPES; there is no runtime registration API.\n489\t */\n490\texport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n491\t\n492\tconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n493\t\n494\texport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\n495\texport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n496\t\n497\texport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n498\t  ACCOUNT: 'Account',\n499\t  ACADEMIC: 'Academic',\n500\t  ATTENDANCE: 'Attendance',\n501\t  COMMUNICATION: 'Communication',\n502\t  FINANCE: 'Finance',\n503\t  SYSTEM: 'System',\n504\t};\n505\t\n506\texport type NotificationTypeDef = {\n507\t  label: string;\n508\t  description: string;\n509\t  category: NotificationCategory;\n510\t  defaultEmail: boolean;\n511\t  mandatoryInApp: boolean;\n512\t  roles: readonly Role[];\n513\t  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n514\t  emailOnly?: true;\n515\t};\n516\t\n517\texport const NOTIFICATION_TYPES = {\n518\t  'account.invite': {\n519\t    label: 'Account invitation',\n520\t    description: 'Invitation to set up your SchoolHub account.',\n521\t    category: 'ACCOUNT',\n522\t    defaultEmail: true,\n523\t    mandatoryInApp: false,\n524\t    emailOnly: true,\n525\t    roles: ALL,\n526\t  },\n527\t  'account.password_reset': {\n528\t    label: 'Password reset',\n529\t    description: 'Link to reset your password.',\n530\t    category: 'ACCOUNT',\n531\t    defaultEmail: true,\n532\t    mandatoryInApp: false,\n533\t    emailOnly: true,\n534\t    roles: ALL,\n535\t  },\n536\t  'system.test': {\n537\t    label: 'Test notification',\n538\t    description: 'Test messages sent by an administrator.',\n539\t    category: 'SYSTEM',\n540\t    defaultEmail: true,\n541\t    mandatoryInApp: false,\n542\t    roles: ALL,\n543\t  },\n544\t  // PRD-07 attendance (FR-20, FR-23).\n545\t  'attendance.absent': {\n546\t    label: 'Marked absent',\n547\t    description: 'A student was marked absent from a class or the daily register.',\n548\t    category: 'ATTENDANCE',\n549\t    defaultEmail: true,\n550\t    mandatoryInApp: true,\n551\t    roles: ['PARENT', 'STUDENT'],\n552\t  },\n553\t  'attendance.late': {\n554\t    label: 'Marked late',\n555\t    description: 'A student was marked late.',\n556\t    category: 'ATTENDANCE',\n557\t    defaultEmail: false,\n558\t    mandatoryInApp: false,\n559\t    roles: ['PARENT', 'STUDENT'],\n560\t  },\n561\t  'attendance.corrected': {\n562\t    label: 'Attendance corrected',\n563\t    description: 'An absence was corrected to present.',\n564\t    category: 'ATTENDANCE',\n565\t    defaultEmail: false,\n566\t    mandatoryInApp: false,\n567\t    roles: ['PARENT', 'STUDENT'],\n568\t  },\n569\t  'attendance.register_missing': {\n570\t    label: 'Register not taken',\n571\t    description: 'An administrator reminded you to take a register.',\n572\t    category: 'ATTENDANCE',\n573\t    defaultEmail: false,\n574\t    mandatoryInApp: false,\n575\t    roles: ['TEACHER'],\n576\t  },\n577\t  // PRD-08 course content (FR-38). Scheduled lessons never notify (FR-39).\n578\t  'content.lesson_published': {\n579\t    label: 'New lesson published',\n580\t    description: 'A teacher published a new lesson in one of your courses.',\n581\t    category: 'ACADEMIC',\n582\t    defaultEmail: false,\n583\t    mandatoryInApp: false,\n584\t    roles: ['STUDENT'],\n585\t  },\n586\t  // PRD-09 assignments (FR-42..FR-46).\n587\t  'assignment.published': {\n588\t    label: 'New assignment',\n589\t    description: 'A teacher published an assignment in one of your courses.',\n590\t    category: 'ACADEMIC',\n591\t    defaultEmail: false,\n592\t    mandatoryInApp: false,\n593\t    roles: ['STUDENT'],\n594\t  },\n595\t  'assignment.due_soon': {\n596\t    label: 'Assignment due soon',\n597\t    description: 'An assignment you have not submitted is due within 24 hours.',\n598\t    category: 'ACADEMIC',\n599\t    defaultEmail: false,\n600\t    mandatoryInApp: false,\n601\t    roles: ['STUDENT'],\n602\t  },\n603\t  'assignment.returned': {\n604\t    label: 'Assignment returned',\n605\t    description: 'Graded work was returned with a score and feedback.',\n606\t    category: 'ACADEMIC',\n607\t    defaultEmail: false,\n608\t    mandatoryInApp: false,\n609\t    roles: ['STUDENT', 'PARENT'],\n610\t  },\n611\t  'assignment.missing': {\n612\t    label: 'Missing assignment',\n613\t    description: 'Your child has not submitted an assignment that was due over 24 hours ago.',\n614\t    category: 'ACADEMIC',\n615\t    defaultEmail: true,\n616\t    mandatoryInApp: false,\n617\t    roles: ['PARENT'],\n618\t  },\n619\t} as const satisfies Record<string, NotificationTypeDef>;\n620\t\n621\texport type NotificationType = keyof typeof NOTIFICATION_TYPES;\n622\t\n623\tconst entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n624\t\n625\texport function getTypeDef(type: string): NotificationTypeDef | undefined {\n626\t  return Object.prototype.hasOwnProperty.call(NOTIFICATION_TYPES, type)\n627\t    ? (NOTIFICATION_TYPES as Record<string, NotificationTypeDef>)[type]\n628\t    : undefined;\n629\t}\n630\t\n631\t/** Types a role may see and configure (FR-28, FR-37): role match, not emailOnly. */\n632\texport function visibleTypesFor(role: Role): NotificationType[] {\n633\t  return entries.filter(([, def]) => def.roles.includes(role) && !def.emailOnly).map(([key]) => key);\n634\t}\n635\t\n636\t/** Type keys in a category, for the FR-34 list filter. */\n637\texport function typesInCategory(category: NotificationCategory): NotificationType[] {\n638\t  return entries.filter(([, def]) => def.category === category).map(([key]) => key);\n639\t}\n640\t\n641\texport function categoryOf(type: string): NotificationCategory | null {\n642\t  return getTypeDef(type)?.category ?? null;\n643\t}\n644\t=== src/server/files/contexts.ts\n645\timport { prisma } from '@/server/db';\n646\timport { assertCanViewCourse } from '@/server/auth/course-access';\n647\timport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\n648\timport { isAssignmentVisible } from '@/server/assignments/assignments-service';\n649\timport type { FileAccessResolver } from './access';\n650\t\n651\t/**\n652\t * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n653\t * first canAccessFile call, so every caller gets them.\n654\t */\n655\t\n656\t/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\n657\texport const lessonResolver: FileAccessResolver = async (user, file) => {\n658\t  if (!user || !file.contextId) return false;\n659\t  const lesson = await prisma.lesson.findUnique({\n660\t    where: { id: file.contextId },\n661\t    select: {\n662\t      status: true,\n663\t      publishAt: true,\n664\t      module: {\n665\t        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n666\t      },\n667\t    },\n668\t  });\n669\t  if (!lesson) return false;\n670\t  try {\n671\t    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n672\t  } catch {\n673\t    return false;\n674\t  }\n675\t  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n676\t};\n677\t\n678\t/** 'assignment' (PRD-09 FR-47): the caller can view the course and (unless they manage it) the assignment is visible. */\n679\texport const assignmentResolver: FileAccessResolver = async (user, file) => {\n680\t  if (!user || !file.contextId) return false;\n681\t  const a = await prisma.assignment.findUnique({\n682\t    where: { id: file.contextId },\n683\t    select: { status: true, availableFrom: true, archivedAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n684\t  });\n685\t  if (!a) return false;\n686\t  try {\n687\t    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], a.course.id);\n688\t  } catch {\n689\t    return false;\n690\t  }\n691\t  return canSeeDrafts(user, a.course) || isAssignmentVisible(a, new Date());\n692\t};\n693\t\n694\t/**\n695\t * 'submission' (PRD-09 FR-47, NFR-4): the submitting student, their linked parents, or a course\n696\t * manager (ADMIN / teacher / co-teacher). Everyone else, including other students, is denied.\n697\t */\n698\texport const submissionResolver: FileAccessResolver = async (user, file) => {\n699\t  if (!user || !file.contextId) return false;\n700\t  const sub = await prisma.submission.findUnique({\n701\t    where: { id: file.contextId },\n702\t    select: { studentId: true, assignment: { select: { course: { select: { teacherId: true, coTeacherIds: true } } } } },\n703\t  });\n704\t  if (!sub) return false;\n705\t  if (sub.studentId === user.id) return true;\n706\t  if (canSeeDrafts(user, sub.assignment.course)) return true;\n707\t  if (user.role !== 'PARENT') return false;\n708\t  const link = await prisma.parentStudentLink.findFirst({ where: { parentId: user.id, studentId: sub.studentId }, select: { id: true } });\n709\t  return link !== null;\n710\t};\n711\t\n712\t/** 'logo': public, including anonymous (app shell, login page, emails). */\n713\texport const logoResolver: FileAccessResolver = () => true;\n714\t\n715\texport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n716\t  register('lesson', lessonResolver);\n717\t  register('logo', logoResolver);\n718\t  register('assignment', assignmentResolver);\n719\t  register('submission', submissionResolver);\n720\t}\n721\t=== src/app/api/internal/email/dispatch/route.ts\n722\timport { timingSafeEqual } from 'node:crypto';\n723\timport { AppError, ok, withHandler } from '@/server/http';\n724\timport { env } from '@/lib/env';\n725\timport { logger } from '@/lib/logger';\n726\timport { dispatchEmails } from '@/server/email/dispatch';\n727\timport { purgeOldNotifications } from '@/server/notifications/purge';\n728\timport { purgeOrphanFiles } from '@/server/files/purge';\n729\timport { sendDueReminders } from '@/server/assignments/reminders';\n730\t\n731\texport const dynamic = 'force-dynamic';\n732\t\n733\tconst DAY_MS = 24 * 60 * 60_000;\n734\t// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\n735\tlet lastPurgeAt = 0;\n736\t\n737\tfunction authorized(header: string | null): boolean {\n738\t  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n739\t  const given = Buffer.from(header.slice('Bearer '.length));\n740\t  const expected = Buffer.from(env.CRON_SECRET);\n741\t  return given.length === expected.length && timingSafeEqual(given, expected);\n742\t}\n743\t\n744\t/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\n745\texport const POST = withHandler(async (request: Request) => {\n746\t  if (!authorized(request.headers.get('authorization'))) {\n747\t    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n748\t  }\n749\t  const result = await dispatchEmails({ batchSize: 50 });\n750\t\n751\t  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n752\t  try {\n753\t    const reminders = await sendDueReminders(new Date());\n754\t    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n755\t  } catch (error) {\n756\t    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n757\t  }\n758\t\n759\t  if (Date.now() - lastPurgeAt > DAY_MS) {\n760\t    lastPurgeAt = Date.now();\n761\t    try {\n762\t      const purged = await purgeOldNotifications();\n763\t      logger.info('Purged old notifications', { purged });\n764\t    } catch (error) {\n765\t      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n766\t    }\n767\t    try {\n768\t      await purgeOrphanFiles(new Date());\n769\t    } catch (error) {\n770\t      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n771\t    }\n772\t  }\n773\t  return ok(result);\n774\t});\n775\t=== src/config/course-tabs.ts\n776\timport { ALL_ROLES, type Role } from './navigation';\n777\t\n778\texport interface CourseTab {\n779\t  key: string;\n780\t  label: string;\n781\t  href: (courseId: string) => string;\n782\t  roles: Role[];\n783\t}\n784\t\n785\t/**\n786\t * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n787\t * assignments, gradebook...) register their tab here.\n788\t */\n789\texport const courseTabs: CourseTab[] = [\n790\t  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n791\t  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n792\t  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n793\t  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n794\t];\n795\t=== src/server/db.ts\n796\timport { PrismaClient } from '@prisma/client';\n797\t\n798\t/**\n799\t * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n800\t * re-evaluates this module on every edit; without the cache that creates a\n801\t * new PrismaClient (and a new Postgres connection pool) each time until the\n802\t * db runs out of connections. Standard Next.js + Prisma pattern.\n803\t */\n804\tconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n805\t\n806\texport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n807\t\n808\tif (process.env.NODE_ENV !== 'production') {\n809\t  globalForPrisma.prisma = prisma;\n810\t}\n811\t=== src/lib/logger.ts\n812\ttype LogMeta = Record<string, unknown> | undefined;\n813\ttype Level = 'info' | 'warn' | 'error';\n814\t\n815\tconst isProd = process.env.NODE_ENV === 'production';\n816\t\n817\tfunction write(level: Level, message: string, meta?: LogMeta) {\n818\t  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n819\t\n820\t  if (isProd) {\n821\t    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n822\t    return;\n823\t  }\n824\t\n825\t  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n826\t}\n827\t\n828\texport const logger = {\n829\t  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n830\t  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n831\t  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n832\t};\n833\t"}]},"parent_tool_use_id":null,"session_id":"3eb50254-5396-4c9e-84e7-da065a5fc108","uuid":"1a991472-810e-4f9e-9a9c-0d42b47a039b","timestamp":"2026-11-09T07:12:46.360Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/.claude/projects/-Users-ikramaansari-Documents-forge-schoolhub/3eb50254-5396-4c9e-84e7-da065a5fc108/tool-results/btm271ki0.txt","content":"    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\n// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\nexport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\n/** First x-forwarded-for entry (the client, behind our proxy), or null. */\nexport function getClientIp(request: Request): string | null {\n  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n}\n\nexport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\n=== src/server/auth/course-access.ts\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { AccessUser } from '@/server/auth/student-access';\n\n/**\n * PRD-05 FR-18. `user` is whatever requireRole(...) resolved (NFR-7 stand-in\n * until PRD-01 lands). NOT_FOUND for a missing course, FORBIDDEN otherwise.\n */\n\nasync function loadCourse(courseId: string) {\n  const course = await prisma.course.findUnique({\n    where: { id: courseId },\n    select: { id: true, teacherId: true, coTeacherIds: true },\n  });\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  return course;\n}\n\nfunction teaches(user: AccessUser, course: { teacherId: string; coTeacherIds: string[] }) {\n  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n}\n\nconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n\nexport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n\n  switch (user.role) {\n    case 'ADMIN':\n      return;\n    case 'TEACHER':\n      if (teaches(user, course)) return;\n      throw forbidden();\n    case 'STUDENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    case 'PARENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    default:\n      throw forbidden();\n  }\n}\n\n/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\nexport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER' && teaches(user, course)) return;\n  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');\n}\n=== src/server/auth/requireRole.ts\nimport { cache } from 'react';\nimport { headers } from 'next/headers';\nimport { redirect } from 'next/navigation';\nimport { AppError } from '@/server/http';\nimport { auth } from '@/server/auth/auth';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side authorization (FR-28, FR-29, ADR-2).\n * Route handlers use requireUser/requireRole (throw AppError → 401/403 via\n * withHandler); server pages/layouts use requirePageUser/requirePageRole\n * (redirect to /login or /forbidden).\n */\nexport interface SessionUser {\n  id: string;\n  role: Role;\n  firstName: string;\n  lastName: string;\n  email: string;\n}\n\nexport const getCurrentUser = cache(async (): Promise<SessionUser | null> => {\n  const user = (await auth())?.user;\n  if (!user?.id) return null;\n  return { id: user.id, role: user.role, firstName: user.firstName, lastName: user.lastName, email: user.email };\n});\n\ntype Check = { user: SessionUser } | { error: 'UNAUTHENTICATED' | 'FORBIDDEN' };\n\nasync function resolve(roles: Role[]): Promise<Check> {\n  const user = await getCurrentUser();\n  if (!user) return { error: 'UNAUTHENTICATED' };\n  if (roles.length && !roles.includes(user.role)) return { error: 'FORBIDDEN' };\n  return { user };\n}\n\nexport async function requireRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  throw result.error === 'UNAUTHENTICATED'\n    ? new AppError('UNAUTHENTICATED', 'You must be signed in.')\n    : new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n}\n\nexport async function requireUser(): Promise<SessionUser> {\n  return requireRole();\n}\n\nexport async function requirePageRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  if (result.error === 'FORBIDDEN') redirect('/forbidden');\n  const callbackUrl = headers().get('x-pathname') ?? '/dashboard';\n  redirect(`/login?callbackUrl=${encodeURIComponent(callbackUrl)}`);\n}\n\nexport async function requirePageUser(): Promise<SessionUser> {\n  return requirePageRole();\n}\n=== src/server/auth/student-access.ts\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\nexport interface AccessUser {\n  id: string;\n  role: Role;\n}\n\nexport type AccessibleStudentIds = 'ALL' | string[];\n\n/**\n * FR-17: resolves which student ids `user` may see.\n * - ADMIN: \"ALL\" (every student)\n * - STUDENT: only themselves\n * - PARENT: students linked via ParentStudentLink (component 6)\n * - TEACHER (PRD-05 FR-22): students ACTIVE in courses they teach or\n *   co-teach, plus members of sections they are homeroom teacher of.\n */\nexport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n  switch (user.role) {\n    case 'ADMIN':\n      return 'ALL';\n    case 'STUDENT':\n      return [user.id];\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({\n        where: { parentId: user.id },\n        select: { studentId: true },\n      });\n      return links.map((link) => link.studentId);\n    }\n    case 'TEACHER': {\n      const [enrolled, members] = await Promise.all([\n        prisma.enrollment.findMany({\n          where: {\n            status: 'ACTIVE',\n            course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] },\n          },\n          select: { studentId: true },\n          distinct: ['studentId'],\n        }),\n        prisma.sectionMember.findMany({\n          where: { section: { homeroomTeacherId: user.id } },\n          select: { studentId: true },\n        }),\n      ]);\n      return [...new Set([...enrolled, ...members].map((row) => row.studentId))];\n    }\n    default:\n      return [];\n  }\n}\n\n/**\n * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n * not allowed to see this particular studentId -- NOT_FOUND rather than\n * FORBIDDEN so existence of another family's student is never revealed.\n * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN; TEACHER is denied students outside their courses/homeroom).\n */\nexport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n  const accessible = await getAccessibleStudentIds(user);\n\n  if (accessible === 'ALL') return;\n\n  if (accessible.includes(studentId)) return;\n\n  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n    throw new AppError('NOT_FOUND', 'Resource not found');\n  }\n\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n}\n=== src/server/assignments/grading-math.ts\n// Pure and isomorphic (ADR-7): imported by the grading UI for the live preview and by the\n// service for the stored value. No Prisma client import. Decimal comes from Prisma's browser\n// runtime, which bundles decimal.js, so no new dependency is needed (ADR-1); decimal.js itself is\n// only a transitive devDependency here and would not be installed in production.\nimport { Decimal } from '@prisma/client/runtime/index-browser.js';\n\nexport { Decimal };\nexport type DecimalValue = string | number | { toString(): string };\n\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\nexport const dec = (v: DecimalValue) => new Decimal(typeof v === 'number' ? v : v.toString());\n\n/** \"14.40\" — the wire and storage form (NFR-1, D5). */\nexport const fixed2 = (v: DecimalValue) => dec(v).toDecimalPlaces(2, Decimal.ROUND_HALF_UP).toFixed(2);\n\n/**\n * FR-23: ceil(elapsed / 24 h) on UTC instants, so a DST change in the school timezone does not\n * matter and exactly 24 h late is 1 day (NFR-9). On time (≤ dueAt) is 0.\n */\nexport function lateDays(submittedAt: Date, dueAt: Date): number {\n  const ms = submittedAt.getTime() - dueAt.getTime();\n  return ms <= 0 ? 0 : Math.ceil(ms / DAY_MS);\n}\n\n/** FR-30: min(lateDays × perDay, max), the pre-filled penalty percent. */\nexport function defaultPenalty(days: number, perDay: DecimalValue, max: DecimalValue): Decimal {\n  return Decimal.min(dec(perDay).mul(days), dec(max));\n}\n\n/** FR-31: raw × (1 − pct/100), rounded half-up to 2 dp. */\nexport function computeFinalScore(raw: DecimalValue, penaltyPercent: DecimalValue): Decimal {\n  return dec(raw)\n    .mul(new Decimal(100).minus(dec(penaltyPercent)))\n    .div(100)\n    .toDecimalPlaces(2, Decimal.ROUND_HALF_UP);\n}\n\n/** FR-11: Σ criterion maxPoints. */\nexport function rubricTotal(criteria: readonly { maxPoints: DecimalValue }[]): Decimal {\n  return criteria.reduce((sum, c) => sum.plus(dec(c.maxPoints)), new Decimal(0));\n}\n\n/** FR-36: maxPoints, or 120 % of it when extra credit is allowed (raw score only). */\nexport function maxRawScore(maxPoints: DecimalValue, allowExtraCredit: boolean): Decimal {\n  return allowExtraCredit ? dec(maxPoints).mul('1.2') : dec(maxPoints);\n}\n\nexport type ChipStatus = 'NOT_SUBMITTED' | 'SUBMITTED' | 'LATE' | 'GRADED' | 'RETURNED' | 'EXEMPT';\n\n/** FR-28 roster chip. Exempt wins; then the most advanced state of the submission. */\nexport function submissionChipStatus(row: {\n  exempt: boolean;\n  submission: { status: 'SUBMITTED' | 'RETURNED'; gradedAt: Date | string | null; isLate: boolean } | null;\n}): ChipStatus {\n  if (row.exempt) return 'EXEMPT';\n  const s = row.submission;\n  if (!s) return 'NOT_SUBMITTED';\n  if (s.status === 'RETURNED') return 'RETURNED';\n  if (s.gradedAt) return 'GRADED';\n  return s.isLate ? 'LATE' : 'SUBMITTED';\n}\n=== src/server/audit.ts\nimport type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { getClientIp } from '@/server/http';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n  request?: Request;\n}\n\n// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\nconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    const metadata = input.metadata\n      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n      : undefined;\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: metadata as Prisma.InputJsonValue | undefined,\n        ip: input.request ? getClientIp(input.request) : null,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n=== src/server/csv.ts\n/**\n * Single choke point for every CSV-generation path in the app (bulk\n * \"Export CSV\", the import error report). NFR-4: a cell starting with\n * =, +, - or @ is prefixed with a leading apostrophe to neutralise\n * formula injection when the file is opened in a spreadsheet tool.\n */\nconst FORMULA_PREFIX_CHARS = ['=', '+', '-', '@'];\n\nexport function escapeCsvCell(value: unknown): string {\n  if (value === null || value === undefined) return '';\n  let cell = String(value);\n\n  if (FORMULA_PREFIX_CHARS.includes(cell[0])) {\n    cell = `'${cell}`;\n  }\n\n  if (/[\",\\n\\r]/.test(cell)) {\n    cell = `\"${cell.replace(/\"/g, '\"\"')}\"`;\n  }\n\n  return cell;\n}\n\n/**\n * Builds a CSV string (header row + one row per record) from an array of\n * flat objects, in the given column order. Every cell goes through\n * escapeCsvCell -- callers never concatenate CSV by hand.\n */\nexport function toCsv<T extends object>(columns: { key: string; header: string }[], rows: T[]): string {\n  const headerLine = columns.map((c) => escapeCsvCell(c.header)).join(',');\n  const lines = rows.map((row) =>\n    columns.map((c) => escapeCsvCell((row as Record<string, unknown>)[c.key])).join(','),\n  );\n  return [headerLine, ...lines].join('\\r\\n');\n}\n=== src/server/notifications/types.ts\n/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'system.test': {\n    label: 'Test notification',\n    description: 'Test messages sent by an administrator.',\n    category: 'SYSTEM',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  // PRD-07 attendance (FR-20, FR-23).\n  'attendance.absent': {\n    label: 'Marked absent',\n    description: 'A student was marked absent from a class or the daily register.',\n    category: 'ATTENDANCE',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.late': {\n    label: 'Marked late',\n    description: 'A student was marked late.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.corrected': {\n    label: 'Attendance corrected',\n    description: 'An absence was corrected to present.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.register_missing': {\n    label: 'Register not taken',\n    description: 'An administrator reminded you to take a register.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['TEACHER'],\n  },\n  // PRD-08 course content (FR-38). Scheduled lessons never notify (FR-39).\n  'content.lesson_published': {\n    label: 'New lesson published',\n    description: 'A teacher published a new lesson in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  // PRD-09 assignments (FR-42..FR-46).\n  'assignment.published': {\n    label: 'New assignment',\n    description: 'A teacher published an assignment in one of your courses.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.due_soon': {\n    label: 'Assignment due soon',\n    description: 'An assignment you have not submitted is due within 24 hours.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT'],\n  },\n  'assignment.returned': {\n    label: 'Assignment returned',\n    description: 'Graded work was returned with a score and feedback.',\n    category: 'ACADEMIC',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  'assignment.missing': {\n    label: 'Missing assignment',\n    description: 'Your child has not submitted an assignment that was due over 24 hours ago.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['PARENT'],\n  },\n} as const satisfies Record<string, NotificationTypeDef>;\n\nexport type NotificationType = keyof typeof NOTIFICATION_TYPES;\n\nconst entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n\nexport function getTypeDef(type: string): NotificationTypeDef | undefined {\n  return Object.prototype.hasOwnProperty.call(NOTIFICATION_TYPES, type)\n    ? (NOTIFICATION_TYPES as Record<string, NotificationTypeDef>)[type]\n    : undefined;\n}\n\n/** Types a role may see and configure (FR-28, FR-37): role match, not emailOnly. */\nexport function visibleTypesFor(role: Role): NotificationType[] {\n  return entries.filter(([, def]) => def.roles.includes(role) && !def.emailOnly).map(([key]) => key);\n}\n\n/** Type keys in a category, for the FR-34 list filter. */\nexport function typesInCategory(category: NotificationCategory): NotificationType[] {\n  return entries.filter(([, def]) => def.category === category).map(([key]) => key);\n}\n\nexport function categoryOf(type: string): NotificationCategory | null {\n  return getTypeDef(type)?.category ?? null;\n}\n=== src/server/files/contexts.ts\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport { isAssignmentVisible } from '@/server/assignments/assignments-service';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'assignment' (PRD-09 FR-47): the caller can view the course and (unless they manage it) the assignment is visible. */\nexport const assignmentResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const a = await prisma.assignment.findUnique({\n    where: { id: file.contextId },\n    select: { status: true, availableFrom: true, archivedAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n  });\n  if (!a) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], a.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, a.course) || isAssignmentVisible(a, new Date());\n};\n\n/**\n * 'submission' (PRD-09 FR-47, NFR-4): the submitting student, their linked parents, or a course\n * manager (ADMIN / teacher / co-teacher). Everyone else, including other students, is denied.\n */\nexport const submissionResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const sub = await prisma.submission.findUnique({\n    where: { id: file.contextId },\n    select: { studentId: true, assignment: { select: { course: { select: { teacherId: true, coTeacherIds: true } } } } },\n  });\n  if (!sub) return false;\n  if (sub.studentId === user.id) return true;\n  if (canSeeDrafts(user, sub.assignment.course)) return true;\n  if (user.role !== 'PARENT') return false;\n  const link = await prisma.parentStudentLink.findFirst({ where: { parentId: user.id, studentId: sub.studentId }, select: { id: true } });\n  return link !== null;\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n  register('assignment', assignmentResolver);\n  register('submission', submissionResolver);\n}\n=== src/app/api/internal/email/dispatch/route.ts\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\nimport { sendDueReminders } from '@/server/assignments/reminders';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n  try {\n    const reminders = await sendDueReminders(new Date());\n    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n  } catch (error) {\n    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\n=== src/config/course-tabs.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\n=== src/server/db.ts\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\n=== src/lib/logger.ts\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};\n","numLines":774,"startLine":60,"totalLines":833}},"tool_result_meta":[{"id":"toolu_01Gn7CqTtSuxmcZJ3SsMV7KP","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
