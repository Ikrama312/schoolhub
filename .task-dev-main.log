{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jew6YigjrndZu8y9BP79kv","type":"tool_result","content":"{\n  \"ticketId\": \"abcd-05\",\n  \"timestamp\": \"2026-10-27T00:00:00Z\",\n  \"phase\": \"intake\",\n  \"version\": \"1.0\",\n\n  \"functionalRequirements\": [\n    { \"id\": \"FR-1\",  \"description\": \"Add Prisma models Section, SectionMember, Course and Enrollment, plus enums CourseKind (CORE/ELECTIVE) and EnrollmentStatus (ACTIVE/DROPPED), exactly per the schema block given, including the @@unique([academicYearId, name]) on Section, @@unique([studentId, academicYearId]) on SectionMember, @@unique([academicYearId, code]) on Course and @@unique([courseId, studentId]) + @@index([studentId, status]) on Enrollment.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 Data model\" },\n    { \"id\": \"FR-2\",  \"description\": \"Build /admin/sections: filtered by academic year (defaults to current, reusing the existing AcademicYear model), with a table of name, grade level, homeroom teacher, room, members/capacity (warning colour at >=90%), and course count.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1\" },\n    { \"id\": \"FR-3\",  \"description\": \"Section create/edit dialog: grade level, name, homeroom teacher (UserPicker filtered to role=TEACHER — the existing src/components/UserPicker already supports a role filter), room, capacity; a teacher may be homeroom teacher of at most one section per academic year.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.2; verified against existing src/components/UserPicker/UserPicker.tsx which already accepts a `role` prop\" },\n    { \"id\": \"FR-4\",  \"description\": \"Build /admin/sections/[id]: members table with add (multi-select student picker filtered to the section's grade level and to students without a section this year) and remove; the section's course list; a 'Create core courses' button.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.3\" },\n    { \"id\": \"FR-5\",  \"description\": \"'Create core courses' dialog: lists all active (non-archived) subjects with a checkbox and a teacher picker per subject; submitting creates one CORE course per checked subject with the default name/code pattern and enrolls all current section members in each created course.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.4\" },\n    { \"id\": \"FR-6\",  \"description\": \"'Copy sections to next year' action on /admin/sections, enabled only when a non-current, future academic year exists; copies section name, grade level advanced to the next GradeLevel by `order`, room and capacity, without members or teacher assignments.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.5\" },\n    { \"id\": \"FR-7\",  \"description\": \"Auto-enroll on section add: adding a student to a section enrolls them ACTIVE in every non-archived CORE course of that section; a previously DROPPED enrollment in one of those courses is reactivated rather than duplicated.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1\" },\n    { \"id\": \"FR-8\",  \"description\": \"Auto-drop on section removal: removing a student from a section sets every ACTIVE enrollment in that section's CORE courses to DROPPED with droppedAt = now; elective enrollments are left untouched.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.2\" },\n    { \"id\": \"FR-9\",  \"description\": \"'Move to section…' single action performs the FR-7 enroll and FR-8 drop steps for the destination/source sections in one database transaction, exposed via POST /api/students/:id/move-section.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.3; API table row POST /api/students/:id/move-section\" },\n    { \"id\": \"FR-10\", \"description\": \"Creating a new CORE course on a section enrolls all of that section's current members (ACTIVE) in the new course.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.4\" },\n    { \"id\": \"FR-11\", \"description\": \"Capacity enforcement: adding a student beyond section or course capacity is refused with a CONFLICT error, message pattern 'Section 7A is full (30/30).', unless the admin explicitly ticks 'Override capacity'.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.5; Acceptance Criteria #4\" },\n    { \"id\": \"FR-12\", \"description\": \"Dropped enrollments retain all historical data (attendance, grades) visible to admins and teachers, but dropped students disappear from active rosters and from add-student pickers.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.6\" },\n    { \"id\": \"FR-13\", \"description\": \"Build /admin/courses: filters for academic year, grade level, subject, teacher, kind, and free-text search by name/code; table of code, name, subject colour chip (reusing Subject.color, already on the model), section, teacher, enrolled count, kind.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.1; verified Subject.color already exists on the Subject model in prisma/schema.prisma\" },\n    { \"id\": \"FR-14\", \"description\": \"Course create/edit dialog: subject, section (optional, required when kind=CORE), teacher, up to 3 co-teachers, name, code (auto-filled from subject+section, editable, forced uppercase), kind, capacity, description.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.2\" },\n    { \"id\": \"FR-15\", \"description\": \"Build /admin/courses/[id]/enrollment: enrolled-students table with drop/reactivate row actions and an 'Add students' picker; for CORE courses show an info note that membership is managed via the section instead.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.3\" },\n    { \"id\": \"FR-16\", \"description\": \"Build the /courses/[courseId] header: subject colour band, course name, code, teacher(s) (including co-teachers), section, room.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.1\" },\n    { \"id\": \"FR-17\", \"description\": \"Add a course-tabs registry at src/config/course-tabs.ts (same shape as the existing src/config/student-tabs.ts, with a `roles` field) rendered as a scrollable MUI Tabs on the course home page; this PRD registers 'Overview' (description/teachers/counts, all roles that can view the course) and 'Roster' (TEACHER/ADMIN: full student list with avatar/name/admission number/link to student page/status; STUDENT: classmates' names only; PARENT: tab not shown).\", \"confidence\": \"HIGH\", \"source\": \"FR-5.2; verified against the existing (empty) src/config/student-tabs.ts pattern this PRD is told to mirror\" },\n    { \"id\": \"FR-18\", \"description\": \"Add src/server/auth/course-access.ts exporting assertCanViewCourse(user, courseId) (ADMIN: all; TEACHER: teacher or co-teacher; STUDENT: has an ACTIVE enrollment; PARENT: any linked child has an ACTIVE enrollment) and assertCanManageCourse(user, courseId) (ADMIN, teacher, co-teacher) for later write operations.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.3\" },\n    { \"id\": \"FR-19\", \"description\": \"Build /my-courses: TEACHER sees MUI Cards in a responsive Grid for each non-archived course they teach/co-teach this year (name, section, enrolled count); STUDENT sees cards for their ACTIVE enrollments (name, teacher); PARENT sees the same cards grouped by child.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1\" },\n    { \"id\": \"FR-20\", \"description\": \"Add sidebar nav entries: 'My courses' for TEACHER/STUDENT/PARENT, and 'Sections'/'Courses' grouped under an 'Administration' section for ADMIN. NavItem currently has no grouping field — src/config/navigation.ts (verified) is a flat array with only Dashboard/Notifications/Email log entries and no 'group' concept, and no admin-facing pages exist yet for the PRD-02/PRD-03 entities (academic years, subjects, rooms, grade levels, users) that would also belong in such a group. The Architect must decide whether to add a lightweight `group` field to NavItem now or ship Sections/Courses as flat entries until a dedicated admin-nav grouping PRD lands.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-6.2; cross-checked against the current flat src/config/navigation.ts and the absence of an 'Administration' grouping or admin pages anywhere under src/app/(app)\" },\n    { \"id\": \"FR-21\", \"description\": \"Register student tab 'Courses' in src/config/student-tabs.ts (visible to every role that can view the student): a table of the student's courses this year with teacher and enrollment status, plus their section and homeroom teacher.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.1\" },\n    { \"id\": \"FR-22\", \"description\": \"Extend the existing getAccessibleStudentIds(user) in src/server/auth/student-access.ts so a TEACHER additionally gets students with ACTIVE enrollments in courses they teach or co-teach, plus members of the section they are homeroom teacher of.\", \"confidence\": \"HIGH\", \"source\": \"FR-8.1; verified getAccessibleStudentIds already exists and is exported from src/server/auth/student-access.ts\" },\n    { \"id\": \"FR-23\", \"description\": \"Expose the full REST surface from the API table: sections CRUD + members + move-section + core-courses + copy-to-year; courses CRUD + roster + enrollments + enrollment status PATCH; GET /api/me/courses — each with the role gating shown in the table and the existing success/list/error response envelope and pagination/sort/search query conventions.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },\n    { \"id\": \"FR-24\", \"description\": \"Every write (section.*, course.*, enrollment.*) records an AuditLog row via the existing audit() helper.\", \"confidence\": \"HIGH\", \"source\": \"API table footnote 'All writes audit (section.*, course.*, enrollment.*)'; verified audit() already exists and is exported from src/server/audit.ts\" }\n  ],\n  \"nonFunctionalRequirements\": [\n    { \"id\": \"NFR-1\", \"description\": \"Material UI only: every visible element in the section/course/enrollment screens is built from @mui/material, @mui/icons-material or the MUI X packages (DataGrid via the existing shared DataTable, Autocomplete, Tabs, Dialog, Drawer, Snackbar+Alert via useToast()); every component looked up via the MUI MCP server before use; no banned libraries (Tailwind, shadcn/ui, Radix, react-select, etc.) in this PRD's code.\", \"confidence\": \"HIGH\", \"source\": \"UI component rule (mandatory, applies to every screen in this PRD); Compliance Rule 6\" },\n    { \"id\": \"NFR-2\", \"description\": \"Integrity: the one-section-per-student-per-year rule is enforced by the database unique constraint (@@unique([studentId, academicYearId]) on SectionMember), not only in application code.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements #1\" },\n    { \"id\": \"NFR-3\", \"description\": \"Performance: adding 30 students to a section with 8 core courses (240 resulting enrollments) completes in under 1 second.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements #2\" },\n    { \"id\": \"NFR-4\", \"description\": \"Privacy: on the course Roster tab and GET /api/courses/:id/roster, students see classmates' names only — no emails, admission numbers or profile links in the response.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements #3; Acceptance Criteria #7\" },\n    { \"id\": \"NFR-5\", \"description\": \"Keep all existing tests passing (npm run lint && npm run typecheck && npm run test) and add the unit/integration/Playwright tests listed in Test Requirements.\", \"confidence\": \"HIGH\", \"source\": \"Assumptions and constraints; Test Requirements\" },\n    { \"id\": \"NFR-6\", \"description\": \"Scope containment: no timetable slots (PRD-06), no course content (PRD-08), no prerequisite or course-request workflows, and no automatic year-to-year student promotion — only the manual 'Copy sections to next year' shortcut.\", \"confidence\": \"HIGH\", \"source\": \"Out of Scope\" },\n    { \"id\": \"NFR-7\", \"description\": \"Server-side authorization gap carried forward from PRD-01/PRD-04: the Platform Context describes src/server/auth/permissions.ts exposing requireUser()/requireRole(...roles), but only src/server/auth/requireRole.ts and student-access.ts exist today (no permissions.ts, no requireUser()). New route handlers in this PRD must use the existing requireRole(...ALL_ROLES)-style stand-in (as PRD-04's handoff also flagged) rather than invent a new auth helper, until PRD-01 lands.\", \"confidence\": \"MEDIUM\", \"source\": \"Platform Context > Code layout conventions (server-side access enforcement), cross-checked against the current contents of src/server/auth/ (only requireRole.ts and student-access.ts present)\" }\n  ],\n  \"overallConfidencePct\": 97,\n  \"clarificationLog\": [],\n  \"status\": \"complete\"\n}\n{\n  \"ticketId\": \"abcd-05\",\n  \"timestamp\": \"2026-10-27T00:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md (REST API surface + Data Flow) and 05-classes-enrollment.md's API table; 17 endpoints (the table's '·'-joined rows are expanded). Conventions shared by every endpoint, not repeated per entry: (1) every handler is wrapped in withHandler() from src/server/http.ts, which maps ZodError->VALIDATION_ERROR 400, AppError->its code, Prisma P2002->CONFLICT 409, P2025->NOT_FOUND 404; (2) success = ok() -> { data }, lists = paginated() -> { data: [...], meta: { page, pageSize, total } } — the real helper nests pagination under `meta`, unlike the PRD's flat example; follow the helper; (3) list query conventions: page (default 1), pageSize (default 20, max 100), sort, order=asc|desc, q; (4) auth: every route calls requireRole(...) from src/server/auth/requireRole.ts (NFR-7 stand-in; no permissions.ts/requireUser()); course-scoped reads additionally call assertCanViewCourse from src/server/auth/course-access.ts (FR-18); (5) every write calls audit() inside the same $transaction (FR-24) via the service/engine, never at the route layer; (6) handlers are thin: zod parse -> one service call -> envelope. Shared shapes are named under `schemas` and referenced as \\\"$ref\\\": \\\"#/schemas/<Name>\\\".\",\n\n  \"schemas\": {\n    \"Section\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevel\": { \"id\": \"string\", \"name\": \"string\", \"order\": \"number\" },\n      \"name\": \"string\", \"homeroomTeacherId\": \"string|null\", \"homeroomTeacher\": { \"id\": \"string\", \"name\": \"string\" },\n      \"roomId\": \"string|null\", \"room\": { \"id\": \"string\", \"name\": \"string\" }, \"capacity\": \"number (1-60)\",\n      \"memberCount\": \"number\", \"courseCount\": \"number\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"SectionInput\": {\n      \"academicYearId\": \"string (required on create)\", \"gradeLevelId\": \"string\", \"name\": \"string (min 1)\",\n      \"homeroomTeacherId\": \"string|null (must be role=TEACHER; at most one section per teacher per year -> CONFLICT)\",\n      \"roomId\": \"string|null\", \"capacity\": \"int 1-60, default 30\"\n    },\n    \"Course\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"subjectId\": \"string\", \"subject\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"color\": \"string\" },\n      \"sectionId\": \"string|null\", \"section\": { \"id\": \"string\", \"name\": \"string\", \"room\": { \"id\": \"string\", \"name\": \"string\" } },\n      \"teacherId\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" }, \"coTeacherIds\": \"string[]\", \"coTeachers\": [{ \"id\": \"string\", \"name\": \"string\" }],\n      \"name\": \"string\", \"code\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"description\": \"string|null\", \"capacity\": \"number|null\",\n      \"archivedAt\": \"ISO 8601|null\", \"enrolledCount\": \"number (ACTIVE only)\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"CourseInput\": {\n      \"academicYearId\": \"string (required on create)\", \"subjectId\": \"string\", \"sectionId\": \"string|null (required iff kind=CORE — single zod refinement shared with the dialog, FR-14)\",\n      \"teacherId\": \"string (role=TEACHER)\", \"coTeacherIds\": \"string[] (max 3, role=TEACHER)\", \"name\": \"string (default '<Subject> – <Section>')\",\n      \"code\": \"string (default '<SUBJECTCODE>-<SECTION>', transformed to uppercase; unique per year -> CONFLICT)\", \"kind\": \"CORE|ELECTIVE (default CORE)\",\n      \"capacity\": \"int>=1|null\", \"description\": \"string|null\"\n    },\n    \"Enrollment\": {\n      \"id\": \"string\", \"courseId\": \"string\", \"studentId\": \"string\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\" },\n      \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\"\n    },\n    \"EnrollStudentsInput\": { \"studentIds\": \"string[] (min 1)\", \"overrideCapacity\": \"boolean (optional, default false)\" },\n    \"EnrollResult\": { \"enrolled\": \"number (new ACTIVE rows)\", \"reactivated\": \"number (DROPPED->ACTIVE)\", \"alreadyActive\": \"number\" },\n    \"CapacityConflict\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Section 7A is full (30/30). | Course MATH-7A is full (30/30).\" } }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/sections\",\n      \"description\": \"List sections for an academic year (defaults to current). Roles: ADMIN, TEACHER. Service: sections-service.listSections.\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, defaults to current AcademicYear)\", \"gradeLevelId\": \"string (optional)\", \"q\": \"string (optional, name search)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"name|gradeLevel|memberCount (default gradeLevel)\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Section\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } }, \"403\": \"FORBIDDEN (STUDENT/PARENT)\" },\n      \"requirementIds\": [\"FR-2\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections\",\n      \"description\": \"Create a section. Role: ADMIN. Homeroom-teacher-per-year check runs inside the write transaction (system-design Decision 3). Audits section.create.\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/SectionInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"409\": \"CONFLICT — duplicate name in year (P2002), or teacher already homeroom of another section this year\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Update a section (partial SectionInput, academicYearId immutable). Role: ADMIN. Capacity may not be lowered below current memberCount. Audits section.update.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<SectionInput> without academicYearId\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (name/homeroom uniqueness)\", \"400\": \"VALIDATION_ERROR (capacity < memberCount)\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Delete a section. Role: ADMIN. Allowed only when it has no members and no courses. Audits section.delete.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"id\": \"string\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT — 'Section 7A still has members or courses.'\" },\n      \"requirementIds\": [\"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/members\",\n      \"description\": \"Add students to a section and auto-enroll them ACTIVE in every non-archived CORE course of the section (reactivating DROPPED rows), all in one $transaction via roster-engine.enrollSectionCoreCourses with batched createMany/updateMany. Role: ADMIN. Audits section.member.add + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": {\n        \"201\": { \"data\": { \"added\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Sam Student is already in section 7A for 2026–2027.' (SectionMember @@unique P2002, mapped to the friendly message by the service)\"],\n        \"400\": \"VALIDATION_ERROR — student not role=STUDENT or wrong grade level\", \"404\": \"NOT_FOUND\"\n      },\n      \"requirementIds\": [\"FR-4\", \"FR-7\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-2\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id/members/:studentId\",\n      \"description\": \"Remove a student from a section; their ACTIVE enrollments in this section's CORE courses become DROPPED with droppedAt=now (electives untouched) via roster-engine.dropSectionCoreCourses, same transaction. Role: ADMIN. Audits section.member.remove + enrollment.drop.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\", \"studentId\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"removed\": true, \"droppedEnrollments\": \"number\" } }, \"404\": \"NOT_FOUND (student not a member)\" },\n      \"requirementIds\": [\"FR-4\", \"FR-8\", \"FR-12\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/students/:id/move-section\",\n      \"description\": \"Move a student to another section of the same academic year in a single $transaction: remove membership + drop source CORE enrollments, add membership + enroll/reactivate destination CORE enrollments (roster-engine.moveStudentSection). Electives unchanged. Role: ADMIN. Audits section.member.move + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string (studentId)\" }, \"body\": { \"toSectionId\": \"string\", \"overrideCapacity\": \"boolean (optional, default false)\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"fromSectionId\": \"string\", \"toSectionId\": \"string\", \"dropped\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }],\n        \"400\": \"VALIDATION_ERROR — destination in a different academic year, or same as source\", \"404\": \"NOT_FOUND — student has no section this year, or toSectionId unknown\"\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-7\", \"FR-8\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/core-courses\",\n      \"description\": \"Bulk-create one CORE course per item (default name '<Subject> – <Section>', code '<SUBJECTCODE>-<SECTION>') and enroll all current section members in each, one $transaction. Subjects must be non-archived. Role: ADMIN. Audits course.create + enrollment.* per course.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"items\": [{ \"subjectId\": \"string\", \"teacherId\": \"string (role=TEACHER)\" }], \"_constraints\": \"items min 1, subjectIds unique\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"courses\": [{ \"$ref\": \"#/schemas/Course\" }], \"enrollmentsCreated\": \"number\" } }, \"409\": \"CONFLICT — course code already exists this year (P2002)\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-5\", \"FR-10\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/copy-to-year\",\n      \"description\": \"Structural copy of all sections from one year to a future, non-current year: name, room, capacity copied; gradeLevel advanced to the next GradeLevel by `order` (sections at the top grade are skipped); no members, no homeroom teacher, no courses. Role: ADMIN. Audits section.create per copy.\",\n      \"requestSchema\": { \"body\": { \"fromYearId\": \"string\", \"toYearId\": \"string (must be a future, non-current AcademicYear)\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"created\": \"number\", \"skipped\": [{ \"name\": \"string\", \"reason\": \"no next grade level | name already exists in target year\" }] } }, \"400\": \"VALIDATION_ERROR — toYearId is current or not in the future\" },\n      \"requirementIds\": [\"FR-6\", \"FR-23\", \"FR-24\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses\",\n      \"description\": \"List courses. ADMIN sees all; TEACHER sees courses they teach/co-teach; STUDENT/PARENT see courses with an ACTIVE enrollment for self/linked child (scoping done in courses-service, not by client filter). Excludes archived unless includeArchived=true (ADMIN only).\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, default current)\", \"gradeLevelId\": \"string\", \"subjectId\": \"string\", \"teacherId\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"sectionId\": \"string\", \"includeArchived\": \"boolean\", \"q\": \"string (name/code)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"code|name|enrolledCount\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Course\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"requirementIds\": [\"FR-13\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses\",\n      \"description\": \"Create a course. Role: ADMIN. A new CORE course on a section enrolls all current section members ACTIVE in the same transaction (FR-10). Audits course.create (+ enrollment.* if CORE).\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/CourseInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"409\": \"CONFLICT — code already used this year\", \"400\": \"VALIDATION_ERROR — e.g. kind=CORE without sectionId, >3 coTeachers\" },\n      \"requirementIds\": [\"FR-14\", \"FR-10\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Update a course (partial CourseInput; academicYearId/sectionId/kind immutable after creation to avoid silent roster rewrites). Archive via { archived: true } (sets archivedAt), unarchive via { archived: false }. Role: ADMIN. Audits course.update / course.archive.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<CourseInput> without academicYearId/sectionId/kind, plus archived?: boolean\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (code)\", \"400\": \"VALIDATION_ERROR (capacity < enrolledCount)\" },\n      \"requirementIds\": [\"FR-14\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Course header/overview data for /courses/[courseId]. Gated by assertCanViewCourse (ADMIN all; TEACHER teacher/co-teacher; STUDENT ACTIVE enrollment; PARENT linked child ACTIVE enrollment).\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"403\": \"FORBIDDEN\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\", \"FR-23\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/roster\",\n      \"description\": \"Course roster, ACTIVE enrollments by default. Gated by assertCanViewCourse; PARENT gets FORBIDDEN (Roster tab not shown). Shape from courses-service.getCourseRoster(id, viewerRole) — the same function the Roster tab server component uses.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"query\": { \"status\": \"ACTIVE|DROPPED|ALL (default ACTIVE; DROPPED/ALL only for ADMIN/TEACHER)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"q\": \"string\" } },\n      \"responseSchema\": {\n        \"200 (ADMIN, TEACHER)\": { \"data\": [{ \"enrollmentId\": \"string\", \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\", \"profileUrl\": \"/students/:id\" } }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },\n        \"200 (STUDENT)\": { \"data\": [{ \"name\": \"string\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" }, \"_privacy\": \"Projection is names only — no ids, emails, admission numbers, avatars or profile links; status forced to ACTIVE (NFR-4)\" },\n        \"403\": \"FORBIDDEN (no view access, or PARENT)\"\n      },\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-12\", \"FR-23\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/enrollments\",\n      \"description\": \"Enroll students directly in a course (create or reactivate DROPPED; same semantics as the roster engine helper). Role: ADMIN. Refused for CORE courses (membership is managed via the section). Capacity checked via checkCapacityOrThrow. Audits enrollment.create / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/EnrollResult\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Core course enrollment is managed via section 7A.'\"], \"400\": \"VALIDATION_ERROR — non-student ids\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/enrollments/:id\",\n      \"description\": \"Drop or reactivate a single enrollment (DROPPED sets droppedAt=now; ACTIVE clears it and runs checkCapacityOrThrow). Historical data is retained either way. Role: ADMIN. Audits enrollment.drop / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"status\": \"ACTIVE|DROPPED\", \"overrideCapacity\": \"boolean (optional, only meaningful for ACTIVE)\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Enrollment\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }], \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-12\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/courses\",\n      \"description\": \"Current user's courses for /my-courses, current academic year, non-archived. TEACHER: taught/co-taught; STUDENT: ACTIVE enrollments; PARENT: grouped by linked child; ADMIN: empty list (admins use /admin/courses). Role: any (requireRole(...ALL_ROLES), NFR-7 stand-in identity).\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"200 (TEACHER)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"section\": { \"id\": \"string\", \"name\": \"string\" }, \"enrolledCount\": \"number\" }] },\n        \"200 (STUDENT)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] },\n        \"200 (PARENT)\": { \"data\": [{ \"child\": { \"id\": \"string\", \"name\": \"string\" }, \"courses\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] }] }\n      },\n      \"requirementIds\": [\"FR-19\", \"FR-23\", \"NFR-7\"]\n    }\n  ],\n  \"status\": \"complete\"\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"020b7a6e-6236-4f8d-a760-9a7fb50fdcce","uuid":"aaecf2f9-be4d-49a9-9054-d724484cdc93","timestamp":"2026-10-27T16:37:14.273Z","tool_use_result":{"stdout":"{\n  \"ticketId\": \"abcd-05\",\n  \"timestamp\": \"2026-10-27T00:00:00Z\",\n  \"phase\": \"intake\",\n  \"version\": \"1.0\",\n\n  \"functionalRequirements\": [\n    { \"id\": \"FR-1\",  \"description\": \"Add Prisma models Section, SectionMember, Course and Enrollment, plus enums CourseKind (CORE/ELECTIVE) and EnrollmentStatus (ACTIVE/DROPPED), exactly per the schema block given, including the @@unique([academicYearId, name]) on Section, @@unique([studentId, academicYearId]) on SectionMember, @@unique([academicYearId, code]) on Course and @@unique([courseId, studentId]) + @@index([studentId, status]) on Enrollment.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 Data model\" },\n    { \"id\": \"FR-2\",  \"description\": \"Build /admin/sections: filtered by academic year (defaults to current, reusing the existing AcademicYear model), with a table of name, grade level, homeroom teacher, room, members/capacity (warning colour at >=90%), and course count.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1\" },\n    { \"id\": \"FR-3\",  \"description\": \"Section create/edit dialog: grade level, name, homeroom teacher (UserPicker filtered to role=TEACHER — the existing src/components/UserPicker already supports a role filter), room, capacity; a teacher may be homeroom teacher of at most one section per academic year.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.2; verified against existing src/components/UserPicker/UserPicker.tsx which already accepts a `role` prop\" },\n    { \"id\": \"FR-4\",  \"description\": \"Build /admin/sections/[id]: members table with add (multi-select student picker filtered to the section's grade level and to students without a section this year) and remove; the section's course list; a 'Create core courses' button.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.3\" },\n    { \"id\": \"FR-5\",  \"description\": \"'Create core courses' dialog: lists all active (non-archived) subjects with a checkbox and a teacher picker per subject; submitting creates one CORE course per checked subject with the default name/code pattern and enrolls all current section members in each created course.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.4\" },\n    { \"id\": \"FR-6\",  \"description\": \"'Copy sections to next year' action on /admin/sections, enabled only when a non-current, future academic year exists; copies section name, grade level advanced to the next GradeLevel by `order`, room and capacity, without members or teacher assignments.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.5\" },\n    { \"id\": \"FR-7\",  \"description\": \"Auto-enroll on section add: adding a student to a section enrolls them ACTIVE in every non-archived CORE course of that section; a previously DROPPED enrollment in one of those courses is reactivated rather than duplicated.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1\" },\n    { \"id\": \"FR-8\",  \"description\": \"Auto-drop on section removal: removing a student from a section sets every ACTIVE enrollment in that section's CORE courses to DROPPED with droppedAt = now; elective enrollments are left untouched.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.2\" },\n    { \"id\": \"FR-9\",  \"description\": \"'Move to section…' single action performs the FR-7 enroll and FR-8 drop steps for the destination/source sections in one database transaction, exposed via POST /api/students/:id/move-section.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.3; API table row POST /api/students/:id/move-section\" },\n    { \"id\": \"FR-10\", \"description\": \"Creating a new CORE course on a section enrolls all of that section's current members (ACTIVE) in the new course.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.4\" },\n    { \"id\": \"FR-11\", \"description\": \"Capacity enforcement: adding a student beyond section or course capacity is refused with a CONFLICT error, message pattern 'Section 7A is full (30/30).', unless the admin explicitly ticks 'Override capacity'.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.5; Acceptance Criteria #4\" },\n    { \"id\": \"FR-12\", \"description\": \"Dropped enrollments retain all historical data (attendance, grades) visible to admins and teachers, but dropped students disappear from active rosters and from add-student pickers.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.6\" },\n    { \"id\": \"FR-13\", \"description\": \"Build /admin/courses: filters for academic year, grade level, subject, teacher, kind, and free-text search by name/code; table of code, name, subject colour chip (reusing Subject.color, already on the model), section, teacher, enrolled count, kind.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.1; verified Subject.color already exists on the Subject model in prisma/schema.prisma\" },\n    { \"id\": \"FR-14\", \"description\": \"Course create/edit dialog: subject, section (optional, required when kind=CORE), teacher, up to 3 co-teachers, name, code (auto-filled from subject+section, editable, forced uppercase), kind, capacity, description.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.2\" },\n    { \"id\": \"FR-15\", \"description\": \"Build /admin/courses/[id]/enrollment: enrolled-students table with drop/reactivate row actions and an 'Add students' picker; for CORE courses show an info note that membership is managed via the section instead.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.3\" },\n    { \"id\": \"FR-16\", \"description\": \"Build the /courses/[courseId] header: subject colour band, course name, code, teacher(s) (including co-teachers), section, room.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.1\" },\n    { \"id\": \"FR-17\", \"description\": \"Add a course-tabs registry at src/config/course-tabs.ts (same shape as the existing src/config/student-tabs.ts, with a `roles` field) rendered as a scrollable MUI Tabs on the course home page; this PRD registers 'Overview' (description/teachers/counts, all roles that can view the course) and 'Roster' (TEACHER/ADMIN: full student list with avatar/name/admission number/link to student page/status; STUDENT: classmates' names only; PARENT: tab not shown).\", \"confidence\": \"HIGH\", \"source\": \"FR-5.2; verified against the existing (empty) src/config/student-tabs.ts pattern this PRD is told to mirror\" },\n    { \"id\": \"FR-18\", \"description\": \"Add src/server/auth/course-access.ts exporting assertCanViewCourse(user, courseId) (ADMIN: all; TEACHER: teacher or co-teacher; STUDENT: has an ACTIVE enrollment; PARENT: any linked child has an ACTIVE enrollment) and assertCanManageCourse(user, courseId) (ADMIN, teacher, co-teacher) for later write operations.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.3\" },\n    { \"id\": \"FR-19\", \"description\": \"Build /my-courses: TEACHER sees MUI Cards in a responsive Grid for each non-archived course they teach/co-teach this year (name, section, enrolled count); STUDENT sees cards for their ACTIVE enrollments (name, teacher); PARENT sees the same cards grouped by child.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1\" },\n    { \"id\": \"FR-20\", \"description\": \"Add sidebar nav entries: 'My courses' for TEACHER/STUDENT/PARENT, and 'Sections'/'Courses' grouped under an 'Administration' section for ADMIN. NavItem currently has no grouping field — src/config/navigation.ts (verified) is a flat array with only Dashboard/Notifications/Email log entries and no 'group' concept, and no admin-facing pages exist yet for the PRD-02/PRD-03 entities (academic years, subjects, rooms, grade levels, users) that would also belong in such a group. The Architect must decide whether to add a lightweight `group` field to NavItem now or ship Sections/Courses as flat entries until a dedicated admin-nav grouping PRD lands.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-6.2; cross-checked against the current flat src/config/navigation.ts and the absence of an 'Administration' grouping or admin pages anywhere under src/app/(app)\" },\n    { \"id\": \"FR-21\", \"description\": \"Register student tab 'Courses' in src/config/student-tabs.ts (visible to every role that can view the student): a table of the student's courses this year with teacher and enrollment status, plus their section and homeroom teacher.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.1\" },\n    { \"id\": \"FR-22\", \"description\": \"Extend the existing getAccessibleStudentIds(user) in src/server/auth/student-access.ts so a TEACHER additionally gets students with ACTIVE enrollments in courses they teach or co-teach, plus members of the section they are homeroom teacher of.\", \"confidence\": \"HIGH\", \"source\": \"FR-8.1; verified getAccessibleStudentIds already exists and is exported from src/server/auth/student-access.ts\" },\n    { \"id\": \"FR-23\", \"description\": \"Expose the full REST surface from the API table: sections CRUD + members + move-section + core-courses + copy-to-year; courses CRUD + roster + enrollments + enrollment status PATCH; GET /api/me/courses — each with the role gating shown in the table and the existing success/list/error response envelope and pagination/sort/search query conventions.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },\n    { \"id\": \"FR-24\", \"description\": \"Every write (section.*, course.*, enrollment.*) records an AuditLog row via the existing audit() helper.\", \"confidence\": \"HIGH\", \"source\": \"API table footnote 'All writes audit (section.*, course.*, enrollment.*)'; verified audit() already exists and is exported from src/server/audit.ts\" }\n  ],\n  \"nonFunctionalRequirements\": [\n    { \"id\": \"NFR-1\", \"description\": \"Material UI only: every visible element in the section/course/enrollment screens is built from @mui/material, @mui/icons-material or the MUI X packages (DataGrid via the existing shared DataTable, Autocomplete, Tabs, Dialog, Drawer, Snackbar+Alert via useToast()); every component looked up via the MUI MCP server before use; no banned libraries (Tailwind, shadcn/ui, Radix, react-select, etc.) in this PRD's code.\", \"confidence\": \"HIGH\", \"source\": \"UI component rule (mandatory, applies to every screen in this PRD); Compliance Rule 6\" },\n    { \"id\": \"NFR-2\", \"description\": \"Integrity: the one-section-per-student-per-year rule is enforced by the database unique constraint (@@unique([studentId, academicYearId]) on SectionMember), not only in application code.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements #1\" },\n    { \"id\": \"NFR-3\", \"description\": \"Performance: adding 30 students to a section with 8 core courses (240 resulting enrollments) completes in under 1 second.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements #2\" },\n    { \"id\": \"NFR-4\", \"description\": \"Privacy: on the course Roster tab and GET /api/courses/:id/roster, students see classmates' names only — no emails, admission numbers or profile links in the response.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements #3; Acceptance Criteria #7\" },\n    { \"id\": \"NFR-5\", \"description\": \"Keep all existing tests passing (npm run lint && npm run typecheck && npm run test) and add the unit/integration/Playwright tests listed in Test Requirements.\", \"confidence\": \"HIGH\", \"source\": \"Assumptions and constraints; Test Requirements\" },\n    { \"id\": \"NFR-6\", \"description\": \"Scope containment: no timetable slots (PRD-06), no course content (PRD-08), no prerequisite or course-request workflows, and no automatic year-to-year student promotion — only the manual 'Copy sections to next year' shortcut.\", \"confidence\": \"HIGH\", \"source\": \"Out of Scope\" },\n    { \"id\": \"NFR-7\", \"description\": \"Server-side authorization gap carried forward from PRD-01/PRD-04: the Platform Context describes src/server/auth/permissions.ts exposing requireUser()/requireRole(...roles), but only src/server/auth/requireRole.ts and student-access.ts exist today (no permissions.ts, no requireUser()). New route handlers in this PRD must use the existing requireRole(...ALL_ROLES)-style stand-in (as PRD-04's handoff also flagged) rather than invent a new auth helper, until PRD-01 lands.\", \"confidence\": \"MEDIUM\", \"source\": \"Platform Context > Code layout conventions (server-side access enforcement), cross-checked against the current contents of src/server/auth/ (only requireRole.ts and student-access.ts present)\" }\n  ],\n  \"overallConfidencePct\": 97,\n  \"clarificationLog\": [],\n  \"status\": \"complete\"\n}\n{\n  \"ticketId\": \"abcd-05\",\n  \"timestamp\": \"2026-10-27T00:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md (REST API surface + Data Flow) and 05-classes-enrollment.md's API table; 17 endpoints (the table's '·'-joined rows are expanded). Conventions shared by every endpoint, not repeated per entry: (1) every handler is wrapped in withHandler() from src/server/http.ts, which maps ZodError->VALIDATION_ERROR 400, AppError->its code, Prisma P2002->CONFLICT 409, P2025->NOT_FOUND 404; (2) success = ok() -> { data }, lists = paginated() -> { data: [...], meta: { page, pageSize, total } } — the real helper nests pagination under `meta`, unlike the PRD's flat example; follow the helper; (3) list query conventions: page (default 1), pageSize (default 20, max 100), sort, order=asc|desc, q; (4) auth: every route calls requireRole(...) from src/server/auth/requireRole.ts (NFR-7 stand-in; no permissions.ts/requireUser()); course-scoped reads additionally call assertCanViewCourse from src/server/auth/course-access.ts (FR-18); (5) every write calls audit() inside the same $transaction (FR-24) via the service/engine, never at the route layer; (6) handlers are thin: zod parse -> one service call -> envelope. Shared shapes are named under `schemas` and referenced as \\\"$ref\\\": \\\"#/schemas/<Name>\\\".\",\n\n  \"schemas\": {\n    \"Section\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevel\": { \"id\": \"string\", \"name\": \"string\", \"order\": \"number\" },\n      \"name\": \"string\", \"homeroomTeacherId\": \"string|null\", \"homeroomTeacher\": { \"id\": \"string\", \"name\": \"string\" },\n      \"roomId\": \"string|null\", \"room\": { \"id\": \"string\", \"name\": \"string\" }, \"capacity\": \"number (1-60)\",\n      \"memberCount\": \"number\", \"courseCount\": \"number\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"SectionInput\": {\n      \"academicYearId\": \"string (required on create)\", \"gradeLevelId\": \"string\", \"name\": \"string (min 1)\",\n      \"homeroomTeacherId\": \"string|null (must be role=TEACHER; at most one section per teacher per year -> CONFLICT)\",\n      \"roomId\": \"string|null\", \"capacity\": \"int 1-60, default 30\"\n    },\n    \"Course\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"subjectId\": \"string\", \"subject\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"color\": \"string\" },\n      \"sectionId\": \"string|null\", \"section\": { \"id\": \"string\", \"name\": \"string\", \"room\": { \"id\": \"string\", \"name\": \"string\" } },\n      \"teacherId\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" }, \"coTeacherIds\": \"string[]\", \"coTeachers\": [{ \"id\": \"string\", \"name\": \"string\" }],\n      \"name\": \"string\", \"code\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"description\": \"string|null\", \"capacity\": \"number|null\",\n      \"archivedAt\": \"ISO 8601|null\", \"enrolledCount\": \"number (ACTIVE only)\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"CourseInput\": {\n      \"academicYearId\": \"string (required on create)\", \"subjectId\": \"string\", \"sectionId\": \"string|null (required iff kind=CORE — single zod refinement shared with the dialog, FR-14)\",\n      \"teacherId\": \"string (role=TEACHER)\", \"coTeacherIds\": \"string[] (max 3, role=TEACHER)\", \"name\": \"string (default '<Subject> – <Section>')\",\n      \"code\": \"string (default '<SUBJECTCODE>-<SECTION>', transformed to uppercase; unique per year -> CONFLICT)\", \"kind\": \"CORE|ELECTIVE (default CORE)\",\n      \"capacity\": \"int>=1|null\", \"description\": \"string|null\"\n    },\n    \"Enrollment\": {\n      \"id\": \"string\", \"courseId\": \"string\", \"studentId\": \"string\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\" },\n      \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\"\n    },\n    \"EnrollStudentsInput\": { \"studentIds\": \"string[] (min 1)\", \"overrideCapacity\": \"boolean (optional, default false)\" },\n    \"EnrollResult\": { \"enrolled\": \"number (new ACTIVE rows)\", \"reactivated\": \"number (DROPPED->ACTIVE)\", \"alreadyActive\": \"number\" },\n    \"CapacityConflict\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Section 7A is full (30/30). | Course MATH-7A is full (30/30).\" } }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/sections\",\n      \"description\": \"List sections for an academic year (defaults to current). Roles: ADMIN, TEACHER. Service: sections-service.listSections.\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, defaults to current AcademicYear)\", \"gradeLevelId\": \"string (optional)\", \"q\": \"string (optional, name search)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"name|gradeLevel|memberCount (default gradeLevel)\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Section\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } }, \"403\": \"FORBIDDEN (STUDENT/PARENT)\" },\n      \"requirementIds\": [\"FR-2\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections\",\n      \"description\": \"Create a section. Role: ADMIN. Homeroom-teacher-per-year check runs inside the write transaction (system-design Decision 3). Audits section.create.\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/SectionInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"409\": \"CONFLICT — duplicate name in year (P2002), or teacher already homeroom of another section this year\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Update a section (partial SectionInput, academicYearId immutable). Role: ADMIN. Capacity may not be lowered below current memberCount. Audits section.update.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<SectionInput> without academicYearId\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (name/homeroom uniqueness)\", \"400\": \"VALIDATION_ERROR (capacity < memberCount)\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Delete a section. Role: ADMIN. Allowed only when it has no members and no courses. Audits section.delete.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"id\": \"string\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT — 'Section 7A still has members or courses.'\" },\n      \"requirementIds\": [\"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/members\",\n      \"description\": \"Add students to a section and auto-enroll them ACTIVE in every non-archived CORE course of the section (reactivating DROPPED rows), all in one $transaction via roster-engine.enrollSectionCoreCourses with batched createMany/updateMany. Role: ADMIN. Audits section.member.add + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": {\n        \"201\": { \"data\": { \"added\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Sam Student is already in section 7A for 2026–2027.' (SectionMember @@unique P2002, mapped to the friendly message by the service)\"],\n        \"400\": \"VALIDATION_ERROR — student not role=STUDENT or wrong grade level\", \"404\": \"NOT_FOUND\"\n      },\n      \"requirementIds\": [\"FR-4\", \"FR-7\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-2\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id/members/:studentId\",\n      \"description\": \"Remove a student from a section; their ACTIVE enrollments in this section's CORE courses become DROPPED with droppedAt=now (electives untouched) via roster-engine.dropSectionCoreCourses, same transaction. Role: ADMIN. Audits section.member.remove + enrollment.drop.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\", \"studentId\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"removed\": true, \"droppedEnrollments\": \"number\" } }, \"404\": \"NOT_FOUND (student not a member)\" },\n      \"requirementIds\": [\"FR-4\", \"FR-8\", \"FR-12\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/students/:id/move-section\",\n      \"description\": \"Move a student to another section of the same academic year in a single $transaction: remove membership + drop source CORE enrollments, add membership + enroll/reactivate destination CORE enrollments (roster-engine.moveStudentSection). Electives unchanged. Role: ADMIN. Audits section.member.move + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string (studentId)\" }, \"body\": { \"toSectionId\": \"string\", \"overrideCapacity\": \"boolean (optional, default false)\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"fromSectionId\": \"string\", \"toSectionId\": \"string\", \"dropped\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }],\n        \"400\": \"VALIDATION_ERROR — destination in a different academic year, or same as source\", \"404\": \"NOT_FOUND — student has no section this year, or toSectionId unknown\"\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-7\", \"FR-8\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/core-courses\",\n      \"description\": \"Bulk-create one CORE course per item (default name '<Subject> – <Section>', code '<SUBJECTCODE>-<SECTION>') and enroll all current section members in each, one $transaction. Subjects must be non-archived. Role: ADMIN. Audits course.create + enrollment.* per course.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"items\": [{ \"subjectId\": \"string\", \"teacherId\": \"string (role=TEACHER)\" }], \"_constraints\": \"items min 1, subjectIds unique\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"courses\": [{ \"$ref\": \"#/schemas/Course\" }], \"enrollmentsCreated\": \"number\" } }, \"409\": \"CONFLICT — course code already exists this year (P2002)\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-5\", \"FR-10\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/copy-to-year\",\n      \"description\": \"Structural copy of all sections from one year to a future, non-current year: name, room, capacity copied; gradeLevel advanced to the next GradeLevel by `order` (sections at the top grade are skipped); no members, no homeroom teacher, no courses. Role: ADMIN. Audits section.create per copy.\",\n      \"requestSchema\": { \"body\": { \"fromYearId\": \"string\", \"toYearId\": \"string (must be a future, non-current AcademicYear)\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"created\": \"number\", \"skipped\": [{ \"name\": \"string\", \"reason\": \"no next grade level | name already exists in target year\" }] } }, \"400\": \"VALIDATION_ERROR — toYearId is current or not in the future\" },\n      \"requirementIds\": [\"FR-6\", \"FR-23\", \"FR-24\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses\",\n      \"description\": \"List courses. ADMIN sees all; TEACHER sees courses they teach/co-teach; STUDENT/PARENT see courses with an ACTIVE enrollment for self/linked child (scoping done in courses-service, not by client filter). Excludes archived unless includeArchived=true (ADMIN only).\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, default current)\", \"gradeLevelId\": \"string\", \"subjectId\": \"string\", \"teacherId\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"sectionId\": \"string\", \"includeArchived\": \"boolean\", \"q\": \"string (name/code)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"code|name|enrolledCount\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Course\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"requirementIds\": [\"FR-13\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses\",\n      \"description\": \"Create a course. Role: ADMIN. A new CORE course on a section enrolls all current section members ACTIVE in the same transaction (FR-10). Audits course.create (+ enrollment.* if CORE).\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/CourseInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"409\": \"CONFLICT — code already used this year\", \"400\": \"VALIDATION_ERROR — e.g. kind=CORE without sectionId, >3 coTeachers\" },\n      \"requirementIds\": [\"FR-14\", \"FR-10\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Update a course (partial CourseInput; academicYearId/sectionId/kind immutable after creation to avoid silent roster rewrites). Archive via { archived: true } (sets archivedAt), unarchive via { archived: false }. Role: ADMIN. Audits course.update / course.archive.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<CourseInput> without academicYearId/sectionId/kind, plus archived?: boolean\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (code)\", \"400\": \"VALIDATION_ERROR (capacity < enrolledCount)\" },\n      \"requirementIds\": [\"FR-14\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Course header/overview data for /courses/[courseId]. Gated by assertCanViewCourse (ADMIN all; TEACHER teacher/co-teacher; STUDENT ACTIVE enrollment; PARENT linked child ACTIVE enrollment).\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"403\": \"FORBIDDEN\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\", \"FR-23\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/roster\",\n      \"description\": \"Course roster, ACTIVE enrollments by default. Gated by assertCanViewCourse; PARENT gets FORBIDDEN (Roster tab not shown). Shape from courses-service.getCourseRoster(id, viewerRole) — the same function the Roster tab server component uses.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"query\": { \"status\": \"ACTIVE|DROPPED|ALL (default ACTIVE; DROPPED/ALL only for ADMIN/TEACHER)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"q\": \"string\" } },\n      \"responseSchema\": {\n        \"200 (ADMIN, TEACHER)\": { \"data\": [{ \"enrollmentId\": \"string\", \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\", \"profileUrl\": \"/students/:id\" } }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },\n        \"200 (STUDENT)\": { \"data\": [{ \"name\": \"string\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" }, \"_privacy\": \"Projection is names only — no ids, emails, admission numbers, avatars or profile links; status forced to ACTIVE (NFR-4)\" },\n        \"403\": \"FORBIDDEN (no view access, or PARENT)\"\n      },\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-12\", \"FR-23\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/enrollments\",\n      \"description\": \"Enroll students directly in a course (create or reactivate DROPPED; same semantics as the roster engine helper). Role: ADMIN. Refused for CORE courses (membership is managed via the section). Capacity checked via checkCapacityOrThrow. Audits enrollment.create / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/EnrollResult\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Core course enrollment is managed via section 7A.'\"], \"400\": \"VALIDATION_ERROR — non-student ids\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/enrollments/:id\",\n      \"description\": \"Drop or reactivate a single enrollment (DROPPED sets droppedAt=now; ACTIVE clears it and runs checkCapacityOrThrow). Historical data is retained either way. Role: ADMIN. Audits enrollment.drop / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"status\": \"ACTIVE|DROPPED\", \"overrideCapacity\": \"boolean (optional, only meaningful for ACTIVE)\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Enrollment\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }], \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-12\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/courses\",\n      \"description\": \"Current user's courses for /my-courses, current academic year, non-archived. TEACHER: taught/co-taught; STUDENT: ACTIVE enrollments; PARENT: grouped by linked child; ADMIN: empty list (admins use /admin/courses). Role: any (requireRole(...ALL_ROLES), NFR-7 stand-in identity).\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"200 (TEACHER)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"section\": { \"id\": \"string\", \"name\": \"string\" }, \"enrolledCount\": \"number\" }] },\n        \"200 (STUDENT)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] },\n        \"200 (PARENT)\": { \"data\": [{ \"child\": { \"id\": \"string\", \"name\": \"string\" }, \"courses\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] }] }\n      },\n      \"requirementIds\": [\"FR-19\", \"FR-23\", \"NFR-7\"]\n    }\n  ],\n  \"status\": \"complete\"\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Jew6YigjrndZu8y9BP79kv","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
