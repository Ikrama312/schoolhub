{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JooW8ssyBegpKL8AYLzXm2","type":"tool_result","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\n// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\nexport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\n/** First x-forwarded-for entry (the client, behind our proxy), or null. */\nexport function getClientIp(request: Request): string | null {\n  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n}\n\nexport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\nimport { cache } from 'react';\nimport { headers } from 'next/headers';\nimport { redirect } from 'next/navigation';\nimport { AppError } from '@/server/http';\nimport { auth } from '@/server/auth/auth';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side authorization (FR-28, FR-29, ADR-2).\n * Route handlers use requireUser/requireRole (throw AppError → 401/403 via\n * withHandler); server pages/layouts use requirePageUser/requirePageRole\n * (redirect to /login or /forbidden).\n */\nexport interface SessionUser {\n  id: string;\n  role: Role;\n  firstName: string;\n  lastName: string;\n  email: string;\n}\n\nexport const getCurrentUser = cache(async (): Promise<SessionUser | null> => {\n  const user = (await auth())?.user;\n  if (!user?.id) return null;\n  return { id: user.id, role: user.role, firstName: user.firstName, lastName: user.lastName, email: user.email };\n});\n\ntype Check = { user: SessionUser } | { error: 'UNAUTHENTICATED' | 'FORBIDDEN' };\n\nasync function resolve(roles: Role[]): Promise<Check> {\n  const user = await getCurrentUser();\n  if (!user) return { error: 'UNAUTHENTICATED' };\n  if (roles.length && !roles.includes(user.role)) return { error: 'FORBIDDEN' };\n  return { user };\n}\n\nexport async function requireRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  throw result.error === 'UNAUTHENTICATED'\n    ? new AppError('UNAUTHENTICATED', 'You must be signed in.')\n    : new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n}\n\nexport async function requireUser(): Promise<SessionUser> {\n  return requireRole();\n}\n\nexport async function requirePageRole(...roles: Role[]): Promise<SessionUser> {\n  const result = await resolve(roles);\n  if ('user' in result) return result.user;\n  if (result.error === 'FORBIDDEN') redirect('/forbidden');\n  const callbackUrl = headers().get('x-pathname') ?? '/dashboard';\n  redirect(`/login?callbackUrl=${encodeURIComponent(callbackUrl)}`);\n}\n\nexport async function requirePageUser(): Promise<SessionUser> {\n  return requirePageRole();\n}\nimport { z } from 'zod';\n\n/**\n * Fail-fast env validation. Runs once at module load (startup boundary) —\n * anything importing this module gets a readable error naming every\n * missing/invalid variable instead of an undefined-at-runtime surprise.\n */\nconst envSchema = z.object({\n  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n  APP_URL: z.string().min(1, 'APP_URL is required'),\n  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n\n  // Email (PRD-04). EMAIL_TRANSPORT defaults to 'console' so dev/test never\n  // need real SMTP creds; the smtp branch (src/server/email/transport.ts)\n  // only reads SMTP_*/EMAIL_FROM when EMAIL_TRANSPORT='smtp'.\n  EMAIL_TRANSPORT: z.enum(['smtp', 'console']).default('console'),\n  SMTP_HOST: z.string().optional(),\n  SMTP_PORT: z.coerce.number().int().optional(),\n  SMTP_USER: z.string().optional(),\n  SMTP_PASS: z.string().optional(),\n  SMTP_SECURE: z.coerce.boolean().optional(),\n  EMAIL_FROM: z.string().optional(),\n  // Bearer token for POST /api/internal/email/dispatch (NFR-8). Optional so\n  // existing .env files don't break; left unset, the route rejects every\n  // request (fail-safe, not fail-open).\n  CRON_SECRET: z.string().optional(),\n});\n\nfunction loadEnv() {\n  const parsed = envSchema.safeParse(process.env);\n  if (!parsed.success) {\n    const issues = parsed.error.issues\n      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n      .join('\\n');\n    throw new Error(`Invalid environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\nexport const env = loadEnv();\nexport type Env = z.infer<typeof envSchema>;\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger'