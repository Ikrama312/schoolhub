{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q4iAGJt21WtitXrcuLAzoH","type":"tool_result","content":"1\timport { z } from 'zod';\n2\timport { ok, paginated, parsePagination, parseQuery, withHandler } from '@/server/http';\n3\timport { requireRole } from '@/server/auth/requireRole';\n4\timport { audit } from '@/server/audit';\n5\timport { createUser, listUsers } from '@/server/services/users';\n6\timport { createUserSchema, ROLE_VALUES } from '@/lib/validators/users';\n7\t\n8\tconst listQuerySchema = z.object({\n9\t  role: z.string().optional(),\n10\t  status: z.enum(['ACTIVE', 'INVITED', 'DISABLED', 'ARCHIVED']).optional(),\n11\t  gradeLevelId: z.string().optional(),\n12\t  q: z.string().optional(),\n13\t  includeArchived: z.enum(['true', 'false']).optional(),\n14\t});\n15\t\n16\t/** GET/POST /api/users — ADMIN only (FR-2, FR-3, FR-6..FR-10, NFR-2). */\n17\texport const GET = withHandler(async (request: Request) => {\n18\t  requireRole('ADMIN');\n19\t\n20\t  const url = new URL(request.url);\n21\t  const query = parseQuery(url.searchParams, listQuerySchema);\n22\t  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n23\t\n24\t  const roleFilter = query.role\n25\t    ? query.role\n26\t        .split(',')\n27\t        .map((value) => value.trim())\n28\t        .filter((value): value is (typeof ROLE_VALUES)[number] => ROLE_VALUES.includes(value as never))\n29\t    : undefined;\n30\t\n31\t  const { rows, total } = await listUsers(\n32\t    {\n33\t      role: roleFilter,\n34\t      status: query.status,\n35\t      gradeLevelId: query.gradeLevelId,\n36\t      q: query.q,\n37\t      includeArchived: query.includeArchived === 'true',\n38\t    },\n39\t    { skip, take },\n40\t  );\n41\t\n42\t  return paginated(rows, { page, pageSize, total });\n43\t});\n44\t\n45\texport const POST = withHandler(async (request: Request) => {\n46\t  const actor = requireRole('ADMIN');\n47\t  const json = await request.json();\n48\t  const input = createUserSchema.parse(json);\n49\t\n50\t  const user = await createUser(input);\n51\t  await audit({ actorId: actor.id, action: 'user.created', entityType: 'User', entityId: user.id });\n52\t\n53\t  return ok(user, { status: 201 });\n54\t});\n55\t"}]},"parent_tool_use_id":null,"session_id":"f0dac64c-df0f-45ea-8469-5aea11dfb611","uuid":"eafec231-1983-41c2-a146-c1896c66b7c9","timestamp":"2026-10-20T06:17:31.804Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/api/users/route.ts","content":"import { z } from 'zod';\nimport { ok, paginated, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { createUser, listUsers } from '@/server/services/users';\nimport { createUserSchema, ROLE_VALUES } from '@/lib/validators/users';\n\nconst listQuerySchema = z.object({\n  role: z.string().optional(),\n  status: z.enum(['ACTIVE', 'INVITED', 'DISABLED', 'ARCHIVED']).optional(),\n  gradeLevelId: z.string().optional(),\n  q: z.string().optional(),\n  includeArchived: z.enum(['true', 'false']).optional(),\n});\n\n/** GET/POST /api/users — ADMIN only (FR-2, FR-3, FR-6..FR-10, NFR-2). */\nexport const GET = withHandler(async (request: Request) => {\n  requireRole('ADMIN');\n\n  const url = new URL(request.url);\n  const query = parseQuery(url.searchParams, listQuerySchema);\n  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n\n  const roleFilter = query.role\n    ? query.role\n        .split(',')\n        .map((value) => value.trim())\n        .filter((value): value is (typeof ROLE_VALUES)[number] => ROLE_VALUES.includes(value as never))\n    : undefined;\n\n  const { rows, total } = await listUsers(\n    {\n      role: roleFilter,\n      status: query.status,\n      gradeLevelId: query.gradeLevelId,\n      q: query.q,\n      includeArchived: query.includeArchived === 'true',\n    },\n    { skip, take },\n  );\n\n  return paginated(rows, { page, pageSize, total });\n});\n\nexport const POST = withHandler(async (request: Request) => {\n  const actor = requireRole('ADMIN');\n  const json = await request.json();\n  const input = createUserSchema.parse(json);\n\n  const user = await createUser(input);\n  await audit({ actorId: actor.id, action: 'user.created', entityType: 'User', entityId: user.id });\n\n  return ok(user, { status: 201 });\n});\n","numLines":55,"startLine":1,"totalLines":55}}}
