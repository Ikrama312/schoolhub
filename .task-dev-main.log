{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011EcvtGKGqfdsurwMcrTfAF","type":"tool_result","content":"1\tgenerator client {\n2\t  provider = \"prisma-client-js\"\n3\t}\n4\t\n5\tdatasource db {\n6\t  provider = \"postgresql\"\n7\t  url      = env(\"DATABASE_URL\")\n8\t}\n9\t\n10\tenum Role {\n11\t  ADMIN\n12\t  TEACHER\n13\t  STUDENT\n14\t  PARENT\n15\t}\n16\t\n17\tenum UserStatus {\n18\t  ACTIVE\n19\t  INVITED\n20\t  DISABLED\n21\t  ARCHIVED\n22\t}\n23\t\n24\tenum AuthTokenType {\n25\t  INVITE\n26\t  PASSWORD_RESET\n27\t}\n28\t\n29\tenum Gender {\n30\t  FEMALE\n31\t  MALE\n32\t  OTHER\n33\t  UNDISCLOSED\n34\t}\n35\t\n36\tenum GuardianRelationship {\n37\t  MOTHER\n38\t  FATHER\n39\t  GUARDIAN\n40\t  GRANDPARENT\n41\t  OTHER\n42\t}\n43\t\n44\tenum EmailStatus {\n45\t  PENDING\n46\t  SENDING\n47\t  SENT\n48\t  FAILED\n49\t}\n50\t\n51\t/// Every authenticated person. passwordHash is nullable because an INVITED\n52\t/// user has no password until they accept their invite (TASK-8's\n53\t/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n54\t/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n55\t/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n56\t/// field shared by every role, archivedAt backs FR-13's archive/restore\n57\t/// (separate from status so a DISABLED-but-not-archived user stays distinct\n58\t/// from an archived one).\n59\tmodel User {\n60\t  id                String      @id @default(cuid())\n61\t  email             String      @unique\n62\t  passwordHash      String?\n63\t  firstName         String\n64\t  lastName          String\n65\t  phone             String?\n66\t  role              Role\n67\t  status            UserStatus  @default(INVITED)\n68\t  failedLoginCount  Int         @default(0)\n69\t  lockedUntil       DateTime?\n70\t  lastLoginAt       DateTime?\n71\t  passwordChangedAt DateTime?\n72\t  archivedAt        DateTime?\n73\t  createdAt         DateTime    @default(now())\n74\t  updatedAt         DateTime    @updatedAt\n75\t  authTokens        AuthToken[]\n76\t  auditLogs         AuditLog[]\n77\t  studentProfile    StudentProfile?\n78\t  teacherProfile    TeacherProfile?\n79\t  parentProfile     ParentProfile?\n80\t  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")\n81\t  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")\n82\t  notifications               Notification[]\n83\t  notificationPreferences     NotificationPreference[]\n84\t\n85\t  @@index([lastName, firstName, email])\n86\t}\n87\t\n88\t/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n89\t/// only -- enforced in the service layer (src/server/services/users.ts,\n90\t/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\n91\tmodel StudentProfile {\n92\t  userId           String     @id\n93\t  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n94\t  admissionNumber  String     @unique\n95\t  dateOfBirth      DateTime   @db.Date\n96\t  gender           Gender     @default(UNDISCLOSED)\n97\t  gradeLevelId     String\n98\t  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n99\t  enrollmentDate   DateTime   @db.Date\n100\t  addressLine1     String?\n101\t  city             String?\n102\t  medicalNotes     String?\n103\t  emergencyContact String?\n104\t  emergencyPhone   String?\n105\t}\n106\t\n107\t/// Teacher-specific fields (FR-1).\n108\tmodel TeacherProfile {\n109\t  userId         String    @id\n110\t  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n111\t  employeeNumber String    @unique\n112\t  title          String?\n113\t  qualifications String?\n114\t  hireDate       DateTime? @db.Date\n115\t}\n116\t\n117\t/// Parent-specific fields (FR-1).\n118\tmodel ParentProfile {\n119\t  userId     String  @id\n120\t  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n121\t  occupation String?\n122\t  address    String?\n123\t}\n124\t\n125\t/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n126\t/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n127\t/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n128\t/// transaction invariants rather than DB constraints.\n129\tmodel ParentStudentLink {\n130\t  id           String               @id @default(cuid())\n131\t  parentId     String\n132\t  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n133\t  studentId    String\n134\t  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n135\t  relationship GuardianRelationship\n136\t  isPrimary    Boolean              @default(false)\n137\t  createdAt    DateTime             @default(now())\n138\t\n139\t  @@unique([parentId, studentId])\n140\t  @@index([studentId])\n141\t}\n142\t\n143\t/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n144\t/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n145\t/// user. One shared shape for both token types; src/server/auth/tokens.ts\n146\t/// is the single producer/consumer.\n147\tmodel AuthToken {\n148\t  id        String        @id @default(cuid())\n149\t  userId    String\n150\t  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n151\t  type      AuthTokenType\n152\t  tokenHash String        @unique\n153\t  expiresAt DateTime\n154\t  usedAt    DateTime?\n155\t  createdAt DateTime      @default(now())\n156\t\n157\t  @@index([userId, type])\n158\t}\n159\t\n160\t/// Insert-only audit trail written exclusively through src/server/audit.ts's\n161\t/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n162\t/// non-existent email can still be recorded.\n163\tmodel AuditLog {\n164\t  id         String   @id @default(cuid())\n165\t  actorId    String?\n166\t  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n167\t  action     String\n168\t  entityType String?\n169\t  entityId   String?\n170\t  metadata   Json?\n171\t  ip         String?\n172\t  createdAt  DateTime @default(now())\n173\t\n174\t  @@index([actorId])\n175\t  @@index([action])\n176\t}\n177\t\n178\t/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n179\t/// info. Later PRDs read this for top-bar branding and public footer; no\n180\t/// other PRD should add a second row or a second settings model.\n181\tmodel SchoolSettings {\n182\t  id           String   @id @default(\"singleton\")\n183\t  name         String   @default(\"SchoolHub Academy\")\n184\t  shortName    String   @default(\"SchoolHub\")\n185\t  logoUrl      String?\n186\t  timezone     String   @default(\"UTC\")\n187\t  addressLine1 String?\n188\t  addressLine2 String?\n189\t  city         String?\n190\t  country      String?\n191\t  phone        String?\n192\t  email        String?\n193\t  website      String?\n194\t  createdAt    DateTime @default(now())\n195\t  updatedAt    DateTime @updatedAt\n196\t}\n197\t\n198\t/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n199\t/// at a time -- enforced in src/server/services/academicYears.ts's\n200\t/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n201\t/// express \"exactly one true\" as a simple unique index).\n202\tmodel AcademicYear {\n203\t  id        String   @id @default(cuid())\n204\t  name      String   @unique\n205\t  startDate DateTime @db.Date\n206\t  endDate   DateTime @db.Date\n207\t  isCurrent Boolean  @default(false)\n208\t  createdAt DateTime @default(now())\n209\t  updatedAt DateTime @updatedAt\n210\t  terms     Term[]\n211\t}\n212\t\n213\t/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n214\t/// Restrict means the year can't be deleted while it still has terms --\n215\t/// the service layer checks this first to return a friendly 409 instead of\n216\t/// a raw FK error.\n217\tmodel Term {\n218\t  id             String       @id @default(cuid())\n219\t  academicYearId String\n220\t  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n221\t  name           String\n222\t  startDate      DateTime     @db.Date\n223\t  endDate        DateTime     @db.Date\n224\t  order          Int\n225\t  createdAt      DateTime     @default(now())\n226\t  updatedAt      DateTime     @updatedAt\n227\t\n228\t  @@unique([academicYearId, name])\n229\t  @@unique([academicYearId, order])\n230\t}\n231\t\n232\t/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n233\t/// reference grade levels, so they're archived instead of deleted.\n234\tmodel GradeLevel {\n235\t  id              String           @id @default(cuid())\n236\t  name            String           @unique\n237\t  shortName       String           @unique\n238\t  order           Int              @unique\n239\t  archivedAt      DateTime?\n240\t  createdAt       DateTime         @default(now())\n241\t  updatedAt       DateTime         @updatedAt\n242\t  studentProfiles StudentProfile[]\n243\t}\n244\t\n245\t/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n246\t/// the service layer, not the DB) so the unique constraint catches\n247\t/// case-insensitive duplicates like \"math\" vs \"MATH\".\n248\tmodel Subject {\n249\t  id          String    @id @default(cuid())\n250\t  name        String\n251\t  code        String    @unique\n252\t  description String?\n253\t  color       String    @default(\"#4F46E5\")\n254\t  archivedAt  DateTime?\n255\t  createdAt   DateTime  @default(now())\n256\t  updatedAt   DateTime  @updatedAt\n257\t}\n258\t\n259\t/// A physical room classes are scheduled in.\n260\tmodel Room {\n261\t  id         String    @id @default(cuid())\n262\t  name       String    @unique\n263\t  building   String?\n264\t  capacity   Int?\n265\t  archivedAt DateTime?\n266\t  createdAt  DateTime  @default(now())\n267\t  updatedAt  DateTime  @updatedAt\n268\t}\n269\t\n270\t/// In-app notification (PRD-04 FR-1). type is a key from the compile-time\n271\t/// registry (src/server/notifications/types.ts) rather than an enum/FK, so\n272\t/// later PRDs register new keys without a migration. category is resolved\n273\t/// from the registry at read time (src/server/notifications/list.ts), not\n274\t/// stored here. The composite index backs both getUnreadCount() (NFR-3,\n275\t/// <50ms) and listNotifications()'s own-rows-newest-first query.\n276\tmodel Notification {\n277\t  id        String    @id @default(cuid())\n278\t  userId    String\n279\t  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n280\t  type      String\n281\t  title     String\n282\t  body      String?\n283\t  link      String?\n284\t  readAt    DateTime?\n285\t  createdAt DateTime  @default(now())\n286\t  updatedAt DateTime  @updatedAt\n287\t\n288\t  @@index([userId, readAt, createdAt])\n289\t}\n290\t\n291\t/// Per-user, per-type override of the registry's defaultEmail/mandatoryInApp\n292\t/// defaults (PRD-04 FR-3). Composite PK instead of a surrogate id/unique\n293\t/// index -- there is exactly one row per (userId, type) by construction\n294\t/// (notify.ts and the preferences PUT route both upsert on it).\n295\tmodel NotificationPreference {\n296\t  userId    String\n297\t  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n298\t  type      String\n299\t  inApp     Boolean  @default(true)\n300\t  email     Boolean  @default(true)\n301\t  updatedAt DateTime @updatedAt\n302\t\n303\t  @@id([userId, type])\n304\t}\n305\t\n306\t/// Durable outbox row the dispatcher claims and sends (PRD-04 FR-1/FR-5).\n307\t/// No FK to User -- toEmail/toName are a