c function importUsers(type: ImportType, rows: unknown[], sendInvites: boolean): Promise<ImportSummary> {\nsrc/server/services/userLinks.ts:7:export interface LinkParentToStudentInput {\nsrc/server/services/userLinks.ts:25:export async function linkParentToStudentTx(tx: TxClient, input: LinkParentToStudentInput) {\nsrc/server/services/userLinks.ts:49:export async function linkParentToStudent(input: LinkParentToStudentInput) {\nsrc/server/services/userLinks.ts:53:export async function unlinkParentFromStudent(studentId: string, parentId: string) {\nsrc/server/services/userLinks.ts:57:export async function listLinksForStudent(studentId: string) {\nsrc/server/services/userLinks.ts:64:export async function listLinksForParent(parentId: string) {\nsrc/server/services/users.ts:117:export async function createUser(input: CreateUserInput) {\nsrc/server/services/users.ts:171:export async function updateUser(id: string, input: UpdateUserInput) {\nsrc/server/services/users.ts:219:export interface ListUsersFilters {\nsrc/server/services/users.ts:237:export async function listUsers(filters: ListUsersFilters, pagination: { skip: number; take: number }) {\nsrc/server/services/users.ts:275:export async function getUserDetail(id: string) {\nsrc/server/services/users.ts:344:export async function setUserStatus(actorId: string, userId: string, status: 'ACTIVE' | 'DISABLED') {\nsrc/server/services/users.ts:353:export async function archiveUser(actorId: string, userId: string) {\nsrc/server/services/users.ts:364:export async function restoreUser(userId: string) {\nsrc/server/services/users.ts:373:export async function unlockUser(userId: string) {\nsrc/server/services/users.ts:388:export async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {","is_error":false}]},"parent_tool_use_id":null,"session_id":"c72bee80-431b-484c-8201-b3e207397669","uuid":"57856328-007f-45f5-871c-eb442cbbdf82","timestamp":"2026-10-27T16:49:37.060Z","tool_use_result":{"stdout":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { AccessUser } from '@/server/auth/student-access';\n\n/**\n * PRD-05 FR-18. `user` is whatever requireRole(...) resolved (NFR-7 stand-in\n * until PRD-01 lands). NOT_FOUND for a missing course, FORBIDDEN otherwise.\n */\n\nasync function loadCourse(courseId: string) {\n  const course = await prisma.course.findUnique({\n    where: { id: courseId },\n    select: { id: true, teacherId: true, coTeacherIds: true },\n  });\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  return course;\n}\n\nfunction teaches(user: AccessUser, course: { teacherId: string; coTeacherIds: string[] }) {\n  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n}\n\nconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n\nexport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n\n  switch (user.role) {\n    case 'ADMIN':\n      return;\n    case 'TEACHER':\n      if (teaches(user, course)) return;\n      throw forbidden();\n    case 'STUDENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    case 'PARENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    default:\n      throw forbidden();\n  }\n}\n\n/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\nexport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER' && teaches(user, course)) return;\n  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\nexport interface AccessUser {\n  id: string;\n  role: Role;\n}\n\nexport type AccessibleStudentIds = 'ALL' | string[];\n\n/**\n * FR-17: resolves which student ids `user` may see.\n * - ADMIN: \"ALL\" (every student)\n * - STUDENT: only themselves\n * - PARENT: students linked via ParentStudentLink (component 6)\n * - TEACHER (PRD-05 FR-22): students ACTIVE in courses they teach or\n *   co-teach, plus members of sections they are homeroom teacher of.\n */\nexport async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n  switch (user.role) {\n    case 'ADMIN':\n      return 'ALL';\n    case 'STUDENT':\n      return [user.id];\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({\n        where: { parentId: user.id },\n        select: { studentId: true },\n      });\n      return links.map((link) => link.studentId);\n    }\n    case 'TEACHER': {\n      const [enrolled, members] = await Promise.all([\n        prisma.enrollment.findMany({\n          where: {\n            status: 'ACTIVE',\n            course: { OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] },\n          },\n          select: { studentId: true },\n          distinct: ['studentId'],\n        }),\n        prisma.sectionMember.findMany({\n          where: { section: { homeroomTeacherId: user.id } },\n          select: { studentId: true },\n        }),\n      ]);\n      return [...new Set([...enrolled, ...members].map((row) => row.studentId))];\n    }\n    default:\n      return [];\n  }\n}\n\n/**\n * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n * not allowed to see this particular studentId -- NOT_FOUND rather than\n * FORBIDDEN so existence of another family's student is never revealed.\n * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n * ADMIN; TEACHER is denied students outside their courses/homeroom).\n */\nexport async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n  const accessible = await getAccessibleStudentIds(user);\n\n  if (accessible === 'ALL') return;\n\n  if (accessible.includes(studentId)) return;\n\n  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n    throw new AppError('NOT_FOUND', 'Resource not found');\n  }\n\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n}\nimport { z } from 'zod';\n\n/**\n * Course/enrollment validation (PRD-05 FR-14/FR-23), shared by the\n * /admin/courses dialog and the /api/courses* handlers. The\n * \"section required iff CORE\" rule is ONE refinement here (Decision 3).\n */\n\nexport const COURSE_KINDS = ['CORE', 'ELECTIVE'] as const;\nexport const ENROLLMENT_STATUSES = ['ACTIVE', 'DROPPED'] as const;\n\nconst nullableText = z.preprocess((v) => (v === '' ? null : v), z.string().nullable().optional());\nconst nullableId = z.preprocess((v) => (v === '' ? null : v), z.string().min(1).nullable().optional());\n\nexport const courseCodeSchema = z\n  .string()\n  .trim()\n  .min(1, 'Code is required')\n  .max(30)\n  .transform((v) => v.toUpperCase());\n\nconst courseCapacitySchema = z.preprocess(\n  (v) => (v === '' || v === undefined ? null : v),\n  z.coerce.number().int('Capacity must be a whole number').min(1, 'Capacity must be at least 1').nullable(),\n);\n\nconst coTeacherIdsSchema = z.array(z.string().min(1)).max(3, 'At most 3 co-teachers').default([]);\n\nconst courseBase = z.object({\n  academicYearId: z.string().min(1, 'Academic year is required'),\n  subjectId: z.string().min(1, 'Subject is required'),\n  sectionId: nullableId,\n  teacherId: z.string().min(1, 'Teacher is required'),\n  coTeacherIds: coTeacherIdsSchema,\n  name: z.string().trim().min(1, 'Name is required').max(120),\n  code: courseCodeSchema,\n  kind: z.enum(COURSE_KINDS).default('CORE'),\n  capacity: courseCapacitySchema.optional(),\n  description: nullableText,\n});\n\nexport const courseInputSchema = courseBase.refine((v) => v.kind !== 'CORE' || Boolean(v.sectionId), {\n  message: 'Section is required for core courses',\n  path: ['sectionId'],\n});\nexport type CourseInput = z.infer<typeof courseInputSchema>;\n\n/** academicYearId/sectionId/kind are immutable after creation. */\nexport const courseUpdateSchema = courseBase\n  .omit({ academicYearId: true, sectionId: true, kind: true })\n  .extend({ coTeacherIds: z.array(z.string().min(1)).max(3, 'At most 3 co-teachers'), archived: z.boolean() })\n  .partial();\nexport type CourseUpdateInput = z.infer<typeof courseUpdateSchema>;\n\nexport const enrollmentStatusSchema = z.object({\n  status: z.enum(ENROLLMENT_STATUSES),\n  overrideCapacity: z.boolean().optional().default(false),\n});\nexport type EnrollmentStatusInput = z.infer<typeof enrollmentStatusSchema>;\n\nconst boolFlag = z.enum(['true', 'false']).optional().transform((v) => v === 'true');\n\nexport const coursesListQuerySchema = z.object({\n  academicYearId: z.string().optional(),\n  gradeLevelId: z.string().optional(),\n  subjectId: z.string().optional(),\n  teacherId: z.string().optional(),\n  sectionId: z.string().optional(),\n  kind: z.enum(COURSE_KINDS).optional(),\n  includeArchived: boolFlag,\n  q: z.string().optional(),\n  sort: z.enum(['code', 'name', 'enrolledCount']).optional().default('code'),\n  order: z.enum(['asc', 'desc']).optional().default('asc'),\n});\nexport type CoursesListQuery = z.infer<typeof coursesListQuerySchema>;\n\nexport const rosterQuerySchema = z.object({\n  status: z.enum(['ACTIVE', 'DROPPED', 'ALL']).optional().default('ACTIVE'),\n  q: z.string().optional(),\n});\nexport type RosterQuery = z.infer<typeof rosterQuerySchema>;\n\n/** FR-14 defaults: \"<Subject> – <Section>\" / \"<SUBJECTCODE>-<SECTION>\". */\nexport function defaultCourseName(subjectName: string, sectionName?: string | null): string {\n  return sectionName ? `${subjectName} – ${sectionName}` : subjectName;\n}\n\nexport function defaultCourseCode(subjectCode: string, sectionName?: string | null): string {\n  const base = subjectCode.trim().toUpperCase();\n  return sectionName ? `${base}-${sectionName.trim().toUpperCase().replace(/\\s+/g, '')}` : base;\n}\nimport { z } from 'zod';\n\n/**\n * Section validation (PRD-05 FR-3/FR-23), shared by the /admin/sections\n * dialogs and the /api/sections* handlers.\n */\n\nconst optionalId = z.preprocess((v) => (v === '' ? null : v), z.string().min(1).nullable().optional());\n\nexport const sectionCapacitySchema = z.coerce\n  .number()\n  .int('Capacity must be a whole number')\n  .min(1, 'Capacity must be at least 1')\n  .max(60, 'Capacity must be at most 60');\n\nexport const sectionInputSchema = z.object({\n  academicYearId: z.string().min(1, 'Academic year is required'),\n  gradeLevelId: z.string().min(1, 'Grade level is required'),\n  name: z.string().trim().min(1, 'Name is required').max(40),\n  homeroomTeacherId: optionalId,\n  roomId: optionalId,\n  capacity: sectionCapacitySchema.default(30),\n});\nexport type SectionInput = z.infer<typeof sectionInputSchema>;\n\n/** academicYearId is immutable after creation. */\nexport const sectionUpdateSchema = sectionInputSchema.omit({ academicYearId: true }).partial();\nexport type SectionUpdateInput = z.infer<typeof sectionUpdateSchema>;\n\nexport const enrollStudentsSchema = z.object({\n  studentIds: z.array(z.string().min(1)).min(1, 'Pick at least one student'),\n  overrideCapacity: z.boolean().optional().default(false),\n});\nexport type EnrollStudentsInput = z.infer<typeof enrollStudentsSchema>;\n\nexport const moveSectionSchema = z.object({\n  toSectionId: z.string().min(1, 'Destination section is required'),\n  overrideCapacity: z.boolean().optional().default(false),\n});\nexport type MoveSectionInput = z.infer<typeof moveSectionSchema>;\n\nexport const coreCoursesSchema = z.object({\n  items: z\n    .array(z.object({ subjectId: z.string().min(1), teacherId: z.string().min(1, 'Teacher is required') }))\n    .min(1, 'Pick at least one subject')\n    .refine((items) => new Set(items.map((i) => i.subjectId)).size === items.length, {\n      message: 'Each subject may appear only once',\n    }),\n});\nexport type CoreCoursesInput = z.infer<typeof coreCoursesSchema>;\n\nexport const copyToYearSchema = z\n  .object({ fromYearId: z.string().min(1), toYearId: z.string().min(1) })\n  .refine((v) => v.fromYearId !== v.toYearId, { message: 'Target year must differ', path: ['toYearId'] });\nexport type CopyToYearInput = z.infer<typeof copyToYearSchema>;\n\nexport const sectionsListQuerySchema = z.object({\n  academicYearId: z.string().optional(),\n  gradeLevelId: z.string().optional(),\n  q: z.string().optional(),\n  sort: z.enum(['name', 'gradeLevel', 'memberCount']).optional().default('gradeLevel'),\n  order: z.enum(['asc', 'desc']).optional().default('asc'),\n});\nexport type SectionsListQuery = z.infer<typeof sectionsListQuerySchema>;\nsrc/server/sections/sections-service.ts:25:export function personName(user: { firstName: string; lastName: string }): string {\nsrc/server/sections/sections-service.ts:49:export type SectionDto = ReturnType<typeof toSection>;\nsrc/server/sections/sections-service.ts:57:export async function listSections(query: Partial<SectionsListQuery>, page: { skip: number; take: number }) {\nsrc/server/sections/sections-service.ts:81:export async function getSection(id: string) {\nsrc/server/sections/sections-service.ts:141:export async function createSection(input: SectionInput, actorId?: string | null) {\nsrc/server/sections/sections-service.ts:163:export async function updateSection(id: string, input