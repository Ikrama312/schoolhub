{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A4JMtC3XavdPzGxLUxBhw7","type":"tool_result","content":"1\tgenerator client {\n2\t  provider = \"prisma-client-js\"\n3\t}\n4\t\n5\tdatasource db {\n6\t  provider = \"postgresql\"\n7\t  url      = env(\"DATABASE_URL\")\n8\t}\n9\t\n10\tenum Role {\n11\t  ADMIN\n12\t  TEACHER\n13\t  STUDENT\n14\t  PARENT\n15\t}\n16\t\n17\tenum UserStatus {\n18\t  ACTIVE\n19\t  INVITED\n20\t  DISABLED\n21\t  ARCHIVED\n22\t}\n23\t\n24\tenum AuthTokenType {\n25\t  INVITE\n26\t  PASSWORD_RESET\n27\t}\n28\t\n29\tenum Gender {\n30\t  FEMALE\n31\t  MALE\n32\t  OTHER\n33\t  UNDISCLOSED\n34\t}\n35\t\n36\tenum GuardianRelationship {\n37\t  MOTHER\n38\t  FATHER\n39\t  GUARDIAN\n40\t  GRANDPARENT\n41\t  OTHER\n42\t}\n43\t\n44\tenum EmailStatus {\n45\t  PENDING\n46\t  SENDING\n47\t  SENT\n48\t  FAILED\n49\t}\n50\t\n51\t/// Every authenticated person. passwordHash is nullable because an INVITED\n52\t/// user has no password until they accept their invite (TASK-8's\n53\t/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n54\t/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n55\t/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n56\t/// field shared by every role, archivedAt backs FR-13's archive/restore\n57\t/// (separate from status so a DISABLED-but-not-archived user stays distinct\n58\t/// from an archived one).\n59\tmodel User {\n60\t  id                      String                   @id @default(cuid())\n61\t  email                   String                   @unique\n62\t  passwordHash            String?\n63\t  firstName               String\n64\t  lastName                String\n65\t  phone                   String?\n66\t  role                    Role\n67\t  status                  UserStatus               @default(INVITED)\n68\t  failedLoginCount        Int                      @default(0)\n69\t  lockedUntil             DateTime?\n70\t  lastLoginAt             DateTime?\n71\t  passwordChangedAt       DateTime?\n72\t  archivedAt              DateTime?\n73\t  createdAt               DateTime                 @default(now())\n74\t  updatedAt               DateTime                 @updatedAt\n75\t  authTokens              AuthToken[]\n76\t  auditLogs               AuditLog[]\n77\t  studentProfile          StudentProfile?\n78\t  teacherProfile          TeacherProfile?\n79\t  parentProfile           ParentProfile?\n80\t  parentLinks             ParentStudentLink[]      @relation(\"ParentLinks\")\n81\t  studentLinks            ParentStudentLink[]      @relation(\"StudentLinks\")\n82\t  notifications           Notification[]\n83\t  notificationPreferences NotificationPreference[]\n84\t  homeroomSections        Section[]                @relation(\"HomeroomTeacher\")\n85\t  sectionMemberships      SectionMember[]\n86\t  taughtCourses           Course[]                 @relation(\"CourseTeacher\")\n87\t  enrollments             Enrollment[]\n88\t  attendanceTaken         AttendanceSession[]      @relation(\"AttendanceTakenBy\")\n89\t  attendanceUpdated       AttendanceSession[]      @relation(\"AttendanceUpdatedBy\")\n90\t  attendanceRecords       AttendanceRecord[]\n91\t  files                   FileObject[]\n92\t  submissions             Submission[]             @relation(\"SubmissionStudent\")\n93\t  gradedSubmissions       Submission[]             @relation(\"SubmissionGrader\")\n94\t  quizzesCreated          Quiz[]                   @relation(\"QuizCreatedBy\")\n95\t  quizAttempts            QuizAttempt[]\n96\t  quizAccommodations      QuizAccommodation[]\n97\t  quizAnswersGraded       QuizAnswer[]             @relation(\"QuizAnswerGradedBy\")\n98\t\n99\t  @@index([lastName, firstName, email])\n100\t  @@index([role, status])\n101\t}\n102\t\n103\t/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n104\t/// only -- enforced in the service layer (src/server/services/users.ts,\n105\t/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\n106\tmodel StudentProfile {\n107\t  userId           String     @id\n108\t  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n109\t  admissionNumber  String     @unique\n110\t  dateOfBirth      DateTime   @db.Date\n111\t  gender           Gender     @default(UNDISCLOSED)\n112\t  gradeLevelId     String\n113\t  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n114\t  enrollmentDate   DateTime   @db.Date\n115\t  addressLine1     String?\n116\t  city             String?\n117\t  medicalNotes     String?\n118\t  emergencyContact String?\n119\t  emergencyPhone   String?\n120\t}\n121\t\n122\t/// Teacher-specific fields (FR-1).\n123\tmodel TeacherProfile {\n124\t  userId         String    @id\n125\t  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n126\t  employeeNumber String    @unique\n127\t  title          String?\n128\t  qualifications String?\n129\t  hireDate       DateTime? @db.Date\n130\t}\n131\t\n132\t/// Parent-specific fields (FR-1).\n133\tmodel ParentProfile {\n134\t  userId     String  @id\n135\t  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n136\t  occupation String?\n137\t  address    String?\n138\t}\n139\t\n140\t/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n141\t/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n142\t/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n143\t/// transaction invariants rather than DB constraints.\n144\tmodel ParentStudentLink {\n145\t  id           String               @id @default(cuid())\n146\t  parentId     String\n147\t  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n148\t  studentId    String\n149\t  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n150\t  relationship GuardianRelationship\n151\t  isPrimary    Boolean              @default(false)\n152\t  createdAt    DateTime             @default(now())\n153\t\n154\t  @@unique([parentId, studentId])\n155\t  @@index([studentId])\n156\t}\n157\t\n158\t/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n159\t/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n160\t/// user. One shared shape for both token types; src/server/auth/tokens.ts\n161\t/// is the single producer/consumer.\n162\tmodel AuthToken {\n163\t  id        String        @id @default(cuid())\n164\t  userId    String\n165\t  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n166\t  type      AuthTokenType\n167\t  tokenHash String        @unique\n168\t  expiresAt DateTime\n169\t  usedAt    DateTime?\n170\t  createdAt DateTime      @default(now())\n171\t\n172\t  @@index([userId, type])\n173\t}\n174\t\n175\t/// Insert-only audit trail written exclusively through src/server/audit.ts's\n176\t/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n177\t/// non-existent email can still be recorded.\n178\tmodel AuditLog {\n179\t  id         String   @id @default(cuid())\n180\t  actorId    String?\n181\t  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n182\t  action     String\n183\t  entityType String?\n184\t  entityId   String?\n185\t  metadata   Json?\n186\t  ip         String?\n187\t  createdAt  DateTime @default(now())\n188\t\n189\t  @@index([actorId])\n190\t  @@index([action])\n191\t  @@index([entityType, entityId])\n192\t  @@index([actorId, createdAt])\n193\t}\n194\t\n195\t/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n196\t/// info. Later PRDs read this for top-bar branding and public footer; no\n197\t/// other PRD should add a second row or a second settings model.\n198\tmodel SchoolSettings {\n199\t  id                       String         @id @default(\"singleton\")\n200\t  name                     String         @default(\"SchoolHub Academy\")\n201\t  shortName                String         @default(\"SchoolHub\")\n202\t  logoUrl                  String?\n203\t  timezone                 String         @default(\"UTC\")\n204\t  addressLine1             String?\n205\t  addressLine2             String?\n206\t  city                     String?\n207\t  country                  String?\n208\t  phone                    String?\n209\t  email                    String?\n210\t  website                  String?\n211\t  /// PRD-07 FR-4\n212\t  attendanceMode           AttendanceMode @default(PER_PERIOD)\n213\t  attendanceAlertThreshold Int            @default(90)\n214\t  createdAt                DateTime       @default(now())\n215\t  updatedAt                DateTime       @updatedAt\n216\t}\n217\t\n218\t/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n219\t/// at a time -- enforced in src/server/services/academicYears.ts's\n220\t/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n221\t/// express \"exactly one true\" as a simple unique index).\n222\tmodel AcademicYear {\n223\t  id             String          @id @default(cuid())\n224\t  name           String          @unique\n225\t  startDate      DateTime        @db.Date\n226\t  endDate        DateTime        @db.Date\n227\t  isCurrent      Boolean         @default(false)\n228\t  createdAt      DateTime        @default(now())\n229\t  updatedAt      DateTime        @updatedAt\n230\t  terms          Term[]\n231\t  sections       Section[]\n232\t  courses        Course[]\n233\t  timetableSlots TimetableSlot[]\n234\t}\n235\t\n236\t/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n237\t/// Restrict means the year can't be deleted while it still has terms --\n238\t/// the service layer checks this first to return a friendly 409 instead of\n239\t/// a raw FK error.\n240\tmodel Term {\n241\t  id             String       @id @default(cuid())\n242\t  academicYearId String\n243\t  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n244\t  name           String\n245\t  startDate      DateTime     @db.Date\n246\t  endDate        DateTime     @db.Date\n247\t  order          Int\n248\t  createdAt      DateTime     @default(now())\n249\t  updatedAt      DateTime     @updatedAt\n250\t\n251\t  @@unique([academicYearId, name])\n252\t  @@unique([academicYearId, order])\n253\t}\n254\t\n255\t/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n256\t/// reference grade levels, so they're archived instead of deleted.\n257\tmodel GradeLevel {\n258\t  id              String           @id @default(cuid())\n259\t  name            String           @unique\n260\t  shortName       String           @unique\n261\t  order           Int              @unique\n262\t  archivedAt      DateTime?\n263\t  createdAt       DateTime         @default(now())\n264\t  updatedAt       DateTime         @updatedAt\n265\t  studentProfiles StudentProfile[]\n266\t  sections        Section[]\n267\t}\n268\t\n269\t/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n270\t/// the service layer, not the DB) so the unique constraint catches\n271\t/// case-insensitive duplicates like \"math\" vs \"MATH\".\n272\tmodel Subject {\n273\t  id          String    @id @default(cuid())\n274\t  name        String\n275\t  code        String    @unique\n276\t  description String?\n277\t  color       String    @default(\"#4F46E5\")\n278\t  archivedAt  DateTime?\n279\t  createdAt   DateTime  @default(now())\n280\t  updatedAt   DateTime  @updatedAt\n281\t  courses     Course[]\n282\t}\n283\t\n284\t/// A physical room classes are scheduled in.\n285\tmodel Room {\n286\t  id             String          @id @default(cuid())\n287\t  name           String          @unique\n288\t  building       String?\n289\t  capacity       Int?\n290\t  archivedAt     DateTime?\n291\t  createdAt      DateTime        @default(now())\n292\t  updatedAt      DateTime        @updatedAt\n293\t  sections       Section[]\n294\t  timetableSlots TimetableSlot[]\n295\t}\n296\t\n297\t/// In-app notification (PRD-04 FR-1). type is a key from the compile-time\n298\t/// registry (src/server/notifications/types.ts) rather than an enum/FK, so\n299\t/// later PRDs register new keys without a migration. category is resolved\n300\t/// from the registry at read time (src/server/notifications/list.ts), not\n301\t/// stored here. The composite index backs both getUnreadCount() (NFR-3,\n302\t/// <50ms) and listNotifications()'s own-rows-newest-first query.\n303\tmodel Notification {\n304\t  id        String    @id @default(cuid())\n305\t  userId    String\n306\t  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n307\t  type      String\n308\t  title     String\n309\t  body      String?\n310\t  link      String?\n311\t  readAt    DateTime?\n312\t  createdAt DateTime  @default(now())\n313\t  updatedAt DateTime  @updatedAt\n314\t\n315\t  @@index([userId, readAt, createdAt])\n316\t}\n317\t\n318\t/// Per-user, per-type override of the registry's defaultEmail/mandatoryInApp\n319\t/// defaults (PRD-04 FR-3). Composite PK instead of a surrogate id/unique\n320\t/// index -- there is exactly one row per (userId, type) by construction\n321\t/// (notify.ts and the preferences PUT route both upsert on it).\n322\tmodel NotificationPreference {\n323\t  userId    String\n324\t  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n325\t  type      String\n326\t  inApp     Boolean  @default(true)\n327\t  email     Boolean  @default(true)\n328\t  updatedAt DateTime @updatedAt\n329\t\n330\t  @@id([userId, type])\n331\t}\n332\t\n333\t/// Durable outbox row the dispatcher claims and sends (PRD-04 FR-1/FR-5).\n334\t/// No FK to User -- toEmail/toName are a point-in-time snapshot (matches\n335\t/// the PRD's schema block exactly) so a later email change or user deletion\n336\t/// never blocks a queued send. updatedAt doubles as the \"flipped to\n337\t/// SENDING\" timestamp the >10-minute stuck-row recovery checks (NFR-4) --\n338\t/// Prisma's @updatedAt already bumps it on that status-flip UPDATE, so no\n339\t/// separate column is needed.\n340\tmodel EmailOutbox {\n341\t  id            String      @id @default(cuid())\n342\t  toEmail       String\n343\t  toName        String?\n344\t  subject       String\n345\t  html          String\n346\t  text          String\n347\t  status        EmailStatus @default(PENDING)\n348\t  attempts      Int         @default(0)\n349\t  lastError     String?\n350\t  nextAttemptAt DateTime    @default(now())\n351\t  sentAt        DateTime?\n352\t  createdAt     DateTime    @default(now())\n353\t  updatedAt     DateTime    @updatedAt\n354\t\n355\t  @@index([status, nextAttemptAt])\n356\t}\n357\t\n358\t// ---------------------------------------------------------------------------\n359\t// PRD-05 Classes & Enrollment (FR-1). Shapes match the PRD schema block\n360\t// exactly; business rules (capacity, CORE auto-enroll, homeroom-once-per-year)\n361\t// live in src/server/enrollment/roster-engine.ts and the sections/courses\n362\t// services, not here.\n363\t// ---------------------------------------------------------------------------\n364\t\n365\tenum CourseKind {\n366\t  CORE\n367\t  ELECTIVE\n368\t}\n369\t\n370\tenum EnrollmentStatus {\n371\t  ACTIVE\n372\t  DROPPED\n373\t}\n374\t\n375\t/// Homeroom group, e.g. \"7A\". capacity is 1-60 (validated in zod).\n376\tmodel Section {\n377\t  id                 String              @id @default(cuid())\n378\t  academicYearId     String\n379\t  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n380\t  gradeLevelId       String\n381\t  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id])\n382\t  name               String\n383\t  homeroomTeacherId  String?\n384\t  homeroomTeacher    User?               @relation(\"HomeroomTeacher\", fields: [homeroomTeacherId], references: [id])\n385\t  roomId             String?\n386\t  room               Room?               @relation(fields: [roomId], references: [id])\n387\t  capacity           Int                 @default(30)\n388\t  createdAt          DateTime            @default(now())\n389\t  updatedAt          DateTime            @updatedAt\n390\t  members            SectionMember[]\n391\t  courses            Course[]\n392\t  attendanceSessions AttendanceSession[]\n393\t\n394\t  @@unique([academicYearId, name])\n395\t}\n396\t\n397\t/// academicYearId is denormalised so the DB enforces one section per\n398\t/// student per year (NFR-2).\n399\tmodel SectionMember {\n400\t  id             String   @id @default(cuid())\n401\t  sectionId      String\n402\t  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n403\t  studentId      String\n404\t  student        User     @relation(fields: [studentId], references: [id])\n405\t  joinedAt       DateTime @default(now())\n406\t  academicYearId String\n407\t\n408\t  @@unique([studentId, academicYearId])\n409\t}\n410\t\n411\t/// sectionId is null for cross-section electives. coTeacherIds is a plain\n412\t/// String[] exactly per FR-1 (queried with `has`), max 3 enforced in zod.\n413\tmodel Course {\n414\t  id                 String              @id @default(cuid())\n415\t  academicYearId     String\n416\t  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n417\t  subjectId          String\n418\t  subject            Subject             @relation(fields: [subjectId], references: [id])\n419\t  sectionId          String?\n420\t  section            Section?            @relation(fields: [sectionId], references: [id])\n421\t  teacherId          String\n422\t  teacher            User                @relation(\"CourseTeacher\", fields: [teacherId], references: [id])\n423\t  coTeacherIds       String[]            @default([])\n424\t  name               String\n425\t  code               String\n426\t  kind               CourseKind          @default(CORE)\n427\t  description        String?\n428\t  capacity           Int?\n429\t  archivedAt         DateTime?\n430\t  createdAt          DateTime            @default(now())\n431\t  updatedAt          DateTime            @updatedAt\n432\t  enrollments        Enrollment[]\n433\t  timetableSlots     TimetableSlot[]\n434\t  attendanceSessions AttendanceSession[]\n435\t  modules            Module[]\n436\t  assignments        Assignment[]\n437\t  quizzes            Quiz[]\n438\t\n439\t  @@unique([academicYearId, code])\n440\t}\n441\t\n442\t/// DROPPED rows are kept (never deleted) so later PRDs' attendance/grades\n443\t/// history stays attached (FR-12).\n444\tmodel Enrollment {\n445\t  id         String           @id @default(cuid())\n446\t  courseId   String\n447\t  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n448\t  studentId  String\n449\t  student    User             @relation(fields: [studentId], references: [id])\n450\t  status     EnrollmentStatus @default(ACTIVE)\n451\t  enrolledAt DateTime         @default(now())\n452\t  droppedAt  DateTime?\n453\t\n454\t  @@unique([courseId, studentId])\n455\t  @@index([studentId, status])\n456\t}\n457\t\n458\t// ---------------------------------------------------------------------------\n459\t// PRD-06 Bell Schedule & Timetable (FR-1..FR-4). One repeating week (NFR-15).\n460\t// Clash rules live in src/server/timetable/, not in the DB.\n461\t// ---------------------------------------------------------------------------\n462\t\n463\tenum PeriodKind {\n464\t  CLASS\n465\t  BREAK\n466\t  LUNCH\n467\t  ASSEMBLY\n468\t}\n469\t\n470\t/// startTime/endTime are 'HH:MM' in SchoolSettings.timezone. order is display order only.\n471\tmodel Period {\n472\t  id                 String              @id @default(cuid())\n473\t  name               String\n474\t  startTime          String\n475\t  endTime            String\n476\t  kind               PeriodKind          @default(CLASS)\n477\t  order              Int                 @unique\n478\t  slots              TimetableSlot[]\n479\t  attendanceSessions AttendanceSession[]\n480\t  createdAt          DateTime            @default(now())\n481\t  updatedAt          DateTime            @updatedAt\n482\t}\n483\t\n484\t/// ISO weekday 1=Mon … 7=Sun; seeded with all 7 rows.\n485\tmodel SchoolDay {\n486\t  dayOfWeek  Int     @id\n487\t  isTeaching Boolean @default(true)\n488\t}\n489\t\n490\t/// period is Restrict: deletePeriod refuses with 409 while slots exist (FR-8).\n491\tmodel TimetableSlot {\n492\t  id             String       @id @default(cuid())\n493\t  academicYearId String\n494\t  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])\n495\t  courseId       String\n496\t  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)\n497\t  dayOfWeek      Int\n498\t  periodId       String\n499\t  period         Period       @relation(fields: [periodId], references: [id])\n500\t  roomId         String?\n501\t  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)\n502\t  createdAt      DateTime     @default(now())\n503\t  updatedAt      DateTime     @updatedAt\n504\t\n505\t  @@unique([courseId, dayOfWeek, periodId])\n506\t  @@index([academicYearId, dayOfWeek, periodId])\n507\t}\n508\t\n509\t// ---------------------------------------------------------------------------\n510\t// PRD-07 Attendance (FR-1..FR-4). Exactly-one-of(courseId, sectionId) and the\n511\t// two partial unique indexes live in the migration SQL (ADR-2) -- Prisma\n512\t// can't express them.\n513\t// ---------------------------------------------------------------------------\n514\t\n515\tenum AttendanceStatus {\n516\t  PRESENT\n517\t  ABSENT\n518\t  LATE\n519\t  EXCUSED\n520\t}\n521\t\n522\tenum AttendanceMode {\n523\t  PER_PERIOD\n524\t  DAILY_HOMEROOM\n525\t  BOTH\n526\t}\n527\t\n528\t/// Course session (courseId + periodId) or daily homeroom register (sectionId).\n529\tmodel AttendanceSession {\n530\t  id          String             @id @default(cuid())\n531\t  courseId    String?\n532\t  course      Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)\n533\t  sectionId   String?\n534\t  section     Section?           @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n535\t  periodId    String?\n536\t  period      Period?            @relation(fields: [periodId], references: [id])\n537\t  date        DateTime           @db.Date\n538\t  takenById   String\n539\t  takenBy     User               @relation(\"AttendanceTakenBy\", fields: [takenById], references: [id])\n540\t  updatedById String\n541\t  updatedBy   User               @relation(\"AttendanceUpdatedBy\", fields: [updatedById], references: [id])\n542\t  createdAt   DateTime           @default(now())\n543\t  updatedAt   DateTime           @updatedAt\n544\t  records     AttendanceRecord[]\n545\t\n546\t  @@index([date])\n547\t}\n548\t\n549\t/// minutesLate is 1..240 iff LATE; note <= 500 (zod, FR-12).\n550\tmodel AttendanceRecord {\n551\t  id          String            @id @default(cuid())\n552\t  sessionId   String\n553\t  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n554\t  studentId   String\n555\t  student     User              @relation(fields: [studentId], references: [id])\n556\t  status      AttendanceStatus\n557\t  minutesLate Int?\n558\t  note        String?\n559\t  createdAt   DateTime          @default(now())\n560\t  updatedAt   DateTime          @updatedAt\n561\t\n562\t  @@unique([sessionId, studentId])\n563\t  @@index([studentId, createdAt])\n564\t}\n565\t\n566\t// ---------------------------------------------------------------------------\n567\t// PRD-08 File storage & course content (SH-8)\n568\t// ---------------------------------------------------------------------------\n569\t\n570\t/// Generic uploaded file (FR-1). Bytes live under UPLOAD_DIR; access goes\n571\t/// through src/server/files/access.ts. contextId null = unattached (purged after 24 h).\n572\tmodel FileObject {\n573\t  id                    String                 @id @default(cuid())\n574\t  ownerId               String\n575\t  owner                 User                   @relation(fields: [ownerId], references: [id])\n576\t  originalName          String\n577\t  mimeType              String\n578\t  sizeBytes             Int\n579\t  storageKey            String                 @unique\n580\t  sha256                String\n581\t  context               String\n582\t  contextId             String?\n583\t  createdAt             DateTime               @default(now())\n584\t  lessonAttachments     LessonAttachment[]\n585\t  assignmentAttachments AssignmentAttachment[]\n586\t  submissionFiles       SubmissionFile[]\n587\t\n588\t  @@index([context, contextId])\n589\t}\n590\t\n591\tenum ContentStatus {\n592\t  DRAFT\n593\t  SCHEDULED\n594\t  PUBLISHED\n595\t}\n596\t\n597\tmodel Module {\n598\t  id          String        @id @default(cuid())\n599\t  courseId    String\n600\t  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)\n601\t  title       String\n602\t  description String?\n603\t  order       Int\n604\t  status      ContentStatus @default(DRAFT)\n605\t  publishAt   DateTime?\n606\t  createdAt   DateTime      @default(now())\n607\t  updatedAt   DateTime      @updatedAt\n608\t  lessons     Lesson[]\n609\t\n610\t  @@index([courseId, order])\n611\t}\n612\t\n613\tmodel Lesson {\n614\t  id               String             @id @default(cuid())\n615\t  moduleId         String\n616\t  module           Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)\n617\t  title            String\n618\t  contentMarkdown  String             @default(\"\")\n619\t  videoUrl         String?\n620\t  estimatedMinutes Int?\n621\t  order            Int\n622\t  status           ContentStatus      @default(DRAFT)\n623\t  publishAt        DateTime?\n624\t  createdAt        DateTime           @default(now())\n625\t  updatedAt        DateTime           @updatedAt\n626\t  attachments      LessonAttachment[]\n627\t  links            LessonLink[]\n628\t  progress         LessonProgress[]\n629\t\n630\t  @@index([moduleId, order])\n631\t}\n632\t\n633\t/// file has no onDelete -> Restrict: an attached file can't be hard-deleted (FR-11).\n634\tmodel LessonAttachment {\n635\t  id       String     @id @default(cuid())\n636\t  lessonId String\n637\t  lesson   Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n638\t  fileId   String\n639\t  file     FileObject @relation(fields: [fileId], references: [id])\n640\t  order    Int\n641\t}\n642\t\n643\tmodel LessonLink {\n644\t  id       String @id @default(cuid())\n645\t  lessonId String\n646\t  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n647\t  title    String\n648\t  url      String\n649\t  order    Int\n650\t}\n651\t\n652\tmodel LessonProgress {\n653\t  lessonId      String\n654\t  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n655\t  studentId     String\n656\t  firstViewedAt DateTime  @default(now())\n657\t  completedAt   DateTime?\n658\t\n659\t  @@id([lessonId, studentId])\n660\t}\n661\t\n662\t// ---------------------------------------------------------------------------\n663\t// PRD-09 assignments & submissions (SH-9, system-design §2.1)\n664\t// ---------------------------------------------------------------------------\n665\t\n666\tenum SubmissionType {\n667\t  ONLINE_TEXT\n668\t  FILE_UPLOAD\n669\t  TEXT_AND_FILE\n670\t  NO_SUBMISSION\n671\t}\n672\t\n673\tenum AssignmentStatus {\n674\t  DRAFT\n675\t  SCHEDULED\n676\t  PUBLISHED\n677\t}\n678\t\n679\tenum SubmissionStatus {\n680\t  SUBMITTED\n681\t  RETURNED\n682\t}\n683\t\n684\tmodel Assignment {\n685\t  id                       String                 @id @default(cuid())\n686\t  courseId                 String\n687\t  course                   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)\n688\t  title                    String\n689\t  instructions             String                 @default(\"\") @db.Text\n690\t  submissionType           SubmissionType\n691\t  maxPoints                Decimal                @db.Decimal(6, 2)\n692\t  dueAt                    DateTime\n693\t  availableFrom            DateTime?\n694\t  allowLate                Boolean                @default(false)\n695\t  lateCutoffAt             DateTime?\n696\t  latePenaltyPercentPerDay Decimal                @default(0) @db.Decimal(5, 2)\n697\t  maxLatePenaltyPercent    Decimal                @default(0) @db.Decimal(5, 2)\n698\t  maxFileCount             Int                    @default(3)\n699\t  allowExtraCredit         Boolean                @default(false)\n700\t  status                   AssignmentStatus       @default(DRAFT)\n701\t  rubricId                 String?                @unique\n702\t  rubric                   Rubric?                @relation(fields: [rubricId], references: [id], onDelete: SetNull)\n703\t  notifiedAt               DateTime?\n704\t  archivedAt               DateTime?\n705\t  createdById              String\n706\t  createdAt                DateTime               @default(now())\n707\t  updatedAt                DateTime               @updatedAt\n708\t  attachments              AssignmentAttachment[]\n709\t  submissions              Submission[]\n710\t  exemptions               GradeExemption[]\n711\t  reminders                AssignmentReminder[]\n712\t\n713\t  @@index([courseId, dueAt])\n714\t}\n715\t\n716\t/// file has no onDelete -> Restrict: an attached file can't be hard-deleted.\n717\tmodel AssignmentAttachment {\n718\t  assignmentId String\n719\t  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n720\t  fileId       String\n721\t  file         FileObject @relation(fields: [fileId], references: [id])\n722\t\n723\t  @@id([assignmentId, fileId])\n724\t}\n725\t\n726\tmodel Rubric {\n727\t  id         String            @id @default(cuid())\n728\t  criteria   RubricCriterion[]\n729\t  assignment Assignment?\n730\t}\n731\t\n732\tmodel RubricCriterion {\n733\t  id          String  @id @default(cuid())\n734\t  rubricId    String\n735\t  rubric      Rubric  @relation(fields: [rubricId], references: [id], onDelete: Cascade)\n736\t  title       String\n737\t  description String?\n738\t  maxPoints   Decimal @db.Decimal(6, 2)\n739\t  order       Int\n740\t  /// [{label, points, description}]\n741\t  levels      Json\n742\t\n743\t  @@index([rubricId, order])\n744\t}\n745\t\n746\t/// One row per (assignment, student); earlier attempts live in SubmissionHistory.\n747\t/// attemptNumber 0 = offline grade (FR-8).\n748\tmodel Submission {\n749\t  id             String              @id @default(cuid())\n750\t  assignmentId   String\n751\t  assignment     Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n752\t  studentId      String\n753\t  student        User                @relation(\"SubmissionStudent\", fields: [studentId], references: [id])\n754\t  status         SubmissionStatus    @default(SUBMITTED)\n755\t  text           String?             @db.Text\n756\t  attemptNumber  Int\n757\t  submittedAt    DateTime\n758\t  isLate         Boolean             @default(false)\n759\t  lateDays       Int                 @default(0)\n760\t  rawScore       Decimal?            @db.Decimal(6, 2)\n761\t  penaltyPercent Decimal?            @db.Decimal(5, 2)\n762\t  finalScore     Decimal?            @db.Decimal(6, 2)\n763\t  /// [{criterionId, points, comment}]\n764\t  rubricScores   Json?\n765\t  feedback       String?             @db.Text\n766\t  gradedById     String?\n767\t  gradedBy       User?               @relation(\"SubmissionGrader\", fields: [gradedById], references: [id])\n768\t  gradedAt       DateTime?\n769\t  returnedAt     DateTime?\n770\t  createdAt      DateTime            @default(now())\n771\t  updatedAt      DateTime            @updatedAt\n772\t  files          SubmissionFile[]\n773\t  history        SubmissionHistory[]\n774\t\n775\t  @@unique([assignmentId, studentId])\n776\t  @@index([studentId])\n777\t}\n778\t\n779\tmodel SubmissionFile {\n780\t  submissionId String\n781\t  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)\n782\t  fileId       String\n783\t  file         FileObject @relation(fields: [fileId], references: [id])\n784\t\n785\t  @@id([submissionId, fileId])\n786\t}\n787\t\n788\t/// fileIds has no FK on purpose: old-attempt files stay attached to the submission (B1).\n789\tmodel SubmissionHistory {\n790\t  id            String     @id @default(cuid())\n791\t  submissionId  String\n792\t  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)\n793\t  attemptNumber Int\n794\t  text          String?    @db.Text\n795\t  fileIds       String[]\n796\t  submittedAt   DateTime\n797\t\n798\t  @@index([submissionId, attemptNumber])\n799\t}\n800\t\n801\t/// The row itself is the PRD-11 \"exclude from gradebook\" flag (FR-35).\n802\tmodel GradeExemption {\n803\t  assignmentId String\n804\t  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n805\t  studentId    String\n806\t  reason       String?\n807\t  createdAt    DateTime   @default(now())\n808\t\n809\t  @@id([assignmentId, studentId])\n810\t}\n811\t\n812\t/// Idempotency key for due_soon / missing reminders (FR-6).\n813\tmodel AssignmentReminder {\n814\t  id           String     @id @default(cuid())\n815\t  assignmentId String\n816\t  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n817\t  studentId    String\n818\t  kind         String\n819\t  createdAt    DateTime   @default(now())\n820\t\n821\t  @@unique([assignmentId, studentId, kind])\n822\t}\n823\t\n824\t// ---------------------------------------------------------------------------\n825\t// PRD-10 Quizzes (FR-1). Fields exactly per the PRD; only relations/indexes added.\n826\t// ---------------------------------------------------------------------------\n827\t\n828\tenum QuizStatus {\n829\t  DRAFT\n830\t  PUBLISHED\n831\t  CLOSED\n832\t}\n833\t\n834\tenum QuestionType {\n835\t  SINGLE_CHOICE\n836\t  MULTIPLE_CHOICE\n837\t  TRUE_FALSE\n838\t  SHORT_ANSWER\n839\t  ESSAY\n840\t}\n841\t\n842\tenum ResultsVisibility {\n843\t  IMMEDIATELY\n844\t  AFTER_CLOSE\n845\t  MANUAL\n846\t}\n847\t\n848\tenum AttemptStatus {\n849\t  IN_PROGRESS\n850\t  SUBMITTED\n851\t  NEEDS_GRADING\n852\t  GRADED\n853\t}\n854\t\n855\tenum ScoringPolicy {\n856\t  HIGHEST\n857\t  LATEST\n858\t  AVERAGE\n859\t}\n860\t\n861\tmodel Quiz {\n862\t  id                 String              @id @default(cuid())\n863\t  courseId           String\n864\t  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)\n865\t  title              String\n866\t  instructions       String              @default(\"\") // Markdown\n867\t  isPractice         Boolean             @default(false) // practice quizzes never reach the gradebook\n868\t  availableFrom      DateTime\n869\t  availableUntil     DateTime // > availableFrom\n870\t  timeLimitMinutes   Int? // 1–300, null = untimed\n871\t  maxAttempts        Int                 @default(1) // 1–10\n872\t  scoringPolicy      ScoringPolicy       @default(HIGHEST)\n873\t  shuffleQuestions   Boolean             @default(false)\n874\t  shuffleOptions     Boolean             @default(false)\n875\t  oneQuestionPerPage Boolean             @default(false)\n876\t  resultsVisibility  ResultsVisibility   @default(AFTER_CLOSE)\n877\t  showCorrectAnswers Boolean             @default(true) // when results are visible\n878\t  resultsReleasedAt  DateTime? // MANUAL release; also the AFTER_CLOSE \"notified once\" claim (A6)\n879\t  status             QuizStatus          @default(DRAFT)\n880\t  createdById        String\n881\t  createdBy          User                @relation(\"QuizCreatedBy\", fields: [createdById], references: [id])\n882\t  createdAt          DateTime            @default(now())\n883\t  updatedAt          DateTime            @updatedAt\n884\t  questions          Question[]\n885\t  attempts           QuizAttempt[]\n886\t  accommodations     QuizAccommodation[]\n887\t\n888\t  @@index([courseId, status])\n889\t}\n890\t\n891\tmodel Question {\n892\t  id            String       @id @default(cuid())\n893\t  quizId        String\n894\t  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)\n895\t  type          QuestionType\n896\t  prompt        String // Markdown, may include an uploaded image\n897\t  points        Decimal      @db.Decimal(5, 2) // 0.5–100\n898\t  order         Int\n899\t  options       Json? // choice types: [{ id, text }]\n900\t  correct       Json // see FR-2\n901\t  explanation   String? // shown with correct answers\n902\t  caseSensitive Boolean      @default(false) // SHORT_ANSWER\n903\t  answers       QuizAnswer[]\n904\t\n905\t  @@index([quizId, order])\n906\t}\n907\t\n908\t/// Only one IN_PROGRESS attempt per (quizId, studentId): partial unique index\n909\t/// \"quiz_attempt_one_in_progress_uq\" lives in migration 20261110000000_add_quizzes (FR-19, ADR-2).\n910\t/// Prisma can't express it — never use `prisma db push`.\n911\tmodel QuizAttempt {\n912\t  id            String        @id @default(cuid())\n913\t  quizId        String\n914\t  quiz          Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)\n915\t  studentId     String\n916\t  student       User          @relation(fields: [studentId], references: [id])\n917\t  attemptNumber Int\n918\t  status        AttemptStatus @default(IN_PROGRESS)\n919\t  startedAt     DateTime      @default(now())\n920\t  deadlineAt    DateTime? // min(startedAt + limit + extraTime, availableUntil)\n921\t  submittedAt   DateTime?\n922\t  autoSubmitted Boolean       @default(false)\n923\t  questionOrder String[] // frozen order for this attempt\n924\t  score         Decimal?      @db.Decimal(7, 2)\n925\t  maxScore      Decimal       @db.Decimal(7, 2)\n926\t  answers       QuizAnswer[]\n927\t\n928\t  @@unique([quizId, studentId, attemptNumber])\n929\t  @@index([quizId, status])\n930\t  @@index([status, deadlineAt])\n931\t}\n932\t\n933\tmodel QuizAnswer {\n934\t  attemptId     String\n935\t  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)\n936\t  questionId    String\n937\t  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)\n938\t  response      Json?\n939\t  pointsAwarded Decimal?    @db.Decimal(5, 2)\n940\t  isCorrect     Boolean?\n941\t  feedback      String?\n942\t  gradedById    String?\n943\t  gradedBy      User?       @relation(\"QuizAnswerGradedBy\", fields: [gradedById], references: [id])\n944\t  updatedAt     DateTime    @updatedAt\n945\t\n946\t  @@id([attemptId, questionId])\n947\t}\n948\t\n949\tmodel QuizAccommodation {\n950\t  quizId           String\n951\t  quiz             Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)\n952\t  studentId        String\n953\t  student          User   @relation(fields: [studentId], references: [id])\n954\t  extraTimeMinutes Int    @default(0) // 0–300\n955\t  extraAttempts    Int    @default(0) // 0–5\n956\t\n957\t  @@id([quizId, studentId])\n958\t}\n959\t"}]},"parent_tool_use_id":null,"session_id":"c6f85ae0-4ad4-4d10-b797-6ff9d3e2b1f5","uuid":"20a241dd-40b9-494d-9fab-41e327607bca","timestamp":"2026-11-09T12:15:38.792Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/prisma/schema.prisma","content":"generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\nenum Gender {\n  FEMALE\n  MALE\n  OTHER\n  UNDISCLOSED\n}\n\nenum GuardianRelationship {\n  MOTHER\n  FATHER\n  GUARDIAN\n  GRANDPARENT\n  OTHER\n}\n\nenum EmailStatus {\n  PENDING\n  SENDING\n  SENT\n  FAILED\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n/// field shared by every role, archivedAt backs FR-13's archive/restore\n/// (separate from status so a DISABLED-but-not-archived user stays distinct\n/// from an archived one).\nmodel User {\n  id                      String                   @id @default(cuid())\n  email                   String                   @unique\n  passwordHash            String?\n  firstName               String\n  lastName                String\n  phone                   String?\n  role                    Role\n  status                  UserStatus               @default(INVITED)\n  failedLoginCount        Int                      @default(0)\n  lockedUntil             DateTime?\n  lastLoginAt             DateTime?\n  passwordChangedAt       DateTime?\n  archivedAt              DateTime?\n  createdAt               DateTime                 @default(now())\n  updatedAt               DateTime                 @updatedAt\n  authTokens              AuthToken[]\n  auditLogs               AuditLog[]\n  studentProfile          StudentProfile?\n  teacherProfile          TeacherProfile?\n  parentProfile           ParentProfile?\n  parentLinks             ParentStudentLink[]      @relation(\"ParentLinks\")\n  studentLinks            ParentStudentLink[]      @relation(\"StudentLinks\")\n  notifications           Notification[]\n  notificationPreferences NotificationPreference[]\n  homeroomSections        Section[]                @relation(\"HomeroomTeacher\")\n  sectionMemberships      SectionMember[]\n  taughtCourses           Course[]                 @relation(\"CourseTeacher\")\n  enrollments             Enrollment[]\n  attendanceTaken         AttendanceSession[]      @relation(\"AttendanceTakenBy\")\n  attendanceUpdated       AttendanceSession[]      @relation(\"AttendanceUpdatedBy\")\n  attendanceRecords       AttendanceRecord[]\n  files                   FileObject[]\n  submissions             Submission[]             @relation(\"SubmissionStudent\")\n  gradedSubmissions       Submission[]             @relation(\"SubmissionGrader\")\n  quizzesCreated          Quiz[]                   @relation(\"QuizCreatedBy\")\n  quizAttempts            QuizAttempt[]\n  quizAccommodations      QuizAccommodation[]\n  quizAnswersGraded       QuizAnswer[]             @relation(\"QuizAnswerGradedBy\")\n\n  @@index([lastName, firstName, email])\n  @@index([role, status])\n}\n\n/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n/// only -- enforced in the service layer (src/server/services/users.ts,\n/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\nmodel StudentProfile {\n  userId           String     @id\n  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  admissionNumber  String     @unique\n  dateOfBirth      DateTime   @db.Date\n  gender           Gender     @default(UNDISCLOSED)\n  gradeLevelId     String\n  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n  enrollmentDate   DateTime   @db.Date\n  addressLine1     String?\n  city             String?\n  medicalNotes     String?\n  emergencyContact String?\n  emergencyPhone   String?\n}\n\n/// Teacher-specific fields (FR-1).\nmodel TeacherProfile {\n  userId         String    @id\n  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  employeeNumber String    @unique\n  title          String?\n  qualifications String?\n  hireDate       DateTime? @db.Date\n}\n\n/// Parent-specific fields (FR-1).\nmodel ParentProfile {\n  userId     String  @id\n  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  occupation String?\n  address    String?\n}\n\n/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n/// transaction invariants rather than DB constraints.\nmodel ParentStudentLink {\n  id           String               @id @default(cuid())\n  parentId     String\n  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n  studentId    String\n  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n  relationship GuardianRelationship\n  isPrimary    Boolean              @default(false)\n  createdAt    DateTime             @default(now())\n\n  @@unique([parentId, studentId])\n  @@index([studentId])\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n  @@index([entityType, entityId])\n  @@index([actorId, createdAt])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id                       String         @id @default(\"singleton\")\n  name                     String         @default(\"SchoolHub Academy\")\n  shortName                String         @default(\"SchoolHub\")\n  logoUrl                  String?\n  timezone                 String         @default(\"UTC\")\n  addressLine1             String?\n  addressLine2             String?\n  city                     String?\n  country                  String?\n  phone                    String?\n  email                    String?\n  website                  String?\n  /// PRD-07 FR-4\n  attendanceMode           AttendanceMode @default(PER_PERIOD)\n  attendanceAlertThreshold Int            @default(90)\n  createdAt                DateTime       @default(now())\n  updatedAt                DateTime       @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id             String          @id @default(cuid())\n  name           String          @unique\n  startDate      DateTime        @db.Date\n  endDate        DateTime        @db.Date\n  isCurrent      Boolean         @default(false)\n  createdAt      DateTime        @default(now())\n  updatedAt      DateTime        @updatedAt\n  terms          Term[]\n  sections       Section[]\n  courses        Course[]\n  timetableSlots TimetableSlot[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id              String           @id @default(cuid())\n  name            String           @unique\n  shortName       String           @unique\n  order           Int              @unique\n  archivedAt      DateTime?\n  createdAt       DateTime         @default(now())\n  updatedAt       DateTime         @updatedAt\n  studentProfiles StudentProfile[]\n  sections        Section[]\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n  courses     Course[]\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id             String          @id @default(cuid())\n  name           String          @unique\n  building       String?\n  capacity       Int?\n  archivedAt     DateTime?\n  createdAt      DateTime        @default(now())\n  updatedAt      DateTime        @updatedAt\n  sections       Section[]\n  timetableSlots TimetableSlot[]\n}\n\n/// In-app notification (PRD-04 FR-1). type is a key from the compile-time\n/// registry (src/server/notifications/types.ts) rather than an enum/FK, so\n/// later PRDs register new keys without a migration. category is resolved\n/// from the registry at read time (src/server/notifications/list.ts), not\n/// stored here. The composite index backs both getUnreadCount() (NFR-3,\n/// <50ms) and listNotifications()'s own-rows-newest-first query.\nmodel Notification {\n  id        String    @id @default(cuid())\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  title     String\n  body      String?\n  link      String?\n  readAt    DateTime?\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n\n  @@index([userId, readAt, createdAt])\n}\n\n/// Per-user, per-type override of the registry's defaultEmail/mandatoryInApp\n/// defaults (PRD-04 FR-3). Composite PK instead of a surrogate id/unique\n/// index -- there is exactly one row per (userId, type) by construction\n/// (notify.ts and the preferences PUT route both upsert on it).\nmodel NotificationPreference {\n  userId    String\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  inApp     Boolean  @default(true)\n  email     Boolean  @default(true)\n  updatedAt DateTime @updatedAt\n\n  @@id([userId, type])\n}\n\n/// Durable outbox row the dispatcher claims and sends (PRD-04 FR-1/FR-5).\n/// No FK to User -- toEmail/toName are a point-in-time snapshot (matches\n/// the PRD's schema block exactly) so a later email change or user deletion\n/// never blocks a queued send. updatedAt doubles as the \"flipped to\n/// SENDING\" timestamp the >10-minute stuck-row recovery checks (NFR-4) --\n/// Prisma's @updatedAt already bumps it on that status-flip UPDATE, so no\n/// separate column is needed.\nmodel EmailOutbox {\n  id            String      @id @default(cuid())\n  toEmail       String\n  toName        String?\n  subject       String\n  html          String\n  text          String\n  status        EmailStatus @default(PENDING)\n  attempts      Int         @default(0)\n  lastError     String?\n  nextAttemptAt DateTime    @default(now())\n  sentAt        DateTime?\n  createdAt     DateTime    @default(now())\n  updatedAt     DateTime    @updatedAt\n\n  @@index([status, nextAttemptAt])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-05 Classes & Enrollment (FR-1). Shapes match the PRD schema block\n// exactly; business rules (capacity, CORE auto-enroll, homeroom-once-per-year)\n// live in src/server/enrollment/roster-engine.ts and the sections/courses\n// services, not here.\n// ---------------------------------------------------------------------------\n\nenum CourseKind {\n  CORE\n  ELECTIVE\n}\n\nenum EnrollmentStatus {\n  ACTIVE\n  DROPPED\n}\n\n/// Homeroom group, e.g. \"7A\". capacity is 1-60 (validated in zod).\nmodel Section {\n  id                 String              @id @default(cuid())\n  academicYearId     String\n  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n  gradeLevelId       String\n  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id])\n  name               String\n  homeroomTeacherId  String?\n  homeroomTeacher    User?               @relation(\"HomeroomTeacher\", fields: [homeroomTeacherId], references: [id])\n  roomId             String?\n  room               Room?               @relation(fields: [roomId], references: [id])\n  capacity           Int                 @default(30)\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  members            SectionMember[]\n  courses            Course[]\n  attendanceSessions AttendanceSession[]\n\n  @@unique([academicYearId, name])\n}\n\n/// academicYearId is denormalised so the DB enforces one section per\n/// student per year (NFR-2).\nmodel SectionMember {\n  id             String   @id @default(cuid())\n  sectionId      String\n  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n  studentId      String\n  student        User     @relation(fields: [studentId], references: [id])\n  joinedAt       DateTime @default(now())\n  academicYearId String\n\n  @@unique([studentId, academicYearId])\n}\n\n/// sectionId is null for cross-section electives. coTeacherIds is a plain\n/// String[] exactly per FR-1 (queried with `has`), max 3 enforced in zod.\nmodel Course {\n  id                 String              @id @default(cuid())\n  academicYearId     String\n  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n  subjectId          String\n  subject            Subject             @relation(fields: [subjectId], references: [id])\n  sectionId          String?\n  section            Section?            @relation(fields: [sectionId], references: [id])\n  teacherId          String\n  teacher            User                @relation(\"CourseTeacher\", fields: [teacherId], references: [id])\n  coTeacherIds       String[]            @default([])\n  name               String\n  code               String\n  kind               CourseKind          @default(CORE)\n  description        String?\n  capacity           Int?\n  archivedAt         DateTime?\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  enrollments        Enrollment[]\n  timetableSlots     TimetableSlot[]\n  attendanceSessions AttendanceSession[]\n  modules            Module[]\n  assignments        Assignment[]\n  quizzes            Quiz[]\n\n  @@unique([academicYearId, code])\n}\n\n/// DROPPED rows are kept (never deleted) so later PRDs' attendance/grades\n/// history stays attached (FR-12).\nmodel Enrollment {\n  id         String           @id @default(cuid())\n  courseId   String\n  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  studentId  String\n  student    User             @relation(fields: [studentId], references: [id])\n  status     EnrollmentStatus @default(ACTIVE)\n  enrolledAt DateTime         @default(now())\n  droppedAt  DateTime?\n\n  @@unique([courseId, studentId])\n  @@index([studentId, status])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-06 Bell Schedule & Timetable (FR-1..FR-4). One repeating week (NFR-15).\n// Clash rules live in src/server/timetable/, not in the DB.\n// ---------------------------------------------------------------------------\n\nenum PeriodKind {\n  CLASS\n  BREAK\n  LUNCH\n  ASSEMBLY\n}\n\n/// startTime/endTime are 'HH:MM' in SchoolSettings.timezone. order is display order only.\nmodel Period {\n  id                 String              @id @default(cuid())\n  name               String\n  startTime          String\n  endTime            String\n  kind               PeriodKind          @default(CLASS)\n  order              Int                 @unique\n  slots              TimetableSlot[]\n  attendanceSessions AttendanceSession[]\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n}\n\n/// ISO weekday 1=Mon … 7=Sun; seeded with all 7 rows.\nmodel SchoolDay {\n  dayOfWeek  Int     @id\n  isTeaching Boolean @default(true)\n}\n\n/// period is Restrict: deletePeriod refuses with 409 while slots exist (FR-8).\nmodel TimetableSlot {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])\n  courseId       String\n  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  dayOfWeek      Int\n  periodId       String\n  period         Period       @relation(fields: [periodId], references: [id])\n  roomId         String?\n  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([courseId, dayOfWeek, periodId])\n  @@index([academicYearId, dayOfWeek, periodId])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-07 Attendance (FR-1..FR-4). Exactly-one-of(courseId, sectionId) and the\n// two partial unique indexes live in the migration SQL (ADR-2) -- Prisma\n// can't express them.\n// ---------------------------------------------------------------------------\n\nenum AttendanceStatus {\n  PRESENT\n  ABSENT\n  LATE\n  EXCUSED\n}\n\nenum AttendanceMode {\n  PER_PERIOD\n  DAILY_HOMEROOM\n  BOTH\n}\n\n/// Course session (courseId + periodId) or daily homeroom register (sectionId).\nmodel AttendanceSession {\n  id          String             @id @default(cuid())\n  courseId    String?\n  course      Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  sectionId   String?\n  section     Section?           @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n  periodId    String?\n  period      Period?            @relation(fields: [periodId], references: [id])\n  date        DateTime           @db.Date\n  takenById   String\n  takenBy     User               @relation(\"AttendanceTakenBy\", fields: [takenById], references: [id])\n  updatedById String\n  updatedBy   User               @relation(\"AttendanceUpdatedBy\", fields: [updatedById], references: [id])\n  createdAt   DateTime           @default(now())\n  updatedAt   DateTime           @updatedAt\n  records     AttendanceRecord[]\n\n  @@index([date])\n}\n\n/// minutesLate is 1..240 iff LATE; note <= 500 (zod, FR-12).\nmodel AttendanceRecord {\n  id          String            @id @default(cuid())\n  sessionId   String\n  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)\n  studentId   String\n  student     User              @relation(fields: [studentId], references: [id])\n  status      AttendanceStatus\n  minutesLate Int?\n  note        String?\n  createdAt   DateTime          @default(now())\n  updatedAt   DateTime          @updatedAt\n\n  @@unique([sessionId, studentId])\n  @@index([studentId, createdAt])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-08 File storage & course content (SH-8)\n// ---------------------------------------------------------------------------\n\n/// Generic uploaded file (FR-1). Bytes live under UPLOAD_DIR; access goes\n/// through src/server/files/access.ts. contextId null = unattached (purged after 24 h).\nmodel FileObject {\n  id                    String                 @id @default(cuid())\n  ownerId               String\n  owner                 User                   @relation(fields: [ownerId], references: [id])\n  originalName          String\n  mimeType              String\n  sizeBytes             Int\n  storageKey            String                 @unique\n  sha256                String\n  context               String\n  contextId             String?\n  createdAt             DateTime               @default(now())\n  lessonAttachments     LessonAttachment[]\n  assignmentAttachments AssignmentAttachment[]\n  submissionFiles       SubmissionFile[]\n\n  @@index([context, contextId])\n}\n\nenum ContentStatus {\n  DRAFT\n  SCHEDULED\n  PUBLISHED\n}\n\nmodel Module {\n  id          String        @id @default(cuid())\n  courseId    String\n  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  title       String\n  description String?\n  order       Int\n  status      ContentStatus @default(DRAFT)\n  publishAt   DateTime?\n  createdAt   DateTime      @default(now())\n  updatedAt   DateTime      @updatedAt\n  lessons     Lesson[]\n\n  @@index([courseId, order])\n}\n\nmodel Lesson {\n  id               String             @id @default(cuid())\n  moduleId         String\n  module           Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)\n  title            String\n  contentMarkdown  String             @default(\"\")\n  videoUrl         String?\n  estimatedMinutes Int?\n  order            Int\n  status           ContentStatus      @default(DRAFT)\n  publishAt        DateTime?\n  createdAt        DateTime           @default(now())\n  updatedAt        DateTime           @updatedAt\n  attachments      LessonAttachment[]\n  links            LessonLink[]\n  progress         LessonProgress[]\n\n  @@index([moduleId, order])\n}\n\n/// file has no onDelete -> Restrict: an attached file can't be hard-deleted (FR-11).\nmodel LessonAttachment {\n  id       String     @id @default(cuid())\n  lessonId String\n  lesson   Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n  fileId   String\n  file     FileObject @relation(fields: [fileId], references: [id])\n  order    Int\n}\n\nmodel LessonLink {\n  id       String @id @default(cuid())\n  lessonId String\n  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n  title    String\n  url      String\n  order    Int\n}\n\nmodel LessonProgress {\n  lessonId      String\n  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n  studentId     String\n  firstViewedAt DateTime  @default(now())\n  completedAt   DateTime?\n\n  @@id([lessonId, studentId])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-09 assignments & submissions (SH-9, system-design §2.1)\n// ---------------------------------------------------------------------------\n\nenum SubmissionType {\n  ONLINE_TEXT\n  FILE_UPLOAD\n  TEXT_AND_FILE\n  NO_SUBMISSION\n}\n\nenum AssignmentStatus {\n  DRAFT\n  SCHEDULED\n  PUBLISHED\n}\n\nenum SubmissionStatus {\n  SUBMITTED\n  RETURNED\n}\n\nmodel Assignment {\n  id                       String                 @id @default(cuid())\n  courseId                 String\n  course                   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  title                    String\n  instructions             String                 @default(\"\") @db.Text\n  submissionType           SubmissionType\n  maxPoints                Decimal                @db.Decimal(6, 2)\n  dueAt                    DateTime\n  availableFrom            DateTime?\n  allowLate                Boolean                @default(false)\n  lateCutoffAt             DateTime?\n  latePenaltyPercentPerDay Decimal                @default(0) @db.Decimal(5, 2)\n  maxLatePenaltyPercent    Decimal                @default(0) @db.Decimal(5, 2)\n  maxFileCount             Int                    @default(3)\n  allowExtraCredit         Boolean                @default(false)\n  status                   AssignmentStatus       @default(DRAFT)\n  rubricId                 String?                @unique\n  rubric                   Rubric?                @relation(fields: [rubricId], references: [id], onDelete: SetNull)\n  notifiedAt               DateTime?\n  archivedAt               DateTime?\n  createdById              String\n  createdAt                DateTime               @default(now())\n  updatedAt                DateTime               @updatedAt\n  attachments              AssignmentAttachment[]\n  submissions              Submission[]\n  exemptions               GradeExemption[]\n  reminders                AssignmentReminder[]\n\n  @@index([courseId, dueAt])\n}\n\n/// file has no onDelete -> Restrict: an attached file can't be hard-deleted.\nmodel AssignmentAttachment {\n  assignmentId String\n  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n  fileId       String\n  file         FileObject @relation(fields: [fileId], references: [id])\n\n  @@id([assignmentId, fileId])\n}\n\nmodel Rubric {\n  id         String            @id @default(cuid())\n  criteria   RubricCriterion[]\n  assignment Assignment?\n}\n\nmodel RubricCriterion {\n  id          String  @id @default(cuid())\n  rubricId    String\n  rubric      Rubric  @relation(fields: [rubricId], references: [id], onDelete: Cascade)\n  title       String\n  description String?\n  maxPoints   Decimal @db.Decimal(6, 2)\n  order       Int\n  /// [{label, points, description}]\n  levels      Json\n\n  @@index([rubricId, order])\n}\n\n/// One row per (assignment, student); earlier attempts live in SubmissionHistory.\n/// attemptNumber 0 = offline grade (FR-8).\nmodel Submission {\n  id             String              @id @default(cuid())\n  assignmentId   String\n  assignment     Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n  studentId      String\n  student        User                @relation(\"SubmissionStudent\", fields: [studentId], references: [id])\n  status         SubmissionStatus    @default(SUBMITTED)\n  text           String?             @db.Text\n  attemptNumber  Int\n  submittedAt    DateTime\n  isLate         Boolean             @default(false)\n  lateDays       Int                 @default(0)\n  rawScore       Decimal?            @db.Decimal(6, 2)\n  penaltyPercent Decimal?            @db.Decimal(5, 2)\n  finalScore     Decimal?            @db.Decimal(6, 2)\n  /// [{criterionId, points, comment}]\n  rubricScores   Json?\n  feedback       String?             @db.Text\n  gradedById     String?\n  gradedBy       User?               @relation(\"SubmissionGrader\", fields: [gradedById], references: [id])\n  gradedAt       DateTime?\n  returnedAt     DateTime?\n  createdAt      DateTime            @default(now())\n  updatedAt      DateTime            @updatedAt\n  files          SubmissionFile[]\n  history        SubmissionHistory[]\n\n  @@unique([assignmentId, studentId])\n  @@index([studentId])\n}\n\nmodel SubmissionFile {\n  submissionId String\n  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)\n  fileId       String\n  file         FileObject @relation(fields: [fileId], references: [id])\n\n  @@id([submissionId, fileId])\n}\n\n/// fileIds has no FK on purpose: old-attempt files stay attached to the submission (B1).\nmodel SubmissionHistory {\n  id            String     @id @default(cuid())\n  submissionId  String\n  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)\n  attemptNumber Int\n  text          String?    @db.Text\n  fileIds       String[]\n  submittedAt   DateTime\n\n  @@index([submissionId, attemptNumber])\n}\n\n/// The row itself is the PRD-11 \"exclude from gradebook\" flag (FR-35).\nmodel GradeExemption {\n  assignmentId String\n  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n  studentId    String\n  reason       String?\n  createdAt    DateTime   @default(now())\n\n  @@id([assignmentId, studentId])\n}\n\n/// Idempotency key for due_soon / missing reminders (FR-6).\nmodel AssignmentReminder {\n  id           String     @id @default(cuid())\n  assignmentId String\n  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n  studentId    String\n  kind         String\n  createdAt    DateTime   @default(now())\n\n  @@unique([assignmentId, studentId, kind])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-10 Quizzes (FR-1). Fields exactly per the PRD; only relations/indexes added.\n// ---------------------------------------------------------------------------\n\nenum QuizStatus {\n  DRAFT\n  PUBLISHED\n  CLOSED\n}\n\nenum QuestionType {\n  SINGLE_CHOICE\n  MULTIPLE_CHOICE\n  TRUE_FALSE\n  SHORT_ANSWER\n  ESSAY\n}\n\nenum ResultsVisibility {\n  IMMEDIATELY\n  AFTER_CLOSE\n  MANUAL\n}\n\nenum AttemptStatus {\n  IN_PROGRESS\n  SUBMITTED\n  NEEDS_GRADING\n  GRADED\n}\n\nenum ScoringPolicy {\n  HIGHEST\n  LATEST\n  AVERAGE\n}\n\nmodel Quiz {\n  id                 String              @id @default(cuid())\n  courseId           String\n  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  title              String\n  instructions       String              @default(\"\") // Markdown\n  isPractice         Boolean             @default(false) // practice quizzes never reach the gradebook\n  availableFrom      DateTime\n  availableUntil     DateTime // > availableFrom\n  timeLimitMinutes   Int? // 1–300, null = untimed\n  maxAttempts        Int                 @default(1) // 1–10\n  scoringPolicy      ScoringPolicy       @default(HIGHEST)\n  shuffleQuestions   Boolean             @default(false)\n  shuffleOptions     Boolean             @default(false)\n  oneQuestionPerPage Boolean             @default(false)\n  resultsVisibility  ResultsVisibility   @default(AFTER_CLOSE)\n  showCorrectAnswers Boolean             @default(true) // when results are visible\n  resultsReleasedAt  DateTime? // MANUAL release; also the AFTER_CLOSE \"notified once\" claim (A6)\n  status             QuizStatus          @default(DRAFT)\n  createdById        String\n  createdBy          User                @relation(\"QuizCreatedBy\", fields: [createdById], references: [id])\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  questions          Question[]\n  attempts           QuizAttempt[]\n  accommodations     QuizAccommodation[]\n\n  @@index([courseId, status])\n}\n\nmodel Question {\n  id            String       @id @default(cuid())\n  quizId        String\n  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)\n  type          QuestionType\n  prompt        String // Markdown, may include an uploaded image\n  points        Decimal      @db.Decimal(5, 2) // 0.5–100\n  order         Int\n  options       Json? // choice types: [{ id, text }]\n  correct       Json // see FR-2\n  explanation   String? // shown with correct answers\n  caseSensitive Boolean      @default(false) // SHORT_ANSWER\n  answers       QuizAnswer[]\n\n  @@index([quizId, order])\n}\n\n/// Only one IN_PROGRESS attempt per (quizId, studentId): partial unique index\n/// \"quiz_attempt_one_in_progress_uq\" lives in migration 20261110000000_add_quizzes (FR-19, ADR-2).\n/// Prisma can't express it — never use `prisma db push`.\nmodel QuizAttempt {\n  id            String        @id @default(cuid())\n  quizId        String\n  quiz          Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)\n  studentId     String\n  student       User          @relation(fields: [studentId], references: [id])\n  attemptNumber Int\n  status        AttemptStatus @default(IN_PROGRESS)\n  startedAt     DateTime      @default(now())\n  deadlineAt    DateTime? // min(startedAt + limit + extraTime, availableUntil)\n  submittedAt   DateTime?\n  autoSubmitted Boolean       @default(false)\n  questionOrder String[] // frozen order for this attempt\n  score         Decimal?      @db.Decimal(7, 2)\n  maxScore      Decimal       @db.Decimal(7, 2)\n  answers       QuizAnswer[]\n\n  @@unique([quizId, studentId, attemptNumber])\n  @@index([quizId, status])\n  @@index([status, deadlineAt])\n}\n\nmodel QuizAnswer {\n  attemptId     String\n  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)\n  questionId    String\n  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)\n  response      Json?\n  pointsAwarded Decimal?    @db.Decimal(5, 2)\n  isCorrect     Boolean?\n  feedback      String?\n  gradedById    String?\n  gradedBy      User?       @relation(\"QuizAnswerGradedBy\", fields: [gradedById], references: [id])\n  updatedAt     DateTime    @updatedAt\n\n  @@id([attemptId, questionId])\n}\n\nmodel QuizAccommodation {\n  quizId           String\n  quiz             Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)\n  studentId        String\n  student          User   @relation(fields: [studentId], references: [id])\n  extraTimeMinutes Int    @default(0) // 0–300\n  extraAttempts    Int    @default(0) // 0–5\n\n  @@id([quizId, studentId])\n}\n","numLines":959,"startLine":1,"totalLines":959}},"tool_result_meta":[{"id":"toolu_01A4JMtC3XavdPzGxLUxBhw7","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
