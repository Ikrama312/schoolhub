{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FrXWwQCjygpkcN54xzJHXn","type":"tool_result","content":"import { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side role checks on write endpoints.\n *\n * PRD-01 (real auth/session) has not landed in this workspace yet, so\n * there is no session to read. This returns the same ADMIN placeholder\n * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n * and throws FORBIDDEN when that role isn't in the allowed list. Every\n * write endpoint in this PRD calls requireRole() instead of checking role\n * itself, so wiring up a real session later is a one-file change here\n * instead of touching every route.\n */\nconst PLACEHOLDER_USER = { id: 'placeholder-user', role: 'ADMIN' as Role };\n\nexport function requireRole(...roles: Role[]): { id: string; role: Role } {\n  if (!roles.includes(PLACEHOLDER_USER.role)) {\n    throw new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n  }\n  return PLACEHOLDER_USER;\n}\nsrc/app/(app):\nadmin\ncourses\ndashboard\nlayout.tsx\nmy-courses\nshell.tsx\nstudents\n\nsrc/app/(app)/admin:\ncourses\nsections\n\nsrc/app/(app)/admin/courses:\n[id]\n\nsrc/app/(app)/admin/courses/[id]:\nenrollment\n\nsrc/app/(app)/admin/courses/[id]/enrollment:\n\nsrc/app/(app)/admin/sections:\n[id]\npage.tsx\nSectionsClient.tsx\n\nsrc/app/(app)/admin/sections/[id]:\n\nsrc/app/(app)/courses:\n[courseId]\n\nsrc/app/(app)/courses/[courseId]:\nroster\n\nsrc/app/(app)/courses/[courseId]/roster:\n\nsrc/app/(app)/dashboard:\npage.tsx\n\nsrc/app/(app)/my-courses:\n\nsrc/app/(app)/students:\n[id]\n\nsrc/app/(app)/students/[id]:\ncourses\n\nsrc/app/(app)/students/[id]/courses:\n\nsrc/components:\nConfirmDialog\nDataTable\nDateDisplay\nEmptyState\nFormField\nLoadingSkeleton\nPageHeader\nStatCard\nToast\nUserAvatar\nUserPicker\n\nsrc/components/ConfirmDialog:\nConfirmDialog.