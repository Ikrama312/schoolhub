ub-prds/tests/e2e/notifications.spec.ts","old_string":"  await prisma.user.upsert({\n    where: { email: ADMIN.email },\n    update: { passwordHash, status: 'ACTIVE', archivedAt: null, failedLoginCount: 0, lockedUntil: null, role: 'ADMIN' },\n    create: { email: ADMIN.email, passwordHash, firstName: 'E2E', lastName: 'Admin', role: 'ADMIN', status: 'ACTIVE' },\n  });","new_string":"  const admin = await prisma.user.upsert({\n    where: { email: ADMIN.email },\n    update: { passwordHash, status: 'ACTIVE', archivedAt: null, failedLoginCount: 0, lockedUntil: null, role: 'ADMIN' },\n    create: { email: ADMIN.email, passwordHash, firstName: 'E2E', lastName: 'Admin', role: 'ADMIN', status: 'ACTIVE' },\n  });\n  // Start from defaults even if an earlier run died before afterAll.\n  await prisma.notificationPreference.deleteMany({ where: { userId: admin.id } });\n  await prisma.notification.deleteMany({ where: { userId: admin.id } });"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B6LrqiT51vwE6ptGbUqtLF","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub-prds/tests/e2e/notifications.spec.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1921163e-32be-4c5c-99f3-b230ef406493","uuid":"5740ccc6-5f53-40f8-989d-65dffaaf5362","timestamp":"2026-11-04T15:09:28.715Z","tool_use_result":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/tests/e2e/notifications.spec.ts","oldString":"  await prisma.user.upsert({\n    where: { email: ADMIN.email },\n    update: { passwordHash, status: 'ACTIVE', archivedAt: null, failedLoginCount: 0, lockedUntil: null, role: 'ADMIN' },\n    create: { email: ADMIN.email, passwordHash, firstName: 'E2E', lastName: 'Admin', role: 'ADMIN', status: 'ACTIVE' },\n  });","newString":"  const admin = await prisma.user.upsert({\n    where: { email: ADMIN.email },\n    update: { passwordHash, status: 'ACTIVE', archivedAt: null, failedLoginCount: 0, lockedUntil: null, role: 'ADMIN' },\n    create: { email: ADMIN.email, passwordHash, firstName: 'E2E', lastName: 'Admin', role: 'ADMIN', status: 'ACTIVE' },\n  });\n  // Start from defaults even if an earlier run died before afterAll.\n  await prisma.notificationPreference.deleteMany({ where: { userId: admin.id } });\n  await prisma.notification.deleteMany({ where: { userId: admin.id } });","originalFile":"import { test, expect, type Page } from '@playwright/test';\nimport { PrismaClient } from '@prisma/client';\nimport bcrypt from 'bcrypt';\n\n/**\n * PRD-04 NFR-16. Creates its own ACTIVE admin (no login UI exists yet) and\n * signs in through next-auth's credentials callback, sharing cookies with the page.\n */\nconst prisma = new PrismaClient();\nconst ADMIN = { email: 'e2e-notifications-admin@schoolhub.test', password: 'E2e-Notif!2026-pass' };\n\ntest.describe.configure({ mode: 'serial' });\n\ntest.beforeAll(async () => {\n  const passwordHash = await bcrypt.hash(ADMIN.password, 10);\n  await prisma.user.upsert({\n    where: { email: ADMIN.email },\n    update: { passwordHash, status: 'ACTIVE', archivedAt: null, failedLoginCount: 0, lockedUntil: null, role: 'ADMIN' },\n    create: { email: ADMIN.email, passwordHash, firstName: 'E2E', lastName: 'Admin', role: 'ADMIN', status: 'ACTIVE' },\n  });\n});\n\ntest.afterAll(async () => {\n  // Cascades remove the admin's notifications and preferences; outbox rows have no FK.\n  await prisma.user.deleteMany({ where: { email: ADMIN.email } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: ADMIN.email } });\n  await prisma.$disconnect();\n});\n\nasync function signIn(page: Page) {\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  const res = await page.request.post('/api/auth/callback/credentials', {\n    form: { email: ADMIN.email, password: ADMIN.password, csrfToken, callbackUrl: '/dashboard' },\n  });\n  expect(res.ok()).toBeTruthy();\n  const session = await (await page.request.get('/api/auth/session')).json();\n  expect(session?.user?.email).toBe(ADMIN.email);\n}\n\nconst bell = (page: Page) => page.getByRole('button', { name: /^Notifications/ });\n\ntest('admin test notification bumps the bell, mark all read clears it', async ({ page }) => {\n  await signIn(page);\n  await page.request.post('/api/notifications/read-all');\n\n  await page.goto('/admin/email-log');\n  await expect(bell(page)).toHaveAccessibleName('Notifications');\n\n  await page.getByRole('button', { name: 'Send test notification to me' }).click();\n  await expect(page.getByText('Test notification sent to you')).toBeVisible();\n\n  // The bell polls every 30 s; a reload fetches immediately.\n  await page.reload();\n  await expect(bell(page)).toHaveAccessibleName('Notifications, 1 unread');\n\n  await bell(page).click();\n  await expect(page.getByRole('button', { name: /Test notification/ })).toBeVisible();\n  await page.getByRole('button', { name: 'Mark all as read' }).click();\n  await expect(bell(page)).toHaveAccessibleName('Notifications');\n\n  const { data } = await (await page.request.get('/api/notifications/unread-count')).json();\n  expect(data.count).toBe(0);\n});\n\ntest('a preference toggle persists across reload', async ({ page }) => {\n  await signIn(page);\n  await page.goto('/account/notifications');\n\n  const email = page.getByRole('switch', { name: 'Test notification email' });\n  await expect(email).toBeChecked();\n\n  const saved = page.waitForResponse((r) => r.url().endsWith('/api/me/notification-preferences') && r.request().method() === 'PUT');\n  await email.click();\n  expect((await saved).ok()).toBeTruthy();\n\n  await page.reload();\n  await expect(page.getByRole('switch', { name: 'Test notification email' })).not.toBeChecked();\n});\n","structuredPatch":[{"oldStart":13,"oldLines":11,"newStart":13,"newLines":14,"lines":[" "," test.beforeAll(async () => {","   const passwordHash = await bcrypt.hash(ADMIN.password, 10);","-  await prisma.user.upsert({","+  const admin = await prisma.user.upsert({","     where: { email: ADMIN.email },","     update: { passwordHash, status: 'ACTIVE', archivedAt: null, failedLoginCount: 0, lockedUntil: null, role: 'ADMIN' },","     create: { email: ADMIN.email, passwordHash, firstName: 'E2E', lastName: 'Admin', role: 'ADMIN', status: 'ACTIVE' },","   });","+  // Start from defaults even if an earlier run died before afterAll.","+  await prisma.notificationPreference.deleteMany({ where: { userId: admin.id } });","+  await prisma.notification.deleteMany({ where: { userId: admin.id } });"," });"," "," test.afterAll(async () => {"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01B6LrqiT51vwE6ptGbUqtLF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
