{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015M2X4zoric9LkvPaUduRLy","type":"tool_result","content":"=== src/lib/validators/auth.ts\nimport { z } from 'zod';\n\n/**\n * Client-safe auth validators (FR-2, FR-8, FR-17). No fs / server imports:\n * the login/invite/reset/security forms import this directly. The\n * common-password rule and the real \"not your email\" check run server-side\n * in src/server/auth/password-policy.ts (the API body doesn't carry the email).\n */\n\nexport const emailField = z.string().trim().toLowerCase().email('Enter a valid email address');\n\nexport interface PasswordCheckResult {\n  length: boolean;\n  letter: boolean;\n  digit: boolean;\n  notEmail: boolean;\n}\n\nexport const PASSWORD_RULES: Record<keyof PasswordCheckResult, { label: string; error: string }> = {\n  length: { label: '10 to 128 characters', error: 'Password must be 10 to 128 characters.' },\n  letter: { label: 'At least one letter', error: 'Password must contain at least one letter.' },\n  digit: { label: 'At least one number', error: 'Password must contain at least one number.' },\n  notEmail: { label: 'Not the same as your email', error: 'Password must not be your email address.' },\n};\n\nexport function passwordChecks(password: string, email: string): PasswordCheckResult {\n  return {\n    length: password.length >= 10 && password.length <= 128,\n    letter: /[A-Za-z]/.test(password),\n    digit: /[0-9]/.test(password),\n    notEmail: password.trim().toLowerCase() !== email.trim().toLowerCase(),\n  };\n}\n\n/** Error messages for every failing rule (empty when the password passes). */\nexport function passwordErrors(password: string, email: string): string[] {\n  const checks = passwordChecks(password, email);\n  return (Object.keys(checks) as (keyof PasswordCheckResult)[])\n    .filter((key) => !checks[key])\n    .map((key) => PASSWORD_RULES[key].error);\n}\n\n/** FR-8: only same-origin relative paths; everything else falls back to /dashboard. */\nexport function safeCallbackUrl(url: string | null | undefined): string {\n  if (!url || !url.startsWith('/') || url.startsWith('//') || url.startsWith('/\\\\')) return '/dashboard';\n  return url;\n}\n\nexport const signInSchema = z.object({\n  email: emailField,\n  password: z.string().min(1, 'Enter your password'),\n});\n\nexport const forgotPasswordSchema = z.object({ email: emailField });\n\n/** superRefine: policy rules on `field` + confirm-equals. `email` is '' when unknown. */\nfunction refineNewPassword(field: string, email = '') {\n  return (value: Record<string, unknown>, ctx: z.RefinementCtx) => {\n    const password = String(value[field] ?? '');\n    for (const message of passwordErrors(password, email)) {\n      ctx.addIssue({ code: z.ZodIssueCode.custom, path: [field], message });\n    }\n    if (password !== value.confirm) {\n      ctx.addIssue({ code: z.ZodIssueCode.custom, path: ['confirm'], message: 'Passwords do not match.' });\n    }\n  };\n}\n\nconst newPasswordShape = { password: z.string(), confirm: z.string() };\n\n/** Client form schema for SetPasswordForm (invite + reset); pass the known email. */\nexport function setPasswordSchema(email = '') {\n  return z.object(newPasswordShape).superRefine(refineNewPassword('password', email));\n}\n\nexport const acceptInviteSchema = z\n  .object({ token: z.string().min(1), ...newPasswordShape })\n  .superRefine(refineNewPassword('password'));\n\nexport const resetPasswordSchema = acceptInviteSchema;\n\nexport function changePasswordFormSchema(email = '') {\n  return z\n    .object({\n      currentPassword: z.string().min(1, 'Enter your current password'),\n      newPassword: z.string(),\n      confirm: z.string(),\n    })\n    .superRefine(refineNewPassword('newPassword', email));\n}\n\nexport const changePasswordSchema = changePasswordFormSchema();\n\nexport type SignInInput = z.infer<typeof signInSchema>;\nexport type AcceptInviteInput = z.infer<typeof acceptInviteSchema>;\nexport type ResetPasswordInput = z.infer<typeof resetPasswordSchema>;\nexport type ChangePasswordInput = z.infer<typeof changePasswordSchema>;\nexport type SetPasswordValues = z.infer<ReturnType<typeof setPasswordSchema>>;\n=== src/server/auth/email.ts\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\n\nexport type AuthEmailKind = 'invite' | 'password-reset';\n\nconst PATHS: Record<AuthEmailKind, string> = { invite: '/invite/', 'password-reset': '/reset-password/' };\nconst SUBJECTS: Record<AuthEmailKind, string> = {\n  invite: \"You're invited to SchoolHub\",\n  'password-reset': 'Reset your SchoolHub password',\n};\n\nexport function authLink(kind: AuthEmailKind, rawToken: string): string {\n  return new URL(PATHS[kind] + encodeURIComponent(rawToken), env.APP_URL).toString();\n}\n\n/**\n * FR-22 seam: logs the link instead of sending. PRD-04 replaces this body\n * with an EmailOutbox enqueue. The raw token appears only here, never in audit.\n */\nexport async function sendAuthEmail(\n  user: { email: string; firstName?: string },\n  kind: AuthEmailKind,\n  link: string,\n): Promise<void> {\n  logger.info('Auth email', { to: user.email, subject: SUBJECTS[kind], link });\n}\n=== src/server/rate-limit.ts\n// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\nconst hits = new Map<string, number[]>();\n\n/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\nexport function rateLimit(\n  key: string,\n  limit: number,\n  windowMs: number,\n  now: number = Date.now(),\n): { ok: boolean; retryAfterMs: number } {\n  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n  if (recent.length >= limit) {\n    hits.set(key, recent);\n    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n  }\n  recent.push(now);\n  hits.set(key, recent);\n  return { ok: true, retryAfterMs: 0 };\n}\n\nexport function __resetRateLimits(): void {\n  hits.clear();\n}\n=== src/server/audit.ts\nimport type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { getClientIp } from '@/server/http';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n  request?: Request;\n}\n\n// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\nconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    const metadata = input.metadata\n      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n      : undefined;\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: metadata as Prisma.InputJsonValue | undefined,\n        ip: input.request ? getClientIp(input.request) : null,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n=== src/server/auth/tokens.ts\nimport { createHash, randomBytes, timingSafeEqual } from 'node:crypto';\nimport type { AuthToken, AuthTokenType, Prisma, User } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\n\n/**\n * The only code that touches AuthToken (FR-13, NFR-1). Raw tokens are\n * returned to the caller once and never stored; only sha256(raw) hex is.\n */\n\ntype Tx = Prisma.TransactionClient;\n\nexport function hashToken(raw: string): string {\n  return createHash('sha256').update(raw).digest('hex');\n}\n\n/** Invalidates the user's older unused tokens of `type`, then issues a new one. Returns the raw token. */\nexport async function createToken(\n  userId: string,\n  type: AuthTokenType,\n  ttl: { minutes?: number; days?: number },\n  tx?: Tx,\n): Promise<string> {\n  const raw = randomBytes(32).toString('base64url');\n  const now = new Date();\n  const ttlMs = ((ttl.days ?? 0) * 24 * 60 + (ttl.minutes ?? 0)) * 60_000;\n\n  const run = async (client: Tx) => {\n    await client.authToken.updateMany({ where: { userId, type, usedAt: null }, data: { usedAt: now } });\n    await client.authToken.create({\n      data: { userId, type, tokenHash: hashToken(raw), expiresAt: new Date(now.getTime() + ttlMs) },\n    });\n  };\n  if (tx) await run(tx);\n  else await prisma.$transaction(run);\n  return raw;\n}\n\nexport type VerifiedToken = {\n  token: AuthToken;\n  user: Pick<User, 'id' | 'email' | 'firstName' | 'lastName' | 'status'>;\n};\n\n/** Returns the token + user, or null if missing, wrong type, used or expired. */\nexport async function verifyToken(raw: string, type: AuthTokenType): Promise<VerifiedToken | null> {\n  if (!raw) return null;\n  const hash = hashToken(raw);\n  const token = await prisma.authToken.findUnique({\n    where: { tokenHash: hash },\n    include: { user: { select: { id: true, email: true, firstName: true, lastName: true, status: true } } },\n  });\n  if (!token) return null;\n  if (!timingSafeEqual(Buffer.from(token.tokenHash, 'hex'), Buffer.from(hash, 'hex'))) return null;\n  if (token.type !== type || token.usedAt || token.expiresAt <= new Date()) return null;\n  const { user, ...rest } = token;\n  return { token: rest, user };\n}\n\n/** Marks the token used; throws INVALID_TOKEN if it was already consumed (double submit). */\nexport async function consumeToken(tokenId: string, tx?: Tx): Promise<void> {\n  const { count } = await (tx ?? prisma).authToken.updateMany({\n    where: { id: tokenId, usedAt: null },\n    data: { usedAt: new Date() },\n  });\n  if (count === 0) throw new AppError('INVALID_TOKEN', 'This link is invalid or has expired.');\n}\n=== src/server/auth/auth.config.ts\nimport type { NextAuthConfig } from 'next-auth';\nimport { safeCallbackUrl } from '@/lib/validators/auth';\n\n/**\n * Edge-safe Auth.js config (ADR-1): no Prisma, no bcrypt. src/middleware.ts\n * uses this alone; src/server/auth/auth.ts adds the Credentials provider\n * and the revocation-checking jwt callback on Node.\n * Cookies: Auth.js defaults (HttpOnly, SameSite=Lax, __Secure- in prod).\n */\nexport const authConfig = {\n  trustHost: true,\n  session: { strategy: 'jwt', maxAge: 8 * 60 * 60, updateAge: 15 * 60 },\n  pages: { signIn: '/login' },\n  providers: [],\n  callbacks: {\n    session({ session, token }) {\n      session.user.id = token.id;\n      session.user.role = token.role;\n      session.user.firstName = token.firstName;\n      session.user.lastName = token.lastName;\n      session.user.email = token.email ?? '';\n      return session;\n    },\n    redirect({ url, baseUrl }) {\n      // Auth.js hands us absolute URLs; reduce same-origin ones to a path, then sanitise.\n      const path = url.startsWith(baseUrl) ? url.slice(baseUrl.length) || '/' : url;\n      return baseUrl + safeCallbackUrl(path);\n    },\n  },\n} satisfies NextAuthConfig;\n=== src/server/auth/auth.ts\nimport NextAuth from 'next-auth';\nimport Credentials from 'next-auth/providers/credentials';\nimport { prisma } from '@/server/db';\nimport { authConfig } from '@/server/auth/auth.config';\nimport { authorizeCredentials } from '@/server/auth/credentials';\n\nconst RECHECK_MS = 5 * 60_000;\n\nexport const { handlers, auth, signIn, signOut, unstable_update } = NextAuth({\n  ...authConfig,\n  providers: [\n    Credentials({\n      credentials: { email: {}, password: {} },\n      authorize: (credentials, request) => authorizeCredentials(credentials, request),\n    }),\n  ],\n  callbacks: {\n    ...authConfig.callbacks,\n    async jwt({ token, user, trigger, session }) {\n      const now = Date.now();\n\n      if (trigger === 'signIn' && user) {\n        return {\n          ...token,\n          id: user.id as string,\n          role: user.role,\n          firstName: user.firstName,\n          lastName: user.lastName,\n          email: user.email,\n          authTime: now,\n          checkedAt: now,\n        };\n      }\n\n      // FR-23: the session that just changed its password stays valid.\n      if (trigger === 'update' && (session as { reauth?: boolean } | undefined)?.reauth) {\n        return { ...token, authTime: now, checkedAt: now };\n      }\n\n      // FR-11: revoke within 5 min of disable/archive/password change elsewhere.\n      if (now - (token.checkedAt ?? 0) > RECHECK_MS) {\n        const fresh = await prisma.user.findUnique({\n          where: { id: token.id },\n          select: { passwordChangedAt: true, status: true, archivedAt: true, role: true, firstName: true, lastName: true },\n        });\n        if (!fresh || fresh.status !== 'ACTIVE' || fresh.archivedAt) return null;\n        if (fresh.passwordChangedAt && fresh.passwordChangedAt.getTime() > token.authTime) return null;\n        return { ...token, role: fresh.role, firstName: fresh.firstName, lastName: fresh.lastName, checkedAt: now };\n      }\n\n      return token;\n    },\n  },\n});\n=== src/types/next-auth.d.ts\nimport type { DefaultSession } from 'next-auth';\nimport type { Role } from '@prisma/client';\n\ndeclare module 'next-auth' {\n  interface User {\n    role: Role;\n    firstName: string;\n    lastName: string;\n  }\n\n  interface Session {\n    user: {\n      id: string;\n      role: Role;\n      firstName: string;\n      lastName: string;\n      email: string;\n    } & DefaultSession['user'];\n  }\n}\n\ndeclare module '@auth/core/jwt' {\n  interface JWT {\n    id: string;\n    role: Role;\n    firstName: string;\n    lastName: string;\n    /** Epoch ms of the last real authentication (sign-in or reauth). Not `iat`, which moves on refresh. */\n    authTime: number;\n    /** Epoch ms of the last DB revocation check. */\n    checkedAt: number;\n  }\n}\n=== src/app/api/auth/[...nextauth]/route.ts\nimport { handlers } from '@/server/auth/auth';\n\nexport const { GET, POST } = handlers;\n=== src/server/auth/password-policy.ts\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { AppError } from '@/server/http';\nimport { passwordErrors } from '@/lib/validators/auth';\n\n/**\n * Server-only password policy (FR-17, ADR-7). Never import from client code:\n * it reads the common-password list from disk.\n */\nconst COMMON = new Set(\n  fs\n    .readFileSync(path.join(process.cwd(), 'src/server/auth/common-passwords.txt'), 'utf8')\n    .split('\\n')\n    .map((line) => line.trim().toLowerCase())\n    .filter(Boolean),\n);\n\nexport function assertPasswordAllowed(password: string, email: string): void {\n  const errors = passwordErrors(password, email);\n  if (COMMON.has(password.toLowerCase())) errors.push('This password is too common. Choose another.');\n  if (errors.length) {\n    throw new AppError('VALIDATION_ERROR', 'Password does not meet the requirements.', {\n      fieldErrors: { password: errors },\n    });\n  }\n}\n=== src/config/public-routes.ts\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\n=== src/middleware.ts\nimport NextAuth from 'next-auth';\nimport { NextResponse } from 'next/server';\nimport { authConfig } from '@/server/auth/auth.config';\nimport { isPublicPath } from '@/config/public-routes';\n\n/**\n * Edge gate (FR-12, NFR-7). Edge-safe: authConfig only, no Prisma/bcrypt.\n * This is a convenience redirect; requireRole()/requirePageRole() remain\n * the real authorization check on every handler and page.\n */\nconst { auth } = NextAuth(authConfig);\n\n// Auth.js's own endpoints (signin/signout/callback/csrf/session) carry their own CSRF token.\nconst AUTHJS_ENDPOINT = /^\\/api\\/auth\\/(signin|signout|callback|csrf|session|providers)(\\/|$)/;\n\nfunction jsonError(code: 'FORBIDDEN' | 'UNAUTHENTICATED', message: string, status: number) {\n  return NextResponse.json({ error: { code, message } }, { status });\n}\n\nexport default auth((req) => {\n  const { pathname, search, origin } = req.nextUrl;\n  const isApi = pathname.startsWith('/api/');\n\n  // NFR-8: cross-origin state-changing API calls are rejected.\n  const requestOrigin = req.headers.get('origin');\n  if (\n    isApi &&\n    !['GET', 'HEAD'].includes(req.method) &&\n    requestOrigin &&\n    requestOrigin !== origin &&\n    !AUTHJS_ENDPOINT.test(pathname)\n  ) {\n    return jsonError('FORBIDDEN', 'Cross-origin request rejected.', 403);\n  }\n\n  if (isPublicPath(pathname)) return NextResponse.next();\n\n  if (!req.auth?.user) {\n    if (isApi) return jsonError('UNAUTHENTICATED', 'You must be signed in.', 401);\n    const login = new URL('/login', origin);\n    login.searchParams.set('callbackUrl', pathname + search);\n    return NextResponse.redirect(login);\n  }\n\n  // requirePageUser() reads this to build the post-login callbackUrl.\n  const headers = new Headers(req.headers);\n  headers.set('x-pathname', pathname + search);\n  return NextResponse.next({ reques