{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghSTAwgGy7hEz2EFucof","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VDn8hmZZUEGrUdopWi9hhW","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/auth/tokens.ts","content":"import { createHash, randomBytes, timingSafeEqual } from 'node:crypto';\nimport type { AuthToken, AuthTokenType, Prisma, User } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\n\n/**\n * The only code that touches AuthToken (FR-13, NFR-1). Raw tokens are\n * returned to the caller once and never stored; only sha256(raw) hex is.\n */\n\ntype Tx = Prisma.TransactionClient;\n\nexport function hashToken(raw: string): string {\n  return createHash('sha256').update(raw).digest('hex');\n}\n\n/** Invalidates the user's older unused tokens of `type`, then issues a new one. Returns the raw token. */\nexport async function createToken(\n  userId: string,\n  type: AuthTokenType,\n  ttl: { minutes?: number; days?: number },\n  tx?: Tx,\n): Promise<string> {\n  const raw = randomBytes(32).toString('base64url');\n  const now = new Date();\n  const ttlMs = ((ttl.days ?? 0) * 24 * 60 + (ttl.minutes ?? 0)) * 60_000;\n\n  const run = async (client: Tx) => {\n    await client.authToken.updateMany({ where: { userId, type, usedAt: null }, data: { usedAt: now } });\n    await client.authToken.create({\n      data: { userId, type, tokenHash: hashToken(raw), expiresAt: new Date(now.getTime() + ttlMs) },\n    });\n  };\n  if (tx) await run(tx);\n  else await prisma.$transaction(run);\n  return raw;\n}\n\nexport type VerifiedToken = {\n  token: AuthToken;\n  user: Pick<User, 'id' | 'email' | 'firstName' | 'lastName' | 'status'>;\n};\n\n/** Returns the token + user, or null if missing, wrong type, used or expired. */\nexport async function verifyToken(raw: string, type: AuthTokenType): Promise<VerifiedToken | null> {\n  if (!raw) return null;\n  const hash = hashToken(raw);\n  const token = await prisma.authToken.findUnique({\n    where: { tokenHash: hash },\n    include: { user: { select: { id: true, email: true, firstName: true, lastName: true, status: true } } },\n  });\n  if (!token) return null;\n  if (!timingSafeEqual(Buffer.from(token.tokenHash, 'hex'), Buffer.from(hash, 'hex'))) return null;\n  if (token.type !== type || token.usedAt || token.expiresAt <= new Date()) return null;\n  const { user, ...rest } = token;\n  return { token: rest, user };\n}\n\n/** Marks the token used; throws INVALID_TOKEN if it was already consumed (double submit). */\nexport async function consumeToken(tokenId: string, tx?: Tx): Promise<void> {\n  const { count } = await (tx ?? prisma).authToken.updateMany({\n    where: { id: tokenId, usedAt: null },\n    data: { usedAt: new Date() },\n  });\n  if (count === 0) throw new AppError('INVALID_TOKEN', 'This link is invalid or has expired.');\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6450,"cache_read_input_tokens":130363,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6450},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"24b2a9c9-4488-41ba-bad0-91baebb96cfb","uuid":"70b96f66-984a-47c4-a7cd-ee1df48f2807","timestamp":"2026-11-04T06:47:35.120Z","request_id":"req_011CghSTAeZSyNNMqXcceCfv","wire_tool_inputs":{"toolu_01VDn8hmZZUEGrUdopWi9hhW":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/auth/tokens.ts","content":"import { createHash, randomBytes, timingSafeEqual } from 'node:crypto';\nimport type { AuthToken, AuthTokenType, Prisma, User } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\n\n/**\n * The only code that touches AuthToken (FR-13, NFR-1). Raw tokens are\n * returned to the caller once and never stored; only sha256(raw) hex is.\n */\n\ntype Tx = Prisma.TransactionClient;\n\nexport function hashToken(raw: string): string {\n  return createHash('sha256').update(raw).digest('hex');\n}\n\n/** Invalidates the user's older unused tokens of `type`, then issues a new one. Returns the raw token. */\nexport async function createToken(\n  userId: string,\n  type: AuthTokenType,\n  ttl: { minutes?: number; days?: number },\n  tx?: Tx,\n): Promise<string> {\n  const raw = randomBytes(32).toString('base64url');\n  const now = new Date();\n  const ttlMs = ((ttl.days ?? 0) * 24 * 60 + (ttl.minutes ?? 0)) * 60_000;\n\n  const run = async (client: Tx) => {\n    await client.authToken.updateMany({ where: { userId, type, usedAt: null }, data: { usedAt: now } });\n    await client.authToken.create({\n      data: { userId, type, tokenHash: hashToken(raw), expiresAt: new Date(now.getTime() + ttlMs) },\n    });\n  };\n  if (tx) await run(tx);\n  else await prisma.$transaction(run);\n  return raw;\n}\n\nexport type VerifiedToken = {\n  token: AuthToken;\n  user: Pick<User, 'id' | 'email' | 'firstName' | 'lastName' | 'status'>;\n};\n\n/** Returns the token + user, or null if missing, wrong type, used or expired. */\nexport async function verifyToken(raw: string, type: AuthTokenType): Promise<VerifiedToken | null> {\n  if (!raw) return null;\n  const hash = hashToken(raw);\n  const token = await prisma.authToken.findUnique({\n    where: { tokenHash: hash },\n    include: { user: { select: { id: true, email: true, firstName: true, lastName: true, status: true } } },\n  });\n  if (!token) return null;\n  if (!timingSafeEqual(Buffer.from(token.tokenHash, 'hex'), Buffer.from(hash, 'hex'))) return null;\n  if (token.type !== type || token.usedAt || token.expiresAt <= new Date()) return null;\n  const { user, ...rest } = token;\n  return { token: rest,