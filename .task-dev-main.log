{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VwsHUk3R9mDZQ3ePPgrYGe","type":"tool_result","content":"1\timport { z } from 'zod';\n2\timport { prisma } from '@/server/db';\n3\timport { paginated, parsePagination, parseQuery, withHandler } from '@/server/http';\n4\timport { requireRole } from '@/server/auth/requireRole';\n5\t\n6\tconst querySchema = z.object({\n7\t  actorId: z.string().optional(),\n8\t  actionPrefix: z.string().optional(),\n9\t  dateFrom: z.coerce.date().optional(),\n10\t  dateTo: z.coerce.date().optional(),\n11\t  page: z.string().optional(),\n12\t  pageSize: z.string().optional(),\n13\t});\n14\t\n15\t/**\n16\t * GET /api/audit-logs -- read-only view over the existing AuditLog table\n17\t * (src/server/audit.ts's schema). No write path here; audit() remains the\n18\t * only writer.\n19\t */\n20\texport const GET = withHandler(async (request: Request) => {\n21\t  requireRole('ADMIN');\n22\t\n23\t  const url = new URL(request.url);\n24\t  const query = parseQuery(url.searchParams, querySchema);\n25\t  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n26\t\n27\t  const where = {\n28\t    ...(query.actorId ? { actorId: query.actorId } : {}),\n29\t    ...(query.actionPrefix ? { action: { startsWith: query.actionPrefix } } : {}),\n30\t    ...(query.dateFrom || query.dateTo\n31\t      ? {\n32\t          createdAt: {\n33\t            ...(query.dateFrom ? { gte: query.dateFrom } : {}),\n34\t            ...(query.dateTo ? { lte: query.dateTo } : {}),\n35\t          },\n36\t        }\n37\t      : {}),\n38\t  };\n39\t\n40\t  const [rows, total] = await Promise.all([\n41\t    prisma.auditLog.findMany({\n42\t      where,\n43\t      include: { actor: { select: { firstName: true, lastName: true } } },\n44\t      orderBy: { createdAt: 'desc' },\n45\t      skip,\n46\t      take,\n47\t    }),\n48\t    prisma.auditLog.count({ where }),\n49\t  ]);\n50\t\n51\t  const data = rows.map((row) => ({\n52\t    id: row.id,\n53\t    createdAt: row.createdAt,\n54\t    actorId: row.actorId,\n55\t    actorName: row.actor ? `${row.actor.firstName} ${row.actor.lastName}` : null,\n56\t    action: row.action,\n57\t    entityType: row.entityType,\n58\t    entityId: row.entityId,\n59\t    ip: row.ip,\n60\t    metadata: row.metadata,\n61\t  }));\n62\t\n63\t  return paginated(data, { page, pageSize, total });\n64\t});\n65\t"}]},"parent_tool_use_id":null,"session_id":"bb2b8c62-3325-431e-93eb-03c63909bc5e","uuid":"b3118108-fd12-4655-a7b3-a05b935127ce","timestamp":"2026-10-19T09:47:24.282Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/api/audit-logs/route.ts","content":"import { z } from 'zod';\nimport { prisma } from '@/server/db';\nimport { paginated, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\n\nconst querySchema = z.object({\n  actorId: z.string().optional(),\n  actionPrefix: z.string().optional(),\n  dateFrom: z.coerce.date().optional(),\n  dateTo: z.coerce.date().optional(),\n  page: z.string().optional(),\n  pageSize: z.string().optional(),\n});\n\n/**\n * GET /api/audit-logs -- read-only view over the existing AuditLog table\n * (src/server/audit.ts's schema). No write path here; audit() remains the\n * only writer.\n */\nexport const GET = withHandler(async (request: Request) => {\n  requireRole('ADMIN');\n\n  const url = new URL(request.url);\n  const query = parseQuery(url.searchParams, querySchema);\n  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n\n  const where = {\n    ...(query.actorId ? { actorId: query.actorId } : {}),\n    ...(query.actionPrefix ? { action: { startsWith: query.actionPrefix } } : {}),\n    ...(query.dateFrom || query.dateTo\n      ? {\n          createdAt: {\n            ...(query.dateFrom ? { gte: query.dateFrom } : {}),\n            ...(query.dateTo ? { lte: query.dateTo } : {}),\n          },\n        }\n      : {}),\n  };\n\n  const [rows, total] = await Promise.all([\n    prisma.auditLog.findMany({\n      where,\n      include: { actor: { select: { firstName: true, lastName: true } } },\n      orderBy: { createdAt: 'desc' },\n      skip,\n      take,\n    }),\n    prisma.auditLog.count({ where }),\n  ]);\n\n  const data = rows.map((row) => ({\n    id: row.id,\n    createdAt: row.createdAt,\n    actorId: row.actorId,\n    actorName: row.actor ? `${row.actor.firstName} ${row.actor.lastName}` : null,\n    action: row.action,\n    entityType: row.entityType,\n    entityId: row.entityId,\n    ip: row.ip,\n    metadata: row.metadata,\n  }));\n\n  return paginated(data, { page, pageSize, total });\n});\n","numLines":65,"startLine":1,"totalLines":65}}}
