{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019zpwGudA2vfWtstqMejcQz","type":"tool_result","content":"1\ttype LogMeta = Record<string, unknown> | undefined;\n2\ttype Level = 'info' | 'warn' | 'error';\n3\t\n4\tconst isProd = process.env.NODE_ENV === 'production';\n5\t\n6\tfunction write(level: Level, message: string, meta?: LogMeta) {\n7\t  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n8\t\n9\t  if (isProd) {\n10\t    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n11\t    return;\n12\t  }\n13\t\n14\t  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n15\t}\n16\t\n17\texport const logger = {\n18\t  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n19\t  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n20\t  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n21\t};\n22\t"}]},"parent_tool_use_id":null,"session_id":"97520f4c-ae80-4db0-b68a-6ea625258a9f","uuid":"797cef2e-f512-4654-b959-f098c48ef645","timestamp":"2026-10-16T17:36:43.597Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/lib/logger.ts","content":"type LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n};\n","numLines":22,"startLine":1,"totalLines":22}}}
