lms.mui.com/material-ui/9.5.0/react-masonry.md)\n- [Menu](https://llms.mui.com/material-ui/9.5.0/react-menu.md)\n- [Menubar New](https://llms.mui.com/material-ui/9.5.0/react-menubar.md)\n- [Modal](https://llms.mui.com/material-ui/9.5.0/react-modal.md)\n- [No SSR](https://llms.mui.com/material-ui/9.5.0/react-no-ssr.md)\n- [Number Field New](https://llms.mui.com/material-ui/9.5.0/react-number-field.md)\n- [Pagination](https://llms.mui.com/material-ui/9.5.0/react-pagination.md)\n- [Paper](https://llms.mui.com/material-ui/9.5.0/react-paper.md)\n- [Popover](https://llms.mui.com/material-ui/9.5.0/react-popover.md)\n- [Popper](https://llms.mui.com/material-ui/9.5.0/react-popper.md)\n- [Portal](https://llms.mui.com/material-ui/9.5.0/react-portal.md)\n- [Progress](https://llms.mui.com/material-ui/9.5.0/react-progress.md)\n- [Radio Group](https://llms.mui.com/material-ui/9.5.0/react-radio-button.md)\n- [Rating](https://llms.mui.com/material-ui/9.5.0/react-rating.md)\n- [Select](https://llms.mui.com/material-ui/9.5.0/react-select.md)\n- [Skeleton](https://llms.mui.com/material-ui/9.5.0/react-skeleton.md)\n- [Slider](https://llms.mui.com/material-ui/9.5.0/react-slider.md)\n- [Snackbar](https://llms.mui.com/material-ui/9.5.0/react-snackbar.md)\n- [Speed Dial](https://llms.mui.com/material-ui/9.5.0/react-speed-dial.md)\n- [Stack](https://llms.mui.com/material-ui/9.5.0/react-stack.md)\n- [Stepper](https://llms.mui.com/material-ui/9.5.0/react-stepper.md)\n- [Switch](https://llms.mui.com/material-ui/9.5.0/react-switch.md)\n- [Table](https://llms.mui.com/material-ui/9.5.0/react-table.md)\n- [Tabs](https://llms.mui.com/material-ui/9.5.0/react-tabs.md)\n- [Text Field](https://llms.mui.com/material-ui/9.5.0/react-text-field.md)\n- [Textarea Autosize](https://llms.mui.com/material-ui/9.5.0/react-textarea-autosize.md)\n- [Timeline](https://llms.mui.com/material-ui/9.5.0/react-timeline.md)\n- [Toggle Button](https://llms.mui.com/material-ui/9.5.0/react-toggle-button.md)\n- [Tooltip](https://llms.mui.com/material-ui/9.5.0/react-tooltip.md)\n- [Transfer List](https://llms.mui.com/material-ui/9.5.0/react-transfer-list.md)\n- [Typography](https://llms.mui.com/material-ui/9.5.0/react-typography.md)\n- [useMediaQuery](https://llms.mui.com/material-ui/9.5.0/react-use-media-query.md)\n- [Transitions](https://llms.mui.com/material-ui/9.5.0/transitions.md)\n"}],"tool_result_meta":[{"id":"toolu_01CLnsim3WMnGS9ZB7JSiwXM","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
