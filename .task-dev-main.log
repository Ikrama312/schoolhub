{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LghXed4xvUnfGdSDStjLVA","type":"tool_result","content":"'use client';\n\nimport Link from 'next/link';\nimport { usePathname } from 'next/navigation';\nimport Tab from '@mui/material/Tab';\nimport Tabs from '@mui/material/Tabs';\nimport { courseTabs } from '@/config/course-tabs';\nimport type { Role } from '@/config/navigation';\n\nexport function CourseTabs({ courseId, role }: { courseId: string; role: Role }) {\n  const pathname = usePathname();\n  const tabs = courseTabs.filter((t) => t.roles.includes(role));\n  // Longest matching href wins so /courses/x/roster doesn't also match Overview.\n  const active = tabs\n    .filter((t) => pathname === t.href(courseId) || pathname.startsWith(`${t.href(courseId)}/`))\n    .sort((a, b) => b.href(courseId).length - a.href(courseId).length)[0];\n\n  return (\n    <Tabs value={active?.key ?? false} variant=\"scrollable\" scrollButtons=\"auto\" sx={{ mb: 3 }} aria-label=\"Course sections\">\n      {tabs.map((t) => (\n        <Tab key={t.key} value={t.key} label={t.label} component={Link} href={t.href(courseId)} />\n      ))}\n    </Tabs>\n  );\n}\n'use client';\n\nimport { Controller, type Control, type FieldValues, type Path } from 'react-hook-form';\nimport TextField, { type TextFieldProps } from '@mui/material/TextField';\nimport MenuItem from '@mui/material/MenuItem';\nimport Checkbox from '@mui/material/Checkbox';\nimport Switch from '@mui/material/Switch';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormControl from '@mui/material/FormControl';\nimport FormLabel from '@mui/material/FormLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport RadioGroup from '@mui/material/RadioGroup';\nimport Radio from '@mui/material/Radio';\nimport Autocomplete from '@mui/material/Autocomplete';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { DateTimePicker } from '@mui/x-date-pickers/DateTimePicker';\n\ninterface BaseProps<TFieldValues extends FieldValues> {\n  name: Path<TFieldValues>;\n  control: Control<TFieldValues>;\n  label: string;\n  helperText?: string;\n}\n\n/** Plain text / number / etc. MUI TextField bound via Controller. */\nexport function TextFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  ...rest\n}: BaseProps<TFieldValues> & Omit<TextFieldProps, 'name' | 'label' | 'error' | 'helperText'>) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          {...rest}\n          label={label}\n          error={Boolean(fieldState.error)}\n          helperText={fieldState.error?.message ?? helperText}\n          fullWidth\n        />\n      )}\n    />\n  );\n}\n\nexport interface SelectOption {\n  value: string;\n  label: string;\n}\n\nexport function SelectFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  options,\n}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <TextField\n          {...field}\n          select\n          label={label}\n          error={Boolean(fieldState.error)}\n          helperText={fieldState.error?.message ?? helperText}\n          fullWidth\n        >\n          {options.map((option) => (\n            <MenuItem key={option.value} value={option.value}>\n              {option.label}\n            </MenuItem>\n          ))}\n        </TextField>\n      )}\n    />\n  );\n}\n\nexport function AutocompleteFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n  helperText,\n  options,\n}: BaseProps<TFieldValues> & { options: SelectOption[] }) {\n  return (\n    <Controller\n      name={name}\n      control={control}\n      render={({ field, fieldState }) => (\n        <Autocomplete\n          options={options}\n          getOptionLabel={(option) => option.label}\n          isOptionEqualToValue={(option, value) => option.value === value.value}\n          value={options.find((option) => option.value === field.value) ?? null}\n          onChange={(_event, value) => field.onChange(value?.value ?? null)}\n          renderInput={(params) => (\n            <TextField\n              {...params}\n              label={label}\n              error={Boolean(fieldState.error)}\n              helperText={fieldState.error?.message ?? helperText}\n            />\n          )}\n        />\n      )}\n    />\n  );\n}\n\nexport function CheckboxFormField<TFieldValues extends FieldValues>({\n  name,\n  control,\n  label,\n}: BaseProps<TFieldValues>) {\n  return (\n    <Controller\nimport Box from '@mui/material/Box';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Breadcrumbs from '@mui/material/Breadcrumbs';\nimport Link from '@mui/material/Link';\nimport NextLink from 'next/link';\n\nexport interface Breadcrumb {\n  label: string;\n  href?: string;\n}\n\nexport interface PageHeaderProps {\n  title: string;\n  description?: string;\n  breadcrumbs?: Breadcrumb[];\n  actions?: React.ReactNode;\n}\n\nexport function PageHeader({ title, description, breadcrumbs, actions }: PageHeaderProps) {\n  return (\n    <Box sx={{ mb: 3 }}>\n      {breadcrumbs && breadcrumbs.length > 0 && (\n        <Breadcrumbs sx={{ mb: 1 }} aria-label=\"breadcrumb\">\n          {breadcrumbs.map((crumb, index) =>\n            crumb.href ? (\n              <Link key={index} component={NextLink} href={crumb.href} underline=\"hover\" color=\"inherit\">\n                {crumb.label}\n              </Link>\n            ) : (\n              <Typography key={index} color=\"text.primary\">\n                {crumb.label}\n              </Typography>\n            ),\n          )}\n        </Breadcrumbs>\n      )}\n      <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n        <Box>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {title}\n          </Typography>\n          {description && (\n            <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mt: 0.5 }}>\n              {description}\n            </Typography>\n          )}\n        </Box>\n        {actions && <Stack direction=\"row\" spacing={1}>{actions}</Stack>}\n      </Stack>\n    </Box>\n  );\n}\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport Button from '@mui/material/Button';\nimport InboxOutlinedIcon from '@mui/icons-material/InboxOutlined';\n\nexport interface EmptyStateProps {\n  icon?: React.ReactNode;\n  title: string;\n  description?: string;\n  action?: { label: string; onClick: () => void };\n}\n\nexport function EmptyState({ icon, title, description, action }: EmptyStateProps) {\n  return (\n    <Stack\n      spacing={1.5}\n      sx={{ alignItems: 'center', justifyContent: 'center', py: 8, px: 2, textAlign: 'center', color: 'text.secondary' }}\n    >\n      {icon ?? <InboxOutlinedIcon sx={{ fontSize: 48 }} />}\n      <Typography variant=\"h6\" color=\"text.primary\">\n        {title}\n      </Typography>\n      {description && <Typography variant=\"body2\">{description}</Typography>}\n      {action && (\n        <Button variant=\"outlined\" onClick={action.onClick} sx={{ mt: 1 }}>\n          {action.label}\n        </Button>\n      )}\n    </Stack>\n  );\n}\n'use client';\n\nimport { createContext, useContext } from 'react';\nimport type { AlertColor } from '@mui/material/Alert';\n\nexport interface ToastOptions {","is_error":false}]},"parent_tool_use_id":null,"session_id":"34574e28-0591-42df-96fb-64403ec6dad4","uuid":"0d12f20f-51d6-4bbe-b34e-be14304f7511","timestamp":"2026-11-06T21:32:51.388Z","tool_use_result":{"stdout":"'use client';\n\nimport Link from 'nex