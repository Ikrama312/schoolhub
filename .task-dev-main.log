n    \"requestSchema\": {\n      \"name\": \"string\",\n      \"shortName\": \"string\",\n      \"order\": \"int\"\n    },\n    \"responseSchema\": {\n      \"data\": {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"shortName\": \"string\",\n        \"order\": \"int\"\n      }\n    },\n    \"requirementIds\": [\n      \"FR-15\",\n      \"NFR-6\",\n      \"NFR-7\"\n    ]\n  },\n  {\n    \"method\": \"PATCH\",\n    \"path\": \"/api/grade-levels/:id\",\n    \"description\": \"Update fields, reorder, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n    \"requestSchema\": {\n      \"name\": \"string?\",\n      \"shortName\": \"string?\",\n      \"order\": \"int?\",\n      \"archived\": \"boolean?\"\n    },\n    \"responseSchema\": {\n      \"data\": {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"shortName\": \"string\",\n        \"order\": \"int\",\n        \"archivedAt\": \"datetime|null\"\n      }\n    },\n    \"requirementIds\": [\n      \"FR-15\",\n      \"NFR-6\",\n      \"NFR-7\"\n    ]\n  },\n  {\n    \"method\": \"GET\",\n    \"path\": \"/api/subjects\",\n    \"description\": \"List subjects, searchable by name/code via ?q=.\",\n    \"requestSchema\": {},\n    \"responseSchema\": {\n      \"data\": [\n        {\n          \"id\": \"string\",\n          \"name\": \"string\",\n          \"code\": \"string\",\n          \"description\": \"string|null\",\n          \"color\": \"string(hex)\",\n          \"archivedAt\": \"datetime|null\"\n        }\n      ]\n    },\n    \"requirementIds\": [\n      \"FR-16\",\n      \"NFR-6\"\n    ]\n  },\n  {\n    \"method\": \"POST\",\n    \"path\": \"/api/subjects\",\n    \"description\": \"Create a subject. Code is normalised upper-case; duplicate code returns CONFLICT (409) with field error 'Code already used by <subject>.'\",\n    \"requestSchema\": {\n      \"name\": \"string\",\n      \"code\": \"string (2-10 chars, normalised u