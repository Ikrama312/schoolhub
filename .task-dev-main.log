de, threshold } = await loadSettings();\n  const today = schoolToday(new Date(), tz);\n  const year = await currentYearWithTerm(today);\n  if (!year) return { threshold, rows: [] };\n  const rows = (await aggregate({ session: { date: { gte: toDbDate(year.start), lte: toDbDate(today) }, ...kindWhere(mode) } }))\n    .filter((r) => r.rate !== null && r.rate < threshold)\n    .sort((a, b) => (a.rate ?? 0) - (b.rate ?? 0))\n    .map((r) => ({ ...r, href: `/students/${r.studentId}/attendance` }));\n  return { threshold, rows };\n}\n\n/** For the admin Settings card. */\nexport async function getAttendanceSettings() {\n  const { mode, threshold } = await loadSettings();\n  return { attendanceMode: mode, attendanceAlertThreshold: threshold };\n}\nDatasource \"db\": PostgreSQL database \"schoolhub\", schema \"public\" at \"localhost:5433\"\n\n11 migrations found in prisma/migrations\n\nDatabase schema is up to date!\nimport { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\ntests/integration/quiz:\nattempts.test.ts\nqa-sh10.test.ts\nregrade.test.ts\n\ntests/unit/quiz:\ngrading.test.ts\nquiz-validators.test.ts\nserializers.test.ts\ntests/integration/files-qa.test.ts:8:  if (process.env.TEST_DATABASE_URL) process.env.DATABASE_URL = process.env.TEST_DATABASE_URL;\ntests/integration/files-qa.test.ts:29: * tagged with MARK and removed. Skipped without TEST_DATABASE_URL.\ntests/integration/files-qa.test.ts:66:describe.skipIf(!process.env.TEST_DATABASE_URL)('files: upload -> access -> delete/purge', () => {\ntests/integration/assignments/qa-sh9.test.ts:5:  if (process.env.TEST_DATABASE_URL) process.env.DATABASE_URL = process.env