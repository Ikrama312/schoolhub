{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FDXt4xikKKAkocmXvhXJng","type":"tool_result","content":"1\t/**\n2\t * Single choke point for every CSV-generation path in the app (bulk\n3\t * \"Export CSV\", the import error report). NFR-4: a cell starting with\n4\t * =, +, - or @ is prefixed with a leading apostrophe to neutralise\n5\t * formula injection when the file is opened in a spreadsheet tool.\n6\t */\n7\tconst FORMULA_PREFIX_CHARS = ['=', '+', '-', '@'];\n8\t\n9\texport function escapeCsvCell(value: unknown): string {\n10\t  if (value === null || value === undefined) return '';\n11\t  let cell = String(value);\n12\t\n13\t  if (FORMULA_PREFIX_CHARS.includes(cell[0])) {\n14\t    cell = `'${cell}`;\n15\t  }\n16\t\n17\t  if (/[\",\\n\\r]/.test(cell)) {\n18\t    cell = `\"${cell.replace(/\"/g, '\"\"')}\"`;\n19\t  }\n20\t\n21\t  return cell;\n22\t}\n23\t\n24\t/**\n25\t * Builds a CSV string (header row + one row per record) from an array of\n26\t * flat objects, in the given column order. Every cell goes through\n27\t * escapeCsvCell -- callers never concatenate CSV by hand.\n28\t */\n29\texport function toCsv(columns: { key: string; header: string }[], rows: Record<string, unknown>[]): string {\n30\t  const headerLine = columns.map((c) => escapeCsvCell(c.header)).join(',');\n31\t  const lines = rows.map((row) => columns.map((c) => escapeCsvCell(row[c.key])).join(','));\n32\t  return [headerLine, ...lines].join('\\r\\n');\n33\t}\n34\t"}]},"parent_tool_use_id":null,"session_id":"bb2b8c62-3325-431e-93eb-03c63909bc5e","uuid":"04406c74-76b6-4d33-9331-441e71d1f7de","timestamp":"2026-10-19T09:47:23.742Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/csv.ts","content":"/**\n * Single choke point for every CSV-generation path in the app (bulk\n * \"Export CSV\", the import error report). NFR-4: a cell starting with\n * =, +, - or @ is prefixed with a leading apostrophe to neutralise\n * formula injection when the file is opened in a spreadsheet tool.\n */\nconst FORMULA_PREFIX_CHARS = ['=', '+', '-', '@'];\n\nexport function escapeCsvCell(value: unknown): string {\n  if (value === null || value === undefined) return '';\n  let cell = String(value);\n\n  if (FORMULA_PREFIX_CHARS.includes(cell[0])) {\n    cell = `'${cell}`;\n  }\n\n  if (/[\",\\n\\r]/.test(cell)) {\n    cell = `\"${cell.replace(/\"/g, '\"\"')}\"`;\n  }\n\n  return cell;\n}\n\n/**\n * Builds a CSV string (header row + one row per record) from an array of\n * flat objects, in the given column order. Every cell goes through\n * escapeCsvCell -- callers never concatenate CSV by hand.\n */\nexport function toCsv(columns: { key: string; header: string }[], rows: Record<string, unknown>[]): string {\n  const headerLine = columns.map((c) => escapeCsvCell(c.header)).join(',');\n  const lines = rows.map((row) => columns.map((c) => escapeCsvCell(row[c.key])).join(','));\n  return [headerLine, ...lines].join('\\r\\n');\n}\n","numLines":34,"startLine":1,"totalLines":34}}}
