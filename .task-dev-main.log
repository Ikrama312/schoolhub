  1048 artifacts/intake/handoff-to-architect.json\n83\t   17516 artifacts/intake/requirements.json\n84\t     650 artifacts/intake/tech-stack.json\n85\t    5349 artifacts/intake/user-stories.md\n86\t    5170 artifacts/telemetry/api-retries.jsonl\n87\t     133 artifacts/telemetry/daemon-handoff.json\n88\t     837 artifacts/telemetry/knowledge-log.jsonl\n89\t    3327 artifacts/telemetry/metering.jsonl\n90\t    1036 artifacts/telemetry/phase-sessions.json\n91\t  162614 total\n92\t{\n93\t  \"ticketId\": \"abcd-1\",\n94\t  \"version\": \"1.0\",\n95\t  \"timestamp\": \"2026-11-04T12:00:00Z\",\n96\t  \"phase\": \"dev-planning\",\n97\t  \"tasks\": [\n98\t    {\n99\t      \"id\": \"TASK-1\",\n100\t      \"description\": \"Additive schema reconcile (ADR-9, C1): add @@index([entityType, entityId]) and @@index([actorId, createdAt]) to AuditLog in prisma/schema.prisma. No renames or drops: keep AuditLog.ip, UserStatus.ARCHIVED and the existing indexes. Generate the migration with `prisma migrate dev --name auth_reconcile` and rename its folder to exactly 20261104000000_auth_reconcile so the path matches this plan. The SQL must contain only CREATE INDEX statements.\",\n101\t      \"files\": [\n102\t        \"prisma/migrations/20261104000000_auth_reconcile/migration.sql\",\n103\t        \"prisma/schema.prisma\"\n104\t      ],\n105\t      \"dependencies\": [],\n106\t      \"estimateHours\": 0.5,\n107\t      \"requirementIds\": [\n108\t        \"FR-1\",\n109\t        \"NFR-9\",\n110\t        \"NFR-12\"\n111\t      ]\n112\t    },\n113\t    {\n114\t      \"id\": \"TASK-2\",\n115\t      \"description\": \"Client-safe validators (C6): emailField = z.string().trim().toLowerCase().email(). Also signInSchema, forgotPasswordSchema, acceptInviteSchema/resetPasswordSchema {token,password,confirm}, and changePasswordSchema {currentPassword,newPassword,confirm} with confirm-equals refines. passwordChecks(pw, email) returns {length (10-128), letter, digit, notEmail}, and the schemas' superRefine uses it. safeCallbackUrl(url) returns url only if it starts with '/' and not '//' or '/\\\\\\\\'; otherwise '/dashboard'. No fs import. Unit tests cover passwordChecks and safeCallbackUrl, including '//evil.com', '/\\\\\\\\evil', 'https://evil.com', '' and null.\",\n116\t      \"files\": [\n117\t        \"src/lib/validators/auth.ts\",\n118\t        \"tests/unit/auth-validators.test.ts\"\n119\t      ],\n120\t      \"dependencies\": [],\n121\t      \"estimateHours\": 1.5,\n122\t      \"requirementIds\": [\n123\t        \"FR-2\",\n124\t        \"FR-8\",\n125\t        \"FR-17\",\n126\t        \"FR-36\",\n127\t        \"NFR-8\"\n128\t      ]\n129\t    },\n130\t    {\n131\t      \"id\": \"TASK-3\",\n132\t      \"description\": \"Auth email seam (C9): sendAuthEmail(user, kind: 'invite'|'password-reset', link) logs {to, subject, link} with logger.info (no console.log). Export a link builder that uses the existing env.APP_URL: /invite/<raw> and /reset-password/<raw>. Don't add an AUTH_URL env var, because APP_URL already exists in src/lib/env.ts. PRD-04 will replace this function's body.\",\n133\t      \"files\": [\n134\t        \"src/server/auth/email.ts\"\n135\t      ],\n136\t      \"dependencies\": [],\n137\t      \"estimateHours\": 0.5,\n138\t      \"requirementIds\": [\n139\t        \"FR-22\",\n140\t        \"NFR-10\",\n141\t        \"NFR-11\"\n142\t      ]\n143\t    },\n144\t    {\n145\t      \"id\": \"TASK-4\",\n146\t      \"description\": \"Rate limiter + client IP (C5, ADR-6): rateLimit(key, limit, windowMs, now = Date.now()) returns {ok, retryAfterMs}. It keeps a module-level Map<string, number[]> and prunes old timestamps on each call. Export __resetRateLimits() for tests. Add the comment `// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled`. Add getClientIp(request) to the existing src/server/http.ts: the first x-forwarded-for entry, trimmed, or null. Unit tests inject `now` and cover the limit, the window sliding and key isolation.\",\n147\t      \"files\": [\n148\t        \"src/server/rate-limit.ts\",\n149\t        \"src/server/http.ts\",\n150\t        \"tests/unit/rate-limit.test.ts\"\n151\t      ],\n152\t      \"dependencies\": [],\n153\t      \"estimateHours\": 1,\n154\t      \"requirementIds\": [\n155\t        \"FR-7\",\n156\t        \"FR-19\",\n157\t        \"FR-30\",\n158\t        \"FR-36\",\n159\t        \"NFR-11\"\n160\t      ]\n161\t    },\n162\t    {\n163\t      \"id\": \"TASK-5\",\n164\t      \"description\": \"Extend audit() (C11): add an optional `request?: Request` and store ip = request ? getClientIp(request) : null in the existing `ip` column. Before the insert, strip the metadata keys password, passwordHash, newPassword, currentPassword, token and rawToken. Keep the existing try/catch so it still never throws. Existing callers keep compiling unchanged.\",\n165\t      \"files\": [\n166\t        \"src/server/audit.ts\"\n167\t      ],\n168\t      \"dependencies\": [\n169\t        \"TASK-4\"\n170\t      ],\n171\t      \"estimateHours\": 0.5,\n172\t      \"requirementIds\": [\n173\t        \"FR-30\",\n174\t        \"FR-31\",\n175\t        \"NFR-9\"\n176\t      ]\n177\t    },\n178\t    {\n179\t      \"id\": \"TASK-6\",\n180\t      \"description\": \"Token module (C4, ADR-5), the only code that touches AuthToken. createToken(userId, type, ttl {minutes?|days?}, tx?) runs, in one transaction, an updateMany that sets usedAt=now on the user's unused tokens of that type, then inserts the new row. It returns the raw randomBytes(32) base64url token and stores only the sha256 hex hash. verifyToken(raw, type) finds by tokenHash, confirms with timingSafeEqual, and returns {token, user} or null if the token is missing, has the wrong type, is used or is expired. consumeToken(tokenId, tx?) runs updateMany {id, usedAt: null} and throws AppError('INVALID_TOKEN') when the count is 0. Export the pure hashToken(raw). Unit tests cover hashToken (deterministic, 64 hex chars, never equal to raw). The DB branches are tested in TASK-25.\",\n181\t      \"files\": [\n182\t        \"src/server/auth/tokens.ts\",\n183\t        \"tests/unit/tokens.test.ts\"\n184\t      ],\n185\t      \"dependencies\": [\n186\t        \"TASK-1\"\n187\t      ],\n188\t      \"estimateHours\": 1.5,\n189\t      \"requirementIds\": [\n190\t        \"FR-13\",\n191\t        \"FR-20\",\n192\t        \"FR-26\",\n193\t        \"FR-31\",\n194\t        \"FR-36\",\n195\t        \"NFR-1\"\n196\t      ]\n197\t    },\n198\t    {\n199\t      \"id\": \"TASK-7\",\n200\t      \"description\": \"Credential verification (C3): authorizeCredentials(input, request). Order: rateLimit('login:ip:'+ip, 10, 5 min) \\u2192 AuthError('rate_limited'); signInSchema parse; user lookup; then exactly ONE bcrypt.compare against the user's hash or a module-level DUMMY_HASH (cost 12). Rejections happen only after that compare. Branches: missing \\u2192 invalid; DISABLED \\u2192 disabled; status!==ACTIVE or archivedAt set \\u2192 invalid; lockedUntil>now \\u2192 'locked:'+ceil(ms/60000); wrong password \\u2192 increment failedLoginCount, and when the count reaches 5 apply the lock (computeLockout) \\u2192 invalid or locked:15; success \\u2192 failedLoginCount=0, lastLoginAt=now. Pure computeLockout(count, now) returns {failedLoginCount, lockedUntil|null}. Audit auth.login.success, auth.login.failure {email, reason} and auth.lockout, passing the request. Define `class AuthError extends CredentialsSignin { code }`. Unit-test computeLockout.\",\n201\t      \"files\": [\n202\t        \"src/server/auth/credentials.ts\",\n203\t        \"tests/unit/lockout.test.ts\"\n204\t      ],\n205\t      \"dependencies\": [\n206\t        \"TASK-2\",\n207\t        \"TASK-4\",\n208\t        \"TASK-5\"\n209\t      ],\n210\t      \"estimateHours\": 2.5,\n211\t      \"requirementIds\": [\n212\t        \"FR-4\",\n213\t        \"FR-5\",\n214\t        \"FR-6\",\n215\t        \"FR-7\",\n216\t        \"FR-9\",\n217\t        \"NFR-3\",\n218\t        \"NFR-4\",\n219\t        \"NFR-12\"\n220\t      ]\n221\t    },\n222\t    {\n223\t      \"id\": \"TASK-8\",\n224\t      \"description\": \"Auth.js core (C2, ADR-1). auth.config.ts must be edge-safe (no Prisma or bcrypt): session jwt with maxAge 8h and updateAge 15m, pages.signIn '/login', providers [], a session callback that copies id/role/firstName/lastName/email, a redirect callback that uses safeCallbackUrl, and trustHost: true. auth.ts (Node) spreads authConfig with Credentials({authorize: (c, req) => authorizeCredentials(c, req)}) and a jwt callback. On signIn it copies the fields and sets authTime and checkedAt. On update with {reauth:true} it sets authTime=now. Otherwise, at most every 5 minutes, it re-selects passwordChangedAt/status/role/names and returns null if status!==ACTIVE or passwordChangedAt>authTime. Use the custom authTime, NOT iat. auth.ts exports {handlers, auth, signIn, signOut, unstable_update}. Add the module augmentation in src/types/next-auth.d.ts and `export const { GET, POST } = handlers` in the catch-all route. Pin next-auth to the exact installed version in package.json (drop the ^).\",\n225\t      \"files\": [\n226\t        \"src/server/auth/auth.config.ts\",\n227\t        \"src/server/auth/auth.ts\",\n228\t        \"src/types/next-auth.d.ts\",\n229\t        \"src/app/api/auth/[...nextauth]/route.ts\",\n230\t        \"package.json\"\n231\t      ],\n232\t      \"dependencies\": [\n233\t        \"TASK-2\",\n234\t        \"TASK-7\"\n235\t      ],\n236\t      \"estimateHours\": 2,\n237\t      \"requirementIds\": [\n238\t        \"FR-3\",\n239\t        \"FR-10\",\n240\t        \"FR-11\",\n241\t        \"FR-34\",\n242\t        \"NFR-2\"\n243\t      ]\n244\t    },\n245\t    {\n246\t      \"id\": \"TASK-9\",\n247\t      \"description\": \"Server-only password policy (C6, ADR-7). Add common-passwords.txt with 1,000 lines, lower-cased, one per line. It must not contain 'schoolhub123!', and it should include entries \\u226510 chars with a letter and a digit (e.g. 'password123') so the rule is testable. password-policy.ts reads the file once into a Set via fs + path.join(process.cwd(), 'src/server/auth/common-passwords.txt') and exports assertPasswordAllowed(pw, email). That function runs passwordChecks plus the case-insensitive common-list check and throws AppError VALIDATION_ERROR with details.fieldErrors.password. Never import it from client code. Unit tests cover each rule and the common-list rejection.\",\n248\t      \"files\": [\n249\t        \"src/server/auth/common-passwords.txt\",\n250\t        \"src/server/auth/password-policy.ts\",\n251\t        \"tests/unit/password-policy.test.ts\"\n252\t      ],\n253\t      \"dependencies\": [\n254\t        \"TASK-2\"\n255\t      ],\n256\t      \"estimateHours\": 1,\n257\t      \"requirementIds\": [\n258\t        \"FR-17\",\n259\t        \"FR-36\",\n260\t        \"NFR-8\"\n261\t      ]\n262\t    },\n263\t    {\n264\t      \"id\": \"TASK-10\",\n265\t      \"description\": \"Edge middleware (C8). public-routes.ts exports PUBLIC_PAGE_PATHS ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'] (a trailing '/' means prefix match) and PUBLIC_API_PATHS ['/api/health', '/api/auth/']. There is no sign-up path. src/middleware.ts is `export default NextAuth(authConfig).auth(req => ...)` and runs, in order: (1) a non-GET/HEAD /api/* request with an Origin that differs from the app origin \\u2192 403 FORBIDDEN in the JSON envelope (skip Auth.js's own catch-all endpoints, which have their own CSRF); (2) public path \\u2192 next(); (3) no session: /api \\u2192 401 {error:{code:'UNAUTHENTICATED',message}}, pages \\u2192 redirect /login?callbackUrl=<path+search>; (4) next() with an x-pathname request header. The matcher excludes _next/static, _next/image, favicon.ico and file extensions. Don't import Prisma or bcrypt.\",\n266\t      \"files\": [\n267\t        \"src/config/public-routes.ts\",\n268\t        \"src/middleware.ts\"\n269\t      ],\n270\t      \"dependencies\": [\n271\t        \"TASK-8\"\n272\t      ],\n273\t      \"estimateHours\": 1.5,\n274\t      \"requirementIds\": [\n275\t        \"FR-12\",\n276\t        \"FR-37\",\n277\t        \"NFR-2\",\n278\t        \"NFR-7\",\n279\t        \"NFR-8\"\n280\t      ]\n281\t    },\n282\t    {\n283\t      \"id\": \"TASK-11\",\n284\t      \"description\": \"Rewrite requireRole.ts (C7, ADR-2): delete PLACEHOLDER_USER. SessionUser is {id, role, firstName, lastName, email}. getCurrentUser = cache(async () => (await auth())?.user ?? null). requireUser() and requireRole(...roles) are async and throw AppError UNAUTHENTICATED / FORBIDDEN. requirePageUser() and requirePageRole(...roles) redirect to /login?callbackUrl=<x-pathname header or /dashboard> or to /forbidden. Both pairs share one internal resolver; there is no flag parameter. No permissions.ts and no can(). NOTE: typecheck is red until TASK-12..14 land, so run them right after this task.\",\n285\t      \"files\": [\n286\t        \"src/server/auth/requireRole.ts\"\n287\t      ],\n288\t      \"dependencies\": [\n289\t        \"TASK-8\"\n290\t      ],\n291\t      \"estimateHours\": 1,\n292\t      \"requirementIds\": [\n293\t        \"FR-28\",\n294\t        \"FR-29\",\n295\t        \"NFR-7\",\n296\t        \"NFR-9\"\n297\t      ]\n298\t    },\n299\t    {\n300\t      \"id\": \"TASK-12\",\n301\t      \"description\": \"Await requireRole in the 13 academic-years / audit-logs / courses / enrollments / me route handlers. Mechanical: `requireRole(` \\u2192 `await requireRole(`. No path, request or response shape changes. withHandler already maps the thrown AppError to 401/403.\",\n302\t      \"files\": [\n303\t        \"src/app/api/academic-years/route.ts\",\n304\t        \"src/app/api/academic-years/[id]/route.ts\",\n305\t        \"src/app/api/academic-years/[id]/set-current/route.ts\",\n306\t        \"src/app/api/academic-years/[id]/terms/route.ts\",\n307\t        \"src/app/api/audit-logs/route.ts\",\n308\t        \"src/app/api/courses/route.ts\",\n309\t        \"src/app/api/courses/[id]/route.ts\",\n310\t        \"src/app/api/courses/[id]/enrollments/route.ts\",\n311\t        \"src/app/api/courses/[id]/roster/route.ts\",\n312\t        \"src/app/api/enrollments/[id]/route.ts\",\n313\t        \"src/app/api/me/children/route.ts\",\n314\t        \"src/app/api/me/courses/route.ts\",\n315\t        \"src/app/api/me/profile/route.ts\"\n316\t      ],\n317\t      \"dependencies\": [\n318\t        \"TASK-11\"\n319\t      ],\n320\t      \"estimateHours\": 0.5,\n321\t      \"requirementIds\": [\n322\t        \"FR-29\",\n323\t        \"NFR-7\",\n324\t        \"NFR-9\"\n325\t      ]\n326\t    },\n327\t    {\n328\t      \"id\": \"TASK-13\",\n329\t      \"description\": \"Await requireRole in the 20 sections / students / users route handlers. Mechanical: `requireRole(` \\u2192 `await requireRole(`. No path, request or response shape changes.\",\n330\t      \"files\": [\n331\t        \"src/app/api/sections/route.ts\",\n332\t        \"src/app/api/sections/[id]/route.ts\",\n333\t        \"src/app/api/sections/[id]/core-courses/route.ts\",\n334\t        \"src/app/api/sections/[id]/members/route.ts\",\n335\t        \"src/app/api/sections/[id]/members/[studentId]/route.ts\",\n336\t        \"src/app/api/sections/copy-to-year/route.ts\",\n337\t        \"src/app/api/students/[id]/route.ts\",\n338\t        \"src/app/api/students/[id]/move-section/route.ts\",\n339\t        \"src/app/api/students/[id]/parents/route.ts\",\n340\t        \"src/app/api/students/[id]/parents/[parentId]/route.ts\",\n341\t        \"src/app/api/users/route.ts\",\n342\t        \"src/app/api/users/[id]/route.ts\",\n343\t        \"src/app/api/users/[id]/archive/route.ts\",\n344\t        \"src/app/api/users/[id]/invite/route.ts\",\n345\t        \"src/app/api/users/[id]/restore/route.ts\",\n346\t        \"src/app/api/users/[id]/status/route.ts\",\n347\t        \"src/app/api/users/[id]/unlock/route.ts\",\n348\t        \"src/app/api/users/export/route.ts\",\n349\t        \"src/app/api/users/import/route.ts\",\n350\t        \"src/app/api/users/search/route.ts\"\n351\t      ],\n352\t      \"dependencies\": [\n353\t        \"TASK-11\"\n354\t      ],\n355\t      \"estimateHours\": 0.5,\n356\t      \"requirementIds\": [\n357\t        \"FR-29\",\n358\t        \"NFR-7\",\n359\t        \"NFR-9\"\n360\t      ]\n361\t    },\n362\t    {\n363\t      \"id\": \"TASK-14\",\n364\t      \"description\": \"Switch the 8 server pages/layouts from requireRole( to `await requirePageRole(`, with the same role arguments, so an unauthorized visit redirects instead of rendering error.tsx. Don't change course-access.ts or student-access.ts, which still receive the resolved {id, role}.\",\n365\t      \"files\": [\n366\t        \"src/app/(app)/admin/courses/page.tsx\",\n367\t        \"src/app/(app)/admin/courses/[id]/enrollment/page.tsx\",\n368\t        \"src/app/(app)/admin/sections/page.tsx\",\n369\t        \"src/app/(app)/admin/sections/[id]/page.tsx\",\n370\t        \"src/app/(app)/courses/[courseId]/layout.tsx\",\n371\t        \"src/app/(app)/courses/[courseId]/roster/page.tsx\",\n372\t        \"src/app/(app)/my-courses/page.tsx\",\n373\t        \"src/app/(app)/students/[id]/courses/page.tsx\"\n374\t      ],\n375\t      \"dependencies\": [\n376\t        \"TASK-11\"\n377\t      ],\n378\t      \"estimateHours\": 0.5,\n379\t      \"requirementIds\": [\n380\t        \"FR-29\",\n381\t        \"NFR-7\",\n382\t        \"NFR-9\"\n383\t      ]\n384\t    },\n385\t    {\n386\t      \"id\": \"TASK-15\",\n387\t      \"description\": \"Guardrail for missed awaits: in .eslintrc.json, add an override for src/**/*.{ts,tsx} with parserOptions.project './tsconfig.json' and '@typescript-eslint/no-floating-promises': 'error'. Fix any newly reported floating promises with an await or a `void` prefix. `npm run lint` must pass.\",\n388\t      \"files\": [\n389\t        \".eslintrc.json\"\n390\t      ],\n391\t      \"dependencies\": [\n392\t        \"TASK-12\",\n393\t        \"TASK-13\",\n394\t        \"TASK-14\"\n395\t      ],\n396\t      \"estimateHours\": 0.5,\n397\t      \"requirementIds\": [\n398\t        \"NFR-10\",\n399\t        \"FR-29\"\n400\t      ]\n401\t    },\n402\t    {\n403\t      \"id\": \"TASK-16\",\n404\t      \"description\": \"Auth services (C9), Node only. acceptInvite({token,password}, req): verifyToken INVITE (null \\u2192 AppError INVALID_TOKEN), assertPasswordAllowed, bcrypt.hash 12, then one $transaction {passwordHash, status ACTIVE, passwordChangedAt now} + consumeToken(tx). Audit auth.invite.accepted and return {email}. requestPasswordReset({email}, req): rateLimit forgot:ip 10/h \\u2192 RATE_LIMITED; rateLimit forgot:email 3/h \\u2192 silently return the generic message; only an ACTIVE user gets createToken PASSWORD_RESET {minutes:60} + sendAuthEmail. Always return {message:\\\"If an account exists for that email, we've sent a reset link.\\\"}. resetPassword: verify PASSWORD_RESET, policy check, hash, then one transaction {passwordHash, passwordChangedAt, failedLoginCount 0, lockedUntil null} + consume. Audit auth.password.reset. changePassword(user, {currentPassword,newPassword}, req): a wrong current password \\u2192 VALIDATION_ERROR details.fieldErrors.currentPassword ['Current password is incorrect.']; then policy check, hash, update passwordHash + passwordChangedAt, audit auth.password.changed. Audit metadata is explicit and never includes passwords or tokens.\",\n405\t      \"files\": [\n406\t        \"src/server/services/auth.ts\"\n407\t      ],\n408\t      \"dependencies\": [\n409\t        \"TASK-3\",\n410\t        \"TASK-4\",\n411\t        \"TASK-5\",\n412\t        \"TASK-6\",\n413\t        \"TASK-9\"\n414\t      ],\n415\t      \"estimateHours\": 2.5,\n416\t      \"requirementIds\": [\n417\t        \"FR-16\",\n418\t        \"FR-19\",\n419\t        \"FR-20\",\n420\t        \"FR-21\",\n421\t        \"FR-23\",\n422\t        \"FR-31\",\n423\t        \"NFR-3\",\n424\t        \"NFR-8\"\n425\t      ]\n426\t    },\n427\t    {\n428\t      \"id\": \"TASK-17\",\n429\t      \"description\": \"Thin auth route handlers (NFR-8): withHandler + parseBody(schema) \\u2192 service \\u2192 ok(). Files: accept-invite (acceptInviteSchema \\u2192 acceptInvite \\u2192 {email}), forgot-password (forgotPasswordSchema \\u2192 requestPasswordReset), reset-password (resetPasswordSchema \\u2192 resetPassword \\u2192 {ok:true}), and account/password. account/password runs await requireUser() \\u2192 changePasswordSchema \\u2192 changePassword, then unstable_update({reauth:true}) from auth.ts \\u2192 {ok:true}. Status codes follow api-contracts.json (400/401/403/410/429).\",\n430\t      \"files\": [\n431\t        \"src/app/api/auth/accept-invite/route.ts\",\n432\t        \"src/app/api/auth/forgot-password/route.ts\",\n433\t        \"src/app/api/auth/reset-password/route.ts\",\n434\t        \"src/app/api/account/password/route.ts\"\n435\t      ],\n436\t      \"dependencies\": [\n437\t        \"TASK-16\",\n438\t        \"TASK-11\"\n439\t      ],\n440\t      \"estimateHours\": 1.5,\n441\t      \"requirementIds\": [\n442\t        \"FR-16\",\n443\t        \"FR-19\",\n444\t        \"FR-21\",\n445\t        \"FR-23\",\n446\t        \"FR-34\",\n447\t        \"NFR-8\"\n448\t      ]\n449\t    },\n450\t    {\n451\t      \"id\": \"TASK-18\",\n452\t      \"description\": \"Users service (C10): keep createUser, setUserStatus(actorId,userId,status) and unlockUser(userId) as they are. Make sure createUser lower-cases the email (a one-line fix if it's missing, e.g. reuse emailField) and that a duplicate email still maps to CONFLICT. Add createInviteToken(userId) = createToken(userId,'INVITE',{days:7}). Replace the no-op sendInvite body with createInviteToken \\u2192 sendAuthEmail(user,'invite',link), keeping the existing {id, inviteSentAt} return shape for users/[id]/invite, the users.ts createUser path and userImport.ts.\",\n453\t      \"files\": [\n454\t        \"src/server/services/users.ts\"\n455\t      ],\n456\t      \"dependencies\": [\n457\t        \"TASK-2\",\n458\t        \"TASK-3\",\n459\t        \"TASK-6\"\n460\t      ],\n461\t      \"estimateHours\": 1,\n462\t      \"requirementIds\": [\n463\t        \"FR-2\",\n464\t        \"FR-25\",\n465\t        \"FR-26\",\n466\t        \"FR-27\"\n467\t      ]\n468\t    },\n469\t    {\n470\t      \"id\": \"TASK-19\",\n471\t      \"description\": \"Shared password UI (C13), MUI v9 only. Look up List, ListItem, ListItemIcon, TextField, InputAdornment, IconButton and Alert through mui-mcp (useMuiDocs \\u2192 fetchDocs) BEFORE writing code. If mui-mcp is unreachable, stop and report a blocker (NFR-6). PasswordChecklist({password, email}) renders an MUI List with CheckCircle/RadioButtonUnchecked icons, driven by passwordChecks. SetPasswordForm({name?, email, onSubmit}) is a client component: read-only name/email, password + confirm with a show-password toggle, the checklist, react-hook-form + zodResolver with shouldFocusError, the form-level Alert inside Box aria-live='polite', and server details.fieldErrors mapped via setError. index.ts re-exports both.\",\n472\t      \"files\": [\n473\t        \"src/components/PasswordChecklist/PasswordChecklist.tsx\",\n474\t        \"src/components/PasswordChecklist/SetPasswordForm.tsx\",\n475\t        \"src/components/PasswordChecklist/index.ts\"\n476\t      ],\n477\t      \"dependencies\": [\n478\t        \"TASK-2\"\n479\t      ],\n480\t      \"estimateHours\": 2,\n481\t      \"requirementIds\": [\n482\t        \"FR-15\",\n483\t        \"FR-17\",\n484\t        \"FR-18\",\n485\t        \"NFR-5\",\n486\t        \"NFR-6\"\n487\t      ]\n488\t    },\n489\t    {\n490\t      \"id\": \"TASK-20\",\n491\t      \"description\": \"(auth) layout + login + forgot-password (C13), MUI v9 via mui-mcp first. layout.tsx is a centred Container + Card with no AppShell. login/page.tsx is a client form using MUI Sign-in template patterns: email, password with a Visibility toggle, signIn('credentials',{redirect:false}). Map the error code: invalid \\u2192 'Email or password is incorrect.', disabled \\u2192 'This account is disabled. Contact the school office.', locked:N \\u2192 'This account is temporarily locked. Try again in N minutes.', rate_limited \\u2192 'Too many attempts. Wait a few minutes and try again.'. On success, router.push(safeCallbackUrl(callbackUrl)). With ?reset=1, show the useToast success toast. Link to /forgot-password; there is NO sign-up link. Wrap useSearchParams in Suspense. forgot-password/page.tsx: an email field that shows the generic message on 200 and the rate-limit message on 429. Both forms use an aria-live Alert + shouldFocusError.\",\n492\t      \"files\": [\n493\t        \"src/app/(auth)/layout.tsx\",\n494\t        \"src/app/(auth)/login/page.tsx\",\n495\t        \"src/app/(auth)/forgot-password/page.tsx\"\n496\t      ],\n497\t      \"dependencies\": [\n498\t        \"TASK-2\",\n499\t        \"TASK-8\",\n500\t        \"TASK-17\"\n501\t      ],\n502\t      \"estimateHours\": 3,\n503\t      \"requirementIds\": [\n504\t        \"FR-3\",\n505\t        \"FR-5\",\n506\t        \"FR-7\",\n507\t        \"FR-8\",\n508\t        \"FR-19\",\n509\t        \"FR-21\",\n510\t        \"FR-37\",\n511\t        \"NFR-5\",\n512\t        \"NFR-6\"\n513\t      ]\n514\t    },\n515\t    {\n516\t      \"id\": \"TASK-21\",\n517\t      \"description\": \"Invite + reset pages (C13). invite/[token]/page.tsx is a server component that calls verifyToken(token,'INVITE'). If it's invalid, show an Alert: 'This invitation link is invalid or has expired. Ask the school office to send a new one.' Otherwise render <SetPasswordForm> with the read-only name/email. Its onSubmit POSTs /api/auth/accept-invite, then calls signIn('credentials',{email,password,redirectTo:'/dashboard'}). reset-password/[token]/page.tsx verifies PASSWORD_RESET the same way ('This reset link is invalid or has expired.'). On submit it POSTs /api/auth/reset-password and then goes to /login?reset=1. A 410 response shows the same invalid Alert.\",\n518\t      \"files\": [\n519\t        \"src/app/(auth)/invite/[token]/page.tsx\",\n520\t        \"src/app/(auth)/reset-password/[token]/page.tsx\"\n521\t      ],\n522\t      \"dependencies\": [\n523\t        \"TASK-6\",\n524\t        \"TASK-17\",\n525\t        \"TASK-19\",\n526\t        \"TASK-20\"\n527\t      ],\n528\t      \"estimateHours\": 2,\n529\t      \"requirementIds\": [\n530\t        \"FR-14\",\n531\t        \"FR-15\",\n532\t        \"FR-16\",\n533\t        \"FR-21\"\n534\t      ]\n535\t    },\n536\t    {\n537\t      \"id\": \"TASK-22\",\n538\t      \"description\": \"App shell (C12). In (app)/layout.tsx, const user = await requirePageUser(), then pass user {id, firstName, lastName, email, role} and navigationForRole(user.role) as props to <AppShell>. Keep the existing schoolShortName prop. In shell.tsx, delete PLACEHOLDER_USER. Render the existing UserAvatar (initials), the full name and a role Chip from props. Add an 'Account security' menu item \\u2192 /account/security. Sign out calls signOut({redirectTo:'/login'}) from next-auth/react. There is no SessionProvider. Look up Menu, MenuItem and Chip through mui-mcp first.\",\n539\t      \"files\": [\n540\t        \"src/app/(app)/layout.tsx\",\n541\t        \"src/app/(app)/shell.tsx\"\n542\t      ],\n543\t      \"dependencies\": [\n544\t        \"TASK-11\"\n545\t      ],\n546\t      \"estimateHours\": 2,\n547\t      \"requirementIds\": [\n548\t        \"FR-24\",\n549\t        \"FR-32\",\n550\t        \"FR-33\",\n551\t        \"NFR-6\",\n552\t        \"NFR-7\"\n553\t      ]\n554\t    },\n555\t    {\n556\t      \"id\": \"TASK-23\",\n557\t      \"description\": \"Account security page (C13): await requirePageUser(). A client form with current, new and confirm password fields plus PasswordChecklist (react-hook-form + zodResolver changePasswordSchema, shouldFocusError, aria-live Alert). It POSTs /api/account/password. On 200, show the useToast 'Password updated' toast and reset the form. Map details.fieldErrors.currentPassword to that field via setError. Optionally show lastLoginAt with the existing DateDisplay in SchoolSettings.timezone.\",\n558\t      \"files\": [\n559\t        \"src/app/(app)/account/security/page.tsx\"\n560\t      ],\n561\t      \"dependencies\": [\n562\t        \"TASK-17\",\n563\t        \"TASK-19\",\n564\t        \"TASK-22\"\n565\t      ],\n566\t      \"estimateHours\": 1.5,\n567\t      \"requirementIds\": [\n568\t        \"FR-23\",\n569\t        \"NFR-5\",\n570\t        \"NFR-6\",\n571\t        \"NFR-7\",\n572\t        \"NFR-12\"\n573\t      ]\n574\t    },\n575\t    {\n576\t      \"id\": \"TASK-24\",\n577\t      \"description\": \"Seed (C14). Upsert by email, so re-running the seed is safe: admin@, teacher@, teacher2@, student@, student2@ and parent@schoolhub.test, all ACTIVE, with passwordHash bcrypt.hash('SchoolHub123!',12) and passwordChangedAt now. Upsert invited@schoolhub.test as INVITED, then call createInviteToken and log the link with logger.info. Keep the office@ and SchoolSettings seeding unchanged. Importing from src/ runs src/lib/env.ts validation, so make sure `npm run db:seed` loads .env (e.g. `tsx --env-file=.env` or import 'dotenv/config' if it's already installed). Don't add a new dependency.\",\n578\t      \"files\": [\n579\t        \"prisma/seed.ts\"\n580\t      ],\n581\t      \"dependencies\": [\n582\t        \"TASK-1\",\n583\t        \"TASK-18\"\n584\t      ],\n585\t      \"estimateHours\": 1,\n586\t      \"requirementIds\": [\n587\t        \"FR-35\",\n588\t        \"FR-13\"\n589\t      ]\n590\t    },\n591\t    {\n592\t      \"id\": \"TASK-25\",\n593\t      \"description\": \"Integration tests (C15), run against DATABASE_URL (docker-compose Postgres). Extend vitest.config.ts to include tests/integration/**/*.test.ts with environment 'node' for that folder (environmentMatchGlobs). Keep the unit tests on jsdom. auth-credentials.test.ts covers every authorizeCredentials branch: invalid, unknown user (the compare still runs), disabled, invited, archived, locked with minutes, 5th failure locks, rate_limited after 10, and success resets the count + sets lastLoginAt. Call __resetRateLimits between tests. auth-services.test.ts covers acceptInvite (activates, consumes, a second use \\u2192 INVALID_TOKEN), verifyToken expired/used/wrong-type branches, createToken invalidating older tokens, requestPasswordReset (unknown email \\u2192 no row; the 4th request per email is silent), resetPassword (clears the lockout), changePassword (wrong current \\u2192 fieldErrors.currentPassword), and that no AuditLog.metadata contains a password, hash or raw token.\",\n594\t      \"files\": [\n595\t        \"vitest.config.ts\",\n596\t        \"tests/integration/auth-credentials.test.ts\",\n597\t        \"tests/integration/auth-services.test.ts\"\n598\t      ],\n599\t      \"dependencies\": [\n600\t        \"TASK-7\",\n601\t        \"TASK-16\",\n602\t        \"TASK-18\"\n603\t      ],\n604\t      \"estimateHours\": 3,\n605\t      \"requirementIds\": [\n606\t        \"FR-36\",\n607\t        \"FR-4\",\n608\t        \"FR-6\",\n609\t        \"FR-13\",\n610\t        \"FR-31\",\n611\t        \"NFR-3\"\n612\t      ]\n613\t    },\n614\t    {\n615\t      \"id\": \"TASK-26\",\n616\t      \"description\": \"Playwright (C15). helpers/auth.ts has signIn(page, email, password='SchoolHub123!') and createResetLink(email), which calls createToken through the app modules because the raw token can't be recovered from the DB. auth.spec.ts covers: unauthenticated /dashboard \\u2192 /login?callbackUrl; sign in as admin@ \\u2192 shell shows the name/role; sign out \\u2192 /login; a wrong password shows 'Email or password is incorrect.'; forgot \\u2192 reset \\u2192 /login?reset=1 toast \\u2192 sign in with the new password; and @axe-core/playwright with zero serious/critical violations on /login, /forgot-password and the invite/reset pages. Update dashboard.spec.ts to sign in first, because /dashboard now redirects unauthenticated visitors.\",\n617\t      \"files\": [\n618\t        \"tests/e2e/helpers/auth.ts\",\n619\t        \"tests/e2e/auth.spec.ts\",\n620\t        \"tests/e2e/dashboard.spec.ts\"\n621\t      ],\n622\t      \"dependencies\": [\n623\t        \"TASK-20\",\n624\t        \"TASK-21\",\n625\t        \"TASK-22\",\n626\t        \"TASK-24\"\n627\t      ],\n628\t      \"estimateHours\": 3,\n629\t      \"requirementIds\": [\n630\t        \"FR-36\",\n631\t        \"FR-3\",\n632\t        \"FR-5\",\n633\t        \"FR-21\",\n634\t        \"FR-32\",\n635\t        \"NFR-5\"\n636\t      ]\n637\t    }\n638\t  ],\n639\t  \"fileStructure\": {\n640\t    \"./\": [\n641\t      \".eslintrc.json\",\n642\t      \"package.json\",\n643\t      \"vitest.config.ts\"\n644\t    ],\n645\t    \"prisma/\": [\n646\t      \"schema.prisma\",\n647\t      \"seed.ts\"\n648\t    ],\n649\t    \"prisma/migrations/20261104000000_auth_reconcile/\": [\n650\t      \"migration.sql\"\n651\t    ],\n652\t    \"src/\": [\n653\t      \"middleware.ts\"\n654\t    ],\n655\t    \"src/app/(app)/\": [\n656\t      \"layout.tsx\",\n657\t      \"shell.tsx\"\n658\t    ],\n659\t    \"src/app/(app)/account/security/\": [\n660\t      \"page.tsx\"\n661\t    ],\n662\t    \"src/app/(app)/admin/courses/\": [\n663\t      \"page.tsx\"\n664\t    ],\n665\t    \"src/app/(app)/admin/courses/[id]/enrollment/\": [\n666\t      \"page.tsx\"\n667\t    ],\n668\t    \"src/app/(app)/admin/sections/\": [\n669\t      \"page.tsx\"\n670\t    ],\n671\t    \"src/app/(app)/admin/sections/[id]/\": [\n672\t      \"page.tsx\"\n673\t    ],\n674\t    \"src/app/(app)/courses/[courseId]/\": [\n675\t      \"layout.tsx\"\n676\t    ],\n677\t    \"src/app/(app)/courses/[courseId]/roster/\": [\n678\t      \"page.tsx\"\n679\t    ],\n680\t    \"src/app/(app)/my-courses/\": [\n681\t      \"page.tsx\"\n682\t    ],\n683\t    \"src/app/(app)/students/[id]/courses/\": [\n684\t      \"page.tsx\"\n685\t    ],\n686\t    \"src/app/(auth)/\": [\