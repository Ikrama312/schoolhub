{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WLf8y76Z8pnSAX2NthoNHV","type":"tool_result","content":"1\texport interface DateRange {\n2\t  startDate: Date;\n3\t  endDate: Date;\n4\t}\n5\t\n6\t/** True when two inclusive date ranges share at least one day. */\n7\texport function rangesOverlap(a: DateRange, b: DateRange): boolean {\n8\t  return a.startDate <= b.endDate && b.startDate <= a.endDate;\n9\t}\n10\t\n11\t/** True when `inner` falls entirely inside `outer` (inclusive on both ends). */\n12\texport function rangeContains(outer: DateRange, inner: DateRange): boolean {\n13\t  return inner.startDate >= outer.startDate && inner.endDate <= outer.endDate;\n14\t}\n15\t"}]},"parent_tool_use_id":null,"session_id":"b784be86-9b15-4d20-b52f-af56b319547e","uuid":"7220408f-0c33-4d4d-bb8a-c1d150a9484d","timestamp":"2026-10-19T08:45:00.617Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/services/dateRange.ts","content":"export interface DateRange {\n  startDate: Date;\n  endDate: Date;\n}\n\n/** True when two inclusive date ranges share at least one day. */\nexport function rangesOverlap(a: DateRange, b: DateRange): boolean {\n  return a.startDate <= b.endDate && b.startDate <= a.endDate;\n}\n\n/** True when `inner` falls entirely inside `outer` (inclusive on both ends). */\nexport function rangeContains(outer: DateRange, inner: DateRange): boolean {\n  return inner.startDate >= outer.startDate && inner.endDate <= outer.endDate;\n}\n","numLines":15,"startLine":1,"totalLines":15}}}
