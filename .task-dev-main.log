{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgBP5ZTRkRyertjniWDp6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0183ywQE4FDytQZJ29mhkQZP","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/services/userLinks.ts","content":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { GuardianRelationship } from '@prisma/client';\n\nconst MAX_PARENTS_PER_STUDENT = 4;\n\nexport interface LinkParentToStudentInput {\n  studentId: string;\n  parentId: string;\n  relationship: GuardianRelationship;\n  isPrimary: boolean;\n}\n\n/**\n * The one writer of ParentStudentLink rows (FR-15/FR-16), called from the\n * student form, the parent form and the student-detail \"Family\" card alike\n * so the two invariants below are enforced exactly once:\n * - a student may have at most 4 linked parents\n * - at most one link per student is isPrimary (setting one clears the rest)\n */\nexport async function linkParentToStudent(input: LinkParentToStudentInput) {\n  return prisma.$transaction(async (tx) => {\n    const existingCount = await tx.parentStudentLink.count({ where: { studentId: input.studentId } });\n    if (existingCount >= MAX_PARENTS_PER_STUDENT) {\n      throw new AppError('VALIDATION_ERROR', `A student can have at most ${MAX_PARENTS_PER_STUDENT} linked parents.`);\n    }\n\n    if (input.isPrimary) {\n      await tx.parentStudentLink.updateMany({\n        where: { studentId: input.studentId },\n        data: { isPrimary: false },\n      });\n    }\n\n    return tx.parentStudentLink.create({\n      data: {\n        studentId: input.studentId,\n        parentId: input.parentId,\n        relationship: input.relationship,\n        isPrimary: input.isPrimary,\n      },\n    });\n  });\n}\n\nexport async function unlinkParentFromStudent(studentId: string, parentId: string) {\n  return prisma.parentStudentLink.deleteMany({ where: { studentId, parentId } });\n}\n\nexport async function listLinksForStudent(studentId: string) {\n  return prisma.parentStudentLink.findMany({\n    where: { studentId },\n    include: { parent: { select: { id: true, firstName: true, lastName: true } } },\n  });\n}\n\nexport async function listLinksForParent(parentId: string) {\n  return prisma.parentStudentLink.findMany({\n    where: { parentId },\n    include: { student: { select: { id: true, firstName: true, lastName: true } } },\n  });\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7519,"cache_read_input_tokens":120401,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7519},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"58cb2461-07a2-4908-85eb-953f83a6620f","uuid":"af40e5f0-45fe-4459-96d2-1d29b4ee99fa","timestamp":"2026-10-19T09:45:29.675Z","request_id":"req_011CgBP5YfJsqFuKTY8kJB4q"}
