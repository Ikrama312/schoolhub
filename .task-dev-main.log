er: 'list',\n  use: {\n    baseURL: process.env.APP_URL ?? 'http://localhost:3000',\n  },\n  webServer: {\n    command: 'npm run start',\n    url: process.env.APP_URL ?? 'http://localhost:3000',\n    reuseExistingServer: !process.env.CI,\n    timeout: 60_000,\n  },\n});\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\n\nexport default function DashboardPage() {\n  return (\n    <div>\n      <PageHeader title=\"Welcome to SchoolHub\" />\n      <EmptyState\n        title=\"Dashboards arrive in a later release\"\n        description=\"This space will show your personalized overview once dashboard PRDs land.\"\n      />\n    </div>\n  );\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\n\nexport interface SubjectInput {\n  name: string;\n  code: string;\n  description?: string | null;\n  color: string;\n}\n\nexport interface UpdateSubjectInput extends Partial<SubjectInput> {\n  archived?: boolean;\n}\n\n/** Codes are always stored upper-case so \"math\" and \"MATH\" collide. */\nexport function normalizeCode(code: string): string {\n  return code.trim().toUpperCase();\n}\n\nasync function assertCodeAvailable(code: string, excludeId?: string) {\n  const existing = await prisma.subject.findUnique({ where: { code } });\n  if (existing && existing.id !== excludeId) {\n    throw new AppError('CONFLICT', `Code already used by ${existing.name}.`);\n  }\n}\n\nexport async function listSubjects(q?: string) {\n  return prisma.subject.findMany({\n    where: q\n      ? { OR: [{ name: { contains: q, mode: 'insensitive' } }, { code: { contains: normalizeCode(q) } }] }\n      : undefined,\n    orderBy: { name: 'asc' },\n  });\n}\n\nexport async function createSubject(input: SubjectInput) {\n  const code = normalizeCode(input.code);\n  await assertCodeAvailable(code);\n  return prisma.subject.create({ data: { ...input, code } });\n}\n\nexport async function updateSubject(id: string, input: UpdateSubjectInput) {\n  const existing = await prisma.subject.findUniqueOrThrow({ where: { id } });\n  const code = input.code ? normalizeCode(input.code) : existing.code;\n  if (code !== existing.code) {\n    await assertCodeAvailable(code, id);\n  }\n  return prisma.subject.update({\n    where: { id },\n    data: {\n      name: input.name ?? existing.name,\n      code,\n      description: input.description === undefined ? existing.description : input.description,\n      color: input.color ?? existing.color,\n      archivedAt: input.archived === undefined ? existing.archivedAt : input.archived ? new Date() : null,\n    },\n  });\n}\n{\n  \"root\": true,\n  \"extends\": [\"next/core-web-vitals\", \"plugin:@typescript-eslint/recommended\"],\n  \"parser\": \"@typescript-eslint/parser\",\n  \"rules\": {\n    \"no-restricted-imports\": [\n      \"error\",\n      {\n        \"paths\": [\n          { \"name\": \"tailwindcss\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"name\": \"lucide-react\", \"message\": \"Use @mui/icons-material instead.\" },\n          { \"name\": \"next-themes\", \"message\": \"Use MUI cssVariables colorSchemes + useColorScheme() instead.\" },\n          { \"name\": \"@tanstack/react-table\", \"message\": \"Use the shared DataTable (MUI X DataGrid) instead.\" },\n          { \"name\": \"recharts\", \"message\": \"Use @mui/x-charts instead.\" },\n          { \"name\": \"react-select\", \"message\": \"Use MUI Autocomplete instead.\" },\n          { \"name\": \"react-datepicker\", \"message\": \"Use @mui/x-date-pickers instead.\" },\n          { \"name\": \"sonner\", \"message\": \"Use the shared useToast()/ToastProvider instead.\" },\n          { \"name\": \"notistack\", \"message\": \"Use the shared useToast()/ToastProvider instead.\" },\n          { \"name\": \"antd\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"name\": \"react-bootstrap\", \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" }\n        ],\n        \"patterns\": [\n          { \"group\": [\"@radix-ui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"group\": [\"@headlessui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" },\n          { \"group\": [\"@fullcalendar/*\"], \"message\": \"Use @mui/x-scheduler (later PRD) instead.\" },\n          { \"group\": [\"@chakra-ui/*\"], \"message\": \"MUI is the only permitted UI/styling library (ADR-5).\" }\n        ]\n      }\n    ]\n  },\n  \"overrides\": [\n    {\n      \"files\": [\"src/server/email/templates/**\"],\n      \"rules\": {\n        \"no-restricted-imports\": \"off\"\n      }\n    }\n  ]\n}\n.\n..\n.claude\n.env\n.env.example\n.eslintrc.json\n.forge\n.next\n.pdlc\n.prettierrc.json\n.task-arch-api-contracts.log\n.task-arch-api-contracts.md\n.task-arch-design-system.log\n.task-arch-design-system.md\n.task-arch-research-reqs.log\n.task-arch-research-reqs.md\n.task-arch-research-stack.log\n.task-arch-research-stack.md\n.task-dev-main.log\n.task-dev-main.md\n.task-dev-planning-main.log\n.task-dev-planning-main.md\n.task-intake-main.log\n.task-intake-main.md\n00-foundation.md\n01-auth-rbac.md\n02-academic-structure.md\n03-user-management.md\n04-notifications.md\n05-classes-enrollment.md\n06-timetable.md\n07-attendance.md\n08-course-content.md\n09-assignments.md\n10-quizzes.md\n11-gradebook.md\n12-announcements.md\n13-messaging.md\n14-calendar.md\n15-parent-portal.md\n16-dashboards.md\n17-fees.md\n18-public-site-admissions.md\nartifacts\ndocker-compose.yml\nKNOWLEDGE.md\nnext-env.d.ts\nnext.config.js\nnode_modules\npackage-lock.json\npackage.json\nplaywright.config.ts\nprisma\npublic\nREADME.md\nrun.sh\nsrc\ntests\ntsconfig.json\ntsconfig.tsbuildinfo\nvitest.config.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WGsoeXUqXnzqVFvQ7WDeG1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
