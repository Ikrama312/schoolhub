{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017a9ec7KRFtKMJnJtkL3WU1","type":"tool_result","content":"=== package.json ===\n{\n  \"name\": \"schoolhub\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"engines\": {\n    \"node\": \">=18.18.0\"\n  },\n  \"scripts\": {\n    \"dev\": \"next dev\",\n    \"build\": \"next build\",\n    \"start\": \"next start\",\n    \"lint\": \"next lint\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\",\n    \"test:e2e\": \"playwright test\",\n    \"db:migrate\": \"prisma migrate dev\",\n    \"db:deploy\": \"prisma migrate deploy\",\n    \"db:seed\": \"tsx prisma/seed.ts\",\n    \"db:reset\": \"prisma migrate reset --force\",\n    \"worker:email\": \"tsx scripts/worker-email.ts\",\n    \"format\": \"prettier --write .\"\n  },\n  \"dependencies\": {\n    \"@emotion/react\": \"11.13.3\",\n    \"@emotion/styled\": \"11.13.0\",\n    \"@hookform/resolvers\": \"3.9.0\",\n    \"@mui/icons-material\": \"9.5.0\",\n    \"@mui/material\": \"9.5.0\",\n    \"@mui/material-nextjs\": \"9.5.0\",\n    \"@mui/x-charts\": \"9.5.0\",\n    \"@mui/x-data-grid\": \"9.5.0\",\n    \"@mui/x-date-pickers\": \"9.5.0\",\n    \"@prisma/client\": \"5.20.0\",\n    \"@react-email/components\": \"0.0.25\",\n    \"@react-email/render\": \"1.0.1\",\n    \"bcrypt\": \"^6.0.0\",\n    \"date-fns\": \"3.6.0\",\n    \"date-fns-tz\": \"3.2.0\",\n    \"next\": \"14.2.18\",\n    \"next-auth\": \"^5.0.0-beta.25\",\n    \"nodemailer\": \"^6.9.14\",\n    \"papaparse\": \"^5.4.1\",\n    \"react\": \"18.3.1\",\n    \"react-dom\": \"18.3.1\",\n    \"react-hook-form\": \"7.53.0\",\n    \"react-is\": \"18.3.1\",\n    \"zod\": \"3.23.8\"\n  },\n  \"devDependencies\": {\n    \"@axe-core/playwright\": \"4.10.0\",\n    \"@playwright/test\": \"1.47.2\",\n    \"@testing-library/jest-dom\": \"6.5.0\",\n    \"@testing-library/react\": \"16.0.1\",\n    \"@testing-library/user-event\": \"14.5.2\",\n    \"@types/bcrypt\": \"^6.0.0\",\n    \"@types/node\": \"20.14.10\",\n    \"@types/nodemailer\": \"^6.4.15\",\n    \"@types/papaparse\": \"^5.3.14\",\n    \"@types/react\": \"18.3.3\",\n    \"@types/react-dom\": \"18.3.0\",\n    \"@typescript-eslint/eslint-plugin\": \"7.16.1\",\n    \"@typescript-eslint/parser\": \"7.16.1\",\n    \"@vitejs/plugin-react\": \"4.3.1\",\n    \"eslint\": \"8.57.0\",\n    \"eslint-config-next\": \"14.2.18\",\n    \"jsdom\": \"25.0.0\",\n    \"prettier\": \"3.3.3\",\n    \"prisma\": \"5.20.0\",\n    \"tsx\": \"4.16.2\",\n    \"typescript\": \"5.5.4\",\n    \"vitest\": \"2.1.1\"\n  },\n  \"overrides\": {\n    \"react-is\": \"18.3.1\"\n  }\n}\n=== .env.example ===\n# Postgres connection string used by Prisma. Matches docker-compose.yml's\n# schoolhub/schoolhub/schoolhub db/user/password on localhost:5432.\nDATABASE_URL=\"postgresql://schoolhub:schoolhub@localhost:5432/schoolhub?schema=public\"\n\n# Public base URL of the app (used for absolute links, e.g. in emails later).\nAPP_URL=\"http://localhost:3000\"\n\n# Secret used to sign auth sessions (wired up by a later PRD). Generate with\n# `openssl rand -base64 32` for real environments.\nAUTH_SECRET=\"dev-secret-change-me\"\n\n# Standard Node environment flag. One of: development | test | production.\nNODE_ENV=\"development\"\n\n# Outbound email (PRD-04). \"console\" (default) logs subject/recipient/text\n# instead of sending — fine for dev/test. Switch to \"smtp\" and fill in the\n# SMTP_* vars below for a real mail server.\nEMAIL_TRANSPORT=\"console\"\nSMTP_HOST=\"\"\nSMTP_PORT=\"587\"\nSMTP_USER=\"\"\nSMTP_PASS=\"\"\nSMTP_SECURE=\"false\"\nEMAIL_FROM=\"SchoolHub <no-reply@schoolhub.test>\"\n\n# Bearer token POST /api/internal/email/dispatch requires in its\n# Authorization header. Generate with `openssl rand -base64 32` for real\n# environments.\nCRON_SECRET=\"dev-secret-change-me\"\n=== prisma/schema.prisma ===\ngenerator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\nenum Gender {\n  FEMALE\n  MALE\n  OTHER\n  UNDISCLOSED\n}\n\nenum GuardianRelationship {\n  MOTHER\n  FATHER\n  GUARDIAN\n  GRANDPARENT\n  OTHER\n}\n\nenum EmailStatus {\n  PENDING\n  SENDING\n  SENT\n  FAILED\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n/// field shared by every role, archivedAt backs FR-13's archive/restore\n/// (separate from status so a DISABLED-but-not-archived user stays distinct\n/// from an archived one).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  phone             String?\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  archivedAt        DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n  studentProfile    StudentProfile?\n  teacherProfile    TeacherProfile?\n  parentProfile     ParentProfile?\n  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")\n  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")\n  notifications               Notification[]\n  notificationPreferences     NotificationPreference[]\n\n  @@index([lastName, firstName, email])\n}\n\n/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n/// only -- enforced in the service layer (src/server/services/users.ts,\n/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\nmodel StudentProfile {\n  userId           String     @id\n  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  admissionNumber  String     @unique\n  dateOfBirth      DateTime   @db.Date\n  gender           Gender     @default(UNDISCLOSED)\n  gradeLevelId     String\n  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n  enrollmentDate   DateTime   @db.Date\n  addressLine1     String?\n  city             String?\n  medicalNotes     String?\n  emergencyContact String?\n  emergencyPhone   String?\n}\n\n/// Teacher-specific fields (FR-1).\nmodel TeacherProfile {\n  userId         String    @id\n  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  employeeNumber String    @unique\n  title          String?\n  qualifications String?\n  hireDate       DateTime? @db.Date\n}\n\n/// Parent-specific fields (FR-1).\nmodel ParentProfile {\n  userId     String  @id\n  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  occupation String?\n  address    String?\n}\n\n/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n/// transaction invariants rather than DB constraints.\nmodel ParentStudentLink {\n  id           String               @id @default(cuid())\n  parentId     String\n  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n  studentId    String\n  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n  relationship GuardianRelationship\n  isPrimary    Boolean              @default(false)\n  createdAt    DateTime             @default(now())\n\n  @@unique([parentId, studentId])\n  @@index([studentId])\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id              String           @id @default(cuid())\n  name            String           @unique\n  shortName       String           @unique\n  order           Int              @unique\n  archivedAt      DateTime?\n  createdAt       DateTime         @default(now())\n  updatedAt       DateTime         @updatedAt\n  studentProfiles StudentProfile[]\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n\n/// In-app notification (PRD-04 FR-1). type is a key from the compile-time\n/// registry (src/server/notifications/types.ts) rather than an enum/FK, so\n/// later PRDs register new keys without a migration. category is resolved\n/// from the registry at read time (src/server/notifications/list.ts), not\n/// stored here. The composite index backs both getUnreadCount() (NFR-3,\n/// <50ms) and listNotifications()'s own-rows-newest-first query.\nmodel Notification {\n  id        String    @id @default(cuid())\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  title     String\n  body      String?\n  link      String?\n  readAt    DateTime?\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n\n  @@index([userId, readAt, createdAt])\n}\n\n/// Per-user, per-type override of the registry's defaultEmail/mandatoryInApp\n/// defaults (PRD-04 FR-3). Composite PK instead of a surrogate id/unique\n/// index -- there is exactly one row per (userId, type) by construction\n/// (notify.ts and the preferences PUT route both upsert on it).\nmodel NotificationPreference {\n  userId    String\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  inApp     Boolean  @default(true)\n  email     Boolean  @default(true)\n  updatedAt DateTime @updatedAt\n\n  @@id([userId, type])\n}\n\n/// Durable outbox row the dispatcher claims and sends (PRD-04 FR-1/FR-5).\n/// No FK to User -- toEmail/toName are a point-in-time snapshot (matches\n/// the PRD's schema block exactly) so a later email change or user deletion\n/// never blocks a queued send. updatedAt doubles as the \"flipped to\n/// SENDING\" timestamp the >10-minute stuck-row recovery checks (NFR-4) --\n/// Prisma's @updatedAt already bumps it on that status-flip UPDATE, so no\n/// separate column is needed.\nmodel EmailOutbox {\n  id            String      @id @default(cuid())\n  toEmail       String\n  toName        String?\n  subject       String\n  html          String\n  text          String\n  status        EmailStatus @default(PENDING)\n  attempts      Int         @default(0)\n  lastError     String?\n  nextAttemptAt DateTime    @default(now())\n  sentAt        DateTime?\n  createdAt     DateTime    @default(now())\n  updatedAt     DateTime    @updatedAt\n\n  @@index([status, nextAttemptAt])\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"26ce942b-d6a7-4ab5-ac09-e89a7a8e3024","uuid":"9230c56a-5908-420c-a862-ce68ad75e202","timestamp":"2026-10-20T07:00:55.641Z","tool_use_result":{"stdout":"=== package.json ===\n{\n  \"name\": \"schoolhub\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"engines\": {\n    \"node\": \">=18.18.0\"\n  },\n  \"scripts\": {\n    \"dev\": \"next dev\",\n    \"build\": \"next build\",\n    \"start\": \"next start\",\n    \"lint\": \"next lint\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\",\n    \"test:e2e\": \"playwright test\",\n    \"db:migrate\": \"prisma migrate dev\",\n    \"db:deploy\": \"prisma migrate deploy\",\n    \"db:seed\": \"tsx prisma/seed.ts\",\n    \"db:reset\": \"prisma migrate reset --force\",\n    \"worker:email\": \"tsx scripts/worker-email.ts\",\n    \"format\": \"prettier --write .\"\n  },\n  \"dependencies\": {\n    \"@emotion/react\": \"11.13.3\",\n    \"@emotion/styled\": \"11.13.0\",\n    \"@hookform/resolvers\": \"3.9.0\",\n    \"@mui/icons-material\": \"9.5.0\",\n    \"@mui/material\": \"9.5.0\",\n    \"@mui/material-nextjs\": \"9.5.0\",\n    \"@mui/x-charts\": \"9.5.0\",\n    \"@mui/x-data-grid\": \"9.5.0\",\n    \"@mui/x-date-pickers\": \"9.5.0\",\n    \"@prisma/client\": \"5.20.0\",\n    \"@react-email/components\": \"0.0.25\",\n    \"@react-email/render\": \"1.0.1\",\n    \"bcrypt\": \"^6.0.0\",\n    \"date-fns\": \"3.6.0\",\n    \"date-fns-tz\": \"3.2.0\",\n    \"next\": \"14.2.18\",\n    \"next-auth\": \"^5.0.0-beta.25\",\n    \"nodemailer\": \"^6.9.14\",\n    \"papaparse\": \"^5.4.1\",\n    \"react\": \"18.3.1\",\n    \"react-dom\": \"18.3.1\",\n    \"react-hook-form\": \"7.53.0\",\n    \"react-is\": \"18.3.1\",\n    \"zod\": \"3.23.8\"\n  },\n  \"devDependencies\": {\n    \"@axe-core/playwright\": \"4.10.0\",\n    \"@playwright/test\": \"1.47.2\",\n    \"@testing-library/jest-dom\": \"6.5.0\",\n    \"@testing-library/react\": \"16.0.1\",\n    \"@testing-library/user-event\": \"14.5.2\",\n    \"@types/bcrypt\": \"^6.0.0\",\n    \"@types/node\": \"20.14.10\",\n    \"@types/nodemailer\": \"^6.4.15\",\n    \"@types/papaparse\": \"^5.3.14\",\n    \"@types/react\": \"18.3.3\",\n    \"@types/react-dom\": \"18.3.0\",\n    \"@typescript-eslint/eslint-plugin\": \"7.16.1\",\n    \"@typescript-eslint/parser\": \"7.16.1\",\n    \"@vitejs/plugin-react\": \"4.3.1\",\n    \"eslint\": \"8.57.0\",\n    \"eslint-config-next\": \"14.2.18\",\n    \"jsdom\": \"25.0.0\",\n    \"prettier\": \"3.3.3\",\n    \"prisma\": \"5.20.0\",\n    \"tsx\": \"4.16.2\",\n    \"typescript\": \"5.5.4\",\n    \"vitest\": \"2.1.1\"\n  },\n  \"overrides\": {\n    \"react-is\": \"18.3.1\"\n  }\n}\n=== .env.example ===\n# Postgres connection string used by Prisma. Matches docker-compose.yml's\n# schoolhub/schoolhub/schoolhub db/user/password on localhost:5432.\nDATABASE_URL=\"postgresql://schoolhub:schoolhub@localhost:5432/schoolhub?schema=public\"\n\n# Public base URL of the app (used for absolute links, e.g. in emails later).\nAPP_URL=\"http://localhost:3000\"\n\n# Secret used to sign auth sessions (wired up by a later PRD). Generate with\n# `openssl rand -base64 32` for real environments.\nAUTH_SECRET=\"dev-secret-change-me\"\n\n# Standard Node environment flag. One of: development | test | production.\nNODE_ENV=\"development\"\n\n# Outbound email (PRD-04). \"console\" (default) logs subject/recipient/text\n# instead of sending — fine for dev/test. Switch to \"smtp\" and fill in the\n# SMTP_* vars below for a real mail server.\nEMAIL_TRANSPORT=\"console\"\nSMTP_HOST=\"\"\nSMTP_PORT=\"587\"\nSMTP_USER=\"\"\nSMTP_PASS=\"\"\nSMTP_SECURE=\"false\"\nEMAIL_FROM=\"SchoolHub <no-reply@schoolhub.test>\"\n\n# Bearer token POST /api/internal/email/dispatch requires in its\n# Authorization header. Generate with `openssl rand -base64 32` for real\n# environments.\nCRON_SECRET=\"dev-secret-change-me\"\n=== prisma/schema.prisma ===\ngenerator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\nenum Gender {\n  FEMALE\n  MALE\n  OTHER\n  UNDISCLOSED\n}\n\nenum GuardianRelationship {\n  MOTHER\n  FATHER\n  GUARDIAN\n  GRANDPARENT\n  OTHER\n}\n\nenum EmailStatus {\n  PENDING\n  SENDING\n  SENT\n  FAILED\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n/// field shared by every role, archivedAt backs FR-13's archive/restore\n/// (separate from status so a DISABLED-but-not-archived user stays distinct\n/// from an archived one).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  phone             String?\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  archivedAt        DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n  studentProfile    StudentProfile?\n  teacherProfile    TeacherProfile?\n  parentProfile     ParentProfile?\n  parentLinks       ParentStudentLink[] @relation(\"ParentLinks\")\n  studentLinks      ParentStudentLink[] @relation(\"StudentLinks\")\n  notifications               Notification[]\n  notificationPreferences     NotificationPreference[]\n\n  @@index([lastName, firstName, email])\n}\n\n/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n/// only -- enforced in the service layer (src/server/services/users.ts,\n/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\nmodel StudentProfile {\n  userId           String     @id\n  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  admissionNumber  String     @unique\n  dateOfBirth      DateTime   @db.Date\n  gender           Gender     @default(UNDISCLOSED)\n  gradeLevelId     String\n  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n  enrollmentDate   DateTime   @db.Date\n  addressLine1     String?\n  city             String?\n  medicalNotes     String?\n  emergencyContact String?\n  emergencyPhone   String?\n}\n\n/// Teacher-specific fields (FR-1).\nmodel TeacherProfile {\n  userId         String    @id\n  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  employeeNumber String    @unique\n  title          String?\n  qualifications String?\n  hireDate       DateTime? @db.Date\n}\n\n/// Parent-specific fields (FR-1).\nmodel ParentProfile {\n  userId     String  @id\n  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  occupation String?\n  address    String?\n}\n\n/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n/// transaction invariants rather than DB constraints.\nmodel ParentStudentLink {\n  id           String               @id @default(cuid())\n  parentId     String\n  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n  studentId    String\n  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n  relationship GuardianRelationship\n  isPrimary    Boolean              @default(false)\n  createdAt    DateTime             @default(now())\n\n  @@unique([parentId, studentId])\n  @@index([studentId])\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id              String           @id @default(cuid())\n  name            String           @unique\n  shortName       String           @unique\n  order           Int              @unique\n  archivedAt      DateTime?\n  createdAt       DateTime         @default(now())\n  updatedAt       DateTime         @updatedAt\n  studentProfiles StudentProfile[]\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n\n/// In-app notification (PRD-04 FR-1). type is a key from the compile-time\n/// registry (src/server/notifications/types.ts) rather than an enum/FK, so\n/// later PRDs register new keys without a migration. category is resolved\n/// from the registry at read time (src/server/notifications/list.ts), not\n/// stored here. The composite index backs both getUnreadCount() (NFR-3,\n/// <50ms) and listNotifications()'s own-rows-newest-first query.\nmodel Notification {\n  id        String    @id @default(cuid())\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  title     String\n  body      String?\n  link      String?\n  readAt    DateTime?\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n\n  @@index([userId, readAt, createdAt])\n}\n\n/// Per-user, per-type override of the registry's defaultEmail/mandatoryInApp\n/// defaults (PRD-04 FR-3). Composite PK instead of a surrogate id/unique\n/// index -- there is exactly one row per (userId, type) by construction\n/// (notify.ts and the preferences PUT route both upsert on it).\nmodel NotificationPreference {\n  userId    String\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  inApp     Boolean  @default(true)\n  email     Boolean  @default(true)\n  updatedAt DateTime @updatedAt\n\n  @@id([userId, type])\n}\n\n/// Durable outbox row the dispatcher claims and sends (PRD-04 FR-1/FR-5).\n/// No FK to User -- toEmail/toName are a point-in-time snapshot (matches\n/// the PRD's schema block exactly) so a later email change or user deletion\n/// never blocks a queued send. updatedAt doubles as the \"flipped to\n/// SENDING\" timestamp the >10-minute stuck-row recovery checks (NFR-4) --\n/// Prisma's @updatedAt already bumps it on that status-flip UPDATE, so no\n/// separate column is needed.\nmodel EmailOutbox {\n  id            String      @id @default(cuid())\n  toEmail       String\n  toName        String?\n  subject       String\n  html          String\n  text          String\n  status        EmailStatus @default(PENDING)\n  attempts      Int         @default(0)\n  lastError     String?\n  nextAttemptAt DateTime    @default(now())\n  sentAt        DateTime?\n  createdAt     DateTime    @default(now())\n  updatedAt     DateTime    @updatedAt\n\n  @@index([status, nextAttemptAt])\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
