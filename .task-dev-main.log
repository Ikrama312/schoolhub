{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C8T2cdefkyh5vEQKvcRptU","type":"tool_result","content":"1\timport { prisma } from '@/server/db';\n2\t\n3\texport interface GradeLevelInput {\n4\t  name: string;\n5\t  shortName: string;\n6\t  order: number;\n7\t}\n8\t\n9\texport interface UpdateGradeLevelInput {\n10\t  name?: string;\n11\t  shortName?: string;\n12\t  order?: number;\n13\t  archived?: boolean;\n14\t}\n15\t\n16\texport async function listGradeLevels(includeArchived = false) {\n17\t  return prisma.gradeLevel.findMany({\n18\t    where: includeArchived ? undefined : { archivedAt: null },\n19\t    orderBy: { order: 'asc' },\n20\t  });\n21\t}\n22\t\n23\texport async function createGradeLevel(input: GradeLevelInput) {\n24\t  return prisma.gradeLevel.create({ data: input });\n25\t}\n26\t\n27\texport async function updateGradeLevel(id: string, input: UpdateGradeLevelInput) {\n28\t  return prisma.$transaction(async (tx) => {\n29\t    const existing = await tx.gradeLevel.findUniqueOrThrow({ where: { id } });\n30\t\n31\t    if (input.order !== undefined && input.order !== existing.order) {\n32\t      // Swap via a negative placeholder so the order-unique constraint never\n33\t      // collides with whichever record currently holds the target slot.\n34\t      const other = await tx.gradeLevel.findUnique({ where: { order: input.order } });\n35\t      if (other) {\n36\t        await tx.gradeLevel.update({ where: { id: other.id }, data: { order: -1 } });\n37\t        await tx.gradeLevel.update({ where: { id }, data: { order: input.order } });\n38\t        await tx.gradeLevel.update({ where: { id: other.id }, data: { order: existing.order } });\n39\t      } else {\n40\t        await tx.gradeLevel.update({ where: { id }, data: { order: input.order } });\n41\t      }\n42\t    }\n43\t\n44\t    return tx.gradeLevel.update({\n45\t      where: { id },\n46\t      data: {\n47\t        name: input.name ?? existing.name,\n48\t        shortName: input.shortName ?? existing.shortName,\n49\t        archivedAt: input.archived === undefined ? existing.archivedAt : input.archived ? new Date() : null,\n50\t      },\n51\t    });\n52\t  });\n53\t}\n54\t"}]},"parent_tool_use_id":null,"session_id":"58cb2461-07a2-4908-85eb-953f83a6620f","uuid":"3059e7ce-100b-405d-a49d-7be21330f7bd","timestamp":"2026-10-19T09:41:43.010Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/services/gradeLevels.ts","content":"import { prisma } from '@/server/db';\n\nexport interface GradeLevelInput {\n  name: string;\n  shortName: string;\n  order: number;\n}\n\nexport interface UpdateGradeLevelInput {\n  name?: string;\n  shortName?: string;\n  order?: number;\n  archived?: boolean;\n}\n\nexport async function listGradeLevels(includeArchived = false) {\n  return prisma.gradeLevel.findMany({\n    where: includeArchived ? undefined : { archivedAt: null },\n    orderBy: { order: 'asc' },\n  });\n}\n\nexport async function createGradeLevel(input: GradeLevelInput) {\n  return prisma.gradeLevel.create({ data: input });\n}\n\nexport async function updateGradeLevel(id: string, input: UpdateGradeLevelInput) {\n  return prisma.$transaction(async (tx) => {\n    const existing = await tx.gradeLevel.findUniqueOrThrow({ where: { id } });\n\n    if (input.order !== undefined && input.order !== existing.order) {\n      // Swap via a negative placeholder so the order-unique constraint never\n      // collides with whichever record currently holds the target slot.\n      const other = await tx.gradeLevel.findUnique({ where: { order: input.order } });\n      if (other) {\n        await tx.gradeLevel.update({ where: { id: other.id }, data: { order: -1 } });\n        await tx.gradeLevel.update({ where: { id }, data: { order: input.order } });\n        await tx.gradeLevel.update({ where: { id: other.id }, data: { order: existing.order } });\n      } else {\n        await tx.gradeLevel.update({ where: { id }, data: { order: input.order } });\n      }\n    }\n\n    return tx.gradeLevel.update({\n      where: { id },\n      data: {\n        name: input.name ?? existing.name,\n        shortName: input.shortName ?? existing.shortName,\n        archivedAt: input.archived === undefined ? existing.archivedAt : input.archived ? new Date() : null,\n      },\n    });\n  });\n}\n","numLines":54,"startLine":1,"totalLines":54}}}
