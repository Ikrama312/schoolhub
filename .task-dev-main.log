{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016Q5BjxL7EXmNUd3rhWrWP5","type":"tool_result","content":"1\t=== prisma/migrations/20261104000000_auth_reconcile/migration.sql\n2\t-- CreateIndex\n3\tCREATE INDEX \"AuditLog_entityType_entityId_idx\" ON \"AuditLog\"(\"entityType\", \"entityId\");\n4\t\n5\t-- CreateIndex\n6\tCREATE INDEX \"AuditLog_actorId_createdAt_idx\" ON \"AuditLog\"(\"actorId\", \"createdAt\");\n7\t=== src/lib/validators/auth.ts\n8\timport { z } from 'zod';\n9\t\n10\t/**\n11\t * Client-safe auth validators (FR-2, FR-8, FR-17). No fs / server imports:\n12\t * the login/invite/reset/security forms import this directly. The\n13\t * common-password rule and the real \"not your email\" check run server-side\n14\t * in src/server/auth/password-policy.ts (the API body doesn't carry the email).\n15\t */\n16\t\n17\texport const emailField = z.string().trim().toLowerCase().email('Enter a valid email address');\n18\t\n19\texport interface PasswordCheckResult {\n20\t  length: boolean;\n21\t  letter: boolean;\n22\t  digit: boolean;\n23\t  notEmail: boolean;\n24\t}\n25\t\n26\texport const PASSWORD_RULES: Record<keyof PasswordCheckResult, { label: string; error: string }> = {\n27\t  length: { label: '10 to 128 characters', error: 'Password must be 10 to 128 characters.' },\n28\t  letter: { label: 'At least one letter', error: 'Password must contain at least one letter.' },\n29\t  digit: { label: 'At least one number', error: 'Password must contain at least one number.' },\n30\t  notEmail: { label: 'Not the same as your email', error: 'Password must not be your email address.' },\n31\t};\n32\t\n33\texport function passwordChecks(password: string, email: string): PasswordCheckResult {\n34\t  return {\n35\t    length: password.length >= 10 && password.length <= 128,\n36\t    letter: /[A-Za-z]/.test(password),\n37\t    digit: /[0-9]/.test(password),\n38\t    notEmail: password.trim().toLowerCase() !== email.trim().toLowerCase(),\n39\t  };\n40\t}\n41\t\n42\t/** Error messages for every failing rule (empty when the password passes). */\n43\texport function passwordErrors(password: string, email: string): string[] {\n44\t  const checks = passwordChecks(password, email);\n45\t  return (Object.keys(checks) as (keyof PasswordCheckResult)[])\n46\t    .filter((key) => !checks[key])\n47\t    .map((key) => PASSWORD_RULES[key].error);\n48\t}\n49\t\n50\t/** FR-8: only same-origin relative paths; everything else falls back to /dashboard. */\n51\texport function safeCallbackUrl(url: string | null | undefined): string {\n52\t  if (!url || !url.startsWith('/') || url.startsWith('//') || url.startsWith('/\\\\')) return '/dashboard';\n53\t  return url;\n54\t}\n55\t\n56\texport const signInSchema = z.object({\n57\t  email: emailField,\n58\t  password: z.string().min(1, 'Enter your password'),\n59\t});\n60\t\n61\texport const forgotPasswordSchema = z.object({ email: emailField });\n62\t\n63\t/** superRefine: policy rules on `field` + confirm-equals. `email` is '' when unknown. */\n64\tfunction refineNewPassword(field: string, email = '') {\n65\t  return (value: Record<string, unknown>, ctx: z.RefinementCtx) => {\n66\t    const password = String(value[field] ?? '');\n67\t    for (const message of passwordErrors(password, email)) {\n68\t      ctx.addIssue({ code: z.ZodIssueCode.custom, path: [field], message });\n69\t    }\n70\t    if (password !== value.confirm) {\n71\t      ctx.addIssue({ code: z.ZodIssueCode.custom, path: ['confirm'], message: 'Passwords do not match.' });\n72\t    }\n73\t  };\n74\t}\n75\t\n76\tconst newPasswordShape = { password: z.string(), confirm: z.string() };\n77\t\n78\t/** Client form schema for SetPasswordForm (invite + reset); pass the known email. */\n79\texport function setPasswordSchema(email = '') {\n80\t  return z.object(newPasswordShape).superRefine(refineNewPassword('password', email));\n81\t}\n82\t\n83\texport const acceptInviteSchema = z\n84\t  .object({ token: z.string().min(1), ...newPasswordShape })\n85\t  .superRefine(refineNewPassword('password'));\n86\t\n87\texport const resetPasswordSchema = acceptInviteSchema;\n88\t\n89\texport function changePasswordFormSchema(email = '') {\n90\t  return z\n91\t    .object({\n92\t      currentPassword: z.string().min(1, 'Enter your current password'),\n93\t      newPassword: z.string(),\n94\t      confirm: z.string(),\n95\t    })\n96\t    .superRefine(refineNewPassword('newPassword', email));\n97\t}\n98\t\n99\texport const changePasswordSchema = changePasswordFormSchema();\n100\t\n101\texport type SignInInput = z.infer<typeof signInSchema>;\n102\texport type AcceptInviteInput = z.infer<typeof acceptInviteSchema>;\n103\texport type ResetPasswordInput = z.infer<typeof resetPasswordSchema>;\n104\texport type ChangePasswordInput = z.infer<typeof changePasswordSchema>;\n105\texport type SetPasswordValues = z.infer<ReturnType<typeof setPasswordSchema>>;\n106\t=== tests/unit/auth-validators.test.ts\n107\timport { describe, it, expect } from 'vitest';\n108\timport {\n109\t  passwordChecks,\n110\t  safeCallbackUrl,\n111\t  signInSchema,\n112\t  acceptInviteSchema,\n113\t  changePasswordSchema,\n114\t} from '@/lib/validators/auth';\n115\t\n116\tdescribe('passwordChecks', () => {\n117\t  it('passes a compliant password', () => {\n118\t    expect(passwordChecks('correcthorse9', 'a@b.test')).toEqual({ length: true, letter: true, digit: true, notEmail: true });\n119\t  });\n120\t\n121\t  it('enforces 10..128 length', () => {\n122\t    expect(passwordChecks('abc123456', 'x@y.z').length).toBe(false);\n123\t    expect(passwordChecks('abc1234567', 'x@y.z').length).toBe(true);\n124\t    expect(passwordChecks('a1'.repeat(64), 'x@y.z').length).toBe(true);\n125\t    expect(passwordChecks('a1'.repeat(64) + 'b', 'x@y.z').length).toBe(false);\n126\t  });\n127\t\n128\t  it('requires a letter and a digit', () => {\n129\t    expect(passwordChecks('1234567890', 'x@y.z').letter).toBe(false);\n130\t    expect(passwordChecks('abcdefghij', 'x@y.z').digit).toBe(false);\n131\t  });\n132\t\n133\t  it('rejects the email, case-insensitively', () => {\n134\t    expect(passwordChecks('Teacher1@School.test', 'teacher1@school.test').notEmail).toBe(false);\n135\t  });\n136\t});\n137\t\n138\tdescribe('safeCallbackUrl', () => {\n139\t  it('keeps relative paths', () => {\n140\t    expect(safeCallbackUrl('/courses/1?tab=roster')).toBe('/courses/1?tab=roster');\n141\t  });\n142\t\n143\t  it.each(['//evil.com', '/\\\\evil', 'https://evil.com', '', null, undefined, 'dashboard'])('rejects %s', (url) => {\n144\t    expect(safeCallbackUrl(url as string | null)).toBe('/dashboard');\n145\t  });\n146\t});\n147\t\n148\tdescribe('schemas', () => {\n149\t  it('trims and lower-cases the sign-in email', () => {\n150\t    expect(signInSchema.parse({ email: '  Admin@SchoolHub.TEST ', password: 'x' }).email).toBe('admin@schoolhub.test');\n151\t  });\n152\t\n153\t  it('flags a confirm mismatch and policy failures', () => {\n154\t    const result = acceptInviteSchema.safeParse({ token: 't', password: 'short', confirm: 'other' });\n155\t    expect(result.success).toBe(false);\n156\t    const fields = result.success ? {} : result.error.flatten().fieldErrors;\n157\t    expect(fields.password?.length).toBeGreaterThan(0);\n158\t    expect(fields.confirm).toEqual(['Passwords do not match.']);\n159\t  });\n160\t\n161\t  it('accepts a valid change-password body', () => {\n162\t    expect(\n163\t      changePasswordSchema.safeParse({ currentPassword: 'old', newPassword: 'newpassword42', confirm: 'newpassword42' }).success,\n164\t    ).toBe(true);\n165\t  });\n166\t});\n167\t=== src/server/auth/email.ts\n168\timport { env } from '@/lib/env';\n169\timport { logger } from '@/lib/logger';\n170\t\n171\texport type AuthEmailKind = 'invite' | 'password-reset';\n172\t\n173\tconst PATHS: Record<AuthEmailKind, string> = { invite: '/invite/', 'password-reset': '/reset-password/' };\n174\tconst SUBJECTS: Record<AuthEmailKind, string> = {\n175\t  invite: \"You're invited to SchoolHub\",\n176\t  'password-reset': 'Reset your SchoolHub password',\n177\t};\n178\t\n179\texport function authLink(kind: AuthEmailKind, rawToken: string): string {\n180\t  return new URL(PATHS[kind] + encodeURIComponent(rawToken), env.APP_URL).toString();\n181\t}\n182\t\n183\t/**\n184\t * FR-22 seam: logs the link instead of sending. PRD-04 replaces this body\n185\t * with an EmailOutbox enqueue. The raw token appears only here, never in audit.\n186\t */\n187\texport async function sendAuthEmail(\n188\t  user: { email: string; firstName?: string },\n189\t  kind: AuthEmailKind,\n190\t  link: string,\n191\t): Promise<void> {\n192\t  logger.info('Auth email', { to: user.email, subject: SUBJECTS[kind], link });\n193\t}\n194\t=== src/server/rate-limit.ts\n195\t// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\n196\tconst hits = new Map<string, number[]>();\n197\t\n198\t/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\n199\texport function rateLimit(\n200\t  key: string,\n201\t  limit: number,\n202\t  windowMs: number,\n203\t  now: number = Date.now(),\n204\t): { ok: boolean; retryAfterMs: number } {\n205\t  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n206\t  if (recent.length >= limit) {\n207\t    hits.set(key, recent);\n208\t    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n209\t  }\n210\t  recent.push(now);\n211\t  hits.set(key, recent);\n212\t  return { ok: true, retryAfterMs: 0 };\n213\t}\n214\t\n215\texport function __resetRateLimits(): void {\n216\t  hits.clear();\n217\t}\n218\t=== tests/unit/rate-limit.test.ts\n219\timport { describe, it, expect, beforeEach } from 'vitest';\n220\timport { rateLimit, __resetRateLimits } from '@/server/rate-limit';\n221\timport { getClientIp } from '@/server/http';\n222\t\n223\tdescribe('rateLimit', () => {\n224\t  beforeEach(() => __resetRateLimits());\n225\t\n226\t  it('allows up to the limit then blocks with retryAfterMs', () => {\n227\t    for (let i = 0; i < 3; i += 1) expect(rateLimit('k', 3, 1000, 100 + i).ok).toBe(true);\n228\t    const blocked = rateLimit('k', 3, 1000, 500);\n229\t    expect(blocked.ok).toBe(false);\n230\t    expect(blocked.retryAfterMs).toBe(600); // first hit at 100 expires at 1100\n231\t  });\n232\t\n233\t  it('slides the window', () => {\n234\t    rateLimit('k', 2, 1000, 0);\n235\t    rateLimit('k', 2, 1000, 500);\n236\t    expect(rateLimit('k', 2, 1000, 999).ok).toBe(false);\n237\t    expect(rateLimit('k', 2, 1000, 1001).ok).toBe(true); // hit at 0 aged out\n238\t  });\n239\t\n240\t  it('isolates keys', () => {\n241\t    rateLimit('a', 1, 1000, 0);\n242\t    expect(rateLimit('a', 1, 1000, 1).ok).toBe(false);\n243\t    expect(rateLimit('b', 1, 1000, 1).ok).toBe(true);\n244\t  });\n245\t});\n246\t\n247\tdescribe('getClientIp', () => {\n248\t  it('takes the first x-forwarded-for entry, trimmed', () => {\n249\t    expect(getClientIp(new Request('http://x', { headers: { 'x-forwarded-for': ' 1.2.3.4 , 10.0.0.1' } }))).toBe('1.2.3.4');\n250\t  });\n251\t\n252\t  it('returns null without the header', () => {\n253\t    expect(getClientIp(new Request('http://x'))).toBeNull();\n254\t  });\n255\t});\n256\t=== src/server/http.ts\n257\timport { NextResponse } from 'next/server';\n258\timport { Prisma } from '@prisma/client';\n259\timport { ZodError, type ZodTypeAny, type output } from 'zod';\n260\timport { logger } from '@/lib/logger';\n261\t\n262\t/**\n263\t * The one chokepoint every route handler goes through. Nothing here should\n264\t * be reimplemented per-route — new endpoints import from this module, they\n265\t * don't hand-roll envelopes, pagination clamping or error mapping.\n266\t */\n267\t\n268\texport type ApiErrorCode =\n269\t  | 'VALIDATION_ERROR'\n270\t  | 'NOT_FOUND'\n271\t  | 'CONFLICT'\n272\t  | 'INTERNAL'\n273\t  | 'RATE_LIMITED'\n274\t  | 'UNAUTHENTICATED'\n275\t  | 'FORBIDDEN'\n276\t  | 'INVALID_TOKEN';\n277\t\n278\tconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n279\t  VALIDATION_ERROR: 400,\n280\t  NOT_FOUND: 404,\n281\t  CONFLICT: 409,\n282\t  INTERNAL: 500,\n283\t  RATE_LIMITED: 429,\n284\t  UNAUTHENTICATED: 401,\n285\t  FORBIDDEN: 403,\n286\t  INVALID_TOKEN: 410,\n287\t};\n288\t\n289\t/** Throw this from a handler for a known, intentional failure. */\n290\texport class AppError extends Error {\n291\t  code: ApiErrorCode;\n292\t  details?: unknown;\n293\t\n294\t  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n295\t    super(message);\n296\t    this.code = code;\n297\t    this.details = details;\n298\t  }\n299\t}\n300\t\n301\texport function ok<T>(data: T, init?: ResponseInit) {\n302\t  return NextResponse.json({ data }, init);\n303\t}\n304\t\n305\texport function paginated<T>(\n306\t  data: T[],\n307\t  meta: { page: number; pageSize: number; total: number },\n308\t  init?: ResponseInit,\n309\t) {\n310\t  return NextResponse.json({ data, meta }, init);\n311\t}\n312\t\n313\texport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n314\t  return NextResponse.json(\n315\t    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n316\t    { status: ERROR_STATUS[code] },\n317\t  );\n318\t}\n319\t\n320\t/**\n321\t * Wraps a route handler, mapping thrown errors to the shared envelope:\n322\t * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n323\t * AppError -> its own code/status\n324\t * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n325\t * anything else -> INTERNAL (500), stack logged, never returned to client\n326\t */\n327\texport function withHandler<Args extends unknown[]>(\n328\t  fn: (...args: Args) => Promise<Response>,\n329\t) {\n330\t  return async (...args: Args): Promise<Response> => {\n331\t    try {\n332\t      return await fn(...args);\n333\t    } catch (error) {\n334\t      if (error instanceof ZodError) {\n335\t        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n336\t      }\n337\t\n338\t      if (error instanceof AppError) {\n339\t        return apiError(error.code, error.message, error.details);\n340\t      }\n341\t\n342\t      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n343\t        if (error.code === 'P2002') {\n344\t          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n345\t        }\n346\t        if (error.code === 'P2025') {\n347\t          return apiError('NOT_FOUND', 'Resource not found');\n348\t        }\n349\t      }\n350\t\n351\t      logger.error('Unhandled error in route handler', {\n352\t        message: error instanceof Error ? error.message : String(error),\n353\t        stack: error instanceof Error ? error.stack : undefined,\n354\t      });\n355\t      return apiError('INTERNAL', 'Internal server error');\n356\t    }\n357\t  };\n358\t}\n359\t\n360\texport interface PaginationParams {\n361\t  page: number;\n362\t  pageSize: number;\n363\t  skip: number;\n364\t  take: number;\n365\t}\n366\t\n367\tconst MAX_PAGE_SIZE = 100;\n368\t\n369\texport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n370\t  const rawPage = Number(searchParams.get('page'));\n371\t  const rawPageSize = Number(searchParams.get('pageSize'));\n372\t\n373\t  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n374\t  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n375\t  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n376\t\n377\t  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n378\t}\n379\t\n380\t// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\n381\texport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n382\t  const json = await request.json().catch(() => ({}));\n383\t  return schema.parse(json);\n384\t}\n385\t\n386\t/** First x-forwarded-for entry (the client, behind our proxy), or null. */\n387\texport function getClientIp(request: Request): string | null {\n388\t  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n389\t}\n390\t\n391\texport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n392\t  return schema.parse(Object.fromEntries(searchParams.entries()));\n393\t}\n394\t=== src/server/audit.ts\n395\timport type { Prisma } from '@prisma/client';\n396\timport { prisma } from '@/server/db';\n397\timport { getClientIp } from '@/server/http';\n398\timport { logger } from '@/lib/logger';\n399\t\n400\texport interface AuditInput {\n401\t  actorId?: string | null;\n402\t  action: string;\n403\t  entityType?: string;\n404\t  entityId?: string;\n405\t  metadata?: Record<string, unknown>;\n406\t  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n407\t  request?: Request;\n408\t}\n409\t\n410\t// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\n411\tconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n412\t\n413\t/**\n414\t * Insert-only audit trail, the single writer of AuditLog rows. Every write\n415\t * endpoint calls this after a successful mutation with action\n416\t * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n417\t * write must not fail the request it's recording, so errors are logged\n418\t * and swallowed.\n419\t */\n420\texport async function audit(input: AuditInput): Promise<void> {\n421\t  try {\n422\t    const metadata = input.metadata\n423\t      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n424\t      : undefined;\n425\t    await prisma.auditLog.create({\n426\t      data: {\n427\t        actorId: input.actorId ?? null,\n428\t        action: input.action,\n429\t        entityType: input.entityType,\n430\t        entityId: input.entityId,\n431\t        metadata: metadata as Prisma.InputJsonValue | undefined,\n432\t        ip: input.request ? getClientIp(input.request) : null,\n433\t      },\n434\t    });\n435\t  } catch (error) {\n436\t    logger.error('Failed to write audit log', {\n437\t      action: input.action,\n438\t      error: error instanceof Error ? error.message : String(error),\n439\t    });\n440\t  }\n441\t}\n442\t=== src/server/auth/tokens.ts\n443\timport { createHash, randomBytes, timingSafeEqual } from 'node:crypto';\n444\timport type { AuthToken, AuthTokenType, Prisma, User } from '@prisma/client';\n445\timport { prisma } from '@/server/db';\n446\timport { AppError } from '@/server/http';\n447\t\n448\t/**\n449\t * The only code that touches AuthToken (FR-13, NFR-1). Raw tokens are\n450\t * returned to the caller once and never stored; only sha256(raw) hex is.\n451\t */\n452\t\n453\ttype Tx = Prisma.TransactionClient;\n454\t\n455\texport function hashToken(raw: string): string {\n456\t  return createHash('sha256').update(raw).digest('hex');\n457\t}\n458\t\n459\t/** Invalidates the user's older unused tokens of `type`, then issues a new one. Returns the raw token. */\n460\texport async function createToken(\n461\t  userId: string,\n462\t  type: AuthTokenType,\n463\t  ttl: { minutes?: number; days?: number },\n464\t  tx?: Tx,\n465\t): Promise<string> {\n466\t  const raw = randomBytes(32).toString('base64url');\n467\t  const now = new Date();\n468\t  const ttlMs = ((ttl.days ?? 0) * 24 * 60 + (ttl.minutes ?? 0)) * 60_000;\n469\t\n470\t  const run = async (client: Tx) => {\n471\t    await client.authToken.updateMany({ where: { userId, type, usedAt: null }, data: { usedAt: now } });\n472\t    await client.authToken.create({\n473\t      data: { userId, type, tokenHash: hashToken(raw), expiresAt: new Date(now.getTime() + ttlMs) },\n474\t    });\n475\t  };\n476\t  if (tx) await run(tx);\n477\t  else await prisma.$transaction(run);\n478\t  return raw;\n479\t}\n480\t\n481\texport type VerifiedToken = {\n482\t  token: AuthToken;\n483\t  user: Pick<User, 'id' | 'email' | 'firstName' | 'lastName' | 'status'>;\n484\t};\n485\t\n486\t/** Returns the token + user, or null if missing, wrong type, used or expired. */\n487\texport async function verifyToken(raw: string, type: AuthTokenType): Promise<VerifiedToken | null> {\n488\t  if (!raw) return null;\n489\t  const hash = hashToken(raw);\n490\t  const token = await prisma.authToken.findUnique({\n491\t    where: { tokenHash: hash },\n492\t    include: { user: { select: { id: true, email: true, firstName: true, lastName: true, status: true } } },\n493\t  });\n494\t  if (!token) return null;\n495\t  if (!timingSafeEqual(Buffer.from(token.tokenHash, 'hex'), Buffer.from(hash, 'hex'))) return null;\n496\t  if (token.type !== type || token.usedAt || token.expiresAt <= new Date()) return null;\n497\t  const { user, ...rest } = token;\n498\t  return { token: rest, user };\n499\t}\n500\t\n501\t/** Marks the token used; throws INVALID_TOKEN if it was already consumed (double submit). */\n502\texport async function consumeToken(tokenId: string, tx?: Tx): Promise<void> {\n503\t  const { count } = await (tx ?? prisma).authToken.updateMany({\n504\t    where: { id: tokenId, usedAt: null },\n505\t    data: { usedAt: new Date() },\n506\t  });\n507\t  if (count === 0) throw new AppError('INVALID_TOKEN', 'This link is invalid or has expired.');\n508\t}\n509\t=== tests/unit/tokens.test.ts\n510\timport { describe, it, expect } from 'vitest';\n511\timport { hashToken } from '@/server/auth/tokens';\n512\t\n513\tdescribe('hashToken', () => {\n514\t  it('is deterministic 64-char hex and never the raw token', () => {\n515\t    const raw = 'abc-raw-token';\n516\t    expect(hashToken(raw)).toBe(hashToken(raw));\n517\t    expect(hashToken(raw)).toMatch(/^[0-9a-f]{64}$/);\n518\t    expect(hashToken(raw)).not.toBe(raw);\n519\t    expect(hashToken('other')).not.toBe(hashToken(raw));\n520\t  });\n521\t});\n522\t=== src/server/auth/credentials.ts\n523\timport bcrypt from 'bcrypt';\n524\timport { CredentialsSignin } from 'next-auth';\n525\timport type { Role } from '@prisma/client';\n526\timport { prisma } from '@/server/db';\n527\timport { audit } from '@/server/audit';\n528\timport { getClientIp } from '@/server/http';\n529\timport { rateLimit } from '@/server/rate-limit';\n530\timport { signInSchema } from '@/lib/validators/auth';\n531\t\n532\t/** Error code surfaces to the login form via signIn(..., {redirect:false}).code (FR-5, FR-7). */\n533\texport class AuthError extends CredentialsSignin {\n534\t  constructor(code: string) {\n535\t    super(code);\n536\t    this.code = code;\n537\t  }\n538\t}\n539\t\n540\texport const MAX_FAILED_LOGINS = 5;\n541\texport const LOCKOUT_MS = 15 * 60_000;\n542\tconst LOGIN_RATE_LIMIT = 10;\n543\tconst LOGIN_RATE_WINDOW_MS = 5 * 60_000;\n544\t\n545\t// Compared against when the user is missing / has no hash, so every path costs one bcrypt compare (NFR-3).\n546\tconst DUMMY_HASH = bcrypt.hashSync('schoolhub-dummy-password-never-matches', 12);\n547\t\n548\t/** FR-6: given the failure count after this attempt, the values to persist. */\n549\texport function computeLockout(count: number, now: Date): { failedLoginCount: number; lockedUntil: Date | null } {\n550\t  if (count >= MAX_FAILED_LOGINS) return { failedLoginCount: 0, lockedUntil: new Date(now.getTime() + LOCKOUT_MS) };\n551\t  return { failedLoginCount: count, lockedUntil: null };\n552\t}\n553\t\n554\texport interface AuthorizedUser {\n555\t  id: string;\n556\t  email: string;\n557\t  firstName: string;\n558\t  lastName: string;\n559\t  role: Role;\n560\t}\n561\t\n562\texport async function authorizeCredentials(input: unknown, request: Request): Promise<AuthorizedUser> {\n563\t  const ip = getClientIp(request);\n564\t  const fail = async (reason: string, email: string | null, actorId: string | null = null): Promise<never> => {\n565\t    await audit({ actorId, action: 'auth.login.failure', entityType: 'User', entityId: actorId ?? undefined, metadata: { email, reason }, request });\n566\t    throw new AuthError(reason);\n567\t  };\n568\t\n569\t  if (!rateLimit(`login:ip:${ip ?? 'unknown'}`, LOGIN_RATE_LIMIT, LOGIN_RATE_WINDOW_MS).ok) {\n570\t    return fail('rate_limited', null);\n571\t  }\n572\t\n573\t  const parsed = signInSchema.safeParse(input);\n574\t  if (!parsed.success) return fail('invalid', null);\n575\t  const { email, password } = parsed.data;\n576\t\n577\t  const user = await prisma.user.findUnique({ where: { email } });\n578\t  const passwordOk = await bcrypt.compare(password, user?.passwordHash ?? DUMMY_HASH);\n579\t  const now = new Date();\n580\t\n581\t  if (!user) return fail('invalid', email);\n582\t  if (user.status === 'DISABLED') return fail('disabled', email, user.id);\n583\t  if (user.status !== 'ACTIVE' || user.archivedAt) return fail('invalid', email, user.id);\n584\t  if (user.lockedUntil && user.lockedUntil > now) {\n585\t    return fail(`locked:${Math.ceil((user.lockedUntil.getTime() - now.getTime()) / 60_000)}`, email, user.id);\n586\t  }\n587\t\n588\t  if (!passwordOk || !user.passwordHash) {\n589\t    // ponytail: concurrent failures can overshoot the count by one before the lock lands; harmless.\n590\t    const { failedLoginCount } = await prisma.user.update({\n591\t      where: { id: user.id },\n592\t      data: { failedLoginCount: { increment: 1 } },\n593\t      select: { failedLoginCount: true },\n594\t    });\n595\t    const lock = computeLockout(failedLoginCount, now);\n596\t    if (lock.lockedUntil) {\n597\t      await prisma.user.update({ where: { id: user.id }, data: lock });\n598\t      await audit({ actorId: user.id, action: 'auth.lockout', entityType: 'User', entityId: user.id, metadata: { email }, request });\n599\t      return fail(`locked:${LOCKOUT_MS / 60_000}`, email, user.id);\n600\t    }\n601\t    return fail('invalid', email, user.id);\n602\t  }\n603\t\n604\t  await prisma.user.update({ where: { id: user.id }, data: { failedLoginCount: 0, lockedUntil: null, lastLoginAt: now } });\n605\t  await audit({ actorId: user.id, action: 'auth.login.success', entityType: 'User', entityId: user.id, request });\n606\t  return { id: user.id, email: user.email, firstName: user.firstName, lastName: user.lastName, role: user.role };\n607\t}\n608\t=== tests/unit/lockout.test.ts\n609\timport { describe, it, expect } from 'vitest';\n610\timport { computeLockout } from '@/server/auth/credentials';\n611\t\n612\tdescribe('computeLockout', () => {\n613\t  const now = new Date('2026-11-04T12:00:00Z');\n614\t\n615\t  it('keeps counting below 5 failures', () => {\n616\t    expect(computeLockout(1, now)).toEqual({ failedLoginCount: 1, lockedUntil: null });\n617\t    expect(computeLockout(4, now)).toEqual({ failedLoginCount: 4, lockedUntil: null });\n618\t  });\n619\t\n620\t  it('locks for 15 minutes and resets the count at 5', () => {\n621\t    expect(computeLockout(5, now)).toEqual({\n622\t      failedLoginCount: 0,\n623\t      lockedUntil: new Date('2026-11-04T12:15:00Z'),\n624\t    });\n625\t  });\n626\t\n627\t  it('also locks if the count overshoots', () => {\n628\t    expect(computeLockout(6, now).lockedUntil).not.toBeNull();\n629\t  });\n630\t});\n631\t=== src/server/auth/auth.config.ts\n632\timport type { NextAuthConfig } from 'next-auth';\n633\timport { safeCallbackUrl } from '@/lib/validators/auth';\n634\t\n635\t/**\n636\t * Edge-safe Auth.js config (ADR-1): no Prisma, no bcrypt. src/middleware.ts\n637\t * uses this alone; src/server/auth/auth.ts adds the Credentials provider\n638\t * and the revocation-checking jwt callback on Node.\n639\t * Cookies: Auth.js defaults (HttpOnly, SameSite=Lax, __Secure- in prod).\n640\t */\n641\texport const authConfig = {\n642\t  trustHost: true,\n643\t  session: { strategy: 'jwt', maxAge: 8 * 60 * 60, updateAge: 15 * 60 },\n644\t  pages: { signIn: '/login' },\n645\t  providers: [],\n646\t  callbacks: {\n647\t    session({ session, token }) {\n648\t      session.user.id = token.id;\n649\t      session.user.role = token.role;\n650\t      session.user.firstName = token.firstName;\n651\t      session.user.lastName = token.lastName;\n652\t      session.user.email = token.email ?? '';\n653\t      return session;\n654\t    },\n655\t    redirect({ url, baseUrl }) {\n656\t      // Auth.js hands us absolute URLs; reduce same-origin ones to a path, then sanitise.\n657\t      const path = url.startsWith(baseUrl) ? url.slice(baseUrl.length) || '/' : url;\n658\t      return baseUrl + safeCallbackUrl(path);\n659\t    },\n660\t  },\n661\t} satisfies NextAuthConfig;\n662\t=== src/server/auth/auth.ts\n663\timport NextAuth from 'next-auth';\n664\timport Credentials from 'next-auth/providers/credentials';\n665\timport { prisma } from '@/server/db';\n666\timport { authConfig } from '@/server/auth/auth.config';\n667\timport { authorizeCredentials } from '@/server/auth/credentials';\n668\t\n669\tconst RECHECK_MS = 5 * 60_000;\n670\t\n671\texport const { handlers, auth, signIn, signOut, unstable_update } = NextAuth({\n672\t  ...authConfig,\n673\t  providers: [\n674\t    Credentials({\n675\t      credentials: { email: {}, password: {} },\n676\t      authorize: (credentials, request) => authorizeCredentials(credentials, request),\n677\t    }),\n678\t  ],\n679\t  callbacks: {\n680\t    ...authConfig.callbacks,\n681\t    async jwt({ token, user, trigger, session }) {\n682\t      const now = Date.now();\n683\t\n684\t      if (trigger === 'signIn' && user) {\n685\t        return {\n686\t          ...token,\n687\t          id: user.id as string,\n688\t          role: user.role,\n689\t          firstName: user.firstName,\n690\t          lastName: user.lastName,\n691\t          email: user.email,\n692\t          authTime: now,\n693\t          checkedAt: now,\n694\t        };\n695\t      }\n696\t\n697\t      // FR-23: the session that just changed its password stays valid.\n698\t      if (trigger === 'update' && (session as { reauth?: boolean } | undefined)?.reauth) {\n699\t        return { ...token, authTime: now, checkedAt: now };\n700\t      }\n701\t\n702\t      // FR-11: revoke within 5 min of disable/archive/password change elsewhere.\n703\t      if (now - (token.checkedAt ?? 0) > RECHECK_MS) {\n704\t        const fresh = await prisma.user.findUnique({\n705\t          where: { id: token.id },\n706\t          select: { passwordChangedAt: true, status: true, archivedAt: true, role: true, firstName: true, lastName: true },\n707\t        });\n708\t        if (!fresh || fresh.status !== 'ACTIVE' || fresh.archivedAt) return null;\n709\t        if (fresh.passwordChangedAt && fresh.passwordChangedAt.getTime() > token.authTime) return null;\n710\t        return { ...token, role: fresh.role, firstName: fresh.firstName, lastName: fresh.lastName, checkedAt: now };\n711\t      }\n712\t\n713\t      return token;\n714\t    },\n715\t  },\n716\t});\n717\t=== src/types/next-auth.d.ts\n718\timport type { DefaultSession } from 'next-auth';\n719\timport type { Role } from '@prisma/client';\n720\t\n721\tdeclare module 'next-auth' {\n722\t  interface User {\n723\t    role: Role;\n724\t    firstName: string;\n725\t    lastName: string;\n726\t  }\n727\t\n728\t  interface Session {\n729\t    user: {\n730\t      id: string;\n731\t      role: Role;\n732\t      firstName: string;\n733\t      lastName: string;\n734\t      email: string;\n735\t    } & DefaultSession['user'];\n736\t  }\n737\t}\n738\t\n739\tdeclare module '@auth/core/jwt' {\n740\t  interface JWT {\n741\t    id: string;\n742\t    role: Role;\n743\t    firstName: string;\n744\t    lastName: string;\n745\t    /** Epoch ms of the last real authentication (sign-in or reauth). Not `iat`, which moves on refresh. */\n746\t    authTime: number;\n747\t    /** Epoch ms of the last DB revocation check. */\n748\t    checkedAt: number;\n749\t  }\n750\t}\n751\t=== src/app/api/auth/[...nextauth]/route.ts\n752\timport { handlers } from '@/server/auth/auth';\n753\t\n754\texport const { GET, POST } = handlers;\n755\t=== src/server/auth/requireRole.ts\n756\timport { AppError } from '@/server/http';\n757\timport type { Role } from '@/config/navigation';\n758\t\n759\t/**\n760\t * Single chokepoint for server-side role checks on write endpoints.\n761\t *\n762\t * PRD-01 (real auth/session) has not landed in this workspace yet, so\n763\t * there is no session to read. This returns the same ADMIN placeholder\n764\t * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n765\t * and throws FORBIDDEN when that role isn't in the allowed list. Every\n766\t * write endpoint in this PRD calls requireRole() instead of checking role\n767\t * itself, so wiring up a real session later is a one-file change here\n768\t * instead of touching every route.\n769\t */\n770\tconst PLACEHOLDER_USER = { id: 'placeholder-user', role: 'ADMIN' as Role };\n771\t\n772\texport function requireRole(...roles: Role[]): { id: string; role: Role } {\n773\t  if (!roles.includes(PLACEHOLDER_USER.role)) {\n774\t    throw new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n775\t  }\n776\t  return PLACEHOLDER_USER;\n777\t}\n778\t=== src/lib/env.ts\n779\timport { z } from 'zod';\n780\t\n781\t/**\n782\t * Fail-fast env validation. Runs once at module load (startup boundary) —\n783\t * anything importing this module gets a readable error naming every\n784\t * missing/invalid variable instead of an undefined-at-runtime surprise.\n785\t */\n786\tconst envSchema = z.object({\n787\t  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n788\t  APP_URL: z.string().min(1, 'APP_URL is required'),\n789\t  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n790\t  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n791\t\n792\t  // Email (PRD-04). EMAIL_TRANSPORT defaults to 'console' so dev/test never\n793\t  // need real SMTP creds; the smtp branch (src/server/email/transport.ts)\n794\t  // only reads SMTP_*/EMAIL_FROM when EMAIL_TRANSPORT='smtp'.\n795\t  EMAIL_TRANSPORT: z.enum(['smtp', 'console']).default('console'),\n796\t  SMTP_HOST: z.string().optional(),\n797\t  SMTP_PORT: z.coerce.number().int().optional(),\n798\t  SMTP_USER: z.string().optional(),\n799\t  SMTP_PASS: z.string().optional(),\n800\t  SMTP_SECURE: z.coerce.boolean().optional(),\n801\t  EMAIL_FROM: z.string().optional(),\n802\t  // Bearer token for POST /api/internal/email/dispatch (NFR-8). Optional so\n803\t  // existing .env files don't break; left unset, the route rejects every\n804\t  // request (fail-safe, not fail-open).\n805\t  CRON_SECRET: z.string().optional(),\n806\t});\n807\t\n808\tfunction loadEnv() {\n809\t  const parsed = envSchema.safeParse(process.env);\n810\t  if (!parsed.success) {\n811\t    const issues = parsed.error.issues\n812\t      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n813\t      .join('\\n');\n814\t    throw new Error(`Invalid environment variables:\\n${issues}`);\n815\t  }\n816\t  return parsed.data;\n817\t}\n818\t\n819\texport const env = loadEnv();\n820\texport type Env = z.infer<typeof envSchema>;\n821\t=== src/lib/logger.ts\n822\ttype LogMeta = Record<string, unknown> | undefined;\n823\ttype Level = 'info' | 'warn' | 'error';\n824\t\n825\tconst isProd = process.env.NODE_ENV === 'production';\n826\t\n827\tfunction write(level: Level, message: string, meta?: LogMeta) {\n828\t  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n829\t\n830\t  if (isProd) {\n831\t    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n832\t    return;\n833\t  }\n834\t\n835\t  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n836\t}\n837\t\n838\texport const logger = {\n839\t  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n840\t  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n841\t  error: (message: string, meta?: LogMeta) => write('error', message, meta),\n842\t};\n843\t    1000 src/server/auth/common-passwords.txt\n844\t1000\n845\tpassword123\n846\tpassword1234\n847\tqwerty123456\n848\t167:model AuditLog {\n849\t168-  id         String   @id @default(cuid())\n850\t169-  actorId    String?\n851\t170-  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n852\t171-  action     String\n853\t172-  entityType String?\n854\t173-  entityId   String?\n855\t174-  metadata   Json?\n856\t175-  ip         String?\n857\t176-  createdAt  DateTime @default(now())\n858\t177-\n859\t178-  @@index([actorId])\n860\t179-  @@index([action])\n861\t"}]},"parent_tool_use_id":null,"session_id":"46abff3e-324d-47c1-a451-e45bcb70c7c7","uuid":"cb8f5f0c-5700-4744-ba4c-f7c8ee9994ef","timestamp":"2026-11-04T06:49:28.382Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/.claude/projects/-Users-ikramaansari-Documents-forge-schoolhub-prds/46abff3e-324d-47c1-a451-e45bcb70c7c7/tool-results/b13a29sfh.txt","content":"=== prisma/migrations/20261104000000_auth_reconcile/migration.sql\n-- CreateIndex\nCREATE INDEX \"AuditLog_entityType_entityId_idx\" ON \"AuditLog\"(\"entityType\", \"entityId\");\n\n-- CreateIndex\nCREATE INDEX \"AuditLog_actorId_createdAt_idx\" ON \"AuditLog\"(\"actorId\", \"createdAt\");\n=== src/lib/validators/auth.ts\nimport { z } from 'zod';\n\n/**\n * Client-safe auth validators (FR-2, FR-8, FR-17). No fs / server imports:\n * the login/invite/reset/security forms import this directly. The\n * common-password rule and the real \"not your email\" check run server-side\n * in src/server/auth/password-policy.ts (the API body doesn't carry the email).\n */\n\nexport const emailField = z.string().trim().toLowerCase().email('Enter a valid email address');\n\nexport interface PasswordCheckResult {\n  length: boolean;\n  letter: boolean;\n  digit: boolean;\n  notEmail: boolean;\n}\n\nexport const PASSWORD_RULES: Record<keyof PasswordCheckResult, { label: string; error: string }> = {\n  length: { label: '10 to 128 characters', error: 'Password must be 10 to 128 characters.' },\n  letter: { label: 'At least one letter', error: 'Password must contain at least one letter.' },\n  digit: { label: 'At least one number', error: 'Password must contain at least one number.' },\n  notEmail: { label: 'Not the same as your email', error: 'Password must not be your email address.' },\n};\n\nexport function passwordChecks(password: string, email: string): PasswordCheckResult {\n  return {\n    length: password.length >= 10 && password.length <= 128,\n    letter: /[A-Za-z]/.test(password),\n    digit: /[0-9]/.test(password),\n    notEmail: password.trim().toLowerCase() !== email.trim().toLowerCase(),\n  };\n}\n\n/** Error messages for every failing rule (empty when the password passes). */\nexport function passwordErrors(password: string, email: string): string[] {\n  const checks = passwordChecks(password, email);\n  return (Object.keys(checks) as (keyof PasswordCheckResult)[])\n    .filter((key) => !checks[key])\n    .map((key) => PASSWORD_RULES[key].error);\n}\n\n/** FR-8: only same-origin relative paths; everything else falls back to /dashboard. */\nexport function safeCallbackUrl(url: string | null | undefined): string {\n  if (!url || !url.startsWith('/') || url.startsWith('//') || url.startsWith('/\\\\')) return '/dashboard';\n  return url;\n}\n\nexport const signInSchema = z.object({\n  email: emailField,\n  password: z.string().min(1, 'Enter your password'),\n});\n\nexport const forgotPasswordSchema = z.object({ email: emailField });\n\n/** superRefine: policy rules on `field` + confirm-equals. `email` is '' when unknown. */\nfunction refineNewPassword(field: string, email = '') {\n  return (value: Record<string, unknown>, ctx: z.RefinementCtx) => {\n    const password = String(value[field] ?? '');\n    for (const message of passwordErrors(password, email)) {\n      ctx.addIssue({ code: z.ZodIssueCode.custom, path: [field], message });\n    }\n    if (password !== value.confirm) {\n      ctx.addIssue({ code: z.ZodIssueCode.custom, path: ['confirm'], message: 'Passwords do not match.' });\n    }\n  };\n}\n\nconst newPasswordShape = { password: z.string(), confirm: z.string() };\n\n/** Client form schema for SetPasswordForm (invite + reset); pass the known email. */\nexport function setPasswordSchema(email = '') {\n  return z.object(newPasswordShape).superRefine(refineNewPassword('password', email));\n}\n\nexport const acceptInviteSchema = z\n  .object({ token: z.string().min(1), ...newPasswordShape })\n  .superRefine(refineNewPassword('password'));\n\nexport const resetPasswordSchema = acceptInviteSchema;\n\nexport function changePasswordFormSchema(email = '') {\n  return z\n    .object({\n      currentPassword: z.string().min(1, 'Enter your current password'),\n      newPassword: z.string(),\n      confirm: z.string(),\n    })\n    .superRefine(refineNewPassword('newPassword', email));\n}\n\nexport const changePasswordSchema = changePasswordFormSchema();\n\nexport type SignInInput = z.infer<typeof signInSchema>;\nexport type AcceptInviteInput = z.infer<typeof acceptInviteSchema>;\nexport type ResetPasswordInput = z.infer<typeof resetPasswordSchema>;\nexport type ChangePasswordInput = z.infer<typeof changePasswordSchema>;\nexport type SetPasswordValues = z.infer<ReturnType<typeof setPasswordSchema>>;\n=== tests/unit/auth-validators.test.ts\nimport { describe, it, expect } from 'vitest';\nimport {\n  passwordChecks,\n  safeCallbackUrl,\n  signInSchema,\n  acceptInviteSchema,\n  changePasswordSchema,\n} from '@/lib/validators/auth';\n\ndescribe('passwordChecks', () => {\n  it('passes a compliant password', () => {\n    expect(passwordChecks('correcthorse9', 'a@b.test')).toEqual({ length: true, letter: true, digit: true, notEmail: true });\n  });\n\n  it('enforces 10..128 length', () => {\n    expect(passwordChecks('abc123456', 'x@y.z').length).toBe(false);\n    expect(passwordChecks('abc1234567', 'x@y.z').length).toBe(true);\n    expect(passwordChecks('a1'.repeat(64), 'x@y.z').length).toBe(true);\n    expect(passwordChecks('a1'.repeat(64) + 'b', 'x@y.z').length).toBe(false);\n  });\n\n  it('requires a letter and a digit', () => {\n    expect(passwordChecks('1234567890', 'x@y.z').letter).toBe(false);\n    expect(passwordChecks('abcdefghij', 'x@y.z').digit).toBe(false);\n  });\n\n  it('rejects the email, case-insensitively', () => {\n    expect(passwordChecks('Teacher1@School.test', 'teacher1@school.test').notEmail).toBe(false);\n  });\n});\n\ndescribe('safeCallbackUrl', () => {\n  it('keeps relative paths', () => {\n    expect(safeCallbackUrl('/courses/1?tab=roster')).toBe('/courses/1?tab=roster');\n  });\n\n  it.each(['//evil.com', '/\\\\evil', 'https://evil.com', '', null, undefined, 'dashboard'])('rejects %s', (url) => {\n    expect(safeCallbackUrl(url as string | null)).toBe('/dashboard');\n  });\n});\n\ndescribe('schemas', () => {\n  it('trims and lower-cases the sign-in email', () => {\n    expect(signInSchema.parse({ email: '  Admin@SchoolHub.TEST ', password: 'x' }).email).toBe('admin@schoolhub.test');\n  });\n\n  it('flags a confirm mismatch and policy failures', () => {\n    const result = acceptInviteSchema.safeParse({ token: 't', password: 'short', confirm: 'other' });\n    expect(result.success).toBe(false);\n    const fields = result.success ? {} : result.error.flatten().fieldErrors;\n    expect(fields.password?.length).toBeGreaterThan(0);\n    expect(fields.confirm).toEqual(['Passwords do not match.']);\n  });\n\n  it('accepts a valid change-password body', () => {\n    expect(\n      changePasswordSchema.safeParse({ currentPassword: 'old', newPassword: 'newpassword42', confirm: 'newpassword42' }).success,\n    ).toBe(true);\n  });\n});\n=== src/server/auth/email.ts\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\n\nexport type AuthEmailKind = 'invite' | 'password-reset';\n\nconst PATHS: Record<AuthEmailKind, string> = { invite: '/invite/', 'password-reset': '/reset-password/' };\nconst SUBJECTS: Record<AuthEmailKind, string> = {\n  invite: \"You're invited to SchoolHub\",\n  'password-reset': 'Reset your SchoolHub password',\n};\n\nexport function authLink(kind: AuthEmailKind, rawToken: string): string {\n  return new URL(PATHS[kind] + encodeURIComponent(rawToken), env.APP_URL).toString();\n}\n\n/**\n * FR-22 seam: logs the link instead of sending. PRD-04 replaces this body\n * with an EmailOutbox enqueue. The raw token appears only here, never in audit.\n */\nexport async function sendAuthEmail(\n  user: { email: string; firstName?: string },\n  kind: AuthEmailKind,\n  link: string,\n): Promise<void> {\n  logger.info('Auth email', { to: user.email, subject: SUBJECTS[kind], link });\n}\n=== src/server/rate-limit.ts\n// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\nconst hits = new Map<string, number[]>();\n\n/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\nexport function rateLimit(\n  key: string,\n  limit: number,\n  windowMs: number,\n  now: number = Date.now(),\n): { ok: boolean; retryAfterMs: number } {\n  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n  if (recent.length >= limit) {\n    hits.set(key, recent);\n    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n  }\n  recent.push(now);\n  hits.set(key, recent);\n  return { ok: true, retryAfterMs: 0 };\n}\n\nexport function __resetRateLimits(): void {\n  hits.clear();\n}\n=== tests/unit/rate-limit.test.ts\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { rateLimit, __resetRateLimits } from '@/server/rate-limit';\nimport { getClientIp } from '@/server/http';\n\ndescribe('rateLimit', () => {\n  beforeEach(() => __resetRateLimits());\n\n  it('allows up to the limit then blocks with retryAfterMs', () => {\n    for (let i = 0; i < 3; i += 1) expect(rateLimit('k', 3, 1000, 100 + i).ok).toBe(true);\n    const blocked = rateLimit('k', 3, 1000, 500);\n    expect(blocked.ok).toBe(false);\n    expect(blocked.retryAfterMs).toBe(600); // first hit at 100 expires at 1100\n  });\n\n  it('slides the window', () => {\n    rateLimit('k', 2, 1000, 0);\n    rateLimit('k', 2, 1000, 500);\n    expect(rateLimit('k', 2, 1000, 999).ok).toBe(false);\n    expect(rateLimit('k', 2, 1000, 1001).ok).toBe(true); // hit at 0 aged out\n  });\n\n  it('isolates keys', () => {\n    rateLimit('a', 1, 1000, 0);\n    expect(rateLimit('a', 1, 1000, 1).ok).toBe(false);\n    expect(rateLimit('b', 1, 1000, 1).ok).toBe(true);\n  });\n});\n\ndescribe('getClientIp', () => {\n  it('takes the first x-forwarded-for entry, trimmed', () => {\n    expect(getClientIp(new Request('http://x', { headers: { 'x-forwarded-for': ' 1.2.3.4 , 10.0.0.1' } }))).toBe('1.2.3.4');\n  });\n\n  it('returns null without the header', () => {\n    expect(getClientIp(new Request('http://x'))).toBeNull();\n  });\n});\n=== src/server/http.ts\nimport { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */\nexport function withHandler<Args extends unknown[]>(\n  fn: (...args: Args) => Promise<Response>,\n) {\n  return async (...args: Args): Promise<Response> => {\n    try {\n      return await fn(...args);\n    } catch (error) {\n      if (error instanceof ZodError) {\n        return apiError('VALIDATION_ERROR', 'Invalid request', error.flatten());\n      }\n\n      if (error instanceof AppError) {\n        return apiError(error.code, error.message, error.details);\n      }\n\n      if (error instanceof Prisma.PrismaClientKnownRequestError) {\n        if (error.code === 'P2002') {\n          return apiError('CONFLICT', 'Resource already exists', { target: error.meta?.target });\n        }\n        if (error.code === 'P2025') {\n          return apiError('NOT_FOUND', 'Resource not found');\n        }\n      }\n\n      logger.error('Unhandled error in route handler', {\n        message: error instanceof Error ? error.message : String(error),\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      return apiError('INTERNAL', 'Internal server error');\n    }\n  };\n}\n\nexport interface PaginationParams {\n  page: number;\n  pageSize: number;\n  skip: number;\n  take: number;\n}\n\nconst MAX_PAGE_SIZE = 100;\n\nexport function parsePagination(searchParams: URLSearchParams): PaginationParams {\n  const rawPage = Number(searchParams.get('page'));\n  const rawPageSize = Number(searchParams.get('pageSize'));\n\n  const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.floor(rawPage) : 1;\n  const pageSizeRequested = Number.isFinite(rawPageSize) && rawPageSize >= 1 ? Math.floor(rawPageSize) : 20;\n  const pageSize = Math.min(pageSizeRequested, MAX_PAGE_SIZE);\n\n  return { page, pageSize, skip: (page - 1) * pageSize, take: pageSize };\n}\n\n// Typed on the schema's *output* so .default()/.transform()/preprocess fields come back resolved.\nexport async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n  const json = await request.json().catch(() => ({}));\n  return schema.parse(json);\n}\n\n/** First x-forwarded-for entry (the client, behind our proxy), or null. */\nexport function getClientIp(request: Request): string | null {\n  return request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || null;\n}\n\nexport function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\n  return schema.parse(Object.fromEntries(searchParams.entries()));\n}\n=== src/server/audit.ts\nimport type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { getClientIp } from '@/server/http';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n  request?: Request;\n}\n\n// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\nconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    const metadata = input.metadata\n      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n      : undefined;\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: metadata as Prisma.InputJsonValue | undefined,\n        ip: input.request ? getClientIp(input.request) : null,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n=== src/server/auth/tokens.ts\nimport { createHash, randomBytes, timingSafeEqual } from 'node:crypto';\nimport type { AuthToken, AuthTokenType, Prisma, User } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\n\n/**\n * The only code that touches AuthToken (FR-13, NFR-1). Raw tokens are\n * returned to the caller once and never stored; only sha256(raw) hex is.\n */\n\ntype Tx = Prisma.TransactionClient;\n\nexport function hashToken(raw: string): string {\n  return createHash('sha256').update(raw).digest('hex');\n}\n\n/** Invalidates the user's older unused tokens of `type`, then issues a new one. Returns the raw token. */\nexport async function createToken(\n  userId: string,\n  type: AuthTokenType,\n  ttl: { minutes?: number; days?: number },\n  tx?: Tx,\n): Promise<string> {\n  const raw = randomBytes(32).toString('base64url');\n  const now = new Date();\n  const ttlMs = ((ttl.days ?? 0) * 24 * 60 + (ttl.minutes ?? 0)) * 60_000;\n\n  const run = async (client: Tx) => {\n    await client.authToken.updateMany({ where: { userId, type, usedAt: null }, data: { usedAt: now } });\n    await client.authToken.create({\n      data: { userId, type, tokenHash: hashToken(raw), expiresAt: new Date(now.getTime() + ttlMs) },\n    });\n  };\n  if (tx) await run(tx);\n  else await prisma.$transaction(run);\n  return raw;\n}\n\nexport type VerifiedToken = {\n  token: AuthToken;\n  user: Pick<User, 'id' | 'email' | 'firstName' | 'lastName' | 'status'>;\n};\n\n/** Returns the token + user, or null if missing, wrong type, used or expired. */\nexport async function verifyToken(raw: string, type: AuthTokenType): Promise<VerifiedToken | null> {\n  if (!raw) return null;\n  const hash = hashToken(raw);\n  const token = await prisma.authToken.findUnique({\n    where: { tokenHash: hash },\n    include: { user: { select: { id: true, email: true, firstName: true, lastName: true, status: true } } },\n  });\n  if (!token) return null;\n  if (!timingSafeEqual(Buffer.from(token.tokenHash, 'hex'), Buffer.from(hash, 'hex'))) return null;\n  if (token.type !== type || token.usedAt || token.expiresAt <= new Date()) return null;\n  const { user, ...rest } = token;\n  return { token: rest, user };\n}\n\n/** Marks the token used; throws INVALID_TOKEN if it was already consumed (double submit). */\nexport async function consumeToken(tokenId: string, tx?: Tx): Promise<void> {\n  const { count } = await (tx ?? prisma).authToken.updateMany({\n    where: { id: tokenId, usedAt: null },\n    data: { usedAt: new Date() },\n  });\n  if (count === 0) throw new AppError('INVALID_TOKEN', 'This link is invalid or has expired.');\n}\n=== tests/unit/tokens.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { hashToken } from '@/server/auth/tokens';\n\ndescribe('hashToken', () => {\n  it('is deterministic 64-char hex and never the raw token', () => {\n    const raw = 'abc-raw-token';\n    expect(hashToken(raw)).toBe(hashToken(raw));\n    expect(hashToken(raw)).toMatch(/^[0-9a-f]{64}$/);\n    expect(hashToken(raw)).not.toBe(raw);\n    expect(hashToken('other')).not.toBe(hashToken(raw));\n  });\n});\n=== src/server/auth/credentials.ts\nimport bcrypt from 'bcrypt';\nimport { CredentialsSignin } from 'next-auth';\nimport type { Role } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { audit } from '@/server/audit';\nimport { getClientIp } from '@/server/http';\nimport { rateLimit } from '@/server/rate-limit';\nimport { signInSchema } from '@/lib/validators/auth';\n\n/** Error code surfaces to the login form via signIn(..., {redirect:false}).code (FR-5, FR-7). */\nexport class AuthError extends CredentialsSignin {\n  constructor(code: string) {\n    super(code);\n    this.code = code;\n  }\n}\n\nexport const MAX_FAILED_LOGINS = 5;\nexport const LOCKOUT_MS = 15 * 60_000;\nconst LOGIN_RATE_LIMIT = 10;\nconst LOGIN_RATE_WINDOW_MS = 5 * 60_000;\n\n// Compared against when the user is missing / has no hash, so every path costs one bcrypt compare (NFR-3).\nconst DUMMY_HASH = bcrypt.hashSync('schoolhub-dummy-password-never-matches', 12);\n\n/** FR-6: given the failure count after this attempt, the values to persist. */\nexport function computeLockout(count: number, now: Date): { failedLoginCount: number; lockedUntil: Date | null } {\n  if (count >= MAX_FAILED_LOGINS) return { failedLoginCount: 0, lockedUntil: new Date(now.getTime() + LOCKOUT_MS) };\n  return { failedLoginCount: count, lockedUntil: null };\n}\n\nexport interface AuthorizedUser {\n  id: string;\n  email: string;\n  firstName: string;\n  lastName: string;\n  role: Role;\n}\n\nexport async function authorizeCredentials(input: unknown, request: Request): Promise<AuthorizedUser> {\n  const ip = getClientIp(request);\n  const fail = async (reason: string, email: string | null, actorId: string | null = null): Promise<never> => {\n    await audit({ actorId, action: 'auth.login.failure', entityType: 'User', entityId: actorId ?? undefined, metadata: { email, reason }, request });\n    throw new AuthError(reason);\n  };\n\n  if (!rateLimit(`login:ip:${ip ?? 'unknown'}`, LOGIN_RATE_LIMIT, LOGIN_RATE_WINDOW_MS).ok) {\n    return fail('rate_limited', null);\n  }\n\n  const parsed = signInSchema.safeParse(input);\n  if (!parsed.success) return fail('invalid', null);\n  const { email, password } = parsed.data;\n\n  const user = await prisma.user.findUnique({ where: { email } });\n  const passwordOk = await bcrypt.compare(password, user?.passwordHash ?? DUMMY_HASH);\n  const now = new Date();\n\n  if (!user) return fail('invalid', email);\n  if (user.status === 'DISABLED') return fail('disabled', email, user.id);\n  if (user.status !== 'ACTIVE' || user.archivedAt) return fail('invalid', email, user.id);\n  if (user.lockedUntil && user.lockedUntil > now) {\n    return fail(`locked:${Math.ceil((user.lockedUntil.getTime() - now.getTime()) / 60_000)}`, email, user.id);\n  }\n\n  if (!passwordOk || !user.passwordHash) {\n    // ponytail: concurrent failures can overshoot the count by one before the lock lands; harmless.\n    const { failedLoginCount } = await prisma.user.update({\n      where: { id: user.id },\n      data: { failedLoginCount: { increment: 1 } },\n      select: { failedLoginCount: true },\n    });\n    const lock = computeLockout(failedLoginCount, now);\n    if (lock.lockedUntil) {\n      await prisma.user.update({ where: { id: user.id }, data: lock });\n      await audit({ actorId: user.id, action: 'auth.lockout', entityType: 'User', entityId: user.id, metadata: { email }, request });\n      return fail(`locked:${LOCKOUT_MS / 60_000}`, email, user.id);\n    }\n    return fail('invalid', email, user.id);\n  }\n\n  await prisma.user.update({ where: { id: user.id }, data: { failedLoginCount: 0, lockedUntil: null, lastLoginAt: now } });\n  await audit({ actorId: user.id, action: 'auth.login.success', entityType: 'User', entityId: user.id, request });\n  return { id: user.id, email: user.email, firstName: user.firstName, lastName: user.lastName, role: user.role };\n}\n=== tests/unit/lockout.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { computeLockout } from '@/server/auth/credentials';\n\ndescribe('computeLockout', () => {\n  const now = new Date('2026-11-04T12:00:00Z');\n\n  it('keeps counting below 5 failures', () => {\n    expect(computeLockout(1, now)).toEqual({ failedLoginCount: 1, lockedUntil: null });\n    expect(computeLockout(4, now)).toEqual({ failedLoginCount: 4, lockedUntil: null });\n  });\n\n  it('locks for 15 minutes and resets the count at 5', () => {\n    expect(computeLockout(5, now)).toEqual({\n      failedLoginCount: 0,\n      lockedUntil: new Date('2026-11-04T12:15:00Z'),\n    });\n  });\n\n  it('also locks if the count overshoots', () => {\n    expect(computeLockout(6, now).lockedUntil).not.toBeNull();\n  });\n});\n=== src/server/auth/auth.config.ts\nimport type { NextAuthConfig } from 'next-auth';\nimport { safeCallbackUrl } from '@/lib/validators/auth';\n\n/**\n * Edge-safe Auth.js config (ADR-1): no Prisma, no bcrypt. src/middleware.ts\n * uses this alone; src/server/auth/auth.ts adds the Credentials provider\n * and the revocation-checking jwt callback on Node.\n * Cookies: Auth.js defaults (HttpOnly, SameSite=Lax, __Secure- in prod).\n */\nexport const authConfig = {\n  trustHost: true,\n  session: { strategy: 'jwt', maxAge: 8 * 60 * 60, updateAge: 15 * 60 },\n  pages: { signIn: '/login' },\n  providers: [],\n  callbacks: {\n    session({ session, token }) {\n      session.user.id = token.id;\n      session.user.role = token.role;\n      session.user.firstName = token.firstName;\n      session.user.lastName = token.lastName;\n      session.user.email = token.email ?? '';\n      return session;\n    },\n    redirect({ url, baseUrl }) {\n      // Auth.js hands us absolute URLs; reduce same-origin ones to a path, then sanitise.\n      const path = url.startsWith(baseUrl) ? url.slice(baseUrl.length) || '/' : url;\n      return baseUrl + safeCallbackUrl(path);\n    },\n  },\n} satisfies NextAuthConfig;\n=== src/server/auth/auth.ts\nimport NextAuth from 'next-auth';\nimport Credentials from 'next-auth/providers/credentials';\nimport { prisma } from '@/server/db';\nimport { authConfig } from '@/server/auth/auth.config';\nimport { authorizeCredentials } from '@/server/auth/credentials';\n\nconst RECHECK_MS = 5 * 60_000;\n\nexport const { handlers, auth, signIn, signOut, unstable_update } = NextAuth({\n  ...authConfig,\n  providers: [\n    Credentials({\n      credentials: { email: {}, password: {} },\n      authorize: (credentials, request) => authorizeCredentials(credentials, request),\n    }),\n  ],\n  callbacks: {\n    ...authConfig.callbacks,\n    async jwt({ token, user, trigger, session }) {\n      const now = Date.now();\n\n      if (trigger === 'signIn' && user) {\n        return {\n          ...token,\n          id: user.id as string,\n          role: user.role,\n          firstName: user.firstName,\n          lastName: user.lastName,\n          email: user.email,\n          authTime: now,\n          checkedAt: now,\n        };\n      }\n\n      // FR-23: the session that just changed its password stays valid.\n      if (trigger === 'update' && (session as { reauth?: boolean } | undefined)?.reauth) {\n        return { ...token, authTime: now, checkedAt: now };\n      }\n\n      // FR-11: revoke within 5 min of disable/archive/password change elsewhere.\n      if (now - (token.checkedAt ?? 0) > RECHECK_MS) {\n        const fresh = await prisma.user.findUnique({\n          where: { id: token.id },\n          select: { passwordChangedAt: true, status: true, archivedAt: true, role: true, firstName: true, lastName: true },\n        });\n        if (!fresh || fresh.status !== 'ACTIVE' || fresh.archivedAt) return null;\n        if (fresh.passwordChangedAt && fresh.passwordChangedAt.getTime() > token.authTime) return null;\n        return { ...token, role: fresh.role, firstName: fresh.firstName, lastName: fresh.lastName, checkedAt: now };\n      }\n\n      return token;\n    },\n  },\n});\n=== src/types/next-auth.d.ts\nimport type { DefaultSession } from 'next-auth';\nimport type { Role } from '@prisma/client';\n\ndeclare module 'next-auth' {\n  interface User {\n    role: Role;\n    firstName: string;\n    lastName: string;\n  }\n\n  interface Session {\n    user: {\n      id: string;\n      role: Role;\n      firstName: string;\n      lastName: string;\n      email: string;\n    } & DefaultSession['user'];\n  }\n}\n\ndeclare module '@auth/core/jwt' {\n  interface JWT {\n    id: string;\n    role: Role;\n    firstName: string;\n    lastName: string;\n    /** Epoch ms of the last real authentication (sign-in or reauth). Not `iat`, which moves on refresh. */\n    authTime: number;\n    /** Epoch ms of the last DB revocation check. */\n    checkedAt: number;\n  }\n}\n=== src/app/api/auth/[...nextauth]/route.ts\nimport { handlers } from '@/server/auth/auth';\n\nexport const { GET, POST } = handlers;\n=== src/server/auth/requireRole.ts\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side role checks on write endpoints.\n *\n * PRD-01 (real auth/session) has not landed in this workspace yet, so\n * there is no session to read. This returns the same ADMIN placeholder\n * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n * and throws FORBIDDEN when that role isn't in the allowed list. Every\n * write endpoint in this PRD calls requireRole() instead of checking role\n * itself, so wiring up a real session later is a one