{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y3wCtX4dU1v5uQQtXF7W6T","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { useEffect, useState } from 'react';\n4\timport Box from '@mui/material/Box';\n5\timport AppBar from '@mui/material/AppBar';\n6\timport Toolbar from '@mui/material/Toolbar';\n7\timport Drawer from '@mui/material/Drawer';\n8\timport List from '@mui/material/List';\n9\timport ListItemButton from '@mui/material/ListItemButton';\n10\timport ListItemIcon from '@mui/material/ListItemIcon';\n11\timport ListItemText from '@mui/material/ListItemText';\n12\timport IconButton from '@mui/material/IconButton';\n13\timport Typography from '@mui/material/Typography';\n14\timport Tooltip from '@mui/material/Tooltip';\n15\timport Avatar from '@mui/material/Avatar';\n16\timport Menu from '@mui/material/Menu';\n17\timport MenuItem from '@mui/material/MenuItem';\n18\timport Divider from '@mui/material/Divider';\n19\timport Chip from '@mui/material/Chip';\n20\timport Badge from '@mui/material/Badge';\n21\timport useMediaQuery from '@mui/material/useMediaQuery';\n22\timport { useTheme, useColorScheme } from '@mui/material/styles';\n23\timport Link from 'next/link';\n24\timport { usePathname } from 'next/navigation';\n25\timport MenuIcon from '@mui/icons-material/Menu';\n26\timport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\n27\timport ChevronRightIcon from '@mui/icons-material/ChevronRight';\n28\timport LightModeIcon from '@mui/icons-material/LightMode';\n29\timport DarkModeIcon from '@mui/icons-material/DarkMode';\n30\timport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\n31\timport PersonOutlineIcon from '@mui/icons-material/PersonOutline';\n32\timport LogoutIcon from '@mui/icons-material/Logout';\n33\timport { navigationForRole, type Role } from '@/config/navigation';\n34\timport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\n35\t\n36\tconst DRAWER_WIDTH_EXPANDED = 256;\n37\tconst DRAWER_WIDTH_COLLAPSED = 64;\n38\tconst COLLAPSE_STORAGE_KEY = 'schoolhub.sidebar.collapsed';\n39\t\n40\t// Placeholder user until PRD-01 wires real auth (FR-33's \"for later wiring\" note).\n41\tconst PLACEHOLDER_USER: { id: string; name: string; role: Role } = {\n42\t  id: 'placeholder-user',\n43\t  name: 'Guest User',\n44\t  role: 'ADMIN',\n45\t};\n46\t\n47\texport interface AppShellProps {\n48\t  schoolShortName: string;\n49\t  children: React.ReactNode;\n50\t}\n51\t\n52\tconst DESKTOP_BREAKPOINT_PX = 1024;\n53\t\n54\texport function AppShell({ schoolShortName, children }: AppShellProps) {\n55\t  const theme = useTheme();\n56\t  const { mode, setMode } = useColorScheme();\n57\t  const pathname = usePathname();\n58\t  // FR-31/NFR-4 fix the fork at exactly 1024px — MUI's own \"lg\" breakpoint\n59\t  // (1200px) doesn't match that, so this uses an explicit media query.\n60\t  const isDesktop = useMediaQuery(`(min-width:${DESKTOP_BREAKPOINT_PX}px)`);\n61\t\n62\t  const [collapsed, setCollapsed] = useState(false);\n63\t  const [mobileOpen, setMobileOpen] = useState(false);\n64\t  const [menuAnchor, setMenuAnchor] = useState<HTMLElement | null>(null);\n65\t\n66\t  useEffect(() => {\n67\t    const stored = window.localStorage.getItem(COLLAPSE_STORAGE_KEY);\n68\t    if (stored === 'true') setCollapsed(true);\n69\t  }, []);\n70\t\n71\t  const toggleCollapsed = () => {\n72\t    setCollapsed((prev) => {\n73\t      const next = !prev;\n74\t      window.localStorage.setItem(COLLAPSE_STORAGE_KEY, String(next));\n75\t      return next;\n76\t    });\n77\t  };\n78\t\n79\t  const drawerWidth = collapsed ? DRAWER_WIDTH_COLLAPSED : DRAWER_WIDTH_EXPANDED;\n80\t  const items = navigationForRole(PLACEHOLDER_USER.role);\n81\t\n82\t  const navList = (\n83\t    <List sx={{ pt: 1 }}>\n84\t      {items.map((item) => {\n85\t        const Icon = item.icon;\n86\t        const active = pathname === item.href || pathname.startsWith(`${item.href}/`);\n87\t        const button = (\n88\t          <ListItemButton\n89\t            key={item.href}\n90\t            component={Link}\n91\t            href={item.href}\n92\t            selected={active}\n93\t            onClick={() => setMobileOpen(false)}\n94\t            sx={{ justifyContent: collapsed && isDesktop ? 'center' : 'flex-start' }}\n95\t          >\n96\t            <ListItemIcon sx={{ minWidth: collapsed && isDesktop ? 0 : 40, justifyContent: 'center' }}>\n97\t              <Icon />\n98\t            </ListItemIcon>\n99\t            {!(collapsed && isDesktop) && <ListItemText primary={item.label} />}\n100\t          </ListItemButton>\n101\t        );\n102\t        return collapsed && isDesktop ? (\n103\t          <Tooltip key={item.href} title={item.label} placement=\"right\">\n104\t            {button}\n105\t          </Tooltip>\n106\t        ) : (\n107\t          button\n108\t        );\n109\t      })}\n110\t    </List>\n111\t  );\n112\t\n113\t  return (\n114\t    <Box sx={{ display: 'flex', minHeight: '100vh' }}>\n115\t      <AppBar\n116\t        position=\"fixed\"\n117\t        sx={{\n118\t          zIndex: (t) => t.zIndex.drawer + 1,\n119\t          ...(isDesktop\n120\t            ? { width: `calc(100% - ${drawerWidth}px)`, ml: `${drawerWidth}px` }\n121\t            : {}),\n122\t        }}\n123\t      >\n124\t        <Toolbar sx={{ gap: 1 }}>\n125\t          {!isDesktop && (\n126\t            <IconButton\n127\t              color=\"inherit\"\n128\t              aria-label=\"Open navigation\"\n129\t              edge=\"start\"\n130\t              onClick={() => setMobileOpen(true)}\n131\t            >\n132\t              <MenuIcon />\n133\t            </IconButton>\n134\t          )}\n135\t          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n136\t            {schoolShortName}\n137\t          </Typography>\n138\t\n139\t          <Tooltip title=\"Notifications\">\n140\t            <IconButton color=\"inherit\" aria-label=\"Notifications\">\n141\t              <Badge badgeContent={0} color=\"error\">\n142\t                <NotificationsNoneIcon />\n143\t              </Badge>\n144\t            </IconButton>\n145\t          </Tooltip>\n146\t\n147\t          <Tooltip title={mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}>\n148\t            <IconButton\n149\t              color=\"inherit\"\n150\t              aria-label=\"Toggle color mode\"\n151\t              onClick={() => setMode(mode === 'dark' ? 'light' : 'dark')}\n152\t            >\n153\t              {mode === 'dark' ? <LightModeIcon /> : <DarkModeIcon />}\n154\t            </IconButton>\n155\t          </Tooltip>\n156\t\n157\t          <IconButton onClick={(event) => setMenuAnchor(event.currentTarget)} aria-label=\"User menu\">\n158\t            <UserAvatar userId={PLACEHOLDER_USER.id} name={PLACEHOLDER_USER.name} size={32} />\n159\t          </IconButton>\n160\t          <Menu anchorEl={menuAnchor} open={Boolean(menuAnchor)} onClose={() => setMenuAnchor(null)}>\n161\t            <Box sx={{ px: 2, py: 1 }}>\n162\t              <Typography variant=\"subtitle2\">{PLACEHOLDER_USER.name}</Typography>\n163\t              <Chip size=\"small\" label={PLACEHOLDER_USER.role} sx={{ mt: 0.5 }} />\n164\t            </Box>\n165\t            <Divider />\n166\t            <MenuItem onClick={() => setMenuAnchor(null)}>\n167\t              <PersonOutlineIcon fontSize=\"small\" sx={{ mr: 1 }} /> Profile\n168\t            </MenuItem>\n169\t            <MenuItem onClick={() => setMenuAnchor(null)}>\n170\t              <LogoutIcon fontSize=\"small\" sx={{ mr: 1 }} /> Sign out\n171\t            </MenuItem>\n172\t          </Menu>\n173\t        </Toolbar>\n174\t      </AppBar>\n175\t\n176\t      {isDesktop ? (\n177\t        <Drawer\n178\t          variant=\"permanent\"\n179\t          sx={{\n180\t            width: drawerWidth,\n181\t            flexShrink: 0,\n182\t            [`& .MuiDrawer-paper`]: { width: drawerWidth, boxSizing: 'border-box', overflowX: 'hidden' },\n183\t          }}\n184\t        >\n185\t          <Toolbar />\n186\t          {navList}\n187\t          <Box sx={{ mt: 'auto', display: 'flex', justifyContent: 'flex-end', p: 1 }}>\n188\t            <IconButton onClick={toggleCollapsed} aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}>\n189\t              {collapsed ? <ChevronRightIcon /> : <ChevronLeftIcon />}\n190\t            </IconButton>\n191\t          </Box>\n192\t        </Drawer>\n193\t      ) : (\n194\t        <Drawer\n195\t          variant=\"temporary\"\n196\t          open={mobileOpen}\n197\t          onClose={() => setMobileOpen(false)}\n198\t          ModalProps={{ keepMounted: true }}\n199\t          sx={{ [`& .MuiDrawer-paper`]: { width: DRAWER_WIDTH_EXPANDED, boxSizing: 'border-box' } }}\n200\t        >\n201\t          <Toolbar />\n202\t          {navList}\n203\t        </Drawer>\n204\t      )}\n205\t\n206\t      <Box\n207\t        component=\"main\"\n208\t        sx={{\n209\t          flexGrow: 1,\n210\t          p: 3,\n211\t          width: isDesktop ? `calc(100% - ${drawerWidth}px)` : '100%',\n212\t        }}\n213\t      >\n214\t        <Toolbar />\n215\t        {children}\n216\t      </Box>\n217\t    </Box>\n218\t  );\n219\t}\n220\t"}]},"parent_tool_use_id":null,"session_id":"97520f4c-ae80-4db0-b68a-6ea625258a9f","uuid":"6ec493c0-318b-405d-953a-d53ecc7d3d2c","timestamp":"2026-10-16T17:36:44.971Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/app/(app)/shell.tsx","content":"'use client';\n\nimport { useEffect, useState } from 'react';\nimport Box from '@mui/material/Box';\nimport AppBar from '@mui/material/AppBar';\nimport Toolbar from '@mui/material/Toolbar';\nimport Drawer from '@mui/material/Drawer';\nimport List from '@mui/material/List';\nimport ListItemButton from '@mui/material/ListItemButton';\nimport ListItemIcon from '@mui/material/ListItemIcon';\nimport ListItemText from '@mui/material/ListItemText';\nimport IconButton from '@mui/material/IconButton';\nimport Typography from '@mui/material/Typography';\nimport Tooltip from '@mui/material/Tooltip';\nimport Avatar from '@mui/material/Avatar';\nimport Menu from '@mui/material/Menu';\nimport MenuItem from '@mui/material/MenuItem';\nimport Divider from '@mui/material/Divider';\nimport Chip from '@mui/material/Chip';\nimport Badge from '@mui/material/Badge';\nimport useMediaQuery from '@mui/material/useMediaQuery';\nimport { useTheme, useColorScheme } from '@mui/material/styles';\nimport Link from 'next/link';\nimport { usePathname } from 'next/navigation';\nimport MenuIcon from '@mui/icons-material/Menu';\nimport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\nimport ChevronRightIcon from '@mui/icons-material/ChevronRight';\nimport LightModeIcon from '@mui/icons-material/LightMode';\nimport DarkModeIcon from '@mui/icons-material/DarkMode';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport PersonOutlineIcon from '@mui/icons-material/PersonOutline';\nimport LogoutIcon from '@mui/icons-material/Logout';\nimport { navigationForRole, type Role } from '@/config/navigation';\nimport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\n\nconst DRAWER_WIDTH_EXPANDED = 256;\nconst DRAWER_WIDTH_COLLAPSED = 64;\nconst COLLAPSE_STORAGE_KEY = 'schoolhub.sidebar.collapsed';\n\n// Placeholder user until PRD-01 wires real auth (FR-33's \"for later wiring\" note).\nconst PLACEHOLDER_USER: { id: string; name: string; role: Role } = {\n  id: 'placeholder-user',\n  name: 'Guest User',\n  role: 'ADMIN',\n};\n\nexport interface AppShellProps {\n  schoolShortName: string;\n  children: React.ReactNode;\n}\n\nconst DESKTOP_BREAKPOINT_PX = 1024;\n\nexport function AppShell({ schoolShortName, children }: AppShellProps) {\n  const theme = useTheme();\n  const { mode, setMode } = useColorScheme();\n  const pathname = usePathname();\n  // FR-31/NFR-4 fix the fork at exactly 1024px — MUI's own \"lg\" breakpoint\n  // (1200px) doesn't match that, so this uses an explicit media query.\n  const isDesktop = useMediaQuery(`(min-width:${DESKTOP_BREAKPOINT_PX}px)`);\n\n  const [collapsed, setCollapsed] = useState(false);\n  const [mobileOpen, setMobileOpen] = useState(false);\n  const [menuAnchor, setMenuAnchor] = useState<HTMLElement | null>(null);\n\n  useEffect(() => {\n    const stored = window.localStorage.getItem(COLLAPSE_STORAGE_KEY);\n    if (stored === 'true') setCollapsed(true);\n  }, []);\n\n  const toggleCollapsed = () => {\n    setCollapsed((prev) => {\n      const next = !prev;\n      window.localStorage.setItem(COLLAPSE_STORAGE_KEY, String(next));\n      return next;\n    });\n  };\n\n  const drawerWidth = collapsed ? DRAWER_WIDTH_COLLAPSED : DRAWER_WIDTH_EXPANDED;\n  const items = navigationForRole(PLACEHOLDER_USER.role);\n\n  const navList = (\n    <List sx={{ pt: 1 }}>\n      {items.map((item) => {\n        const Icon = item.icon;\n        const active = pathname === item.href || pathname.startsWith(`${item.href}/`);\n        const button = (\n          <ListItemButton\n            key={item.href}\n            component={Link}\n            href={item.href}\n            selected={active}\n            onClick={() => setMobileOpen(false)}\n            sx={{ justifyContent: collapsed && isDesktop ? 'center' : 'flex-start' }}\n          >\n            <ListItemIcon sx={{ minWidth: collapsed && isDesktop ? 0 : 40, justifyContent: 'center' }}>\n              <Icon />\n            </ListItemIcon>\n            {!(collapsed && isDesktop) && <ListItemText primary={item.label} />}\n          </ListItemButton>\n        );\n        return collapsed && isDesktop ? (\n          <Tooltip key={item.href} title={item.label} placement=\"right\">\n            {button}\n          </Tooltip>\n        ) : (\n          button\n        );\n      })}\n    </List>\n  );\n\n  return (\n    <Box sx={{ display: 'flex', minHeight: '100vh' }}>\n      <AppBar\n        position=\"fixed\"\n        sx={{\n          zIndex: (t) => t.zIndex.drawer + 1,\n          ...(isDesktop\n            ? { width: `calc(100% - ${drawerWidth}px)`, ml: `${drawerWidth}px` }\n            : {}),\n        }}\n      >\n        <Toolbar sx={{ gap: 1 }}>\n          {!isDesktop && (\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Open navigation\"\n              edge=\"start\"\n              onClick={() => setMobileOpen(true)}\n            >\n              <MenuIcon />\n            </IconButton>\n          )}\n          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n            {schoolShortName}\n          </Typography>\n\n          <Tooltip title=\"Notifications\">\n            <IconButton color=\"inherit\" aria-label=\"Notifications\">\n              <Badge badgeContent={0} color=\"error\">\n                <NotificationsNoneIcon />\n              </Badge>\n            </IconButton>\n          </Tooltip>\n\n          <Tooltip title={mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}>\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Toggle color mode\"\n              onClick={() => setMode(mode === 'dark' ? 'light' : 'dark')}\n            >\n              {mode === 'dark' ? <LightModeIcon /> : <DarkModeIcon />}\n            </IconButton>\n          </Tooltip>\n\n          <IconButton onClick={(event) => setMenuAnchor(event.currentTarget)} aria-label=\"User menu\">\n            <UserAvatar userId={PLACEHOLDER_USER.id} name={PLACEHOLDER_USER.name} size={32} />\n          </IconButton>\n          <Menu anchorEl={menuAnchor} open={Boolean(menuAnchor)} onClose={() => setMenuAnchor(null)}>\n            <Box sx={{ px: 2, py: 1 }}>\n              <Typography variant=\"subtitle2\">{PLACEHOLDER_USER.name}</Typography>\n              <Chip size=\"small\" label={PLACEHOLDER_USER.role} sx={{ mt: 0.5 }} />\n            </Box>\n            <Divider />\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <PersonOutlineIcon fontSize=\"small\" sx={{ mr: 1 }} /> Profile\n            </MenuItem>\n            <MenuItem onClick={() => setMenuAnchor(null)}>\n              <LogoutIcon fontSize=\"small\" sx={{ mr: 1 }} /> Sign out\n            </MenuItem>\n          </Menu>\n        </Toolbar>\n      </AppBar>\n\n      {isDesktop ? (\n        <Drawer\n          variant=\"permanent\"\n          sx={{\n            width: drawerWidth,\n            flexShrink: 0,\n            [`& .MuiDrawer-paper`]: { width: drawerWidth, boxSizing: 'border-box', overflowX: 'hidden' },\n          }}\n        >\n          <Toolbar />\n          {navList}\n          <Box sx={{ mt: 'auto', display: 'flex', justifyContent: 'flex-end', p: 1 }}>\n            <IconButton onClick={toggleCollapsed} aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}>\n              {collapsed ? <ChevronRightIcon /> : <ChevronLeftIcon />}\n            </IconButton>\n          </Box>\n        </Drawer>\n      ) : (\n        <Drawer\n          variant=\"temporary\"\n          open={mobileOpen}\n          onClose={() => setMobileOpen(false)}\n          ModalProps={{ keepMounted: true }}\n          sx={{ [`& .MuiDrawer-paper`]: { width: DRAWER_WIDTH_EXPANDED, boxSizing: 'border-box' } }}\n        >\n          <Toolbar />\n          {navList}\n        </Drawer>\n      )}\n\n      <Box\n        component=\"main\"\n        sx={{\n          flexGrow: 1,\n          p: 3,\n          width: isDesktop ? `calc(100% - ${drawerWidth}px)` : '100%',\n        }}\n      >\n        <Toolbar />\n        {children}\n      </Box>\n    </Box>\n  );\n}\n","numLines":220,"startLine":1,"totalLines":220}}}
