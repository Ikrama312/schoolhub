{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014QyZc27wv6YzHwdRgviMEF","type":"tool_result","content":"// ---------------------------------------------------------------------------\n\n/// Generic uploaded file (FR-1). Bytes live under UPLOAD_DIR; access goes\n/// through src/server/files/access.ts. contextId null = unattached (purged after 24 h).\nmodel FileObject {\n  id                String             @id @default(cuid())\n  ownerId           String\n  owner             User               @relation(fields: [ownerId], references: [id])\n  originalName      String\n  mimeType          String\n  sizeBytes         Int\n  storageKey        String             @unique\n  sha256            String\n  context           String\n  contextId         String?\n  createdAt         DateTime           @default(now())\n  lessonAttachments LessonAttachment[]\n\n  @@index([context, contextId])\n}\n\nenum ContentStatus {\n  DRAFT\n  SCHEDULED\n  PUBLISHED\n}\n\nmodel Module {\n  id          String        @id @default(cuid())\n  courseId    String\n  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  title       String\n  description String?\n  order       Int\n  status      ContentStatus @default(DRAFT)\n  publishAt   DateTime?\n  createdAt   DateTime      @default(now())\n  updatedAt   DateTime      @updatedAt\n  lessons     Lesson[]\n\n  @@index([courseId, order])\n}\n\nmodel Lesson {\n  id               String             @id @default(cuid())\n  moduleId         String\n  module           Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)\n  title            String\n  contentMarkdown  String             @default(\"\")\n  videoUrl         String?\n  estimatedMinutes Int?\n  order            Int\n  status           ContentStatus      @default(DRAFT)\n  publishAt        DateTime?\n  createdAt        DateTime           @default(now())\n  updatedAt        DateTime           @updatedAt\n  attachments      LessonAttachment[]\n  links            LessonLink[]\n  progress         LessonProgress[]\n\n  @@index([moduleId, order])\n}\n\n/// file has no onDelete -> Restrict: an attached file can't be hard-deleted (FR-11).\nmodel LessonAttachment {\n  id       String     @id @default(cuid())\n  lessonId String\n  lesson   Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n  fileId   String\n  file     FileObject @relation(fields: [fileId], references: [id])\n  order    Int\n}\n\nmodel LessonLink {\n  id       String @id @default(cuid())\n  lessonId String\n  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n  title    String\n  url      String\n  order    Int\n}\n\nmodel LessonProgress {\n  lessonId      String\n  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n  studentId     String\n  firstViewedAt DateTime  @default(now())\n  completedAt   DateTime?\n\n  @@id([lessonId, studentId])\n}\nsrc/app/(app)/layout.tsx\nsrc/app/(app)/shell.tsx\n\nsrc/app/(app)/account:\nnotifications\nsecurity\n\nsrc/app/(app)/admin:\nattendance\ncourses\nemail-log\nsections\n\nsrc/app/(app)/attendance:\ntake\n\nsrc/app/(app)/courses:\n[courseId]\n\nsrc/app/(app)/courses/[courseId]:\nattendance\nCourseTabs.tsx\nlayout.tsx\npage.tsx\nroster\n\nsrc/app/(app)/dashboard:\npage.tsx\n\nsrc/app/(app)/my-courses:\npage.tsx\n\nsrc/app/(app)/notifications:\nNotificationsList.tsx\npage.tsx\n\nsrc/app/(app)/students:\n[id]\n\nsrc/app/(app)/students/[id]:\nattendance\ncourses\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { AppError } from '@/server/http';\nimport { getCourse } from '@/server/courses/courses-service';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { CourseTabs } from './CourseTabs';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course home shell — PRD-05 FR-16/FR-18. Gate once here; tabs inherit it. */\nexport default async function CourseLayout({\n  params,\n  children,\n}: {\n  params: { courseId: string };\n  children: React.ReactNode;\n}) {\n  const user = await requirePageRole(...ALL_ROLES);\n  try {\n    await assertCanViewCourse(user, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const course = await getCourse(params.courseId);\n  const teachers = [course.teacher, ...course.coTeachers].map((t) => t.name).join(', ');\n\n  return (\n    <Box>\n      <Paper variant=\"outlined\" sx={{ mb: 2, overflow: 'hidden' }}>\n        <Box sx={{ height: 8, bgcolor: course.subject.color }} />\n        <Box sx={{ p: 2 }}>\n          <Typography variant=\"h5\" component=\"h1\" sx={{ fontWeight: 600 }}>\n            {course.name}\n          </Typography>\n          <Stack direction=\"row\" spacing={2} sx={{ mt: 0.5, flexWrap: 'wrap', color: 'text.secondary' }} useFlexGap>\n            <Typography variant=\"body2\">{course.code}</Typography>\n            <Typography variant=\"body2\">Teachers: {teachers}</Typography>\n            {course.section && <Typography variant=\"body2\">Section {course.section.name}</Typography>}\n            {course.section?.room && <Typography variant=\"body2\">Room {course.section.room.name}</Typography>}\n          </Stack>\n        </Box>\n      </Paper>\n      <CourseTabs courseId={course.id} role={user.role} />\n      {children}\n    </Box>\n  );\n}\nsrc/components/ConfirmDialog:\nConfirmDialog.tsx\n\nsrc/components/DataTable:\nDataTable.tsx\n\nsrc/components/DateDisplay:\nDateDisplay.tsx\n\nsrc