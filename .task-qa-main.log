{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PPJwX1g26dcg3AqueB616g","type":"tool_result","content":"1\timport { prisma } from '@/server/db';\n2\timport { AppError } from '@/server/http';\n3\timport { getAccessibleStudentIds, type AccessUser } from '@/server/auth/student-access';\n4\t\n5\t/**\n6\t * PRD-11 report card access (FR-32, FR-37, NFR-5, NFR-6). Anyone who may not see a card gets\n7\t * NOT_FOUND, so a 7B student cannot tell that Sam's card exists (AC-7).\n8\t */\n9\t\n10\texport const reportCardNotFound = () => new AppError('NOT_FOUND', 'Report card not found');\n11\t\n12\t/** ADMIN; teachers of the student or their homeroom teacher; the student / linked parent once PUBLISHED. */\n13\texport async function canViewReportCard(user: AccessUser, card: { studentId: string; status: 'DRAFT' | 'PUBLISHED' }): Promise<boolean> {\n14\t  if (user.role === 'ADMIN') return true;\n15\t  if ((user.role === 'STUDENT' || user.role === 'PARENT') && card.status !== 'PUBLISHED') return false;\n16\t  const ids = await getAccessibleStudentIds(user);\n17\t  return ids === 'ALL' || ids.includes(card.studentId);\n18\t}\n19\t\n20\texport async function assertCanViewReportCard(user: AccessUser, card: { studentId: string; status: 'DRAFT' | 'PUBLISHED' }) {\n21\t  if (!(await canViewReportCard(user, card))) throw reportCardNotFound();\n22\t}\n23\t\n24\t/** ADMIN, or the homeroom teacher of the student's section in the card's academic year. */\n25\texport async function canEditHomeroomComment(user: AccessUser, studentId: string, academicYearId: string): Promise<boolean> {\n26\t  if (user.role === 'ADMIN') return true;\n27\t  if (user.role !== 'TEACHER') return false;\n28\t  const m = await prisma.sectionMember.findFirst({\n29\t    where: { studentId, academicYearId, section: { homeroomTeacherId: user.id } },\n30\t    select: { id: true },\n31\t  });\n32\t  return !!m;\n33\t}\n34\t"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"0d27ce7e-2364-44eb-9141-e9846e27ba5e","timestamp":"2026-11-09T14:01:52.465Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/report-cards/access.ts","content":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { getAccessibleStudentIds, type AccessUser } from '@/server/auth/student-access';\n\n/**\n * PRD-11 report card access (FR-32, FR-37, NFR-5, NFR-6). Anyone who may not see a card gets\n * NOT_FOUND, so a 7B student cannot tell that Sam's card exists (AC-7).\n */\n\nexport const reportCardNotFound = () => new AppError('NOT_FOUND', 'Report card not found');\n\n/** ADMIN; teachers of the student or their homeroom teacher; the student / linked parent once PUBLISHED. */\nexport async function canViewReportCard(user: AccessUser, card: { studentId: string; status: 'DRAFT' | 'PUBLISHED' }): Promise<boolean> {\n  if (user.role === 'ADMIN') return true;\n  if ((user.role === 'STUDENT' || user.role === 'PARENT') && card.status !== 'PUBLISHED') return false;\n  const ids = await getAccessibleStudentIds(user);\n  return ids === 'ALL' || ids.includes(card.studentId);\n}\n\nexport async function assertCanViewReportCard(user: AccessUser, card: { studentId: string; status: 'DRAFT' | 'PUBLISHED' }) {\n  if (!(await canViewReportCard(user, card))) throw reportCardNotFound();\n}\n\n/** ADMIN, or the homeroom teacher of the student's section in the card's academic year. */\nexport async function canEditHomeroomComment(user: AccessUser, studentId: string, academicYearId: string): Promise<boolean> {\n  if (user.role === 'ADMIN') return true;\n  if (user.role !== 'TEACHER') return false;\n  const m = await prisma.sectionMember.findFirst({\n    where: { studentId, academicYearId, section: { homeroomTeacherId: user.id } },\n    select: { id: true },\n  });\n  return !!m;\n}\n","numLines":34,"startLine":1,"totalLines":34}},"tool_result_meta":[{"id":"toolu_01PPJwX1g26dcg3AqueB616g","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
