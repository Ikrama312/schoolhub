{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018F7SQ83Xgo15rWYNvaa41E","type":"tool_result","content":"total 32\ndrwxr-xr-x   5 ikramaansari  staff   160 Nov  4 11:55 .\ndrwxr-xr-x  15 ikramaansari  staff   480 Nov  4 20:02 ..\n-rw-r--r--   1 ikramaansari  staff   243 Nov  4 11:55 index.ts\n-rw-r--r--   1 ikramaansari  staff  1598 Nov  4 11:54 PasswordChecklist.tsx\n-rw-r--r--   1 ikramaansari  staff  5155 Nov  4 11:55 SetPasswordForm.tsx\n     1\texport { PasswordChecklist, type PasswordChecklistProps } from './PasswordChecklist';\n     2\texport {\n     3\t  SetPasswordForm,\n     4\t  postJson,\n     5\t  applyFieldErrors,\n     6\t  passwordInputSlot,\n     7\t  type SetPasswordFormProps,\n     8\t  type ApiFailure,\n     9\t} from './SetPasswordForm';\n     1\t'use client';\n     2\t\n     3\timport List from '@mui/material/List';\n     4\timport ListItem from '@mui/material/ListItem';\n     5\timport ListItemIcon from '@mui/material/ListItemIcon';\n     6\timport ListItemText from '@mui/material/ListItemText';\n     7\timport CheckCircleIcon from '@mui/icons-material/CheckCircle';\n     8\timport RadioButtonUncheckedIcon from '@mui/icons-material/RadioButtonUnchecked';\n     9\timport { PASSWORD_RULES, passwordChecks, type PasswordCheckResult } from '@/lib/validators/auth';\n    10\t\n    11\texport interface PasswordChecklistProps {\n    12\t  password: string;\n    13\t  email: string;\n    14\t}\n    15\t\n    16\t/** Live password-rule checklist (FR-17). The common-password rule is server-only. */\n    17\texport function PasswordChecklist({ password, email }: PasswordChecklistProps) {\n    18\t  const checks = passwordChecks(password, email);\n    19\t  return (\n    20\t    <List dense disablePadding aria-label=\"Password requirements\">\n    21\t      {(Object.keys(PASSWORD_RULES) as (keyof PasswordCheckResult)[]).map((key) => {\n    22\t        const met = checks[key];\n    23\t        return (\n    24\t          <ListItem key={key} disableGutters>\n    25\t            <ListItemIcon sx={{ minWidth: 32 }}>\n    26\t              {met ? (\n    27\t                <CheckCircleIcon fontSize=\"small\" color=\"success\" titleAccess=\"Met\" />\n    28\t              ) : (\n    29\t                <RadioButtonUncheckedIcon fontSize=\"small\" color=\"disabled\" titleAccess=\"Not met\" />\n    30\t              )}\n    31\t            </ListItemIcon>\n    32\t            <ListItemText\n    33\t              primary={PASSWORD_RULES[key].label}\n    34\t              slotProps={{ primary: { variant: 'body2', color: met ? 'text.primary' : 'text.secondary' } }}\n    35\t            />\n    36\t          </ListItem>\n    37\t        );\n    38\t      })}\n    39\t    </List>\n    40\t  );\n    41\t}\n     1\t'use client';\n     2\t\n     3\timport { useState } from 'react';\n     4\timport { useForm, type FieldValues, type Path, type UseFormSetError } from 'react-hook-form';\n     5\timport { zodResolver } from '@hookform/resolvers/zod';\n     6\timport Box from '@mui/material/Box';\n     7\timport Stack from '@mui/material/Stack';\n     8\timport TextField from '@mui/material/TextField';\n     9\timport Button from '@mui/material/Button';\n    10\timport Alert from '@mui/material/Alert';\n    11\timport InputAdornment from '@mui/material/InputAdornment';\n    12\timport IconButton from '@mui/material/IconButton';\n    13\timport Visibility from '@mui/icons-material/Visibility';\n    14\timport VisibilityOff from '@mui/icons-material/VisibilityOff';\n    15\timport { TextFormField } from '@/components/FormField/FormField';\n    16\timport { setPasswordSchema, type SetPasswordValues } from '@/lib/validators/auth';\n    17\timport { PasswordChecklist } from './PasswordChecklist';\n    18\t\n    19\t/** The API error envelope's body, or null on success. */\n    20\texport interface ApiFailure {\n    21\t  status: number;\n    22\t  code: string;\n    23\t  message: string;\n    24\t  fieldErrors?: Record<string, string[]>;\n    25\t}\n    26\t\n    27\t/** POST JSON to our own API; resolves to the parsed `data` or an ApiFailure. */\n    28\texport async function postJson<T = unknown>(url: string, body: unknown): Promise<{ data: T } | { error: ApiFailure }> {\n    29\t  try {\n    30\t    const res = await fetch(url, {\n    31\t      method: 'POST',\n    32\t      headers: { 'Content-Type': 'application/json' },\n    33\t      body: JSON.stringify(body),\n    34\t    });\n    35\t    const json = await res.json().catch(() => ({}));\n    36\t    if (res.ok) return { data: json.data as T };\n    37\t    return {\n    38\t      error: {\n    39\t        status: res.status,\n    40\t        code: json.error?.code ?? 'INTERNAL',\n    41\t        message: json.error?.message ?? 'Something went wrong. Please try again.',\n    42\t        fieldErrors: json.error?.details?.fieldErrors,\n    43\t      },\n    44\t    };\n    45\t  } catch {\n    46\t    return { error: { status: 0, code: 'NETWORK', message: 'Network error. Check your connection and try again.' } };\n    47\t  }\n    48\t}\n    49\t\n    50\t/** Maps server details.fieldErrors onto form fields; returns true if any field matched. */\n    51\texport function applyFieldErrors<T extends FieldValues>(\n    52\t  setError: UseFormSetError<T>,\n    53\t  fieldErrors: Record<string, string[]> | undefined,\n    54\t  fields: Path<T>[],\n    55\t): boolean {\n    56\t  let matched = false;\n    57\t  for (const field of fields) {\n    58\t    const messages = fieldErrors?.[field];\n    59\t    if (messages?.length) {\n    60\t      setError(field, { type: 'server', message: messages.join(' ') }, { shouldFocus: !matched });\n    61\t      matched = true;\n    62\t    }\n    63\t  }\n    64\t  return matched;\n    65\t}\n    66\t\n    67\t/** Visibility toggle for a password TextField (v9: slotProps.input). */\n    68\texport function passwordInputSlot(show: boolean, toggle: () => void) {\n    69\t  return {\n    70\t    input: {\n    71\t      endAdornment: (\n    72\t        <InputAdornment position=\"end\">\n    73\t          <IconButton aria-label={show ? 'Hide password' : 'Show password'} onClick={toggle} edge=\"end\">\n    74\t            {show ? <VisibilityOff /> : <Visibility />}\n    75\t          </IconButton>\n    76\t        </InputAdornment>\n    77\t      ),\n    78\t    },\n    79\t  };\n    80\t}\n    81\t\n    82\texport interface SetPasswordFormProps {\n    83\t  name?: string;\n    84\t  email: string;\n    85\t  submitLabel?: string;\n    86\t  /** Return an ApiFailure to show it; return nothing on success. */\n    87\t  onSubmit: (password: string, confirm: string) => Promise<ApiFailure | void>;\n    88\t}\n    89\t\n    90\t/** Shared set-password form for invite acceptance and password reset (FR-16, FR-21). */\n    91\texport function SetPasswordForm({ name, email, submitLabel = 'Set password', onSubmit }: SetPasswordFormProps) {\n    92\t  const [show, setShow] = useState(false);\n    93\t  const [formError, setFormError] = useState<string | null>(null);\n    94\t  const { control, handleSubmit, watch, setError, formState } = useForm<SetPasswordValues>({\n    95\t    resolver: zodResolver(setPasswordSchema(email)),\n    96\t    defaultValues: { password: '', confirm: '' },\n    97\t    shouldFocusError: true,\n    98\t  });\n    99\t\n   100\t  const submit = handleSubmit(async ({ password, confirm }) => {\n   101\t    setFormError(null);\n   102\t    const failure = await onSubmit(password, confirm);\n   103\t    if (!failure) return;\n   104\t    if (!applyFieldErrors(setError, failure.fieldErrors, ['password', 'confirm'])) setFormError(failure.message);\n   105\t  });\n   106\t\n   107\t  return (\n   108\t    <Box component=\"form\" noValidate onSubmit={submit}>\n   109\t      <Stack spacing={2}>\n   110\t        <Box aria-live=\"polite\">{formError && <Alert severity=\"error\">{formError}</Alert>}</Box>\n   111\t        {name && <TextField label=\"Name\