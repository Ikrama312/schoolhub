      await prisma.course.delete({ where: { id: big.id } });\n204\t      await prisma.user.deleteMany({ where: { id: { in: students.map((s) => s.id) } } });\n205\t    }\n206\t  });\n207\t});\n208\t"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"83b6f0e2-7f5f-41b7-bda8-e7ac1c35bc60","timestamp":"2026-11-09T14:20:25.256Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/tests/integration/gradebook/qa-sh11.test.ts","content":"  });\n\n  it('NFR-2: gradebook for 35 students × 80 items loads in under 800 ms', async () => {\n    const big = await prisma.course.create({ data: { name: `${MARK}-perf`, code: `${MARK}-perf`, academicYearId: ids.year, subjectId: ids.subject, teacherId: ids.teacher } });\n    await prisma.user.createMany({\n      data: Array.from({ length: 35 }, (_, i) => ({ email: `p${i}@${MARK}.test`, firstName: 'P', lastName: `P${String(i).padStart(2, '0')}`, role: 'STUDENT' as const, status: 'ACTIVE' as const })),\n    });\n    const students = await prisma.user.findMany({ where: { email: { endsWith: `@${MARK}.test`, startsWith: 'p' } }, select: { id: true } });\n    expect(students).toHaveLength(35);\n    await prisma.enrollment.createMany({ data: students.map((s) => ({ courseId: big.id, studentId: s.id })) });\n    await prisma.gradeItem.createMany({\n      data: Array.from({ length: 80 }, (_, i) => ({ courseId: big.id, termId: ids.term, title: `${MARK} perf ${i}`, maxPoints: '10', dueAt: new Date(Date.now() - DAY), source: 'MANUAL' as const })),\n    });\n    const items = await prisma.gradeItem.findMany({ where: { courseId: big.id }, select: { id: true } });\n    await prisma.grade.createMany({ data: items.flatMap((it, j) => students.map((s, k) => ({ gradeItemId: it.id, studentId: s.id, score: String((j + k) % 11), updatedById: ids.teacher }))) });\n\n    try {\n      await getGradebook(T(), big.id, ids.term); // warm-up (connection pool, JIT)\n      const t0 = performance.now();\n      const gb = await getGradebook(T(), big.id, ids.term);\n      const ms = performance.now() - t0;\n      expect(gb.rows).toHaveLength(35);\n      expect(gb.items).toHaveLength(80);\n      expect(ms).toBeLessThan(800);\n    } finally {\n      await prisma.course.delete({ where: { id: big.id } });\n      await prisma.user.deleteMany({ where: { id: { in: students.map((s) => s.id) } } });\n    }\n  });\n});\n","numLines":31,"startLine":178,"totalLines":208}},"tool_result_meta":[{"id":"toolu_01Lpqfxqybpzc99N44RDJryW","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
