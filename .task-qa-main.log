{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S3DdhpQZWQyD1GyegYDLuN","type":"tool_result","content":"1\timport { prisma } from '@/server/db';\n2\timport { AppError } from '@/server/http';\n3\timport { assertCanViewStudent, type AccessUser } from '@/server/auth/student-access';\n4\timport { fixed2 } from '@/server/assignments/grading-math';\n5\timport { computeCourseResult, loadCourseTermData } from './load';\n6\timport { gradeColour, itemPercent, UNCATEGORISED } from './grade-calc';\n7\timport { resolveTerm } from './gradebook-service';\n8\t\n9\t/**\n10\t * PRD-11 student/parent grades (FR-26–FR-28, FR-42, NFR-5). Only visible items are loaded (in the\n11\t * query) and the calculation runs over exactly those, so totals match what is shown. The output\n12\t * is a whitelist: no updatedById, no hidden items, no submission/attempt ids.\n13\t */\n14\t\n15\tasync function termsFor(termId: string | undefined) {\n16\t  if (termId) {\n17\t    const t = await prisma.term.findUnique({ where: { id: termId }, select: { academicYearId: true } });\n18\t    if (!t) throw new AppError('VALIDATION_ERROR', 'Unknown term.', { fieldErrors: { termId: ['Unknown term'] } });\n19\t    return prisma.term.findMany({ where: { academicYearId: t.academicYearId }, orderBy: { order: 'asc' } });\n20\t  }\n21\t  return prisma.term.findMany({ where: { academicYear: { isCurrent: true } }, orderBy: { order: 'asc' } });\n22\t}\n23\t\n24\texport async function getStudentGrades(user: AccessUser, studentId: string, termId?: string, courseId?: string) {\n25\t  await assertCanViewStudent(user, studentId);\n26\t  const student = await prisma.user.findFirst({ where: { id: studentId, role: 'STUDENT' }, select: { id: true, firstName: true, lastName: true } });\n27\t  if (!student) throw new AppError('NOT_FOUND', 'Student not found');\n28\t  const terms = await termsFor(termId);\n29\t  if (!terms.length) return { student, term: null, terms: [], courses: [] };\n30\t  const { term, terms: refs } = await resolveTerm(terms, termId);\n31\t\n32\t  const enrollments = await prisma.enrollment.findMany({\n33\t    where: { studentId, status: 'ACTIVE', course: { academicYearId: terms[0].academicYearId, ...(courseId ? { id: courseId } : {}) } },\n34\t    select: { course: { select: { id: true, code: true, name: true, teacher: { select: { firstName: true, lastName: true } } } } },\n35\t    orderBy: { course: { name: 'asc' } },\n36\t  });\n37\t  const courses = enrollments.map((e) => e.course);\n38\t  const data = await loadCourseTermData(courses.map((c) => c.id), term.id, [studentId], { visibleOnly: true });\n39\t  const now = new Date();\n40\t\n41\t  return {\n42\t    student,\n43\t    term,\n44\t    terms: refs,\n45\t    courses: courses.map((c) => {\n46\t      const result = computeCourseResult(data, c.id, studentId, now);\n47\t      const cats = new Map((data.categories.get(c.id) ?? []).map((x) => [x.id, x.name]));\n48\t      const dropped = new Set(result.categories.flatMap((x) => x.droppedItemIds));\n49\t      return {\n50\t        course: { id: c.id, code: c.code, name: c.name, teacherName: `${c.teacher.firstName} ${c.teacher.lastName}` },\n51\t        percent: result.percent,\n52\t        letter: result.letter,\n53\t        descriptor: result.descriptor,\n54\t        colour: gradeColour(result.percent),\n55\t        categories: result.categories,\n56\t        items: (data.items.get(c.id) ?? []).map((i) => {\n57\t          const g = data.grades.get(i.id)?.get(studentId);\n58\t          const categoryId = i.categoryId && cats.has(i.categoryId) ? i.categoryId : null;\n59\t          return {\n60\t            id: i.id,\n61\t            title: i.title,\n62\t            categoryId,\n63\t            categoryName: categoryId ? cats.get(categoryId)! : UNCATEGORISED,\n64\t            maxPoints: fixed2(i.maxPoints),\n65\t            dueAt: i.dueAt?.toISOString() ?? null,\n66\t            score: g?.score == null ? null : fixed2(g.score),\n67\t            percent: itemPercent(g?.score ?? null, i.maxPoints),\n68\t            comment: g?.comment ?? null,\n69\t            missing: g?.missing ?? false,\n70\t            excused: g?.excused ?? false,\n71\t            dropped: dropped.has(i.id),\n72\t          };\n73\t        }),\n74\t      };\n75\t    }),\n76\t  };\n77\t}\n78\texport type StudentGrades = Awaited<ReturnType<typeof getStudentGrades>>;\n79\t"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"d0754d00-6847-4789-b2f1-5fff12eea29d","timestamp":"2026-11-09T14:01:52.091Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/gradebook/student-grades-service.ts","content":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { assertCanViewStudent, type AccessUser } from '@/server/auth/student-access';\nimport { fixed2 } from '@/server/assignments/grading-math';\nimport { computeCourseResult, loadCourseTermData } from './load';\nimport { gradeColour, itemPercent, UNCATEGORISED } from './grade-calc';\nimport { resolveTerm } from './gradebook-service';\n\n/**\n * PRD-11 student/parent grades (FR-26–FR-28, FR-42, NFR-5). Only visible items are loaded (in the\n * query) and the calculation runs over exactly those, so totals match what is shown. The output\n * is a whitelist: no updatedById, no hidden items, no submission/attempt ids.\n */\n\nasync function termsFor(termId: string | undefined) {\n  if (termId) {\n    const t = await prisma.term.findUnique({ where: { id: termId }, select: { academicYearId: true } });\n    if (!t) throw new AppError('VALIDATION_ERROR', 'Unknown term.', { fieldErrors: { termId: ['Unknown term'] } });\n    return prisma.term.findMany({ where: { academicYearId: t.academicYearId }, orderBy: { order: 'asc' } });\n  }\n  return prisma.term.findMany({ where: { academicYear: { isCurrent: true } }, orderBy: { order: 'asc' } });\n}\n\nexport async function getStudentGrades(user: AccessUser, studentId: string, termId?: string, courseId?: string) {\n  await assertCanViewStudent(user, studentId);\n  const student = await prisma.user.findFirst({ where: { id: studentId, role: 'STUDENT' }, select: { id: true, firstName: true, lastName: true } });\n  if (!student) throw new AppError('NOT_FOUND', 'Student not found');\n  const terms = await termsFor(termId);\n  if (!terms.length) return { student, term: null, terms: [], courses: [] };\n  const { term, terms: refs } = await resolveTerm(terms, termId);\n\n  const enrollments = await prisma.enrollment.findMany({\n    where: { studentId, status: 'ACTIVE', course: { academicYearId: terms[0].academicYearId, ...(courseId ? { id: courseId } : {}) } },\n    select: { course: { select: { id: true, code: true, name: true, teacher: { select: { firstName: true, lastName: true } } } } },\n    orderBy: { course: { name: 'asc' } },\n  });\n  const courses = enrollments.map((e) => e.course);\n  const data = await loadCourseTermData(courses.map((c) => c.id), term.id, [studentId], { visibleOnly: true });\n  const now = new Date();\n\n  return {\n    student,\n    term,\n    terms: refs,\n    courses: courses.map((c) => {\n      const result = computeCourseResult(data, c.id, studentId, now);\n      const cats = new Map((data.categories.get(c.id) ?? []).map((x) => [x.id, x.name]));\n      const dropped = new Set(result.categories.flatMap((x) => x.droppedItemIds));\n      return {\n        course: { id: c.id, code: c.code, name: c.name, teacherName: `${c.teacher.firstName} ${c.teacher.lastName}` },\n        percent: result.percent,\n        letter: result.letter,\n        descriptor: result.descriptor,\n        colour: gradeColour(result.percent),\n        categories: result.categories,\n        items: (data.items.get(c.id) ?? []).map((i) => {\n          const g = data.grades.get(i.id)?.get(studentId);\n          const categoryId = i.categoryId && cats.has(i.categoryId) ? i.categoryId : null;\n          return {\n            id: i.id,\n            title: i.title,\n            categoryId,\n            categoryName: categoryId ? cats.get(categoryId)! : UNCATEGORISED,\n            maxPoints: fixed2(i.maxPoints),\n            dueAt: i.dueAt?.toISOString() ?? null,\n            score: g?.score == null ? null : fixed2(g.score),\n            percent: itemPercent(g?.score ?? null, i.maxPoints),\n            comment: g?.comment ?? null,\n            missing: g?.missing ?? false,\n            excused: g?.excused ?? false,\n            dropped: dropped.has(i.id),\n          };\n        }),\n      };\n    }),\n  };\n}\nexport type StudentGrades = Awaited<ReturnType<typeof getStudentGrades>>;\n","numLines":79,"startLine":1,"totalLines":79}},"tool_result_meta":[{"id":"toolu_01S3DdhpQZWQyD1GyegYDLuN","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
