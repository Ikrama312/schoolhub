eSchema = z.object({\nsrc/lib/validators/gradebook.ts:147:export type TermOverrideInput = z.output<typeof termOverrideSchema>;\nsrc/lib/validators/gradebook.ts:148:export type TermOverrideFormValues = z.input<typeof termOverrideSchema>;\nsrc/lib/validators/gradebook.ts:150:export const gradebookQuery = z.object({ termId: id.optional(), format: z.enum(['json', 'csv']).default('json') });\nsrc/lib/validators/gradebook.ts:151:export const studentGradesQuery = z.object({ termId: id.optional(), courseId: id.optional() });\nsrc/lib/validators/gradebook.ts:157:export const reportCardPatchSchema = z\nsrc/lib/validators/gradebook.ts:161:export type ReportCardPatch = z.output<typeof reportCardPatchSchema>;\nsrc/lib/validators/gradebook.ts:169:export const generateSchema = z.object({ termId: id, studentIds: idList });\nsrc/lib/validators/gradebook.ts:170:export const publishSchema = z.object({ ids: idList });\nsrc/lib/validators/gradebook.ts:171:export const unpublishSchema = z.object({ ids: idList, reason: z.string().trim().min(1, 'A reason is required').max(500) });\nsrc/lib/validators/gradebook.ts:173:export const reportCardsQuery = z.object({\n  return i ? prisma.grade.findUnique({ where: { gradeItemId_studentId: { gradeItemId: i.id, studentId } } }) : null;\n};\n\nasync function mkAssignment(extra: Record<string, unknown> = {}) {\n  const a = await createAssignment(\n    T(),\n    ids.course,\n    assignmentInput.parse({ title: `${MARK} hw`, submissionType: 'ONLINE_TEXT', maxPoints: 20, dueAt: new Date(Date.now() + DAY), status: 'PUBLISHED', ...extra }),\n  );\n  return a.id;\n}\n\nasync function mkQuiz(resultsVisibility: 'IMMEDIATELY' | 'AFTER_CLOSE' | 'MANUAL', extra: Record<string, unknown> = {}) {\n  const now = Date.now();\n  const q = await createQuiz(\n    T(),\n    ids.course,\n    quizSettingsSchema.parse({ title: `${MARK} quiz`, availableFrom: new Date(now - DAY), availableUntil: new Date(now + DAY), resultsVisibility, ...extra }),\n  );\n  await prisma.question.create({ data: { quizId: q.id, type: 'TRUE_FALSE', prompt: 'T?', points: '4', order: 0, correct: { value: true } } });\n  await prisma.question.create({ data: { quizId: q.id, type: 'TRUE_FALSE', prompt: 'F?', points: '1', order: 1, correct: { value: false } } });\n  await updateQuiz(T(), q.id, { status: 'PUBLISHED' });\n  return q.id;\n}\n\nasync function takeQuiz(quizId: string, studentId: string, answers: boolean[]) {\n  const { attempt } = await startOrResumeAttempt(S(studentId), quizId);\n  const qs = await prisma.question.findMany({ where: { quizId }, orderBy: { order: 'asc' } });\n  for (const [i, value] of answers.entries()) await saveAnswer(S(studentId), attempt.id, qs[i].id, { value });\n  await submitForStudent(S(studentId), attempt.id);\n}\n\ndescribe.skipIf(!process.env.TEST_DATABASE_URL)('gradebook sync (integration)', () => {\n  beforeAll(async () => {\n    const mk = (n: string, role: 'TEACHER' | 'STUDENT') =>\n      prisma.user.create({ data: { email: `${n}@${MARK}.test`, firstName: 'QA', lastName: n, role, status: 'ACTIVE' } }).then((u) => u.id);\n    Object.assign(ids, { teacher: await mk('teacher', 'TEACHER'), s1: await mk('s1', 'STUDENT'), s2: await mk('s2', 'STUDENT') });\n    const now = Date.now();\n    ids.year = (await prisma.academicYear.create({ data: { name: MARK, startDate: new Date(isoDay(now - 200 * DAY)), endDate: new Date(isoDay(now + 200 * DAY)) } })).id;\n    ids.term = (await prisma.term.create({ data: { academicYearId: ids.year, name: 'T1', order: 1, startDate: new Date(isoDay(now - 100 * DAY)), endDate: new Date(isoDay(now + 100 * DAY)) } })).id;\n    ids.subject = (await prisma.subject.create({ data: { name: MARK, code: MARK.toUpperCase() } })).id;\n    ids.course = (await prisma.course.create({ data: { name: MARK, code: MARK, academicYearId: ids.year, subjectId: ids.subject, teacherId: ids.teacher } })).id;\n    await prisma.enrollment.createMany({ data: [ids.s1, ids.s2].map((studentId) => ({ courseId: ids.course, studentId })) });\n  });\n\n  afterAll(async () => {\n    const users = [ids.teacher, ids.s1, ids.s2].filter(Boolean);\n    await prisma.course.deleteMany({ where: { code: MARK } });\n    await prisma.term.deleteMany({ where: { academicYearId: ids.year } });\n    await prisma.notification.deleteMany({ where: { userId: { in: users } } });\n    await prisma.auditLog.deleteMany({ where: { actorId: { in: users } } });\n    await prisma.user.deleteMany({ where: { id: { in: users } } });\n    await prisma.subject.deleteMany({ where: { code: MARK.toUpperCase() } });\n    await prisma.academicYear.deleteMany({ where: { name: MARK } });\n  });","is_error":false}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"212d9ef9-3536-4ad2-aa52-918facc6e555","timestamp":"2026-11-09T14:10:17.644Z","tool_use_result":{"stdout":"src/server/gradebook/backfill.ts:44:export async function backfillGradebook(now = new Date()): Promise<{ items: number; grades: number }> {\nsrc/server/gradebook/categories-service.ts:12:export const toCategoryDto = (c: GradeCategory) => ({\nsrc/server/gradebook/categories-service.ts:30:export async function getCategories(user: AccessUser, courseId: string) {\nsrc/server/gradebook/categories-service.ts:36:export async function replaceCategories(user: AccessUser, courseId: string, input: CategoriesPut, request?: Request) {\nsrc/server/gradebook/grade-calc.ts:6:export interface CalcItem {\nsrc/server/gradebook/grade-calc.ts:14:export interface CalcGrade {\nsrc/server/gradebook/grade-calc.ts:20:export interface CalcCategory {\nsrc/server/gradebook/grade-calc.ts:28:export interface CalcBand {\nsrc/server/gradebook/grade-calc.ts:35:export interface CalcOverride {\nsrc/server/gradebook/grade-calc.ts:41:export interface CategoryResult {\nsrc/server/gradebook/grade-calc.ts:51:export interface StudentTermResult {\nsrc/server/gradebook/grade-calc.ts:62:export const UNCATEGORISED = 'Uncategorised';\nsrc/server/gradebook/grade-calc.ts:67:export cons