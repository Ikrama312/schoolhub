{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RkPe9vuFahZvH1KouaAnEF","type":"tool_result","content":"40\t    if (e instanceof AppError) return { code: e.code, details: e.details };\n41\t    if (e instanceof Prisma.PrismaClientKnownRequestError) return { code: e.code };\n42\t    return { code: (e as Error).message };\n43\t  }\n44\t  return { code: 'OK' };\n45\t}\n46\t\n47\tdescribe.skipIf(!process.env.TEST_DATABASE_URL)('attendance-service (integration)', () => {\n48\t  beforeAll(async () => {\n49\t    const tz = (await prisma.schoolSettings.findUnique({ where: { id: 'singleton' } }))?.timezone ?? 'UTC';\n50\t    today = schoolToday(new Date(), tz);\n51\t    const mk = (n: string, role: 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT', lastName = n) =>\n52\t      prisma.user.create({ data: { email: email(n), firstName: 'QA', lastName, role, status: 'ACTIVE' } }).then((u) => u.id);\n53\t    Object.assign(ids, {\n54\t      teacher: await mk('teacher', 'TEACHER'),\n55\t      other: await mk('other', 'TEACHER'),\n56\t      admin: await mk('admin', 'ADMIN'),\n57\t      s1: await mk('s1', 'STUDENT', 'Alpha'),\n58\t      s2: await mk('s2', 'STUDENT', 'Beta'),\n59\t      late: await mk('late', 'STUDENT', 'Gamma'),\n60\t      gone: await mk('gone', 'STUDENT', 'Delta'),\n61\t      parent: await mk('parent', 'PARENT'),\n62\t    });\n63\t    await prisma.parentStudentLink.create({ data: { parentId: ids.parent, studentId: ids.s1, relationship: 'MOTHER', isPrimary: true } });\n64\t    const order = 9000 + Math.floor(Math.random() * 900);\n65\t    ids.year = (await prisma.academicYear.create({ data: { name: MARK, startDate: new Date('2026-01-01'), endDate: new Date('2027-12-31') } })).id;\n66\t    ids.grade = (await prisma.gradeLevel.create({ data: { name: MARK, shortName: MARK, order } })).id;\n67\t    ids.subject = (await prisma.subject.create({ data: { name: MARK, code: MARK.toUpperCase() } })).id;\n68\t    ids.period = (await prisma.period.create({ data: { name: MARK, startTime: '23:00', endTime: '23:30', order } })).id;\n69\t    ids.section = (await prisma.section.create({ data: { name: MARK, academicYearId: ids.year, gradeLevelId: ids.grade, homeroomTeacherId: ids.teacher } })).id;\n70\t    ids.course = (\n71\t      await prisma.course.create({\n72\t        data: { name: MARK, code: MARK, academicYearId: ids.year, subjectId: ids.subject, sectionId: ids.section, teacherId: ids.teacher },\n73\t      })\n74\t    ).id;\n75\t    const longAgo = new Date(Date.now() - 60 * 86_400_000);\n76\t    await prisma.enrollment.createMany({\n77\t      data: [\n78\t        { courseId: ids.course, studentId: ids.s1, enrolledAt: longAgo },\n79\t        { courseId: ids.course, studentId: ids.s2, enrolledAt: longAgo },\n80\t        // NFR-3: enrolled after today -> not on today's register.\n81\t        { courseId: ids.course, studentId: ids.late, enrolledAt: new Date(Date.now() + 3 * 86_400_000) },\n82\t        // Dropped long before today -> not on today's register.\n83\t        { courseId: ids.course, studentId: ids.gone, enrolledAt: longAgo, status: 'DROPPED', droppedAt: new Date(Date.now() - 30 * 86_400_000) },\n84\t      ],\n85\t    });\n86\t    await prisma.sectionMember.createMany({\n87\t      data: [ids.s1, ids.s2].map((studentId) => ({ sectionId: ids.section, studentId, academicYearId: ids.year })),\n88\t    });\n89\t  });\n90\t\n91\t  afterAll(async () => {\n92\t    const users = Object.entries(ids).filter(([k]) => ['teacher', 'other', 'admin', 's1', 's2', 'late', 'gone', 'parent'].includes(k)).map(([, v]) => v);\n93\t    await prisma.attendanceSession.deleteMany({ where: { OR: [{ courseId: ids.course }, { sectionId: ids.section }] } });\n94\t    await prisma.enrollment.deleteMany({ where: { courseId: ids.course } });\n95\t    await prisma.sectionMember.deleteMany({ where: { sectionId: ids.section } });\n96\t    await prisma.course.deleteMany({ where: { id: ids.course } });\n97\t    await prisma.section.deleteMany({ where: { id: ids.section } });\n98\t    await prisma.period.deleteMany({ where: { id: ids.period } });\n99\t    await prisma.subject.deleteMany({ where: { id: ids.subject } });\n100\t    await prisma.gradeLevel.deleteMany({ where: { id: ids.grade } });\n101\t    await prisma.academicYear.deleteMany({ where: { id: ids.year } });\n102\t    await prisma.emailOutbox.deleteMany({ where: { toEmail: { endsWith: `@${MARK}.test` } } });\n103\t    await prisma.auditLog.deleteMany({ where: { actorId: { in: users } } });\n104\t    await prisma.user.deleteMany({ where: { id: { in: users } } });\n105\t    await prisma.$disconnect();\n106\t  });\n107\t\n108\t  it('roster is the students active on the date (NFR-3, FR-9)', async () => {\n109\t    const reg = await getRegister(asTeacher(), courseKey());\n110\t    expect(reg.students.map((s) => s.id)).toEqual([ids.s1, ids.s2]); // sorted by last name\n111\t    expect(reg.sessionId).toBeNull();\n112\t    expect(reg.records).toEqual([]);\n113\t  });\n114\t\n115\t  it('rejects off-roster or incomplete records and writes nothing (atomic save)', async () => {\n116\t    const bad = await code(saveRegister(asTeacher(), courseKey(), [...all(), { studentId: ids.late, status: 'PRESENT' }]));\n117\t    expect(bad).toEqual({ code: 'VALIDATION_ERROR', details: { invalidStudentIds: [ids.late] } });\n118\t    const partial = await code(saveRegister(asTeacher(), courseKey(), [{ studentId: ids.s1, status: 'PRESENT' }]));\n119\t    expect(partial).toEqual({ code: 'VALIDATION_ERROR', details: { missingStudentIds: [ids.s2] } });\n120\t    expect(await prisma.attendanceSession.count({ where: { courseId: ids.course } })).toBe(0);\n121\t  });\n122\t\n123\t  it('EXCUSED is ADMIN-only (FR-10); other teachers are refused', async () => {\n124\t    expect((await code(saveRegister(asTeacher(), courseKey(), all('EXCUSED')))).code).toBe('FORBIDDEN');\n125\t    expect((await code(saveRegister({ id: ids.other, role: 'TEACHER' }, courseKey(), all()))).code).toBe('FORBIDDEN');\n126\t  });\n127\t\n128\t  it('saves once, notifies on transition only (FR-14, FR-21, FR-22)', async () => {\n129\t    const reg = await saveRegister(asTeacher(), courseKey(), all('ABSENT'));\n130\t    expect(reg.sessionId).not.toBeNull();\n131\t    expect(reg.updatedBy?.id).toBe(ids.teacher);\n132\t    const absentFor = () => prisma.notification.count({ where: { userId: { in: [ids.s1, ids.parent] }, type: 'attendance.absent' } });\n133\t    expect(await absentFor()).toBe(2); // student + linked parent\n134\t    await saveRegister(asTeacher(), courseKey(), all('ABSENT')); // no change\n135\t    expect(await absentFor()).toBe(2);\n136\t    await saveRegister(asTeacher(), courseKey(), all('PRESENT'));\n137\t    expect(await prisma.notification.count({ where: { userId: ids.s1, type: 'attendance.corrected' } })).toBe(1);\n138\t    expect(await prisma.attendanceSession.count({ where: { courseId: ids.course } })).toBe(1);\n139\t    expect(await prisma.auditLog.count({ where: { actorId: ids.teacher, action: 'attendance.record.update' } })).toBe(1);\n140\t  });\n141\t\n142\t  it('teacher edit window is 14 days; admin can edit older registers (FR-8, FR-19)', async () => {\n143\t    expect((await code(saveRegister(asTeacher(), courseKey(addDays(today, -15)), all()))).code).toBe('FORBIDDEN');\n144\t    expect((await code(getRegister(asTeacher(), courseKey(addDays(today, -15))))).code).toBe('FORBIDDEN');\n145\t    expect((await code(saveRegister(asTeacher(), courseKey(addDays(today, 1)), all()))).code).toBe('VALIDATION_ERROR');\n146\t    expect((await code(saveRegister(asAdmin(), courseKey(addDays(today, -15)), all('EXCUSED')))).code).toBe('OK');\n147\t  });\n148\t\n149\t  it('daily register: homeroom teacher only (FR-15)', async () => {\n150\t    const key = { sectionId: ids.section, date: today };\n151\t    expect((await code(saveRegister(asTeacher(), key, all()))).code).toBe('OK');\n152\t    expect((await code(getRegister({ id: ids.other, role: 'TEACHER' }, key))).code).toBe('FORBIDDEN');\n153\t  });\n154\t\n155\t  it('DB: CHECK one-of(courseId, sectionId) and both partial unique indexes (FR-2, FR-3)', async () => {\n156\t    const base = { date: new Date(`${today}T00:00:00Z`), takenById: ids.admin, updatedById: ids.admin };\n157\t    const both = prisma.attendanceSession.create({ data: { ...base, courseId: ids.course, sectionId: ids.section, periodId: ids.period } });\n158\t    expect((await code(both)).code).not.toBe('OK');\n159\t    expect((await code(prisma.attendanceSession.create({ data: base }))).code).not.toBe('OK');\n160\t    // Both registers for `today` already exist from earlier tests.\n161\t    expect((await code(prisma.attendanceSession.create({ data: { ...base, courseId: ids.course, periodId: ids.period } }))).code).toBe('P2002');\n162\t    expect((await code(prisma.attendanceSession.create({ data: { ...base, sectionId: ids.section } }))).code).toBe('P2002');\n163\t  });\n164\t});\n165\t"}]},"parent_tool_use_id":null,"session_id":"88405567-c8b9-4e5f-8912-47ba3c7edb01","uuid":"2ddcd471-33f9-4c4d-b07d-27bcaef31ecf","timestamp":"2026-11-06T06:07:43.567Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/tests/integration/attendance-service.test.ts","content":"    if (e instanceof AppError) return { code: e.code, details: e.details };\n    if (e instanceof Prisma.PrismaClientKnownRequestError) return { code: e.code };\n    return { code: (e as Error).message };\n  }\n  return { code: 'OK' };\n}\n\ndescribe.skipIf(!process.env.TEST_DATABASE_URL)('attendance-service (integration)', () => {\n  beforeAll(async () => {\n    const tz = (await prisma.schoolSettings.findUnique({ where: { id: 'singleton' } }))?.timezone ?? 'UTC';\n    today = schoolToday(new Date(), tz);\n    const mk = (n: string, role: 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT', lastName = n) =>\n      prisma.user.create({ data: { email: email(n), firstName: 'QA', lastName, role, status: 'ACTIVE' } }).then((u) => u.