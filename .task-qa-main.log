all\" aria-label=\"Course roster\">\n        <TableHead>\n          <TableRow>\n11:import { RosterTable, type RosterRow } from './RosterTable';\n18:  if (user.role === 'PARENT') notFound();\n19:  const { rows } = await getCourseRoster(params.courseId, user.role);\n23:  if (user.role === 'STUDENT') {\n48:  return <RosterTable rows={tableRows} courseCode={course?.code ?? ''} />;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018fMPnuQPzgZ7J8gAMtD5qp","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
