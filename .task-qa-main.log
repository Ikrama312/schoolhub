{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tx9p7V1kgeUgNjz8Cp95ZV","type":"tool_result","content":"1\t'use client';\n2\t\n3\timport { useEffect, useMemo, useState } from 'react';\n4\timport { useRouter } from 'next/navigation';\n5\timport Alert from '@mui/material/Alert';\n6\timport Box from '@mui/material/Box';\n7\timport Button from '@mui/material/Button';\n8\timport Chip from '@mui/material/Chip';\n9\timport IconButton from '@mui/material/IconButton';\n10\timport Paper from '@mui/material/Paper';\n11\timport Stack from '@mui/material/Stack';\n12\timport TextField from '@mui/material/TextField';\n13\timport ToggleButton from '@mui/material/ToggleButton';\n14\timport ToggleButtonGroup from '@mui/material/ToggleButtonGroup';\n15\timport Typography from '@mui/material/Typography';\n16\timport StickyNote2OutlinedIcon from '@mui/icons-material/StickyNote2Outlined';\n17\timport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\n18\timport { useToast } from '@/components/Toast/useToast';\n19\timport { registerPutBody, MINUTES_LATE_MAX, NOTE_MAX, type AttendanceStatusValue } from '@/lib/validators/attendance';\n20\timport type { Register } from '@/server/attendance/attendance-service';\n21\t\n22\ttype Row = { status: AttendanceStatusValue | null; minutesLate: number; note: string; noteOpen: boolean };\n23\t\n24\tconst OPTIONS: { value: AttendanceStatusValue; short: string; word: string; color: 'success' | 'error' | 'warning' | 'info' }[] = [\n25\t  { value: 'PRESENT', short: 'P', word: 'present', color: 'success' },\n26\t  { value: 'ABSENT', short: 'A', word: 'absent', color: 'error' },\n27\t  { value: 'LATE', short: 'L', word: 'late', color: 'warning' },\n28\t  { value: 'EXCUSED', short: 'E', word: 'excused', color: 'info' },\n29\t];\n30\t\n31\tfunction draftKey(key: Register['key']) {\n32\t  return 'courseId' in key\n33\t    ? `attendance-draft:${key.courseId}:${key.date}:${key.periodId}`\n34\t    : `attendance-draft:section:${key.sectionId}:${key.date}:daily`;\n35\t}\n36\t\n37\tfunction rowsFrom(register: Register): Record<string, Row> {\n38\t  const byId = new Map(register.records.map((r) => [r.studentId, r]));\n39\t  return Object.fromEntries(\n40\t    register.students.map((s) => {\n41\t      const r = byId.get(s.id);\n42\t      return [s.id, { status: r?.status ?? null, minutesLate: r?.minutesLate ?? 5, note: r?.note ?? '', noteOpen: Boolean(r?.note) }];\n43\t    }),\n44\t  );\n45\t}\n46\t\n47\t/** The only register component: course and daily registers (FR-9 to FR-17, NFR-2, NFR-4, NFR-9). */\n48\texport function RegisterForm({ initial }: { initial: Register }) {\n49\t  const router = useRouter();\n50\t  const { showToast } = useToast();\n51\t  const [register, setRegister] = useState(initial);\n52\t  const [rows, setRows] = useState(() => rowsFrom(initial));\n53\t  const [saving, setSaving] = useState(false);\n54\t  const [draft, setDraft] = useState<Record<string, Row> | null>(null);\n55\t  const storageKey = draftKey(register.key);\n56\t  const locked = register.readOnly || saving;\n57\t\n58\t  // NFR-2: offer a draft left behind by a failed save.\n59\t  useEffect(() => {\n60\t    try {\n61\t      const raw = localStorage.getItem(storageKey);\n62\t      if (raw) setDraft(JSON.parse(raw));\n63\t    } catch {\n64\t      // Corrupt/unavailable storage: nothing to restore.\n65\t    }\n66\t  }, [storageKey]);\n67\t\n68\t  const counts = useMemo(() => {\n69\t    const c = { PRESENT: 0, ABSENT: 0, LATE: 0, EXCUSED: 0, unmarked: 0 };\n70\t    for (const r of Object.values(rows)) {\n71\t      if (r.status) c[r.status] += 1;\n72\t      else c.unmarked += 1;\n73\t    }\n74\t    return c;\n75\t  }, [rows]);\n76\t\n77\t  const update = (id: string, patch: Partial<Row>) => setRows((prev) => ({ ...prev, [id]: { ...prev[id], ...patch } }));\n78\t\n79\t  const markAllPresent = () =>\n80\t    setRows((prev) => Object.fromEntries(Object.entries(prev).map(([id, r]) => [id, r.status ? r : { ...r, status: 'PRESENT' as const }])));\n81\t\n82\t  async function save() {\n83\t    const body = {\n84\t      ...register.key,\n85\t      records: Object.entries(rows).map(([studentId, r]) => ({\n86\t        studentId,\n87\t        status: r.status!,\n88\t        ...(r.status === 'LATE' ? { minutesLate: r.minutesLate } : {}),\n89\t        ...(r.note.trim() ? { note: r.note.trim() } : {}),\n90\t      })),\n91\t    };\n92\t    const parsed = registerPutBody.safeParse(body);\n93\t    if (!parsed.success) {\n94\t      showToast({ message: parsed.error.issues[0]?.message ?? 'Check the register and try again.', severity: 'error' });\n95\t      return;\n96\t    }\n97\t\n98\t    setSaving(true);\n99\t    try {\n100\t      let res: Response;\n101\t      try {\n102\t        res = await fetch('/api/attendance/register', {\n103\t          method: 'PUT',\n104\t          headers: { 'Content-Type': 'application/json' },\n105\t          body: JSON.stringify(parsed.data),\n106\t        });\n107\t      } catch {\n108\t        localStorage.setItem(storageKey, JSON.stringify(rows));\n109\t        showToast({ message: 'You appear to be offline. Your register was saved on this device; try again shortly.', severity: 'warning' });\n110\t        return;\n111\t      }\n112\t      const json = await res.json().catch(() => ({}));\n113\t      if (!res.ok) {\n114\t        showToast({ message: json?.error?.message ?? 'Could not save the register.', severity: 'error' });\n115\t        return;\n116\t      }\n117\t      localStorage.removeItem(storageKey);\n118\t      setDraft(null);\n119\t      setRegister(json.data);\n120\t      setRows(rowsFrom(json.data));\n121\t      showToast({ message: 'Attendance saved', severity: 'success' });\n122\t      router.refresh();\n123\t    } finally {\n124\t      setSaving(false);\n125\t    }\n126\t  }\n127\t\n128\t  return (\n129\t    <Box sx={{ pb: 10 }}>\n130\t      {draft && !register.readOnly && (\n131\t        <Alert\n132\t          severity=\"info\"\n133\t          s