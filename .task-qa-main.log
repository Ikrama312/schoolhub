                     String                   @id @default(cuid())\n  email                   String                   @unique\n  passwordHash            String?\n  firstName               String\n  lastName                String\n  phone                   String?\n  role                    Role\n  status                  UserStatus               @default(INVITED)\n  failedLoginCount        Int                      @default(0)\n  lockedUntil             DateTime?\n  lastLoginAt             DateTime?\n  passwordChangedAt       DateTime?\n  archivedAt              DateTime?\n  createdAt               DateTime                 @default(now())\n  updatedAt               DateTime                 @updatedAt\n  studentProfile          StudentProfile?\n  teacherProfile          TeacherProfile?\n  parentProfile           ParentProfile?\n\n  @@index([lastName, firstName, email])\n  @@index([role, status])\n}\n5:export function rateLimit(\n6-  key: string,\n7-  limit: number,\n8-  windowMs: number,\n12:export type ApiErrorCode =\n34:export class AppError extends Error {\n45:export function ok<T>(data: T, init?: ResponseInit) {\n49:export function paginated<T>(\n57:export function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n71:export function withHandler<Args extends unknown[]>(\n104:export interface PaginationParams {\n113:export function parsePagination(searchParams: URLSearchParams): PaginationParams {\n125:export async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\n131:export function getClientIp(request: Request): string | null {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01YUnqfh4CvvM1dWLC6REpdV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
