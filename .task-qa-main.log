{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X8jDsQiMhbKioRdDJWwaf4","type":"tool_result","content":"import type { UserStatus } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\nimport { MAX_PARTICIPANTS } from '@/lib/messaging/constants';\n\n/**\n * PRD-13 contact rules (FR-5, FR-6, FR-7, FR-32, ADR-3). The single source of truth for\n * who may message whom: create, send, contacts and the student/roster actions all go\n * through here. `canMessageWith` is pure; `loadRelations` fetches everything it needs\n * for a set of users in one batch.\n */\n\nexport interface Party {\n  id: string;\n  role: Role;\n}\nexport interface RelUser extends Party {\n  status: UserStatus;\n}\n\nexport interface Relations {\n  users: Map<string, RelUser>;\n  /** `${teacherId}|${studentId}`: ACTIVE enrollment in a course the teacher manages (teacherId or co-teacher), or current-year homeroom. */\n  teaches: Set<string>;\n  /** parentId → linked studentIds */\n  children: Map<string, string[]>;\n}\n\nconst isStaff = (role: Role) => role === 'ADMIN' || role === 'TEACHER';\nconst teaches = (rel: Relations, teacherId: string, studentId: string) => rel.teaches.has(`${teacherId}|${studentId}`);\nconst childrenOf = (rel: Relations, parentId: string) => rel.children.get(parentId) ?? [];\n\n/** The FR-5 sender → recipient matrix. Non-ACTIVE recipients and self are never messageable. */\nexport function canMessageWith(sender: Party, recipient: RelUser, rel: Relations): boolean {\n  if (sender.id === recipient.id || recipient.status !== 'ACTIVE') return false;\n  if (sender.role === 'ADMIN' || recipient.role === 'ADMIN') return true;\n  switch (sender.role) {\n    case 'TEACHER':\n      if (recipient.role === 'TEACHER') return true;\n      if (recipient.role === 'STUDENT') return teaches(rel, sender.id, recipient.id);\n      return childrenOf(rel, recipient.id).some((child) => teaches(rel, sender.id, child));\n    case 'STUDENT':\n      return recipient.role === 'TEACHER' && teaches(rel, recipient.id, sender.id);\n    case 'PARENT':\n      return recipient.role === 'TEACHER' && childrenOf(rel, sender.id).some((child) => teaches(rel, recipient.id, child));\n    default:\n      return false;\n  }\n}\n\n/** Loads roles/status, parent links, managed-course enrollments and current homerooms for `ids` in one batch. */\nexport async function loadRelations(ids: string[]): Promise<Relations> {\n  const unique = [...new Set(ids)];\n  const [users, links] = await Promise.all([\n    prisma.user.findMany({ where: { id: { in: unique } }, select: { id: true, role: true, status: true, archivedAt: true } }),\n    prisma.parentStudentLink.findMany({ where: { parentId: { in: unique } }, select: { parentId: true, studentId: true } }),\n  ]);\n  const children = new Map<string, string[]>();\n  for (const l of links) children.set(l.parentId, [...(children.get(l.parentId) ?? []), l.studentId]);\n\n  const teacherIds = users.filter((u) => u.role === 'TEACHER').map((u) => u.id);\n  const studentIds = [...new Set([...users.filter((u) => u.role === 'STUDENT').map((u) => u.id), ...links.map((l) => l.studentId)])];\n  const pairs = new Set<string>();\n  if (teacherIds.length && studentIds.length) {\n    const teacherSet = new Set(teacherIds);\n    const [enrollments, homerooms] = await Promise.all([\n      prisma.enrollment.findMany({\n        where: {\n          status: 'ACTIVE',\n          studentId: { in: studentIds },\n          course: { archivedAt: null, OR: [{ teacherId: { in: teacherIds } }, { coTeacherIds: { hasSome: teacherIds } }] },\n        },\n        select: { studentId: true, course: { select: { teacherId: true, coTeacherIds: true } } },\n      }),\n      prisma.sectionMember.findMany({\n        where: { studentId: { in: studentIds }, section: { homeroomTeacherId: { in: teacherIds }, academicYear: { isCurrent: true } } },\n        select: { studentId: true, section: { select: { homeroomTeacherId: true } } },\n      }),\n    ]);\n    for (const e of enrollments) {\n      for (const t of [e.course.teacherId, ...e.course.coTeacherIds]) if (teacherSet.has(t)) pairs.add(`${t}|${e.studentId}`);\n    }\n    for (const h of homerooms) if (h.section.homeroomTeacherId) pairs.add(`${h.section.homeroomTeacherId}|${h.studentId}`);\n  }\n\n  return {\n    users: new Map(users.map((u) => [u.id, { id: u.id, role: u.role, status: u.archivedAt ? 'ARCHIVED' : u.status }])),\n    teaches: pairs,\n    children,\n  };\n}\n\nexport async function canMessage(sender: Party, recipientId: string): Promise<boolean> {\n  const rel = await loadRelations([sender.id, recipientId]);\n  const recipient = rel.users.get(recipientId);\n  return !!recipient && canMessageWith(sender, recipient, rel);\n}\n\n/** The subset of `ids` the sender may message. */\nexport async function messageableIds(sender: Party, ids: string[]): Promise<string[]> {\n  const rel = await loadRelations([sender.id, ...ids]);\n  return [...new Set(ids)].filter((id) => {\n    const u = rel.users.get(id);\n    return !!u && canMessageWith(sender, u, rel);\n  });\n}\n\nexport type NewConversationProblem = 'TOO_FEW_PARTICIPANTS' | 'TOO_MANY_PARTICIPANTS' | 'CONTACT_RULES' | 'GROUP_NEEDS_STAFF';\n\n/** Pure FR-6 check over already-loaded relations; null when the conversation may be created. */\nexport function checkNewConversation(creator: Party, otherIds: string[], rel: Relations): NewConversationProblem | null {\n  const others = [...new Set(otherIds)].filter((id) => id !== creator.id);\n  if (others.length < 1) return 'TOO_FEW_PARTICIPANTS';\n  if (others.length + 1 > MAX_PARTICIPANTS) return 'TOO_MANY_PARTICIPANTS';\n  const users = others.map((id) => rel.users.get(id));\n  if (users.some((u) => !u || !canMessageWith(creator, u, rel))) return 'CONTACT_RULES';\n  const roles = [creator.role, ...users.map((u) => u!.role)];\n  if (roles.includes('STUDENT') && !roles.some(isStaff)) return 'GROUP_NEEDS_STAFF';\n  return null;\n}\n\n/** FR-6: throws 403 (nothing created) on any violation; returns the other participants and involvesStudent (FR-30). */\nexport async function validateNewConversation(creator: Party, otherIds: string[]): Promise<{ participantIds: string[]; involvesStudent: boolean }> {\n  const rel = await loadRelations([creator.id, ...otherIds]);\n  const problem = checkNewConversation(creator, otherIds, rel);\n  if (problem === 'TOO_FEW_PARTICIPANTS') throw new AppError('VALIDATION_ERROR', 'Pick at least one recipient.');\n  if (problem) throw new AppError('FORBIDDEN', 'You cannot start this conversation.', { reason: problem });\n  const participantIds = [...new Set(otherIds)].filter((id) => id !== creator.id);\n  const involvesStudent = creator.role === 'STUDENT' || participantIds.some((id) => rel.users.get(id)!.role === 'STUDENT');\n  return { participantIds, involvesStudent };\n}\n\n/**\n * A4/FR-7 pure: staff can always send; anyone else needs a live relationship with at least one\n * staff participant who has not left. `participants` are the ones still in the conversation.\n */\nexport function canSendInWith(sender: Party, participantIds: string[], rel: Relations): boolean {\n  if (isStaff(sender.role)) return true;\n  return participantIds.some((id) => {\n    const u = rel.users.get(id);\n    return !!u && isStaff(u.role) && canMessageWith(sender, u, rel);\n  });\n}\n\nexport async function canSendIn(sender: Party, participantIds: string[]): Promise<boolean> {\n  if (isStaff(sender.role)) return true;\n  return canSendInWith(sender, participantIds, await loadRelations([sender.id, ...participantIds]));\n}\nimport type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { rateLimit } from '@/server/rate-limit';\nimport { EDIT_WINDOW_MS, RATE_LIMIT } from '@/lib/messaging/constants';\nimport type { ListMessagesQuery, SendMessageInput } from '@/lib/validators/messaging';\nimport type { Party } from './contact-rules';\nimport { canSendIn } from './contact-rules';\nimport { getParticipation } from './access';\nimport { onMessageSent } from './notifications';\n\n/**\n * PRD-13 message service (FR-3, FR-7, FR-10, FR-11, FR-13, FR-15, FR-27, FR-31, NFR-2..4).\n * Messages are never hard-deleted (NFR-3); normal users see deleted ones redacted.\n */\n\ntype Tx = Prisma.TransactionClient;\n\nexport const userSummarySelect = { id: true, firstName: true, lastName: true, role: true } as const;\ntype UserRow = { id: string; firstName: string; lastName: string; role: Party['role'] };\n\nexport const toUserSummary = (u: UserRow) => ({ id: u.id, name: `${u.firstName} ${u.lastName}`, role: u.role, avatarUrl: null as string | null });\nexport type UserSummary = ReturnType<typeof toUserSummary>;\n\nexport const messageInclude = {\n  sender: { select: userSummarySelect },\n  attachments: { select: { file: { select: { id: true, originalName: true, mimeType: true, sizeBytes: true } } } },\n} as const;\nexport type MessageRow = Prisma.MessageGetPayload<{ include: typeof messageInclude }>;\n\nexport const toAttachment = (f: MessageRow['attachments'][number]['file']) => ({\n  fileId: f.id,\n  name: f.originalName,\n  mimeType: f.mimeType,\n  size: f.sizeBytes,\n  url: `/api/files/${f.id}`,\n});\n\nexport function toMessageDTO(m: MessageRow, viewerId: string, now: Date = new Date()) {\n  const deleted = m.deletedAt !== null;\n  const isOwn = m.senderId === viewerId;\n  return {\n    id: m.id,\n    conversationId: m.conversationId,\n    sender: toUserSummary(m.sender),\n    body: deleted ? null : m.body,\n    deleted,\n    editedAt: m.editedAt?.toISOString() ?? null,\n    createdAt: m.createdAt.toISOString(),\n    updatedAt: m.updatedAt.toISOString(),\n    attachments: deleted ? [] : m.attachments.map((a) => toAttachment(a.file)),\n    isOwn,\n    canEdit: isOwn && !deleted && now.getTime() - m.createdAt.getTime() <= EDIT_WINDOW_MS,\n  };\n}\nexport type MessageDTO = ReturnType<typeof toMessageDTO>;\n\n/** NFR-4: 30 messages (sends + creates) per minute per user. */\nexport function assertRateLimit(userId: string): void {\n  const r = rateLimit(`msg:${userId}`, RATE_LIMIT.limit, RATE_LIMIT.windowMs);\n  if (!r.ok) throw new AppError('RATE_LIMITED', 'You are sending messages too quickly.', { retryAfterMs: r.retryAfterMs });\n}\n\nconst POLL_TAKE = 100;\n\n/** Keyset pagination on (createdAt, id). `after` (+`since`) is the 5 s poll; `before` loads older pages. */\nexport async function listMessages(user: Party, conversationId: string, q: ListMessagesQuery) {\n  await getParticipation(user.id, conversationId);\n  const now = new Date();\n  const dto = (rows: MessageRow[]) => rows.map((m) => toMessageDTO(m, user.id, now));\n  const cursorId = q.after ?? q.before;\n  const cursor = cursorId\n    ? await prisma.message.findFirst({ where: { id: cursorId, conversationId }, select: { id: true, createdAt: true } })\n    : null;\n  if (cursorId && !cursor) throw new AppError('NOT_FOUND', 'Message not found');\n\n  if (q.after && cursor) {\n    const newer = { OR: [{ createdAt: { gt: cursor.createdAt } }, { createdAt: cursor.createdAt, id: { gt: cursor.id } }] };\n    const [messages, changed] = await Promise.all([\n      prisma.message.findMany({ where: { conversationId, ...newer }, include: messageInclude, orderBy: [{ createdAt: 'asc' }, { id: 'asc' }], take: POLL_TAKE }),\n      q.since\n        ? prisma.message.findMany({\n            where: { conversationId, updatedAt: { gt: new Date(q.since) }, NOT: newer },\n            include: messageInclude,\n            orderBy: [{ createdAt: 'asc' }, { id: 'asc' }],\n            take: POLL_TAKE,\n          })\n        : Promise.resolve([]),\n    ]);\n    return { messages: dto(messages), changed: dto(changed), hasMore: false };\n  }\n\n  const older = cursor ? { OR: [{ createdAt: { lt: cursor.createdAt } }, { createdAt: cursor.createdAt, id: { lt: cursor.id } }] } : {};\n  const rows = await prisma.message.findMany({\n    where: { conversationId, ...older },\n    include: messageInclude,\n    orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],\n    take: q.limit + 1,\n  });\n  const hasMore = rows.length > q.limit;\n  return { messages: dto(rows.slice(0, q.limit).reverse()), changed: [], hasMore };\n}\n\n/**\n * The send transaction body, shared with createConversation (FR-11, FR-27, FR-31, A11):\n * insert, link attachments (owned by the sender, unattached, context 'message'), bump\n * lastMessageAt, mark the sender read and unarchive for everyone else.\n */\nexport async function insertMessage(tx: Tx, senderId: string, conversationId: string, input: SendMessageInput): Promise<MessageRow> {\n  const fileIds = [...new Set(input.fileIds ?? [])];\n  if (fileIds.length) {\n    const ok = await tx.fileObject.count({ where: { id: { in: fileIds }, ownerId: senderId, contextId: null, context: 'message' } });\n    if (ok !== fileIds.length) throw new AppError('VALIDATION_ERROR', 'One or more files cannot be attached.', { fileIds });\n  }\n  const created = await tx.message.create({ data: { conversationId, senderId, body: input.body } });\n  if (fileIds.length) {\n    await tx.fileObject.updateMany({ where: { id: { in: fileIds } }, data: { contextId: created.id } });\n    await tx.messageAttachment.createMany({ data: fileIds.map((fileId) => ({ messageId: created.id, fileId })) });\n  }\n  await tx.conversation.update({ where: { id: conversationId }, data: { lastMessageAt: created.createdAt } });\n  await tx.conversationParticipant.update({\n    where: { conversationId_userId: { conversationId, userId: senderId } },\n    data: { lastReadAt: created.createdAt },\n  });\n  await tx.conversationParticipant.updateMany({\n    where: { conversationId, userId: { not: senderId }, archivedAt: { not: null } },\n    data: { archivedAt: null },\n  });\n  return tx.message.findUniqueOrThrow({ where: { id: created.id }, include: messageInclude });\n}\n\nexport const afterSend = (m: MessageRow) =>\n  onMessageSent(m.conversationId, { senderId: m.senderId, senderName: `${m.sender.firstName} ${m.sender.lastName}`, body: m.body });\n\n/** FR-7/FR-11: rate limit → participation (404) → canSendIn (403 RELATIONSHIP_ENDED) → transaction → after-commit notify. */\nexport async function sendMessage(user: Party, conversationId: string, input: SendMessageInput): Promise<MessageDTO> {\n  assertRateLimit(user.id);\n  await getParticipation(user.id, conversationId);\n  const others = await prisma.conversationParticipant.findMany({\n    where: { conversationId, leftAt: null, userId: { not: user.id } },\n    select: { userId: true },\n  });\n  if (!(await canSendIn(user, others.map((o) => o.userId)))) {\n    throw new AppError('FORBIDDEN', 'You can no longer send messages in this conversation.', { reason: 'RELATIONSHIP_ENDED' });\n  }\n  const message = await prisma.$transaction((tx) => insertMessage(tx, user.id, conversationId, input));\n  await afterSend(message);\n  return toMessageDTO(message, user.id);\n}\n\n/** FR-15: own message, still a participant, not deleted, within 15 minutes. */\nasync function loadOwnEditable(user: Party, messageId: string, now: Date) {\n  const m = await prisma.message.findUnique({ where: { id: messageId }, select: { id: true, conversationId: true, senderId: true, body: true, createdAt: true, deletedAt: true } });\n  if (!m) throw new AppError('NOT_FOUND', 'Message not found');\n  await getParticipation(user.id, m.conversationId);\n  const refuse = (reason: string, msg: string) => new AppError('FORBIDDEN', msg, { reason });\n  if (m.senderId !== user.id) throw refuse('NOT_SENDER', 'You can only change your own messages.');\n  if (m.deletedAt) throw refuse('ALREADY_DELETED', 'This message was deleted.');\n  if (now.getTime() - m.createdAt.getTime() > EDIT_WINDOW_MS) throw refuse('EDIT_WINDOW_EXPIRED', 'Messages can only be changed within 15 minutes of sending.');\n  return m;\n}\n\n/** FR-3/FR-15: stores the old body as a MessageRevision, then updates body + editedAt, in one transaction. */\nexport async function editMessage(user: Party, messageId: string, body: string, now: Date = new Date()): Promise<MessageDTO> {\n  const m = await loadOwnEditable(user, messageId, now);\n  const updated = await prisma.$transaction(async (tx) => {\n    await tx.messageRevision.create({ data: { messageId, body: m.body } });\n    return tx.message.update({ where: { id: messageId }, data: { body, editedAt: now }, include: messageInclude });\n  });\n  return toMessageDTO(updated, user.id, now);\n}\n\n/** FR-15/NFR-3: soft delete only. */\nexport async function deleteMessage(user: Party, messageId: string, now: Date = new Date()): Promise<MessageDTO> {\n  await loadOwnEditable(user, messageId, now);\n  const updated = await prisma.message.update({ where: { id: messageId }, data: { deletedAt: now }, include: messageInclude });\n  return toMessageDTO(updated, user.id, now);\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { SessionUser } from '@/server/auth/requireRole';\n\n/**\n * PRD-13 access helpers (NFR-1, A7). A participant who has left is a non-participant (404);\n * a conversation cuid is never authorisation. The safeguarding flag is always read from the DB.\n */\n\nconst notFound = () => new AppError('NOT_FOUND', 'Conversation not found');\n\nexport async function getParticipation(userId: string, conversationId: string) {\n  const row = await prisma.conversationParticipant.findUnique({ where: { conversationId_userId: { conversationId, userId } } });\n  if (!row || row.leftAt) throw notFound();\n  return row;\n}\n\nexport async function isSafeguardingLead(user: { id: string; role: string }): Promise<boolean> {\n  if (user.role !== 'ADMIN') return false;\n  const row = await prisma.user.findUnique({ where: { id: user.id }, select: { isSafeguardingLead: true, status: true } });\n  return !!row?.isSafeguardingLead && row.status === 'ACTIVE';\n}\n\n/** Service-level guard: 403 unless an ACTIVE ADMIN with isSafeguardingLead (fresh DB read). */\nexport async function assertSafeguardingLead(user: { id: string; role: string }): Promise<void> {\n  if (!(await isSafeguardingLead(user))) {\n    throw new AppError('FORBIDDEN', 'Only safeguarding leads can access this area.');\n  }\n}\n\n// The guards below import auth lazily so services (and their integration tests) never load next-auth.\n\n/** Route guard: 401 when signed out, 403 for anyone but a safeguarding lead. */\nexport async function requireSafeguardingLead(): Promise<SessionUser> {\n  const { requireRole } = await import('@/server/auth/requireRole');\n  const user = await requireRole('ADMIN');\n  await assertSafeguardingLead(user);\n  return user;\n}\n\n/** Page guard: redirects to /login or /forbidden. */\nexport async function requirePageSafeguardingLead(): Promise<SessionUser> {\n  const [{ requirePageRole }, { redirect }] = await Promise.all([import('@/server/auth/requireRole'), import('next/navigation')]);\n  const user = await requirePageRole('ADMIN');\n  if (!(await isSafeguardingLead(user))) redirect('/forbidden');\n  return user;\n}\nimport { fromZonedTime } from 'date-fns-tz';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport type { MessagingSettingsInput } from '@/lib/validators/messaging';\n\n/** PRD-13 quiet hours (FR-20, FR-21, ADR-6, ADR-12). HH:mm strings in the school timezone; ranges may wrap midnight. */\n\nexport interface QuietHours {\n  quietStart: string | null;\n  quietEnd: string | null;\n}\n\n/** [start, end) — e.g. 22:00–07:00 covers 23:30 and 06:59 but not 07:00. start === end is never quiet. */\nexport function isInQuietHours(hhmm: string, start: string, end: string): boolean {\n  if (start === end) return false;\n  return start < end ? hhmm >= start && hhmm < end : hhmm >= start || hhmm < end;\n}\n\n/** The UTC instant quiet hours end, or null when `now` is outside quiet hours (or none are set). DST-safe via fromZonedTime. */\nexport function quietHoursEnd(now: Date, tz: string, settings: QuietHours | null): Date | null {\n  if (!settings?.quietStart || !settings.quietEnd) return null;\n  if (!isInQuietHours(formatInSchoolTz(now, 'HH:mm', tz), settings.quietStart, settings.quietEnd)) return null;\n  const today = formatInSchoolTz(now, 'yyyy-MM-dd', tz);\n  const end = fromZonedTime(`${today} ${settings.quietEnd}`, tz);\n  if (end > now) return end;\n  const tomorrow = new Date(Date.parse(`${today}T12:00:00Z`) + 86_400_000).toISOString().slice(0, 10);\n  return fromZonedTime(`${tomorrow} ${settings.quietEnd}`, tz);\n}\n\nexport async function getSettings(userId: string): Promise<QuietHours> {\n  const row = await prisma.messagingSettings.findUnique({ where: { userId }, select: { quietStart: true, quietEnd: true } });\n  return { quietStart: row?.quietStart ?? null, quietEnd: row?.quietEnd ?? null };\n}\n\nexport async function putSettings(userId: string, input: MessagingSettingsInput): Promise<QuietHours> {\n  const { quietStart, quietEnd } = input;\n  if ((quietStart === null) !== (quietEnd === null)) throw new AppError('VALIDATION_ERROR', 'Set both start and end, or neither.');\n  if (quietStart !== null && quietStart === quietEnd) throw new AppError('VALIDATION_ERROR', 'Start and end must differ.');\n  const row = await prisma.messagingSettings.upsert({\n    where: { userId },\n    create: { userId, quietStart, quietEnd },\n    update: { quietStart, quietEnd },\n    select: { quietStart: true, quietEnd: true },\n  });\n  return row;\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { notify } from '@/server/notifications/notify';\nimport { EMAIL_DELAY_MS } from '@/lib/messaging/constants';\n\n/** PRD-13 notification side effects (FR-19, FR-20, FR-26). Never throw: call after the transaction commits. */\n\n/** The one link builder for a conversation; markRead matches notifications on it. */\nexport const conversationLink = (conversationId: string) => `/messages/${conversationId}`;\n\nconst PREVIEW_MAX = 140;\n\n/**\n * FR-19/FR-20: for each other participant who has not muted or left — replace their unread\n * message.received row for this conversation with one fresh in-app notification, and start the\n * 10-minute email clock (create-only: the first unread message sets dueAt).\n */\nexport async function onMessageSent(\n  conversationId: string,\n  message: { senderId: string; senderName: string; body: string },\n  now: Date = new Date(),\n): Promise<void> {\n  try {\n    const recipients = await prisma.conversationParticipant.findMany({\n      where: { conversationId, userId: { not: message.senderId }, leftAt: null, mutedAt: null },\n      select: { userId: true },\n    });\n    const userIds = recipients.map((r) => r.userId);\n    if (!userIds.length) return;\n    const link = conversationLink(conversationId);\n    await prisma.notification.deleteMany({ where: { userId: { in: userIds }, type: 'message.received', readAt: null, link } });\n    const preview = message.body.length > PREVIEW_MAX ? `${message.body.slice(0, PREVIEW_MAX - 1)}…` : message.body;\n    await notify({ type: 'message.received', userIds, title: `New message from ${message.senderName}`, body: preview, link });\n    await prisma.pendingMessageEmail.createMany({\n      data: userIds.map((userId) => ({ userId, conversationId, dueAt: new Date(now.getTime() + EMAIL_DELAY_MS) })),\n      skipDuplicates: true,\n    });\n  } catch (error) {\n    logger.error('onMessageSent failed', { conversationId, message: error instanceof Error ? error.message : String(error) });\n  }\n}\n\n/** FR-26: notify every ACTIVE safeguarding lead (mandatory in-app + email). Never includes the message text. */\nexport async function onMessageReported(reportId: string): Promise<void> {\n  try {\n    const leads = await prisma.user.findMany({\n      where: { role: 'ADMIN', isSafeguardingLead: true, status: 'ACTIVE', archivedAt: null },\n      select: { id: true },\n    });\n    await notify({\n      type: 'message.reported',\n      userIds: leads.map((l) => l.id),\n      title: 'A message was reported',\n      body: 'A message has been reported for safeguarding review.',\n      link: `/admin/safeguarding?report=${reportId}`,\n      email: { template: 'generic-notification' },\n    });\n  } catch (error) {\n    logger.error('onMessageReported failed', { reportId, message: error instanceof Error ? error.message : String(error) });\n  }\n}\nimport { prisma } from '@/server/db';\nimport { notify } from '@/server/notifications/notify';\nimport { getSchoolTimezone } from '@/server/assignments/assignments-service';\nimport { quietHoursEnd } from './quiet-hours';\nimport { conversationLink } from './notifications';\n\n/** PRD-13 deferred message email (FR-4, FR-20). Run by POST /api/internal/email/dispatch. */\n\nconst BATCH = 200;\n\nexport async function processPendingMessageEmails(now: Date = new Date()): Promise<{ sent: number; deferred: number; dropped: number }> {\n  const summary = { sent: 0, deferred: 0, dropped: 0 };\n  const rows = await prisma.pendingMessageEmail.findMany({ where: { dueAt: { lte: now } }, orderBy: { dueAt: 'asc' }, take: BATCH });\n  if (!rows.length) return summary;\n  const tz = await getSchoolTimezone();\n\n  for (const row of rows) {\n    // Claim by delete: a concurrent run that loses the race skips the row.\n    const claimed = await prisma.pendingMessageEmail.deleteMany({ where: { id: row.id } });\n    if (claimed.count !== 1) continue;\n\n    const [participant, settings, conversation] = await Promise.all([\n      prisma.conversationParticipant.findUnique({ where: { conversationId_userId: { conversationId: row.conversationId, userId: row.userId } } }),\n      prisma.messagingSettings.findUnique({ where: { userId: row.userId }, select: { quietStart: true, quietEnd: true } }),\n      prisma.conversation.findUnique({ where: { id: row.conversationId }, select: { subject: true } }),\n    ]);\n    if (!participant || !conversation || participant.leftAt || participant.mutedAt || (participant.lastReadAt && participant.lastReadAt >= row.createdAt)) {\n      summary.dropped++;\n      continue;\n    }\n\n    const quietEnd = quietHoursEnd(now, tz, settings);\n    if (quietEnd) {\n      await prisma.pendingMessageEmail.upsert({\n        where: { userId_conversationId: { userId: row.userId, conversationId: row.conversationId } },\n        create: { userId: row.userId, conversationId: row.conversationId, dueAt: quietEnd, createdAt: row.createdAt },\n        update: {},\n      });\n      summary.deferred++;\n      continue;\n    }\n\n    await notify({\n      type: 'message.received',\n      userIds: [row.userId],\n      title: conversation.subject ? `Unread messages: ${conversation.subject}` : 'You have unread messages',\n      body: 'You have unread direct messages in SchoolHub. Open the conversation to read them.',\n      link: conversationLink(row.conversationId),\n      inApp: false,\n      email: { template: 'generic-notification' },\n    });\n    summary.sent++;\n  }\n  return summary;\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Party } from './contact-rules';\nimport { getParticipation } from './access';\nimport { onMessageReported } from './notifications';\n\n/** PRD-13 FR-22/FR-26, A12: a participant reports someone else's message; one OPEN report per (message, reporter). */\nexport async function reportMessage(user: Party, messageId: string, reason: string) {\n  const m = await prisma.message.findUnique({ where: { id: messageId }, select: { conversationId: true, senderId: true } });\n  if (!m) throw new AppError('NOT_FOUND', 'Message not found');\n  await getParticipation(user.id, m.conversationId);\n  if (m.senderId === user.id) throw new AppError('FORBIDDEN', 'You cannot report your own message.');\n  const existing = await prisma.messageReport.findFirst({ where: { messageId, reporterId: user.id, status: 'OPEN' }, select: { id: true } });\n  if (existing) throw new AppError('CONFLICT', 'You have already reported this message.');\n  const report = await prisma.messageReport.create({ data: { messageId, reporterId: user.id, reason }, select: { id: true, status: true } });\n  await onMessageReported(report.id);\n  return { reportId: report.id, status: report.status };\n}\n/** PRD-13 limits shared by validators, services and the client (FR-11, FR-13, FR-15). Client-safe. */\nexport const BODY_MAX = 5000;\nexport const COUNTER_FROM = 4500;\nexport const MAX_FILES = 5;\nexport const MAX_PARTICIPANTS = 25;\nexport const SUBJECT_MAX = 120;\nexport const REASON_MAX = 1000;\nexport const EDIT_WINDOW_MS = 15 * 60_000;\nexport const THREAD_POLL_MS = 5000;\nexport const LIST_POLL_MS = 30000;\nexport const PAGE_SIZE = 30;\nexport const RATE_LIMIT = { limit: 30, windowMs: 60_000 } as const;\nexport const EMAIL_DELAY_MS = 10 * 60_000;\nexport const DELETED_TEXT = 'This message was deleted';","is_error":false}]},"parent_tool_use_id":null,"session_id":"b2a19e14-003d-496b-9902-59b2c0434c99","uuid":"07b6480d-d38d-4929-9438-54c35788ddc8","timestamp":"2026-11-09T17:57:12.096Z","tool_use_result":{"stdout":"import type { UserStatus } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\nimport { MAX_PARTICIPANTS } from '@/lib/messaging/constants';\n\n/**\n * PRD-13 contact rules (FR-5, FR-6, FR-7, FR-32, ADR-3). The single source of truth for\n * who may message whom: create, send, contacts and the student/roster actions all go\n * through here. `canMessageWith` is pure; `loadRelations` fetches everything it needs\n * for a set of users in one batch.\n */\n\nexport interface Party {\n  id: string;\n  role: Role;\n}\nexport interface RelUser extends Party {\n  status: UserStatus;\n}\n\nexport interface Relations {\n  users: Map<string, RelUser>;\n  /** `${teacherId}|${studentId}`: ACTIVE enrollment in a course the teacher manages (teacherId or co-teacher), or current-year homeroom. */\n  teaches: Set<string>;\n  /** parentId → linked studentIds */\n  children: Map<string, string[]>;\n}\n\nconst isStaff = (role: Role) => role === 'ADMIN' || role === 'TEACHER';\nconst teaches = (rel: Relations, teacherId: string, studentId: string) => rel.teaches.has(`${teacherId}|${studentId}`);\nconst childrenOf = (rel: Relations, parentId: string) => rel.children.get(parentId) ?? [];\n\n/** The FR-5 sender → recipient matrix. Non-ACTIVE recipients and self are never messageable. */\nexport function canMessageWith(sender: Party, recipient: RelUser, rel: Relations): boolean {\n  if (sender.id === recipient.id || recipient.status !== 'ACTIVE') return false;\n  if (sender.role === 'ADMIN' || recipient.role === 'ADMIN') return true;\n  switch (sender.role) {\n    case 'TEACHER':\n      if (recipient.role === 'TEACHER') return true;\n      if (recipient.role === 'STUDENT') return teaches(rel, sender.id, recipient.id);\n      return childrenOf(rel, recipient.id).some((child) => teaches(rel, sender.id, child));\n    case 'STUDENT':\n      return recipient.role === 'TEACHER' && teaches(rel, recipient.id, sender.id);\n    case 'PARENT':\n      return recipient.role === 'TEACHER' && childrenOf(rel, sender.id).some((child) => teaches(rel, recipient.id, child));\n    default:\n      return false;\n  }\n}\n\n/** Loads roles/status, parent links, managed-course enrollments and current homerooms for `ids` in one batch. */\nexport async function loadRelations(ids: string[]): Promise<Relations> {\n  const unique = [...new Set(ids)];\n  const [users, links] = await Promise.all([\n    prisma.user.findMany({ where: { id: { in: unique } }, select: { id: true, role: true, status: true, archivedAt: true } }),\n    prisma.parentStudentLink.findMany({ where: { parentId: { in: unique } }, select: { parentId: true, studentId: true } }),\n  ]);\n  const children = new Map<string, string[]>();\n  for (const l of links) children.set(l.parentId, [...(children.get(l.parentId) ?? []), l.studentId]);\n\n  const teacherIds = users.filter((u) => u.role === 'TEACHER').map((u) => u.id);\n  const studentIds = [...new Set([...users.filter((u) => u.role === 'STUDENT').map((u) => u.id), ...links.map((l) => l.studentId)])];\n  const pairs = new Set<string>();\n  if (teacherIds.length && studentIds.length) {\n    const teacherSet = new Set(teacherIds);\n    const [enrollments, homerooms] = await Promise.all([\n      prisma.enrollment.findMany({\n        where: {\n          status: 'ACTIVE',\n          studentId: { in: studentIds },\n          course: { archivedAt: null, OR: [{ teacherId: { in: teacherIds } }, { coTeacherIds: { hasSome: teacherIds } }] },\n        },\n        select: { studentId: true, course: { select: { teacherId: true, coTeacherIds: true } } },\n      }),\n      prisma.sectionMember.findMany({\n        where: { studentId: { in: studentIds }, section: { homeroomTeacherId: { in: teacherIds }, academicYear: { isCurrent: true } } },\n        select: { studentId: true, section: { select: { homeroomTeacherId: true } } },\n      }),\n    ]);\n    for (const e of enrollments) {\n      for (const t of [e.course.teacherId, ...e.course.coTeacherIds]) if (teacherSet.has(t)) pairs.add(`${t}|${e.studentId}`);\n    }\n    for (const h of homerooms) if (h.section.homeroomTeacherId) pairs.add(`${h.section.homeroomTeacherId}|${h.studentId}`);\n  }\n\n  return {\n    users: new Map(users.map((u) => [u.id, { id: u.id, role: u.role, status: u.archivedAt ? 'ARCHIVED' : u.status }])),\n    teaches: pairs,\n    children,\n  };\n}\n\nexport async function canMessage(sender: Party, recipientId: string): Promise<boolean> {\n  const rel = await loadRelations([sender.id, recipientId]);\n  const recipient = rel.users.get(recipientId);\n  return !!recipient && canMessageWith(sender, recipient, rel);\n}\n\n/** The subset of `ids` the sender may message. */\nexport async function messageableIds(sender: Party, ids: string[]): Promise<string[]> {\n  const rel = await loadRelations([sender.id, ...ids]);\n  return [...new Set(ids)].filter((id) => {\n    const u = rel.users.get(id);\n    return !!u && canMessageWith(sender, u, rel);\n  });\n}\n\nexport type NewConversationProblem = 'TOO_FEW_PARTICIPANTS' | 'TOO_MANY_PARTICIPANTS' | 'CONTACT_RULES' | 'GROUP_NEEDS_STAFF';\n\n/** Pure FR-6 check over already-loaded relations; null when the conversation may be created. */\nexport function checkNewConversation(creator: Party, otherIds: string[], rel: Relations): NewConversationProblem | null {\n  const others = [...new Set(otherIds)].filter((id) => id !== creator.id);\n  if (others.length < 1) return 'TOO_FEW_PARTICIPANTS';\n  if (others.length + 1 > MAX_PARTICIPANTS) return 'TOO_MANY_PARTICIPANTS';\n  const users = others.map((id) => rel.users.get(id));\n  if (users.some((u) => !u || !canMessageWith(creator, u, rel))) return 'CONTACT_RULES';\n  const roles = [creator.role, ...users.map((u) => u!.role)];\n  if (roles.includes('STUDENT') && !roles.some(isStaff)) return 'GROUP_NEEDS_STAFF';\n  return null;\n}\n\n/** FR-6: throws 403 (nothing created) on any violation; returns the other participants and involvesStudent (FR-30). */\nexport async function validateNewConversation(creator: Party, otherIds: string[]): Promise<{ participantIds: string[]; involvesStudent: boolean }> {\n  const rel = await loadRelations([creator.id, ...otherIds]);\n  const problem = checkNewConversation(creator, otherIds, rel);\n  if (problem === 'TOO_FEW_PARTICIPANTS') throw new AppError('VALIDATION_ERROR', 'Pick at least one recipient.');\n  if (problem) throw new AppError('FORBIDDEN', 'You cannot start this conversation.', { reason: problem });\n  const participantIds = [...new Set(otherIds)].filter((id) => id !== creator.id);\n  const involvesStudent = creator.role === 'STUDENT' || participantIds.some((id) => rel.users.get(id)!.role === 'STUDENT');\n  return { participantIds, involvesStudent };\n}\n\n/**\n * A4/FR-7 pure: staff can always send; anyone else needs a live relationship with at least one\n * staff participant who has not left. `participants` are the ones still in the conversation.\n */\nexport function canSendInWith(sender: Party, participantIds: string[], rel: Relations): boolean {\n  if (isStaff(sender.role)) return true;\n  return participantIds.some((id) => {\n    const u = rel.users.get(id);\n    return !!u && isStaff(u.role) && canMessageWith(sender, u, rel);\n  });\n}\n\nexport async function canSendIn(sender: Party, participantIds: string[]): Promise<boolean> {\n  if (isStaff(sender.role)) return true;\n  return canSendInWith(sender, participantIds, await loadRelations([sender.id, ...participantIds]));\n}\nimport type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { rateLimit } from '@/server/rate-limit';\nimport { EDIT_WINDOW_MS, RATE_LIMIT } from '@/lib/messaging/constants';\nimport type { ListMessagesQuery, SendMessageInput } from '@/lib/validators/messaging';\nimport type { Party } from './contact-rules';\nimport { canSendIn } from './contact-rules';\nimport { getParticipation } from './access';\nimport { onMessageSent } from './notifications';\n\n/**\n * PRD-13 message service (FR-3, FR-7, FR-10, FR-11, FR-13, FR-15, FR-27, FR-31, NFR-2..4).\n * Messages are never hard-deleted (NFR-3); normal users see deleted ones redacted.\n */\n\ntype Tx = Prisma.TransactionClient;\n\nexport const userSummarySelect = { id: true, firstName: true, lastName: true, role: true } as const;\ntype UserRow = { id: string; firstName: string; lastName: string; role: Party['role'] };\n\nexport const toUserSummary = (u: UserRow) => ({ id: u.id, name: `${u.firstName} ${u.lastName}`, role: u.role, avatarUrl: null as string | null });\nexport type UserSummary = ReturnType<typeof toUserSummary>;\n\nexport const messageInclude = {\n  sender: { select: userSummarySelect },\n  attachments: { select: { file: { select: { id: true, originalName: true, mimeType: true, sizeBytes: true } } } },\n} as const;\nexport type MessageRow = Prisma.MessageGetPayload<{ include: typeof messageInclude }>;\n\nexport const toAttachment = (f: MessageRow['attachments'][number]['file']) => ({\n  fileId: f.id,\n  name: f.originalName,\n  mimeType: f.mimeType,\n  size: f.sizeBytes,\n  url: `/api/files/${f.id}`,\n});\n\nexport function toMessageDTO(m: MessageRow, viewerId: string, now: Date = new Date()) {\n  const deleted = m.deletedAt !== null;\n  const isOwn = m.senderId === viewerId;\n  return {\n    id: m.id,\n    conversationId: m.conversationId,\n    sender: toUserSummary(m.sender),\n    body: deleted ? null : m.body,\n    deleted,\n    editedAt: m.editedAt?.toISOString() ?? null,\n    createdAt: m.createdAt.toISOString(),\n    updatedAt: m.updatedAt.toISOString(),\n    attachments: deleted ? [] : m.attachments.map((a) => toAttachment(a.file)),\n    isOwn,\n    canEdit: isOwn && !deleted && now.getTime() - m.createdAt.getTime() <= EDIT_WINDOW_MS,\n  };\n}\nexport type MessageDTO = ReturnType<typeof toMessageDTO>;\n\n/** NFR-4: 30 messages (sends + creates) per minute per user. */\nexport function assertRateLimit(userId: string): void {\n  const r = rateLimit(`msg:${userId}`, RATE_LIMIT.limit, RATE_LIMIT.windowMs);\n  if (!r.ok) throw new AppError('RATE_LIMITED', 'You are sending messages too quickly.', { retryAfterMs: r.retryAfterMs });\n}\n\nconst POLL_TAKE = 100;\n\n/** Keyset pagination on (createdAt, id). `after` (+`since`) is the 5 s poll; `before` loads older pages. */\nexport async function listMessages(user: Party, conversationId: string, q: ListMessagesQuery) {\n  await getParticipation(user.id, conversationId);\n  const now = new Date();\n  const dto = (rows: MessageRow[]) => rows.map((m) => toMessageDTO(m, user.id, now));\n  const cursorId = q.after ?? q.before;\n  const cursor = cursorId\n    ? await prisma.message.findFirst({ where: { id: cursorId, conversationId }, select: { id: true, createdAt: true } })\n    : null;\n  if (cursorId && !cursor) throw new AppError('NOT_FOUND', 'Message not found');\n\n  if (q.after && cursor) {\n    const newer = { OR: [{ createdAt: { gt: cursor.createdAt } }, { createdAt: cursor.createdAt, id: { gt: cursor.id } }] };\n    const [messages, changed] = await Promise.all([\n      prisma.message.findMany({ where: { conversationId, ...newer }, include: messageInclude, orderBy: [{ createdAt: 'asc' }, { id: 'asc' }], take: POLL_TAKE }),\n      q.since\n        ? prisma.message.findMany({\n            where: { conversationId, updatedAt: { gt: new Date(q.since) }, NOT: newer },\n            include: messageInclude,\n            orderBy: [{ createdAt: 'asc' }, { id: 'asc' }],\n            take: POLL_TAKE,\n          })\n        : Promise.resolve([]),\n    ]);\n    return { messages: dto(messages), changed: dto(changed), hasMore: false };\n  }\n\n  const older = cursor ? { OR: [{ createdAt: { lt: cursor.createdAt } }, { createdAt: cursor.createdAt, id: { lt: cursor.id } }] } : {};\n  const rows = await prisma.message.findMany({\n    where: { conversationId, ...older },\n    include: messageInclude,\n    orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],\n    take: q.limit + 1,\n  });\n  const hasMore = rows.length > q.limit;\n  return { messages: dto(rows.slice(0, q.limit).reverse()), changed: [], hasMore };\n}\n\n/**\n * The send transaction body, shared with createConversation (FR-11, FR-27, FR-31, A11):\n * insert, link attachments (owned by the sender, unattached, context 'message'), bump\n * lastMessageAt, mark the sender read and unarchive for everyone else.\n */\nexport async function insertMessage(tx: Tx, senderId: string, conversationId: string, input: SendMessageInput): Promise<MessageRow> {\n  const fileIds = [...new Set(input.fileIds ?? [])];\n  if (fileIds.length) {\n    const ok = await tx.fileObject.count({ where: { id: { in: fileIds }, ownerId: senderId, contextId: null, context: 'message' } });\n    if (ok !== fileIds.length) throw new AppError('VALIDATION_ERROR', 'One or more files cannot be attached.', { fileIds });\n  }\n  const created = await tx.message.create({ data: { conversationId, senderId, body: input.body } });\n  if (fileIds.length) {\n    await tx.fileObject.updateMany({ where: { id: { in: fileIds } }, data: { contextId: created.id } });\n    await tx.messageAttachment.createMany({ data: fileIds.map((fileId) => ({ messageId: created.id, fileId })) });\n  }\n  await tx.conversation.update({ where: { id: conversationId }, data: { lastMessageAt: created.createdAt } });\n  await tx.conversationParticipant.update({\n    where: { conversationId_userId: { conversationId, userId: senderId } },\n    data: { lastReadAt: created.createdAt },\n  });\n  await tx.conversationParticipant.updateMany({\n    where: { conversationId, userId: { not: senderId }, archivedAt: { not: null } },\n    data: { archivedAt: null },\n  });\n  return tx.message.findUniqueOrThrow({ where: { id: created.id }, include: messageInclude });\n}\n\nexport const afterSend = (m: MessageRow) =>\n  onMessageSent(m.conversationId, { senderId: m.senderId, senderName: `${m.sender.firstName} ${m.sender.lastName}`, body: m.body });\n\n/** FR-7/FR-11: rate limit → participation (404) → canSendIn (403 RELATIONSHIP_ENDED) → transaction → after-commit notify. */\nexport async function sendMessage(user: Party, conversationId: string, input: SendMessageInput): Promise<MessageDTO> {\n  assertRateLimit(user.id);\n  await getParticipation(user.id, conversationId);\n  const others = await prisma.conversationParticipant.findMany({\n    where: { conversationId, leftAt: null, userId: { not: user.id } },\n    select: { userId: true },\n  });\n  if (!(await canSendIn(user, others.map((o) => o.userId)))) {\n    throw new AppError('FORBIDDEN', 'You can no longer send messages in this conversation.', { reason: 'RELATIONSHIP_ENDED' });\n  }\n  const message = await prisma.$transaction((tx) => insertMessage(tx, user.id, conversationId, input));\n  await afterSend(message);\n  return toMessageDTO(message, user.id);\n}\n\n/** FR-15: own message, still a participant, not deleted, within 15 minutes. */\nasync function loadOwnEditable(user: Party, messageId: string, now: Date) {\n  const m = await prisma.message.findUnique({ where: { id: messageId }, select: { id: true, conversationId: true, senderId: true, body: true, createdAt: true, deletedAt: true } });\n  if (!m) throw new AppError('NOT_FOUND', 'Message not found');\n  await getParticipation(user.id, m.conversationId);\n  const refuse = (reason: string, msg: string) => new AppError('FORBIDDEN', msg, { reason });\n  if (m.senderId !== user.id) throw refuse('NOT_SENDER', 'You can only change your own messages.');\n  if (m.deletedAt) throw refuse('ALREADY_DELETED', 'This message was deleted.');\n  if (now.getTime() - m.createdAt.getTime() > EDIT_WINDOW_MS) throw refuse('EDIT_WINDOW_EXPIRED', 'Messages can only be changed within 15 minutes of sending.');\n  return m;\n}\n\n/** FR-3/FR-15: stores the old body as a MessageRevision, then updates body + editedAt, in one transaction. */\nexport async function editMessage(user: Party, messageId: string, body: string, now: Date = new Date()): Promise<MessageDTO> {\n  const m = await loadOwnEditable(user, messageId, now);\n  const updated = await prisma.$transaction(async (tx) => {\n    await tx.messageRevision.create({ data: { messageId, body: m.body } });\n    return tx.message.update({ where: { id: messageId }, data: { body, editedAt: now }, include: messageInclude });\n  });\n  return toMessageDTO(updated, user.id, now);\n}\n\n/** FR-15/NFR-3: soft delete only. */\nexport async function deleteMessage(user: Party, messageId: string, now: Date = new Date()): Promise<MessageDTO> {\n  await loadOwnEditable(user, messageId, now);\n  const updated = await prisma.message.update({ where: { id: messageId }, data: { deletedAt: now }, include: messageInclude });\n  return toMessageDTO(updated, user.id, now);\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { SessionUser } from '@/server/auth/requireRole';\n\n/**\n * PRD-13 access helpers (NFR-1, A7). A participant who has left is a non-participant (404);\n * a conversation cuid is never authorisation. The safeguarding flag is always read from the DB.\n */\n\nconst notFound = () => new AppError('NOT_FOUND', 'Conversation not found');\n\nexport async function getParticipation(userId: string, conversationId: string) {\n  const row = await prisma.conversationParticipant.findUnique({ where: { conversationId_userId: { conversationId, userId } } });\n  if (!row || row.leftAt) throw notFound();\n  return row;\n}\n\nexport async function isSafeguardingLead(user: { id: string; role: string }): Promise<boolean> {\n  if (user.role !== 'ADMIN') return false;\n  const row = await prisma.user.findUnique({ where: { id: user.id }, select: { isSafeguardingLead: true, status: true } });\n  return !!row?.isSafeguardingLead && row.status === 'ACTIVE';\n}\n\n/** Service-level guard: 403 unless an ACTIVE ADMIN with isSafeguardingLead (fresh DB read). */\nexport async function assertSafeguardingLead(user: { id: string; role: string }): Promise<void> {\n  if (!(await isSafeguardingLead(user))) {\n    throw new AppError('FORBIDDEN', 'Only safeguarding leads can access this area.');\n  }\n}\n\n// The guards below import auth lazily so services (and their integration tests) never load next-auth.\n\n/** Route guard: 401 when signed out, 403 for anyone but a safeguarding lead. */\nexport async function requireSafeguardingLead(): Promise<SessionUser> {\n  const { requireRole } = await import('@/server/auth/requireRole');\n  const user = await requireRole('ADMIN');\n  await assertSafeguardingLead(user);\n  return user;\n}\n\n/** Page guard: redirects to /login or /forbidden. */\nexport async function requirePageSafeguardingLead(): Promise<SessionUser> {\n  const [{ requirePageRole }, { redirect }] = await Promise.all([import('@/server/auth/requireRole'), import('next/navigation')]);\n  const user = await requirePageRole('ADMIN');\n  if (!(await isSafeguardingLead(user))) redirect('/forbidden');\n  return user;\n}\nimport { fromZonedTime } from 'date-fns-tz';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport type { MessagingSettingsInput } from '@/lib/validators/messaging';\n\n/** PRD-13 quiet hours (FR-20, FR-21, ADR-6, ADR-12). HH:mm strings in the school timezone; ranges may wrap midnight. */\n\nexport interface QuietHours {\n  quietStart: string | null;\n  quietEnd: string | null;\n}\n\n/** [start, end) — e.g. 22:00–07:00 covers 23:30 and 06:59 but not 07:00. start === end is never quiet. */\nexport function isInQuietHours(hhmm: string, start: string, end: string): boolean {\n  if (start === end) return false;\n  return start < end ? hhmm >= start && hhmm < end : hhmm >= start || hhmm < end;\n}\n\n/** The UTC instant quiet hours end, or null when `now` is outside quiet hours (or none are set). DST-safe via fromZonedTime. */\nexport function quietHoursEnd(now: Date, tz: string, settings: QuietHours | null): Date | null {\n  if (!settings?.quietStart || !settings.quietEnd) return null;\n  if (!isInQuietHours(formatInSchoolTz(now, 'HH:mm', tz), settings.quietStart, settings.quietEnd)) return null;\n  const today = formatInSchoolTz(now, 'yyyy-MM-dd', tz);\n  const end = fromZonedTime(`${today} ${settings.quietEnd}`, tz);\n  if (end > now) return end;\n  const tomorrow = new Date(Date.parse(`${today}T12:00:00Z`) + 86_400_000).toISOString().slice(0, 10);\n  return fromZonedTime(`${tomorrow} ${settings.quietEnd}`, tz);\n}\n\nexport async function getSettings(userId: string): Promise<QuietHours> {\n  const row = await prisma.messagingSettings.findUnique({ where: { userId }, select: { quietStart: true, quietEnd: true } });\n  return { quietStart: row?.quietStart ?? null, quietEnd: row?.quietEnd ?? null };\n}\n\nexport async function putSettings(userId: string, input: MessagingSettingsInput): Promise<QuietHours> {\n  const { quietStart, quietEnd } = input;\n  if ((quietStart === null) !== (quietEnd === null)) throw new AppError('VALIDATION_ERROR', 'Set both start and end, or neither.');\n  if (quietStart !== null && quietStart === quietEnd) throw new AppError('VALIDATION_ERROR', 'Start and end must differ.');\n  const row = await prisma.messagingSettings.upsert({\n    where: { userId },\n    create: { userId, quietStart, quietEnd },\n    update: { quietStart, quietEnd },\n    select: { quietStart: true, quietEnd: true },\n  });\n  return row;\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { notify } from '@/server/notifications/notify';\nimport { EMAIL_DELAY_MS } from '@/lib/messaging/constants';\n\n/** PRD-13 notification side effects (FR-19, FR-20, FR-26). Never throw: call after the transaction commits. */\n\n/** The one link builder for a conversation; markRead matches notifications on it. */\nexport const conversationLink = (conversationId: string) => `/messages/${conversationId}`;\n\nconst PREVIEW_MAX = 140;\n\n/**\n * FR-19/FR-20: for each other participant who has not muted or left — replace their unread\n * message.received row for this conversation with one fresh in-app notification, and start the\n * 10-minute email clock (create-only: the first unread message sets dueAt).\n */\nexport async function onMessageSent(\n  conversationId: string,\n  message: { senderId: string; senderName: string; body: string },\n  now: Date = new Date(),\n): Promise<void> {\n  try {\n    const recipients = await prisma.conversationParticipant.findMany({\n      where: { conversationId, userId: { not: message.senderId }, leftAt: null, mutedAt: null },\n      select: { userId: true },\n    });\n    const userIds = recipients.map((r) => r.userId);\n    if (!userIds.length) return;\n    const link = conversationLink(conversationId);\n    await prisma.notification.deleteMany({ where: { userId: { in: userIds }, type: 'message.received', readAt: null, link } });\n    const preview = message.body.length > PREVIEW_MAX ? `${message.body.slice(0, PREVIEW_MAX - 1)}…` : message.body;\n    await notify({ type: 'message.received', userIds, title: `New message from ${message.senderName}`, body: preview, link });\n    await prisma.pendingMessageEmail.createMany({\n      data: userIds.map((userId) => ({ userId, conversationId, dueAt: new Date(now.getTime() + EMAIL_DELAY_MS) })),\n      skipDuplicates: true,\n    });\n  } catch (error) {\n    logger.error('onMessageSent failed', { conversationId, message: error instanceof Error ? error.message : String(error) });\n  }\n}\n\n/** FR-26: notify every ACTIVE safeguarding lead (mandatory in-app + email). Never includes the message text. */\nexport async function onMessageReported(reportId: string): Promise<void> {\n  try {\n    const leads = await prisma.user.findMany({\n      where: { role: 'ADMIN', isSafeguardingLead: true, status: 'ACTIVE', archivedAt: null },\n      select: { id: true },\n    });\n    await notify({\n      type: 'message.reported',\n      userIds: leads.map((l) => l.id),\n      title: 'A message was reported',\n      body: 'A message has been reported for safeguarding review.',\n      link: `/admin/safeguarding?report=${reportId}`,\n      email: { template: 'generic-notification' },\n    });\n  } catch (error) {\n    logger.error('onMessageReported failed', { reportId, message: error instanceof Error ? error.message : String(error) });\n  }\n}\nimport { prisma } from '@/server/db';\nimport { notify } from '@/server/notifications/notify';\nimport { getSchoolTimezone } from '@/server/assignments/assignments-service';\nimport { quietHoursEnd } from './quiet-hours';\nimport { conversationLink } from './notifications';\n\n/** PRD-13 deferred message email (FR-4, FR-20). Run by POST /api/internal/email/dispatch. */\n\nconst BATCH = 200;\n\nexport async function processPendingMessageEmails(now: Date = new Date()): Promise<{ sent: number; deferred: number; dropped: number }> {\n  const summary = { sent: 0, deferred: 0, dropped: 0 };\n  const rows = await prisma.pendingMessageEmail.findMany({ where: { dueAt: { lte: now } }, orderBy: { dueAt: 'asc' }, take: BATCH });\n  if (!rows.length) return summary;\n  const tz = await getSchoolTimezone();\n\n  for (const row of rows) {\n    // Claim by delete: a concurrent run that loses the race skips the row.\n    const claimed = await prisma.pendingMessageEmail.deleteMany({ where: { id: row.id } });\n    if (claimed.count !== 1) continue;\n\n    const [participant, settings, conversation] = await Promise.all([\n      prisma.conversationParticipant.findUnique({ where: { conversationId_userId: { conversationId: row.conversationId, userId: row.userId } } }),\n      prisma.messagingSettings.findUnique({ where: { userId: row.userId }, select: { quietStart: true, quietEnd: true } }),\n      prisma.conversation.findUnique({ where: { id: row.conversationId }, select: { subject: true } }),\n    ]);\n    if (!participant || !conversation || participant.leftAt || participant.mutedAt || (participant.lastReadAt && participant.lastReadAt >= row.createdAt)) {\n      summary.dropped++;\n      continue;\n    }\n\n    const quietEnd = quietHoursEnd(now, tz, settings);\n    if (quietEnd) {\n      await prisma.pendingMessageEmail.upsert({\n        where: { userId_conversationId: { userId: row.userId, conversationId: row.conversationId } },\n        create: { userId: row.userId, conversationId: row.conversationId, dueAt: quietEnd, createdAt: row.createdAt },\n        update: {},\n      });\n      summary.deferred++;\n      continue;\n    }\n\n    await notify({\n      type: 'message.received',\n      userIds: [row.userId],\n      title: conversation.subject ? `Unread messages: ${conversation.subject}` : 'You have unread messages',\n      body: 'You have unread direct messages in SchoolHub. Open the conversation to read them.',\n      link: conversationLink(row.conversationId),\n      inApp: false,\n      email: { template: 'generic-notification' },\n    });\n    summary.sent++;\n  }\n  return summary;\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { Party } from './contact-rules';\nimport { getParticipation } from './access';\nimport { onMessageReported } from './notifications';\n\n/** PRD-13 FR-22/FR-26, A12: a participant reports someone else's message; one OPEN report per (message, reporter). */\nexport async function reportMessage(user: Party, messageId: string, reason: string) {\n  const m = await prisma.message.findUnique({ where: { id: messageId }, select: { conversationId: true, senderId: true } });\n  if (!m) throw new AppError('NOT_FOUND', 'Message not found');\n  await getParticipation(user.id, m.conversationId);\n  if (m.senderId === user.id) throw new AppError('FORBIDDEN', 'You cannot report your own message.');\n  const existing = await prisma.messageReport.findFirst({ where: { messageId, reporterId: user.id, status: 'OPEN' }, select: { id: true } });\n  if (existing) throw new AppError('CONFLICT', 'You have already reported this message.');\n  const report = await prisma.messageReport.create({ data: { messageId, reporterId: user.id, reason }, select: { id: true, status: true } });\n  await onMessageReported(report.id);\n  return { reportId: report.id, status: report.status };\n}\n/** PRD-13 limits shared by validators, services and the client (FR-11, FR-13, FR-15). Client-safe. */\nexport const BODY_MAX = 5000;\nexport const COUNTER_FROM = 4500;\nexport const MAX_FILES = 5;\nexport const MAX_PARTICIPANTS = 25;\nexport const SUBJECT_MAX = 120;\nexport const REASON_MAX = 1000;\nexport const EDIT_WINDOW_MS = 15 * 60_000;\nexport const THREAD_POLL_MS = 5000;\nexport const LIST_POLL_MS = 30000;\nexport const PAGE_SIZE = 30;\nexport const RATE_LIMIT = { limit: 30, windowMs: 60_000 } as const;\nexport const EMAIL_DELAY_MS = 10 * 60_000;\nexport const DELETED_TEXT = 'This message was deleted';","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01X8jDsQiMhbKioRdDJWwaf4","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
