{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VM5VxrNQZ5cKkc4YNu4HqH","type":"tool_result","content":"1\t-- CreateEnum\n2\tCREATE TYPE \"AttendanceStatus\" AS ENUM ('PRESENT', 'ABSENT', 'LATE', 'EXCUSED');\n3\t\n4\t-- CreateEnum\n5\tCREATE TYPE \"AttendanceMode\" AS ENUM ('PER_PERIOD', 'DAILY_HOMEROOM', 'BOTH');\n6\t\n7\t-- AlterTable\n8\tALTER TABLE \"SchoolSettings\" ADD COLUMN     \"attendanceAlertThreshold\" INTEGER NOT NULL DEFAULT 90,\n9\tADD COLUMN     \"attendanceMode\" \"AttendanceMode\" NOT NULL DEFAULT 'PER_PERIOD';\n10\t\n11\t-- CreateTable\n12\tCREATE TABLE \"AttendanceSession\" (\n13\t    \"id\" TEXT NOT NULL,\n14\t    \"courseId\" TEXT,\n15\t    \"sectionId\" TEXT,\n16\t    \"periodId\" TEXT,\n17\t    \"date\" DATE NOT NULL,\n18\t    \"takenById\" TEXT NOT NULL,\n19\t    \"updatedById\" TEXT NOT NULL,\n20\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n21\t    \"updatedAt\" TIMESTAMP(3) NOT NULL,\n22\t\n23\t    CONSTRAINT \"AttendanceSession_pkey\" PRIMARY KEY (\"id\")\n24\t);\n25\t\n26\t-- CreateTable\n27\tCREATE TABLE \"AttendanceRecord\" (\n28\t    \"id\" TEXT NOT NULL,\n29\t    \"sessionId\" TEXT NOT NULL,\n30\t    \"studentId\" TEXT NOT NULL,\n31\t    \"status\" \"AttendanceStatus\" NOT NULL,\n32\t    \"minutesLate\" INTEGER,\n33\t    \"note\" TEXT,\n34\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n35\t    \"updatedAt\" TIMESTAMP(3) NOT NULL,\n36\t\n37\t    CONSTRAINT \"AttendanceRecord_pkey\" PRIMARY KEY (\"id\")\n38\t);\n39\t\n40\t-- CreateIndex\n41\tCREATE INDEX \"AttendanceSession_date_idx\" ON \"AttendanceSession\"(\"date\");\n42\t\n43\t-- CreateIndex\n44\tCREATE INDEX \"AttendanceRecord_studentId_createdAt_idx\" ON \"AttendanceRecord\"(\"studentId\", \"createdAt\");\n45\t\n46\t-- CreateIndex\n47\tCREATE UNIQUE INDEX \"AttendanceRecord_sessionId_studentId_key\" ON \"AttendanceRecord\"(\"sessionId\", \"studentId\");\n48\t\n49\t-- AddForeignKey\n50\tALTER TABLE \"AttendanceSession\" ADD CONSTRAINT \"AttendanceSession_courseId_fkey\" FOREIGN KEY (\"courseId\") REFERENCES \"Course\"(\"id\") ON DELETE CASCADE ON UPDATE CASCADE;\n51\t\n52\t-- AddForeignKey\n53\tALTER TABLE \"AttendanceSession\" ADD CONSTRAINT \"AttendanceSession_sectionId_fkey\" FOREIGN KEY (\"sectionId\") REFERENCES \"Section\"(\"id\") ON DELETE CASCADE ON UPDATE CASCADE;\n54\t\n55\t-- AddForeignKey\n56\tALTER TABLE \"AttendanceSession\" ADD CONSTRAINT \"AttendanceSession_periodId_fkey\" FOREIGN KEY (\"periodId\") REFERENCES \"Period\"(\"id\") ON DELETE SET NULL ON UPDATE CASCADE;\n57\t\n58\t-- AddForeignKey\n59\tALTER TABLE \"AttendanceSession\" ADD CONSTRAINT \"AttendanceSession_takenById_fkey\" FOREIGN KEY (\"takenById\") REFERENCES \"User\"(\"id\") ON DELETE RESTRICT ON UPDATE CASCADE;\n60\t\n61\t-- AddForeignKey\n62\tALTER TABLE \"AttendanceSession\" ADD CONSTRAINT \"AttendanceSession_updatedById_fkey\" FOREIGN KEY (\"updatedById\") REFERENCES \"User\"(\"id\") ON DELETE RESTRICT ON UPDATE CASCADE;\n63\t\n64\t-- AddForeignKey\n65\tALTER TABLE \"AttendanceRecord\" ADD CONSTRAINT \"AttendanceRecord_sessionId_fkey\" FOREIGN KEY (\"sessionId\") REFERENCES \"AttendanceSession\"(\"id\") ON DELETE CASCADE ON UPDATE CASCADE;\n66\t\n67\t-- AddForeignKey\n68\tALTER TABLE \"AttendanceRecord\" ADD CONSTRAINT \"AttendanceRecord_studentId_fkey\" FOREIGN KEY (\"studentId\") REFERENCES \"User\"(\"id\") ON DELETE RESTRICT ON UPDATE CASCADE;\n69\t\n70\t\n71\t-- Hand-written (ADR-2): Prisma can't express these.\n72\t-- FR-2: a session is either a course session or a daily section register, never both/neither.\n73\tALTER TABLE \"AttendanceSession\" ADD CONSTRAINT \"attendance_session_one_target_chk\"\n74\t  CHECK (((\"courseId\" IS NOT NULL)::int + (\"sectionId\" IS NOT NULL)::int) = 1);\n75\t\n76\t-- FR-3: one register per course/date/period and one daily register per section/date.\n77\tCREATE UNIQUE INDEX \"attendance_session_course_uq\" ON \"AttendanceSession\"(\"courseId\", \"date