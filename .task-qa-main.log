----------\n+// PRD-14 School Calendar, Events & Holidays (FR-2, FR-3). Recurring events are\n+// stored once and expanded at read time (src/server/calendar/recurrence.ts).\n+// ---------------------------------------------------------------------------\n+\n+/// PRD-12 FR-1 values; owned here until PRD-12 (announcements) lands and adopts it.\n+enum AudienceType {\n+  SCHOOL\n+  STAFF\n+  ROLE\n+  GRADE_LEVEL\n+  SECTION\n+  COURSE\n+}\n+\n+enum EventCategory {\n+  HOLIDAY\n+  TERM_BREAK\n+  EXAM\n+  EVENT\n+  MEETING\n+  TRIP\n+  SPORTS\n+  DEADLINE\n+  OTHER\n+}\n+\n+enum Recurrence {\n+  NONE\n+  WEEKLY\n+  MONTHLY\n+}\n+\n+enum RsvpResponse {\n+  YES\n+  NO\n+  MAYBE\n+}\n+\n+/// All-day events run [school-tz midnight, next midnight) -- endAt is exclusive (FR-4).\n+model CalendarEvent {\n+  id                 String          @id @default(cuid())\n+  title              String\n+  description        String?\n+  category           EventCategory\n+  startAt            DateTime\n+  endAt              DateTime\n+  allDay             Boolean         @default(false)\n+  location           String?\n+  /// Stored, unused (NFR-11: no room booking).\n+  roomId             String?\n+  recurrence         Recurrence      @default(NONE)\n+  recurrenceUntil    DateTime?       @db.Date\n+  isNoSchool         Boolean         @default(false)\n+  rsvpEnabled        Boolean         @default(false)\n+  rsvpDeadline       DateTime?\n+  /// D-1: the reminder's \"once per event\" claim.\n+  rsvpReminderSentAt DateTime?\n+  isPublic           Boolean         @default(false)\n+  createdById        String\n+  createdBy          User            @relation(\"CalendarEventCreator\", fields: [createdById], references: [id])\n+  createdAt          DateTime        @default(now())\n+  updatedAt          DateTime        @updatedAt\n+  audiences          EventAudience[]\n+  rsvps              EventRsvp[]\n+\n+  @@index([startAt, endAt])\n+}\n+\n+/// refId: gradeLevelId | sectionId | courseId | Role na