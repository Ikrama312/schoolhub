{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Diq5sCwwwEged2gZUxqLUm","type":"tool_result","content":"// Pure and isomorphic (ADR-7): imported by the grading UI for the live preview and by the\n// service for the stored value. No Prisma client import. Decimal comes from Prisma's browser\n// runtime, which bundles decimal.js, so no new dependency is needed (ADR-1); decimal.js itself is\n// only a transitive devDependency here and would not be installed in production.\nimport { Decimal } from '@prisma/client/runtime/index-browser.js';\n\nexport { Decimal };\nexport type DecimalValue = string | number | { toString(): string };\n\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\nexport const dec = (v: DecimalValue) => new Decimal(typeof v === 'number' ? v : v.toString());\n\n/** \"14.40\" — the wire and storage form (NFR-1, D5). */\nexport const fixed2 = (v: DecimalValue) => dec(v).toDecimalPlaces(2, Decimal.ROUND_HALF_UP).toFixed(2);\n\n/**\n * FR-23: ceil(elapsed / 24 h) on UTC instants, so a DST change in the school timezone does not\n * matter and exactly 24 h late is 1 day (NFR-9). On time (≤ dueAt) is 0.\n */\nexport function lateDays(submittedAt: Date, dueAt: Date): number {\n  const ms = submittedAt.getTime() - dueAt.getTime();\n  return ms <= 0 ? 0 : Math.ceil(ms / DAY_MS);\n}\n\n/** FR-30: min(lateDays × perDay, max), the pre-filled penalty percent. */\nexport function defaultPenalty(days: number, perDay: DecimalValue, max: DecimalValue): Decimal {\n  return Decimal.min(dec(perDay).mul(days), dec(max));\n}\n\n/** FR-31: raw × (1 − pct/100), rounded half-up to 2 dp. */\nexport function computeFinalScore(raw: DecimalValue, penaltyPercent: DecimalValue): Decimal {\n  return dec(raw)\n    .mul(new Decimal(100).minus(dec(penaltyPercent)))\n    .div(100)\n    .toDecimalPlaces(2, Decimal.ROUND_HALF_UP);\n}\n\n/** FR-11: Σ criterion maxPoints. */\nexport function rubricTotal(criteria: readonly { maxPoints: DecimalValue }[]): Decimal {\n  return criteria.reduce((sum, c) => sum.plus(dec(c.maxPoints)), new Decimal(0));\n}\n\n/** FR-36: maxPoints, or 120 % of it when extra credit is allowed (raw score only). */\nexport function maxRawScore(maxPoints: DecimalValue, allowExtraCredit: boolean): Decimal {\n  return allowExtraCredit ? dec(maxPoints).mul('1.2') : dec(maxPoints);\n}\n\nexport type ChipStatus = 'NOT_SUBMITTED' | 'SUBMITTED' | 'LATE' | 'GRADED' | 'RETURNED' | 'EXEMPT';\n\n/** FR-28 roster chip. Exempt wins; then the most advanced state of the submission. */\nexport function submissionChipStatus(row: {\n  exempt: boolean;\n  submission: { status: 'SUBMITTED' | 'RETURNED'; gradedAt: Date | string | null; isLate: boolean } | null;\n}): ChipStatus {\n  if (row.exempt) return 'EXEMPT';\n  const s = row.submission;\n  if (!s) return 'NOT_SUBMITTED';\n  if (s.status === 'RETURNED') return 'RETURNED';\n  if (s.gradedAt) return 'GRADED';\n  return s.isLate ? 'LATE' : 'SUBMITTED';\n}\nimport { formatInTimeZone, fromZonedTime } from 'date-fns-tz';\n\n/**\n * Formats a UTC date/ISO-string in the school's configured timezone\n * (SchoolSettings.timezone). pattern is a date-fns format string.\n */\nexport function formatInSchoolTz(\n  date: Date | string,\n  pattern: string,\n  timezone: string,\n): string {\n  const value = typeof date === 'string' ? new Date(date) : date;\n  return formatInTimeZone(value, timezone, pattern);\n}\n\n/** ISO weekday (1=Mon … 7=Sun) and 'HH:mm' wall clock in the school timezone. Never the browser's. */\nexport function schoolNow(now: Date, tz: string): { isoDay: number; hhmm: string } {\n  return { isoDay: Number(formatInSchoolTz(now, 'i', tz)), hhmm: formatInSchoolTz(now, 'HH:mm', tz) };\n}\n\n/**\n * FR-10: 23:59 school-local on the first teaching weekday after today (looks ≤7 days ahead),\n * as a UTC instant. teachingDays are ISO weekdays (SchoolDay.dayOfWeek). No teaching day → tomorrow.\n */\nexport function nextTeachingDayDueAt(now: Date, tz: string, teachingDays: readonly number[]): Date {\n  const today = formatInSchoolTz(now, 'yyyy-MM-dd', tz);\n  const dayAt = (offset: number) => new Date(Date.parse(`${today}T12:00:00Z`) + offset * 86_400_000);\n  let target = dayAt(1);\n  for (let offset = 1; offset <= 7; offset++) {\n    const day = dayAt(offset);\n    if (teachingDays.includes(day.getUTCDay() || 7)) {\n      target = day;\n      break;\n    }\n  }\n  return fromZonedTime(`${target.toISOString().slice(0, 10)} 23:59`, tz);\n}\n\n/** The period running at hhmm ([start, end)) and the next one to start after hhmm. */\nexport function nowAndNext<P extends { startTime: string; endTime: string }>(\n  periods: P[],\n  hhmm: string,\n): { now: P | null; next: P | null } {\n  const sorted = [...periods].sort((a, b) => a.startTime.localeCompare(b.startTime));\n  return {\n    now: sorted.find((p) => p.startTime <= hhmm && hhmm < p.endTime) ?? null,\n    next: sorted.find((p) => p.startTime > hhmm) ?? null,\n  };\n}\n\n/** ISO weekday labels, index 1=Mon … 7=Sun (index 0 unused). */\nexport const ISO_DAY_NAMES = ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];\ntests/unit/assignments/assignment-validators.test.ts:1:import { describe, expect, it } from 'vitest';\ntests/unit/assignments/assignment-validators.test.ts:14:describe('assignmentInput (FR-7, FR-11)', () => {\ntests/unit/assignments/assignment-validators.test.ts:15:  it('accepts the minimum and applies defaults; decimals become 2 dp strings', () => {\ntests/unit/assignments/assignment-validators.test.ts:23:  it('enforces field limits', () => {\ntests/unit/assignments/assignment-validators.test.ts:32:  it('requires lateCutoffAt after dueAt', () => {\ntests/unit/assignments/assignment-validators.test.ts:37:  it('rejects a rubric whose criteria do not sum to maxPoints, with the FR-11 copy', () => {\ntests/unit/assignments/assignment-validators.test.ts:43:  it('rejects a level worth more than its criterion', () => {\ntests/unit/assignments/assignment-validators.test.ts:51:  it('SCHEDULED needs availableFrom', () => {\ntests/unit/assignments/assignment-validators.test.ts:56:describe('submissionInput / gradeInput', () => {\ntests/unit/assignments/assignment-validators.test.ts:57:  it('limits submission text and files', () => {\ntests/unit/assignments/assignment-validators.test.ts:63:  it('penalty 0–100, feedback ≤ 10k, return defaults false', () => {\ntests/unit/assignments/grading-math.test.ts:1:import { describe, expect, it } from 'vitest';\ntests/unit/assignments/grading-math.test.ts:15:describe('lateDays (FR-23, NFR-9)', () => {\ntests/unit/assignments/grading-math.test.ts:17:  it('is 0 on time and exactly at the deadline', () => {\ntests/unit/assignments/grading-math.test.ts:21:  it('1 ms late is 1 day; exactly 24 h is 1; 24 h + 1 ms is 2', () => {\ntests/unit/assignments/grading-math.test.ts:26:  it('PRD example: due Mon 23:59, submitted Wed 10:00 → 2', () => {\ntests/unit/assignments/grading-math.test.ts:31:  it('counts elapsed 24 h across spring-forward (Europe/London, 29 Mar 2026)', () => {\ntests/unit/assignments/grading-math.test.ts:38:  it('counts elapsed 24 h across fall-back (Europe/London, 25 Oct 2026)', () => {\ntests/unit/assignments/grading-math.test.ts:46:describe('defaultPenalty (FR-30)', () => {\ntests/unit/assignments/grading-math.test.ts:47:  it('multiplies and caps', () => {\ntests/unit/assignments/grading-math.test.ts:54:describe('computeFinalScore (FR-31, NFR-1)', () => {\ntests/unit/assignments/grading-math.test.ts:55:  it('18 @ 20 % = \"14.40\"', () => {\ntests/unit/assignments/grading-math.test.ts:58:  it('rounds half-up at .005', () => {\ntests/unit/assignments/grading-math.test.ts:63:  it('no float drift: 0.1 + 0.2 style inputs', () => {\ntests/unit/assignments/grading-math.test.ts:70:describe('rubricTotal / maxRawScore', () => {\ntests/unit/assignments/grading-math.test.ts:71:  it('sums criterion maxima exactly', () => {\ntests/unit/assignments/grading-math.test.ts:76:  it('allows 120 % with extra credit', () => {\ntests/unit/assignments/grading-math.test.ts:82:describe('submissionChipStatus (FR-28)', () => {\ntests/unit/assignments/grading-math.test.ts:89:  it('maps every state', () => {\ntests/unit/dates.test.ts:1:import { describe, expect, it } from 'vitest';\ntests/unit/dates.test.ts:4:describe('formatInSchoolTz', () => {\ntests/unit/dates.test.ts:7:  it('formats a UTC ISO string in the given timezone', () => {\ntests/unit/dates.test.ts:11:  it('formats a Date object the same way as an equivalent ISO string', () => {\ntests/unit/dates.test.ts:18:  it('produces a different wall-clock time for a different timezone', () => {\ntests/unit/dates.test.ts:25:  it('respects the given date-fns pattern', () => {\ntests/unit/dates.test.ts:30:describe('nextTeachingDayDueAt (FR-10, NFR-9)', () => {\ntests/unit/dates.test.ts:34:  it('Mon → Tue 23:59 local', () => {\ntests/unit/dates.test.ts:40:  it('Fri → skips the weekend to Mon', () => {\ntests/unit/dates.test.ts:46:  it('uses the school day, not the UTC day (late evening in Tokyo is already tomorrow)', () => {\ntests/unit/dates.test.ts:53:  it('is 23:59 local on both sides of a DST change (Europe/London)', () => {\ntests/unit/dates.test.ts:60:  it('falls back to tomorrow when no day is teaching', () => {\ntests/integration/assignments/grading.test.ts:2:import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\ntests/integration/assignments/grading.test.ts:56:describe.skipIf(!process.env.TEST_DATABASE_URL)('assignments: grading and return (integration)', () => {\ntests/integration/assignments/grading.test.ts:96:  it('derives rawScore from rubric points, ignoring a client raw score (D7, FR-30, FR-31)', async () => {\ntests/integration/assignments/grading.test.ts:98:    const { submission } = await submit(as(ids.s1, 'STUDENT'), id, { text: 'answer', fileIds: [] });\ntests/integration/assignments/grading.test.ts:126:  it('caps the raw score at maxPoints, or 120 % with extra credit (FR-36)', async () =