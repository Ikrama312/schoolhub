{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TA37L4426y4QoXdW1mCw2M","type":"tool_result","content":"import type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { canMessageWith, loadRelations, type Party } from './contact-rules';\nimport { toUserSummary, userSummarySelect, type UserSummary } from './messages';\n\n/**\n * PRD-13 FR-8: labelled recipient groups for the new-conversation picker. Candidates are found\n * forward from the same relations contact-rules uses, then every one is re-checked through\n * canMessageWith, so the picker can never offer someone the API would refuse.\n */\n\nconst CAP = 50;\ntype Row = { id: string; firstName: string; lastName: string; role: Party['role'] };\ntype Group = { label: string; users: Row[] };\n\nconst active: Prisma.UserWhereInput = { status: 'ACTIVE', archivedAt: null };\nconst managed = (teacherId: string): Prisma.CourseWhereInput => ({\n  archivedAt: null,\n  OR: [{ teacherId }, { coTeacherIds: { has: teacherId } }],\n});\n\n/** Teachers (course teacher, co-teachers, current homeroom) of one student. */\nasync function teachersOf(studentId: string): Promise<Row[]> {\n  const [courses, homerooms] = await Promise.all([\n    prisma.course.findMany({\n      where: { archivedAt: null, enrollments: { some: { studentId, status: 'ACTIVE' } } },\n      select: { teacherId: true, coTeacherIds: true },\n    }),\n    prisma.sectionMember.findMany({\n      where: { studentId, section: { academicYear: { isCurrent: true }, homeroomTeacherId: { not: null } } },\n      select: { section: { select: { homeroomTeacherId: true } } },\n    }),\n  ]);\n  const ids = [...courses.flatMap((c) => [c.teacherId, ...c.coTeacherIds]), ...homerooms.map((h) => h.section.homeroomTeacherId!)];\n  return prisma.user.findMany({ where: { id: { in: [...new Set(ids)] }, role: 'TEACHER', ...active }, select: userSummarySelect });\n}\n\nconst parentsOf = (studentIds: string[]) =>\n  prisma.user.findMany({ where: { role: 'PARENT', ...active, parentLinks: { some: { studentId: { in: studentIds } } } }, select: userSummarySelect });\n\nasync function candidateGroups(user: Party, nameWhere: Prisma.UserWhereInput): Promise<Group[]> {\n  const groups: Group[] = [];\n  const office = () =>\n    prisma.user.findMany({ where: { role: 'ADMIN', ...active, id: { not: user.id }, ...nameWhere }, select: userSummarySelect, take: CAP });\n\n  if (user.role === 'STUDENT') {\n    groups.push({ label: 'My teachers', users: await teachersOf(user.id) });\n  } else if (user.role === 'PARENT') {\n    const kids = await prisma.parentStudentLink.findMany({\n      where: { parentId: user.id },\n      select: { student: { select: { id: true, firstName: true } } },\n      orderBy: { student: { firstName: 'asc' } },\n    });\n    for (const k of kids) groups.push({ label: `My child's teachers (${k.student.firstName})`, users: await teachersOf(k.student.id) });\n  } else if (user.role === 'TEACHER') {\n    const [courses, homerooms] = await Promise.all([\n      prisma.course.findMany({\n        where: managed(user.id),\n        orderBy: { code: 'asc' },\n        select: { code: true, enrollments: { where: { status: 'ACTIVE' }, select: { student: { select: userSummarySelect } } } },\n      }),\n      prisma.section.findMany({\n        where: { homeroomTeacherId: user.id, academicYear: { isCurrent: true } },\n        select: { name: true, members: { select: { student: { select: userSummarySelect } } } },\n      }),\n    ]);\n    for (const c of courses) {\n      const students = c.enrollments.map((e) => e.student);\n      groups.push({ label: `Students in ${c.code}`, users: students });\n      groups.push({ label: `Parents of students in ${c.code}`, users: await parentsOf(students.map((s) => s.id)) });\n    }\n    for (const s of homerooms) {\n      const students = s.members.map((m) => m.student);\n      groups.push({ label: `Homeroom ${s.name}`, users: [...students, ...(await parentsOf(students.map((x) => x.id)))] });\n    }\n    groups.push({\n      label: 'Staff',\n      users: await prisma.user.findMany({ where: { role: 'TEACHER', ...active, id: { not: user.id }, ...nameWhere }, select: userSummarySelect, take: CAP }),\n    });\n  } else if (user.role === 'ADMIN') {\n    // ADMIN may message anyone (FR-5): search-driven groups, capped.\n    const byRole = (role: Party['role']) =>\n      prisma.user.findMany({ where: { role, ...active, ...nameWhere }, select: userSummarySelect, orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }], take: CAP });\n    groups.push({ label: 'Staff', users: await byRole('TEACHER') });\n    groups.push({ label: 'Students', users: await byRole('STUDENT') });\n    groups.push({ label: 'Parents', users: await byRole('PARENT') });\n  }\n  groups.push({ label: 'School office', users: await office() });\n  return groups;\n}\n\nexport async function listContacts(user: Party, q?: string): Promise<{ groups: { label: string; contacts: UserSummary[] }[] }> {\n  const term = q?.trim().toLowerCase() ?? '';\n  // DB pre-filter on the first word (so \"Tom Te\" still narrows); the full-name match runs below.\n  const word = term.split(/\\s+/)[0];\n  const nameWhere: Prisma.UserWhereInput = word\n    ? { OR: [{ firstName: { contains: word, mode: 'insensitive' } }, { lastName: { contains: word, mode: 'insensitive' } }] }\n    : {};\n  const groups = await candidateGroups(user, nameWhere);\n  const rel = await loadRelations([user.id, ...groups.flatMap((g) => g.users.map((u) => u.id))]);\n\n  return {\n    groups: groups\n      .map((g) => {\n        const seen = new Set<string>();\n        const contacts = g.users\n          .filter((u) => {\n            if (seen.has(u.id)) return false;\n            seen.add(u.id);\n            const r = rel.users.get(u.id);\n            return !!r && canMessageWith(user, r, rel) && (!term || `${u.firstName} ${u.lastName}`.toLowerCase().includes(term));\n          })\n          .sort((a, b) => a.lastName.localeCompare(b.lastName) || a.firstName.localeCompare(b.firstName))\n          .slice(0, CAP)\n          .map(toUserSummary);\n        return { label: g.label, contacts };\n      })\n      .filter((g) => g.contacts.length > 0),\n  };\n}\nimport { z } from 'zod';\nimport { BODY_MAX, MAX_FILES, MAX_PARTICIPANTS, PAGE_SIZE, REASON_MAX, SUBJECT_MAX } from '@/lib/messaging/constants';\n\n/** PRD-13 validation (system-design §3.2). Client-safe: shared by the composer/dialogs and every handler. */\n\nconst id = z.string().min(1);\nconst body = z.string().trim().min(1, 'Message is required').max(BODY_MAX, `At most ${BODY_MAX} characters`);\nconst fileIds = z.array(id).max(MAX_FILES, `At most ${MAX_FILES} attachments`).optional();\n/** Query-string boolean: only 'true'/'false' (z.coerce.boolean would read 'false' as true). */\nconst queryBool = z.enum(['true', 'false']).transform((v) => v === 'true');\nconst page = z.coerce.number().int().min(1).optional();\nconst pageSize = z.coerce.number().int().min(1).max(100).optional();\n\nexport const createConversationSchema = z.object({\n  participantIds: z\n    .array(id)\n    .min(1, 'Pick at least one recipient')\n    .max(MAX_PARTICIPANTS - 1, `At most ${MAX_PARTICIPANTS - 1} recipients`)\n    .transform((ids) => [...new Set(ids)]),\n  subject: z.string().trim().max(SUBJECT_MAX, `At most ${SUBJECT_MAX} characters`).optional().transform((s) => s || undefined),\n  body,\n  fileIds,\n});\nexport type CreateConversationInput = z.output<typeof createConversationSchema>;\n\nexport const sendMessageSchema = z.object({ body, fileIds });\nexport type SendMessageInput = z.output<typeof sendMessageSchema>;\n\nexport const editMessageSchema = z.object({ body });\n\nexport const listMessagesQuery = z\n  .object({\n    before: id.optional(),\n    after: id.optional(),\n    since: z.string().datetime({ offset: true }).optional(),\n    limit: z.coerce.number().int().min(1).max(PAGE_SIZE).default(PAGE_SIZE),\n  })\n  .refine((q) => !(q.before && q.after), { message: 'before and after are mutually exclusive', path: ['before'] })\n  .refine((q) => !q.since || q.after, { message: 'since requires after', path: ['since'] });\nexport type ListMessagesQuery = z.output<typeof listMessagesQuery>;\n\nexport const listConversationsQuery = z.object({\n  archived: queryBool.optional(),\n  q: z.string().trim().max(100).optional(),\n  page,\n  pageSize,\n});\n\nexport const archiveSchema = z.object({ archived: z.boolean() });\nexport const muteSchema = z.object({ muted: z.boolean() });\n\nexport const reportSchema = z.object({\n  reason: z.string().trim().min(1, 'Reason is required').max(REASON_MAX, `At most ${REASON_MAX} characters`),\n});\n\nexport const reviewReportSchema = z\n  .object({\n    action: z.enum(['review', 'dismiss']),\n    note: z.string().trim().max(REASON_MAX, `At most ${REASON_MAX} characters`).optional(),\n  })\n  .refine((v) => v.action !== 'review' || !!v.note, { message: 'A note is required to mark reviewed', path: ['note'] });\n\nexport const reportsQuery = z.object({ status: z.enum(['OPEN', 'REVIEWED', 'DISMISSED']).optional(), page, pageSize });\n\nexport const safeguardingConversationsQuery = z.object({\n  participantId: id.optional(),\n  from: z.coerce.date().optional(),\n  to: z.coerce.date().optional(),\n  page,\n  pageSize,\n});\n\nconst hhmm = z.string().regex(/^([01]\\d|2[0-3]):[0-5]\\d$/, 'Use HH:mm');\nexport const messagingSettingsSchema = z\n  .object({ quietStart: hhmm.nullable(), quietEnd: hhmm.nullable() })\n  .refine((s) => (s.quietStart === null) === (s.quietEnd === null), { message: 'Set both start and end, or neither', path: ['quietEnd'] })\n  .refine((s) => s.quietStart === null || s.quietStart !== s.quietEnd, { message: 'Start and end must differ', path: ['quietEnd'] });\nexport type MessagingSettingsInput = z.output<typeof messagingSettingsSchema>;\n\nexport const contactsQuery = z.object({ q: z.string().trim().max(100).optional() });\n85: * 'message' (PRD-13 FR-27, A7): a participant of the message's conversation who has not left, or an\n86- * ACTIVE ADMIN safeguarding lead (flag read from the DB). Errors deny (canAccessFile catches).\n87- */\n88:export const messageResolver: FileAccessResolver = async (user, file) => {\n89-  if (!user || !file.contextId) return false;\n90:  const m = await prisma.message.findUnique({ where: { id: file.contextId }, select: { conversationId: true } });\n91-  if (!m) return false;\n92-  const p = await prisma.conversationParticipant.findUnique({\n93-    where: { conversationId_userId: { conversationId: m.conversationId, userId: user.id } },\n94-    select: { leftAt: true },\n95-  });\n96-  if (p && !p.leftAt) return true;\n97-  if (user.role !== 'ADMIN') return false;\n98-  const lead = await prisma.user.findUnique({ where: { id: user.id }, select: { isSafeguardingLead: true, status: true } });\n99-  return !!lead?.isSafeguardingLead && lead.status === 'ACTIVE';\n100-};\n101-\n102-/** 'logo': public, including anonymous (app shell, login page, emails). */\n103-export const logoResolver: FileAccessResolver = () => true;\n104-\n105-export function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n106-  register('lesson', lessonResolver);\n107-  register('logo', logoResolver);\n108-  register('assignment', assignmentResolver);\n109-  register('submission', submissionResolver);\n110-  register('quiz', quizResolver);\n111:  register('message', messageResolver);\n112-}\n// @vitest-environment node\nimport { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest';\n\nvi.hoisted(() => {\n  if (process.env.TEST_DATABASE_URL) process.env.DATABASE_URL = process.env.TEST_DATABASE_URL;\n  process.env.DATABASE_URL ??= 'postgresql://unused@localhost/unused';\n  process.env.APP_URL ??= 'http://localhost:3000';\n  process.env.AUTH_SECRET ??= 'test-secret';\n});\n\nimport { prisma } from '@/server/db';\nimport { __resetRateLimits } from '@/server/rate-limit';\nimport { createConversationSchema } from '@/lib/validators/messaging';\nimport { createConversation, getConversation, leave, markRead, setMuted, unreadCount } from '@/server/messaging/conversations';\nimport { deleteMessage, editMessage, listMessages, sendMessage } from '@/server/messaging/messages';\nimport { reportMessage } from '@/server/messaging/reports';\nimport { conversationLink } from '@/server/messaging/notifications';\n\n/**\n * PRD-13 NFR-10 integration: notification collapse, mute, rate limit, 404 for non-/ex-participants,\n * edit revisions + 15-minute window, duplicate report 409, contact rules on create/send.\n * Real migrated Postgres; fixtures tagged with MARK. Skipped without TEST_DATABASE_URL.\n */\nconst MARK = 'it-sh13-msg';\ntype R = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\nconst ids = {} as Record<'year' | 'subject' | 'course' | 'lead' | 't' | 't2' | 's1' | 's2' | 'p', string>;\nconst as = (k: keyof typeof ids, role: R) => ({ id: ids[k], role });\nconst T = () => as('t', 'TEACHER');\nconst P = () => as('p', 'PARENT');\nconst S1 = () => as('s1', 'STUDENT');\nconst S2 = () => as('s2', 'STUDENT');\nconst code = (p: Promise<unknown>) => p.then(() => 'OK', (e: { code?: string }) => e.code ?? String(e));\nconst reason = (p: Promise<unknown>) => p.then(() => 'OK', (e: { details?: { reason?: string } }) => e.details?.reason ?? 'none');\nconst create = (user: { id: string; role: R }, participantIds: string[], body = 'hello') =>\n  createConversation(user, createConversationSchema.parse({ participantIds, body, subject: MARK }));\n\ndescribe.skipIf(!process.env.TEST_DATABASE_URL)('messaging (integration)', () => {\n  beforeAll(async () => {\n    const mk = (n: string, role: R, extra = {}) =>\n      prisma.user.create({ data: { email: `${n}@${MARK}.test`, firstName: n, lastName: 'QA', role, status: 'ACTIVE', ...extra } }).then((u) => u.id);\n    Object.assign(ids, {\n      lead: await mk('lead', 'ADMIN', { isSafeguardingLead: true }),\n      t: await mk('t', 'TEACHER'),\n      t2: await mk('t2', 'TEACHER'),\n      s1: await mk('s1', 'STUDENT'),\n      s2: await mk('s2', 'STUDENT'),\n      p: await mk('p', 'PARENT'),\n    });\n    await prisma.parentStudentLink.create({ data: { parentId: ids.p, studentId: ids.s1, relationship: 'MOTHER', isPrimary: true } });\n    ids.year = (await prisma.academicYear.create({ data: { name: MARK, startDate: new Date('2026-08-01'), endDate: new Date('2027-07-01') } })).id;\n    ids.subject = (await prisma.subject.create({ data: { name: MARK, code: MARK.toUpperCase() } })).id;\n    ids.course = (await prisma.course.create({ data: { name: MARK, code: MARK, academicYearId: ids.year, subjectId: ids.subject, teacherId: ids.t } })).id;\n    await prisma.enrollment.createMany({ data: [ids.s1, ids.s2].map((studentId) => ({ courseId: ids.course, studentId })) });\n  });\n\n  beforeEach(() => __resetRateLimits());\n\n  afterAll(async () => {\n    const users = Object.entries(ids).filter(([k]) => !['year', 'subject', 'course'].includes(k)).map(([, v]) => v);\n    await prisma.conversation.deleteMany({ where: { createdById: { in: users } } });\n    await prisma.course.deleteMany({ where: { code: MARK } });\n    await prisma.notification.deleteMany({ where: { userId: { in: users } } });\n    await prisma.auditLog.deleteMany({ where: { actorId: { in: users } } });\n    await prisma.user.deleteMany({ where: { id: { in: users } } });\n    await prisma.subject.deleteMany({ where: { code: MARK.toUpperCase() } });\n    await prisma.academicYear.deleteMany({ where: { name: MARK } });\n    await prisma.$disconnect();\n  });\n\n  it('FR-19/FR-20: three sends leave one unread notification and one pending email (first message starts the clock)', async () => {","is_error":false}]},"parent_tool_use_id":null,"session_id":"b2a19e14-003d-496b-9902-59b2c0434c99","uuid":"94fa5781-a070-490c-a4b8-12dfc07edd5f","timestamp":"2026-11-09T17:57:39.013Z","tool_use_result":{"stdout":"import type { Prisma } from