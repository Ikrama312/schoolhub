{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WqZ7tKWqgsr1X6CwNQF3Gu","type":"tool_result","content":"1\t// Pure and isomorphic (NFR-1): no Prisma client, no clock. Callers pass `now`.\n2\t// The gradebook, the student views and report-card generation all call computeStudentTerm, so\n3\t// every screen shows the same number (FR-15, AC-1).\n4\timport { Decimal, dec, fixed2, type DecimalValue } from '@/server/assignments/grading-math';\n5\t\n6\texport interface CalcItem {\n7\t  id: string;\n8\t  categoryId: string | null;\n9\t  maxPoints: DecimalValue;\n10\t  dueAt: Date | null;\n11\t  isVisible: boolean;\n12\t}\n13\t\n14\texport interface CalcGrade {\n15\t  score: DecimalValue | null;\n16\t  excused: boolean;\n17\t  missing: boolean;\n18\t}\n19\t\n20\texport interface CalcCategory {\n21\t  id: string;\n22\t  name: string;\n23\t  weightPercent: DecimalValue;\n24\t  dropLowest: number;\n25\t  order: number;\n26\t}\n27\t\n28\texport interface CalcBand {\n29\t  letter: string;\n30\t  minPercent: number;\n31\t  gpa?: number;\n32\t  descriptor?: string;\n33\t}\n34\t\n35\texport interface CalcOverride {\n36\t  percent: DecimalValue | null;\n37\t  letter: string | null;\n38\t  teacherComment: string | null;\n39\t}\n40\t\n41\texport interface CategoryResult {\n42\t  id: string | null;\n43\t  name: string;\n44\t  weightPercent: string;\n45\t  percent: string | null;\n46\t  earned: string;\n47\t  possible: string;\n48\t  droppedItemIds: string[];\n49\t}\n50\t\n51\texport interface StudentTermResult {\n52\t  categories: CategoryResult[];\n53\t  percent: string | null;\n54\t  letter: string | null;\n55\t  descriptor: string | null;\n56\t  computedPercent: string | null;\n57\t  computedLetter: string | null;\n58\t  overridden: boolean;\n59\t  override: { percent: string | null; letter: string | null; teacherComment: string | null } | null;\n60\t}\n61\t\n62\texport const UNCATEGORISED = 'Uncategorised';\n63\t\n64\tconst HUNDRED = new Decimal(100);\n65\t\n66\t/** FR-13: half-up to 1 dp, applied once at the very end. */\n67\texport const roundHalfUp1 = (v: DecimalValue) => dec(v).toDecimalPlaces(1, Decimal.ROUND_HALF_UP);\n68\tconst pct1 = (v: Decimal | null) => (v === null ? null : roundHalfUp1(v).toFixed(1));\n69\t\n70\t/** FR-10: visible, not excused, and either scored or (missing and past due → 0). */\n71\texport function counted(item: CalcItem, grade: CalcGrade | undefined, now: Date): boolean {\n72\t  if (!item.isVisible || !grade || grade.excused) return false;\n73\t  if (grade.score !== null) return true;\n74\t  return grade.missing && item.dueAt !== null && now.getTime() > item.dueAt.getTime();\n75\t}\n76\t\n77\t/** FR-29 warning: visible, past due, no score, neither missing nor excused. */\n78\texport function isUngradedPastDue(item: CalcItem, grade: CalcGrade | undefined, now: Date): boolean {\n79\t  if (!item.isVisible || !item.dueAt || now.getTime() <= item.dueAt.getTime()) return false;\n80\t  return !grade || (grade.score === null && !grade.missing && !grade.excused);\n81\t}\n82\t\n83\tinterface Entry {\n84\t  item: CalcItem;\n85\t  earned: Decimal;\n86\t  max: Decimal;\n87\t}\n88\t\n89\tconst ratio = (e: Entry) => (e.max.gt(0) ? e.earned.div(e.max) : new Decimal(Infinity));\n90\t\n91\t/** FR-11: drop the n lowest percentages (tie: dueAt, then id), never all of them. */\n92\texport function applyDropLowest<T extends Entry>(entries: readonly T[], dropLowest: number): { kept: T[]; dropped: T[] } {\n93\t  const n = Math.max(0, Math.min(dropLowest, entries.length - 1));\n94\t  if (n === 0) return { kept: [...entries], dropped: [] };\n95\t  const sorted = [...entries].sort((a, b) => {\n96\t    const c = ratio(a).cmp(ratio(b));\n97\t    if (c !== 0) return c;\n98\t    const da = a.item.dueAt?.getTime() ?? Infinity;\n99\t    const db = b.item.dueAt?.getTime() ?? Infinity;\n100\t    if (da !== db) return da - db;\n101\t    return a.item.id < b.item.id ? -1 : a.item.id > b.item.id ? 1 : 0;\n102\t  });\n103\t  const dropped = sorted.slice(0, n);\n104\t  return { kept: entries.filter((e) => !dropped.includes(e)), dropped };\n105\t}\n106\t\n107\t/** Σ earned / Σ max × 100, unrounded; null when nothing is possible. */\n108\texport function categoryPercent(entries: readonly Entry[]): { percent: Decimal | null; earned: Decimal; possible: Decimal } {\n109\t  const earned = entries.reduce((s, e) => s.plus(e.earned), new Decimal(0));\n110\t  const possible = entries.reduce((s, e) => s.plus(e.max), new Decimal(0));\n111\t  return { percent: possible.gt(0) ? earned.div(possible).mul(HUNDRED) : null, earned, possible };\n112\t}\n113\t\n114\t/** FR-13: first band (sorted desc) with percent ≥ minPercent. */\n115\texport function letterFor(percent: DecimalValue | null, bands: readonly CalcBand[]): CalcBand | null {\n116\t  if (percent === null) return null;\n117\t  const p = dec(percent);\n118\t  return bands.find((b) => p.gte(b.minPercent)) ?? null;\n119\t}\n120\t\n121\t/** Course scale, else the school default. */\n122\texport function effectiveScale<S>(courseScale: S | null | undefined, defaultScale: S | null | undefined): S | null {\n123\t  return courseScale ?? defaultScale ?? null;\n124\t}\n125\t\n126\t/** FR-14 / A12: percent replaces percent (letter re-derived unless also set); letter-only keeps the computed percent. */\n127\texport function applyOverride(\n128\t  computed: { percent: Decimal | null; letter: string | null },\n129\t  override: CalcOverride | null | undefined,\n130\t  bands: readonly CalcBand[],\n131\t): { percent: Decimal | null; letter: string | null; overridden: boolean } {\n132\t  const hasPercent = override?.percent !== null && override?.percent !== undefined;\n133\t  const hasLetter = !!override?.letter;\n134\t  if (!hasPercent && !hasLetter) return { ...computed, overridden: false };\n135\t  const percent = hasPercent ? roundHalfUp1(override!.percent!) : computed.percent;\n136\t  const letter = hasLetter ? override!.letter! : letterFor(percent, bands)?.letter ?? null;\n137\t  return { percent, letter, overridden: true };\n138\t}\n139\t\n140\t/** FR-26: ≥ 80 green, 60–79.9 amber, < 60 red. */\n141\texport function gradeColour(percent: DecimalValue | null): 'success' | 'warning' | 'error' | null {\n142\t  if (percent === null) return null;\n143\t  const p = dec(percent);\n144\t  if (p.gte(80)) return 'success';\n145\t  if (p.gte(60)) return 'warning';\n146\t  return 'error';\n147\t}\n148\t\n149\t/** Score / max as a 1 dp string for one item; null when ungraded or max is 0. */\n150\texport function itemPercent(score: DecimalValue | null, maxPoints: DecimalValue): string | null {\n151\t  if (score === null || !dec(maxPoints).gt(0)) return null;\n152\t  return pct1(dec(score).div(dec(maxPoints)).mul(HUNDRED));\n153\t}\n154\t\n155\texport interface StudentTermInput {\n156\t  items: readonly CalcItem[];\n157\t  grades: ReadonlyMap<string, CalcGrade>;\n158\t  categories: readonly CalcCategory[];\n159\t  bands: readonly CalcBand[];\n160\t  override?: CalcOverride | null;\n161\t  now: Date;\n162\t}\n163\t\n164\t/** FR-10–FR-14 for one student, course and term (system-design §3.2). */\n165\texport function computeStudentTerm(input: StudentTermInput): StudentTermResult {\n166\t  const { items, grades, bands, now } = input;\n167\t  const categories = [...input.categories].sort((a, b) => a.order - b.order);\n168\t  const known = new Set(categories.map((c) => c.id));\n169\t  const bucketOf = (item: CalcItem) => (item.categoryId && known.has(item.categoryId) ? item.categoryId : null);\n170\t\n171\t  const entries = new Map<string | null, Entry[]>();\n172\t  for (const item of items) {\n173\t    const g = grades.get(item.id);\n174\t    if (!counted(item, g, now)) continue;\n175\t    const key = bucketOf(item);\n176\t    entries.set(key, [...(entries.get(key) ?? []), { item, earned: g!.score === null ? new Decimal(0) : dec(g!.score), max: dec(item.maxPoints) }]);\n177\t  }\n178\t\n179\t  const results: CategoryResult[] = [];\n180\t  const allKept: Entry[] = [];\n181\t  let weighted = new Decimal(0);\n182\t  let weightTotal = new Decimal(0);\n183\t\n184\t  for (const c of categories) {\n185\t    const { kept, dropped } = applyDropLowest(entries.get(c.id) ?? [], c.dropLowest);\n186\t    const r = categoryPercent(kept);\n187\t    allKept.push(...kept);\n188\t    if (r.percent !== null) {\n189\t      weighted = weighted.plus(dec(c.weightPercent).mul(r.percent));\n190\t      weightTotal = weightTotal.plus(dec(c.weightPercent));\n191\t    }\n192\t    results.push({\n193\t      id: c.id,\n194\t      name: c.name,\n195\t      weightPercent: fixed2(c.weightPercent),\n196\t      percent: pct1(r.percent),\n197\t      earned: fixed2(r.earned),\n198\t      possible: fixed2(r.possible),\n199\t      droppedItemIds: dropped.map((e) => e.item.id),\n200\t    });\n201\t  }\n202\t\n203\t  // A8: implicit bucket — shown with its subtotal, weight 0 when the course has categories.\n204\t  const hasUncategorised = items.some((i) => i.isVisible && bucketOf(i) === null);\n205\t  const loose = entries.get(null) ?? [];\n206\t  allKept.push(...loose);\n207\t  if (hasUncategorised) {\n208\t    const r = categoryPercent(loose);\n209\t    results.push({\n210\t      id: null,\n211\t      name: UNCATEGORISED,\n212\t      weightPercent: categories.length ? '0.00' : '100.00',\n213\t      percent: pct1(r.percent),\n214\t      earned: fixed2(r.earned),\n215\t      possible: fixed2(r.possible),\n216\t      droppedItemIds: [],\n217\t    });\n218\t  }\n219\t\n220\t  // FR-12: renormalised weighted mean; points total when there are no categories or none counted.\n221\t  const raw = categories.length && weightTotal.gt(0) ? weighted.div(weightTotal) : categoryPercent(allKept).percent;\n222\t  const computedPercent = raw === null ? null : roundHalfUp1(raw);\n223\t  const computedLetter = letterFor(computedPercent, bands)?.letter ?? null;\n224\t  const final = applyOverride({ percent: computedPercent, letter: computedLetter }, input.override, bands);\n225\t  const o = input.override;\n226\t\n227\t  return {\n228\t    categories: results,\n229\t    percent: final.percent === null ? null : final.percent.toFixed(1),\n230\t    letter: final.letter,\n231\t    descriptor: bands.find((b) => b.letter === final.letter)?.descriptor ?? null,\n232\t    computedPercent: computedPercent === null ? null : computedPercent.toFixed(1),\n233\t    computedLetter,\n234\t    overridden: final.overridden,\n235\t    override: o ? { percent: o.percent === null ? null : fixed2(o.percent), letter: o.letter, teacherComment: o.teacherComment } : null,\n236\t  };\n237\t}\n238\t"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"a4ef37fc-36ec-40d7-b20a-fa7b42f154e9","timestamp":"2026-11-09T13:57:40.593Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/gradebook/grade-calc.ts","content":"// Pure and isomorphic (NFR-1): no Prisma client, no clock. Callers pass `now`.\n// The gradebook, the student views and report-card generation all call computeStudentTerm, so\n// every screen shows the same number (FR-15, AC-1).\nimport { Decimal, dec, fixed2, type DecimalValue } from '@/server/assignments/grading-math';\n\nexport interface CalcItem {\n  id: string;\n  categoryId: string | null;\n  maxPoints: DecimalValue;\n  dueAt: Date | null;\n  isVisible: boolean;\n}\n\nexport interface CalcGrade {\n  score: DecimalValue | null;\n  excused: boolean;\n  missing: boolean;\n}\n\nexport interface CalcCategory {\n  id: string;\n  name: string;\n  weightPercent: DecimalValue;\n  dropLowest: number;\n  order: number;\n}\n\nexport interface CalcBand {\n  letter: string;\n  minPercent: number;\n  gpa?: number;\n  descriptor?: string;\n}\n\nexport interface CalcOverride {\n  percent: DecimalValue | null;\n  letter: string | null;\n  teacherComment: string | null;\n}\n\nexport interface CategoryResult {\n  id: string | null;\n  name: string;\n  weightPercent: string;\n  percent: string | null;\n  earned: string;\n  possible: string;\n  droppedItemIds: string[];\n}\n\nexport interface StudentTermResult {\n  categories: CategoryResult[];\n  percent: string | null;\n  letter: string | null;\n  descriptor: string | null;\n  computedPercent: string | null;\n  computedLetter: string | null;\n  overridden: boolean;\n  override: { percent: string | null; letter: string | null; teacherComment: string | null } | null;\n}\n\nexport const UNCATEGORISED = 'Uncategorised';\n\nconst HUNDRED = new Decimal(100);\n\n/** FR-13: half-up to 1 dp, applied once at the very end. */\nexport const roundHalfUp1 = (v: DecimalValue) => dec(v).toDecimalPlaces(1, Decimal.ROUND_HALF_UP);\nconst pct1 = (v: Decimal | null) => (v === null ? null : roundHalfUp1(v).toFixed(1));\n\n/** FR-10: visible, not excused, and either scored or (missing and past due → 0). */\nexport function counted(item: CalcItem, grade: CalcGrade | undefined, now: Date): boolean {\n  if (!item.isVisible || !grade || grade.excused) return false;\n  if (grade.score !== null) return true;\n  return grade.missing && item.dueAt !== null && now.getTime() > item.dueAt.getTime();\n}\n\n/** FR-29 warning: visible, past due, no score, neither missing nor excused. */\nexport function isUngradedPastDue(item: CalcItem, grade: CalcGrade | undefined, now: Date): boolean {\n  if (!item.isVisible || !item.dueAt || now.getTime() <= item.dueAt.getTime()) return false;\n  return !grade || (grade.score === null && !grade.missing && !grade.excused);\n}\n\ninterface Entry {\n  item: CalcItem;\n  earned: Decimal;\n  max: Decimal;\n}\n\nconst ratio = (e: Entry) => (e.max.gt(0) ? e.earned.div(e.max) : new Decimal(Infinity));\n\n/** FR-11: drop the n lowest percentages (tie: dueAt, then id), never all of them. */\nexport function applyDropLowest<T extends Entry>(entries: readonly T[], dropLowest: number): { kept: T[]; dropped: T[] } {\n  const n = Math.max(0, Math.min(dropLowest, entries.length - 1));\n  if (n === 0) return { kept: [...entries], dropped: [] };\n  const sorted = [...entries].sort((a, b) => {\n    const c = ratio(a).cmp(ratio(b));\n    if (c !== 0) return c;\n    const da = a.item.dueAt?.getTime() ?? Infinity;\n    const db = b.item.dueAt?.getTime() ?? Infinity;\n    if (da !== db) return da - db;\n    return a.item.id < b.item.id ? -1 : a.item.id > b.item.id ? 1 : 0;\n  });\n  const dropped = sorted.slice(0, n);\n  return { kept: entries.filter((e) => !dropped.includes(e)), dropped };\n}\n\n/** Σ earned / Σ max × 100, unrounded; null when nothing is possible. */\nexport function categoryPercent(entries: readonly Entry[]): { percent: Decimal | null; earned: Decimal; possible: Decimal } {\n  const earned = entries.reduce((s, e) => s.plus(e.earned), new Decimal(0));\n  const possible = entries.reduce((s, e) => s.plus(e.max), new Decimal(0));\n  return { percent: possible.gt(0) ? earned.div(possible).mul(HUNDRED) : null, earned, possible };\n}\n\n/** FR-13: first band (sorted desc) with percent ≥ minPercent. */\nexport function letterFor(percent: DecimalValue | null, bands: readonly CalcBand[]): CalcBand | null {\n  if (percent === null) return null;\n  const p = dec(percent);\n  return bands.find((b) => p.gte(b.minPercent)) ?? null;\n}\n\n/** Course scale, else the school default. */\nexport function effectiveScale<S>(courseScale: S | null | undefined, defaultScale: S | null | undefined): S | null {\n  return courseScale ?? defaultScale ?? null;\n}\n\n/** FR-14 / A12: percent replaces percent (letter re-derived unless also set); letter-only keeps the computed percent. */\nexport function applyOverride(\n  computed: { percent: Decimal | null; letter: string | null },\n  override: CalcOverride | null | undefined,\n  bands: readonly CalcBand[],\n): { percent: Decimal | null; letter: string | null; overridden: boolean } {\n  const hasPercent = override?.percent !== null && override?.percent !== undefined;\n  const hasLetter = !!override?.letter;\n  if (!hasPercent && !hasLetter) return { ...computed, overridden: false };\n  const percent = hasPercent ? roundHalfUp1(override!.percent!) : computed.percent;\n  const letter = hasLetter ? override!.letter! : letterFor(percent, bands)?.letter ?? null;\n  return { percent, letter, overridden: true };\n}\n\n/** FR-26: ≥ 80 green, 60–79.9 amber, < 60 red. */\nexport function gradeColour(percent: DecimalValue | null): 'success' | 'warning' | 'error' | null {\n  if (percent === null) return null;\n  const p = dec(percent);\n  if (p.gte(80)) return 'success';\n  if (p.gte(60)) return 'warning';\n  return 'error';\n}\n\n/** Score / max as a 1 dp string for one item; null when ungraded or max is 0. */\nexport function itemPercent(score: DecimalValue | null, maxPoints: DecimalValue): string | null {\n  if (score === null || !dec(maxPoints).gt(0)) return null;\n  return pct1(dec(score).div(dec(maxPoints)).mul(HUNDRED));\n}\n\nexport interface StudentTermInput {\n  items: readonly CalcItem[];\n  grades: ReadonlyMap<string, CalcGrade>;\n  categories: readonly CalcCategory[];\n  bands: readonly CalcBand[];\n  override?: CalcOverride | null;\n  now: Date;\n}\n\n/** FR-10–FR-14 for one student, course and term (system-design §3.2). */\nexport function computeStudentTerm(input: StudentTermInput): StudentTermResult {\n  const { items, grades, bands, now } = input;\n  const categories = [...input.categories].sort((a, b) => a.order - b.order);\n  const known = new Set(categories.map((c) => c.id));\n  const bucketOf = (item: CalcItem) => (item.categoryId && known.has(item.categoryId) ? item.categoryId : null);\n\n  const entries = new Map<string | null, Entry[]>();\n  for (const item of items) {\n    const g = grades.get(item.id);\n    if (!counted(item, g, now)) continue;\n    const key = bucketOf(item);\n    entries.set(key, [...(entries.get(key) ?? []), { item, earned: g!.score === null ? new Decimal(0) : dec(g!.score), max: dec(item.maxPoints) }]);\n  }\n\n  const results: CategoryResult[] = [];\n  const allKept: Entry[] = [];\n  let weighted = new Decimal(0);\n  let weightTotal = new Decimal(0);\n\n  for (const c of categories) {\n    const { kept, dropped } = applyDropLowest(entries.get(c.id) ?? [], c.dropLowest);\n    const r = categoryPercent(kept);\n    allKept.push(...kept);\n    if (r.percent !== null) {\n      weighted = weighted.plus(dec(c.weightPercent).mul(r.percent));\n      weightTotal = weightTotal.plus(dec(c.weightPercent));\n    }\n    results.push({\n      id: c.id,\n      name: c.name,\n      weightPercent: fixed2(c.weightPercent),\n      percent: pct1(r.percent),\n      earned: fixed2(r.earned),\n      possible: fixed2(r.possible),\n      droppedItemIds: dropped.map((e) => e.item.id),\n    });\n  }\n\n  // A8: implicit bucket — shown with its subtotal, weight 0 when the course has categories.\n  const hasUncategorised = items.some((i) => i.isVisible && bucketOf(i) === null);\n  const loose = entries.get(null) ?? [];\n  allKept.push(...loose);\n  if (hasUncategorised) {\n    const r = categoryPercent(loose);\n    results.push({\n      id: null,\n      name: UNCATEGORISED,\n      weightPercent: categories.length ? '0.00' : '100.00',\n      percent: pct1(r.percent),\n      earned: fixed2(r.earned),\n      possible: fixed2(r.possible),\n      droppedItemIds: [],\n    });\n  }\n\n  // FR-12: renormalised weighted mean; points total when there are no categories or none counted.\n  const raw = categories.length && weightTotal.gt(0) ? weighted.div(weightTotal) : categoryPercent(allKept).percent;\n  const computedPercent = raw === null ? null : roundHalfUp1(raw);\n  const computedLetter = letterFor(computedPercent, bands)?.letter ?? null;\n  const final = applyOverride({ percent: computedPercent, letter: computedLetter }, input.override, bands);\n  const o = input.override;\n\n  return {\n    categories: results,\n    percent: final.percent === null ? null : final.percent.toFixed(1),\n    letter: final.letter,\n    descriptor: bands.find((b) => b.letter === final.letter)?.descriptor ?? null,\n    computedPercent: computedPercent === null ? null : computedPercent.toFixed(1),\n    computedLetter,\n    overridden: final.overridden,\n    override: o ? { percent: o.percent === null ? null : fixed2(o.percent), letter: o.letter, teacherComment: o.teacherComment } : null,\n  };\n}\n","numLines":238,"startLine":1,"totalLines":238}},"tool_result_meta":[{"id":"toolu_01WqZ7tKWqgsr1X6CwNQF3Gu","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
