TION',\n+    defaultEmail: true,\n+    mandatoryInApp: false,\n+    roles: ALL,\n+  },\n+  'event.updated': {\n+    label: 'Event changed',\n+    description: 'The time or location of an upcoming event changed.',\n+    category: 'COMMUNICATION',\n+    defaultEmail: false,\n+    mandatoryInApp: false,\n+    roles: ALL,\n+  },\n+  'event.rsvp_reminder': {\n+    label: 'RSVP reminder',\n+    description: 'An event you were invited to closes RSVPs within 48 hours.',\n+    category: 'COMMUNICATION',\n+    defaultEmail: false,\n+    mandatoryInApp: false,\n+    roles: ALL,\n+  },\n } as const satisfies Record<string, NotificationTypeDef>;\n \n export type NotificationType = keyof typeof NOTIFICATION_TYPES;\ndiff --git a/src/theme/theme.ts b/src/theme/theme.ts\nindex 3ef686d..19c3d72 100644\n--- a/src/theme/theme.ts\n+++ b/src/theme/theme.ts\n@@ -1,5 +1,7 @@\n import { Roboto } from 'next/font/google';\n import { createTheme } from '@mui/material/styles';\n+// PRD-14 FR-9: adds the scheduler's component keys to the theme types.\n+import type {} from '@mui/x-scheduler/theme-augmentation';\n \n export const roboto = Roboto({\n   weight: ['300', '400', '500', '700'],","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014o4XPdtk3x4EgqKnjzKJAg","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
