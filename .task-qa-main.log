Late < 1 || r.minutesLate > MINUTES_LATE_MAX) {\n43\t        ctx.addIssue({ code: 'custom', path: ['minutesLate'], message: `Minutes late must be 1–${MINUTES_LATE_MAX}` });\n44\t      }\n45\t    } else if (r.minutesLate !== undefined) {\n46\t      ctx.addIssue({ code: 'custom', path: ['minutesLate'], message: 'Minutes late is only allowed for LATE' });\n47\t    }\n48\t  });\n49\texport type RegisterRecordInput = z.infer<typeof registerRecord>;\n50\t\n51\tconst records = z\n52\t  .array(registerRecord)\n53\t  .min(1, 'Mark at least one student')\n54\t  .refine((rs) => new Set(rs.map((r) => r.studentId)).size === rs.length, 'Duplicate studentId');\n55\t\n56\texport const registerPutBody = z.union([\n57\t  courseKey.extend({ records }).strict(),\n58\t  sectionKey.extend({ records }).strict(),\n59\t]);\n60\texport type RegisterPutBody = z.infer<typeof registerPutBody>;\n61\t\n62\texport const studentAttendanceQuery = z\n63\t  .object({ from: dateOnly.optional(), to: dateOnly.optional() })\n64\t  .refine((q) => !q.from || !q.to || q.to >= q.from, { message: '`to` must be on or after `from`', path: ['to'] });\n65\t\n66\texport const courseMatrixQuery = z.object({});\n67\t\n68\texport const overviewQuery = z.object({ date: dateOnly.optional() });\n69\t\n70\tfunction daysBetween(from: string, to: string) {\n71\t  return (Date.parse(`${to}T00:00:00Z`) - Date.parse(`${from}T00:00:00Z`)) / 86_400_000;\n72\t}\n73\t\n74\texport const reportFilters = z\n75\t  .object({\n76\t    from: dateOnly,\n77\t    to: dateOnly,\n78\t    gradeLevelId: id.optional(),\n79\t    sectionId: id.optional(),\n80\t    courseId: id.optional(),\n81\t    status: attendanceStatus.optional(),\n82\t    format: z.literal('csv').optional(),\n83\t    // Pagination is read by parsePagination; accepted here so parseQuery doesn't choke.\n84\t    page: z.string().optional(),\n85\t    pageSize: z.string().optional(),\n86\t  })\n87\t  .refine((f) => f.to >= f.from, { message: '`to` must be on or after `from`', path: ['to'] })\n88\t  .refine((f) => daysBetween(f.from, f.to) <= MAX_REPORT_DAYS, {\n89\t    message: `Range must be ${MAX_REPORT_DAYS} days or fewer`,\n90\t    path: ['to'],\n91\t  });\n92\texport type ReportFilters = z.infer<typeof reportFilters>;\n93\t\n94\texport const remindBody = z.object({ courseId: id, periodId: id, date: dateOnly });\n95\t\n96\texport const attendanceSettingsPatch = z\n97\t  .object({\n98\t    attendanceMode: attendanceMode.optional(),\n99\t    attendanceAlertThreshold: z.number().int().min(0).max(100).optional(),\n100\t  })\n101\t  .strict()\n102\t  .refine((p) => Object.values(p).some((v) => v !== undefined), 'Provide at least one field');\n103\texport type AttendanceSettingsPatch = z.infer<typeof attendanceSettingsPatch>;\n104\t"}]},"parent_tool_use_id":null,"session_id":"88405567-c8b9-4e5f-8912-47ba3c7edb01","uuid":"eead519c-6bf2-4d89-a2e1-75f7b3a8e088","timestamp":"2026-11-06T06:06:37.331Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/src/lib/validators/attendance.ts","content":"import { z } from 'zod';\n\n/**\n * PRD-07 validation (FR-36), shared by RegisterForm and every attendance\n * handler. Role-dependent rules (EXCUSED = ADMIN only, the 14-day window,\n * future dates) live in the service against the user, not here.\n */\n\nexport const ATTENDANCE_STATUSES = ['PRESENT', 'ABSENT', 'LATE', 'EXCUSED'] as const;\nexport const ATTENDANCE_MODES = ['PER_PERIOD', 'DAILY_HOMEROOM', 'BOTH'] as const;\nexport const attendanceStatus = z.enum(ATTENDANCE_STATUSES);\nexport const attendanceMode = z.enum(ATTENDANCE_MODES);\nexport type AttendanceStatusValue = z.infer<typeof attendanceStatus>;\n\nexport const NOTE_MAX = 500;\nexport const MINUTES_LATE_MAX = 240;\nexport const MAX_REPORT_DAYS = 366;\n\nexport const dateOnly = z\n  .string()\n  .regex(/^\\d{4}-\\d{2}-\\d{2}$/, 'Use yyyy-MM-dd')\n  .refine((d) => !Number.isNaN(Date.parse(`${d}T00:00:00Z`)) && new Date(`${d}T00:00:00Z`).toISOString().startsWith(d), 'Invalid date');\n\nconst id = z.string().min(1);\n\nconst courseKey = z.object({ courseId: id, date: dateOnly, periodId: id });\nconst sectionKey = z.object({ sectionId: id, date: dateOnly });\n\n/** Course register or daily register -- exactly one (FR-2). */\nexport const registerQuery = z.union([courseKey.strict(), sectionKey.strict()]);\nexport type RegisterKey = z.infer<typeof registerQuery>;\n\nexport const registerRecord = z\n  .object({\n    studentId: id,\n    status: attendanceStatus,\n    minutesLate: z.number().int().optional(),\n    note: z.string().trim().max(NOTE_MAX, `Note must be ${NOTE_MAX} characters or fewer`).optional(),\n  })\n  .superRefine((r, ctx) => {\n    if (r.status === 'LATE') {\n      if (r.minutesLate === undefined || r.minutesLate < 1 || r.minutesLate > MINUTES_LATE_MAX) {\n        ctx.addIssue({ code: 'custom', path: ['minutesLate'], message: `Minutes late must be 1–${MINUTES_LATE_MAX}` });\n      }\n    } else if (r.minutesLate !== undefined) {\n      ctx.addIssue({ code: 'custom', path: ['minutesLate'], message: 'Minutes late is only allowed for LATE' });\n    }\n  });\nexport type RegisterRecordInput = z.infer<typeof registerRecord>;\n\nconst records = z\n  .array(registerRecord)\n  .min(1, 'Mark at least one student')\n  .refine((rs) => new Set(rs.map((r) => r.studentId)).size === rs.length, 'Duplicate studentId');\n\nexport const registerPutBody = z.union([\n  courseKey.extend({ records }).strict(),\n  sectionKey.extend({ records }).strict(),\n]);\nexport type RegisterPutBody = z.infer<typeof registerPutBody>;\n\nexport const studentAttendanceQuery = z\n  .object({ from: dateOnly.optional(), to: dateOnly.optional() })\n  .refine((q) => !q.from || !q.to || q.to >= q.from, { message: '`to` must be on or after `from`', path: ['to'] });\n\nexport const courseMatrixQuery = z.object({});\n\nexport const overviewQuery = z.object({ date: dateOnly.optional() });\n\nfunction daysBetween(from: string, to: string) {\n  return (Date.parse(`${to}T00:00:00Z`) - Date.parse(`${from}T00:00:00Z`)) / 86_400_000;\n}\n\nexport const reportFilters = z\n  .object({\n    from: dateOnly,\n    to: dateOnly,\n    gradeLevelId: id.optional(),\n    sectionId: id.optional(),\n    courseId: id.optional(),\n    status: attendanceStatus.optional(),\n    format: z.literal('csv').optional(),\n    // Pagination is read by parsePagination; accepted here so parseQuery doesn't choke.\n    page: z.string().optional(),\n    pageSize: z.string().optional(),\n  })\n  .refine((f) => f.to >= f.from, { message: '`to` must be on or after `from`', path: ['to'] })\n  .refine((f) => daysBetween(f.from, f.to) <= MAX_REPORT_DAYS, {\n    message: `Range must be ${MAX_REPORT_DAYS} days or fewer`,\n    path: ['to'],\n  });\nexport type ReportFilters = z.infer<typeof reportFilters>;\n\nexport const remindBody = z.object({ courseId: id, periodId: id, date: dateOnly });\n\nexport const attendanceSettingsPatch = z\n  .object({\n    attendanceMode: attendanceMode.optional(),\n    attendanceAlertThreshold: z.number().int().min(0).max(100).optional(),\n  })\n  .strict()\n  .refine((p) => Object.values(p).some((v) => v !== undefined), 'Provide at least one field');\nexport type AttendanceSettingsPatch = z.infer<typeof attendanceSettingsPatch>;\n","numLines":104,"startLine":1,"totalLines":104}},"tool_result_meta":[{"id":"toolu_01J8jPHTDmzQbcqgT7Zc72vr","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
