{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018uv5FpPdkNEvCZtS94GXxR","type":"tool_result","content":"210\t\n211\t// ---------------------------------------------------------------------------\n212\t// Items (FR-22, FR-24, FR-9)\n213\t// ---------------------------------------------------------------------------\n214\t\n215\texport async function createManualItem(user: AccessUser, courseId: string, input: ManualItemInput, request?: Request) {\n216\t  await assertCanManageCourse(user, courseId);\n217\t  await Promise.all([assertCategory(courseId, input.categoryId), assertTerm(courseId, input.termId)]);\n218\t  const item = await prisma.gradeItem.create({\n219\t    data: { courseId, termId: input.termId, categoryId: input.categoryId ?? null, title: input.title, maxPoints: input.maxPoints, dueAt: input.dueAt ?? null, source: 'MANUAL' },\n220\t  });\n221\t  await audit({ actorId: user.id, action: 'gradeItem.create', entityType: 'GradeItem', entityId: item.id, metadata: { courseId, title: item.title }, request });\n222\t  return toItemDto(item);\n223\t}\n224\t\n225\texport async function updateItem(user: AccessUser, itemId: string, patch: ItemPatch, request?: Request) {\n226\t  const item = await loadItem(user, itemId);\n227\t  const keys = Object.keys(patch).filter((k) => patch[k as keyof ItemPatch] !== undefined);\n228\t  if (item.source !== 'MANUAL' && keys.some((k) => k !== 'isVisible')) throw invalid(SOURCE_EDIT);\n229\t  await Promise.all([assertCategory(item.courseId, patch.categoryId), assertTerm(item.courseId, patch.termId)]);\n230\t  if (patch.maxPoints !== undefined) {\n231\t    const top = await prisma.grade.aggregate({ where: { gradeItemId: itemId }, _max: { score: true } });\n232\t    if (top._max.score && dec(top._max.score).gt(dec(patch.maxPoints))) {\n233\t      throw invalid(`A student already has ${fixed2(top._max.score)} points.`, { fieldErrors: { maxPoints: ['Lower than an existing score'] } });\n234\t    }\n235\t  }\n236\t  const updated = await prisma.gradeItem.update({\n237\t    where: { id: itemId },\n238\t    data: {\n239\t      ...(patch.title !== undefined ? { title: patch.title } : {}),\n240\t      ...(patch.categoryId !== undefined ? { categoryId: patch.categoryId } : {}),\n241\t      ...(patch.maxPoints !== undefined ? { maxPoints: patch.maxPoints } : {}),\n242\t      ...(patch.dueAt !== undefined ? { dueAt: patch.dueAt } : {}),\n243\t      ...(patch.termId !== undefined ? { termId: patch.termId } : {}),\n244\t      ...(patch.isVisible !== undefined ? { isVisible: patch.isVisible } : {}),\n245\t    },\n246\t  });\n247\t  await audit({ actorId: user.id, action: 'gradeItem.update', entityType: 'GradeItem', entityId: itemId, metadata: { old: toItemDto(item), new: toItemDto(updated) }, request });\n248\t  return toItemDto(updated);\n249\t}\n250\t\n251\texport async function deleteItem(user: AccessUser, itemId: string, request?: Request) {\n252\t  const item = await loadItem(user, itemId);\n253\t  if (item.source !== 'MANUAL') throw invalid('Synced items are removed by deleting their source.');\n254\t  const grades = await prisma.grade.findMany({ where: { gradeItemId: itemId } });\n255\t  await prisma.gradeItem.delete({ where: { id: itemId } });\n256\t  await audit({\n257\t    actorId: user.id,\n258\t    action: 'gradeItem.delete',\n259\t    entityType: 'GradeItem',\n260\t    entityId: itemId,\n261\t    metadata: { old: { item: toItemDto(item), grades: grades.map((g) => toCell(itemId, g.studentId, g)) } },\n262\t    request,\n263\t  });\n264\t  return { id: itemId };\n265\t}\n266\t\n267\t/** FR-24: every enrolled student with no score, not excused and not missing → missing. */\n268\texport async function markAllMissing(user: AccessUser, itemId: string, request?: Request, now = new Date()) {\n269\t  const item = await loadItem(user, itemId);\n270\t  if (!item.dueAt || now.getTime() <= item.dueAt.getTime()) throw invalid('Items can be marked missing only after their due date.');\n271\t  const [enrolled, grades] = await Promise.all([\n272\t    prisma.enrollment.findMany({ where: { courseId: item.courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n273\t    prisma.grade.findMany({ where: { gradeItemId: itemId }, select: { studentId: true, score: true, excused: true, missing: true } }),\n274\t  ]);\n275\t  const byStudent = new Map(grades.map((g) => [g.studentId, g]));\n276\t  const noRow = enrolled.map((e) => e.studentId).filter((id) => !byStudent.has(id));\n277\t  const blank = grades.filter((g) => g.score === null && !g.excused && !g.missing && enrolled.some((e) => e.studentId === g.studentId)).map((g) => g.studentId);\n278\t  const studentIds = [...noRow, ...blank];\n279\t  if (studentIds.length) {\n280\t    await prisma.$transaction([\n281\t      prisma.grade.createMany({ data: noRow.map((studentId) => ({ gradeItemId: itemId, studentId, missing: true, updatedById: user.id })), skipDuplicates: true }),\n282\t      prisma.grade.updateMany({ where: { gradeItemId: itemId, studentId: { in: blank }, score: null }, data: { missing: true, updatedById: user.id } }),\n283\t    ]);\n284\t  }\n285\t  await audit({ actorId: user.id, action: 'grade.markMissing', entityType: 'GradeItem', entityId: itemId, metadata: { itemId, studentIds }, request });\n286\t  return { updatedCount: studentIds.length, studentIds };\n287\t}\n288\t\n289\t// ---------------------------------------------------------------------------\n290\t// Grades and overrides (FR-20, FR-23, FR-38, NFR-4)\n291\t// ---------------------------------------------------------------------------\n292\t\n293\texport async function putGrade(user: AccessUser, itemId: string, studentId: string, input: GradePut, request?: Request) {\n294\t  const item = await loadItem(user, itemId);\n295\t  await assertEnrolled(item.courseId, studentId);\n296\t  const keys = Object.keys(input).filter((k) => input[k as keyof GradePut] !== undefined);\n297\t  if (item.source !== 'MANUAL' && keys.some((k) => k !== 'comment')) throw invalid(`Only the comment can be changed here. ${SOURCE_EDIT}`);\n298\t  if (input.score != null && dec(input.score).gt(dec(item.maxPoints))) {\n299\t    throw invalid(`Score must be between 0 and ${dec(item.maxPoints).toString()}.`, { fieldErrors: { score: ['Above max points'] } });\n300\t  }\n301\t  const data = {\n302\t    ...(input.score !== undefined ? { score: input.score } : {}),\n303\t    ...(input.excused !== undefined ? { excused: input.excused } : {}),\n304\t    ...(input.missing !== undefined ? { missing: input.missing } : {}),\n305\t    ...(input.comment !== undefined ? { comment: input.comment || null } : {}),\n306\t    updatedById: user.id,\n307\t  };\n308\t  const key = { gradeItemId_studentId: { gradeItemId: itemId, studentId } };\n309\t  const { old, saved } = await prisma.$transaction(async (tx) => {\n310\t    const old = await tx.grade.findUnique({ where: key });\n311\t    const saved = await tx.grade.upsert({ where: key, create: { gradeItemId: itemId, studentId, ...data }, update: data });\n312\t    return { old, saved };\n313\t  });\n314\t  const oldCell = old ? toCell(itemId, studentId, old) : null;\n315\t  const newCell = toCell(itemId, studentId, saved);\n316\t  await audit({ actorId: user.id, action: 'grade.update', entityType: 'GradeItem', entityId: itemId, metadata: { studentId, old: oldCell, new: newCell }, request });\n317\t  // A9: one notification per student per item — the first time a manual score appears.\n318\t  if (item.source === 'MANUAL' && oldCell?.score == null && newCell.score !== null) {\n319\t    await notifyStudentAndParents({\n320\t      type: 'grade.posted',\n321\t      studentIds: [studentId],\n322\t      title: `Grade posted: ${item.title}`,\n323\t      body: `${newCell.score.replace(/\\.00$/, '')}/${dec(item.maxPoints).toString()}`,\n324\t      link: `/students/${studentId}/grades`,\n325\t    });\n326\t  }\n327\t  return { grade: newCell, result: await studentResult(item.courseId, item.termId, studentId) };\n328\t}\n329\t\n330\texport async function putTermOverride(user: AccessUser, courseId: string, studentId: string, input: TermOverrideInput, request?: Request) {\n331\t  await assertCanManageCourse(user, courseId);\n332\t  await Promise.all([assertTerm(courseId, input.termId), assertEnrolled(courseId, studentId)]);\n333\t  if (input.letter) {\n334\t    const data = await loadCourseTermData([courseId], input.termId, [studentId]);\n335\t    const bands = data.scales.get(courseId)?.bands ?? [];\n336\t    if (!bands.some((b) => b.letter === input.letter)) {\n337\t      throw invalid('That letter is not in the course’s grading scale.', { fieldErrors: { letter: ['Unknown letter'] } });\n338\t    }\n339\t  }\n340\t  const data = {\n341\t    ...(input.percent !== undefined ? { percent: input.percent } : {}),\n342\t    ...(input.letter !== undefined ? { letter: input.letter || null } : {}),\n343\t    ...(input.teacherComment !== undefined ? { teacherComment: input.teacherComment || null } : {}),\n344\t    updatedById: user.id,\n345\t  };\n346\t  const key = { courseId_termId_studentId: { courseId, termId: input.termId, studentId } };\n347\t  const dto = (o: { percent: unknown; letter: string | null; teacherComment: string | null } | null) =>\n348\t    o ? { percent: o.percent == null ? null : fixed2(String(o.percent)), letter: o.letter, teacherComment: o.teacherComment } : null;\n349\t  const { old, saved } = await prisma.$transaction(async (tx) => {\n350\t    const old = await tx.termGradeOverride.findUnique({ where: key });\n351\t    const saved = await tx.termGradeOverride.upsert({ where: key, create: { courseId, termId: input.termId, studentId, ...data }, update: data });\n352\t    return { old, saved };\n353\t  });\n354\t  await audit({\n355\t    actorId: user.id,\n356\t    action: 'termOverride.upsert',\n357\t    entityType: 'Course',\n358\t    entityId: courseId,\n359\t    metadata: { studentId, termId: input.termId, old: dto(old), new: dto(saved) },\n360\t    request,\n361\t  });\n362\t  return { override: dto(saved)!, result: await studentResult(courseId, input.termId, studentId) };\n363\t}\n364\t"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"97177617-c78b-4d01-9a83-2240dc021dfb","timestamp":"2026-11-09T14:10:19.565Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/gradebook/gradebook-service.ts","content":"\n// ---------------------------------------------------------------------------\n// Items (FR-22, FR-24, FR-9)\n// ---------------------------------------------------------------------------\n\nexport async function createManualItem(user: AccessUser, courseId: string, input: ManualItemInput, request?: Request) {\n  await assertCanManageCourse(user, courseId);\n  await Promise.all([assertCategory(courseId, input.categoryId), assertTerm(courseId, input.termId)]);\n  const item = await prisma.gradeItem.create({\n    data: { courseId, termId: input.termId, categoryId: input.categoryId ?? null, title: input.title, maxPoints: input.maxPoints, dueAt: input.dueAt ?? null, source: 'MANUAL' },\n  });\n  await audit({ actorId: user.id, action: 'gradeItem.create', entityType: 'GradeItem', entityId: item.id, metadata: { courseId, title: item.title }, request });\n  return toItemDto(item);\n}\n\nexport async function updateItem(user: AccessUser, itemId: string, patch: ItemPatch, request?: Request) {\n  const item = await loadItem(user, itemId);\n  const keys = Object.keys(patch).filter((k) => patch[k as keyof ItemPatch] !== undefined);\n  if (item.source !== 'MANUAL' && keys.some((k) => k !== 'isVisible')) throw invalid(SOURCE_EDIT);\n  await Promise.all([assertCategory(item.courseId, patch.categoryId), assertTerm(item.courseId, patch.termId)]);\n  if (patch.maxPoints !== undefined) {\n    const top = await prisma.grade.aggregate({ where: { gradeItemId: itemId }, _max: { score: true } });\n    if (top._max.score && dec(top._max.score).gt(dec(patch.maxPoints))) {\n      throw invalid(`A student already has ${fixed2(top._max.score)} points.`, { fieldErrors: { maxPoints: ['Lower than an existing score'] } });\n    }\n  }\n  const updated = await prisma.gradeItem.update({\n    where: { id: itemId },\n    data: {\n      ...(patch.title !== undefined ? { title: patch.title } : {}),\n      ...(patch.categoryId !== undefined ? { categoryId: patch.categoryId } : {}),\n      ...(patch.maxPoints !== undefined ? { maxPoints: patch.maxPoints } : {}),\n      ...(patch.dueAt !== undefined ? { dueAt: patch.dueAt } : {}),\n      ...(patch.termId !== undefined ? { termId: patch.termId } : {}),\n      ...(patch.isVisible !== undefined ? { isVisible: patch.isVisible } : {}),\n    },\n  });\n  await audit({ actorId: user.id, action: 'gradeItem.update', entityType: 'GradeItem', entityId: itemId, metadata: { old: toItemDto(item), new: toItemDto(updated) }, request });\n  return toItemDto(updated);\n}\n\nexport async function deleteItem(user: AccessUser, itemId: string, request?: Request) {\n  const item = await loadItem(user, itemId);\n  if (item.source !== 'MANUAL') throw invalid('Synced items are removed by deleting their source.');\n  const grades = await prisma.grade.findMany({ where: { gradeItemId: itemId } });\n  await prisma.gradeItem.delete({ where: { id: itemId } });\n  await audit({\n    actorId: user.id,\n    action: 'gradeItem.delete',\n    entityType: 'GradeItem',\n    entityId: itemId,\n    metadata: { old: { item: toItemDto(item), grades: grades.map((g) => toCell(itemId, g.studentId, g)) } },\n    request,\n  });\n  return { id: itemId };\n}\n\n/** FR-24: every enrolled student with no score, not excused and not missing → missing. */\nexport async function markAllMissing(user: AccessUser, itemId: string, request?: Request, now = new Date()) {\n  const item = await loadItem(user, itemId);\n  if (!item.dueAt || now.getTime() <= item.dueAt.getTime()) throw invalid('Items can be marked missing only after their due date.');\n  const [enrolled, grades] = await Promise.all([\n    prisma.enrollment.findMany({ where: { courseId: item.courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n    prisma.grade.findMany({ where: { gradeItemId: itemId }, select: { studentId: true, score: true, excused: true, missing: true } }),\n  ]);\n  const byStudent = new Map(grades.map((g) => [g.studentId, g]));\n  const noRow = enrolled.map((e) => e.studentId).filter((id) => !byStudent.has(id));\n  const blank = grades.filter((g) => g.score === null && !g.excused && !g.missing && enrolled.some((e) => e.studentId === g.studentId)).map((g) => g.studentId);\n  const studentIds = [...noRow, ...blank];\n  if (studentIds.length) {\n    await prisma.$transaction([\n      prisma.grade.createMany({ data: noRow.map((studentId) => ({ gradeItemId: itemId, studentId, missing: true, updatedById: user.id })), skipDuplicates: true }),\n      prisma.grade.updateMany({ where: { gradeItemId: itemId, studentId: { in: blank }, score: null }, data: { missing: true, updatedById: user.id } }),\n    ]);\n  }\n  await audit({ actorId: user.id, action: 'grade.markMissing', entityType: 'GradeItem', entityId: itemId, metadata: { itemId, studentIds }, request });\n  return { updatedCount: studentIds.length, studentIds };\n}\n\n// ---------------------------------------------------------------------------\n// Grades and overrides (FR-20, FR-23, FR-38, NFR-4)\n// ---------------------------------------------------------------------------\n\nexport async function putGrade(user: AccessUser, itemId: string, studentId: string, input: GradePut, request?: Request) {\n  const item = await loadItem(user, itemId);\n  await assertEnrolled(item.courseId, studentId);\n  const keys = Object.keys(input).filter((k) => input[k as keyof GradePut] !== undefined);\n  if (item.source !== 'MANUAL' && keys.some((k) => k !== 'comment')) throw invalid(`Only the comment can be changed here. ${SOURCE_EDIT}`);\n  if (input.score != null && dec(input.score).gt(dec(item.maxPoints))) {\n    throw invalid(`Score must be between 0 and ${dec(item.maxPoints).toString()}.`, { fieldErrors: { score: ['Above max points'] } });\n  }\n  const data = {\n    ...(input.score !== undefined ? { score: input.score } : {}),\n    ...(input.excused !== undefined ? { excused: input.excused } : {}),\n    ...(input.missing !== undefined ? { missing: input.missing } : {}),\n    ...(input.comment !== undefined ? { comment: input.comment || null } : {}),\n    updatedById: user.id,\n  };\n  const key = { gradeItemId_studentId: { gradeItemId: itemId, studentId } };\n  const { old, saved } = await prisma.$transaction(async (tx) => {\n    const old = await tx.grade.findUnique({ where: key });\n    const saved = await tx.grade.upsert({ where: key, create: { gradeItemId: itemId, studentId, ...data }, update: data });\n    return { old, saved };\n  });\n  const oldCell = old ? toCell(itemId, studentId, old) : null;\n  const newCell = toCell(itemId, studentId, saved);\n  await audit({ actorId: user.id, action: 'grade.update', entityType: 'GradeItem', entityId: itemId, metadata: { studentId, old: oldCell, new: newCell }, request });\n  // A9: one notification per student per item — the first time a manual score appears.\n  if (item.source === 'MANUAL' && oldCell?.score == null && newCell.score !== null) {\n    await notifyStudentAndParents({\n      type: 'grade.posted',\n      studentIds: [studentId],\n      title: `Grade posted: ${item.title}`,\n      body: `${newCell.score.replace(/\\.00$/, '')}/${dec(item.maxPoints).toString()}`,\n      link: `/students/${studentId}/grades`,\n    });\n  }\n  return { grade: newCell, result: await studentResult(item.courseId, item.termId, studentId) };\n}\n\nexport async function putTermOverride(user: AccessUser, courseId: string, studentId: string, input: TermOverrideInput, request?: Request) {\n  await assertCanManageCourse(user, courseId);\n  await Promise.all([assertTerm(courseId, input.termId), assertEnrolled(courseId, studentId)]);\n  if (input.letter) {\n    const data = await loadCourseTermData([courseId], input.termId, [studentId]);\n    const bands = data.scales.get(courseId)?.bands ?? [];\n    if (!bands.some((b) => b.letter === input.letter)) {\n      throw invalid('That letter is not in the course’s grading scale.', { fieldErrors: { letter: ['Unknown letter'] } });\n    }\n  }\n  const data = {\n    ...(input.percent !== undefined ? { percent: input.percent } : {}),\n    ...(input.letter !== undefined ? { letter: input.letter || null } : {}),\n    ...(input.teacherComment !== undefined ? { teacherComment: input.teacherComment || null } : {}),\n    updatedById: user.id,\n  };\n  const key = { courseId_termId_studentId: { courseId, termId: input.termId, studentId } };\n  const dto = (o: { percent: unknown; letter: string | null; teacherComment: string | null } | null) =>\n    o ? { percent: o.percent == null ? null : fixed2(String(o.percent)), letter: o.letter, teacherComment: o.teacherComment } : null;\n  const { old, saved } = await prisma.$transaction(async (tx) => {\n    const old = await tx.termGradeOverride.findUnique({ where: key });\n    const saved = await tx.termGradeOverride.upsert({ where: key, create: { courseId, termId: input.termId, studentId, ...data }, update: data });\n    return { old, saved };\n  });\n  await audit({\n    actorId: user.id,\n    action: 'termOverride.upsert',\n    entityType: 'Course',\n    entityId: courseId,\n    metadata: { studentId, termId: input.termId, old: dto(old), new: dto(saved) },\n    request,\n  });\n  return { override: dto(saved)!, result: await studentResult(courseId, input.termId, studentId) };\n}\n","numLines":155,"startLine":210,"totalLines":364}},"tool_result_meta":[{"id":"toolu_018uv5FpPdkNEvCZtS94GXxR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
