{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Njt5EuCJywH4uAo7tUrTog","type":"tool_result","content":"import { formatInTimeZone, getTimezoneOffset } from 'date-fns-tz';\nimport { addDateDays, schoolDateOf, schoolMidnight } from '@/lib/dates';\n\n/**\n * PRD-14 RFC 5545 builder (FR-12, FR-26, NFR-3, NFR-6, ADR-5). Pure, no I/O.\n * - all-day: DTSTART/DTEND;VALUE=DATE with an exclusive DTEND\n * - timed one-off: UTC 'Z' times\n * - series: TZID + RRULE (UNTIL in UTC, end of the until day), VTIMEZONE in the calendar\n * - deadlines: zero-duration VEVENT with URL\n * Lines end in CRLF and are folded at 75 octets.\n */\n\nexport interface IcalItem {\n  uid: string;\n  title: string;\n  description?: string | null;\n  location?: string | null;\n  start: Date;\n  /** Exclusive for all-day; equals start for deadlines. */\n  end: Date;\n  allDay: boolean;\n  url?: string | null;\n  category?: string | null;\n  recurrence?: { freq: 'WEEKLY' | 'MONTHLY'; until: string } | null;\n}\n\nconst CRLF = '\\r\\n';\nconst DAY_MS = 86_400_000;\n\nexport function escapeText(value: string): string {\n  return value.replace(/\\\\/g, '\\\\\\\\').replace(/;/g, '\\\\;').replace(/,/g, '\\\\,').replace(/\\r?\\n/g, '\\\\n');\n}\n\n/** Folds one content line at 75 octets (UTF-8), never splitting a character. */\nexport function foldLine(line: string): string {\n  const parts: string[] = [];\n  let current = '';\n  let bytes = 0;\n  let limit = 75;\n  for (const ch of line) {\n    const size = Buffer.byteLength(ch, 'utf8');\n    if (bytes + size > limit) {\n      parts.push(current);\n      current = ' ';\n      bytes = 1;\n      limit = 75;\n    }\n    current += ch;\n    bytes += size;\n  }\n  parts.push(current);\n  return parts.join(CRLF);\n}\n\nconst utcStamp = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\\.\\d{3}/, '');\nconst localStamp = (d: Date, tz: string) => formatInTimeZone(d, tz, \"yyyyMMdd'T'HHmmss\");\nconst dateValue = (dateStr: string) => dateStr.replace(/-/g, '');\n\nfunction formatOffset(ms: number): string {\n  const sign = ms < 0 ? '-' : '+';\n  const minutes = Math.abs(ms) / 60_000;\n  return `${sign}${String(Math.floor(minutes / 60)).padStart(2, '0')}${String(minutes % 60).padStart(2, '0')}`;\n}\n\n/** VTIMEZONE with every offset transition from a year before `from` to `to`. */\nexport function vtimezone(tz: string, from: Date, to: Date): string[] {\n  const offset = (t: number) => getTimezoneOffset(tz, new Date(t));\n  const transitions: { at: number; before: number; after: number }[] = [];\n  const end = to.getTime();\n  let prev = from.getTime() - 366 * DAY_MS;\n  let prevOffset = offset(prev);\n  for (let t = prev + DAY_MS; t <= end + DAY_MS; t += DAY_MS) {\n    const o = offset(t);\n    if (o !== prevOffset) {\n      let lo = prev;\n      let hi = t; // offset(lo) = prevOffset, offset(hi) = o\n      while (hi - lo > 60_000) {\n        const mid = lo + Math.floor((hi - lo) / 2);\n        if (offset(mid) === prevOffset) lo = mid;\n        else hi = mid;\n      }\n      transitions.push({ at: hi, before: prevOffset, after: o });\n    }\n    prev = t;\n    prevOffset = o;\n  }\n\n  const lines = ['BEGIN:VTIMEZONE', `TZID:${tz}`];\n  if (transitions.length === 0) {\n    const o = formatOffset(offset(from.getTime()));\n    lines.push('BEGIN:STANDARD', 'DTSTART:19700101T000000', `TZOFFSETFROM:${o}`, `TZOFFSETTO:${o}`, 'END:STANDARD');\n  }\n  for (const tr of transitions) {\n    const kind = tr.after > tr.before ? 'DAYLIGHT' : 'STANDARD';\n    // DTSTART is the local time of the transition, in the offset in force before it.\n    const local = new Date(Math.round((tr.at + tr.before) / 60_000) * 60_000).toISOString();\n    lines.push(\n      `BEGIN:${kind}`,\n      `DTSTART:${local.slice(0, 19).replace(/[-:]/g, '')}`,\n      `TZOFFSETFROM:${formatOffset(tr.before)}`,\n      `TZOFFSETTO:${formatOffset(tr.after)}`,\n      `END:${kind}`,\n    );\n  }\n  lines.push('END:VTIMEZONE');\n  return lines;\n}\n\nexport function vevent(item: IcalItem, tz: string, now: Date = new Date()): string[] {\n  const lines = ['BEGIN:VEVENT', `UID:${item.uid}@schoolhub`, `DTSTAMP:${utcStamp(now)}`];\n\n  if (item.allDay) {\n    lines.push(`DTSTART;VALUE=DATE:${dateValue(schoolDateOf(item.start, tz))}`);\n    lines.push(`DTEND;VALUE=DATE:${dateValue(schoolDateOf(item.end, tz))}`);\n  } else if (item.recurrence) {\n    lines.push(`DTSTART;TZID=${tz}:${localStamp(item.start, tz)}`);\n    lines.push(`DTEND;TZID=${tz}:${localStamp(item.end, tz)}`);\n  } else {\n    lines.push(`DTSTART:${utcStamp(item.start)}`);\n    lines.push(`DTEND:${utcStamp(item.end)}`);\n  }\n\n  if (item.recurrence) {\n    // UNTIL is inclusive of the whole until-day. DATE-valued for all-day series (RFC 5545 §3.3.10).\n    const until = item.allDay\n      ? dateValue(item.recurrence.until)\n      : utcStamp(new Date(schoolMidnight(addDateDays(item.recurrence.until, 1), tz).getTime() - 1000));\n    const byMonthDay = item.recurrence.freq === 'MONTHLY' ? `;BYMONTHDAY=${Number(formatInTimeZone(item.start, tz, 'd'))}` : '';\n    lines.push(`RRULE:FREQ=${item.recurrence.freq};UNTIL=${until}${byMonthDay}`);\n  }\n\n  lines.push(`SUMMARY:${escapeText(item.title)}`);\n  if (item.description) lines.push(`DESCRIPTION:${escapeText(item.description)}`);\n  if (item.location) lines.push(`LOCATION:${escapeText(item.location)}`);\n  if (item.category) lines.push(`CATEGORIES:${escapeText(item.category)}`);\n  if (item.url) lines.push(`URL:${item.url}`);\n  lines.push('END:VEVENT');\n  return lines;\n}\n\nexport function buildCalendar(\n  items: IcalItem[],\n  tz: string,\n  window: { from: Date; to: Date },\n  opts: { name?: string; now?: Date } = {},\n): string {\n  const lines = [\n    'BEGIN:VCALENDAR',\n    'VERSION:2.0',\n    'PRODID:-//SchoolHub//Calendar//EN',\n    'CALSCALE:GREGORIAN',\n    'METHOD:PUBLISH',\n    `X-WR-CALNAME:${escapeText(opts.name ?? 'SchoolHub')}`,\n    `X-WR-TIMEZONE:${tz}`,\n    ...vtimezone(tz, window.from, window.to),\n    ...items.flatMap((item) => vevent(item, tz, opts.now)),\n    'END:VCALENDAR',\n  ];\n  return lines.map(foldLine).join(CRLF) + CRLF;\n}\nimport { formatInTimeZone, fromZonedTime } from 'date-fns-tz';\n\n/**\n * PRD-14 FR-15 / ADR-3: read-time expansion of a recurring event. Pure.\n * Steps in school-tz wall-clock time, so a 15:30 club stays at 15:30 across a\n * DST change. WEEKLY = +7 days; MONTHLY = same day of month, months without that\n * day are skipped. recurrenceUntil is inclusive (the whole school-tz day).\n */\n\nexport interface RecurringEvent {\n  id: string;\n  startAt: Date;\n  endAt: Date;\n  recurrence: 'NONE' | 'WEEKLY' | 'MONTHLY';\n  /** Prisma @db.Date (UTC midnight of the date) or 'yyyy-MM-dd'. */\n  recurrenceUntil: Date | string | null;\n}\n\nexport interface Occurrence {\n  /** `${eventId}:${startISO}` */\n  id: string;\n  eventId: string;\n  start: Date;\n  end: Date;\n}\n\nconst DAY_MS = 86_400_000;\nconst MAX_STEPS = 400; // ≤ 1 year of weekly/monthly, with headroom\n\n/** Wall-clock time in tz as a \"naive\" epoch (the local fields read as if UTC). */\nfunction naive(d: Date, tz: string): number {\n  return Date.parse(`${formatInTimeZone(d, tz, \"yyyy-MM-dd'T'HH:mm:ss.SSS\")}Z`);\n}\n\nfunction fromNaive(ms: number, tz: string): Date {\n  return fromZonedTime(new Date(ms).toISOString().slice(0, 23), tz);\n}\n\nfunction untilDate(u: Date | string): string {\n  return typeof u === 'string' ? u.slice(0, 10) : u.toISOString().slice(0, 10);\n}\n\nfunction overlaps(start: Date, end: Date, from: Date, to: Date): boolean {\n  if (start >= to) return false;\n  return end > from || (end.getTime() === start.getTime() && start >= from);\n}\n\nexport function expandOccurrences(event: RecurringEvent, from: Date, to: Date, tz: string): Occurrence[] {\n  const make = (start: Date, end: Date): Occurrence => ({\n    id: `${event.id}:${start.toISOString()}`,\n    eventId: event.id,\n    start,\n    end,\n  });\n\n  if (event.recurrence === 'NONE' || !event.recurrenceUntil) {\n    return overlaps(event.startAt, event.endAt, from, to) ? [make(event.startAt, event.endAt)] : [];\n  }\n\n  const start0 = naive(event.startAt, tz);\n  const duration = naive(event.endAt, tz) - start0;\n  const until = untilDate(event.recurrenceUntil);\n  const base = new Date(start0);\n  const out: Occurrence[] = [];\n\n  for (let k = 0; k < MAX_STEPS; k++) {\n    let localStart: number;\n    if (event.recurrence === 'WEEKLY') {\n      localStart = start0 + k * 7 * DAY_MS;\n    } else {\n      const y = base.getUTCFullYear();\n      const m = base.getUTCMonth() + k;\n      const day = base.getUTCDate();\n      const daysInMonth = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();\n      if (day > daysInMonth) continue; // e.g. the 31st in a 30-day month\n      localStart = Date.UTC(y, m, day) + (start0 % DAY_MS);\n    }\n    if (new Date(localStart).toISOString().slice(0, 10) > until) break;\n    const start = fromNaive(localStart, tz);\n    if (start >= to) break;\n    const end = fromNaive(localStart + duration, tz);\n    if (overlaps(start, end, from, to)) out.push(make(start, end));\n  }\n  return out;\n}\nimport { describe, expect, it } from 'vitest';\nimport ical, { type VEvent } from 'node-ical';\nimport { buildCalendar, escapeText, foldLine, vevent } from '@/server/calendar/ical';\n\nconst tz = 'America/New_York';\nconst now = new Date('2026-11-10T12:00:00Z');\nconst window = { from: new Date('2026-10-01T00:00:00Z'), to: new Date('2027-10-01T00:00:00Z') };\n\ndescribe('escapeText / foldLine', () => {\n  it('escapes , ; \\\\ and newlines', () => {\n    expect(escapeText('a,b;c\\\\d\\ne')).toBe('a\\\\,b\\;c\\\\\\\\d\\\\ne');\n  });\n\n  it('folds at 75 octets with CRLF + space, never splitting multibyte chars', () => {\n    const folded = foldLine(`SUMMARY:${'é'.repeat(80)}`);\n    const lines = folded.split('\\r\\n');\n    expect(lines.length).toBeGreaterThan(1);\n    for (const l of lines) expect(Buffer.byteLength(l, 'utf8')).toBeLessThanOrEqual(75);\n    expect(lines.slice(1).every((l) => l.startsWith(' '))).toBe(true);\n    expect(lines.map((l, i) => (i ? l.slice(1) : l)).join('')).toBe(`SUMMARY:${'é'.repeat(80)}`);\n  });\n});\n\ndescribe('vevent', () => {\n  it('all-day uses VALUE=DATE with an exclusive end, across DST', () => {\n    const lines = vevent(\n      { uid: 'h', title: 'Break', start: new Date('2026-10-31T04:00:00Z'), end: new Date('2026-11-02T05:00:00Z'), allDay: true },\n      tz,\n      now,\n    );\n    expect(lines).toContain('DTSTART;VALUE=DATE:20261031');\n    expect(lines).toContain('DTEND;VALUE=DATE:20261102');\n  });\n\n  it('one-off timed uses UTC Z; series uses TZID + RRULE with UTC UNTIL', () => {\n    const oneOff = vevent({ uid: 'o', title: 'x', start: new Date('2026-11-12T23:00:00Z'), end: new Date('2026-11-13T00:00:00Z'), allDay: false }, tz, now);\n    expect(oneOff).toContain('DTSTART:20261112T230000Z');\n    const series = vevent(\n      {\n        uid: 's',\n        title: 'Chess',\n        start: new Date('2026-09-01T19:30:00Z'),\n        end: new Date('2026-09-01T20:30:00Z'),\n        allDay: false,\n        recurrence: { freq: 'WEEKLY', until: '2026-12-15' },\n      },\n      tz,\n      now,\n    );\n    expect(series).toContain(`DTSTART;TZID=${tz}:20260901T153000`);\n    expect(series).toContain('RRULE:FREQ=WEEKLY;UNTIL=20261216T045959Z');\n  });\n});\n\ndescribe('buildCalendar parsed by node-ical (NFR-6)', () => {\n  const body = buildCalendar(\n    [\n      { uid: 'e1', title: 'Fair, science; fun', description: 'Line 1\\nLine 2', location: 'Hall, A', start: new Date('2026-11-20T14:00:00Z'), end: new Date('2026-11-20T17:00:00Z'), allDay: false },\n      { uid: 'e2', title: 'Thanksgiving break', start: new Date('2026-11-26T05:00:00Z'), end: new Date('2026-11-28T05:00:00Z'), allDay: true },\n      {\n        uid: 'e3',\n        title: 'Chess club',\n        start: new Date('2026-10-27T19:30:00Z'),\n        end: new Date('2026-10-27T20:30:00Z'),\n        allDay: false,\n        recurrence: { freq: 'WEEKLY', until: '2026-11-17' },\n      },\n      { uid: 'a1', title: 'Essay due', start: new Date('2026-11-15T04:59:00Z'), end: new Date('2026-11-15T04:59:00Z'), allDay: false, url: 'http://localhost:3000/courses/c/assignments/a' },\n      { uid: 'm1', title: 'Monthly', start: new Date('2027-01-31T15:00:00Z'), end: new Date('2027-01-31T16:00:00Z'), allDay: false, recurrence: { freq: 'MONTHLY', until: '2027-05-31' } },\n    ],\n    tz,\n    window,\n    { now },\n  );\n  const parsed = ical.sync.parseICS(body);\n  const ev = (uid: string) => Object.values(parsed).find((c) => c?.type === 'VEVENT' && (c as { uid?: string }).uid === `${uid}@schoolhub`) as VEvent;\n\n  it('is CRLF-terminated with folded lines', () => {\n    expect(body.endsWith('\\r\\n')).toBe(true);\n    expect(body.split('\\r\\n').every((l) => Buffer.byteLength(l, 'utf8') <= 75)).toBe(true);\n    expect(body).toContain('BEGIN:VTIMEZONE');\n  });\n\n  it('round-trips escaped text', () => {\n    expect(ev('e1').summary).toBe('Fair, science; fun');\n    expect(ev('e1').description).toBe('Line 1\\nLine 2');\n    expect(ev('e1').location).toBe('Hall, A');\n  });\n\n  it('all-day is a date with exclusive end', () => {\n    const e = ev('e2');\n    expect(e.start.dateOnly).toBe(true);\n    expect(e.datetype).toBe('date');\n  });\n\n  it('weekly RRULE keeps 15:30 local across DST', () => {\n    const dates = ev('e3').rrule!.all().map((d: Date) => d.toISOString());\n    expect(dates.length).toBe(4);\n    const startTimes = ical\n      .expandRecurringEvent(ev('e3'), { from: new Date('2026-10-01T00:00:00Z'), to: new Date('2026-12-01T00:00:00Z') })\n      .map((i) => i.start.toISOString());\n    expect(startTimes).toEqual(['2026-10-27T19:30:00.000Z', '2026-11-03T20:30:00.000Z', '2026-11-10T20:30:00.000Z', '2026-11-17T20:30:00.000Z']);\n  });\n\n  it('monthly RRULE with BYMONTHDAY skips short months', () => {\n    expect(body).toContain('BYMONTHDAY=31');\n    expect(ev('m1').rrule!.all().length).toBe(3); // Jan, Mar, May\n  });\n\n  it('deadline is zero-duration with a URL', () => {\n    const e = ev('a1');\n    expect(e.end!.getTime()).toBe(e.start.getTime());\n    expect(e.url).toBe('http://localhost:3000/courses/c/assignments/a');\n  });\n});\nimport { describe, expect, it } from 'vitest';\nimport { expandOccurrences } from '@/server/calendar/recurrence';\n\nconst tz = 'America/New_York';\nconst D = (s: string) => new Date(s);\n\ndescribe('expandOccurrences', () => {\n  it('NONE returns the event when it overlaps the range', () => {\n    const e = { id: 'e', startAt: D('2026-11-10T15:00:00Z'), endAt: D('2026-11-10T16:00:00Z'), recurrence: 'NONE' as const, recurrenceUntil: null };\n    expect(expandOccurrences(e, D('2026-11-01T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz)).toHaveLength(1);\n    expect(expandOccurrences(e, D('2026-11-11T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz)).toHaveLength(0);\n  });\n\n  it('WEEKLY steps 7 days and ids are eventId:startISO', () => {\n    const e = { id: 'chess', startAt: D('2026-09-01T19:30:00Z'), endAt: D('2026-09-01T20:30:00Z'), recurrence: 'WEEKLY' as const, recurrenceUntil: '2026-09-29' };\n    const occ = expandOccurrences(e, D('2026-09-01T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz);\n    expect(occ.map((o) => o.start.toISOString())).toEqual([\n      '2026-09-01T19:30:00.000Z',\n      '2026-09-08T19:30:00.000Z',\n      '2026-09-15T19:30:00.000Z',\n      '2026-09-22T19:30:00.000Z',\n      '2026-09-29T19:30:00.000Z', // until is inclusive\n    ]);\n    expect(occ[1].id).toBe('chess:2026-09-08T19:30:00.000Z');\n    expect(occ[1].eventId).toBe('chess');\n  });\n\n  it('keeps wall-clock time across the DST change (2026-11-01)', () => {\n    // Tuesdays 15:30 New York: EDT (-4) then EST (-5)\n    const e = { id: 'c', startAt: D('2026-10-27T19:30:00Z'), endAt: D('2026-10-27T20:30:00Z'), recurrence: 'WEEKLY' as const, recurrenceUntil: '2026-11-10' };\n    const occ = expandOccurrences(e, D('2026-10-01T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz);\n    expect(occ.map((o) => o.start.toISOString())).toEqual(['2026-10-27T19:30:00.000Z', '2026-11-03T20:30:00.000Z', '2026-11-10T20:30:00.000Z']);\n    expect(occ.every((o) => o.end.getTime() - o.start.getTime() === 3_600_000)).toBe(true);\n  });\n\n  it('MONTHLY on the 31st skips short months', () => {\n    const e = { id: 'm', startAt: D('2027-01-31T14:00:00Z'), endAt: D('2027-01-31T15:00:00Z'), recurrence: 'MONTHLY' as const, recurrenceUntil: '2027-07-31' };\n    const occ = expandOccurrences(e, D('2027-01-01T00:00:00Z'), D('2027-12-01T00:00:00Z'), tz);\n    expect(occ.map((o) => o.start.toISOString().slice(0, 10))).toEqual(['2027-01-31', '2027-03-31', '2027-05-31', '2027-07-31']);\n  });\n\n  it('respects the range and the until bound', () => {\n    const e = { id: 'w', startAt: D('2026-09-01T19:30:00Z'), endAt: D('2026-09-01T20:30:00Z'), recurrence: 'WEEKLY' as const, recurrenceUntil: D('2026-12-15T00:00:00Z') };\n    const occ = expandOccurrences(e, D('2026-12-01T00:00:00Z'), D('2027-01-31T00:00:00Z'), tz);\n    expect(occ.map((o) => o.start.toISOString().slice(0, 10))).toEqual(['2026-12-01', '2026-12-08', '2026-12-15']);\n  });\n\n  it('all-day weekly across DST keeps school-midnight bounds', () => {\n    const e = { id: 'a', startAt: D('2026-10-25T04:00:00Z'), endAt: D('2026-10-26T04:00:00Z'), recurrence: 'WEEKLY' as const, recurrenceUntil: '2026-11-01' };\n    const occ = expandOccurrences(e, D('2026-10-01T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz);\n    expect(occ[1].start.toISOString()).toBe('2026-11-01T04:00:00.000Z'); // 00:00 EDT on Nov 1\n    expect(occ[1].end.toISOString()).toBe('2026-11-02T05:00:00.000Z'); // 00:00 EST on Nov 2\n  });\n});","is_error":false}]},"parent_tool_use_id":null,"session_id":"d4f9b1f7-a7a6-4988-a1be-042973bf331a","uuid":"520cceca-fe5e-44ef-a69f-519d02fa39b0","timestamp":"2026-11-09T23:50:49.762Z","tool_use_result":{"stdout":"import { formatInTimeZone, getTimezoneOffset } from 'date-fns-tz';\nimport { addDateDays, schoolDateOf, schoolMidnight } from '@/lib/dates';\n\n/**\n * PRD-14 RFC 5545 builder (FR-12, FR-26, NFR-3, NFR-6, ADR-5). Pure, no I/O.\n * - all-day: DTSTART/DTEND;VALUE=DATE with an exclusive DTEND\n * - timed one-off: UTC 'Z' times\n * - series: TZID + RRULE (UNTIL in UTC, end of the until day), VTIMEZONE in the calendar\n * - deadlines: zero-duration VEVENT with URL\n * Lines end in CRLF and are folded at 75 octets.\n */\n\nexport interface IcalItem {\n  uid: string;\n  title: string;\n  description?: string | null;\n  location?: string | null;\n  start: Date;\n  /** Exclusive for all-day; equals start for deadlines. */\n  end: Date;\n  allDay: boolean;\n  url?: string | null;\n  category?: string | null;\n  recurrence?: { freq: 'WEEKLY' | 'MONTHLY'; until: string } | null;\n}\n\nconst CRLF = '\\r\\n';\nconst DAY_MS = 86_400_000;\n\nexport function escapeText(value: string): string {\n  return value.replace(/\\\\/g, '\\\\\\\\').replace(/;/g, '\\\\;').replace(/,/g, '\\\\,').replace(/\\r?\\n/g, '\\\\n');\n}\n\n/** Folds one content line at 75 octets (UTF-8), never splitting a character. */\nexport function foldLine(line: string): string {\n  const parts: string[] = [];\n  let current = '';\n  let bytes = 0;\n  let limit = 75;\n  for (const ch of line) {\n    const size = Buffer.byteLength(ch, 'utf8');\n    if (bytes + size > limit) {\n      parts.push(current);\n      current = ' ';\n      bytes = 1;\n      limit = 75;\n    }\n    current += ch;\n    bytes += size;\n  }\n  parts.push(current);\n  return parts.join(CRLF);\n}\n\nconst utcStamp = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\\.\\d{3}/, '');\nconst localStamp = (d: Date, tz: string) => formatInTimeZone(d, tz, \"yyyyMMdd'T'HHmmss\");\nconst dateValue = (dateStr: string) => dateStr.replace(/-/g, '');\n\nfunction formatOffset(ms: number): string {\n  const sign = ms < 0 ? '-' : '+';\n  const minutes = Math.abs(ms) / 60_000;\n  return `${sign}${String(Math.floor(minutes / 60)).padStart(2, '0')}${String(minutes % 60).padStart(2, '0')}`;\n}\n\n/** VTIMEZONE with every offset transition from a year before `from` to `to`. */\nexport function vtimezone(tz: string, from: Date, to: Date): string[] {\n  const offset = (t: number) => getTimezoneOffset(tz, new Date(t));\n  const transitions: { at: number; before: number; after: number }[] = [];\n  const end = to.getTime();\n  let prev = from.getTime() - 366 * DAY_MS;\n  let prevOffset = offset(prev);\n  for (let t = prev + DAY_MS; t <= end + DAY_MS; t += DAY_MS) {\n    const o = offset(t);\n    if (o !== prevOffset) {\n      let lo = prev;\n      let hi = t; // offset(lo) = prevOffset, offset(hi) = o\n      while (hi - lo > 60_000) {\n        const mid = lo + Math.floor((hi - lo) / 2);\n        if (offset(mid) === prevOffset) lo = mid;\n        else hi = mid;\n      }\n      transitions.push({ at: hi, before: prevOffset, after: o });\n    }\n    prev = t;\n    prevOffset = o;\n  }\n\n  const lines = ['BEGIN:VTIMEZONE', `TZID:${tz}`];\n  if (transitions.length === 0) {\n    const o = formatOffset(offset(from.getTime()));\n    lines.push('BEGIN:STANDARD', 'DTSTART:19700101T000000', `TZOFFSETFROM:${o}`, `TZOFFSETTO:${o}`, 'END:STANDARD');\n  }\n  for (const tr of transitions) {\n    const kind = tr.after > tr.before ? 'DAYLIGHT' : 'STANDARD';\n    // DTSTART is the local time of the transition, in the offset in force before it.\n    const local = new Date(Math.round((tr.at + tr.before) / 60_000) * 60_000).toISOString();\n    lines.push(\n      `BEGIN:${kind}`,\n      `DTSTART:${local.slice(0, 19).replace(/[-:]/g, '')}`,\n      `TZOFFSETFROM:${formatOffset(tr.before)}`,\n      `TZOFFSETTO:${formatOffset(tr.after)}`,\n      `END:${kind}`,\n    );\n  }\n  lines.push('END:VTIMEZONE');\n  return lines;\n}\n\nexport function vevent(item: IcalItem, tz: string, now: Date = new Date()): string[] {\n  const lines = ['BEGIN:VEVENT', `UID:${item.uid}@schoolhub`, `DTSTAMP:${utcStamp(now)}`];\n\n  if (item.allDay) {\n    lines.push(`DTSTART;VALUE=DATE:${dateValue(schoolDateOf(item.start, tz))}`);\n    lines.push(`DTEND;VALUE=DATE:${dateValue(schoolDateOf(item.end, tz))}`);\n  } else if (item.recurrence) {\n    lines.push(`DTSTART;TZID=${tz}:${localStamp(item.start, tz)}`);\n    lines.push(`DTEND;TZID=${tz}:${localStamp(item.end, tz)}`);\n  } else {\n    lines.push(`DTSTART:${utcStamp(item.start)}`);\n    lines.push(`DTEND:${utcStamp(item.end)}`);\n  }\n\n  if (item.recurrence) {\n    // UNTIL is inclusive of the whole until-day. DATE-valued for all-day series (RFC 5545 §3.3.10).\n    const until = item.allDay\n      ? dateValue(item.recurrence.until)\n      : utcStamp(new Date(schoolMidnight(addDateDays(item.recurrence.until, 1), tz).getTime() - 1000));\n    const byMonthDay = item.recurrence.freq === 'MONTHLY' ? `;BYMONTHDAY=${Number(formatInTimeZone(item.start, tz, 'd'))}` : '';\n    lines.push(`RRULE:FREQ=${item.recurrence.freq};UNTIL=${until}${byMonthDay}`);\n  }\n\n  lines.push(`SUMMARY:${escapeText(item.title)}`);\n  if (item.description) lines.push(`DESCRIPTION:${escapeText(item.description)}`);\n  if (item.location) lines.push(`LOCATION:${escapeText(item.location)}`);\n  if (item.category) lines.push(`CATEGORIES:${escapeText(item.category)}`);\n  if (item.url) lines.push(`URL:${item.url}`);\n  lines.push('END:VEVENT');\n  return lines;\n}\n\nexport function buildCalendar(\n  items: IcalItem[],\n  tz: string,\n  window: { from: Date; to: Date },\n  opts: { name?: string; now?: Date } = {},\n): string {\n  const lines = [\n    'BEGIN:VCALENDAR',\n    'VERSION:2.0',\n    'PRODID:-//SchoolHub//Calendar//EN',\n    'CALSCALE:GREGORIAN',\n    'METHOD:PUBLISH',\n    `X-WR-CALNAME:${escapeText(opts.name ?? 'SchoolHub')}`,\n    `X-WR-TIMEZONE:${tz}`,\n    ...vtimezone(tz, window.from, window.to),\n    ...items.flatMap((item) => vevent(item, tz, opts.now)),\n    'END:VCALENDAR',\n  ];\n  return lines.map(foldLine).join(CRLF) + CRLF;\n}\nimport { formatInTimeZone, fromZonedTime } from 'date-fns-tz';\n\n/**\n * PRD-14 FR-15 / ADR-3: read-time expansion of a recurring event. Pure.\n * Steps in school-tz wall-clock time, so a 15:30 club stays at 15:30 across a\n * DST change. WEEKLY = +7 days; MONTHLY = same day of month, months without that\n * day are skipped. recurrenceUntil is inclusive (the whole school-tz day).\n */\n\nexport interface RecurringEvent {\n  id: string;\n  startAt: Date;\n  endAt: Date;\n  recurrence: 'NONE' | 'WEEKLY' | 'MONTHLY';\n  /** Prisma @db.Date (UTC midnight of the date) or 'yyyy-MM-dd'. */\n  recurrenceUntil: Date | string | null;\n}\n\nexport interface Occurrence {\n  /** `${eventId}:${startISO}` */\n  id: string;\n  eventId: string;\n  start: Date;\n  end: Date;\n}\n\nconst DAY_MS = 86_400_000;\nconst MAX_STEPS = 400; // ≤ 1 year of weekly/monthly, with headroom\n\n/** Wall-clock time in tz as a \"naive\" epoch (the local fields read as if UTC). */\nfunction naive(d: Date, tz: string): number {\n  return Date.parse(`${formatInTimeZone(d, tz, \"yyyy-MM-dd'T'HH:mm:ss.SSS\")}Z`);\n}\n\nfunction fromNaive(ms: number, tz: string): Date {\n  return fromZonedTime(new Date(ms).toISOString().slice(0, 23), tz);\n}\n\nfunction untilDate(u: Date | string): string {\n  return typeof u === 'string' ? u.slice(0, 10) : u.toISOString().slice(0, 10);\n}\n\nfunction overlaps(start: Date, end: Date, from: Date, to: Date): boolean {\n  if (start >= to) return false;\n  return end > from || (end.getTime() === start.getTime() && start >= from);\n}\n\nexport function expandOccurrences(event: RecurringEvent, from: Date, to: Date, tz: string): Occurrence[] {\n  const make = (start: Date, end: Date): Occurrence => ({\n    id: `${event.id}:${start.toISOString()}`,\n    eventId: event.id,\n    start,\n    end,\n  });\n\n  if (event.recurrence === 'NONE' || !event.recurrenceUntil) {\n    return overlaps(event.startAt, event.endAt, from, to) ? [make(event.startAt, event.endAt)] : [];\n  }\n\n  const start0 = naive(event.startAt, tz);\n  const duration = naive(event.endAt, tz) - start0;\n  const until = untilDate(event.recurrenceUntil);\n  const base = new Date(start0);\n  const out: Occurrence[] = [];\n\n  for (let k = 0; k < MAX_STEPS; k++) {\n    let localStart: number;\n    if (event.recurrence === 'WEEKLY') {\n      localStart = start0 + k * 7 * DAY_MS;\n    } else {\n      const y = base.getUTCFullYear();\n      const m = base.getUTCMonth() + k;\n      const day = base.getUTCDate();\n      const daysInMonth = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();\n      if (day > daysInMonth) continue; // e.g. the 31st in a 30-day month\n      localStart = Date.UTC(y, m, day) + (start0 % DAY_MS);\n    }\n    if (new Date(localStart).toISOString().slice(0, 10) > until) break;\n    const start = fromNaive(localStart, tz);\n    if (start >= to) break;\n    const end = fromNaive(localStart + duration, tz);\n    if (overlaps(start, end, from, to)) out.push(make(start, end));\n  }\n  return out;\n}\nimport { describe, expect, it } from 'vitest';\nimport ical, { type VEvent } from 'node-ical';\nimport { buildCalendar, escapeText, foldLine, vevent } from '@/server/calendar/ical';\n\nconst tz = 'America/New_York';\nconst now = new Date('2026-11-10T12:00:00Z');\nconst window = { from: new Date('2026-10-01T00:00:00Z'), to: new Date('2027-10-01T00:00:00Z') };\n\ndescribe('escapeText / foldLine', () => {\n  it('escapes , ; \\\\ and newlines', () => {\n    expect(escapeText('a,b;c\\\\d\\ne')).toBe('a\\\\,b\\;c\\\\\\\\d\\\\ne');\n  });\n\n  it('folds at 75 octets with CRLF + space, never splitting multibyte chars', () => {\n    const folded = foldLine(`SUMMARY:${'é'.repeat(80)}`);\n    const lines = folded.split('\\r\\n');\n    expect(lines.length).toBeGreaterThan(1);\n    for (const l of lines) expect(Buffer.byteLength(l, 'utf8')).toBeLessThanOrEqual(75);\n    expect(lines.slice(1).every((l) => l.startsWith(' '))).toBe(true);\n    expect(lines.map((l, i) => (i ? l.slice(1) : l)).join('')).toBe(`SUMMARY:${'é'.repeat(80)}`);\n  });\n});\n\ndescribe('vevent', () => {\n  it('all-day uses VALUE=DATE with an exclusive end, across DST', () => {\n    const lines = vevent(\n      { uid: 'h', title: 'Break', start: new Date('2026-10-31T04:00:00Z'), end: new Date('2026-11-02T05:00:00Z'), allDay: true },\n      tz,\n      now,\n    );\n    expect(lines).toContain('DTSTART;VALUE=DATE:20261031');\n    expect(lines).toContain('DTEND;VALUE=DATE:20261102');\n  });\n\n  it('one-off timed uses UTC Z; series uses TZID + RRULE with UTC UNTIL', () => {\n    const oneOff = vevent({ uid: 'o', title: 'x', start: new Date('2026-11-12T23:00:00Z'), end: new Date('2026-11-13T00:00:00Z'), allDay: false }, tz, now);\n    expect(oneOff).toContain('DTSTART:20261112T230000Z');\n    const series = vevent(\n      {\n        uid: 's',\n        title: 'Chess',\n        start: new Date('2026-09-01T19:30:00Z'),\n        end: new Date('2026-09-01T20:30:00Z'),\n        allDay: false,\n        recurrence: { freq: 'WEEKLY', until: '2026-12-15' },\n      },\n      tz,\n      now,\n    );\n    expect(series).toContain(`DTSTART;TZID=${tz}:20260901T153000`);\n    expect(series).toContain('RRULE:FREQ=WEEKLY;UNTIL=20261216T045959Z');\n  });\n});\n\ndescribe('buildCalendar parsed by node-ical (NFR-6)', () => {\n  const body = buildCalendar(\n    [\n      { uid: 'e1', title: 'Fair, science; fun', description: 'Line 1\\nLine 2', location: 'Hall, A', start: new Date('2026-11-20T14:00:00Z'), end: new Date('2026-11-20T17:00:00Z'), allDay: false },\n      { uid: 'e2', title: 'Thanksgiving break', start: new Date('2026-11-26T05:00:00Z'), end: new Date('2026-11-28T05:00:00Z'), allDay: true },\n      {\n        uid: 'e3',\n        title: 'Chess club',\n        start: new Date('2026-10-27T19:30:00Z'),\n        end: new Date('2026-10-27T20:30:00Z'),\n        allDay: false,\n        recurrence: { freq: 'WEEKLY', until: '2026-11-17' },\n      },\n      { uid: 'a1', title: 'Essay due', start: new Date('2026-11-15T04:59:00Z'), end: new Date('2026-11-15T04:59:00Z'), allDay: false, url: 'http://localhost:3000/courses/c/assignments/a' },\n      { uid: 'm1', title: 'Monthly', start: new Date('2027-01-31T15:00:00Z'), end: new Date('2027-01-31T16:00:00Z'), allDay: false, recurrence: { freq: 'MONTHLY', until: '2027-05-31' } },\n    ],\n    tz,\n    window,\n    { now },\n  );\n  const parsed = ical.sync.parseICS(body);\n  const ev = (uid: string) => Object.values(parsed).find((c) => c?.type === 'VEVENT' && (c as { uid?: string }).uid === `${uid}@schoolhub`) as VEvent;\n\n  it('is CRLF-terminated with folded lines', () => {\n    expect(body.endsWith('\\r\\n')).toBe(true);\n    expect(body.split('\\r\\n').every((l) => Buffer.byteLength(l, 'utf8') <= 75)).toBe(true);\n    expect(body).toContain('BEGIN:VTIMEZONE');\n  });\n\n  it('round-trips escaped text', () => {\n    expect(ev('e1').summary).toBe('Fair, science; fun');\n    expect(ev('e1').description).toBe('Line 1\\nLine 2');\n    expect(ev('e1').location).toBe('Hall, A');\n  });\n\n  it('all-day is a date with exclusive end', () => {\n    const e = ev('e2');\n    expect(e.start.dateOnly).toBe(true);\n    expect(e.datetype).toBe('date');\n  });\n\n  it('weekly RRULE keeps 15:30 local across DST', () => {\n    const dates = ev('e3').rrule!.all().map((d: Date) => d.toISOString());\n    expect(dates.length).toBe(4);\n    const startTimes = ical\n      .expandRecurringEvent(ev('e3'), { from: new Date('2026-10-01T00:00:00Z'), to: new Date('2026-12-01T00:00:00Z') })\n      .map((i) => i.start.toISOString());\n    expect(startTimes).toEqual(['2026-10-27T19:30:00.000Z', '2026-11-03T20:30:00.000Z', '2026-11-10T20:30:00.000Z', '2026-11-17T20:30:00.000Z']);\n  });\n\n  it('monthly RRULE with BYMONTHDAY skips short months', () => {\n    expect(body).toContain('BYMONTHDAY=31');\n    expect(ev('m1').rrule!.all().length).toBe(3); // Jan, Mar, May\n  });\n\n  it('deadline is zero-duration with a URL', () => {\n    const e = ev('a1');\n    expect(e.end!.getTime()).toBe(e.start.getTime());\n    expect(e.url).toBe('http://localhost:3000/courses/c/assignments/a');\n  });\n});\nimport { describe, expect, it } from 'vitest';\nimport { expandOccurrences } from '@/server/calendar/recurrence';\n\nconst tz = 'America/New_York';\nconst D = (s: string) => new Date(s);\n\ndescribe('expandOccurrences', () => {\n  it('NONE returns the event when it overlaps the range', () => {\n    const e = { id: 'e', startAt: D('2026-11-10T15:00:00Z'), endAt: D('2026-11-10T16:00:00Z'), recurrence: 'NONE' as const, recurrenceUntil: null };\n    expect(expandOccurrences(e, D('2026-11-01T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz)).toHaveLength(1);\n    expect(expandOccurrences(e, D('2026-11-11T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz)).toHaveLength(0);\n  });\n\n  it('WEEKLY steps 7 days and ids are eventId:startISO', () => {\n    const e = { id: 'chess', startAt: D('2026-09-01T19:30:00Z'), endAt: D('2026-09-01T20:30:00Z'), recurrence: 'WEEKLY' as const, recurrenceUntil: '2026-09-29' };\n    const occ = expandOccurrences(e, D('2026-09-01T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz);\n    expect(occ.map((o) => o.start.toISOString())).toEqual([\n      '2026-09-01T19:30:00.000Z',\n      '2026-09-08T19:30:00.000Z',\n      '2026-09-15T19:30:00.000Z',\n      '2026-09-22T19:30:00.000Z',\n      '2026-09-29T19:30:00.000Z', // until is inclusive\n    ]);\n    expect(occ[1].id).toBe('chess:2026-09-08T19:30:00.000Z');\n    expect(occ[1].eventId).toBe('chess');\n  });\n\n  it('keeps wall-clock time across the DST change (2026-11-01)', () => {\n    // Tuesdays 15:30 New York: EDT (-4) then EST (-5)\n    const e = { id: 'c', startAt: D('2026-10-27T19:30:00Z'), endAt: D('2026-10-27T20:30:00Z'), recurrence: 'WEEKLY' as const, recurrenceUntil: '2026-11-10' };\n    const occ = expandOccurrences(e, D('2026-10-01T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz);\n    expect(occ.map((o) => o.start.toISOString())).toEqual(['2026-10-27T19:30:00.000Z', '2026-11-03T20:30:00.000Z', '2026-11-10T20:30:00.000Z']);\n    expect(occ.every((o) => o.end.getTime() - o.start.getTime() === 3_600_000)).toBe(true);\n  });\n\n  it('MONTHLY on the 31st skips short months', () => {\n    const e = { id: 'm', startAt: D('2027-01-31T14:00:00Z'), endAt: D('2027-01-31T15:00:00Z'), recurrence: 'MONTHLY' as const, recurrenceUntil: '2027-07-31' };\n    const occ = expandOccurrences(e, D('2027-01-01T00:00:00Z'), D('2027-12-01T00:00:00Z'), tz);\n    expect(occ.map((o) => o.start.toISOString().slice(0, 10))).toEqual(['2027-01-31', '2027-03-31', '2027-05-31', '2027-07-31']);\n  });\n\n  it('respects the range and the until bound', () => {\n    const e = { id: 'w', startAt: D('2026-09-01T19:30:00Z'), endAt: D('2026-09-01T20:30:00Z'), recurrence: 'WEEKLY' as const, recurrenceUntil: D('2026-12-15T00:00:00Z') };\n    const occ = expandOccurrences(e, D('2026-12-01T00:00:00Z'), D('2027-01-31T00:00:00Z'), tz);\n    expect(occ.map((o) => o.start.toISOString().slice(0, 10))).toEqual(['2026-12-01', '2026-12-08', '2026-12-15']);\n  });\n\n  it('all-day weekly across DST keeps school-midnight bounds', () => {\n    const e = { id: 'a', startAt: D('2026-10-25T04:00:00Z'), endAt: D('2026-10-26T04:00:00Z'), recurrence: 'WEEKLY' as const, recurrenceUntil: '2026-11-01' };\n    const occ = expandOccurrences(e, D('2026-10-01T00:00:00Z'), D('2026-12-01T00:00:00Z'), tz);\n    expect(occ[1].start.toISOString()).toBe('2026-11-01T04:00:00.000Z'); // 00:00 EDT on Nov 1\n    expect(occ[1].end.toISOString()).toBe('2026-11-02T05:00:00.000Z'); // 00:00 EST on Nov 2\n  });\n});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Njt5EuCJywH4uAo7tUrTog","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
