string | null;\n  country?: string | null;\n  phone?: string | null;\n  email?: string | null;\n  website?: string | null;\n  /** PRD-07 FR-4/FR-5 */\n  attendanceMode?: AttendanceMode;\n  attendanceAlertThreshold?: number;\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {\n  return prisma.schoolSettings.update({ where: { id: 'singleton' }, data: input });\n}\n=== src/config/student-tabs.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/** Extension point for the student detail page; later PRDs register their tab here. */\nexport const studentTabs: StudentTab[] = [\n  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\n];\n=== src/config/course-tabs.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\n61:  'attendance.absent': {\n62-    label: 'Marked absent',\n63-    description: 'A student was marked absent from a class or the daily register.',\n64-    category: 'ATTENDANCE',\n65-    defaultEmail: true,\n66-    mandatoryInApp: true,\n67-    roles: ['PARENT', 'STUDENT'],\n68-  },\n69:  'attendance.late': {\n70-    label: 'Marked late',\n71-    description: 'A student was marked late.',\n72-    category: 'ATTENDANCE',\n73-    defaultEmail: false,\n74-    mandatoryInApp: false,\n75-    roles: ['PARENT', 'STUDENT'],\n76-  },\n77:  'attendance.corrected': {\n78-    label: 'Attendance corrected',\n79-    description: 'An absence was corrected to present.',\n80-    category: 'ATTENDANCE',\n81-    defaultEmail: false,\n82-    mandatoryInApp: false,\n83-    roles: ['PARENT', 'STUDENT'],\n84-  },\n85:  'attendance.register_missing': {\n86-    label: 'Register not taken',\n87-    description: 'An administrator reminded you to take a register.',\n88-    category: 'ATTENDANCE',\n89-    defaultEmail: false,\n90-    mandatoryInApp: false,\n91-    roles: ['TEACHER'],\n92-  },\n93-} as const satisfies Record<string, NotificationTypeDef>;\n94-\n95-export type NotificationType = keyof typeof NOTIFICATION_TYPES;\n96-\n97-const entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n34:  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n35:  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VrVSqEBy5sKiA5g3LefrK8","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
