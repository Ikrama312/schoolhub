{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R4pHVTduaD1Z6neRAoAZvz","type":"tool_result","content":"1\t// @vitest-environment node\n2\timport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n3\t\n4\tvi.hoisted(() => {\n5\t  if (process.env.TEST_DATABASE_URL) process.env.DATABASE_URL = process.env.TEST_DATABASE_URL;\n6\t  process.env.DATABASE_URL ??= 'postgresql://unused@localhost/unused';\n7\t  process.env.APP_URL ??= 'http://localhost:3000';\n8\t  process.env.AUTH_SECRET ??= 'test-secret';\n9\t});\n10\t\n11\timport { prisma } from '@/server/db';\n12\timport { AppError } from '@/server/http';\n13\timport { gradeAnswerManually, saveAnswer, startOrResumeAttempt, submitForStudent } from '@/server/quiz/attempt-service';\n14\timport { addQuestion, deleteQuestion, deleteQuiz, regradeQuiz, releaseResults, updateQuestion, updateQuiz } from '@/server/quiz/quiz-service';\n15\t\n16\t/**\n17\t * PRD-10 edit lock, regrade, manual grading and release (FR-10, FR-24, FR-25, FR-20) on real Postgres.\n18\t * Skipped without TEST_DATABASE_URL.\n19\t */\n20\tconst MARK = 'qa-sh10-rgd';\n21\tconst MIN = 60_000;\n22\tconst ids = {} as Record<'year' | 'subject' | 'course' | 'teacher' | 's1' | 's2' | 'parent', string>;\n23\tconst teacher = () => ({ id: ids.teacher, role: 'TEACHER' as const });\n24\tconst student = (id: string) => ({ id, role: 'STUDENT' as const });\n25\t\n26\tasync function code(p: Promise<unknown>) {\n27\t  try {\n28\t    await p;\n29\t    return 'OK';\n30\t  } catch (e) {\n31\t    return e instanceof AppError ? e.code : (e as Error).message;\n32\t  }\n33\t}\n34\t\n35\tdescribe.skipIf(!process.env.TEST_DATABASE_URL)('quiz regrade and grading (integration)', () => {\n36\t  beforeAll(async () => {\n37\t    const mk = (n: string, role: 'TEACHER' | 'STUDENT' | 'PARENT') =>\n38\t      prisma.user.create({ data: { email: `${n}@${MARK}.test`, firstName: 'QA', lastName: n, role, status: 'ACTIVE' } }).then((u) => u.id);\n39\t    Object.assign(ids, { teacher: await mk('teacher', 'TEACHER'), s1: await mk('s1', 'STUDENT'), s2: await mk('s2', 'STUDENT'), parent: await mk('parent', 'PARENT') });\n40\t    await prisma.parentStudentLink.create({ data: { parentId: ids.parent, studentId: ids.s1, relationship: 'MOTHER' } });\n41\t    ids.year = (await prisma.academicYear.create({ data: { name: MARK, startDate: new Date('2026-01-01'), endDate: new Date('2027-12-31') } })).id;\n42\t    ids.subject = (await prisma.subject.create({ data: { name: MARK, code: MARK.toUpperCase() } })).id;\n43\t    ids.course = (await prisma.course.create({ data: { name: MARK, code: MARK, academicYearId: ids.year, subjectId: ids.subject, teacherId: ids.teacher } })).id;\n44\t    await prisma.enrollment.createMany({ data: [ids.s1, ids.s2].map((studentId) => ({ courseId: ids.course, studentId })) });\n45\t  });\n46\t\n47\t  afterAll(async () => {\n48\t    const users = [ids.teacher, ids.s1, ids.s2, ids.parent].filter(Boolean);\n49\t    await prisma.course.deleteMany({ where: { code: MARK } });\n50\t    await prisma.notification.deleteMany({ where: { userId: { in: users } } });\n51\t    await prisma.emailOutbox.deleteMany({ where: { toEmail: { endsWith: `@${MARK}.test` } } });\n52\t    await prisma.auditLog.deleteMany({ where: { actorId: { in: users } } });\n53\t    await prisma.user.deleteMany({ where: { id: { in: users } } });\n54\t    await prisma.subject.deleteMany({ where: { code: MARK.toUpperCase() } });\n55\t    await prisma.academicYear.deleteMany({ where: { name: MARK } });\n56\t  });\n57\t\n58\t  it('publish check, edit lock, regrade keeps manual grades, essay grading → GRADED, manual release', async () => {\n59\t    const now = Date.now();\n60\t    const quiz = await prisma.quiz.create({\n61\t      data: {\n62\t        courseId: ids.course,\n63\t        title: `${MARK} quiz`,\n64\t        availableFrom: new Date(now - 10 * MIN),\n65\t        availableUntil: new Date(now + 60 * MIN),\n66\t        resultsVisibility: 'MANUAL',\n67\t        createdById: ids.teacher,\n68\t      },\n69\t    });\n70\t    expect(await code(updateQuiz(teacher(), quiz.id, { status: 'PUBLISHED' }))).toBe('VALIDATION_ERROR');\n71\t\n72\t    const short = await addQuestion(teacher(), quiz.id, { type: 'SHORT_ANSWER', prompt: 'Animal?', points: '2.00', correct: { accepted: ['cat'] }, explanation: null, caseSensitive: false });\n73\t    const essay = await addQuestion(teacher(), quiz.id, { type: 'ESSAY', prompt: 'Explain', points: '5.00', correct: { guidance: 'secret' }, explanation: null, caseSensitive: false });\n74\t    const published = await updateQuiz(teacher(), quiz.id, { status: 'PUBLISHED' });\n75\t    expect(published).toMatchObject({ status: 'PUBLISHED', totalPoints: '7.00', locked: false });\n76\t    expect(await prisma.notification.count({ where: { userId: ids.s1, type: 'quiz.published' } })).toBe(1);\n77\t    expect(await code(updateQuiz(teacher(), quiz.id, { status: 'PUBLISHED' }))).toBe('CONFLICT');\n78\t\n79\t    const results: Record<string, string> = {};\n80\t    for (const s of [ids.s1, ids.s2]) {\n81\t      const { attempt } = await startOrResumeAttempt(student(s), quiz.id);\n82\t      await saveAnswer(student(s), attempt.id, short.id, { text: 'Dog' });\n83\t      await saveAnswer(student(s), attempt.id, essay.id, { text: 'Because.' });\n84\t      const r = await submitForStudent(student(s), attempt.id);\n85\t      expect(r).toMatchObject({ status: 'NEEDS_GRADING', resultsVisible: false, score: null, questions: null }); // AC-6, AC-7\n86\t      results[s] = attempt.id;\n87\t    }\n88\t\n89\t    // Edit lock (FR-10, AC-9)\n90\t    expect(await code(deleteQuestion(teacher(), short.id))).toBe('CONFLICT');\n91\t    expect(await code(updateQuestion(teacher(), short.id, { points: 3 }))).toBe('CONFLICT');\n92\t    expect(await code(updateQuestion(teacher(), essay.id, { correct: { guidance: 'x' } }))).toBe('CONFLICT');\n93\t    expect(await code(addQuestion(teacher(), quiz.id, { type: 'TRUE_FALSE', prompt: 'x', points: '1.00', correct: { value: true }, explanation: null, caseSensitive: false }))).toBe('CONFLICT');\n94\t    expect(await code(deleteQuiz(teacher(), quiz.id))).toBe('CONFLICT');\n95\t\n96\t    // s2's short answer is overridden by hand; then \"dog\" becomes accepted and we regrade.\n97\t    await gradeAnswerManually(teacher(), results[ids.s2], short.id, { pointsAwarded: '1.00', feedback: 'Half' });\n98\t    expect(await code(gradeAnswerManually(teacher(), results[ids.s2], short.id, { pointsAwarded: '2.50' }))).toBe('VALIDATION_ERROR');\n99\t    await updateQuestion(teacher(), short.id, { ...short, points: short.points, correct: { accepted: ['cat', 'dog'] } });\n100\t    const rg = await regradeQuiz(teacher(), quiz.id);\n101\t    expect(rg).toEqual({ attemptCount: 2, changedAnswerCount: 1 });\n102\t    const a1 = await prisma.quizAnswer.findUniqueOrThrow({ where: { attemptId_questionId: { attemptId: results[ids.s1], questionId: short.id } } });\n103\t    const a2 = await prisma.quizAnswer.findUniqueOrThrow({ where: { attemptId_questionId: { attemptId: results[ids.s2], questionId: short.id } } });\n104\t    expect([a1.pointsAwarded?.toFixed(2), a1.isCorrect]).toEqual(['2.00', true]);\n105\t    expect([a2.pointsAwarded?.toFixed(2), a2.feedback]).toEqual(['1.00', 'Half']);\n106\t\n107\t    // Essay grade → GRADED with the recomputed score (FR-25)\n108\t    const g = await gradeAnswerManually(teacher(), results[ids.s1], essay.id, { pointsAwarded: '4.50', feedback: 'Good' });\n109\t    expect(g.attempt).toMatchObject({ status: 'GRADED', score: '6.50', maxScore: '7.00' });\n110\t\n111\t    // MANUAL release: once, idempotent (FR-20, FR-30)\n112\t    const rel = await releaseResults(teacher(), quiz.id);\n113\t    expect(rel.notified).toBe(true);\n114\t    expect((await releaseResults(teacher(), quiz.id)).notified).toBe(false);\n115\t    expect(await prisma.notification.count({ where: { userId: { in: [ids.s1, ids.s2, ids.parent] }, type: 'quiz.results_released' } })).toBe(3);\n116\t  });\n117\t});\n118\t"}]},"parent_tool_use_id":null,"session_id":"1873d368-49d2-4130-ab97-f8c75b3c27a8","uuid":"3dc06f3a-f223-46ea-b85f-b20c610f4ff4","timestamp":"2026-11-09T07:54:02.130Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/tests/integration/quiz/regrade.test.ts","content":"// @vitest-environment node\nimport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n\nvi.hoisted(() => {\n  if (process.env.TEST_DATABASE_URL) process.env.DATABASE_URL = process.env.TEST_DATABASE_URL;\n  process.env.DATABASE_URL ??= 'postgresql://unused@localhost/unused';\n  process.env.APP_URL ??= 'http://localhost:3000';\n  process.env.AUTH_SECRET ??= 'test-secret';\n});\n\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { gradeAnswerManually, saveAnswer, startOrResumeAttempt, submitForStudent } from '@/server/quiz/attempt-service';\nimport { addQuestion, deleteQuestion, deleteQuiz, regradeQuiz, releaseResults, updateQuestion, updateQuiz } from '@/server/quiz/quiz-service';\n\n/**\n * PRD-10 edit lock, regrade, manual grading and release (FR-10, FR-24, FR-25, FR-20) on real Postgres.\n * Skipped without TEST_DATABASE_URL.\n */\nconst MARK = 'qa-sh10-rgd';\nconst MIN = 60_000;\nconst ids = {} as Record<'year' | 'subject' | 'course' | 'teacher' | 's1' | 's2' | 'parent', string>;\nconst teacher = () => ({ id: ids.teacher, role: 'TEACHER' as const });\nconst student = (id: string) => ({ id, role: 'STUDENT' as const });\n\nasync function code(p: Promise<unknown>) {\n  try {\n    await p;\n    return 'OK';\n  } catch (e) {\n    return e instanceof AppError ? e.code : (e as Error).message;\n  }\n}\n\ndescribe.skipIf(!process.env.TEST_DATABASE_URL)('quiz regrade and grading (integration)', () => {\n  beforeAll(async () => {\n    const mk = (n: string, role: 'TEACHER' | 'STUDENT' | 'PARENT') =>\n      prisma.user.create({ data: { email: `${n}@${MARK}.test`, firstName: 'QA', lastName: n, role, status: 'ACTIVE' } }).then((u) => u.id);\n    Object.assign(ids, { teacher: await mk('teacher', 'TEACHER'), s1: await mk('s1', 'STUDENT'), s2: await mk('s2', 'STUDENT'), parent: await mk('parent', 'PARENT') });\n    await prisma.parentStudentLink.create({ data: { parentId: ids.parent, studentId: ids.s1, relationship: 'MOTHER' } });\n    ids.year = (await prisma.academicYear.create({ data: { name: MARK, startDate: new Date('2026-01-01'), endDate: new Date('2027-12-31') } })).id;\n    ids.subject = (await prisma.subject.create({ data: { name: MARK, code: MARK.toUpperCase() } })).id;\n    ids.course = (await prisma.course.create({ data: { name: MARK, code: MARK, academicYearId: ids.year, subjectId: ids.subject, teacherId: ids.teacher } })).id;\n    await prisma.enrollment.createMany({ data: [ids.s1, ids.s2].map((studentId) => ({ courseId: ids.course, studentId })) });\n  });\n\n  afterAll(async () => {\n    const users = [ids.teacher, ids.s1, ids.s2, ids.parent].filter(Boolean);\n    await prisma.course.deleteMany({ where: { code: MARK } });\n    await prisma.notification.deleteMany({ where: { userId: { in: users } } });\n    await prisma.emailOutbox.deleteMany({ where: { toEmail: { endsWith: `@${MARK}.test` } } });\n    await prisma.auditLog.deleteMany({ where: { actorId: { in: users } } });\n    await prisma.user.deleteMany({ where: { id: { in: users } } });\n    await prisma.subject.deleteMany({ where: { code: MARK.toUpperCase() } });\n    await prisma.academicYear.deleteMany({ where: { name: MARK } });\n  });\n\n  it('publish check, edit lock, regrade keeps manual grades, essay grading → GRADED, manual release', async () => {\n    const now = Date.now();\n    const quiz = await prisma.quiz.create({\n      data: {\n        courseId: ids.course,\n        title: `${MARK} quiz`,\n        availableFrom: new Date(now - 10 * MIN),\n        availableUntil: new Date(now + 60 * MIN),\n        resultsVisibility: 'MANUAL',\n        createdById: ids.teacher,\n      },\n    });\n    expect(await code(updateQuiz(teacher(), quiz.id, { status: 'PUBLISHED' }))).toBe('VALIDATION_ERROR');\n\n    const short = await addQuestion(teacher(), quiz.id, { type: 'SHORT_ANSWER', prompt: 'Animal?', points: '2.00', correct: { accepted: ['cat'] }, explanation: null, caseSensitive: false });\n    const essay = await addQuestion(teacher(), quiz.id, { type: 'ESSAY', prompt: 'Explain', points: '5.00', correct: { guidance: 'secret' }, explanation: null, caseSensitive: false });\n    const published = await updateQuiz(teacher(), quiz.id, { status: 'PUBLISHED' });\n    expect(published).toMatchObject({ status: 'PUBLISHED', totalPoints: '7.00', locked: false });\n    expect(await prisma.notification.count({ where: { userId: ids.s1, type: 'quiz.published' } })).toBe(1);\n    expect(await code(updateQuiz(teacher(), quiz.id, { status: 'PUBLISHED' }))).toBe('CONFLICT');\n\n    const results: Record<string, string> = {};\n    for (const s of [ids.s1, ids.s2]) {\n      const { attempt } = await startOrResumeAttempt(student(s), quiz.id);\n      await saveAnswer(student(s), attempt.id, short.id, { text: 'Dog' });\n      await saveAnswer(student(s), attempt.id, essay.id, { text: 'Because.' });\n      const r = await submitForStudent(student(s), attempt.id);\n      expect(r).toMatchObject({ status: 'NEEDS_GRADING', resultsVisible: false, score: null, questions: null }); // AC-6, AC-7\n      results[s] = attempt.id;\n    }\n\n    // Edit lock (FR-10, AC-9)\n    expect(await code(deleteQuestion(teacher(), short.id))).toBe('CONFLICT');\n    expect(await code(updateQuestion(teacher(), short.id, { points: 3 }))).toBe('CONFLICT');\n    expect(await code(updateQuestion(teacher(), essay.id, { correct: { guidance: 'x' } }))).toBe('CONFLICT');\n    expect(await code(addQuestion(teacher(), quiz.id, { type: 'TRUE_FALSE', prompt: 'x', points: '1.00', correct: { value: true }, explanation: null, caseSensitive: false }))).toBe('CONFLICT');\n    expect(await code(deleteQuiz(teacher(), quiz.id))).toBe('CONFLICT');\n\n    // s2's short answer is overridden by hand; then \"dog\" becomes accepted and we regrade.\n    await gradeAnswerManually(teacher(), results[ids.s2], short.id, { pointsAwarded: '1.00', feedback: 'Half' });\n    expect(await code(gradeAnswerManually(teacher(), results[ids.s2], short.id, { pointsAwarded: '2.50' }))).toBe('VALIDATION_ERROR');\n    await updateQuestion(teacher(), short.id, { ...short, points: short.points, correct: { accepted: ['cat', 'dog'] } });\n    const rg = await regradeQuiz(teacher(), quiz.id);\n    expect(rg).toEqual({ attemptCount: 2, changedAnswerCount: 1 });\n    const a1 = await prisma.quizAnswer.findUniqueOrThrow({ where: { attemptId_questionId: { attemptId: results[ids.s1], questionId: short.id } } });\n    const a2 = await prisma.quizAnswer.findUniqueOrThrow({ where: { attemptId_questionId: { attemptId: results[ids.s2], questionId: short.id } } });\n    expect([a1.pointsAwarded?.toFixed(2), a1.isCorrect]).toEqual(['2.00', true]);\n    expect([a2.pointsAwarded?.toFixed(2), a2.feedback]).toEqual(['1.00', 'Half']);\n\n    // Essay grade → GRADED with the recomputed score (FR-25)\n    const g = await gradeAnswerManually(teacher(), results[ids.s1], essay.id, { pointsAwarded: '4.50', feedback: 'Good' });\n    expect(g.attempt).toMatchObject({ status: 'GRADED', score: '6.50', maxScore: '7.00' });\n\n    // MANUAL release: once, idempotent (FR-20, FR-30)\n    const rel = await releaseResults(teacher(), quiz.id);\n    expect(rel.notified).toBe(true);\n    expect((await releaseResults(teacher(), quiz.id)).notified).toBe(false);\n    expect(await prisma.notification.count({ where: { userId: { in: [ids.s1, ids.s2, ids.parent] }, type: 'quiz.results_released' } })).toBe(3);\n  });\n});\n","numLines":118,"startLine":1,"totalLines":118}},"tool_result_meta":[{"id":"toolu_01R4pHVTduaD1Z6neRAoAZvz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
