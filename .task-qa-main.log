mId], references: [id])\n  capacity          Int             @default(30)\n  createdAt         DateTime        @default(now())\n  updatedAt         DateTime        @updatedAt\n  members           SectionMember[]\n  courses           Course[]\n\n  @@unique([academicYearId, name])\n}\nmodel Course {\n  id             String          @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])\n  subjectId      String\n  subject        Subject         @relation(fields: [subjectId], references: [id])\n  sectionId      String?\n  section        Section?        @relation(fields: [sectionId], references: [id])\n  teacherId      String\n  teacher        User            @relation(\"CourseTeacher\", fields: [teacherId], references: [id])\n  coTeacherIds   String[]        @default([])\n  name           String\n  code           String\n  kind           CourseKind      @default(CORE)\n  description    String?\n  capacity       Int?\n  archivedAt     DateTime?\n  createdAt      DateTime        @default(now())\n  updatedAt      DateTime        @updatedAt\n  enrollments    Enrollment[]\n  timetableSlots TimetableSlot[]\n\n  @@unique([academicYearId, code])\n}\nmodel Enrollment {\n  id         String           @id @default(cuid())\n  courseId   String\n  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  studentId  String\n  student    User             @relation(fields: [studentId], references: [id])\n  status     EnrollmentStatus @default(ACTIVE)\n  enrolledAt DateTime         @default(now())\n  droppedAt  DateTime?\n\n  @@unique([courseId, studentId])\n  @@index([studentId, status])\n}\nimport type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { getClientIp } from '@/server/http';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n  request?: Request;\n}\n\n// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\nconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    const metadata = input.metadata\n      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n      : undefined;\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: metadata as Prisma.InputJsonValue | undefined,\n        ip: input.request ? getClientIp(input.request) : null,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n34:export class AppError extends Error {\n35-  code: ApiErrorCode;\n36-  details?: unknown;\n37-\n38-  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n39-    super(message);\n40-    this.code = code;\n41-    this.details = details;\n42-  }\n43-}\n44-\n45-export function ok<T>(data: T, init?: ResponseInit) {\n46-  return NextResponse.json({ data }, init);\n47-}\n48-\n49-export function paginated<T>(\nimport { PrismaClient } from '@prisma/client';\n\n/**\n * Prisma client singleton cached on globalThis. Next.js dev hot-reload\n * re-evaluates this module on every edit; without the cache that creates a\n * new PrismaClient (and a new Postgres connection pool) each time until the\n * db runs out of connections. Standard Next.js + Prisma pattern.\n */\nconst globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };\n\nexport const prisma = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') {\n  globalForPrisma.prisma = prisma;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NcqRQgbytrSZDtoCUsMwKR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
