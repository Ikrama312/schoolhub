{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014rXQNGjhaiiVgN3TDVcvj1","type":"tool_result","content":"1\timport { Prisma } from '@prisma/client';\n2\timport { prisma } from '@/server/db';\n3\timport { AppError } from '@/server/http';\n4\timport { audit } from '@/server/audit';\n5\timport { logger } from '@/lib/logger';\n6\timport { ISO_DAY_NAMES, schoolNow } from '@/lib/dates';\n7\timport type { Role } from '@/config/navigation';\n8\timport type {\n9\t  PeriodInput,\n10\t  PeriodUpdateInput,\n11\t  SchoolDaysInput,\n12\t  SlotCreateInput,\n13\t  SlotUpdateInput,\n14\t  TimetableViewKind,\n15\t} from '@/lib/validators/timetable';\n16\timport { clashesForCell, periodsOverlap, type CandidateCourse, type Clash, type OtherSlot } from './clash-rules';\n17\t\n18\t/**\n19\t * PRD-06 timetable service: the only writer of Period / SchoolDay /\n20\t * TimetableSlot. Route handlers stay thin (NFR-8). audit() runs after the\n21\t * transaction commits, so a rolled-back write is never audited (D7).\n22\t *\n23\t * Note: this file deliberately does not import services/settings.ts or\n24\t * services/academicYears.ts -- their react.cache() wrappers are undefined\n25\t * outside Next (vitest/tsx), and the concurrency test imports this module.\n26\t */\n27\t\n28\ttype Tx = Prisma.TransactionClient;\n29\texport interface AuditCtx {\n30\t  actorId?: string | null;\n31\t  request?: Request;\n32\t}\n33\t\n34\t// ---------------------------------------------------------------------------\n35\t// Bell schedule: periods (FR-5, FR-6, FR-8, FR-33)\n36\t// ---------------------------------------------------------------------------\n37\t\n38\texport function listPeriods(db: Tx = prisma) {\n39\t  return db.period.findMany({ orderBy: { order: 'asc' } });\n40\t}\n41\t\n42\tasync function assertNoOverlap(candidate: { startTime: string; endTime: string }, excludeId?: string) {\n43\t  const others = await prisma.period.findMany({ where: excludeId ? { id: { not: excludeId } } : {} });\n44\t  const hit = others.find((o) => periodsOverlap(candidate, o));\n45\t  if (hit) {\n46\t    throw new AppError('VALIDATION_ERROR', `Overlaps '${hit.name}' (${hit.startTime}–${hit.endTime}).`);\n47\t  }\n48\t}\n49\t\n50\texport async function createPeriod(input: PeriodInput, ctx: AuditCtx = {}) {\n51\t  await assertNoOverlap(input);\n52\t  const max = await prisma.period.aggregate({ _max: { order: true } });\n53\t  const period = await prisma.period.create({ data: { ...input, order: (max._max.order ?? 0) + 1 } });\n54\t  await audit({ ...ctx, action: 'period.create', entityType: 'Period', entityId: period.id, metadata: { ...input } });\n55\t  return period;\n56\t}\n57\t\n58\texport async function updatePeriod(id: string, patch: PeriodUpdateInput, ctx: AuditCtx = {}) {\n59\t  const existing = await prisma.period.findUnique({ where: { id } });\n60\t  if (!existing) throw new AppError('NOT_FOUND', 'Period not found');\n61\t  const merged = { ...existing, ...stripUndefined(patch) };\n62\t  if (merged.endTime <= merged.startTime) {\n63\t    throw new AppError('VALIDATION_ERROR', 'End time must be after start time');\n64\t  }\n65\t  await assertNoOverlap(merged, id);\n66\t  const period = await prisma.period.update({ where: { id }, data: stripUndefined(patch) });\n67\t  await audit({ ...ctx, action: 'period.update', entityType: 'Period', entityId: id, metadata: { ...patch } });\n68\t  return period;\n69\t}\n70\t\n71\texport async function deletePeriod(id: string, ctx: AuditCtx = {}) {\n72\t  const existing = await prisma.period.findUnique({ where: { id }, select: { id: true, name: true } });\n73\t  if (!existing) throw new AppError('NOT_FOUND', 'Period not found');\n74\t  const slotCount = await prisma.timetableSlot.count({ where: { periodId: id } });\n75\t  if (slotCount > 0) {\n76\t    throw new AppError('CONFLICT', `Period has ${slotCount} timetable slots. Remove them first.`, { slotCount });\n77\t  }\n78\t  await prisma.period.delete({ where: { id } });\n79\t  await audit({ ...ctx, action: 'period.delete', entityType: 'Period', entityId: id, metadata: { name: existing.name } });\n80\t  return { id };\n81\t}\n82\t\n83\t/** Index 0 → order 1. Two-phase write so the @unique order never collides mid-update. */\n84\texport async function reorderPeriods(periodIds: string[], ctx: AuditCtx = {}) {\n85\t  const periods = await prisma.$transaction(async (tx) => {\n86\t    const existing = await tx.period.findMany({ select: { id: true } });\n87\t    const known = new Set(existing.map((p) => p.id));\n88\t    if (known.size !== periodIds.length || !periodIds.every((id) => known.has(id))) {\n89\t      throw new AppError('VALIDATION_ERROR', 'periodIds must list every period exactly once');\n90\t    }\n91\t    for (const [i, id] of periodIds.entries()) await tx.period.update({ where: { id }, data: { order: -(i + 1) } });\n92\t    for (const [i, id] of periodIds.entries()) await tx.period.update({ where: { id }, data: { order: i + 1 } });\n93\t    return listPeriods(tx);\n94\t  });\n95\t  await audit({ ...ctx, action: 'period.reorder', entityType: 'Period', metadata: { periodIds } });\n96\t  return periods;\n97\t}\n98\t\n99\t// ---------------------------------------------------------------------------\n100\t// Teaching days (FR-7, FR-34)\n101\t// ---------------------------------------------------------------------------\n102\t\n103\t/** Always 7 rows Mon→Sun; a missing row (unseeded DB) defaults to Mon–Fri teaching. */\n104\tasync function loadDays(db: Tx = prisma) {\n105\t  const rows = await db.schoolDay.findMany();\n106\t  return [1, 2, 3, 4, 5, 6, 7].map(\n107\t    (dayOfWeek) => rows.find((r) => r.dayOfWeek === dayOfWeek) ?? { dayOfWeek, isTeaching: dayOfWeek <= 5 },\n108\t  );\n109\t}\n110\t\n111\t/** slotCount covers all academic years -- the same set updateSchoolDays deletes (D3). */\n112\texport async function listSchoolDays(db: Tx = prisma) {\n113\t  const [days, counts] = await Promise.all([\n114\t    loadDays(db),\n115\t    db.timetableSlot.groupBy({ by: ['dayOfWeek'], _count: { _all: true } }),\n116\t  ]);\n117\t  return days.map((d) => ({ ...d, slotCount: counts.find((c) => c.dayOfWeek === d.dayOfWeek)?._count._all ?? 0 }));\n118\t}\n119\t\n120\texport async function updateSchoolDays(input: SchoolDaysInput['days'], ctx: AuditCtx = {}) {\n121\t  const result = await prisma.$transaction(async (tx) => {\n122\t    const current = await loadDays(tx);\n123\t    const changed = input.filter((d) => current.find((c) => c.dayOfWeek === d.dayOfWeek)?.isTeaching !== d.isTeaching);\n124\t    const off = changed.filter((d) => !d.isTeaching).map((d) => d.dayOfWeek);\n125\t    const { count: deletedSlotCount } = off.length\n126\t      ? await tx.timetableSlot.deleteMany({ where: { dayOfWeek: { in: off } } })\n127\t      : { count: 0 };\n128\t    for (const d of input) {\n129\t      await tx.schoolDay.upsert({ where: { dayOfWeek: d.dayOfWeek }, update: { isTeaching: d.isTeaching }, create: d });\n130\t    }\n131\t    return { days: await listSchoolDays(tx), changed, deletedSlotCount };\n132\t  });\n133\t  await audit({\n134\t    ...ctx,\n135\t    action: 'schoolDay.update',\n136\t    entityType: 'SchoolDay',\n137\t    metadata: { changed: result.changed, deletedSlotCount: result.deletedSlotCount },\n138\t  });\n139\t  return { days: result.days, deletedSlotCount: result.deletedSlotCount };\n140\t}\n141\t\n142\t// ---------------------------------------------------------------------------\n143\t// Clash validation (FR-9..FR-14)\n144\t// ---------------------------------------------------------------------------\n145\t\n146\tconst clashCourseInclude = {\n147\t  subject: { select: { name: true } },\n148\t  section: { select: { name: true } },\n149\t} satisfies Prisma.CourseInclude;\n150\t\n151\ttype ClashCourseRow = Prisma.CourseGetPayload<{ include: typeof clashCourseInclude }>;\n152\t\n153\tfunction toCandidate(c: ClashCourseRow): CandidateCourse {\n154\t  return {\n155\t    id: c.id,\n156\t    code: c.code,\n157\t    teacherId: c.teacherId,\n158\t    coTeacherIds: c.coTeacherIds,\n159\t    sectionId: c.sectionId,\n160\t    sectionName: c.section?.name ?? null,\n161\t    subjectName: c.subject.name,\n162\t  };\n163\t}\n164\t\n165\tasync function teacherNames(courses: CandidateCourse[], db: Tx) {\n166\t  const ids = [...new Set(courses.flatMap((c) => [c.teacherId, ...c.coTeacherIds]))];\n167\t  const users = await db.user.findMany({ where: { id: { in: ids } }, select: { id: true, firstName: true, lastName: true } });\n168\t  return new Map(users.map((u) => [u.id, `${u.firstName} ${u.lastName}`]));\n169\t}\n170\t\n171\t/** courseId → number of the given course's ACTIVE students also ACTIVE in it. One query. */\n172\tasync function overlapByCourse(courseId: string, otherIds: string[] | undefined, db: Tx) {\n173\t  const rows = await db.enrollment.groupBy({\n174\t    by: ['courseId'],\n175\t    where: {\n176\t      status: 'ACTIVE',\n177\t      courseId: otherIds ? { in: otherIds } : { not: courseId },\n178\t      student: { enrollments: { some: { courseId, status: 'ACTIVE' } } },\n179\t    },\n180\t    _count: { _all: true },\n181\t  });\n182\t  return new Map(rows.map((r) => [r.courseId, r._count._all]));\n183\t}\n184\t\n185\texport interface ValidateSlotInput {\n186\t  courseId: string;\n187\t  dayOfWeek: number;\n188\t  periodId: string;\n189\t  roomId: string | null;\n190\t  excludeSlotId?: string;\n191\t}\n192\t\n193\t/** Returns ALL clashes for placing the course at the cell (FR-14). */\n194\texport async function validateSlot(input: ValidateSlotInput, db: Tx = prisma): Promise<Clash[]> {\n195\t  const [course, period, day] = await Promise.all([\n196\t    db.course.findUnique({ where: { id: input.courseId }, include: clashCourseInclude }),\n197\t    db.period.findUnique({ where: { id: input.periodId } }),\n198\t    db.schoolDay.findUnique({ where: { dayOfWeek: input.dayOfWeek } }),\n199\t  ]);\n200\t  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n201\t  if (!period) throw new AppError('NOT_FOUND', 'Period not found');\n202\t\n203\t  const rows = await db.timetableSlot.findMany({\n204\t    where: {\n205\t      academicYearId: course.academicYearId,\n206\t      dayOfWeek: input.dayOfWeek,\n207\t      periodId: input.periodId,\n208\t      ...(input.excludeSlotId ? { id: { not: input.excludeSlotId } } : {}),\n209\t    },\n210\t    include: { course: { include: clashCourseInclude }, room: { select: { name: true } } },\n211\t  });\n212\t  const others: OtherSlot[] = rows.map((r) => ({ id: r.id, roomId: r.roomId, roomName: r.room?.name, course: toCandidate(r.course) }));\n213\t  const candidate = toCandidate(course);\n214\t  const [names, overlap] = await Promise.all([\n215\t    teacherNames([candidate, ...others.map((o) => o.course)], db),\n216\t    overlapByCourse(course.id, others.map((o) => o.course.id), db),\n217\t  ]);\n218\t\n219\t  return clashesForCell(\n220\t    candidate,\n221\t    input.roomId,\n222\t    {\n223\t      dayLabel: ISO_DAY_NAMES[input.dayOfWeek],\n224\t      period: period,\n225\t      isTeaching: day?.isTeaching ?? input.dayOfWeek <= 5,\n226\t    },\n227\t    others,\n228\t    overlap,\n229\t    { teacherNames: names },\n230\t  );\n231\t}\n232\t\n233\t// ---------------------------------------------------------------------------\n234\t// Slot writes (FR-17, FR-18, FR-21, FR-37, NFR-1)\n235\t// ---------------------------------------------------------------------------\n236\t\n237\t/** Retries a SERIALIZABLE transaction that lost a write conflict (P2034). Local until a 2nd caller exists (D6). */\n238\tasync function withSerializableRetry<T>(fn: () => Promise<T>, attempts = 3): Promise<T> {\n239\t  for (let attempt = 1; ; attempt++) {\n240\t    try {\n241\t      return await fn();\n242\t    } catch (error) {\n243\t      const retryable = error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2034';\n244\t      if (!retryable || attempt >= attempts) throw error;\n245\t      logger.warn('Timetable write conflict, retrying', { attempt });\n246\t    }\n247\t  }\n248\t}\n249\t\n250\tconst serializable = { isolationLevel: Prisma.TransactionIsolationLevel.Serializable };\n251\t\n252\texport const slotInclude = {\n253\t  course: {\n254\t    select: {\n255\t      id: true,\n256\t      code: true,\n257\t      name: true,\n258\t      sectionId: true,\n259\t      subject: { select: { id: true, name: true, color: true } },\n260\t      teacher: { select: { id: true, firstName: true, lastName: true } },\n261\t      section: { select: { id: true, name: true } },\n262\t    },\n263\t  },\n264\t  room: { select: { id: true, name: true } },\n265\t  period: true,\n266\t} satisfies Prisma.TimetableSlotInclude;\n267\t\n268\texport type ExpandedSlot = Prisma.TimetableSlotGetPayload<{ include: typeof slotInclude }>;\n269\t\n270\t/** D4: archived courses/rooms can't receive new placements. Returns the course's year. */\n271\tasync function assertWritable(tx: Tx, courseId: string, roomId: string | null | undefined) {\n272\t  const course = await tx.course.findUnique({ where: { id: courseId }, select: { academicYearId: true, archivedAt: true } });\n273\t  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n274\t  if (course.archivedAt) throw new AppError('VALIDATION_ERROR', 'Archived courses cannot be scheduled.');\n275\t  if (roomId) {\n276\t    const room = await tx.room.findUnique({ where: { id: roomId }, select: { archivedAt: true } });\n277\t    if (!room || room.archivedAt) throw new AppError('VALIDATION_ERROR', 'Room is archived or does not exist.');\n278\t  }\n279\t  return course.academicYearId;\n280\t}\n281\t\n282\tfunction throwIfClashes(clashes: Clash[]) {\n283\t  if (!clashes.length) return;\n284\t  const more = clashes.length > 1 ? ` (+${clashes.length - 1} more)` : '';\n285\t  throw new AppError('CONFLICT', clashes[0].message + more, { clashes });\n286\t}\n287\t\n288\texport async function createSlot(input: SlotCreateInput, ctx: AuditCtx = {}) {\n289\t  const roomId = input.roomId ?? null;\n290\t  const slot = await withSerializableRetry(() =>\n291\t    prisma.$transaction(async (tx) => {\n292\t      const academicYearId = await assertWritable(tx, input.courseId, roomId);\n293\t      throwIfClashes(await validateSlot({ ...input, roomId }, tx));\n294\t      return tx.timetableSlot.create({\n295\t        data: { academicYearId, courseId: input.courseId, dayOfWeek: input.dayOfWeek, periodId: input.periodId, roomId },\n296\t        include: slotInclude,\n297\t      });\n298\t    }, serializable),\n299\t  );\n300\t  await audit({\n301\t    ...ctx,\n302\t    action: 'timetableSlot.create',\n303\t    entityType: 'TimetableSlot',\n304\t    entityId: slot.id,\n305\t    metadata: { courseId: slot.courseId, dayOfWeek: slot.dayOfWeek, periodId: slot.periodId, roomId: slot.roomId },\n306\t  });\n307\t  return slot;\n308\t}\n309\t\n310\texport async function moveSlot(id: string, patch: SlotUpdateInput, ctx: AuditCtx = {}) {\n311\t  const { from, slot } = await withSerializableRetry(() =>\n312\t    prisma.$transaction(async (tx) => {\n313\t      const existing = await tx.timetableSlot.findUnique({ where: { id } });\n314\t      if (!existing) throw new AppError('NOT_FOUND', 'Timetable slot not found');\n315\t      const to = {\n316\t        dayOfWeek: patch.dayOfWeek ?? existing.dayOfWeek,\n317\t        periodId: patch.periodId ?? existing.periodId,\n318\t        roomId: patch.roomId === undefined ? existing.roomId : patch.roomId,\n319\t      };\n320\t      // Only a newly chosen room is checked for archival; an unchanged one rides along.\n321\t      await assertWritable(tx, existing.courseId, patch.roomId);\n322\t      throwIfClashes(await validateSlot({ courseId: existing.courseId, ...to, excludeSlotId: id }, tx));\n323\t      const updated = await tx.timetableSlot.update({ where: { id }, data: to, include: slotInclude });\n324\t      return { from: existing, slot: updated };\n325\t    }, serializable),\n326\t  );\n327\t  await audit({\n328\t    ...ctx,\n329\t    action: 'timetableSlot.update',\n330\t    entityType: 'TimetableSlot',\n331\t    entityId: id,\n332\t    metadata: {\n333\t      courseId: slot.courseId,\n334\t      from: { dayOfWeek: from.dayOfWeek, periodId: from.periodId, roomId: from.roomId },\n335\t      to: { dayOfWeek: slot.dayOfWeek, periodId: slot.periodId, roomId: slot.roomId },\n336\t    },\n337\t  });\n338\t  return slot;\n339\t}\n340\t\n341\texport async function deleteSlot(id: string, ctx: AuditCtx = {}) {\n342\t  const existing = await prisma.timetableSlot.findUnique({ where: { id } });\n343\t  if (!existing) throw new AppError('NOT_FOUND', 'Timetable slot not found');\n344\t  await prisma.timetableSlot.delete({ where: { id } });\n345\t  await audit({\n346\t    ...ctx,\n347\t    action: 'timetableSlot.delete',\n348\t    entityType: 'TimetableSlot',\n349\t    entityId: id,\n350\t    metadata: { courseId: existing.courseId, dayOfWeek: existing.dayOfWeek, periodId: existing.periodId, roomId: existing.roomId },\n351\t  });\n352\t  return { id };\n353\t}\n354\t\n355\t// ---------------------------------------------------------------------------\n356\t// Reads (FR-15, FR-19, FR-21, FR-24, FR-27, FR-35, FR-36, FR-38)\n357\t// ---------------------------------------------------------------------------\n358\t\n359\t/**\n360\t * Clash preview while dragging (FR-19, D2): cell key `${day}-${periodId}` →\n361\t * messages, clashing cells only. Fixed query count regardless of grid size (NFR-3).\n362\t * ponytail: in-memory clash map; move to SQL aggregation near ~50k slots/year.\n363\t */\n364\texport async function getAvailability(courseId: string, roomId?: string): Promise<Record<string, string[]>> {\n365\t  const course = await prisma.course.findUnique({ where: { id: courseId }, include: clashCourseInclude });\n366\t  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n367\t\n368\t  const [periods, days, rows, overlap] = await Promise.all([\n369\t    prisma.period.findMany({ where: { kind: 'CLASS' }, orderBy: { order: 'asc' } }),\n370\t    loadDays(),\n371\t    prisma.timetableSlot.findMany({\n372\t      where: { academicYearId: course.academicYearId, courseId: { not: courseId } },\n373\t      include: { course: { include: clashCourseInclude }, room: { select: { name: true } } },\n374\t    }),\n375\t    overlapByCourse(courseId, undefined, prisma),\n376\t  ]);\n377\t  const candidate = toCandidate(course);\n378\t  const others = rows.map((r) => ({\n379\t    key: `${r.dayOfWeek}-${r.periodId}`,\n380\t    slot: { id: r.id, roomId: r.roomId, roomName: r.room?.name, course: toCandidate(r.course) } as OtherSlot,\n381\t  }));\n382\t  const names = await teacherNames([candidate, ...others.map((o) => o.slot.course)], prisma);\n383\t\n384\t  const result: Record<string, string[]> = {};\n385\t  for (const day of days.filter((d) => d.isTeaching)) {\n386\t    for (const period of periods) {\n387\t      const key = `${day.dayOfWeek}-${period.id}`;\n388\t      const cellOthers = others.filter((o) => o.key === key).map((o) => o.slot);\n389\t      if (!cellOthers.length) continue;\n390\t      const clashes = clashesForCell(\n391\t        candidate,\n392\t        roomId ?? null,\n393\t        { dayLabel: ISO_DAY_NAMES[day.dayOfWeek], period, isTeaching: true },\n394\t        cellOthers,\n395\t        overlap,\n396\t        { teacherNames: names },\n397\t      );\n398\t      if (clashes.length) result[key] = clashes.map((c) => c.message);\n399\t    }\n400\t  }\n401\t  return result;\n402\t}\n403\t\n404\texport function getFreeRooms(q: { dayOfWeek: number; periodId: string; academicYearId: string; excludeSlotId?: string }) {\n405\t  return prisma.room.findMany({\n406\t    where: {\n407\t      archivedAt: null,\n408\t      timetableSlots: {\n409\t        none: {\n410\t          academicYearId: q.academicYearId,\n411\t          dayOfWeek: q.dayOfWeek,\n412\t          periodId: q.periodId,\n413\t          ...(q.excludeSlotId ? { id: { not: q.excludeSlotId } } : {}),\n414\t        },\n415\t      },\n416\t    },\n417\t    select: { id: true, name: true, capacity: true },\n418\t    orderBy: { name: 'asc' },\n419\t  });\n420\t}\n421\t\n422\texport type SlotTarget =\n423\t  | { kind: 'section'; sectionId: string }\n424\t  | { kind: 'teacher'; userId: string }\n425\t  | { kind: 'room'; roomId: string }\n426\t  | { kind: 'student'; studentId: string };\n427\t\n428\tfunction slotWhere(target: SlotTarget): Prisma.TimetableSlotWhereInput {\n429\t  switch (target.kind) {\n430\t    case 'section':\n431\t      return { course: { sectionId: target.sectionId } };\n432\t    case 'teacher':\n433\t      return { course: { OR: [{ teacherId: target.userId }, { coTeacherIds: { has: target.userId } }] } };\n434\t    case 'room':\n435\t      return { roomId: target.roomId };\n436\t    case 'student':\n437\t      return { course: { enrollments: { some: { studentId: target.studentId, status: 'ACTIVE' } } } };\n438\t  }\n439\t}\n440\t\n441\tasync function loadView(target: SlotTarget | null, academicYearId: string | null) {\n442\t  const [periods, days, slots] = await Promise.all([\n443\t    listPeriods(),\n444\t    loadDays(),\n445\t    target && academicYearId\n446\t      ? prisma.timetableSlot.findMany({ where: { academicYearId, ...slotWhere(target) }, include: slotInclude })\n447\t      : Promise.resolve([] as ExpandedSlot[]),\n448\t  ]);\n449\t  return { periods, days, slots };\n450\t}\n451\t\n452\texport type TimetableViewData = Awaited<ReturnType<typeof loadView>>;\n453\t\n454\t/** Everything the grid needs in one response (NFR-2). */\n455\texport function getTimetable(view: TimetableViewKind, id: string, academicYearId: string) {\n456\t  const target: SlotTarget =\n457\t    view === 'section' ? { kind: 'section', sectionId: id } : view === 'teacher' ? { kind: 'teacher', userId: id } : { kind: 'room', roomId: id };\n458\t  return loadView(target, academicYearId);\n459\t}\n460\t\n461\t/** FR-35 / D8. ADMIN any view; TEACHER own teacher view or sections they homeroom/teach; else FORBIDDEN. */\n462\texport async function assertCanViewTimetable(user: { id: string; role: Role }, view: TimetableViewKind, id: string) {\n463\t  if (user.role === 'ADMIN') return;\n464\t  if (user.role === 'TEACHER') {\n465\t    if (view === 'teacher' && id === user.id) return;\n466\t    if (view === 'section') {\n467\t      const section = await prisma.section.findFirst({\n468\t        where: {\n469\t          id,\n470\t          OR: [\n471\t            { homeroomTeacherId: user.id },\n472\t            { courses: { some: { archivedAt: null, OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] } } },\n473\t          ],\n474\t        },\n475\t        select: { id: true },\n476\t      });\n477\t      if (section) return;\n478\t    }\n479\t  }\n480\t  throw new AppError('FORBIDDEN', 'You do not have permission to view this timetable.');\n481\t}\n482\t\n483\tasync function currentYearId() {\n484\t  const year = await prisma.academicYear.findFirst({ where: { isCurrent: true }, select: { id: true } });\n485\t  return year?.id ?? null;\n486\t}\n487\t\n488\tasync function schoolTimezone() {\n489\t  const settings = await prisma.schoolSettings.findUnique({ where: { id: 'singleton' }, select: { timezone: true } });\n490\t  return settings?.timezone ?? 'UTC';\n491\t}\n492\t\n493\texport type PersonalTarget = { kind: 'teacher'; userId: string } | { kind: 'student'; studentId: string };\n494\t\n495\t/**\n496\t * FR-25/FR-38 access, shared by GET /api/me/timetable and the /timetable page (NFR-7).\n497\t * null = no personal timetable (ADMIN, D5; or a parent with no linked child).\n498\t */\n499\texport async function resolvePersonalTarget(\n500\t  user: { id: string; role: Role },\n501\t  studentId?: string,\n502\t): Promise<PersonalTarget | null> {\n503\t  switch (user.role) {\n504\t    case 'TEACHER':\n505\t      return { kind: 'teacher', userId: user.id };\n506\t    case 'STUDENT':\n507\t      if (studentId && studentId !== user.id) throw new AppError('FORBIDDEN', 'You can only view your own timetable.');\n508\t      return { kind: 'student', studentId: user.id };\n509\t    case 'PARENT': {\n510\t      const links = await prisma.parentStudentLink.findMany({ where: { parentId: user.id }, select: { studentId: true } });\n511\t      if (studentId) {\n512\t        if (!links.some((l) => l.studentId === studentId)) {\n513\t          throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n514\t        }\n515\t        return { kind: 'student', studentId };\n516\t      }\n517\t      if (links.length > 1) throw new AppError('VALIDATION_ERROR', 'studentId is required when you have more than one child.');\n518\t      return links.length ? { kind: 'student', studentId: links[0].studentId } : null;\n519\t    }\n520\t    default:\n521\t      return null;\n522\t  }\n523\t}\n524\t\n525\t/** Teacher (incl. co-taught) or student (ACTIVE enrollments) week; year defaults to the current one. */\n526\texport async function getPersonalTimetable(target: PersonalTarget | null, academicYearId?: string) {\n527\t  return loadView(target, academicYearId ?? (await currentYearId()));\n528\t}\n529\t\n530\t// ---------------------------------------------------------------------------\n531\t// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n532\t// ---------------------------------------------------------------------------\n533\t\n534\texport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\n535\texport interface ScheduleEntry {\n536\t  period: ExpandedSlot['period'];\n537\t  course: ExpandedSlot['course'];\n538\t  room: ExpandedSlot['room'];\n539\t}\n540\t\n541\t/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\n542\texport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n543\t  let slotTarget: SlotTarget | null;\n544\t  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n545\t  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n546\t  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n547\t  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n548\t\n549\t  const { isoDay } = schoolNow(date, await schoolTimezone());\n550\t  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n551\t  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n552\t  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n553\t\n554\t  const academicYearId = await currentYearId();\n555\t  if (!academicYearId) return [];\n556\t  const slots = await prisma.timetableSlot.findMany({\n557\t    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n558\t    include: slotInclude,\n559\t    orderBy: { period: { order: 'asc' } },\n560\t  });\n561\t  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n562\t}\n563\t\n564\t/** The entry running at `now` in the school timezone, else null. */\n565\texport async function getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null> {\n566\t  const [schedule, tz] = await Promise.all([getScheduleForDate(user, now), schoolTimezone()]);\n567\t  const { hhmm } = schoolNow(now, tz);\n568\t  return schedule.find((s) => s.period.startTime <= hhmm && hhmm < s.period.endTime) ?? null;\n569\t}\n570\t\n571\tfunction stripUndefined<T extends object>(obj: T) {\n572\t  return Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== undefined)) as Partial<T>;\n573\t}\n574\t"}]},"parent_tool_use_id":null,"session_id":"b6711741-6c85-44a1-926e-b6198252edd5","uuid":"4de29459-b749-41d5-9e16-2a15d05ac335","timestamp":"2026-11-05T05:30:59.595Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/timetable/timetable-service.ts","content":"import { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { logger } from '@/lib/logger';\nimport { ISO_DAY_NAMES, schoolNow } from '@/lib/dates';\nimport type { Role } from '@/config/navigation';\nimport type {\n  PeriodInput,\n  PeriodUpdateInput,\n  SchoolDaysInput,\n  SlotCreateInput,\n  SlotUpdateInput,\n  TimetableViewKind,\n} from '@/lib/validators/timetable';\nimport { clashesForCell, periodsOverlap, type CandidateCourse, type Clash, type OtherSlot } from './clash-rules';\n\n/**\n * PRD-06 timetable service: the only writer of Period / SchoolDay /\n * TimetableSlot. Route handlers stay thin (NFR-8). audit() runs after the\n * transaction commits, so a rolled-back write is never audited (D7).\n *\n * Note: this file deliberately does not import services/settings.ts or\n * services/academicYears.ts -- their react.cache() wrappers are undefined\n * outside Next (vitest/tsx), and the concurrency test imports this module.\n */\n\ntype Tx = Prisma.TransactionClient;\nexport interface AuditCtx {\n  actorId?: string | null;\n  request?: Request;\n}\n\n// ---------------------------------------------------------------------------\n// Bell schedule: periods (FR-5, FR-6, FR-8, FR-33)\n// ---------------------------------------------------------------------------\n\nexport function listPeriods(db: Tx = prisma) {\n  return db.period.findMany({ orderBy: { order: 'asc' } });\n}\n\nasync function assertNoOverlap(candidate: { startTime: string; endTime: string }, excludeId?: string) {\n  const others = await prisma.period.findMany({ where: excludeId ? { id: { not: excludeId } } : {} });\n  const hit = others.find((o) => periodsOverlap(candidate, o));\n  if (hit) {\n    throw new AppError('VALIDATION_ERROR', `Overlaps '${hit.name}' (${hit.startTime}–${hit.endTime}).`);\n  }\n}\n\nexport async function createPeriod(input: PeriodInput, ctx: AuditCtx = {}) {\n  await assertNoOverlap(input);\n  const max = await prisma.period.aggregate({ _max: { order: true } });\n  const period = await prisma.period.create({ data: { ...input, order: (max._max.order ?? 0) + 1 } });\n  await audit({ ...ctx, action: 'period.create', entityType: 'Period', entityId: period.id, metadata: { ...input } });\n  return period;\n}\n\nexport async function updatePeriod(id: string, patch: PeriodUpdateInput, ctx: AuditCtx = {}) {\n  const existing = await prisma.period.findUnique({ where: { id } });\n  if (!existing) throw new AppError('NOT_FOUND', 'Period not found');\n  const merged = { ...existing, ...stripUndefined(patch) };\n  if (merged.endTime <= merged.startTime) {\n    throw new AppError('VALIDATION_ERROR', 'End time must be after start time');\n  }\n  await assertNoOverlap(merged, id);\n  const period = await prisma.period.update({ where: { id }, data: stripUndefined(patch) });\n  await audit({ ...ctx, action: 'period.update', entityType: 'Period', entityId: id, metadata: { ...patch } });\n  return period;\n}\n\nexport async function deletePeriod(id: string, ctx: AuditCtx = {}) {\n  const existing = await prisma.period.findUnique({ where: { id }, select: { id: true, name: true } });\n  if (!existing) throw new AppError('NOT_FOUND', 'Period not found');\n  const slotCount = await prisma.timetableSlot.count({ where: { periodId: id } });\n  if (slotCount > 0) {\n    throw new AppError('CONFLICT', `Period has ${slotCount} timetable slots. Remove them first.`, { slotCount });\n  }\n  await prisma.period.delete({ where: { id } });\n  await audit({ ...ctx, action: 'period.delete', entityType: 'Period', entityId: id, metadata: { name: existing.name } });\n  return { id };\n}\n\n/** Index 0 → order 1. Two-phase write so the @unique order never collides mid-update. */\nexport async function reorderPeriods(periodIds: string[], ctx: AuditCtx = {}) {\n  const periods = await prisma.$transaction(async (tx) => {\n    const existing = await tx.period.findMany({ select: { id: true } });\n    const known = new Set(existing.map((p) => p.id));\n    if (known.size !== periodIds.length || !periodIds.every((id) => known.has(id))) {\n      throw new AppError('VALIDATION_ERROR', 'periodIds must list every period exactly once');\n    }\n    for (const [i, id] of periodIds.entries()) await tx.period.update({ where: { id }, data: { order: -(i + 1) } });\n    for (const [i, id] of periodIds.entries()) await tx.period.update({ where: { id }, data: { order: i + 1 } });\n    return listPeriods(tx);\n  });\n  await audit({ ...ctx, action: 'period.reorder', entityType: 'Period', metadata: { periodIds } });\n  return periods;\n}\n\n// ---------------------------------------------------------------------------\n// Teaching days (FR-7, FR-34)\n// ---------------------------------------------------------------------------\n\n/** Always 7 rows Mon→Sun; a missing row (unseeded DB) defaults to Mon–Fri teaching. */\nasync function loadDays(db: Tx = prisma) {\n  const rows = await db.schoolDay.findMany();\n  return [1, 2, 3, 4, 5, 6, 7].map(\n    (dayOfWeek) => rows.find((r) => r.dayOfWeek === dayOfWeek) ?? { dayOfWeek, isTeaching: dayOfWeek <= 5 },\n  );\n}\n\n/** slotCount covers all academic years -- the same set updateSchoolDays deletes (D3). */\nexport async function listSchoolDays(db: Tx = prisma) {\n  const [days, counts] = await Promise.all([\n    loadDays(db),\n    db.timetableSlot.groupBy({ by: ['dayOfWeek'], _count: { _all: true } }),\n  ]);\n  return days.map((d) => ({ ...d, slotCount: counts.find((c) => c.dayOfWeek === d.dayOfWeek)?._count._all ?? 0 }));\n}\n\nexport async function updateSchoolDays(input: SchoolDaysInput['days'], ctx: AuditCtx = {}) {\n  const result = await prisma.$transaction(async (tx) => {\n    const current = await loadDays(tx);\n    const changed = input.filter((d) => current.find((c) => c.dayOfWeek === d.dayOfWeek)?.isTeaching !== d.isTeaching);\n    const off = changed.filter((d) => !d.isTeaching).map((d) => d.dayOfWeek);\n    const { count: deletedSlotCount } = off.length\n      ? await tx.timetableSlot.deleteMany({ where: { dayOfWeek: { in: off } } })\n      : { count: 0 };\n    for (const d of input) {\n      await tx.schoolDay.upsert({ where: { dayOfWeek: d.dayOfWeek }, update: { isTeaching: d.isTeaching }, create: d });\n    }\n    return { days: await listSchoolDays(tx), changed, deletedSlotCount };\n  });\n  await audit({\n    ...ctx,\n    action: 'schoolDay.update',\n    entityType: 'SchoolDay',\n    metadata: { changed: result.changed, deletedSlotCount: result.deletedSlotCount },\n  });\n  return { days: result.days, deletedSlotCount: result.deletedSlotCount };\n}\n\n// ---------------------------------------------------------------------------\n// Clash validation (FR-9..FR-14)\n// ---------------------------------------------------------------------------\n\nconst clashCourseInclude = {\n  subject: { select: { name: true } },\n  section: { select: { name: true } },\n} satisfies Prisma.CourseInclude;\n\ntype ClashCourseRow = Prisma.CourseGetPayload<{ include: typeof clashCourseInclude }>;\n\nfunction toCandidate(c: ClashCourseRow): CandidateCourse {\n  return {\n    id: c.id,\n    code: c.code,\n    teacherId: c.teacherId,\n    coTeacherIds: c.coTeacherIds,\n    sectionId: c.sectionId,\n    sectionName: c.section?.name ?? null,\n    subjectName: c.subject.name,\n  };\n}\n\nasync function teacherNames(courses: CandidateCourse[], db: Tx) {\n  const ids = [...new Set(courses.flatMap((c) => [c.teacherId, ...c.coTeacherIds]))];\n  const users = await db.user.findMany({ where: { id: { in: ids } }, select: { id: true, firstName: true, lastName: true } });\n  return new Map(users.map((u) => [u.id, `${u.firstName} ${u.lastName}`]));\n}\n\n/** courseId → number of the given course's ACTIVE students also ACTIVE in it. One query. */\nasync function overlapByCourse(courseId: string, otherIds: string[] | undefined, db: Tx) {\n  const rows = await db.enrollment.groupBy({\n    by: ['courseId'],\n    where: {\n      status: 'ACTIVE',\n      courseId: otherIds ? { in: otherIds } : { not: courseId },\n      student: { enrollments: { some: { courseId, status: 'ACTIVE' } } },\n    },\n    _count: { _all: true },\n  });\n  return new Map(rows.map((r) => [r.courseId, r._count._all]));\n}\n\nexport interface ValidateSlotInput {\n  courseId: string;\n  dayOfWeek: number;\n  periodId: string;\n  roomId: string | null;\n  excludeSlotId?: string;\n}\n\n/** Returns ALL clashes for placing the course at the cell (FR-14). */\nexport async function validateSlot(input: ValidateSlotInput, db: Tx = prisma): Promise<Clash[]> {\n  const [course, period, day] = await Promise.all([\n    db.course.findUnique({ where: { id: input.courseId }, include: clashCourseInclude }),\n    db.period.findUnique({ where: { id: input.periodId } }),\n    db.schoolDay.findUnique({ where: { dayOfWeek: input.dayOfWeek } }),\n  ]);\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  if (!period) throw new AppError('NOT_FOUND', 'Period not found');\n\n  const rows = await db.timetableSlot.findMany({\n    where: {\n      academicYearId: course.academicYearId,\n      dayOfWeek: input.dayOfWeek,\n      periodId: input.periodId,\n      ...(input.excludeSlotId ? { id: { not: input.excludeSlotId } } : {}),\n    },\n    include: { course: { include: clashCourseInclude }, room: { select: { name: true } } },\n  });\n  const others: OtherSlot[] = rows.map((r) => ({ id: r.id, roomId: r.roomId, roomName: r.room?.name, course: toCandidate(r.course) }));\n  const candidate = toCandidate(course);\n  const [names, overlap] = await Promise.all([\n    teacherNames([candidate, ...others.map((o) => o.course)], db),\n    overlapByCourse(course.id, others.map((o) => o.course.id), db),\n  ]);\n\n  return clashesForCell(\n    candidate,\n    input.roomId,\n    {\n      dayLabel: ISO_DAY_NAMES[input.dayOfWeek],\n      period: period,\n      isTeaching: day?.isTeaching ?? input.dayOfWeek <= 5,\n    },\n    others,\n    overlap,\n    { teacherNames: names },\n  );\n}\n\n// ---------------------------------------------------------------------------\n// Slot writes (FR-17, FR-18, FR-21, FR-37, NFR-1)\n// ---------------------------------------------------------------------------\n\n/** Retries a SERIALIZABLE transaction that lost a write conflict (P2034). Local until a 2nd caller exists (D6). */\nasync function withSerializableRetry<T>(fn: () => Promise<T>, attempts = 3): Promise<T> {\n  for (let attempt = 1; ; attempt++) {\n    try {\n      return await fn();\n    } catch (error) {\n      const retryable = error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2034';\n      if (!retryable || attempt >= attempts) throw error;\n      logger.warn('Timetable write conflict, retrying', { attempt });\n    }\n  }\n}\n\nconst serializable = { isolationLevel: Prisma.TransactionIsolationLevel.Serializable };\n\nexport const slotInclude = {\n  course: {\n    select: {\n      id: true,\n      code: true,\n      name: true,\n      sectionId: true,\n      subject: { select: { id: true, name: true, color: true } },\n      teacher: { select: { id: true, firstName: true, lastName: true } },\n      section: { select: { id: true, name: true } },\n    },\n  },\n  room: { select: { id: true, name: true } },\n  period: true,\n} satisfies Prisma.TimetableSlotInclude;\n\nexport type ExpandedSlot = Prisma.TimetableSlotGetPayload<{ include: typeof slotInclude }>;\n\n/** D4: archived courses/rooms can't receive new placements. Returns the course's year. */\nasync function assertWritable(tx: Tx, courseId: string, roomId: string | null | undefined) {\n  const course = await tx.course.findUnique({ where: { id: courseId }, select: { academicYearId: true, archivedAt: true } });\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  if (course.archivedAt) throw new AppError('VALIDATION_ERROR', 'Archived courses cannot be scheduled.');\n  if (roomId) {\n    const room = await tx.room.findUnique({ where: { id: roomId }, select: { archivedAt: true } });\n    if (!room || room.archivedAt) throw new AppError('VALIDATION_ERROR', 'Room is archived or does not exist.');\n  }\n  return course.academicYearId;\n}\n\nfunction throwIfClashes(clashes: Clash[]) {\n  if (!clashes.length) return;\n  const more = clashes.length > 1 ? ` (+${clashes.length - 1} more)` : '';\n  throw new AppError('CONFLICT', clashes[0].message + more, { clashes });\n}\n\nexport async function createSlot(input: SlotCreateInput, ctx: AuditCtx = {}) {\n  const roomId = input.roomId ?? null;\n  const slot = await withSerializableRetry(() =>\n    prisma.$transaction(async (tx) => {\n      const academicYearId = await assertWritable(tx, input.courseId, roomId);\n      throwIfClashes(await validateSlot({ ...input, roomId }, tx));\n      return tx.timetableSlot.create({\n        data: { academicYearId, courseId: input.courseId, dayOfWeek: input.dayOfWeek, periodId: input.periodId, roomId },\n        include: slotInclude,\n      });\n    }, serializable),\n  );\n  await audit({\n    ...ctx,\n    action: 'timetableSlot.create',\n    entityType: 'TimetableSlot',\n    entityId: slot.id,\n    metadata: { courseId: slot.courseId, dayOfWeek: slot.dayOfWeek, periodId: slot.periodId, roomId: slot.roomId },\n  });\n  return slot;\n}\n\nexport async function moveSlot(id: string, patch: SlotUpdateInput, ctx: AuditCtx = {}) {\n  const { from, slot } = await withSerializableRetry(() =>\n    prisma.$transaction(async (tx) => {\n      const existing = await tx.timetableSlot.findUnique({ where: { id } });\n      if (!existing) throw new AppError('NOT_FOUND', 'Timetable slot not found');\n      const to = {\n        dayOfWeek: patch.dayOfWeek ?? existing.dayOfWeek,\n        periodId: patch.periodId ?? existing.periodId,\n        roomId: patch.roomId === undefined ? existing.roomId : patch.roomId,\n      };\n      // Only a newly chosen room is checked for archival; an unchanged one rides along.\n      await assertWritable(tx, existing.courseId, patch.roomId);\n      throwIfClashes(await validateSlot({ courseId: existing.courseId, ...to, excludeSlotId: id }, tx));\n      const updated = await tx.timetableSlot.update({ where: { id }, data: to, include: slotInclude });\n      return { from: existing, slot: updated };\n    }, serializable),\n  );\n  await audit({\n    ...ctx,\n    action: 'timetableSlot.update',\n    entityType: 'TimetableSlot',\n    entityId: id,\n    metadata: {\n      courseId: slot.courseId,\n      from: { dayOfWeek: from.dayOfWeek, periodId: from.periodId, roomId: from.roomId },\n      to: { dayOfWeek: slot.dayOfWeek, periodId: slot.periodId, roomId: slot.roomId },\n    },\n  });\n  return slot;\n}\n\nexport async function deleteSlot(id: string, ctx: AuditCtx = {}) {\n  const existing = await prisma.timetableSlot.findUnique({ where: { id } });\n  if (!existing) throw new AppError('NOT_FOUND', 'Timetable slot not found');\n  await prisma.timetableSlot.delete({ where: { id } });\n  await audit({\n    ...ctx,\n    action: 'timetableSlot.delete',\n    entityType: 'TimetableSlot',\n    entityId: id,\n    metadata: { courseId: existing.courseId, dayOfWeek: existing.dayOfWeek, periodId: existing.periodId, roomId: existing.roomId },\n  });\n  return { id };\n}\n\n// ---------------------------------------------------------------------------\n// Reads (FR-15, FR-19, FR-21, FR-24, FR-27, FR-35, FR-36, FR-38)\n// ---------------------------------------------------------------------------\n\n/**\n * Clash preview while dragging (FR-19, D2): cell key `${day}-${periodId}` →\n * messages, clashing cells only. Fixed query count regardless of grid size (NFR-3).\n * ponytail: in-memory clash map; move to SQL aggregation near ~50k slots/year.\n */\nexport async function getAvailability(courseId: string, roomId?: string): Promise<Record<string, string[]>> {\n  const course = await prisma.course.findUnique({ where: { id: courseId }, include: clashCourseInclude });\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n\n  const [periods, days, rows, overlap] = await Promise.all([\n    prisma.period.findMany({ where: { kind: 'CLASS' }, orderBy: { order: 'asc' } }),\n    loadDays(),\n    prisma.timetableSlot.findMany({\n      where: { academicYearId: course.academicYearId, courseId: { not: courseId } },\n      include: { course: { include: clashCourseInclude }, room: { select: { name: true } } },\n    }),\n    overlapByCourse(courseId, undefined, prisma),\n  ]);\n  const candidate = toCandidate(course);\n  const others = rows.map((r) => ({\n    key: `${r.dayOfWeek}-${r.periodId}`,\n    slot: { id: r.id, roomId: r.roomId, roomName: r.room?.name, course: toCandidate(r.course) } as OtherSlot,\n  }));\n  const names = await teacherNames([candidate, ...others.map((o) => o.slot.course)], prisma);\n\n  const result: Record<string, string[]> = {};\n  for (const day of days.filter((d) => d.isTeaching)) {\n    for (const period of periods) {\n      const key = `${day.dayOfWeek}-${period.id}`;\n      const cellOthers = others.filter((o) => o.key === key).map((o) => o.slot);\n      if (!cellOthers.length) continue;\n      const clashes = clashesForCell(\n        candidate,\n        roomId ?? null,\n        { dayLabel: ISO_DAY_NAMES[day.dayOfWeek], period, isTeaching: true },\n        cellOthers,\n        overlap,\n        { teacherNames: names },\n      );\n      if (clashes.length) result[key] = clashes.map((c) => c.message);\n    }\n  }\n  return result;\n}\n\nexport function getFreeRooms(q: { dayOfWeek: number; periodId: string; academicYearId: string; excludeSlotId?: string }) {\n  return prisma.room.findMany({\n    where: {\n      archivedAt: null,\n      timetableSlots: {\n        none: {\n          academicYearId: q.academicYearId,\n          dayOfWeek: q.dayOfWeek,\n          periodId: q.periodId,\n          ...(q.excludeSlotId ? { id: { not: q.excludeSlotId } } : {}),\n        },\n      },\n    },\n    select: { id: true, name: true, capacity: true },\n    orderBy: { name: 'asc' },\n  });\n}\n\nexport type SlotTarget =\n  | { kind: 'section'; sectionId: string }\n  | { kind: 'teacher'; userId: string }\n  | { kind: 'room'; roomId: string }\n  | { kind: 'student'; studentId: string };\n\nfunction slotWhere(target: SlotTarget): Prisma.TimetableSlotWhereInput {\n  switch (target.kind) {\n    case 'section':\n      return { course: { sectionId: target.sectionId } };\n    case 'teacher':\n      return { course: { OR: [{ teacherId: target.userId }, { coTeacherIds: { has: target.userId } }] } };\n    case 'room':\n      return { roomId: target.roomId };\n    case 'student':\n      return { course: { enrollments: { some: { studentId: target.studentId, status: 'ACTIVE' } } } };\n  }\n}\n\nasync function loadView(target: SlotTarget | null, academicYearId: string | null) {\n  const [periods, days, slots] = await Promise.all([\n    listPeriods(),\n    loadDays(),\n    target && academicYearId\n      ? prisma.timetableSlot.findMany({ where: { academicYearId, ...slotWhere(target) }, include: slotInclude })\n      : Promise.resolve([] as ExpandedSlot[]),\n  ]);\n  return { periods, days, slots };\n}\n\nexport type TimetableViewData = Awaited<ReturnType<typeof loadView>>;\n\n/** Everything the grid needs in one response (NFR-2). */\nexport function getTimetable(view: TimetableViewKind, id: string, academicYearId: string) {\n  const target: SlotTarget =\n    view === 'section' ? { kind: 'section', sectionId: id } : view === 'teacher' ? { kind: 'teacher', userId: id } : { kind: 'room', roomId: id };\n  return loadView(target, academicYearId);\n}\n\n/** FR-35 / D8. ADMIN any view; TEACHER own teacher view or sections they homeroom/teach; else FORBIDDEN. */\nexport async function assertCanViewTimetable(user: { id: string; role: Role }, view: TimetableViewKind, id: string) {\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER') {\n    if (view === 'teacher' && id === user.id) return;\n    if (view === 'section') {\n      const section = await prisma.section.findFirst({\n        where: {\n          id,\n          OR: [\n            { homeroomTeacherId: user.id },\n            { courses: { some: { archivedAt: null, OR: [{ teacherId: user.id }, { coTeacherIds: { has: user.id } }] } } },\n          ],\n        },\n        select: { id: true },\n      });\n      if (section) return;\n    }\n  }\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this timetable.');\n}\n\nasync function currentYearId() {\n  const year = await prisma.academicYear.findFirst({ where: { isCurrent: true }, select: { id: true } });\n  return year?.id ?? null;\n}\n\nasync function schoolTimezone() {\n  const settings = await prisma.schoolSettings.findUnique({ where: { id: 'singleton' }, select: { timezone: true } });\n  return settings?.timezone ?? 'UTC';\n}\n\nexport type PersonalTarget = { kind: 'teacher'; userId: string } | { kind: 'student'; studentId: string };\n\n/**\n * FR-25/FR-38 access, shared by GET /api/me/timetable and the /timetable page (NFR-7).\n * null = no personal timetable (ADMIN, D5; or a parent with no linked child).\n */\nexport async function resolvePersonalTarget(\n  user: { id: string; role: Role },\n  studentId?: string,\n): Promise<PersonalTarget | null> {\n  switch (user.role) {\n    case 'TEACHER':\n      return { kind: 'teacher', userId: user.id };\n    case 'STUDENT':\n      if (studentId && studentId !== user.id) throw new AppError('FORBIDDEN', 'You can only view your own timetable.');\n      return { kind: 'student', studentId: user.id };\n    case 'PARENT': {\n      const links = await prisma.parentStudentLink.findMany({ where: { parentId: user.id }, select: { studentId: true } });\n      if (studentId) {\n        if (!links.some((l) => l.studentId === studentId)) {\n          throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n        }\n        return { kind: 'student', studentId };\n      }\n      if (links.length > 1) throw new AppError('VALIDATION_ERROR', 'studentId is required when you have more than one child.');\n      return links.length ? { kind: 'student', studentId: links[0].studentId } : null;\n    }\n    default:\n      return null;\n  }\n}\n\n/** Teacher (incl. co-taught) or student (ACTIVE enrollments) week; year defaults to the current one. */\nexport async function getPersonalTimetable(target: PersonalTarget | null, academicYearId?: string) {\n  return loadView(target, academicYearId ?? (await currentYearId()));\n}\n\n// ---------------------------------------------------------------------------\n// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n// ---------------------------------------------------------------------------\n\nexport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\nexport interface ScheduleEntry {\n  period: ExpandedSlot['period'];\n  course: ExpandedSlot['course'];\n  room: ExpandedSlot['room'];\n}\n\n/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\nexport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n  let slotTarget: SlotTarget | null;\n  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n\n  const { isoDay } = schoolNow(date, await schoolTimezone());\n  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n\n  const academicYearId = await currentYearId();\n  if (!academicYearId) return [];\n  const slots = await prisma.timetableSlot.findMany({\n    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n    include: slotInclude,\n    orderBy: { period: { order: 'asc' } },\n  });\n  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n}\n\n/** The entry running at `now` in the school timezone, else null. */\nexport async function getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null> {\n  const [schedule, tz] = await Promise.all([getScheduleForDate(user, now), schoolTimezone()]);\n  const { hhmm } = schoolNow(now, tz);\n  return schedule.find((s) => s.period.startTime <= hhmm && hhmm < s.period.endTime) ?? null;\n}\n\nfunction stripUndefined<T extends object>(obj: T) {\n  return Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== undefined)) as Partial<T>;\n}\n","numLines":574,"startLine":1,"totalLines":574}},"tool_result_meta":[{"id":"toolu_014rXQNGjhaiiVgN3TDVcvj1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UXKtLfT3Pp3D3zqVg8G7k1","type":"tool_result","content":"1\t/**\n2\t * Pure clash engine (PRD-06 FR-9..FR-14, ADR-4). No Prisma import, so the\n3\t * NFR-11 unit tests run without a DB. timetable-service.ts loads the rows,\n4\t * this decides. Every rule runs; all clashes are returned (FR-14).\n5\t */\n6\t\n7\texport type ClashRule = 'TEACHER' | 'ROOM' | 'SECTION' | 'STUDENT' | 'PERIOD_KIND' | 'NON_TEACHING_DAY';\n8\texport type Clash = { rule: ClashRule; message: string };\n9\t\n10\texport interface CandidateCourse {\n11\t  id: string;\n12\t  code: string;\n13\t  teacherId: string;\n14\t  coTeacherIds: string[];\n15\t  sectionId: string | null;\n16\t  sectionName?: string | null;\n17\t  subjectName: string;\n18\t}\n19\t\n20\texport interface OtherSlot {\n21\t  id: string;\n22\t  roomId: string | null;\n23\t  roomName?: string | null;\n24\t  course: CandidateCourse;\n25\t}\n26\t\n27\texport interface CellCtx {\n28\t  dayLabel: string;\n29\t  period: { name: string; kind: string };\n30\t  isTeaching: boolean;\n31\t}\n32\t\n33\texport interface ClashOptions {\n34\t  /** userId → display name, for the TEACHER message (co-teachers included). */\n35\t  teacherNames?: Map<string, string>;\n36\t  /** The moving slot itself, skipped on a PATCH (FR-14). */\n37\t  excludeSlotId?: string;\n38\t}\n39\t\n40\tconst teachersOf = (c: CandidateCourse) => [c.teacherId, ...c.coTeacherIds];\n41\t\n42\texport function clashesForCell(\n43\t  course: CandidateCourse,\n44\t  roomId: string | null,\n45\t  cell: CellCtx,\n46\t  others: OtherSlot[],\n47\t  overlapByCourseId: Map<string, number>,\n48\t  opts: ClashOptions = {},\n49\t): Clash[] {\n50\t  const at = `on ${cell.dayLabel}, ${cell.period.name}.`;\n51\t  const rest = others.filter((o) => o.id !== opts.excludeSlotId);\n52\t  const clashes: Clash[] = [];\n53\t\n54\t  if (cell.period.kind !== 'CLASS') {\n55\t    clashes.push({ rule: 'PERIOD_KIND', message: `Period '${cell.period.name}' is not a class period.` });\n56\t  }\n57\t  if (!cell.isTeaching) {\n58\t    clashes.push({ rule: 'NON_TEACHING_DAY', message: `${cell.dayLabel} is not a teaching day.` });\n59\t  }\n60\t\n61\t  const mine = new Set(teachersOf(course));\n62\t  for (const o of rest) {\n63\t    for (const t of new Set(teachersOf(o.course))) {\n64\t      if (!mine.has(t)) continue;\n65\t      const name = opts.teacherNames?.get(t) ?? 'A teacher';\n66\t      clashes.push({ rule: 'TEACHER', message: `Clash: ${name} already teaches ${o.course.code} ${at}` });\n67\t    }\n68\t  }\n69\t\n70\t  if (roomId) {\n71\t    for (const o of rest) {\n72\t      if (o.roomId !== roomId) continue;\n73\t      clashes.push({ rule: 'ROOM', message: `Clash: ${o.roomName ?? 'The room'} is used by ${o.course.code} ${at}` });\n74\t    }\n75\t  }\n76\t\n77\t  if (course.sectionId) {\n78\t    for (const o of rest) {\n79\t      if (o.course.sectionId !== course.sectionId) continue;\n80\t      const section = o.course.sectionName ?? course.sectionName ?? 'The section';\n81\t      clashes.push({ rule: 'SECTION', message: `Clash: ${section} already has ${o.course.subjectName} ${at}` });\n82\t    }\n83\t  }\n84\t\n85\t  for (const o of rest) {\n86\t    const n = overlapByCourseId.get(o.course.id) ?? 0;\n87\t    if (n > 0) {\n88\t      clashes.push({\n89\t        rule: 'STUDENT',\n90\t        message: `Clash: ${n} students in ${course.code} also take ${o.course.code} at this time.`,\n91\t      });\n92\t    }\n93\t  }\n94\t\n95\t  return clashes;\n96\t}\n97\t\n98\t/** Half-open [start, end) overlap on 'HH:MM' strings (FR-6). */\n99\texport function periodsOverlap(\n100\t  a: { startTime: string; endTime: string },\n101\t  b: { startTime: string; endTime: string },\n102\t): boolean {\n103\t  return a.startTime < b.endTime && b.startTime < a.endTime;\n104\t}\n105\t"}]},"parent_tool_use_id":null,"session_id":"b6711741-6c85-44a1-926e-b6198252edd5","uuid":"28a5a4d1-a2ad-4eaa-b034-6156146f4210","timestamp":"2026-11-05T05:30:59.602Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/src/server/timetable/clash-rules.ts","content":"/**\n * Pure clash engine (PRD-06 FR-9..FR-14, ADR-4). No Prisma import, so the\n * NFR-11 unit tests run without a DB. timetable-service.ts loads the rows,\n * this decides. Every rule runs; all clashes are returned (FR-14).\n */\n\nexport type ClashRule = 'TEACHER' | 'ROOM' | 'SECTION' | 'STUDENT' | 'PERIOD_KIND' | 'NON_TEACHING_DAY';\nexport type Clash = { rule: ClashRule; message: string };\n\nexport interface CandidateCourse {\n  id: string;\n  code: string;\n  teacherId: string;\n  coTeacherIds: string[];\n  sectionId: string | null;\n  sectionName?: string | null;\n  subjectName: string;\n}\n\nexport interface OtherSlot {\n  id: string;\n  roomId: string | null;\n  roomName?: string | null;\n  course: CandidateCourse;\n}\n\nexport interface CellCtx {\n  dayLabel: string;\n  period: { name: string; kind: string };\n  isTeaching: boolean;\n}\n\nexport interface ClashOptions {\n  /** userId → display name, for the TEACHER message (co-teachers included). */\n  teacherNames?: Map<string, string>;\n  /** The moving slot itself, skipped on a PATCH (FR-14). */\n  excludeSlotId?: string;\n}\n\nconst teachersOf = (c: CandidateCourse) => [c.teacherId, ...c.coTeacherIds];\n\nexport function clashesForCell(\n  course: CandidateCourse,\n  roomId: string | null,\n  cell: CellCtx,\n  others: OtherSlot[],\n  overlapByCourseId: Map<string, number>,\n  opts: ClashOptions = {},\n): Clash[] {\n  const at = `on ${cell.dayLabel}, ${cell.period.name}.`;\n  const rest = others.filter((o) => o.id !== opts.excludeSlotId);\n  const clashes: Clash[] = [];\n\n  if (cell.period.kind !== 'CLASS') {\n    clashes.push({ rule: 'PERIOD_KIND', message: `Period '${cell.period.name}' is not a class period.` });\n  }\n  if (!cell.isTeaching) {\n    clashes.push({ rule: 'NON_TEACHING_DAY', message: `${cell.dayLabel} is not a teaching day.` });\n  }\n\n  const mine = new Set(teachersOf(course));\n  for (const o of rest) {\n    for (const t of new Set(teachersOf(o.course))) {\n      if (!mine.has(t)) continue;\n      const name = opts.teacherNames?.get(t) ?? 'A teacher';\n      clashes.push({ rule: 'TEACHER', message: `Clash: ${name} already teaches ${o.course.code} ${at}` });\n    }\n  }\n\n  if (roomId) {\n    for (const o of rest) {\n      if (o.roomId !== roomId) continue;\n      clashes.push({ rule: 'ROOM', message: `Clash: ${o.roomName ?? 'The room'} is used by ${o.course.code} ${at}` });\n    }\n  }\n\n  if (course.sectionId) {\n    for (const o of rest) {\n      if (o.course.sectionId !== course.sectionId) continue;\n      const section = o.course.sectionName ?? course.sectionName ?? 'The section';\n      clashes.push({ rule: 'SECTION', message: `Clash: ${section} already has ${o.course.subjectName} ${at}` });\n    }\n  }\n\n  for (const o of rest) {\n    const n = overlapByCourseId.get(o.course.id) ?? 0;\n    if (n > 0) {\n      clashes.push({\n        rule: 'STUDENT',\n        message: `Clash: ${n} students in ${course.code} also take ${o.course.code} at this time.`,\n      });\n    }\n  }\n\n  return clashes;\n}\n\n/** Half-open [start, end) overlap on 'HH:MM' strings (FR-6). */\nexport function periodsOverlap(\n  a: { startTime: string; endTime: string },\n  b: { startTime: string; endTime: string },\n): boolean {\n  return a.startTime < b.endTime && b.startTime < a.endTime;\n}\n","numLines":105,"startLine":1,"totalLines":105}},"tool_result_meta":[{"id":"toolu_01UXKtLfT3Pp3D3zqVg8G7k1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
