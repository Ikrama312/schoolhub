turn;\n69-\n70-  if (user.role === 'STUDENT' || user.role === 'PARENT') {\n71-    throw new AppError('NOT_FOUND', 'Resource not found');\n72-  }\n73-\n74-  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');\n75-}\n12:    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },\n109:      \"errors\": [\"VALIDATION_ERROR (bad key, future date)\", \"FORBIDDEN (no access, outside 14-day open window)\", \"NOT_FOUND (course/section/period)\"],\n129:        \"NOT_FOUND\"\n148:      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n165:      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n230:      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND (course/period)\"],","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01U4gBuaCqgqjAeXh4tGJcQd","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
