{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ECPmqkvnxQ1ExDDphRzZm3","type":"tool_result","content":"290\t    return { studentId: pick.id, children };\n291\t  }\n292\t  throw new AppError('FORBIDDEN', 'You do not have permission to view this.');\n293\t}\n294\t\n295\t// ---------------------------------------------------------------------------\n296\t// publishOnce (FR-42)\n297\t// ---------------------------------------------------------------------------\n298\t\n299\t/** Sends assignment.published exactly once, guarded by an atomic notifiedAt claim. */\n300\texport async function publishOnce(id: string, now = new Date()): Promise<void> {\n301\t  const a = await prisma.assignment.findUnique({\n302\t    where: { id },\n303\t    select: { id: true, title: true, courseId: true, status: true, availableFrom: true, archivedAt: true, notifiedAt: true, dueAt: true, course: { select: { name: true } } },\n304\t  });\n305\t  if (!a || a.notifiedAt || !isAssignmentVisible(a, now)) return;\n306\t  const { count } = await prisma.assignment.updateMany({ where: { id, notifiedAt: null }, data: { notifiedAt: now } });\n307\t  if (count !== 1) return;\n308\t  // PRD-11 FR-3: first visible moment (incl. SCHEDULED → visible on the read path); claimer only.\n309\t  await upsertItemFromAssignment(prisma, id, { wasVisible: false, now });\n310\t  const [students, tz] = await Promise.all([\n311\t    prisma.enrollment.findMany({ where: { courseId: a.courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n312\t    getSchoolTimezone(),\n313\t  ]);\n314\t  await notify({\n315\t    type: 'assignment.published',\n316\t    userIds: students.map((s) => s.studentId),\n317\t    title: `New assignment: ${a.title}`,\n318\t    body: `${a.course.name} — due ${formatInSchoolTz(a.dueAt, 'EEE d MMM yyyy, HH:mm', tz)}`,\n319\t    link: `/courses/${a.courseId}/assignments/${a.id}`,\n320\t  });\n321\t}\n322\t\n323\t/** Read-path trigger for SCHEDULED rows that became visible (fire-and-forget, never fails the read). */\n324\tfunction publishNewlyVisible(rows: (VisibilityFields & { id: string; notifiedAt: Date | null })[], now: Date) {\n325\t  for (const a of rows) {\n326\t    if (a.status === 'SCHEDULED' && !a.notifiedAt && isAssignmentVisible(a, now)) {\n327\t      void publishOnce(a.id, now).catch((error) =>\n328\t        logger.error('publishOnce failed', { assignmentId: a.id, message: error instanceof Error ? error.message : String(error) }),\n329\t      );\n330\t    }\n331\t  }\n332\t}\n333\t\n334\t// ---------------------------------------------------------------------------"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"77184134-d87e-4e7c-bcb5-2637079e2baa","timestamp":"2026-11-09T14:04:13.433Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/assignments/assignments-service.ts","content":"    return { studentId: pick.id, children };\n  }\n  throw new AppError('FORBIDDEN', 'You do not have permission to view this.');\n}\n\n// ---------------------------------------------------------------------------\n// publishOnce (FR-42)\n// ---------------------------------------------------------------------------\n\n/** Sends assignment.published exactly once, guarded by an atomic notifiedAt claim. */\nexport async function publishOnce(id: string, now = new Date()): Promise<void> {\n  const a = await prisma.assignment.findUnique({\n    where: { id },\n    select: { id: true, title: true, courseId: true, status: true, availableFrom: true, archivedAt: true, notifiedAt: true, dueAt: true, course: { select: { name: true } } },\n  });\n  if (!a || a.notifiedAt || !isAssignmentVisible(a, now)) return;\n  const { count } = await prisma.assignment.updateMany({ where: { id, notifiedAt: null }, data: { notifiedAt: now } });\n  if (count !== 1) return;\n  // PRD-11 FR-3: first visible moment (incl. SCHEDULED → visible on the read path); claimer only.\n  await upsertItemFromAssignment(prisma, id, { wasVisible: false, now });\n  const [students, tz] = await Promise.all([\n    prisma.enrollment.findMany({ where: { courseId: a.courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n    getSchoolTimezone(),\n  ]);\n  await notify({\n    type: 'assignment.published',\n    userIds: students.map((s) => s.studentId),\n    title: `New assignment: ${a.title}`,\n    body: `${a.course.name} — due ${formatInSchoolTz(a.dueAt, 'EEE d MMM yyyy, HH:mm', tz)}`,\n    link: `/courses/${a.courseId}/assignments/${a.id}`,\n  });\n}\n\n/** Read-path trigger for SCHEDULED rows that became visible (fire-and-forget, never fails the read). */\nfunction publishNewlyVisible(rows: (VisibilityFields & { id: string; notifiedAt: Date | null })[], now: Date) {\n  for (const a of rows) {\n    if (a.status === 'SCHEDULED' && !a.notifiedAt && isAssignmentVisible(a, now)) {\n      void publishOnce(a.id, now).catch((error) =>\n        logger.error('publishOnce failed', { assignmentId: a.id, message: error instanceof Error ? error.message : String(error) }),\n      );\n    }\n  }\n}\n\n// ---------------------------------------------------------------------------","numLines":45,"startLine":290,"totalLines":1159}},"tool_result_meta":[{"id":"toolu_01ECPmqkvnxQ1ExDDphRzZm3","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
