{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RyT4YV8grLvk7w7eRFzr78","type":"tool_result","content":"1\timport { Prisma } from '@prisma/client';\n2\timport { prisma } from '@/server/db';\n3\timport { AppError, type PaginationParams } from '@/server/http';\n4\timport { audit } from '@/server/audit';\n5\timport type { AccessUser } from '@/server/auth/student-access';\n6\timport { notify, notifyStudentAndParents } from '@/server/notifications/notify';\n7\timport { getSchoolTimezone } from '@/server/assignments/assignments-service';\n8\timport { fixed2 } from '@/server/assignments/grading-math';\n9\timport { formatInSchoolTz } from '@/lib/dates';\n10\timport { logger } from '@/lib/logger';\n11\timport {\n12\t  questionSchema,\n13\t  quizSettingsSchema,\n14\t  type AccommodationInput,\n15\t  type QuestionInput,\n16\t  type QuestionPatch,\n17\t  type QuizPatch,\n18\t  type QuizSettings,\n19\t} from '@/lib/validators/quiz';\n20\timport { attemptLimit, canPublish, percentOf, resultsVisible } from './grading';\n21\timport { toManagerQuestion, toStudentQuiz, totalPoints, type StudentQuiz } from './serializers';\n22\timport { canManageCourse, manageCourseOrNotFound, quizNotFound, viewCourseOrNotFound } from './access';\n23\timport { autoGradeAnswers, ensureNotExpired, ensureQuizAttemptsNotExpired, getAccommodation, quizSelect, recomputeAttempt } from './attempt-service';\n24\t\n25\t/**\n26\t * PRD-10 quiz authoring, listing and teacher actions (system-design §3.1, §4.1, §4.5).\n27\t * Route handlers and server pages stay thin; every write is access-checked here.\n28\t */\n29\t\n30\ttype Tx = Prisma.TransactionClient;\n31\t\n32\texport const LOCK_MESSAGE = 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.';\n33\tconst courseNotFound = () => new AppError('NOT_FOUND', 'Course not found');\n34\tconst questionNotFound = () => new AppError('NOT_FOUND', 'Question not found');\n35\tconst iso = (d: Date | null) => (d ? d.toISOString() : null);\n36\t\n37\t// ---------------------------------------------------------------------------\n38\t// Manager quiz payload\n39\t// ---------------------------------------------------------------------------\n40\t\n41\tasync function loadManagerQuiz(quizId: string, db: Tx | typeof prisma = prisma) {\n42\t  const quiz = await db.quiz.findUnique({\n43\t    where: { id: quizId },\n44\t    include: { questions: { orderBy: { order: 'asc' } }, _count: { select: { attempts: true } } },\n45\t  });\n46\t  if (!quiz) throw quizNotFound();\n47\t  return quiz;\n48\t}\n49\ttype ManagerQuizRow = Awaited<ReturnType<typeof loadManagerQuiz>>;\n50\t\n51\tfunction toManagerQuiz(q: ManagerQuizRow) {\n52\t  return {\n53\t    id: q.id,\n54\t    courseId: q.courseId,\n55\t    title: q.title,\n56\t    instructions: q.instructions,\n57\t    isPractice: q.isPractice,\n58\t    availableFrom: q.availableFrom.toISOString(),\n59\t    availableUntil: q.availableUntil.toISOString(),\n60\t    timeLimitMinutes: q.timeLimitMinutes,\n61\t    maxAttempts: q.maxAttempts,\n62\t    scoringPolicy: q.scoringPolicy,\n63\t    shuffleQuestions: q.shuffleQuestions,\n64\t    shuffleOptions: q.shuffleOptions,\n65\t    oneQuestionPerPage: q.oneQuestionPerPage,\n66\t    resultsVisibility: q.resultsVisibility,\n67\t    showCorrectAnswers: q.showCorrectAnswers,\n68\t    status: q.status,\n69\t    resultsReleasedAt: iso(q.resultsReleasedAt),\n70\t    createdById: q.createdById,\n71\t    createdAt: q.createdAt.toISOString(),\n72\t    updatedAt: q.updatedAt.toISOString(),\n73\t    questions: q.questions.map(toManagerQuestion),\n74\t    totalPoints: totalPoints(q.questions),\n75\t    attemptCount: q._count.attempts,\n76\t    locked: q._count.attempts > 0,\n77\t    publishProblems: canPublish(q.questions),\n78\t  };\n79\t}\n80\texport type ManagerQuiz = ReturnType<typeof toManagerQuiz>;\n81\t\n82\t/** Manager-only quiz (FR-6..FR-10). */\n83\texport async function getQuizForManager(user: AccessUser, quizId: string) {\n84\t  const quiz = await loadManagerQuiz(quizId);\n85\t  await manageCourseOrNotFound(user, quiz.courseId);\n86\t  return toManagerQuiz(quiz);\n87\t}\n88\t\n89\t/** Start-screen quiz for a STUDENT (own attempts) or PARENT (zeros). DRAFT → NOT_FOUND. */\n90\texport async function getQuizForStudent(user: AccessUser, quizId: string, now = new Date()): Promise<StudentQuiz> {\n91\t  const quiz = await prisma.quiz.findUnique({ where: { id: quizId }, select: { ...quizSelect, questions: { select: { points: true } } } });\n92\t  if (!quiz || quiz.status === 'DRAFT') throw quizNotFound();\n93\t  await viewCourseOrNotFound(user, quiz.courseId);\n94\t  if (user.role !== 'STUDENT') {\n95\t    return toStudentQuiz(quiz, quiz.questions, { now, extraTimeMinutes: 0, extraAttempts: 0, attemptsUsed: 0, inProgressAttemptId: null });\n96\t  }\n97\t  const inProgress = await prisma.quizAttempt.findFirst({ where: { quizId, studentId: user.id, status: 'IN_PROGRESS' }, select: { id: true, status: true, deadlineAt: true } });\n98\t  const expired = inProgress ? await ensureNotExpired(inProgress, now) : false;\n99\t  const [acc, attemptsUsed] = await Promise.all([getAccommodation(quizId, user.id), prisma.quizAttempt.count({ where: { quizId, studentId: user.id } })]);\n100\t  return toStudentQuiz(quiz, quiz.questions, { now, ...acc, attemptsUsed, inProgressAttemptId: inProgress && !expired ? inProgress.id : null });\n101\t}\n102\t\n103\t/** GET /api/quizzes/:id — manager gets everything, everyone else the allow-listed StudentQuiz. */\n104\texport async function getQuiz(user: AccessUser, quizId: string) {\n105\t  const quiz = await prisma.quiz.findUnique({ where: { id: quizId }, select: { courseId: true } });\n106\t  if (!quiz) throw quizNotFound();\n107\t  if (await canManageCourse(user, quiz.courseId)) return getQuizForManager(user, quizId);\n108\t  return getQuizForStudent(user, quizId);\n109\t}\n110\t\n111\t// ---------------------------------------------------------------------------\n112\t// Course list (FR-11, FR-33)\n113\t// ---------------------------------------------------------------------------\n114\t\n115\ttype Group = 'UPCOMING' | 'AVAILABLE' | 'COMPLETED' | 'MISSED';\n116\t\n117\texport async function listCourseQuizzes(user: AccessUser, courseId: string, page: PaginationParams, now = new Date()) {\n118\t  await viewCourseOrNotFound(user, courseId, courseNotFound);\n119\t  const manager = await canManageCourse(user, courseId);\n120\t  const where: Prisma.QuizWhereInput = manager ? { courseId } : { courseId, status: { in: ['PUBLISHED', 'CLOSED'] } };\n121\t  const [total, quizzes] = await Promise.all([\n122\t    prisma.quiz.count({ where }),\n123\t    prisma.quiz.findMany({\n124\t      where,\n125\t      select: { ...quizSelect, questions: { select: { points: true } } },\n126\t      orderBy: { availableFrom: 'desc' },\n127\t      skip: page.skip,\n128\t      take: page.take,\n129\t    }),\n130\t  ]);\n131\t  const meta = { page: page.page, pageSize: page.pageSize, total };\n132\t\n133\t  if (manager) {\n134\t    for (const q of quizzes) await ensureQuizAttemptsNotExpired(q.id, now);\n135\t    const attempts = await prisma.quizAttempt.findMany({\n136\t      where: { quizId: { in: quizzes.map((q) => q.id) } },\n137\t      select: { quizId: true, status: true, score: true, maxScore: true },\n138\t    });\n139\t    const items = quizzes.map((q) => {\n140\t      const mine = attempts.filter((a) => a.quizId === q.id);\n141\t      const graded = mine.filter((a) => a.status === 'GRADED' && a.score !== null).map((a) => percentOf(a.score!, a.maxScore) ?? 0);\n142\t      return {\n143\t        role: 'MANAGER' as const,\n144\t        id: q.id,\n145\t        title: q.title,\n146\t        status: q.status,\n147\t        isPractice: q.isPractice,\n148\t        availableFrom: q.availableFrom.toISOString(),\n149\t        availableUntil: q.availableUntil.toISOString(),\n150\t        timeLimitMinutes: q.timeLimitMinutes,\n151\t        resultsVisibility: q.resultsVisibility,\n152\t        questionCount: q.questions.length,\n153\t        totalPoints: totalPoints(q.questions),\n154\t        attemptCount: mine.length,\n155\t        averagePercent: graded.length ? Math.round((graded.reduce((s, p) => s + p, 0) / graded.length) * 10) / 10 : null,\n156\t        needsGradingCount: mine.filter((a) => a.status === 'NEEDS_GRADING').length,\n157\t      };\n158\t    });\n159\t    return { role: 'MANAGER' as const, items, meta };\n160\t  }\n161\t\n162\t  const studentIds =\n163\t    user.role === 'STUDENT'\n164\t      ? [{ id: user.id, name: '' }]\n165\t      : (\n166\t          await prisma.user.findMany({\n167\t            where: { studentLinks: { some: { parentId: user.id } }, enrollments: { some: { courseId, status: 'ACTIVE' } } },\n168\t            select: { id: true, firstName: true, lastName: true },\n169\t            orderBy: [{ firstName: 'asc' }],\n170\t          })\n171\t        ).map((s) => ({ id: s.id, name: `${s.firstName} ${s.lastName}` }));\n172\t  const ids = studentIds.map((s) => s.id);\n173\t  const quizIds = quizzes.map((q) => q.id);\n174\t\n175\t  if (user.role === 'STUDENT') {\n176\t    const open = await prisma.quizAttempt.findMany({ where: { quizId: { in: quizIds }, studentId: user.id, status: 'IN_PROGRESS' }, select: { id: true, status: true, deadlineAt: true } });\n177\t    for (const a of open) await ensureNotExpired(a, now);\n178\t  }\n179\t  const [attempts, accs] = await Promise.all([\n180\t    prisma.quizAttempt.findMany({\n181\t      where: { quizId: { in: quizIds }, studentId: { in: ids } },\n182\t      select: { id: true, quizId: true, studentId: true, attemptNumber: true, status: true, submittedAt: true, score: true, maxScore: true },\n183\t      orderBy: { attemptNumber: 'asc' },\n184\t    }),\n185\t    prisma.quizAccommodation.findMany({ where: { quizId: { in: quizIds }, studentId: { in: ids } } }),\n186\t  ]);\n187\t\n188\t  const scoreOf = (q: (typeof quizzes)[number], a: (typeof attempts)[number]) => {\n189\t    const show = resultsVisible(q, a, now) && a.status === 'GRADED' && a.score !== null;\n190\t    return { score: show ? fixed2(a.score!) : null, maxScore: fixed2(a.maxScore), percent: show ? percentOf(a.score!, a.maxScore) : null };\n191\t  };\n192\t\n193\t  if (user.role === 'STUDENT') {\n194\t    const items = quizzes.map((q) => {\n195\t      const mine = attempts.filter((a) => a.quizId === q.id);\n196\t      const acc = accs.find((x) => x.quizId === q.id);\n197\t      const inProgress = mine.find((a) => a.status === 'IN_PROGRESS');\n198\t      const quiz = toStudentQuiz(q, q.questions, {\n199\t        now,\n200\t        extraTimeMinutes: acc?.extraTimeMinutes ?? 0,\n201\t        extraAttempts: acc?.extraAttempts ?? 0,\n202\t        attemptsUsed: mine.length,\n203\t        inProgressAttemptId: inProgress?.id ?? null,\n204\t      });\n205\t      const submitted = mine.filter((a) => a.status !== 'IN_PROGRESS');\n206\t      let group: Group;\n207\t      if (now < q.availableFrom) group = 'UPCOMING';\n208\t      else if (quiz.isOpen && (inProgress || mine.length < attemptLimit(q.maxAttempts, acc?.extraAttempts ?? 0))) group = 'AVAILABLE';\n209\t      else if (submitted.length) group = 'COMPLETED';\n210\t      else group = 'MISSED';\n211\t      const latest = submitted.at(-1);\n212\t      return {\n213\t        role: 'STUDENT' as const,\n214\t        quiz,\n215\t        group,\n216\t        latestResult: latest ? { attemptId: latest.id, status: latest.status, ...scoreOf(q, latest) } : null,\n217\t      };\n218\t    });\n219\t    return { role: 'STUDENT' as const, items, meta };\n220\t  }\n221\t\n222\t  // PARENT: one row per linked child × quiz; only visible results, read-only.\n223\t  const items = studentIds.flatMap((child) =>\n224\t    quizzes.map((q) => ({\n225\t      role: 'PARENT' as const,\n226\t      student: child,\n227\t      quiz: toStudentQuiz(q, q.questions, { now, extraTimeMinutes: 0, extraAttempts: 0, attemptsUsed: 0, inProgressAttemptId: null }),\n228\t      results: attempts\n229\t        .filter((a) => a.quizId === q.id && a.studentId === child.id && a.submittedAt && resultsVisible(q, a, now))\n230\t        .map((a) => ({ attemptId: a.id, attemptNumber: a.attemptNumber, submittedAt: a.submittedAt!.toISOString(), ...scoreOf(q, a) })),\n231\t    })),\n232\t  );\n233\t  return { role: 'PARENT' as const, items, meta };\n234\t}\n235\texport type CourseQuizList = Awaited<ReturnType<typeof listCourseQuizzes>>;\n236\t\n237\t// ---------------------------------------------------------------------------\n238\t// Create / update / delete (FR-6, FR-9, FR-29, FR-31)\n239\t// ---------------------------------------------------------------------------\n240\t\n241\tfunction settingsData(s: QuizSettings) {\n242\t  return {\n243\t    title: s.title,\n244\t    instructions: s.instructions,\n245\t    isPractice: s.isPractice,\n246\t    availableFrom: s.availableFrom,\n247\t    availableUntil: s.availableUntil,\n248\t    timeLimitMinutes: s.timeLimitMinutes,\n249\t    maxAttempts: s.maxAttempts,\n250\t    scoringPolicy: s.scoringPolicy,\n251\t    shuffleQuestions: s.shuffleQuestions,\n252\t    shuffleOptions: s.shuffleOptions,\n253\t    oneQuestionPerPage: s.oneQuestionPerPage,\n254\t    resultsVisibility: s.resultsVisibility,\n255\t    showCorrectAnswers: s.showCorrectAnswers,\n256\t  };\n257\t}\n258\t\n259\texport async function createQuiz(user: AccessUser, courseId: string, input: QuizSettings, request?: Request) {\n260\t  await manageCourseOrNotFound(user, courseId, courseNotFound);\n261\t  const quiz = await prisma.quiz.create({ data: { ...settingsData(input), courseId, createdById: user.id } });\n262\t  await audit({ actorId: user.id, action: 'quiz.create', entityType: 'Quiz', entityId: quiz.id, metadata: { courseId }, request });\n263\t  return toManagerQuiz(await loadManagerQuiz(quiz.id));\n264\t}\n265\t\n266\tasync function notifyPublished(quizId: string) {\n267\t  try {\n268\t    const q = await prisma.quiz.findUniqueOrThrow({ where: { id: quizId }, select: { id: true, title: true, courseId: true, availableFrom: true, course: { select: { name: true } } } });\n269\t    const [students, tz] = await Promise.all([\n270\t      prisma.enrollment.findMany({ where: { courseId: q.courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n271\t      getSchoolTimezone(),\n272\t    ]);\n273\t    await notify({\n274\t      type: 'quiz.published',\n275\t      userIds: students.map((s) => s.studentId),\n276\t      title: `New quiz: ${q.title}`,\n277\t      body: `${q.course.name} — opens ${formatInSchoolTz(q.availableFrom, 'EEE d MMM yyyy, HH:mm', tz)}`,\n278\t      link: `/quizzes/${q.id}/take`,\n279\t    });\n280\t  } catch (error) {\n281\t    logger.error('quiz.published notify failed', { quizId, message: error instanceof Error ? error.message : String(error) });\n282\t  }\n283\t}\n284\t\n285\texport async function updateQuiz(user: AccessUser, quizId: string, patch: QuizPatch, request?: Request) {\n286\t  const existing = await loadManagerQuiz(quizId);\n287\t  await manageCourseOrNotFound(user, existing.courseId);\n288\t  const { status, ...settings } = patch;\n289\t  const settingKeys = Object.keys(settings).filter((k) => settings[k as keyof typeof settings] !== undefined);\n290\t\n291\t  if (status) {\n292\t    const allowed = (existing.status === 'DRAFT' && status === 'PUBLISHED') || (existing.status === 'PUBLISHED' && status === 'CLOSED');\n293\t    if (!allowed) throw new AppError('CONFLICT', `A ${existing.status.toLowerCase()} quiz cannot be ${status === 'PUBLISHED' ? 'published' : 'closed'}.`);\n294\t    if (status === 'PUBLISHED') {\n295\t      const problems = canPublish(existing.questions);\n296\t      if (problems.length) throw new AppError('VALIDATION_ERROR', 'This quiz cannot be published yet.', { problems });\n297\t    }\n298\t  }\n299\t  // Cross-field rules run on stored ⊕ patch (api-contracts QuizSettingsInput).\n300\t  const merged = settingKeys.length ? quizSettingsSchema.parse({ ...toManagerQuiz(existing), ...settings }) : null;\n301\t\n302\t  const published = await prisma.$transaction(async (tx) => {\n303\t    if (merged) await tx.quiz.update({ where: { id: quizId }, data: settingsData(merged) });\n304\t    if (status === 'PUBLISHED') return (await tx.quiz.updateMany({ where: { id: quizId, status: 'DRAFT' }, data: { status: 'PUBLISHED' } })).count === 1;\n305\t    if (status === 'CLOSED') await tx.quiz.updateMany({ where: { id: quizId, status: 'PUBLISHED' }, data: { status: 'CLOSED' } });\n306\t    return false;\n307\t  });\n308\t  await audit({ actorId: user.id, action: 'quiz.update', entityType: 'Quiz', entityId: quizId, metadata: { fields: settingKeys, status }, request });\n309\t  if (published) await notifyPublished(quizId); // A9: exactly once, after commit\n310\t  return toManagerQuiz(await loadManagerQuiz(quizId));\n311\t}\n312\t\n313\texport async function deleteQuiz(user: AccessUser, quizId: string, request?: Request) {\n314\t  const quiz = await loadManagerQuiz(quizId);\n315\t  await manageCourseOrNotFound(user, quiz.courseId);\n316\t  if (quiz._count.attempts > 0) throw new AppError('CONFLICT', 'This quiz has attempts and cannot be deleted.');\n317\t  await prisma.quiz.delete({ where: { id: quizId } });\n318\t  await audit({ actorId: user.id, action: 'quiz.delete', entityType: 'Quiz', entityId: quizId, metadata: { courseId: quiz.courseId, title: quiz.title }, request });\n319\t  return { id: quizId };\n320\t}\n321\t\n322\t// ---------------------------------------------------------------------------\n323\t// Questions behind the edit lock (FR-7, FR-10, FR-39)\n324\t// ---------------------------------------------------------------------------\n325\t\n326\tasync function managedQuizForWrite(user: AccessUser, quizId: string) {\n327\t  const quiz = await prisma.quiz.findUnique({ where: { id: quizId }, select: { id: true, courseId: true, _count: { select: { attempts: true } } } });\n328\t  if (!quiz) throw quizNotFound();\n329\t  await manageCourseOrNotFound(user, quiz.courseId);\n330\t  return { ...quiz, locked: quiz._count.attempts > 0 };\n331\t}\n332\t\n333\tconst FILE_REF = /\\/api\\/files\\/([A-Za-z0-9_-]+)/g;\n334\t\n335\t/** FR-39: attach unattached 'quiz' uploads the prompt references, so the quiz resolver governs them. */\n336\tasync function attachPromptFiles(tx: Tx, user: AccessUser, quizId: string, prompt: string) {\n337\t  const ids = [...new Set([...prompt.matchAll(FILE_REF)].map((m) => m[1]))];\n338\t  if (!ids.length) return;\n339\t  await tx.fileObject.updateMany({\n340\t    where: { id: { in: ids }, context: 'quiz', contextId: null, ...(user.role === 'ADMIN' ? {} : { ownerId: user.id }) },\n341\t    data: { contextId: quizId },\n342\t  });\n343\t}\n344\t\n345\tfunction questionData(q: QuestionInput) {\n346\t  return {\n347\t    type: q.type,\n348\t    prompt: q.prompt,\n349\t    points: q.points,\n350\t    options: q.type === 'SINGLE_CHOICE' || q.type === 'MULTIPLE_CHOICE' ? (q.options as Prisma.InputJsonValue) : Prisma.DbNull,\n351\t    correct: q.correct as Prisma.InputJsonValue,\n352\t    explanation: q.explanation,\n353\t    caseSensitive: q.type === 'SHORT_ANSWER' ? q.caseSensitive : false,\n354\t  };\n355\t}\n356\t\n357\texport async function addQuestion(user: AccessUser, quizId: string, input: QuestionInput) {\n358\t  const quiz = await managedQuizForWrite(user, quizId);\n359\t  if (quiz.locked) throw new AppError('CONFLICT', LOCK_MESSAGE);\n360\t  const q = await prisma.$transaction(async (tx) => {\n361\t    const last = await tx.question.aggregate({ where: { quizId }, _max: { order: true } });\n362\t    const created = await tx.question.create({ data: { ...questionData(input), quizId, order: (last._max.order ?? -1) + 1 } });\n363\t    await attachPromptFiles(tx, user, quizId, input.prompt);\n364\t    return created;\n365\t  });\n366\t  return toManagerQuestion(q);\n367\t}\n368\t\n369\tasync function loadQuestion(user: AccessUser, questionId: string) {\n370\t  const q = await prisma.question.findUnique({ where: { id: questionId } });\n371\t  if (!q) throw questionNotFound();\n372\t  const quiz = await managedQuizForWrite(user, q.quizId).catch(() => {\n373\t    throw questionNotFound();\n374\t  });\n375\t  return { q, locked: quiz.locked };\n376\t}\n377\t\n378\tconst same = (a: unknown, b: unknown) => JSON.stringify(a ?? null) === JSON.stringify(b ?? null);\n379\t\n380\texport async function updateQuestion(user: AccessUser, questionId: string, patch: QuestionPatch) {\n381\t  const { q, locked } = await loadQuestion(user, questionId);\n382\t  const current = toManagerQuestion(q);\n383\t  if (locked) {\n384\t    // Keys whose value is unchanged are fine (the builder sends the whole question).\n385\t    const changed = (Object.keys(patch) as (keyof QuestionPatch)[]).filter((k) =>\n386\t      k === 'points' ? fixed2(String(patch.points)) !== current.points : !same(patch[k], current[k]),\n387\t    );\n388\t    const allowed = new Set<string>(['prompt', 'explanation', ...(q.type === 'SHORT_ANSWER' ? ['caseSensitive', 'correct'] : [])]);\n389\t    const correctOk = !changed.includes('correct') || Object.keys(patch.correct ?? {}).every((k) => k === 'accepted');\n390\t    if (!changed.every((k) => allowed.has(k)) || !correctOk) throw new AppError('CONFLICT', LOCK_MESSAGE);\n391\t  }\n392\t  const merged = questionSchema.parse({ ...current, ...patch });\n393\t  const updated = await prisma.$transaction(async (tx) => {\n394\t    const row = await tx.question.update({ where: { id: questionId }, data: questionData(merged) });\n395\t    await attachPromptFiles(tx, user, q.quizId, merged.prompt);\n396\t    return row;\n397\t  });\n398\t  return toManagerQuestion(updated); // A3: editing never regrades by itself\n399\t}\n400\t\n401\texport async function deleteQuestion(user: AccessUser, questionId: string) {\n402\t  const { q, locked } = await loadQuestion(user, questionId);\n403\t  if (locked) throw new AppError('CONFLICT', LOCK_MESSAGE);\n404\t  await prisma.$transaction([\n405\t    prisma.question.delete({ where: { id: questionId } }),\n406\t    prisma.question.updateMany({ where: { quizId: q.quizId, order: { gt: q.order } }, data: { order: { decrement: 1 } } }),\n407\t  ]);\n408\t  return { id: questionId };\n409\t}\n410\t\n411\texport async function reorderQuestions(user: AccessUser, quizId: string, questionIds: string[]) {\n412\t  const quiz = await managedQuizForWrite(user, quizId);\n413\t  if (quiz.locked) throw new AppError('CONFLICT', LOCK_MESSAGE);\n414\t  const existing = await prisma.question.findMany({ where: { quizId }, select: { id: true } });\n415\t  const ids = new Set(existing.map((e) => e.id));\n416\t  if (questionIds.length !== ids.size || new Set(questionIds).size !== ids.size || !questionIds.every((id) => ids.has(id))) {\n417\t    throw new AppError('VALIDATION_ERROR', 'questionIds must list every question of this quiz exactly once.');\n418\t  }\n419\t  await prisma.$transaction(questionIds.map((id, order) => prisma.question.update({ where: { id }, data: { order } })));\n420\t  return (await prisma.question.findMany({ where: { quizId }, orderBy: { order: 'asc' } })).map(toManagerQuestion);\n421\t}\n422\t\n423\t// ---------------------------------------------------------------------------\n424\t// Teacher actions (FR-10, FR-20, FR-28, FR-30, FR-38)\n425\t// ---------------------------------------------------------------------------\n426\t\n427\texport async function regradeQuiz(user: AccessUser, quizId: string, request?: Request) {\n428\t  const quiz = await managedQuizForWrite(user, quizId);\n429\t  const result = await prisma.$transaction(\n430\t    async (tx) => {\n431\t      const attempts = await tx.quizAttempt.findMany({ where: { quizId, status: { not: 'IN_PROGRESS' } }, select: { id: true, questionOrder: true } });\n432\t      let changedAnswerCount = 0;\n433\t      for (const a of attempts) {\n434\t        changedAnswerCount += await autoGradeAnswers(tx, a.id, a.questionOrder, { createMissing: false });\n435\t        await recomputeAttempt(tx, a.id);\n436\t      }\n437\t      return { attemptCount: attempts.length, changedAnswerCount };\n438\t    },\n439\t    { timeout: 60_000 },\n440\t  );\n441\t  await audit({ actorId: user.id, action: 'quiz.regrade', entityType: 'Quiz', entityId: quiz.id, metadata: result, request });\n442\t  return result;\n443\t}\n444\t\n445\t/** quiz.results_released to every student with a submitted attempt, and their parents. Never throws. */\n446\texport async function notifyResultsReleased(quizId: string) {\n447\t  try {\n448\t    const q = await prisma.quiz.findUniqueOrThrow({ where: { id: quizId }, select: { id: true, title: true, course: { select: { name: true } } } });\n449\t    const rows = await prisma.quizAttempt.findMany({ where: { quizId, status: { not: 'IN_PROGRESS' } }, select: { studentId: true }, distinct: ['studentId'] });\n450\t    if (!rows.length) return;\n451\t    await notifyStudentAndParents({\n452\t      type: 'quiz.results_released',\n453\t      studentIds: rows.map((r) => r.studentId),\n454\t      title: `Quiz results released: ${q.title}`,\n455\t      body: q.course.name,\n456\t      link: `/quizzes/${q.id}/take`,\n457\t      email: { template: 'generic-notification' },\n458\t    });\n459\t  } catch (error) {\n460\t    logger.error('quiz.results_released notify failed', { quizId, message: error instanceof Error ? error.message : String(error) });\n461\t  }\n462\t}\n463\t\n464\texport async function releaseResults(user: AccessUser, quizId: string, request?: Request, now = new Date()) {\n465\t  await managedQuizForWrite(user, quizId);\n466\t  const { count } = await prisma.quiz.updateMany({ where: { id: quizId, resultsVisibility: 'MANUAL', resultsReleasedAt: null }, data: { resultsReleasedAt: now } });\n467\t  const quiz = await prisma.quiz.findUniqueOrThrow({ where: { id: quizId }, select: { resultsVisibility: true, resultsReleasedAt: true } });\n468\t  if (quiz.resultsVisibility !== 'MANUAL') throw new AppError('CONFLICT', 'Only quizzes with manual results visibility can be released.');\n469\t  if (count === 1) {\n470\t    await notifyResultsReleased(quizId);\n471\t    await audit({ actorId: user.id, action: 'quiz.release_results', entityType: 'Quiz', entityId: quizId, request });\n472\t  }\n473\t  return { resultsReleasedAt: quiz.resultsReleasedAt!.toISOString(), notified: count === 1 };\n474\t}\n475\t\n476\texport async function upsertAccommodation(user: AccessUser, quizId: string, studentId: string, input: AccommodationInput, request?: Request) {\n477\t  const quiz = await managedQuizForWrite(user, quizId);\n478\t  const enrolled = await prisma.enrollment.findFirst({ where: { courseId: quiz.courseId, studentId, status: 'ACTIVE' }, select: { id: true } });\n479\t  if (!enrolled) throw new AppError('NOT_FOUND', 'Student not found in this course');\n480\t  const row = await prisma.quizAccommodation.upsert({\n481\t    where: { quizId_studentId: { quizId, studentId } },\n482\t    create: { quizId, studentId, ...input },\n483\t    update: input,\n484\t  });\n485\t  await audit({ actorId: user.id, action: 'quiz.accommodation', entityType: 'Quiz', entityId: quizId, metadata: { studentId, ...input }, request });\n486\t  return { quizId, studentId, extraTimeMinutes: row.extraTimeMinutes, extraAttempts: row.extraAttempts };\n487\t}\n488\t\n489\t/** Builder accommodations table (FR-28): ACTIVE enrollees with their current accommodation. */\n490\texport async function listAccommodations(user: AccessUser, quizId: string) {\n491\t  const quiz = await managedQuizForWrite(user, quizId);\n492\t  const [enrollments, accs] = await Promise.all([\n493\t    prisma.enrollment.findMany({\n494\t      where: { courseId: quiz.courseId, status: 'ACTIVE' },\n495\t      select: { student: { select: { id: true, firstName: true, lastName: true } } },\n496\t      orderBy: [{ student: { lastName: 'asc' } }, { student: { firstName: 'asc' } }],\n497\t    }),\n498\t    prisma.quizAccommodation.findMany({ where: { quizId } }),\n499\t  ]);\n500\t  return enrollments.map(({ student: s }) => {\n501\t    const a = accs.find((x) => x.studentId === s.id);\n502\t    return { studentId: s.id, name: `${s.firstName} ${s.lastName}`, extraTimeMinutes: a?.extraTimeMinutes ?? 0, extraAttempts: a?.extraAttempts ?? 0 };\n503\t  });\n504\t}\n505\t\n506\t"}]},"parent_tool_use_id":null,"session_id":"1873d368-49d2-4130-ab97-f8c75b3c27a8","uuid":"1016ecd9-5327-46f7-ab26-0173dfb954f6","timestamp":"2026-11-09T07:54:01.494Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/src/server/quiz/quiz-service.ts","content":"import { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError, type PaginationParams } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport type { AccessUser } from '@/server/auth/student-access';\nimport { notify, notifyStudentAndParents } from '@/server/notifications/notify';\nimport { getSchoolTimezone } from '@/server/assignments/assignments-service';\nimport { fixed2 } from '@/server/assignments/grading-math';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { logger } from '@/lib/logger';\nimport {\n  questionSchema,\n  quizSettingsSchema,\n  type AccommodationInput,\n  type QuestionInput,\n  type QuestionPatch,\n  type QuizPatch,\n  type QuizSettings,\n} from '@/lib/validators/quiz';\nimport { attemptLimit, canPublish, percentOf, resultsVisible } from './grading';\nimport { toManagerQuestion, toStudentQuiz, totalPoints, type StudentQuiz } from './serializers';\nimport { canManageCourse, manageCourseOrNotFound, quizNotFound, viewCourseOrNotFound } from './access';\nimport { autoGradeAnswers, ensureNotExpired, ensureQuizAttemptsNotExpired, getAccommodation, quizSelect, recomputeAttempt } from './attempt-service';\n\n/**\n * PRD-10 quiz authoring, listing and teacher actions (system-design §3.1, §4.1, §4.5).\n * Route handlers and server pages stay thin; every write is access-checked here.\n */\n\ntype Tx = Prisma.TransactionClient;\n\nexport const LOCK_MESSAGE = 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.';\nconst courseNotFound = () => new AppError('NOT_FOUND', 'Course not found');\nconst questionNotFound = () => new AppError('NOT_FOUND', 'Question not found');\nconst iso = (d: Date | null) => (d ? d.toISOString() : null);\n\n// ---------------------------------------------------------------------------\n// Manager quiz payload\n// ---------------------------------------------------------------------------\n\nasync function loadManagerQuiz(quizId: string, db: Tx | typeof prisma = prisma) {\n  const quiz = await db.quiz.findUnique({\n    where: { id: quizId },\n    include: { questions: { orderBy: { order: 'asc' } }, _count: { select: { attempts: true } } },\n  });\n  if (!quiz) throw quizNotFound();\n  return quiz;\n}\ntype ManagerQuizRow = Awaited<ReturnType<typeof loadManagerQuiz>>;\n\nfunction toManagerQuiz(q: ManagerQuizRow) {\n  return {\n    id: q.id,\n    courseId: q.courseId,\n    title: q.title,\n    instructions: q.instructions,\n    isPractice: q.isPractice,\n    availableFrom: q.availableFrom.toISOString(),\n    availableUntil: q.availableUntil.toISOString(),\n    timeLimitMinutes: q.timeLimitMinutes,\n    maxAttempts: q.maxAttempts,\n    scoringPolicy: q.scoringPolicy,\n    shuffleQuestions: q.shuffleQuestions,\n    shuffleOptions: q.shuffleOptions,\n    oneQuestionPerPage: q.oneQuestionPerPage,\n    resultsVisibility: q.resultsVisibility,\n    showCorrectAnswers: q.showCorrectAnswers,\n    status: q.status,\n    resultsReleasedAt: iso(q.resultsReleasedAt),\n    createdById: q.createdById,\n    createdAt: q.createdAt.toISOString(),\n    updatedAt: q.updatedAt.toISOString(),\n    questions: q.questions.map(toManagerQuestion),\n    totalPoints: totalPoints(q.questions),\n    attemptCount: q._count.attempts,\n    locked: q._count.attempts > 0,\n    publishProblems: canPublish(q.questions),\n  };\n}\nexport type ManagerQuiz = ReturnType<typeof toManagerQuiz>;\n\n/** Manager-only quiz (FR-6..FR-10). */\nexport async function getQuizForManager(user: AccessUser, quizId: string) {\n  const quiz = await loadManagerQuiz(quizId);\n  await manageCourseOrNotFound(user, quiz.courseId);\n  return toManagerQuiz(quiz);\n}\n\n/** Start-screen quiz for a STUDENT (own attempts) or PARENT (zeros). DRAFT → NOT_FOUND. */\nexport async function getQuizForStudent(user: AccessUser, quizId: string, now = new Date()): Promise<StudentQuiz> {\n  const quiz = await prisma.quiz.findUnique({ where: { id: quizId }, select: { ...quizSelect, questions: { select: { points: true } } } });\n  if (!quiz || quiz.status === 'DRAFT') throw quizNotFound();\n  await viewCourseOrNotFound(user, quiz.courseId);\n  if (user.role !== 'STUDENT') {\n    return toStudentQuiz(quiz, quiz.questions, { now, extraTimeMinutes: 0, extraAttempts: 0, attemptsUsed: 0, inProgressAttemptId: null });\n  }\n  const inProgress = await prisma.quizAttempt.findFirst({ where: { quizId, studentId: user.id, status: 'IN_PROGRESS' }, select: { id: true, status: true, deadlineAt: true } });\n  const expired = inProgress ? await ensureNotExpired(inProgress, now) : false;\n  const [acc, attemptsUsed] = await Promise.all([getAccommodation(quizId, user.id), prisma.quizAttempt.count({ where: { quizId, studentId: user.id } })]);\n  return toStudentQuiz(quiz, quiz.questions, { now, ...acc, attemptsUsed, inProgressAttemptId: inProgress && !expired ? inProgress.id : null });\n}\n\n/** GET /api/quizzes/:id — manager gets everything, everyone else the allow-listed StudentQuiz. */\nexport async function getQuiz(user: AccessUser, quizId: string) {\n  const quiz = await prisma.quiz.findUnique({ where: { id: quizId }, select: { courseId: true } });\n  if (!quiz) throw quizNotFound();\n  if (await canManageCourse(user, quiz.courseId)) return getQuizForManager(user, quizId);\n  return getQuizForStudent(user, quizId);\n}\n\n// ---------------------------------------------------------------------------\n// Course list (FR-11, FR-33)\n// ---------------------------------------------------------------------------\n\ntype Group = 'UPCOMING' | 'AVAILABLE' | 'COMPLETED' | 'MISSED';\n\nexport async function listCourseQuizzes(user: AccessUser, courseId: string, page: PaginationParams, now = new Date()) {\n  await viewCourseOrNotFound(user, courseId, courseNotFound);\n  const manager = await canManageCourse(user, courseId);\n  const where: Prisma.QuizWhereInput = manager ? { courseId } : { courseId, status: { in: ['PUBLISHED', 'CLOSED'] } };\n  const [total, quizzes] = await Promise.all([\n    prisma.quiz.count({ where }),\n    prisma.quiz.findMany({\n      where,\n      select: { ...quizSelect, questions: { select: { points: true } } },\n      orderBy: { availableFrom: 'desc' },\n      skip: page.skip,\n      take: page.take,\n    }),\n  ]);\n  const meta = { page: page.page, pageSize: page.pageSize, total };\n\n  if (manager) {\n    for (const q of quizzes) await ensureQuizAttemptsNotExpired(q.id, now);\n    const attempts = await prisma.quizAttempt.findMany({\n      where: { quizId: { in: quizzes.map((q) => q.id) } },\n      select: { quizId: true, status: true, score: true, maxScore: true },\n    });\n    const items = quizzes.map((q) => {\n      const mine = attempts.filter((a) => a.quizId === q.id);\n      const graded = mine.filter((a) => a.status === 'GRADED' && a.score !== null).map((a) => percentOf(a.score!, a.maxScore) ?? 0);\n      return {\n        role: 'MANAGER' as const,\n        id: q.id,\n        title: q.title,\n        status: q.status,\n        isPractice: q.isPractice,\n        availableFrom: q.availableFrom.toISOString(),\n        availableUntil: q.availableUntil.toISOString(),\n        timeLimitMinutes: q.timeLimitMinutes,\n        resultsVisibility: q.resultsVisibility,\n        questionCount: q.questions.length,\n        totalPoints: totalPoints(q.questions),\n        attemptCount: mine.length,\n        averagePercent: graded.length ? Math.round((graded.reduce((s, p) => s + p, 0) / graded.length) * 10) / 10 : null,\n        needsGradingCount: mine.filter((a) => a.status === 'NEEDS_GRADING').length,\n      };\n    });\n    return { role: 'MANAGER' as const, items, meta };\n  }\n\n  const studentIds =\n    user.role === 'STUDENT'\n      ? [{ id: user.id, name: '' }]\n      : (\n          await prisma.user.findMany({\n            where: { studentLinks: { some: { parentId: user.id } }, enrollments: { some: { courseId, status: 'ACTIVE' } } },\n            select: { id: true, firstName: true, lastName: true },\n            orderBy: [{ firstName: 'asc' }],\n          })\n        ).map((s) => ({ id: s.id, name: `${s.firstName} ${s.lastName}` }));\n  const ids = studentIds.map((s) => s.id);\n  const quizIds = quizzes.map((q) => q.id);\n\n  if (user.role === 'STUDENT') {\n    const open = await prisma.quizAttempt.findMany({ where: { quizId: { in: quizIds }, studentId: user.id, status: 'IN_PROGRESS' }, select: { id: true, status: true, deadlineAt: true } });\n    for (const a of open) await ensureNotExpired(a, now);\n  }\n  const [attempts, accs] = await Promise.all([\n    prisma.quizAttempt.findMany({\n      where: { quizId: { in: quizIds }, studentId: { in: ids } },\n      select: { id: true, quizId: true, studentId: true, attemptNumber: true, status: true, submittedAt: true, score: true, maxScore: true },\n      orderBy: { attemptNumber: 'asc' },\n    }),\n    prisma.quizAccommodation.findMany({ where: { quizId: { in: quizIds }, studentId: { in: ids } } }),\n  ]);\n\n  const scoreOf = (q: (typeof quizzes)[number], a: (typeof attempts)[number]) => {\n    const show = resultsVisible(q, a, now) && a.status === 'GRADED' && a.score !== null;\n    return { score: show ? fixed2(a.score!) : null, maxScore: fixed2(a.maxScore), percent: show ? percentOf(a.score!, a.maxScore) : null };\n  };\n\n  if (user.role === 'STUDENT') {\n    const items = quizzes.map((q) => {\n      const mine = attempts.filter((a) => a.quizId === q.id);\n      const acc = accs.find((x) => x.quizId === q.id);\n      const inProgress = mine.find((a) => a.status === 'IN_PROGRESS');\n      const quiz = toStudentQuiz(q, q.questions, {\n        now,\n        extraTimeMinutes: acc?.extraTimeMinutes ?? 0,\n        extraAttempts: acc?.extraAttempts ?? 0,\n        attemptsUsed: mine.length,\n        inProgressAttemptId: inProgress?.id ?? null,\n      });\n      const submitted = mine.filter((a) => a.status !== 'IN_PROGRESS');\n      let group: Group;\n      if (now < q.availableFrom) group = 'UPCOMING';\n      else if (quiz.isOpen && (inProgress || mine.length < attemptLimit(q.maxAttempts, acc?.extraAttempts ?? 0))) group = 'AVAILABLE';\n      else if (submitted.length) group = 'COMPLETED';\n      else group = 'MISSED';\n      const latest = submitted.at(-1);\n      return {\n        role: 'STUDENT' as const,\n        quiz,\n        group,\n        latestResult: latest ? { attemptId: latest.id, status: latest.status, ...scoreOf(q, latest) } : null,\n      };\n    });\n    return { role: 'STUDENT' as const, items, meta };\n  }\n\n  // PARENT: one row per linked child × quiz; only visible results, read-only.\n  const items = studentIds.flatMap((child) =>\n    quizzes.map((q) => ({\n      role: 'PARENT' as const,\n      student: child,\n      quiz: toStudentQuiz(q, q.questions, { now, extraTimeMinutes: 0, extraAttempts: 0, attemptsUsed: 0, inProgressAttemptId: null }),\n      results: attempts\n        .filter((a) => a.quizId === q.id && a.studentId === child.id && a.submittedAt && resultsVisible(q, a, now))\n        .map((a) => ({ attemptId: a.id, attemptNumber: a.attemptNumber, submittedAt: a.submittedAt!.toISOString(), ...scoreOf(q, a) })),\n    })),\n  );\n  return { role: 'PARENT' as const, items, meta };\n}\nexport type CourseQuizList = Awaited<ReturnType<typeof listCourseQuizzes>>;\n\n// ---------------------------------------------------------------------------\n// Create / update / delete (FR-6, FR-9, FR-29, FR-31)\n// ---------------------------------------------------------------------------\n\nfunction settingsData(s: QuizSettings) {\n  return {\n    title: s.title,\n    instructions: s.instructions,\n    isPractice: s.isPractice,\n    availableFrom: s.availableFrom,\n    availableUntil: s.availableUntil,\n    timeLimitMinutes: s.timeLimitMinutes,\n    maxAttempts: s.maxAttempts,\n    scoringPolicy: s.scoringPolicy,\n    shuffleQuestions: s.shuffleQuestions,\n    shuffleOptions: s.shuffleOptions,\n    oneQuestionPerPage: s.oneQuestionPerPage,\n    resultsVisibility: s.resultsVisibility,\n    showCorrectAnswers: s.showCorrectAnswers,\n  };\n}\n\nexport async function createQuiz(user: AccessUser, courseId: string, input: QuizSettings, request?: Request) {\n  await manageCourseOrNotFound(user, courseId, courseNotFound);\n  const quiz = await prisma.quiz.create({ data: { ...settingsData(input), courseId, createdById: user.id } });\n  await audit({ actorId: user.id, action: 'quiz.create', entityType: 'Quiz', entityId: quiz.id, metadata: { courseId }, request });\n  return toManagerQuiz(await loadManagerQuiz(quiz.id));\n}\n\nasync function notifyPublished(quizId: string) {\n  try {\n    const q = await prisma.quiz.findUniqueOrThrow({ where: { id: quizId }, select: { id: true, title: true, courseId: true, availableFrom: true, course: { select: { name: true } } } });\n    const [students, tz] = await Promise.all([\n      prisma.enrollment.findMany({ where: { courseId: q.courseId, status: 'ACTIVE' }, select: { studentId: true } }),\n      getSchoolTimezone(),\n    ]);\n    await notify({\n      type: 'quiz.published',\n      userIds: students.map((s) => s.studentId),\n      title: `New quiz: ${q.title}`,\n      body: `${q.course.name} — opens ${formatInSchoolTz(q.availableFrom, 'EEE d MMM yyyy, HH:mm', tz)}`,\n      link: `/quizzes/${q.id}/take`,\n    });\n  } catch (error) {\n    logger.error('quiz.published notify failed', { quizId, message: error instanceof Error ? error.message : String(error) });\n  }\n}\n\nexport async function updateQuiz(user: AccessUser, quizId: string, patch: QuizPatch, request?: Request) {\n  const existing = await loadManagerQuiz(quizId);\n  await manageCourseOrNotFound(user, existing.courseId);\n  const { status, ...settings } = patch;\n  const settingKeys = Object.keys(settings).filter((k) => settings[k as keyof typeof settings] !== undefined);\n\n  if (status) {\n    const allowed = (existing.status === 'DRAFT' && status === 'PUBLISHED') || (existing.status === 'PUBLISHED' && status === 'CLOSED');\n    if (!allowed) throw new AppError('CONFLICT', `A ${existing.status.toLowerCase()} quiz cannot be ${status === 'PUBLISHED' ? 'published' : 'closed'}.`);\n    if (status === 'PUBLISHED') {\n      const problems = canPublish(existing.questions);\n      if (problems.length) throw new AppError('VALIDATION_ERROR', 'This quiz cannot be published yet.', { problems });\n    }\n  }\n  // Cross-field rules run on stored ⊕ patch (api-contracts QuizSettingsInput).\n  const merged = settingKeys.length ? quizSettingsSchema.parse({ ...toManagerQuiz(existing), ...settings }) : null;\n\n  const published = await prisma.$transaction(async (tx) => {\n    if (merged) await tx.quiz.update({ where: { id: quizId }, data: settingsData(merged) });\n    if (status === 'PUBLISHED') return (await tx.quiz.updateMany({ where: { id: quizId, status: 'DRAFT' }, data: { status: 'PUBLISHED' } })).count === 1;\n    if (status === 'CLOSED') await tx.quiz.updateMany({ where: { id: quizId, status: 'PUBLISHED' }, data: { status: 'CLOSED' } });\n    return false;\n  });\n  await audit({ actorId: user.id, action: 'quiz.update', entityType: 'Quiz', entityId: quizId, metadata: { fields: settingKeys, status }, request });\n  if (published) await notifyPublished(quizId); // A9: exactly once, after commit\n  return toManagerQuiz(await loadManagerQuiz(quizId));\n}\n\nexport async function deleteQuiz(user: AccessUser, quizId: string, request?: Request) {\n  const quiz = await loadManagerQuiz(quizId);\n  await manageCourseOrNotFound(user, quiz.courseId);\n  if (quiz._count.attempts > 0) throw new AppError('CONFLICT', 'This quiz has attempts and cannot be deleted.');\n  await prisma.quiz.delete({ where: { id: quizId } });\n  await audit({ actorId: user.id, action: 'quiz.delete', entityType: 'Quiz', entityId: quizId, metadata: { courseId: quiz.courseId, title: quiz.title }, request });\n  return { id: quizId };\n}\n\n// ---------------------------------------------------------------------------\n// Questions behind the edit lock (FR-7, FR-10, FR-39)\n// ---------------------------------------------------------------------------\n\nasync function managedQuizForWrite(user: AccessUser, quizId: string) {\n  const quiz = await prisma.quiz.findUnique({ where: { id: quizId }, select: { id: true, courseId: true, _count: { select: { attempts: true } } } });\n  if (!quiz) throw quizNotFound();\n  await manageCourseOrNotFound(user, quiz.courseId);\n  return { ...quiz, locked: quiz._count.attempts > 0 };\n}\n\nconst FILE_REF = /\\/api\\/files\\/([A-Za-z0-9_-]+)/g;\n\n/** FR-39: attach unattached 'quiz' uploads the prompt references, so the quiz resolver governs them. */\nasync function attachPromptFiles(tx: Tx, user: AccessUser, quizId: string, prompt: string) {\n  const ids = [...new Set([...prompt.matchAll(FILE_REF)].map((m) => m[1]))];\n  if (!ids.length) return;\n  await tx.fileObject.updateMany({\n    where: { id: { in: ids }, context: 'quiz', contextId: null, ...(user.role === 'ADMIN' ? {} : { ownerId: user.id }) },\n    data: { contextId: quizId },\n  });\n}\n\nfunction questionData(q: QuestionInput) {\n  return {\n    type: q.type,\n    prompt: q.prompt,\n    points: q.points,\n    options: q.type === 'SINGLE_CHOICE' || q.type === 'MULTIPLE_CHOICE' ? (q.options as Prisma.InputJsonValue) : Prisma.DbNull,\n    correct: q.correct as Prisma.InputJsonValue,\n    explanation: q.explanation,\n    caseSensitive: q.type === 'SHORT_ANSWER' ? q.caseSensitive : false,\n  };\n}\n\nexport async function addQuestion(user: AccessUser, quizId: string, input: QuestionInput) {\n  const quiz = await managedQuizForWrite(user, quizId);\n  if (quiz.locked) throw new AppError('CONFLICT', LOCK_MESSAGE);\n  const q = await prisma.$transaction(async (tx) => {\n    const last = await tx.question.aggregate({ where: { quizId }, _max: { order: true } });\n    const created = await tx.question.create({ data: { ...questionData(input), quizId, order: (last._max.order ?? -1) + 1 } });\n    await attachPromptFiles(tx, user, quizId, input.prompt);\n    return created;\n  });\n  return toManagerQuestion(q);\n}\n\nasync function loadQuestion(user: AccessUser, questionId: string) {\n  const q = await prisma.question.findUnique({ where: { id: questionId } });\n  if (!q) throw questionNotFound();\n  const quiz = await managedQuizForWrite(user, q.quizId).catch(() => {\n    throw questionNotFound();\n  });\n  return { q, locked: quiz.locked };\n}\n\nconst same = (a: unknown, b: unknown) => JSON.stringify(a ?? null) === JSON.stringify(b ?? null);\n\nexport async function updateQuestion(user: AccessUser, questionId: string, patch: QuestionPatch) {\n  const { q, locked } = await loadQuestion(user, questionId);\n  const current = toManagerQuestion(q);\n  if (locked) {\n    // Keys whose value is unchanged are fine (the builder sends the whole question).\n    const changed = (Object.keys(patch) as (keyof QuestionPatch)[]).filter((k) =>\n      k === 'points' ? fixed2(String(patch.points)) !== current.points : !same(patch[k], current[k]),\n    );\n    const allowed = new Set<string>(['prompt', 'explanation', ...(q.type === 'SHORT_ANSWER' ? ['caseSensitive', 'correct'] : [])]);\n    const correctOk = !changed.includes('correct') || Object.keys(patch.correct ?? {}).every((k) => k === 'accepted');\n    if (!changed.every((k) => allowed.has(k)) || !correctOk) throw new AppError('CONFLICT', LOCK_MESSAGE);\n  }\n  const merged = questionSchema.parse({ ...current, ...patch });\n  const updated = await prisma.$transaction(async (tx) => {\n    const row = await tx.question.update({ where: { id: questionId }, data: questionData(merged) });\n    await attachPromptFiles(tx, user, q.quizId, merged.prompt);\n    return row;\n  });\n  return toManagerQuestion(updated); // A3: editing never regrades by itself\n}\n\nexport async function deleteQuestion(user: AccessUser, questionId: string) {\n  const { q, locked } = await loadQuestion(user, questionId);\n  if (locked) throw new AppError('CONFLICT', LOCK_MESSAGE);\n  await prisma.$transaction([\n    prisma.question.delete({ where: { id: questionId } }),\n    prisma.question.updateMany({ where: { quizId: q.quizId, order: { gt: q.order } }, data: { order: { decrement: 1 } } }),\n  ]);\n  return { id: questionId };\n}\n\nexport async function reorderQuestions(user: AccessUser, quizId: string, questionIds: string[]) {\n  const quiz = await managedQuizForWrite(user, quizId);\n  if (quiz.locked) throw new AppError('CONFLICT', LOCK_MESSAGE);\n  const existing = await prisma.question.findMany({ where: { quizId }, select: { id: true } });\n  const ids = new Set(existing.map((e) => e.id));\n  if (questionIds.length !== ids.size || new Set(questionIds).size !== ids.size || !questionIds.every((id) => ids.has(id))) {\n    throw new AppError('VALIDATION_ERROR', 'questionIds must list every question of this quiz exactly once.');\n  }\n  await prisma.$transaction(questionIds.map((id, order) => prisma.question.update({ where: { id }, data: { order } })));\n  return (await prisma.question.findMany({ where: { quizId }, orderBy: { order: 'asc' } })).map(toManagerQuestion);\n}\n\n// ---------------------------------------------------------------------------\n// Teacher actions (FR-10, FR-20, FR-28, FR-30, FR-38)\n// ---------------------------------------------------------------------------\n\nexport async function regradeQuiz(user: AccessUser, quizId: string, request?: Request) {\n  const quiz = await managedQuizForWrite(user, quizId);\n  const result = await prisma.$transaction(\n    async (tx) => {\n      const attempts = await tx.quizAttempt.findMany({ where: { quizId, status: { not: 'IN_PROGRESS' } }, select: { id: true, questionOrder: true } });\n      let changedAnswerCount = 0;\n      for (const a of attempts) {\n        changedAnswerCount += await autoGradeAnswers(tx, a.id, a.questionOrder, { createMissing: false });\n        await recomputeAttempt(tx, a.id);\n      }\n      return { attemptCount: attempts.length, changedAnswerCount };\n    },\n    { timeout: 60_000 },\n  );\n  await audit({ actorId: user.id, action: 'quiz.regrade', entityType: 'Quiz', entityId: quiz.id, metadata: result, request });\n  return result;\n}\n\n/** quiz.results_released to every student with a submitted attempt, and their parents. Never throws. */\nexport async function notifyResultsReleased(quizId: string) {\n  try {\n    const q = await prisma.quiz.findUniqueOrThrow({ where: { id: quizId }, select: { id: true, title: true, course: { select: { name: true } } } });\n    const rows = await prisma.quizAttempt.findMany({ where: { quizId, status: { not: 'IN_PROGRESS' } }, select: { studentId: true }, distinct: ['studentId'] });\n    if (!rows.length) return;\n    await notifyStudentAndParents({\n      type: 'quiz.results_released',\n      studentIds: rows.map((r) => r.studentId),\n      title: `Quiz results released: ${q.title}`,\n      body: q.course.name,\n      link: `/quizzes/${q.id}/take`,\n      email: { template: 'generic-notification' },\n    });\n  } catch (error) {\n    logger.error('quiz.results_released notify failed', { quizId, message: error instanceof Error ? error.message : String(error) });\n  }\n}\n\nexport async function releaseResults(user: AccessUser, quizId: string, request?: Request, now = new Date()) {\n  await managedQuizForWrite(user, quizId);\n  const { count } = await prisma.quiz.updateMany({ where: { id: quizId, resultsVisibility: 'MANUAL', resultsReleasedAt: null }, data: { resultsReleasedAt: now } });\n  const quiz = await prisma.quiz.findUniqueOrThrow({ where: { id: quizId }, select: { resultsVisibility: true, resultsReleasedAt: true } });\n  if (quiz.resultsVisibility !== 'MANUAL') throw new AppError('CONFLICT', 'Only quizzes with manual results visibility can be released.');\n  if (count === 1) {\n    await notifyResultsReleased(quizId);\n    await audit({ actorId: user.id, action: 'quiz.release_results', entityType: 'Quiz', entityId: quizId, request });\n  }\n  return { resultsReleasedAt: quiz.resultsReleasedAt!.toISOString(), notified: count === 1 };\n}\n\nexport async function upsertAccommodation(user: AccessUser, quizId: string, studentId: string, input: AccommodationInput, request?: Request) {\n  const quiz = await managedQuizForWrite(user, quizId);\n  const enrolled = await prisma.enrollment.findFirst({ where: { courseId: quiz.courseId, studentId, status: 'ACTIVE' }, select: { id: true } });\n  if (!enrolled) throw new AppError('NOT_FOUND', 'Student not found in this course');\n  const row = await prisma.quizAccommodation.upsert({\n    where: { quizId_studentId: { quizId, studentId } },\n    create: { quizId, studentId, ...input },\n    update: input,\n  });\n  await audit({ actorId: user.id, action: 'quiz.accommodation', entityType: 'Quiz', entityId: quizId, metadata: { studentId, ...input }, request });\n  return { quizId, studentId, extraTimeMinutes: row.extraTimeMinutes, extraAttempts: row.extraAttempts };\n}\n\n/** Builder accommodations table (FR-28): ACTIVE enrollees with their current accommodation. */\nexport async function listAccommodations(user: AccessUser, quizId: string) {\n  const quiz = await managedQuizForWrite(user, quizId);\n  const [enrollments, accs] = await Promise.all([\n    prisma.enrollment.findMany({\n      where: { courseId: quiz.courseId, status: 'ACTIVE' },\n      select: { student: { select: { id: true, firstName: true, lastName: true } } },\n      orderBy: [{ student: { lastName: 'asc' } }, { student: { firstName: 'asc' } }],\n    }),\n    prisma.quizAccommodation.findMany({ where: { quizId } }),\n  ]);\n  return enrollments.map(({ student: s }) => {\n    const a = accs.find((x) => x.studentId === s.id);\n    return { studentId: s.id, name: `${s.firstName} ${s.lastName}`, extraTimeMinutes: a?.extraTimeMinutes ?? 0, extraAttempts: a?.extraAttempts ?? 0 };\n  });\n}\n\n","numLines":506,"startLine":1,"totalLines":506}},"tool_result_meta":[{"id":"toolu_01RyT4YV8grLvk7w7eRFzr78","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
