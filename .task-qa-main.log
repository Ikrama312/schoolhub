{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E5yYCpug8HBFQd1SVDGjVo","type":"tool_result","content":"tests/integration/messaging/email.test.ts:61:  it('sends one email (no extra in-app row) when unread and outside quiet hours', async () => {\ntests/integration/messaging/email.test.ts:71:  it('drops the email when the recipient read the conversation after it was queued', async () => {\ntests/integration/messaging/email.test.ts:79:  it('drops the email for a muted recipient', async () => {\ntests/integration/messaging/email.test.ts:86:  it('defers to the end of quiet hours (school timezone), keeping the original createdAt', async () => {\ntests/integration/messaging/messaging.test.ts:70:  it('FR-19/FR-20: three sends leave one unread notification and one pending email (first message starts the clock)', async () => {\ntests/integration/messaging/messaging.test.ts:90:  it('FR-19: muted participants get no notification and no pending email', async () => {\ntests/integration/messaging/messaging.test.ts:99:  it('NFR-4: the 31st message in a minute is 429 RATE_LIMITED with retryAfterMs', async () => {\ntests/integration/messaging/messaging.test.ts:107:  it('NFR-1/A7: non-participants and participants who left get 404', async () => {\ntests/integration/messaging/messaging.test.ts:122:  it('FR-3/FR-15: edit stores a revision; 15-minute window; soft delete is redacted for users only', async () => {\ntests/integration/messaging/messaging.test.ts:139:  it('FR-13/A9: the after+since poll returns new messages and edits since the given time', async () => {\ntests/integration/messaging/messaging.test.ts:152:  it('A12/FR-26: duplicate OPEN report is 409; own message 403; leads are notified', async () => {\ntests/integration/messaging/messaging.test.ts:163:  it('FR-6/FR-7: student↔student is 403 on create; a dropped student cannot send but the teacher still can', async () => {\ntests/integration/messaging/messaging.test.ts:177:  it('FR-30/A11: involvesStudent is computed; a new message unarchives for recipients', async () => {\ntests/integration/messaging/safeguarding.test.ts:73:  it('NFR-1/FR-23: non-lead admins and teachers get 403 everywhere', async () => {\ntests/integration/messaging/safeguarding.test.ts:81:  it('FR-24/FR-25/NFR-3: student conversations only; deleted body and revisions visible; every view audited', async () => {\ntests/integration/messaging/safeguarding.test.ts:93:  it('FR-23/NFR-11: report detail is audited; review needs a note; a handled report is 409', async () => {\ntests/integration/messaging/safeguarding.test.ts:111:  it('FR-2: isSafeguardingLead can only be set on an ADMIN, and the change is audited', async () => {\ntests/e2e/messaging.spec.ts:50:test('parent → teacher round trip appears in the other open thread within 6 s', async ({ browser }) => {\ntests/e2e/messaging.spec.ts:85:test('student → student is absent from the picker and POST /api/conversations returns 403', async ({ page }) => {\nimport { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { DELETED_TEXT } from '@/lib/messaging/constants';\nimport type { CreateConversationInput } from '@/lib/validators/messaging';\nimport { canSendIn, validateNewConversation, type Party } from './contact-rules';\nimport { getParticipation } from './access';\nimport { conversationLink } from './notifications';\nimport { afterSend, assertRateLimit, insertMessage, toMessageDTO, toUserSummary, userSummarySelect } from './messages';\n\n/** PRD-13 conversation service (FR-6, FR-9, FR-12, FR-14, FR-18, FR-30, FR-31, NFR-2). */\n\nconst PREVIEW_MAX = 80;\n\nexport async function listConversations(\n  user: Party,\n  opts: { archived?: boolean; q?: string; skip: number; take: number },\n) {\n  const where: Prisma.ConversationWhereInput = {\n    participants: { some: { userId: user.id, leftAt: null, archivedAt: opts.archived ? { not: null } : null } },\n  };\n  if (opts.q) {\n    const contains = { contains: opts.q, mode: 'insensitive' as const };\n    where.OR = [\n      { subject: contains },\n      { participants: { some: { userId: { not: user.id }, user: { OR: [{ firstName: contains }, { lastName: contains }] } } } },\n    ];\n  }\n  const [total, rows] = await Promise.all([\n    prisma.conversation.count({ where }),\n    prisma.conversation.findMany({\n      where,\n      orderBy: [{ lastMessageAt: 'desc' }, { id: 'desc' }],\n      skip: opts.skip,\n      take: opts.take,\n      include: {\n        participants: { select: { userId: true, leftAt: true, mutedAt: true, archivedAt: true, user: { select: userSummarySelect } } },\n        messages: { orderBy: [{ createdAt: 'desc' }, { id: 'desc' }], take: 1, select: { body: true, deletedAt: true, sender: { select: { firstName: true } } } },\n      },\n    }),\n  ]);\n\n  const unread = new Map<string, number>();\n  if (rows.length) {\n    // One LATERAL COUNT over the page, capped at 99 per row (NFR-2).\n    const counts = await prisma.$queryRaw<{ id: string; unread: number }[]>`\n      SELECT p.\"conversationId\" AS id, c.cnt::int AS unread\n      FROM \"ConversationParticipant\" p\n      CROSS JOIN LATERAL (\n        SELECT COUNT(*) AS cnt FROM (\n          SELECT 1 FROM \"Message\" m\n          WHERE m.\"conversationId\" = p.\"conversationId\" AND m.\"senderId\" <> p.\"userId\" AND m.\"deletedAt\" IS NULL\n            AND m.\"createdAt\" > COALESCE(p.\"lastReadAt\", 'epoch'::timestamp)\n          LIMIT 99\n        ) x\n      ) c\n      WHERE p.\"userId\" = ${user.id} AND p.\"conversationId\" IN (${Prisma.join(rows.map((r) => r.id))})`;\n    for (const c of counts) unread.set(c.id, c.unread);\n  }\n\n  const data = rows.map((c) => {\n    const me = c.participants.find((p) => p.userId === user.id)!;\n    const last = c.messages[0];\n    const preview = !last\n      ? null\n      : last.deletedAt\n        ? DELETED_TEXT\n        : `${last.sender.firstName}: ${last.body.length > PREVIEW_MAX ? `${last.body.slice(0, PREVIEW_MAX - 1)}…` : last.body}`;\n    return {\n      id: c.id,\n      subject: c.subject,\n      participants: c.participants.filter((p) => p.userId !== user.id && !p.leftAt).map((p) => toUserSummary(p.user)),\n      preview,\n      lastMessageAt: c.lastMessageAt.toISOString(),\n      unreadCount: unread.get(c.id) ?? 0,\n      muted: me.mutedAt !== null,\n      archived: me.archivedAt !== null,\n    };\n  });\n  return { data, total };\n}\n\nexport async function getConversation(user: Party, conversationId: string) {\n  const me = await getParticipation(user.id, conversationId);\n  const c = await prisma.conversation.findUniqueOrThrow({\n    where: { id: conversationId },\n    include: { participants: { orderBy: { createdAt: 'asc' }, select: { userId: true, leftAt: true, user: { select: userSummarySelect } } } },\n  });\n  const active = c.participants.filter((p) => !p.leftAt);\n  const others = active.filter((p) => p.userId !== user.id).map((p) => p.userId);\n  return {\n    id: c.id,\n    subject: c.subject,\n    createdById: c.createdById,\n    involvesStudent: c.involvesStudent,\n    lastMessageAt: c.lastMessageAt.toISOString(),\n    participants: c.participants.map((p) => ({ ...toUserSummary(p.user), leftAt: p.leftAt?.toISOString() ?? null })),\n    me: { lastReadAt: me.lastReadAt?.toISOString() ?? null, muted: me.mutedAt !== null, archived: me.archivedAt !== null },\n    canSend: await canSendIn(user, others),\n    canLeave: active.length > 2 && !(c.createdById === user.id && c.involvesStudent),\n  };\n}\nexport type ConversationDetail = Awaited<ReturnType<typeof getConversation>>;\n\n/** FR-6/FR-12/FR-30: contact rules first (403, nothing written), then one transaction with the first message. */\nexport async function createConversation(user: Party, input: CreateConversationInput) {\n  assertRateLimit(user.id);\n  const { participantIds, involvesStudent } = await validateNewConversation(user, input.participantIds);\n  const message = await prisma.$transaction(async (tx) => {\n    const c = await tx.conversation.create({\n      data: {\n        subject: input.subject ?? null,\n        createdById: user.id,\n        involvesStudent,\n        participants: { create: [user.id, ...participantIds].map((userId) => ({ userId })) },\n      },\n    });\n    return insertMessage(tx, user.id, c.id, { body: input.body, fileIds: input.fileIds });\n  });\n  await afterSend(message);\n  return { conversation: await getConversation(user, message.conversationId), message: toMessageDTO(message, user.id) };\n}\n\n/** FR-14: lastReadAt = now; also clears the unread message.received notification and the pending email. */\nexport async function markRead(user: Party, conversationId: string) {\n  await getParticipation(user.id, conversationId);\n  const now = new Date();\n  await prisma.$transaction([\n    prisma.conversationParticipant.update({ where: { conversationId_userId: { conversationId, userId: user.id } }, data: { lastReadAt: now } }),\n    prisma.notification.updateMany({\n      where: { userId: user.id, type: 'message.received', readAt: null, link: conversationLink(conversationId) },\n      data: { readAt: now },\n    }),\n    prisma.pendingMessageEmail.deleteMany({ where: { userId: user.id, conversationId } }),\n  ]);\n  return { lastReadAt: now.toISOString() };\n}\n\nexport async function setMuted(user: Party, conversationId: string, muted: boolean) {\n  await getParticipation(user.id, conversationId);\n  await prisma.conversationParticipant.update({\n    where: { conversationId_userId: { conversationId, userId: user.id } },\n    data: { mutedAt: muted ? new Date() : null },\n  });\n  return { muted };\n}\n\nexport async function setArchived(user: Party, conversationId: string, archived: boolean) {\n  await getParticipation(user.id, conversationId);\n  await prisma.conversationParticipant.update({\n    where: { conversationId_userId: { conversationId, userId: user.id } },\n    data: { archivedAt: archived ? new Date() : null },\n  });\n  return { archived };\n}\n\n/** FR-14/A10: not from 1:1s (archive covers those), and never the creator of a student group. */\nexport async function leave(user: Party, conversationId: string) {\n  await getParticipation(user.id, conversationId);\n  const c = await prisma.conversation.findUniqueOrThrow({\n    where: { id: conversationId },\n    select: { createdById: true, involvesStudent: true, _count: { select: { participants: { where: { leftAt: null } } } } },\n  });\n  if (c._count.participants <= 2) throw new AppError('FORBIDDEN', 'You cannot leave a one-to-one conversation. Archive it instead.', { reason: 'ONE_TO_ONE' });\n  if (c.createdById === user.id && c.involvesStudent) {\n    throw new AppError('FORBIDDEN', 'The creator of a group with students cannot leave it.', { reason: 'CREATOR_OF_STUDENT_GROUP' });\n  }\n  await prisma.$transaction([\n    prisma.conversationParticipant.update({ where: { conversationId_userId: { conversationId, userId: user.id } }, data: { leftAt: new Date() } }),\n    prisma.pendingMessageEmail.deleteMany({ where: { userId: user.id, conversationId } }),\n  ]);\n  return { left: true as const };\n}\n\n/** FR-18: conversations not left with activity after lastReadAt. One raw COUNT (NFR-2). */\nexport async function unreadCount(userId: string): Promise<number> {\n  const [row] = await prisma.$queryRaw<{ count: number }[]>`\n    SELECT COUNT(*)::int AS count\n    FROM \"ConversationParticipant\" p\n    JOIN \"Conversation\" c ON c.id = p.\"conversationId\"\n    WHERE p.\"userId\" = ${userId} AND p.\"leftAt\" IS NULL\n      AND c.\"lastMessageAt\" > COALESCE(p.\"lastReadAt\", 'epoch'::timestamp)`;\n  return row?.count ?? 0;\n}\nimport type { Prisma, ReportStatus } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport type { Party } from './contact-rules';\nimport { assertSafeguardingLead } from './access';\nimport { messageInclude, toAttachment, toUserSummary, userSummarySelect } from './messages';\n\n/**\n * PRD-13 safeguarding (FR-23..FR-25, NFR-1, NFR-3, NFR-11). Every function re-checks the lead flag\n * from the DB. Deleted bodies and edit revisions are visible here and nowhere else. Every view of\n * conversation content writes audit('safeguarding.conversation.view').\n */\n\nconst sgInclude = { ...messageInclude, revisions: { orderBy: { createdAt: 'asc' }, select: { body: true, createdAt: true } } } as const;\ntype SgRow = Prisma.MessageGetPayload<{ include: typeof sgInclude }>;\n\nconst toSgMessage = (m: SgRow) => ({\n  id: m.id,\n  conversationId: m.conversationId,\n  sender: toUserSummary(m.sender),\n  body: m.body,\n  deleted: m.deletedAt !== null,\n  deletedAt: m.deletedAt?.toISOString() ?? null,\n  editedAt: m.editedAt?.toISOString() ?? null,\n  createdAt: m.createdAt.toISOString(),\n  updatedAt: m.updatedAt.toISOString(),\n  attachments: m.attachments.map((a) => toAttachment(a.file)),\n  isOwn: false,\n  canEdit: false,\n  revisions: m.revisions.map((r) => ({ body: r.body, createdAt: r.createdAt.toISOString() })),\n});\nexport type SafeguardingMessageDTO = ReturnType<typeof toSgMessage>;\n\nconst reportInclude = {\n  reporter: { select: userSummarySelect },\n  reviewedBy: { select: userSummarySelect },\n  message: { include: sgInclude },\n} as const;\ntype ReportRow = Prisma.MessageReportGetPayload<{ include: typeof reportInclude }>;\n\nconst toReport = (r: ReportRow) => ({\n  id: r.id,\n  status: r.status,\n  reason: r.reason,\n  reporter: toUserSummary(r.reporter),\n  message: toSgMessage(r.message),\n  conversationId: r.message.conversationId,\n  reviewedBy: r.reviewedBy ? toUserSummary(r.reviewedBy) : null,\n  reviewedAt: r.reviewedAt?.toISOString() ?? null,\n  reviewNote: r.reviewNote,\n  createdAt: r.createdAt.toISOString(),\n});\nexport type ReportDTO = ReturnType<typeof toReport>;\n\nconst participantsOf = async (conversationId: string) =>\n  (\n    await prisma.conversationParticipant.findMany({\n      where: { conversationId },\n      orderBy: { createdAt: 'asc' },\n      select: { leftAt: true, user: { select: userSummarySelect } },\n    })\n  ).map((p) => ({ ...toUserSummary(p.user), leftAt: p.leftAt?.toISOString() ?? null }));\n\nconst viewAudit = (lead: Party, conversationId: string, request?: Request, metadata?: Record<string, unknown>) =>\n  audit({ actorId: lead.id, action: 'safeguarding.conversation.view', entityType: 'Conversation', entityId: conversationId, metadata, request });\n\n/** FR-23: OPEN first (enum order), then newest first. */\nexport async function listReports(lead: Party, opts: { status?: ReportStatus; skip: number; take: number }) {\n  await assertSafeguardingLead(lead);\n  const where: Prisma.MessageReportWhereInput = opts.status ? { status: opts.status } : {};\n  const [total, rows] = await Promise.all([\n    prisma.messageReport.count({ where }),\n    prisma.messageReport.findMany({ where, include: reportInclude, orderBy: [{ status: 'asc' }, { createdAt: 'desc' }], skip: opts.skip, take: opts.take }),\n  ]);\n  return { data: rows.map(toReport), total };\n}\n\n/** FR-23/FR-25: the report, ±5 messages of context (incl. deleted + revisions), participants. Audited. */\nexport async function getReport(lead: Party, reportId: string, request?: Request) {\n  await assertSafeguardingLead(lead);\n  const r = await prisma.messageReport.findUnique({ where: { id: reportId }, include: reportInclude });\n  if (!r) throw new AppError('NOT_FOUND', 'Report not found');\n  const { conversationId, createdAt, id } = r.message;\n  const [before, after, participants] = await Promise.all([\n    prisma.message.findMany({\n      where: { conversationId, OR: [{ createdAt: { lt: createdAt } }, { createdAt, id: { lt: id } }] },\n      include: sgInclude,\n      orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],\n      take: 5,\n    }),\n    prisma.message.findMany({\n      where: { conversationId, OR: [{ createdAt: { gt: createdAt } }, { createdAt, id: { gt: id } }] },\n      include: sgInclude,\n      orderBy: [{ createdAt: 'asc' }, { id: 'asc' }],\n      take: 5,\n    }),\n    participantsOf(conversationId),\n  ]);\n  await viewAudit(lead, conversationId, request, { reportId });\n  return { report: toReport(r), before: before.reverse().map(toSgMessage), after: after.map(toSgMessage), participants };\n}\n\n/** FR-23/NFR-11: review needs a note; only OPEN reports can change (409). Audited. */\nexport async function reviewReport(lead: Party, reportId: string, input: { action: 'review' | 'dismiss'; note?: string }, request?: Request) {\n  await assertSafeguardingLead(lead);\n  if (input.action === 'review' && !input.note) throw new AppError('VALIDATION_ERROR', 'A note is required to mark a report reviewed.');\n  const r = await prisma.messageReport.findUnique({ where: { id: reportId }, select: { status: true, message: { select: { conversationId: true } } } });\n  if (!r) throw new AppError('NOT_FOUND', 'Report not found');\n  // Conditional update closes the race between two leads acting at once.\n  const changed = await prisma.messageReport.updateMany({\n    where: { id: reportId, status: 'OPEN' },\n    data: { status: input.action === 'review' ? 'REVIEWED' : 'DISMISSED', reviewedById: lead.id, reviewedAt: new Date(), reviewNote: input.note ?? null },\n  });\n  if (changed.count !== 1) throw new AppError('CONFLICT', 'This report has already been handled.');\n  await audit({\n    actorId: lead.id,\n    action: `safeguarding.report.${input.action}`,\n    entityType: 'MessageReport',\n    entityId: reportId,\n    metadata: { conversationId: r.message.conversationId, note: input.note ?? null },\n    request,\n  });\n  return { report: toReport(await prisma.messageReport.findUniqueOrThrow({ where: { id: reportId }, include: reportInclude })) };\n}\n\n/** FR-24: involvesStudent conversations only; from/to select conversations active in the range. */\nexport async function searchConversations(lead: Party, opts: { participantId?: string; from?: Date; to?: Date; skip: number; take: number }) {\n  await assertSafeguardingLead(lead);\n  const where: Prisma.ConversationWhereInput = {\n    involvesStudent: true,\n    ...(opts.participantId ? { participants: { some: { userId: opts.participantId } } } : {}),\n    ...(opts.from ? { lastMessageAt: { gte: opts.from } } : {}),\n    ...(opts.to ? { createdAt: { lte: opts.to } } : {}),\n  };\n  const [total, rows] = await Promise.all([\n    prisma.conversation.count({ where }),\n    prisma.conversation.findMany({\n      where,\n      orderBy: [{ lastMessageAt: 'desc' }, { id: 'desc' }],\n      skip: opts.skip,\n      take: opts.take,\n      include: { participants: { select: { user: { select: userSummarySelect } } }, _count: { select: { messages: true } } },\n    }),\n  ]);\n  const open = await prisma.messageReport.findMany({\n    where: { status: 'OPEN', message: { conversationId: { in: rows.map((r) => r.id) } } },\n    select: { message: { select: { conversationId: true } } },\n  });\n  const openBy = new Map<string, number>();\n  for (const o of open) openBy.set(o.message.conversationId, (openBy.get(o.message.conversationId) ?? 0) + 1);\n  return {\n    data: rows.map((c) => ({\n      id: c.id,\n      subject: c.subject,\n      participants: c.participants.map((p) => toUserSummary(p.user)),\n      createdAt: c.createdAt.toISOString(),\n      lastMessageAt: c.lastMessageAt.toISOString(),\n      messageCount: c._count.messages,\n      openReportCount: openBy.get(c.id) ?? 0,\n    })),\n    total,\n  };\n}\n\n/** FR-24/FR-25: full read-only thread incl. deleted content and revisions; 404 unless involvesStudent. Audited on every call. */\nexport async function getConversationForSafeguarding(lead: Party, conversationId: string, request?: Request) {\n  await assertSafeguardingLead(lead);\n  const c = await prisma.conversation.findUnique({ where: { id: conversationId } });\n  if (!c || !c.involvesStudent) throw new AppError('NOT_FOUND', 'Conversation not found');\n  const [participants, messages] = await Promise.all([\n    participantsOf(conversationId),\n    prisma.message.findMany({ where: { conversationId }, include: sgInclude, orderBy: [{ createdAt: 'asc' }, { id: 'asc' }] }),\n  ]);\n  await viewAudit(lead, conversationId, request);\n  return {\n    conversation: {\n      id: c.id,\n      subject: c.subject,\n      createdById: c.createdById,\n      involvesStudent: c.involvesStudent,\n      lastMessageAt: c.lastMessageAt.toISOString(),\n      participants,\n    },\n    messages: messages.map(toSgMessage),\n  };\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"b2a19e14-003d-496b-9902-59b2c0434c99","uuid":"285b84fc-7268-471a-8558-b415ea56abb9","timestamp":"2026-11-09T17:57:33.181Z","tool_use_result":{"stdout":"tests/integration/messaging/email.test.ts:61:  it('sends one email (no extra in-app row) when unread and outside quiet hours', async () => {\ntests/integration/messaging/email.test.ts:71:  it('drops the email when the recipient read the conversation after it was queued', async () => {\ntests/integration/messaging/email.test.ts:79:  it('drops the email for a muted recipient', async () => {\ntests/integration/messaging/email.test.ts:86:  it('defers to the end of quiet hours (school timezone), keeping the original createdAt', async () => {\ntests/integration/messaging/messaging.test.ts:70:  it('FR-19/FR-20: three sends leave one unread notification and one pending email (first message starts the clock)', async () => {\ntests/integration/messaging/messaging.test.ts:90:  it('FR-19: muted participants get no notification and no pending email', async () => {\ntests/integration/messaging/messaging.test.ts:99:  it('NFR-4: the 31st message in a minute is 429 RATE_LIMITED with retryAfterMs', async () => {\ntests/integration/messaging/messaging.test.ts:107:  it('NFR-1/A7: non-participants and participants who left get 404', async () => {\ntests/integration/messaging/messaging.test.ts:122:  it('FR-3/FR-15: edit stores a revision; 15-minute window; soft delete is redacted for users only', async () => {\ntests/integration/messaging/messaging.test.ts:139:  it('FR-13/A9: the after+since poll returns new messages and edits since the given time', async () => {\ntests/integration/messaging/messaging.test.ts:152:  it('A12/FR-26: duplicate OPEN report is 409; own message 403; leads are notified', async () => {\ntests/integration/messaging/messaging.test.ts:163:  it('FR-6/FR-7: student↔student is 403 on create; a dropped student cannot send but the teacher still can', async () => {\ntests/integration/messaging/messaging.test.ts:177:  it('FR-30/A11: involvesStudent is computed; a new message unarchives for recipients', async () => {\ntests/integration/messaging/safeguarding.test.ts:73:  it('NFR-1/FR-23: non-lead admins and teachers get 403 everywhere', async () => {\ntests/integration/messaging/safeguarding.test.ts:81:  it('FR-24/FR-25/NFR-3: student conversations only; deleted body and revisions visible; every view audited', async () => {\ntests/integration/messaging/safeguarding.test.ts:93:  it('FR-23/NFR-11: report detail is audited; review needs a note; a handled report is 409', async () => {\ntests/integration/messaging/safeguarding.test.ts:111:  it('FR-2: isSafeguardingLead can only be set on an ADMIN, and the change is audited', async () => {\ntests/e2e/messaging.spec.ts:50:test('parent → teacher round trip appears in the other open thread within 6 s', async ({ browser }) => {\ntests/e2e/messaging.spec.ts:85:test('student → student is absent from the picker and POST /api/conversations returns 403', async ({ page }) => {\nimport { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { DELETED_TEXT } from '@/lib/messaging/constants';\nimport type { CreateConversationInput } from '@/lib/validators/messaging';\nimport { canSendIn, validateNewConversation, type Party } from './contact-rules';\nimport { getParticipation } from './access';\nimport { conversationLink } from './notifications';\nimport { afterSend, assertRateLimit, insertMessage, toMessageDTO, toUserSummary, userSummarySelect } from './messages';\n\n/** PRD-13 conversation service (FR-6, FR-9, FR-12, FR-14, FR-18, FR-30, FR-31, NFR-2). */\n\nconst PREVIEW_MAX = 80;\n\nexport async function listConversations(\n  user: Party,\n  opts: { archived?: boolean; q?: string; skip: number; take: number },\n) {\n  const where: Prisma.ConversationWhereInput = {\n    participants: { some: { userId: user.id, leftAt: null, archivedAt: opts.archived ? { not: null } : null } },\n  };\n  if (opts.q) {\n    const contains = { contains: opts.q, mode: 'insensitive' as const };\n    where.OR = [\n      { subject: contains },\n      { participants: { some: { userId: { not: user.id }, user: { OR: [{ firstName: contains }, { lastName: contains }] } } } },\n    ];\n  }\n  const [total, rows] = await Promise.all([\n    prisma.conversation.count({ where }),\n    prisma.conversation.findMany({\n      where,\n      orderBy: [{ lastMessageAt: 'desc' }, { id: 'desc' }],\n      skip: opts.skip,\n      take: opts.take,\n      include: {\n        participants: { select: { userId: true, leftAt: true, mutedAt: true, archivedAt: true, user: { select: userSummarySelect } } },\n        messages: { orderBy: [{ createdAt: 'desc' }, { id: 'desc' }], take: 1, select: { body: true, deletedAt: true, sender: { select: { firstName: true } } } },\n      },\n    }),\n  ]);\n\n  const unread = new Map<string, number>();\n  if (rows.length) {\n    // One LATERAL COUNT over the page, capped at 99 per row (NFR-2).\n    const counts = await prisma.$queryRaw<{ id: string; unread: number }[]>`\n      SELECT p.\"conversationId\" AS id, c.cnt::int AS unread\n      FROM \"ConversationParticipant\" p\n      CROSS JOIN LATERAL (\n        SELECT COUNT(*) AS cnt FROM (\n          SELECT 1 FROM \"Message\" m\n          WHERE m.\"conversationId\" = p.\"conversationId\" AND m.\"senderId\" <> p.\"userId\" AND m.\"deletedAt\" IS NULL\n            AND m.\"createdAt\" > COALESCE(p.\"lastReadAt\", 'epoch'::timestamp)\n          LIMIT 99\n        ) x\n      ) c\n      WHERE p.\"userId\" = ${user.id} AND p.\"conversationId\" IN (${Prisma.join(rows.map((r) => r.id))})`;\n    for (const c of counts) unread.set(c.id, c.unread);\n  }\n\n  const data = rows.map((c) => {\n    const me = c.participants.find((p) => p.userId === user.id)!;\n    const last = c.messages[0];\n    const preview = !last\n      ? null\n      : last.deletedAt\n        ? DELETED_TEXT\n        : `${last.sender.firstName}: ${last.body.length > PREVIEW_MAX ? `${last.body.slice(0, PREVIEW_MAX - 1)}…` : last.body}`;\n    return {\n      id: c.id,\n      subject: c.subject,\n      participants: c.participants.filter((p) => p.userId !== user.id && !p.leftAt).map((p) => toUserSummary(p.user)),\n      preview,\n      lastMessageAt: c.lastMessageAt.toISOString(),\n      unreadCount: unread.get(c.id) ?? 0,\n      muted: me.mutedAt !== null,\n      archived: me.archivedAt !== null,\n    };\n  });\n  return { data, total };\n}\n\nexport async function getConversation(user: Party, conversationId: string) {\n  const me = await getParticipation(user.id, conversationId);\n  const c = await prisma.conversation.findUniqueOrThrow({\n    where: { id: conversationId },\n    include: { participants: { orderBy: { createdAt: 'asc' }, select: { userId: true, leftAt: true, user: { select: userSummarySelect } } } },\n  });\n  const active = c.participants.filter((p) => !p.leftAt);\n  const others = active.filter((p) => p.userId !== user.id).map((p) => p.userId);\n  return {\n    id: c.id,\n    subject: c.subject,\n    createdById: c.createdById,\n    involvesStudent: c.involvesStudent,\n    lastMessageAt: c.lastMessageAt.toISOString(),\n    participants: c.participants.map((p) => ({ ...toUserSummary(p.user), leftAt: p.leftAt?.toISOString() ?? null })),\n    me: { lastReadAt: me.lastReadAt?.toISOString() ?? null, muted: me.mutedAt !== null, archived: me.archivedAt !== null },\n    canSend: await canSendIn(user, others),\n    canLeave: active.length > 2 && !(c.createdById === user.id && c.involvesStudent),\n  };\n}\nexport type ConversationDetail = Awaited<ReturnType<typeof getConversation>>;\n\n/** FR-6/FR-12/FR-30: contact rules first (403, nothing written), then one transaction with the first message. */\nexport async function createConversation(user: Party, input: CreateConversationInput) {\n  assertRateLimit(user.id);\n  const { participantIds, involvesStudent } = await validateNewConversation(user, input.participantIds);\n  const message = await prisma.$transaction(async (tx) => {\n    const c = await tx.conversation.create({\n      data: {\n        subject: input.subject ?? null,\n        createdById: user.id,\n        involvesStudent,\n        participants: { create: [user.id, ...participantIds].map((userId) => ({ userId })) },\n      },\n    });\n    return insertMessage(tx, user.id, c.id, { body: input.body, fileIds: input.fileIds });\n  });\n  await afterSend(message);\n  return { conversation: await getConversation(user, message.conversationId), message: toMessageDTO(message, user.id) };\n}\n\n/** FR-14: lastReadAt = now; also clears the unread message.received notification and the pending email. */\nexport async function markRead(user: Party, conversationId: string) {\n  await getParticipation(user.id, conversationId);\n  const now = new Date();\n  await prisma.$transaction([\n    prisma.conversationParticipant.update({ where: { conversationId_userId: { conversationId, userId: user.id } }, data: { lastReadAt: now } }),\n    prisma.notification.updateMany({\n      where: { userId: user.id, type: 'message.received', readAt: null, link: conversationLink(conversationId) },\n      data: { readAt: now },\n    }),\n    prisma.pendingMessageEmail.deleteMany({ where: { userId: user.id, conversationId } }),\n  ]);\n  return { lastReadAt: now.toISOString() };\n}\n\nexport async function setMuted(user: Party, conversationId: string, muted: boolean) {\n  await getParticipation(user.id, conversationId);\n  await prisma.conversationParticipant.update({\n    where: { conversationId_userId: { conversationId, userId: user.id } },\n    data: { mutedAt: muted ? new Date() : null },\n  });\n  return { muted };\n}\n\nexport async function setArchived(user: Party, conversationId: string, archived: boolean) {\n  await getParticipation(user.id, conversationId);\n  await prisma.conversationParticipant.update({\n    where: { conversationId_userId: { conversationId, userId: user.id } },\n    data: { archivedAt: archived ? new Date() : null },\n  });\n  return { archived };\n}\n\n/** FR-14/A10: not from 1:1s (archive covers those), and never the creator of a student group. */\nexport async function leave(user: Party, conversationId: string) {\n  await getParticipation(user.id, conversationId);\n  const c = await prisma.conversation.findUniqueOrThrow({\n    where: { id: conversationId },\n    select: { createdById: true, involvesStudent: true, _count: { select: { participants: { where: { leftAt: null } } } } },\n  });\n  if (c._count.participants <= 2) throw new AppError('FORBIDDEN', 'You cannot leave a one-to-one conversation. Archive it instead.', { reason: 'ONE_TO_ONE' });\n  if (c.createdById === user.id && c.involvesStudent) {\n    throw new AppError('FORBIDDEN', 'The creator of a group with students cannot leave it.', { reason: 'CREATOR_OF_STUDENT_GROUP' });\n  }\n  await prisma.$transaction([\n    prisma.conversationParticipant.update({ where: { conversationId_userId: { conversationId, userId: user.id } }, data: { leftAt: new Date() } }),\n    prisma.pendingMessageEmail.deleteMany({ where: { userId: user.id, conversationId } }),\n  ]);\n  return { left: true as const };\n}\n\n/** FR-18: conversations not left with activity after lastReadAt. One raw COUNT (NFR-2). */\nexport async function unreadCount(userId: string): Promise<number> {\n  const [row] = await prisma.$queryRaw<{ count: number }[]>`\n    SELECT COUNT(*)::int AS count\n    FROM \"ConversationParticipant\" p\n    JOIN \"Conversation\" c ON c.id = p.\"conversationId\"\n    WHERE p.\"userId\" = ${userId} AND p.\"leftAt\" IS NULL\n      AND c.\"lastMessageAt\" > COALESCE(p.\"lastReadAt\", 'epoch'::timestamp)`;\n  return row?.count ?? 0;\n}\nimport type { Prisma, ReportStatus } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport type { Party } from './contact-rules';\nimport { assertSafeguardingLead } from './access';\nimport { messageInclude, toAttachment, toUserSummary, userSummarySelect } from './messages';\n\n/**\n * PRD-13 safeguarding (FR-23..FR-25, NFR-1, NFR-3, NFR-11). Every function re-checks the lead flag\n * from the DB. Deleted bodies and edit revisions are visible here and nowhere else. Every view of\n * conversation content writes audit('safeguarding.conversation.view').\n */\n\nconst sgInclude = { ...messageInclude, revisions: { orderBy: { createdAt: 'asc' }, select: { body: true, createdAt: true } } } as const;\ntype SgRow = Prisma.MessageGetPayload<{ include: typeof sgInclude }>;\n\nconst toSgMessage = (m: SgRow) => ({\n  id: m.id,\n  conversationId: m.conversationId,\n  sender: toUserSummary(m.sender),\n  body: m.body,\n  deleted: m.deletedAt !== null,\n  deletedAt: m.deletedAt?.toISOString() ?? null,\n  editedAt: m.editedAt?.toISOString() ?? null,\n  createdAt: m.createdAt.toISOString(),\n  updatedAt: m.updatedAt.toISOString(),\n  attachments: m.attachments.map((a) => toAttachment(a.file)),\n  isOwn: false,\n  canEdit: false,\n  revisions: m.revisions.map((r) => ({ body: r.body, createdAt: r.createdAt.toISOString() })),\n});\nexport type SafeguardingMessageDTO = ReturnType<typeof toSgMessage>;\n\nconst reportInclude = {\n  reporter: { select: userSummarySelect },\n  reviewedBy: { select: userSummarySelect },\n  message: { include: sgInclude },\n} as const;\ntype ReportRow = Prisma.MessageReportGetPayload<{ include: typeof reportInclude }>;\n\nconst toReport = (r: ReportRow) => ({\n  id: r.id,\n  status: r.status,\n  reason: r.reason,\n  reporter: toUserSummary(r.reporter),\n  message: toSgMessage(r.message),\n  conversationId: r.message.conversationId,\n  reviewedBy: r.reviewedBy ? toUserSummary(r.reviewedBy) : null,\n  reviewedAt: r.reviewedAt?.toISOString() ?? null,\n  reviewNote: r.reviewNote,\n  createdAt: r.createdAt.toISOString(),\n});\nexport type ReportDTO = ReturnType<typeof toReport>;\n\nconst participantsOf = async (conversationId: string) =>\n  (\n    await prisma.conversationParticipant.findMany({\n      where: { conversationId },\n      orderBy: { createdAt: 'asc' },\n      select: { leftAt: true, user: { select: userSummarySelect } },\n    })\n  ).map((p) => ({ ...toUserSummary(p.user), leftAt: p.leftAt?.toISOString() ?? null }));\n\nconst viewAudit = (lead: Party, conversationId: string, request?: Request, metadata?: Record<string, unknown>) =>\n  audit({ actorId: lead.id, action: 'safeguarding.conversation.view', entityType: 'Conversation', entityId: conversationId, metadata, request });\n\n/** FR-23: OPEN first (enum order), then newest first. */\nexport async function listReports(lead: Party, opts: { status?: ReportStatus; skip: number; take: number }) {\n  await assertSafeguardingLead(lead);\n  const where: Prisma.MessageReportWhereInput = opts.status ? { status: opts.status } : {};\n  const [total, rows] = await Promise.all([\n    prisma.messageReport.count({ where }),\n    prisma.messageReport.findMany({ where, include: reportInclude, orderBy: [{ status: 'asc' }, { createdAt: 'desc' }], skip: opts.skip, take: opts.take }),\n  ]);\n  return { data: rows.map(toReport), total };\n}\n\n/** FR-23/FR-25: the report, ±5 messages of context (incl. deleted + revisions), participants. Audited. */\nexport async function getReport(lead: Party, reportId: string, request?: Request) {\n  await assertSafeguardingLead(lead);\n  const r = await prisma.messageReport.findUnique({ where: { id: reportId }, include: reportInclude });\n  if (!r) throw new AppError('NOT_FOUND', 'Report not found');\n  const { conversationId, createdAt, id } = r.message;\n  const [before, after, participants] = await Promise.all([\n    prisma.message.findMany({\n      where: { conversationId, OR: [{ createdAt: { lt: createdAt } }, { createdAt, id: { lt: id } }] },\n      include: sgInclude,\n      orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],\n      take: 5,\n    }),\n    prisma.message.findMany({\n      where: { conversationId, OR: [{ createdAt: { gt: createdAt } }, { createdAt, id: { gt: id } }] },\n      include: sgInclude,\n      orderBy: [{ createdAt: 'asc' }, { id: 'asc' }],\n      take: 5,\n    }),\n    participantsOf(conversationId),\n  ]);\n  await viewAudit(lead, conversationId, request, { reportId });\n  return { report: toReport(r), before: before.reverse().map(toSgMessage), after: after.map(toSgMessage), participants };\n}\n\n/** FR-23/NFR-11: review needs a note; only OPEN reports can change (409). Audited. */\nexport async function reviewReport(lead: Party, reportId: string, input: { action: 'review' | 'dismiss'; note?: string }, request?: Request) {\n  await assertSafeguardingLead(lead);\n  if (input.action === 'review' && !input.note) throw new AppError('VALIDATION_ERROR', 'A note is required to mark a report reviewed.');\n  const r = await prisma.messageReport.findUnique({ where: { id: reportId }, select: { status: true, message: { select: { conversationId: true } } } });\n  if (!r) throw new AppError('NOT_FOUND', 'Report not found');\n  // Conditional update closes the race between two leads acting at once.\n  const changed = await prisma.messageReport.updateMany({\n    where: { id: reportId, status: 'OPEN' },\n    data: { status: input.action === 'review' ? 'REVIEWED' : 'DISMISSED', reviewedById: lead.id, reviewedAt: new Date(), reviewNote: input.note ?? null },\n  });\n  if (changed.count !== 1) throw new AppError('CONFLICT', 'This report has already been handled.');\n  await audit({\n    actorId: lead.id,\n    action: `safeguarding.report.${input.action}`,\n    entityType: 'MessageReport',\n    entityId: reportId,\n    metadata: { conversationId: r.message.conversationId, note: input.note ?? null },\n    request,\n  });\n  return { report: toReport(await prisma.messageReport.findUniqueOrThrow({ where: { id: reportId }, include: reportInclude })) };\n}\n\n/** FR-24: involvesStudent conversations only; from/to select conversations active in the range. */\nexport async function searchConversations(lead: Party, opts: { participantId?: string; from?: Date; to?: Date; skip: number; take: number }) {\n  await assertSafeguardingLead(lead);\n  const where: Prisma.ConversationWhereInput = {\n    involvesStudent: true,\n    ...(opts.participantId ? { participants: { some: { userId: opts.participantId } } } : {}),\n    ...(opts.from ? { lastMessageAt: { gte: opts.from } } : {}),\n    ...(opts.to ? { createdAt: { lte: opts.to } } : {}),\n  };\n  const [total, rows] = await Promise.all([\n    prisma.conversation.count({ where }),\n    prisma.conversation.findMany({\n      where,\n      orderBy: [{ lastMessageAt: 'desc' }, { id: 'desc' }],\n      skip: opts.skip,\n      take: opts.take,\n      include: { participants: { select: { user: { select: userSummarySelect } } }, _count: { select: { messages: true } } },\n    }),\n  ]);\n  const open = await prisma.messageReport.findMany({\n    where: { status: 'OPEN', message: { conversationId: { in: rows.map((r) => r.id) } } },\n    select: { message: { select: { conversationId: true } } },\n  });\n  const openBy = new Map<string, number>();\n  for (const o of open) openBy.set(o.message.conversationId, (openBy.get(o.message.conversationId) ?? 0) + 1);\n  return {\n    data: rows.map((c) => ({\n      id: c.id,\n      subject: c.subject,\n      participants: c.participants.map((p) => toUserSummary(p.user)),\n      createdAt: c.createdAt.toISOString(),\n      lastMessageAt: c.lastMessageAt.toISOString(),\n      messageCount: c._count.messages,\n      openReportCount: openBy.get(c.id) ?? 0,\n    })),\n    total,\n  };\n}\n\n/** FR-24/FR-25: full read-only thread incl. deleted content and revisions; 404 unless involvesStudent. Audited on every call. */\nexport async function getConversationForSafeguarding(lead: Party, conversationId: string, request?: Request) {\n  await assertSafeguardingLead(lead);\n  const c = await prisma.conversation.findUnique({ where: { id: conversationId } });\n  if (!c || !c.involvesStudent) throw new AppError('NOT_FOUND', 'Conversation not found');\n  const [participants, messages] = await Promise.all([\n    participantsOf(conversationId),\n    prisma.message.findMany({ where: { conversationId }, include: sgInclude, orderBy: [{ createdAt: 'asc' }, { id: 'asc' }] }),\n  ]);\n  await viewAudit(lead, conversationId, request);\n  return {\n    conversation: {\n      id: c.id,\n      subject: c.subject,\n      createdById: c.createdById,\n      involvesStudent: c.involvesStudent,\n      lastMessageAt: c.lastMessageAt.toISOString(),\n      participants,\n    },\n    messages: messages.map(toSgMessage),\n  };\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01E5yYCpug8HBFQd1SVDGjVo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
