{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TS1sZ7YE2SspuyUV9rDmeH","type":"tool_result","content":"import { createHash, randomUUID } from 'node:crypto';\nimport { createReadStream, createWriteStream } from 'node:fs';\nimport { mkdir, rename, unlink } from 'node:fs/promises';\nimport path from 'node:path';\nimport { Transform, type Readable } from 'node:stream';\nimport { pipeline } from 'node:stream/promises';\nimport { env } from '@/lib/env';\n\n/**\n * Local-disk file storage (PRD-08 FR-2, NFR-5, NFR-11). Single implementation,\n * no interface: bytes live under UPLOAD_DIR (never public/) and are only ever\n * served through GET /api/files/:id.\n */\n\nfunction root(): string {\n  // Read per call so tests can point UPLOAD_DIR at a temp dir.\n  return path.resolve(process.env.UPLOAD_DIR || env.UPLOAD_DIR);\n}\n\n/** Absolute path for a storage key; throws if the key escapes UPLOAD_DIR (traversal guard). */\nexport function resolveKey(storageKey: string): string {\n  const base = root();\n  const full = path.resolve(base, storageKey);\n  if (!full.startsWith(base + path.sep)) throw new Error('Invalid storage key');\n  return full;\n}\n\nexport interface SavedFile {\n  storageKey: string;\n  sizeBytes: number;\n  sha256: string;\n}\n\n/**\n * Streams `stream` to UPLOAD_DIR/.tmp, hashing and counting bytes on the way,\n * then renames to <yyyy>/<mm>/<id>.<ext>. On any stream error (including an\n * abort for oversize/bad type) the tmp file is removed and the error rethrown.\n */\nexport async function saveFile(stream: Readable, meta: { ext: string }): Promise<SavedFile> {\n  const base = root();\n  const id = randomUUID().replace(/-/g, '');\n  const tmpDir = path.join(base, '.tmp');\n  await mkdir(tmpDir, { recursive: true });\n  const tmp = path.join(tmpDir, id);\n\n  const hash = createHash('sha256');\n  let sizeBytes = 0;\n  const tap = new Transform({\n    transform(chunk: Buffer, _enc, cb) {\n      hash.update(chunk);\n      sizeBytes += chunk.length;\n      cb(null, chunk);\n    },\n  });\n\n  try {\n    await pipeline(stream, tap, createWriteStream(tmp));\n  } catch (error) {\n    await unlink(tmp).catch(() => undefined);\n    throw error;\n  }\n\n  const now = new Date();\n  const ext = meta.ext.toLowerCase().replace(/[^a-z0-9]/g, '');\n  const storageKey = `${now.getUTCFullYear()}/${String(now.getUTCMonth() + 1).padStart(2, '0')}/${id}${ext ? `.${ext}` : ''}`;\n  const dest = resolveKey(storageKey);\n  await mkdir(path.dirname(dest), { recursive: true });\n  await rename(tmp, dest);\n  return { storageKey, sizeBytes, sha256: hash.digest('hex') };\n}\n\nexport function readFile(storageKey: string): Readable {\n  return createReadStream(resolveKey(storageKey));\n}\n\n/** Removes stored bytes; a missing file is not an error. */\nexport async function deleteFile(storageKey: string): Promise<void> {\n  try {\n    await unlink(resolveKey(storageKey));\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;\n  }\n}\nimport type { FileObject } from '@prisma/client';\nimport { registerBuiltInContexts } from './contexts';\n\n/**\n * File access registry (PRD-08 FR-9, NFR-1). Every download goes through\n * canAccessFile. Later PRDs call registerFileAccess for their own contexts.\n */\n\nexport interface FileAccessUser {\n  id: string;\n  role: string;\n}\n\nexport type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\n\n/** Resolvers receive null for anonymous callers; only return true for null if the context is public. */\nexport type FileAccessResolver = (user: FileAccessUser | null, file: FileAccessFile) => boolean | Promise<boolean>;\n\nconst registry = new Map<string, FileAccessResolver>();\n\nexport function registerFileAccess(context: string, resolver: FileAccessResolver): void {\n  registry.set(context, resolver);\n}\n\nconst ownerOrAdmin = (user: FileAccessUser | null, file: FileAccessFile) =>\n  user !== null && (user.role === 'ADMIN' || user.id === file.ownerId);\n\nlet builtInsRegistered = false;\n\n/**\n * Dispatch order: (1) unattached -> owner/ADMIN; (2) registered resolver;\n * (3) unknown context -> owner/ADMIN. Anonymous is denied except where a\n * resolver explicitly accepts null. Resolver errors deny.\n */\nexport async function canAccessFile(user: FileAccessUser | null, file: FileAccessFile): Promise<boolean> {\n  // Lazy so the circular import with contexts.ts never hits an uninitialised registry,\n  // and no caller can forget to load the built-in contexts.\n  if (!builtInsRegistered) {\n    builtInsRegistered = true;\n    registerBuiltInContexts(registerFileAccess);\n  }\n  if (file.contextId === null) return ownerOrAdmin(user, file);\n  const resolver = registry.get(file.context);\n  if (!resolver) return ownerOrAdmin(user, file);\n  try {\n    return (await resolver(user, file)) === true;\n  } catch {\n    return false;\n  }\n}\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n}\nimport { Readable } from 'node:stream';\nimport type { ReadableStream as NodeWebReadableStream } from 'node:stream/web';\nimport type { FileObject, Prisma } from '@prisma/client';\n// @ts-expect-error -- ponytail: busboy ships without types and comes transitively via next (ADR-2); add @types/busboy if it becomes a direct dep.\nimport busboy from 'busboy';\nimport { fileTypeFromBuffer } from 'file-type';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { rateLimit } from '@/server/rate-limit';\nimport { env } from '@/lib/env';\nimport { deleteFile, readFile, saveFile } from '@/server/storage';\nimport { canAccessFile, type FileAccessUser } from './access';\nimport { checkType, extOf, maxBytesFor, sanitizeFilename } from './validate';\n\n/**\n * File business logic (PRD-08 FR-3, FR-8, FR-11, FR-17, FR-46, NFR-3, NFR-5).\n * Route handlers in src/app/api/files stay thin.\n */\n\nconst HEAD_BYTES = 4100;\nconst MULTIPART_SLACK = 64 * 1024;\nconst CONTEXT_RE = /^[a-z][a-z0-9_-]{0,39}$/;\nconst UPLOADS_PER_HOUR = 60;\n\nexport interface FileSummary {\n  id: string;\n  originalName: string;\n  mimeType: string;\n  sizeBytes: number;\n}\n\nexport const toSummary = (f: Pick<FileObject, 'id' | 'originalName' | 'mimeType' | 'sizeBytes'>): FileSummary => ({\n  id: f.id,\n  originalName: f.originalName,\n  mimeType: f.mimeType,\n  sizeBytes: f.sizeBytes,\n});\n\nfunction maxUploadMb(): number {\n  const fromProcess = Number(process.env.MAX_UPLOAD_MB);\n  return Number.isInteger(fromProcess) && fromProcess > 0 ? fromProcess : env.MAX_UPLOAD_MB;\n}\n\n/** Lets busboy reach 'close' after we stop reading a part (the async iterator's 'readable' listener blocks resume()). */\nfunction drain(stream: Readable): void {\n  stream.removeAllListeners('readable');\n  stream.resume();\n}\n\nconst tooBig = (maxBytes: number) =>\n  new AppError('VALIDATION_ERROR', `File exceeds ${Math.round(maxBytes / (1024 * 1024))} MB.`);\n\n/** Streams one file part to disk: sniff the head, then hash+count while writing (NFR-5). */\nasync function storePart(\n  user: FileAccessUser,\n  context: string,\n  filename: string,\n  stream: Readable & { truncated?: boolean },\n  maxBytes: number,\n): Promise<FileSummary> {\n  const originalName = sanitizeFilename(filename);\n  const ext = extOf(originalName);\n\n  // Peek the first HEAD_BYTES without buffering the rest.\n  const iterator = stream[Symbol.asyncIterator]() as AsyncIterator<Buffer>;\n  const headChunks: Buffer[] = [];\n  let headLength = 0;\n  let done = false;\n  while (headLength < HEAD_BYTES) {\n    const next = await iterator.next();\n    if (next.done) {\n      done = true;\n      break;\n    }\n    headChunks.push(next.value);\n    headLength += next.value.length;\n  }\n  const head = Buffer.concat(headChunks);\n  const sniffed = head.length ? (await fileTypeFromBuffer(head))?.mime : undefined;\n  const check = checkType(ext, sniffed, context, head);\n  if (!check.ok) {\n    drain(stream);\n    throw new AppError('VALIDATION_ERROR', check.error);\n  }\n  if (head.length === 0) {\n    throw new AppError('VALIDATION_ERROR', 'File is empty.');\n  }\n\n  async function* body() {\n    let total = head.length;\n    if (total > maxBytes) throw tooBig(maxBytes);\n    yield head;\n    if (!done) {\n      for (let next = await iterator.next(); !next.done; next = await iterator.next()) {\n        total += next.value.length;\n        // Per-context cap (logo 2 MB) is enforced here mid-stream; saveFile unlinks the tmp file.\n        if (total > maxBytes) throw tooBig(maxBytes);\n        yield next.value;\n      }\n    }\n    // busboy stops emitting at limits.fileSize and marks the stream truncated.\n    if (stream.truncated) throw tooBig(maxBytes);\n  }\n\n  const saved = await saveFile(Readable.from(body()), { ext });\n  const row = await prisma.fileObject.create({\n    data: {\n      ownerId: user.id,\n      originalName,\n      mimeType: check.mime,\n      sizeBytes: saved.sizeBytes,\n      storageKey: saved.storageKey,\n      sha256: saved.sha256,\n      context,\n      contextId: null,\n    },\n  });\n  return toSummary(row);\n}\n\n/** POST /api/files: multipart with a `context` field BEFORE the `file` part (ADR-2). */\nexport async function uploadFile(user: FileAccessUser, request: Request): Promise<FileSummary> {\n  const limit = rateLimit(`upload:${user.id}`, UPLOADS_PER_HOUR, 3_600_000);\n  if (!limit.ok) {\n    throw new AppError('RATE_LIMITED', 'Too many uploads. Try again later.', {\n      retryAfterSeconds: Math.ceil(limit.retryAfterMs / 1000),\n    });\n  }\n\n  const contentType = request.headers.get('content-type') ?? '';\n  if (!contentType.startsWith('multipart/form-data') || !request.body) {\n    throw new AppError('VALIDATION_ERROR', 'Expected multipart/form-data.');\n  }\n  const globalMax = maxBytesFor('lesson', maxUploadMb());\n  const declared = Number(request.headers.get('content-length'));\n  if (Number.isFinite(declared) && declared > globalMax + MULTIPART_SLACK) throw tooBig(globalMax);\n\n  return new Promise<FileSummary>((resolve, reject) => {\n    let context: string | null = null;\n    let work: Promise<FileSummary> | null = null;\n    let parser: ReturnType<typeof busboy>;\n    try {\n      parser = busboy({\n        headers: { 'content-type': contentType },\n        limits: { files: 1, fields: 5, fileSize: globalMax },\n      });\n    } catch {\n      reject(new AppError('VALIDATION_ERROR', 'Malformed multipart body.'));\n      return;\n    }\n\n    parser.on('field', (name: string, value: string) => {\n      if (name === 'context') context = value;\n    });\n\n    parser.on('file', (_name: string, stream: Readable & { truncated?: boolean }, info: { filename?: string }) => {\n      if (work) {\n        drain(stream);\n        return;\n      }\n      if (!context || !CONTEXT_RE.test(context)) {\n        drain(stream);\n        work = Promise.reject(new AppError('VALIDATION_ERROR', 'A valid context field must precede the file.'));\n        work.catch(() => undefined);\n        return;\n      }\n      work = storePart(user, context, info.filename ?? 'file', stream, maxBytesFor(context, maxUploadMb()));\n      // On failure keep draining so busboy reaches 'close' and the promise settles.\n      work.catch(() => drain(stream));\n    });\n\n    parser.on('error', () => reject(new AppError('VALIDATION_ERROR', 'Malformed multipart body.')));\n    parser.on('close', () => {\n      if (!work) reject(new AppError('VALIDATION_ERROR', 'No file was uploaded.'));\n      else work.then(resolve, reject);\n    });\n\n    Readable.fromWeb(request.body as unknown as NodeWebReadableStream).on('error', reject).pipe(parser);\n  });\n}\n\n/** Loads the row and runs the registry; denial is NOT_FOUND before any bytes are read (FR-9, NFR-1). */\nexport async function getFileForDownload(user: FileAccessUser | null, id: string) {\n  const file = await prisma.fileObject.findUnique({ where: { id } });\n  if (!file || !(await canAccessFile(user, file))) throw new AppError('NOT_FOUND', 'File not found');\n  return { file, stream: readFile(file.storageKey) };\n}\n\n/** FR-11: owner or ADMIN, only while unattached. Row first, then bytes. */\nexport async function deleteUnattachedFile(user: FileAccessUser, id: string, request?: Request): Promise<void> {\n  const file = await prisma.fileObject.findUnique({ where: { id } });\n  if (!file || (user.role !== 'ADMIN' && file.ownerId !== user.id)) throw new AppError('NOT_FOUND', 'File not found');\n  if (file.contextId !== null) throw new AppError('CONFLICT', 'File is attached and cannot be deleted.');\n  await prisma.fileObject.delete({ where: { id } });\n  await deleteFile(file.storageKey);\n  if (file.ownerId !== user.id) {\n    await audit({\n      actorId: user.id,\n      action: 'file.delete',\n      entityType: 'FileObject',\n      entityId: id,\n      metadata: { ownerId: file.ownerId, originalName: file.originalName },\n      request,\n    });\n  }\n}\n\ntype Tx = Prisma.TransactionClient;\n\n/**\n * FR-17: attach files to (context, contextId). Each must be the caller's\n * (any for ADMIN) and either unattached or already on this same record.\n */\nexport async function attachFiles(\n  tx: Tx,\n  user: FileAccessUser,\n  fileIds: string[],\n  context: string,\n  contextId: string,\n): Promise<void> {\n  const ids = [...new Set(fileIds)];\n  if (ids.length === 0) return;\n  const files = await tx.fileObject.findMany({\n    where: { id: { in: ids } },\n    select: { id: true, ownerId: true, context: true, contextId: true },\n  });\n  const eligible = files.filter(\n    (f) =>\n      (user.role === 'ADMIN' || f.ownerId === user.id) &&\n      (f.contextId === null || (f.contextId === contextId && f.context === context)),\n  );\n  if (eligible.length !== ids.length) {\n    throw new AppError('VALIDATION_ERROR', 'One or more files cannot be attached.', {\n      fileIds: ids.filter((id) => !eligible.some((f) => f.id === id)),\n    });\n  }\n  await tx.fileObject.updateMany({ where: { id: { in: ids } }, data: { context, contextId } });\n}\n\n/** D5: detached files get contextId null and are purged 24 h later. */\nexport async function detachFiles(tx: Tx, fileIds: string[]): Promise<void> {\n  if (fileIds.length === 0) return;\n  await tx.fileObject.updateMany({ where: { id: { in: fileIds } }, data: { contextId: null } });\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { deleteFile } from '@/server/storage';\n\nconst DAY_MS = 24 * 60 * 60_000;\nconst BATCH = 500;\n\n/**\n * FR-12: delete unattached files (contextId null) older than 24 h -- abandoned\n * uploads, detached attachments, removed inline images, replaced logos.\n * Bytes first, then rows. One batch per call; the daily run catches the rest.\n */\nexport async function purgeOrphanFiles(now: Date = new Date()): Promise<number> {\n  const orphans = await prisma.fileObject.findMany({\n    where: { contextId: null, createdAt: { lt: new Date(now.getTime() - DAY_MS) } },\n    select: { id: true, storageKey: true },\n    take: BATCH,\n  });\n  const deleted: string[] = [];\n  for (const file of orphans) {\n    try {\n      await deleteFile(file.storageKey);\n      deleted.push(file.id);\n    } catch (error) {\n      logger.error('Orphan file delete failed', { id: file.id, message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  // ponytail: a file attached in the ms between findMany and here keeps its row but loses its bytes;\n  // wrap in a row lock if attaching day-old uploads ever becomes common.\n  const { count } = await prisma.fileObject.deleteMany({ where: { id: { in: deleted }, contextId: null } });\n  logger.info('Purged orphan files', { count });\n  return count;\n}\n/**\n * Pure upload validation (PRD-08 FR-4..FR-7, FR-40, FR-41, ADR-3). No I/O:\n * the caller sniffs the first bytes with file-type and passes the result in.\n */\n\ntype Sniff = 'required' | 'none' | 'zip-or-ooxml';\n\ninterface Rule {\n  /** Stored mimeType -- never taken from the client. */\n  mime: string;\n  sniff: Sniff;\n  /** Sniffed mimes accepted for 'required'/'zip-or-ooxml'. */\n  accept: string[];\n}\n\nconst CFB = 'application/x-cfb';\nconst OOXML = (mime: string): Rule => ({ mime, sniff: 'zip-or-ooxml', accept: ['application/zip', mime] });\n\nexport const ALLOWED: Record<string, Rule> = {\n  pdf: { mime: 'application/pdf', sniff: 'required', accept: ['application/pdf'] },\n  doc: { mime: 'application/msword', sniff: 'required', accept: [CFB] },\n  xls: { mime: 'application/vnd.ms-excel', sniff: 'required', accept: [CFB] },\n  ppt: { mime: 'application/vnd.ms-powerpoint', sniff: 'required', accept: [CFB] },\n  docx: OOXML('application/vnd.openxmlformats-officedocument.wordprocessingml.document'),\n  xlsx: OOXML('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'),\n  pptx: OOXML('application/vnd.openxmlformats-officedocument.presentationml.presentation'),\n  txt: { mime: 'text/plain', sniff: 'none', accept: [] },\n  csv: { mime: 'text/csv', sniff: 'none', accept: [] },\n  png: { mime: 'image/png', sniff: 'required', accept: ['image/png'] },\n  jpg: { mime: 'image/jpeg', sniff: 'required', accept: ['image/jpeg'] },\n  jpeg: { mime: 'image/jpeg', sniff: 'required', accept: ['image/jpeg'] },\n  gif: { mime: 'image/gif', sniff: 'required', accept: ['image/gif'] },\n  webp: { mime: 'image/webp', sniff: 'required', accept: ['image/webp'] },\n  mp3: { mime: 'audio/mpeg', sniff: 'required', accept: ['audio/mpeg'] },\n  mp4: { mime: 'video/mp4', sniff: 'required', accept: ['video/mp4', 'audio/mp4'] },\n  zip: { mime: 'application/zip', sniff: 'required', accept: ['application/zip'] },\n  // FR-41: SVG is text (no signature) and only allowed for the logo context.\n  svg: { mime: 'image/svg+xml', sniff: 'none', accept: [] },\n};\n\nconst LOGO_EXTS = ['png', 'jpg', 'jpeg', 'webp', 'svg'];\nconst NAME_MAX = 150;\n\n/** Lower-case extension without the dot, or '' when there is none. */\nexport function extOf(name: string): string {\n  const dot = name.lastIndexOf('.');\n  return dot > 0 ? name.slice(dot + 1).toLowerCase() : '';\n}\n\n/** FR-7: strip path separators and control chars, trim, cap at 150 chars keeping the extension. */\nexport function sanitizeFilename(name: string): string {\n  // eslint-disable-next-line no-control-regex\n  let clean = name.replace(/[/\\\\\\x00-\\x1f\\x7f]/g, '').trim();\n  if (!clean) clean = 'file';\n  if (clean.length <= NAME_MAX) return clean;\n  const ext = extOf(clean);\n  const suffix = ext && ext.length < 20 ? `.${ext}` : '';\n  return clean.slice(0, NAME_MAX - suffix.length) + suffix;\n}\n\nexport type TypeCheck = { ok: true; mime: string } | { ok: false; error: string };\n\n/**\n * ext: from the sanitised name. sniffed: file-type's mime for the head, or\n * undefined when no signature matched. head: the first bytes (SVG check).\n */\nexport function checkType(ext: string, sniffed: string | undefined, context: string, head?: Buffer): TypeCheck {\n  const error = { ok: false as const, error: `File type .${ext || 'unknown'} is not allowed.` };\n  const rule = ALLOWED[ext];\n  if (!rule) return error;\n  if (context === 'logo' ? !LOGO_EXTS.includes(ext) : ext === 'svg') return error;\n\n  switch (rule.sniff) {\n    case 'none':\n      // Any detected signature (ELF, PE, zip...) behind a text extension is a disguise.\n      if (sniffed !== undefined) return error;\n      if (ext === 'svg' && !(head ?? Buffer.alloc(0)).toString('utf8').toLowerCase().includes('<svg')) return error;\n      return { ok: true, mime: rule.mime };\n    case 'required':\n    case 'zip-or-ooxml':\n      return sniffed !== undefined && rule.accept.includes(sniffed) ? { ok: true, mime: rule.mime } : error;\n  }\n}\n\n/** Per-context byte limit: 2 MB for logos, MAX_UPLOAD_MB otherwise. */\nexport function maxBytesFor(context: string, maxUploadMb: number): number {\n  return (context === 'logo' ? 2 : maxUploadMb) * 1024 * 1024;\n}\nimport { AppError, apiError, ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { uploadFile } from '@/server/files/files-service';\n\nexport const runtime = 'nodejs';\nexport const dynamic = 'force-dynamic';\n\n/**\n * POST /api/files: multipart upload with `context` before `file` (FR-3..FR-7).\n * '/api/files/' is public in middleware (D1), so requireUser is mandatory here.\n */\nexport const POST = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  try {\n    return ok(await uploadFile(user, request), { status: 201 });\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'RATE_LIMITED') {\n      const res = apiError(error.code, error.message, error.details);\n      const seconds = (error.details as { retryAfterSeconds?: number } | undefined)?.retryAfterSeconds ?? 3600;\n      res.headers.set('Retry-After', String(seconds));\n      return res;\n    }\n    throw error;\n  }\n});\nimport { Readable } from 'node:stream';\nimport { ok, withHandler } from '@/server/http';\nimport { getCurrentUser, requireUser } from '@/server/auth/requireRole';\nimport { deleteUnattachedFile, getFileForDownload } from '@/server/files/files-service';\n\nexport const runtime = 'nodejs';\nexport const dynamic = 'force-dynamic';\n\ntype Ctx = { params: { id: string } };\n\n/**\n * GET /api/files/:id (FR-8, FR-9, FR-41). Anonymous callers reach this (D1);\n * canAccessFile decides, and a denial is 404 before any bytes are read.\n */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await getCurrentUser();\n  const { file, stream } = await getFileForDownload(user, params.id);\n\n  const wantInline = new URL(request.url).searchParams.get('inline') === '1';\n  const inlineOk = file.mimeType.startsWith('image/') || file.mimeType === 'application/pdf';\n  const disposition = wantInline && inlineOk ? 'inline' : 'attachment';\n\n  const headers = new Headers({\n    'Content-Type': file.mimeType,\n    'Content-Length': String(file.sizeBytes),\n    'X-Content-Type-Options': 'nosniff',\n    'Content-Disposition': `${disposition}; filename*=UTF-8''${encodeURIComponent(file.originalName)}`,\n    'Cache-Control': file.context === 'logo' ? 'public, max-age=3600' : 'private, no-store',\n  });\n  if (file.mimeType === 'image/svg+xml') {\n    headers.set('Content-Security-Policy', \"default-src 'none'; style-src 'unsafe-inline'\");\n  }\n  return new Response(Readable.toWeb(stream) as ReadableStream, { status: 200, headers });\n});\n\n/** DELETE /api/files/:id: owner or ADMIN, only while unattached (FR-11). */\nexport const DELETE = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  await deleteUnattachedFile(user, params.id, request);\n  return ok({ id: params.id });\n});","is_error":false}]},"parent_tool_use_id":null,"session_id":"e79742d4-00ef-4cc8-ab33-edc1cbedabaa","uuid":"30b66b5a-df27-411b-9009-c2bbab2bf171","timestamp":"2026-11-07T02:53:08.508Z","tool_use_result":{"stdout":"import { createHash, randomUUID } from 'node:crypto';\nimport { createReadStream, createWriteStream } from 'node:fs';\nimport { mkdir, rename, unlink } from 'node:fs/promises';\nimport path from 'node:path';\nimport { Transform, type Readable } from 'node:stream';\nimport { pipeline } from 'node:stream/promises';\nimport { env } from '@/lib/env';\n\n/**\n * Local-disk file storage (PRD-08 FR-2, NFR-5, NFR-11). Single implementation,\n * no interface: bytes live under UPLOAD_DIR (never public/) and are only ever\n * served through GET /api/files/:id.\n */\n\nfunction root(): string {\n  // Read per call so tests can point UPLOAD_DIR at a temp dir.\n  return path.resolve(process.env.UPLOAD_DIR || env.UPLOAD_DIR);\n}\n\n/** Absolute path for a storage key; throws if the key escapes UPLOAD_DIR (traversal guard). */\nexport function resolveKey(storageKey: string): string {\n  const base = root();\n  const full = path.resolve(base, storageKey);\n  if (!full.startsWith(base + path.sep)) throw new Error('Invalid storage key');\n  return full;\n}\n\nexport interface SavedFile {\n  storageKey: string;\n  sizeBytes: number;\n  sha256: string;\n}\n\n/**\n * Streams `stream` to UPLOAD_DIR/.tmp, hashing and counting bytes on the way,\n * then renames to <yyyy>/<mm>/<id>.<ext>. On any stream error (including an\n * abort for oversize/bad type) the tmp file is removed and the error rethrown.\n */\nexport async function saveFile(stream: Readable, meta: { ext: string }): Promise<SavedFile> {\n  const base = root();\n  const id = randomUUID().replace(/-/g, '');\n  const tmpDir = path.join(base, '.tmp');\n  await mkdir(tmpDir, { recursive: true });\n  const tmp = path.join(tmpDir, id);\n\n  const hash = createHash('sha256');\n  let sizeBytes = 0;\n  const tap = new Transform({\n    transform(chunk: Buffer, _enc, cb) {\n      hash.update(chunk);\n      sizeBytes += chunk.length;\n      cb(null, chunk);\n    },\n  });\n\n  try {\n    await pipeline(stream, tap, createWriteStream(tmp));\n  } catch (error) {\n    await unlink(tmp).catch(() => undefined);\n    throw error;\n  }\n\n  const now = new Date();\n  const ext = meta.ext.toLowerCase().replace(/[^a-z0-9]/g, '');\n  const storageKey = `${now.getUTCFullYear()}/${String(now.getUTCMonth() + 1).padStart(2, '0')}/${id}${ext ? `.${ext}` : ''}`;\n  const dest = resolveKey(storageKey);\n  await mkdir(path.dirname(dest), { recursive: true });\n  await rename(tmp, dest);\n  return { storageKey, sizeBytes, sha256: hash.digest('hex') };\n}\n\nexport function readFile(storageKey: string): Readable {\n  return createReadStream(resolveKey(storageKey));\n}\n\n/** Removes stored bytes; a missing file is not an error. */\nexport async function deleteFile(storageKey: string): Promise<void> {\n  try {\n    await unlink(resolveKey(storageKey));\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;\n  }\n}\nimport type { FileObject } from '@prisma/client';\nimport { registerBuiltInContexts } from './contexts';\n\n/**\n * File access registry (PRD-08 FR-9, NFR-1). Every download goes through\n * canAccessFile. Later PRDs call registerFileAccess for their own contexts.\n */\n\nexport interface FileAccessUser {\n  id: string;\n  role: string;\n}\n\nexport type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\n\n/** Resolvers receive null for anonymous callers; only return true for null if the context is public. */\nexport type FileAccessResolver = (user: FileAccessUser | null, file: FileAccessFile) => boolean | Promise<boolean>;\n\nconst registry = new Map<string, FileAccessResolver>();\n\nexport function registerFileAccess(context: string, resolver: FileAccessResolver): void {\n  registry.set(context, resolver);\n}\n\nconst ownerOrAdmin = (user: FileAccessUser | null, file: FileAccessFile) =>\n  user !== null && (user.role === 'ADMIN' || user.id === file.ownerId);\n\nlet builtInsRegistered = false;\n\n/**\n * Dispatch order: (1) unattached -> owner/ADMIN; (2) registered resolver;\n * (3) unknown context -> owner/ADMIN. Anonymous is denied except where a\n * resolver explicitly accepts null. Resolver errors deny.\n */\nexport async function canAccessFile(user: FileAccessUser | null, file: FileAccessFile): Promise<boolean> {\n  // Lazy so the circular import with contexts.ts never hits an uninitialised registry,\n  // and no caller can forget to load the built-in contexts.\n  if (!builtInsRegistered) {\n    builtInsRegistered = true;\n    registerBuiltInContexts(registerFileAccess);\n  }\n  if (file.contextId === null) return ownerOrAdmin(user, file);\n  const resolver = registry.get(file.context);\n  if (!resolver) return ownerOrAdmin(user, file);\n  try {\n    return (await resolver(user, file)) === true;\n  } catch {\n    return false;\n  }\n}\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n}\nimport { Readable } from 'node:stream';\nimport type { ReadableStream as NodeWebReadableStream } from 'node:stream/web';\nimport type { FileObject, Prisma } from '@prisma/client';\n// @ts-expect-error -- ponytail: busboy ships without types and comes transitively via next (ADR-2); add @types/busboy if it becomes a direct dep.\nimport busboy from 'busboy';\nimport { fileTypeFromBuffer } from 'file-type';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { rateLimit } from '@/server/rate-limit';\nimport { env } from '@/lib/env';\nimport { deleteFile, readFile, saveFile } from '@/server/storage';\nimport { canAccessFile, type FileAccessUser } from './access';\nimport { checkType, extOf, maxBytesFor, sanitizeFilename } from './validate';\n\n/**\n * File business logic (PRD-08 FR-3, FR-8, FR-11, FR-17, FR-46, NFR-3, NFR-5).\n * Route handlers in src/app/api/files stay thin.\n */\n\nconst HEAD_BYTES = 4100;\nconst MULTIPART_SLACK = 64 * 1024;\nconst CONTEXT_RE = /^[a-z][a-z0-9_-]{0,39}$/;\nconst UPLOADS_PER_HOUR = 60;\n\nexport interface FileSummary {\n  id: string;\n  originalName: string;\n  mimeType: string;\n  sizeBytes: number;\n}\n\nexport const toSummary = (f: Pick<FileObject, 'id' | 'originalName' | 'mimeType' | 'sizeBytes'>): FileSummary => ({\n  id: f.id,\n  originalName: f.originalName,\n  mimeType: f.mimeType,\n  sizeBytes: f.sizeBytes,\n});\n\nfunction maxUploadMb(): number {\n  const fromProcess = Number(process.env.MAX_UPLOAD_MB);\n  return Number.isInteger(fromProcess) && fromProcess > 0 ? fromProcess : env.MAX_UPLOAD_MB;\n}\n\n/** Lets busboy reach 'close' after we stop reading a part (the async iterator's 'readable' listener blocks resume()). */\nfunction drain(stream: Readable): void {\n  stream.removeAllListeners('readable');\n  stream.resume();\n}\n\nconst tooBig = (maxBytes: number) =>\n  new AppError('VALIDATION_ERROR', `File exceeds ${Math.round(maxBytes / (1024 * 1024))} MB.`);\n\n/** Streams one file part to disk: sniff the head, then hash+count while writing (NFR-5). */\nasync function storePart(\n  user: FileAccessUser,\n  context: string,\n  filename: string,\n  stream: Readable & { truncated?: boolean },\n  maxBytes: number,\n): Promise<FileSummary> {\n  const originalName = sanitizeFilename(filename);\n  const ext = extOf(originalName);\n\n  // Peek the first HEAD_BYTES without buffering the rest.\n  const iterator = stream[Symbol.asyncIterator]() as AsyncIterator<Buffer>;\n  const headChunks: Buffer[] = [];\n  let headLength = 0;\n  let done = false;\n  while (headLength < HEAD_BYTES) {\n    const next = await iterator.next();\n    if (next.done) {\n      done = true;\n      break;\n    }\n    headChunks.push(next.value);\n    headLength += next.value.length;\n  }\n  const head = Buffer.concat(headChunks);\n  const sniffed = head.length ? (await fileTypeFromBuffer(head))?.mime : undefined;\n  const check = checkType(ext, sniffed, context, head);\n  if (!check.ok) {\n    drain(stream);\n    throw new AppError('VALIDATION_ERROR', check.error);\n  }\n  if (head.length === 0) {\n    throw new AppError('VALIDATION_ERROR', 'File is empty.');\n  }\n\n  async function* body() {\n    let total = head.length;\n    if (total > maxBytes) throw tooBig(maxBytes);\n    yield head;\n    if (!done) {\n      for (let next = await iterator.next(); !next.done; next = await iterator.next()) {\n        total += next.value.length;\n        // Per-context cap (logo 2 MB) is enforced here mid-stream; saveFile unlinks the tmp file.\n        if (total > maxBytes) throw tooBig(maxBytes);\n        yield next.value;\n      }\n    }\n    // busboy stops emitting at limits.fileSize and marks the stream truncated.\n    if (stream.truncated) throw tooBig(maxBytes);\n  }\n\n  const saved = await saveFile(Readable.from(body()), { ext });\n  const row = await prisma.fileObject.create({\n    data: {\n      ownerId: user.id,\n      originalName,\n      mimeType: check.mime,\n      sizeBytes: saved.sizeBytes,\n      storageKey: saved.storageKey,\n      sha256: saved.sha256,\n      context,\n      contextId: null,\n    },\n  });\n  return toSummary(row);\n}\n\n/** POST /api/files: multipart with a `context` field BEFORE the `file` part (ADR-2). */\nexport async function uploadFile(user: FileAccessUser, request: Request): Promise<FileSummary> {\n  const limit = rateLimit(`upload:${user.id}`, UPLOADS_PER_HOUR, 3_600_000);\n  if (!limit.ok) {\n    throw new AppError('RATE_LIMITED', 'Too many uploads. Try again later.', {\n      retryAfterSeconds: Math.ceil(limit.retryAfterMs / 1000),\n    });\n  }\n\n  const contentType = request.headers.get('content-type') ?? '';\n  if (!contentType.startsWith('multipart/form-data') || !request.body) {\n    throw new AppError('VALIDATION_ERROR', 'Expected multipart/form-data.');\n  }\n  const globalMax = maxBytesFor('lesson', maxUploadMb());\n  const declared = Number(request.headers.get('content-length'));\n  if (Number.isFinite(declared) && declared > globalMax + MULTIPART_SLACK) throw tooBig(globalMax);\n\n  return new Promise<FileSummary>((resolve, reject) => {\n    let context: string | null = null;\n    let work: Promise<FileSummary> | null = null;\n    let parser: ReturnType<typeof busboy>;\n    try {\n      parser = busboy({\n        headers: { 'content-type': contentType },\n        limits: { files: 1, fields: 5, fileSize: globalMax },\n      });\n    } catch {\n      reject(new AppError('VALIDATION_ERROR', 'Malformed multipart body.'));\n      return;\n    }\n\n    parser.on('field', (name: string, value: string) => {\n      if (name === 'context') context = value;\n    });\n\n    parser.on('file', (_name: string, stream: Readable & { truncated?: boolean }, info: { filename?: string }) => {\n      if (work) {\n        drain(stream);\n        return;\n      }\n      if (!context || !CONTEXT_RE.test(context)) {\n        drain(stream);\n        work = Promise.reject(new AppError('VALIDATION_ERROR', 'A valid context field must precede the file.'));\n        work.catch(() => undefined);\n        return;\n      }\n      work = storePart(user, context, info.filename ?? 'file', stream, maxBytesFor(context, maxUploadMb()));\n      // On failure keep draining so busboy reaches 'close' and the promise settles.\n      work.catch(() => drain(stream));\n    });\n\n    parser.on('error', () => reject(new AppError('VALIDATION_ERROR', 'Malformed multipart body.')));\n    parser.on('close', () => {\n      if (!work) reject(new AppError('VALIDATION_ERROR', 'No file was uploaded.'));\n      else work.then(resolve, reject);\n    });\n\n    Readable.fromWeb(request.body as unknown as NodeWebReadableStream).on('error', reject).pipe(parser);\n  });\n}\n\n/** Loads the row and runs the registry; denial is NOT_FOUND before any bytes are read (FR-9, NFR-1). */\nexport async function getFileForDownload(user: FileAccessUser | null, id: string) {\n  const file = await prisma.fileObject.findUnique({ where: { id } });\n  if (!file || !(await canAccessFile(user, file))) throw new AppError('NOT_FOUND', 'File not found');\n  return { file, stream: readFile(file.storageKey) };\n}\n\n/** FR-11: owner or ADMIN, only while unattached. Row first, then bytes. */\nexport async function deleteUnattachedFile(user: FileAccessUser, id: string, request?: Request): Promise<void> {\n  const file = await prisma.fileObject.findUnique({ where: { id } });\n  if (!file || (user.role !== 'ADMIN' && file.ownerId !== user.id)) throw new AppError('NOT_FOUND', 'File not found');\n  if (file.contextId !== null) throw new AppError('CONFLICT', 'File is attached and cannot be deleted.');\n  await prisma.fileObject.delete({ where: { id } });\n  await deleteFile(file.storageKey);\n  if (file.ownerId !== user.id) {\n    await audit({\n      actorId: user.id,\n      action: 'file.delete',\n      entityType: 'FileObject',\n      entityId: id,\n      metadata: { ownerId: file.ownerId, originalName: file.originalName },\n      request,\n    });\n  }\n}\n\ntype Tx = Prisma.TransactionClient;\n\n/**\n * FR-17: attach files to (context, contextId). Each must be the caller's\n * (any for ADMIN) and either unattached or already on this same record.\n */\nexport async function attachFiles(\n  tx: Tx,\n  user: FileAccessUser,\n  fileIds: string[],\n  context: string,\n  contextId: string,\n): Promise<void> {\n  const ids = [...new Set(fileIds)];\n  if (ids.length === 0) return;\n  const files = await tx.fileObject.findMany({\n    where: { id: { in: ids } },\n    select: { id: true, ownerId: true, context: true, contextId: true },\n  });\n  const eligible = files.filter(\n    (f) =>\n      (user.role === 'ADMIN' || f.ownerId === user.id) &&\n      (f.contextId === null || (f.contextId === contextId && f.context === context)),\n  );\n  if (eligible.length !== ids.length) {\n    throw new AppError('VALIDATION_ERROR', 'One or more files cannot be attached.', {\n      fileIds: ids.filter((id) => !eligible.some((f) => f.id === id)),\n    });\n  }\n  await tx.fileObject.updateMany({ where: { id: { in: ids } }, data: { context, contextId } });\n}\n\n/** D5: detached files get contextId null and are purged 24 h later. */\nexport async function detachFiles(tx: Tx, fileIds: string[]): Promise<void> {\n  if (fileIds.length === 0) return;\n  await tx.fileObject.updateMany({ where: { id: { in: fileIds } }, data: { contextId: null } });\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { deleteFile } from '@/server/storage';\n\nconst DAY_MS = 24 * 60 * 60_000;\nconst BATCH = 500;\n\n/**\n * FR-12: delete unattached files (contextId null) older than 24 h -- abandoned\n * uploads, detached attachments, removed inline images, replaced logos.\n * Bytes first, then rows. One batch per call; the daily run catches the rest.\n */\nexport async function purgeOrphanFiles(now: Date = new Date()): Promise<number> {\n  const orphans = await prisma.fileObject.findMany({\n    where: { contextId: null, createdAt: { lt: new Date(now.getTime() - DAY_MS) } },\n    select: { id: true, storageKey: true },\n    take: BATCH,\n  });\n  const deleted: string[] = [];\n  for (const file of orphans) {\n    try {\n      await deleteFile(file.storageKey);\n      deleted.push(file.id);\n    } catch (error) {\n      logger.error('Orphan file delete failed', { id: file.id, message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  // ponytail: a file attached in the ms between findMany and here keeps its row but loses its bytes;\n  // wrap in a row lock if attaching day-old uploads ever becomes common.\n  const { count } = await prisma.fileObject.deleteMany({ where: { id: { in: deleted }, contextId: null } });\n  logger.info('Purged orphan files', { count });\n  return count;\n}\n/**\n * Pure upload validation (PRD-08 FR-4..FR-7, FR-40, FR-41, ADR-3). No I/O:\n * the caller sniffs the first bytes with file-type and passes the result in.\n */\n\ntype Sniff = 'required' | 'none' | 'zip-or-ooxml';\n\ninterface Rule {\n  /** Stored mimeType -- never taken from the client. */\n  mime: string;\n  sniff: Sniff;\n  /** Sniffed mimes accepted for 'required'/'zip-or-ooxml'. */\n  accept: string[];\n}\n\nconst CFB = 'application/x-cfb';\nconst OOXML = (mime: string): Rule => ({ mime, sniff: 'zip-or-ooxml', accept: ['application/zip', mime] });\n\nexport const ALLOWED: Record<string, Rule> = {\n  pdf: { mime: 'application/pdf', sniff: 'required', accept: ['application/pdf'] },\n  doc: { mime: 'application/msword', sniff: 'required', accept: [CFB] },\n  xls: { mime: 'application/vnd.ms-excel', sniff: 'required', accept: [CFB] },\n  ppt: { mime: 'application/vnd.ms-powerpoint', sniff: 'required', accept: [CFB] },\n  docx: OOXML('application/vnd.openxmlformats-officedocument.wordprocessingml.document'),\n  xlsx: OOXML('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'),\n  pptx: OOXML('application/vnd.openxmlformats-officedocument.presentationml.presentation'),\n  txt: { mime: 'text/plain', sniff: 'none', accept: [] },\n  csv: { mime: 'text/csv', sniff: 'none', accept: [] },\n  png: { mime: 'image/png', sniff: 'required', accept: ['image/png'] },\n  jpg: { mime: 'image/jpeg', sniff: 'required', accept: ['image/jpeg'] },\n  jpeg: { mime: 'image/jpeg', sniff: 'required', accept: ['image/jpeg'] },\n  gif: { mime: 'image/gif', sniff: 'required', accept: ['image/gif'] },\n  webp: { mime: 'image/webp', sniff: 'required', accept: ['image/webp'] },\n  mp3: { mime: 'audio/mpeg', sniff: 'required', accept: ['audio/mpeg'] },\n  mp4: { mime: 'video/mp4', sniff: 'required', accept: ['video/mp4', 'audio/mp4'] },\n  zip: { mime: 'application/zip', sniff: 'required', accept: ['application/zip'] },\n  // FR-41: SVG is text (no signature) and only allowed for the logo context.\n  svg: { mime: 'image/svg+xml', sniff: 'none', accept: [] },\n};\n\nconst LOGO_EXTS = ['png', 'jpg', 'jpeg', 'webp', 'svg'];\nconst NAME_MAX = 150;\n\n/** Lower-case extension without the dot, or '' when there is none. */\nexport function extOf(name: string): string {\n  const dot = name.lastIndexOf('.');\n  return dot > 0 ? name.slice(dot + 1).toLowerCase() : '';\n}\n\n/** FR-7: strip path separators and control chars, trim, cap at 150 chars keeping the extension. */\nexport function sanitizeFilename(name: string): string {\n  // eslint-disable-next-line no-control-regex\n  let clean = name.replace(/[/\\\\\\x00-\\x1f\\x7f]/g, '').trim();\n  if (!clean) clean = 'file';\n  if (clean.length <= NAME_MAX) return clean;\n  const ext = extOf(clean);\n  const suffix = ext && ext.length < 20 ? `.${ext}` : '';\n  return clean.slice(0, NAME_MAX - suffix.length) + suffix;\n}\n\nexport type TypeCheck = { ok: true; mime: string } | { ok: false; error: string };\n\n/**\n * ext: from the sanitised name. sniffed: file-type's mime for the head, or\n * undefined when no signature matched. head: the first bytes (SVG check).\n */\nexport function checkType(ext: string, sniffed: string | undefined, context: string, head?: Buffer): TypeCheck {\n  const error = { ok: false as const, error: `File type .${ext || 'unknown'} is not allowed.` };\n  const rule = ALLOWED[ext];\n  if (!rule) return error;\n  if (context === 'logo' ? !LOGO_EXTS.includes(ext) : ext === 'svg') return error;\n\n  switch (rule.sniff) {\n    case 'none':\n      // Any detected signature (ELF, PE, zip...) behind a text extension is a disguise.\n      if (sniffed !== undefined) return error;\n      if (ext === 'svg' && !(head ?? Buffer.alloc(0)).toString('utf8').toLowerCase().includes('<svg')) return error;\n      return { ok: true, mime: rule.mime };\n    case 'required':\n    case 'zip-or-ooxml':\n      return sniffed !== undefined && rule.accept.includes(sniffed) ? { ok: true, mime: rule.mime } : error;\n  }\n}\n\n/** Per-context byte limit: 2 MB for logos, MAX_UPLOAD_MB otherwise. */\nexport function maxBytesFor(context: string, maxUploadMb: number): number {\n  return (context === 'logo' ? 2 : maxUploadMb) * 1024 * 1024;\n}\nimport { AppError, apiError, ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { uploadFile } from '@/server/files/files-service';\n\nexport const runtime = 'nodejs';\nexport const dynamic = 'force-dynamic';\n\n/**\n * POST /api/files: multipart upload with `context` before `file` (FR-3..FR-7).\n * '/api/files/' is public in middleware (D1), so requireUser is mandatory here.\n */\nexport const POST = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  try {\n    return ok(await uploadFile(user, request), { status: 201 });\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'RATE_LIMITED') {\n      const res = apiError(error.code, error.message, error.details);\n      const seconds = (error.details as { retryAfterSeconds?: number } | undefined)?.retryAfterSeconds ?? 3600;\n      res.headers.set('Retry-After', String(seconds));\n      return res;\n    }\n    throw error;\n  }\n});\nimport { Readable } from 'node:stream';\nimport { ok, withHandler } from '@/server/http';\nimport { getCurrentUser, requireUser } from '@/server/auth/requireRole';\nimport { deleteUnattachedFile, getFileForDownload } from '@/server/files/files-service';\n\nexport const runtime = 'nodejs';\nexport const dynamic = 'force-dynamic';\n\ntype Ctx = { params: { id: string } };\n\n/**\n * GET /api/files/:id (FR-8, FR-9, FR-41). Anonymous callers reach this (D1);\n * canAccessFile decides, and a denial is 404 before any bytes are read.\n */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await getCurrentUser();\n  const { file, stream } = await getFileForDownload(user, params.id);\n\n  const wantInline = new URL(request.url).searchParams.get('inline') === '1';\n  const inlineOk = file.mimeType.startsWith('image/') || file.mimeType === 'application/pdf';\n  const disposition = wantInline && inlineOk ? 'inline' : 'attachment';\n\n  const headers = new Headers({\n    'Content-Type': file.mimeType,\n    'Content-Length': String(file.sizeBytes),\n    'X-Content-Type-Options': 'nosniff',\n    'Content-Disposition': `${disposition}; filename*=UTF-8''${encodeURIComponent(file.originalName)}`,\n    'Cache-Control': file.context === 'logo' ? 'public, max-age=3600' : 'private, no-store',\n  });\n  if (file.mimeType === 'image/svg+xml') {\n    headers.set('Content-Security-Policy', \"default-src 'none'; style-src 'unsafe-inline'\");\n  }\n  return new Response(Readable.toWeb(stream) as ReadableStream, { status: 200, headers });\n});\n\n/** DELETE /api/files/:id: owner or ADMIN, only while unattached (FR-11). */\nexport const DELETE = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  await deleteUnattachedFile(user, params.id, request);\n  return ok({ id: params.id });\n});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01TS1sZ7YE2SspuyUV9rDmeH","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
