rror'; message: string } | null;\n    19\t\n    20\t/** C1: same success copy for known and unknown emails (FR-18, no enumeration). */\n    21\texport function ForgotPasswordForm() {\n    22\t  const [status, setStatus] = useState<Status>(null);\n    23\t  const { control, handleSubmit, setError, formState } = useForm<Values>({\n    24\t    resolver: zodResolver(forgotPasswordSchema),\n    25\t    defaultValues: { email: '' },\n    26\t    shouldFocusError: true,\n    27\t  });\n    28\t\n    29\t  const submit = handleSubmit(async ({ email }) => {\n    30\t    setStatus(null);\n    31\t    const result = await postJson<{ message: string }>('/api/auth/forgot-password', { email });\n    32\t    if ('data' in result) {\n    33\t      setStatus({ severity: 'success', message: result.data.message });\n    34\t      return;\n    35\t    }\n    36\t    const { error } = result;\n    37\t    if (error.status === 429) {\n    38\t      setStatus({ severity: 'error', message: 'Too many attempts. Wait a few minutes and try again.' });\n    39\t    } else if (!(error.status === 400 && applyFieldErrors(setError, error.fieldErrors, ['email']))) {\n    40\t      setStatus({ severity: 'error', message: error.message });\n    41\t    }\n    42\t  });\n    43\t\n    44\t  return (\n    45\t    <Box component=\"form\" noValidate onSubmit={submit}>\n    46\t      <Stack spacing={2}>\n    47\t        <Box aria-live=\"polite\">{status && <Alert severity={status.severity}>{status.message}</Alert>}</Box>\n    48\t        <TextFormField name=\"email\" control={control} label=\"Email\" type=\"email\" autoComplete=\"email\" required />\n    49\t        <Button type=\"submit\" variant=\"contained\" size=\"large\" disabled={formState.isSubmitting}>\n    50\t          Send reset link\n    51\t        </Button>\n    52\t        <Link component={NextLink} href=\"/login\" variant=\"body2\" sx={{ alignSelf: 'center' }}>\n    53\t          Back to sign in\n    54\t        </Link>\n    55\t      </Stack>\n    56\t    </Box>\n    57\t  );\n    58\t}\n=== src/app/(auth)/TokenPasswordForm.tsx\n     1\t'use client';\n     2\t\n     3\timport { useState } from 'react';\n     4\timport NextLink from 'next/link';\n     5\timport { useRouter } from 'next/navigation';\n     6\timport { signIn } from 'next-auth/react';\n     7\timport Stack from '@mui/material/Stack';\n     8\timport Alert from '@mui/material/Alert';\n     9\timport Link from '@mui/material/Link';\n    10\timport { SetPasswordForm, postJson } from '@/components/PasswordChecklist';\n    11\t\n    12\texport interface TokenPasswordFormProps {\n    13\t  mode: 'invite' | 'reset';\n    14\t  token: string;\n    15\t  email: string;\n    16\t  name?: string;\n    17\t  invalidMessage: string;\n    18\t}\n    19\t\n    20\t/** C4: shared invite-accept / password-reset form. The token is only ever a prop (NFR-8). */\n    21\texport function TokenPasswordForm({ mode, token, email, name, invalidMessage }: TokenPasswordFormProps) {\n    22\t  const router = useRouter();\n    23\t  const [invalid, setInvalid] = useState(false);\n    24\t\n    25\t  if (invalid) return <TokenInvalidAlert message={invalidMessage} showForgotLink={mode === 'reset'} />;\n    26\t\n    27\t  const onSubmit = async (password: string, confirm: string) => {\n    28\t    const url = mode === 'invite' ? '/api/auth/accept-invite' : '/api/auth/reset-password';\n    29\t    const result = await postJson(url, { token, password, confirm });\n    30\t    if ('error' in result) {\n    31\t      if (result.error.status === 410) {\n    32\t        setInvalid(true);\n    33\t        return;\n    34\t      }\n    35\t      return result.error;\n    36\t    }\n    37\t    if (mode === 'reset') {\n    38\t      router.replace('/login?reset=1');\n    39\t      return;\n    40\t    }\n    41\t    const signedIn = await signIn('credentials', { email, password, redirect: false });\n    42\t    router.replace(!signedIn || signedIn.error ? '/login' : '/dashboard');\n    43\t    router.refresh();\n    44\t  };\n    45\t\n    46\t  return (\n    47\t    <SetPasswordForm\n    48\t      name={name}\n    49\t      email={email}\n    50\t      submitLabel={mode === 'invite' ? 'Activate account' : 'Set new password'}\n    51\t      onSubmit={onSubmit}\n    52\t    />\n    53\t  );\n    54\t}\n    55\t\n    56\t/** Invalid/expired-link state, shared by the server pages (C2, C3) and the 410 path above. */\n    57\texport function TokenInvalidAlert({ message, showForgotLink }: { message: string; showForgotLink: boolean }) {\n    58\t  return (\n    59\t    <Stack spacing={2} aria-live=\"polite\">\n    60\t      <Alert severity=\"error\">{message}</Alert>\n    61\t      {showForgotLink && (\n    62\t        <Link component={NextLink} href=\"/forgot-password\" variant=\"body2\" sx={{ alignSelf: 'center' }}>\n    63\t          Request a new reset link\n    64\t        </Link>\n    65\t      )}\n    66\t    </Stack>\n    67\t  );\n    68\t}\n=== src/app/(auth)/reset-password/[token]/page.tsx\n     1\timport type { Metadata } from 'next';\n     2\timport Stack from '@mui/material/Stack';\n     3\timport Typography from '@mui/material/Typography';\n     4\timport { verifyToken } from '@/server/auth/tokens';\n     5\timport { TokenInvalidAlert, TokenPasswordForm } from '../../TokenPasswordForm';\n     6\t\n     7\texport const metadata: Metadata = { title: 'Set a new password · SchoolHub' };\n     8\texport const dynamic = 'force-dynamic';\n     9\t\n    10\tconst INVALID = 'This link is invalid or has expired.';\n    11\t\n    12\t/** /reset-password/[token] — C2. verifyToken is read-only; the API consumes the token. */\n    13\texport default async function ResetPasswordPage({ params }: { params: { token: string } }) {\n    14\t  const verified = await verifyToken(params.token, 'PASSWORD_RESET');\n    15\t  return (\n    16\t    <Stack spacing={2}>\n    17\t      <Typography variant=\"h5\" component=\"h1\">\n    18\t        Set a new password\n    19\t      </Typography>\n    20\t      {verified ? (\n    21\t        <TokenPasswordForm mode=\"reset\" token={params.token} email={verified.user.email} invalidMessage={INVALID} />\n    22\t      ) : (\n    23\t        <TokenInvalidAlert message={INVALID} showForgotLink />\n    24\t      )}\n    25\t    </Stack>\n    26\t  );\n    27\t}\n=== src/app/(auth)/invite/[token]/page.tsx\n     1\timport type { Metadata } from 'next';\n     2\timport Stack from '@mui/material/Stack';\n     3\timport Typography from '@mui/material/Typography';\n     4\timport { verifyToken } from '@/server/auth/tokens';\n     5\timport { TokenInvalidAlert, TokenPasswordForm } from '../../TokenPasswordForm';\n     6\t\n     7\texport const metadata: Metadata = { title: 'Accept invitation · SchoolHub' };\n     8\texport const dynamic = 'force-dynamic';\n     9\t\n    10\tconst INVALID = 'This invitation link is invalid or has expired. Ask the school office to send a new one.';\n    11\t\n    12\t/** /invite/[token] — C3 (FR-12, FR-13). No sign-up affordance (NFR-14). */\n    13\texport default async function InvitePage({ params }: { params: { token: string } }) {\n    14\t  const verified = await verifyToken(params.token, 'INVITE');\n    15\t  return (\n    16\t    <Stack spacing={2}>\n    17\t      <Typography variant=\"h5\" component=\"h1\">\n    18\t        Welcome to SchoolHub\n    19\t      </Typography>\n    20\t      {verified ? (\n    21\t        <TokenPasswordForm\n    22\t          mode=\"invite\"\n    23\t          token={params.token}\n    24\t          email={verified.user.email}\n    25\t          name={`${verified.user.firstName} ${verified.user.lastName}`}\n    26\t          invalidMessage={INVALID}\n    27\t        />\n    28\t      ) : (\n    29\t        <TokenInvalidAlert message={INVALID} showForgotLink={false} />\n    30\t      )}\n    31\t    </Stack>\n    32\t  );\n    33\t}\n=== src/app/(app)/account/security/page.tsx\n     1\timport { requirePageUser } from '@/server/auth/requireRole';\n     2\timport { PageHeader } from '@/components/PageHeader/PageHeader';\n     3\timport { ChangePasswordForm } from './ChangePasswordForm';\n     4\t\n     5\texport const dynamic = 'force-dynamic';\n     6\t\n     7\t/** /account/security — C5 (FR-23). */\n     8\texport default async function AccountSecurityPage() {\n     9\t  const user = await requirePageUser();\n    10\t  return (\n    11\t    <>\n    12\t      <PageHeader title=\"Account security\" description=\"Change the password you use to sign in.\" />\n    13\t      <ChangePasswordForm email={user.email} />\n    14\t    </>\n    15\t  );\n    16\t}\n=== src/app/(app)/account/security/ChangePasswordForm.tsx\n     1\t'use client';\n     2\t\n     3\timport { useState } from 'react';\n     4\timport { useRouter } from 'next/navigation';\n     5\timport { useForm } from 'react-hook-form';\n     6\timport { zodResolver } from '@hookform/resolvers/zod';\n     7\timport Box from '@mui/material/Box';\n     8\timport Stack from '@mui/material/Stack';\n     9\timport Button from '@mui/material/Button';\n    10\timport Alert from '@mui/material/Alert';\n    11\timport { TextFormField } from '@/components/FormField/FormField';\n    12\timport { PasswordChecklist, applyFieldErrors, passwordInputSlot, postJson } from '@/components/PasswordChecklist';\n    13\timport { useToast } from '@/components/Toast/useToast';\n    14\timport { changePasswordFormSchema, type ChangePasswordInput } from '@/lib/validators/auth';\n    15\t\n    16\t/** C5: signed-in password change. Other sessions are revoked server-side (FR-23). */\n    17\texport function ChangePasswordForm({ email }: { email: string }) {\n    18\t  const router = useRouter();\n    19\t  const { showToast } = useToast();\n    20\t  const [show, setShow] = useState(false);\n    21\t  const [formError, setFormError] = useState<string | null>(null);\n    22\t  const { control, handleSubmit, watch, setError, reset, formState } = useForm<ChangePasswordInput>({\n    23\t    resolver: zodResolver(changePasswordFormSchema(email)),\n    24\t    defaultValues: { currentPassword: '', newPassword: '', confirm: '' },\n    25\t    shouldFocusError: true,\n    26\t  });\n    27\t\n    28\t  const submit = handleSubmit(async (values) => {\n    29\t    setFormError(null);\n    30\t    const result = await postJson('/api/account/password', values);\n    31\t    if ('data' in result) {\n    32\t      showToast({ message: 'Password updated', severity: 'success' });\n    33\t      reset();\n    34\t      router.refresh();\n    35\t      return;\n    36\t    }\n    37\t    const { password, ...rest } = result.error.fieldErrors ?? {};\n    38\t    // The server's common-password policy error is keyed `password`; this form calls it newPassword.\n    39\t    const fieldErrors = password ? { ...rest, newPassword: [...(rest.newPassword ?? []), ...password] } : rest;\n    40\t    if (!applyFieldErrors(setError, fieldErrors, ['currentPassword', 'newPassword', 'confirm'])) {\n    41\t      setFormError(result.error.message);\n    42\t    }\n    43\t  });\n    44\t\n    45\t  const toggle = () => setShow((s) => !s);\n    46\t  const type = show ? 'text' : 'password';\n    47\t\n    48\t  return (\n    49\t    <Box component=\"form\" noValidate onSubmit={submit} sx={{ maxWidth: 480 }}>\n    50\t      <Stack spacing={2}>\n    51\t        <Box aria-live=\"polite\">{formError && <Alert severity=\"error\">{formError}</Alert>}</Box>\n    52\t        <TextFormField\n    53\t          name=\"currentPassword\"\n    54\t          control={control}\n    55\t          label=\"Current password\"\n    56\t          type={type}\n    57\t          autoComplete=\"current-password\"\n    58\t          required\n    59\t          slotProps={passwordInputSlot(show, toggle)}\n    60\t        />\n    61\t        <TextFormField\n    62\t          name=\"newPassword\"\n    63\t          control={control}\n    64\t          label=\"New password\"\n    65\t          type={type}\n    66\t          autoComplete=\"new-password\"\n    67\t          required\n    68\t          slotProps={passwordInputSlot(show, toggle)}\n    69\t        />\n    70\t        <PasswordChecklist password={watch('newPassword')} email={email} />\n    71\t        <TextFormField\n    72\t          name=\"confirm\"\n    73\t          control={control}\n    74\t          label=\"Confirm new password\"\n    75\t          type={type}\n    76\t          autoComplete=\"new-password\"\n    77\t          required\n    78\t        />\n    79\t        <Button type=\"submit\" variant=\"contained\" disabled={formState.isSubmitting} sx={{ alignSelf: 'flex-start' }}>\n    80\t          Update password\n    81\t        </Button>\n    82\t      </Stack>\n    83\t    </Box>\n    84\t  );\n    85\t}\n=== src/app/(app)/layout.tsx\n     1\timport { prisma } from '@/server/db';\n     2\timport { requirePageUser } from '@/server/auth/requireRole';\n     3\timport { AppShell } from './shell';\n     4\t\n     5\texport default async function AppLayout({ children }: { children: React.ReactNode }) {\n     6\t  const user = await requirePageUser();\n     7\t  const settings = await prisma.schoolSettings.findUnique({ where: { id: 'singleton' } });\n     8\t\n     9\t  return (\n    10\t    <AppShell\n    11\t      user={{ id: user.id, role: user.role, firstName: user.firstName, lastName: user.lastName, email: user.email }}\n    12\t      schoolShortName={settings?.shortName ?? 'SchoolHub'}\n    13\t    >\n    14\t      {children}\n    15\t    </AppShell>\n    16\t  );\n    17\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"f52d74ab-5795-43ec-9250-cb726f8a81b9","uuid":"f3bbcee3-0edb-44c2-b575-72d4cd2efd36","timestamp":"2026-11-05T16:49:16.242Z","tool_use_result":{"stdout":"=== src/app/(auth)/forgot-password/page.tsx\n     1\timport type { Metadata } from 'next';\n     2\timport Stack from '@mui/material/Stack';\n     3\timport Typography from '@mui/material