{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013xEvgXy2iptMHw3z1DxvmN","type":"tool_result","content":"183\tasync function seedAttendance() {\n184\t  const { schoolToday, addDays } = await import('../src/server/attendance/attendance-rules');\n185\t  const settings = await prisma.schoolSettings.findUniqueOrThrow({ where: { id: 'singleton' } });\n186\t  const sections = await prisma.section.findMany({\n187\t    where: { name: { in: ['7A', '7B'] }, academicYear: { isCurrent: true } },\n188\t    select: { id: true },\n189\t  });\n190\t  const slots = await prisma.timetableSlot.findMany({\n191\t    where: { course: { sectionId: { in: sections.map((s) => s.id) }, archivedAt: null } },\n192\t    select: {\n193\t      dayOfWeek: true,\n194\t      periodId: true,\n195\t      course: {\n196\t        select: {\n197\t          id: true,\n198\t          teacherId: true,\n199\t          enrollments: { where: { status: 'ACTIVE' }, select: { student: { select: { id: true, email: true, lastName: true } } } },\n200\t        },\n201\t      },\n202\t    },\n203\t  });\n204\t  if (!slots.length) {\n205\t    console.log('Seed: no 7A/7B timetable slots found, skipping demo attendance');\n206\t    return;\n207\t  }\n208\t\n209\t  const teachingDays = new Set(\n210\t    (await prisma.schoolDay.findMany({ where: { isTeaching: true } })).map((d) => d.dayOfWeek),\n211\t  );\n212\t  const isTeaching = (d: string) => {\n213\t    const iso = new Date(`${d}T12:00:00Z`).getUTCDay() || 7;\n214\t    return teachingDays.size ? teachingDays.has(iso) : iso <= 5;\n215\t  };\n216\t  const days: string[] = [];\n217\t  for (let d = addDays(schoolToday(new Date(), settings.timezone), -1); days.length < 15; d = addDays(d, -1)) {\n218\t    if (isTeaching(d)) days.unshift(d);\n219\t  }\n220\t\n221\t  // Two named students forced below 85%: the demo student accounts if enrolled, else the first two by last name.\n222\t  const roster = [...new Map(slots.flatMap((s) => s.course.enrollments.map((e) => [e.student.id, e.student]))).values()];\n223\t  const named = roster.filter((s) => ['student@schoolhub.test', 'student2@schoolhub.test'].includes(s.email));\n224\t  const low = new Set(\n225\t    (named.length === 2 ? named : [...roster].sort((a, b) => a.lastName.localeCompare(b.lastName)).slice(0, 2)).map((s) => s.id),\n226\t  );\n227\t\n228\t  const courseIds = [...new Set(slots.map((s) => s.course.id))];\n229\t  const dbDate = (d: string) => new Date(`${d}T00:00:00Z`);\n230\t  await prisma.attendanceSession.deleteMany({\n231\t    where: { courseId: { in: courseIds }, date: { gte: dbDate(days[0]), lte: dbDate(days[days.length - 1]) } },\n232\t  });\n233\t\n234\t  const rng = mulberry32(20261107);\n235\t  let sessions = 0;\n236\t  for (const [dayIndex, day] of days.entries()) {\n237\t    const iso = new Date(`${day}T12:00:00Z`).getUTCDay() || 7;\n238\t    for (const slot of slots.filter((s) => s.dayOfWeek === iso)) {\n239\t      const records = slot.course.enrollments.map(({ student }) => {\n240\t        const r = rng();\n241\t        // Absent every 4th teaching day: 4 of 15 days -> 73% (< 85%) whatever the RNG does.\n242\t        if (low.has(student.id)) return { studentId: student.id, status: dayIndex % 4 === 0 ? ('ABSENT' as const) : ('PRESENT' as const) };\n243\t        if (r < 0.94) return { studentId: student.id, status: 'PRESENT' as const };\n244\t        if (r < 0.97) return { studentId: student.id, status: 'LATE' as const, minutesLate: 5 + Math.floor(rng() * 16) };\n245\t        return { studentId: student.id, status: 'ABSENT' as const };\n246\t      });\n247\t      await prisma.attendanceSession.create({\n248\t        data: {\n249\t          courseId: slot.course.id,\n250\t          periodId: slot.periodId,\n251\t          date: dbDate(day),\n252\t          takenById: slot.course.teacherId,\n253\t          updatedById: slot.course.teacherId,\n254\t          records: { create: records },\n255\t        },\n256\t      });\n257\t      sessions += 1;\n258\t    }\n259\t  }\n260\t  logger.info('Seed: demo attendance ready', { sessions, days: days.length, lowAttendance: low.size });\n261\t}\n262\t"}]},"parent_tool_use_id":null,"session_id":"88405567-c8b9-4e5f-8912-47ba3c7edb01","uuid":"216aa72b-eef3-43a8-8531-41176bdc79f8","timestamp":"2026-11-06T06:13:09.183Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/prisma/seed.ts","content":"async function seedAttendance() {\n  const { schoolToday, addDays } = await import('../src/server/attendance/attendance-rules');\n  const settings = await prisma.schoolSettings.findUniqueOrThrow({ where: { id: 'singleton' } });\n  const sections = await prisma.section.findMany({\n    where: { name: { in: ['7A', '7B'] }, academicYear: { isCurrent: true } },\n    select: { id: true },\n  });\n  const slots = await prisma.timetableSlot.findMany({\n    where: { course: { sectionId: { in: sections.map((s) => s.id) }, archivedAt: null } },\n    select: {\n      dayOfWeek: true,\n      periodId: true,\n      course: {\n        select: {\n          id: true,\n          teacherId: true,\n          enrollments: { where: { status: 'ACTIVE' }, select: { student: { select: { id: true, email: true, lastName: true } } } },\n        },\n      },\n    },\n  });\n  if (!slots.length) {\n    console.log('Seed: no 7A/7B timetable slots found, skipping demo attendance');\n    return;\n  }\n\n  const teachingDays = new Set(\n    (await prisma.schoolDay.findMany({ where: { isTeaching: true } })).map((d) => d.dayOfWeek),\n  );\n  const isTeaching = (d: string) => {\n    const iso = new Date(`${d}T12:00:00Z`).getUTCDay() || 7;\n    return teachingDays.size ? teachingDays.has(iso) : iso <= 5;\n  };\n  const days: string[] = [];\n  for (let d = addDays(schoolToday(new Date(), settings.timezone), -1); days.length < 15; d = addDays(d, -1)) {\n    if (isTeaching(d)) days.unshift(d);\n  }\n\n  // Two named students forced below 85%: the demo student accounts if enrolled, else the first two by last name.\n  const roster = [...new Map(slots.flatMap((s) => s.course.enrollments.map((e) => [e.student.id, e.student]))).values()];\n  const named = roster.filter((s) => ['student@schoolhub.test', 'student2@schoolhub.test'].includes(s.email));\n  const low = new Set(\n    (named.length === 2 ? named : [...roster].sort((a, b) => a.lastName.localeCompare(b.lastName)).slice(0, 2)).map((s) => s.id),\n  );\n\n  const courseIds = [...new Set(slots.map((s) => s.course.id))];\n  const dbDate = (d: string) => new Date(`${d}T00:00:00Z`);\n  await prisma.attendanceSession.deleteMany({\n    where: { courseId: { in: courseIds }, date: { gte: dbDate(days[0]), lte: dbDate(days[days.length - 1]) } },\n  });\n\n  const rng = mulberry32(20261107);\n  let sessions = 0;\n  for (const [dayIndex, day] of days.entries()) {\n    const iso = new Date(`${day}T12:00:00Z`).getUTCDay() || 7;\n    for (const slot of slots.filter((s) => s.dayOfWeek === iso)) {\n      const records = slot.course.enrollments.map(({ student }) => {\n        const r = rng();\n        // Absent every 4th teaching day: 4 of 15 days -> 73% (< 85%) whatever the RNG does.\n        if (low.has(student.id)) return { studentId: student.id, status: dayIndex % 4 === 0 ? ('ABSENT' as const) : ('PRESENT' as const) };\n        if (r < 0.94) return { studentId: student.id, status: 'PRESENT' as const };\n        if (r < 0.97) return { studentId: student.id, status: 'LATE' as const, minutesLate: 5 + Math.floor(rng() * 16) };\n        return { studentId: student.id, status: 'ABSENT' as const };\n      });\n      await prisma.attendanceSession.create({\n        data: {\n          courseId: slot.course.id,\n          periodId: slot.periodId,\n          date: dbDate(day),\n          takenById: slot.course.teacherId,\n          updatedById: slot.course.teacherId,\n          records: { create: records },\n        },\n      });\n      sessions += 1;\n    }\n  }\n  logger.info('Seed: demo attendance ready', { sessions, days: days.length, lowAttendance: low.size });\n}\n","numLines":80,"startLine":183,"totalLines":276}},"tool_result_meta":[{"id":"toolu_013xEvgXy2iptMHw3z1DxvmN","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
