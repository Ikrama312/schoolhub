ick={() => update(s.id, { noteOpen: !row.noteOpen })}\n209\t                  sx={{ width: 44, height: 44 }}\n210\t                  color={row.note ? 'primary' : 'default'}\n211\t                >\n212\t                  <StickyNote2OutlinedIcon />\n213\t                </IconButton>\n214\t              </Stack>\n215\t              {(row.status === 'LATE' || row.noteOpen) && (\n216\t                <Stack direction={{ xs: 'column', sm: 'row' }} spacing={1} sx={{ mt: 1, pl: { sm: 6 } }}>\n217\t                  {row.status === 'LATE' && (\n218\t                    <TextField\n219\t                      type=\"number\"\n220\t                      size=\"small\"\n221\t                      label=\"Minutes late\"\n222\t                      value={row.minutesLate}\n223\t                      disabled={locked}\n224\t                      onChange={(e) => update(s.id, { minutesLate: Number(e.target.value) })}\n225\t                      sx={{ width: { sm: 140 } }}\n226\t                      slotProps={{ htmlInput: { min: 1, max: MINUTES_LATE_MAX, 'aria-label': `Minutes late for ${name}` } }}\n227\t                    />\n228\t                  )}\n229\t                  {row.noteOpen && (\n230\t                    <TextField\n231\t                      size=\"small\"\n232\t                      label=\"Note\"\n233\t                      value={row.note}\n234\t                      disabled={locked}\n235\t                      onChange={(e) => update(s.id, { note: e.target.value })}\n236\t                      sx={{ flexGrow: 1 }}\n237\t                      slotProps={{ htmlInput: { maxLength: NOTE_MAX, 'aria-label': `Note for ${name}` } }}\n238\t                    />\n239\t                  )}\n240\t                </Stack>\n241\t              )}\n242\t            </Box>\n243\t          );\n244\t        })}\n245\t      </Paper>\n246\t\n247\t      <Paper\n248\t        elevation={3}\n249\t        sx={{ position: 'sticky', bottom: 0, mt: 2, p: 1.5, display: 'flex', align