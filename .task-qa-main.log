{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0151rkK2A9MSxk5riAP1vK9q","type":"tool_result","content":"1\timport type { Prisma, PrismaClient } from '@prisma/client';\n2\timport { prisma } from '@/server/db';\n3\timport { AppError } from '@/server/http';\n4\timport { logger } from '@/lib/logger';\n5\timport { dec, fixed2, type DecimalValue } from '@/server/assignments/grading-math';\n6\timport { getSchoolTimezone, isAssignmentVisible } from '@/server/assignments/assignments-service';\n7\timport { getStudentQuizScore } from '@/server/quiz/attempt-service';\n8\timport { resultsVisible } from '@/server/quiz/grading';\n9\timport { termFor } from './term-placement';\n10\t\n11\t/**\n12\t * PRD-11 source → gradebook sync (FR-3–FR-7, system-design §3.1). Every function is idempotent\n13\t * (GradeItem.sourceId and Grade's composite key, B19). Assignment hooks run inside the caller's\n14\t * transaction; quiz hooks run after commit and never throw.\n15\t *\n16\t * A7: isVisible is written only on source visibility transitions, so a teacher's hide survives\n17\t * plain re-saves of the source.\n18\t */\n19\t\n20\ttype Db = Prisma.TransactionClient | PrismaClient;\n21\t\n22\t// ---------------------------------------------------------------------------\n23\t// Pure row builders (shared with backfill.ts)\n24\t// ---------------------------------------------------------------------------\n25\t\n26\texport function itemFromAssignment(\n27\t  a: { id: string; courseId: string; title: string; maxPoints: DecimalValue; dueAt: Date; categoryId: string | null },\n28\t  termId: string,\n29\t) {\n30\t  return {\n31\t    courseId: a.courseId,\n32\t    categoryId: a.categoryId,\n33\t    termId,\n34\t    title: a.title,\n35\t    maxPoints: fixed2(a.maxPoints),\n36\t    dueAt: a.dueAt,\n37\t    source: 'ASSIGNMENT' as const,\n38\t    sourceId: a.id,\n39\t    isVisible: true,\n40\t  };\n41\t}\n42\t\n43\texport function itemFromQuiz(\n44\t  q: { id: string; courseId: string; title: string; availableUntil: Date; categoryId: string | null },\n45\t  maxPoints: DecimalValue,\n46\t  termId: string,\n47\t) {\n48\t  return {\n49\t    courseId: q.courseId,\n50\t    categoryId: q.categoryId,\n51\t    termId,\n52\t    title: q.title,\n53\t    maxPoints: fixed2(maxPoints),\n54\t    dueAt: q.availableUntil,\n55\t    source: 'QUIZ' as const,\n56\t    sourceId: q.id,\n57\t    isVisible: true,\n58\t  };\n59\t}\n60\t\n61\t/** FR-5 / FR-6 / A1: only RETURNED scores sync; an exemption row means excused. */\n62\texport function gradeFromSubmission(sub: { status: string; finalScore: DecimalValue | null } | null, exempt: boolean) {\n63\t  return {\n64\t    score: sub?.status === 'RETURNED' && sub.finalScore !== null ? fixed2(sub.finalScore) : null,\n65\t    excused: exempt,\n66\t  };\n67\t}\n68\t\n69\t/** FR-7: policy score scaled to the item's maxPoints. */\n70\texport function gradeFromQuizScore(result: { score: DecimalValue; maxScore: DecimalValue } | null, itemMaxPoints: DecimalValue): string | null {\n71\t  if (!result || !dec(result.maxScore).gt(0)) return null;\n72\t  return fixed2(dec(result.score).div(dec(result.maxScore)).mul(dec(itemMaxPoints)));\n73\t}\n74\t\n75\t// ---------------------------------------------------------------------------\n76\t// Helpers\n77\t// ---------------------------------------------------------------------------\n78\t\n79\t/** Terms of the course's academic year, ordered. */\n80\texport async function courseTerms(db: Db, courseId: string) {\n81\t  const course = await db.course.findUnique({ where: { id: courseId }, select: { academicYearId: true } });\n82\t  if (!course) return [];\n83\t  return db.term.findMany({ where: { academicYearId: course.academicYearId }, orderBy: { order: 'asc' } });\n84\t}\n85\t\n86\tasync function placeTerm(db: Db, courseId: string, date: Date | null, now: Date) {\n87\t  const [terms, tz] = await Promise.all([courseTerms(db, courseId), getSchoolTimezone()]);\n88\t  return termFor(date, terms, tz, now)?.id ?? null;\n89\t}\n90\t\n91\t/** FR-2: a categoryId on an assignment/quiz must belong to the same course. */\n92\texport async function assertCategoryInCourse(db: Db, courseId: string, categoryId: string | null | undefined) {\n93\t  if (!categoryId) return;\n94\t  const c = await db.gradeCategory.findUnique({ where: { id: categoryId }, select: { courseId: true } });\n95\t  if (!c || c.courseId !== courseId) {\n96\t    throw new AppError('VALIDATION_ERROR', 'That category does not belong to this course.', { fieldErrors: { categoryId: ['Unknown category'] } });\n97\t  }\n98\t}\n99\t\n100\tasync function upsertItem(\n101\t  db: Db,\n102\t  sourceId: string,\n103\t  visible: boolean,\n104\t  wasVisible: boolean | undefined,\n105\t  build: (termId: string) => ReturnType<typeof itemFromAssignment> | ReturnType<typeof itemFromQuiz>,\n106\t  placementDate: Date,\n107\t  courseId: string,\n108\t  now: Date,\n109\t) {\n110\t  const existing = await db.gradeItem.findUnique({ where: { sourceId }, select: { id: true, dueAt: true } });\n111\t  if (!existing) {\n112\t    if (!visible) return;\n113\t    const termId = await placeTerm(db, courseId, placementDate, now);\n114\t    if (!termId) {\n115\t      logger.warn('Gradebook sync skipped: no term for item (A6)', { sourceId, courseId });\n116\t      return;\n117\t    }\n118\t    // ON CONFLICT DO NOTHING: a concurrent sync of the same source may have created it (B19).\n119\t    await db.gradeItem.createMany({ data: [build(termId)], skipDuplicates: true });\n120\t    return;\n121\t  }\n122\t  const { courseId: _c, source: _s, sourceId: _id, isVisible: _v, termId: _t, ...fields } = build('');\n123\t  const data: Prisma.GradeItemUncheckedUpdateInput = { ...fields };\n124\t  // A10: re-place only when the date moved.\n125\t  if (existing.dueAt?.getTime() !== placementDate.getTime()) {\n126\t    const termId = await placeTerm(db, courseId, placementDate, now);\n127\t    if (termId) data.termId = termId;\n128\t  }\n129\t  if (!visible) data.isVisible = false;\n130\t  else if (wasVisible === false) data.isVisible = true;\n131\t  await db.gradeItem.update({ where: { id: existing.id }, data });\n132\t}\n133\t\n134\t// ---------------------------------------------------------------------------\n135\t// Item sync (FR-3, FR-4)\n136\t// ---------------------------------------------------------------------------\n137\t\n138\t/** Create/refresh the item for an assignment. `wasVisible` is the source's visibility before this write. */\n139\texport async function upsertItemFromAssignment(db: Db, assignmentId: string, opts: { wasVisible?: boolean; now?: Date } = {}) {\n140\t  const now = opts.now ?? new Date();\n141\t  const a = await db.assignment.findUnique({\n142\t    where: { id: assignmentId },\n143\t    select: { id: true, courseId: true, title: true, maxPoints: true, dueAt: true, categoryId: true, status: true, availableFrom: true, archivedAt: true },\n144\t  });\n145\t  if (!a) return;\n146\t  await upsertItem(db, a.id, isAssignmentVisible(a, now), opts.wasVisible, (termId) => itemFromAssignment(a, termId), a.dueAt, a.courseId, now);\n147\t}\n148\t\n149\t/** A15: PUBLISHED and CLOSED quizzes are visible; practice quizzes never have an item. */\n150\texport async function upsertItemFromQuiz(db: Db, quizId: string, opts: { wasVisible?: boolean; now?: Date } = {}) {\n151\t  const now = opts.now ?? new Date();\n152\t  const q = await db.quiz.findUnique({\n153\t    where: { id: quizId },\n154\t    select: { id: true, courseId: true, title: true, availableUntil: true, categoryId: true, status: true, isPractice: true, questions: { select: { points: true } } },\n155\t  });\n156\t  if (!q) return;\n157\t  if (q.isPractice) return deleteItemForSource(db, q.id);\n158\t  const max = q.questions.reduce((s, x) => s.plus(dec(x.points)), dec(0));\n159\t  await upsertItem(db, q.id, q.status !== 'DRAFT', opts.wasVisible, (termId) => itemFromQuiz(q, max, termId), q.availableUntil, q.courseId, now);\n160\t}\n161\t\n162\t/** Archive → hidden (FR-4). */\n163\texport async function hideItemForSource(db: Db, sourceId: string) {\n164\t  await db.gradeItem.updateMany({ where: { sourceId }, data: { isVisible: false } });\n165\t}\n166\t\n167\t/** Source deleted → item and its grades deleted (cascade). */\n168\texport async function deleteItemForSource(db: Db, sourceId: string) {\n169\t  await db.gradeItem.deleteMany({ where: { sourceId } });\n170\t}\n171\t\n172\t// ---------------------------------------------------------------------------\n173\t// Grade sync (FR-5–FR-7)\n174\t// ---------------------------------------------------------------------------\n175\t\n176\t/** FR-5/FR-6: call after any write to a submission or exemption. No-op without an item. */\n177\texport async function syncSubmissionGrade(db: Db, assignmentId: string, studentId: string, actorId?: string) {\n178\t  const item = await db.gradeItem.findUnique({ where: { sourceId: assignmentId }, select: { id: true } });\n179\t  if (!item) return;\n180\t  const [a, sub, exemption, existing] = await Promise.all([\n181\t    db.assignment.findUnique({ where: { id: assignmentId }, select: { createdById: true } }),\n182\t    db.submission.findUnique({ where: { assignmentId_studentId: { assignmentId, studentId } }, select: { status: true, finalScore: true } }),\n183\t    db.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId, studentId } }, select: { studentId: true } }),\n184\t    db.grade.findUnique({ where: { gradeItemId_studentId: { gradeItemId: item.id, studentId } }, select: { studentId: true } }),\n185\t  ]);\n186\t  const g = gradeFromSubmission(sub, !!exemption);\n187\t  if (!existing && g.score === null && !g.excused) return;\n188\t  const updatedById = actorId ?? a?.createdById ?? studentId;\n189\t  await db.grade.upsert({\n190\t    where: { gradeItemId_studentId: { gradeItemId: item.id, studentId } },\n191\t    create: { gradeItemId: item.id, studentId, ...g, updatedById },\n192\t    update: { ...g, updatedById },\n193\t  });\n194\t}\n195\t\n196\t/** FR-7: GRADED ∧ results visible ∧ not practice → upsert the policy score. Never throws (runs after commit). */\n197\texport async function syncQuizGrade(quizId: string, studentId: string, now = new Date()) {\n198\t  try {\n199\t    const [quiz, item] = await Promise.all([\n200\t      prisma.quiz.findUnique({ where: { id: quizId }, select: { isPractice: true, resultsVisibility: true, availableUntil: true, resultsReleasedAt: true, createdById: true } }),\n201\t      prisma.gradeItem.findUnique({ where: { sourceId: quizId }, select: { id: true, maxPoints: true } }),\n202\t    ]);\n203\t    if (!quiz || !item || quiz.isPractice) return;\n204\t    // Unreleased scores are never written (NFR-5 layer 1).\n205\t    if (!resultsVisible(quiz, { status: 'GRADED' }, now)) return;\n206\t    const result = await getStudentQuizScore(quizId, studentId);\n207\t    const score = gradeFromQuizScore(result, item.maxPoints);\n208\t    const key = { gradeItemId_studentId: { gradeItemId: item.id, studentId } };\n209\t    if (score === null) {\n210\t      // e.g. a regrade sent the only graded attempt back to NEEDS_GRADING.\n211\t      await prisma.grade.updateMany({ where: { gradeItemId: item.id, studentId }, data: { score: null, updatedById: quiz.createdById } });\n212\t      return;\n213\t    }\n214\t    await prisma.grade.upsert({\n215\t      where: key,\n216\t      create: { gradeItemId: item.id, studentId, score, updatedById: quiz.createdById },\n217\t      update: { score, updatedById: quiz.createdById },\n218\t    });\n219\t  } catch (error) {\n220\t    logger.error('syncQuizGrade failed', { quizId, studentId, message: error instanceof Error ? error.message : String(error) });\n221\t  }\n222\t}\n223\t\n224\t/** Release / close (R1): every student with a submitted attempt. Never throws. */\n225\texport async function syncQuizGrades(quizId: string, now = new Date()) {\n226\t  try {\n227\t    const rows = await prisma.quizAttempt.findMany({ where: { quizId, status: { not: 'IN_PROGRESS' } }, select: { studentId: true }, distinct: ['studentId'] });\n228\t    // ponytail: one getStudentQuizScore per student (~3 queries each); batch like backfill.ts if classes grow past a few hundred.\n229\t    for (const r of rows) await syncQuizGrade(quizId, r.studentId, now);\n230\t  } catch (error) {\n231\t    logger.error('syncQuizGrades failed', { quizId, message: error instanceof Error ? error.message : String(error) });\n232\t  }\n233\t}\n234\t"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"bed297e2-3bee-4ab8-8e6e-b203b9cf1521","timestamp":"2026-11-09T14:01:47.978Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/gradebook/gradebook-sync.ts","content":"import type { Prisma, PrismaClient } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { logger } from '@/lib/logger';\nimport { dec, fixed2, type DecimalValue } from '@/server/assignments/grading-math';\nimport { getSchoolTimezone, isAssignmentVisible } from '@/server/assignments/assignments-service';\nimport { getStudentQuizScore } from '@/server/quiz/attempt-service';\nimport { resultsVisible } from '@/server/quiz/grading';\nimport { termFor } from './term-placement';\n\n/**\n * PRD-11 source → gradebook sync (FR-3–FR-7, system-design §3.1). Every function is idempotent\n * (GradeItem.sourceId and Grade's composite key, B19). Assignment hooks run inside the caller's\n * transaction; quiz hooks run after commit and never throw.\n *\n * A7: isVisible is written only on source visibility transitions, so a teacher's hide survives\n * plain re-saves of the source.\n */\n\ntype Db = Prisma.TransactionClient | PrismaClient;\n\n// ---------------------------------------------------------------------------\n// Pure row builders (shared with backfill.ts)\n// ---------------------------------------------------------------------------\n\nexport function itemFromAssignment(\n  a: { id: string; courseId: string; title: string; maxPoints: DecimalValue; dueAt: Date; categoryId: string | null },\n  termId: string,\n) {\n  return {\n    courseId: a.courseId,\n    categoryId: a.categoryId,\n    termId,\n    title: a.title,\n    maxPoints: fixed2(a.maxPoints),\n    dueAt: a.dueAt,\n    source: 'ASSIGNMENT' as const,\n    sourceId: a.id,\n    isVisible: true,\n  };\n}\n\nexport function itemFromQuiz(\n  q: { id: string; courseId: string; title: string; availableUntil: Date; categoryId: string | null },\n  maxPoints: DecimalValue,\n  termId: string,\n) {\n  return {\n    courseId: q.courseId,\n    categoryId: q.categoryId,\n    termId,\n    title: q.title,\n    maxPoints: fixed2(maxPoints),\n    dueAt: q.availableUntil,\n    source: 'QUIZ' as const,\n    sourceId: q.id,\n    isVisible: true,\n  };\n}\n\n/** FR-5 / FR-6 / A1: only RETURNED scores sync; an exemption row means excused. */\nexport function gradeFromSubmission(sub: { status: string; finalScore: DecimalValue | null } | null, exempt: boolean) {\n  return {\n    score: sub?.status === 'RETURNED' && sub.finalScore !== null ? fixed2(sub.finalScore) : null,\n    excused: exempt,\n  };\n}\n\n/** FR-7: policy score scaled to the item's maxPoints. */\nexport function gradeFromQuizScore(result: { score: DecimalValue; maxScore: DecimalValue } | null, itemMaxPoints: DecimalValue): string | null {\n  if (!result || !dec(result.maxScore).gt(0)) return null;\n  return fixed2(dec(result.score).div(dec(result.maxScore)).mul(dec(itemMaxPoints)));\n}\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\n/** Terms of the course's academic year, ordered. */\nexport async function courseTerms(db: Db, courseId: string) {\n  const course = await db.course.findUnique({ where: { id: courseId }, select: { academicYearId: true } });\n  if (!course) return [];\n  return db.term.findMany({ where: { academicYearId: course.academicYearId }, orderBy: { order: 'asc' } });\n}\n\nasync function placeTerm(db: Db, courseId: string, date: Date | null, now: Date) {\n  const [terms, tz] = await Promise.all([courseTerms(db, courseId), getSchoolTimezone()]);\n  return termFor(date, terms, tz, now)?.id ?? null;\n}\n\n/** FR-2: a categoryId on an assignment/quiz must belong to the same course. */\nexport async function assertCategoryInCourse(db: Db, courseId: string, categoryId: string | null | undefined) {\n  if (!categoryId) return;\n  const c = await db.gradeCategory.findUnique({ where: { id: categoryId }, select: { courseId: true } });\n  if (!c || c.courseId !== courseId) {\n    throw new AppError('VALIDATION_ERROR', 'That category does not belong to this course.', { fieldErrors: { categoryId: ['Unknown category'] } });\n  }\n}\n\nasync function upsertItem(\n  db: Db,\n  sourceId: string,\n  visible: boolean,\n  wasVisible: boolean | undefined,\n  build: (termId: string) => ReturnType<typeof itemFromAssignment> | ReturnType<typeof itemFromQuiz>,\n  placementDate: Date,\n  courseId: string,\n  now: Date,\n) {\n  const existing = await db.gradeItem.findUnique({ where: { sourceId }, select: { id: true, dueAt: true } });\n  if (!existing) {\n    if (!visible) return;\n    const termId = await placeTerm(db, courseId, placementDate, now);\n    if (!termId) {\n      logger.warn('Gradebook sync skipped: no term for item (A6)', { sourceId, courseId });\n      return;\n    }\n    // ON CONFLICT DO NOTHING: a concurrent sync of the same source may have created it (B19).\n    await db.gradeItem.createMany({ data: [build(termId)], skipDuplicates: true });\n    return;\n  }\n  const { courseId: _c, source: _s, sourceId: _id, isVisible: _v, termId: _t, ...fields } = build('');\n  const data: Prisma.GradeItemUncheckedUpdateInput = { ...fields };\n  // A10: re-place only when the date moved.\n  if (existing.dueAt?.getTime() !== placementDate.getTime()) {\n    const termId = await placeTerm(db, courseId, placementDate, now);\n    if (termId) data.termId = termId;\n  }\n  if (!visible) data.isVisible = false;\n  else if (wasVisible === false) data.isVisible = true;\n  await db.gradeItem.update({ where: { id: existing.id }, data });\n}\n\n// ---------------------------------------------------------------------------\n// Item sync (FR-3, FR-4)\n// ---------------------------------------------------------------------------\n\n/** Create/refresh the item for an assignment. `wasVisible` is the source's visibility before this write. */\nexport async function upsertItemFromAssignment(db: Db, assignmentId: string, opts: { wasVisible?: boolean; now?: Date } = {}) {\n  const now = opts.now ?? new Date();\n  const a = await db.assignment.findUnique({\n    where: { id: assignmentId },\n    select: { id: true, courseId: true, title: true, maxPoints: true, dueAt: true, categoryId: true, status: true, availableFrom: true, archivedAt: true },\n  });\n  if (!a) return;\n  await upsertItem(db, a.id, isAssignmentVisible(a, now), opts.wasVisible, (termId) => itemFromAssignment(a, termId), a.dueAt, a.courseId, now);\n}\n\n/** A15: PUBLISHED and CLOSED quizzes are visible; practice quizzes never have an item. */\nexport async function upsertItemFromQuiz(db: Db, quizId: string, opts: { wasVisible?: boolean; now?: Date } = {}) {\n  const now = opts.now ?? new Date();\n  const q = await db.quiz.findUnique({\n    where: { id: quizId },\n    select: { id: true, courseId: true, title: true, availableUntil: true, categoryId: true, status: true, isPractice: true, questions: { select: { points: true } } },\n  });\n  if (!q) return;\n  if (q.isPractice) return deleteItemForSource(db, q.id);\n  const max = q.questions.reduce((s, x) => s.plus(dec(x.points)), dec(0));\n  await upsertItem(db, q.id, q.status !== 'DRAFT', opts.wasVisible, (termId) => itemFromQuiz(q, max, termId), q.availableUntil, q.courseId, now);\n}\n\n/** Archive → hidden (FR-4). */\nexport async function hideItemForSource(db: Db, sourceId: string) {\n  await db.gradeItem.updateMany({ where: { sourceId }, data: { isVisible: false } });\n}\n\n/** Source deleted → item and its grades deleted (cascade). */\nexport async function deleteItemForSource(db: Db, sourceId: string) {\n  await db.gradeItem.deleteMany({ where: { sourceId } });\n}\n\n// ---------------------------------------------------------------------------\n// Grade sync (FR-5–FR-7)\n// ---------------------------------------------------------------------------\n\n/** FR-5/FR-6: call after any write to a submission or exemption. No-op without an item. */\nexport async function syncSubmissionGrade(db: Db, assignmentId: string, studentId: string, actorId?: string) {\n  const item = await db.gradeItem.findUnique({ where: { sourceId: assignmentId }, select: { id: true } });\n  if (!item) return;\n  const [a, sub, exemption, existing] = await Promise.all([\n    db.assignment.findUnique({ where: { id: assignmentId }, select: { createdById: true } }),\n    db.submission.findUnique({ where: { assignmentId_studentId: { assignmentId, studentId } }, select: { status: true, finalScore: true } }),\n    db.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId, studentId } }, select: { studentId: true } }),\n    db.grade.findUnique({ where: { gradeItemId_studentId: { gradeItemId: item.id, studentId } }, select: { studentId: true } }),\n  ]);\n  const g = gradeFromSubmission(sub, !!exemption);\n  if (!existing && g.score === null && !g.excused) return;\n  const updatedById = actorId ?? a?.createdById ?? studentId;\n  await db.grade.upsert({\n    where: { gradeItemId_studentId: { gradeItemId: item.id, studentId } },\n    create: { gradeItemId: item.id, studentId, ...g, updatedById },\n    update: { ...g, updatedById },\n  });\n}\n\n/** FR-7: GRADED ∧ results visible ∧ not practice → upsert the policy score. Never throws (runs after commit). */\nexport async function syncQuizGrade(quizId: string, studentId: string, now = new Date()) {\n  try {\n    const [quiz, item] = await Promise.all([\n      prisma.quiz.findUnique({ where: { id: quizId }, select: { isPractice: true, resultsVisibility: true, availableUntil: true, resultsReleasedAt: true, createdById: true } }),\n      prisma.gradeItem.findUnique({ where: { sourceId: quizId }, select: { id: true, maxPoints: true } }),\n    ]);\n    if (!quiz || !item || quiz.isPractice) return;\n    // Unreleased scores are never written (NFR-5 layer 1).\n    if (!resultsVisible(quiz, { status: 'GRADED' }, now)) return;\n    const result = await getStudentQuizScore(quizId, studentId);\n    const score = gradeFromQuizScore(result, item.maxPoints);\n    const key = { gradeItemId_studentId: { gradeItemId: item.id, studentId } };\n    if (score === null) {\n      // e.g. a regrade sent the only graded attempt back to NEEDS_GRADING.\n      await prisma.grade.updateMany({ where: { gradeItemId: item.id, studentId }, data: { score: null, updatedById: quiz.createdById } });\n      return;\n    }\n    await prisma.grade.upsert({\n      where: key,\n      create: { gradeItemId: item.id, studentId, score, updatedById: quiz.createdById },\n      update: { score, updatedById: quiz.createdById },\n    });\n  } catch (error) {\n    logger.error('syncQuizGrade failed', { quizId, studentId, message: error instanceof Error ? error.message : String(error) });\n  }\n}\n\n/** Release / close (R1): every student with a submitted attempt. Never throws. */\nexport async function syncQuizGrades(quizId: string, now = new Date()) {\n  try {\n    const rows = await prisma.quizAttempt.findMany({ where: { quizId, status: { not: 'IN_PROGRESS' } }, select: { studentId: true }, distinct: ['studentId'] });\n    // ponytail: one getStudentQuizScore per student (~3 queries each); batch like backfill.ts if classes grow past a few hundred.\n    for (const r of rows) await syncQuizGrade(quizId, r.studentId, now);\n  } catch (error) {\n    logger.error('syncQuizGrades failed', { quizId, message: error instanceof Error ? error.message : String(error) });\n  }\n}\n","numLines":234,"startLine":1,"totalLines":234}},"tool_result_meta":[{"id":"toolu_0151rkK2A9MSxk5riAP1vK9q","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
