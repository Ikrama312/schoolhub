{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GDMrANmQrfMuUPF8Sxs8ji","type":"tool_result","content":"1\timport { prisma } from '@/server/db';\n2\timport { toCsv } from '@/server/csv';\n3\timport type { AccessUser } from '@/server/auth/student-access';\n4\timport { Decimal, dec, fixed2 } from '@/server/assignments/grading-math';\n5\timport { percentOf } from './grading';\n6\timport { manageCourseOrNotFound, quizNotFound } from './access';\n7\t\n8\t/**\n9\t * FR-26/FR-27: in-memory aggregation over submitted attempts (class sizes are small).\n10\t */\n11\t\n12\ttype Option = { id: string; text: string };\n13\t\n14\tasync function load(user: AccessUser, quizId: string) {\n15\t  const quiz = await prisma.quiz.findUnique({\n16\t    where: { id: quizId },\n17\t    select: {\n18\t      courseId: true,\n19\t      questions: { orderBy: { order: 'asc' } },\n20\t      attempts: {\n21\t        where: { status: { not: 'IN_PROGRESS' } },\n22\t        include: { answers: true, student: { select: { firstName: true, lastName: true } } },\n23\t        orderBy: [{ student: { lastName: 'asc' } }, { attemptNumber: 'asc' }],\n24\t      },\n25\t    },\n26\t  });\n27\t  if (!quiz) throw quizNotFound();\n28\t  await manageCourseOrNotFound(user, quiz.courseId);\n29\t  return quiz;\n30\t}\n31\t\n32\texport const HISTOGRAM_LABELS = Array.from({ length: 10 }, (_, i) => `${i * 10}–${i * 10 + 10}`);\n33\t\n34\t/** 10 buckets by percent; 100 % lands in the last bucket. Pure. */\n35\texport function histogram(percents: readonly number[]) {\n36\t  const counts = new Array(10).fill(0) as number[];\n37\t  for (const p of percents) counts[Math.min(9, Math.max(0, Math.floor(p / 10)))]++;\n38\t  return HISTOGRAM_LABELS.map((bucket, i) => ({ bucket, count: counts[i] }));\n39\t}\n40\t\n41\tfunction median(sorted: readonly Decimal[]): Decimal | null {\n42\t  if (!sorted.length) return null;\n43\t  const mid = Math.floor(sorted.length / 2);\n44\t  return sorted.length % 2 ? sorted[mid] : sorted[mid - 1].plus(sorted[mid]).div(2);\n45\t}\n46\t\n47\texport async function getQuizAnalytics(user: AccessUser, quizId: string) {\n48\t  const quiz = await load(user, quizId);\n49\t  const attempts = quiz.attempts;\n50\t  const scores = attempts.map((a) => dec(a.score ?? 0)).sort((x, y) => x.comparedTo(y));\n51\t  const n = scores.length;\n52\t  const times = attempts.filter((a) => a.submittedAt).map((a) => (a.submittedAt!.getTime() - a.startedAt.getTime()) / 1000);\n53\t\n54\t  const summary = {\n55\t    attempts: n,\n56\t    average: n ? fixed2(scores.reduce((s, x) => s.plus(x), new Decimal(0)).div(n)) : null,\n57\t    median: n ? fixed2(median(scores)!) : null,\n58\t    highest: n ? fixed2(scores[n - 1]) : null,\n59\t    lowest: n ? fixed2(scores[0]) : null,\n60\t    averageTimeSeconds: times.length ? Math.round(times.reduce((s, t) => s + t, 0) / times.length) : null,\n61\t  };\n62\t\n63\t  const questions = quiz.questions.map((q) => {\n64\t    const answers = attempts.map((a) => a.answers.find((x) => x.questionId === q.id)).filter((a) => a !== undefined);\n65\t    const graded = answers.filter((a) => a.pointsAwarded !== null);\n66\t    const isChoice = q.type === 'SINGLE_CHOICE' || q.type === 'MULTIPLE_CHOICE';\n67\t    const correct = (q.correct ?? {}) as { optionId?: string; optionIds?: string[] };\n68\t    const correctIds = new Set(q.type === 'SINGLE_CHOICE' ? [correct.optionId] : correct.optionIds ?? []);\n69\t    let optionDistribution: { optionId: string; text: string; count: number; isCorrect: boolean }[] | null = null;\n70\t    let mostChosenWrongOptionId: string | null = null;\n71\t    if (isChoice) {\n72\t      const counts = new Map<string, number>();\n73\t      for (const a of answers) {\n74\t        const r = (a.response ?? {}) as { optionId?: string; optionIds?: string[] };\n75\t        for (const id of q.type === 'SINGLE_CHOICE' ? [r.optionId] : r.optionIds ?? []) if (id) counts.set(id, (counts.get(id) ?? 0) + 1);\n76\t      }\n77\t      optionDistribution = ((q.options ?? []) as Option[]).map((o) => ({ optionId: o.id, text: o.text, count: counts.get(o.id) ?? 0, isCorrect: correctIds.has(o.id) }));\n78\t      const wrong = optionDistribution.filter((o) => !o.isCorrect && o.count > 0).sort((x, y) => y.count - x.count);\n79\t      mostChosenWrongOptionId = wrong[0]?.optionId ?? null;\n80\t    }\n81\t    return {\n82\t      questionId: q.id,\n83\t      order: q.order,\n84\t      type: q.type,\n85\t      prompt: q.prompt,\n86\t      points: fixed2(q.points),\n87\t      percentCorrect: answers.length ? Math.round((answers.filter((a) => a.isCorrect === true).length / answers.length) * 1000) / 10 : null,\n88\t      averagePoints: graded.length ? fixed2(graded.reduce((s, a) => s.plus(dec(a.pointsAwarded!)), new Decimal(0)).div(graded.length)) : null,\n89\t      optionDistribution,\n90\t      mostChosenWrongOptionId,\n91\t    };\n92\t  });\n93\t\n94\t  return { summary, histogram: histogram(attempts.map((a) => percentOf(a.score ?? 0, a.maxScore) ?? 0)), questions };\n95\t}\n96\texport type QuizAnalytics = Awaited<ReturnType<typeof getQuizAnalytics>>;\n97\t\n98\t/** FR-27 CSV: student, attemptNumber, score, then one points column per question in quiz order. */\n99\texport async function analyticsCsv(user: AccessUser, quizId: string): Promise<string> {\n100\t  const quiz = await load(user, quizId);\n101\t  const columns = [\n102\t    { key: 'student', header: 'Student' },\n103\t    { key: 'attemptNumber', header: 'Attempt' },\n104\t    { key: 'score', header: 'Score' },\n105\t    ...quiz.questions.map((q, i) => ({ key: q.id, header: `Q${i + 1} (${fixed2(q.points)})` })),\n106\t  ];\n107\t  const rows = quiz.attempts.map((a) => ({\n108\t    student: `${a.student.firstName} ${a.student.lastName}`,\n109\t    attemptNumber: a.attemptNumber,\n110\t    score: a.score === null ? '' : fixed2(a.score),\n111\t    ...Object.fromEntries(\n112\t      quiz.questions.map((q) => {\n113\t        const ans = a.answers.find((x) => x.questionId === q.id);\n114\t        return [q.id, ans?.pointsAwarded == null ? '' : fixed2(ans.pointsAwarded)];\n115\t      }),\n116\t    ),\n117\t  }));\n118\t  return toCsv(columns, rows);\n119\t}\n120\t"}]},"parent_tool_use_id":null,"session_id":"1873d368-49d2-4130-ab97-f8c75b3c27a8","uuid":"30f874ec-8abe-4dde-ace1-23e7982971bc","timestamp":"2026-11-09T07:54:01.633Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/src/server/quiz/analytics.ts","content":"import { prisma } from '@/server/db';\nimport { toCsv } from '@/server/csv';\nimport type { AccessUser } from '@/server/auth/student-access';\nimport { Decimal, dec, fixed2 } from '@/server/assignments/grading-math';\nimport { percentOf } from './grading';\nimport { manageCourseOrNotFound, quizNotFound } from './access';\n\n/**\n * FR-26/FR-27: in-memory aggregation over submitted attempts (class sizes are small).\n */\n\ntype Option = { id: string; text: string };\n\nasync function load(user: AccessUser, quizId: string) {\n  const quiz = await prisma.quiz.findUnique({\n    where: { id: quizId },\n    select: {\n      courseId: true,\n      questions: { orderBy: { order: 'asc' } },\n      attempts: {\n        where: { status: { not: 'IN_PROGRESS' } },\n        include: { answers: true, student: { select: { firstName: true, lastName: true } } },\n        orderBy: [{ student: { lastName: 'asc' } }, { attemptNumber: 'asc' }],\n      },\n    },\n  });\n  if (!quiz) throw quizNotFound();\n  await manageCourseOrNotFound(user, quiz.courseId);\n  return quiz;\n}\n\nexport const HISTOGRAM_LABELS = Array.from({ length: 10 }, (_, i) => `${i * 10}–${i * 10 + 10}`);\n\n/** 10 buckets by percent; 100 % lands in the last bucket. Pure. */\nexport function histogram(percents: readonly number[]) {\n  const counts = new Array(10).fill(0) as number[];\n  for (const p of percents) counts[Math.min(9, Math.max(0, Math.floor(p / 10)))]++;\n  return HISTOGRAM_LABELS.map((bucket, i) => ({ bucket, count: counts[i] }));\n}\n\nfunction median(sorted: readonly Decimal[]): Decimal | null {\n  if (!sorted.length) return null;\n  const mid = Math.floor(sorted.length / 2);\n  return sorted.length % 2 ? sorted[mid] : sorted[mid - 1].plus(sorted[mid]).div(2);\n}\n\nexport async function getQuizAnalytics(user: AccessUser, quizId: string) {\n  const quiz = await load(user, quizId);\n  const attempts = quiz.attempts;\n  const scores = attempts.map((a) => dec(a.score ?? 0)).sort((x, y) => x.comparedTo(y));\n  const n = scores.length;\n  const times = attempts.filter((a) => a.submittedAt).map((a) => (a.submittedAt!.getTime() - a.startedAt.getTime()) / 1000);\n\n  const summary = {\n    attempts: n,\n    average: n ? fixed2(scores.reduce((s, x) => s.plus(x), new Decimal(0)).div(n)) : null,\n    median: n ? fixed2(median(scores)!) : null,\n    highest: n ? fixed2(scores[n - 1]) : null,\n    lowest: n ? fixed2(scores[0]) : null,\n    averageTimeSeconds: times.length ? Math.round(times.reduce((s, t) => s + t, 0) / times.length) : null,\n  };\n\n  const questions = quiz.questions.map((q) => {\n    const answers = attempts.map((a) => a.answers.find((x) => x.questionId === q.id)).filter((a) => a !== undefined);\n    const graded = answers.filter((a) => a.pointsAwarded !== null);\n    const isChoice = q.type === 'SINGLE_CHOICE' || q.type === 'MULTIPLE_CHOICE';\n    const correct = (q.correct ?? {}) as { optionId?: string; optionIds?: string[] };\n    const correctIds = new Set(q.type === 'SINGLE_CHOICE' ? [correct.optionId] : correct.optionIds ?? []);\n    let optionDistribution: { optionId: string; text: string; count: number; isCorrect: boolean }[] | null = null;\n    let mostChosenWrongOptionId: string | null = null;\n    if (isChoice) {\n      const counts = new Map<string, number>();\n      for (const a of answers) {\n        const r = (a.response ?? {}) as { optionId?: string; optionIds?: string[] };\n        for (const id of q.type === 'SINGLE_CHOICE' ? [r.optionId] : r.optionIds ?? []) if (id) counts.set(id, (counts.get(id) ?? 0) + 1);\n      }\n      optionDistribution = ((q.options ?? []) as Option[]).map((o) => ({ optionId: o.id, text: o.text, count: counts.get(o.id) ?? 0, isCorrect: correctIds.has(o.id) }));\n      const wrong = optionDistribution.filter((o) => !o.isCorrect && o.count > 0).sort((x, y) => y.count - x.count);\n      mostChosenWrongOptionId = wrong[0]?.optionId ?? null;\n    }\n    return {\n      questionId: q.id,\n      order: q.order,\n      type: q.type,\n      prompt: q.prompt,\n      points: fixed2(q.points),\n      percentCorrect: answers.length ? Math.round((answers.filter((a) => a.isCorrect === true).length / answers.length) * 1000) / 10 : null,\n      averagePoints: graded.length ? fixed2(graded.reduce((s, a) => s.plus(dec(a.pointsAwarded!)), new Decimal(0)).div(graded.length)) : null,\n      optionDistribution,\n      mostChosenWrongOptionId,\n    };\n  });\n\n  return { summary, histogram: histogram(attempts.map((a) => percentOf(a.score ?? 0, a.maxScore) ?? 0)), questions };\n}\nexport type QuizAnalytics = Awaited<ReturnType<typeof getQuizAnalytics>>;\n\n/** FR-27 CSV: student, attemptNumber, score, then one points column per question in quiz order. */\nexport async function analyticsCsv(user: AccessUser, quizId: string): Promise<string> {\n  const quiz = await load(user, quizId);\n  const columns = [\n    { key: 'student', header: 'Student' },\n    { key: 'attemptNumber', header: 'Attempt' },\n    { key: 'score', header: 'Score' },\n    ...quiz.questions.map((q, i) => ({ key: q.id, header: `Q${i + 1} (${fixed2(q.points)})` })),\n  ];\n  const rows = quiz.attempts.map((a) => ({\n    student: `${a.student.firstName} ${a.student.lastName}`,\n    attemptNumber: a.attemptNumber,\n    score: a.score === null ? '' : fixed2(a.score),\n    ...Object.fromEntries(\n      quiz.questions.map((q) => {\n        const ans = a.answers.find((x) => x.questionId === q.id);\n        return [q.id, ans?.pointsAwarded == null ? '' : fixed2(ans.pointsAwarded)];\n      }),\n    ),\n  }));\n  return toCsv(columns, rows);\n}\n","numLines":120,"startLine":1,"totalLines":120}},"tool_result_meta":[{"id":"toolu_01GDMrANmQrfMuUPF8Sxs8ji","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
