{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EWhrNXyXc8LxncomhPnyiY","type":"tool_result","content":"12\t\n13\t/** SH-13 QA: FR-11 composer behaviour, FR-7 blocked state, and the messaging validators (FR-11/12/21/22). */\n14\t\n15\tconst api = vi.fn();\n16\tvi.mock('@/components/messaging/usePolling', () => ({ api: (...a: unknown[]) => api(...a) }));\n17\tvi.mock('@/components/FileUpload/FileUpload', () => ({ FileUpload: () => null }));\n18\t\n19\timport { CANNOT_SEND, Composer } from '@/components/messaging/Composer';\n20\t\n21\tconst box = () => screen.getByRole('textbox', { name: 'Message' });\n22\t\n23\tdescribe('Composer (FR-11, FR-7)', () => {\n24\t  beforeEach(() => api.mockReset());\n25\t\n26\t  it('Enter sends, Shift+Enter does not', async () => {\n27\t    api.mockResolvedValue({ data: { message: { id: 'm1' } } });\n28\t    const onSent = vi.fn();\n29\t    render(<Composer conversationId=\"c1\" canSend onSent={onSent} />);\n30\t    fireEvent.change(box(), { target: { value: 'hello' } });\n31\t    fireEvent.keyDown(box(), { key: 'Enter', shiftKey: true });\n32\t    expect(api).not.toHaveBeenCalled();\n33\t    fireEvent.keyDown(box(), { key: 'Enter' });\n34\t    await waitFor(() => expect(onSent).toHaveBeenCalledWith({ id: 'm1' }));\n35\t    expect(api).toHaveBeenCalledWith('/api/conversations/c1/messages', { method: 'POST', body: { body: 'hello', fileIds: [] } });\n36\t    expect(box()).toHaveValue('');\n37\t  });\n38\t\n39\t  it('does not send a blank message', () => {\n40\t    render(<Composer conversationId=\"c1\" canSend onSent={() => {}} />);\n41\t    fireEvent.change(box(), { target: { value: '   ' } });\n42\t    fireEvent.keyDown(box(), { key: 'Enter' });\n43\t    expect(api).not.toHaveBeenCalled();\n44\t  });\n45\t\n46\t  it(`shows the counter only after ${COUNTER_FROM} characters`, () => {\n47\t    render(<Composer conversationId=\"c1\" canSend onSent={() => {}} />);\n48\t    fireEvent.change(box(), { target: { value: 'a'.repeat(COUNTER_FROM) } });\n49\t    expect(screen.queryByText(`${COUNTER_FROM} / ${BODY_MAX}`)).not.toBeInTheDocument();\n50\t    fireEvent.change(box(), { target: { value: 'a'.repeat(COUNTER_FROM + 1) } });\n51\t    expect(screen.getByText(`${COUNTER_FROM + 1} / ${BODY_MAX}`)).toBeInTheDocument();"}]},"parent_tool_use_id":null,"session_id":"b2a19e14-003d-496b-9902-59b2c0434c99","uuid":"8a93c22d-0c9f-41cf-84c4-a924841b3bc4","timestamp":"2026-11-09T18:00:20.487Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/tests/unit/messaging/composer-qa.test.tsx","content":"\n/** SH-13 QA: FR-11 composer behaviour, FR-7 blocked state, and the messaging validators (FR-11/12/21/22). */\n\nconst api = vi.fn();\nvi.mock('@/components/messaging/usePolling', () => ({ api: (...a: unknown[]) => api(...a) }));\nvi.mock('@/components/FileUpload/FileUpload', () => ({ FileUpload: () => null }));\n\nimport { CANNOT_SEND, Composer } from '@/components/messaging/Composer';\n\nconst box = () => screen.getByRole('textbox', { name: 'Message' });\n\ndescribe('Composer (FR-11, FR-7)', () => {\n  beforeEach(() => api.mockReset());\n\n  it('Enter sends, Shift+Enter does not', async () => {\n    api.mockResolvedValue({ data: { message: { id: 'm1' } } });\n    const onSent = vi.fn();\n    render(<Composer conversationId=\"c1\" canSend onSent={onSent} />);\n    fireEvent.change(box(), { target: { value: 'hello' } });\n    fireEvent.keyDown(box(), { key: 'Enter', shiftKey: true });\n    expect(api).not.toHaveBeenCalled();\n    fireEvent.keyDown(box(), { key: 'Enter' });\n    await waitFor(() => expect(onSent).toHaveBeenCalledWith({ id: 'm1' }));\n    expect(api).toHaveBeenCalledWith('/api/conversations/c1/messages', { method: 'POST', body: { body: 'hello', fileIds: [] } });\n    expect(box()).toHaveValue('');\n  });\n\n  it('does not send a blank message', () => {\n    render(<Composer conversationId=\"c1\" canSend onSent={() => {}} />);\n    fireEvent.change(box(), { target: { value: '   ' } });\n    fireEvent.keyDown(box(), { key: 'Enter' });\n    expect(api).not.toHaveBeenCalled();\n  });\n\n  it(`shows the counter only after ${COUNTER_FROM} characters`, () => {\n    render(<Composer conversationId=\"c1\" canSend onSent={() => {}} />);\n    fireEvent.change(box(), { target: { value: 'a'.repeat(COUNTER_FROM) } });\n    expect(screen.queryByText(`${COUNTER_FROM} / ${BODY_MAX}`)).not.toBeInTheDocument();\n    fireEvent.change(box(), { target: { value: 'a'.repeat(COUNTER_FROM + 1) } });\n    expect(screen.getByText(`${COUNTER_FROM + 1} / ${BODY_MAX}`)).toBeInTheDocument();","numLines":40,"startLine":12,"totalLines":106}},"tool_result_meta":[{"id":"toolu_01EWhrNXyXc8LxncomhPnyiY","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
