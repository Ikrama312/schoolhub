{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LHqQMrxa3gexQNTomW98ET","type":"tool_result","content":"Connection to localhost port 3000 [tcp/hbci] succeeded!\n3000 in use\napp-build-manifest.json\nbuild-manifest.json\ncache\nimport NextAuth from 'next-auth';\nimport { NextResponse } from 'next/server';\nimport { authConfig } from '@/server/auth/auth.config';\nimport { isPublicPath } from '@/config/public-routes';\n\n/**\n * Edge gate (FR-12, NFR-7). Edge-safe: authConfig only, no Prisma/bcrypt.\n * This is a convenience redirect; requireRole()/requirePageRole() remain\n * the real authorization check on every handler and page.\n */\nconst { auth } = NextAuth(authConfig);\n\n// Auth.js's own endpoints (signin/signout/callback/csrf/session) carry their own CSRF token.\nconst AUTHJS_ENDPOINT = /^\\/api\\/auth\\/(signin|signout|callback|csrf|session|providers)(\\/|$)/;\n\nfunction jsonError(code: 'FORBIDDEN' | 'UNAUTHENTICATED', message: string, status: number) {\n  return NextResponse.json({ error: { code, message } }, { status });\n}\n\nexport default auth((req) => {\n  const { pathname, search, origin } = req.nextUrl;\n  const isApi = pathname.startsWith('/api/');\n\n  // NFR-8: cross-origin state-changing API calls are rejected.\n  const requestOrigin = req.headers.get('origin');\n  if (\n    isApi &&\n    !['GET', 'HEAD'].includes(req.method) &&\n    requestOrigin &&\n    requestOrigin !== origin &&\n    !AUTHJS_ENDPOINT.test(pathname)\n  ) {\n    return jsonError('FORBIDDEN', 'Cross-origin request rejected.', 403);\n  }\n\n  if (isPublicPath(pathname)) return NextResponse.next();\n\n  if (!req.auth?.user) {\n    if (isApi) return jsonError('UNAUTHENTICATED', 'You must be signed in.', 401);\n    const login = new URL('/login', origin);\n    login.searchParams.set('callbackUrl', pathname + search);\n    return NextResponse.redirect(login);\n  }\n\n  // requirePageUser() reads this to build the post-login callbackUrl.\n  const headers = new Headers(req.headers);\n  headers.set('x-pathname', pathname + search);\n  return NextResponse.next({ request: { headers } });\n});\n\nexport const config = {\n  matcher: ['/((?!_next/static|_next/image|favicon.ico|.*\\\\.[a-zA-Z0-9]+$).*)'],\n};\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport { test, expect, type Page } from '@playwright/test';\nimport AxeBuilder from '@axe-core/playwright';\nimport { PrismaClient } from '@prisma/client';\nimport bcrypt from 'bcrypt';\n\n/**\n * PRD-01 C9: sign-in/out, wrong password, callbackUrl redirect, forgot -> reset,\n * and an axe scan of the public auth pages. Uses seeded users (prisma/seed.ts).\n */\nconst prisma = new PrismaClient();\nconst SEED_PASSWORD = 'SchoolHub123!';\nconst ADMIN = 'admin@schoolhub.test';\nconst STUDENT2 = 'student2@schoolhub.test';\nconst RESET_PASSWORD = 'E2e-Reset!2026-pass';\n\ntest.describe.configure({ mode: 'serial' });\n\ntest.afterAll(async () => {\n  // Put student2 back to the seed password so other runs and specs can sign in.\n  const passwordHash = await bcrypt.hash(SEED_PASSWORD, 10);\n  await prisma.user.update({\n    where: { email: STUDENT2 },\n    data: { passwordHash, failedLoginCount: 0, lockedUntil: null },\n  });\n  await prisma.$disconnect();\n});\n\nasync function signInViaUi(page: Page, email: string, password: string) {\n  await page.getByLabel(/^Email/).fill(email);\n  await page.getByLabel(/^Password/).fill(password);\n  await page.getByRole('button', { name: 'Sign in' }).click();\n}\n\ntest('admin signs in, sees name and role in the user menu, and signs out', async ({ page }) => {\n  await page.goto('/login');\n  await signInViaUi(page, ADMIN, SEED_PASSWORD);\n  await expect(page).toHaveURL(/\\/dashboard$/);\n\n  await page.getByRole('button', { name: 'User menu' }).click();\n  const menu = page.getByRole('menu');\n  await expect(menu.getByText('Alice Admin')).toBeVisible();\n  await expect(menu.getByText('ADMIN', { exact: true })).toBeVisible();\n\n  await page.getByRole('menuitem', { name: 'Sign out' }).click();\n  await expect(page).toHaveURL(/\\/login/);\n});\n\ntest('a wrong password shows the generic error', async ({ page }) => {\n  await page.goto('/login');\n  await signInViaUi(page, ADMIN, 'Definitely-wrong-1');\n  await expect(page.getByRole('alert')).toHaveText('Email or password is incorrect.');\n  await expect(page).toHaveURL(/\\/login/);\n});\n\ntest('an unauthenticated visit to /dashboard redirects to login with a callbackUrl', async ({ page }) => {\n  await page.goto('/dashboard');\n  await expect(page).toHaveURL(/\\/login\\?callbackUrl=%2Fdashboard$/);\n});\n\ntest('forgot password -> reset link -> sign in with the new password', async ({ page }) => {\n  const startedAt = new Date();\n  await page.goto('/forgot-password');\n  await page.getByLabel(/^Email/).fill(STUDENT2);\n  await page.getByRole('button', { name: 'Send reset link' }).click();\n  await expect(page.getByRole('alert')).toContainText(\"If an account exists for that email, we've sent a reset link.\");\n\n  // Read the reset link straight from the outbox (no test-only app route).\n  let link = '';\n  await expect\n    .poll(async () => {\n      const row = await prisma.emailOutbox.findFirst({\n        where: { toEmail: STUDENT2, createdAt: { gte: startedAt } },\n        orderBy: { createdAt: 'desc' },\n      });\n      link = row?.text.match(/\\/reset-password\\/[^\\s\"'<>]+/)?.[0] ?? '';\n      return link;\n    })\n    .not.toBe('');\n\n  await page.goto(link);\n  await page.getByLabel(/^New password/).fill(RESET_PASSWORD);\n  await page.getByLabel(/^Confirm password/).fill(RESET_PASSWORD);\n  await page.getByRole('button', { name: 'Set new password' }).click();\n\n  await expect(page).toHaveURL(/\\/login\\?reset=1/);\n  await expect(page.getByText('Password updated. Sign in with your new password.')).toBeVisible();\n\n  await signInViaUi(page, STUDENT2, RESET_PASSWORD);\n  await expect(page).toHaveURL(/\\/dashboard$/);\n});\n\ntest('/login and /forgot-password have zero serious or critical axe violations', async ({ page }) => {\n  for (const path of ['/login', '/forgot-password']) {\n    await page.goto(path);\n    const results = await new AxeBuilder({ page }).analyze();\n    const seriousOrCritical = results.violations.filter((v) => v.impact === 'serious' || v.impact === 'critical');\n    expect(seriousOrCritical, path).toEqual([]);\n  }\n});","is_error":false}]},"parent_tool_use_id":null,"session_id":"f52d74ab-5795-43ec-9250-cb726f8a81b9","uuid":"004ed0c0-856a-42da-9dca-60052f342f7a","timestamp":"2026-11-05T16:50:24.224Z","tool_use_result":{"stdout":"Connection to localhost port 3000 [tcp/hbci] succeeded!\n3000 in use\napp-build-manifest.json\nbuild-manifest.json\ncache\nimport NextAuth from 'next-auth';\nimport { NextResponse } from 'next/server';\nimport { authConfig } from '@/server/auth/auth.config';\nimport { isPublicPath } from '@/config/public-routes';\n\n/**\n * Edge gate (FR-12, NFR-7). Edge-safe: authConfig only, no Prisma/bcrypt.\n * This is a convenience redirect; requireRole()/requirePageRole() remain\n * the real authorization check on every handler and page.\n */\nconst { auth } = NextAuth(authConfig);\n\n// Auth.js's own endpoints (signin/signout/callback/csrf/session) carry their own CSRF token.\nconst AUTHJS_ENDPOINT = /^\\/api\\/auth\\/(signin|signout|callback|csrf|session|providers