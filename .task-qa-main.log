{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E1uPXTDreHe3XLGXXt78Rh","type":"tool_result","content":"638\t/**\n639\t * PRD-13 FR-29: Alice is the safeguarding lead, Pat↔Sam are linked, and four demo threads.\n640\t * Each thread is idempotent (looked up by subject) and checked against the real contact rules;\n641\t * a block whose prerequisites are missing is skipped with logger.warn, never forced.\n642\t */\n643\tasync function seedMessaging() {\n644\t  const { loadRelations, checkNewConversation } = await import('../src/server/messaging/contact-rules');\n645\t  const byEmail = (email: string) => prisma.user.findUnique({ where: { email }, select: { id: true, role: true } });\n646\t  const [alice, tom, tina, sam, pat] = await Promise.all(\n647\t    ['admin@schoolhub.test', 'teacher@schoolhub.test', 'teacher2@schoolhub.test', 'student@schoolhub.test', 'parent@schoolhub.test'].map(byEmail),\n648\t  );\n649\t\n650\t  if (alice?.role === 'ADMIN') await prisma.user.update({ where: { id: alice.id }, data: { isSafeguardingLead: true } });\n651\t  else logger.warn('Seed: Alice Admin not found, skipping safeguarding lead');\n652\t\n653\t  if (pat && sam) {\n654\t    const hasPrimary = (await prisma.parentStudentLink.count({ where: { studentId: sam.id, isPrimary: true } })) > 0;\n655\t    await prisma.parentStudentLink.upsert({\n656\t      where: { parentId_studentId: { parentId: pat.id, studentId: sam.id } },\n657\t      update: {},\n658\t      create: { parentId: pat.id, studentId: sam.id, relationship: 'GUARDIAN', isPrimary: !hasPrimary },\n659\t    });\n660\t  }\n661\t\n662\t  type U = { id: string; role: Role };\n663\t  const HOUR = 3_600_000;\n664\t  /** Creates one thread; messages are [participant index, body], oldest first. Returns message ids or null if skipped. */\n665\t  async function thread(subject: string, members: (U | null | undefined)[], messages: [number, string][]): Promise<string[] | null> {\n666\t    if (members.some((m) => !m)) {\n667\t      logger.warn('Seed: messaging prerequisites missing, skipping thread', { subject });\n668\t      return null;\n669\t    }\n670\t    if (await prisma.conversation.findFirst({ where: { subject }, select: { id: true } })) return null;\n671\t    const [creator, ...others] = members as U[];\n672\t    const rel = await loadRelations(members.map((m) => m!.id));\n673\t    const problem = checkNewConversation(creator, others.map((o) => o.id), rel);\n674\t    if (problem) {\n675\t      logger.warn('Seed: thread would break contact rules, skipping', { subject, problem });\n676\t      return null;\n677\t    }\n678\t    const start = Date.now() - messages.length * 2 * HOUR;\n679\t    const at = (i: number) => new Date(start + i * 2 * HOUR);\n680\t    const last = at(messages.length - 1);\n681\t    return prisma.$transaction(async (tx) => {\n682\t      const c = await tx.conversation.create({\n683\t        data: { subject, createdById: creator.id, involvesStudent: members.some((m) => m!.role === 'STUDENT'), lastMessageAt: last, createdAt: at(0) },\n684\t      });\n685\t      const ids: string[] = [];\n686\t      for (const [i, [who, body]] of messages.entries()) {\n687\t        ids.push((await tx.message.create({ data: { conversationId: c.id, senderId: members[who]!.id, body, createdAt: at(i) } })).id);\n688\t      }\n689\t      // Whoever sent the last message has read everything; everyone else has one unread.\n690\t      const lastSender = members[messages[messages.length - 1][0]]!.id;\n691\t      await tx.conversationParticipant.createMany({\n692\t        data: (members as U[]).map((m) => ({ conversationId: c.id, userId: m.id, lastReadAt: m.id === lastSender ? last : at(messages.length - 2) })),\n693\t      });\n694\t      return ids;\n695\t    });\n696\t  }\n697\t\n698\t  let created = 0;\n699\t  if (await thread(\"Sam's homework\", [pat, tom], [\n700\t    [0, \"Hi Mr Teacher, Sam has been finding this week's fractions homework hard. Is there anything we can do at home?\"],\n701\t    [1, 'Thanks for letting me know. Sam is doing well in class — practising equivalent fractions for 10 minutes a day would help.'],\n702\t    [0, 'That sounds manageable. Are there worksheets you would recommend?'],\n703\t    [1, \"I've put two extra worksheets in the course materials under Week 3.\"],\n704\t    [0, \"Great, we'll work through them this weekend.\"],\n705\t    [1, \"Perfect. Let me know how it goes — I'll check in with Sam on Monday.\"],\n706\t  ])) created++;\n707\t\n708\t  const math = await prisma.course.findFirst({\n709\t    where: { code: 'MATH-7A', archivedAt: null, academicYear: { isCurrent: true } },\n710\t    select: { teacherId: true, enrollments: { where: { status: 'ACTIVE', student: { status: 'ACTIVE' } }, select: { studentId: true }, orderBy: { studentId: 'asc' }, take: 4 } },\n711\t  });\n712\t  const mathTeacher = math ? await prisma.user.findUnique({ where: { id: math.teacherId }, select: { id: true, role: true } }) : null;\n713\t  const four = math?.enrollments.length === 4 ? math.enrollments.map((e) => ({ id: e.studentId, role: 'STUDENT' as const })) : null;\n714\t  if (!four) logger.warn('Seed: MATH-7A with 4 ACTIVE students not found, skipping group thread');\n715\t  else if (await thread('MATH-7A fractions practice', [mathTeacher, ...four], [\n716\t    [0, \"Hi all — I've set up this group for questions about the fractions practice set due Friday.\"],\n717\t    [1, 'Do we need to simplify every answer?'],\n718\t    [0, 'Yes please, always give answers in their simplest form.'],\n719\t  ])) created++;\n720\t\n721\t  if (await thread('Staff room', [tina, tom], [\n722\t    [0, 'Are you still okay to swap duty on Thursday?'],\n723\t    [1, 'Yes, Thursday works. I can take the lunch slot.'],\n724\t    [0, \"Thanks! I'll cover your Friday morning in return.\"],\n725\t    [1, 'Deal — see you at the staff meeting.'],\n726\t  ])) created++;\n727\t\n728\t  // Student↔teacher thread with one OPEN report (teacher reports the student's message).\n729\t  const reported = await thread('Quiz retake', [sam, tom], [\n730\t    [0, 'Can I retake the quiz? I was off sick.'],\n731\t    [1, \"Yes — you can retake it on Wednesday at lunch.\"],\n732\t    [0, 'This is so unfair, everyone else got extra time and you never help me!!!'],\n733\t    [1, \"I understand you're frustrated. Let's talk about it on Wednesday.\"],\n734\t  ]);\n735\t  if (reported && tom) {\n736\t    created++;\n737\t    await prisma.messageReport.create({\n738\t      data: { messageId: reported[2], reporterId: tom.id, reason: 'Student seems very upset — flagging for pastoral follow-up.' },\n739\t    });\n740\t  }\n741\t  logger.info('Seed: demo messaging ready', { threadsCreated: created });\n742\t}\n743\t\n744\tasync function disconnectAll() {\n745\t  await prisma.$disconnect();\n746\t  // The auth services use the app's shared client (src/server/db.ts).\n747\t  await (await import('../src/server/db')).prisma.$disconnect();\n748\t}\n749\t\n750\tmain()\n751\t  .then(disconnectAll)\n752\t  .catch(async (error) => {\n753\t    console.error(error);\n754\t    await disconnectAll();\n755\t    process.exit(1);"}]},"parent_tool_use_id":null,"session_id":"b2a19e14-003d-496b-9902-59b2c0434c99","uuid":"18ebae3e-4e5d-41f7-9cae-7ce4c80cdab9","timestamp":"2026-11-09T17:57:55.532Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/prisma/seed.ts","content":"/**\n * PRD-13 FR-29: Alice is the safeguarding lead, Pat↔Sam are linked, and four demo threads.\n * Each thread is idempotent (looked up by subject) and checked against the real contact rules;\n * a block whose prerequisites are missing is skipped with logger.warn, never forced.\n */\nasync function seedMessaging() {\n  const { loadRelations, checkNewConversation } = await import('../src/server/messaging/contact-rules');\n  const byEmail = (email: string) => prisma.user.findUnique({ where: { email }, select: { id: true, role: true } });\n  const [alice, tom, tina, sam, pat] = await Promise.all(\n    ['admin@schoolhub.test', 'teacher@schoolhub.test', 'teacher2@schoolhub.test', 'student@schoolhub.test', 'parent@schoolhub.test'].map(byEmail),\n  );\n\n  if (alice?.role === 'ADMIN') await prisma.user.update({ where: { id: alice.id }, data: { isSafeguardingLead: true } });\n  else logger.warn('Seed: Alice Admin not found, skipping safeguarding lead');\n\n  if (pat && sam) {\n    const hasPrimary = (await prisma.parentStudentLink.count({ where: { studentId: sam.id, isPrimary: true } })) > 0;\n    await prisma.parentStudentLink.upsert({\n      where: { parentId_studentId: { parentId: pat.id, studentId: sam.id } },\n      update: {},\n      create: { parentId: pat.id, studentId: sam.id, relationship: 'GUARDIAN', isPrimary: !hasPrimary },\n    });\n  }\n\n  type U = { id: string; role: Role };\n  const HOUR = 3_600_000;\n  /** Creates one thread; messages are [participant index, body], oldest first. Returns message ids or null if skipped. */\n  async function thread(subject: string, members: (U | null | undefined)[], messages: [number, string][]): Promise<string[] | null> {\n    if (members.some((m) => !m)) {\n      logger.warn('Seed: messaging prerequisites missing, skipping thread', { subject });\n      return null;\n    }\n    if (await prisma.conversation.findFirst({ where: { subject }, select: { id: true } })) return null;\n    const [creator, ...others] = members as U[];\n    const rel = await loadRelations(members.map((m) => m!.id));\n    const problem = checkNewConversation(creator, others.map((o) => o.id), rel);\n    if (problem) {\n      logger.warn('Seed: thread would break contact rules, skipping', { subject, problem });\n      return null;\n    }\n    const start = Date.now() - messages.length * 2 * HOUR;\n    const at = (i: number) => new Date(start + i * 2 * HOUR);\n    const last = at(messages.length - 1);\n    return prisma.$transaction(async (tx) => {\n      const c = await tx.conversation.create({\n        data: { subject, createdById: creator.id, involvesStudent: members.some((m) => m!.role === 'STUDENT'), lastMessageAt: last, createdAt: at(0) },\n      });\n      const ids: string[] = [];\n      for (const [i, [who, body]] of messages.entries()) {\n        ids.push((await tx.message.create({ data: { conversationId: c.id, senderId: members[who]!.id, body, createdAt: at(i) } })).id);\n      }\n      // Whoever sent the last message has read everything; everyone else has one unread.\n      const lastSender = members[messages[messages.length - 1][0]]!.id;\n      await tx.conversationParticipant.createMany({\n        data: (members as U[]).map((m) => ({ conversationId: c.id, userId: m.id, lastReadAt: m.id === lastSender ? last : at(messages.length - 2) })),\n      });\n      return ids;\n    });\n  }\n\n  let created = 0;\n  if (await thread(\"Sam's homework\", [pat, tom], [\n    [0, \"Hi Mr Teacher, Sam has been finding this week's fractions homework hard. Is there anything we can do at home?\"],\n    [1, 'Thanks for letting me know. Sam is doing well in class — practising equivalent fractions for 10 minutes a day would help.'],\n    [0, 'That sounds manageable. Are there worksheets you would recommend?'],\n    [1, \"I've put two extra worksheets in the course materials under Week 3.\"],\n    [0, \"Great, we'll work through them this weekend.\"],\n    [1, \"Perfect. Let me know how it goes — I'll check in with Sam on Monday.\"],\n  ])) created++;\n\n  const math = await prisma.course.findFirst({\n    where: { code: 'MATH-7A', archivedAt: null, academicYear: { isCurrent: true } },\n    select: { teacherId: true, enrollments: { where: { status: 'ACTIVE', student: { status: 'ACTIVE' } }, select: { studentId: true }, orderBy: { studentId: 'asc' }, take: 4 } },\n  });\n  const mathTeacher = math ? await prisma.user.findUnique({ where: { id: math.teacherId }, select: { id: true, role: true } }) : null;\n  const four = math?.enrollments.length === 4 ? math.enrollments.map((e) => ({ id: e.studentId, role: 'STUDENT' as const })) : null;\n  if (!four) logger.warn('Seed: MATH-7A with 4 ACTIVE students not found, skipping group thread');\n  else if (await thread('MATH-7A fractions practice', [mathTeacher, ...four], [\n    [0, \"Hi all — I've set up this group for questions about the fractions practice set due Friday.\"],\n    [1, 'Do we need to simplify every answer?'],\n    [0, 'Yes please, always give answers in their simplest form.'],\n  ])) created++;\n\n  if (await thread('Staff room', [tina, tom], [\n    [0, 'Are you still okay to swap duty on Thursday?'],\n    [1, 'Yes, Thursday works. I can take the lunch slot.'],\n    [0, \"Thanks! I'll cover your Friday morning in return.\"],\n    [1, 'Deal — see you at the staff meeting.'],\n  ])) created++;\n\n  // Student↔teacher thread with one OPEN report (teacher reports the student's message).\n  const reported = await thread('Quiz retake', [sam, tom], [\n    [0, 'Can I retake the quiz? I was off sick.'],\n    [1, \"Yes — you can retake it on Wednesday at lunch.\"],\n    [0, 'This is so unfair, everyone else got extra time and you never help me!!!'],\n    [1, \"I understand you're frustrated. Let's talk about it on Wednesday.\"],\n  ]);\n  if (reported && tom) {\n    created++;\n    await prisma.messageReport.create({\n      data: { messageId: reported[2], reporterId: tom.id, reason: 'Student seems very upset — flagging for pastoral follow-up.' },\n    });\n  }\n  logger.info('Seed: demo messaging ready', { threadsCreated: created });\n}\n\nasync function disconnectAll() {\n  await prisma.$disconnect();\n  // The auth services use the app's shared client (src/server/db.ts).\n  await (await import('../src/server/db')).prisma.$disconnect();\n}\n\nmain()\n  .then(disconnectAll)\n  .catch(async (error) => {\n    console.error(error);\n    await disconnectAll();\n    process.exit(1);","numLines":118,"startLine":638,"totalLines":757}},"tool_result_meta":[{"id":"too