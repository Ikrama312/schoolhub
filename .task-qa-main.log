{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VrVSqEBy5sKiA5g3LefrK8","type":"tool_result","content":"=== src/app/api/attendance/today/route.ts\nimport { ok, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { getToday } from '@/server/attendance/attendance-service';\n\n/** GET /api/attendance/today — the teacher's meetings and daily registers today (FR-6, FR-7). */\nexport const GET = withHandler(async () => {\n  const user = await requireRole('TEACHER', 'ADMIN');\n  return ok(await getToday(user));\n});\n=== src/app/api/attendance/register/route.ts\nimport { ok, parseBody, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { getRegister, saveRegister } from '@/server/attendance/attendance-service';\nimport { registerPutBody, registerQuery } from '@/lib/validators/attendance';\n\n/** GET /api/attendance/register?courseId&date&periodId | ?sectionId&date (FR-8, FR-9, FR-14, FR-15, FR-19). */\nexport const GET = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  const key = parseQuery(new URL(request.url).searchParams, registerQuery);\n  return ok(await getRegister(user, key));\n});\n\n/** PUT /api/attendance/register — save the whole register atomically (FR-10, FR-14, FR-18..22, NFR-3). */\nexport const PUT = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  const { records, ...key } = await parseBody(request, registerPutBody);\n  return ok(await saveRegister(user, key, records));\n});\n=== src/app/api/students/[id]/attendance/route.ts\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { getStudentAttendance } from '@/server/attendance/attendance-service';\nimport { studentAttendanceQuery } from '@/lib/validators/attendance';\n\n/** GET /api/students/:id/attendance?from&to — assertCanViewStudent inside the service (FR-25..28). */\nexport const GET = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  const range = parseQuery(new URL(request.url).searchParams, studentAttendanceQuery);\n  return ok(await getStudentAttendance(user, params.id, range));\n});\n=== src/app/api/courses/[id]/attendance/route.ts\nimport { ok, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { getCourseMatrix } from '@/server/attendance/attendance-service';\n\n/** GET /api/courses/:id/attendance — last 20 sessions × students; assertCanManageCourse in the service (FR-29). */\nexport const GET = withHandler(async (_request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  return ok(await getCourseMatrix(user, params.id));\n});\n=== src/app/api/admin/attendance/below-threshold/route.ts\nimport { NextResponse } from 'next/server';\nimport { parsePagination, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { getBelowThreshold } from '@/server/attendance/attendance-service';\n\n/** GET /api/admin/attendance/below-threshold — year-to-date rate below the alert threshold, ascending (FR-33). */\nexport const GET = withHandler(async (request: Request) => {\n  await requireRole('ADMIN');\n  const { page, pageSize, skip, take } = parsePagination(new URL(request.url).searchParams);\n  const { threshold, rows } = await getBelowThreshold();\n  // Same envelope as paginated(), plus meta.threshold (api-contracts).\n  return NextResponse.json({ data: rows.slice(skip, skip + take), meta: { page, pageSize, total: rows.length, threshold } });\n});\n=== src/app/api/admin/attendance/overview/route.ts\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { getOverview } from '@/server/attendance/attendance-service';\nimport { overviewQuery } from '@/lib/validators/attendance';\n\n/** GET /api/admin/attendance/overview?date — expected vs taken, missing registers (FR-30, FR-31). */\nexport const GET = withHandler(async (request: Request) => {\n  await requireRole('ADMIN');\n  const { date } = parseQuery(new URL(request.url).searchParams, overviewQuery);\n  return ok(await getOverview(date));\n});\n=== src/app/api/admin/attendance/remind/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { remindTeacher } from '@/server/attendance/attendance-service';\nimport { remindBody } from '@/lib/validators/attendance';\n\n/** POST /api/admin/attendance/remind — notify the course teacher of a missing register (FR-31). */\nexport const POST = withHandler(async (request: Request) => {\n  const admin = await requireRole('ADMIN');\n  const body = await parseBody(request, remindBody);\n  return ok(await remindTeacher(admin, body, request));\n});\n=== src/app/api/admin/attendance/report/route.ts\nimport { paginated, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { toCsv } from '@/server/csv';\nimport { getReport } from '@/server/attendance/attendance-service';\nimport { reportFilters } from '@/lib/validators/attendance';\n\nconst COLUMNS = [\n  { key: 'studentName', header: 'Student' },\n  { key: 'sectionName', header: 'Section' },\n  { key: 'gradeLevelName', header: 'Grade' },\n  { key: 'records', header: 'Records' },\n  { key: 'present', header: 'Present' },\n  { key: 'absent', header: 'Absent' },\n  { key: 'late', header: 'Late' },\n  { key: 'excused', header: 'Excused' },\n  { key: 'rate', header: 'Rate' },\n];\n\n/** GET /api/admin/attendance/report — per-student summary; paginated JSON or ?format=csv (FR-32). */\nexport const GET = withHandler(async (request: Request) => {\n  await requireRole('ADMIN');\n  const url = new URL(request.url);\n  const filters = parseQuery(url.searchParams, reportFilters);\n  const rows = await getReport(filters);\n  if (filters.format === 'csv') {\n    return new Response(toCsv(COLUMNS, rows), {\n      headers: {\n        'Content-Type': 'text/csv; charset=utf-8',\n        'Content-Disposition': `attachment; filename=\"attendance-report-${filters.from}-${filters.to}.csv\"`,\n      },\n    });\n  }\n  const { page, pageSize, skip, take } = parsePagination(url.searchParams);\n  return paginated(rows.slice(skip, skip + take), { page, pageSize, total: rows.length });\n});\n=== src/app/api/settings/school/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { audit } from '@/server/audit';\nimport { prisma } from '@/server/db';\nimport { updateSchoolSettings } from '@/server/services/settings';\nimport { attendanceSettingsPatch } from '@/lib/validators/attendance';\n\n/** PATCH /api/settings/school — ADMIN; attendance fields only (PRD-07 FR-4/FR-5, strict body). */\nexport const PATCH = withHandler(async (request: Request) => {\n  const user = await requireRole('ADMIN');\n  const patch = await parseBody(request, attendanceSettingsPatch);\n  const old = await prisma.schoolSettings.upsert({ where: { id: 'singleton' }, update: {}, create: { id: 'singleton' } });\n  const updated = await updateSchoolSettings(patch);\n  const pick = (s: typeof old) => ({ attendanceMode: s.attendanceMode, attendanceAlertThreshold: s.attendanceAlertThreshold });\n  await audit({\n    actorId: user.id,\n    action: 'school_settings.update',\n    entityType: 'SchoolSettings',\n    entityId: 'singleton',\n    metadata: { old: pick(old), new: pick(updated) },\n    request,\n  });\n  return ok(pick(updated));\n});\n=== src/server/services/settings.ts\nimport { cache } from 'react';\nimport type { AttendanceMode } from '@prisma/client';\nimport { prisma } from '@/server/db';\n\nexport interface UpdateSchoolSettingsInput {\n  name?: string;\n  shortName?: string;\n  logoUrl?: string | null;\n  timezone?: string;\n  addressLine1?: string | null;\n  addressLine2?: string | null;\n  city?: string | null;\n  country?: string | null;\n  phone?: string | null;\n  email?: string | null;\n  website?: string | null;\n  /** PRD-07 FR-4/FR-5 */\n  attendanceMode?: AttendanceMode;\n  attendanceAlertThreshold?: number;\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {\n  return prisma.schoolSettings.update({ where: { id: 'singleton' }, data: input });\n}\n=== src/config/student-tabs.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/** Extension point for the student detail page; later PRDs register their tab here. */\nexport const studentTabs: StudentTab[] = [\n  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\n];\n=== src/config/course-tabs.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\n61:  'attendance.absent': {\n62-    label: 'Marked absent',\n63-    description: 'A student was marked absent from a class or the daily register.',\n64-    category: 'ATTENDANCE',\n65-    defaultEmail: true,\n66-    mandatoryInApp: true,\n67-    roles: ['PARENT', 'STUDENT'],\n68-  },\n69:  'attendance.late': {\n70-    label: 'Marked late',\n71-    description: 'A student was marked late.',\n72-    category: 'ATTENDANCE',\n73-    defaultEmail: false,\n74-    mandatoryInApp: false,\n75-    roles: ['PARENT', 'STUDENT'],\n76-  },\n77:  'attendance.corrected': {\n78-    label: 'Attendance corrected',\n79-    description: 'An absence was corrected to present.',\n80-    category: 'ATTENDANCE',\n81-    defaultEmail: false,\n82-    mandatoryInApp: false,\n83-    roles: ['PARENT', 'STUDENT'],\n84-  },\n85:  'attendance.register_missing': {\n86-    label: 'Register not taken',\n87-    description: 'An administrator reminded you to take a register.',\n88-    category: 'ATTENDANCE',\n89-    defaultEmail: false,\n90-    mandatoryInApp: false,\n91-    roles: ['TEACHER'],\n92-  },\n93-} as const satisfies Record<string, NotificationTypeDef>;\n94-\n95-export type NotificationType = keyof typeof NOTIFICATION_TYPES;\n96-\n97-const entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n34:  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n35:  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },","is_error":false}]},"parent_tool_use_id":null,"session_id":"88405567-c8b9-4e5f-8912-47ba3c7edb01","uuid":"0baded0d-0b31-45b6-8f70-4f8b066970d4","timestamp":"2026-11-06T06:07:51.305Z","tool_use_result":{"stdout":"=== src/app/api/attendance/today/route.ts\nimport { ok,