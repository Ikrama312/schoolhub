{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BA8PkUeYuavEEPLbMk2PYF","type":"tool_result","content":"// ---------------------------------------------------------------------------\n\n/// Generic uploaded file (FR-1). Bytes live under UPLOAD_DIR; access goes\n/// through src/server/files/access.ts. contextId null = unattached (purged after 24 h).\nmodel FileObject {\n  id                String             @id @default(cuid())\n  ownerId           String\n  owner             User               @relation(fields: [ownerId], references: [id])\n  originalName      String\n  mimeType          String\n  sizeBytes         Int\n  storageKey        String             @unique\n  sha256            String\n  context           String\n  contextId         String?\n  createdAt         DateTime           @default(now())\n  lessonAttachments LessonAttachment[]\n\n  @@index([context, contextId])\n}\n\nenum ContentStatus {\n  DRAFT\n  SCHEDULED\n  PUBLISHED\n}\n\nmodel Module {\n  id          String        @id @default(cuid())\n  courseId    String\n  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  title       String\n  description String?\n  order       Int\n  status      ContentStatus @default(DRAFT)\n  publishAt   DateTime?\n  createdAt   DateTime      @default(now())\n  updatedAt   DateTime      @updatedAt\n  lessons     Lesson[]\n\n  @@index([courseId, order])\n}\n\nmodel Lesson {\n  id               String             @id @default(cuid())\n  moduleId         String\n  module           Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)\n  title            String\n  contentMarkdown  String             @default(\"\")\n  videoUrl         String?\n  estimatedMinutes Int?\n  order            Int\n  status           ContentStatus      @default(DRAFT)\n  publishAt        DateTime?\n  createdAt        DateTime           @default(now())\n  updatedAt        DateTime           @updatedAt\n  attachments      LessonAttachment[]\n  links            LessonLink[]\n  progress         LessonProgress[]\n\n  @@index([moduleId, order])\n}\n\n/// file has no onDelete -> Restrict: an attached file can't be hard-deleted (FR-11).\nmodel LessonAttachment {\n  id       String     @id @default(cuid())\n  lessonId String\n  lesson   Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n  fileId   String\n  file     FileObject @relation(fields: [fileId], references: [id])\n  order    Int\n}\n\nmodel LessonLink {\n  id       String @id @default(cuid())\n  lessonId String\n  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n  title    String\n  url      String\n  order    Int\n}\n\nmodel LessonProgress {\n  lessonId      String\n  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n  studentId     String\n  firstViewedAt DateTime  @default(now())\n  completedAt   DateTime?\n\n  @@id([lessonId, studentId])\n}\nimport type { ContentStatus } from '@prisma/client';\n\n/**\n * Single source of truth for content visibility (PRD-08 FR-18, FR-19, FR-44).\n * Pure: evaluated at read time, no background job. Used by list, get,\n * prev/next, file access, progress and the Learning tab.\n */\n\nexport interface Publishable {\n  status: ContentStatus;\n  publishAt: Date | null;\n}\n\nexport function isVisible(item: Publishable, now: Date): boolean {\n  if (item.status === 'PUBLISHED') return true;\n  return item.status === 'SCHEDULED' && item.publishAt !== null && item.publishAt.getTime() <= now.getTime();\n}\n\n/** A lesson is visible to students/parents only when it AND its module are visible. */\nexport function isLessonVisible(lesson: Publishable, module: Publishable, now: Date): boolean {\n  return isVisible(module, now) && isVisible(lesson, now);\n}\n\n/** ADMIN, or the course's teacher/co-teacher, see drafts and scheduled items. */\nexport function canSeeDrafts(\n  user: { id: string; role: string },\n  course: { teacherId: string; coTeacherIds: string[] },\n): boolean {\n  if (user.role === 'ADMIN') return true;\n  return user.role === 'TEACHER' && (course.teacherId === user.id || course.coTeacherIds.includes(user.id));\n}\n/**\n * Video URL parsing (PRD-08 FR-30). Shared by the Zod validator and the\n * viewer. Only ever emits the two privacy-enhanced origins allowed by the\n * CSP frame-src in next.config.js.\n */\nexport interface ParsedVideo {\n  provider: 'youtube' | 'vimeo';\n  id: string;\n}\n\nconst YT_ID = /^[A-Za-z0-9_-]{6,20}$/;\nconst VIMEO_ID = /^\\d{1,12}$/;\n\nexport function parseVideoUrl(raw: string): ParsedVideo | null {\n  let url: URL;\n  try {\n    url = new URL(raw.trim());\n  } catch {\n    return null;\n  }\n  if (url.protocol !== 'https:' && url.protocol !== 'http:') return null;\n  const host = url.hostname.toLowerCase().replace(/^(www\\.|m\\.)/, '');\n  const firstSegment = url.pathname.split('/').filter(Boolean)[0] ?? '';\n\n  if (host === 'youtube.com' && url.pathname === '/watch') {\n    const id = url.searchParams.get('v') ?? '';\n    return YT_ID.test(id) ? { provider: 'youtube', id } : null;\n  }\n  if (host === 'youtu.be') {\n    return YT_ID.test(firstSegment) ? { provider: 'youtube', id: firstSegment } : null;\n  }\n  if (host === 'vimeo.com') {\n    return VIMEO_ID.test(firstSegment) ? { provider: 'vimeo', id: firstSegment } : null;\n  }\n  return null;\n}\n\nexport function embedUrl(video: ParsedVideo): string {\n  return video.provider === 'youtube'\n    ? `https://www.youtube-nocookie.com/embed/${video.id}`\n    : `https://player.vimeo.com/video/${video.id}`;\n}\nvitest.config.ts\nvitest.tmp.config.ts\n  \"scripts\": {\n    \"dev\": \"next dev\",\n    \"build\": \"next build\",\n    \"start\": \"next start\",\n    \"lint\": \"next lint\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\",\n    \"test:e2e\": \"playwright test\",\n    \"db:migrate\": \"prisma migrate dev\",\n    \"db:deploy\": \"prisma migrate deploy\",\n    \"db:seed\": \"tsx prisma/seed.ts\",\n    \"db:reset\": \"prisma migrate reset --force\",\n    \"worker:email\": \"tsx scripts/worker-email.ts\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"e79742d4-00ef-4cc8-ab33-edc1cbedabaa","uuid":"32bf92c5-e866-44e3-a877-7c9d8ba6ff27","timestamp":"2026-11-07T02:53:18.161Z","tool_use_result":{"stdout":"// ---------------------------------------------------------------------------\n\n/// Generic uploaded file (FR-1). Bytes live under UPLOAD_DIR; access goes\n/// through src/server/files/access.ts. contextId null = unattached (purged after 24 h).\nmodel FileObject {\n  id                String             @id @default(cuid())\n  ownerId           String\n  owner             User               @relation(fields: [ownerId], references: [id])\n  originalName      String\n  mimeType          String\n  sizeBytes         Int\n  storageKey        String             @unique\n  sha256            String\n  context           String\n  contextId         String?\n  createdAt         DateTime           @default(now())\n  lessonAttachments LessonAttachment[]\n\n  @@index([context, contextId])\n}\n\nenum ContentStatus {\n  DRAFT\n  SCHEDULED\n  PUBLISHED\n}\n\nmodel Module {\n  id          String        @id @default(cuid())\n  courseId    String\n  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  title       String\n  description String?\n  order       Int\n  status      ContentStatus @default(DRAFT)\n  publishAt   DateTime?\n  createdAt   DateTime      @default(now())\n  updatedAt   DateTime      @updatedAt\n  lessons     Lesson[]\n\n  @@index([courseId, order])\n}\n\nmodel Lesson {\n  id               String             @id @default(cuid())\n  moduleId         String\n  module           Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)\n  title            String\n  contentMarkdown  String          