{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MdVhrzBfbdS16n4xyov13M","type":"tool_result","content":"import '@testing-library/jest-dom/vitest';\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\nimport { render, screen, waitFor } from '@testing-library/react';\nimport userEvent from '@testing-library/user-event';\n\n/**\n * SH-1 QA: client behaviour of the new auth forms. Only the network (fetch)\n * and framework boundaries (router, next-auth signIn) are stubbed.\n */\n// userEvent typing into MUI fields is slow under full-suite parallel load.\nvi.setConfig({ testTimeout: 30_000 });\n\nconst replace = vi.fn();\nconst refresh = vi.fn();\nvi.mock('next/navigation', () => ({ useRouter: () => ({ replace, refresh }) }));\nconst signIn = vi.fn();\nvi.mock('next-auth/react', () => ({ signIn: (...args: unknown[]) => signIn(...args) }));\n\nimport { ForgotPasswordForm } from '@/app/(auth)/forgot-password/ForgotPasswordForm';\nimport { TokenPasswordForm } from '@/app/(auth)/TokenPasswordForm';\nimport { ChangePasswordForm } from '@/app/(app)/account/security/ChangePasswordForm';\nimport { ToastProvider } from '@/components/Toast/ToastProvider';\n\nconst fetchMock = vi.fn();\nconst reply = (status: number, body: unknown) =>\n  fetchMock.mockResolvedValueOnce(new Response(JSON.stringify(body), { status }));\nconst sentBody = (call = 0) => JSON.parse(fetchMock.mock.calls[call][1].body as string);\n\nconst GOOD = 'Brand-new-pass-77';\nconst INVALID = 'This invitation link is invalid or has expired. Ask the school office to send a new one.';\ndom\njest-dom\nreact\nuser-event\ngrep: src/components/Toast/useToast.tsx: No such file or directory\n1:import Avatar from '@mui/material/Avatar';\n3:export interface UserAvatarProps {\n27:export function UserAvatar({ userId, name, size = 32 }: UserAvatarProps) {","is_error":false}]},"parent_tool_use_id":null,"session_id":"88405567-c8b9-4e5f-8912-47ba3c7edb01","uuid":"f67ebc05-c34a-4d09-