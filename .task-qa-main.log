{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FzQvo917J2wX2qiMAJmd16","type":"tool_result","content":"1\timport { Prisma, type AttendanceMode } from '@prisma/client';\n2\timport { fromZonedTime } from 'date-fns-tz';\n3\timport { prisma } from '@/server/db';\n4\timport { AppError } from '@/server/http';\n5\timport { audit } from '@/server/audit';\n6\timport { assertCanManageCourse } from '@/server/auth/course-access';\n7\timport { assertCanViewStudent, type AccessUser } from '@/server/auth/student-access';\n8\timport { notify, notifyStudentAndParents } from '@/server/notifications/notify';\n9\timport { getScheduleForDate, getSchoolScheduleForDate } from '@/server/timetable/timetable-service';\n10\timport { formatInSchoolTz, schoolNow } from '@/lib/dates';\n11\timport type { RegisterKey, RegisterRecordInput, ReportFilters } from '@/lib/validators/attendance';\n12\timport {\n13\t  addDays,\n14\t  canEdit,\n15\t  canOpen,\n16\t  countStatuses,\n17\t  dayColour,\n18\t  diffRecords,\n19\t  notificationsFor,\n20\t  schoolToday,\n21\t  type Rec,\n22\t  type Status,\n23\t  type StatusCounts,\n24\t} from './attendance-rules';\n25\t\n26\t/**\n27\t * PRD-07 attendance service (FR-37). The only writer of AttendanceSession /\n28\t * AttendanceRecord. Route handlers and server pages stay thin.\n29\t *\n30\t * Deliberately does not import services/settings.ts: its react.cache()\n31\t * wrapper is undefined outside Next, and the integration test imports this.\n32\t */\n33\t\n34\ttype Tx = Prisma.TransactionClient;\n35\ttype CourseKey = { courseId: string; date: string; periodId: string };\n36\tconst isCourseKey = (k: RegisterKey): k is CourseKey => 'courseId' in k;\n37\t\n38\tconst toDbDate = (d: string) => new Date(`${d}T00:00:00Z`);\n39\tconst fromDbDate = (d: Date) => d.toISOString().slice(0, 10);\n40\t/** A Date that falls on `d` in any timezone within ±11h -- for weekday lookups. */\n41\tconst middayOf = (d: string) => new Date(`${d}T12:00:00Z`);\n42\tconst fullName = (u: { firstName: string; lastName: string }) => `${u.firstName} ${u.lastName}`;\n43\tconst userRef = (u: { id: string; firstName: string; lastName: string } | null) => (u ? { id: u.id, name: fullName(u) } : null);\n44\tconst longDate = (d: string) => formatInSchoolTz(toDbDate(d), 'EEEE d MMM yyyy', 'UTC');\n45\t\n46\tasync function loadSettings() {\n47\t  const s = await prisma.schoolSettings.upsert({ where: { id: 'singleton' }, update: {}, create: { id: 'singleton' } });\n48\t  return { tz: s.timezone, mode: s.attendanceMode, threshold: s.attendanceAlertThreshold };\n49\t}\n50\t\n51\t/** FR-28: which session kind counts toward rates for the configured mode. */\n52\tfunction kindWhere(mode: AttendanceMode): Prisma.AttendanceSessionWhereInput {\n53\t  return mode === 'DAILY_HOMEROOM' ? { sectionId: { not: null } } : { courseId: { not: null } };\n54\t}\n55\t\n56\t/** FR-15: ADMIN or the section's homeroom teacher. Private to this module. */\n57\tasync function assertCanManageSection(user: AccessUser, sectionId: string) {\n58\t  const section = await prisma.section.findUnique({ where: { id: sectionId }, select: { id: true, name: true, homeroomTeacherId: true } });\n59\t  if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n60\t  if (user.role === 'ADMIN' || (user.role === 'TEACHER' && section.homeroomTeacherId === user.id)) return section;\n61\t  throw new AppError('FORBIDDEN', 'You do not have permission to take this register.');\n62\t}\n63\t\n64\t/** Access check + header labels. NOT_FOUND for a missing course/section/period. */\n65\tasync function loadKey(user: AccessUser, key: RegisterKey) {\n66\t  if (isCourseKey(key)) {\n67\t    await assertCanManageCourse(user, key.courseId);\n68\t    const [course, period] = await Promise.all([\n69\t      prisma.course.findUnique({ where: { id: key.courseId }, select: { name: true, section: { select: { name: true } } } }),\n70\t      prisma.period.findUnique({ where: { id: key.periodId }, select: { name: true } }),\n71\t    ]);\n72\t    if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n73\t    if (!period) throw new AppError('NOT_FOUND', 'Period not found');\n74\t    return { courseName: course.name, sectionName: course.section?.name ?? '', periodName: period.name as string | null, date: key.date };\n75\t  }\n76\t  const section = await assertCanManageSection(user, key.sectionId);\n77\t  return { courseName: null as string | null, sectionName: section.name, periodName: null as string | null, date: key.date };\n78\t}\n79\t\n80\tfunction assertOpen(user: AccessUser, date: string, today: string) {\n81\t  const open = canOpen(user.role, date, today);\n82\t  if (!open.ok) throw new AppError(open.code === 'FUTURE' ? 'VALIDATION_ERROR' : 'FORBIDDEN', open.reason);\n83\t}\n84\t\n85\t/** NFR-3 / FR-9: students active on `date`, sorted by last name. */\n86\tasync function activeRoster(db: Tx, key: RegisterKey, tz: string) {\n87\t  const student = { select: { id: true, firstName: true, lastName: true } } as const;\n88\t  let students: { id: string; firstName: string; lastName: string }[];\n89\t  if (isCourseKey(key)) {\n90\t    // enrolledAt::date <= date AND (ACTIVE OR droppedAt::date > date), dates in the school timezone.\n91\t    const nextDay = fromZonedTime(`${addDays(key.date, 1)}T00:00:00`, tz);\n92\t    const rows = await db.enrollment.findMany({\n93\t      where: { courseId: key.courseId, enrolledAt: { lt: nextDay }, OR: [{ status: 'ACTIVE' }, { droppedAt: { gte: nextDay } }] },\n94\t      select: { student },\n95\t    });\n96\t    students = rows.map((r) => r.student);\n97\t  } else {\n98\t    const rows = await db.sectionMember.findMany({ where: { sectionId: key.sectionId }, select: { student } });\n99\t    students = rows.map((r) => r.student);\n100\t  }\n101\t  return students.sort((a, b) => a.lastName.localeCompare(b.lastName) || a.firstName.localeCompare(b.firstName));\n102\t}\n103\t\n104\tfunction sessionWhere(key: RegisterKey): Prisma.AttendanceSessionWhereInput {\n105\t  return isCourseKey(key)\n106\t    ? { courseId: key.courseId, periodId: key.periodId, date: toDbDate(key.date) }\n107\t    : { sectionId: key.sectionId, date: toDbDate(key.date) };\n108\t}\n109\t\n110\tconst toRec = (r: { studentId: string; status: Status; minutesLate: number | null; note: string | null }): Rec => ({\n111\t  studentId: r.studentId,\n112\t  status: r.status,\n113\t  minutesLate: r.minutesLate,\n114\t  note: r.note,\n115\t});\n116\t\n117\t// ---------------------------------------------------------------------------\n118\t// Teacher landing (FR-6, FR-7)\n119\t// ---------------------------------------------------------------------------\n120\t\n121\tconst takenSelect = { createdAt: true, takenBy: { select: { id: true, firstName: true, lastName: true } } } as const;\n122\t\n123\texport async function getToday(user: AccessUser, date?: string) {\n124\t  const { tz, mode } = await loadSettings();\n125\t  const now = new Date();\n126\t  const today = schoolToday(now, tz);\n127\t  const day = date ?? today;\n128\t  assertOpen(user, day, today);\n129\t\n130\t  const schedule = await getScheduleForDate({ userId: user.id, role: user.role }, day === today ? now : middayOf(day));\n131\t  const { hhmm } = schoolNow(now, tz);\n132\t  const courseSessions = schedule.length\n133\t    ? await prisma.attendanceSession.findMany({\n134\t        where: { date: toDbDate(day), courseId: { in: schedule.map((s) => s.course.id) } },\n135\t        select: { courseId: true, periodId: true, ...takenSelect },\n136\t      })\n137\t    : [];\n138\t  const taken = (s: { createdAt: Date; takenBy: { id: string; firstName: string; lastName: string } } | undefined) =>\n139\t    s ? { at: s.createdAt.toISOString(), by: userRef(s.takenBy)! } : null;\n140\t\n141\t  const meetings = schedule.map((s) => ({\n142\t    kind: 'course' as const,\n143\t    courseId: s.course.id,\n144\t    courseName: s.course.name,\n145\t    sectionName: s.course.section?.name ?? '',\n146\t    periodId: s.period.id,\n147\t    periodName: s.period.name,\n148\t    startTime: s.period.startTime,\n149\t    endTime: s.period.endTime,\n150\t    isCurrent: day === today && s.period.startTime <= hhmm && hhmm < s.period.endTime,\n151\t    taken: taken(courseSessions.find((x) => x.courseId === s.course.id && x.periodId === s.period.id)),\n152\t  }));\n153\t\n154\t  let dailyRegisters: { kind: 'section'; sectionId: string; sectionName: string; taken: ReturnType<typeof taken> }[] = [];\n155\t  if (mode !== 'PER_PERIOD') {\n156\t    const sections = await prisma.section.findMany({\n157\t      where: { homeroomTeacherId: user.id, academicYear: { isCurrent: true } },\n158\t      select: { id: true, name: true, attendanceSessions: { where: { date: toDbDate(day) }, select: takenSelect } },\n159\t      orderBy: { name: 'asc' },\n160\t    });\n161\t    dailyRegisters = sections.map((s) => ({ kind: 'section', sectionId: s.id, sectionName: s.name, taken: taken(s.attendanceSessions[0]) }));\n162\t  }\n163\t\n164\t  return { date: day, today, meetings, dailyRegisters };\n165\t}\n166\t\n167\t// ---------------------------------------------------------------------------\n168\t// Register read / save (FR-8 to FR-22, NFR-1, NFR-3)\n169\t// ---------------------------------------------------------------------------\n170\t\n171\texport type Register = Awaited<ReturnType<typeof getRegister>>;\n172\t\n173\texport async function getRegister(user: AccessUser, key: RegisterKey) {\n174\t  const header = await loadKey(user, key);\n175\t  const { tz } = await loadSettings();\n176\t  const today = schoolToday(new Date(), tz);\n177\t  assertOpen(user, key.date, today);\n178\t\n179\t  const [students, session] = await Promise.all([\n180\t    activeRoster(prisma, key, tz),\n181\t    prisma.attendanceSession.findFirst({\n182\t      where: sessionWhere(key),\n183\t      include: {\n184\t        records: true,\n185\t        takenBy: { select: { id: true, firstName: true, lastName: true } },\n186\t        updatedBy: { select: { id: true, firstName: true, lastName: true } },\n187\t      },\n188\t    }),\n189\t  ]);\n190\t  const edit = canEdit(user.role, key.date, today);\n191\t\n192\t  return {\n193\t    key,\n194\t    header,\n195\t    sessionId: session?.id ?? null,\n196\t    students: students.map((s) => ({ ...s, avatarUrl: null as string | null })),\n197\t    records: (session?.records ?? []).map((r) => ({\n198\t      studentId: r.studentId,\n199\t      status: r.status,\n200\t      ...(r.minutesLate != null ? { minutesLate: r.minutesLate } : {}),\n201\t      ...(r.note ? { note: r.note } : {}),\n202\t    })),\n203\t    takenBy: userRef(session?.takenBy ?? null),\n204\t    updatedBy: userRef(session?.updatedBy ?? null),\n205\t    updatedAt: session?.updatedAt.toISOString() ?? null,\n206\t    readOnly: !edit.ok,\n207\t    readOnlyReason: edit.ok ? null : (edit.reason ?? null),\n208\t    canExcuse: user.role === 'ADMIN',\n209\t  };\n210\t}\n211\t\n212\texport async function saveRegister(user: AccessUser, key: RegisterKey, records: RegisterRecordInput[]) {\n213\t  const header = await loadKey(user, key);\n214\t  const { tz } = await loadSettings();\n215\t  const today = schoolToday(new Date(), tz);\n216\t  assertOpen(user, key.date, today);\n217\t  const edit = canEdit(user.role, key.date, today);\n218\t  if (!edit.ok) throw new AppError('FORBIDDEN', edit.reason ?? 'You cannot edit this register.');\n219\t  if (user.role !== 'ADMIN' && records.some((r) => r.status === 'EXCUSED')) {\n220\t    throw new AppError('FORBIDDEN', 'Only administrators can mark a student excused.');\n221\t  }\n222\t\n223\t  const next: Rec[] = records.map((r) => ({\n224\t    studentId: r.studentId,\n225\t    status: r.status,\n226\t    minutesLate: r.status === 'LATE' ? (r.minutesLate ?? null) : null,\n227\t    note: r.note ? r.note : null,\n228\t  }));\n229\t\n230\t  const write = () =>\n231\t    prisma.$transaction(async (tx) => {\n232\t      const roster = new Set((await activeRoster(tx, key, tz)).map((s) => s.id));\n233\t      const given = new Set(next.map((r) => r.studentId));\n234\t      const invalidStudentIds = [...given].filter((id) => !roster.has(id));\n235\t      if (invalidStudentIds.length) {\n236\t        throw new AppError('VALIDATION_ERROR', 'Some students are not on this register for that date.', { invalidStudentIds });\n237\t      }\n238\t      const missingStudentIds = [...roster].filter((id) => !given.has(id));\n239\t      if (missingStudentIds.length) {\n240\t        throw new AppError('VALIDATION_ERROR', 'Mark every student before saving.', { missingStudentIds });\n241\t      }\n242\t\n243\t      const session =\n244\t        (await tx.attendanceSession.findFirst({ where: sessionWhere(key), select: { id: true } })) ??\n245\t        (await tx.attendanceSession.create({\n246\t          data: {\n247\t            ...(isCourseKey(key) ? { courseId: key.courseId, periodId: key.periodId } : { sectionId: key.sectionId }),\n248\t            date: toDbDate(key.date),\n249\t            takenById: user.id,\n250\t            updatedById: user.id,\n251\t          },\n252\t          select: { id: true },\n253\t        }));\n254\t\n255\t      const prev = await tx.attendanceRecord.findMany({ where: { sessionId: session.id } });\n256\t      const diff = diffRecords(new Map(prev.map((r) => [r.studentId, toRec(r)])), next);\n257\t      if (diff.created.length) {\n258\t        await tx.attendanceRecord.createMany({\n259\t          data: diff.created.map((r) => ({ sessionId: session.id, studentId: r.studentId, status: r.status, minutesLate: r.minutesLate, note: r.note })),\n260\t        });\n261\t      }\n262\t      for (const c of diff.changed) {\n263\t        await tx.attendanceRecord.update({\n264\t          where: { sessionId_studentId: { sessionId: session.id, studentId: c.studentId } },\n265\t          data: { status: c.next.status, minutesLate: c.next.minutesLate, note: c.next.note },\n266\t        });\n267\t      }\n268\t      await tx.attendanceSession.update({ where: { id: session.id }, data: { updatedById: user.id } });\n269\t      return { sessionId: session.id, diff };\n270\t    });\n271\t\n272\t  let result: Awaited<ReturnType<typeof write>>;\n273\t  try {\n274\t    result = await write();\n275\t  } catch (error) {\n276\t    // ADR-3: two first-saves raced on the partial unique index. The aborted tx can't\n277\t    // re-read, so run it once more -- findFirst now sees the winner's session.\n278\t    if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') result = await write();\n279\t    else throw error;\n280\t  }\n281\t\n282\t  // After commit (audit/notify never throw).\n283\t  const { sessionId, diff } = result;\n284\t  await Promise.all(\n285\t    diff.changed\n286\t      .filter((c) => c.prev.status !== c.next.status)\n287\t      .map((c) =>\n288\t        audit({\n289\t          actorId: user.id,\n290\t          action: 'attendance.record.update',\n291\t          entityType: 'AttendanceSession',\n292\t          entityId: sessionId,\n293\t          metadata: { studentId: c.studentId, old: c.prev.status, new: c.next.status, note: c.next.note },\n294\t        }),\n295\t      ),\n296\t  );\n297\t\n298\t  const notes = notificationsFor(diff);\n299\t  const affected = [...notes.absent, ...notes.late, ...notes.corrected].map((r) => r.studentId);\n300\t  if (affected.length) {\n301\t    const names = new Map(\n302\t      (await prisma.user.findMany({ where: { id: { in: affected } }, select: { id: true, firstName: true, lastName: true } })).map((u) => [u.id, fullName(u)]),\n303\t    );\n304\t    const body = header.courseName\n305\t      ? `${header.courseName} – ${header.sectionName}, ${header.periodName}, ${longDate(key.date)}`\n306\t      : `${header.sectionName} daily register, ${longDate(key.date)}`;\n307\t    const send = (type: 'attendance.absent' | 'attendance.late' | 'attendance.corrected', r: Rec, title: string) =>\n308\t      notifyStudentAndParents({\n309\t        type,\n310\t        studentIds: [r.studentId],\n311\t        title,\n312\t        body,\n313\t        link: `/students/${r.studentId}/attendance`,\n314\t        email: { template: 'generic-notification' },\n315\t      });\n316\t    await Promise.all([\n317\t      ...notes.absent.map((r) => send('attendance.absent', r, `${names.get(r.studentId)} was marked absent`)),\n318\t      ...notes.late.map((r) => send('attendance.late', r, `${names.get(r.studentId)} was marked late (${r.minutesLate} min)`)),\n319\t      ...notes.corrected.map((r) => send('attendance.corrected', r, `Attendance corrected: ${names.get(r.studentId)} was present`)),\n320\t    ]);\n321\t  }\n322\t\n323\t  return getRegister(user, key);\n324\t}\n325\t\n326\t// ---------------------------------------------------------------------------\n327\t// Student tab (FR-25 to FR-28)\n328\t// ---------------------------------------------------------------------------\n329\t\n330\tasync function currentYearWithTerm(today: string) {\n331\t  const year = await prisma.academicYear.findFirst({\n332\t    where: { isCurrent: true },\n333\t    select: { id: true, startDate: true, terms: { select: { name: true, startDate: true, endDate: true }, orderBy: { startDate: 'asc' } } },\n334\t  });\n335\t  if (!year) return null;\n336\t  const terms = year.terms.map((t) => ({ name: t.name, start: fromDbDate(t.startDate), end: fromDbDate(t.endDate) }));\n337\t  // FR-25: the term containing today, else the latest ended one.\n338\t  const term = terms.find((t) => t.start <= today && today <= t.end) ?? terms.filter((t) => t.end < today).pop() ?? null;\n339\t  return { id: year.id, start: fromDbDate(year.startDate), term };\n340\t}\n341\t\n342\texport async function getStudentAttendance(user: AccessUser, studentId: string, range: { from?: string; to?: string }) {\n343\t  await assertCanViewStudent(user, studentId);\n344\t  const { tz, mode } = await loadSettings();\n345\t  const today = schoolToday(new Date(), tz);\n346\t  const from = range.from ?? `${today.slice(0, 8)}01`;\n347\t  // Day 28 + 4 always lands in next month; its 1st minus one day is this month's last day.\n348\t  const to = range.to ?? addDays(`${addDays(`${today.slice(0, 8)}28`, 4).slice(0, 8)}01`, -1);\n349\t  const year = await currentYearWithTerm(today);\n350\t\n351\t  const lo = year && year.start < from ? year.start : from;\n352\t  const hi = to > today ? to : today;\n353\t  const rows = await prisma.attendanceRecord.findMany({\n354\t    where: { studentId, session: { date: { gte: toDbDate(lo), lte: toDbDate(hi) }, ...kindWhere(mode) } },\n355\t    select: {\n356\t      id: true,\n357\t      status: true,\n358\t      minutesLate: true,\n359\t      note: true,\n360\t      session: {\n361\t        select: {\n362\t          date: true,\n363\t          period: { select: { name: true, order: true } },\n364\t          course: { select: { name: true, section: { select: { name: true } } } },\n365\t          section: { select: { name: true } },\n366\t        },\n367\t      },\n368\t    },\n369\t  });\n370\t  const recs = rows.map((r) => ({ ...r, date: fromDbDate(r.session.date) }));\n371\t  const within = (a: string, b: string) => recs.filter((r) => r.date >= a && r.date <= b).map((r) => r.status);\n372\t\n373\t  const term = year?.term;\n374\t  const summary = {\n375\t    term: { ...(term ? countStatuses(within(term.start, term.end < today ? term.end : today)) : countStatuses([])), termName: term?.name ?? null },\n376\t    year: year ? countStatuses(within(year.start, today)) : countStatuses([]),\n377\t  };\n378\t\n379\t  const inRange = recs.filter((r) => r.date >= from && r.date <= to);\n380\t  const byDay = new Map<string, Status[]>();\n381\t  for (const r of inRange) byDay.set(r.date, [...(byDay.get(r.date) ?? []), r.status]);\n382\t  const calendar = [...byDay.entries()]\n383\t    .sort(([a], [b]) => a.localeCompare(b))\n384\t    .map(([date, statuses]) => {\n385\t      const c = countStatuses(statuses);\n386\t      return { date, colour: dayColour(statuses), present: c.present, absent: c.absent, late: c.late, excused: c.excused };\n387\t    });\n388\t\n389\t  const showNotes = user.role === 'ADMIN' || user.role === 'TEACHER'; // FR-27\n390\t  const records = inRange\n391\t    .sort((a, b) => b.date.localeCompare(a.date) || (a.session.period?.order ?? 0) - (b.session.period?.order ?? 0))\n392\t    .map((r) => ({\n393\t      id: r.id,\n394\t      date: r.date,\n395\t      periodName: r.session.period?.name ?? null,\n396\t      courseName: r.session.course?.name ?? null,\n397\t      sectionName: r.session.section?.name ?? r.session.course?.section?.name ?? null,\n398\t      status: r.status,\n399\t      minutesLate: r.minutesLate,\n400\t      ...(showNotes ? { note: r.note } : {}),\n401\t    }));\n402\t\n403\t  return { from, to, summary, calendar, records };\n404\t}\n405\t\n406\t// ---------------------------------------------------------------------------\n407\t// Course matrix (FR-29)\n408\t// ---------------------------------------------------------------------------\n409\t\n410\texport async function getCourseMatrix(user: AccessUser, courseId: string) {\n411\t  await assertCanManageCourse(user, courseId);\n412\t  const sessions = (\n413\t    await prisma.attendanceSession.findMany({\n414\t      where: { courseId },\n415\t      orderBy: [{ date: 'desc' }, { period: { order: 'desc' } }],\n416\t      take: 20,\n417\t      select: { id: true, date: true, periodId: true, period: { select: { name: true } }, records: { select: { studentId: true, status: true } } },\n418\t    })\n419\t  ).reverse();\n420\t\n421\t  const [enrollments, totals] = await Promise.all([\n422\t    prisma.enrollment.findMany({\n423\t      where: { courseId },\n424\t      select: { status: true, student: { select: { id: true, firstName: true, lastName: true } } },\n425\t    }),\n426\t    prisma.attendanceRecord.groupBy({ by: ['studentId', 'status'], where: { session: { courseId } }, _count: { _all: true } }),\n427\t  ]);\n428\t\n429\t  const cells = new Map<string, Record<string, Status>>();\n430\t  for (const s of sessions) for (const r of s.records) cells.set(r.studentId, { ...(cells.get(r.studentId) ?? {}), [s.id]: r.status });\n431\t\n432\t  const students = enrollments\n433\t    .filter((e) => e.status === 'ACTIVE' || cells.has(e.student.id))\n434\t    .map((e) => ({\n435\t      studentId: e.student.id,\n436\t      firstName: e.student.firstName,\n437\t      lastName: e.student.lastName,\n438\t      enrollmentStatus: e.status,\n439\t      cells: cells.get(e.student.id) ?? {},\n440\t      rate: foldCounts(totals.filter((t) => t.studentId === e.student.id)).rate,\n441\t    }))\n442\t    .sort((a, b) => a.lastName.localeCompare(b.lastName) || a.firstName.localeCompare(b.firstName));\n443\t\n444\t  return {\n445\t    sessions: sessions.map((s) => ({ sessionId: s.id, date: fromDbDate(s.date), periodId: s.periodId ?? '', periodName: s.period?.name ?? '' })),\n446\t    students,\n447\t  };\n448\t}\n449\t\n450\tfunction foldCounts(groups: { status: Status; _count: { _all: number } }[]): StatusCounts {\n451\t  return countStatuses(groups.flatMap((g) => Array<Status>(g._count._all).fill(g.status)));\n452\t}\n453\t\n454\t// ---------------------------------------------------------------------------\n455\t// Admin: overview, remind, report, below threshold (FR-30 to FR-33)\n456\t// ---------------------------------------------------------------------------\n457\t\n458\tfunction plusMinutes(hhmm: string, minutes: number) {\n459\t  const [h, m] = hhmm.split(':').map(Number);\n460\t  const t = h * 60 + m + minutes;\n461\t  return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;\n462\t}\n463\t\n464\texport async function getOverview(dateArg?: string) {\n465\t  const { tz, mode } = await loadSettings();\n466\t  const now = new Date();\n467\t  const today = schoolToday(now, tz);\n468\t  const date = dateArg ?? today;\n469\t  if (date > today) throw new AppError('VALIDATION_ERROR', 'The overview cannot be shown for a future date.');\n470\t\n471\t  const [schedule, sections, sessions, groups] = await Promise.all([\n472\t    getSchoolScheduleForDate(date === today ? now : middayOf(date)),\n473\t    mode === 'PER_PERIOD'\n474\t      ? Promise.resolve([] as { id: string }[])\n475\t      : prisma.section.findMany({ where: { academicYear: { isCurrent: true } }, select: { id: true } }),\n476\t    prisma.attendanceSession.findMany({ where: { date: toDbDate(date) }, select: { courseId: true, periodId: true, sectionId: true } }),\n477\t    prisma.attendanceRecord.groupBy({ by: ['status'], where: { session: { date: toDbDate(date), ...kindWhere(mode) } }, _count: { _all: true } }),\n478\t  ]);\n479\t\n480\t  const done = new Set(sessions.map((s) => (s.courseId ? `${s.courseId}|${s.periodId}` : `section|${s.sectionId}`)));\n481\t  const takenMeetings = schedule.filter((s) => done.has(`${s.course.id}|${s.period.id}`));\n482\t  const takenSections = sections.filter((s) => done.has(`section|${s.id}`));\n483\t  const { hhmm } = schoolNow(now, tz);\n484\t\n485\t  const missing =\n486\t    date !== today\n487\t      ? []\n488\t      : schedule\n489\t          .filter((s) => !done.has(`${s.course.id}|${s.period.id}`) && plusMinutes(s.period.startTime, 15) <= hhmm)\n490\t          .map((s) => ({\n491\t            courseId: s.course.id,\n492\t            courseName: s.course.name,\n493\t            sectionName: s.course.section?.name ?? '',\n494\t            periodId: s.period.id,\n495\t            periodName: s.period.name,\n496\t            startTime: s.period.startTime,\n497\t            teacher: userRef(s.course.teacher)!,\n498\t          }));\n499\t\n500\t  return {\n501\t    date,\n502\t    expected: schedule.length + sections.length,\n503\t    taken: takenMeetings.length + takenSections.length,\n504\t    rate: foldCounts(groups).rate,\n505\t    missing,\n506\t  };\n507\t}\n508\t\n509\texport async function remindTeacher(admin: AccessUser, input: { courseId: string; periodId: string; date: string }, request?: Request) {\n510\t  const [course, period] = await Promise.all([\n511\t    prisma.course.findUnique({ where: { id: input.courseId }, select: { id: true, name: true, teacher: { select: { id: true, firstName: true, lastName: true } } } }),\n512\t    prisma.period.findUnique({ where: { id: input.periodId }, select: { name: true } }),\n513\t  ]);\n514\t  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n515\t  if (!period) throw new AppError('NOT_FOUND', 'Period not found');\n516\t\n517\t  await notify({\n518\t    type: 'attendance.register_missing',\n519\t    userIds: [course.teacher.id],\n520\t    title: `Register not taken: ${course.name}`,\n521\t    body: `${period.name}, ${longDate(input.date)}`,\n522\t    link: `/attendance/take/${course.id}?date=${input.date}&periodId=${input.periodId}`,\n523\t  });\n524\t  await audit({ actorId: admin.id, action: 'attendance.remind', entityType: 'Course', entityId: course.id, metadata: { ...input, teacherId: course.teacher.id }, request });\n525\t  return { reminded: userRef(course.teacher)! };\n526\t}\n527\t\n528\texport interface StudentSummaryRow extends StatusCounts {\n529\t  studentId: string;\n530\t  studentName: string;\n531\t  sectionName: string | null;\n532\t  gradeLevelName: string | null;\n533\t}\n534\t\n535\t/** groupBy (studentId, status) → per-student rows with names, sorted by last name. */\n536\tasync function aggregate(where: Prisma.AttendanceRecordWhereInput, mustHave?: Status): Promise<StudentSummaryRow[]> {\n537\t  const groups = await prisma.attendanceRecord.groupBy({ by: ['studentId', 'status'], where, _count: { _all: true } });\n538\t  const byStudent = new Map<string, typeof groups>();\n539\t  for (const g of groups) byStudent.set(g.studentId, [...(byStudent.get(g.studentId) ?? []), g]);\n540\t  const ids = [...byStudent.keys()].filter((id) => !mustHave || byStudent.get(id)!.some((g) => g.status === mustHave));\n541\t  if (!ids.length) return [];\n542\t\n543\t  const students = await prisma.user.findMany({\n544\t    where: { id: { in: ids } },\n545\t    select: {\n546\t      id: true,\n547\t      firstName: true,\n548\t      lastName: true,\n549\t      studentProfile: { select: { gradeLevel: { select: { name: true } } } },\n550\t      sectionMemberships: { where: { section: { academicYear: { isCurrent: true } } }, select: { section: { select: { name: true } } } },\n551\t    },\n552\t    orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }],\n553\t  });\n554\t  return students.map((s) => ({\n555\t    studentId: s.id,\n556\t    studentName: fullName(s),\n557\t    sectionName: s.sectionMemberships[0]?.section.name ?? null,\n558\t    gradeLevelName: s.studentProfile?.gradeLevel.name ?? null,\n559\t    ...foldCounts(byStudent.get(s.id)!),\n560\t  }));\n561\t}\n562\t\n563\t// ponytail: rows are paginated in memory after the groupBy -- bounded by the student count;\n564\t// move to SQL window pagination if the school grows past a few thousand students.\n565\texport async function getReport(filters: ReportFilters): Promise<StudentSummaryRow[]> {\n566\t  const { mode } = await loadSettings();\n567\t  const student: Prisma.UserWhereInput = {\n568\t    ...(filters.gradeLevelId ? { studentProfile: { gradeLevelId: filters.gradeLevelId } } : {}),\n569\t    ...(filters.sectionId ? { sectionMemberships: { some: { sectionId: filters.sectionId } } } : {}),\n570\t  };\n571\t  return aggregate(\n572\t    {\n573\t      session: {\n574\t        date: { gte: toDbDate(filters.from), lte: toDbDate(filters.to) },\n575\t        ...(filters.courseId ? { courseId: filters.courseId } : kindWhere(mode)),\n576\t      },\n577\t      student,\n578\t    },\n579\t    filters.status,\n580\t  );\n581\t}\n582\t\n583\texport async function getBelowThreshold() {\n584\t  const { tz, mode, threshold } = await loadSettings();\n585\t  const today = schoolToday(new Date(), tz);\n586\t  const year = await currentYearWithTerm(today);\n587\t  if (!year) return { threshold, rows: [] };\n588\t  const rows = (await aggregate({ session: { date: { gte: toDbDate(year.start), lte: toDbDate(today) }, ...kindWhere(mode) } }))\n589\t    .filter((r) => r.rate !== null && r.rate < threshold)\n590\t    .sort((a, b) => (a.rate ?? 0) - (b.rate ?? 0))\n591\t    .map((r) => ({ ...r, href: `/students/${r.studentId}/attendance` }));\n592\t  return { threshold, rows };\n593\t}\n594\t\n595\t/** For the admin Settings card. */\n596\texport async function getAttendanceSettings() {\n597\t  const { mode, threshold } = await loadSettings();\n598\t  return { attendanceMode: mode, attendanceAlertThreshold: threshold };\n599\t}\n600\t"}]},"parent_tool_use_id":null,"session_id":"88405567-c8b9-4e5f-8912-47ba3c7edb01","uuid":"9e9ca057-b077-4755-ba03-59daa81907c4","timestamp":"2026-11-06T06:06:36.680Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/src/server/attendance/attendance-service.ts","content":"import { Prisma, type AttendanceMode } from '@prisma/client';\nimport { fromZonedTime } from 'date-fns-tz';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { audit } from '@/server/audit';\nimport { assertCanManageCourse } from '@/server/auth/course-access';\nimport { assertCanViewStudent, type AccessUser } from '@/server/auth/student-access';\nimport { notify, notifyStudentAndParents } from '@/server/notifications/notify';\nimport { getScheduleForDate, getSchoolScheduleForDate } from '@/server/timetable/timetable-service';\nimport { formatInSchoolTz, schoolNow } from '@/lib/dates';\nimport type { RegisterKey, RegisterRecordInput, ReportFilters } from '@/lib/validators/attendance';\nimport {\n  addDays,\n  canEdit,\n  canOpen,\n  countStatuses,\n  dayColour,\n  diffRecords,\n  notificationsFor,\n  schoolToday,\n  type Rec,\n  type Status,\n  type StatusCounts,\n} from './attendance-rules';\n\n/**\n * PRD-07 attendance service (FR-37). The only writer of AttendanceSession /\n * AttendanceRecord. Route handlers and server pages stay thin.\n *\n * Deliberately does not import services/settings.ts: its react.cache()\n * wrapper is undefined outside Next, and the integration test imports this.\n */\n\ntype Tx = Prisma.TransactionClient;\ntype CourseKey = { courseId: string; date: string; periodId: string };\nconst isCourseKey = (k: RegisterKey): k is CourseKey => 'courseId' in k;\n\nconst toDbDate = (d: string) => new Date(`${d}T00:00:00Z`);\nconst fromDbDate = (d: Date) => d.toISOString().slice(0, 10);\n/** A Date that falls on `d` in any timezone within ±11h -- for weekday lookups. */\nconst middayOf = (d: string) => new Date(`${d}T12:00:00Z`);\nconst fullName = (u: { firstName: string; lastName: string }) => `${u.firstName} ${u.lastName}`;\nconst userRef = (u: { id: string; firstName: string; lastName: string } | null) => (u ? { id: u.id, name: fullName(u) } : null);\nconst longDate = (d: string) => formatInSchoolTz(toDbDate(d), 'EEEE d MMM yyyy', 'UTC');\n\nasync function loadSettings() {\n  const s = await prisma.schoolSettings.upsert({ where: { id: 'singleton' }, update: {}, create: { id: 'singleton' } });\n  return { tz: s.timezone, mode: s.attendanceMode, threshold: s.attendanceAlertThreshold };\n}\n\n/** FR-28: which session kind counts toward rates for the configured mode. */\nfunction kindWhere(mode: AttendanceMode): Prisma.AttendanceSessionWhereInput {\n  return mode === 'DAILY_HOMEROOM' ? { sectionId: { not: null } } : { courseId: { not: null } };\n}\n\n/** FR-15: ADMIN or the section's homeroom teacher. Private to this module. */\nasync function assertCanManageSection(user: AccessUser, sectionId: string) {\n  const section = await prisma.section.findUnique({ where: { id: sectionId }, select: { id: true, name: true, homeroomTeacherId: true } });\n  if (!section) throw new AppError('NOT_FOUND', 'Section not found');\n  if (user.role === 'ADMIN' || (user.role === 'TEACHER' && section.homeroomTeacherId === user.id)) return section;\n  throw new AppError('FORBIDDEN', 'You do not have permission to take this register.');\n}\n\n/** Access check + header labels. NOT_FOUND for a missing course/section/period. */\nasync function loadKey(user: AccessUser, key: RegisterKey) {\n  if (isCourseKey(key)) {\n    await assertCanManageCourse(user, key.courseId);\n    const [course, period] = await Promise.all([\n      prisma.course.findUnique({ where: { id: key.courseId }, select: { name: true, section: { select: { name: true } } } }),\n      prisma.period.findUnique({ where: { id: key.periodId }, select: { name: true } }),\n    ]);\n    if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n    if (!period) throw new AppError('NOT_FOUND', 'Period not found');\n    return { courseName: course.name, sectionName: course.section?.name ?? '', periodName: period.name as string | null, date: key.date };\n  }\n  const section = await assertCanManageSection(user, key.sectionId);\n  return { courseName: null as string | null, sectionName: section.name, periodName: null as string | null, date: key.date };\n}\n\nfunction assertOpen(user: AccessUser, date: string, today: string) {\n  const open = canOpen(user.role, date, today);\n  if (!open.ok) throw new AppError(open.code === 'FUTURE' ? 'VALIDATION_ERROR' : 'FORBIDDEN', open.reason);\n}\n\n/** NFR-3 / FR-9: students active on `date`, sorted by last name. */\nasync function activeRoster(db: Tx, key: RegisterKey, tz: string) {\n  const student = { select: { id: true, firstName: true, lastName: true } } as const;\n  let students: { id: string; firstName: string; lastName: string }[];\n  if (isCourseKey(key)) {\n    // enrolledAt::date <= date AND (ACTIVE OR droppedAt::date > date), dates in the school timezone.\n    const nextDay = fromZonedTime(`${addDays(key.date, 1)}T00:00:00`, tz);\n    const rows = await db.enrollment.findMany({\n      where: { courseId: key.courseId, enrolledAt: { lt: nextDay }, OR: [{ status: 'ACTIVE' }, { droppedAt: { gte: nextDay } }] },\n      select: { student },\n    });\n    students = rows.map((r) => r.student);\n  } else {\n    const rows = await db.sectionMember.findMany({ where: { sectionId: key.sectionId }, select: { student } });\n    students = rows.map((r) => r.student);\n  }\n  return students.sort((a, b) => a.lastName.localeCompare(b.lastName) || a.firstName.localeCompare(b.firstName));\n}\n\nfunction sessionWhere(key: RegisterKey): Prisma.AttendanceSessionWhereInput {\n  return isCourseKey(key)\n    ? { courseId: key.courseId, periodId: key.periodId, date: toDbDate(key.date) }\n    : { sectionId: key.sectionId, date: toDbDate(key.date) };\n}\n\nconst toRec = (r: { studentId: string; status: Status; minutesLate: number | null; note: string | null }): Rec => ({\n  studentId: r.studentId,\n  status: r.status,\n  minutesLate: r.minutesLate,\n  note: r.note,\n});\n\n// ---------------------------------------------------------------------------\n// Teacher landing (FR-6, FR-7)\n// ---------------------------------------------------------------------------\n\nconst takenSelect = { createdAt: true, takenBy: { select: { id: true, firstName: true, lastName: true } } } as const;\n\nexport async function getToday(user: AccessUser, date?: string) {\n  const { tz, mode } = await loadSettings();\n  const now = new Date();\n  const today = schoolToday(now, tz);\n  const day = date ?? today;\n  assertOpen(user, day, today);\n\n  const schedule = await getScheduleForDate({ userId: user.id, role: user.role }, day === today ? now : middayOf(day));\n  const { hhmm } = schoolNow(now, tz);\n  const courseSessions = schedule.length\n    ? await prisma.attendanceSession.findMany({\n        where: { date: toDbDate(day), courseId: { in: schedule.map((s) => s.course.id) } },\n        select: { courseId: true, periodId: true, ...takenSelect },\n      })\n    : [];\n  const taken = (s: { createdAt: Date; takenBy: { id: string; firstName: string; lastName: string } } | undefined) =>\n    s ? { at: s.createdAt.toISOString(), by: userRef(s.takenBy)! } : null;\n\n  const meetings = schedule.map((s) => ({\n    kind: 'course' as const,\n    courseId: s.course.id,\n    courseName: s.course.name,\n    sectionName: s.course.section?.name ?? '',\n    periodId: s.period.id,\n    periodName: s.period.name,\n    startTime: s.period.startTime,\n    endTime: s.period.endTime,\n    isCurrent: day === today && s.period.startTime <= hhmm && hhmm < s.period.endTime,\n    taken: taken(courseSessions.find((x) => x.courseId === s.course.id && x.periodId === s.period.id)),\n  }));\n\n  let dailyRegisters: { kind: 'section'; sectionId: string; sectionName: string; taken: ReturnType<typeof taken> }[] = [];\n  if (mode !== 'PER_PERIOD') {\n    const sections = await prisma.section.findMany({\n      where: { homeroomTeacherId: user.id, academicYear: { isCurrent: true } },\n      select: { id: true, name: true, attendanceSessions: { where: { date: toDbDate(day) }, select: takenSelect } },\n      orderBy: { name: 'asc' },\n    });\n    dailyRegisters = sections.map((s) => ({ kind: 'section', sectionId: s.id, sectionName: s.name, taken: taken(s.attendanceSessions[0]) }));\n  }\n\n  return { date: day, today, meetings, dailyRegisters };\n}\n\n// ---------------------------------------------------------------------------\n// Register read / save (FR-8 to FR-22, NFR-1, NFR-3)\n// ---------------------------------------------------------------------------\n\nexport type Register = Awaited<ReturnType<typeof getRegister>>;\n\nexport async function getRegister(user: AccessUser, key: RegisterKey) {\n  const header = await loadKey(user, key);\n  const { tz } = await loadSettings();\n  const today = schoolToday(new Date(), tz);\n  assertOpen(user, key.date, today);\n\n  const [students, session] = await Promise.all([\n    activeRoster(prisma, key, tz),\n    prisma.attendanceSession.findFirst({\n      where: sessionWhere(key),\n      include: {\n        records: true,\n        takenBy: { select: { id: true, firstName: true, lastName: true } },\n        updatedBy: { select: { id: true, firstName: true, lastName: true } },\n      },\n    }),\n  ]);\n  const edit = canEdit(user.role, key.date, today);\n\n  return {\n    key,\n    header,\n    sessionId: session?.id ?? null,\n    students: students.map((s) => ({ ...s, avatarUrl: null as string | null })),\n    records: (session?.records ?? []).map((r) => ({\n      studentId: r.studentId,\n      status: r.status,\n      ...(r.minutesLate != null ? { minutesLate: r.minutesLate } : {}),\n      ...(r.note ? { note: r.note } : {}),\n    })),\n    takenBy: userRef(session?.takenBy ?? null),\n    updatedBy: userRef(session?.updatedBy ?? null),\n    updatedAt: session?.updatedAt.toISOString() ?? null,\n    readOnly: !edit.ok,\n    readOnlyReason: edit.ok ? null : (edit.reason ?? null),\n    canExcuse: user.role === 'ADMIN',\n  };\n}\n\nexport async function saveRegister(user: AccessUser, key: RegisterKey, records: RegisterRecordInput[]) {\n  const header = await loadKey(user, key);\n  const { tz } = await loadSettings();\n  const today = schoolToday(new Date(), tz);\n  assertOpen(user, key.date, today);\n  const edit = canEdit(user.role, key.date, today);\n  if (!edit.ok) throw new AppError('FORBIDDEN', edit.reason ?? 'You cannot edit this register.');\n  if (user.role !== 'ADMIN' && records.some((r) => r.status === 'EXCUSED')) {\n    throw new AppError('FORBIDDEN', 'Only administrators can mark a student excused.');\n  }\n\n  const next: Rec[] = records.map((r) => ({\n    studentId: r.studentId,\n    status: r.status,\n    minutesLate: r.status === 'LATE' ? (r.minutesLate ?? null) : null,\n    note: r.note ? r.note : null,\n  }));\n\n  const write = () =>\n    prisma.$transaction(async (tx) => {\n      const roster = new Set((await activeRoster(tx, key, tz)).map((s) => s.id));\n      const given = new Set(next.map((r) => r.studentId));\n      const invalidStudentIds = [...given].filter((id) => !roster.has(id));\n      if (invalidStudentIds.length) {\n        throw new AppError('VALIDATION_ERROR', 'Some students are not on this register for that date.', { invalidStudentIds });\n      }\n      const missingStudentIds = [...roster].filter((id) => !given.has(id));\n      if (missingStudentIds.length) {\n        throw new AppError('VALIDATION_ERROR', 'Mark every student before saving.', { missingStudentIds });\n      }\n\n      const session =\n        (await tx.attendanceSession.findFirst({ where: sessionWhere(key), select: { id: true } })) ??\n        (await tx.attendanceSession.create({\n          data: {\n            ...(isCourseKey(key) ? { courseId: key.courseId, periodId: key.periodId } : { sectionId: key.sectionId }),\n            date: toDbDate(key.date),\n            takenById: user.id,\n            updatedById: user.id,\n          },\n          select: { id: true },\n        }));\n\n      const prev = await tx.attendanceRecord.findMany({ where: { sessionId: session.id } });\n      const diff = diffRecords(new Map(prev.map((r) => [r.studentId, toRec(r)])), next);\n      if (diff.created.length) {\n        await tx.attendanceRecord.createMany({\n          data: diff.created.map((r) => ({ sessionId: session.id, studentId: r.studentId, status: r.status, minutesLate: r.minutesLate, note: r.note })),\n        });\n      }\n      for (const c of diff.changed) {\n        await tx.attendanceRecord.update({\n          where: { sessionId_studentId: { sessionId: session.id, studentId: c.studentId } },\n          data: { status: c.next.status, minutesLate: c.next.minutesLate, note: c.next.note },\n        });\n      }\n      await tx.attendanceSession.update({ where: { id: session.id }, data: { updatedById: user.id } });\n      return { sessionId: session.id, diff };\n    });\n\n  let result: Awaited<ReturnType<typeof write>>;\n  try {\n    result = await write();\n  } catch (error) {\n    // ADR-3: two first-saves raced on the partial unique index. The aborted tx can't\n    // re-read, so run it once more -- findFirst now sees the winner's session.\n    if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') result = await write();\n    else throw error;\n  }\n\n  // After commit (audit/notify never throw).\n  const { sessionId, diff } = result;\n  await Promise.all(\n    diff.changed\n      .filter((c) => c.prev.status !== c.next.status)\n      .map((c) =>\n        audit({\n          actorId: user.id,\n          action: 'attendance.record.update',\n          entityType: 'AttendanceSession',\n          entityId: sessionId,\n          metadata: { studentId: c.studentId, old: c.prev.status, new: c.next.status, note: c.next.note },\n        }),\n      ),\n  );\n\n  const notes = notificationsFor(diff);\n  const affected = [...notes.absent, ...notes.late, ...notes.corrected].map((r) => r.studentId);\n  if (affected.length) {\n    const names = new Map(\n      (await prisma.user.findMany({ where: { id: { in: affected } }, select: { id: true, firstName: true, lastName: true } })).map((u) => [u.id, fullName(u)]),\n    );\n    const body = header.courseName\n      ? `${header.courseName} – ${header.sectionName}, ${header.periodName}, ${longDate(key.date)}`\n      : `${header.sectionName} daily register, ${longDate(key.date)}`;\n    const send = (type: 'attendance.absent' | 'attendance.late' | 'attendance.corrected', r: Rec, title: string) =>\n      notifyStudentAndParents({\n        type,\n        studentIds: [r.studentId],\n        title,\n        body,\n        link: `/students/${r.studentId}/attendance`,\n        email: { template: 'generic-notification' },\n      });\n    await Promise.all([\n      ...notes.absent.map((r) => send('attendance.absent', r, `${names.get(r.studentId)} was marked absent`)),\n      ...notes.late.map((r) => send('attendance.late', r, `${names.get(r.studentId)} was marked late (${r.minutesLate} min)`)),\n      ...notes.corrected.map((r) => send('attendance.corrected', r, `Attendance corrected: ${names.get(r.studentId)} was present`)),\n    ]);\n  }\n\n  return getRegister(user, key);\n}\n\n// ---------------------------------------------------------------------------\n// Student tab (FR-25 to FR-28)\n// ---------------------------------------------------------------------------\n\nasync function currentYearWithTerm(today: string) {\n  const year = await prisma.academicYear.findFirst({\n    where: { isCurrent: true },\n    select: { id: true, startDate: true, terms: { select: { name: true, startDate: true, endDate: true }, orderBy: { startDate: 'asc' } } },\n  });\n  if (!year) return null;\n  const terms = year.terms.map((t) => ({ name: t.name, start: fromDbDate(t.startDate), end: fromDbDate(t.endDate) }));\n  // FR-25: the term containing today, else the latest ended one.\n  const term = terms.find((t) => t.start <= today && today <= t.end) ?? terms.filter((t) => t.end < today).pop() ?? null;\n  return { id: year.id, start: fromDbDate(year.startDate), term };\n}\n\nexport async function getStudentAttendance(user: AccessUser, studentId: string, range: { from?: string; to?: string }) {\n  await assertCanViewStudent(user, studentId);\n  const { tz, mode } = await loadSettings();\n  const today = schoolToday(new Date(), tz);\n  const from = range.from ?? `${today.slice(0, 8)}01`;\n  // Day 28 + 4 always lands in next month; its 1st minus one day is this month's last day.\n  const to = range.to ?? addDays(`${addDays(`${today.slice(0, 8)}28`, 4).slice(0, 8)}01`, -1);\n  const year = await currentYearWithTerm(today);\n\n  const lo = year && year.start < from ? year.start : from;\n  const hi = to > today ? to : today;\n  const rows = await prisma.attendanceRecord.findMany({\n    where: { studentId, session: { date: { gte: toDbDate(lo), lte: toDbDate(hi) }, ...kindWhere(mode) } },\n    select: {\n      id: true,\n      status: true,\n      minutesLate: true,\n      note: true,\n      session: {\n        select: {\n          date: true,\n          period: { select: { name: true, order: true } },\n          course: { select: { name: true, section: { select: { name: true } } } },\n          section: { select: { name: true } },\n        },\n      },\n    },\n  });\n  const recs = rows.map((r) => ({ ...r, date: fromDbDate(r.session.date) }));\n  const within = (a: string, b: string) => recs.filter((r) => r.date >= a && r.date <= b).map((r) => r.status);\n\n  const term = year?.term;\n  const summary = {\n    term: { ...(term ? countStatuses(within(term.start, term.end < today ? term.end : today)) : countStatuses([])), termName: term?.name ?? null },\n    year: year ? countStatuses(within(year.start, today)) : countStatuses([]),\n  };\n\n  const inRange = recs.filter((r) => r.date >= from && r.date <= to);\n  const byDay = new Map<string, Status[]>();\n  for (const r of inRange) byDay.set(r.date, [...(byDay.get(r.date) ?? []), r.status]);\n  const calendar = [...byDay.entries()]\n    .sort(([a], [b]) => a.localeCompare(b))\n    .map(([date, statuses]) => {\n      const c = countStatuses(statuses);\n      return { date, colour: dayColour(statuses), present: c.present, absent: c.absent, late: c.late, excused: c.excused };\n    });\n\n  const showNotes = user.role === 'ADMIN' || user.role === 'TEACHER'; // FR-27\n  const records = inRange\n    .sort((a, b) => b.date.localeCompare(a.date) || (a.session.period?.order ?? 0) - (b.session.period?.order ?? 0))\n    .map((r) => ({\n      id: r.id,\n      date: r.date,\n      periodName: r.session.period?.name ?? null,\n      courseName: r.session.course?.name ?? null,\n      sectionName: r.session.section?.name ?? r.session.course?.section?.name ?? null,\n      status: r.status,\n      minutesLate: r.minutesLate,\n      ...(showNotes ? { note: r.note } : {}),\n    }));\n\n  return { from, to, summary, calendar, records };\n}\n\n// ---------------------------------------------------------------------------\n// Course matrix (FR-29)\n// ---------------------------------------------------------------------------\n\nexport async function getCourseMatrix(user: AccessUser, courseId: string) {\n  await assertCanManageCourse(user, courseId);\n  const sessions = (\n    await prisma.attendanceSession.findMany({\n      where: { courseId },\n      orderBy: [{ date: 'desc' }, { period: { order: 'desc' } }],\n      take: 20,\n      select: { id: true, date: true, periodId: true, period: { select: { name: true } }, records: { select: { studentId: true, status: true } } },\n    })\n  ).reverse();\n\n  const [enrollments, totals] = await Promise.all([\n    prisma.enrollment.findMany({\n      where: { courseId },\n      select: { status: true, student: { select: { id: true, firstName: true, lastName: true } } },\n    }),\n    prisma.attendanceRecord.groupBy({ by: ['studentId', 'status'], where: { session: { courseId } }, _count: { _all: true } }),\n  ]);\n\n  const cells = new Map<string, Record<string, Status>>();\n  for (const s of sessions) for (const r of s.records) cells.set(r.studentId, { ...(cells.get(r.studentId) ?? {}), [s.id]: r.status });\n\n  const students = enrollments\n    .filter((e) => e.status === 'ACTIVE' || cells.has(e.student.id))\n    .map((e) => ({\n      studentId: e.student.id,\n      firstName: e.student.firstName,\n      lastName: e.student.lastName,\n      enrollmentStatus: e.status,\n      cells: cells.get(e.student.id) ?? {},\n      rate: foldCounts(totals.filter((t) => t.studentId === e.student.id)).rate,\n    }))\n    .sort((a, b) => a.lastName.localeCompare(b.lastName) || a.firstName.localeCompare(b.firstName));\n\n  return {\n    sessions: sessions.map((s) => ({ sessionId: s.id, date: fromDbDate(s.date), periodId: s.periodId ?? '', periodName: s.period?.name ?? '' })),\n    students,\n  };\n}\n\nfunction foldCounts(groups: { status: Status; _count: { _all: number } }[]): StatusCounts {\n  return countStatuses(groups.flatMap((g) => Array<Status>(g._count._all).fill(g.status)));\n}\n\n// ---------------------------------------------------------------------------\n// Admin: overview, remind, report, below threshold (FR-30 to FR-33)\n// ---------------------------------------------------------------------------\n\nfunction plusMinutes(hhmm: string, minutes: number) {\n  const [h, m] = hhmm.split(':').map(Number);\n  const t = h * 60 + m + minutes;\n  return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;\n}\n\nexport async function getOverview(dateArg?: string) {\n  const { tz, mode } = await loadSettings();\n  const now = new Date();\n  const today = schoolToday(now, tz);\n  const date = dateArg ?? today;\n  if (date > today) throw new AppError('VALIDATION_ERROR', 'The overview cannot be shown for a future date.');\n\n  const [schedule, sections, sessions, groups] = await Promise.all([\n    getSchoolScheduleForDate(date === today ? now : middayOf(date)),\n    mode === 'PER_PERIOD'\n      ? Promise.resolve([] as { id: string }[])\n      : prisma.section.findMany({ where: { academicYear: { isCurrent: true } }, select: { id: true } }),\n    prisma.attendanceSession.findMany({ where: { date: toDbDate(date) }, select: { courseId: true, periodId: true, sectionId: true } }),\n    prisma.attendanceRecord.groupBy({ by: ['status'], where: { session: { date: toDbDate(date), ...kindWhere(mode) } }, _count: { _all: true } }),\n  ]);\n\n  const done = new Set(sessions.map((s) => (s.courseId ? `${s.courseId}|${s.periodId}` : `section|${s.sectionId}`)));\n  const takenMeetings = schedule.filter((s) => done.has(`${s.course.id}|${s.period.id}`));\n  const takenSections = sections.filter((s) => done.has(`section|${s.id}`));\n  const { hhmm } = schoolNow(now, tz);\n\n  const missing =\n    date !== today\n      ? []\n      : schedule\n          .filter((s) => !done.has(`${s.course.id}|${s.period.id}`) && plusMinutes(s.period.startTime, 15) <= hhmm)\n          .map((s) => ({\n            courseId: s.course.id,\n            courseName: s.course.name,\n            sectionName: s.course.section?.name ?? '',\n            periodId: s.period.id,\n            periodName: s.period.name,\n            startTime: s.period.startTime,\n            teacher: userRef(s.course.teacher)!,\n          }));\n\n  return {\n    date,\n    expected: schedule.length + sections.length,\n    taken: takenMeetings.length + takenSections.length,\n    rate: foldCounts(groups).rate,\n    missing,\n  };\n}\n\nexport async function remindTeacher(admin: AccessUser, input: { courseId: string; periodId: string; date: string }, request?: Request) {\n  const [course, period] = await Promise.all([\n    prisma.course.findUnique({ where: { id: input.courseId }, select: { id: true, name: true, teacher: { select: { id: true, firstName: true, lastName: true } } } }),\n    prisma.period.findUnique({ where: { id: input.periodId }, select: { name: true } }),\n  ]);\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  if (!period) throw new AppError('NOT_FOUND', 'Period not found');\n\n  await notify({\n    type: 'attendance.register_missing',\n    userIds: [course.teacher.id],\n    title: `Register not taken: ${course.name}`,\n    body: `${period.name}, ${longDate(input.date)}`,\n    link: `/attendance/take/${course.id}?date=${input.date}&periodId=${input.periodId}`,\n  });\n  await audit({ actorId: admin.id, action: 'attendance.remind', entityType: 'Course', entityId: course.id, metadata: { ...input, teacherId: course.teacher.id }, request });\n  return { reminded: userRef(course.teacher)! };\n}\n\nexport interface StudentSummaryRow extends StatusCounts {\n  studentId: string;\n  studentName: string;\n  sectionName: string | null;\n  gradeLevelName: string | null;\n}\n\n/** groupBy (studentId, status) → per-student rows with names, sorted by last name. */\nasync function aggregate(where: Prisma.AttendanceRecordWhereInput, mustHave?: Status): Promise<StudentSummaryRow[]> {\n  const groups = await prisma.attendanceRecord.groupBy({ by: ['studentId', 'status'], where, _count: { _all: true } });\n  const byStudent = new Map<string, typeof groups>();\n  for (const g of groups) byStudent.set(g.studentId, [...(byStudent.get(g.studentId) ?? []), g]);\n  const ids = [...byStudent.keys()].filter((id) => !mustHave || byStudent.get(id)!.some((g) => g.status === mustHave));\n  if (!ids.length) return [];\n\n  const students = await prisma.user.findMany({\n    where: { id: { in: ids } },\n    select: {\n      id: true,\n      firstName: true,\n      lastName: true,\n      studentProfile: { select: { gradeLevel: { select: { name: true } } } },\n      sectionMemberships: { where: { section: { academicYear: { isCurrent: true } } }, select: { section: { select: { name: true } } } },\n    },\n    orderBy: [{ lastName: 'asc' }, { firstName: 'asc' }],\n  });\n  return students.map((s) => ({\n    studentId: s.id,\n    studentName: fullName(s),\n    sectionName: s.sectionMemberships[0]?.section.name ?? null,\n    gradeLevelName: s.studentProfile?.gradeLevel.name ?? null,\n    ...foldCounts(byStudent.get(s.id)!),\n  }));\n}\n\n// ponytail: rows are paginated in memory after the groupBy -- bounded by the student count;\n// move to SQL window pagination if the school grows past a few thousand students.\nexport async function getReport(filters: ReportFilters): Promise<StudentSummaryRow[]> {\n  const { mode } = await loadSettings();\n  const student: Prisma.UserWhereInput = {\n    ...(filters.gradeLevelId ? { studentProfile: { gradeLevelId: filters.gradeLevelId } } : {}),\n    ...(filters.sectionId ? { sectionMemberships: { some: { sectionId: filters.sectionId } } } : {}),\n  };\n  return aggregate(\n    {\n      session: {\n        date: { gte: toDbDate(filters.from), lte: toDbDate(filters.to) },\n        ...(filters.courseId ? { courseId: filters.courseId } : kindWhere(mode)),\n      },\n      student,\n    },\n    filters.status,\n  );\n}\n\nexport async function getBelowThreshold() {\n  const { tz, mode, threshold } = await loadSettings();\n  const today = schoolToday(new Date(), tz);\n  const year = await currentYearWithTerm(today);\n  if (!year) return { threshold, rows: [] };\n  const rows = (await aggregate({ session: { date: { gte: toDbDate(year.start), lte: toDbDate(today) }, ...kindWhere(mode) } }))\n    .filter((r) => r.rate !== null && r.rate < threshold)\n    .sort((a, b) => (a.rate ?? 0) - (b.rate ?? 0))\n    .map((r) => ({ ...r, href: `/students/${r.studentId}/attendance` }));\n  return { threshold, rows };\n}\n\n/** For the admin Settings card. */\nexport async function getAttendanceSettings() {\n  const { mode, threshold } = await loadSettings();\n  return { attendanceMode: mode, attendanceAlertThreshold: threshold };\n}\n","numLines":600,"startLine":1,"totalLines":600}},"tool_result_meta":[{"id":"toolu_01FzQvo917J2wX2qiMAJmd16","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
