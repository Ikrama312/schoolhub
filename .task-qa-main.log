{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018fMPnuQPzgZ7J8gAMtD5qp","type":"tool_result","content":"import { requirePageUser } from '@/server/auth/requireRole';\nimport { assertCanViewStudent } from '@/server/auth/student-access';\nimport { prisma } from '@/server/db';\nimport { messageableIds } from '@/server/messaging/contact-rules';\nimport { StudentMessageActions, type StudentMessageActionsProps } from '@/components/messaging/StudentMessageActions';\n\n/**\n * PRD-13 FR-16: a compact action row above every student tab. The [id] segment name is kept.\n * Pages still do their own access checks; this layout renders nothing extra unless the viewer can\n * see the student and has someone to message.\n */\nexport default async function StudentLayout({ children, params }: { children: React.ReactNode; params: { id: string } }) {\n  const user = await requirePageUser();\n  const actions = await resolveActions(user, params.id).catch(() => null);\n  return (\n    <>\n      {actions && <StudentMessageActions {...actions} />}\n      {children}\n    </>\n  );\n}\n\nasync function resolveActions(user: Awaited<ReturnType<typeof requirePageUser>>, studentId: string): Promise<StudentMessageActionsProps | null> {\n  if (user.role === 'STUDENT') return null;\n  await assertCanViewStudent(user, studentId);\n  const student = await prisma.user.findUnique({\n    where: { id: studentId },\n    select: {\n      role: true,\n      firstName: true,\n      lastName: true,\n      studentLinks: { select: { parent: { select: { id: true, firstName: true, lastName: true } } } },\n    },\n  });\n  if (!student || student.role !== 'STUDENT') return null;\n\n  if (user.role === 'PARENT') {\n    return student.studentLinks.some((l) => l.parent.id === user.id) ? { mode: 'teacher', childFirstName: student.firstName } : null;\n  }\n  const reachable = new Set(await messageableIds(user, student.studentLinks.map((l) => l.parent.id)));\n  const parents = student.studentLinks\n    .filter((l) => reachable.has(l.parent.id))\n    .map((l) => ({ id: l.parent.id, name: `${l.parent.firstName} ${l.parent.lastName}`, role: 'PARENT' as const, avatarUrl: null }));\n  return parents.length ? { mode: 'parents', studentName: `${student.firstName} ${student.lastName}`, parents } : null;\n}\n/** Staff roster table with selection and PRD-13 FR-17 \"Message selected students\". Only ACTIVE students are selectable. */\nexport function RosterTable({ rows, courseCode }: { rows: RosterRow[]; courseCode: string }) {\n  const [selected, setSelected] = useState<Set<string>>(new Set());\n  const [open, setOpen] = useState(false);\n  const selectable = rows.filter((r) => r.status === 'ACTIVE');\n  const allSelected = selectable.length > 0 && selectable.every((r) => selected.has(r.studentId));\n  const recipients = useMemo(\n    () => rows.filter((r) => selected.has(r.studentId)).map((r) => ({ id: r.studentId, name: r.name, role: 'STUDENT' as const, avatarUrl: null })),\n    [rows, selected],\n  );\n\n  const toggle = (id: string) =>\n    setSelected((prev) => {\n      const next = new Set(prev);\n      if (!next.delete(id)) next.add(id);\n      return next;\n    });\n\n  return (\n    <TableContainer component={Paper} variant=\"outlined\">\n      <Toolbar variant=\"dense\" sx={{ gap: 2 }}>\n        <Typography variant=\"body2\" sx={{ flex: 1 }} color=\"text.secondary\">\n          {selected.size ? `${selected.size} selected` : 'Select students to message them'}\n        </Typography>\n        <Button size=\"small\" variant=\"contained\" startIcon={<ChatBubbleOutlineOutlinedIcon />} disabled={!selected.size} onClick={() => setOpen(true)}>\n          Message selected students\n        </Button>\n      </Toolbar>\n      <Table size=\"small\" aria-label=\"Course roster\">\n        <TableHead>\n          <TableRow>\n11:import { RosterTable, type RosterRow } from './RosterTable';\n18:  if (user.role === 'PARENT') notFound();\n19:  const { rows } = await getCourseRoster(params.courseId, user.role);\n23:  if (user.role === 'STUDENT') {\n48:  return <RosterTable rows={tableRows} courseCode={course?.code ?? ''} />;","is_error":false}]},"parent_tool_use_id":null,"session_id":"b2a19e14-003d-496b-9902-59b2c0434c99","uuid":"9dd6489d-7be6-433e-b500-d0581cd92fb9","timestamp":"2026-11-09T18:02:48.857Z","tool_use_result":{"stdout":"import { requirePageUser } from '@/server/auth/requireRole';\nimport { assertCanViewStudent } from '@/server/auth/student-access';\nimport { prisma } from '@/server/db';\nimport { messageableIds } from '@/server/messaging/contact-rules';\nimport { StudentMessageActions, type StudentMessageActionsProps } from '@/components/messaging/StudentMessageActions';\n\n/**\n * PRD-13 FR-16: a compact action row above every student tab. The [id] segment name is kept.\n * Pages still do their own access checks; this layout renders nothing extra unless the viewer can\n * see the student and has someone to message.\n */\nexport default async function StudentLayout({ children, params }: { children: React.ReactNode; params: { id: string } }) {\n  const user = await requirePageUser();\n  const actions = await resolveActions(user, params.id).catch(() => null);\n  return (\n    <>\n      {actions && <StudentMessageActions {...actions} />}\n      {children}\n    </>\n  );\n}\n\nasync function resolveActions(user: Awaited<ReturnType<typeof requirePageUser>>, studentId: string): Promise<StudentMessageActionsProps | null> {\n  if (user.role === 'STUDENT') return null;\n  await assertCanViewStudent(user, studentId);\n  const student = await prisma.user.findUnique({\n    where: { id: studentId },\n    select: {\n      role: true,\n      firstName: true,\n      lastName: true,\n      studentLinks: { select: { parent: { select: { id: true, firstName: true, lastName: true } } } },\n    },\n  });\n  if (!student || student.role !== 'STUDENT') return null;\n\n  if (user.role === 'PARENT') {\n    return student.studentLinks.some((l) => l.pare