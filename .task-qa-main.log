{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Wdi9GZdRzCHJ1rY33jxMs","type":"tool_result","content":"1\timport { describe, expect, it } from 'vitest';\n2\timport {\n3\t  applyOverride,\n4\t  computeStudentTerm,\n5\t  counted,\n6\t  gradeColour,\n7\t  isUngradedPastDue,\n8\t  letterFor,\n9\t  roundHalfUp1,\n10\t  type CalcCategory,\n11\t  type CalcGrade,\n12\t  type CalcItem,\n13\t} from '@/server/gradebook/grade-calc';\n14\t\n15\t/** PRD-11 seed scale (Seed Data). */\n16\tconst BANDS = [\n17\t  ['A', 93], ['A-', 90], ['B+', 87], ['B', 83], ['B-', 80], ['C+', 77],\n18\t  ['C', 73], ['C-', 70], ['D+', 67], ['D', 63], ['D-', 60], ['F', 0],\n19\t].map(([letter, minPercent]) => ({ letter: letter as string, minPercent: minPercent as number, descriptor: `${letter} desc` }));\n20\t\n21\tconst NOW = new Date('2026-11-01T12:00:00Z');\n22\tconst PAST = new Date('2026-10-01T12:00:00Z');\n23\tconst FUTURE = new Date('2026-12-01T12:00:00Z');\n24\t\n25\tlet n = 0;\n26\tconst item = (categoryId: string | null, maxPoints: number | string, extra: Partial<CalcItem> = {}): CalcItem => ({\n27\t  id: `i${++n}`,\n28\t  categoryId,\n29\t  maxPoints,\n30\t  dueAt: PAST,\n31\t  isVisible: true,\n32\t  ...extra,\n33\t});\n34\tconst cat = (id: string, weightPercent: number, dropLowest = 0, order = 0): CalcCategory => ({ id, name: id, weightPercent, dropLowest, order });\n35\tconst scored = (score: number | string | null, extra: Partial<CalcGrade> = {}): CalcGrade => ({ score, excused: false, missing: false, ...extra });\n36\t\n37\tfunction run(pairs: [CalcItem, CalcGrade | undefined][], categories: CalcCategory[] = [], override: Parameters<typeof computeStudentTerm>[0]['override'] = null) {\n38\t  const grades = new Map<string, CalcGrade>();\n39\t  for (const [i, g] of pairs) if (g) grades.set(i.id, g);\n40\t  return computeStudentTerm({ items: pairs.map(([i]) => i), grades, categories, bands: BANDS, override, now: NOW });\n41\t}\n42\t\n43\tdescribe('computeStudentTerm', () => {\n44\t  it('FR-15 golden: Homework 40 % (18/20, 9/10) + Exams 60 % (70/100) = 78.0 % C+ (AC-1)', () => {\n45\t    const r = run(\n46\t      [\n47\t        [item('hw', 20), scored(18)],\n48\t        [item('hw', 10), scored(9)],\n49\t        [item('ex', 100), scored(70)],\n50\t      ],\n51\t      [cat('hw', 40, 0, 0), cat('ex', 60, 0, 1)],\n52\t    );\n53\t    expect(r.categories.map((c) => [c.id, c.percent, c.earned, c.possible])).toEqual([\n54\t      ['hw', '90.0', '27.00', '30.00'],\n55\t      ['ex', '70.0', '70.00', '100.00'],\n56\t    ]);\n57\t    expect(r).toMatchObject({ percent: '78.0', letter: 'C+', computedPercent: '78.0', computedLetter: 'C+', overridden: false, descriptor: 'C+ desc' });\n58\t  });\n59\t\n60\t  it('no categories → points total', () => {\n61\t    const r = run([[item(null, 20), scored(10)], [item(null, 80), scored(70)]]);\n62\t    expect(r.percent).toBe('80.0');\n63\t    expect(r.categories).toEqual([expect.objectContaining({ id: null, name: 'Uncategorised', weightPercent: '100.00', percent: '80.0' })]);\n64\t  });\n65\t\n66\t  it('empty categories are skipped and weights re-normalised', () => {\n67\t    const r = run([[item('hw', 10), scored(5)]], [cat('hw', 30), cat('ex', 70, 0, 1)]);\n68\t    expect(r.percent).toBe('50.0');\n69\t    expect(r.categories.find((c) => c.id === 'ex')?.percent).toBeNull();\n70\t  });\n71\t\n72\t  it('nothing counted → percent and letter null', () => {\n73\t    const r = run([[item('hw', 10), undefined], [item('hw', 10), scored(null)]], [cat('hw', 100)]);\n74\t    expect(r).toMatchObject({ percent: null, letter: null, computedPercent: null });\n75\t  });\n76\t\n77\t  it('A8: Uncategorised has weight 0 when the course has categories; falls back to points when no category counts', () => {\n78\t    const weighted = run([[item('hw', 10), scored(10)], [item(null, 10), scored(0)]], [cat('hw', 100)]);\n79\t    expect(weighted.percent).toBe('100.0');\n80\t    expect(weighted.categories.at(-1)).toMatchObject({ id: null, weightPercent: '0.00', percent: '0.0' });\n81\t\n82\t    const fallback = run([[item(null, 10), scored(4)]], [cat('hw', 100)]);\n83\t    expect(fallback.percent).toBe('40.0');\n84\t  });\n85\t\n86\t  it('AC-2: dropLowest 1 removes the 50 % score', () => {\n87\t    const low = item('hw', 10);\n88\t    const r = run(\n89\t      [\n90\t        [low, scored(5)],\n91\t        [item('hw', 10), scored(9)],\n92\t        [item('hw', 10), scored(10)],\n93\t      ],\n94\t      [cat('hw', 100, 1)],\n95\t    );\n96\t    expect(r.categories[0]).toMatchObject({ percent: '95.0', droppedItemIds: [low.id] });\n97\t  });\n98\t\n99\t  it('never drops every counted item', () => {\n100\t    const r = run([[item('hw', 10), scored(3)], [item('hw', 10), scored(7)]], [cat('hw', 100, 5)]);\n101\t    expect(r.categories[0].droppedItemIds).toHaveLength(1);\n102\t    expect(r.percent).toBe('70.0');\n103\t  });\n104\t\n105\t  it('AC-5: missing past due counts as 0; excused and ungraded do not count', () => {\n106\t    const r = run([\n107\t      [item(null, 10), scored(10)],\n108\t      [item(null, 10), scored(null, { missing: true })],\n109\t      [item(null, 10), scored(8, { excused: true })],\n110\t      [item(null, 10), scored(null)],\n111\t    ]);\n112\t    expect(r.percent).toBe('50.0');\n113\t  });\n114\t\n115\t  it('missing before the due date (or with no due date) does not count; boundary is strict', () => {\n116\t    const future = item(null, 10, { dueAt: FUTURE });\n117\t    const noDue = item(null, 10, { dueAt: null });\n118\t    const exact = item(null, 10, { dueAt: NOW });\n119\t    const m = scored(null, { missing: true });\n120\t    expect(counted(future, m, NOW)).toBe(false);\n121\t    expect(counted(noDue, m, NOW)).toBe(false);\n122\t    expect(counted(exact, m, NOW)).toBe(false);\n123\t    expect(counted(exact, m, new Date(NOW.getTime() + 1))).toBe(true);\n124\t  });\n125\t\n126\t  it('hidden items do not count', () => {\n127\t    const r = run([[item(null, 10), scored(10)], [item(null, 10, { isVisible: false }), scored(0)]]);\n128\t    expect(r.percent).toBe('100.0');\n129\t  });\n130\t\n131\t  it('rounds once at the end: 89.95 → 90.0 → A- (A3); 77.0 → C+; 76.95 → 77.0 → C+', () => {\n132\t    expect(run([[item(null, 200), scored('179.90')]])).toMatchObject({ percent: '90.0', letter: 'A-' });\n133\t    expect(run([[item(null, 100), scored(77)]])).toMatchObject({ percent: '77.0', letter: 'C+' });\n134\t    expect(run([[item(null, 2000), scored('1539.00')]])).toMatchObject({ percent: '77.0', letter: 'C+' });\n135\t    expect(run([[item(null, 100), scored('76.94')]])).toMatchObject({ percent: '76.9', letter: 'C' });\n136\t  });\n137\t\n138\t  it('weighted mean uses unrounded category percents', () => {\n139\t    // hw 1/3 = 33.333…, ex 2/3 = 66.666…; 50/50 → exactly 50.0 (rounding categories first would also give 50.0,\n140\t    // so use 1/3 vs 1/6: 33.333 * .5 + 16.667 * .5 = 25.0)\n141\t    const r = run([[item('hw', 3), scored(1)], [item('ex', 6), scored(1)]], [cat('hw', 50), cat('ex', 50, 0, 1)]);\n142\t    expect(r.percent).toBe('25.0');\n143\t  });\n144\t\n145\t  it('AC-6: letter-only override keeps the computed percent', () => {\n146\t    const r = run([[item(null, 100), scored(78)]], [], { percent: null, letter: 'B', teacherComment: null });\n147\t    expect(r).toMatchObject({ percent: '78.0', letter: 'B', computedLetter: 'C+', overridden: true, descriptor: 'B desc' });\n148\t  });\n149\t\n150\t  it('A12: percent-only override re-derives the letter; both set use both; comment-only is not an override', () => {\n151\t    expect(run([[item(null, 100), scored(78)]], [], { percent: '91', letter: null, teacherComment: null })).toMatchObject({ percent: '91.0', letter: 'A-', computedPercent: '78.0' });\n152\t    expect(run([[item(null, 100), scored(78)]], [], { percent: '91', letter: 'B', teacherComment: null })).toMatchObject({ percent: '91.0', letter: 'B' });\n153\t    const c = run([[item(null, 100), scored(78)]], [], { percent: null, letter: null, teacherComment: 'Good' });\n154\t    expect(c).toMatchObject({ overridden: false, letter: 'C+', override: { teacherComment: 'Good' } });\n155\t  });\n156\t});\n157\t\n158\tdescribe('helpers', () => {\n159\t  it('letterFor / roundHalfUp1 / applyOverride', () => {\n160\t    expect(letterFor('92.99', BANDS)?.letter).toBe('A-');\n161\t    expect(letterFor('0', BANDS)?.letter).toBe('F');\n162\t    expect(letterFor(null, BANDS)).toBeNull();\n163\t    expect(roundHalfUp1('0.05').toFixed(1)).toBe('0.1');\n164\t    expect(applyOverride({ percent: null, letter: null }, null, BANDS).overridden).toBe(false);\n165\t  });\n166\t\n167\t  it('gradeColour bands (FR-26)', () => {\n168\t    expect(gradeColour('80.0')).toBe('success');\n169\t    expect(gradeColour('79.9')).toBe('warning');\n170\t    expect(gradeColour('60.0')).toBe('warning');\n171\t    expect(gradeColour('59.9')).toBe('error');\n172\t    expect(gradeColour(null)).toBeNull();\n173\t  });\n174\t\n175\t  it('isUngradedPastDue (FR-29 warning)', () => {\n176\t    const i = item(null, 10);\n177\t    expect(isUngradedPastDue(i, undefined, NOW)).toBe(true);\n178\t    expect(isUngradedPastDue(i, scored(null, { missing: true }), NOW)).toBe(false);\n179\t    expect(isUngradedPastDue(i, scored(null, { excused: true }), NOW)).toBe(false);\n180\t    expect(isUngradedPastDue(i, scored(5), NOW)).toBe(false);\n181\t    expect(isUngradedPastDue(item(null, 10, { dueAt: FUTURE }), undefined, NOW)).toBe(false);\n182\t  });\n183\t});\n184\t"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"631fbb68-15f8-463b-9b5c-d8cfc59dcd35","timestamp":"2026-11-09T14:01:48.434Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/tests/unit/gradebook/grade-calc.test.ts","content":"import { describe, expect, it } from 'vitest';\nimport {\n  applyOverride,\n  computeStudentTerm,\n  counted,\n  gradeColour,\n  isUngradedPastDue,\n  letterFor,\n  roundHalfUp1,\n  type CalcCategory,\n  type CalcGrade,\n  type CalcItem,\n} from '@/server/gradebook/grade-calc';\n\n/** PRD-11 seed scale (Seed Data). */\nconst BANDS = [\n  ['A', 93], ['A-', 90], ['B+', 87], ['B', 83], ['B-', 80], ['C+', 77],\n  ['C', 73], ['C-', 70], ['D+', 67], ['D', 63], ['D-', 60], ['F', 0],\n].map(([letter, minPercent]) => ({ letter: letter as string, minPercent: minPercent as number, descriptor: `${letter} desc` }));\n\nconst NOW = new Date('2026-11-01T12:00:00Z');\nconst PAST = new Date('2026-10-01T12:00:00Z');\nconst FUTURE = new Date('2026-12-01T12:00:00Z');\n\nlet n = 0;\nconst item = (categoryId: string | null, maxPoints: number | string, extra: Partial<CalcItem> = {}): CalcItem => ({\n  id: `i${++n}`,\n  categoryId,\n  maxPoints,\n  dueAt: PAST,\n  isVisible: true,\n  ...extra,\n});\nconst cat = (id: string, weightPercent: number, dropLowest = 0, order = 0): CalcCategory => ({ id, name: id, weightPercent, dropLowest, order });\nconst scored = (score: number | string | null, extra: Partial<CalcGrade> = {}): CalcGrade => ({ score, excused: false, missing: false, ...extra });\n\nfunction run(pairs: [CalcItem, CalcGrade | undefined][], categories: CalcCategory[] = [], override: Parameters<typeof computeStudentTerm>[0]['override'] = null) {\n  const grades = new Map<string, CalcGrade>();\n  for (const [i, g] of pairs) if (g) grades.set(i.id, g);\n  return computeStudentTerm({ items: pairs.map(([i]) => i), grades, categories, bands: BANDS, override, now: NOW });\n}\n\ndescribe('computeStudentTerm', () => {\n  it('FR-15 golden: Homework 40 % (18/20, 9/10) + Exams 60 % (70/100) = 78.0 % C+ (AC-1)', () => {\n    const r = run(\n      [\n        [item('hw', 20), scored(18)],\n        [item('hw', 10), scored(9)],\n        [item('ex', 100), scored(70)],\n      ],\n      [cat('hw', 40, 0, 0), cat('ex', 60, 0, 1)],\n    );\n    expect(r.categories.map((c) => [c.id, c.percent, c.earned, c.possible])).toEqual([\n      ['hw', '90.0', '27.00', '30.00'],\n      ['ex', '70.0', '70.00', '100.00'],\n    ]);\n    expect(r).toMatchObject({ percent: '78.0', letter: 'C+', computedPercent: '78.0', computedLetter: 'C+', overridden: false, descriptor: 'C+ desc' });\n  });\n\n  it('no categories → points total', () => {\n    const r = run([[item(null, 20), scored(10)], [item(null, 80), scored(70)]]);\n    expect(r.percent).toBe('80.0');\n    expect(r.categories).toEqual([expect.objectContaining({ id: null, name: 'Uncategorised', weightPercent: '100.00', percent: '80.0' })]);\n  });\n\n  it('empty categories are skipped and weights re-normalised', () => {\n    const r = run([[item('hw', 10), scored(5)]], [cat('hw', 30), cat('ex', 70, 0, 1)]);\n    expect(r.percent).toBe('50.0');\n    expect(r.categories.find((c) => c.id === 'ex')?.percent).toBeNull();\n  });\n\n  it('nothing counted → percent and letter null', () => {\n    const r = run([[item('hw', 10), undefined], [item('hw', 10), scored(null)]], [cat('hw', 100)]);\n    expect(r).toMatchObject({ percent: null, letter: null, computedPercent: null });\n  });\n\n  it('A8: Uncategorised has weight 0 when the course has categories; falls back to points when no category counts', () => {\n    const weighted = run([[item('hw', 10), scored(10)], [item(null, 10), scored(0)]], [cat('hw', 100)]);\n    expect(weighted.percent).toBe('100.0');\n    expect(weighted.categories.at(-1)).toMatchObject({ id: null, weightPercent: '0.00', percent: '0.0' });\n\n    const fallback = run([[item(null, 10), scored(4)]], [cat('hw', 100)]);\n    expect(fallback.percent).toBe('40.0');\n  });\n\n  it('AC-2: dropLowest 1 removes the 50 % score', () => {\n    const low = item('hw', 10);\n    const r = run(\n      [\n        [low, scored(5)],\n        [item('hw', 10), scored(9)],\n        [item('hw', 10), scored(10)],\n      ],\n      [cat('hw', 100, 1)],\n    );\n    expect(r.categories[0]).toMatchObject({ percent: '95.0', droppedItemIds: [low.id] });\n  });\n\n  it('never drops every counted item', () => {\n    const r = run([[item('hw', 10), scored(3)], [item('hw', 10), scored(7)]], [cat('hw', 100, 5)]);\n    expect(r.categories[0].droppedItemIds).toHaveLength(1);\n    expect(r.percent).toBe('70.0');\n  });\n\n  it('AC-5: missing past due counts as 0; excused and ungraded do not count', () => {\n    const r = run([\n      [item(null, 10), scored(10)],\n      [item(null, 10), scored(null, { missing: true })],\n      [item(null, 10), scored(8, { excused: true })],\n      [item(null, 10), scored(null)],\n    ]);\n    expect(r.percent).toBe('50.0');\n  });\n\n  it('missing before the due date (or with no due date) does not count; boundary is strict', () => {\n    const future = item(null, 10, { dueAt: FUTURE });\n    const noDue = item(null, 10, { dueAt: null });\n    const exact = item(null, 10, { dueAt: NOW });\n    const m = scored(null, { missing: true });\n    expect(counted(future, m, NOW)).toBe(false);\n    expect(counted(noDue, m, NOW)).toBe(false);\n    expect(counted(exact, m, NOW)).toBe(false);\n    expect(counted(exact, m, new Date(NOW.getTime() + 1))).toBe(true);\n  });\n\n  it('hidden items do not count', () => {\n    const r = run([[item(null, 10), scored(10)], [item(null, 10, { isVisible: false }), scored(0)]]);\n    expect(r.percent).toBe('100.0');\n  });\n\n  it('rounds once at the end: 89.95 → 90.0 → A- (A3); 77.0 → C+; 76.95 → 77.0 → C+', () => {\n    expect(run([[item(null, 200), scored('179.90')]])).toMatchObject({ percent: '90.0', letter: 'A-' });\n    expect(run([[item(null, 100), scored(77)]])).toMatchObject({ percent: '77.0', letter: 'C+' });\n    expect(run([[item(null, 2000), scored('1539.00')]])).toMatchObject({ percent: '77.0', letter: 'C+' });\n    expect(run([[item(null, 100), scored('76.94')]])).toMatchObject({ percent: '76.9', letter: 'C' });\n  });\n\n  it('weighted mean uses unrounded category percents', () => {\n    // hw 1/3 = 33.333…, ex 2/3 = 66.666…; 50/50 → exactly 50.0 (rounding categories first would also give 50.0,\n    // so use 1/3 vs 1/6: 33.333 * .5 + 16.667 * .5 = 25.0)\n    const r = run([[item('hw', 3), scored(1)], [item('ex', 6), scored(1)]], [cat('hw', 50), cat('ex', 50, 0, 1)]);\n    expect(r.percent).toBe('25.0');\n  });\n\n  it('AC-6: letter-only override keeps the computed percent', () => {\n    const r = run([[item(null, 100), scored(78)]], [], { percent: null, letter: 'B', teacherComment: null });\n    expect(r).toMatchObject({ percent: '78.0', letter: 'B', computedLetter: 'C+', overridden: true, descriptor: 'B desc' });\n  });\n\n  it('A12: percent-only override re-derives the letter; both set use both; comment-only is not an override', () => {\n    expect(run([[item(null, 100), scored(78)]], [], { percent: '91', letter: null, teacherComment: null })).toMatchObject({ percent: '91.0', letter: 'A-', computedPercent: '78.0' });\n    expect(run([[item(null, 100), scored(78)]], [], { percent: '91', letter: 'B', teacherComment: null })).toMatchObject({ percent: '91.0', letter: 'B' });\n    const c = run([[item(null, 100), scored(78)]], [], { percent: null, letter: null, teacherComment: 'Good' });\n    expect(c).toMatchObject({ overridden: false, letter: 'C+', override: { teacherComment: 'Good' } });\n  });\n});\n\ndescribe('helpers', () => {\n  it('letterFor / roundHalfUp1 / applyOverride', () => {\n    expect(letterFor('92.99', BANDS)?.letter).toBe('A-');\n    expect(letterFor('0', BANDS)?.letter).toBe('F');\n    expect(letterFor(null, BANDS)).toBeNull();\n    expect(roundHalfUp1('0.05').toFixed(1)).toBe('0.1');\n    expect(applyOverride({ percent: null, letter: null }, null, BANDS).overridden).toBe(false);\n  });\n\n  it('gradeColour bands (FR-26)', () => {\n    expect(gradeColour('80.0')).toBe('success');\n    expect(gradeColour('79.9')).toBe('warning');\n    expect(gradeColour('60.0')).toBe('warning');\n    expect(gradeColour('59.9')).toBe('error');\n    expect(gradeColour(null)).toBeNull();\n  });\n\n  it('isUngradedPastDue (FR-29 warning)', () => {\n    const i = item(null, 10);\n    expect(isUngradedPastDue(i, undefined, NOW)).toBe(true);\n    expect(isUngradedPastDue(i, scored(null, { missing: true }), NOW)).toBe(false);\n    expect(isUngradedPastDue(i, scored(null, { excused: true }), NOW)).toBe(false);\n    expect(isUngradedPastDue(i, scored(5), NOW)).toBe(false);\n    expect(isUngradedPastDue(item(null, 10, { dueAt: FUTURE }), undefined, NOW)).toBe(false);\n  });\n});\n","numLines":184,"startLine":1,"totalLines":184}},"tool_result_meta":[{"id":"toolu_012Wdi9GZdRzCHJ1rY33jxMs","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
