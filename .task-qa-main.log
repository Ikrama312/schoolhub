{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019B8s5QEFN7VXDSrRnzhmRx","type":"tool_result","content":"import { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { notify } from '@/server/notifications/notify';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { getSchoolTimezone, visibleWhere } from './assignments-service';\n\n/**\n * FR-43 / FR-45 / FR-60 maintenance pass, run on every dispatcher request (system-design §2.3).\n * Idempotent through the AssignmentReminder unique key: insert per (assignment, student, kind)\n * and notify only when the insert succeeded, so concurrent dispatchers send once.\n */\n\nconst HOUR = 3_600_000;\n// ponytail: missing pass only looks back 8 days; widen or add a cursor if the dispatcher can be down longer.\nconst MISSING_LOOKBACK_MS = 8 * 24 * HOUR;\n\ntype Kind = 'due_soon' | 'missing';\n\n/** ACTIVE enrollees with no submission and no exemption, for assignments in the window. */\nasync function candidates(dueAt: Prisma.DateTimeFilter, now: Date) {\n  const assignments = await prisma.assignment.findMany({\n    where: { AND: [visibleWhere(now), { dueAt, submissionType: { not: 'NO_SUBMISSION' } }] },\n    select: {\n      id: true,\n      title: true,\n      dueAt: true,\n      courseId: true,\n      course: { select: { name: true, enrollments: { where: { status: 'ACTIVE' }, select: { studentId: true } } } },\n      submissions: { select: { studentId: true } },\n      exemptions: { select: { studentId: true } },\n    },\n  });\n  return assignments.map((a) => {\n    const done = new Set([...a.submissions, ...a.exemptions].map((r) => r.studentId));\n    return { a, studentIds: a.course.enrollments.map((e) => e.studentId).filter((id) => !done.has(id)) };\n  });\n}\n\n/** True only for the caller that inserted the row. P2003 = the assignment was hard-deleted mid-pass: skip it. */\nasync function claim(assignmentId: string, studentId: string, kind: Kind): Promise<boolean> {\n  try {\n    await prisma.assignmentReminder.create({ data: { assignmentId, studentId, kind } });\n    return true;\n  } catch (error) {\n    if (error instanceof Prisma.PrismaClientKnownRequestError && ['P2002', 'P2003'].includes(error.code)) return false;\n    throw error;\n  }\n}\n\nexport async function sendDueReminders(now = new Date()): Promise<{ dueSoon: number; missing: number }> {\n  const tz = await getSchoolTimezone();\n  let dueSoon = 0;\n  let missing = 0;\n\n  for (const { a, studentIds } of await candidates({ gt: now, lte: new Date(now.getTime() + 24 * HOUR) }, now)) {\n    for (const studentId of studentIds) {\n      if (!(await claim(a.id, studentId, 'due_soon'))) continue;\n      dueSoon++;\n      await notify({\n        type: 'assignment.due_soon',\n        userIds: [studentId],\n        title: `Due soon: ${a.title}`,\n        body: `${a.course.name} — due ${formatInSchoolTz(a.dueAt, 'EEE d MMM, HH:mm', tz)}`,\n        link: `/courses/${a.courseId}/assignments/${a.id}`,\n      });\n    }\n  }\n\n  const missingWindow = { gte: new Date(now.getTime() - MISSING_LOOKBACK_MS), lte: new Date(now.getTime() - 24 * HOUR) };\n  for (const { a, studentIds } of await candidates(missingWindow, now)) {\n    if (studentIds.length === 0) continue;\n    const [students, links] = await Promise.all([\n      prisma.user.findMany({ where: { id: { in: studentIds } }, select: { id: true, firstName: true, lastName: true } }),\n      prisma.parentStudentLink.findMany({ where: { studentId: { in: studentIds } }, select: { studentId: true, parentId: true } }),\n    ]);\n    for (const student of students) {\n      if (!(await claim(a.id, student.id, 'missing'))) continue;\n      missing++;\n      const parents = links.filter((l) => l.studentId === student.id).map((l) => l.parentId);\n      // Parents only (FR-45); email defaults on for this type.\n      await notify({\n        type: 'assignment.missing',\n        userIds: parents,\n        title: `Missing assignment: ${a.title}`,\n        body: `${student.firstName} ${student.lastName} has not submitted \"${a.title}\" (${a.course.name}), due ${formatInSchoolTz(a.dueAt, 'EEE d MMM, HH:mm', tz)}.`,\n        link: `/assignments?studentId=${student.id}`,\n        email: { template: 'generic-notification' },\n      });\n    }\n  }\n  return { dueSoon, missing };\n}\n== src/app/api/assignments/[id]/route.ts\nimport { ok, parseBody, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { deleteOrArchiveAssignment, getAssignment, updateAssignment } from '@/server/assignments/assignments-service';\nimport { assignmentPatch, studentQuery } from '@/lib/validators/assignments';\n\ntype Ctx = { params: { id: string } };\n\n/** GET /api/assignments/:id (FR-50) · PATCH / DELETE (FR-51). Course access is checked in the service. */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const { studentId } = parseQuery(new URL(request.url).searchParams, studentQuery);\n  return ok(await getAssignment(user, params.id, studentId));\n});\n\nexport const PATCH = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const patch = await parseBody(request, assignmentPatch);\n  return ok(await updateAssignment(user, params.id, patch, request));\n});\n\nexport const DELETE = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  return ok(await deleteOrArchiveAssignment(user, params.id, request));\n});\n== src/app/api/assignments/[id]/submissions/route.ts\nimport { ok, paginated, parseBody, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole, requireUser } from '@/server/auth/requireRole';\nimport { listGradingRoster, submit } from '@/server/assignments/assignments-service';\nimport { rosterQuery, submissionInput } from '@/lib/validators/assignments';\n\ntype Ctx = { params: { id: string } };\n\n/** GET /api/assignments/:id/submissions — grading roster (FR-54). assertCanManageCourse in the service. */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const searchParams = new URL(request.url).searchParams;\n  if (!searchParams.has('pageSize')) searchParams.set('pageSize', '100');\n  const page = parsePagination(searchParams);\n  const query = parseQuery(searchParams, rosterQuery);\n  const { items, total } = await listGradingRoster(user, params.id, query, page);\n  return paginated(items, { page: page.page, pageSize: page.pageSize, total });\n});\n\n/** POST /api/assignments/:id/submissions — submit or resubmit (FR-53). 201 first time, 200 on resubmit. */\nexport const POST = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireRole('STUDENT');\n  const input = await parseBody(request, submissionInput);\n  const { submission, created } = await submit(user, params.id, input);\n  return ok(submission, { status: created ? 201 : 200 });\n});\n== src/app/api/me/assignments/route.ts\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { listMyAssignments } from '@/server/assignments/assignments-service';\nimport { meAssignmentsQuery } from '@/lib/validators/assignments';\n\nexport const dynamic = 'force-dynamic';\n\n/** GET /api/me/assignments — student/parent rows or the teacher/admin \"To grade\" list (FR-57). */\nexport const GET = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  const query = parseQuery(new URL(request.url).searchParams, meAssignmentsQuery);\n  return ok(await listMyAssignments(user, query));\n});\n== src/app/api/submissions/[id]/grade/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { gradeSubmission } from '@/server/assignments/assignments-service';\nimport { gradeInput } from '@/lib/validators/assignments';\n\n/** PUT /api/submissions/:id/grade — Save, or Save & return with return:true (FR-56, D6). */\nexport const PUT = withHandler(async (request: Request, { params }: { params: { id: string } }) => {\n  const user = await requireUser();\n  const input = await parseBody(request, gradeInput);\n  return ok(await gradeSubmission(user, params.id, input, request));\n});\nsrc/app/api/internal/email/dispatch/route.ts:8:import { sendDueReminders } from '@/server/assignments/reminders';\nsrc/app/api/internal/email/dispatch/route.ts:30:  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\nsrc/app/api/internal/email/dispatch/route.ts:33:    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\nsrc/app/api/internal/email/dispatch/route.ts:35:    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\nsrc/server/files/contexts.ts:4:import { isAssignmentVisible } from '@/server/assignments/assignments-service';\nsrc/server/files/contexts.ts:34:/** 'assignment' (PRD-09 FR-47): the caller can view the course and (unless they manage it) the assignment is visible. */\nsrc/server/files/contexts.ts:35:export const assignmentResolver: FileAccessResolver = async (user, file) => {\nsrc/server/files/contexts.ts:37:  const a = await prisma.assignment.findUnique({\nsrc/server/files/contexts.ts:47:  return canSeeDrafts(user, a.course) || isAssignmentVisible(a, new Date());\nsrc/server/files/contexts.ts:51: * 'submission' (PRD-09 FR-47, NFR-4): the submitting student, their linked parents, or a course\nsrc/server/files/contexts.ts:54:export const submissionResolver: FileAccessResolver = async (user, file) => {\nsrc/server/files/contexts.ts:56:  const sub = await prisma.submission.findUnique({\nsrc/server/files/contexts.ts:58:    select: { studentId: true, assignment: { select: { course: { select: { teacherId: true, coTeacherIds: true } } } } },\nsrc/server/files/contexts.ts:62:  if (canSeeDrafts(user, sub.assignment.course)) return true;\nsrc/server/files/contexts.ts:74:  register('assignment', assignmentResolver);\nsrc/server/files/contexts.ts:75:  register('submission', submissionResolver);","is_error":false}]},"parent_tool_use_id":null,"session_id":"e675b554-96f9-4967-b795-466c40a9a33c","uuid":"dfdedbc8-ef3f-41d0-ad2b-d2a710e4346a","timestamp":"2026-11-09T06:08:11.131Z","tool_use_result":{"stdout":"import { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { notify } from '@/server/notifications/notify';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { getSchoolTimezone, visibleWhere } from './assignments-service';\n\n/**\n * FR-43 / FR-45 / FR-60 maintenance pass, run on every dispatcher request (system-design §2.3).\n * Idempotent through the AssignmentReminder unique key: insert per (assignment, student, kind)\n * and notify only when the insert succeeded, so concurrent dispatchers send once.\n */\n\nconst HOUR = 3_600_000;\n// ponytail: missing pass only looks back 8 days; widen or add a cursor if the dispatcher can be down longer.\nconst MISSING_LOOKBACK_MS = 8 * 24 * HOUR;\n\ntype Kind = 'due_soon' | 'missing';\n\n/** ACTIVE enrollees with no submission and no exemption, for assignments in the window. */\nasync function candidates(dueAt: Prisma.DateTimeFilter, now: Date) {\n  const assignments = await prisma.assignment.findMany({\n    where: { AND: [visibleWhere(now), { dueAt, submissionType: { not: 'NO_SUBMISSION' } }] },\n    select: {\n      id: true,\n      title: true,\n      dueAt: true,\n      courseId: true,\n      course: { select: { name: true, enrollments: { where: { status: 'ACTIVE' }, select: { studentId: true } } } },\n      submissions: { select: { studentId: true } },\n      exemptions: { select: { studentId: true } },\n    },\n  });\n  return assignments.map((a) => {\n    const done = new Set([...a.submissions, ...a.exemptions].map((r) => r.studentId));\n    return { a, studentIds: a.course.enrollments.map((e) => e.studentId).filter((id) => !done.has(id)) };\n  });\n}\n\n/** True only for the caller that inserted the row. P2003 = the assignment was hard-deleted mid-pass: skip it. */\nasync function claim(assignmentId: string, studentId: string, kind: Kind): Promise<boolean> {\n  try {\n    await prisma.assignmentReminder.create({ data: { assignmentId, studentId, kind } });\n    return true;\n  } catch (error) {\n    if (error instanceof Prisma.PrismaClientKnownRequestError && ['P2002', 'P2003'].includes(error.code)) return false;\n    throw error;\n  }\n}\n\nexport async function sendDueReminders(now = new Date()): Promise<{ dueSoon: number; missing: number }> {\n  const tz = await getSchoolTimezone();\n  let dueSoon = 0;\n  let missing = 0;\n\n  for (const { a, studentIds } of await candidates({ gt: now, lte: new Date(now.getTime() + 24 * HOUR) }, now)) {\n    for (const studentId of studentIds) {\n      if (!(await claim(a.id, studentId, 'due_soon'))) continue;\n      dueSoon++;\n      await notify({\n        type: 'assignment.due_soon',\n        userIds: [studentId],\n        title: `Due soon: ${a.title}`,\n        body: `${a.course.name} — due ${formatInSchoolTz(a.dueAt, 'EEE d MMM, HH:mm', tz)}`,\n        link: `/courses/${a.courseId}/assignments/${a.id}`,\n      });\n    }\n  }\n\n  const missingWindow = { gte: new Date(now.getTime() - MISSING_LOOKBACK_MS), lte: new Date(now.getTime() - 24 * HOUR) };\n  for (const { a, studentIds } of await candidates(missingWindow, now)) {\n    if (studentIds.length === 0) continue;\n    const [students, links] = await Promise.all([\n      prisma.user.findMany({ where: { id: { in: studentIds } }, select: { id: true, firstName: true, lastName: true } }),\n      prisma.parentStudentLink.findMany({ where: { studentId: { in: studentIds } }, select: { studentId: true, parentId: true } }),\n    ]);\n    for (const student of students) {\n      if (!(await claim(a.id, student.id, 'missing'))) continue;\n      missing++;\n      const parents = links.filter((l) => l.studentId === student.id).map((l) => l.parentId);\n      // Parents only (FR-45); email defaults on for this type.\n      await notify({\n        type: 'assignment.missing',\n        userIds: parents,\n        title: `Missing assignment: ${a.title}`,\n        body: `${student.firstName} ${student.lastName} has not submitted \"${a.title}\" (${a.course.name}), due ${formatInSchoolTz(a.dueAt, 'EEE d MMM, HH:mm', tz)}.`,\n        link: `/assignments?studentId=${student.id}`,\n        email: { template: 'generic-notification' },\n      });\n    }\n  }\n  return { dueSoon, missing };\n}\n== src/app/api/assignments/[id]/route.ts\nimport { ok, parseBody, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { deleteOrArchiveAssignment, getAssignment, updateAssignment } from '@/server/assignments/assignments-service';\nimport { assignmentPatch, studentQuery } from '@/lib/validators/assignments';\n\ntype Ctx = { params: { id: string } };\n\n/** GET /api/assignments/:id (FR-50) · PATCH / DELETE (FR-51). Course access is checked in the service. */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const { studentId } = parseQuery(new URL(request.url).searchParams, studentQuery);\n  return ok(await getAssignment(user, params.id, studentId));\n});\n\nexport const PATCH = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const patch = await parseBody(request, assignmentPatch);\n  return ok(await updateAssignment(user, params.id, patch, request));\n});\n\nexport const DELETE = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  return ok(await deleteOrArchiveAssignment(user, params.id, request));\n});\n== src/app/api/assignments/[id]/submissions/route.ts\nimport { ok, paginated, parseBody, parsePagination, parseQuery, withHandler } from '@/server/http';\nimport { requireRole, requireUser } from '@/server/auth/requireRole';\nimport { listGradingRoster, submit } from '@/server/assignments/assignments-service';\nimport { rosterQuery, submissionInput } from '@/lib/validators/assignments';\n\ntype Ctx = { params: { id: string } };\n\n/** GET /api/assignments/:id/submissions — grading roster (FR-54). assertCanManageCourse in the service. */\nexport const GET = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireUser();\n  const searchParams = new URL(request.url).searchParams;\n  if (!searchParams.has('pageSize')) searchParams.set('pageSize', '100');\n  const page = parsePagination(searchParams);\n  const query = parseQuery(searchParams, rosterQuery);\n  const { items, total } = await listGradingRoster(user, params.id, query, page);\n  return paginated(items, { page: page.page, pageSize: page.pageSize, total });\n});\n\n/** POST /api/assignments/:id/submissions — submit or resubmit (FR-53). 201 first time, 200 on resubmit. */\nexport const POST = withHandler(async (request: Request, { params }: Ctx) => {\n  const user = await requireRole('STUDENT');\n  const input = await parseBody(request, submissionInput);\n  const { submission, created } = await submit(user, params.id, input);\n  return ok(submission, { status: created ? 201 : 200 });\n});\n== src/app/api/me/assignments/route.ts\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { listMyAssignments } from '@/server/assignments/assignments-service';\nimport { meAssignmentsQuery } from '@/lib/validators/assignments';\n\nexport const dynamic = 'force-dynamic';\n\n/** GET /api/me/assignments — student/parent rows or the teacher/admin \"To grade\" list (FR-57). */\nexport const