{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019MVkkdiV7huSF7Hserwi4x","type":"tool_result","content":"     1\t// @vitest-environment node\n     2\timport { afterAll, beforeEach, describe, expect, it, vi } from 'vitest';\n     3\t\n     4\t// Point the shared Prisma client and env at the test DB before any app module loads.\n     5\tvi.hoisted(() => {\n     6\t  if (process.env.TEST_DATABASE_URL) process.env.DATABASE_URL = process.env.TEST_DATABASE_URL;\n     7\t  process.env.DATABASE_URL ??= 'postgresql://unused@localhost/unused';\n     8\t  process.env.APP_URL ??= 'http://localhost:3000';\n     9\t  process.env.AUTH_SECRET ??= 'test-secret';\n    10\t});\n    11\t\n    12\t// next-auth's root entry pulls in next/server, which doesn't resolve under vitest.\n    13\tvi.mock('next-auth', () => ({\n    14\t  CredentialsSignin: class CredentialsSignin extends Error {\n    15\t    code = 'credentials';\n    16\t  },\n    17\t}));\n    18\t\n    19\timport bcrypt from 'bcrypt';\n    20\timport { prisma } from '@/server/db';\n    21\timport { __resetRateLimits } from '@/server/rate-limit';\n    22\timport { authorizeCredentials } from '@/server/auth/credentials';\n    23\timport { createToken, hashToken } from '@/server/auth/tokens';\n    24\timport { acceptInvite, changePassword, requestPasswordReset, resetPassword } from '@/server/services/auth';\n    25\t\n    26\tconst MARK = '@auth-it.test';\n    27\tconst PASSWORD = 'Correct-horse-42';\n    28\tconst NEW_PASSWORD = 'Brand-new-pass-77';\n    29\tconst secrets: string[] = [PASSWORD, NEW_PASSWORD];\n    30\t\n    31\tlet ipSeq = 0;\n    32\t/** A fresh IP per call keeps the per-IP limiter out of tests that aren't about it. */\n    33\tconst req = (ip = `10.0.0.${++ipSeq}`) => new Request('http://localhost/api', { headers: { 'x-forwarded-for': ip } });\n    34\t\n    35\tasync function makeUser(\n    36\t  local: string,\n    37\t  data: Partial<{ status: 'ACTIVE' | 'INVITED' | 'DISABLED'; archivedAt: Date; lockedUntil: Date; passwordHash: string | null }> = {},\n    38\t) {\n    39\t  return prisma.user.create({\n    40\t    data: {\n    41\t      email: `${local}${MARK}`,\n    42\t      firstName: 'Auth',\n    43\t      lastName: 'Test',\n    44\t      role: 'STUDENT',\n    45\t      status: 'ACTIVE',\n    46\t      passwordHash: await bcrypt.hash(PASSWORD, 4),\n    47\t      ...data,\n    48\t    },\n    49\t  });\n    50\t}\n    51\t\n    52\t/** Resolves to the thrown error's code, or 'ok'. */\n    53\tasync function loginCode(email: string, password: string, request = req()): Promise<string> {\n    54\t  try {\n    55\t    await authorizeCredentials({ email, password }, request);\n    56\t    return 'ok';\n    57\t  } catch (error) {\n    58\t    return (error as { code: string }).code;\n    59\t  }\n    60\t}\n    61\t\n    62\tdescribe.runIf(process.env.TEST_DATABASE_URL)('auth services (integration)', () => {\n    63\t  const cleanup = async () => {\n    64\t    const users = await prisma.user.findMany({ where: { email: { endsWith: MARK } }, select: { id: true } });\n    65\t    const ids = users.map((u) => u.id);\n    66\t    await prisma.auditLog.deleteMany({ where: { OR: [{ actorId: { in: ids } }, { entityId: { in: ids } }] } });\n    67\t    await prisma.authToken.deleteMany({ where: { userId: { in: ids } } });\n    68\t    await prisma.emailOutbox.deleteMany({ where: { toEmail: { endsWith: MARK } } });\n    69\t    await prisma.user.deleteMany({ where: { id: { in: ids } } });\n    70\t  };\n2:import { afterAll, beforeEach, describe, expect, it, vi } from 'vitest';\n62:describe.runIf(process.env.TEST_DATABASE_URL)('auth services (integration)', () => {\n82:  describe('authorizeCredentials', () => {\n83:    it('rejects unknown email and wrong password with the same code', async () => {\n89:    it('rejects DISABLED, archived and locked accounts', async () => {\n98:    it('locks on the 5th failure and audits auth.lockout', async () => {\n109: 