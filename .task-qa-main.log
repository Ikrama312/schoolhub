{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012X9tAeavhBruxB1v65tywo","type":"tool_result","content":"     1\t'use client';\n     2\t\n     3\timport { useEffect, useRef, useState } from 'react';\n     4\timport NextLink from 'next/link';\n     5\timport { useRouter } from 'next/navigation';\n     6\timport { signIn } from 'next-auth/react';\n     7\timport { useForm } from 'react-hook-form';\n     8\timport { zodResolver } from '@hookform/resolvers/zod';\n     9\timport Box from '@mui/material/Box';\n    10\timport Stack from '@mui/material/Stack';\n    11\timport Typography from '@mui/material/Typography';\n    12\timport Button from '@mui/material/Button';\n    13\timport Alert from '@mui/material/Alert';\n    14\timport Link from '@mui/material/Link';\n    15\timport { TextFormField } from '@/components/FormField/FormField';\n    16\timport { passwordInputSlot } from '@/components/PasswordChecklist';\n    17\timport { useToast } from '@/components/Toast/useToast';\n    18\timport { safeCallbackUrl, signInSchema, type SignInInput } from '@/lib/validators/auth';\n    19\t\n    20\t/** FR-4/FR-6: maps the authorize() error code to user-facing copy. */\n    21\texport function loginErrorMessage(code: string | null | undefined): string {\n    22\t  const locked = code?.match(/^locked:(\\d+)$/);\n    23\t  if (locked) return `This account is temporarily locked. Try again in ${locked[1]} minutes.`;\n    24\t  if (code === 'disabled') return 'This account is disabled. Contact the school office.';\n    25\t  if (code === 'rate_limited') return 'Too many attempts. Wait a few minutes and try again.';\n    26\t  return 'Email or password is incorrect.';\n    27\t}\n    28\t\n    29\texport function LoginForm({ callbackUrl, reset }: { callbackUrl?: string; reset: boolean }) {\n    30\t  const router = useRouter();\n    31\t  const { showToast } = useToast();\n    32\t  const [show, setShow] = useState(false);\n    33\t  const [error, setError] = useState<string | null>(null);\n    34\t  const toasted = useRef(false);\n    35\t  const { control, handleSubmit, formState } = useForm<SignInInput>({\n    36\t    resolver: zodResolver(signInSchema),\n    37\t    defaultValues: { email: '', password: '' },\n    38\t    shouldFocusError: true,\n    39\t  });\n    40\t\n    41\t  useEffect(() => {\n    42\t    if (reset && !toasted.current) {\n    43\t      toasted.current = true;\n    44\t      showToast({ message: 'Password updated. Sign in with your new password.', severity: 'success' });\n    45\t    }\n    46\t  }, [reset, showToast]);\n    47\t\n    48\t  const submit = handleSubmit(async ({ email, password }) => {\n    49\t    setError(null);\n    50\t    const result = await signIn('credentials', { email, password, redirect: false });\n    51\t    // signIn resolves ok:true even on CredentialsSignin; `error` is the failure signal.\n    52\t    if (!result || result.error) {\n    53\t      setError(loginErrorMessage(result?.code));\n    54\t      return;\n    55\t    }\n    56\t    router.replace(safeCallbackUrl(callbackUrl));\n    57\t    router.refresh();\n    58\t  });\n    59\t\n    60\t  return (\n    61\t    <Box component=\"form\" noValidate onSubmit={submit}>\n    62\t      <Stack spacing={2}>\n    63\t        <Typography variant=\"h5\" component=\"h1\">\n    64\t          Sign in\n    65\t        </Typography>\n    66\t        <Box aria-live=\"polite\">{error && <Alert severity=\"error\">{error}</Alert>}</Box>\n    67\t        <TextFormField name=\"email\" control={control} label=\"Email\" type=\"email\" autoComplete=\"email\" required />\n    68\t        <TextFormField\n    69\t          name=\"password\"\n    70\t          control={control}\n    71\t          label=\"Password\"\n    72\t          type={show ? 'text' : 'password'}\n    73\t          autoComplete=\"current-password\"\n    74\t          required\n    75\t          slotProps={passwordInputSlot(show, () => setShow((s) => !s))}\n    76\t        />\n    77\t        <Button type=\"submit\" variant=\"contained\" size=\"large\" disabled={formState.isSubmitting}>\n    78\t          Sign in\n    79\t        </Button>\n    80\t        <Link component={NextLink} href=\"/forgot-password\" variant=\"body2\" sx={{ alignSelf: 'center' }}>\n    81\t          Forgot your password?\n    82\t        </Link>\n    83\t      </Stack>\n    84\t    </Box>\n    85\t  );\n    86\t}\n    25\timport ChevronLeftIcon from '@mui/icons-material/ChevronLeft';\n    26\timport ChevronRightIcon from '@mui/icons-material/ChevronRight';\n    27\timport LightModeIcon from '@mui/icons-material/LightMode';\n    28\timport DarkModeIcon from '@mui/icons-material/DarkMode';\n    29\timport LockOutlinedIcon from '@mui/icons-material/LockOutlined';\n    30\timport LogoutIcon from '@mui/icons-material/Logout';\n    31\timport { signOut } from 'next-auth/react';\n    32\timport { navigationForRole } from '@/config/navigation';\n    33\timport type { SessionUser } from '@/server/auth/requireRole';\n    34\timport { UserAvatar } from '@/components/UserAvatar/UserAvatar';\n    35\timport { NotificationBell } from '@/components/NotificationBell/NotificationBell';\n    36\t\n    37\tconst DRAWER_WIDTH_EXPANDED = 256;\n    38\tconst DRAWER_WIDTH_COLLAPSED = 64;\n    39\tconst COLLAPSE_STORAGE_KEY = 'schoolhub.sidebar.collapsed';\n    40\t\n    41\texport interface AppShellProps {\n    42\t  user: SessionUser;\n    43\t  schoolShortName: string;\n    44\t  children: React.ReactNode;\n    45\t}\n    46\t\n    47\tconst DESKTOP_BREAKPOINT_PX = 1024;\n    48\t\n    49\texport function AppShell({ user, schoolShortName, children }: AppShellProps) {\n    50\t  const { mode, setMode } = useColorScheme();\n    51\t  const pathname = usePathname();\n    52\t  // FR-31/NFR-4 fix the fork at exactly 1024px — MUI's own \"lg\" breakpoint\n    53\t  // (1200px) doesn't match that, so this uses an explicit media query.\n    54\t  const isDesktop = useMediaQuery(`(