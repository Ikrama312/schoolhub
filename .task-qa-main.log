{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ogetLtBQTLVT9FEnStYB7","type":"tool_result","content":"63\texport async function resolveTerm(terms: Term[], termId: string | undefined) {\n64\t  const today = schoolToday(new Date(), await getSchoolTimezone());\n65\t  const refs = terms.map((t) => toTermRef(t, today));\n66\t  if (termId) {\n67\t    const t = refs.find((r) => r.id === termId);\n68\t    if (!t) throw invalid('That term is not part of this course’s academic year.', { fieldErrors: { termId: ['Unknown term'] } });\n69\t    return { term: t, terms: refs };\n70\t  }\n71\t  const t = refs.find((r) => r.isCurrent) ?? refs[0];\n72\t  if (!t) throw new AppError('NOT_FOUND', 'This course’s academic year has no terms yet.');\n73\t  return { term: t, terms: refs };\n74\t}\n75\t\n76\tasync function loadItem(user: AccessUser, itemId: string) {\n77\t  const item = await prisma.gradeItem.findUnique({ where: { id: itemId } });\n78\t  if (!item) throw new AppError('NOT_FOUND', 'Grade item not found');\n79\t  await assertCanManageCourse(user, item.courseId);\n80\t  return item;\n81\t}\n82\t\n83\tasync function assertEnrolled(courseId: string, studentId: string) {\n84\t  const e = await prisma.enrollment.findFirst({ where: { courseId, studentId, status: 'ACTIVE' }, select: { id: true } });\n85\t  if (!e) throw new AppError('NOT_FOUND', 'Student not found in this course');\n86\t}\n87\t\n88\tasync function assertCategory(courseId: string, categoryId: string | null | undefined) {\n89\t  if (!categoryId) return;\n90\t  const c = await prisma.gradeCategory.findUnique({ where: { id: categoryId }, select: { courseId: true } });\n91\t  if (c?.courseId !== courseId) throw invalid('That category does not belong to this course.', { fieldErrors: { categoryId: ['Unknown category'] } });\n92\t}\n93\t\n94\tasync function assertTerm(courseId: string, termId: string | undefined) {\n95\t  if (!termId) return;\n96\t  const terms = await courseTerms(prisma, courseId);\n97\t  if (!terms.some((t) => t.id === termId)) throw invalid('That term is not part of this course’s academic year.', { fieldErrors: { termId: ['Unknown term'] } });\n98\t}\n99\t\n100\tasync function studentResult(courseId: string, termId: string, studentId: string): Promise<StudentTermResult> {\n101\t  const data = await loadCourseTermData([courseId], termId, [studentId]);\n102\t  return computeCourseResult(data, courseId, studentId, new Date());\n103\t}\n104\t\n105\t/** The attempt whose score the policy uses, for click-through (FR-21). AVERAGE → latest. */\n106\tfunction pickAttempt(policy: ScoringPolicy, attempts: { id: string; score: unknown; maxScore: unknown; submittedAt: Date | null }[]) {\n107\t  if (!attempts.length) return null;\n108\t  if (policy === 'HIGHEST') {\n109\t    return attempts.reduce((a, b) => ((percentOf(String(b.score ?? 0), String(b.maxScore)) ?? 0) > (percentOf(String(a.score ?? 0), String(a.maxScore)) ?? 0) ? b : a)).id;\n110\t  }\n111\t  return attempts.reduce((a, b) => ((b.submittedAt?.getTime() ?? 0) > (a.submittedAt?.getTime() ?? 0) ? b : a)).id;\n112\t}\n113\t\n114\t// ---------------------------------------------------------------------------\n115\t// Read (FR-18, FR-19, FR-21, NFR-2)\n116\t// ---------------------------------------------------------------------------\n117\t\n118\texport async function getGradebook(user: AccessUser, courseId: string, termId?: string) {\n119\t  await assertCanManageCourse(user, courseId);\n120\t  const course = await prisma.course.findUniqueOrThrow({ where: { id: courseId }, select: { id: true, code: true, name: true } });\n121\t  const { term, terms } = await resolveTerm(await courseTerms(prisma, courseId), termId);\n122\t\n123\t  const enrollments = await prisma.enrollment.findMany({\n124\t    where: { courseId, status: 'ACTIVE' },\n125\t    select: { student: { select: { id: true, firstName: true, lastName: true, studentProfile: { select: { admissionNumber: true } } } } },\n126\t    orderBy: [{ student: { lastName: 'asc' } }, { student: { firstName: 'asc' } }],\n127\t  });\n128\t  const students = enrollments.map((e) => e.student);\n129\t  const data = await loadCourseTermData([courseId], term.id, students.map((s) => s.id));\n130\t  const categories = data.categories.get(courseId) ?? [];\n131\t  const order = new Map(categories.map((c) => [c.id, c.order]));\n132\t  const items = [...(data.items.get(courseId) ?? [])].sort(\n133\t    (a, b) =>\n134\t      (order.get(a.categoryId ?? '') ?? Infinity) - (order.get(b.categoryId ?? '') ?? Infinity) ||\n135\t      (a.dueAt?.getTime() ?? Infinity) - (b.dueAt?.getTime() ?? Infinity) ||\n136\t      a.title.localeCompare(b.title),\n137\t  );\n138\t\n139\t  const assignmentIds = items.filter((i) => i.source === 'ASSIGNMENT' && i.sourceId).map((i) => i.sourceId!);\n140\t  const quizIds = items.filter((i) => i.source === 'QUIZ' && i.sourceId).map((i) => i.sourceId!);\n141\t  const [subs, attempts, quizzes] = await Promise.all([\n142\t    assignmentIds.length ? prisma.submission.findMany({ where: { assignmentId: { in: assignmentIds } }, select: { id: true, assignmentId: true, studentId: true, isLate: true } }) : [],\n143\t    quizIds.length\n144\t      ? prisma.quizAttempt.findMany({ where: { quizId: { in: quizIds }, status: 'GRADED' }, select: { id: true, quizId: true, studentId: true, score: true, maxScore: true, submittedAt: true } })\n145\t      : [],\n146\t    quizIds.length ? prisma.quiz.findMany({ where: { id: { in: quizIds } }, select: { id: true, scoringPolicy: true } }) : [],\n147\t  ]);\n148\t  const subBy = new Map(subs.map((s) => [`${s.assignmentId}:${s.studentId}`, s]));\n149\t  const policy = new Map(quizzes.map((q) => [q.id, q.scoringPolicy]));\n150\t  const attemptsBy = new Map<string, typeof attempts>();\n151\t  for (const a of attempts) attemptsBy.set(`${a.quizId}:${a.studentId}`, [...(attemptsBy.get(`${a.quizId}:${a.studentId}`) ?? []), a]);\n152\t\n153\t  const now = new Date();\n154\t  const rows = students.map((s) => {\n155\t    const cells: Record<string, ReturnType<typeof toCell> & { isLate: boolean; submissionId: string | null; attemptId: string | null }> = {};\n156\t    for (const i of items) {\n157\t      const sub = i.source === 'ASSIGNMENT' ? subBy.get(`${i.sourceId}:${s.id}`) : undefined;\n158\t      const atts = i.source === 'QUIZ' ? attemptsBy.get(`${i.sourceId}:${s.id}`) ?? [] : [];\n159\t      cells[i.id] = {\n160\t        ...toCell(i.id, s.id, data.grades.get(i.id)?.get(s.id)),\n161\t        isLate: sub?.isLate ?? false,\n162\t        submissionId: sub?.id ?? null,\n163\t        attemptId: i.source === 'QUIZ' ? pickAttempt(policy.get(i.sourceId!) ?? 'HIGHEST', atts) : null,\n164\t      };\n165\t    }\n166\t    return {\n167\t      student: { id: s.id, firstName: s.firstName, lastName: s.lastName, admissionNumber: s.studentProfile?.admissionNumber ?? null },\n168\t      cells,\n169\t      result: computeCourseResult(data, courseId, s.id, now),\n170\t    };\n171\t  });\n172\t\n173\t  const scale = data.scales.get(courseId);\n174\t  return {\n175\t    course,\n176\t    term,\n177\t    terms,\n178\t    scale: scale ? { id: scale.id, name: scale.name, bands: scale.bands } : null,\n179\t    categories: categories.map(toCategoryDto),\n180\t    items: items.map(toItemDto),\n181\t    rows,\n182\t  };\n183\t}\n184\texport type GradebookPayload = Awaited<ReturnType<typeof getGradebook>>;"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"9ba80519-8675-426a-8095-7205f10b4649","timestamp":"2026-11-09T14:10:41.866Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/gradebook/gradebook-service.ts","content":"export async function resolveTerm(terms: Term[], termId: string | undefined) {\n  const today = schoolToday(new Date(), await getSchoolTimezone());\n  const refs = terms.map((t) => toTermRef(t, today));\n  if (termId) {\n    const t = refs.find((r) => r.id === termId);\n    if (!t) throw invalid('That term is not part of this course’s academic year.', { fieldErrors: { termId: ['Unknown term'] } });\n    return { term: t, terms: refs };\n  }\n  const t = refs.find((r) => r.isCurrent) ?? refs[0];\n  if (!t) throw new AppError('NOT_FOUND', 'This course’s academic year has no terms yet.');\n  return { term: t, terms: refs };\n}\n\nasync function loadItem(user: AccessUser, itemId: string) {\n  const item = await prisma.gradeItem.findUnique({ where: { id: itemId } });\n  if (!item) throw new AppError('NOT_FOUND', 'Grade item not found');\n  await assertCanManageCourse(user, item.courseId);\n  return item;\n}\n\nasync function assertEnrolled(courseId: string, studentId: string) {\n  const e = await prisma.enrollment.findFirst({ where: { courseId, studentId, status: 'ACTIVE' }, select: { id: true } });\n  if (!e) throw new AppError('NOT_FOUND', 'Student not found in this course');\n}\n\nasync function assertCategory(courseId: string, categoryId: string | null | undefined) {\n  if (!categoryId) return;\n  const c = await prisma.gradeCategory.findUnique({ where: { id: categoryId }, select: { courseId: true } });\n  if (c?.courseId !== courseId) throw invalid('That category does not belong to this course.', { fieldErrors: { categoryId: ['Unknown category'] } });\n}\n\nasync function assertTerm(courseId: string, termId: string | undefined) {\n  if (!termId) return;\n  const terms = await courseTerms(prisma, courseId);\n  if (!terms.some((t) => t.id === termId)) throw invalid('That term is not part of this course’s academic year.', { fieldErrors: { termId: ['Unknown term'] } });\n}\n\nasync function studentResult(courseId: string, termId: string, studentId: string): Promise<StudentTermResult> {\n  const data = await loadCourseTermData([courseId], termId, [studentId]);\n  return computeCourseResult(data, courseId, studentId, new Date());\n}\n\n/** The attempt whose score the policy uses, for click-through (FR-21). AVERAGE → latest. */\nfunction pickAttempt(policy: ScoringPolicy, attempts: { id: string; score: unknown; maxScore: unknown; submittedAt: Date | null }[]) {\n  if (!attempts.length) return null;\n  if (policy === 'HIGHEST') {\n    return attempts.reduce((a, b) => ((percentOf(String(b.score ?? 0), String(b.maxScore)) ?? 0) > (percentOf(String(a.score ?? 0), String(a.maxScore)) ?? 0) ? b : a)).id;\n  }\n  return attempts.reduce((a, b) => ((b.submittedAt?.getTime() ?? 0) > (a.submittedAt?.getTime() ?? 0) ? b : a)).id;\n}\n\n// ---------------------------------------------------------------------------\n// Read (FR-18, FR-19, FR-21, NFR-2)\n// ---------------------------------------------------------------------------\n\nexport async function getGradebook(user: AccessUser, courseId: string, termId?: string) {\n  await assertCanManageCourse(user, courseId);\n  const course = await prisma.course.findUniqueOrThrow({ where: { id: courseId }, select: { id: true, code: true, name: true } });\n  const { term, terms } = await resolveTerm(await courseTerms(prisma, courseId), termId);\n\n  const enrollments = await prisma.enrollment.findMany({\n    where: { courseId, status: 'ACTIVE' },\n    select: { student: { select: { id: true, firstName: true, lastName: true, studentProfile: { select: { admissionNumber: true } } } } },\n    orderBy: [{ student: { lastName: 'asc' } }, { student: { firstName: 'asc' } }],\n  });\n  const students = enrollments.map((e) => e.student);\n  const data = await loadCourseTermData([courseId], term.id, students.map((s) => s.id));\n  const categories = data.categories.get(courseId) ?? [];\n  const order = new Map(categories.map((c) => [c.id, c.order]));\n  const items = [...(data.items.get(courseId) ?? [])].sort(\n    (a, b) =>\n      (order.get(a.categoryId ?? '') ?? Infinity) - (order.get(b.categoryId ?? '') ?? Infinity) ||\n      (a.dueAt?.getTime() ?? Infinity) - (b.dueAt?.getTime() ?? Infinity) ||\n      a.title.localeCompare(b.title),\n  );\n\n  const assignmentIds = items.filter((i) => i.source === 'ASSIGNMENT' && i.sourceId).map((i) => i.sourceId!);\n  const quizIds = items.filter((i) => i.source === 'QUIZ' && i.sourceId).map((i) => i.sourceId!);\n  const [subs, attempts, quizzes] = await Promise.all([\n    assignmentIds.length ? prisma.submission.findMany({ where: { assignmentId: { in: assignmentIds } }, select: { id: true, assignmentId: true, studentId: true, isLate: true } }) : [],\n    quizIds.length\n      ? prisma.quizAttempt.findMany({ where: { quizId: { in: quizIds }, status: 'GRADED' }, select: { id: true, quizId: true, studentId: true, score: true, maxScore: true, submittedAt: true } })\n      : [],\n    quizIds.length ? prisma.quiz.findMany({ where: { id: { in: quizIds } }, select: { id: true, scoringPolicy: true } }) : [],\n  ]);\n  const subBy = new Map(subs.map((s) => [`${s.assignmentId}:${s.studentId}`, s]));\n  const policy = new Map(quizzes.map((q) => [q.id, q.scoringPolicy]));\n  const attemptsBy = new Map<string, typeof attempts>();\n  for (const a of attempts) attemptsBy.set(`${a.quizId}:${a.studentId}`, [...(attemptsBy.get(`${a.quizId}:${a.studentId}`) ?? []), a]);\n\n  const now = new Date();\n  const rows = students.map((s) => {\n    const cells: Record<string, ReturnType<typeof toCell> & { isLate: boolean; submissionId: string | null; attemptId: string | null }> = {};\n    for (const i of items) {\n      const sub = i.source === 'ASSIGNMENT' ? subBy.get(`${i.sourceId}:${s.id}`) : undefined;\n      const atts = i.source === 'QUIZ' ? attemptsBy.get(`${i.sourceId}:${s.id}`) ?? [] : [];\n      cells[i.id] = {\n        ...toCell(i.id, s.id, data.grades.get(i.id)?.get(s.id)),\n        isLate: sub?.isLate ?? false,\n        submissionId: sub?.id ?? null,\n        attemptId: i.source === 'QUIZ' ? pickAttempt(policy.get(i.sourceId!) ?? 'HIGHEST', atts) : null,\n      };\n    }\n    return {\n      student: { id: s.id, firstName: s.firstName, lastName: s.lastName, admissionNumber: s.studentProfile?.admissionNumber ?? null },\n      cells,\n      result: computeCourseResult(data, courseId, s.id, now),\n    };\n  });\n\n  const scale = data.scales.get(courseId);\n  return {\n    course,\n    term,\n    terms,\n    scale: scale ? { id: scale.id, name: scale.name, bands: scale.bands } : null,\n    categories: categories.map(toCategoryDto),\n    items: items.map(toItemDto),\n    rows,\n  };\n}\nexport type GradebookPayload = Awaited<ReturnType<typeof getGradebook>>;","numLines":122,"startLine":63,"totalLines":364}},"tool_result_meta":[{"id":"toolu_013ogetLtBQTLVT9FEnStYB7","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
