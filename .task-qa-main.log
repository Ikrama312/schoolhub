{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RBVrBhB298cJn7H1yGpG5Z","type":"tool_result","content":"1\timport type { Grade, GradeCategory, GradeItem, GradingScale, TermGradeOverride } from '@prisma/client';\n2\timport { prisma } from '@/server/db';\n3\timport { computeStudentTerm, effectiveScale, type CalcBand, type CalcGrade, type StudentTermResult } from './grade-calc';\n4\t\n5\t/**\n6\t * PRD-11 shared batched loader (NFR-2, NFR-3): a fixed number of findMany calls with `in`\n7\t * filters regardless of how many courses/students, grouped in memory. Used by the gradebook,\n8\t * student grades and report-card generation.\n9\t */\n10\t\n11\texport type ScaleRow = Pick<GradingScale, 'id' | 'name' | 'isDefault'> & { bands: CalcBand[] };\n12\t\n13\texport interface CourseTermData {\n14\t  items: Map<string, GradeItem[]>;\n15\t  categories: Map<string, GradeCategory[]>;\n16\t  scales: Map<string, ScaleRow | null>;\n17\t  defaultScale: ScaleRow | null;\n18\t  allScales: ScaleRow[];\n19\t  /** itemId → studentId → grade */\n20\t  grades: Map<string, Map<string, Grade>>;\n21\t  /** `${courseId}:${studentId}` → override */\n22\t  overrides: Map<string, TermGradeOverride>;\n23\t}\n24\t\n25\tconst toScale = (s: GradingScale): ScaleRow => ({ id: s.id, name: s.name, isDefault: s.isDefault, bands: s.bands as unknown as CalcBand[] });\n26\t\n27\texport async function loadScales() {\n28\t  const rows = await prisma.gradingScale.findMany({ orderBy: [{ isDefault: 'desc' }, { name: 'asc' }] });\n29\t  const all = rows.map(toScale);\n30\t  return { all, defaultScale: all.find((s) => s.isDefault) ?? null };\n31\t}\n32\t\n33\texport async function loadCourseTermData(\n34\t  courseIds: string[],\n35\t  termId: string,\n36\t  studentIds?: string[],\n37\t  { visibleOnly = false }: { visibleOnly?: boolean } = {},\n38\t): Promise<CourseTermData> {\n39\t  const [courses, items, categories, overrides, scales] = await Promise.all([\n40\t    prisma.course.findMany({ where: { id: { in: courseIds } }, select: { id: true, gradingScaleId: true } }),\n41\t    prisma.gradeItem.findMany({\n42\t      where: { courseId: { in: courseIds }, termId, ...(visibleOnly ? { isVisible: true } : {}) },\n43\t      orderBy: [{ dueAt: { sort: 'asc', nulls: 'last' } }, { title: 'asc' }],\n44\t    }),\n45\t    prisma.gradeCategory.findMany({ where: { courseId: { in: courseIds } }, orderBy: { order: 'asc' } }),\n46\t    prisma.termGradeOverride.findMany({ where: { courseId: { in: courseIds }, termId, ...(studentIds ? { studentId: { in: studentIds } } : {}) } }),\n47\t    loadScales(),\n48\t  ]);\n49\t  const grades = items.length\n50\t    ? await prisma.grade.findMany({ where: { gradeItemId: { in: items.map((i) => i.id) }, ...(studentIds ? { studentId: { in: studentIds } } : {}) } })\n51\t    : [];\n52\t\n53\t  const group = <T, K>(rows: T[], key: (r: T) => K) => {\n54\t    const m = new Map<K, T[]>();\n55\t    for (const r of rows) m.set(key(r), [...(m.get(key(r)) ?? []), r]);\n56\t    return m;\n57\t  };\n58\t  const byId = new Map(scales.all.map((s) => [s.id, s]));\n59\t  const gradeMap = new Map<string, Map<string, Grade>>();\n60\t  for (const g of grades) {\n61\t    if (!gradeMap.has(g.gradeItemId)) gradeMap.set(g.gradeItemId, new Map());\n62\t    gradeMap.get(g.gradeItemId)!.set(g.studentId, g);\n63\t  }\n64\t  return {\n65\t    items: group(items, (i) => i.courseId),\n66\t    categories: group(categories, (c) => c.courseId),\n67\t    scales: new Map(courses.map((c) => [c.id, effectiveScale(c.gradingScaleId ? byId.get(c.gradingScaleId) : null, scales.defaultScale)])),\n68\t    defaultScale: scales.defaultScale,\n69\t    allScales: scales.all,\n70\t    grades: gradeMap,\n71\t    overrides: new Map(overrides.map((o) => [`${o.courseId}:${o.studentId}`, o])),\n72\t  };\n73\t}\n74\t\n75\texport function studentGrades(data: CourseTermData, items: readonly GradeItem[], studentId: string): Map<string, CalcGrade> {\n76\t  const m = new Map<string, CalcGrade>();\n77\t  for (const i of items) {\n78\t    const g = data.grades.get(i.id)?.get(studentId);\n79\t    if (g) m.set(i.id, g);\n80\t  }\n81\t  return m;\n82\t}\n83\t\n84\t/** The single calc call every consumer shares (FR-15). */\n85\texport function computeCourseResult(data: CourseTermData, courseId: string, studentId: string, now: Date): StudentTermResult {\n86\t  const items = data.items.get(courseId) ?? [];\n87\t  return computeStudentTerm({\n88\t    items,\n89\t    grades: studentGrades(data, items, studentId),\n90\t    categories: data.categories.get(courseId) ?? [],\n91\t    bands: data.scales.get(courseId)?.bands ?? [],\n92\t    override: data.overrides.get(`${courseId}:${studentId}`) ?? null,\n93\t    now,\n94\t  });\n95\t}\n96\t"}]},"parent_tool_use_id":null,"session_id":"642b14da-c159-4e91-9f7f-23e093754dba","uuid":"f3cd43d3-3f18-4146-b521-f64a604dcc9f","timestamp":"2026-11-09T14:01:52.970Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/gradebook/load.ts","content":"import type { Grade, GradeCategory, GradeItem, GradingScale, TermGradeOverride } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { computeStudentTerm, effectiveScale, type CalcBand, type CalcGrade, type StudentTermResult } from './grade-calc';\n\n/**\n * PRD-11 shared batched loader (NFR-2, NFR-3): a fixed number of findMany calls with `in`\n * filters regardless of how many courses/students, grouped in memory. Used by the gradebook,\n * student grades and report-card generation.\n */\n\nexport type ScaleRow = Pick<GradingScale, 'id' | 'name' | 'isDefault'> & { bands: CalcBand[] };\n\nexport interface CourseTermData {\n  items: Map<string, GradeItem[]>;\n  categories: Map<string, GradeCategory[]>;\n  scales: Map<string, ScaleRow | null>;\n  defaultScale: ScaleRow | null;\n  allScales: ScaleRow[];\n  /** itemId → studentId → grade */\n  grades: Map<string, Map<string, Grade>>;\n  /** `${courseId}:${studentId}` → override */\n  overrides: Map<string, TermGradeOverride>;\n}\n\nconst toScale = (s: GradingScale): ScaleRow => ({ id: s.id, name: s.name, isDefault: s.isDefault, bands: s.bands as unknown as CalcBand[] });\n\nexport async function loadScales() {\n  const rows = await prisma.gradingScale.findMany({ orderBy: [{ isDefault: 'desc' }, { name: 'asc' }] });\n  const all = rows.map(toScale);\n  return { all, defaultScale: all.find((s) => s.isDefault) ?? null };\n}\n\nexport async function loadCourseTermData(\n  courseIds: string[],\n  termId: string,\n  studentIds?: string[],\n  { visibleOnly = false }: { visibleOnly?: boolean } = {},\n): Promise<CourseTermData> {\n  const [courses, items, categories, overrides, scales] = await Promise.all([\n    prisma.course.findMany({ where: { id: { in: courseIds } }, select: { id: true, gradingScaleId: true } }),\n    prisma.gradeItem.findMany({\n      where: { courseId: { in: courseIds }, termId, ...(visibleOnly ? { isVisible: true } : {}) },\n      orderBy: [{ dueAt: { sort: 'asc', nulls: 'last' } }, { title: 'asc' }],\n    }),\n    prisma.gradeCategory.findMany({ where: { courseId: { in: courseIds } }, orderBy: { order: 'asc' } }),\n    prisma.termGradeOverride.findMany({ where: { courseId: { in: courseIds }, termId, ...(studentIds ? { studentId: { in: studentIds } } : {}) } }),\n    loadScales(),\n  ]);\n  const grades = items.length\n    ? await prisma.grade.findMany({ where: { gradeItemId: { in: items.map((i) => i.id) }, ...(studentIds ? { studentId: { in: studentIds } } : {}) } })\n    : [];\n\n  const group = <T, K>(rows: T[], key: (r: T) => K) => {\n    const m = new Map<K, T[]>();\n    for (const r of rows) m.set(key(r), [...(m.get(key(r)) ?? []), r]);\n    return m;\n  };\n  const byId = new Map(scales.all.map((s) => [s.id, s]));\n  const gradeMap = new Map<string, Map<string, Grade>>();\n  for (const g of grades) {\n    if (!gradeMap.has(g.gradeItemId)) gradeMap.set(g.gradeItemId, new Map());\n    gradeMap.get(g.gradeItemId)!.set(g.studentId, g);\n  }\n  return {\n    items: group(items, (i) => i.courseId),\n    categories: group(categories, (c) => c.courseId),\n    scales: new Map(courses.map((c) => [c.id, effectiveScale(c.gradingScaleId ? byId.get(c.gradingScaleId) : null, scales.defaultScale)])),\n    defaultScale: scales.defaultScale,\n    allScales: scales.all,\n    grades: gradeMap,\n    overrides: new Map(overrides.map((o) => [`${o.courseId}:${o.studentId}`, o])),\n  };\n}\n\nexport function studentGrades(data: CourseTermData, items: readonly GradeItem[], studentId: string): Map<string, CalcGrade> {\n  const m = new Map<string, CalcGrade>();\n  for (const i of items) {\n    const g = data.grades.get(i.id)?.get(studentId);\n    if (g) m.set(i.id, g);\n  }\n  return m;\n}\n\n/** The single calc call every consumer shares (FR-15). */\nexport function computeCourseResult(data: CourseTermData, courseId: string, studentId: string, now: Date): StudentTermResult {\n  const items = data.items.get(courseId) ?? [];\n  return computeStudentTerm({\n    items,\n    grades: studentGrades(data, items, studentId),\n    categories: data.categories.get(courseId) ?? [],\n    bands: data.scales.get(courseId)?.bands ?? [],\n    override: data.overrides.get(`${courseId}:${studentId}`) ?? null,\n    now,\n  });\n}\n","numLines":96,"startLine":1,"totalLines":96}},"tool_result_meta":[{"id":"toolu_01RBVrBhB298cJn7H1yGpG5Z","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
