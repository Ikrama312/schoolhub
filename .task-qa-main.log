{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AcJz2kjER3CdsL1T4xLukh","type":"tool_result","content":"export async function listScales() {\n  const rows = await prisma.gradingScale.findMany({ orderBy: [{ isDefault: 'desc' }, { name: 'asc' }] });\n  return rows.map(toDto);\n}\n\nexport async function createScale(user: AccessUser, input: ScaleInput, request?: Request) {\n  adminOnly(user);\n  const scale = await prisma.$transaction(async (tx) => {\n    const isDefault = input.isDefault || (await tx.gradingScale.count()) === 0;\n    if (isDefault) await tx.gradingScale.updateMany({ where: { isDefault: true }, data: { isDefault: false } });\n    return tx.gradingScale.create({ data: { name: input.name, isDefault, bands: input.bands as unknown as Prisma.InputJsonValue } });\n  });\n  await audit({ actorId: user.id, action: 'gradingScale.create', entityType: 'GradingScale', entityId: scale.id, metadata: { name: scale.name, isDefault: scale.isDefault }, request });\n  return toDto(scale);\n}\n\nexport async function updateScale(user: AccessUser, id: string, patch: ScalePatch, request?: Request) {\n  adminOnly(user);\n  const old = await prisma.gradingScale.findUnique({ where: { id } });\n  if (!old) throw notFound();\n  if (patch.isDefault === false && old.isDefault) {\n    throw new AppError('VALIDATION_ERROR', 'Make another scale the default instead.', { fieldErrors: { isDefault: ['A default scale is required'] } });\n  }\n  const scale = await prisma.$transaction(async (tx) => {\n    if (patch.isDefault && !old.isDefault) await tx.gradingScale.updateMany({ where: { isDefault: true }, data: { isDefault: false } });\n    return tx.gradingScale.update({\n      where: { id },\n      data: {\n        ...(patch.name !== undefined ? { name: patch.name } : {}),\n        ...(patch.isDefault !== undefined ? { isDefault: patch.isDefault } : {}),\n        ...(patch.bands !== undefined ? { bands: patch.bands as unknown as Prisma.InputJsonValue } : {}),\n      },\n    });\n  });\n  await audit({ actorId: user.id, action: 'gradingScale.update', entityType: 'GradingScale', entityId: id, metadata: { old: toDto(old), new: toDto(scale) }, request });\n  return toDto(scale);\n}\n\n/** A11: the default or a scale any course uses can't be deleted. */\nexport async function deleteScale(user: AccessUser, id: string, request?: Request) {\n  adminOnly(user);\n  const scale = await prisma.gradingScale.findUnique({ where: { id }, include: { _count: { select: { courses: true } } } });\n  if (!scale) throw notFound();\n  if (scale.isDefault) throw new AppError('CONFLICT', 'The default scale cannot be deleted.', { courseCount: scale._count.courses });\n  if (scale._count.courses > 0) {\n    throw new AppError('CONFLICT', `This scale is used by ${scale._count.courses} course(s).`, { courseCount: scale._count.courses });\n  }\n  await prisma.gradingScale.delete({ where: { id } });\n  await audit({ actorId: user.id, action: 'gradingScale.delete', entityType: 'GradingScale', entityId: id, metadata: { old: toDto(scale) }, request });\n  return { id };\n}\nexport async function getCategories(user: AccessUser, courseId: string) {\n  await assertCanViewCourse(user, courseId);\n  return load(courseId);\n}\n\n/** PUT replaces the whole list in one transaction; a non-empty list must total exactly 100. */\nexport async function replaceCategories(user: AccessUser, courseId: string, input: CategoriesPut, request?: Request) {\n  await assertCanManageCourse(user, courseId);\n  const sum = weightSum(input.categories);\n  if (input.categories.length && !dec(sum).eq(100)) {\n    throw new AppError('VALIDATION_ERROR', `Weights total ${dec(sum).toString()} / 100`, { sum });\n  }\n  const before = await load(courseId);\n  const knownIds = new Set(before.categories.map((c) => c.id));\n  const foreign = input.categories.filter((c) => c.id && !knownIds.has(c.id));\n  if (foreign.length) throw new AppError('VALIDATION_ERROR', 'Unknown category id.', { ids: foreign.map((c) => c.id) });\n  if (input.gradingScaleId) {\n    const exists = await prisma.gradingScale.findUnique({ where: { id: input.gradingScaleId }, select: { id: true } });\n    if (!exists) throw new AppError('VALIDATION_ERROR', 'Unknown grading scale.', { fieldErrors: { gradingScaleId: ['Unknown scale'] } });\n  }\n\n  await prisma.$transaction(async (tx) => {\n    const keep = input.categories.map((c) => c.id).filter((id): id is string => !!id);\n    await tx.gradeCategory.deleteMany({ where: { courseId, id: { notIn: keep } } });\n    for (const c of input.categories) {\n      const data = { name: c.name, weightPercent: c.weightPercent, dropLowest: c.dropLowest, order: c.order };\n      if (c.id) await tx.gradeCategory.update({ where: { id: c.id }, data });\n      else await tx.gradeCategory.create({ data: { ...data, courseId } });\n    }\n    if (input.gradingScaleId !== undefined) await tx.course.update({ where: { id: courseId }, data: { gradingScaleId: input.gradingScaleId } });\n  });\n  const after = await load(courseId);\n  await audit({ actorId: user.id, action: 'gradeCategories.replace', entityType: 'Course', entityId: courseId, metadata: { old: before, new: after }, request });\n  return after;\n}\n152:  // PRD-11 gradebook (FR-38). grade.posted fires once per student per manual item (A9).\n153:  'grade.posted': {\n154-    label: 'Grade posted',\n155-    description: 'A teacher entered a grade for an in-class or offline item.',\n156-    category: 'ACADEMIC',\n157-    defaultEmail: false,\n--\n161:  'report_card.published': {\n162-    label: 'Report card published',\n163-    description: 'A term report card is available to view and print.',\n164-    category: 'ACADEMIC',\n165-    defaultEmail: true,\n20:export async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\n21-  switch (user.role) {\n22-    case 'ADMIN':\n23-      return 'ALL';\n--\n63:export async function assertCanViewStudent(user: AccessUser, studentId: