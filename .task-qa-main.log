{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011GyjM62ggGUD48hM8Vy8Q5","type":"tool_result","content":"import { defineConfig } from 'vitest/config';\nimport react from '@vitejs/plugin-react';\nimport path from 'node:path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    include: ['tests/unit/**/*.test.{ts,tsx}', 'tests/integration/**/*.test.ts'],\n  },\n});\ntests:\ne2e\nintegration\nunit\n\ntests/integration:\nassignments\nattendance-qa.test.ts\nattendance-service.test.ts\nauth.test.ts\nemail-dispatch.test.ts\nfiles-qa.test.ts\ngradebook\nmessaging\nquiz\nreport-cards\ntimetable-concurrency.test.ts\n\ntests/unit:\nassignments\nattendance-register-form.test.tsx\nattendance-rules.test.ts\nauth-forms.test.tsx\nauth-validators.test.ts\nConfirmDialog.test.tsx\ncontent-validators.test.ts\nDataTable.test.tsx\ndates.test.ts\nenv.test.ts\neslint-no-restricted-imports.test.ts\nfile-access.test.ts\nfile-validate.test.ts\ngradebook\nhttp.test.ts\nlockout.test.ts\nlogin-error-message.test.ts\nmessaging\nnotifications.test.ts\npassword-policy.test.ts\npublic-routes.test.ts\n'use client';\n\nimport { useState } from 'react';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport IconButton from '@mui/material/IconButton';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport Tooltip from '@mui/material/Tooltip';\nimport Typography from '@mui/material/Typography';\nimport SendIcon from '@mui/icons-material/Send';\nimport { FileUpload, type FileRef } from '@/components/FileUpload/FileUpload';\nimport { BODY_MAX, COUNTER_FROM, MAX_FILES } from '@/lib/messaging/constants';\nimport { api } from './usePolling';\nimport type { MessageDTO } from './MessageThread';\n\nexport const CANNOT_SEND = 'You can no longer send messages in this conversation.';\n\n/**\n * PRD-13 FR-11: Enter sends, Shift+Enter adds a newline; up to 5 attachments (context 'message');\n * a counter appears past 4,500 characters. Disabled with an explanation when canSend is false (FR-7).\n */\nexport function Composer({ conversationId, canSend, onSent }: { conversationId: string; canSend: boolean; onSent: (m: MessageDTO) => void }) {\n  const [body, setBody] = useState('');\n  const [files, setFiles] = useState<FileRef[]>([]);\n  const [sending, setSending] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [blocked, setBlocked] = useState(false);\n\n  if (!canSend || blocked) {\n    return (\n      <Box sx={{ p: 2 }}>\n        <Alert severity=\"info\">{CANNOT_SEND}</Alert>\n      </Box>\n    );\n  }\n\n  const tooLong = body.length > BODY_MAX;\n  const ready = body.trim().length > 0 && !tooLong && !sending;\n\n  async function send() {\n    if (!ready) return;\n    setSending(true);\n    setError(null);\n    try {\n      const { data } = await api<{ data: { message: MessageDTO } }>(`/api/conversations/${conversationId}/messages`, {\n        method: 'POST',\n        body: { body, fileIds: files.map((f) => f.id) },\n      });\n      setBody('');\n      setFiles([]);\n      onSent(data.message);\n    } catch (e) {\n      const err = e as { details?: { reason?: string }; message?: string };\n      if (err.details?.reason === 'RELATIONSHIP_ENDED') setBlocked(true);\n      else setError(err.message ?? 'Could not send.');\n    } finally {\n      setSending(false);\n    }\n  }\n\n  return (\n    <Box sx={{ p: 1.5, borderTop: 1, borderColor: 'divider' }}>\n      {error && (\n        <Alert severity=\"error\" onClose={() => setError(null)} sx={{ mb: 1 }}>\n          {error}\n        </Alert>\n      )}\n      <Stack direction=\"row\" spacing={1} sx={{ alignItems: 'flex-end' }}>\n        <TextField\n          fullWidth\n          multiline\n          maxRows={8}\n          size=\"small\"\n          placeholder=\"Write a message…\"\n          value={body}\n          onChange={(e) => setBody(e.target.value)}\n          onKeyDown={(e) => {\n            if (e.key === 'Enter' && !e.shiftKey && !e.nativeEvent.isComposing) {\n              e.preventDefault();\n              void send();\n            }\n          }}\n          error={tooLong}\n          disabled={sending}\n          slotProps={{ htmlInput: { 'aria-label': 'Message' } }}\n        />\n        <Tooltip title=\"Send (Enter)\">\n          <span>\n            <IconButton color=\"primary\" onClick={() => void send()} disabled={!ready} aria-label=\"Send message\">\n              <SendIcon />\n            </IconButton>\n          </span>\n        </Tooltip>\n      </Stack>\n      <Stack direction=\"row\" sx={{ alignItems: 'flex-start', justifyContent: 'space-between' }}>\n        <FileUpload context=\"message\" max={MAX_FILES} value={files} onChange={setFiles} disabled={sending} />\n        {body.length > COUNTER_FROM && (\n          <Typography variant=\"caption\" color={tooLong ? 'error' : 'text.secondary'} sx={{ pt: 1 }} aria-live=\"polite\">\n            {body.length} / {BODY_MAX}\n          </Typography>\n        )}\n      </Stack>\n    </Box>\n  );\n}\n74:  updatedAt                DateTime                  @updatedAt\n224:  updatedAt                DateTime       @updatedAt\n238:  updatedAt      DateTime        @updatedAt\n11:  createdBy       User                      @relation(\"ConversationCreator\", fields: [createdById], references: [id], onDelete: Cascade)\n16:  updatedAt       DateTime                  @updatedAt\n28:  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)\n30:  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)\n36:  updatedAt      DateTime     @updatedAt\n38:  @@unique([conversationId, userId])\n45:  conversation   Conversation        @relation(fields: [conversationId], references: [id