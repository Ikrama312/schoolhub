stMessageAt (FR-31), quiet-hours settings (FR-21), 'message' file access (FR-27),\n * empty poll (NFR-2). Real Postgres; skipped without TEST_DATABASE_URL.\n */\nconst MARK = 'qa-sh13';\ntype R = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\ntype K = 'lead' | 'a2' | 't' | 'co' | 't3' | 's1' | 's2' | 's3' | 'p' | 'p2';\nconst ids = {} as Record<K | 'year' | 'subject' | 'course', string>;\nconst as = (k: K, role: R) => ({ id: ids[k], role });\nconst T = () => as('t', 'TEACHER');\nconst CO = () => as('co', 'TEACHER');\nconst S1 = () => as('s1', 'STUDENT');\nconst S2 = () => as('s2', 'STUDENT');\nconst P = () => as('p', 'PARENT');\nconst code = (p: Promise<unknown>) => p.then(() => 'OK', (e: { code?: string }) => e.code ?? String(e));\nconst reason = (p: Promise<unknown>) => p.then(() => 'OK', (e: { details?: { reason?: string } }) => e.details?.reason ?? 'none');\nconst create = (user: { id: string; role: R }, participantIds: string[], body = 'hello', subject = MARK) =>\n  createConversation(user, createConversationSchema.parse({ participantIds, body, subject }));\nconst flat = (g: { groups: { label: string; contacts: { id: string }[] }[] }) => new Set(g.groups.flatMap((x) => x.contacts.map((c) => c.id)));","is_error":false}]},"parent_tool_use_id":null,"session_id":"d4f9b1f7-a7a6-4988-a1be-042973bf331a","uuid":"93ce87c6-7338-4879-9ec2-ac1a16bf777e","timestamp":"2026-11-10T00:09:38.644Z","tool_use_result":{"stdout":"   × useToast / ToastProvider > auto-hides after 5 seconds and advances the queue to the next toast\n   × ForgotPasswordForm (FR-17) > blocks an invalid email client-side, focusing the field (NFR-5, NFR-11)\n   × TokenPasswordForm (FR-13, FR-14, FR-16, FR-19) > invite: shows name/email read-only, a live checklist, and signs in to /dashboard\n   × TokenPasswordForm (FR-13, FR-14, FR-16, FR-19) > invite: a 410 (used/expired token) swaps the form for the invalid-link message\n   × ChangePasswordForm (FR-20) > maps the server currentPassword error onto the field\