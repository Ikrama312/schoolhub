{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0157gwakmjbF2T1moDywYVbn","type":"tool_result","content":"1\timport { formatInSchoolTz } from '@/lib/dates';\n2\t\n3\t/**\n4\t * PRD-07 pure rules (FR-8, FR-19, FR-22, FR-26, FR-28). No DB imports, so\n5\t * unit tests and the client (DatePicker limits) can use it directly.\n6\t * Dates are 'yyyy-MM-dd' strings in the school timezone (ADR-5).\n7\t */\n8\t\n9\texport type Status = 'PRESENT' | 'ABSENT' | 'LATE' | 'EXCUSED';\n10\texport type RuleRole = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n11\t\n12\texport const TEACHER_WINDOW_DAYS = 14;\n13\texport const WINDOW_REASON = `Teachers can edit registers up to ${TEACHER_WINDOW_DAYS} days after the register date`;\n14\t\n15\texport interface Rec {\n16\t  studentId: string;\n17\t  status: Status;\n18\t  minutesLate?: number | null;\n19\t  note?: string | null;\n20\t}\n21\t\n22\texport function schoolToday(now: Date, tz: string): string {\n23\t  return formatInSchoolTz(now, 'yyyy-MM-dd', tz);\n24\t}\n25\t\n26\t/** Whole days from `from` to `to` (both yyyy-MM-dd). */\n27\texport function daysBetween(from: string, to: string): number {\n28\t  return Math.round((Date.parse(`${to}T00:00:00Z`) - Date.parse(`${from}T00:00:00Z`)) / 86_400_000);\n29\t}\n30\t\n31\t/** yyyy-MM-dd shifted by n days. */\n32\texport function addDays(date: string, n: number): string {\n33\t  return new Date(Date.parse(`${date}T00:00:00Z`) + n * 86_400_000).toISOString().slice(0, 10);\n34\t}\n35\t\n36\texport type OpenResult = { ok: true } | { ok: false; code: 'FUTURE' | 'WINDOW'; reason: string };\n37\t\n38\t/** FR-8: never the future; ADMIN any past date; TEACHER only the last 14 days. */\n39\texport function canOpen(role: RuleRole, date: string, today: string): OpenResult {\n40\t  if (date > today) return { ok: false, code: 'FUTURE', reason: 'Registers cannot be taken for future dates' };\n41\t  if (role === 'ADMIN') return { ok: true };\n42\t  if (role === 'TEACHER' && daysBetween(date, today) <= TEACHER_WINDOW_DAYS) return { ok: true };\n43\t  return { ok: false, code: 'WINDOW', reason: WINDOW_REASON };\n44\t}\n45\t\n46\t/** FR-19: ADMIN always; TEACHER within 14 days of the register date. */\n47\texport function canEdit(role: RuleRole, date: string, today: string): { ok: boolean; reason?: string } {\n48\t  if (role === 'ADMIN') return { ok: true };\n49\t  if (role === 'TEACHER' && daysBetween(date, today) <= TEACHER_WINDOW_DAYS) return { ok: true };\n50\t  return { ok: false, reason: WINDOW_REASON };\n51\t}\n52\t\n53\texport interface RecordDiff {\n54\t  created: Rec[];\n55\t  changed: { studentId: string; prev: Rec; next: Rec }[];\n56\t}\n57\t\n58\tconst norm = (r: Rec) => [r.status, r.minutesLate ?? null, r.note ?? null].join('|');\n59\t\n60\t/** What a save actually writes; unchanged rows are dropped. */\n61\texport function diffRecords(prev: Map<string, Rec>, next: Rec[]): RecordDiff {\n62\t  const diff: RecordDiff = { created: [], changed: [] };\n63\t  for (const rec of next) {\n64\t    const old = prev.get(rec.studentId);\n65\t    if (!old) diff.created.push(rec);\n66\t    else if (norm(old) !== norm(rec)) diff.changed.push({ studentId: rec.studentId, prev: old, next: rec });\n67\t  }\n68\t  return diff;\n69\t}\n70\t\n71\t/** FR-21/22: transitions into ABSENT / LATE, and ABSENT→PRESENT. New rows count as transitions from nothing. */\n72\texport function notificationsFor(diff: RecordDiff): { absent: Rec[]; late: Rec[]; corrected: Rec[] } {\n73\t  const out = { absent: [] as Rec[], late: [] as Rec[], corrected: [] as Rec[] };\n74\t  const moves = [\n75\t    ...diff.created.map((next) => ({ from: null as Status | null, next })),\n76\t    ...diff.changed.map((c) => ({ from: c.prev.status, next: c.next })),\n77\t  ];\n78\t  for (const { from, next } of moves) {\n79\t    if (from === next.status) continue;\n80\t    if (next.status === 'ABSENT') out.absent.push(next);\n81\t    else if (next.status === 'LATE') out.late.push(next);\n82\t    else if (next.status === 'PRESENT' && from === 'ABSENT') out.corrected.push(next);\n83\t  }\n84\t  return out;\n85\t}\n86\t\n87\texport interface StatusCounts {\n88\t  records: number;\n89\t  present: number;\n90\t  absent: number;\n91\t  late: number;\n92\t  excused: number;\n93\t  rate: number | null;\n94\t}\n95\t\n96\t/** FR-28: (P+L+E)/total×100, 1 dp; null with no records. */\n97\texport function attendanceRate(c: { present: number; absent: number; late: number; excused: number }): number | null {\n98\t  const total = c.present + c.absent + c.late + c.excused;\n99\t  if (total === 0) return null;\n100\t  return Math.round(((c.present + c.late + c.excused) / total) * 1000) / 10;\n101\t}\n102\t\n103\texport function countStatuses(statuses: Iterable<Status>): StatusCounts {\n104\t  const c = { present: 0, absent: 0, late: 0, excused: 0 };\n105\t  for (const s of statuses) c[s.toLowerCase() as keyof typeof c] += 1;\n106\t  const records = c.present + c.absent + c.late + c.excused;\n107\t  return { records, ...c, rate: attendanceRate(c) };\n108\t}\n109\t\n110\texport type DayColour = 'success' | 'warning' | 'error' | 'default';\n111\t\n112\t/** FR-26: red if any absence, amber if any late, green otherwise; grey with no data. */\n113\texport function dayColour(statuses: Status[]): DayColour {\n114\t  if (statuses.length === 0) return 'default';\n115\t  if (statuses.includes('ABSENT')) return 'error';\n116\t  if (statuses.includes('LATE')) return 'warning';\n117\t  return 'success';\n118\t}\n119\t"}]},"parent_tool_use_id":null,"session_id":"88405567-c8b9-4e5f-8912-47ba3c7edb01","uuid":"749df331-c920-4afe-9b5e-08e32427f4ed","timestamp":"2026-11-06T06:06:36.777Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub/src/server/attendance/attendance-rules.ts","content":"import { formatInSchoolTz } from '@/lib/dates';\n\n/**\n * PRD-07 pure rules (FR-8, FR-19, FR-22, FR-26, FR-28). No DB imports, so\n * unit tests and the client (DatePicker limits) can use it directly.\n * Dates are 'yyyy-MM-dd' strings in the school timezone (ADR-5).\n */\n\nexport type Status = 'PRESENT' | 'ABSENT' | 'LATE' | 'EXCUSED';\nexport type RuleRole = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport const TEACHER_WINDOW_DAYS = 14;\nexport const WINDOW_REASON = `Teachers can edit registers up to ${TEACHER_WINDOW_DAYS} days after the register date`;\n\nexport interface Rec {\n  studentId: string;\n  status: Status;\n  minutesLate?: number | null;\n  note?: string | null;\n}\n\nexport function schoolToday(now: Date, tz: string): string {\n  return formatInSchoolTz(now, 'yyyy-MM-dd', tz);\n}\n\n/** Whole days from `from` to `to` (both yyyy-MM-dd). */\nexport function daysBetween(from: string, to: string): number {\n  return Math.round((Date.parse(`${to}T00:00:00Z`) - Date.parse(`${from}T00:00:00Z`)) / 86_400_000);\n}\n\n/** yyyy-MM-dd shifted by n days. */\nexport function addDays(date: string, n: number): string {\n  return new Date(Date.parse(`${date}T00:00:00Z`) + n * 86_400_000).toISOString().slice(0, 10);\n}\n\nexport type OpenResult = { ok: true } | { ok: false; code: 'FUTURE' | 'WINDOW'; reason: string };\n\n/** FR-8: never the future; ADMIN any past date; TEACHER only the last 14 days. */\nexport function canOpen(role: RuleRole, date: string, today: string): OpenResult {\n  if (date > today) return { ok: false, code: 'FUTURE', reason: 'Registers cannot be taken for future dates' };\n  if (role === 'ADMIN') return { ok: true };\n  if (role === 'TEACHER' && daysBetween(date, today) <= TEACHER_WINDOW_DAYS) return { ok: true };\n  return { ok: false, code: 'WINDOW', reason: WINDOW_REASON };\n}\n\n/** FR-19: ADMIN always; TEACHER within 14 days of the register date. */\nexport function canEdit(role: RuleRole, date: string, today: string): { ok: boolean; reason?: string } {\n  if (role === 'ADMIN') return { ok: true };\n  if (role === 'TEACHER' && daysBetween(date, today) <= TEACHER_WINDOW_DAYS) return { ok: true };\n  return { ok: false, reason: WINDOW_REASON };\n}\n\nexport interface RecordDiff {\n  created: Rec[];\n  changed: { studentId: string; prev: Rec; next: Rec }[];\n}\n\nconst norm = (r: Rec) => [r.status, r.minutesLate ?? null, r.note ?? null].join('|');\n\n/** What a save actually writes; unchanged rows are dropped. */\nexport function diffRecords(prev: Map<string, Rec>, next: Rec[]): RecordDiff {\n  const diff: RecordDiff = { created: [], changed: [] };\n  for (const rec of next) {\n    const old = prev.get(rec.studentId);\n    if (!old) diff.created.push(rec);\n    else if (norm(old) !== norm(rec)) diff.changed.push({ studentId: rec.studentId, prev: old, next: rec });\n  }\n  return diff;\n}\n\n/** FR-21/22: transitions into ABSENT / LATE, and ABSENT→PRESENT. New rows count as transitions from nothing. */\nexport function notificationsFor(diff: RecordDiff): { absent: Rec[]; late: Rec[]; corrected: Rec[] } {\n  const out = { absent: [] as Rec[], late: [] as Rec[], corrected: [] as Rec[] };\n  const moves = [\n    ...diff.created.map((next) => ({ from: null as Status | null, next })),\n    ...diff.changed.map((c) => ({ from: c.prev.status, next: c.next })),\n  ];\n  for (const { from, next } of moves) {\n    if (from === next.status) continue;\n    if (next.status === 'ABSENT') out.absent.push(next);\n    else if (next.status === 'LATE') out.late.push(next);\n    else if (next.status === 'PRESENT' && from === 'ABSENT') out.corrected.push(next);\n  }\n  return out;\n}\n\nexport interface StatusCounts {\n  records: number;\n  present: number;\n  absent: number;\n  late: number;\n  excused: number;\n  rate: number | null;\n}\n\n/** FR-28: (P+L+E)/total×100, 1 dp; null with no records. */\nexport function attendanceRate(c: { present: number; absent: number; late: number; excused: number }): number | null {\n  const total = c.present + c.absent + c.late + c.excused;\n  if (total === 0) return null;\n  return Math.round(((c.present + c.late + c.excused) / total) * 1000) / 10;\n}\n\nexport function countStatuses(statuses: Iterable<Status>): StatusCounts {\n  const c = { present: 0, absent: 0, late: 0, excused: 0 };\n  for (const s of statuses) c[s.toLowerCase() as keyof typeof c] += 1;\n  const records = c.present + c.absent + c.late + c.excused;\n  return { records, ...c, rate: attendanceRate(c) };\n}\n\nexport type DayColour = 'success' | 'warning' | 'error' | 'default';\n\n/** FR-26: red if any absence, amber if any late, green otherwise; grey with no data. */\nexport function dayColour(statuses: Status[]): DayColour {\n  if (statuses.length === 0) return 'default';\n  if (statuses.includes('ABSENT')) return 'error';\n  if (statuses.includes('LATE')) return 'warning';\n  return 'success';\n}\n","numLines":119,"startLine":1,"totalLines":119}},"tool_result_meta":[{"id":"toolu_0157gwakmjbF2T1moDywYVbn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
