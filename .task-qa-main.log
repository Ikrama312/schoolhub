{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WBhEoBnS3NHUkeFjfnDeNd","type":"tool_result","content":"import NextLink from 'next/link';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolSettings } from '@/server/services/settings';\nimport { getToday } from '@/server/attendance/attendance-service';\nimport { schoolToday } from '@/server/attendance/attendance-rules';\nimport { dateOnly } from '@/lib/validators/attendance';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { DateNav } from './DateNav';\n\nexport const dynamic = 'force-dynamic';\n\ntype Taken = { at: string; by: { name: string } } | null;\n\n/** Teacher landing — today's meetings, current period highlighted, daily registers (FR-6, FR-7, FR-8). */\nexport default async function TakeAttendancePage({ searchParams }: { searchParams: { date?: string } }) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  const { timezone } = await getSchoolSettings();\n  const today = schoolToday(new Date(), timezone);\n  const date = dateOnly.safeParse(searchParams.date).success ? searchParams.date! : today;\n\n  let data: Awaited<ReturnType<typeof getToday>> | null = null;\n  let error: string | null = null;\n  try {\n    data = await getToday(user, date);\n  } catch (e) {\n    if (!(e instanceof AppError)) throw e;\n    error = e.message;\n  }\n\n  const takenLabel = (t: Taken) =>\n    t ? `Taken ${formatInSchoolTz(t.at, 'HH:mm', timezone)} by ${t.by.name}` : 'Not taken';\n  const chip = (t: Taken) => <Chip size=\"small\" color={t ? 'success' : 'default'} label={takenLabel(t)} />;\n\n  return (\n    <Box>\n      <PageHeader\n        title=\"Take attendance\"\n        description={formatInSchoolTz(new Date(`${date}T12:00:00Z`), 'EEEE d MMMM yyyy', 'UTC')}\n        actions={<DateNav date={date} today={today} role={user.role} />}\n      />\n      {error && <Alert severity=\"warning\" sx={{ mb: 2 }}>{error}</Alert>}\n      {data && data.meetings.length === 0 && data.dailyRegisters.length === 0 && (\n        <EmptyState title=\"No registers for this day\" description=\"You have no classes or homeroom registers scheduled.\" />\n      )}\n      {data && data.dailyRegisters.length > 0 && (\n        <Stack spacing={1} sx={{ mb: 2 }}>\n          {data.dailyRegisters.map((d) => (\n            <Paper key={d.sectionId} variant=\"outlined\" sx={{ p: 2 }}>\n              <Stack direction=\"row\" spacing={2} useFlexGap sx={{ alignItems: 'center', flexWrap: 'wrap' }}>\n                <Typography sx={{ flexGrow: 1, fontWeight: 600 }}>Daily register – {d.sectionName}</Typography>\n                {chip(d.taken)}\n                <Button component={NextLink} href={`/attendance/take/section/${d.sectionId}?date=${date}`} variant=\"outlined\">\n                  {d.taken ? 'Review' : 'Take attendance'}\n                </Button>\n              </Stack>\n            </Paper>\n          ))}\n        </Stack>\n      )}\n      {data && data.meetings.length > 0 && (\n        <Stack spacing={1}>\n          {data.meetings.map((m) => (\n            <Paper\n              key={`${m.courseId}-${m.periodId}`}\n              variant=\"outlined\"\n              sx={{ p: 2, borderColor: m.isCurrent ? 'primary.main' : undefined, borderWidth: m.isCurrent ? 2 : 1 }}\n            >\n              <Stack direction=\"row\" spacing={2} useFlexGap sx={{ alignItems: 'center', flexWrap: 'wrap' }}>\n                <Box sx={{ flexGrow: 1, minWidth: 180 }}>\n                  <Typography sx={{ fontWeight: 600 }}>\n                    {m.courseName}\n                    {m.sectionName && ` – ${m.sectionName}`}\n                  </Typography>\n                  <Typography variant=\"body2\" color=\"text.secondary\">\n                    {m.periodName} · {m.startTime}–{m.endTime}\n                    {m.isCurrent && ' · Now'}\n                  </Typography>\n                </Box>\n                {chip(m.taken)}\n                <Button\n                  component={NextLink}\n                  href={`/attendance/take/${m.courseId}?date=${date}&periodId=${m.periodId}`}\n                  variant={m.isCurrent ? 'contained' : 'outlined'}\n                >\n                  {m.taken ? 'Review' : 'Take attendance'}\n                </Button>\n              </Stack>\n            </Paper>\n          ))}\n        </Stack>\n      )}\n    </Box>\n  );\n}\n'use client';\n\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { format } from 'date-fns';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { addDays, canOpen, type RuleRole } from '@/server/attendance/attendance-rules';\n\nconst toLocal = (d: string) => {\n  const [y, m, day] = d.split('-').map(Number);\n  return new Date(y, m - 1, day);\n};\n\n/** FR-8: pick a register date; never the future, teachers only the last 14 days (same canOpen rule as the server). */\nexport function DateNav({ date, today, role }: { date: string; today: string; role: RuleRole }) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  return (\n    <DatePicker\n      label=\"Register date\"\n      value={toLocal(date)}\n      disableFuture\n      maxDate={toLocal(today)}\n      minDate={role === 'TEACHER' ? toLocal(addDays(today, -14)) : undefined}\n      shouldDisableDate={(d) => !canOpen(role, format(d, 'yyyy-MM-dd'), today).ok}\n      onChange={(d) => {\n        if (!d || Number.isNaN(d.getTime())) return;\n        const next = new URLSearchParams(searchParams.toString());\n        next.set('date', format(d, 'yyyy-MM-dd'));\n        router.push(`${pathname}?${next.toString()}`);\n      }}\n      slotProps={{ textField: { size: 'small' } }}\n    />\n  );\n}\nimport { notFound } from 'next/navigation';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolSettings } from '@/server/services/settings';\nimport { getRegister, type Register } from '@/server/attendance/attendance-service';\nimport { schoolToday } from '@/server/attendance/attendance-rules';\nimport { registerQuery } from '@/lib/validators/attendance';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { RegisterForm } from '../RegisterForm';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course register — /attendance/take/<courseId>?date=&periodId= (FR-8, FR-9, FR-19). */\nexport default async function CourseRegisterPage({\n  params,\n  searchParams,\n}: {\n  params: { courseId: string };\n  searchParams: { date?: string; periodId?: string };\n}) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  const { timezone } = await getSchoolSettings();\n  const key = registerQuery.safeParse({\n    courseId: params.courseId,\n    periodId: searchParams.periodId,\n    date: searchParams.date ?? schoolToday(new Date(), timezone),\n  });\n  if (!key.success) notFound();\n\n  let register: Register | null = null;\n  let error: string | null = null;\n  try {\n    register = await getRegister(user, key.data);\n  } catch (e) {\n    if (e instanceof AppError && e.code === 'NOT_FOUND') notFound();\n    if (!(e instanceof AppError)) throw e;\n    error = e.message;\n  }\n\n  return (\n    <Box>\n      <PageHeader\n        title={register?.header.courseName ?? 'Register'}\n        description={\n          register\n            ? [register.header.sectionName, register.header.periodName, formatInSchoolTz(new Date(`${key.data.date}T12:00:00Z`), 'EEEE d MMM yyyy', 'UTC')]\n                .filter(Boolean)\n                .join(' · ')\n            : undefined\n        }\n        breadcrumbs={[{ label: 'Take attendance', href: `/attendance/take?date=${key.data.date}` }, { label: 'Register' }]}\n      />\n      {error && <Alert severity=\"warning\">{error}</Alert>}\n      {register && <RegisterForm key={`${key.data.date}-${register.sessionId}`} initial={register} />}\n    </Box>\n  );\n}\nimport { notFound } from 'next/navigation';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolSettings } from '@/server/services/settings';\nimport { getRegister, type Register } from '@/server/attendance/attendance-service';\nimport { schoolToday } from '@/server/attendance/attendance-rules';\nimport { registerQuery } from '@/lib/validators/attendance';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { RegisterForm } from '../../RegisterForm';\n\nexport const dynamic = 'force-dynamic';\n\n/** Daily homeroom register — /attendance/take/section/<sectionId>?date= (FR-15, FR-16). */\nexport default async function SectionRegisterPage({\n  params,\n  searchParams,\n}: {\n  params: { sectionId: string };\n  searchParams: { date?: string };\n}) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  const { timezone } = await getSchoolSettings();\n  const key = registerQuery.safeParse({ sectionId: params.sectionId, date: searchParams.date ?? schoolToday(new Date(), timezone) });\n  if (!key.success) notFound();\n\n  let register: Register | null = null;\n  let error: string | null = null;\n  try {\n    register = await getRegister(user, key.data);\n  } catch (e) {\n    if (e instanceof AppError && e.code === 'NOT_FOUND') notFound();\n    if (!(e instanceof AppError)) throw e;\n    error = e.message;\n  }\n\n  return (\n    <Box>\n      <PageHeader\n        title={register ? `Daily register – ${register.header.sectionName}` : 'Daily register'}\n        description={formatInSchoolTz(new Date(`${key.data.date}T12:00:00Z`), 'EEEE d MMM yyyy', 'UTC')}\n        breadcrumbs={[{ label: 'Take attendance', href: `/attendance/take?date=${key.data.date}` }, { label: 'Daily register' }]}\n      />\n      {error && <Alert severity=\"warning\">{error}</Alert>}\n      {register && <RegisterForm key={`${key.data.date}-${register.sessionId}`} initial={register} />}\n    </Box>\n  );\n}\nimport { notFound, redirect } from 'next/navigation';\nimport Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { prisma } from '@/server/db';\nimport { getStudentAttendance } from '@/server/attendance/attendance-service';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { ALL_ROLES } from '@/config/navigation';\nimport { StudentAttendanceClient } from './StudentAttendanceClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** Student \"Attendance\" tab — FR-24 to FR-28. Access is assertCanViewStudent inside the service. */\nexport default async function StudentAttendancePage({ params }: { params: { id: string } }) {\n  const user = await requirePageRole(...ALL_ROLES);\n  let data: Awaited<ReturnType<typeof getStudentAttendance>>;\n  try {\n    data = await getStudentAttendance(user, params.id, {});\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  const student = await prisma.user.findUnique({ where: { id: params.id }, select: { firstName: true, lastName: true } });\n  if (!student) notFound();\n\n  return (\n    <Box>\n      <PageHeader title=\"Attendance\" description={`${student.firstName} ${student.lastName}`} />\n      <StudentAttendanceClient studentId={params.id} initial={data} />\n    </Box>\n  );\n}\nimport { notFound, redirect } from 'next/navigation';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getCourseMatrix } from '@/server/attendance/attendance-service';\nimport { CourseAttendanceMatrix } from './CourseAttendanceMatrix';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course \"Attendance\" tab — FR-29. TEACHER/ADMIN; assertCanManageCourse inside the service. */\nexport default async function CourseAttendancePage({ params }: { params: { courseId: string } }) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  let matrix: Awaited<ReturnType<typeof getCourseMatrix>>;\n  try {\n    matrix = await getCourseMatrix(user, params.courseId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  return <CourseAttendanceMatrix courseId={params.courseId} matrix={matrix} />;\n}\nimport Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { prisma } from '@/server/db';\nimport { getSchoolSettings } from '@/server/services/settings';\nimport { getAttendanceSettings, getBelowThreshold, getOverview } from '@/server/attendance/attendance-service';\nimport { schoolToday } from '@/server/attendance/attendance-rules';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { AdminAttendanceClient } from './AdminAttendanceClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /admin/attendance — ADMIN (FR-5, FR-30 to FR-33). */\nexport default async function AdminAttendancePage() {\n  await requirePageRole('ADMIN');\n  const { timezone } = await getSchoolSettings();\n  const today = schoolToday(new Date(), timezone);\n  const current = { academicYear: { isCurrent: true } };\n  const [overview, below, settings, gradeLevels, sections, courses] = await Promise.all([\n    getOverview(),\n    getBelowThreshold(),\n    getAttendanceSettings(),\n    prisma.gradeLevel.findMany({ where: { archivedAt: null }, select: { id: true, name: true }, orderBy: { order: 'asc' } }),\n    prisma.section.findMany({ where: current, select: { id: true, name: true }, orderBy: { name: 'asc' } }),\n    prisma.course.findMany({ where: { ...current, archivedAt: null }, select: { id: true, name: true }, orderBy: { name: 'asc' } }),\n  ]);\n\n  return (\n    <Box>\n      <PageHeader title=\"Attendance\" description=\"Today's registers, reports and settings\" />\n      <AdminAttendanceClient\n        overview={overview}\n        below={below}\n        settings={settings}\n        options={{ gradeLevels, sections, courses }}\n        today={today}\n        monthStart={`${today.slice(0, 8)}01`}\n      />\n    </Box>\n  );\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"88405567-c8b9-4e5f-8912-47ba3c7edb01","uuid":"1c1ce052-2816-45b6-a129-316bde7b2297","timestamp":"2026-11-06T06:07:55.372Z","tool_use_result":{"stdout":"import NextLink from 'next/link';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Chip from '@mui/material/Chip';\nimport Paper from '@mui/material/Paper';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolSettings } from '@/server/services/settings';\nimport { getToday } from '@/server/attendance/attendance-service';\nimport { schoolToday } from '@/server/attendance/attendance-rules';\nimport { dateOnly } from '@/lib/validators/attendance';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { DateNav } from './DateNav';\n\nexport const dynamic = 'force-dynamic';\n\ntype Taken = { at: string; by: { name: string } } | null;\n\n/** Teacher landing — today's meetings, current period highlighted, daily registers (FR-6, FR-7, FR-8). */\nexport default async function TakeAttendancePage({ searchParams }: { searchParams: { date?: string } }) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  const { timezone } = await getSchoolSettings();\n  const today = schoolToday(new Date(), timezone);\n  const date = dateOnly.safeParse(searchParams.date).success ? searchParams.date! : today;\n\n  let data: Awaited<ReturnType<typeof getToday>> | null = null;\n  let error: string | null = null;\n  try {\n    data = await getToday(user, date);\n  } catch (e) {\n    if (!(e instanceof AppError)) throw e;\n    error = e.message;\n  }\n\n  const takenLabel = (t: Taken) =>\n    t ? `Taken ${formatInSchoolTz(t.at, 'HH:mm', timezone)} by ${t.by.name}` : 'Not taken';\n  const chip = (t: Taken) => <Chip size=\"small\" color={t ? 'success' : 'default'} label={takenLabel(t)} />;\n\n  return (\n    <Box>\n      <PageHeader\n        title=\"Take attendance\"\n        description={formatInSchoolTz(new Date(`${date}T12:00:00Z`), 'EEEE d MMMM yyyy', 'UTC')}\n        actions={<DateNav date={date} today={today} role={user.role} />}\n      />\n      {error && <Alert severity=\"warning\" sx={{ mb: 2 }}>{error}</Alert>}\n      {data && data.meetings.length === 0 && data.dailyRegisters.length === 0 && (\n        <EmptyState title=\"No registers for this day\" description=\"You have no classes or homeroom registers scheduled.\" />\n      )}\n      {data && data.dailyRegisters.length > 0 && (\n        <Stack spacing={1} sx={{ mb: 2 }}>\n          {data.dailyRegisters.map((d) => (\n            <Paper key={d.sectionId} variant=\"outlined\" sx={{ p: 2 }}>\n              <Stack direction=\"row\" spacing={2} useFlexGap sx={{ alignItems: 'center', flexWrap: 'wrap' }}>\n                <Typography sx={{ flexGrow: 1, fontWeight: 600 }}>Daily register – {d.sectionName}</Typography>\n                {chip(d.taken)}\n                <Button component={NextLink} href={`/attendance/take/section/${d.sectionId}?date=${date}`} variant=\"outlined\">\n                  {d.taken ? 'Review' : 'Take attendance'}\n                </Button>\n              </Stack>\n            </Paper>\n          ))}\n        </Stack>\n      )}\n      {data && data.meetings.length > 0 && (\n        <Stack spacing={1}>\n          {data.meetings.map((m) => (\n            <Paper\n              key={`${m.courseId}-${m.periodId}`}\n              variant=\"outlined\"\n              sx={{ p: 2, borderColor: m.isCurrent ? 'primary.main' : undefined, borderWidth: m.isCurrent ? 2 : 1 }}\n            >\n              <Stack direction=\"row\" spacing={2} useFlexGap sx={{ alignItems: 'center', flexWrap: 'wrap' }}>\n                <Box sx={{ flexGrow: 1, minWidth: 180 }}>\n                  <Typography sx={{ fontWeight: 600 }}>\n                    {m.courseName}\n                    {m.sectionName && ` – ${m.sectionName}`}\n                  </Typography>\n                  <Typography variant=\"body2\" color=\"text.secondary\">\n                    {m.periodName} · {m.startTime}–{m.endTime}\n                    {m.isCurrent && ' · Now'}\n                  </Typography>\n                </Box>\n                {chip(m.taken)}\n                <Button\n                  component={NextLink}\n                  href={`/attendance/take/${m.courseId}?date=${date}&periodId=${m.periodId}`}\n                  variant={m.isCurrent ? 'contained' : 'outlined'}\n                >\n                  {m.taken ? 'Review' : 'Take attendance'}\n                </Button>\n              </Stack>\n            </Paper>\n          ))}\n        </Stack>\n      )}\n    </Box>\n  );\n}\n'use client';\n\nimport { useRouter, usePathname, useSearchParams } from 'next/navigation';\nimport { format } from 'date-fns';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { addDays, canOpen, type RuleRole } from '@/server/attendance/attendance-rules';\n\nconst toLocal = (d: string) => {\n  const [y, m, day] = d.split('-').map(Number);\n  return new Date(y, m - 1, day);\n};\n\n/** FR-8: pick a register date; never the future, teachers only the last 14 days (same canOpen rule as the server). */\nexport function DateNav({ date, today, role }: { date: string; today: string; role: RuleRole }) {\n  const router = useRouter();\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  return (\n    <DatePicker\n      label=\"Register date\"\n      value={toLocal(date)}\n      disableFuture\n      maxDate={toLocal(today)}\n      minDate={role === 'TEACHER' ? toLocal(addDays(today, -14)) : undefined}\n      shouldDisableDate={(d) => !canOpen(role, format(d, 'yyyy-MM-dd'), today).ok}\n      onChange={(d) => {\n        if (!d || Number.isNaN(d.getTime())) return;\n        const next = new URLSearchParams(searchParams.toString());\n        next.set('date', format(d, 'yyyy-MM-dd'));\n        router.push(`${pathname}?${next.toString()}`);\n      }}\n      slotProps={{ textField: { size: 'small' } }}\n    />\n  );\n}\nimport { notFound } from 'next/navigation';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolSettings } from '@/server/services/settings';\nimport { getRegister, type Register } from '@/server/attendance/attendance-service';\nimport { schoolToday } from '@/server/attendance/attendance-rules';\nimport { registerQuery } from '@/lib/validators/attendance';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { RegisterForm } from '../RegisterForm';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course register — /attendance/take/<courseId>?date=&periodId= (FR-8, FR-9, FR-19). */\nexport default async function CourseRegisterPage({\n  params,\n  searchParams,\n}: {\n  params: { courseId: string };\n  searchParams: { date?: string; periodId?: string };\n}) {\n  const user = await requirePageRole('TEACHER', 'ADMIN');\n  const { timezone } = await getSchoolSettings();\n  const key = registerQuery.safeParse({\n    courseId: params.courseId,\n    periodId: searchParams.periodId,\n    date: searchParams.date ?? schoolToday(new Date(), timezone),\n  });\n  if (!key.success) notFound();\n\n  let register: Register | null = null;\n  let error: string | null = null;\n  try {\n    register = await getRegister(user, key.data);\n  } catch (e) {\n    if (e instanceof AppError && e.code === 'NOT_FOUND') notFound();\n    if (!(e instanceof AppError)) throw e;\n    error = e.message;\n  }\n\n  return (\n    <Box>\n      <PageHeader\n        title={register?.header.courseName ?? 'Register'}\n        description={\n          register\n            ? [register.header.sectionName, register.header.periodName, formatInSchoolTz(new Date(`${key.data.date}T12:00:00Z`), 'EEEE d MMM yyyy', 'UTC')]\n                .filter(Boolean)\n                .join(' · ')\n            : undefined\n        }\n        breadcrumbs={[{ label: 'Take attendance', href: `/attendance/take?date=${key.data.date}` }, { label: 'Register' }]}\n      />\n      {error && <Alert severity=\"warning\">{error}</Alert>}\n      {register && <RegisterForm key={`${key.data.date}-${register.sessionId}`} initial={register} />}\n    </Box>\n  );\n}\nimport { notFound } from 'next/navigation';\nimport Alert from '@mui/material/Alert';\nimport Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimpo