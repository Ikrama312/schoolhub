 { periodReorderSchema } from '@/lib/validators/timetable';\n\n/** POST /api/periods/reorder — ADMIN (PRD-06 FR-5). */\nexport const POST = withHandler(async (request: Request) => {\n  const actor = await requireRole('ADMIN');\n  const { periodIds } = await parseBody(request, periodReorderSchema);\n  return ok(await reorderPeriods(periodIds, { actorId: actor.id, request }));\n});\n=== src/app/api/school-days/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole, requireUser } from '@/server/auth/requireRole';\nimport { listSchoolDays, updateSchoolDays } from '@/server/timetable/timetable-service';\nimport { schoolDaysSchema } from '@/lib/validators/timetable';\n\n/** GET (any user) / PUT (ADMIN) /api/school-days — PRD-06 FR-7, FR-34. */\nexport const GET = withHandler(async () => {\n  await requireUser();\n  return ok(await listSchoolDays());\n});\n\nexport const PUT = withHandler(async (request: Request) => {\n  const actor = await requireRole('ADMIN');\n  const { days } = await parseBody(request, schoolDaysSchema);\n  return ok(await updateSchoolDays(days, { actorId: actor.id, request }));\n});\n=== src/app/api/timetable/route.ts\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { assertCanViewTimetable, getTimetable } from '@/server/timetable/timetable-service';\nimport { timetableQuerySchema } from '@/lib/validators/timetable';\n\n/** GET /api/timetable?view&id&academicYearId — PRD-06 FR-35. */\nexport const GET = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  const q = parseQuery(new URL(request.url).searchParams, timetableQuerySchema);\n  await assertCanViewTimetable(user, q.view, q.id);\n  return ok(await getTimetable(q.view, q.id, q.academicYearId));\n});\n=== src/app/api/timetable/availability/route.ts\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { getAvailability } from '@/server/timetable/timetable-service';\nimport { availabilityQuerySchema } from '@/lib/validators/timetable';\n\n/** GET /api/timetable/availability?courseId&roomId — ADMIN (PRD-06 FR-36, D2). */\nexport const GET = withHandler(async (request: Request) => {\n  await requireRole('ADMIN');\n  const q = parseQuery(new URL(request.url).searchParams, availabilityQuerySchema);\n  return ok(await getAvailability(q.courseId, q.roomId));\n});\n=== src/app/api/timetable/free-rooms/route.ts\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { getFreeRooms } from '@/server/timetable/timetable-service';\nimport { freeRoomsQuerySchema } from '@/lib/validators/timetable';\n\n/** GET /api/timetable/free-rooms — ADMIN (PRD-06 FR-21, D1). */\nexport const GET = withHandler(async (request: Request) => {\n  await requireRole('ADMIN');\n  return ok(await getFreeRooms(parseQuery(new URL(request.url).searchParams, freeRoomsQuerySchema)));\n});\n=== src/app/api/timetable/slots/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { createSlot } from '@/server/timetable/timetable-service';\nimport { slotCreateSchema } from '@/lib/validators/timetable';\n\n/** POST /api/timetable/slots — ADMIN (PRD-06 FR-37). 409 { clashes } on any clash. */\nexport const POST = withHandler(async (request: Request) => {\n  const actor = await requireRole('ADMIN');\n  const input = await parseBody(request, slotCreateSchema);\n  return ok(await createSlot(input, { actorId: actor.id, request }), { status: 201 });\n});\n=== src/app/api/timetable/slots/[id]/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireRole } from '@/server/auth/requireRole';\nimport { deleteSlot, moveSlot } from '@/server/timetable/timetable-service';\nimport { slotUpdateSchema } from '@/lib/validators/timetable';\n\ntype Ctx = { params: { id: string } };\n\n/** PATCH (move / change room) and DELETE /api/timetable/slots/:id — ADMIN (PRD-06 FR-37). */\nexport const PATCH = withHandler(async (request: Request, { params }: Ctx) => {\n  const actor = await requireRole('ADMIN');\n  const patch = await parseBody(request, slotUpdateSchema);\n  return ok(await moveSlot(params.id, patch, { actorId: actor.id, request }));\n});\n\nexport const DELETE = withHandler(async (request: Request, { params }: Ctx) => {\n  const actor = await requireRole('ADMIN');\n  return ok(await deleteSlot(params.id, { actorId: actor.id, request }));\n});\n=== src/app/api/me/timetable/route.ts\nimport { ok, parseQuery, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { getPersonalTimetable, resolvePersonalTarget } from '@/server/timetable/timetable-service';\nimport { meTimetableQuerySchema } from '@/lib/validators/timetable';\n\n/** GET /api/me/timetable — PRD-06 FR-38, FR-25. ADMIN gets an empty week (D5). */\nexport const GET = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  const q = parseQuery(new URL(request.url).searchParams, meTimetableQuerySchema);\n  const target = await resolvePersonalTarget(user, q.studentId);\n  return ok(await getPersonalTimetable(target, q.academicYearId));\n});\nimport { z } from 'zod';\n\n/**\n * PRD-06 validation (FR-39), shared by the bell-schedule / timetable forms\n * and the /api/periods, /api/school-days, /api/timetable* handlers.\n * academicYearId is never accepted on slot writes; it comes from the course (FR-37).\n */\n\nexport const hhmm = z.string().regex(/^([01]\\d|2[0-3]):[0-5]\\d$/, 'Use HH:MM (24-hour)');\n\nexport const periodKind = z.enum(['CLASS', 'BREAK', 'LUNCH', 'ASSEMBLY']);\n\nconst endAfterStart = { message: 'End time must be after start time', path: ['endTime'] };\n\nconst periodBase = z.object({\n  name: z.string().trim().min(1, 'Name is required').max(50),\n  startTime: hhmm,\n  endTime: hhmm,\n  kind: periodKind,\n});\n\n// 'HH:MM' strings compare correctly as strings (ADR-2).\nexport const periodSchema = periodBase.refine((p) => p.endTime > p.startTime, endAfterStart);\nexport type PeriodInput = z.infer<typeof periodSchema>;\n\nexport const periodUpdateSchema = periodBase\n  .partial()\n  .refine((p) => !p.startTime || !p.endTime || p.endTime > p.startTime, endAfterStart);\nexport type PeriodUpdateInput = z.infer<typeof periodUpdateSchema>;\n\nexport const periodReorderSchema = z.object({\n  periodIds: z\n    .array(z.string().min(1))\n    .min(1)\n    .refine((ids) => new Set(ids).size === ids.length, 'Duplicate period ids'),\n});\n\nconst dayOfWeek = z.number().int().min(1).max(7);\n\nexport const schoolDaysSchema = z.object({\n  days: z\n    .array(z.object({ dayOfWeek, isTeaching: z.boolean() }))\n    .length(7)\n    .refine((days) => new Set(days.map((d) => d.dayOfWeek)).size === 7, 'Each day must appear once'),\n});\nexport type SchoolDaysInput = z.infer<typeof schoolDaysSchema>;\n\nexport const slotCreateSchema = z.object({\n  courseId: z.string().min(1),\n  dayOfWeek,\n  periodId: z.string().min(1),\n  roomId: z.string().min(1).nullable().optional(),\n});\nexport type SlotCreateInput = z.infer<typeof slotCreateSchema>;\n\nexport const slotUpdateSchema = z\n  .object({\n    dayOfWeek: dayOfWeek.optional(),\n    periodId: z.string().min(1).optional(),\n    roomId: z.string().min(1).nullable().optional(),\n  })\n  .refine((p) => Object.values(p).some((v) => v !== undefined), 'Provide at least one field');\nexport type SlotUpdateInput = z.infer<typeof slotUpdateSchema>;\n\nexport const timetableView = z.enum(['section', 'teacher', 'room']);\nexport type TimetableViewKind = z.infer<typeof timetableView>;\n\nexport const timetableQuerySchema = z.object({\n  view: timetableView,\n  id: z.string().min(1),\n  academicYearId: z.string().min(1),\n});\n\nexport const availabilityQuerySchema = z.object({\n  courseId: z.string().min(1),\n  roomId: z.string().min(1).optional(),\n});\n\nexport const freeRoomsQuerySchema = z.object({\n  dayOfWeek: z.coerce.number().int().min(1).max(7),\n  periodId: z.string().min(1),\n  academicYearId: z.string().min(1),\n  excludeSlotId: z.string().min(1).optional(),\n});\n\nexport const meTimetableQuerySchema = z.object({\n  studentId: z.string().min(1).optional(),\n  academicYearId: z.string().min(1).optional(),\n});\nimport { formatInTimeZone } from 'date-fns-tz';\n\n/**\n * Formats a UTC date/ISO-string in the school's configured timezone\n * (SchoolSettings.timezone). pattern is a date-fns format string.\n */\nexport function formatInSchoolTz(\n  date: Date | string,\n  pattern: string,\n  timezone: string,\n): string {\n  const value = typeof date === 'string' ? new Date(date) : date;\n  return formatInTimeZone(value, timezone, pattern);\n}\n\n/** ISO weekday (1=Mon … 7=Sun) and 'HH:mm' wall clock in the school timezone. Never the browser's. */\nexport function schoolNow(now: Date, tz: string): { isoDay: number; hhmm: string } {\n  return { isoDay: Number(formatInSchoolTz(now, 'i', tz)), hhmm: formatInSchoolTz(now, 'HH:mm', tz) };\n}\n\n/** The period running at hhmm ([start, end)) and the next one to start after hhmm. */\nexport function nowAndNext<P extends { startTime: string; endTime: string }>(\n  periods: P[],\n  hhmm: string,\n): { now: P | null; next: P | null } {\n  const sorted = [...periods].sort((a, b) => a.startTime.localeCompare(b.startTime));\n  return {\n    now: sorted.find((p) => p.startTime <= hhmm && hhmm < p.endTime) ?? null,\n    next: sorted.find((p) => p.startTime > hhmm) ?? null,\n  };\n}\n\n/** ISO weekday labels, index 1=Mon … 7=Sun (index 0 unused). */\nexport const ISO_DAY_NAMES = ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01M8G236tc9Q8GQi7n76M86u","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
