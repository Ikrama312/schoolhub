{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgsgHTB8TGzr164MiH84X","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Reu5oGDadoh7GUKVbuwA64","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-12\",\n  \"timestamp\": \"2026-11-09T19:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the SH-11 contracts that were here before.\",\n    \"basePath\": \"/api (the existing SchoolHub convention, not /api/v1). Route files are src/app/api/**/route.ts. Requirement: FR-34.\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with a Zod schema from src/lib/validators/announcements.ts → one call into src/server/announcements/announcements-service.ts → ok(data) / ok(data, {status: 201}) / paginated(data, meta). No business logic in routes. Requirements: FR-34, FR-36, NFR-8.\",\n    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. Paginated endpoints return { \\\"data\\\": [...], \\\"meta\\\": { page, pageSize, total } } via paginated() in src/server/http.ts. Requirement: FR-34.\",\n    \"pagination\": \"?page (≥1, default 1) & ?pageSize (default 20, max 100 via parsePagination; GET /api/announcements/manage clamps to 50 because it computes live reach per row). Requirements: FR-17, FR-23, FR-31.\",\n    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } }. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, RATE_LIMITED 429, INTERNAL 500. Requirement: FR-34.\",\n    \"accessErrors\": \"Targeting violations on create, update and preview return 403 FORBIDDEN (AC-3). STUDENT/PARENT on ADMIN/TEACHER routes get 403 from requireRole (FR-11). Callers who may not see a specific announcement (non-member, non-author, or not yet visible) get 404 NOT_FOUND on detail, ack, stats, remind, PATCH and archive, so its existence is not leaked (system-design A10). Requirements: NFR-3, NFR-6.\",\n    \"dates\": \"All timestamps are ISO 8601 UTC strings. The composer converts SchoolSettings.timezone input to UTC before sending. Clients display with formatInSchoolTz. Requirement: NFR-7.\",\n    \"visibility\": \"visible = status ∈ {SCHEDULED, PUBLISHED} ∧ publishAt ≤ now ∧ (expiresAt null ∨ expiresAt > now), evaluated at read time. Requirements: FR-16, NFR-6.\",\n    \"sanitisation\": \"`body` is raw Markdown, rendered client-side only through MarkdownView (rehype-sanitize). `excerpt` is plain text from toPlainText and must be rendered as escaped text. Requirement: NFR-4.\"\n  },\n\n  \"components\": {\n    \"AudienceRow\": {\n      \"description\": \"Generic audience row (FR-8). refId is required unless the type is SCHOOL or STAFF. For ROLE it must be a Role value. For GRADE_LEVEL, SECTION and COURSE, at least one include flag must be true. Requirements: FR-1, FR-3..FR-6.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"type\": { \"enum\": [\"SCHOOL\", \"STAFF\", \"ROLE\", \"GRADE_LEVEL\", \"SECTION\", \"COURSE\"] },\n        \"refId\": { \"type\": [\"string\", \"null\"], \"description\": \"GradeLevel.id | Section.id | Course.id | Role value\" },\n        \"includeStudents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeParents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeTeachers\": { \"type\": \"boolean\", \"default\": true }\n      },\n      \"required\": [\"type\"]\n    },\n    \"AnnouncementInput\": {\n      \"description\": \"Body of POST /api/announcements. Mirrors announcementInputSchema. Requirements: FR-2, FR-13, FR-15, FR-16.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150, \"description\": \"Trimmed\" },\n        \"body\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 20000, \"description\": \"Markdown\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"minItems\": 0, \"maxItems\": 20 },\n        \"pinned\": { \"type\": \"boolean\", \"default\": false },\n        \"requiresAck\": { \"type\": \"boolean\", \"default\": false },\n        \"isPublic\": { \"type\": \"boolean\", \"default\": false, \"description\": \"ADMIN only. true from a TEACHER → 403 (FR-10)\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"], \"description\": \"FileObject id uploaded with context 'announcement'\" },\n        \"attachmentFileIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"maxItems\": 10, \"default\": [] },\n        \"mode\": { \"enum\": [\"draft\", \"publish\", \"schedule\"] },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Required and > now when mode = schedule. Ignored for publish (set to now)\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Must be > (publishAt ?? now)\" }\n      },\n      \"required\": [\"title\", \"body\", \"audiences\", \"mode\"]\n    },\n    \"AnnouncementPatch\": {\n      \"description\": \"AnnouncementInput with every field optional (announcementPatchSchema). audiences, when present, replaces all rows. Requirements: FR-12, FR-29.\",\n      \"type\": \"object\",\n      \"allOf\": [{ \"$ref\": \"#/components/AnnouncementInput\" }],\n      \"required\": []\n    },\n    \"Author\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\"] }\n      },\n      \"required\": [\"id\", \"name\", \"role\"]\n    },\n    \"Attachment\": {\n      \"description\": \"Download via the existing GET /api/files/:id, gated by the 'announcement' file context (FR-30).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"description\": \"FileObject id\" },\n        \"name\": { \"type\": \"string\" },\n        \"mimeType\": { \"type\": \"string\" },\n        \"size\": { \"type\": \"integer\" }\n      },\n      \"required\": [\"id\", \"name\"]\n    },\n    \"FeedItem\": {\n      \"description\": \"Feed card DTO. Requirements: FR-17, FR-18, FR-22, NFR-5.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"excerpt\": { \"type\": \"string\", \"maxLength\": 200, \"description\": \"Plain text (toPlainText(body, 200))\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"pinned\": { \"type\": \"boolean\", \"description\": \"true only for the ≤3 items lifted to the top of page 1\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"Audience chips, e.g. 'Grade 7 · Parents'\" },\n        \"attachmentCount\": { \"type\": \"integer\" },\n        \"unread\": { \"type\": \"boolean\", \"description\": \"No AnnouncementRead.readAt for the caller. UI shows a dot with visually hidden text 'Unread'\" },\n        \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"forChildren\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" } } }, \"description\": \"PARENT callers only; empty otherwise. The linked children that put the parent in a GRADE_LEVEL, SECTION or COURSE audience ('For Sam')\" }\n      },\n      \"required\": [\"id\", \"title\", \"excerpt\", \"author\", \"publishAt\", \"pinned\", \"requiresAck\", \"labels\", \"attachmentCount\", \"unread\", \"forChildren\"]\n    },\n    \"AnnouncementDetail\": {\n      \"description\": \"Full record for detail and edit. Requirements: FR-13, FR-19, FR-20.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown. Render only via MarkdownView\" },\n        \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n        \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"description\": \"Returned only when canEdit; [] otherwise\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n        \"pinned\": { \"type\": \"boolean\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"isPublic\": { \"type\": \"boolean\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"attachments\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/Attachment\" } },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"myRead\": { \"type\": [\"object\", \"null\"], \"properties\": { \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" } }, \"description\": \"null when the caller is not an audience member (for example an admin outside the audience)\" },\n        \"canEdit\": { \"type\": \"boolean\", \"description\": \"ADMIN, or the author while not ARCHIVED\" },\n        \"canViewStats\": { \"type\": \"boolean\", \"description\": \"ADMIN or the author\" }\n      },\n      \"required\": [\"id\", \"title\", \"body\", \"status\", \"displayStatus\", \"author\", \"labels\", \"pinned\", \"requiresAck\", \"isPublic\", \"attachments\", \"canEdit\", \"canViewStats\"]\n    },\n    \"AudienceCounts\": {\n      \"description\": \"Requirements: FR-14, FR-15.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"total\": { \"type\": \"integer\" },\n        \"byRole\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"STUDENT\": { \"type\": \"integer\" },\n            \"PARENT\": { \"type\": \"integer\" },\n            \"TEACHER\": { \"type\": \"integer\" },\n            \"ADMIN\": { \"type\": \"integer\" }\n          },\n          \"required\": [\"STUDENT\", \"PARENT\", \"TEACHER\", \"ADMIN\"]\n        }\n      },\n      \"required\": [\"total\", \"byRole\"]\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Feed for the caller (any authenticated role). Only visible announcements whose audience includes the caller, resolved with audiences.some(audienceWhere(keys)) and never by expanding recipients (NFR-2). Page 1 starts with up to 3 pinned items (newest first, pinned=true), followed by the page of remaining items in publishAt desc, id desc order. meta.total excludes those lifted pins. Extra pinned items appear in date order with pinned=false (A4). With courseId, the caller must pass assertCanViewCourse (else 404) and results are limited to rows with a COURSE audience for that course. Expired, scheduled-future, draft and archived items are never returned.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {\n        \"query\": {\n          \"tab\": { \"enum\": [\"all\", \"unread\", \"ack\"], \"default\": \"all\", \"description\": \"unread = no readAt; ack = requiresAck and not acknowledged by the caller\" },\n          \"courseId\": { \"type\": \"string\", \"description\": \"Optional. Course 'Announcements' tab\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/FeedItem\" } },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (bad query)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (courseId the caller cannot view)\"],\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-21\", \"FR-22\", \"FR-34\", \"NFR-2\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Create an announcement. assertCanTarget(user, audiences, isPublic) runs first. A TEACHER may target only COURSE rows for courses where they are teacherId or in coTeacherIds, and SECTION rows for the section they homeroom. Anything else, or isPublic=true, returns 403. For mode publish or schedule, zero resolved recipients returns 400 VALIDATION_ERROR (details.reason='NO_RECIPIENTS'). Drafts may have zero recipients. A single transaction writes the announcement, audience rows and attachment rows and calls attachFiles. mode=publish sets status PUBLISHED and publishAt=now, then claimAndNotify sends announcement.published exactly once (generic-notification email, 300-character plain-text body, 'Read announcement' link to /announcements/:id, mandatoryInApp = requiresAck). mode=schedule sets status SCHEDULED and does not notify. mode=draft sets status DRAFT.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/components/AnnouncementInput\" } },\n      \"responseSchema\": {\n        \"status\": 201,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod: title > 150, body > 20,000, schedule without a future publishAt, expiresAt ≤ publishAt; or NO_RECIPIENTS on publish/schedule)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT; teacher targeting SCHOOL/STAFF/ROLE/GRADE_LEVEL, a foreign course or section, or isPublic)\", \"404 NOT_FOUND (coverFileId or attachment not owned by the caller or not uploaded)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-13\", \"FR-15\", \"FR-16\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/unread-count\",\n      \"description\": \"Sidebar badge count. Uses the same where clause as the feed's 'all' tab plus reads.none{userId, readAt not null}. Polled every 30 seconds, only while the page is visible.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-32\", \"FR-34\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/preview-audience\",\n      \"description\": \"Live recipient count for the composer ('Will reach 412 people: 180 students, 214 parents, 18 teachers'). assertCanTarget(user, audiences, false) runs first, so teachers cannot probe the size of audiences they cannot target. Then countAudienceByRole. ACTIVE, non-archived users only, deduplicated. The client debounces calls by 400 ms.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"body\": {\n          \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"maxItems\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AudienceCounts\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role, or teacher targeting violation)\"],\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-10\", \"FR-14\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/manage\",\n      \"description\": \"Manage list with no visibility filter, so it includes drafts, scheduled, expired and archived items. TEACHER sees authorId = me; ADMIN sees all. Ordered by updatedAt desc. reach, readPct and ackPct are computed live against the current resolveAudienceUserIds, and reads from users who have left the audience are excluded. Percentages are integers rounded half-up; they are null when reach is 0, and ackPct is null when requiresAck is false.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"], \"description\": \"Optional filter on displayStatus\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 50, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n                \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n                \"author\": { \"$ref\": \"#/components/Author\" },\n                \"audienceSummary\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"audienceLabels(rows)\" },\n                \"pinned\": { \"type\": \"boolean\" },\n                \"requiresAck\": { \"type\": \"boolean\" },\n                \"isPublic\": { \"type\": \"boolean\" },\n                \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"reach\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n              },\n              \"required\": [\"id\", \"title\", \"status\", \"displayStatus\", \"author\", \"audienceSummary\", \"reach\", \"readPct\", \"ackPct\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Detail. Allowed for ADMIN, the author (any status), or an audience member while the announcement is visible. Everyone else gets 404, including members before publishAt or after expiry. For audience members only, the call upserts AnnouncementRead.readAt and keeps the first readAt. The edit page (/announcements/:id/edit) uses the same endpoint and reads audiences from it when canEdit.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (missing, or not visible to the caller)\"],\n      \"requirementIds\": [\"FR-19\", \"FR-30\", \"FR-34\", \"NFR-4\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Update. Allowed for the author or ADMIN; others get 404. A non-admin editing an ARCHIVED row gets 409 CONFLICT (archive is terminal for authors). If audiences or isPublic is in the patch, assertCanTarget re-runs on the resulting values. audiences, when sent, replaces all rows. attachmentFileIds, when sent, re-syncs attachments (attaches new ones, detaches removed ones). A transition from DRAFT to publish or schedule re-checks for zero recipients and, for publish, calls claimAndNotify. Edits to an already-notified announcement, including audience changes, never re-notify, because notifiedAt is never cleared. An ADMIN editing someone else's announcement writes audit('announcement.update'). mode=draft on a PUBLISHED row returns 409 (unpublishing is done by archiving).\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"body\": { \"$ref\": \"#/components/AnnouncementPatch\" }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod or NO_RECIPIENTS)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role or targeting violation)\", \"404 NOT_FOUND (not author/admin)\", \"409 CONFLICT (author editing ARCHIVED; PUBLISHED → draft)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-15\", \"FR-27\", \"FR-29\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/archive\",\n      \"description\": \"Archive: sets status ARCHIVED. Allowed for the author or ADMIN; others get 404. Idempotent: archiving an already-archived row returns 200 with the current record. An ADMIN archiving someone else's announcement writes audit('announcement.archive').\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"id\": \"string\", \"status\": \"ARCHIVED\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/ack\",\n      \"description\": \"Acknowledge. Requires a visible announcement and audience membership; otherwise 404. A row with requiresAck=false returns 409. Upserts AnnouncementRead, sets acknowledgedAt once and also sets readAt if it was empty. Repeat calls are idempotent and return the original acknowledgedAt. The UI shows 'Acknowledged on 14 Sep' in the school timezone.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"readAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not visible or not a member)\", \"409 CONFLICT (requiresAck=false)\"],\n      \"requirementIds\": [\"FR-20\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id/stats\",\n      \"description\": \"Per-announcement stats. Allowed for the author or ADMIN; others get 404. Recipients come from the live resolveAudienceUserIds, left-joined to AnnouncementRead. The counts always describe the full audience, while the filter applies only to the rows. With format=csv, the response is text/csv with Content-Disposition: attachment; filename=\\\"announcement-<id>-recipients.csv\\\", built by toCsv from src/server/csv.ts with the columns Name, Role, Read at and Acknowledged at, dates in the school timezone, and the filter applied. Rows are sorted by name.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"query\": {\n          \"filter\": { \"enum\": [\"unread\", \"unacked\"], \"description\": \"Optional. unacked is only meaningful when requiresAck\" },\n          \"format\": { \"enum\": [\"csv\"], \"description\": \"Optional\" }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"counts\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"recipients\": { \"type\": \"integer\" },\n                \"read\": { \"type\": \"integer\" },\n                \"acknowledged\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"Rounded half-up; null when recipients is 0\" },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"null when !requiresAck or recipients is 0. AC-5: 30/50 → 60\" }\n              }\n            },\n            \"requiresAck\": { \"type\": \"boolean\" },\n            \"lastRemindedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n            \"rows\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"userId\": { \"type\": \"string\" },\n                  \"name\": { \"type\": \"string\" },\n                  \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"] },\n                  \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                  \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n                }\n              }\n            }\n          }\n        },\n        \"csvVariant\": \"200 text/csv; charset=utf-8 (no JSON envelope)\"\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND (not author/admin)\"],\n      \"requirementIds\": [\"FR-24\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/remind\",\n      \"description\": \"Send a reminder to recipients who have not acknowledged. Allowed for the author or ADMIN; others get 404. The announcement must have requiresAck and be visible; otherwise 409. The throttle is claimed atomically: updateMany where lastRemindedAt is null or ≤ now − 24h sets lastRemindedAt = now. If no row is claimed, the response is 429 RATE_LIMITED with details.retryAfter (ISO, lastRemindedAt + 24h). Otherwise it calls notify('announcement.reminder', mandatoryInApp) for recipients minus acknowledged users. If nobody is left to remind, it still claims the throttle and returns notified: 0. AC-5: 50 recipients with 30 acknowledged → notified 20.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"notified\": { \"type\": \"integer\" }, \"remindedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\", \"409 CONFLICT (!requiresAck or not visible)\", \"429 RATE_LIMITED { details: { retryAfter } }\"],\n      \"requirementIds\": [\"FR-25\", \"FR-26\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/public/news\",\n      \"description\": \"Public news for the future PRD-18 website. No authentication. The path is added to PUBLIC_API_PATHS in src/config/public-routes.ts. Rate-limited by client IP with the existing src/server/rate-limit.ts, which returns 429 RATE_LIMITED. Returns isPublic ∧ visible announcements, newest first. The DTO deliberately omits author identity, audience and read data. Cover images and attachments are served through GET /api/files/:id, which the 'announcement' file resolver allows anonymously only for public, visible announcements.\",\n      \"auth\": \"none (public)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"excerpt\": { \"type\": \"string\", \"maxLength\": 200 },\n                \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown; consumers must sanitise (MarkdownView)\" },\n                \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n                \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n                \"attachments\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } }\n              },\n              \"required\": [\"id\", \"title\", \"excerpt\", \"body\", \"publishAt\", \"attachments\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"429 RATE_LIMITED\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-34\", \"NFR-4\", \"NFR-9\"]\n    }\n  ],\n\n  \"internalHooks\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"Existing endpoint, gated by CRON_SECRET; its contract is unchanged. It gains an isolated publishDueAnnouncements(now) pass (findMany SCHEDULED ∧ notifiedAt null ∧ publishAt ≤ now, take 50 → claimAndNotify each). The pass is idempotent under concurrent runs. The response may add an 'announcementsPublished' integer next to the existing counters.\",\n      \"requirementIds\": [\"FR-27\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/files/:id\",\n      \"description\": \"Existing endpoint; its contract is unchanged. It gains the new 'announcement' access context: allowed for anyone (including anonymous callers) if isPublic ∧ visible; otherwise for ADMIN, the author, or a member while visible; otherwise denied.\",\n      \"requirementIds\": [\"FR-30\", \"NFR-6\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2053,"cache_read_input_tokens":56781,"cache_creation":{"ephemeral_5m_input_tokens":2053,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76e7b8df-be53-412b-af2c-ced0a46be4d2","uuid":"96e6572f-c5c4-4010-830b-c0d1169f5b3d","timestamp":"2026-11-09T16:36:13.053Z","request_id":"req_011CgsgHSxijGsMPXReTHiVr","wire_tool_inputs":{"toolu_01Reu5oGDadoh7GUKVbuwA64":{"file_path":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-12\",\n  \"timestamp\": \"2026-11-09T19:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the SH-11 contracts that were here before.\",\n    \"basePath\": \"/api (the existing SchoolHub convention, not /api/v1). Route files are src/app/api/**/route.ts. Requirement: FR-34.\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with a Zod schema from src/lib/validators/announcements.ts → one call into src/server/announcements/announcements-service.ts → ok(data) / ok(data, {status: 201}) / paginated(data, meta). No business logic in routes. Requirements: FR-34, FR-36, NFR-8.\",\n    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. Paginated endpoints return { \\\"data\\\": [...], \\\"meta\\\": { page, pageSize, total } } via paginated() in src/server/http.ts. Requirement: FR-34.\",\n    \"pagination\": \"?page (≥1, default 1) & ?pageSize (default 20, max 100 via parsePagination; GET /api/announcements/manage clamps to 50 because it computes live reach per row). Requirements: FR-17, FR-23, FR-31.\",\n    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } }. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, RATE_LIMITED 429, INTERNAL 500. Requirement: FR-34.\",\n    \"accessErrors\": \"Targeting violations on create, update and preview return 403 FORBIDDEN (AC-3). STUDENT/PARENT on ADMIN/TEACHER routes get 403 from requireRole (FR-11). Callers who may not see a specific announcement (non-member, non-author, or not yet visible) get 404 NOT_FOUND on detail, ack, stats, remind, PATCH and archive, so its existence is not leaked (system-design A10). Requirements: NFR-3, NFR-6.\",\n    \"dates\": \"All timestamps are ISO 8601 UTC strings. The composer converts SchoolSettings.timezone input to UTC before sending. Clients display with formatInSchoolTz. Requirement: NFR-7.\",\n    \"visibility\": \"visible = status ∈ {SCHEDULED, PUBLISHED} ∧ publishAt ≤ now ∧ (expiresAt null ∨ expiresAt > now), evaluated at read time. Requirements: FR-16, NFR-6.\",\n    \"sanitisation\": \"`body` is raw Markdown, rendered client-side only through MarkdownView (rehype-sanitize). `excerpt` is plain text from toPlainText and must be rendered as escaped text. Requirement: NFR-4.\"\n  },\n\n  \"components\": {\n    \"AudienceRow\": {\n      \"description\": \"Generic audience row (FR-8). refId is required unless the type is SCHOOL or STAFF. For ROLE it must be a Role value. For GRADE_LEVEL, SECTION and COURSE, at least one include flag must be true. Requirements: FR-1, FR-3..FR-6.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"type\": { \"enum\": [\"SCHOOL\", \"STAFF\", \"ROLE\", \"GRADE_LEVEL\", \"SECTION\", \"COURSE\"] },\n        \"refId\": { \"type\": [\"string\", \"null\"], \"description\": \"GradeLevel.id | Section.id | Course.id | Role value\" },\n        \"includeStudents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeParents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeTeachers\": { \"type\": \"boolean\", \"default\": true }\n      },\n      \"required\": [\"type\"]\n    },\n    \"AnnouncementInput\": {\n      \"description\": \"Body of POST /api/announcements. Mirrors announcementInputSchema. Requirements: FR-2, FR-13, FR-15, FR-16.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150, \"description\": \"Trimmed\" },\n        \"body\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 20000, \"description\": \"Markdown\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"minItems\": 0, \"maxItems\": 20 },\n        \"pinned\": { \"type\": \"boolean\", \"default\": false },\n        \"requiresAck\": { \"type\": \"boolean\", \"default\": false },\n        \"isPublic\": { \"type\": \"boolean\", \"default\": false, \"description\": \"ADMIN only. true from a TEACHER → 403 (FR-10)\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"], \"description\": \"FileObject id uploaded with context 'announcement'\" },\n        \"attachmentFileIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"maxItems\": 10, \"default\": [] },\n        \"mode\": { \"enum\": [\"draft\", \"publish\", \"schedule\"] },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Required and > now when mode = schedule. Ignored for publish (set to now)\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Must be > (publishAt ?? now)\" }\n      },\n      \"required\": [\"title\", \"body\", \"audiences\", \"mode\"]\n    },\n    \"AnnouncementPatch\": {\n      \"description\": \"AnnouncementInput with every field optional (announcementPatchSchema). audiences, when present, replaces all rows. Requirements: FR-12, FR-29.\",\n      \"type\": \"object\",\n      \"allOf\": [{ \"$ref\": \"#/components/AnnouncementInput\" }],\n      \"required\": []\n    },\n    \"Author\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\"] }\n      },\n      \"required\": [\"id\", \"name\", \"role\"]\n    },\n    \"Attachment\": {\n      \"description\": \"Download via the existing GET /api/files/:id, gated by the 'announcement' file context (FR-30).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"description\": \"FileObject id\" },\n        \"name\": { \"type\": \"string\" },\n        \"mimeType\": { \"type\": \"string\" },\n        \"size\": { \"type\": \"integer\" }\n      },\n      \"required\": [\"id\", \"name\"]\n    },\n    \"FeedItem\": {\n      \"description\": \"Feed card DTO. Requirements: FR-17, FR-18, FR-22, NFR-5.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"excerpt\": { \"type\": \"string\", \"maxLength\": 200, \"description\": \"Plain text (toPlainText(body, 200))\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"pinned\": { \"type\": \"boolean\", \"description\": \"true only for the ≤3 items lifted to the top of page 1\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"Audience chips, e.g. 'Grade 7 · Parents'\" },\n        \"attachmentCount\": { \"type\": \"integer\" },\n        \"unread\": { \"type\": \"boolean\", \"description\": \"No AnnouncementRead.readAt for the caller. UI shows a dot with visually hidden text 'Unread'\" },\n        \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"forChildren\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" } } }, \"description\": \"PARENT callers only; empty otherwise. The linked children that put the parent in a GRADE_LEVEL, SECTION or COURSE audience ('For Sam')\" }\n      },\n      \"required\": [\"id\", \"title\", \"excerpt\", \"author\", \"publishAt\", \"pinned\", \"requiresAck\", \"labels\", \"attachmentCount\", \"unread\", \"forChildren\"]\n    },\n    \"AnnouncementDetail\": {\n      \"description\": \"Full record for detail and edit. Requirements: FR-13, FR-19, FR-20.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown. Render only via MarkdownView\" },\n        \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n        \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"description\": \"Returned only when canEdit; [] otherwise\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n        \"pinned\": { \"type\": \"boolean\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"isPublic\": { \"type\": \"boolean\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"attachments\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/Attachment\" } },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"myRead\": { \"type\": [\"object\", \"null\"], \"properties\": { \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" } }, \"description\": \"null when the caller is not an audience member (for example an admin outside the audience)\" },\n        \"canEdit\": { \"type\": \"boolean\", \"description\": \"ADMIN, or the author while not ARCHIVED\" },\n        \"canViewStats\": { \"type\": \"boolean\", \"description\": \"ADMIN or the author\" }\n      },\n      \"required\": [\"id\", \"title\", \"body\", \"status\", \"displayStatus\", \"author\", \"labels\", \"pinned\", \"requiresAck\", \"isPublic\", \"attachments\", \"canEdit\", \"canViewStats\"]\n    },\n    \"AudienceCounts\": {\n      \"description\": \"Requirements: FR-14, FR-15.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"total\": { \"type\": \"integer\" },\n        \"byRole\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"STUDENT\": { \"type\": \"integer\" },\n            \"PARENT\": { \"type\": \"integer\" },\n            \"TEACHER\": { \"type\": \"integer\" },\n            \"ADMIN\": { \"type\": \"integer\" }\n          },\n          \"required\": [\"STUDENT\", \"PARENT\", \"TEACHER\", \"ADMIN\"]\n        }\n      },\n      \"required\": [\"total\", \"byRole\"]\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Feed for the caller (any authenticated role). Only visible announcements whose audience includes the caller, resolved with audiences.some(audienceWhere(keys)) and never by expanding recipients (NFR-2). Page 1 starts with up to 3 pinned items (newest first, pinned=true), followed by the page of remaining items in publishAt desc, id desc order. meta.total excludes those lifted pins. Extra pinned items appear in date order with pinned=false (A4). With courseId, the caller must pass assertCanViewCourse (else 404) and results are limited to rows with a COURSE audience for that course. Expired, scheduled-future, draft and archived items are never returned.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {\n        \"query\": {\n          \"tab\": { \"enum\": [\"all\", \"unread\", \"ack\"], \"default\": \"all\", \"description\": \"unread = no readAt; ack = requiresAck and not acknowledged by the caller\" },\n          \"courseId\": { \"type\": \"string\", \"description\": \"Optional. Course 'Announcements' tab\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/FeedItem\" } },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (bad query)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (courseId the caller cannot view)\"],\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-21\", \"FR-22\", \"FR-34\", \"NFR-2\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Create an announcement. assertCanTarget(user, audiences, isPublic) runs first. A TEACHER may target only COURSE rows for courses where they are teacherId or in coTeacherIds, and SECTION rows for the section they homeroom. Anything else, or isPublic=true, returns 403. For mode publish or schedule, zero resolved recipients returns 400 VALIDATION_ERROR (details.reason='NO_RECIPIENTS'). Drafts may have zero recipients. A single transaction writes the announcement, audience rows and attachment rows and calls attachFiles. mode=publish sets status PUBLISHED and publishAt=now, then claimAndNotify sends announcement.published exactly once (generic-notification email, 300-character plain-text body, 'Read announcement' link to /announcements/:id, mandatoryInApp = requiresAck). mode=schedule sets status SCHEDULED and does not notify. mode=draft sets status DRAFT.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/components/AnnouncementInput\" } },\n      \"responseSchema\": {\n        \"status\": 201,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod: title > 150, body > 20,000, schedule without a future publishAt, expiresAt ≤ publishAt; or NO_RECIPIENTS on publish/schedule)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT; teacher targeting SCHOOL/STAFF/ROLE/GRADE_LEVEL, a foreign course or section, or isPublic)\", \"404 NOT_FOUND (coverFileId or attachment not owned by the caller or not uploaded)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-13\", \"FR-15\", \"FR-16\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/unread-count\",\n      \"description\": \"Sidebar badge count. Uses the same where clause as the feed's 'all' tab plus reads.none{userId, readAt not null}. Polled every 30 seconds, only while the page is visible.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-32\", \"FR-34\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/preview-audience\",\n      \"description\": \"Live recipient count for the composer ('Will reach 412 people: 180 students, 214 parents, 18 teachers'). assertCanTarget(user, audiences, false) runs first, so teachers cannot probe the size of audiences they cannot target. Then countAudienceByRole. ACTIVE, non-archived users only, deduplicated. The client debounces calls by 400 ms.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"body\": {\n          \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"maxItems\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AudienceCounts\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role, or teacher targeting violation)\"],\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-10\", \"FR-14\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/manage\",\n      \"description\": \"Manage list with no visibility filter, so it includes drafts, scheduled, expired and archived items. TEACHER sees authorId = me; ADMIN sees all. Ordered by updatedAt desc. reach, readPct and ackPct are computed live against the current resolveAudienceUserIds, and reads from users who have left the audience are excluded. Percentages are integers rounded half-up; they are null when reach is 0, and ackPct is null when requiresAck is false.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"], \"description\": \"Optional filter on displayStatus\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 50, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n                \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n                \"author\": { \"$ref\": \"#/components/Author\" },\n                \"audienceSummary\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"audienceLabels(rows)\" },\n                \"pinned\": { \"type\": \"boolean\" },\n                \"requiresAck\": { \"type\": \"boolean\" },\n                \"isPublic\": { \"type\": \"boolean\" },\n                \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"reach\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n              },\n              \"required\": [\"id\", \"title\", \"status\", \"displayStatus\", \"author\", \"audienceSummary\", \"reach\", \"readPct\", \"ackPct\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Detail. Allowed for ADMIN, the author (any status), or an audience member while the announcement is visible. Everyone else gets 404, including members before publishAt or after expiry. For audience members only, the call upserts AnnouncementRead.readAt and keeps the first readAt. The edit page (/announcements/:id/edit) uses the same endpoint and reads audiences from it when canEdit.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (missing, or not visible to the caller)\"],\n      \"requirementIds\": [\"FR-19\", \"FR-30\", \"FR-34\", \"NFR-4\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Update. Allowed for the author or ADMIN; others get 404. A non-admin editing an ARCHIVED row gets 409 CONFLICT (archive is terminal for authors). If audiences or isPublic is in the patch, assertCanTarget re-runs on the resulting values. audiences, when sent, replaces all rows. attachmentFileIds, when sent, re-syncs attachments (attaches new ones, detaches removed ones). A transition from DRAFT to publish or schedule re-checks for zero recipients and, for publish, calls claimAndNotify. Edits to an already-notified announcement, including audience changes, never re-notify, because notifiedAt is never cleared. An ADMIN editing someone else's announcement writes audit('announcement.update'). mode=draft on a PUBLISHED row returns 409 (unpublishing is done by archiving).\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"body\": { \"$ref\": \"#/components/AnnouncementPatch\" }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod or NO_RECIPIENTS)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role or targeting violation)\", \"404 NOT_FOUND (not author/admin)\", \"409 CONFLICT (author editing ARCHIVED; PUBLISHED → draft)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-15\", \"FR-27\", \"FR-29\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/archive\",\n      \"description\": \"Archive: sets status ARCHIVED. Allowed for the author or ADMIN; others get 404. Idempotent: archiving an already-archived row returns 200 with the current record. An ADMIN archiving someone else's announcement writes audit('announcement.archive').\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"id\": \"string\", \"status\": \"ARCHIVED\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/ack\",\n      \"description\": \"Acknowledge. Requires a visible announcement and audience membership; otherwise 404. A row with requiresAck=false returns 409. Upserts AnnouncementRead, sets acknowledgedAt once and also sets readAt if it was empty. Repeat calls are idempotent and return the original acknowledgedAt. The UI shows 'Acknowledged on 14 Sep' in the school timezone.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"readAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not visible or not a member)\", \"409 CONFLICT (requiresAck=false)\"],\n      \"requirementIds\": [\"FR-20\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id/stats\",\n      \"description\": \"Per-announcement stats. Allowed for the author or ADMIN; others get 404. Recipients come from the live resolveAudienceUserIds, left-joined to AnnouncementRead. The counts always describe the full audience, while the filter applies only to the rows. With format=csv, the response is text/csv with Content-Disposition: attachment; filename=\\\"announcement-<id>-recipients.csv\\\", built by toCsv from src/server/csv.ts with the columns Name, Role, Read at and Acknowledged at, dates in the school timezone, and the filter applied. Rows are sorted by name.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"query\": {\n          \"filter\": { \"enum\": [\"unread\", \"unacked\"], \"description\": \"Optional. unacked is only meaningful when requiresAck\" },\n          \"format\": { \"enum\": [\"csv\"], \"description\": \"Optional\" }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"counts\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"recipients\": { \"type\": \"integer\" },\n                \"read\": { \"type\": \"integer\" },\n                \"acknowledged\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"Rounded half-up; null when recipients is 0\" },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"null when !requiresAck or recipients is 0. AC-5: 30/50 → 60\" }\n              }\n            },\n            \"requiresAck\": { \"type\": \"boolean\" },\n            \"lastRemindedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n            \"rows\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"userId\": { \"type\": \"string\" },\n                  \"name\": { \"type\": \"string\" },\n                  \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"] },\n                  \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                  \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n                }\n              }\n            }\n          }\n        },\n        \"csvVariant\": \"200 text/csv; charset=utf-8 (no JSON envelope)\"\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND (not author/admin)\"],\n      \"requirementIds\": [\"FR-24\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/remind\",\n      \"description\": \"Send a reminder to recipients who have not acknowledged. Allowed for the author or ADMIN; others get 404. The announcement must have requiresAck and be visible; otherwise 409. The throttle is claimed atomically: updateMany where lastRemindedAt is null or ≤ now − 24h sets lastRemindedAt = now. If no row is claimed, the response is 429 RATE_LIMITED with details.retryAfter (ISO, lastRemindedAt + 24h). Otherwise it calls notify('announcement.reminder', mandatoryInApp) for recipients minus acknowledged users. If nobody is left to remind, it still claims the throttle and returns notified: 0. AC-5: 50 recipients with 30 acknowledged → notified 20.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"notified\": { \"type\": \"integer\" }, \"remindedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\", \"409 CONFLICT (!requiresAck or not visible)\", \"429 RATE_LIMITED { details: { retryAfter } }\"],\n      \"requirementIds\": [\"FR-25\", \"FR-26\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/public/news\",\n      \"description\": \"Public news for the future PRD-18 website. No authentication. The path is added to PUBLIC_API_PATHS in src/config/public-routes.ts. Rate-limited by client IP with the existing src/server/rate-limit.ts, which returns 429 RATE_LIMITED. Returns isPublic ∧ visible announcements, newest first. The DTO deliberately omits author identity, audience and read data. Cover images and attachments are served through GET /api/files/:id, which the 'announcement' file resolver allows anonymously only for public, visible announcements.\",\n      \"auth\": \"none (public)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"excerpt\": { \"type\": \"string\", \"maxLength\": 200 },\n                \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown; consumers must sanitise (MarkdownView)\" },\n                \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n                \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n                \"attachments\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } }\n              },\n              \"required\": [\"id\", \"title\", \"excerpt\", \"body\", \"publishAt\", \"attachments\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"429 RATE_LIMITED\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-34\", \"NFR-4\", \"NFR-9\"]\n    }\n  ],\n\n  \"internalHooks\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"Existing endpoint, gated by CRON_SECRET; its contract is unchanged. It gains an isolated publishDueAnnouncements(now) pass (findMany SCHEDULED ∧ notifiedAt null ∧ publishAt ≤ now, take 50 → claimAndNotify each). The pass is idempotent under concurrent runs. The response may add an 'announcementsPublished' integer next to the existing counters.\",\n      \"requirementIds\": [\"FR-27\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/files/:id\",\n      \"description\": \"Existing endpoint; its contract is unchanged. It gains the new 'announcement' access context: allowed for anyone (including anonymous callers) if isPublic ∧ visible; otherwise for ADMIN, the author, or a member while visible; otherwise denied.\",\n      \"requirementIds\": [\"FR-30\", \"NFR-6\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Reu5oGDadoh7GUKVbuwA64","type":"tool_result","content":"The file /Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"76e7b8df-be53-412b-af2c-ced0a46be4d2","uuid":"9a65b520-aaec-47ae-adad-e613a7ddec99","timestamp":"2026-11-09T16:36:13.160Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-12\",\n  \"timestamp\": \"2026-11-09T19:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the SH-11 contracts that were here before.\",\n    \"basePath\": \"/api (the existing SchoolHub convention, not /api/v1). Route files are src/app/api/**/route.ts. Requirement: FR-34.\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with a Zod schema from src/lib/validators/announcements.ts → one call into src/server/announcements/announcements-service.ts → ok(data) / ok(data, {status: 201}) / paginated(data, meta). No business logic in routes. Requirements: FR-34, FR-36, NFR-8.\",\n    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. Paginated endpoints return { \\\"data\\\": [...], \\\"meta\\\": { page, pageSize, total } } via paginated() in src/server/http.ts. Requirement: FR-34.\",\n    \"pagination\": \"?page (≥1, default 1) & ?pageSize (default 20, max 100 via parsePagination; GET /api/announcements/manage clamps to 50 because it computes live reach per row). Requirements: FR-17, FR-23, FR-31.\",\n    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } }. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, RATE_LIMITED 429, INTERNAL 500. Requirement: FR-34.\",\n    \"accessErrors\": \"Targeting violations on create, update and preview return 403 FORBIDDEN (AC-3). STUDENT/PARENT on ADMIN/TEACHER routes get 403 from requireRole (FR-11). Callers who may not see a specific announcement (non-member, non-author, or not yet visible) get 404 NOT_FOUND on detail, ack, stats, remind, PATCH and archive, so its existence is not leaked (system-design A10). Requirements: NFR-3, NFR-6.\",\n    \"dates\": \"All timestamps are ISO 8601 UTC strings. The composer converts SchoolSettings.timezone input to UTC before sending. Clients display with formatInSchoolTz. Requirement: NFR-7.\",\n    \"visibility\": \"visible = status ∈ {SCHEDULED, PUBLISHED} ∧ publishAt ≤ now ∧ (expiresAt null ∨ expiresAt > now), evaluated at read time. Requirements: FR-16, NFR-6.\",\n    \"sanitisation\": \"`body` is raw Markdown, rendered client-side only through MarkdownView (rehype-sanitize). `excerpt` is plain text from toPlainText and must be rendered as escaped text. Requirement: NFR-4.\"\n  },\n\n  \"components\": {\n    \"AudienceRow\": {\n      \"description\": \"Generic audience row (FR-8). refId is required unless the type is SCHOOL or STAFF. For ROLE it must be a Role value. For GRADE_LEVEL, SECTION and COURSE, at least one include flag must be true. Requirements: FR-1, FR-3..FR-6.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"type\": { \"enum\": [\"SCHOOL\", \"STAFF\", \"ROLE\", \"GRADE_LEVEL\", \"SECTION\", \"COURSE\"] },\n        \"refId\": { \"type\": [\"string\", \"null\"], \"description\": \"GradeLevel.id | Section.id | Course.id | Role value\" },\n        \"includeStudents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeParents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeTeachers\": { \"type\": \"boolean\", \"default\": true }\n      },\n      \"required\": [\"type\"]\n    },\n    \"AnnouncementInput\": {\n      \"description\": \"Body of POST /api/announcements. Mirrors announcementInputSchema. Requirements: FR-2, FR-13, FR-15, FR-16.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150, \"description\": \"Trimmed\" },\n        \"body\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 20000, \"description\": \"Markdown\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"minItems\": 0, \"maxItems\": 20 },\n        \"pinned\": { \"type\": \"boolean\", \"default\": false },\n        \"requiresAck\": { \"type\": \"boolean\", \"default\": false },\n        \"isPublic\": { \"type\": \"boolean\", \"default\": false, \"description\": \"ADMIN only. true from a TEACHER → 403 (FR-10)\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"], \"description\": \"FileObject id uploaded with context 'announcement'\" },\n        \"attachmentFileIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"maxItems\": 10, \"default\": [] },\n        \"mode\": { \"enum\": [\"draft\", \"publish\", \"schedule\"] },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Required and > now when mode = schedule. Ignored for publish (set to now)\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Must be > (publishAt ?? now)\" }\n      },\n      \"required\": [\"title\", \"body\", \"audiences\", \"mode\"]\n    },\n    \"AnnouncementPatch\": {\n      \"description\": \"AnnouncementInput with every field optional (announcementPatchSchema). audiences, when present, replaces all rows. Requirements: FR-12, FR-29.\",\n      \"type\": \"object\",\n      \"allOf\": [{ \"$ref\": \"#/components/AnnouncementInput\" }],\n      \"required\": []\n    },\n    \"Author\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\"] }\n      },\n      \"required\": [\"id\", \"name\", \"role\"]\n    },\n    \"Attachment\": {\n      \"description\": \"Download via the existing GET /api/files/:id, gated by the 'announcement' file context (FR-30).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"description\": \"FileObject id\" },\n        \"name\": { \"type\": \"string\" },\n        \"mimeType\": { \"type\": \"string\" },\n        \"size\": { \"type\": \"integer\" }\n      },\n      \"required\": [\"id\", \"name\"]\n    },\n    \"FeedItem\": {\n      \"description\": \"Feed card DTO. Requirements: FR-17, FR-18, FR-22, NFR-5.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"excerpt\": { \"type\": \"string\", \"maxLength\": 200, \"description\": \"Plain text (toPlainText(body, 200))\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"pinned\": { \"type\": \"boolean\", \"description\": \"true only for the ≤3 items lifted to the top of page 1\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"Audience chips, e.g. 'Grade 7 · Parents'\" },\n        \"attachmentCount\": { \"type\": \"integer\" },\n        \"unread\": { \"type\": \"boolean\", \"description\": \"No AnnouncementRead.readAt for the caller. UI shows a dot with visually hidden text 'Unread'\" },\n        \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"forChildren\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" } } }, \"description\": \"PARENT callers only; empty otherwise. The linked children that put the parent in a GRADE_LEVEL, SECTION or COURSE audience ('For Sam')\" }\n      },\n      \"required\": [\"id\", \"title\", \"excerpt\", \"author\", \"publishAt\", \"pinned\", \"requiresAck\", \"labels\", \"attachmentCount\", \"unread\", \"forChildren\"]\n    },\n    \"AnnouncementDetail\": {\n      \"description\": \"Full record for detail and edit. Requirements: FR-13, FR-19, FR-20.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown. Render only via MarkdownView\" },\n        \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n        \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"description\": \"Returned only when canEdit; [] otherwise\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n        \"pinned\": { \"type\": \"boolean\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"isPublic\": { \"type\": \"boolean\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"attachments\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/Attachment\" } },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"myRead\": { \"type\": [\"object\", \"null\"], \"properties\": { \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" } }, \"description\": \"null when the caller is not an audience member (for example an admin outside the audience)\" },\n        \"canEdit\": { \"type\": \"boolean\", \"description\": \"ADMIN, or the author while not ARCHIVED\" },\n        \"canViewStats\": { \"type\": \"boolean\", \"description\": \"ADMIN or the author\" }\n      },\n      \"required\": [\"id\", \"title\", \"body\", \"status\", \"displayStatus\", \"author\", \"labels\", \"pinned\", \"requiresAck\", \"isPublic\", \"attachments\", \"canEdit\", \"canViewStats\"]\n    },\n    \"AudienceCounts\": {\n      \"description\": \"Requirements: FR-14, FR-15.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"total\": { \"type\": \"integer\" },\n        \"byRole\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"STUDENT\": { \"type\": \"integer\" },\n            \"PARENT\": { \"type\": \"integer\" },\n            \"TEACHER\": { \"type\": \"integer\" },\n            \"ADMIN\": { \"type\": \"integer\" }\n          },\n          \"required\": [\"STUDENT\", \"PARENT\", \"TEACHER\", \"ADMIN\"]\n        }\n      },\n      \"required\": [\"total\", \"byRole\"]\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Feed for the caller (any authenticated role). Only visible announcements whose audience includes the caller, resolved with audiences.some(audienceWhere(keys)) and never by expanding recipients (NFR-2). Page 1 starts with up to 3 pinned items (newest first, pinned=true), followed by the page of remaining items in publishAt desc, id desc order. meta.total excludes those lifted pins. Extra pinned items appear in date order with pinned=false (A4). With courseId, the caller must pass assertCanViewCourse (else 404) and results are limited to rows with a COURSE audience for that course. Expired, scheduled-future, draft and archived items are never returned.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {\n        \"query\": {\n          \"tab\": { \"enum\": [\"all\", \"unread\", \"ack\"], \"default\": \"all\", \"description\": \"unread = no readAt; ack = requiresAck and not acknowledged by the caller\" },\n          \"courseId\": { \"type\": \"string\", \"description\": \"Optional. Course 'Announcements' tab\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/FeedItem\" } },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (bad query)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (courseId the caller cannot view)\"],\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-21\", \"FR-22\", \"FR-34\", \"NFR-2\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Create an announcement. assertCanTarget(user, audiences, isPublic) runs first. A TEACHER may target only COURSE rows for courses where they are teacherId or in coTeacherIds, and SECTION rows for the section they homeroom. Anything else, or isPublic=true, returns 403. For mode publish or schedule, zero resolved recipients returns 400 VALIDATION_ERROR (details.reason='NO_RECIPIENTS'). Drafts may have zero recipients. A single transaction writes the announcement, audience rows and attachment rows and calls attachFiles. mode=publish sets status PUBLISHED and publishAt=now, then claimAndNotify sends announcement.published exactly once (generic-notification email, 300-character plain-text body, 'Read announcement' link to /announcements/:id, mandatoryInApp = requiresAck). mode=schedule sets status SCHEDULED and does not notify. mode=draft sets status DRAFT.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/components/AnnouncementInput\" } },\n      \"responseSchema\": {\n        \"status\": 201,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod: title > 150, body > 20,000, schedule without a future publishAt, expiresAt ≤ publishAt; or NO_RECIPIENTS on publish/schedule)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT; teacher targeting SCHOOL/STAFF/ROLE/GRADE_LEVEL, a foreign course or section, or isPublic)\", \"404 NOT_FOUND (coverFileId or attachment not owned by the caller or not uploaded)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-13\", \"FR-15\", \"FR-16\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/unread-count\",\n      \"description\": \"Sidebar badge count. Uses the same where clause as the feed's 'all' tab plus reads.none{userId, readAt not null}. Polled every 30 seconds, only while the page is visible.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-32\", \"FR-34\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/preview-audience\",\n      \"description\": \"Live recipient count for the composer ('Will reach 412 people: 180 students, 214 parents, 18 teachers'). assertCanTarget(user, audiences, false) runs first, so teachers cannot probe the size of audiences they cannot target. Then countAudienceByRole. ACTIVE, non-archived users only, deduplicated. The client debounces calls by 400 ms.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"body\": {\n          \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"maxItems\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AudienceCounts\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role, or teacher targeting violation)\"],\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-10\", \"FR-14\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/manage\",\n      \"description\": \"Manage list with no visibility filter, so it includes drafts, scheduled, expired and archived items. TEACHER sees authorId = me; ADMIN sees all. Ordered by updatedAt desc. reach, readPct and ackPct are computed live against the current resolveAudienceUserIds, and reads from users who have left the audience are excluded. Percentages are integers rounded half-up; they are null when reach is 0, and ackPct is null when requiresAck is false.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"], \"description\": \"Optional filter on displayStatus\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 50, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n                \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n                \"author\": { \"$ref\": \"#/components/Author\" },\n                \"audienceSummary\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"audienceLabels(rows)\" },\n                \"pinned\": { \"type\": \"boolean\" },\n                \"requiresAck\": { \"type\": \"boolean\" },\n                \"isPublic\": { \"type\": \"boolean\" },\n                \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"reach\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n              },\n              \"required\": [\"id\", \"title\", \"status\", \"displayStatus\", \"author\", \"audienceSummary\", \"reach\", \"readPct\", \"ackPct\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Detail. Allowed for ADMIN, the author (any status), or an audience member while the announcement is visible. Everyone else gets 404, including members before publishAt or after expiry. For audience members only, the call upserts AnnouncementRead.readAt and keeps the first readAt. The edit page (/announcements/:id/edit) uses the same endpoint and reads audiences from it when canEdit.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (missing, or not visible to the caller)\"],\n      \"requirementIds\": [\"FR-19\", \"FR-30\", \"FR-34\", \"NFR-4\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Update. Allowed for the author or ADMIN; others get 404. A non-admin editing an ARCHIVED row gets 409 CONFLICT (archive is terminal for authors). If audiences or isPublic is in the patch, assertCanTarget re-runs on the resulting values. audiences, when sent, replaces all rows. attachmentFileIds, when sent, re-syncs attachments (attaches new ones, detaches removed ones). A transition from DRAFT to publish or schedule re-checks for zero recipients and, for publish, calls claimAndNotify. Edits to an already-notified announcement, including audience changes, never re-notify, because notifiedAt is never cleared. An ADMIN editing someone else's announcement writes audit('announcement.update'). mode=draft on a PUBLISHED row returns 409 (unpublishing is done by archiving).\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"body\": { \"$ref\": \"#/components/AnnouncementPatch\" }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod or NO_RECIPIENTS)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role or targeting violation)\", \"404 NOT_FOUND (not author/admin)\", \"409 CONFLICT (author editing ARCHIVED; PUBLISHED → draft)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-15\", \"FR-27\", \"FR-29\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/archive\",\n      \"description\": \"Archive: sets status ARCHIVED. Allowed for the author or ADMIN; others get 404. Idempotent: archiving an already-archived row returns 200 with the current record. An ADMIN archiving someone else's announcement writes audit('announcement.archive').\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"id\": \"string\", \"status\": \"ARCHIVED\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/ack\",\n      \"description\": \"Acknowledge. Requires a visible announcement and audience membership; otherwise 404. A row with requiresAck=false returns 409. Upserts AnnouncementRead, sets acknowledgedAt once and also sets readAt if it was empty. Repeat calls are idempotent and return the original acknowledgedAt. The UI shows 'Acknowledged on 14 Sep' in the school timezone.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"readAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not visible or not a member)\", \"409 CONFLICT (requiresAck=false)\"],\n      \"requirementIds\": [\"FR-20\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id/stats\",\n      \"description\": \"Per-announcement stats. Allowed for the author or ADMIN; others get 404. Recipients come from the live resolveAudienceUserIds, left-joined to AnnouncementRead. The counts always describe the full audience, while the filter applies only to the rows. With format=csv, the response is text/csv with Content-Disposition: attachment; filename=\\\"announcement-<id>-recipients.csv\\\", built by toCsv from src/server/csv.ts with the columns Name, Role, Read at and Acknowledged at, dates in the school timezone, and the filter applied. Rows are sorted by name.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"query\": {\n          \"filter\": { \"enum\": [\"unread\", \"unacked\"], \"description\": \"Optional. unacked is only meaningful when requiresAck\" },\n          \"format\": { \"enum\": [\"csv\"], \"description\": \"Optional\" }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"counts\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"recipients\": { \"type\": \"integer\" },\n                \"read\": { \"type\": \"integer\" },\n                \"acknowledged\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"Rounded half-up; null when recipients is 0\" },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"null when !requiresAck or recipients is 0. AC-5: 30/50 → 60\" }\n              }\n            },\n            \"requiresAck\": { \"type\": \"boolean\" },\n            \"lastRemindedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n            \"rows\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"userId\": { \"type\": \"string\" },\n                  \"name\": { \"type\": \"string\" },\n                  \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"] },\n                  \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                  \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n                }\n              }\n            }\n          }\n        },\n        \"csvVariant\": \"200 text/csv; charset=utf-8 (no JSON envelope)\"\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND (not author/admin)\"],\n      \"requirementIds\": [\"FR-24\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/remind\",\n      \"description\": \"Send a reminder to recipients who have not acknowledged. Allowed for the author or ADMIN; others get 404. The announcement must have requiresAck and be visible; otherwise 409. The throttle is claimed atomically: updateMany where lastRemindedAt is null or ≤ now − 24h sets lastRemindedAt = now. If no row is claimed, the response is 429 RATE_LIMITED with details.retryAfter (ISO, lastRemindedAt + 24h). Otherwise it calls notify('announcement.reminder', mandatoryInApp) for recipients minus acknowledged users. If nobody is left to remind, it still claims the throttle and returns notified: 0. AC-5: 50 recipients with 30 acknowledged → notified 20.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"notified\": { \"type\": \"integer\" }, \"remindedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\", \"409 CONFLICT (!requiresAck or not visible)\", \"429 RATE_LIMITED { details: { retryAfter } }\"],\n      \"requirementIds\": [\"FR-25\", \"FR-26\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/public/news\",\n      \"description\": \"Public news for the future PRD-18 website. No authentication. The path is added to PUBLIC_API_PATHS in src/config/public-routes.ts. Rate-limited by client IP with the existing src/server/rate-limit.ts, which returns 429 RATE_LIMITED. Returns isPublic ∧ visible announcements, newest first. The DTO deliberately omits author identity, audience and read data. Cover images and attachments are served through GET /api/files/:id, which the 'announcement' file resolver allows anonymously only for public, visible announcements.\",\n      \"auth\": \"none (public)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"excerpt\": { \"type\": \"string\", \"maxLength\": 200 },\n                \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown; consumers must sanitise (MarkdownView)\" },\n                \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n                \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n                \"attachments\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } }\n              },\n              \"required\": [\"id\", \"title\", \"excerpt\", \"body\", \"publishAt\", \"attachments\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"429 RATE_LIMITED\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-34\", \"NFR-4\", \"NFR-9\"]\n    }\n  ],\n\n  \"internalHooks\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"Existing endpoint, gated by CRON_SECRET; its contract is unchanged. It gains an isolated publishDueAnnouncements(now) pass (findMany SCHEDULED ∧ notifiedAt null ∧ publishAt ≤ now, take 50 → claimAndNotify each). The pass is idempotent under concurrent runs. The response may add an 'announcementsPublished' integer next to the existing counters.\",\n      \"requirementIds\": [\"FR-27\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/files/:id\",\n      \"description\": \"Existing endpoint; its contract is unchanged. It gains the new 'announcement' access context: allowed for anyone (including anonymous callers) if isPublic ∧ visible; otherwise for ADMIN, the author, or a member while visible; otherwise denied.\",\n      \"requirementIds\": [\"FR-30\", \"NFR-6\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":671,"newStart":1,"newLines":427,"lines":[" {","-  \"ticketId\": \"SH-11\",","-  \"timestamp\": \"2026-11-09T17:45:00Z\",","+  \"ticketId\": \"SH-12\",","+  \"timestamp\": \"2026-11-09T19:30:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\","," ","   \"conventions\": {","-    \"basePath\": \"/api (existing SchoolHub convention, not /api/v1; route files live under src/app/api/**/route.ts). Requirement: FR-39, NFR-9.\",","-    \"handlerPipeline\": \"withHandler → requireUser/requireRole → Zod schema from src/lib/validators/gradebook.ts → service in src/server/gradebook/ or src/server/report-cards/ → ok(data) / ok(data, {status: 201}). Requirement: FR-39, NFR-6.\",","-    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. None of these endpoints is paginated: the largest list (report cards for one term, up to ~600 rows) must be complete so 'Publish all' / 'Print all' can act on the full filtered list.\",","-    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } } from src/server/http.ts. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, INTERNAL 500.\",","-    \"decimals\": \"Input: number | string with at most 2 decimals (same `decimal(min,max,label)` helper pattern as validators/assignments.ts). Output: points and weights are 2 dp strings via fixed2 (\\\"18.00\\\"). Computed percents are 1 dp strings rounded half-up once (\\\"78.0\\\"), or null when nothing counts. Requirement: NFR-1, FR-13.\",","-    \"dates\": \"ISO 8601 UTC strings. Clients render with DateDisplay in SchoolSettings.timezone. Requirement: NFR-10.\",","-    \"accessTerms\": \"manage = assertCanManageCourse (ADMIN, or TEACHER who teaches the course). view course = assertCanViewCourse. view student = assertCanViewStudent (self, linked parent, teacher of the student, homeroom teacher, ADMIN). Unauthorised access to a specific entity returns NOT_FOUND where the existing assert does so. Requirement: NFR-6, FR-39.\",","-    \"privacy\": \"Student/parent-facing responses (GET /api/students/:id/grades, GET /api/report-cards with studentId, GET /api/report-cards/:id) never include hidden items, unreleased scores, updatedById or unpublished cards. Requirement: NFR-5, FR-42, FR-37.\"","+    \"replaces\": \"This file replaces the SH-11 contracts that were here before.\",","+    \"basePath\": \"/api (the existing SchoolHub convention, not /api/v1). Route files are src/app/api/**/route.ts. Requirement: FR-34.\",","+    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with a Zod schema from src/lib/validators/announcements.ts → one call into src/server/announcements/announcements-service.ts → ok(data) / ok(data, {status: 201}) / paginated(data, meta). No business logic in routes. Requirements: FR-34, FR-36, NFR-8.\",","+    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. Paginated endpoints return { \\\"data\\\": [...], \\\"meta\\\": { page, pageSize, total } } via paginated() in src/server/http.ts. Requirement: FR-34.\",","+    \"pagination\": \"?page (≥1, default 1) & ?pageSize (default 20, max 100 via parsePagination; GET /api/announcements/manage clamps to 50 because it computes live reach per row). Requirements: FR-17, FR-23, FR-31.\",","+    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } }. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, RATE_LIMITED 429, INTERNAL 500. Requirement: FR-34.\",","+    \"accessErrors\": \"Targeting violations on create, update and preview return 403 FORBIDDEN (AC-3). STUDENT/PARENT on ADMIN/TEACHER routes get 403 from requireRole (FR-11). Callers who may not see a specific announcement (non-member, non-author, or not yet visible) get 404 NOT_FOUND on detail, ack, stats, remind, PATCH and archive, so its existence is not leaked (system-design A10). Requirements: NFR-3, NFR-6.\",","+    \"dates\": \"All timestamps are ISO 8601 UTC strings. The composer converts SchoolSettings.timezone input to UTC before sending. Clients display with formatInSchoolTz. Requirement: NFR-7.\",","+    \"visibility\": \"visible = status ∈ {SCHEDULED, PUBLISHED} ∧ publishAt ≤ now ∧ (expiresAt null ∨ expiresAt > now), evaluated at read time. Requirements: FR-16, NFR-6.\",","+    \"sanitisation\": \"`body` is raw Markdown, rendered client-side only through MarkdownView (rehype-sanitize). `excerpt` is plain text from toPlainText and must be rendered as escaped text. Requirement: NFR-4.\"","   },"," ","   \"components\": {","-    \"Decimal2In\": { \"oneOf\": [{ \"type\": \"number\" }, { \"type\": \"string\", \"pattern\": \"^\\\\d+(\\\\.\\\\d{1,2})?$\" }] },","-    \"Decimal2Out\": { \"type\": \"string\", \"pattern\": \"^-?\\\\d+\\\\.\\\\d{2}$\", \"example\": \"18.00\" },","-    \"Percent1Out\": { \"type\": [\"string\", \"null\"], \"pattern\": \"^\\\\d+\\\\.\\\\d$\", \"example\": \"78.0\" },","-    \"Band\": {","+    \"AudienceRow\": {","+      \"description\": \"Generic audience row (FR-8). refId is required unless the type is SCHOOL or STAFF. For ROLE it must be a Role value. For GRADE_LEVEL, SECTION and COURSE, at least one include flag must be true. Requirements: FR-1, FR-3..FR-6.\",","       \"type\": \"object\",","-      \"required\": [\"letter\", \"minPercent\"],","       \"properties\": {","-        \"letter\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 5 },","-        \"minPercent\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 100 },","-        \"gpa\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 10, \"description\": \"Stored only, never computed (NFR-13).\" },","-        \"descriptor\": { \"type\": \"string\", \"maxLength\": 100 }","-      }","+        \"type\": { \"enum\": [\"SCHOOL\", \"STAFF\", \"ROLE\", \"GRADE_LEVEL\", \"SECTION\", \"COURSE\"] },","+        \"refId\": { \"type\": [\"string\", \"null\"], \"description\": \"GradeLevel.id | Section.id | Course.id | Role value\" },","+        \"includeStudents\": { \"type\": \"boolean\", \"default\": true },","+        \"includeParents\": { \"type\": \"boolean\", \"default\": true },","+        \"includeTeachers\": { \"type\": \"boolean\", \"default\": true }","+      },","+      \"required\": [\"type\"]","     },","-    \"Bands\": {","-      \"type\": \"array\",","-      \"minItems\": 1,","-      \"items\": { \"$ref\": \"#/components/Band\" },","-      \"description\": \"bandsSchema: minPercent strictly descending, last band minPercent = 0, letters unique (case-sensitive). Server re-sorts nothing; out-of-order input is a VALIDATION_ERROR. Requirement: FR-16.\"","-    },","-    \"GradingScale\": {","+    \"AnnouncementInput\": {","+      \"description\": \"Body of POST /api/announcements. Mirrors announcementInputSchema. Requirements: FR-2, FR-13, FR-15, FR-16.\",","       \"type\": \"object\",","       \"properties\": {","-        \"id\": { \"type\": \"string\" },","-        \"name\": { \"type\": \"string\" },","-        \"isDefault\": { \"type\": \"boolean\" },","-        \"bands\": { \"$ref\": \"#/components/Bands\" },","-        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }","-      }","+        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150, \"description\": \"Trimmed\" },","+        \"body\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 20000, \"description\": \"Markdown\" },","+        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"minItems\": 0, \"maxItems\": 20 },","+        \"pinned\": { \"type\": \"boolean\", \"default\": false },","+        \"requiresAck\": { \"type\": \"boolean\", \"default\": false },","+        \"isPublic\": { \"type\": \"boolean\", \"default\": false, \"description\": \"ADMIN only. true from a TEACHER → 403 (FR-10)\" },","+        \"coverFileId\": { \"type\": [\"string\", \"null\"], \"description\": \"FileObject id uploaded with context 'announcement'\" },","+        \"attachmentFileIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"maxItems\": 10, \"default\": [] },","+        \"mode\": { \"enum\": [\"draft\", \"publish\", \"schedule\"] },","+        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Required and > now when mode = schedule. Ignored for publish (set to now)\" },","+        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Must be > (publishAt ?? now)\" }","+      },","+      \"required\": [\"title\", \"body\", \"audiences\", \"mode\"]","     },","-    \"GradeCategory\": {","+    \"AnnouncementPatch\": {","+      \"description\": \"AnnouncementInput with every field optional (announcementPatchSchema). audiences, when present, replaces all rows. Requirements: FR-12, FR-29.\",","       \"type\": \"object\",","-      \"properties\": {","-        \"id\": { \"type\": \"string\" },","-        \"name\": { \"type\": \"string\" },","-        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },","-        \"dropLowest\": { \"type\": \"integer\", \"minimum\": 0 },","-        \"order\": { \"type\": \"integer\" }","-      }","+      \"allOf\": [{ \"$ref\": \"#/components/AnnouncementInput\" }],","+      \"required\": []","     },","-    \"GradeItem\": {","+    \"Author\": {","       \"type\": \"object\",","       \"properties\": {","         \"id\": { \"type\": \"string\" },","-        \"courseId\": { \"type\": \"string\" },","-        \"termId\": { \"type\": \"string\" },","-        \"categoryId\": { \"type\": [\"string\", \"null\"] },","-        \"title\": { \"type\": \"string\" },","-        \"maxPoints\": { \"$ref\": \"#/components/Decimal2Out\" },","-        \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-        \"source\": { \"enum\": [\"ASSIGNMENT\", \"QUIZ\", \"MANUAL\"] },","-        \"sourceId\": { \"type\": [\"string\", \"null\"] },","-        \"isVisible\": { \"type\": \"boolean\" }","-      }","+        \"name\": { \"type\": \"string\" },","+        \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\"] }","+      },","+      \"required\": [\"id\", \"name\", \"role\"]","     },","-    \"Grade\": {","+    \"Attachment\": {","+      \"description\": \"Download via the existing GET /api/files/:id, gated by the 'announcement' file context (FR-30).\",","       \"type\": \"object\",","-      \"description\": \"Teacher-facing grade cell. A student with no Grade row is returned as score null, excused false, missing false.\",","       \"properties\": {","-        \"gradeItemId\": { \"type\": \"string\" },","-        \"studentId\": { \"type\": \"string\" },","-        \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },","-        \"excused\": { \"type\": \"boolean\" },","-        \"missing\": { \"type\": \"boolean\" },","-        \"comment\": { \"type\": [\"string\", \"null\"] },","-        \"updatedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }","-      }","-    },","-    \"TermOverride\": {","-      \"type\": \"object\",","-      \"properties\": {","-        \"percent\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },","-        \"letter\": { \"type\": [\"string\", \"null\"] },","-        \"teacherComment\": { \"type\": [\"string\", \"null\"] }","-      }","-    },","-    \"CategoryResult\": {","-      \"type\": \"object\",","-      \"description\": \"id null = implicit 'Uncategorised' bucket (weight 0 when the course has categories, A8).\",","-      \"properties\": {","-        \"id\": { \"type\": [\"string\", \"null\"] },","+        \"id\": { \"type\": \"string\", \"description\": \"FileObject id\" },","         \"name\": { \"type\": \"string\" },","-        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },","-        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },","-        \"earned\": { \"$ref\": \"#/components/Decimal2Out\" },","-        \"possible\": { \"$ref\": \"#/components/Decimal2Out\" },","-        \"droppedItemIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }","-      }","+        \"mimeType\": { \"type\": \"string\" },","+        \"size\": { \"type\": \"integer\" }","+      },","+      \"required\": [\"id\", \"name\"]","     },","-    \"StudentTermResult\": {","+    \"FeedItem\": {","+      \"description\": \"Feed card DTO. Requirements: FR-17, FR-18, FR-22, NFR-5.\",","       \"type\": \"object\",","-      \"description\": \"Output of grade-calc.computeStudentTerm, the single shared calculation (FR-10–FR-15). percent/letter are final (override applied); computed* are pre-override.\",","       \"properties\": {","-        \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/CategoryResult\" } },","-        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },","-        \"letter\": { \"type\": [\"string\", \"null\"] },","-        \"descriptor\": { \"type\": [\"string\", \"null\"] },","-        \"computedPercent\": { \"$ref\": \"#/components/Percent1Out\" },","-        \"computedLetter\": { \"type\": [\"string\", \"null\"] },","-        \"overridden\": { \"type\": \"boolean\" },","-        \"override\": { \"oneOf\": [{ \"$ref\": \"#/components/TermOverride\" }, { \"type\": \"null\" }] }","-      }","+        \"id\": { \"type\": \"string\" },","+        \"title\": { \"type\": \"string\" },","+        \"excerpt\": { \"type\": \"string\", \"maxLength\": 200, \"description\": \"Plain text (toPlainText(body, 200))\" },","+        \"coverFileId\": { \"type\": [\"string\", \"null\"] },","+        \"author\": { \"$ref\": \"#/components/Author\" },","+        \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },","+        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","+        \"pinned\": { \"type\": \"boolean\", \"description\": \"true only for the ≤3 items lifted to the top of page 1\" },","+        \"requiresAck\": { \"type\": \"boolean\" },","+        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"Audience chips, e.g. 'Grade 7 · Parents'\" },","+        \"attachmentCount\": { \"type\": \"integer\" },","+        \"unread\": { \"type\": \"boolean\", \"description\": \"No AnnouncementRead.readAt for the caller. UI shows a dot with visually hidden text 'Unread'\" },","+        \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","+        \"forChildren\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" } } }, \"description\": \"PARENT callers only; empty otherwise. The linked children that put the parent in a GRADE_LEVEL, SECTION or COURSE audience ('For Sam')\" }","+      },","+      \"required\": [\"id\", \"title\", \"excerpt\", \"author\", \"publishAt\", \"pinned\", \"requiresAck\", \"labels\", \"attachmentCount\", \"unread\", \"forChildren\"]","     },","-    \"TermRef\": {","+    \"AnnouncementDetail\": {","+      \"description\": \"Full record for detail and edit. Requirements: FR-13, FR-19, FR-20.\",","       \"type\": \"object\",","       \"properties\": {","         \"id\": { \"type\": \"string\" },","-        \"name\": { \"type\": \"string\" },","-        \"startDate\": { \"type\": \"string\", \"format\": \"date\" },","-        \"endDate\": { \"type\": \"string\", \"format\": \"date\" },","-        \"isCurrent\": { \"type\": \"boolean\" }","-      }","+        \"title\": { \"type\": \"string\" },","+        \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown. Render only via MarkdownView\" },","+        \"status\"