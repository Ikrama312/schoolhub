{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgBR7TfU4P95Abkykz2iV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FGk8rRPc7MfLHzN8tSochv","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"abcd-04\",\n  \"timestamp\": \"2026-10-19T15:10:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md's Component Breakdown/Data Flow (abcd-04, Components 3/8/11/15/16/17) and the source PRD's explicit API table (04-notifications.md, section 'API'), which fully specifies method/path/role/body for all 11 endpoints (the table's 'POST /api/notifications/:id/read · /unread' row is two endpoints). Two items carried forward, unresolved here because they are sequencing/confirmation items for dev-planning, not contract-shape questions: (1) every non-ADMIN, non-CRON_SECRET endpoint below calls requireRole(...ALL_ROLES) as the stand-in for a real requireUser() per system-design.md's Overview/Component 12 finding — src/server/auth/permissions.ts does not exist yet (only requireRole.ts's ADMIN-placeholder does), so 'own notifications only' / 'own preferences only' scoping is written against the request's userId param today and must be swapped to the real session identity when PRD-01 lands, not re-derived; (2) list/count responses use the real paginated()/ok() shapes from src/server/http.ts (data + nested meta for lists), confirmed directly against src/server/http.ts and existing routes (src/app/api/users/route.ts, src/app/api/audit-logs/route.ts) rather than assumed.\",\n\n  \"conventions\": {\n    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n    \"listEnvelope\": { \"data\": \"[...]\", \"meta\": { \"page\": 1, \"pageSize\": 20, \"total\": 0 } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\", \"INVALID_TOKEN (410)\"],\n    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100), per src/server/http.ts parsePagination()\",\n    \"auth\": \"Own-row routes call requireRole(...ALL_ROLES) (placeholder for PRD-01's requireUser(); see note). ADMIN-only routes call requireRole('ADMIN') directly — already real today. POST /api/internal/email/dispatch checks Authorization: Bearer ${CRON_SECRET} itself, not requireRole.\",\n    \"security\": \"Notification.link values are validated server-side as '/'-prefixed relative paths before any write that sets them (NFR-5); this is a notify()-time invariant, not re-validated at the read endpoints below.\"\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/notifications\",\n      \"description\": \"Any role. Own notifications only (userId scoped server-side). Backs both the /notifications page (paginated, filterable) and, with pageSize=10 and no filters, the bell popover's recent-10 list — one implementation (Component 11), not two query paths.\",\n      \"requestSchema\": { \"unread\": \"boolean?\", \"category\": \"\\\"ACCOUNT\\\"|\\\"ACADEMIC\\\"|\\\"ATTENDANCE\\\"|\\\"COMMUNICATION\\\"|\\\"FINANCE\\\"|\\\"SYSTEM\\\"?\", \"page\": \"int? (default 1)\", \"pageSize\": \"int? (default 20, max 100)\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"type\": \"string\", \"category\": \"string\", \"title\": \"string\", \"body\": \"string|null\", \"link\": \"string|null\", \"readAt\": \"datetime|null\", \"createdAt\": \"datetime\" } ], \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/notifications/unread-count\",\n      \"description\": \"Any role. Own count only. Backed by the Notification(userId, readAt, createdAt) composite index; must respond under 50ms (NFR-3). Polled by the bell every 30s while the tab is visible.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"count\": \"int\" } },\n      \"requirementIds\": [\"FR-14\", \"FR-21\", \"NFR-3\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/:id/read\",\n      \"description\": \"Owner only (the notification's userId must match the caller). Sets readAt=now if not already set; idempotent. NOT_FOUND if the id doesn't belong to the caller (never reveals another user's notification exists).\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"readAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/:id/unread\",\n      \"description\": \"Owner only. Clears readAt. Same ownership/NOT_FOUND rule as /read.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"readAt\": null } },\n      \"requirementIds\": [\"FR-16\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/read-all\",\n      \"description\": \"Any role. Sets readAt=now on every unread Notification row owned by the caller in one update.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"updated\": \"int\" } },\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/notification-preferences\",\n      \"description\": \"Any role. Merges NOTIFICATION_TYPES registry entries visible to the caller's role with the caller's existing NotificationPreference rows (registry defaultEmail/mandatoryInApp used where no row exists).\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"type\": \"string\", \"label\": \"string\", \"description\": \"string\", \"category\": \"string\", \"inApp\": \"boolean\", \"email\": \"boolean\", \"mandatoryInApp\": \"boolean\" } ] },\n      \"requirementIds\": [\"FR-18\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/me/notification-preferences\",\n      \"description\": \"Any role. Upserts one {type, inApp, email} preference row for the caller. Rejects inApp=false for mandatoryInApp types with VALIDATION_ERROR before any write (FR-22) — defense in depth alongside the disabled UI switch.\",\n      \"requestSchema\": { \"type\": \"string (must exist in NOTIFICATION_TYPES)\", \"inApp\": \"boolean\", \"email\": \"boolean\" },\n      \"responseSchema\": { \"data\": { \"type\": \"string\", \"inApp\": \"boolean\", \"email\": \"boolean\" } },\n      \"requirementIds\": [\"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"Requires header Authorization: Bearer ${CRON_SECRET}; mismatch or missing header returns 401 UNAUTHENTICATED via the standard error envelope (NFR-8), checked before any other work. On success: recovers stuck SENDING rows (>10min), claims up to batchSize PENDING rows via FOR UPDATE SKIP LOCKED, sends each, applies the retry backoff on failure, and runs the once-per-day purge.\",\n      \"requestSchema\": { \"batchSize\": \"int? (default 50)\" },\n      \"responseSchema\": { \"data\": { \"sent\": \"int\", \"failed\": \"int\", \"retried\": \"int\" } },\n      \"requirementIds\": [\"FR-10\", \"FR-11\", \"FR-12\", \"FR-17\", \"FR-21\", \"NFR-4\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/email-log\",\n      \"description\": \"ADMIN only. Paginated EmailOutbox rows, newest first, optional status filter.\",\n      \"requestSchema\": { \"status\": \"\\\"PENDING\\\"|\\\"SENDING\\\"|\\\"SENT\\\"|\\\"FAILED\\\"?\", \"page\": \"int?\", \"pageSize\": \"int?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"toEmail\": \"string\", \"toName\": \"string|null\", \"subject\": \"string\", \"status\": \"string\", \"attempts\": \"int\", \"lastError\": \"string|null\", \"nextAttemptAt\": \"datetime\", \"sentAt\": \"datetime|null\", \"createdAt\": \"datetime\" } ], \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/email-log/:id/retry\",\n      \"description\": \"ADMIN only. Only valid for rows currently status=FAILED (VALIDATION_ERROR otherwise); resets attempts=0, status=PENDING, nextAttemptAt=now so the next dispatchEmails() pass picks it up — not a separate send path.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"PENDING\", \"attempts\": 0, \"nextAttemptAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/notifications/test\",\n      \"description\": \"ADMIN only. Calls notify({ type: 'system.test', userIds: [caller.id], title, body }) for the signed-in admin; exercises the same in-app + email path as any other notification.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"notificationId\": \"string\", \"emailQueued\": \"boolean\" } },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-7\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2364,"cache_read_input_tokens":66152,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2364},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"54b3bb1c-c2bb-4763-9a84-dd2308368397","uuid":"30a89c97-3817-414a-9506-7a7d3cce4830","timestamp":"2026-10-19T10:12:48.680Z","request_id":"req_011CgBR7TRqEuewmhnf6u9mv"}
