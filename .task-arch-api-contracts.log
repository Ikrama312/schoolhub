bers, or `null` when there are no recipients.\n\n`artifacts/architect/threat-model-notes.json` is left over from SH-11. It isn't owned by any architect sub-task, so I didn't touch it; it may confuse downstream phases.","ttft_ms":2502,"type":"result","duration_ms":128463,"uuid":"759ff8ec-59fb-4d4a-95c6-3dab480fa9dd","ttft_stream_ms":1450,"time_to_request_ms":131,"first_content_frame_ms":1450,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":18,"outputTokens":15515,"cacheReadInputTokens":445398,"cacheCreationInputTokens":59910,"webSearchRequests":0,"costUSD":0.7404406,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":610,"cacheCreationEphemeral5mInputTokens":46097,"cacheCreationEphemeral1hInputTokens":13813,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
