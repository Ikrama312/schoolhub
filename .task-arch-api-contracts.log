{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgsk949H2Fqak4JBZ4WeN","type":"message","role":"assistant","content":[{"type":"text","text":"Note: VALIDATION_ERROR maps to 400, not the 422 that system-design §1 mentions for isSafeguardingLead. The contract uses 400. Writing the contracts now."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":794,"cache_read_input_tokens":55926,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":794},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2e59def-a937-4e61-837c-a8e39741caba","uuid":"8700e825-f800-4c6c-b1a4-03e51ad99511","timestamp":"2026-11-09T17:25:19.768Z","request_id":"req_011Cgsk93wseEopRRL2XR3ri"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgsk949H2Fqak4JBZ4WeN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014UxViYQujj3GCQ9JFM5si3","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-13\",\n  \"timestamp\": \"2026-11-09T22:40:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the stale SH-12 contracts.\",\n    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (FR-28)\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole, or requireSafeguardingLead for safeguarding routes → parseQuery / parseBody with schemas from src/lib/validators/messaging.ts → one service call in src/server/messaging/* → ok(data) / ok(data, {status:201}) / paginated(data, meta). (NFR-6)\",\n    \"envelopes\": {\n      \"success\": \"{ data: T }\",\n      \"list\": \"{ data: T[], meta: { page, pageSize, total } } for page-based lists. Pagination comes from parsePagination: default page size 20, max 100.\",\n      \"error\": \"{ error: { code, message, details? } }\"\n    },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409,\n      \"RATE_LIMITED\": 429\n    },\n    \"errorPolicy\": [\n      \"If the caller is not a participant, or has left (leftAt is set), the API returns 404 NOT_FOUND. A conversation cuid is never treated as authorisation. (NFR-1)\",\n      \"A contact-rule violation on create returns 403 FORBIDDEN, and nothing is written. (FR-6)\",\n      \"A send after the relationship has ended returns 403 FORBIDDEN with details.reason='RELATIONSHIP_ENDED'. (FR-7)\",\n      \"An edit or delete by someone other than the sender, more than 15 minutes after sending, or on an already-deleted message returns 403 FORBIDDEN. details.reason is 'NOT_SENDER', 'EDIT_WINDOW_EXPIRED' or 'ALREADY_DELETED'. (FR-15)\",\n      \"A rate-limit hit returns 429 RATE_LIMITED with details.retryAfterMs. (NFR-4)\",\n      \"A caller who is not an ADMIN with isSafeguardingLead=true (read from the database) gets 403 FORBIDDEN on /api/safeguarding/*. (FR-23, NFR-1)\"\n    ],\n    \"ids\": \"All ids are cuid strings. All timestamps are ISO 8601 UTC strings. The client renders them in the school timezone. (NFR-6)\"\n  },\n\n  \"components\": {\n    \"UserSummary\": { \"id\": \"string\", \"name\": \"string\", \"role\": \"ADMIN|TEACHER|STUDENT|PARENT\", \"avatarUrl\": \"string|null\" },\n    \"Attachment\": { \"fileId\": \"string\", \"name\": \"string\", \"mimeType\": \"string\", \"size\": \"number\", \"url\": \"string (/api/files/:id, gated by the 'message' file context, FR-27)\" },\n    \"MessageDTO\": {\n      \"id\": \"string\",\n      \"conversationId\": \"string\",\n      \"sender\": \"UserSummary\",\n      \"body\": \"string|null (null when deleted)\",\n      \"deleted\": \"boolean\",\n      \"editedAt\": \"string|null\",\n      \"createdAt\": \"string\",\n      \"updatedAt\": \"string\",\n      \"attachments\": \"Attachment[] (empty when deleted)\",\n      \"isOwn\": \"boolean\",\n      \"canEdit\": \"boolean (isOwn, not deleted, and now - createdAt ≤ 15 min)\"\n    },\n    \"ConversationListItem\": {\n      \"id\": \"string\",\n      \"subject\": \"string|null\",\n      \"participants\": \"UserSummary[] (excluding the caller)\",\n      \"preview\": \"string|null ('<first name>: <body ≤80>' or 'This message was deleted')\",\n      \"lastMessageAt\": \"string\",\n      \"unreadCount\": \"number (capped at 99)\",\n      \"muted\": \"boolean\",\n      \"archived\": \"boolean\"\n    },\n    \"ConversationDetail\": {\n      \"id\": \"string\",\n      \"subject\": \"string|null\",\n      \"createdById\": \"string\",\n      \"involvesStudent\": \"boolean\",\n      \"lastMessageAt\": \"string\",\n      \"participants\": \"(UserSummary & { leftAt: string|null })[]\",\n      \"me\": { \"lastReadAt\": \"string|null\", \"muted\": \"boolean\", \"archived\": \"boolean\" },\n      \"canSend\": \"boolean (canSendIn result, FR-7)\",\n      \"canLeave\": \"boolean (false when ≤2 participants, or when the caller is the creator and involvesStudent is true, FR-14)\"\n    },\n    \"ContactGroup\": { \"label\": \"string, e.g. 'My teachers', 'My child's teachers (Sam)', 'Students in MATH-7A', 'Parents of students in MATH-7A', 'Homeroom 7A', 'Staff', 'School office'\", \"contacts\": \"UserSummary[] (≤50 per group)\" },\n    \"SafeguardingMessageDTO\": \"MessageDTO with body always present (including deleted content), plus deletedAt: string|null and revisions: { body: string, createdAt: string }[] (NFR-3)\",\n    \"ReportDTO\": {\n      \"id\": \"string\",\n      \"status\": \"OPEN|REVIEWED|DISMISSED\",\n      \"reason\": \"string\",\n      \"reporter\": \"UserSummary\",\n      \"message\": \"SafeguardingMessageDTO\",\n      \"conversationId\": \"string\",\n      \"reviewedBy\": \"UserSummary|null\",\n      \"reviewedAt\": \"string|null\",\n      \"reviewNote\": \"string|null\",\n      \"createdAt\": \"string\"\n    },\n    \"MessagingSettings\": { \"quietStart\": \"HH:mm|null\", \"quietEnd\": \"HH:mm|null\" }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conversations\",\n      \"description\": \"Returns the caller's conversations that they have not left, sorted by lastMessageAt desc. The Inbox tab sends archived=false (the default) and the Archived tab sends archived=true. q matches participant name or subject. Polled every 30 s.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": { \"query\": { \"archived\": \"boolean? (default false)\", \"q\": \"string? ≤100\", \"page\": \"int? ≥1\", \"pageSize\": \"int? ≤100\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"ConversationListItem[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-9\", \"FR-13\", \"FR-28\", \"FR-31\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations\",\n      \"description\": \"Creates a conversation, adding the caller as a participant automatically, together with its first message. The request must pass validateNewConversation: 2–25 participants including the caller, canMessage(creator, p) for every participant, and a TEACHER or ADMIN in any group that contains a STUDENT. involvesStudent is computed here. The send side effects of POST .../messages also apply.\",\n      \"auth\": \"any authenticated user; rateLimit('msg:'+uid, 30, 60_000)\",\n      \"requestSchema\": { \"body\": { \"participantIds\": \"cuid[] 1..24 (excluding the caller, deduplicated)\", \"subject\": \"string? ≤120\", \"body\": \"string, trimmed, 1..5000\", \"fileIds\": \"cuid[]? ≤5 (owned by the caller, unattached, context 'message')\" } },\n      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"conversation\": \"ConversationDetail\", \"message\": \"MessageDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (contact rules, group without staff, more than 25 participants; nothing is created)\", \"429 RATE_LIMITED\"],\n      \"requirementIds\": [\"FR-6\", \"FR-11\", \"FR-12\", \"FR-16\", \"FR-17\", \"FR-28\", \"FR-30\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conversations/:id\",\n      \"description\": \"Returns the conversation header, the participants, the caller's state, canSend and canLeave.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"ConversationDetail\" } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-14\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conversations/:id/messages\",\n      \"description\": \"Keyset-paginated messages. Without a cursor it returns the latest page. 'before' loads older messages for the upward infinite scroll. 'after' (plus an optional 'since') is the 5-second poll, which returns new messages plus messages edited or deleted since the given time. A poll with nothing new returns empty arrays and is designed to respond in under 100 ms using @@index([conversationId, createdAt]).\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"cuid\" },\n        \"query\": { \"before\": \"cuid? (mutually exclusive with after)\", \"after\": \"cuid?\", \"since\": \"ISO datetime? (only with after)\", \"limit\": \"int? 1..30 (default 30)\" }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"messages\": \"MessageDTO[] in ascending createdAt order\",\n            \"changed\": \"MessageDTO[] (only when after+since is sent; messages with createdAt ≤ cursor and updatedAt > since)\",\n            \"hasMore\": \"boolean (older messages exist; only in initial and 'before' mode)\"\n          }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (before and after both sent, or since without after)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not a participant, or the cursor id is not in this conversation)\"],\n      \"requirementIds\": [\"FR-10\", \"FR-13\", \"FR-28\", \"NFR-1\", \"NFR-2\", \"NFR-3\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/messages\",\n      \"description\": \"Sends a message. Order: rate limit, participation, canSendIn (staff can always send; a non-staff sender needs a live relationship with at least one staff participant who has not left), attachment ownership, then a transaction that inserts the message, links the files, bumps lastMessageAt, sets the sender's lastReadAt and clears archivedAt for the other participants. After commit, onMessageSent runs for each other participant who has not muted or left: it deletes their older unread message.received row, notifies in-app and upserts PendingMessageEmail (dueAt = now + 10 min, create-only).\",\n      \"auth\": \"participant who has not left; rateLimit('msg:'+uid, 30, 60_000)\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"body\": \"string, trimmed, 1..5000\", \"fileIds\": \"cuid[]? ≤5\" } },\n      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"message\": \"MessageDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR (including invalid or foreign fileIds)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='RELATIONSHIP_ENDED'\", \"404 NOT_FOUND\", \"429 RATE_LIMITED details.retryAfterMs\"],\n      \"requirementIds\": [\"FR-7\", \"FR-11\", \"FR-19\", \"FR-20\", \"FR-27\", \"FR-28\", \"FR-31\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/read\",\n      \"description\": \"Sets the caller's lastReadAt to now, marks the caller's unread message.received notification for this conversation as read, and deletes the caller's PendingMessageEmail row for it.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": {} },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"lastReadAt\": \"string\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-14\", \"FR-20\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/mute\",\n      \"description\": \"Mutes or unmutes the conversation for the caller only. Muted participants get no message.received notification and no email.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"muted\": \"boolean\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"muted\": \"boolean\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-14\", \"FR-19\", \"FR-28\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/archive\",\n      \"description\": \"Archives or unarchives the conversation for the caller only. A new message from someone else unarchives it.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"archived\": \"boolean\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"archived\": \"boolean\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-9\", \"FR-14\", \"FR-28\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/leave\",\n      \"description\": \"Sets leftAt for the caller. After that the caller is treated as a non-participant (404, and no attachment access). Leaving is refused for conversations with 2 or fewer participants, and for the creator of a conversation where involvesStudent is true.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": {} },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"left\": true } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='ONE_TO_ONE'|'CREATOR_OF_STUDENT_GROUP'\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-14\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/messages/:id\",\n      \"description\": \"Edits the caller's own message within 15 minutes of sending. In one transaction it inserts a MessageRevision holding the old body, then updates body and editedAt.\",\n      \"auth\": \"sender, a participant who has not left, within 15 minutes\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"body\": \"string, trimmed, 1..5000\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"message\": \"MessageDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='NOT_SENDER'|'EDIT_WINDOW_EXPIRED'|'ALREADY_DELETED'\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-3\", \"FR-15\", \"FR-28\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/messages/:id\",\n      \"description\": \"Soft-deletes the caller's own message within 15 minutes by setting deletedAt. No hard delete is possible. The content stays visible to safeguarding leads.\",\n      \"auth\": \"sender, a participant who has not left, within 15 minutes\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"message\": \"MessageDTO (deleted:true, body:null)\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='NOT_SENDER'|'EDIT_WINDOW_EXPIRED'|'ALREADY_DELETED'\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-15\", \"FR-28\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/messages/:id/report\",\n      \"description\": \"Reports another participant's message. After commit, every ACTIVE safeguarding lead gets a message.reported notification (mandatory in-app plus email, without the message text) linking to /admin/safeguarding?report=<id>. The client shows the toast 'Reported — the school will review this.'\",\n      \"auth\": \"participant who has not left, not the sender\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"reason\": \"string, trimmed, 1..1000\" } },\n      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"reportId\": \"string\", \"status\": \"OPEN\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (reporting your own message)\", \"404 NOT_FOUND\", \"409 CONFLICT (an OPEN report from this user on this message already exists)\"],\n      \"requirementIds\": [\"FR-22\", \"FR-26\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/messaging/unread-count\",\n      \"description\": \"Returns the number of conversations the caller has not left where lastMessageAt > coalesce(lastReadAt, epoch). It runs as a single $queryRaw COUNT and backs the sidebar badge, which polls every 30 s.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"count\": \"number\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-13\", \"FR-18\", \"FR-28\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/messaging/contacts\",\n      \"description\": \"Returns only the users the caller can message (canMessage), in labelled groups. Users the caller cannot message are never returned.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": { \"query\": { \"q\": \"string? ≤100 (case-insensitive name match)\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"groups\": \"ContactGroup[]\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-5\", \"FR-8\", \"FR-12\", \"FR-16\", \"FR-28\", \"FR-32\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/messaging-settings\",\n      \"description\": \"Returns the caller's quiet hours. Both values are null when none are set.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"MessagingSettings\" } },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-21\", \"FR-28\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/me/messaging-settings\",\n      \"description\": \"Upserts the caller's quiet hours as HH:mm in the school timezone. The range may wrap midnight. quietStart and quietEnd must be both set or both null (null clears them), and start must not equal end.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": { \"body\": { \"quietStart\": \"string /^([01]\\\\d|2[0-3]):[0-5]\\\\d$/ | null\", \"quietEnd\": \"string /^([01]\\\\d|2[0-3]):[0-5]\\\\d$/ | null\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"MessagingSettings\" } },\n      \"errors\": [\"400 VALIDATION_ERROR (only one value set, bad format, or start == end)\", \"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"FR-28\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/reports\",\n      \"description\": \"The reports queue, with OPEN reports first and then by createdAt desc. The optional status filter narrows the list.\",\n      \"auth\": \"ADMIN with isSafeguardingLead (read from the database)\",\n      \"requestSchema\": { \"query\": { \"status\": \"OPEN|REVIEWED|DISMISSED?\", \"page\": \"int?\", \"pageSize\": \"int? ≤100\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"(ReportDTO without the context fields)[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\"],\n      \"requirementIds\": [\"FR-23\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/reports/:id\",\n      \"description\": \"Report detail: the reported message, the 5 messages before and the 5 after it (including deleted content and revisions), and the participants. Each call writes audit('safeguarding.conversation.view', entityType 'Conversation').\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"report\": \"ReportDTO\", \"before\": \"SafeguardingMessageDTO[] (≤5)\", \"after\": \"SafeguardingMessageDTO[] (≤5)\", \"participants\": \"(UserSummary & { leftAt: string|null })[]\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-23\", \"FR-25\", \"FR-28\", \"NFR-1\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/safeguarding/reports/:id\",\n      \"description\": \"Marks a report reviewed or dismissed. A review requires a note; for a dismissal the note is optional. Sets status, reviewedById, reviewedAt and reviewNote, and writes audit('safeguarding.report.review' or 'safeguarding.report.dismiss').\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"action\": \"'review'|'dismiss'\", \"note\": \"string? ≤1000 (required when action is 'review')\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"report\": \"ReportDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\", \"409 CONFLICT (report is no longer OPEN)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-28\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/conversations\",\n      \"description\": \"Searches conversations where involvesStudent is true. Filters: a participant, and a createdAt or lastMessageAt range. Ordered by lastMessageAt desc.\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"query\": { \"participantId\": \"cuid?\", \"from\": \"ISO date?\", \"to\": \"ISO date?\", \"page\": \"int?\", \"pageSize\": \"int? ≤100\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"{ id, subject, participants: UserSummary[], createdAt, lastMessageAt, messageCount, openReportCount }[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\"],\n      \"requirementIds\": [\"FR-24\", \"FR-28\", \"FR-30\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/conversations/:id\",\n      \"description\": \"Read-only view of the full thread, including deleted content (marked as deleted) and the original text of edited messages. Every call writes audit('safeguarding.conversation.view').\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"conversation\": \"ConversationDetail without me/canSend/canLeave\", \"messages\": \"SafeguardingMessageDTO[] in ascending order\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND (also returned when involvesStudent is false)\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-28\", \"NFR-1\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/users/:id\",\n      \"description\": \"EXISTING endpoint, extended with an optional isSafeguardingLead flag. Setting it to true on a non-ADMIN user is rejected. The change is audited in the existing user.update metadata. There is no admin form, so the API and the seed are the only way to set it (ADR-11).\",\n      \"auth\": \"ADMIN (unchanged)\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"...existing fields\": \"unchanged\", \"isSafeguardingLead\": \"boolean?\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"existing user DTO + isSafeguardingLead: boolean\" } },\n      \"errors\": [\"400 VALIDATION_ERROR details.reason='SAFEGUARDING_LEAD_REQUIRES_ADMIN'\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-2\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING maintenance endpoint. Its request and response contract does not change. It also runs processPendingMessageEmails(now) in its own try/catch, processing at most 200 due rows per run. A user who has read, muted or left the conversation is dropped, a user in quiet hours is deferred to the end of quiet hours, and everyone else is sent the email with notify({inApp:false}).\",\n      \"auth\": \"CRON_SECRET (unchanged)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"existing summary + messageEmails: { sent: number, deferred: number, dropped: number }\" } },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-4\", \"FR-20\"]\n    }\n  ],\n\n  \"unchangedButAffected\": [\n    { \"path\": \"GET /api/files/:id\", \"note\": \"Adds registerFileAccess('message'). Participants who have not left and safeguarding leads are allowed; everyone else is denied. No contract change.\", \"requirementIds\": [\"FR-27\"] },\n    { \"path\": \"POST /api/files (upload)\", \"note\": \"Accepts context 'message' (unattached until sent). No other contract change.\", \"requirementIds\": [\"FR-11\", \"FR-27\"] }\n  ],\n\n  \"status\": \"complete\"\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":794,"cache_read_input_tokens":55926,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":794},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2e59def-a937-4e61-837c-a8e39741caba","uuid":"7baac29d-ab61-46cd-a86a-2730f69365c2","timestamp":"2026-11-09T17:26:30.887Z","request_id":"req_011Cgsk93wseEopRRL2XR3ri","wire_tool_inputs":{"toolu_014UxViYQujj3GCQ9JFM5si3":{"file_path":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-13\",\n  \"timestamp\": \"2026-11-09T22:40:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the stale SH-12 contracts.\",\n    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (FR-28)\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole, or requireSafeguardingLead for safeguarding routes → parseQuery / parseBody with schemas from src/lib/validators/messaging.ts → one service call in src/server/messaging/* → ok(data) / ok(data, {status:201}) / paginated(data, meta). (NFR-6)\",\n    \"envelopes\": {\n      \"success\": \"{ data: T }\",\n      \"list\": \"{ data: T[], meta: { page, pageSize, total } } for page-based lists. Pagination comes from parsePagination: default page size 20, max 100.\",\n      \"error\": \"{ error: { code, message, details? } }\"\n    },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409,\n      \"RATE_LIMITED\": 429\n    },\n    \"errorPolicy\": [\n      \"If the caller is not a participant, or has left (leftAt is set), the API returns 404 NOT_FOUND. A conversation cuid is never treated as authorisation. (NFR-1)\",\n      \"A contact-rule violation on create returns 403 FORBIDDEN, and nothing is written. (FR-6)\",\n      \"A send after the relationship has ended returns 403 FORBIDDEN with details.reason='RELATIONSHIP_ENDED'. (FR-7)\",\n      \"An edit or delete by someone other than the sender, more than 15 minutes after sending, or on an already-deleted message returns 403 FORBIDDEN. details.reason is 'NOT_SENDER', 'EDIT_WINDOW_EXPIRED' or 'ALREADY_DELETED'. (FR-15)\",\n      \"A rate-limit hit returns 429 RATE_LIMITED with details.retryAfterMs. (NFR-4)\",\n      \"A caller who is not an ADMIN with isSafeguardingLead=true (read from the database) gets 403 FORBIDDEN on /api/safeguarding/*. (FR-23, NFR-1)\"\n    ],\n    \"ids\": \"All ids are cuid strings. All timestamps are ISO 8601 UTC strings. The client renders them in the school timezone. (NFR-6)\"\n  },\n\n  \"components\": {\n    \"UserSummary\": { \"id\": \"string\", \"name\": \"string\", \"role\": \"ADMIN|TEACHER|STUDENT|PARENT\", \"avatarUrl\": \"string|null\" },\n    \"Attachment\": { \"fileId\": \"string\", \"name\": \"string\", \"mimeType\": \"string\", \"size\": \"number\", \"url\": \"string (/api/files/:id, gated by the 'message' file context, FR-27)\" },\n    \"MessageDTO\": {\n      \"id\": \"string\",\n      \"conversationId\": \"string\",\n      \"sender\": \"UserSummary\",\n      \"body\": \"string|null (null when deleted)\",\n      \"deleted\": \"boolean\",\n      \"editedAt\": \"string|null\",\n      \"createdAt\": \"string\",\n      \"updatedAt\": \"string\",\n      \"attachments\": \"Attachment[] (empty when deleted)\",\n      \"isOwn\": \"boolean\",\n      \"canEdit\": \"boolean (isOwn, not deleted, and now - createdAt ≤ 15 min)\"\n    },\n    \"ConversationListItem\": {\n      \"id\": \"string\",\n      \"subject\": \"string|null\",\n      \"participants\": \"UserSummary[] (excluding the caller)\",\n      \"preview\": \"string|null ('<first name>: <body ≤80>' or 'This message was deleted')\",\n      \"lastMessageAt\": \"string\",\n      \"unreadCount\": \"number (capped at 99)\",\n      \"muted\": \"boolean\",\n      \"archived\": \"boolean\"\n    },\n    \"ConversationDetail\": {\n      \"id\": \"string\",\n      \"subject\": \"string|null\",\n      \"createdById\": \"string\",\n      \"involvesStudent\": \"boolean\",\n      \"lastMessageAt\": \"string\",\n      \"participants\": \"(UserSummary & { leftAt: string|null })[]\",\n      \"me\": { \"lastReadAt\": \"string|null\", \"muted\": \"boolean\", \"archived\": \"boolean\" },\n      \"canSend\": \"boolean (canSendIn result, FR-7)\",\n      \"canLeave\": \"boolean (false when ≤2 participants, or when the caller is the creator and involvesStudent is true, FR-14)\"\n    },\n    \"ContactGroup\": { \"label\": \"string, e.g. 'My teachers', 'My child's teachers (Sam)', 'Students in MATH-7A', 'Parents of students in MATH-7A', 'Homeroom 7A', 'Staff', 'School office'\", \"contacts\": \"UserSummary[] (≤50 per group)\" },\n    \"SafeguardingMessageDTO\": \"MessageDTO with body always present (including deleted content), plus deletedAt: string|null and revisions: { body: string, createdAt: string }[] (NFR-3)\",\n    \"ReportDTO\": {\n      \"id\": \"string\",\n      \"status\": \"OPEN|REVIEWED|DISMISSED\",\n      \"reason\": \"string\",\n      \"reporter\": \"UserSummary\",\n      \"message\": \"SafeguardingMessageDTO\",\n      \"conversationId\": \"string\",\n      \"reviewedBy\": \"UserSummary|null\",\n      \"reviewedAt\": \"string|null\",\n      \"reviewNote\": \"string|null\",\n      \"createdAt\": \"string\"\n    },\n    \"MessagingSettings\": { \"quietStart\": \"HH:mm|null\", \"quietEnd\": \"HH:mm|null\" }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conversations\",\n      \"description\": \"Returns the caller's conversations that they have not left, sorted by lastMessageAt desc. The Inbox tab sends archived=false (the default) and the Archived tab sends archived=true. q matches participant name or subject. Polled every 30 s.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": { \"query\": { \"archived\": \"boolean? (default false)\", \"q\": \"string? ≤100\", \"page\": \"int? ≥1\", \"pageSize\": \"int? ≤100\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"ConversationListItem[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-9\", \"FR-13\", \"FR-28\", \"FR-31\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations\",\n      \"description\": \"Creates a conversation, adding the caller as a participant automatically, together with its first message. The request must pass validateNewConversation: 2–25 participants including the caller, canMessage(creator, p) for every participant, and a TEACHER or ADMIN in any group that contains a STUDENT. involvesStudent is computed here. The send side effects of POST .../messages also apply.\",\n      \"auth\": \"any authenticated user; rateLimit('msg:'+uid, 30, 60_000)\",\n      \"requestSchema\": { \"body\": { \"participantIds\": \"cuid[] 1..24 (excluding the caller, deduplicated)\", \"subject\": \"string? ≤120\", \"body\": \"string, trimmed, 1..5000\", \"fileIds\": \"cuid[]? ≤5 (owned by the caller, unattached, context 'message')\" } },\n      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"conversation\": \"ConversationDetail\", \"message\": \"MessageDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (contact rules, group without staff, more than 25 participants; nothing is created)\", \"429 RATE_LIMITED\"],\n      \"requirementIds\": [\"FR-6\", \"FR-11\", \"FR-12\", \"FR-16\", \"FR-17\", \"FR-28\", \"FR-30\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conversations/:id\",\n      \"description\": \"Returns the conversation header, the participants, the caller's state, canSend and canLeave.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"ConversationDetail\" } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-14\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conversations/:id/messages\",\n      \"description\": \"Keyset-paginated messages. Without a cursor it returns the latest page. 'before' loads older messages for the upward infinite scroll. 'after' (plus an optional 'since') is the 5-second poll, which returns new messages plus messages edited or deleted since the given time. A poll with nothing new returns empty arrays and is designed to respond in under 100 ms using @@index([conversationId, createdAt]).\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"cuid\" },\n        \"query\": { \"before\": \"cuid? (mutually exclusive with after)\", \"after\": \"cuid?\", \"since\": \"ISO datetime? (only with after)\", \"limit\": \"int? 1..30 (default 30)\" }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"messages\": \"MessageDTO[] in ascending createdAt order\",\n            \"changed\": \"MessageDTO[] (only when after+since is sent; messages with createdAt ≤ cursor and updatedAt > since)\",\n            \"hasMore\": \"boolean (older messages exist; only in initial and 'before' mode)\"\n          }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (before and after both sent, or since without after)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not a participant, or the cursor id is not in this conversation)\"],\n      \"requirementIds\": [\"FR-10\", \"FR-13\", \"FR-28\", \"NFR-1\", \"NFR-2\", \"NFR-3\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/messages\",\n      \"description\": \"Sends a message. Order: rate limit, participation, canSendIn (staff can always send; a non-staff sender needs a live relationship with at least one staff participant who has not left), attachment ownership, then a transaction that inserts the message, links the files, bumps lastMessageAt, sets the sender's lastReadAt and clears archivedAt for the other participants. After commit, onMessageSent runs for each other participant who has not muted or left: it deletes their older unread message.received row, notifies in-app and upserts PendingMessageEmail (dueAt = now + 10 min, create-only).\",\n      \"auth\": \"participant who has not left; rateLimit('msg:'+uid, 30, 60_000)\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"body\": \"string, trimmed, 1..5000\", \"fileIds\": \"cuid[]? ≤5\" } },\n      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"message\": \"MessageDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR (including invalid or foreign fileIds)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='RELATIONSHIP_ENDED'\", \"404 NOT_FOUND\", \"429 RATE_LIMITED details.retryAfterMs\"],\n      \"requirementIds\": [\"FR-7\", \"FR-11\", \"FR-19\", \"FR-20\", \"FR-27\", \"FR-28\", \"FR-31\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/read\",\n      \"description\": \"Sets the caller's lastReadAt to now, marks the caller's unread message.received notification for this conversation as read, and deletes the caller's PendingMessageEmail row for it.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": {} },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"lastReadAt\": \"string\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-14\", \"FR-20\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/mute\",\n      \"description\": \"Mutes or unmutes the conversation for the caller only. Muted participants get no message.received notification and no email.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"muted\": \"boolean\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"muted\": \"boolean\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-14\", \"FR-19\", \"FR-28\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/archive\",\n      \"description\": \"Archives or unarchives the conversation for the caller only. A new message from someone else unarchives it.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"archived\": \"boolean\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"archived\": \"boolean\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-9\", \"FR-14\", \"FR-28\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/leave\",\n      \"description\": \"Sets leftAt for the caller. After that the caller is treated as a non-participant (404, and no attachment access). Leaving is refused for conversations with 2 or fewer participants, and for the creator of a conversation where involvesStudent is true.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": {} },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"left\": true } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='ONE_TO_ONE'|'CREATOR_OF_STUDENT_GROUP'\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-14\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/messages/:id\",\n      \"description\": \"Edits the caller's own message within 15 minutes of sending. In one transaction it inserts a MessageRevision holding the old body, then updates body and editedAt.\",\n      \"auth\": \"sender, a participant who has not left, within 15 minutes\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"body\": \"string, trimmed, 1..5000\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"message\": \"MessageDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='NOT_SENDER'|'EDIT_WINDOW_EXPIRED'|'ALREADY_DELETED'\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-3\", \"FR-15\", \"FR-28\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/messages/:id\",\n      \"description\": \"Soft-deletes the caller's own message within 15 minutes by setting deletedAt. No hard delete is possible. The content stays visible to safeguarding leads.\",\n      \"auth\": \"sender, a participant who has not left, within 15 minutes\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"message\": \"MessageDTO (deleted:true, body:null)\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='NOT_SENDER'|'EDIT_WINDOW_EXPIRED'|'ALREADY_DELETED'\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-15\", \"FR-28\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/messages/:id/report\",\n      \"description\": \"Reports another participant's message. After commit, every ACTIVE safeguarding lead gets a message.reported notification (mandatory in-app plus email, without the message text) linking to /admin/safeguarding?report=<id>. The client shows the toast 'Reported — the school will review this.'\",\n      \"auth\": \"participant who has not left, not the sender\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"reason\": \"string, trimmed, 1..1000\" } },\n      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"reportId\": \"string\", \"status\": \"OPEN\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (reporting your own message)\", \"404 NOT_FOUND\", \"409 CONFLICT (an OPEN report from this user on this message already exists)\"],\n      \"requirementIds\": [\"FR-22\", \"FR-26\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/messaging/unread-count\",\n      \"description\": \"Returns the number of conversations the caller has not left where lastMessageAt > coalesce(lastReadAt, epoch). It runs as a single $queryRaw COUNT and backs the sidebar badge, which polls every 30 s.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"count\": \"number\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-13\", \"FR-18\", \"FR-28\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/messaging/contacts\",\n      \"description\": \"Returns only the users the caller can message (canMessage), in labelled groups. Users the caller cannot message are never returned.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": { \"query\": { \"q\": \"string? ≤100 (case-insensitive name match)\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"groups\": \"ContactGroup[]\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-5\", \"FR-8\", \"FR-12\", \"FR-16\", \"FR-28\", \"FR-32\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/messaging-settings\",\n      \"description\": \"Returns the caller's quiet hours. Both values are null when none are set.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"MessagingSettings\" } },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-21\", \"FR-28\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/me/messaging-settings\",\n      \"description\": \"Upserts the caller's quiet hours as HH:mm in the school timezone. The range may wrap midnight. quietStart and quietEnd must be both set or both null (null clears them), and start must not equal end.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": { \"body\": { \"quietStart\": \"string /^([01]\\\\d|2[0-3]):[0-5]\\\\d$/ | null\", \"quietEnd\": \"string /^([01]\\\\d|2[0-3]):[0-5]\\\\d$/ | null\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"MessagingSettings\" } },\n      \"errors\": [\"400 VALIDATION_ERROR (only one value set, bad format, or start == end)\", \"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"FR-28\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/reports\",\n      \"description\": \"The reports queue, with OPEN reports first and then by createdAt desc. The optional status filter narrows the list.\",\n      \"auth\": \"ADMIN with isSafeguardingLead (read from the database)\",\n      \"requestSchema\": { \"query\": { \"status\": \"OPEN|REVIEWED|DISMISSED?\", \"page\": \"int?\", \"pageSize\": \"int? ≤100\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"(ReportDTO without the context fields)[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\"],\n      \"requirementIds\": [\"FR-23\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/reports/:id\",\n      \"description\": \"Report detail: the reported message, the 5 messages before and the 5 after it (including deleted content and revisions), and the participants. Each call writes audit('safeguarding.conversation.view', entityType 'Conversation').\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"report\": \"ReportDTO\", \"before\": \"SafeguardingMessageDTO[] (≤5)\", \"after\": \"SafeguardingMessageDTO[] (≤5)\", \"participants\": \"(UserSummary & { leftAt: string|null })[]\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-23\", \"FR-25\", \"FR-28\", \"NFR-1\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/safeguarding/reports/:id\",\n      \"description\": \"Marks a report reviewed or dismissed. A review requires a note; for a dismissal the note is optional. Sets status, reviewedById, reviewedAt and reviewNote, and writes audit('safeguarding.report.review' or 'safeguarding.report.dismiss').\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"action\": \"'review'|'dismiss'\", \"note\": \"string? ≤1000 (required when action is 'review')\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"report\": \"ReportDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\", \"409 CONFLICT (report is no longer OPEN)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-28\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/conversations\",\n      \"description\": \"Searches conversations where involvesStudent is true. Filters: a participant, and a createdAt or lastMessageAt range. Ordered by lastMessageAt desc.\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"query\": { \"participantId\": \"cuid?\", \"from\": \"ISO date?\", \"to\": \"ISO date?\", \"page\": \"int?\", \"pageSize\": \"int? ≤100\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"{ id, subject, participants: UserSummary[], createdAt, lastMessageAt, messageCount, openReportCount }[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\"],\n      \"requirementIds\": [\"FR-24\", \"FR-28\", \"FR-30\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/conversations/:id\",\n      \"description\": \"Read-only view of the full thread, including deleted content (marked as deleted) and the original text of edited messages. Every call writes audit('safeguarding.conversation.view').\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"conversation\": \"ConversationDetail without me/canSend/canLeave\", \"messages\": \"SafeguardingMessageDTO[] in ascending order\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND (also returned when involvesStudent is false)\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-28\", \"NFR-1\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/users/:id\",\n      \"description\": \"EXISTING endpoint, extended with an optional isSafeguardingLead flag. Setting it to true on a non-ADMIN user is rejected. The change is audited in the existing user.update metadata. There is no admin form, so the API and the seed are the only way to set it (ADR-11).\",\n      \"auth\": \"ADMIN (unchanged)\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"...existing fields\": \"unchanged\", \"isSafeguardingLead\": \"boolean?\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"existing user DTO + isSafeguardingLead: boolean\" } },\n      \"errors\": [\"400 VALIDATION_ERROR details.reason='SAFEGUARDING_LEAD_REQUIRES_ADMIN'\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-2\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING maintenance endpoint. Its request and response contract does not change. It also runs processPendingMessageEmails(now) in its own try/catch, processing at most 200 due rows per run. A user who has read, muted or left the conversation is dropped, a user in quiet hours is deferred to the end of quiet hours, and everyone else is sent the email with notify({inApp:false}).\",\n      \"auth\": \"CRON_SECRET (unchanged)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"existing summary + messageEmails: { sent: number, deferred: number, dropped: number }\" } },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-4\", \"FR-20\"]\n    }\n  ],\n\n  \"unchangedButAffected\": [\n    { \"path\": \"GET /api/files/:id\", \"note\": \"Adds registerFileAccess('message'). Participants who have not left and safeguarding leads are allowed; everyone else is denied. No contract change.\", \"requirementIds\": [\"FR-27\"] },\n    { \"path\": \"POST /api/files (upload)\", \"note\": \"Accepts context 'message' (unattached until sent). No other contract change.\", \"requirementIds\": [\"FR-11\", \"FR-27\"] }\n  ],\n\n  \"status\": \"complete\"\n}\n"}}}
{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","resetsAt":1794261600,"rateLimitType":"five_hour","overageStatus":"rejected","overageDisabledReason":"org_level_disabled_until","isUsingOverage":false,"unifiedWindows":{"five_hour":{"utilization":0.31,"resetsAt":1794261600,"status":"allowed"},"seven_day":{"utilization":0.19,"resetsAt":1794718800,"status":"allowed"}}},"uuid":"032f65d1-ea66-43e9-a241-35320a0b844e","session_id":"d2e59def-a937-4e61-837c-a8e39741caba"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014UxViYQujj3GCQ9JFM5si3","type":"tool_result","content":"The file /Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"d2e59def-a937-4e61-837c-a8e39741caba","uuid":"4d57ee04-eee1-4c2e-a1a7-50d797bbcdcb","timestamp":"2026-11-09T17:26:30.981Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-13\",\n  \"timestamp\": \"2026-11-09T22:40:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the stale SH-12 contracts.\",\n    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (FR-28)\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole, or requireSafeguardingLead for safeguarding routes → parseQuery / parseBody with schemas from src/lib/validators/messaging.ts → one service call in src/server/messaging/* → ok(data) / ok(data, {status:201}) / paginated(data, meta). (NFR-6)\",\n    \"envelopes\": {\n      \"success\": \"{ data: T }\",\n      \"list\": \"{ data: T[], meta: { page, pageSize, total } } for page-based lists. Pagination comes from parsePagination: default page size 20, max 100.\",\n      \"error\": \"{ error: { code, message, details? } }\"\n    },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409,\n      \"RATE_LIMITED\": 429\n    },\n    \"errorPolicy\": [\n      \"If the caller is not a participant, or has left (leftAt is set), the API returns 404 NOT_FOUND. A conversation cuid is never treated as authorisation. (NFR-1)\",\n      \"A contact-rule violation on create returns 403 FORBIDDEN, and nothing is written. (FR-6)\",\n      \"A send after the relationship has ended returns 403 FORBIDDEN with details.reason='RELATIONSHIP_ENDED'. (FR-7)\",\n      \"An edit or delete by someone other than the sender, more than 15 minutes after sending, or on an already-deleted message returns 403 FORBIDDEN. details.reason is 'NOT_SENDER', 'EDIT_WINDOW_EXPIRED' or 'ALREADY_DELETED'. (FR-15)\",\n      \"A rate-limit hit returns 429 RATE_LIMITED with details.retryAfterMs. (NFR-4)\",\n      \"A caller who is not an ADMIN with isSafeguardingLead=true (read from the database) gets 403 FORBIDDEN on /api/safeguarding/*. (FR-23, NFR-1)\"\n    ],\n    \"ids\": \"All ids are cuid strings. All timestamps are ISO 8601 UTC strings. The client renders them in the school timezone. (NFR-6)\"\n  },\n\n  \"components\": {\n    \"UserSummary\": { \"id\": \"string\", \"name\": \"string\", \"role\": \"ADMIN|TEACHER|STUDENT|PARENT\", \"avatarUrl\": \"string|null\" },\n    \"Attachment\": { \"fileId\": \"string\", \"name\": \"string\", \"mimeType\": \"string\", \"size\": \"number\", \"url\": \"string (/api/files/:id, gated by the 'message' file context, FR-27)\" },\n    \"MessageDTO\": {\n      \"id\": \"string\",\n      \"conversationId\": \"string\",\n      \"sender\": \"UserSummary\",\n      \"body\": \"string|null (null when deleted)\",\n      \"deleted\": \"boolean\",\n      \"editedAt\": \"string|null\",\n      \"createdAt\": \"string\",\n      \"updatedAt\": \"string\",\n      \"attachments\": \"Attachment[] (empty when deleted)\",\n      \"isOwn\": \"boolean\",\n      \"canEdit\": \"boolean (isOwn, not deleted, and now - createdAt ≤ 15 min)\"\n    },\n    \"ConversationListItem\": {\n      \"id\": \"string\",\n      \"subject\": \"string|null\",\n      \"participants\": \"UserSummary[] (excluding the caller)\",\n      \"preview\": \"string|null ('<first name>: <body ≤80>' or 'This message was deleted')\",\n      \"lastMessageAt\": \"string\",\n      \"unreadCount\": \"number (capped at 99)\",\n      \"muted\": \"boolean\",\n      \"archived\": \"boolean\"\n    },\n    \"ConversationDetail\": {\n      \"id\": \"string\",\n      \"subject\": \"string|null\",\n      \"createdById\": \"string\",\n      \"involvesStudent\": \"boolean\",\n      \"lastMessageAt\": \"string\",\n      \"participants\": \"(UserSummary & { leftAt: string|null })[]\",\n      \"me\": { \"lastReadAt\": \"string|null\", \"muted\": \"boolean\", \"archived\": \"boolean\" },\n      \"canSend\": \"boolean (canSendIn result, FR-7)\",\n      \"canLeave\": \"boolean (false when ≤2 participants, or when the caller is the creator and involvesStudent is true, FR-14)\"\n    },\n    \"ContactGroup\": { \"label\": \"string, e.g. 'My teachers', 'My child's teachers (Sam)', 'Students in MATH-7A', 'Parents of students in MATH-7A', 'Homeroom 7A', 'Staff', 'School office'\", \"contacts\": \"UserSummary[] (≤50 per group)\" },\n    \"SafeguardingMessageDTO\": \"MessageDTO with body always present (including deleted content), plus deletedAt: string|null and revisions: { body: string, createdAt: string }[] (NFR-3)\",\n    \"ReportDTO\": {\n      \"id\": \"string\",\n      \"status\": \"OPEN|REVIEWED|DISMISSED\",\n      \"reason\": \"string\",\n      \"reporter\": \"UserSummary\",\n      \"message\": \"SafeguardingMessageDTO\",\n      \"conversationId\": \"string\",\n      \"reviewedBy\": \"UserSummary|null\",\n      \"reviewedAt\": \"string|null\",\n      \"reviewNote\": \"string|null\",\n      \"createdAt\": \"string\"\n    },\n    \"MessagingSettings\": { \"quietStart\": \"HH:mm|null\", \"quietEnd\": \"HH:mm|null\" }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conversations\",\n      \"description\": \"Returns the caller's conversations that they have not left, sorted by lastMessageAt desc. The Inbox tab sends archived=false (the default) and the Archived tab sends archived=true. q matches participant name or subject. Polled every 30 s.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": { \"query\": { \"archived\": \"boolean? (default false)\", \"q\": \"string? ≤100\", \"page\": \"int? ≥1\", \"pageSize\": \"int? ≤100\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"ConversationListItem[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-9\", \"FR-13\", \"FR-28\", \"FR-31\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations\",\n      \"description\": \"Creates a conversation, adding the caller as a participant automatically, together with its first message. The request must pass validateNewConversation: 2–25 participants including the caller, canMessage(creator, p) for every participant, and a TEACHER or ADMIN in any group that contains a STUDENT. involvesStudent is computed here. The send side effects of POST .../messages also apply.\",\n      \"auth\": \"any authenticated user; rateLimit('msg:'+uid, 30, 60_000)\",\n      \"requestSchema\": { \"body\": { \"participantIds\": \"cuid[] 1..24 (excluding the caller, deduplicated)\", \"subject\": \"string? ≤120\", \"body\": \"string, trimmed, 1..5000\", \"fileIds\": \"cuid[]? ≤5 (owned by the caller, unattached, context 'message')\" } },\n      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"conversation\": \"ConversationDetail\", \"message\": \"MessageDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (contact rules, group without staff, more than 25 participants; nothing is created)\", \"429 RATE_LIMITED\"],\n      \"requirementIds\": [\"FR-6\", \"FR-11\", \"FR-12\", \"FR-16\", \"FR-17\", \"FR-28\", \"FR-30\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conversations/:id\",\n      \"description\": \"Returns the conversation header, the participants, the caller's state, canSend and canLeave.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"ConversationDetail\" } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-14\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conversations/:id/messages\",\n      \"description\": \"Keyset-paginated messages. Without a cursor it returns the latest page. 'before' loads older messages for the upward infinite scroll. 'after' (plus an optional 'since') is the 5-second poll, which returns new messages plus messages edited or deleted since the given time. A poll with nothing new returns empty arrays and is designed to respond in under 100 ms using @@index([conversationId, createdAt]).\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"cuid\" },\n        \"query\": { \"before\": \"cuid? (mutually exclusive with after)\", \"after\": \"cuid?\", \"since\": \"ISO datetime? (only with after)\", \"limit\": \"int? 1..30 (default 30)\" }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"messages\": \"MessageDTO[] in ascending createdAt order\",\n            \"changed\": \"MessageDTO[] (only when after+since is sent; messages with createdAt ≤ cursor and updatedAt > since)\",\n            \"hasMore\": \"boolean (older messages exist; only in initial and 'before' mode)\"\n          }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (before and after both sent, or since without after)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not a participant, or the cursor id is not in this conversation)\"],\n      \"requirementIds\": [\"FR-10\", \"FR-13\", \"FR-28\", \"NFR-1\", \"NFR-2\", \"NFR-3\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/messages\",\n      \"description\": \"Sends a message. Order: rate limit, participation, canSendIn (staff can always send; a non-staff sender needs a live relationship with at least one staff participant who has not left), attachment ownership, then a transaction that inserts the message, links the files, bumps lastMessageAt, sets the sender's lastReadAt and clears archivedAt for the other participants. After commit, onMessageSent runs for each other participant who has not muted or left: it deletes their older unread message.received row, notifies in-app and upserts PendingMessageEmail (dueAt = now + 10 min, create-only).\",\n      \"auth\": \"participant who has not left; rateLimit('msg:'+uid, 30, 60_000)\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"body\": \"string, trimmed, 1..5000\", \"fileIds\": \"cuid[]? ≤5\" } },\n      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"message\": \"MessageDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR (including invalid or foreign fileIds)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='RELATIONSHIP_ENDED'\", \"404 NOT_FOUND\", \"429 RATE_LIMITED details.retryAfterMs\"],\n      \"requirementIds\": [\"FR-7\", \"FR-11\", \"FR-19\", \"FR-20\", \"FR-27\", \"FR-28\", \"FR-31\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/read\",\n      \"description\": \"Sets the caller's lastReadAt to now, marks the caller's unread message.received notification for this conversation as read, and deletes the caller's PendingMessageEmail row for it.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": {} },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"lastReadAt\": \"string\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-14\", \"FR-20\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/mute\",\n      \"description\": \"Mutes or unmutes the conversation for the caller only. Muted participants get no message.received notification and no email.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"muted\": \"boolean\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"muted\": \"boolean\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-14\", \"FR-19\", \"FR-28\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/archive\",\n      \"description\": \"Archives or unarchives the conversation for the caller only. A new message from someone else unarchives it.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"archived\": \"boolean\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"archived\": \"boolean\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-9\", \"FR-14\", \"FR-28\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conversations/:id/leave\",\n      \"description\": \"Sets leftAt for the caller. After that the caller is treated as a non-participant (404, and no attachment access). Leaving is refused for conversations with 2 or fewer participants, and for the creator of a conversation where involvesStudent is true.\",\n      \"auth\": \"participant who has not left\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": {} },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"left\": true } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='ONE_TO_ONE'|'CREATOR_OF_STUDENT_GROUP'\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-14\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/messages/:id\",\n      \"description\": \"Edits the caller's own message within 15 minutes of sending. In one transaction it inserts a MessageRevision holding the old body, then updates body and editedAt.\",\n      \"auth\": \"sender, a participant who has not left, within 15 minutes\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"body\": \"string, trimmed, 1..5000\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"message\": \"MessageDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='NOT_SENDER'|'EDIT_WINDOW_EXPIRED'|'ALREADY_DELETED'\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-3\", \"FR-15\", \"FR-28\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/messages/:id\",\n      \"description\": \"Soft-deletes the caller's own message within 15 minutes by setting deletedAt. No hard delete is possible. The content stays visible to safeguarding leads.\",\n      \"auth\": \"sender, a participant who has not left, within 15 minutes\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"message\": \"MessageDTO (deleted:true, body:null)\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='NOT_SENDER'|'EDIT_WINDOW_EXPIRED'|'ALREADY_DELETED'\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-15\", \"FR-28\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/messages/:id/report\",\n      \"description\": \"Reports another participant's message. After commit, every ACTIVE safeguarding lead gets a message.reported notification (mandatory in-app plus email, without the message text) linking to /admin/safeguarding?report=<id>. The client shows the toast 'Reported — the school will review this.'\",\n      \"auth\": \"participant who has not left, not the sender\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"reason\": \"string, trimmed, 1..1000\" } },\n      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"reportId\": \"string\", \"status\": \"OPEN\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (reporting your own message)\", \"404 NOT_FOUND\", \"409 CONFLICT (an OPEN report from this user on this message already exists)\"],\n      \"requirementIds\": [\"FR-22\", \"FR-26\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/messaging/unread-count\",\n      \"description\": \"Returns the number of conversations the caller has not left where lastMessageAt > coalesce(lastReadAt, epoch). It runs as a single $queryRaw COUNT and backs the sidebar badge, which polls every 30 s.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"count\": \"number\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-13\", \"FR-18\", \"FR-28\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/messaging/contacts\",\n      \"description\": \"Returns only the users the caller can message (canMessage), in labelled groups. Users the caller cannot message are never returned.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": { \"query\": { \"q\": \"string? ≤100 (case-insensitive name match)\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"groups\": \"ContactGroup[]\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-5\", \"FR-8\", \"FR-12\", \"FR-16\", \"FR-28\", \"FR-32\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/messaging-settings\",\n      \"description\": \"Returns the caller's quiet hours. Both values are null when none are set.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"MessagingSettings\" } },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-21\", \"FR-28\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/me/messaging-settings\",\n      \"description\": \"Upserts the caller's quiet hours as HH:mm in the school timezone. The range may wrap midnight. quietStart and quietEnd must be both set or both null (null clears them), and start must not equal end.\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": { \"body\": { \"quietStart\": \"string /^([01]\\\\d|2[0-3]):[0-5]\\\\d$/ | null\", \"quietEnd\": \"string /^([01]\\\\d|2[0-3]):[0-5]\\\\d$/ | null\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"MessagingSettings\" } },\n      \"errors\": [\"400 VALIDATION_ERROR (only one value set, bad format, or start == end)\", \"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"FR-28\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/reports\",\n      \"description\": \"The reports queue, with OPEN reports first and then by createdAt desc. The optional status filter narrows the list.\",\n      \"auth\": \"ADMIN with isSafeguardingLead (read from the database)\",\n      \"requestSchema\": { \"query\": { \"status\": \"OPEN|REVIEWED|DISMISSED?\", \"page\": \"int?\", \"pageSize\": \"int? ≤100\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"(ReportDTO without the context fields)[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\"],\n      \"requirementIds\": [\"FR-23\", \"FR-28\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/reports/:id\",\n      \"description\": \"Report detail: the reported message, the 5 messages before and the 5 after it (including deleted content and revisions), and the participants. Each call writes audit('safeguarding.conversation.view', entityType 'Conversation').\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"report\": \"ReportDTO\", \"before\": \"SafeguardingMessageDTO[] (≤5)\", \"after\": \"SafeguardingMessageDTO[] (≤5)\", \"participants\": \"(UserSummary & { leftAt: string|null })[]\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-23\", \"FR-25\", \"FR-28\", \"NFR-1\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/safeguarding/reports/:id\",\n      \"description\": \"Marks a report reviewed or dismissed. A review requires a note; for a dismissal the note is optional. Sets status, reviewedById, reviewedAt and reviewNote, and writes audit('safeguarding.report.review' or 'safeguarding.report.dismiss').\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"action\": \"'review'|'dismiss'\", \"note\": \"string? ≤1000 (required when action is 'review')\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"report\": \"ReportDTO\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\", \"409 CONFLICT (report is no longer OPEN)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-28\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/conversations\",\n      \"description\": \"Searches conversations where involvesStudent is true. Filters: a participant, and a createdAt or lastMessageAt range. Ordered by lastMessageAt desc.\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"query\": { \"participantId\": \"cuid?\", \"from\": \"ISO date?\", \"to\": \"ISO date?\", \"page\": \"int?\", \"pageSize\": \"int? ≤100\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"{ id, subject, participants: UserSummary[], createdAt, lastMessageAt, messageCount, openReportCount }[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\"],\n      \"requirementIds\": [\"FR-24\", \"FR-28\", \"FR-30\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/safeguarding/conversations/:id\",\n      \"description\": \"Read-only view of the full thread, including deleted content (marked as deleted) and the original text of edited messages. Every call writes audit('safeguarding.conversation.view').\",\n      \"auth\": \"ADMIN with isSafeguardingLead\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"conversation\": \"ConversationDetail without me/canSend/canLeave\", \"messages\": \"SafeguardingMessageDTO[] in ascending order\" } } },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND (also returned when involvesStudent is false)\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-28\", \"NFR-1\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/users/:id\",\n      \"description\": \"EXISTING endpoint, extended with an optional isSafeguardingLead flag. Setting it to true on a non-ADMIN user is rejected. The change is audited in the existing user.update metadata. There is no admin form, so the API and the seed are the only way to set it (ADR-11).\",\n      \"auth\": \"ADMIN (unchanged)\",\n      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"...existing fields\": \"unchanged\", \"isSafeguardingLead\": \"boolean?\" } },\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"existing user DTO + isSafeguardingLead: boolean\" } },\n      \"errors\": [\"400 VALIDATION_ERROR details.reason='SAFEGUARDING_LEAD_REQUIRES_ADMIN'\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-2\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING maintenance endpoint. Its request and response contract does not change. It also runs processPendingMessageEmails(now) in its own try/catch, processing at most 200 due rows per run. A user who has read, muted or left the conversation is dropped, a user in quiet hours is deferred to the end of quiet hours, and everyone else is sent the email with notify({inApp:false}).\",\n      \"auth\": \"CRON_SECRET (unchanged)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"existing summary + messageEmails: { sent: number, deferred: number, dropped: number }\" } },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-4\", \"FR-20\"]\n    }\n  ],\n\n  \"unchangedButAffected\": [\n    { \"path\": \"GET /api/files/:id\", \"note\": \"Adds registerFileAccess('message'). Participants who have not left and safeguarding leads are allowed; everyone else is denied. No contract change.\", \"requirementIds\": [\"FR-27\"] },\n    { \"path\": \"POST /api/files (upload)\", \"note\": \"Accepts context 'message' (unattached until sent). No other contract change.\", \"requirementIds\": [\"FR-11\", \"FR-27\"] }\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":427,"newStart":1,"newLines":340,"lines":[" {","-  \"ticketId\": \"SH-12\",","-  \"timestamp\": \"2026-11-09T19:30:00Z\",","+  \"ticketId\": \"SH-13\",","+  \"timestamp\": \"2026-11-09T22:40:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\","," ","   \"conventions\": {","-    \"replaces\": \"This file replaces the SH-11 contracts that were here before.\",","-    \"basePath\": \"/api (the existing SchoolHub convention, not /api/v1). Route files are src/app/api/**/route.ts. Requirement: FR-34.\",","-    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with a Zod schema from src/lib/validators/announcements.ts → one call into src/server/announcements/announcements-service.ts → ok(data) / ok(data, {status: 201}) / paginated(data, meta). No business logic in routes. Requirements: FR-34, FR-36, NFR-8.\",","-    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. Paginated endpoints return { \\\"data\\\": [...], \\\"meta\\\": { page, pageSize, total } } via paginated() in src/server/http.ts. Requirement: FR-34.\",","-    \"pagination\": \"?page (≥1, default 1) & ?pageSize (default 20, max 100 via parsePagination; GET /api/announcements/manage clamps to 50 because it computes live reach per row). Requirements: FR-17, FR-23, FR-31.\",","-    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } }. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, RATE_LIMITED 429, INTERNAL 500. Requirement: FR-34.\",","-    \"accessErrors\": \"Targeting violations on create, update and preview return 403 FORBIDDEN (AC-3). STUDENT/PARENT on ADMIN/TEACHER routes get 403 from requireRole (FR-11). Callers who may not see a specific announcement (non-member, non-author, or not yet visible) get 404 NOT_FOUND on detail, ack, stats, remind, PATCH and archive, so its existence is not leaked (system-design A10). Requirements: NFR-3, NFR-6.\",","-    \"dates\": \"All timestamps are ISO 8601 UTC strings. The composer converts SchoolSettings.timezone input to UTC before sending. Clients display with formatInSchoolTz. Requirement: NFR-7.\",","-    \"visibility\": \"visible = status ∈ {SCHEDULED, PUBLISHED} ∧ publishAt ≤ now ∧ (expiresAt null ∨ expiresAt > now), evaluated at read time. Requirements: FR-16, NFR-6.\",","-    \"sanitisation\": \"`body` is raw Markdown, rendered client-side only through MarkdownView (rehype-sanitize). `excerpt` is plain text from toPlainText and must be rendered as escaped text. Requirement: NFR-4.\"","+    \"replaces\": \"This file replaces the stale SH-12 contracts.\",","+    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (FR-28)\",","+    \"handlerPipeline\": \"withHandler → requireUser / requireRole, or requireSafeguardingLead for safeguarding routes → parseQuery / parseBody with schemas from src/lib/validators/messaging.ts → one service call in src/server/messaging/* → ok(data) / ok(data, {status:201}) / paginated(data, meta). (NFR-6)\",","+    \"envelopes\": {","+      \"success\": \"{ data: T }\",","+      \"list\": \"{ data: T[], meta: { page, pageSize, total } } for page-based lists. Pagination comes from parsePagination: default page size 20, max 100.\",","+      \"error\": \"{ error: { code, message, details? } }\"","+    },","+    \"errorCodes\": {","+      \"VALIDATION_ERROR\": 400,","+      \"UNAUTHENTICATED\": 401,","+      \"FORBIDDEN\": 403,","+      \"NOT_FOUND\": 404,","+      \"CONFLICT\": 409,","+      \"RATE_LIMITED\": 429","+    },","+    \"errorPolicy\": [","+      \"If the caller is not a participant, or has left (leftAt is set), the API returns 404 NOT_FOUND. A conversation cuid is never treated as authorisation. (NFR-1)\",","+      \"A contact-rule violation on create returns 403 FORBIDDEN, and nothing is written. (FR-6)\",","+      \"A send after the relationship has ended returns 403 FORBIDDEN with details.reason='RELATIONSHIP_ENDED'. (FR-7)\",","+      \"An edit or delete by someone other than the sender, more than 15 minutes after sending, or on an already-deleted message returns 403 FORBIDDEN. details.reason is 'NOT_SENDER', 'EDIT_WINDOW_EXPIRED' or 'ALREADY_DELETED'. (FR-15)\",","+      \"A rate-limit hit returns 429 RATE_LIMITED with details.retryAfterMs. (NFR-4)\",","+      \"A caller who is not an ADMIN with isSafeguardingLead=true (read from the database) gets 403 FORBIDDEN on /api/safeguarding/*. (FR-23, NFR-1)\"","+    ],","+    \"ids\": \"All ids are cuid strings. All timestamps are ISO 8601 UTC strings. The client renders them in the school timezone. (NFR-6)\"","   },"," ","   \"components\": {","-    \"AudienceRow\": {","-      \"description\": \"Generic audience row (FR-8). refId is required unless the type is SCHOOL or STAFF. For ROLE it must be a Role value. For GRADE_LEVEL, SECTION and COURSE, at least one include flag must be true. Requirements: FR-1, FR-3..FR-6.\",","-      \"type\": \"object\",","-      \"properties\": {","-        \"type\": { \"enum\": [\"SCHOOL\", \"STAFF\", \"ROLE\", \"GRADE_LEVEL\", \"SECTION\", \"COURSE\"] },","-        \"refId\": { \"type\": [\"string\", \"null\"], \"description\": \"GradeLevel.id | Section.id | Course.id | Role value\" },","-        \"includeStudents\": { \"type\": \"boolean\", \"default\": true },","-        \"includeParents\": { \"type\": \"boolean\", \"default\": true },","-        \"includeTeachers\": { \"type\": \"boolean\", \"default\": true }","-      },","-      \"required\": [\"type\"]","+    \"UserSummary\": { \"id\": \"string\", \"name\": \"string\", \"role\": \"ADMIN|TEACHER|STUDENT|PARENT\", \"avatarUrl\": \"string|null\" },","+    \"Attachment\": { \"fileId\": \"string\", \"name\": \"string\", \"mimeType\": \"string\", \"size\": \"number\", \"url\": \"string (/api/files/:id, gated by the 'message' file context, FR-27)\" },","+    \"MessageDTO\": {","+      \"id\": \"string\",","+      \"conversationId\": \"string\",","+      \"sender\": \"UserSummary\",","+      \"body\": \"string|null (null when deleted)\",","+      \"deleted\": \"boolean\",","+      \"editedAt\": \"string|null\",","+      \"createdAt\": \"string\",","+      \"updatedAt\": \"string\",","+      \"attachments\": \"Attachment[] (empty when deleted)\",","+      \"isOwn\": \"boolean\",","+      \"canEdit\": \"boolean (isOwn, not deleted, and now - createdAt ≤ 15 min)\"","     },","-    \"AnnouncementInput\": {","-      \"description\": \"Body of POST /api/announcements. Mirrors announcementInputSchema. Requirements: FR-2, FR-13, FR-15, FR-16.\",","-      \"type\": \"object\",","-      \"properties\": {","-        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150, \"description\": \"Trimmed\" },","-        \"body\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 20000, \"description\": \"Markdown\" },","-        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"minItems\": 0, \"maxItems\": 20 },","-        \"pinned\": { \"type\": \"boolean\", \"default\": false },","-        \"requiresAck\": { \"type\": \"boolean\", \"default\": false },","-        \"isPublic\": { \"type\": \"boolean\", \"default\": false, \"description\": \"ADMIN only. true from a TEACHER → 403 (FR-10)\" },","-        \"coverFileId\": { \"type\": [\"string\", \"null\"], \"description\": \"FileObject id uploaded with context 'announcement'\" },","-        \"attachmentFileIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"maxItems\": 10, \"default\": [] },","-        \"mode\": { \"enum\": [\"draft\", \"publish\", \"schedule\"] },","-        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Required and > now when mode = schedule. Ignored for publish (set to now)\" },","-        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Must be > (publishAt ?? now)\" }","-      },","-      \"required\": [\"title\", \"body\", \"audiences\", \"mode\"]","+    \"ConversationListItem\": {","+      \"id\": \"string\",","+      \"subject\": \"string|null\",","+      \"participants\": \"UserSummary[] (excluding the caller)\",","+      \"preview\": \"string|null ('<first name>: <body ≤80>' or 'This message was deleted')\",","+      \"lastMessageAt\": \"string\",","+      \"unreadCount\": \"number (capped at 99)\",","+      \"muted\": \"boolean\",","+      \"archived\": \"boolean\"","     },","-    \"AnnouncementPatch\": {","-      \"description\": \"AnnouncementInput with every field optional (announcementPatchSchema). audiences, when present, replaces all rows. Requirements: FR-12, FR-29.\",","-      \"type\": \"object\",","-      \"allOf\": [{ \"$ref\": \"#/components/AnnouncementInput\" }],","-      \"required\": []","+    \"ConversationDetail\": {","+      \"id\": \"string\",","+      \"subject\": \"string|null\",","+      \"createdById\": \"string\",","+      \"involvesStudent\": \"boolean\",","+      \"lastMessageAt\": \"string\",","+      \"participants\": \"(UserSummary & { leftAt: string|null })[]\",","+      \"me\": { \"lastReadAt\": \"string|null\", \"muted\": \"boolean\", \"archived\": \"boolean\" },","+      \"canSend\": \"boolean (canSendIn result, FR-7)\",","+      \"canLeave\": \"boolean (false when ≤2 participants, or when the caller is the creator and involvesStudent is true, FR-14)\"","     },","-    \"Author\": {","-      \"type\": \"object\",","-      \"properties\": {","-        \"id\": { \"type\": \"string\" },","-        \"name\": { \"type\": \"string\" },","-        \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\"] }","-      },","-      \"required\": [\"id\", \"name\", \"role\"]","+    \"ContactGroup\": { \"label\": \"string, e.g. 'My teachers', 'My child's teachers (Sam)', 'Students in MATH-7A', 'Parents of students in MATH-7A', 'Homeroom 7A', 'Staff', 'School office'\", \"contacts\": \"UserSummary[] (≤50 per group)\" },","+    \"SafeguardingMessageDTO\": \"MessageDTO with body always present (including deleted content), plus deletedAt: string|null and revisions: { body: string, createdAt: string }[] (NFR-3)\",","+    \"ReportDTO\": {","+      \"id\": \"string\",","+      \"status\": \"OPEN|REVIEWED|DISMISSED\",","+      \"reason\": \"string\",","+      \"reporter\": \"UserSummary\",","+      \"message\": \"SafeguardingMessageDTO\",","+      \"conversationId\": \"string\",","+      \"reviewedBy\": \"UserSummary|null\",","+      \"reviewedAt\": \"string|null\",","+      \"reviewNote\": \"string|null\",","+      \"createdAt\": \"string\"","     },","-    \"Attachment\": {","-      \"description\": \"Download via the existing GET /api/files/:id, gated by the 'announcement' file context (FR-30).\",","-      \"type\": \"object\",","-      \"properties\": {","-        \"id\": { \"type\": \"string\", \"description\": \"FileObject id\" },","-        \"name\": { \"type\": \"string\" },","-        \"mimeType\": { \"type\": \"string\" },","-        \"size\": { \"type\": \"integer\" }","-      },","-      \"required\": [\"id\", \"name\"]","-    },","-    \"FeedItem\": {","-      \"description\": \"Feed card DTO. Requirements: FR-17, FR-18, FR-22, NFR-5.\",","-      \"type\": \"object\",","-      \"properties\": {","-        \"id\": { \"type\": \"string\" },","-        \"title\": { \"type\": \"string\" },","-        \"excerpt\": { \"type\": \"string\", \"maxLength\": 200, \"description\": \"Plain text (toPlainText(body, 200))\" },","-        \"coverFileId\": { \"type\": [\"string\", \"null\"] },","-        \"author\": { \"$ref\": \"#/components/Author\" },","-        \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-        \"pinned\": { \"type\": \"boolean\", \"description\": \"true only for the ≤3 items lifted to the top of page 1\" },","-        \"requiresAck\": { \"type\": \"boolean\" },","-        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"Audience chips, e.g. 'Grade 7 · Parents'\" },","-        \"attachmentCount\": { \"type\": \"integer\" },","-        \"unread\": { \"type\": \"boolean\", \"description\": \"No AnnouncementRead.readAt for the caller. UI shows a dot with visually hidden text 'Unread'\" },","-        \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-        \"forChildren\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" } } }, \"description\": \"PARENT callers only; empty otherwise. The linked children that put the parent in a GRADE_LEVEL, SECTION or COURSE audience ('For Sam')\" }","-      },","-      \"required\": [\"id\", \"title\", \"excerpt\", \"author\", \"publishAt\", \"pinned\", \"requiresAck\", \"labels\", \"attachmentCount\", \"unread\", \"forChildren\"]","-    },","-    \"AnnouncementDetail\": {","-      \"description\": \"Full record for detail and edit. Requirements: FR-13, FR-19, FR-20.\",","-      \"type\": \"object\",","-      \"properties\": {","-        \"id\": { \"type\": \"string\" },","-        \"title\": { \"type\": \"string\" },","-        \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown. Render only via MarkdownView\" },","-        \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },","-        \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },","-        \"author\": { \"$ref\": \"#/components/Author\" },","-        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"description\": \"Returned only when canEdit; [] otherwise\" },","-        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },","-        \"pinned\": { \"type\": \"boolean\" },","-        \"requiresAck\": { \"type\": \"boolean\" },","-        \"isPublic\": { \"type\": \"boolean\" },","-        \"coverFileId\": { \"type\": [\"string\", \"null\"] },","-        \"attachments\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/Attachment\" } },","-        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-        \"myRead\": { \"type\": [\"object\", \"null\"], \"properties\": { \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" } }, \"description\": \"null when the caller is not an audience member (for example an admin outside the audience)\" },","-        \"canEdit\": { \"type\": \"boolean\", \"description\": \"ADMIN, or the author while not ARCHIVED\" },","-        \"canViewStats\": { \"type\": \"boolean\", \"description\": \"ADMIN or the author\" }","-      },","-      \"required\": [\"id\", \"title\", \"body\", \"status\", \"displayStatus\", \"author\", \"labels\", \"pinned\", \"requiresAck\", \"isPublic\", \"attachments\", \"canEdit\", \"canViewStats\"]","-    },","-    \"AudienceCounts\": {","-      \"description\": \"Requirements: FR-14, FR-15.\",","-      \"type\": \"object\",","-      \"properties\": {","-        \"total\": { \"type\": \"integer\" },","-        \"byRole\": {","-          \"type\": \"object\",","-          \"properties\": {","-            \"STUDENT\": { \"type\": \"integer\" },","-            \"PARENT\": { \"type\": \"integer\" },","-            \"TEACHER\": { \"type\": \"integer\" },","-            \"ADMIN\": { \"type\": \"integer\" }","-          },","-          \"required\": [\"STUDENT\", \"PARENT\", \"TEACHER\", \"ADMIN\"]","-        }","-      },","-      \"required\": [\"total\", \"byRole\"]","-    }","+    \"MessagingSettings\": { \"quietStart\": \"HH:mm|null\", \"quietEnd\": \"HH:mm|null\" }","   },"," ","   \"endpoints\": [","     {","       \"method\": \"GET\",","-      \"path\": \"/api/announcements\",","-      \"description\": \"Feed for the caller (any authenticated role). Only visible announcements whose audience includes the caller, resolved with audiences.some(audienceWhere(keys)) and never by expanding recipients (NFR-2). Page 1 starts with up to 3 pinned items (newest first, pinned=true), followed by the page of remaining items in publishAt desc, id desc order. meta.total excludes those lifted pins. Extra pinned items appear in date order with pinned=false (A4). With courseId, the caller must pass assertCanViewCourse (else 404) and results are limited to rows with a COURSE audience for that course. Expired, scheduled-future, draft and archived items are never returned.\",","-      \"auth\": \"requireUser\",","-      \"requestSchema\": {","-        \"query\": {","-          \"tab\": { \"enum\": [\"all\", \"unread\", \"ack\"], \"default\": \"all\", \"description\": \"unread = no readAt; ack = requiresAck and not acknowledged by the caller\" },","-          \"courseId\": { \"type\": \"string\", \"description\": \"Optional. Course 'Announcements' tab\" },","-          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },","-          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }","-        }","-      },","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": {","-          \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/FeedItem\" } },","-          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }","-        }","-      },","-      \"errors\": [\"400 VALIDATION_ERROR (bad query)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (courseId the caller cannot view)\"],","-      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-21\", \"FR-22\", \"FR-34\", \"NFR-2\", \"NFR-5\", \"NFR-6\"]","+      \"path\": \"/api/conversations\",","+      \"description\": \"Returns the caller's conversations that they have not left, sorted by lastMessageAt desc. The Inbox tab sends archived=false (the default) and the Archived tab sends archived=true. q matches participant name or subject. Polled every 30 s.\",","+      \"auth\": \"any authenticated user\",","+      \"requestSchema\": { \"query\": { \"archived\": \"boolean? (default false)\", \"q\": \"string? ≤100\", \"page\": \"int? ≥1\", \"pageSize\": \"int? ≤100\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"ConversationListItem[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-9\", \"FR-13\", \"FR-28\", \"FR-31\", \"NFR-1\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/announcements\",","-      \"description\": \"Create an announcement. assertCanTarget(user, audiences, isPublic) runs first. A TEACHER may target only COURSE rows for courses where they are teacherId or in coTeacherIds, and SECTION rows for the section they homeroom. Anything else, or isPublic=true, returns 403. For mode publish or schedule, zero resolved recipients returns 400 VALIDATION_ERROR (details.reason='NO_RECIPIENTS'). Drafts may have zero recipients. A single transaction writes the announcement, audience rows and attachment rows and calls attachFiles. mode=publish sets status PUBLISHED and publishAt=now, then claimAndNotify sends announcement.published exactly once (generic-notification email, 300-character plain-text body, 'Read announcement' link to /announcements/:id, mandatoryInApp = requiresAck). mode=schedule sets status SCHEDULED and does not notify. mode=draft sets status DRAFT.\",","-      \"auth\": \"requireRole(ADMIN, TEACHER)\",","-      \"requestSchema\": { \"body\": { \"$ref\": \"#/components/AnnouncementInput\" } },","-      \"responseSchema\": {","-        \"status\": 201,","-        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }","-      },","-      \"errors\": [\"400 VALIDATION_ERROR (Zod: title > 150, body > 20,000, schedule without a future publishAt, expiresAt ≤ publishAt; or NO_RECIPIENTS on publish/schedule)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT; teacher targeting SCHOOL/STAFF/ROLE/GRADE_LEVEL, a foreign course or section, or isPublic)\", \"404 NOT_FOUND (coverFileId or attachment not owned by the caller or not uploaded)\"],","-      \"requirementIds\": [\"FR-2\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-13\", \"FR-15\", \"FR-16\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-34\", \"NFR-3\"]","+      \"path\": \"/api/conversations\",","+      \"description\": \"Creates a conversation, adding the caller as a participant automatically, together with its first message. The request must pass validateNewConversation: 2–25 participants including the caller, canMessage(creator, p) for every participant, and a TEACHER or ADMIN in any group that contains a STUDENT. involvesStudent is computed here. The send side effects of POST .../messages also apply.\",","+      \"auth\": \"any authenticated user; rateLimit('msg:'+uid, 30, 60_000)\",","+      \"requestSchema\": { \"body\": { \"participantIds\": \"cuid[] 1..24 (excluding the caller, deduplicated)\", \"subject\": \"string? ≤120\", \"body\": \"string, trimmed, 1..5000\", \"fileIds\": \"cuid[]? ≤5 (owned by the caller, unattached, context 'message')\" } },","+      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"conversation\": \"ConversationDetail\", \"message\": \"MessageDTO\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (contact rules, group without staff, more than 25 participants; nothing is created)\", \"429 RATE_LIMITED\"],","+      \"requirementIds\": [\"FR-6\", \"FR-11\", \"FR-12\", \"FR-16\", \"FR-17\", \"FR-28\", \"FR-30\", \"NFR-1\", \"NFR-4\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/announcements/unread-count\",","-      \"description\": \"Sidebar badge count. Uses the same where clause as the feed's 'all' tab plus reads.none{userId, readAt not null}. Polled every 30 seconds, only while the page is visible.\",","-      \"auth\": \"requireUser\",","-      \"requestSchema\": {},","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": { \"data\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } }","-      },","-      \"errors\": [\"401 UNAUTHENTICATED\"],","-      \"requirementIds\": [\"FR-32\", \"FR-34\", \"NFR-2\"]","+      \"path\": \"/api/conversations/:id\",","+      \"description\": \"Returns the conversation header, the participants, the caller's state, canSend and canLeave.\",","+      \"auth\": \"participant who has not left\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"ConversationDetail\" } },","+      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],","+      \"requirementIds\": [\"FR-7\", \"FR-14\", \"FR-28\", \"NFR-1\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/announcements/preview-audience\",","-      \"description\": \"Live recipient count for the composer ('Will reach 412 people: 180 students, 214 parents, 18 teachers'). assertCanTarget(user, audiences, false) runs first, so teachers cannot probe the size of audiences they cannot target. Then countAudienceByRole. ACTIVE, non-archived users only, deduplicated. The client debounces calls by 400 ms.\",","-      \"auth\": \"requireRole(ADMIN, TEACHER)\",","-      \"requestSchema\": {","-        \"body\": {","-          \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"maxItems\": 20 }","-        }","-      },","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": { \"data\": { \"$ref\": \"#/components/AudienceCounts\" } }","-      },","-      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role, or teacher targeting violation)\"],","-      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-10\", \"FR-14\", \"FR-34\", \"NFR-3\"]","-    },","-    {","       \"method\": \"GET\",","-      \"path\": \"/api/announcements/manage\",","-      \"description\": \"Manage list with no visibility filter, so it includes drafts, scheduled, expired and archived items. TEACHER sees authorId = me; ADMIN sees all. Ordered by updatedAt desc. reach, readPct and ackPct are computed live against the current resolveAudienceUserIds, and reads from users who have left the audience are excluded. Percentages are integers rounded half-up; they are null when reach is 0, and ackPct is null when requiresAck is false.\",","-      \"auth\": \"requireRole(ADMIN, TEACHER)\",","+      \"path\": \"/api/conversations/:id/messages\",","+      \"description\": \"Keyset-paginated messages. Without a cursor it returns the latest page. 'before' loads older messages for the upward infinite scroll. 'after' (plus an optional 'since') is the 5-second poll, which returns new messages plus messages edited or deleted since the given time. A poll with nothing new returns empty arrays and is designed to respond in under 100 ms using @@index([conversationId, createdAt]).\",","+      \"auth\": \"participant who has not left\",","       \"requestSchema\": {","-        \"query\": {","-          \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"], \"description\": \"Optional filter on displayStatus\" },","-          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },","-          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 50, \"default\": 20 }","-        }","+        \"params\": { \"id\": \"cuid\" },","+        \"query\": { \"before\": \"cuid? (mutually exclusive with after)\", \"after\": \"cuid?\", \"since\": \"ISO datetime? (only with after)\", \"limit\": \"int? 1..30 (default 30)\" }","       },","       \"responseSchema\": {","         \"status\": 200,","         \"body\": {","           \"data\": {","-            \"type\": \"array\",","-            \"items\": {","-              \"type\": \"object\",","-              \"properties\": {","-                \"id\": { \"type\": \"string\" },","-                \"title\": { \"type\": \"string\" },","-                \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },","-                \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },","-                \"author\": { \"$ref\": \"#/components/Author\" },","-                \"audienceSummary\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"audienceLabels(rows)\" },","-                \"pinned\": { \"type\": \"boolean\" },","-                \"requiresAck\": { \"type\": \"boolean\" },","-                \"isPublic\": { \"type\": \"boolean\" },","-                \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-                \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-                \"reach\": { \"type\": \"integer\" },","-                \"readPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },","-                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },","-                \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }","-              },","-              \"required\": [\"id\", \"title\", \"status\", \"displayStatus\", \"author\", \"audienceSummary\", \"reach\", \"readPct\", \"ackPct\"]","-            }","-          },","-          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }","+            \"messages\": \"MessageDTO[] in ascending createdAt order\",","+            \"changed\": \"MessageDTO[] (only when after+since is sent; messages with createdAt ≤ cursor and updatedAt > since)\",","+            \"hasMore\": \"boolean (older messages exist; only in initial and 'before' mode)\"","+          }","         }","       },","-      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\"],","-      \"requirementIds\": [\"FR-23\", \"FR-34\", \"NFR-3\"]","+      \"errors\": [\"400 VALIDATION_ERROR (before and after both sent, or since without after)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not a participant, or the cursor id is not in this conversation)\"],","+      \"requirementIds\": [\"FR-10\", \"FR-13\", \"FR-28\", \"NFR-1\", \"NFR-2\", \"NFR-3\", \"NFR-8\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/announcements/:id\",","-      \"description\": \"Detail. Allowed for ADMIN, the author (any status), or an audience member while the announcement is visible. Everyone else gets 404, including members before publishAt or after expiry. For audience members only, the call upserts AnnouncementRead.readAt and keeps the first readAt. The edit page (/announcements/:id/edit) uses the same endpoint and reads audiences from it when canEdit.\",","-      \"auth\": \"requireUser (service gates)\",","-      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }","-      },","-      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (missing, or not visible to the caller)\"],","-      \"requirementIds\": [\"FR-19\", \"FR-30\", \"FR-34\", \"NFR-4\", \"NFR-6\"]","+      \"method\": \"POST\",","+      \"path\": \"/api/conversations/:id/messages\",","+      \"description\": \"Sends a message. Order: rate limit, participation, canSendIn (staff can always send; a non-staff sender needs a live relationship with at least one staff participant who has not left), attachment ownership, then a transaction that inserts the message, links the files, bumps lastMessageAt, sets the sender's lastReadAt and clears archivedAt for the other participants. After commit, onMessageSent runs for each other participant who has not muted or left: it deletes their older unread message.received row, notifies in-app and upserts PendingMessageEmail (dueAt = now + 10 min, create-only).\",","+      \"auth\": \"participant who has not left; rateLimit('msg:'+uid, 30, 60_000)\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"body\": \"string, trimmed, 1..5000\", \"fileIds\": \"cuid[]? ≤5\" } },","+      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"message\": \"MessageDTO\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR (including invalid or foreign fileIds)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='RELATIONSHIP_ENDED'\", \"404 NOT_FOUND\", \"429 RATE_LIMITED details.retryAfterMs\"],","+      \"requirementIds\": [\"FR-7\", \"FR-11\", \"FR-19\", \"FR-20\", \"FR-27\", \"FR-28\", \"FR-31\", \"NFR-1\", \"NFR-4\"]","     },","     {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/announcements/:id\",","-      \"description\": \"Update. Allowed for the author or ADMIN; others get 404. A non-admin editing an ARCHIVED row gets 409 CONFLICT (archive is terminal for authors). If audiences or isPublic is in the patch, assertCanTarget re-runs on the resulting values. audiences, when sent, replaces all rows. attachmentFileIds, when sent, re-syncs attachments (attaches new ones, detaches removed ones). A transition from DRAFT to publish or schedule re-checks for zero recipients and, for publish, calls claimAndNotify. Edits to an already-notified announcement, including audience changes, never re-notify, because notifiedAt is never cleared. An ADMIN editing someone else's announcement writes audit('announcement.update'). mode=draft on a PUBLISHED row returns 409 (unpublishing is done by archiving).\",","-      \"auth\": \"requireRole(ADMIN, TEACHER)\",","-      \"requestSchema\": {","-        \"params\": { \"id\": { \"type\": \"string\" } },","-        \"body\": { \"$ref\": \"#/components/AnnouncementPatch\" }","-      },","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }","-      },","-      \"errors\": [\"400 VALIDATION_ERROR (Zod or NO_RECIPIENTS)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role or targeting violation)\", \"404 NOT_FOUND (not author/admin)\", \"409 CONFLICT (author editing ARCHIVED; PUBLISHED → draft)\"],","-      \"requirementIds\": [\"FR-2\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-15\", \"FR-27\", \"FR-29\", \"FR-34\", \"NFR-3\"]","+      \"method\": \"POST\",","+      \"path\": \"/api/conversations/:id/read\",","+      \"description\": \"Sets the caller's lastReadAt to now, marks the caller's unread message.received notification for this conversation as read, and deletes the caller's PendingMessageEmail row for it.\",","+      \"auth\": \"participant who has not left\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": {} },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"lastReadAt\": \"string\" } } },","+      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],","+      \"requirementIds\": [\"FR-14\", \"FR-20\", \"FR-28\", \"NFR-1\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/announcements/:id/archive\",","-      \"description\": \"Archive: sets status ARCHIVED. Allowed for the author or ADMIN; others get 404. Idempotent: archiving an already-archived row returns 200 with the current record. An ADMIN archiving someone else's announcement writes audit('announcement.archive').\",","-      \"auth\": \"requireRole(ADMIN, TEACHER)\",","-      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": { \"data\": { \"id\": \"string\", \"status\": \"ARCHIVED\" } }","-      },","-      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\"],","-      \"requirementIds\": [\"FR-12\", \"FR-34\", \"NFR-3\"]","+      \"path\": \"/api/conversations/:id/mute\",","+      \"description\": \"Mutes or unmutes the conversation for the caller only. Muted participants get no message.received notification and no email.\",","+      \"auth\": \"participant who has not left\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"muted\": \"boolean\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"muted\": \"boolean\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],","+      \"requirementIds\": [\"FR-14\", \"FR-19\", \"FR-28\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/announcements/:id/ack\",","-      \"description\": \"Acknowledge. Requires a visible announcement and audience membership; otherwise 404. A row with requiresAck=false returns 409. Upserts AnnouncementRead, sets acknowledgedAt once and also sets readAt if it was empty. Repeat calls are idempotent and return the original acknowledgedAt. The UI shows 'Acknowledged on 14 Sep' in the school timezone.\",","-      \"auth\": \"requireUser (service gates)\",","-      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": { \"data\": { \"readAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }","-      },","-      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not visible or not a member)\", \"409 CONFLICT (requiresAck=false)\"],","-      \"requirementIds\": [\"FR-20\", \"FR-34\", \"NFR-6\", \"NFR-7\"]","+      \"path\": \"/api/conversations/:id/archive\",","+      \"description\": \"Archives or unarchives the conversation for the caller only. A new message from someone else unarchives it.\",","+      \"auth\": \"participant who has not left\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"archived\": \"boolean\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"archived\": \"boolean\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"],","+      \"requirementIds\": [\"FR-9\", \"FR-14\", \"FR-28\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/announcements/:id/stats\",","-      \"description\": \"Per-announcement stats. Allowed for the author or ADMIN; others get 404. Recipients come from the live resolveAudienceUserIds, left-joined to AnnouncementRead. The counts always describe the full audience, while the filter applies only to the rows. With format=csv, the response is text/csv with Content-Disposition: attachment; filename=\\\"announcement-<id>-recipients.csv\\\", built by toCsv from src/server/csv.ts with the columns Name, Role, Read at and Acknowledged at, dates in the school timezone, and the filter applied. Rows are sorted by name.\",","-      \"auth\": \"requireRole(ADMIN, TEACHER)\",","-      \"requestSchema\": {","-        \"params\": { \"id\": { \"type\": \"string\" } },","-        \"query\": {","-          \"filter\": { \"enum\": [\"unread\", \"unacked\"], \"description\": \"Optional. unacked is only meaningful when requiresAck\" },","-          \"format\": { \"enum\": [\"csv\"], \"description\": \"Optional\" }","-        }","-      },","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": {","-          \"data\": {","-            \"counts\": {","-              \"type\": \"object\",","-              \"properties\": {","-                \"recipients\": { \"type\": \"integer\" },","-                \"read\": { \"type\": \"integer\" },","-                \"acknowledged\": { \"type\": \"integer\" },","-                \"readPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"Rounded half-up; null when recipients is 0\" },","-                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"null when !requiresAck or recipients is 0. AC-5: 30/50 → 60\" }","-              }","-            },","-            \"requiresAck\": { \"type\": \"boolean\" },","-            \"lastRemindedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-            \"rows\": {","-              \"type\": \"array\",","-              \"items\": {","-                \"type\": \"object\",","-                \"properties\": {","-                  \"userId\": { \"type\": \"string\" },","-                  \"name\": { \"type\": \"string\" },","-                  \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"] },","-                  \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-                  \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }","-                }","-              }","-            }","-          }","-        },","-        \"csvVariant\": \"200 text/csv; charset=utf-8 (no JSON envelope)\"","-      },","-      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND (not author/admin)\"],","-      \"requirementIds\": [\"FR-24\", \"FR-34\", \"NFR-6\", \"NFR-7\"]","+      \"method\": \"POST\",","+      \"path\": \"/api/conversations/:id/leave\",","+      \"description\": \"Sets leftAt for the caller. After that the caller is treated as a non-participant (404, and no attachment access). Leaving is refused for conversations with 2 or fewer participants, and for the creator of a conversation where involvesStudent is true.\",","+      \"auth\": \"participant who has not left\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": {} },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"left\": true } } },","+      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='ONE_TO_ONE'|'CREATOR_OF_STUDENT_GROUP'\", \"404 NOT_FOUND\"],","+      \"requirementIds\": [\"FR-14\", \"FR-28\", \"NFR-1\"]","     },","     {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/messages/:id\",","+      \"description\": \"Edits the caller's own message within 15 minutes of sending. In one transaction it inserts a MessageRevision holding the old body, then updates body and editedAt.\",","+      \"auth\": \"sender, a participant who has not left, within 15 minutes\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"body\": \"string, trimmed, 1..5000\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"message\": \"MessageDTO\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='NOT_SENDER'|'EDIT_WINDOW_EXPIRED'|'ALREADY_DELETED'\", \"404 NOT_FOUND\"],","+      \"requirementIds\": [\"FR-3\", \"FR-15\", \"FR-28\", \"NFR-3\"]","+    },","+    {","+      \"method\": \"DELETE\",","+      \"path\": \"/api/messages/:id\",","+      \"description\": \"Soft-deletes the caller's own message within 15 minutes by setting deletedAt. No hard delete is possible. The content stays visible to safeguarding leads.\",","+      \"auth\": \"sender, a participant who has not left, within 15 minutes\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"message\": \"MessageDTO (deleted:true, body:null)\" } } },","+      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN details.reason='NOT_SENDER'|'EDIT_WINDOW_EXPIRED'|'ALREADY_DELETED'\", \"404 NOT_FOUND\"],","+      \"requirementIds\": [\"FR-15\", \"FR-28\", \"NFR-3\"]","+    },","+    {","       \"method\": \"POST\",","-      \"path\": \"/api/announcements/:id/remind\",","-      \"description\": \"Send a reminder to recipients who have not acknowledged. Allowed for the author or ADMIN; others get 404. The announcement must have requiresAck and be visible; otherwise 409. The throttle is claimed atomically: updateMany where lastRemindedAt is null or ≤ now − 24h sets lastRemindedAt = now. If no row is claimed, the response is 429 RATE_LIMITED with details.retryAfter (ISO, lastRemindedAt + 24h). Otherwise it calls notify('announcement.reminder', mandatoryInApp) for recipients minus acknowledged users. If nobody is left to remind, it still claims the throttle and returns notified: 0. AC-5: 50 recipients with 30 acknowledged → notified 20.\",","-      \"auth\": \"requireRole(ADMIN, TEACHER)\",","-      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": { \"data\": { \"notified\": { \"type\": \"integer\" }, \"remindedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }","-      },","-      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\", \"409 CONFLICT (!requiresAck or not visible)\", \"429 RATE_LIMITED { details: { retryAfter } }\"],","-      \"requirementIds\": [\"FR-25\", \"FR-26\", \"FR-34\"]","+      \"path\": \"/api/messages/:id/report\",","+      \"description\": \"Reports another participant's message. After commit, every ACTIVE safeguarding lead gets a message.reported notification (mandatory in-app plus email, without the message text) linking to /admin/safeguarding?report=<id>. The client shows the toast 'Reported — the school will review this.'\",","+      \"auth\": \"participant who has not left, not the sender\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"reason\": \"string, trimmed, 1..1000\" } },","+      \"responseSchema\": { \"status\": 201, \"body\": { \"data\": { \"reportId\": \"string\", \"status\": \"OPEN\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (reporting your own message)\", \"404 NOT_FOUND\", \"409 CONFLICT (an OPEN report from this user on this message already exists)\"],","+      \"requirementIds\": [\"FR-22\", \"FR-26\", \"FR-28\", \"NFR-1\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/public/news\",","-      \"description\": \"Public news for the future PRD-18 website. No authentication. The path is added to PUBLIC_API_PATHS in src/config/public-routes.ts. Rate-limited by client IP with the existing src/server/rate-limit.ts, which returns 429 RATE_LIMITED. Returns isPublic ∧ visible announcements, newest first. The DTO deliberately omits author identity, audience and read data. Cover images and attachments are served through GET /api/files/:id, which the 'announcement' file resolver allows anonymously only for public, visible announcements.\",","-      \"auth\": \"none (public)\",","-      \"requestSchema\": {","-        \"query\": {","-          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },","-          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }","-        }","-      },","-      \"responseSchema\": {","-        \"status\": 200,","-        \"body\": {","-          \"data\": {","-            \"type\": \"array\",","-            \"items\": {","-              \"type\": \"object\",","-              \"properties\": {","-                \"id\": { \"type\": \"string\" },","-                \"title\": { \"type\": \"string\" },","-                \"excerpt\": { \"type\": \"string\", \"maxLength\": 200 },","-                \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown; consumers must sanitise (MarkdownView)\" },","-                \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-                \"coverFileId\": { \"type\": [\"string\", \"null\"] },","-                \"attachments\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } }","-              },","-              \"required\": [\"id\", \"title\", \"excerpt\", \"body\", \"publishAt\", \"attachments\"]","-            }","-          },","-          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }","-        }","-      },","-      \"errors\": [\"400 VALIDATION_ERROR\", \"429 RATE_LIMITED\"],","-      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-34\", \"NFR-4\", \"NFR-9\"]","-    }","-  ],","-","-  \"internalHooks\": [","+      \"path\": \"/api/messaging/unread-count\",","+      \"description\": \"Returns the number of conversations the caller has not left where lastMessageAt > coalesce(lastReadAt, epoch). It runs as a single $queryRaw COUNT and backs the sidebar badge, which polls every 30 s.\",","+      \"auth\": \"any authenticated user\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"count\": \"number\" } } },","+      \"errors\": [\"401 UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-13\", \"FR-18\", \"FR-28\", \"NFR-2\"]","+    },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/internal/email/dispatch\",","-      \"description\": \"Existing endpoint, gated by CRON_SECRET; its contract is unchanged. It gains an isolated publishDueAnnouncements(now) pass (findMany SCHEDULED ∧ notifiedAt null ∧ publishAt ≤ now, take 50 → claimAndNotify each). The pass is idempotent under concurrent runs. The response may add an 'announcementsPublished' integer next to the existing counters.\",","-      \"requirementIds\": [\"FR-27\", \"NFR-11\"]","+      \"method\": \"GET\",","+      \"path\": \"/api/messaging/contacts\",","+      \"description\": \"Returns only the users the caller can message (canMessage), in labelled groups. Users the caller cannot message are never returned.\",","+      \"auth\": \"any authenticated user\",","+      \"requestSchema\": { \"query\": { \"q\": \"string? ≤100 (case-insensitive name match)\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"groups\": \"ContactGroup[]\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-5\", \"FR-8\", \"FR-12\", \"FR-16\", \"FR-28\", \"FR-32\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/files/:id\",","-      \"description\": \"Existing endpoint; its contract is unchanged. It gains the new 'announcement' access context: allowed for anyone (including anonymous callers) if isPublic ∧ visible; otherwise for ADMIN, the author, or a member while visible; otherwise denied.\",","-      \"requirementIds\": [\"FR-30\", \"NFR-6\"]","+      \"path\": \"/api/me/messaging-settings\",","+      \"description\": \"Returns the caller's quiet hours. Both values are null when none are set.\",","+      \"auth\": \"any authenticated user\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"MessagingSettings\" } },","+      \"errors\": [\"401 UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-21\", \"FR-28\"]","+    },","+    {","+      \"method\": \"PUT\",","+      \"path\": \"/api/me/messaging-settings\",","+      \"description\": \"Upserts the caller's quiet hours as HH:mm in the school timezone. The range may wrap midnight. quietStart and quietEnd must be both set or both null (null clears them), and start must not equal end.\",","+      \"auth\": \"any authenticated user\",","+      \"requestSchema\": { \"body\": { \"quietStart\": \"string /^([01]\\\\d|2[0-3]):[0-5]\\\\d$/ | null\", \"quietEnd\": \"string /^([01]\\\\d|2[0-3]):[0-5]\\\\d$/ | null\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"MessagingSettings\" } },","+      \"errors\": [\"400 VALIDATION_ERROR (only one value set, bad format, or start == end)\", \"401 UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-20\", \"FR-21\", \"FR-28\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/safeguarding/reports\",","+      \"description\": \"The reports queue, with OPEN reports first and then by createdAt desc. The optional status filter narrows the list.\",","+      \"auth\": \"ADMIN with isSafeguardingLead (read from the database)\",","+      \"requestSchema\": { \"query\": { \"status\": \"OPEN|REVIEWED|DISMISSED?\", \"page\": \"int?\", \"pageSize\": \"int? ≤100\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"(ReportDTO without the context fields)[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\"],","+      \"requirementIds\": [\"FR-23\", \"FR-28\", \"NFR-1\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/safeguarding/reports/:id\",","+      \"description\": \"Report detail: the reported message, the 5 messages before and the 5 after it (including deleted content and revisions), and the participants. Each call writes audit('safeguarding.conversation.view', entityType 'Conversation').\",","+      \"auth\": \"ADMIN with isSafeguardingLead\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"report\": \"ReportDTO\", \"before\": \"SafeguardingMessageDTO[] (≤5)\", \"after\": \"SafeguardingMessageDTO[] (≤5)\", \"participants\": \"(UserSummary & { leftAt: string|null })[]\" } } },","+      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\"],","+      \"requirementIds\": [\"FR-23\", \"FR-25\", \"FR-28\", \"NFR-1\", \"NFR-3\"]","+    },","+    {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/safeguarding/reports/:id\",","+      \"description\": \"Marks a report reviewed or dismissed. A review requires a note; for a dismissal the note is optional. Sets status, reviewedById, reviewedAt and reviewNote, and writes audit('safeguarding.report.review' or 'safeguarding.report.dismiss').\",","+      \"auth\": \"ADMIN with isSafeguardingLead\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"action\": \"'review'|'dismiss'\", \"note\": \"string? ≤1000 (required when action is 'review')\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"report\": \"ReportDTO\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\", \"409 CONFLICT (report is no longer OPEN)\"],","+      \"requirementIds\": [\"FR-23\", \"FR-28\", \"NFR-11\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/safeguarding/conversations\",","+      \"description\": \"Searches conversations where involvesStudent is true. Filters: a participant, and a createdAt or lastMessageAt range. Ordered by lastMessageAt desc.\",","+      \"auth\": \"ADMIN with isSafeguardingLead\",","+      \"requestSchema\": { \"query\": { \"participantId\": \"cuid?\", \"from\": \"ISO date?\", \"to\": \"ISO date?\", \"page\": \"int?\", \"pageSize\": \"int? ≤100\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"{ id, subject, participants: UserSummary[], createdAt, lastMessageAt, messageCount, openReportCount }[]\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },","+      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\"],","+      \"requirementIds\": [\"FR-24\", \"FR-28\", \"FR-30\", \"NFR-1\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/safeguarding/conversations/:id\",","+      \"description\": \"Read-only view of the full thread, including deleted content (marked as deleted) and the original text of edited messages. Every call writes audit('safeguarding.conversation.view').\",","+      \"auth\": \"ADMIN with isSafeguardingLead\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": { \"conversation\": \"ConversationDetail without me/canSend/canLeave\", \"messages\": \"SafeguardingMessageDTO[] in ascending order\" } } },","+      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND (also returned when involvesStudent is false)\"],","+      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-28\", \"NFR-1\", \"NFR-3\"]","+    },","+    {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/users/:id\",","+      \"description\": \"EXISTING endpoint, extended with an optional isSafeguardingLead flag. Setting it to true on a non-ADMIN user is rejected. The change is audited in the existing user.update metadata. There is no admin form, so the API and the seed are the only way to set it (ADR-11).\",","+      \"auth\": \"ADMIN (unchanged)\",","+      \"requestSchema\": { \"params\": { \"id\": \"cuid\" }, \"body\": { \"...existing fields\": \"unchanged\", \"isSafeguardingLead\": \"boolean?\" } },","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"existing user DTO + isSafeguardingLead: boolean\" } },","+      \"errors\": [\"400 VALIDATION_ERROR details.reason='SAFEGUARDING_LEAD_REQUIRES_ADMIN'\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND\"],","+      \"requirementIds\": [\"FR-2\", \"NFR-11\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/internal/email/dispatch\",","+      \"description\": \"EXISTING maintenance endpoint. Its request and response contract does not change. It also runs processPendingMessageEmails(now) in its own try/catch, processing at most 200 due rows per run. A user who has read, muted or left the conversation is dropped, a user in quiet hours is deferred to the end of quiet hours, and everyone else is sent the email with notify({inApp:false}).\",","+      \"auth\": \"CRON_SECRET (unchanged)\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"status\": 200, \"body\": { \"data\": \"existing summary + messageEmails: { sent: number, deferred: number, dropped: number }\" } },","+      \"errors\": [\"401 UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-4\", \"FR-20\"]","     }","   ],"," ","+  \"unchangedButAffected\": [","+    { \"path\": \"GET /api/files/:id\", \"note\": \"Adds registerFileAccess('message'). Participants who have not left and safeguarding leads are allowed; everyone else is denied. No contract change.\", \"requirementIds\": [\"FR-27\"] },","+    { \"path\": \"POST /api/files (upload)\", \"note\": \"Accepts context 'message' (unattached until sent). No other contract change.\", \"requirementIds\": [\"FR-11\", \"FR-27\"] }","+  ],","+","   \"status\": \"complete\""," }"]}],"originalFile":"{\n  \"ticketId\": \"SH-12\",\n  \"timestamp\": \"2026-11-09T19:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the SH-11 contracts that were here before.\",\n    \"basePath\": \"/api (the existing SchoolHub convention, not /api/v1). Route files are src/app/api/**/route.ts. Requirement: FR-34.\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with a Zod schema from src/lib/validators/announcements.ts → one call into src/server/announcements/announcements-service.ts → ok(data) / ok(data, {status: 201}) / paginated(data, meta). No business logic in routes. Requirements: FR-34, FR-36, NFR-8.\",\n    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. Paginated endpoints return { \\\"data\\\": [...], \\\"meta\\\": { page, pageSize, total } } via paginated() in src/server/http.ts. Requirement: FR-34.\",\n    \"pagination\": \"?page (≥1, default 1) & ?pageSize (default 20, max 100 via parsePagination; GET /api/announcements/manage clamps to 50 because it computes live reach per row). Requirements: FR-17, FR-23, FR-31.\",\n    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } }. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, RATE_LIMITED 429, INTERNAL 500. Requirement: FR-34.\",\n    \"accessErrors\": \"Targeting violations on create, update and preview return 403 FORBIDDEN (AC-3). STUDENT/PARENT on ADMIN/TEACHER routes get 403 from requireRole (FR-11). Callers who may not see a specific announcement (non-member, non-author, or not yet visible) get 404 NOT_FOUND on detail, ack, stats, remind, PATCH and archive, so its existence is not leaked (system-design A10). Requirements: NFR-3, NFR-6.\",\n    \"dates\": \"All timestamps are ISO 8601 UTC strings. The composer converts SchoolSettings.timezone input to UTC before sending. Clients display with formatInSchoolTz. Requirement: NFR-7.\",\n    \"visibility\": \"visible = status ∈ {SCHEDULED, PUBLISHED} ∧ publishAt ≤ now ∧ (expiresAt null ∨ expiresAt > now), evaluated at read time. Requirements: FR-16, NFR-6.\",\n    \"sanitisation\": \"`body` is raw Markdown, rendered client-side only through MarkdownView (rehype-sanitize). `excerpt` is plain text from toPlainText and must be rendered as escaped text. Requirement: NFR-4.\"\n  },\n\n  \"components\": {\n    \"AudienceRow\": {\n      \"description\": \"Generic audience row (FR-8). refId is required unless the type is SCHOOL or STAFF. For ROLE it must be a Role value. For GRADE_LEVEL, SECTION and COURSE, at least one include flag must be true. Requirements: FR-1, FR-3..FR-6.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"type\": { \"enum\": [\"SCHOOL\", \"STAFF\", \"ROLE\", \"GRADE_LEVEL\", \"SECTION\", \"COURSE\"] },\n        \"refId\": { \"type\": [\"string\", \"null\"], \"description\": \"GradeLevel.id | Section.id | Course.id | Role value\" },\n        \"includeStudents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeParents\": { \"type\": \"boolean\", \"default\": true },\n        \"includeTeachers\": { \"type\": \"boolean\", \"default\": true }\n      },\n      \"required\": [\"type\"]\n    },\n    \"AnnouncementInput\": {\n      \"description\": \"Body of POST /api/announcements. Mirrors announcementInputSchema. Requirements: FR-2, FR-13, FR-15, FR-16.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150, \"description\": \"Trimmed\" },\n        \"body\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 20000, \"description\": \"Markdown\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"minItems\": 0, \"maxItems\": 20 },\n        \"pinned\": { \"type\": \"boolean\", \"default\": false },\n        \"requiresAck\": { \"type\": \"boolean\", \"default\": false },\n        \"isPublic\": { \"type\": \"boolean\", \"default\": false, \"description\": \"ADMIN only. true from a TEACHER → 403 (FR-10)\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"], \"description\": \"FileObject id uploaded with context 'announcement'\" },\n        \"attachmentFileIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"maxItems\": 10, \"default\": [] },\n        \"mode\": { \"enum\": [\"draft\", \"publish\", \"schedule\"] },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Required and > now when mode = schedule. Ignored for publish (set to now)\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\", \"description\": \"Must be > (publishAt ?? now)\" }\n      },\n      \"required\": [\"title\", \"body\", \"audiences\", \"mode\"]\n    },\n    \"AnnouncementPatch\": {\n      \"description\": \"AnnouncementInput with every field optional (announcementPatchSchema). audiences, when present, replaces all rows. Requirements: FR-12, FR-29.\",\n      \"type\": \"object\",\n      \"allOf\": [{ \"$ref\": \"#/components/AnnouncementInput\" }],\n      \"required\": []\n    },\n    \"Author\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\"] }\n      },\n      \"required\": [\"id\", \"name\", \"role\"]\n    },\n    \"Attachment\": {\n      \"description\": \"Download via the existing GET /api/files/:id, gated by the 'announcement' file context (FR-30).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"description\": \"FileObject id\" },\n        \"name\": { \"type\": \"string\" },\n        \"mimeType\": { \"type\": \"string\" },\n        \"size\": { \"type\": \"integer\" }\n      },\n      \"required\": [\"id\", \"name\"]\n    },\n    \"FeedItem\": {\n      \"description\": \"Feed card DTO. Requirements: FR-17, FR-18, FR-22, NFR-5.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"excerpt\": { \"type\": \"string\", \"maxLength\": 200, \"description\": \"Plain text (toPlainText(body, 200))\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"pinned\": { \"type\": \"boolean\", \"description\": \"true only for the ≤3 items lifted to the top of page 1\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"Audience chips, e.g. 'Grade 7 · Parents'\" },\n        \"attachmentCount\": { \"type\": \"integer\" },\n        \"unread\": { \"type\": \"boolean\", \"description\": \"No AnnouncementRead.readAt for the caller. UI shows a dot with visually hidden text 'Unread'\" },\n        \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"forChildren\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" } } }, \"description\": \"PARENT callers only; empty otherwise. The linked children that put the parent in a GRADE_LEVEL, SECTION or COURSE audience ('For Sam')\" }\n      },\n      \"required\": [\"id\", \"title\", \"excerpt\", \"author\", \"publishAt\", \"pinned\", \"requiresAck\", \"labels\", \"attachmentCount\", \"unread\", \"forChildren\"]\n    },\n    \"AnnouncementDetail\": {\n      \"description\": \"Full record for detail and edit. Requirements: FR-13, FR-19, FR-20.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown. Render only via MarkdownView\" },\n        \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n        \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n        \"author\": { \"$ref\": \"#/components/Author\" },\n        \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"description\": \"Returned only when canEdit; [] otherwise\" },\n        \"labels\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n        \"pinned\": { \"type\": \"boolean\" },\n        \"requiresAck\": { \"type\": \"boolean\" },\n        \"isPublic\": { \"type\": \"boolean\" },\n        \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n        \"attachments\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/Attachment\" } },\n        \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"myRead\": { \"type\": [\"object\", \"null\"], \"properties\": { \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" } }, \"description\": \"null when the caller is not an audience member (for example an admin outside the audience)\" },\n        \"canEdit\": { \"type\": \"boolean\", \"description\": \"ADMIN, or the author while not ARCHIVED\" },\n        \"canViewStats\": { \"type\": \"boolean\", \"description\": \"ADMIN or the author\" }\n      },\n      \"required\": [\"id\", \"title\", \"body\", \"status\", \"displayStatus\", \"author\", \"labels\", \"pinned\", \"requiresAck\", \"isPublic\", \"attachments\", \"canEdit\", \"canViewStats\"]\n    },\n    \"AudienceCounts\": {\n      \"description\": \"Requirements: FR-14, FR-15.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"total\": { \"type\": \"integer\" },\n        \"byRole\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"STUDENT\": { \"type\": \"integer\" },\n            \"PARENT\": { \"type\": \"integer\" },\n            \"TEACHER\": { \"type\": \"integer\" },\n            \"ADMIN\": { \"type\": \"integer\" }\n          },\n          \"required\": [\"STUDENT\", \"PARENT\", \"TEACHER\", \"ADMIN\"]\n        }\n      },\n      \"required\": [\"total\", \"byRole\"]\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Feed for the caller (any authenticated role). Only visible announcements whose audience includes the caller, resolved with audiences.some(audienceWhere(keys)) and never by expanding recipients (NFR-2). Page 1 starts with up to 3 pinned items (newest first, pinned=true), followed by the page of remaining items in publishAt desc, id desc order. meta.total excludes those lifted pins. Extra pinned items appear in date order with pinned=false (A4). With courseId, the caller must pass assertCanViewCourse (else 404) and results are limited to rows with a COURSE audience for that course. Expired, scheduled-future, draft and archived items are never returned.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {\n        \"query\": {\n          \"tab\": { \"enum\": [\"all\", \"unread\", \"ack\"], \"default\": \"all\", \"description\": \"unread = no readAt; ack = requiresAck and not acknowledged by the caller\" },\n          \"courseId\": { \"type\": \"string\", \"description\": \"Optional. Course 'Announcements' tab\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/FeedItem\" } },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (bad query)\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (courseId the caller cannot view)\"],\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-21\", \"FR-22\", \"FR-34\", \"NFR-2\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements\",\n      \"description\": \"Create an announcement. assertCanTarget(user, audiences, isPublic) runs first. A TEACHER may target only COURSE rows for courses where they are teacherId or in coTeacherIds, and SECTION rows for the section they homeroom. Anything else, or isPublic=true, returns 403. For mode publish or schedule, zero resolved recipients returns 400 VALIDATION_ERROR (details.reason='NO_RECIPIENTS'). Drafts may have zero recipients. A single transaction writes the announcement, audience rows and attachment rows and calls attachFiles. mode=publish sets status PUBLISHED and publishAt=now, then claimAndNotify sends announcement.published exactly once (generic-notification email, 300-character plain-text body, 'Read announcement' link to /announcements/:id, mandatoryInApp = requiresAck). mode=schedule sets status SCHEDULED and does not notify. mode=draft sets status DRAFT.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/components/AnnouncementInput\" } },\n      \"responseSchema\": {\n        \"status\": 201,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod: title > 150, body > 20,000, schedule without a future publishAt, expiresAt ≤ publishAt; or NO_RECIPIENTS on publish/schedule)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT; teacher targeting SCHOOL/STAFF/ROLE/GRADE_LEVEL, a foreign course or section, or isPublic)\", \"404 NOT_FOUND (coverFileId or attachment not owned by the caller or not uploaded)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-13\", \"FR-15\", \"FR-16\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/unread-count\",\n      \"description\": \"Sidebar badge count. Uses the same where clause as the feed's 'all' tab plus reads.none{userId, readAt not null}. Polled every 30 seconds, only while the page is visible.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-32\", \"FR-34\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/preview-audience\",\n      \"description\": \"Live recipient count for the composer ('Will reach 412 people: 180 students, 214 parents, 18 teachers'). assertCanTarget(user, audiences, false) runs first, so teachers cannot probe the size of audiences they cannot target. Then countAudienceByRole. ACTIVE, non-archived users only, deduplicated. The client debounces calls by 400 ms.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"body\": {\n          \"audiences\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/AudienceRow\" }, \"maxItems\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AudienceCounts\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role, or teacher targeting violation)\"],\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-10\", \"FR-14\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/manage\",\n      \"description\": \"Manage list with no visibility filter, so it includes drafts, scheduled, expired and archived items. TEACHER sees authorId = me; ADMIN sees all. Ordered by updatedAt desc. reach, readPct and ackPct are computed live against the current resolveAudienceUserIds, and reads from users who have left the audience are excluded. Percentages are integers rounded half-up; they are null when reach is 0, and ackPct is null when requiresAck is false.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"], \"description\": \"Optional filter on displayStatus\" },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 50, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"status\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"ARCHIVED\"] },\n                \"displayStatus\": { \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\", \"EXPIRED\", \"ARCHIVED\"] },\n                \"author\": { \"$ref\": \"#/components/Author\" },\n                \"audienceSummary\": { \"type\": \"array\", \"items\": { \"type\": \"string\" }, \"description\": \"audienceLabels(rows)\" },\n                \"pinned\": { \"type\": \"boolean\" },\n                \"requiresAck\": { \"type\": \"boolean\" },\n                \"isPublic\": { \"type\": \"boolean\" },\n                \"publishAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"expiresAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                \"reach\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"minimum\": 0, \"maximum\": 100 },\n                \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n              },\n              \"required\": [\"id\", \"title\", \"status\", \"displayStatus\", \"author\", \"audienceSummary\", \"reach\", \"readPct\", \"ackPct\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Detail. Allowed for ADMIN, the author (any status), or an audience member while the announcement is visible. Everyone else gets 404, including members before publishAt or after expiry. For audience members only, the call upserts AnnouncementRead.readAt and keeps the first readAt. The edit page (/announcements/:id/edit) uses the same endpoint and reads audiences from it when canEdit.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (missing, or not visible to the caller)\"],\n      \"requirementIds\": [\"FR-19\", \"FR-30\", \"FR-34\", \"NFR-4\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/announcements/:id\",\n      \"description\": \"Update. Allowed for the author or ADMIN; others get 404. A non-admin editing an ARCHIVED row gets 409 CONFLICT (archive is terminal for authors). If audiences or isPublic is in the patch, assertCanTarget re-runs on the resulting values. audiences, when sent, replaces all rows. attachmentFileIds, when sent, re-syncs attachments (attaches new ones, detaches removed ones). A transition from DRAFT to publish or schedule re-checks for zero recipients and, for publish, calls claimAndNotify. Edits to an already-notified announcement, including audience changes, never re-notify, because notifiedAt is never cleared. An ADMIN editing someone else's announcement writes audit('announcement.update'). mode=draft on a PUBLISHED row returns 409 (unpublishing is done by archiving).\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"body\": { \"$ref\": \"#/components/AnnouncementPatch\" }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"$ref\": \"#/components/AnnouncementDetail\" } }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR (Zod or NO_RECIPIENTS)\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role or targeting violation)\", \"404 NOT_FOUND (not author/admin)\", \"409 CONFLICT (author editing ARCHIVED; PUBLISHED → draft)\"],\n      \"requirementIds\": [\"FR-2\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-15\", \"FR-27\", \"FR-29\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/archive\",\n      \"description\": \"Archive: sets status ARCHIVED. Allowed for the author or ADMIN; others get 404. Idempotent: archiving an already-archived row returns 200 with the current record. An ADMIN archiving someone else's announcement writes audit('announcement.archive').\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"id\": \"string\", \"status\": \"ARCHIVED\" } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-34\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/ack\",\n      \"description\": \"Acknowledge. Requires a visible announcement and audience membership; otherwise 404. A row with requiresAck=false returns 409. Upserts AnnouncementRead, sets acknowledgedAt once and also sets readAt if it was empty. Repeat calls are idempotent and return the original acknowledgedAt. The UI shows 'Acknowledged on 14 Sep' in the school timezone.\",\n      \"auth\": \"requireUser (service gates)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"readAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"acknowledgedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND (not visible or not a member)\", \"409 CONFLICT (requiresAck=false)\"],\n      \"requirementIds\": [\"FR-20\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/announcements/:id/stats\",\n      \"description\": \"Per-announcement stats. Allowed for the author or ADMIN; others get 404. Recipients come from the live resolveAudienceUserIds, left-joined to AnnouncementRead. The counts always describe the full audience, while the filter applies only to the rows. With format=csv, the response is text/csv with Content-Disposition: attachment; filename=\\\"announcement-<id>-recipients.csv\\\", built by toCsv from src/server/csv.ts with the columns Name, Role, Read at and Acknowledged at, dates in the school timezone, and the filter applied. Rows are sorted by name.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": { \"type\": \"string\" } },\n        \"query\": {\n          \"filter\": { \"enum\": [\"unread\", \"unacked\"], \"description\": \"Optional. unacked is only meaningful when requiresAck\" },\n          \"format\": { \"enum\": [\"csv\"], \"description\": \"Optional\" }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"counts\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"recipients\": { \"type\": \"integer\" },\n                \"read\": { \"type\": \"integer\" },\n                \"acknowledged\": { \"type\": \"integer\" },\n                \"readPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"Rounded half-up; null when recipients is 0\" },\n                \"ackPct\": { \"type\": [\"integer\", \"null\"], \"description\": \"null when !requiresAck or recipients is 0. AC-5: 30/50 → 60\" }\n              }\n            },\n            \"requiresAck\": { \"type\": \"boolean\" },\n            \"lastRemindedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n            \"rows\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"userId\": { \"type\": \"string\" },\n                  \"name\": { \"type\": \"string\" },\n                  \"role\": { \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"] },\n                  \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                  \"acknowledgedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n                }\n              }\n            }\n          }\n        },\n        \"csvVariant\": \"200 text/csv; charset=utf-8 (no JSON envelope)\"\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND (not author/admin)\"],\n      \"requirementIds\": [\"FR-24\", \"FR-34\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/announcements/:id/remind\",\n      \"description\": \"Send a reminder to recipients who have not acknowledged. Allowed for the author or ADMIN; others get 404. The announcement must have requiresAck and be visible; otherwise 409. The throttle is claimed atomically: updateMany where lastRemindedAt is null or ≤ now − 24h sets lastRemindedAt = now. If no row is claimed, the response is 429 RATE_LIMITED with details.retryAfter (ISO, lastRemindedAt + 24h). Otherwise it calls notify('announcement.reminder', mandatoryInApp) for recipients minus acknowledged users. If nobody is left to remind, it still claims the throttle and returns notified: 0. AC-5: 50 recipients with 30 acknowledged → notified 20.\",\n      \"auth\": \"requireRole(ADMIN, TEACHER)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } }, \"body\": {} },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": { \"data\": { \"notified\": { \"type\": \"integer\" }, \"remindedAt\": { \"type\": \"string\", \"format\": \"date-time\" } } }\n      },\n      \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (STUDENT/PARENT)\", \"404 NOT_FOUND\", \"409 CONFLICT (!requiresAck or not visible)\", \"429 RATE_LIMITED { details: { retryAfter } }\"],\n      \"requirementIds\": [\"FR-25\", \"FR-26\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/public/news\",\n      \"description\": \"Public news for the future PRD-18 website. No authentication. The path is added to PUBLIC_API_PATHS in src/config/public-routes.ts. Rate-limited by client IP with the existing src/server/rate-limit.ts, which returns 429 RATE_LIMITED. Returns isPublic ∧ visible announcements, newest first. The DTO deliberately omits author identity, audience and read data. Cover images and attachments are served through GET /api/files/:id, which the 'announcement' file resolver allows anonymously only for public, visible announcements.\",\n      \"auth\": \"none (public)\",\n      \"requestSchema\": {\n        \"query\": {\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": {\n        \"status\": 200,\n        \"body\": {\n          \"data\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"title\": { \"type\": \"string\" },\n                \"excerpt\": { \"type\": \"string\", \"maxLength\": 200 },\n                \"body\": { \"type\": \"string\", \"description\": \"Raw Markdown; consumers must sanitise (MarkdownView)\" },\n                \"publishAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n                \"coverFileId\": { \"type\": [\"string\", \"null\"] },\n                \"attachments\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } }\n              },\n              \"required\": [\"id\", \"title\", \"excerpt\", \"body\", \"publishAt\", \"attachments\"]\n            }\n          },\n          \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" }\n        }\n      },\n      \"errors\": [\"400 VALIDATION_ERROR\", \"429 RATE_LIMITED\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-34\", \"NFR-4\", \"NFR-9\"]\n    }\n  ],\n\n  \"internalHooks\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"Existing endpoint, gated by CRON_SECRET; its contract is unchanged. It gains an isolated publishDueAnnouncements(now) pass (findMany SCHEDULED ∧ notifiedAt null ∧ publishAt ≤ now, take 50 → claimAndNotify each). The pass is idempotent under concurrent runs. The response may add an 'announcementsPublished' integer next to the existing counters.\",\n      \"requirementIds\": [\"FR-27\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/files/:id\",\n      \"description\": \"Existing endpoint; its contract is unchanged. It gains the new 'announcement' access context: allowed for anyone (including anonymous callers) if isPublic ∧ visible; otherwise for ADMIN, the author, or a member while visible; otherwise denied.\",\n      \"requirementIds\": [\"FR-30\", \"NFR-6\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_014UxViYQujj3GCQ9JFM5si3","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
