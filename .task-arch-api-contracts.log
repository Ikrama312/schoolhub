{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgrw2vWWLfsJxNefsMMqw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MXjUrKWjBs5MFXJRW7imKv","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-10\",\n  \"timestamp\": \"2026-11-09T13:00:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api. This is the existing project convention; there is no /api/v1 prefix (system-design §3.3).\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/quiz.ts) → one call into src/server/quiz/*-service.ts → ok()/paginated(). All of these come from src/server/http.ts. Handlers contain no logic (NFR-6, NFR-7).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int ≥ 1, default 1\", \"pageSize\": \"int 1–100, default 20 (parsePagination)\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": \"400. Zod failure (details = zod flatten()) or a service rule failure such as canPublish problems, points > question points, or step ≠ 0.5.\",\n      \"UNAUTHENTICATED\": \"401. No session, or a bad cron secret on the internal route.\",\n      \"NOT_FOUND\": \"404. The resource is missing OR the caller cannot access it. Existence is never revealed, so FORBIDDEN is not used for quiz resources (NFR-5).\",\n      \"CONFLICT\": \"409. Answer write after deadlineAt + 30 s, a closed or not-yet-open quiz, attempt limit reached, edit lock (quiz has attempts), delete with attempts, an invalid status transition, or a write to a non-IN_PROGRESS attempt.\",\n      \"INTERNAL\": \"500. Logged with logger.error and never detailed to the client.\"\n    },\n    \"createdStatus\": \"POST endpoints that create a resource return 201 via ok(x, {status: 201}). Every other success returns 200.\",\n    \"decimals\": \"points, score, maxScore, pointsAwarded, totalPoints and the analytics averages are serialized as strings with 2 decimals by fixed2 from @/server/assignments/grading-math (e.g. \\\"2.00\\\"). Input decimals accept number | string. Percentages are numbers rounded to 1 decimal.\",\n    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client time (ADR-4). The UI displays times in SchoolSettings.timezone (NFR-6).\",\n    \"ids\": \"cuid strings. Option ids inside Question.options are short cuids generated by the builder and stay stable across edits.\",\n    \"studentPrivacy\": \"Every quiz, attempt or result returned to a STUDENT or PARENT is built only by the allow-listing serializers in src/server/quiz/serializers.ts (toStudentQuiz, toStudentAttempt, toStudentResult). `correct` and `explanation` appear only inside StudentResult.questions[] and only when resultsVisible && showCorrectAnswers. Scores appear only when resultsVisible. Student-path Prisma selects never load `correct` or `explanation` (NFR-1, ADR-5).\",\n    \"lazyAutoSubmit\": \"GET /api/attempts/:id, POST /api/quizzes/:id/attempts, the course list and the teacher grade/list loads call ensureNotExpired first. So an IN_PROGRESS attempt past deadlineAt is always returned already submitted (FR-18).\",\n    \"noEndpointBy design\": [\n      \"getStudentQuizScore(quizId, studentId) → {score, maxScore, percent, isPractice, attemptsCounted} | null is a TypeScript export of attempt-service.ts for PRD-11. It has no HTTP route (FR-22, FR-33, system-design §4.7).\",\n      \"The grading workspace, the analytics page and the builder's accommodations table are server pages. They call the services directly, after requirePageRole and assertCanManageCourse. Only their writes go through the routes below (system-design §3.4).\",\n      \"Preview mode (FR-8) calls no attempt endpoint (A10).\"\n    ],\n    \"requirementIds\": [\"FR-31\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\", \"NFR-7\"]\n  },\n\n  \"sharedSchemas\": {\n    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^\\\\d+\\\\.\\\\d{2}$\", \"description\": \"Output form. Input form is number | string.\" },\n    \"QuizStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"PUBLISHED\", \"CLOSED\"] },\n    \"QuestionType\": { \"type\": \"string\", \"enum\": [\"SINGLE_CHOICE\", \"MULTIPLE_CHOICE\", \"TRUE_FALSE\", \"SHORT_ANSWER\", \"ESSAY\"] },\n    \"ResultsVisibility\": { \"type\": \"string\", \"enum\": [\"IMMEDIATELY\", \"AFTER_CLOSE\", \"MANUAL\"] },\n    \"AttemptStatus\": { \"type\": \"string\", \"enum\": [\"IN_PROGRESS\", \"SUBMITTED\", \"NEEDS_GRADING\", \"GRADED\"] },\n    \"ScoringPolicy\": { \"type\": \"string\", \"enum\": [\"HIGHEST\", \"LATEST\", \"AVERAGE\"] },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"name\": \"string\" } },\n    \"Option\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"text\": \"string (non-empty)\" } },\n    \"Correct\": {\n      \"description\": \"Keyed by Question.type (FR-2). Manager-only, except as described in conventions.studentPrivacy.\",\n      \"oneOf\": {\n        \"SINGLE_CHOICE\": { \"optionId\": \"string (must be one of options[].id)\" },\n        \"MULTIPLE_CHOICE\": { \"optionIds\": \"string[] (≥ 1, each in options[].id)\" },\n        \"TRUE_FALSE\": { \"value\": \"boolean\" },\n        \"SHORT_ANSWER\": { \"accepted\": \"string[] (1–10, non-empty)\" },\n        \"ESSAY\": { \"guidance\": \"string?\" }\n      }\n    },\n    \"AnswerResponse\": {\n      \"description\": \"answerResponseSchema. A type-agnostic union, so the autosave path doesn't load the Question (NFR-2). A shape that doesn't match the question's type grades as 0 / incorrect at submit.\",\n      \"oneOf\": [\n        { \"optionId\": \"string\" },\n        { \"optionIds\": \"string[]\" },\n        { \"value\": \"boolean\" },\n        { \"text\": \"string (≤ 10,000 chars)\" }\n      ]\n    },\n    \"QuizSettingsInput\": {\n      \"description\": \"quizSettingsSchema (FR-2, FR-6). Cross-field rules run in superRefine: availableUntil > availableFrom, and timeLimitMinutes ≤ the window length in minutes. On PATCH, both rules are checked against the stored values merged with the patch.\",\n      \"properties\": {\n        \"title\": \"string (trimmed, non-empty)\",\n        \"instructions\": \"string (Markdown, default \\\"\\\")\",\n        \"isPractice\": \"boolean (default false)\",\n        \"availableFrom\": \"ISO datetime\",\n        \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int 1–300 | null (null = untimed)\",\n        \"maxAttempts\": \"int 1–10 (default 1)\",\n        \"scoringPolicy\": \"ScoringPolicy (default HIGHEST)\",\n        \"shuffleQuestions\": \"boolean (default false)\",\n        \"shuffleOptions\": \"boolean (default false)\",\n        \"oneQuestionPerPage\": \"boolean (default false)\",\n        \"resultsVisibility\": \"ResultsVisibility (default AFTER_CLOSE)\",\n        \"showCorrectAnswers\": \"boolean (default true)\"\n      }\n    },\n    \"QuestionInput\": {\n      \"description\": \"questionSchema, a z.discriminatedUnion on type (FR-2, FR-7). points 0.5–100 in steps of 0.5. options has 2–8 entries for SINGLE_CHOICE/MULTIPLE_CHOICE and is absent for the other types. prompt is non-empty Markdown and may embed a file uploaded with context 'quiz' (FR-39).\",\n      \"properties\": {\n        \"type\": \"QuestionType\",\n        \"prompt\": \"string (Markdown)\",\n        \"points\": \"number | string\",\n        \"options\": \"Option[] | undefined\",\n        \"correct\": \"Correct (shape keyed by type)\",\n        \"explanation\": \"string | null\",\n        \"caseSensitive\": \"boolean (SHORT_ANSWER only, default false)\"\n      }\n    },\n    \"ManagerQuestion\": {\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\",\n        \"order\": \"int\", \"options\": \"Option[] | null\", \"correct\": \"Correct\", \"explanation\": \"string | null\", \"caseSensitive\": \"boolean\"\n      }\n    },\n    \"ManagerQuiz\": {\n      \"description\": \"Full quiz, including answers. Returned only to managers (assertCanManageCourse).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\",\n        \"...\": \"every QuizSettingsInput field, resolved\",\n        \"status\": \"QuizStatus\",\n        \"resultsReleasedAt\": \"ISO datetime | null\",\n        \"createdById\": \"string\", \"createdAt\": \"ISO datetime\", \"updatedAt\": \"ISO datetime\",\n        \"questions\": \"ManagerQuestion[] (sorted by order)\",\n        \"totalPoints\": \"Decimal (Σ points, FR-8)\",\n        \"attemptCount\": \"int\",\n        \"locked\": \"boolean (attemptCount > 0, edit lock FR-10)\",\n        \"publishProblems\": \"string[] (canPublish(questions); empty means publishable, FR-9)\"\n      }\n    },\n    \"StudentQuiz\": {\n      \"description\": \"toStudentQuiz. Allow-listed, with no questions and no `correct` (NFR-1). Drives the start screen (FR-12).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\", \"title\": \"string\", \"instructions\": \"string\", \"isPractice\": \"boolean\",\n        \"status\": \"QuizStatus (DRAFT is never returned to a non-manager; that case is NOT_FOUND)\",\n        \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int | null\", \"oneQuestionPerPage\": \"boolean\", \"resultsVisibility\": \"ResultsVisibility\",\n        \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n        \"extraTimeMinutes\": \"int (caller's accommodation, 0 if none; 0 for parents)\",\n        \"attemptLimit\": \"int (attemptLimit(maxAttempts, extraAttempts), FR-23)\",\n        \"attemptsUsed\": \"int (caller's own attempts; 0 for parents)\",\n        \"inProgressAttemptId\": \"string | null (Resume target, FR-19)\",\n        \"isOpen\": \"boolean (PUBLISHED && availableFrom ≤ now < availableUntil)\"\n      }\n    },\n    \"StudentQuestion\": {\n      \"description\": \"A question as shown in the player. It never contains correct, explanation or caseSensitive.\",\n      \"properties\": { \"id\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\", \"options\": \"Option[] | null (in seededShuffle(options, attempt.id) order when shuffleOptions, FR-13)\" }\n    },\n    \"StudentAttempt\": {\n      \"description\": \"toStudentAttempt. Returned while status = IN_PROGRESS (FR-13, FR-14, FR-19).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\", \"status\": \"\\\"IN_PROGRESS\\\"\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime (always set: untimed attempts use availableUntil)\",\n        \"serverNow\": \"ISO datetime (lets the display-only timer correct for client clock skew, ADR-4)\",\n        \"oneQuestionPerPage\": \"boolean\",\n        \"questions\": \"StudentQuestion[] (in the frozen questionOrder)\",\n        \"answers\": \"{ questionId: string, response: AnswerResponse | null, savedAt: ISO datetime }[] (no grading fields)\"\n      }\n    },\n    \"StudentResult\": {\n      \"description\": \"toStudentResult. Returned for a submitted attempt to its owner or a linked parent (FR-20, FR-21). When resultsVisible = false, every score field is null and questions is null; the UI shows 'Submitted — results will be available later.'\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\",\n        \"status\": \"\\\"SUBMITTED\\\" | \\\"NEEDS_GRADING\\\" | \\\"GRADED\\\"\",\n        \"startedAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime\", \"autoSubmitted\": \"boolean\",\n        \"resultsVisible\": \"boolean\",\n        \"awaitingGrading\": \"boolean (status ≠ GRADED)\",\n        \"score\": \"Decimal | null (only when resultsVisible && status = GRADED)\",\n        \"maxScore\": \"Decimal\",\n        \"percent\": \"number | null (same condition as score)\",\n        \"questions\": \"null | { id, type, prompt, points: Decimal, options: Option[] | null, response: AnswerResponse | null, pendingReview: boolean (needsReview, A8), pointsAwarded: Decimal | null (null when pendingReview), isCorrect: boolean | null, feedback: string | null, correct?: Correct (only if showCorrectAnswers), explanation?: string | null (only if showCorrectAnswers) }[] (in questionOrder)\"\n      }\n    },\n    \"ManagerAnswer\": {\n      \"properties\": {\n        \"questionId\": \"string\", \"response\": \"AnswerResponse | null\", \"pointsAwarded\": \"Decimal | null\", \"isCorrect\": \"boolean | null\",\n        \"feedback\": \"string | null\", \"gradedById\": \"string | null\", \"needsReview\": \"boolean (derived, A8)\", \"updatedAt\": \"ISO datetime\"\n      }\n    },\n    \"ManagerAttempt\": {\n      \"description\": \"The full attempt for a course manager (FR-24).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"student\": \"UserRef\", \"attemptNumber\": \"int\", \"status\": \"AttemptStatus\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime | null\", \"autoSubmitted\": \"boolean\",\n        \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\",\n        \"questionOrder\": \"string[]\",\n        \"questions\": \"ManagerQuestion[] (in questionOrder)\",\n        \"answers\": \"ManagerAnswer[]\"\n      }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Role-shaped, paginated course Quizzes tab list (FR-11). Access: assertCanViewCourse. Managers see every status. Students and parents see only PUBLISHED and CLOSED quizzes. Sorted by availableFrom desc. Runs ensureNotExpired on the caller's own IN_PROGRESS attempts before computing groups.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId (cuid)\" },\n        \"query\": { \"page\": \"int?\", \"pageSize\": \"int? ≤ 100\" }\n      },\n      \"responseSchema\": {\n        \"envelope\": \"paginated\",\n        \"item\": {\n          \"oneOf\": {\n            \"manager\": {\n              \"role\": \"\\\"MANAGER\\\"\",\n              \"id\": \"string\", \"title\": \"string\", \"status\": \"QuizStatus\", \"isPractice\": \"boolean\",\n              \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\", \"timeLimitMinutes\": \"int | null\",\n              \"resultsVisibility\": \"ResultsVisibility\", \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n              \"attemptCount\": \"int\", \"averagePercent\": \"number | null (submitted+graded attempts)\", \"needsGradingCount\": \"int (attempts with status NEEDS_GRADING)\"\n            },\n            \"student\": {\n              \"role\": \"\\\"STUDENT\\\"\",\n              \"quiz\": \"StudentQuiz\",\n              \"group\": \"\\\"UPCOMING\\\" | \\\"AVAILABLE\\\" | \\\"COMPLETED\\\" | \\\"MISSED\\\". UPCOMING = now < availableFrom. AVAILABLE = isOpen && (attemptsUsed < attemptLimit || inProgressAttemptId). COMPLETED = ≥ 1 submitted attempt and not AVAILABLE. MISSED = now ≥ availableUntil with 0 attempts (A2).\",\n              \"latestResult\": \"{ attemptId: string, status: AttemptStatus, score: Decimal | null, maxScore: Decimal, percent: number | null } | null (scores null unless resultsVisible)\"\n            },\n            \"parent\": {\n              \"role\": \"\\\"PARENT\\\"\",\n              \"student\": \"UserRef (linked child enrolled in the course; one row per child × quiz)\",\n              \"quiz\": \"StudentQuiz\",\n              \"results\": \"{ attemptId: string, attemptNumber: int, submittedAt: ISO datetime, score: Decimal | null, maxScore: Decimal, percent: number | null }[] (only attempts where resultsVisible, read-only)\"\n            }\n          }\n        }\n      },\n      \"errors\": [\"NOT_FOUND (course not visible)\"],\n      \"requirementIds\": [\"FR-11\", \"FR-31\", \"FR-33\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Creates a DRAFT quiz. The /quizzes/new page sends defaults and then redirects to /edit (FR-6). createdById = caller. Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId\" },\n        \"body\": \"QuizSettingsInput with title, availableFrom and availableUntil required; every other field optional (FR-1 defaults)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (cannot manage course)\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-31\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Manager: ManagerQuiz, the full quiz including correct answers. STUDENT (ACTIVE enrollee) or PARENT (linked to an enrollee): toStudentQuiz, with no questions and never `correct`. A DRAFT quiz is NOT_FOUND for non-managers.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"ManagerQuiz\", \"StudentQuiz\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-31\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Updates settings and/or the status transition. Allowed transitions are DRAFT→PUBLISHED and PUBLISHED→CLOSED only (A9); any other change is CONFLICT. Publishing runs canPublish: if there are problems it returns VALIDATION_ERROR with details {problems: string[]} (FR-9). Otherwise it does a conditional updateMany where status = DRAFT, and only if that updated a row is notify('quiz.published') sent, after commit, to ACTIVE enrollees (FR-29). resultsReleasedAt cannot be set here; use release-results.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\" },\n        \"body\": \"Partial<QuizSettingsInput> & { status?: \\\"PUBLISHED\\\" | \\\"CLOSED\\\" } (at least one key)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\" },\n      \"errors\": [\"VALIDATION_ERROR (schema, cross-field rule, or publish problems)\", \"CONFLICT (invalid status transition)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-9\", \"FR-29\", \"FR-31\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Deletes the quiz (questions and accommodations cascade). Allowed only while no attempt exists.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (quiz has attempts)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions\",\n      \"description\": \"Adds a question at order = max + 1. The builder's Duplicate action is this call with a copied body (FR-7). Edit lock: CONFLICT when the quiz has attempts (FR-10). Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"QuestionInput\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions/reorder\",\n      \"description\": \"Rewrites Question.order to match the given list, in one transaction. The list must be exactly the quiz's question ids (a permutation), otherwise VALIDATION_ERROR. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": { \"questionIds\": \"string[]\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion[] (new order)\" },\n      \"errors\": [\"VALIDATION_ERROR (not a permutation)\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Edits a question. Without attempts, any QuestionInput field can change; the result is re-validated as a whole against the type's schema. With attempts (edit lock, FR-10), only prompt and explanation can change, plus correct.accepted and caseSensitive for SHORT_ANSWER. Any other key gives CONFLICT with the message 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.' Editing never triggers a regrade (A3).\",\n      \"auth\": \"manage course (of the question's quiz)\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" }, \"body\": \"Partial<QuestionInput>\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Deletes a question and closes the gap in order. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/regrade\",\n      \"description\": \"In one transaction: re-runs gradeAnswer on every answer with gradedById = null across submitted attempts (manual grades always win, A8), runs recomputeAttempt on each attempt, then writes audit('quiz.regrade').\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"attemptCount\": \"int\", \"changedAnswerCount\": \"int\" } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-10\", \"FR-25\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/release-results\",\n      \"description\": \"MANUAL visibility only. Runs updateMany({id, resultsVisibility: MANUAL, resultsReleasedAt: null} → now). If that updated a row, it calls notifyStudentAndParents('quiz.results_released') for every student with a submitted attempt, then audit('quiz.release_results'). A repeat call is a no-op that returns the existing timestamp. A non-MANUAL quiz is CONFLICT.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"resultsReleasedAt\": \"ISO datetime\", \"notified\": \"boolean (false on repeat)\" } },\n      \"errors\": [\"CONFLICT (resultsVisibility ≠ MANUAL)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-20\", \"FR-30\", \"FR-38\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id/analytics\",\n      \"description\": \"Quiz analytics computed in memory over submitted attempts (FR-26, FR-27). With ?format=csv it returns text/csv (Content-Disposition: attachment; filename=\\\"quiz-<id>-attempts.csv\\\"), built with toCsv. CSV columns: student, attemptNumber, score, then one points column per question in quiz order.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"query\": { \"format\": \"\\\"json\\\" | \\\"csv\\\" (default json)\" } },\n      \"responseSchema\": {\n        \"envelope\": \"data (json) | raw text/csv\",\n        \"data\": {\n          \"summary\": { \"attempts\": \"int\", \"average\": \"Decimal | null\", \"median\": \"Decimal | null\", \"highest\": \"Decimal | null\", \"lowest\": \"Decimal | null\", \"averageTimeSeconds\": \"int | null\" },\n          \"histogram\": \"{ bucket: \\\"0–10\\\" | … | \\\"90–100\\\", count: int }[10] (by percent; 100% goes in the last bucket)\",\n          \"questions\": \"{ questionId, order: int, type: QuestionType, prompt, points: Decimal, percentCorrect: number | null, averagePoints: Decimal | null, optionDistribution: { optionId, text, count: int, isCorrect: boolean }[] | null (choice types only), mostChosenWrongOptionId: string | null }[]\"\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR (bad format)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-26\", \"FR-27\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/quizzes/:id/accommodations/:studentId\",\n      \"description\": \"Upserts the QuizAccommodation for one ACTIVE enrollee, then writes audit('quiz.accommodation'). It applies only to attempts started afterwards, because deadlineAt is frozen at start (A7). Sending {0, 0} keeps the row; that is equivalent to no accommodation.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\", \"studentId\": \"userId (must be ACTIVE enrolled in the course)\" },\n        \"body\": { \"extraTimeMinutes\": \"int 0–300\", \"extraAttempts\": \"int 0–5\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"quizId\": \"string\", \"studentId\": \"string\", \"extraTimeMinutes\": \"int\", \"extraAttempts\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (quiz or student not in course)\"],\n      \"requirementIds\": [\"FR-28\", \"FR-2\", \"FR-23\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/attempts\",\n      \"description\": \"STUDENT start or resume (system-design §4.2). Requires the quiz to be PUBLISHED with availableFrom ≤ now < availableUntil, else CONFLICT. An existing IN_PROGRESS attempt goes through ensureNotExpired and is returned with 200 (resume, FR-19). Otherwise, attempt count ≥ attemptLimit is CONFLICT (FR-23). Otherwise the attempt is created with id pre-generated, questionOrder frozen (seededShuffle by id when shuffleQuestions) and deadlineAt = computeDeadline(...), and returned with 201. A P2002 race on the partial unique index re-reads and returns the IN_PROGRESS attempt with 200.\",\n      \"auth\": \"role STUDENT + view course (ACTIVE enrollee)\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentAttempt\", \"status\": \"201 created | 200 resumed\" },\n      \"errors\": [\"CONFLICT (quiz not open | attempt limit reached)\", \"NOT_FOUND (quiz not visible)\", \"FORBIDDEN is not used; a non-STUDENT gets NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-19\", \"FR-23\", \"FR-28\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attempts/:id\",\n      \"description\": \"Calls ensureNotExpired first (FR-18), then assertCanAccessAttempt (FR-34). Owner: StudentAttempt while IN_PROGRESS, otherwise StudentResult. Linked PARENT: StudentResult, and only if the attempt is submitted and resultsVisible, else NOT_FOUND. Course manager: ManagerAttempt. Any other caller gets NOT_FOUND.\",\n      \"auth\": \"owner | linked parent (read-only) | course manager\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"StudentAttempt\", \"StudentResult\", \"ManagerAttempt\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-24\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId\",\n      \"description\": \"Autosave hot path (system-design §4.3, NFR-2): one attempt read, no Quiz or Question load, then one QuizAnswer upsert on the (attemptId, questionId) PK. Checks: studentId ≠ caller → NOT_FOUND; questionId ∉ questionOrder → NOT_FOUND; status ≠ IN_PROGRESS → CONFLICT; now > deadlineAt + 30 s → submitAttempt(id, {auto: true}) then CONFLICT 'Time is up' (FR-16). Idempotent, so localStorage replays are safe (FR-15). response: null clears the answer.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId\" },\n        \"body\": { \"response\": \"AnswerResponse | null\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"questionId\": \"string\", \"savedAt\": \"ISO datetime\" }, \"note\": \"Carries no grading data (NFR-1). On 409 the client stops its queue, clears localStorage['quiz-attempt:<id>'] and routes to the result page.\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (not in progress | past deadline + grace)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-32\", \"NFR-2\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/attempts/:id/submit\",\n      \"description\": \"Runs submitAttempt(id, {auto: false}) (system-design §4.4). The IN_PROGRESS → SUBMITTED claim is atomic; missing answers are created as null, every answer is auto-graded, then recomputeAttempt sets status NEEDS_GRADING or GRADED (FR-17). An already-submitted attempt returns its current state with 200 (idempotent, no error). A submit after the deadline still succeeds as a manual submit; nothing is lost because the answers were already saved.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentResult\" },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-17\", \"FR-25\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId/grade\",\n      \"description\": \"Manual grade or override (FR-24). The attempt must be submitted (not IN_PROGRESS), else CONFLICT. pointsAwarded must be ≤ question.points and a multiple of 0.5, else VALIDATION_ERROR. Sets pointsAwarded, isCorrect = (pointsAwarded == question.points), feedback and gradedById = caller, upserting the answer row if it is missing. Then recomputeAttempt (FR-25), and audit('quizAnswer.grade') after commit. No notification is sent (FR-30). The body field is named pointsAwarded per the PRD API table (system-design §3.2 calls it `points`; manualGradeSchema should use pointsAwarded).\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId (must be in questionOrder)\" },\n        \"body\": { \"pointsAwarded\": \"number | string, ≥ 0, step 0.5\", \"feedback\": \"string | null (optional)\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"answer\": \"ManagerAnswer\", \"attempt\": { \"id\": \"string\", \"status\": \"AttemptStatus\", \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (attempt in progress)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-4\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING cron route. The request/response contract is unchanged: Bearer CRON_SECRET in, ok(dispatchEmails result) out. Changed behaviour only: after sendDueReminders(now), it also runs autoSubmitExpiredAttempts(now) (IN_PROGRESS with deadlineAt < now − 30 s, ≤ 200 per call) and sendAfterCloseResultsReleased(now) (atomic resultsReleasedAt claim, A6). Each runs in its own try/catch with logger.error, on every request, and both are idempotent.\",\n      \"auth\": \"cron secret\",\n      \"requestSchema\": { \"headers\": { \"authorization\": \"Bearer <CRON_SECRET>\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"unchanged dispatchEmails() result\" },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-18\", \"FR-30\", \"FR-35\"]\n    }\n  ],\n\n  \"reusedUnchanged\": [\n    \"POST /api/files and GET /api/files/:id serve question-prompt images with the new 'quiz' file context and resolver (manager, or course viewer once the quiz is PUBLISHED). The route contracts don't change (FR-39, system-design §3.5).\"\n  ],\n\n  \"status\": \"complete\"\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3548,"cache_read_input_tokens":65915,"cache_creation":{"ephemeral_5m_input_tokens":3548,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b2cdffa8-12d1-4e17-864e-e6653bd23adc","uuid":"93fe2be6-626f-4dbf-8322-7c26312240bf","timestamp":"2026-11-09T07:09:11.488Z","request_id":"req_011Cgrw2vFNg4K6UV4hQhnyc","wire_tool_inputs":{"toolu_01MXjUrKWjBs5MFXJRW7imKv":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-10\",\n  \"timestamp\": \"2026-11-09T13:00:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api. This is the existing project convention; there is no /api/v1 prefix (system-design §3.3).\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/quiz.ts) → one call into src/server/quiz/*-service.ts → ok()/paginated(). All of these come from src/server/http.ts. Handlers contain no logic (NFR-6, NFR-7).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int ≥ 1, default 1\", \"pageSize\": \"int 1–100, default 20 (parsePagination)\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": \"400. Zod failure (details = zod flatten()) or a service rule failure such as canPublish problems, points > question points, or step ≠ 0.5.\",\n      \"UNAUTHENTICATED\": \"401. No session, or a bad cron secret on the internal route.\",\n      \"NOT_FOUND\": \"404. The resource is missing OR the caller cannot access it. Existence is never revealed, so FORBIDDEN is not used for quiz resources (NFR-5).\",\n      \"CONFLICT\": \"409. Answer write after deadlineAt + 30 s, a closed or not-yet-open quiz, attempt limit reached, edit lock (quiz has attempts), delete with attempts, an invalid status transition, or a write to a non-IN_PROGRESS attempt.\",\n      \"INTERNAL\": \"500. Logged with logger.error and never detailed to the client.\"\n    },\n    \"createdStatus\": \"POST endpoints that create a resource return 201 via ok(x, {status: 201}). Every other success returns 200.\",\n    \"decimals\": \"points, score, maxScore, pointsAwarded, totalPoints and the analytics averages are serialized as strings with 2 decimals by fixed2 from @/server/assignments/grading-math (e.g. \\\"2.00\\\"). Input decimals accept number | string. Percentages are numbers rounded to 1 decimal.\",\n    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client time (ADR-4). The UI displays times in SchoolSettings.timezone (NFR-6).\",\n    \"ids\": \"cuid strings. Option ids inside Question.options are short cuids generated by the builder and stay stable across edits.\",\n    \"studentPrivacy\": \"Every quiz, attempt or result returned to a STUDENT or PARENT is built only by the allow-listing serializers in src/server/quiz/serializers.ts (toStudentQuiz, toStudentAttempt, toStudentResult). `correct` and `explanation` appear only inside StudentResult.questions[] and only when resultsVisible && showCorrectAnswers. Scores appear only when resultsVisible. Student-path Prisma selects never load `correct` or `explanation` (NFR-1, ADR-5).\",\n    \"lazyAutoSubmit\": \"GET /api/attempts/:id, POST /api/quizzes/:id/attempts, the course list and the teacher grade/list loads call ensureNotExpired first. So an IN_PROGRESS attempt past deadlineAt is always returned already submitted (FR-18).\",\n    \"noEndpointBy design\": [\n      \"getStudentQuizScore(quizId, studentId) → {score, maxScore, percent, isPractice, attemptsCounted} | null is a TypeScript export of attempt-service.ts for PRD-11. It has no HTTP route (FR-22, FR-33, system-design §4.7).\",\n      \"The grading workspace, the analytics page and the builder's accommodations table are server pages. They call the services directly, after requirePageRole and assertCanManageCourse. Only their writes go through the routes below (system-design §3.4).\",\n      \"Preview mode (FR-8) calls no attempt endpoint (A10).\"\n    ],\n    \"requirementIds\": [\"FR-31\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\", \"NFR-7\"]\n  },\n\n  \"sharedSchemas\": {\n    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^\\\\d+\\\\.\\\\d{2}$\", \"description\": \"Output form. Input form is number | string.\" },\n    \"QuizStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"PUBLISHED\", \"CLOSED\"] },\n    \"QuestionType\": { \"type\": \"string\", \"enum\": [\"SINGLE_CHOICE\", \"MULTIPLE_CHOICE\", \"TRUE_FALSE\", \"SHORT_ANSWER\", \"ESSAY\"] },\n    \"ResultsVisibility\": { \"type\": \"string\", \"enum\": [\"IMMEDIATELY\", \"AFTER_CLOSE\", \"MANUAL\"] },\n    \"AttemptStatus\": { \"type\": \"string\", \"enum\": [\"IN_PROGRESS\", \"SUBMITTED\", \"NEEDS_GRADING\", \"GRADED\"] },\n    \"ScoringPolicy\": { \"type\": \"string\", \"enum\": [\"HIGHEST\", \"LATEST\", \"AVERAGE\"] },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"name\": \"string\" } },\n    \"Option\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"text\": \"string (non-empty)\" } },\n    \"Correct\": {\n      \"description\": \"Keyed by Question.type (FR-2). Manager-only, except as described in conventions.studentPrivacy.\",\n      \"oneOf\": {\n        \"SINGLE_CHOICE\": { \"optionId\": \"string (must be one of options[].id)\" },\n        \"MULTIPLE_CHOICE\": { \"optionIds\": \"string[] (≥ 1, each in options[].id)\" },\n        \"TRUE_FALSE\": { \"value\": \"boolean\" },\n        \"SHORT_ANSWER\": { \"accepted\": \"string[] (1–10, non-empty)\" },\n        \"ESSAY\": { \"guidance\": \"string?\" }\n      }\n    },\n    \"AnswerResponse\": {\n      \"description\": \"answerResponseSchema. A type-agnostic union, so the autosave path doesn't load the Question (NFR-2). A shape that doesn't match the question's type grades as 0 / incorrect at submit.\",\n      \"oneOf\": [\n        { \"optionId\": \"string\" },\n        { \"optionIds\": \"string[]\" },\n        { \"value\": \"boolean\" },\n        { \"text\": \"string (≤ 10,000 chars)\" }\n      ]\n    },\n    \"QuizSettingsInput\": {\n      \"description\": \"quizSettingsSchema (FR-2, FR-6). Cross-field rules run in superRefine: availableUntil > availableFrom, and timeLimitMinutes ≤ the window length in minutes. On PATCH, both rules are checked against the stored values merged with the patch.\",\n      \"properties\": {\n        \"title\": \"string (trimmed, non-empty)\",\n        \"instructions\": \"string (Markdown, default \\\"\\\")\",\n        \"isPractice\": \"boolean (default false)\",\n        \"availableFrom\": \"ISO datetime\",\n        \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int 1–300 | null (null = untimed)\",\n        \"maxAttempts\": \"int 1–10 (default 1)\",\n        \"scoringPolicy\": \"ScoringPolicy (default HIGHEST)\",\n        \"shuffleQuestions\": \"boolean (default false)\",\n        \"shuffleOptions\": \"boolean (default false)\",\n        \"oneQuestionPerPage\": \"boolean (default false)\",\n        \"resultsVisibility\": \"ResultsVisibility (default AFTER_CLOSE)\",\n        \"showCorrectAnswers\": \"boolean (default true)\"\n      }\n    },\n    \"QuestionInput\": {\n      \"description\": \"questionSchema, a z.discriminatedUnion on type (FR-2, FR-7). points 0.5–100 in steps of 0.5. options has 2–8 entries for SINGLE_CHOICE/MULTIPLE_CHOICE and is absent for the other types. prompt is non-empty Markdown and may embed a file uploaded with context 'quiz' (FR-39).\",\n      \"properties\": {\n        \"type\": \"QuestionType\",\n        \"prompt\": \"string (Markdown)\",\n        \"points\": \"number | string\",\n        \"options\": \"Option[] | undefined\",\n        \"correct\": \"Correct (shape keyed by type)\",\n        \"explanation\": \"string | null\",\n        \"caseSensitive\": \"boolean (SHORT_ANSWER only, default false)\"\n      }\n    },\n    \"ManagerQuestion\": {\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\",\n        \"order\": \"int\", \"options\": \"Option[] | null\", \"correct\": \"Correct\", \"explanation\": \"string | null\", \"caseSensitive\": \"boolean\"\n      }\n    },\n    \"ManagerQuiz\": {\n      \"description\": \"Full quiz, including answers. Returned only to managers (assertCanManageCourse).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\",\n        \"...\": \"every QuizSettingsInput field, resolved\",\n        \"status\": \"QuizStatus\",\n        \"resultsReleasedAt\": \"ISO datetime | null\",\n        \"createdById\": \"string\", \"createdAt\": \"ISO datetime\", \"updatedAt\": \"ISO datetime\",\n        \"questions\": \"ManagerQuestion[] (sorted by order)\",\n        \"totalPoints\": \"Decimal (Σ points, FR-8)\",\n        \"attemptCount\": \"int\",\n        \"locked\": \"boolean (attemptCount > 0, edit lock FR-10)\",\n        \"publishProblems\": \"string[] (canPublish(questions); empty means publishable, FR-9)\"\n      }\n    },\n    \"StudentQuiz\": {\n      \"description\": \"toStudentQuiz. Allow-listed, with no questions and no `correct` (NFR-1). Drives the start screen (FR-12).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\", \"title\": \"string\", \"instructions\": \"string\", \"isPractice\": \"boolean\",\n        \"status\": \"QuizStatus (DRAFT is never returned to a non-manager; that case is NOT_FOUND)\",\n        \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int | null\", \"oneQuestionPerPage\": \"boolean\", \"resultsVisibility\": \"ResultsVisibility\",\n        \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n        \"extraTimeMinutes\": \"int (caller's accommodation, 0 if none; 0 for parents)\",\n        \"attemptLimit\": \"int (attemptLimit(maxAttempts, extraAttempts), FR-23)\",\n        \"attemptsUsed\": \"int (caller's own attempts; 0 for parents)\",\n        \"inProgressAttemptId\": \"string | null (Resume target, FR-19)\",\n        \"isOpen\": \"boolean (PUBLISHED && availableFrom ≤ now < availableUntil)\"\n      }\n    },\n    \"StudentQuestion\": {\n      \"description\": \"A question as shown in the player. It never contains correct, explanation or caseSensitive.\",\n      \"properties\": { \"id\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\", \"options\": \"Option[] | null (in seededShuffle(options, attempt.id) order when shuffleOptions, FR-13)\" }\n    },\n    \"StudentAttempt\": {\n      \"description\": \"toStudentAttempt. Returned while status = IN_PROGRESS (FR-13, FR-14, FR-19).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\", \"status\": \"\\\"IN_PROGRESS\\\"\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime (always set: untimed attempts use availableUntil)\",\n        \"serverNow\": \"ISO datetime (lets the display-only timer correct for client clock skew, ADR-4)\",\n        \"oneQuestionPerPage\": \"boolean\",\n        \"questions\": \"StudentQuestion[] (in the frozen questionOrder)\",\n        \"answers\": \"{ questionId: string, response: AnswerResponse | null, savedAt: ISO datetime }[] (no grading fields)\"\n      }\n    },\n    \"StudentResult\": {\n      \"description\": \"toStudentResult. Returned for a submitted attempt to its owner or a linked parent (FR-20, FR-21). When resultsVisible = false, every score field is null and questions is null; the UI shows 'Submitted — results will be available later.'\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\",\n        \"status\": \"\\\"SUBMITTED\\\" | \\\"NEEDS_GRADING\\\" | \\\"GRADED\\\"\",\n        \"startedAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime\", \"autoSubmitted\": \"boolean\",\n        \"resultsVisible\": \"boolean\",\n        \"awaitingGrading\": \"boolean (status ≠ GRADED)\",\n        \"score\": \"Decimal | null (only when resultsVisible && status = GRADED)\",\n        \"maxScore\": \"Decimal\",\n        \"percent\": \"number | null (same condition as score)\",\n        \"questions\": \"null | { id, type, prompt, points: Decimal, options: Option[] | null, response: AnswerResponse | null, pendingReview: boolean (needsReview, A8), pointsAwarded: Decimal | null (null when pendingReview), isCorrect: boolean | null, feedback: string | null, correct?: Correct (only if showCorrectAnswers), explanation?: string | null (only if showCorrectAnswers) }[] (in questionOrder)\"\n      }\n    },\n    \"ManagerAnswer\": {\n      \"properties\": {\n        \"questionId\": \"string\", \"response\": \"AnswerResponse | null\", \"pointsAwarded\": \"Decimal | null\", \"isCorrect\": \"boolean | null\",\n        \"feedback\": \"string | null\", \"gradedById\": \"string | null\", \"needsReview\": \"boolean (derived, A8)\", \"updatedAt\": \"ISO datetime\"\n      }\n    },\n    \"ManagerAttempt\": {\n      \"description\": \"The full attempt for a course manager (FR-24).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"student\": \"UserRef\", \"attemptNumber\": \"int\", \"status\": \"AttemptStatus\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime | null\", \"autoSubmitted\": \"boolean\",\n        \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\",\n        \"questionOrder\": \"string[]\",\n        \"questions\": \"ManagerQuestion[] (in questionOrder)\",\n        \"answers\": \"ManagerAnswer[]\"\n      }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Role-shaped, paginated course Quizzes tab list (FR-11). Access: assertCanViewCourse. Managers see every status. Students and parents see only PUBLISHED and CLOSED quizzes. Sorted by availableFrom desc. Runs ensureNotExpired on the caller's own IN_PROGRESS attempts before computing groups.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId (cuid)\" },\n        \"query\": { \"page\": \"int?\", \"pageSize\": \"int? ≤ 100\" }\n      },\n      \"responseSchema\": {\n        \"envelope\": \"paginated\",\n        \"item\": {\n          \"oneOf\": {\n            \"manager\": {\n              \"role\": \"\\\"MANAGER\\\"\",\n              \"id\": \"string\", \"title\": \"string\", \"status\": \"QuizStatus\", \"isPractice\": \"boolean\",\n              \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\", \"timeLimitMinutes\": \"int | null\",\n              \"resultsVisibility\": \"ResultsVisibility\", \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n              \"attemptCount\": \"int\", \"averagePercent\": \"number | null (submitted+graded attempts)\", \"needsGradingCount\": \"int (attempts with status NEEDS_GRADING)\"\n            },\n            \"student\": {\n              \"role\": \"\\\"STUDENT\\\"\",\n              \"quiz\": \"StudentQuiz\",\n              \"group\": \"\\\"UPCOMING\\\" | \\\"AVAILABLE\\\" | \\\"COMPLETED\\\" | \\\"MISSED\\\". UPCOMING = now < availableFrom. AVAILABLE = isOpen && (attemptsUsed < attemptLimit || inProgressAttemptId). COMPLETED = ≥ 1 submitted attempt and not AVAILABLE. MISSED = now ≥ availableUntil with 0 attempts (A2).\",\n              \"latestResult\": \"{ attemptId: string, status: AttemptStatus, score: Decimal | null, maxScore: Decimal, percent: number | null } | null (scores null unless resultsVisible)\"\n            },\n            \"parent\": {\n              \"role\": \"\\\"PARENT\\\"\",\n              \"student\": \"UserRef (linked child enrolled in the course; one row per child × quiz)\",\n              \"quiz\": \"StudentQuiz\",\n              \"results\": \"{ attemptId: string, attemptNumber: int, submittedAt: ISO datetime, score: Decimal | null, maxScore: Decimal, percent: number | null }[] (only attempts where resultsVisible, read-only)\"\n            }\n          }\n        }\n      },\n      \"errors\": [\"NOT_FOUND (course not visible)\"],\n      \"requirementIds\": [\"FR-11\", \"FR-31\", \"FR-33\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Creates a DRAFT quiz. The /quizzes/new page sends defaults and then redirects to /edit (FR-6). createdById = caller. Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId\" },\n        \"body\": \"QuizSettingsInput with title, availableFrom and availableUntil required; every other field optional (FR-1 defaults)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (cannot manage course)\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-31\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Manager: ManagerQuiz, the full quiz including correct answers. STUDENT (ACTIVE enrollee) or PARENT (linked to an enrollee): toStudentQuiz, with no questions and never `correct`. A DRAFT quiz is NOT_FOUND for non-managers.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"ManagerQuiz\", \"StudentQuiz\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-31\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Updates settings and/or the status transition. Allowed transitions are DRAFT→PUBLISHED and PUBLISHED→CLOSED only (A9); any other change is CONFLICT. Publishing runs canPublish: if there are problems it returns VALIDATION_ERROR with details {problems: string[]} (FR-9). Otherwise it does a conditional updateMany where status = DRAFT, and only if that updated a row is notify('quiz.published') sent, after commit, to ACTIVE enrollees (FR-29). resultsReleasedAt cannot be set here; use release-results.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\" },\n        \"body\": \"Partial<QuizSettingsInput> & { status?: \\\"PUBLISHED\\\" | \\\"CLOSED\\\" } (at least one key)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\" },\n      \"errors\": [\"VALIDATION_ERROR (schema, cross-field rule, or publish problems)\", \"CONFLICT (invalid status transition)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-9\", \"FR-29\", \"FR-31\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Deletes the quiz (questions and accommodations cascade). Allowed only while no attempt exists.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (quiz has attempts)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions\",\n      \"description\": \"Adds a question at order = max + 1. The builder's Duplicate action is this call with a copied body (FR-7). Edit lock: CONFLICT when the quiz has attempts (FR-10). Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"QuestionInput\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions/reorder\",\n      \"description\": \"Rewrites Question.order to match the given list, in one transaction. The list must be exactly the quiz's question ids (a permutation), otherwise VALIDATION_ERROR. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": { \"questionIds\": \"string[]\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion[] (new order)\" },\n      \"errors\": [\"VALIDATION_ERROR (not a permutation)\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Edits a question. Without attempts, any QuestionInput field can change; the result is re-validated as a whole against the type's schema. With attempts (edit lock, FR-10), only prompt and explanation can change, plus correct.accepted and caseSensitive for SHORT_ANSWER. Any other key gives CONFLICT with the message 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.' Editing never triggers a regrade (A3).\",\n      \"auth\": \"manage course (of the question's quiz)\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" }, \"body\": \"Partial<QuestionInput>\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Deletes a question and closes the gap in order. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/regrade\",\n      \"description\": \"In one transaction: re-runs gradeAnswer on every answer with gradedById = null across submitted attempts (manual grades always win, A8), runs recomputeAttempt on each attempt, then writes audit('quiz.regrade').\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"attemptCount\": \"int\", \"changedAnswerCount\": \"int\" } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-10\", \"FR-25\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/release-results\",\n      \"description\": \"MANUAL visibility only. Runs updateMany({id, resultsVisibility: MANUAL, resultsReleasedAt: null} → now). If that updated a row, it calls notifyStudentAndParents('quiz.results_released') for every student with a submitted attempt, then audit('quiz.release_results'). A repeat call is a no-op that returns the existing timestamp. A non-MANUAL quiz is CONFLICT.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"resultsReleasedAt\": \"ISO datetime\", \"notified\": \"boolean (false on repeat)\" } },\n      \"errors\": [\"CONFLICT (resultsVisibility ≠ MANUAL)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-20\", \"FR-30\", \"FR-38\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id/analytics\",\n      \"description\": \"Quiz analytics computed in memory over submitted attempts (FR-26, FR-27). With ?format=csv it returns text/csv (Content-Disposition: attachment; filename=\\\"quiz-<id>-attempts.csv\\\"), built with toCsv. CSV columns: student, attemptNumber, score, then one points column per question in quiz order.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"query\": { \"format\": \"\\\"json\\\" | \\\"csv\\\" (default json)\" } },\n      \"responseSchema\": {\n        \"envelope\": \"data (json) | raw text/csv\",\n        \"data\": {\n          \"summary\": { \"attempts\": \"int\", \"average\": \"Decimal | null\", \"median\": \"Decimal | null\", \"highest\": \"Decimal | null\", \"lowest\": \"Decimal | null\", \"averageTimeSeconds\": \"int | null\" },\n          \"histogram\": \"{ bucket: \\\"0–10\\\" | … | \\\"90–100\\\", count: int }[10] (by percent; 100% goes in the last bucket)\",\n          \"questions\": \"{ questionId, order: int, type: QuestionType, prompt, points: Decimal, percentCorrect: number | null, averagePoints: Decimal | null, optionDistribution: { optionId, text, count: int, isCorrect: boolean }[] | null (choice types only), mostChosenWrongOptionId: string | null }[]\"\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR (bad format)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-26\", \"FR-27\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/quizzes/:id/accommodations/:studentId\",\n      \"description\": \"Upserts the QuizAccommodation for one ACTIVE enrollee, then writes audit('quiz.accommodation'). It applies only to attempts started afterwards, because deadlineAt is frozen at start (A7). Sending {0, 0} keeps the row; that is equivalent to no accommodation.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\", \"studentId\": \"userId (must be ACTIVE enrolled in the course)\" },\n        \"body\": { \"extraTimeMinutes\": \"int 0–300\", \"extraAttempts\": \"int 0–5\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"quizId\": \"string\", \"studentId\": \"string\", \"extraTimeMinutes\": \"int\", \"extraAttempts\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (quiz or student not in course)\"],\n      \"requirementIds\": [\"FR-28\", \"FR-2\", \"FR-23\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/attempts\",\n      \"description\": \"STUDENT start or resume (system-design §4.2). Requires the quiz to be PUBLISHED with availableFrom ≤ now < availableUntil, else CONFLICT. An existing IN_PROGRESS attempt goes through ensureNotExpired and is returned with 200 (resume, FR-19). Otherwise, attempt count ≥ attemptLimit is CONFLICT (FR-23). Otherwise the attempt is created with id pre-generated, questionOrder frozen (seededShuffle by id when shuffleQuestions) and deadlineAt = computeDeadline(...), and returned with 201. A P2002 race on the partial unique index re-reads and returns the IN_PROGRESS attempt with 200.\",\n      \"auth\": \"role STUDENT + view course (ACTIVE enrollee)\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentAttempt\", \"status\": \"201 created | 200 resumed\" },\n      \"errors\": [\"CONFLICT (quiz not open | attempt limit reached)\", \"NOT_FOUND (quiz not visible)\", \"FORBIDDEN is not used; a non-STUDENT gets NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-19\", \"FR-23\", \"FR-28\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attempts/:id\",\n      \"description\": \"Calls ensureNotExpired first (FR-18), then assertCanAccessAttempt (FR-34). Owner: StudentAttempt while IN_PROGRESS, otherwise StudentResult. Linked PARENT: StudentResult, and only if the attempt is submitted and resultsVisible, else NOT_FOUND. Course manager: ManagerAttempt. Any other caller gets NOT_FOUND.\",\n      \"auth\": \"owner | linked parent (read-only) | course manager\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"StudentAttempt\", \"StudentResult\", \"ManagerAttempt\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-24\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId\",\n      \"description\": \"Autosave hot path (system-design §4.3, NFR-2): one attempt read, no Quiz or Question load, then one QuizAnswer upsert on the (attemptId, questionId) PK. Checks: studentId ≠ caller → NOT_FOUND; questionId ∉ questionOrder → NOT_FOUND; status ≠ IN_PROGRESS → CONFLICT; now > deadlineAt + 30 s → submitAttempt(id, {auto: true}) then CONFLICT 'Time is up' (FR-16). Idempotent, so localStorage replays are safe (FR-15). response: null clears the answer.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId\" },\n        \"body\": { \"response\": \"AnswerResponse | null\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"questionId\": \"string\", \"savedAt\": \"ISO datetime\" }, \"note\": \"Carries no grading data (NFR-1). On 409 the client stops its queue, clears localStorage['quiz-attempt:<id>'] and routes to the result page.\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (not in progress | past deadline + grace)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-32\", \"NFR-2\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/attempts/:id/submit\",\n      \"description\": \"Runs submitAttempt(id, {auto: false}) (system-design §4.4). The IN_PROGRESS → SUBMITTED claim is atomic; missing answers are created as null, every answer is auto-graded, then recomputeAttempt sets status NEEDS_GRADING or GRADED (FR-17). An already-submitted attempt returns its current state with 200 (idempotent, no error). A submit after the deadline still succeeds as a manual submit; nothing is lost because the answers were already saved.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentResult\" },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-17\", \"FR-25\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId/grade\",\n      \"description\": \"Manual grade or override (FR-24). The attempt must be submitted (not IN_PROGRESS), else CONFLICT. pointsAwarded must be ≤ question.points and a multiple of 0.5, else VALIDATION_ERROR. Sets pointsAwarded, isCorrect = (pointsAwarded == question.points), feedback and gradedById = caller, upserting the answer row if it is missing. Then recomputeAttempt (FR-25), and audit('quizAnswer.grade') after commit. No notification is sent (FR-30). The body field is named pointsAwarded per the PRD API table (system-design §3.2 calls it `points`; manualGradeSchema should use pointsAwarded).\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId (must be in questionOrder)\" },\n        \"body\": { \"pointsAwarded\": \"number | string, ≥ 0, step 0.5\", \"feedback\": \"string | null (optional)\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"answer\": \"ManagerAnswer\", \"attempt\": { \"id\": \"string\", \"status\": \"AttemptStatus\", \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (attempt in progress)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-4\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING cron route. The request/response contract is unchanged: Bearer CRON_SECRET in, ok(dispatchEmails result) out. Changed behaviour only: after sendDueReminders(now), it also runs autoSubmitExpiredAttempts(now) (IN_PROGRESS with deadlineAt < now − 30 s, ≤ 200 per call) and sendAfterCloseResultsReleased(now) (atomic resultsReleasedAt claim, A6). Each runs in its own try/catch with logger.error, on every request, and both are idempotent.\",\n      \"auth\": \"cron secret\",\n      \"requestSchema\": { \"headers\": { \"authorization\": \"Bearer <CRON_SECRET>\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"unchanged dispatchEmails() result\" },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-18\", \"FR-30\", \"FR-35\"]\n    }\n  ],\n\n  \"reusedUnchanged\": [\n    \"POST /api/files and GET /api/files/:id serve question-prompt images with the new 'quiz' file context and resolver (manager, or course viewer once the quiz is PUBLISHED). The route contracts don't change (FR-39, system-design §3.5).\"\n  ],\n\n  \"status\": \"complete\"\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MXjUrKWjBs5MFXJRW7imKv","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/api-contracts.json has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"b2cdffa8-12d1-4e17-864e-e6653bd23adc","uuid":"d68b2661-3252-4acc-9b48-498170dfd4ee","timestamp":"2026-11-09T07:09:11.704Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-10\",\n  \"timestamp\": \"2026-11-09T13:00:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api. This is the existing project convention; there is no /api/v1 prefix (system-design §3.3).\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/quiz.ts) → one call into src/server/quiz/*-service.ts → ok()/paginated(). All of these come from src/server/http.ts. Handlers contain no logic (NFR-6, NFR-7).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int ≥ 1, default 1\", \"pageSize\": \"int 1–100, default 20 (parsePagination)\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": \"400. Zod failure (details = zod flatten()) or a service rule failure such as canPublish problems, points > question points, or step ≠ 0.5.\",\n      \"UNAUTHENTICATED\": \"401. No session, or a bad cron secret on the internal route.\",\n      \"NOT_FOUND\": \"404. The resource is missing OR the caller cannot access it. Existence is never revealed, so FORBIDDEN is not used for quiz resources (NFR-5).\",\n      \"CONFLICT\": \"409. Answer write after deadlineAt + 30 s, a closed or not-yet-open quiz, attempt limit reached, edit lock (quiz has attempts), delete with attempts, an invalid status transition, or a write to a non-IN_PROGRESS attempt.\",\n      \"INTERNAL\": \"500. Logged with logger.error and never detailed to the client.\"\n    },\n    \"createdStatus\": \"POST endpoints that create a resource return 201 via ok(x, {status: 201}). Every other success returns 200.\",\n    \"decimals\": \"points, score, maxScore, pointsAwarded, totalPoints and the analytics averages are serialized as strings with 2 decimals by fixed2 from @/server/assignments/grading-math (e.g. \\\"2.00\\\"). Input decimals accept number | string. Percentages are numbers rounded to 1 decimal.\",\n    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client time (ADR-4). The UI displays times in SchoolSettings.timezone (NFR-6).\",\n    \"ids\": \"cuid strings. Option ids inside Question.options are short cuids generated by the builder and stay stable across edits.\",\n    \"studentPrivacy\": \"Every quiz, attempt or result returned to a STUDENT or PARENT is built only by the allow-listing serializers in src/server/quiz/serializers.ts (toStudentQuiz, toStudentAttempt, toStudentResult). `correct` and `explanation` appear only inside StudentResult.questions[] and only when resultsVisible && showCorrectAnswers. Scores appear only when resultsVisible. Student-path Prisma selects never load `correct` or `explanation` (NFR-1, ADR-5).\",\n    \"lazyAutoSubmit\": \"GET /api/attempts/:id, POST /api/quizzes/:id/attempts, the course list and the teacher grade/list loads call ensureNotExpired first. So an IN_PROGRESS attempt past deadlineAt is always returned already submitted (FR-18).\",\n    \"noEndpointBy design\": [\n      \"getStudentQuizScore(quizId, studentId) → {score, maxScore, percent, isPractice, attemptsCounted} | null is a TypeScript export of attempt-service.ts for PRD-11. It has no HTTP route (FR-22, FR-33, system-design §4.7).\",\n      \"The grading workspace, the analytics page and the builder's accommodations table are server pages. They call the services directly, after requirePageRole and assertCanManageCourse. Only their writes go through the routes below (system-design §3.4).\",\n      \"Preview mode (FR-8) calls no attempt endpoint (A10).\"\n    ],\n    \"requirementIds\": [\"FR-31\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\", \"NFR-7\"]\n  },\n\n  \"sharedSchemas\": {\n    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^\\\\d+\\\\.\\\\d{2}$\", \"description\": \"Output form. Input form is number | string.\" },\n    \"QuizStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"PUBLISHED\", \"CLOSED\"] },\n    \"QuestionType\": { \"type\": \"string\", \"enum\": [\"SINGLE_CHOICE\", \"MULTIPLE_CHOICE\", \"TRUE_FALSE\", \"SHORT_ANSWER\", \"ESSAY\"] },\n    \"ResultsVisibility\": { \"type\": \"string\", \"enum\": [\"IMMEDIATELY\", \"AFTER_CLOSE\", \"MANUAL\"] },\n    \"AttemptStatus\": { \"type\": \"string\", \"enum\": [\"IN_PROGRESS\", \"SUBMITTED\", \"NEEDS_GRADING\", \"GRADED\"] },\n    \"ScoringPolicy\": { \"type\": \"string\", \"enum\": [\"HIGHEST\", \"LATEST\", \"AVERAGE\"] },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"name\": \"string\" } },\n    \"Option\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"text\": \"string (non-empty)\" } },\n    \"Correct\": {\n      \"description\": \"Keyed by Question.type (FR-2). Manager-only, except as described in conventions.studentPrivacy.\",\n      \"oneOf\": {\n        \"SINGLE_CHOICE\": { \"optionId\": \"string (must be one of options[].id)\" },\n        \"MULTIPLE_CHOICE\": { \"optionIds\": \"string[] (≥ 1, each in options[].id)\" },\n        \"TRUE_FALSE\": { \"value\": \"boolean\" },\n        \"SHORT_ANSWER\": { \"accepted\": \"string[] (1–10, non-empty)\" },\n        \"ESSAY\": { \"guidance\": \"string?\" }\n      }\n    },\n    \"AnswerResponse\": {\n      \"description\": \"answerResponseSchema. A type-agnostic union, so the autosave path doesn't load the Question (NFR-2). A shape that doesn't match the question's type grades as 0 / incorrect at submit.\",\n      \"oneOf\": [\n        { \"optionId\": \"string\" },\n        { \"optionIds\": \"string[]\" },\n        { \"value\": \"boolean\" },\n        { \"text\": \"string (≤ 10,000 chars)\" }\n      ]\n    },\n    \"QuizSettingsInput\": {\n      \"description\": \"quizSettingsSchema (FR-2, FR-6). Cross-field rules run in superRefine: availableUntil > availableFrom, and timeLimitMinutes ≤ the window length in minutes. On PATCH, both rules are checked against the stored values merged with the patch.\",\n      \"properties\": {\n        \"title\": \"string (trimmed, non-empty)\",\n        \"instructions\": \"string (Markdown, default \\\"\\\")\",\n        \"isPractice\": \"boolean (default false)\",\n        \"availableFrom\": \"ISO datetime\",\n        \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int 1–300 | null (null = untimed)\",\n        \"maxAttempts\": \"int 1–10 (default 1)\",\n        \"scoringPolicy\": \"ScoringPolicy (default HIGHEST)\",\n        \"shuffleQuestions\": \"boolean (default false)\",\n        \"shuffleOptions\": \"boolean (default false)\",\n        \"oneQuestionPerPage\": \"boolean (default false)\",\n        \"resultsVisibility\": \"ResultsVisibility (default AFTER_CLOSE)\",\n        \"showCorrectAnswers\": \"boolean (default true)\"\n      }\n    },\n    \"QuestionInput\": {\n      \"description\": \"questionSchema, a z.discriminatedUnion on type (FR-2, FR-7). points 0.5–100 in steps of 0.5. options has 2–8 entries for SINGLE_CHOICE/MULTIPLE_CHOICE and is absent for the other types. prompt is non-empty Markdown and may embed a file uploaded with context 'quiz' (FR-39).\",\n      \"properties\": {\n        \"type\": \"QuestionType\",\n        \"prompt\": \"string (Markdown)\",\n        \"points\": \"number | string\",\n        \"options\": \"Option[] | undefined\",\n        \"correct\": \"Correct (shape keyed by type)\",\n        \"explanation\": \"string | null\",\n        \"caseSensitive\": \"boolean (SHORT_ANSWER only, default false)\"\n      }\n    },\n    \"ManagerQuestion\": {\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\",\n        \"order\": \"int\", \"options\": \"Option[] | null\", \"correct\": \"Correct\", \"explanation\": \"string | null\", \"caseSensitive\": \"boolean\"\n      }\n    },\n    \"ManagerQuiz\": {\n      \"description\": \"Full quiz, including answers. Returned only to managers (assertCanManageCourse).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\",\n        \"...\": \"every QuizSettingsInput field, resolved\",\n        \"status\": \"QuizStatus\",\n        \"resultsReleasedAt\": \"ISO datetime | null\",\n        \"createdById\": \"string\", \"createdAt\": \"ISO datetime\", \"updatedAt\": \"ISO datetime\",\n        \"questions\": \"ManagerQuestion[] (sorted by order)\",\n        \"totalPoints\": \"Decimal (Σ points, FR-8)\",\n        \"attemptCount\": \"int\",\n        \"locked\": \"boolean (attemptCount > 0, edit lock FR-10)\",\n        \"publishProblems\": \"string[] (canPublish(questions); empty means publishable, FR-9)\"\n      }\n    },\n    \"StudentQuiz\": {\n      \"description\": \"toStudentQuiz. Allow-listed, with no questions and no `correct` (NFR-1). Drives the start screen (FR-12).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\", \"title\": \"string\", \"instructions\": \"string\", \"isPractice\": \"boolean\",\n        \"status\": \"QuizStatus (DRAFT is never returned to a non-manager; that case is NOT_FOUND)\",\n        \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int | null\", \"oneQuestionPerPage\": \"boolean\", \"resultsVisibility\": \"ResultsVisibility\",\n        \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n        \"extraTimeMinutes\": \"int (caller's accommodation, 0 if none; 0 for parents)\",\n        \"attemptLimit\": \"int (attemptLimit(maxAttempts, extraAttempts), FR-23)\",\n        \"attemptsUsed\": \"int (caller's own attempts; 0 for parents)\",\n        \"inProgressAttemptId\": \"string | null (Resume target, FR-19)\",\n        \"isOpen\": \"boolean (PUBLISHED && availableFrom ≤ now < availableUntil)\"\n      }\n    },\n    \"StudentQuestion\": {\n      \"description\": \"A question as shown in the player. It never contains correct, explanation or caseSensitive.\",\n      \"properties\": { \"id\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\", \"options\": \"Option[] | null (in seededShuffle(options, attempt.id) order when shuffleOptions, FR-13)\" }\n    },\n    \"StudentAttempt\": {\n      \"description\": \"toStudentAttempt. Returned while status = IN_PROGRESS (FR-13, FR-14, FR-19).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\", \"status\": \"\\\"IN_PROGRESS\\\"\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime (always set: untimed attempts use availableUntil)\",\n        \"serverNow\": \"ISO datetime (lets the display-only timer correct for client clock skew, ADR-4)\",\n        \"oneQuestionPerPage\": \"boolean\",\n        \"questions\": \"StudentQuestion[] (in the frozen questionOrder)\",\n        \"answers\": \"{ questionId: string, response: AnswerResponse | null, savedAt: ISO datetime }[] (no grading fields)\"\n      }\n    },\n    \"StudentResult\": {\n      \"description\": \"toStudentResult. Returned for a submitted attempt to its owner or a linked parent (FR-20, FR-21). When resultsVisible = false, every score field is null and questions is null; the UI shows 'Submitted — results will be available later.'\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\",\n        \"status\": \"\\\"SUBMITTED\\\" | \\\"NEEDS_GRADING\\\" | \\\"GRADED\\\"\",\n        \"startedAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime\", \"autoSubmitted\": \"boolean\",\n        \"resultsVisible\": \"boolean\",\n        \"awaitingGrading\": \"boolean (status ≠ GRADED)\",\n        \"score\": \"Decimal | null (only when resultsVisible && status = GRADED)\",\n        \"maxScore\": \"Decimal\",\n        \"percent\": \"number | null (same condition as score)\",\n        \"questions\": \"null | { id, type, prompt, points: Decimal, options: Option[] | null, response: AnswerResponse | null, pendingReview: boolean (needsReview, A8), pointsAwarded: Decimal | null (null when pendingReview), isCorrect: boolean | null, feedback: string | null, correct?: Correct (only if showCorrectAnswers), explanation?: string | null (only if showCorrectAnswers) }[] (in questionOrder)\"\n      }\n    },\n    \"ManagerAnswer\": {\n      \"properties\": {\n        \"questionId\": \"string\", \"response\": \"AnswerResponse | null\", \"pointsAwarded\": \"Decimal | null\", \"isCorrect\": \"boolean | null\",\n        \"feedback\": \"string | null\", \"gradedById\": \"string | null\", \"needsReview\": \"boolean (derived, A8)\", \"updatedAt\": \"ISO datetime\"\n      }\n    },\n    \"ManagerAttempt\": {\n      \"description\": \"The full attempt for a course manager (FR-24).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"student\": \"UserRef\", \"attemptNumber\": \"int\", \"status\": \"AttemptStatus\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime | null\", \"autoSubmitted\": \"boolean\",\n        \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\",\n        \"questionOrder\": \"string[]\",\n        \"questions\": \"ManagerQuestion[] (in questionOrder)\",\n        \"answers\": \"ManagerAnswer[]\"\n      }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Role-shaped, paginated course Quizzes tab list (FR-11). Access: assertCanViewCourse. Managers see every status. Students and parents see only PUBLISHED and CLOSED quizzes. Sorted by availableFrom desc. Runs ensureNotExpired on the caller's own IN_PROGRESS attempts before computing groups.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId (cuid)\" },\n        \"query\": { \"page\": \"int?\", \"pageSize\": \"int? ≤ 100\" }\n      },\n      \"responseSchema\": {\n        \"envelope\": \"paginated\",\n        \"item\": {\n          \"oneOf\": {\n            \"manager\": {\n              \"role\": \"\\\"MANAGER\\\"\",\n              \"id\": \"string\", \"title\": \"string\", \"status\": \"QuizStatus\", \"isPractice\": \"boolean\",\n              \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\", \"timeLimitMinutes\": \"int | null\",\n              \"resultsVisibility\": \"ResultsVisibility\", \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n              \"attemptCount\": \"int\", \"averagePercent\": \"number | null (submitted+graded attempts)\", \"needsGradingCount\": \"int (attempts with status NEEDS_GRADING)\"\n            },\n            \"student\": {\n              \"role\": \"\\\"STUDENT\\\"\",\n              \"quiz\": \"StudentQuiz\",\n              \"group\": \"\\\"UPCOMING\\\" | \\\"AVAILABLE\\\" | \\\"COMPLETED\\\" | \\\"MISSED\\\". UPCOMING = now < availableFrom. AVAILABLE = isOpen && (attemptsUsed < attemptLimit || inProgressAttemptId). COMPLETED = ≥ 1 submitted attempt and not AVAILABLE. MISSED = now ≥ availableUntil with 0 attempts (A2).\",\n              \"latestResult\": \"{ attemptId: string, status: AttemptStatus, score: Decimal | null, maxScore: Decimal, percent: number | null } | null (scores null unless resultsVisible)\"\n            },\n            \"parent\": {\n              \"role\": \"\\\"PARENT\\\"\",\n              \"student\": \"UserRef (linked child enrolled in the course; one row per child × quiz)\",\n              \"quiz\": \"StudentQuiz\",\n              \"results\": \"{ attemptId: string, attemptNumber: int, submittedAt: ISO datetime, score: Decimal | null, maxScore: Decimal, percent: number | null }[] (only attempts where resultsVisible, read-only)\"\n            }\n          }\n        }\n      },\n      \"errors\": [\"NOT_FOUND (course not visible)\"],\n      \"requirementIds\": [\"FR-11\", \"FR-31\", \"FR-33\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Creates a DRAFT quiz. The /quizzes/new page sends defaults and then redirects to /edit (FR-6). createdById = caller. Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId\" },\n        \"body\": \"QuizSettingsInput with title, availableFrom and availableUntil required; every other field optional (FR-1 defaults)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (cannot manage course)\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-31\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Manager: ManagerQuiz, the full quiz including correct answers. STUDENT (ACTIVE enrollee) or PARENT (linked to an enrollee): toStudentQuiz, with no questions and never `correct`. A DRAFT quiz is NOT_FOUND for non-managers.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"ManagerQuiz\", \"StudentQuiz\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-31\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Updates settings and/or the status transition. Allowed transitions are DRAFT→PUBLISHED and PUBLISHED→CLOSED only (A9); any other change is CONFLICT. Publishing runs canPublish: if there are problems it returns VALIDATION_ERROR with details {problems: string[]} (FR-9). Otherwise it does a conditional updateMany where status = DRAFT, and only if that updated a row is notify('quiz.published') sent, after commit, to ACTIVE enrollees (FR-29). resultsReleasedAt cannot be set here; use release-results.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\" },\n        \"body\": \"Partial<QuizSettingsInput> & { status?: \\\"PUBLISHED\\\" | \\\"CLOSED\\\" } (at least one key)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\" },\n      \"errors\": [\"VALIDATION_ERROR (schema, cross-field rule, or publish problems)\", \"CONFLICT (invalid status transition)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-9\", \"FR-29\", \"FR-31\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Deletes the quiz (questions and accommodations cascade). Allowed only while no attempt exists.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (quiz has attempts)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions\",\n      \"description\": \"Adds a question at order = max + 1. The builder's Duplicate action is this call with a copied body (FR-7). Edit lock: CONFLICT when the quiz has attempts (FR-10). Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"QuestionInput\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions/reorder\",\n      \"description\": \"Rewrites Question.order to match the given list, in one transaction. The list must be exactly the quiz's question ids (a permutation), otherwise VALIDATION_ERROR. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": { \"questionIds\": \"string[]\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion[] (new order)\" },\n      \"errors\": [\"VALIDATION_ERROR (not a permutation)\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Edits a question. Without attempts, any QuestionInput field can change; the result is re-validated as a whole against the type's schema. With attempts (edit lock, FR-10), only prompt and explanation can change, plus correct.accepted and caseSensitive for SHORT_ANSWER. Any other key gives CONFLICT with the message 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.' Editing never triggers a regrade (A3).\",\n      \"auth\": \"manage course (of the question's quiz)\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" }, \"body\": \"Partial<QuestionInput>\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Deletes a question and closes the gap in order. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/regrade\",\n      \"description\": \"In one transaction: re-runs gradeAnswer on every answer with gradedById = null across submitted attempts (manual grades always win, A8), runs recomputeAttempt on each attempt, then writes audit('quiz.regrade').\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"attemptCount\": \"int\", \"changedAnswerCount\": \"int\" } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-10\", \"FR-25\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/release-results\",\n      \"description\": \"MANUAL visibility only. Runs updateMany({id, resultsVisibility: MANUAL, resultsReleasedAt: null} → now). If that updated a row, it calls notifyStudentAndParents('quiz.results_released') for every student with a submitted attempt, then audit('quiz.release_results'). A repeat call is a no-op that returns the existing timestamp. A non-MANUAL quiz is CONFLICT.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"resultsReleasedAt\": \"ISO datetime\", \"notified\": \"boolean (false on repeat)\" } },\n      \"errors\": [\"CONFLICT (resultsVisibility ≠ MANUAL)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-20\", \"FR-30\", \"FR-38\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id/analytics\",\n      \"description\": \"Quiz analytics computed in memory over submitted attempts (FR-26, FR-27). With ?format=csv it returns text/csv (Content-Disposition: attachment; filename=\\\"quiz-<id>-attempts.csv\\\"), built with toCsv. CSV columns: student, attemptNumber, score, then one points column per question in quiz order.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"query\": { \"format\": \"\\\"json\\\" | \\\"csv\\\" (default json)\" } },\n      \"responseSchema\": {\n        \"envelope\": \"data (json) | raw text/csv\",\n        \"data\": {\n          \"summary\": { \"attempts\": \"int\", \"average\": \"Decimal | null\", \"median\": \"Decimal | null\", \"highest\": \"Decimal | null\", \"lowest\": \"Decimal | null\", \"averageTimeSeconds\": \"int | null\" },\n          \"histogram\": \"{ bucket: \\\"0–10\\\" | … | \\\"90–100\\\", count: int }[10] (by percent; 100% goes in the last bucket)\",\n          \"questions\": \"{ questionId, order: int, type: QuestionType, prompt, points: Decimal, percentCorrect: number | null, averagePoints: Decimal | null, optionDistribution: { optionId, text, count: int, isCorrect: boolean }[] | null (choice types only), mostChosenWrongOptionId: string | null }[]\"\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR (bad format)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-26\", \"FR-27\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/quizzes/:id/accommodations/:studentId\",\n      \"description\": \"Upserts the QuizAccommodation for one ACTIVE enrollee, then writes audit('quiz.accommodation'). It applies only to attempts started afterwards, because deadlineAt is frozen at start (A7). Sending {0, 0} keeps the row; that is equivalent to no accommodation.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\", \"studentId\": \"userId (must be ACTIVE enrolled in the course)\" },\n        \"body\": { \"extraTimeMinutes\": \"int 0–300\", \"extraAttempts\": \"int 0–5\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"quizId\": \"string\", \"studentId\": \"string\", \"extraTimeMinutes\": \"int\", \"extraAttempts\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (quiz or student not in course)\"],\n      \"requirementIds\": [\"FR-28\", \"FR-2\", \"FR-23\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/attempts\",\n      \"description\": \"STUDENT start or resume (system-design §4.2). Requires the quiz to be PUBLISHED with availableFrom ≤ now < availableUntil, else CONFLICT. An existing IN_PROGRESS attempt goes through ensureNotExpired and is returned with 200 (resume, FR-19). Otherwise, attempt count ≥ attemptLimit is CONFLICT (FR-23). Otherwise the attempt is created with id pre-generated, questionOrder frozen (seededShuffle by id when shuffleQuestions) and deadlineAt = computeDeadline(...), and returned with 201. A P2002 race on the partial unique index re-reads and returns the IN_PROGRESS attempt with 200.\",\n      \"auth\": \"role STUDENT + view course (ACTIVE enrollee)\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentAttempt\", \"status\": \"201 created | 200 resumed\" },\n      \"errors\": [\"CONFLICT (quiz not open | attempt limit reached)\", \"NOT_FOUND (quiz not visible)\", \"FORBIDDEN is not used; a non-STUDENT gets NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-19\", \"FR-23\", \"FR-28\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attempts/:id\",\n      \"description\": \"Calls ensureNotExpired first (FR-18), then assertCanAccessAttempt (FR-34). Owner: StudentAttempt while IN_PROGRESS, otherwise StudentResult. Linked PARENT: StudentResult, and only if the attempt is submitted and resultsVisible, else NOT_FOUND. Course manager: ManagerAttempt. Any other caller gets NOT_FOUND.\",\n      \"auth\": \"owner | linked parent (read-only) | course manager\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"StudentAttempt\", \"StudentResult\", \"ManagerAttempt\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-24\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId\",\n      \"description\": \"Autosave hot path (system-design §4.3, NFR-2): one attempt read, no Quiz or Question load, then one QuizAnswer upsert on the (attemptId, questionId) PK. Checks: studentId ≠ caller → NOT_FOUND; questionId ∉ questionOrder → NOT_FOUND; status ≠ IN_PROGRESS → CONFLICT; now > deadlineAt + 30 s → submitAttempt(id, {auto: true}) then CONFLICT 'Time is up' (FR-16). Idempotent, so localStorage replays are safe (FR-15). response: null clears the answer.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId\" },\n        \"body\": { \"response\": \"AnswerResponse | null\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"questionId\": \"string\", \"savedAt\": \"ISO datetime\" }, \"note\": \"Carries no grading data (NFR-1). On 409 the client stops its queue, clears localStorage['quiz-attempt:<id>'] and routes to the result page.\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (not in progress | past deadline + grace)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-32\", \"NFR-2\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/attempts/:id/submit\",\n      \"description\": \"Runs submitAttempt(id, {auto: false}) (system-design §4.4). The IN_PROGRESS → SUBMITTED claim is atomic; missing answers are created as null, every answer is auto-graded, then recomputeAttempt sets status NEEDS_GRADING or GRADED (FR-17). An already-submitted attempt returns its current state with 200 (idempotent, no error). A submit after the deadline still succeeds as a manual submit; nothing is lost because the answers were already saved.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentResult\" },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-17\", \"FR-25\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId/grade\",\n      \"description\": \"Manual grade or override (FR-24). The attempt must be submitted (not IN_PROGRESS), else CONFLICT. pointsAwarded must be ≤ question.points and a multiple of 0.5, else VALIDATION_ERROR. Sets pointsAwarded, isCorrect = (pointsAwarded == question.points), feedback and gradedById = caller, upserting the answer row if it is missing. Then recomputeAttempt (FR-25), and audit('quizAnswer.grade') after commit. No notification is sent (FR-30). The body field is named pointsAwarded per the PRD API table (system-design §3.2 calls it `points`; manualGradeSchema should use pointsAwarded).\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId (must be in questionOrder)\" },\n        \"body\": { \"pointsAwarded\": \"number | string, ≥ 0, step 0.5\", \"feedback\": \"string | null (optional)\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"answer\": \"ManagerAnswer\", \"attempt\": { \"id\": \"string\", \"status\": \"AttemptStatus\", \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (attempt in progress)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-4\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING cron route. The request/response contract is unchanged: Bearer CRON_SECRET in, ok(dispatchEmails result) out. Changed behaviour only: after sendDueReminders(now), it also runs autoSubmitExpiredAttempts(now) (IN_PROGRESS with deadlineAt < now − 30 s, ≤ 200 per call) and sendAfterCloseResultsReleased(now) (atomic resultsReleasedAt claim, A6). Each runs in its own try/catch with logger.error, on every request, and both are idempotent.\",\n      \"auth\": \"cron secret\",\n      \"requestSchema\": { \"headers\": { \"authorization\": \"Bearer <CRON_SECRET>\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"unchanged dispatchEmails() result\" },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-18\", \"FR-30\", \"FR-35\"]\n    }\n  ],\n\n  \"reusedUnchanged\": [\n    \"POST /api/files and GET /api/files/:id serve question-prompt images with the new 'quiz' file context and resolver (manager, or course viewer once the quiz is PUBLISHED). The route contracts don't change (FR-39, system-design §3.5).\"\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":426,"newStart":1,"newLines":424,"lines":[" {","-  \"ticketId\": \"SH-9\",","-  \"timestamp\": \"2026-11-09T10:55:00Z\",","+  \"ticketId\": \"SH-10\",","+  \"timestamp\": \"2026-11-09T13:00:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\",","+","   \"conventions\": {","-    \"basePath\": \"/api (existing project convention, no /api/v1 prefix)\",","-    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/assignments.ts) → assertCanViewCourse/assertCanManageCourse/assertCanViewStudent → src/server/assignments/assignments-service.ts → ok()/paginated(). All helpers come from src/server/http.ts (system-design §2.4, §2.7).\",","+    \"basePath\": \"/api. This is the existing project convention; there is no /api/v1 prefix (system-design §3.3).\",","+    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/quiz.ts) → one call into src/server/quiz/*-service.ts → ok()/paginated(). All of these come from src/server/http.ts. Handlers contain no logic (NFR-6, NFR-7).\",","     \"successEnvelope\": { \"data\": \"<responseSchema>\" },","-    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"total\": \"int\" } },","+    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int ≥ 1, default 1\", \"pageSize\": \"int 1–100, default 20 (parsePagination)\", \"total\": \"int\" } },","     \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },","-    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },","-    \"validationErrorDetails\": \"A ZodError maps to VALIDATION_ERROR with details = zod flatten() { formErrors, fieldErrors }. Service-raised rule failures (rubric sum, deadline, content type, file ownership) are VALIDATION_ERROR with a human message (system-design D13).\",","-    \"decimals\": \"maxPoints, latePenaltyPercentPerDay, maxLatePenaltyPercent, rawScore, penaltyPercent, finalScore and rubric points are serialized as strings with 2 decimals (e.g. \\\"14.40\\\"). On input they are accepted as number or string (D5, NFR-1).\",","-    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client 'now' (NFR-2). Display uses formatInSchoolTz (NFR-9).\",","-    \"ids\": \"All ids are cuid strings.\",","-    \"privacy\": \"Every submission object returned to a student or parent passes through toStudentSubmission: grade fields (rawScore, penaltyPercent, finalScore, feedback, rubricScores, gradedById, gradedAt) are null until status = RETURNED, and history is never included (FR-27, NFR-4).\",","-    \"visibility\": \"For non-managers, an assignment that is DRAFT, SCHEDULED-but-not-yet-available, or archived is NOT_FOUND, not FORBIDDEN (FR-13, FR-52).\",","-    \"requirementIds\": [\"FR-48\", \"FR-49\", \"FR-50\", \"FR-51\", \"FR-53\", \"FR-54\", \"FR-55\", \"FR-56\", \"FR-57\", \"FR-58\", \"NFR-1\", \"NFR-2\", \"NFR-4\", \"NFR-5\", \"NFR-7\"]","+    \"errorCodes\": {","+      \"VALIDATION_ERROR\": \"400. Zod failure (details = zod flatten()) or a service rule failure such as canPublish problems, points > question points, or step ≠ 0.5.\",","+      \"UNAUTHENTICATED\": \"401. No session, or a bad cron secret on the internal route.\",","+      \"NOT_FOUND\": \"404. The resource is missing OR the caller cannot access it. Existence is never revealed, so FORBIDDEN is not used for quiz resources (NFR-5).\",","+      \"CONFLICT\": \"409. Answer write after deadlineAt + 30 s, a closed or not-yet-open quiz, attempt limit reached, edit lock (quiz has attempts), delete with attempts, an invalid status transition, or a write to a non-IN_PROGRESS attempt.\",","+      \"INTERNAL\": \"500. Logged with logger.error and never detailed to the client.\"","+    },","+    \"createdStatus\": \"POST endpoints that create a resource return 201 via ok(x, {status: 201}). Every other success returns 200.\",","+    \"decimals\": \"points, score, maxScore, pointsAwarded, totalPoints and the analytics averages are serialized as strings with 2 decimals by fixed2 from @/server/assignments/grading-math (e.g. \\\"2.00\\\"). Input decimals accept number | string. Percentages are numbers rounded to 1 decimal.\",","+    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client time (ADR-4). The UI displays times in SchoolSettings.timezone (NFR-6).\",","+    \"ids\": \"cuid strings. Option ids inside Question.options are short cuids generated by the builder and stay stable across edits.\",","+    \"studentPrivacy\": \"Every quiz, attempt or result returned to a STUDENT or PARENT is built only by the allow-listing serializers in src/server/quiz/serializers.ts (toStudentQuiz, toStudentAttempt, toStudentResult). `correct` and `explanation` appear only inside StudentResult.questions[] and only when resultsVisible && showCorrectAnswers. Scores appear only when resultsVisible. Student-path Prisma selects never load `correct` or `explanation` (NFR-1, ADR-5).\",","+    \"lazyAutoSubmit\": \"GET /api/attempts/:id, POST /api/quizzes/:id/attempts, the course list and the teacher grade/list loads call ensureNotExpired first. So an IN_PROGRESS attempt past deadlineAt is always returned already submitted (FR-18).\",","+    \"noEndpointBy design\": [","+      \"getStudentQuizScore(quizId, studentId) → {score, maxScore, percent, isPractice, attemptsCounted} | null is a TypeScript export of attempt-service.ts for PRD-11. It has no HTTP route (FR-22, FR-33, system-design §4.7).\",","+      \"The grading workspace, the analytics page and the builder's accommodations table are server pages. They call the services directly, after requirePageRole and assertCanManageCourse. Only their writes go through the routes below (system-design §3.4).\",","+      \"Preview mode (FR-8) calls no attempt endpoint (A10).\"","+    ],","+    \"requirementIds\": [\"FR-31\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\", \"NFR-7\"]","   },","+","   \"sharedSchemas\": {","-    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^-?\\\\d+(\\\\.\\\\d{1,2})?$\", \"description\": \"Output form. Input form is number | string.\" },","-    \"SubmissionType\": { \"type\": \"string\", \"enum\": [\"ONLINE_TEXT\", \"FILE_UPLOAD\", \"TEXT_AND_FILE\", \"NO_SUBMISSION\"] },","-    \"AssignmentStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\"] },","-    \"SubmissionStatus\": { \"type\": \"string\", \"enum\": [\"SUBMITTED\", \"RETURNED\"] },","-    \"ChipStatus\": { \"type\": \"string\", \"enum\": [\"NOT_SUBMITTED\", \"SUBMITTED\", \"LATE\", \"GRADED\", \"RETURNED\", \"EXEMPT\"], \"description\": \"grading-math.submissionChipStatus (FR-28).\" },","-    \"FileRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"filename\": { \"type\": \"string\" }, \"mimeType\": { \"type\": \"string\" }, \"size\": { \"type\": \"integer\" } } },","-    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },","-    \"RubricLevel\": {","-      \"type\": \"object\",","-      \"required\": [\"label\", \"points\"],","-      \"properties\": { \"label\": { \"type\": \"string\", \"maxLength\": 100 }, \"points\": { \"$ref\": \"#/sharedSchemas/Decimal\" }, \"description\": { \"type\": \"string\", \"maxLength\": 1000 } }","+    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^\\\\d+\\\\.\\\\d{2}$\", \"description\": \"Output form. Input form is number | string.\" },","+    \"QuizStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"PUBLISHED\", \"CLOSED\"] },","+    \"QuestionType\": { \"type\": \"string\", \"enum\": [\"SINGLE_CHOICE\", \"MULTIPLE_CHOICE\", \"TRUE_FALSE\", \"SHORT_ANSWER\", \"ESSAY\"] },","+    \"ResultsVisibility\": { \"type\": \"string\", \"enum\": [\"IMMEDIATELY\", \"AFTER_CLOSE\", \"MANUAL\"] },","+    \"AttemptStatus\": { \"type\": \"string\", \"enum\": [\"IN_PROGRESS\", \"SUBMITTED\", \"NEEDS_GRADING\", \"GRADED\"] },","+    \"ScoringPolicy\": { \"type\": \"string\", \"enum\": [\"HIGHEST\", \"LATEST\", \"AVERAGE\"] },","+    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"name\": \"string\" } },","+    \"Option\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"text\": \"string (non-empty)\" } },","+    \"Correct\": {","+      \"description\": \"Keyed by Question.type (FR-2). Manager-only, except as described in conventions.studentPrivacy.\",","+      \"oneOf\": {","+        \"SINGLE_CHOICE\": { \"optionId\": \"string (must be one of options[].id)\" },","+        \"MULTIPLE_CHOICE\": { \"optionIds\": \"string[] (≥ 1, each in options[].id)\" },","+        \"TRUE_FALSE\": { \"value\": \"boolean\" },","+        \"SHORT_ANSWER\": { \"accepted\": \"string[] (1–10, non-empty)\" },","+        \"ESSAY\": { \"guidance\": \"string?\" }","+      }","     },","-    \"RubricCriterionInput\": {","-      \"type\": \"object\",","-      \"required\": [\"title\", \"maxPoints\", \"levels\"],","+    \"AnswerResponse\": {","+      \"description\": \"answerResponseSchema. A type-agnostic union, so the autosave path doesn't load the Question (NFR-2). A shape that doesn't match the question's type grades as 0 / incorrect at submit.\",","+      \"oneOf\": [","+        { \"optionId\": \"string\" },","+        { \"optionIds\": \"string[]\" },","+        { \"value\": \"boolean\" },","+        { \"text\": \"string (≤ 10,000 chars)\" }","+      ]","+    },","+    \"QuizSettingsInput\": {","+      \"description\": \"quizSettingsSchema (FR-2, FR-6). Cross-field rules run in superRefine: availableUntil > availableFrom, and timeLimitMinutes ≤ the window length in minutes. On PATCH, both rules are checked against the stored values merged with the patch.\",","       \"properties\": {","-        \"id\": { \"type\": \"string\", \"description\": \"Present on PATCH to keep an existing criterion; omitted for new ones.\" },","-        \"title\": { \"type\": \"string\", \"maxLength\": 150 },","-        \"description\": { \"type\": \"string\", \"maxLength\": 1000 },","-        \"maxPoints\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"levels\": { \"type\": \"array\", \"minItems\": 1, \"items\": { \"$ref\": \"#/sharedSchemas/RubricLevel\" } }","-      },","-      \"description\": \"Array order = criterion order.\"","+        \"title\": \"string (trimmed, non-empty)\",","+        \"instructions\": \"string (Markdown, default \\\"\\\")\",","+        \"isPractice\": \"boolean (default false)\",","+        \"availableFrom\": \"ISO datetime\",","+        \"availableUntil\": \"ISO datetime\",","+        \"timeLimitMinutes\": \"int 1–300 | null (null = untimed)\",","+        \"maxAttempts\": \"int 1–10 (default 1)\",","+        \"scoringPolicy\": \"ScoringPolicy (default HIGHEST)\",","+        \"shuffleQuestions\": \"boolean (default false)\",","+        \"shuffleOptions\": \"boolean (default false)\",","+        \"oneQuestionPerPage\": \"boolean (default false)\",","+        \"resultsVisibility\": \"ResultsVisibility (default AFTER_CLOSE)\",","+        \"showCorrectAnswers\": \"boolean (default true)\"","+      }","     },","-    \"RubricCriterion\": {","-      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/RubricCriterionInput\" }],","-      \"properties\": { \"id\": { \"type\": \"string\" }, \"order\": { \"type\": \"integer\" } }","-    },","-    \"AssignmentInput\": {","-      \"description\": \"Zod assignmentInput (FR-7). superRefine: lateCutoffAt > dueAt; if rubric given, Σ criterion.maxPoints = maxPoints. Service: status SCHEDULED requires availableFrom > server now (FR-12).\",","-      \"type\": \"object\",","-      \"required\": [\"title\", \"submissionType\", \"maxPoints\", \"dueAt\", \"status\"],","+    \"QuestionInput\": {","+      \"description\": \"questionSchema, a z.discriminatedUnion on type (FR-2, FR-7). points 0.5–100 in steps of 0.5. options has 2–8 entries for SINGLE_CHOICE/MULTIPLE_CHOICE and is absent for the other types. prompt is non-empty Markdown and may embed a file uploaded with context 'quiz' (FR-39).\",","       \"properties\": {","-        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150 },","-        \"instructions\": { \"type\": \"string\", \"maxLength\": 50000, \"description\": \"Markdown.\" },","-        \"submissionType\": { \"$ref\": \"#/sharedSchemas/SubmissionType\" },","-        \"maxPoints\": { \"description\": \"0–1000\", \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"dueAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-        \"availableFrom\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","-        \"allowLate\": { \"type\": \"boolean\", \"default\": false },","-        \"lateCutoffAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","-        \"latePenaltyPercentPerDay\": { \"description\": \"0–100\", \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"maxLatePenaltyPercent\": { \"description\": \"0–100\", \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"maxFileCount\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 10, \"default\": 3 },","-        \"allowExtraCredit\": { \"type\": \"boolean\", \"default\": false },","-        \"status\": { \"$ref\": \"#/sharedSchemas/AssignmentStatus\" },","-        \"rubric\": { \"type\": \"array\", \"nullable\": true, \"items\": { \"$ref\": \"#/sharedSchemas/RubricCriterionInput\" }, \"description\": \"null/omitted = no rubric. On PATCH, null removes the rubric.\" },","-        \"attachmentFileIds\": { \"type\": \"array\", \"maxItems\": 10, \"items\": { \"type\": \"string\" }, \"description\": \"Uploads from POST /api/files {context:'assignment'} owned by the caller. On PATCH this is the full new set; removed ids are detached.\" }","+        \"type\": \"QuestionType\",","+        \"prompt\": \"string (Markdown)\",","+        \"points\": \"number | string\",","+        \"options\": \"Option[] | undefined\",","+        \"correct\": \"Correct (shape keyed by type)\",","+        \"explanation\": \"string | null\",","+        \"caseSensitive\": \"boolean (SHORT_ANSWER only, default false)\"","       }","     },","-    \"Assignment\": {","-      \"type\": \"object\",","+    \"ManagerQuestion\": {","       \"properties\": {","-        \"id\": { \"type\": \"string\" },","-        \"courseId\": { \"type\": \"string\" },","-        \"courseName\": { \"type\": \"string\" },","-        \"title\": { \"type\": \"string\" },","-        \"instructions\": { \"type\": \"string\" },","-        \"submissionType\": { \"$ref\": \"#/sharedSchemas/SubmissionType\" },","-        \"maxPoints\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"dueAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-        \"availableFrom\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","-        \"allowLate\": { \"type\": \"boolean\" },","-        \"lateCutoffAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","-        \"latePenaltyPercentPerDay\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"maxLatePenaltyPercent\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"maxFileCount\": { \"type\": \"integer\" },","-        \"allowExtraCredit\": { \"type\": \"boolean\" },","-        \"status\": { \"$ref\": \"#/sharedSchemas/AssignmentStatus\" },","-        \"archivedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true, \"description\": \"Managers only; always null for students/parents (archived is NOT_FOUND for them).\" },","-        \"rubric\": { \"type\": \"array\", \"nullable\": true, \"items\": { \"$ref\": \"#/sharedSchemas/RubricCriterion\" } },","-        \"attachments\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/FileRef\" } },","-        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }","+        \"id\": \"string\", \"quizId\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\",","+        \"order\": \"int\", \"options\": \"Option[] | null\", \"correct\": \"Correct\", \"explanation\": \"string | null\", \"caseSensitive\": \"boolean\"","       }","     },","-    \"AssignmentSummary\": {","-      \"description\": \"List row: Assignment minus instructions, rubric and attachments, plus hasRubric.\",","-      \"type\": \"object\",","+    \"ManagerQuiz\": {","+      \"description\": \"Full quiz, including answers. Returned only to managers (assertCanManageCourse).\",","       \"properties\": {","-        \"id\": { \"type\": \"string\" }, \"courseId\": { \"type\": \"string\" }, \"courseName\": { \"type\": \"string\" }, \"title\": { \"type\": \"string\" },","-        \"submissionType\": { \"$ref\": \"#/sharedSchemas/SubmissionType\" }, \"maxPoints\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"dueAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"availableFrom\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","-        \"status\": { \"$ref\": \"#/sharedSchemas/AssignmentStatus\" }, \"archivedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","-        \"hasRubric\": { \"type\": \"boolean\" }","+        \"id\": \"string\", \"courseId\": \"string\",","+        \"...\": \"every QuizSettingsInput field, resolved\",","+        \"status\": \"QuizStatus\",","+        \"resultsReleasedAt\": \"ISO datetime | null\",","+        \"createdById\": \"string\", \"createdAt\": \"ISO datetime\", \"updatedAt\": \"ISO datetime\",","+        \"questions\": \"ManagerQuestion[] (sorted by order)\",","+        \"totalPoints\": \"Decimal (Σ points, FR-8)\",","+        \"attemptCount\": \"int\",","+        \"locked\": \"boolean (attemptCount > 0, edit lock FR-10)\",","+        \"publishProblems\": \"string[] (canPublish(questions); empty means publishable, FR-9)\"","       }","     },","-    \"ManagerCounts\": {","-      \"type\": \"object\",","+    \"StudentQuiz\": {","+      \"description\": \"toStudentQuiz. Allow-listed, with no questions and no `correct` (NFR-1). Drives the start screen (FR-12).\",","       \"properties\": {","-        \"enrolled\": { \"type\": \"integer\", \"description\": \"ACTIVE enrollments\" },","-        \"submitted\": { \"type\": \"integer\" },","-        \"graded\": { \"type\": \"integer\" },","-        \"returned\": { \"type\": \"integer\" },","-        \"exempt\": { \"type\": \"integer\" },","-        \"missing\": { \"type\": \"integer\", \"description\": \"missingWhere: visible, past due, not NO_SUBMISSION, no submission, not exempt (FR-35, FR-60)\" }","+        \"id\": \"string\", \"courseId\": \"string\", \"title\": \"string\", \"instructions\": \"string\", \"isPractice\": \"boolean\",","+        \"status\": \"QuizStatus (DRAFT is never returned to a non-manager; that case is NOT_FOUND)\",","+        \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\",","+        \"timeLimitMinutes\": \"int | null\", \"oneQuestionPerPage\": \"boolean\", \"resultsVisibility\": \"ResultsVisibility\",","+        \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",","+        \"extraTimeMinutes\": \"int (caller's accommodation, 0 if none; 0 for parents)\",","+        \"attemptLimit\": \"int (attemptLimit(maxAttempts, extraAttempts), FR-23)\",","+        \"attemptsUsed\": \"int (caller's own attempts; 0 for parents)\",","+        \"inProgressAttemptId\": \"string | null (Resume target, FR-19)\",","+        \"isOpen\": \"boolean (PUBLISHED && availableFrom ≤ now < availableUntil)\"","       }","     },","-    \"Submission\": {","-      \"description\": \"Full (manager) shape. Student/parent responses get the same shape through toStudentSubmission: grade fields null until RETURNED, history omitted.\",","-      \"type\": \"object\",","+    \"StudentQuestion\": {","+      \"description\": \"A question as shown in the player. It never contains correct, explanation or caseSensitive.\",","+      \"properties\": { \"id\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\", \"options\": \"Option[] | null (in seededShuffle(options, attempt.id) order when shuffleOptions, FR-13)\" }","+    },","+    \"StudentAttempt\": {","+      \"description\": \"toStudentAttempt. Returned while status = IN_PROGRESS (FR-13, FR-14, FR-19).\",","       \"properties\": {","-        \"id\": { \"type\": \"string\" },","-        \"assignmentId\": { \"type\": \"string\" },","-        \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" },","-        \"status\": { \"$ref\": \"#/sharedSchemas/SubmissionStatus\" },","-        \"attemptNumber\": { \"type\": \"integer\", \"description\": \"0 = offline grade (FR-8)\" },","-        \"text\": { \"type\": \"string\", \"nullable\": true },","-        \"files\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/FileRef\" } },","-        \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-        \"isLate\": { \"type\": \"boolean\" },","-        \"lateDays\": { \"type\": \"integer\" },","-        \"rawScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true },","-        \"penaltyPercent\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true },","-        \"finalScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true },","-        \"rubricScores\": { \"type\": \"array\", \"nullable\": true, \"items\": { \"$ref\": \"#/sharedSchemas/RubricScore\" } },","-        \"feedback\": { \"type\": \"string\", \"nullable\": true, \"description\": \"Markdown\" },","-        \"gradedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },","-        \"gradedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","-        \"returnedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","-        \"history\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SubmissionAttempt\" }, \"description\": \"Managers only (FR-55). Oldest first.\" }","+        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\", \"status\": \"\\\"IN_PROGRESS\\\"\",","+        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime (always set: untimed attempts use availableUntil)\",","+        \"serverNow\": \"ISO datetime (lets the display-only timer correct for client clock skew, ADR-4)\",","+        \"oneQuestionPerPage\": \"boolean\",","+        \"questions\": \"StudentQuestion[] (in the frozen questionOrder)\",","+        \"answers\": \"{ questionId: string, response: AnswerResponse | null, savedAt: ISO datetime }[] (no grading fields)\"","       }","     },","-    \"SubmissionAttempt\": {","-      \"type\": \"object\",","+    \"StudentResult\": {","+      \"description\": \"toStudentResult. Returned for a submitted attempt to its owner or a linked parent (FR-20, FR-21). When resultsVisible = false, every score field is null and questions is null; the UI shows 'Submitted — results will be available later.'\",","       \"properties\": {","-        \"attemptNumber\": { \"type\": \"integer\" },","-        \"text\": { \"type\": \"string\", \"nullable\": true },","-        \"files\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/FileRef\" } },","-        \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }","+        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\",","+        \"status\": \"\\\"SUBMITTED\\\" | \\\"NEEDS_GRADING\\\" | \\\"GRADED\\\"\",","+        \"startedAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime\", \"autoSubmitted\": \"boolean\",","+        \"resultsVisible\": \"boolean\",","+        \"awaitingGrading\": \"boolean (status ≠ GRADED)\",","+        \"score\": \"Decimal | null (only when resultsVisible && status = GRADED)\",","+        \"maxScore\": \"Decimal\",","+        \"percent\": \"number | null (same condition as score)\",","+        \"questions\": \"null | { id, type, prompt, points: Decimal, options: Option[] | null, response: AnswerResponse | null, pendingReview: boolean (needsReview, A8), pointsAwarded: Decimal | null (null when pendingReview), isCorrect: boolean | null, feedback: string | null, correct?: Correct (only if showCorrectAnswers), explanation?: string | null (only if showCorrectAnswers) }[] (in questionOrder)\"","       }","     },","-    \"RubricScore\": {","-      \"type\": \"object\",","-      \"required\": [\"criterionId\", \"points\"],","-      \"properties\": { \"criterionId\": { \"type\": \"string\" }, \"points\": { \"$ref\": \"#/sharedSchemas/Decimal\" }, \"comment\": { \"type\": \"string\", \"maxLength\": 2000 } }","-    },","-    \"GradeInput\": {","-      \"description\": \"Zod gradeInput. With a rubric: rubricScores required, each criterion exactly once, 0 ≤ points ≤ criterion.maxPoints, server sets rawScore = Σ points and ignores any client rawScore (D7). Without a rubric: rawScore required, 0 ≤ rawScore ≤ maxPoints (×1.2 if allowExtraCredit) (FR-36). finalScore is always computed server-side (FR-31).\",","-      \"type\": \"object\",","-      \"required\": [\"penaltyPercent\"],","+    \"ManagerAnswer\": {","       \"properties\": {","-        \"rawScore\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"penaltyPercent\": { \"description\": \"0–100; UI prefills grading-math.defaultPenalty\", \"$ref\": \"#/sharedSchemas/Decimal\" },","-        \"feedback\": { \"type\": \"string\", \"maxLength\": 10000 },","-        \"rubricScores\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RubricScore\" } },","-        \"return\": { \"type\": \"boolean\", \"default\": false, \"description\": \"'Save & return' in one transaction (D6).\" }","+        \"questionId\": \"string\", \"response\": \"AnswerResponse | null\", \"pointsAwarded\": \"Decimal | null\", \"isCorrect\": \"boolean | null\",","+        \"feedback\": \"string | null\", \"gradedById\": \"string | null\", \"needsReview\": \"boolean (derived, A8)\", \"updatedAt\": \"ISO datetime\"","       }","     },","-    \"StudentAssignmentRow\": {","-      \"description\": \"Row for student/parent lists. submission is the toStudentSubmission shape without history or text/files (summary only).\",","-      \"type\": \"object\",","+    \"ManagerAttempt\": {","+      \"description\": \"The full attempt for a course manager (FR-24).\",","       \"properties\": {","-        \"assignment\": { \"$ref\": \"#/sharedSchemas/AssignmentSummary\" },","-        \"group\": { \"type\": \"string\", \"enum\": [\"UPCOMING\", \"MISSING\", \"SUBMITTED\", \"RETURNED\", \"CLOSED\"], \"description\": \"Server-computed, first match wins: RETURNED (submission RETURNED) → SUBMITTED (submission exists) → UPCOMING (dueAt > now) → MISSING (missingWhere) → CLOSED (past due but exempt or NO_SUBMISSION; UI lists it under 'Past due' with no missing badge). FR-18 'Past due (missing)' = MISSING.\" },","-        \"exempt\": { \"type\": \"boolean\" },","-        \"submission\": {","-          \"type\": \"object\", \"nullable\": true,","-          \"properties\": {","-            \"id\": { \"type\": \"string\" }, \"status\": { \"$ref\": \"#/sharedSchemas/SubmissionStatus\" }, \"attemptNumber\": { \"type\": \"integer\" },","-            \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"isLate\": { \"type\": \"boolean\" },","-            \"finalScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true }, \"returnedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true }","-          }","-        }","+        \"id\": \"string\", \"quizId\": \"string\", \"student\": \"UserRef\", \"attemptNumber\": \"int\", \"status\": \"AttemptStatus\",","+        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime | null\", \"autoSubmitted\": \"boolean\",","+        \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\",","+        \"questionOrder\": \"string[]\",","+        \"questions\": \"ManagerQuestion[] (in questionOrder)\",","+        \"answers\": \"ManagerAnswer[]\"","       }","     }","   },","+","   \"endpoints\": [","     {","       \"method\": \"GET\",","-      \"path\": \"/api/courses/{courseId}/assignments\",","-      \"description\": \"Role-shaped list for the course Assignments tab. Auth: requireUser + assertCanViewCourse. Managers (canSeeDrafts) get every status incl. archived, with counts (one groupBy). Students/parents get only visibleWhere(now) assignments with their own submission state; parents pass studentId (resolveViewedStudent; defaults to the only linked child). Read path fires publishOnce for newly visible SCHEDULED rows (fire-and-forget, FR-42). Sorted by dueAt asc.\",","-      \"query\": { \"studentId\": { \"type\": \"string\", \"description\": \"PARENT only; must be a linked child\" } },","-      \"requestSchema\": {},","+      \"path\": \"/api/courses/:id/quizzes\",","+      \"description\": \"Role-shaped, paginated course Quizzes tab list (FR-11). Access: assertCanViewCourse. Managers see every status. Students and parents see only PUBLISHED and CLOSED quizzes. Sorted by availableFrom desc. Runs ensureNotExpired on the caller's own IN_PROGRESS attempts before computing groups.\",","+      \"auth\": \"view course\",","+      \"requestSchema\": {","+        \"params\": { \"id\": \"courseId (cuid)\" },","+        \"query\": { \"page\": \"int?\", \"pageSize\": \"int? ≤ 100\" }","+      },","       \"responseSchema\": {","-        \"description\": \"{ data: ... }\",","-        \"oneOf\": [","-          { \"title\": \"manager\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"manager\" }, \"items\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/AssignmentSummary\" }], \"properties\": { \"counts\": { \"$ref\": \"#/sharedSchemas/ManagerCounts\" } } } } } },","-          { \"title\": \"student/parent\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"student\" }, \"studentId\": { \"type\": \"string\" }, \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentAssignmentRow\" } } } }","-        ]","+        \"envelope\": \"paginated\",","+        \"item\": {","+          \"oneOf\": {","+            \"manager\": {","+              \"role\": \"\\\"MANAGER\\\"\",","+              \"id\": \"string\", \"title\": \"string\", \"status\": \"QuizStatus\", \"isPractice\": \"boolean\",","+              \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\", \"timeLimitMinutes\": \"int | null\",","+              \"resultsVisibility\": \"ResultsVisibility\", \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",","+              \"attemptCount\": \"int\", \"averagePercent\": \"number | null (submitted+graded attempts)\", \"needsGradingCount\": \"int (attempts with status NEEDS_GRADING)\"","+            },","+            \"student\": {","+              \"role\": \"\\\"STUDENT\\\"\",","+              \"quiz\": \"StudentQuiz\",","+              \"group\": \"\\\"UPCOMING\\\" | \\\"AVAILABLE\\\" | \\\"COMPLETED\\\" | \\\"MISSED\\\". UPCOMING = now < availableFrom. AVAILABLE = isOpen && (attemptsUsed < attemptLimit || inProgressAttemptId). COMPLETED = ≥ 1 submitted attempt and not AVAILABLE. MISSED = now ≥ availableUntil with 0 attempts (A2).\",","+              \"latestResult\": \"{ attemptId: string, status: AttemptStatus, score: Decimal | null, maxScore: Decimal, percent: number | null } | null (scores null unless resultsVisible)\"","+            },","+            \"parent\": {","+              \"role\": \"\\\"PARENT\\\"\",","+              \"student\": \"UserRef (linked child enrolled in the course; one row per child × quiz)\",","+              \"quiz\": \"StudentQuiz\",","+              \"results\": \"{ attemptId: string, attemptNumber: int, submittedAt: ISO datetime, score: Decimal | null, maxScore: Decimal, percent: number | null }[] (only attempts where resultsVisible, read-only)\"","+            }","+          }","+        }","       },","-      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN (not in course / studentId not linked)\", \"NOT_FOUND (course)\"],","-      \"requirementIds\": [\"FR-48\", \"FR-17\", \"FR-18\", \"FR-13\", \"FR-42\", \"FR-52\", \"NFR-4\"]","+      \"errors\": [\"NOT_FOUND (course not visible)\"],","+      \"requirementIds\": [\"FR-11\", \"FR-31\", \"FR-33\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/courses/{courseId}/assignments\",","-      \"description\": \"Create an assignment with optional rubric and attachments in one transaction. Auth: assertCanManageCourse. After commit, if visible now → publishOnce (assignment.published to ACTIVE-enrolled students). Audit assignment.create.\",","-      \"requestSchema\": { \"$ref\": \"#/sharedSchemas/AssignmentInput\" },","-      \"responseSchema\": { \"description\": \"201 { data: Assignment }\", \"$ref\": \"#/sharedSchemas/Assignment\" },","-      \"errors\": [\"VALIDATION_ERROR (Zod; 'Rubric totals {sum} points but the assignment is worth {maxPoints}.'; SCHEDULED with availableFrom ≤ now; attachment not owned/wrong context)\", \"FORBIDDEN\", \"NOT_FOUND (course)\"],","-      \"requirementIds\": [\"FR-49\", \"FR-7\", \"FR-9\", \"FR-11\", \"FR-12\", \"FR-42\", \"FR-59\"]","+      \"path\": \"/api/courses/:id/quizzes\",","+      \"description\": \"Creates a DRAFT quiz. The /quizzes/new page sends defaults and then redirects to /edit (FR-6). createdById = caller. Returns 201.\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": {","+        \"params\": { \"id\": \"courseId\" },","+        \"body\": \"QuizSettingsInput with title, availableFrom and availableUntil required; every other field optional (FR-1 defaults)\"","+      },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\", \"status\": 201 },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (cannot manage course)\"],","+      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-31\", \"FR-34\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/assignments/{assignmentId}\",","-      \"description\": \"Assignment detail. Auth: requireUser + assertCanViewCourse. Non-managers get NOT_FOUND unless isAssignmentVisible. Students/parents also get their own submission (toStudentSubmission) and exemption flag. serverNow lets the client offset its countdown (display only, FR-19).\",","-      \"query\": { \"studentId\": { \"type\": \"string\", \"description\": \"PARENT only; must be a linked child\" } },","-      \"requestSchema\": {},","-      \"responseSchema\": {","-        \"type\": \"object\",","-        \"properties\": {","-          \"assignment\": { \"$ref\": \"#/sharedSchemas/Assignment\" },","-          \"canManage\": { \"type\": \"boolean\" },","-          \"submission\": { \"$ref\": \"#/sharedSchemas/Submission\", \"nullable\": true, \"description\": \"Student/parent only; serializer applied. Absent for managers.\" },","-          \"exempt\": { \"type\": \"boolean\", \"description\": \"Student/parent only\" },","-          \"submissionCount\": { \"type\": \"integer\", \"description\": \"Managers only; drives the FR-14 edit warning\" },","-          \"serverNow\": { \"type\": \"string\", \"format\": \"date-time\" }","-        }","-      },","-      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-50\", \"FR-19\", \"FR-26\", \"FR-27\", \"FR-13\", \"FR-52\", \"NFR-2\", \"NFR-4\"]","+      \"path\": \"/api/quizzes/:id\",","+      \"description\": \"Manager: ManagerQuiz, the full quiz including correct answers. STUDENT (ACTIVE enrollee) or PARENT (linked to an enrollee): toStudentQuiz, with no questions and never `correct`. A DRAFT quiz is NOT_FOUND for non-managers.\",","+      \"auth\": \"view course\",","+      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"ManagerQuiz\", \"StudentQuiz\"] } },","+      \"errors\": [\"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-12\", \"FR-31\", \"FR-34\", \"NFR-1\", \"NFR-5\"]","     },","     {","       \"method\": \"PATCH\",","-      \"path\": \"/api/assignments/{assignmentId}\",","-      \"description\": \"Update an assignment. Auth: assertCanManageCourse. Body is a partial AssignmentInput (same superRefine on the merged result). attachmentFileIds is the full new set (removed files detached). If it becomes visible and notifiedAt is null → publishOnce. Client shows the FR-14 'review grades' banner if maxPoints changed and submissionCount > 0. Audit assignment.update.\",","-      \"requestSchema\": { \"description\": \"Partial<AssignmentInput>\", \"$ref\": \"#/sharedSchemas/AssignmentInput\" },","-      \"responseSchema\": { \"$ref\": \"#/sharedSchemas/Assignment\" },","-      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-51\", \"FR-12\", \"FR-14\", \"FR-11\", \"FR-42\", \"FR-59\"]","+      \"path\": \"/api/quizzes/:id\",","+      \"description\": \"Updates settings and/or the status transition. Allowed transitions are DRAFT→PUBLISHED and PUBLISHED→CLOSED only (A9); any other change is CONFLICT. Publishing runs canPublish: if there are problems it returns VALIDATION_ERROR with details {problems: string[]} (FR-9). Otherwise it does a conditional updateMany where status = DRAFT, and only if that updated a row is notify('quiz.published') sent, after commit, to ACTIVE enrollees (FR-29). resultsReleasedAt cannot be set here; use release-results.\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": {","+        \"params\": { \"id\": \"quizId\" },","+        \"body\": \"Partial<QuizSettingsInput> & { status?: \\\"PUBLISHED\\\" | \\\"CLOSED\\\" } (at least one key)\"","+      },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\" },","+      \"errors\": [\"VALIDATION_ERROR (schema, cross-field rule, or publish problems)\", \"CONFLICT (invalid status transition)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-9\", \"FR-29\", \"FR-31\"]","     },","     {","       \"method\": \"DELETE\",","-      \"path\": \"/api/assignments/{assignmentId}\",","-      \"description\": \"Hard delete (with rubric, attachments detached) when there are 0 submissions; otherwise set archivedAt. Auth: assertCanManageCourse. Audit assignment.delete | assignment.archive.\",","-      \"requestSchema\": {},","-      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"result\": { \"type\": \"string\", \"enum\": [\"deleted\", \"archived\"] } } },","-      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-51\", \"FR-52\", \"FR-59\"]","+      \"path\": \"/api/quizzes/:id\",","+      \"description\": \"Deletes the quiz (questions and accommodations cascade). Allowed only while no attempt exists.\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },","+      \"errors\": [\"CONFLICT (quiz has attempts)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-31\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/assignments/{assignmentId}/duplicate\",","-      \"description\": \"Copy as DRAFT to each target course. Auth: manage source course and assertCanManageCourse for every target (all checked before any write). Rubric copied as new rows; attachments re-saved as new FileObjects (context 'assignment'); same dueAt, availableFrom/lateCutoffAt keep offsets; notifiedAt null. One transaction per target. Audit assignment.duplicate.\",","-      \"requestSchema\": { \"type\": \"object\", \"required\": [\"courseIds\"], \"properties\": { \"courseIds\": { \"type\": \"array\", \"minItems\": 1, \"items\": { \"type\": \"string\" } } } },","-      \"responseSchema\": { \"description\": \"201\", \"type\": \"object\", \"properties\": { \"created\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"courseId\": { \"type\": \"string\" }, \"assignmentId\": { \"type\": \"string\" } } } } } },","-      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN (any target not managed)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-15\", \"FR-59\"]","+      \"path\": \"/api/quizzes/:id/questions\",","+      \"description\": \"Adds a question at order = max + 1. The builder's Duplicate action is this call with a copied body (FR-7). Edit lock: CONFLICT when the quiz has attempts (FR-10). Returns 201.\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"QuestionInput\" },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\", \"status\": 201 },","+      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/assignments/{assignmentId}/submissions\",","-      \"description\": \"Grading roster: every ACTIVE-enrolled student, including those who have not submitted, with chip status, exemption and submission summary. Auth: assertCanManageCourse. Paginated (pageSize ≤ 100). Sort by name (default) or submittedAt; optional chip filter.\",","-      \"query\": {","-        \"page\": { \"type\": \"integer\", \"default\": 1 },","-        \"pageSize\": { \"type\": \"integer\", \"maximum\": 100, \"default\": 100 },","-        \"sort\": { \"type\": \"string\", \"enum\": [\"name\", \"submittedAt\"], \"default\": \"name\" },","-        \"status\": { \"$ref\": \"#/sharedSchemas/ChipStatus\" }","-      },","-      \"requestSchema\": {},","-      \"responseSchema\": {","-        \"description\": \"paginated envelope; data[] items:\",","-        \"type\": \"object\",","-        \"properties\": {","-          \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" },","-          \"chipStatus\": { \"$ref\": \"#/sharedSchemas/ChipStatus\" },","-          \"exempt\": { \"type\": \"boolean\" },","-          \"submission\": {","-            \"type\": \"object\", \"nullable\": true,","-            \"properties\": {","-              \"id\": { \"type\": \"string\" }, \"status\": { \"$ref\": \"#/sharedSchemas/SubmissionStatus\" }, \"attemptNumber\": { \"type\": \"integer\" },","-              \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"isLate\": { \"type\": \"boolean\" }, \"lateDays\": { \"type\": \"integer\" },","-              \"finalScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true }, \"gradedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","-              \"returnedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true }","-            }","-          }","-        }","-      },","-      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-54\", \"FR-28\", \"FR-35\"]","+      \"method\": \"POST\",","+      \"path\": \"/api/quizzes/:id/questions/reorder\",","+      \"description\": \"Rewrites Question.order to match the given list, in one transaction. The list must be exactly the quiz's question ids (a permutation), otherwise VALIDATION_ERROR. Blocked by the edit lock.\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": { \"questionIds\": \"string[]\" } },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion[] (new order)\" },","+      \"errors\": [\"VALIDATION_ERROR (not a permutation)\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]","     },","     {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/questions/:id\",","+      \"description\": \"Edits a question. Without attempts, any QuestionInput field can change; the result is re-validated as a whole against the type's schema. With attempts (edit lock, FR-10), only prompt and explanation can change, plus correct.accepted and caseSensitive for SHORT_ANSWER. Any other key gives CONFLICT with the message 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.' Editing never triggers a regrade (A3).\",","+      \"auth\": \"manage course (of the question's quiz)\",","+      \"requestSchema\": { \"params\": { \"id\": \"questionId\" }, \"body\": \"Partial<QuestionInput>\" },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]","+    },","+    {","+      \"method\": \"DELETE\",","+      \"path\": \"/api/questions/:id\",","+      \"description\": \"Deletes a question and closes the gap in order. Blocked by the edit lock.\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": { \"params\": { \"id\": \"questionId\" } },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },","+      \"errors\": [\"CONFLICT (edit lock)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]","+    },","+    {","       \"method\": \"POST\",","-      \"path\": \"/api/assignments/{assignmentId}/submissions\",","-      \"description\": \"Submit or resubmit. Auth: requireRole STUDENT. Server-clock checks in order (first failure wins): visible → ACTIVE-enrolled → not exempt and type ≠ NO_SUBMISSION → deadline/late cutoff → content matches type and fileIds ≤ maxFileCount → each file owned by caller, context 'submission', unattached or already on this submission. Resubmit (status SUBMITTED, incl. attempt-0 offline row) snapshots SubmissionHistory, increments attemptNumber, clears grade fields. Returns 201 on first submit, 200 on resubmit.\",","-      \"requestSchema\": {","-        \"type\": \"object\",","-        \"properties\": {","-          \"text\": { \"type\": \"string\", \"maxLength\": 50000 },","-          \"fileIds\": { \"type\": \"array\", \"maxItems\": 10, \"items\": { \"type\": \"string\" }, \"default\": [] }","-        }","-      },","-      \"responseSchema\": { \"description\": \"Receipt: toStudentSubmission shape (grade fields null).\", \"$ref\": \"#/sharedSchemas/Submission\" },","-      \"errors\": [","-        \"NOT_FOUND (assignment not visible)\",","-        \"FORBIDDEN (not STUDENT / not ACTIVE-enrolled)\",","-        \"VALIDATION_ERROR (exempt; NO_SUBMISSION; 'The deadline has passed and late submissions are closed.'; missing text/files for type; too many files; file not yours / wrong context)\",","-        \"CONFLICT ('This submission has been returned and can no longer be changed.')\"","-      ],","-      \"requirementIds\": [\"FR-53\", \"FR-22\", \"FR-23\", \"FR-24\", \"FR-35\", \"FR-60\", \"FR-7\", \"NFR-2\", \"FR-59\"]","+      \"path\": \"/api/quizzes/:id/regrade\",","+      \"description\": \"In one transaction: re-runs gradeAnswer on every answer with gradedById = null across submitted attempts (manual grades always win, A8), runs recomputeAttempt on each attempt, then writes audit('quiz.regrade').\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"attemptCount\": \"int\", \"changedAnswerCount\": \"int\" } },","+      \"errors\": [\"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-10\", \"FR-25\", \"FR-38\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/assignments/{assignmentId}/return\",","-      \"description\": \"Bulk 'Return all graded'. Auth: assertCanManageCourse. Default set = gradedAt != null AND status SUBMITTED. Supplied ids that are ungraded/already returned/not in this assignment are skipped and reported. One updateMany, then notifyStudentAndParents(assignment.returned) per student and one audit row per submission.\",","-      \"requestSchema\": { \"type\": \"object\", \"properties\": { \"submissionIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } } },","+      \"path\": \"/api/quizzes/:id/release-results\",","+      \"description\": \"MANUAL visibility only. Runs updateMany({id, resultsVisibility: MANUAL, resultsReleasedAt: null} → now). If that updated a row, it calls notifyStudentAndParents('quiz.results_released') for every student with a submitted attempt, then audit('quiz.release_results'). A repeat call is a no-op that returns the existing timestamp. A non-MANUAL quiz is CONFLICT.\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"resultsReleasedAt\": \"ISO datetime\", \"notified\": \"boolean (false on repeat)\" } },","+      \"errors\": [\"CONFLICT (resultsVisibility ≠ MANUAL)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-20\", \"FR-30\", \"FR-38\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/quizzes/:id/analytics\",","+      \"description\": \"Quiz analytics computed in memory over submitted attempts (FR-26, FR-27). With ?format=csv it returns text/csv (Content-Disposition: attachment; filename=\\\"quiz-<id>-attempts.csv\\\"), built with toCsv. CSV columns: student, attemptNumber, score, then one points column per question in quiz order.\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"query\": { \"format\": \"\\\"json\\\" | \\\"csv\\\" (default json)\" } },","       \"responseSchema\": {","-        \"type\": \"object\",","-        \"properties\": {","-          \"returned\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },","-          \"skipped\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"submissionId\": { \"type\": \"string\" }, \"reason\": { \"type\": \"string\", \"enum\": [\"NOT_GRADED\", \"ALREADY_RETURNED\", \"NOT_FOUND\"] } } } }","+        \"envelope\": \"data (json) | raw text/csv\",","+        \"data\": {","+          \"summary\": { \"attempts\": \"int\", \"average\": \"Decimal | null\", \"median\": \"Decimal | null\", \"highest\": \"Decimal | null\", \"lowest\": \"Decimal | null\", \"averageTimeSeconds\": \"int | null\" },","+          \"histogram\": \"{ bucket: \\\"0–10\\\" | … | \\\"90–100\\\", count: int }[10] (by percent; 100% goes in the last bucket)\",","+          \"questions\": \"{ questionId, order: int, type: QuestionType, prompt, points: Decimal, percentCorrect: number | null, averagePoints: Decimal | null, optionDistribution: { optionId, text, count: int, isCorrect: boolean }[] | null (choice types only), mostChosenWrongOptionId: string | null }[]\"","         }","       },","-      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-32\", \"FR-44\", \"FR-59\"]","+      \"errors\": [\"VALIDATION_ERROR (bad format)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-26\", \"FR-27\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/assignments/{assignmentId}/grade-offline\",","-      \"description\": \"'Grade without submission'. Auth: assertCanManageCourse. Student must be ACTIVE-enrolled with no existing submission. Creates the attemptNumber 0 Submission (text null, no files, submittedAt = gradedAt, penalty 0) using the same rubric/raw-score validation as PUT /grade. return:true also returns it. Audit submission.grade_offline.\",","+      \"method\": \"PUT\",","+      \"path\": \"/api/quizzes/:id/accommodations/:studentId\",","+      \"description\": \"Upserts the QuizAccommodation for one ACTIVE enrollee, then writes audit('quiz.accommodation'). It applies only to attempts started afterwards, because deadlineAt is frozen at start (A7). Sending {0, 0} keeps the row; that is equivalent to no accommodation.\",","+      \"auth\": \"manage course\",","       \"requestSchema\": {","-        \"type\": \"object\",","-        \"required\": [\"studentId\"],","-        \"properties\": {","-          \"studentId\": { \"type\": \"string\" },","-          \"rawScore\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","-          \"feedback\": { \"type\": \"string\", \"maxLength\": 10000 },","-          \"rubricScores\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RubricScore\" } },","-          \"return\": { \"type\": \"boolean\", \"default\": false }","-        }","+        \"params\": { \"id\": \"quizId\", \"studentId\": \"userId (must be ACTIVE enrolled in the course)\" },","+        \"body\": { \"extraTimeMinutes\": \"int 0–300\", \"extraAttempts\": \"int 0–5\" }","       },","-      \"responseSchema\": { \"description\": \"201\", \"$ref\": \"#/sharedSchemas/Submission\" },","-      \"errors\": [\"VALIDATION_ERROR (score out of range / rubric incomplete / student not enrolled)\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT (submission already exists — grade that one)\"],","-      \"requirementIds\": [\"FR-34\", \"FR-8\", \"FR-36\", \"FR-59\"]","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"quizId\": \"string\", \"studentId\": \"string\", \"extraTimeMinutes\": \"int\", \"extraAttempts\": \"int\" } },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (quiz or student not in course)\"],","+      \"requirementIds\": [\"FR-28\", \"FR-2\", \"FR-23\", \"FR-38\"]","     },","     {","-      \"method\": \"PUT\",","-      \"path\": \"/api/assignments/{assignmentId}/exemptions/{studentId}\",","-      \"description\": \"Exempt a student (idempotent upsert of GradeExemption). Auth: assertCanManageCourse; student must be enrolled. Effects: removed from missing, no reminders, cannot submit; row is the PRD-11 exclusion flag. Audit assignment.exempt.\",","-      \"requestSchema\": { \"type\": \"object\", \"properties\": { \"reason\": { \"type\": \"string\", \"maxLength\": 500 } } },","-      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"assignmentId\": { \"type\": \"string\" }, \"studentId\": { \"type\": \"string\" }, \"exempt\": { \"const\": true }, \"reason\": { \"type\": \"string\", \"nullable\": true } } },","-      \"errors\": [\"VALIDATION_ERROR (student not enrolled)\", \"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-35\", \"FR-5\", \"FR-59\"]","+      \"method\": \"POST\",","+      \"path\": \"/api/quizzes/:id/attempts\",","+      \"description\": \"STUDENT start or resume (system-design §4.2). Requires the quiz to be PUBLISHED with availableFrom ≤ now < availableUntil, else CONFLICT. An existing IN_PROGRESS attempt goes through ensureNotExpired and is returned with 200 (resume, FR-19). Otherwise, attempt count ≥ attemptLimit is CONFLICT (FR-23). Otherwise the attempt is created with id pre-generated, questionOrder frozen (seededShuffle by id when shuffleQuestions) and deadlineAt = computeDeadline(...), and returned with 201. A P2002 race on the partial unique index re-reads and returns the IN_PROGRESS attempt with 200.\",","+      \"auth\": \"role STUDENT + view course (ACTIVE enrollee)\",","+      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentAttempt\", \"status\": \"201 created | 200 resumed\" },","+      \"errors\": [\"CONFLICT (quiz not open | attempt limit reached)\", \"NOT_FOUND (quiz not visible)\", \"FORBIDDEN is not used; a non-STUDENT gets NOT_FOUND\"],","+      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-19\", \"FR-23\", \"FR-28\", \"FR-32\", \"NFR-1\"]","     },","     {","-      \"method\": \"DELETE\",","-      \"path\": \"/api/assignments/{assignmentId}/exemptions/{studentId}\",","-      \"description\": \"Remove an exemption (idempotent deleteMany). Auth: assertCanManageCourse. Audit assignment.unexempt.\",","-      \"requestSchema\": {},","-      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"assignmentId\": { \"type\": \"string\" }, \"studentId\": { \"type\": \"string\" }, \"exempt\": { \"const\": false } } },","-      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-35\", \"FR-59\"]","-    },","-    {","       \"method\": \"GET\",","-      \"path\": \"/api/submissions/{submissionId}\",","-      \"description\": \"Submission detail for the grading main panel and student/parent results. Auth: submitting student, linked parent, or course manager; anyone else NOT_FOUND. Managers get the full shape incl. history (with files); student/parent get toStudentSubmission. Grading page caches and prefetches next/prev (NFR-3).\",","-      \"requestSchema\": {},","-      \"responseSchema\": { \"$ref\": \"#/sharedSchemas/Submission\" },","-      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-55\", \"FR-29\", \"FR-26\", \"FR-27\", \"NFR-3\", \"NFR-4\"]","+      \"path\": \"/api/attempts/:id\",","+      \"description\": \"Calls ensureNotExpired first (FR-18), then assertCanAccessAttempt (FR-34). Owner: StudentAttempt while IN_PROGRESS, otherwise StudentResult. Linked PARENT: StudentResult, and only if the attempt is submitted and resultsVisible, else NOT_FOUND. Course manager: ManagerAttempt. Any other caller gets NOT_FOUND.\",","+      \"auth\": \"owner | linked parent (read-only) | course manager\",","+      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" } },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"StudentAttempt\", \"StudentResult\", \"ManagerAttempt\"] } },","+      \"errors\": [\"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-24\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\"]","     },","     {","       \"method\": \"PUT\",","-      \"path\": \"/api/submissions/{submissionId}/grade\",","-      \"description\": \"Save a grade (status stays SUBMITTED, invisible to student) or Save & return (return:true → RETURNED + returnedAt in the same transaction, then notifyStudentAndParents(assignment.returned, 'Course: Title — {final}/{max}')). Auth: assertCanManageCourse. Server computes rawScore (rubric) and finalScore = computeFinalScore(raw, penalty). Re-grading a RETURNED submission is allowed and keeps it RETURNED. Audit submission.grade (+ submission.return).\",","-      \"requestSchema\": { \"$ref\": \"#/sharedSchemas/GradeInput\" },","-      \"responseSchema\": { \"description\": \"Full manager shape\", \"$ref\": \"#/sharedSchemas/Submission\" },","-      \"errors\": [\"VALIDATION_ERROR (score/penalty range; rubric scores missing, duplicated or over criterion max)\", \"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-56\", \"FR-30\", \"FR-31\", \"FR-32\", \"FR-36\", \"FR-44\", \"FR-59\", \"NFR-1\"]","+      \"path\": \"/api/attempts/:id/answers/:questionId\",","+      \"description\": \"Autosave hot path (system-design §4.3, NFR-2): one attempt read, no Quiz or Question load, then one QuizAnswer upsert on the (attemptId, questionId) PK. Checks: studentId ≠ caller → NOT_FOUND; questionId ∉ questionOrder → NOT_FOUND; status ≠ IN_PROGRESS → CONFLICT; now > deadlineAt + 30 s → submitAttempt(id, {auto: true}) then CONFLICT 'Time is up' (FR-16). Idempotent, so localStorage replays are safe (FR-15). response: null clears the answer.\",","+      \"auth\": \"owner (STUDENT)\",","+      \"requestSchema\": {","+        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId\" },","+        \"body\": { \"response\": \"AnswerResponse | null\" }","+      },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"questionId\": \"string\", \"savedAt\": \"ISO datetime\" }, \"note\": \"Carries no grading data (NFR-1). On 409 the client stops its queue, clears localStorage['quiz-attempt:<id>'] and routes to the result page.\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (not in progress | past deadline + grace)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-32\", \"NFR-2\", \"NFR-1\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/me/assignments\",","-      \"description\": \"Data for /assignments. STUDENT: own rows across ACTIVE enrollments, filtered by tab (UPCOMING sorted by dueAt asc; MISSING = missingWhere; SUBMITTED; RETURNED) and courseId. PARENT: same, for studentId (linked child; defaults to the only child). TEACHER: 'To grade' = SUBMITTED, ungraded submissions in courses where teacherId or coTeacherIds includes them, oldest submittedAt first. ADMIN: 'To grade' across all courses. Fires publishOnce for newly visible SCHEDULED rows (student/parent).\",","-      \"query\": {","-        \"studentId\": { \"type\": \"string\", \"description\": \"PARENT only\" },","-        \"tab\": { \"type\": \"string\", \"enum\": [\"UPCOMING\", \"MISSING\", \"SUBMITTED\", \"RETURNED\"], \"default\": \"UPCOMING\", \"description\": \"STUDENT/PARENT only\" },","-        \"courseId\": { \"type\": \"string\" }","-      },","-      \"requestSchema\": {},","-      \"responseSchema\": {","-        \"oneOf\": [","-          { \"title\": \"student/parent\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"student\" }, \"studentId\": { \"type\": \"string\" }, \"children\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/UserRef\" }, \"description\": \"PARENT only, for the child selector\" }, \"courses\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } }, \"description\": \"for the course filter\" }, \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentAssignmentRow\" } } } },","-          { \"title\": \"to-grade (TEACHER/ADMIN)\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"toGrade\" }, \"items\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"submissionId\": { \"type\": \"string\" }, \"assignment\": { \"$ref\": \"#/sharedSchemas/AssignmentSummary\" }, \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" }, \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"isLate\": { \"type\": \"boolean\" } } } } } }","-        ]","-      },","-      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN (studentId not a linked child)\"],","-      \"requirementIds\": [\"FR-57\", \"FR-37\", \"FR-38\", \"FR-39\", \"FR-35\", \"FR-60\", \"FR-42\", \"NFR-4\"]","+      \"method\": \"POST\",","+      \"path\": \"/api/attempts/:id/submit\",","+      \"description\": \"Runs submitAttempt(id, {auto: false}) (system-design §4.4). The IN_PROGRESS → SUBMITTED claim is atomic; missing answers are created as null, every answer is auto-graded, then recomputeAttempt sets status NEEDS_GRADING or GRADED (FR-17). An already-submitted attempt returns its current state with 200 (idempotent, no error). A submit after the deadline still succeeds as a manual submit; nothing is lost because the answers were already saved.\",","+      \"auth\": \"owner (STUDENT)\",","+      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" }, \"body\": \"none\" },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentResult\" },","+      \"errors\": [\"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-17\", \"FR-25\", \"FR-32\", \"NFR-1\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/students/{studentId}/assignments\",","-      \"description\": \"Per-student assignment list across the student's ACTIVE enrollments (students/[id]/assignments page). Auth: assertCanViewStudent. Per course: viewers who manage that course get full grade fields; everyone else gets toStudentSubmission (D8). Only visible, non-archived assignments.\",","-      \"query\": { \"courseId\": { \"type\": \"string\" } },","-      \"requestSchema\": {},","-      \"responseSchema\": {","-        \"type\": \"object\",","-        \"properties\": {","-          \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" },","-          \"items\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentAssignmentRow\" }], \"properties\": { \"canManage\": { \"type\": \"boolean\" } } } }","-        }","+      \"method\": \"PUT\",","+      \"path\": \"/api/attempts/:id/answers/:questionId/grade\",","+      \"description\": \"Manual grade or override (FR-24). The attempt must be submitted (not IN_PROGRESS), else CONFLICT. pointsAwarded must be ≤ question.points and a multiple of 0.5, else VALIDATION_ERROR. Sets pointsAwarded, isCorrect = (pointsAwarded == question.points), feedback and gradedById = caller, upserting the answer row if it is missing. Then recomputeAttempt (FR-25), and audit('quizAnswer.grade') after commit. No notification is sent (FR-30). The body field is named pointsAwarded per the PRD API table (system-design §3.2 calls it `points`; manualGradeSchema should use pointsAwarded).\",","+      \"auth\": \"manage course\",","+      \"requestSchema\": {","+        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId (must be in questionOrder)\" },","+        \"body\": { \"pointsAwarded\": \"number | string, ≥ 0, step 0.5\", \"feedback\": \"string | null (optional)\" }","       },","-      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND (student)\"],","-      \"requirementIds\": [\"FR-58\", \"FR-41\", \"FR-27\", \"NFR-4\"]","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"answer\": \"ManagerAnswer\", \"attempt\": { \"id\": \"string\", \"status\": \"AttemptStatus\", \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\" } } },","+      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (attempt in progress)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-4\", \"FR-38\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/internal/email/dispatch\",","+      \"description\": \"EXISTING cron route. The request/response contract is unchanged: Bearer CRON_SECRET in, ok(dispatchEmails result) out. Changed behaviour only: after sendDueReminders(now), it also runs autoSubmitExpiredAttempts(now) (IN_PROGRESS with deadlineAt < now − 30 s, ≤ 200 per call) and sendAfterCloseResultsReleased(now) (atomic resultsReleasedAt claim, A6). Each runs in its own try/catch with logger.error, on every request, and both are idempotent.\",","+      \"auth\": \"cron secret\",","+      \"requestSchema\": { \"headers\": { \"authorization\": \"Bearer <CRON_SECRET>\" }, \"body\": \"none\" },","+      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"unchanged dispatchEmails() result\" },","+      \"errors\": [\"UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-18\", \"FR-30\", \"FR-35\"]","     }","   ],","-  \"reusedEndpoints\": [","-    { \"method\": \"POST\", \"path\": \"/api/files\", \"note\": \"Unchanged. Clients upload with context 'assignment' (authoring) or 'submission' (student) before referencing fileIds.\", \"requirementIds\": [\"FR-9\", \"FR-20\", \"FR-47\"] },","-    { \"method\": \"GET\", \"path\": \"/api/files/{id}?inline=1\", \"note\": \"Unchanged handler; new resolvers assignmentResolver/submissionResolver in src/server/files/contexts.ts. Header change D11 (X-Frame-Options SAMEORIGIN for this path only) enables PDF iframe preview.\", \"requirementIds\": [\"FR-29\", \"FR-47\", \"NFR-4\"] },","-    { \"method\": \"POST\", \"path\": \"/api/internal/email/dispatch\", \"note\": \"Unchanged contract; now also calls sendDueReminders(now) on every request (due_soon, missing).\", \"requirementIds\": [\"FR-43\", \"FR-45\", \"FR-6\"] }","+","+  \"reusedUnchanged\": [","+    \"POST /api/files and GET /api/files/:id serve question-prompt images with the new 'quiz' file context and resolver (manager, or course viewer once the quiz is PUBLISHED). The route contracts don't change (FR-39, system-design §3.5).\"","   ],","+","   \"status\": \"complete\""," }"]}],"originalFile":"{\n  \"ticketId\": \"SH-9\",\n  \"timestamp\": \"2026-11-09T10:55:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention, no /api/v1 prefix)\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/assignments.ts) → assertCanViewCourse/assertCanManageCourse/assertCanViewStudent → src/server/assignments/assignments-service.ts → ok()/paginated(). All helpers come from src/server/http.ts (system-design §2.4, §2.7).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },\n    \"validationErrorDetails\": \"A ZodError maps to VALIDATION_ERROR with details = zod flatten() { formErrors, fieldErrors }. Service-raised rule failures (rubric sum, deadline, content type, file ownership) are VALIDATION_ERROR with a human message (system-design D13).\",\n    \"decimals\": \"maxPoints, latePenaltyPercentPerDay, maxLatePenaltyPercent, rawScore, penaltyPercent, finalScore and rubric points are serialized as strings with 2 decimals (e.g. \\\"14.40\\\"). On input they are accepted as number or string (D5, NFR-1).\",\n    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client 'now' (NFR-2). Display uses formatInSchoolTz (NFR-9).\",\n    \"ids\": \"All ids are cuid strings.\",\n    \"privacy\": \"Every submission object returned to a student or parent passes through toStudentSubmission: grade fields (rawScore, penaltyPercent, finalScore, feedback, rubricScores, gradedById, gradedAt) are null until status = RETURNED, and history is never included (FR-27, NFR-4).\",\n    \"visibility\": \"For non-managers, an assignment that is DRAFT, SCHEDULED-but-not-yet-available, or archived is NOT_FOUND, not FORBIDDEN (FR-13, FR-52).\",\n    \"requirementIds\": [\"FR-48\", \"FR-49\", \"FR-50\", \"FR-51\", \"FR-53\", \"FR-54\", \"FR-55\", \"FR-56\", \"FR-57\", \"FR-58\", \"NFR-1\", \"NFR-2\", \"NFR-4\", \"NFR-5\", \"NFR-7\"]\n  },\n  \"sharedSchemas\": {\n    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^-?\\\\d+(\\\\.\\\\d{1,2})?$\", \"description\": \"Output form. Input form is number | string.\" },\n    \"SubmissionType\": { \"type\": \"string\", \"enum\": [\"ONLINE_TEXT\", \"FILE_UPLOAD\", \"TEXT_AND_FILE\", \"NO_SUBMISSION\"] },\n    \"AssignmentStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"SCHEDULED\", \"PUBLISHED\"] },\n    \"SubmissionStatus\": { \"type\": \"string\", \"enum\": [\"SUBMITTED\", \"RETURNED\"] },\n    \"ChipStatus\": { \"type\": \"string\", \"enum\": [\"NOT_SUBMITTED\", \"SUBMITTED\", \"LATE\", \"GRADED\", \"RETURNED\", \"EXEMPT\"], \"description\": \"grading-math.submissionChipStatus (FR-28).\" },\n    \"FileRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"filename\": { \"type\": \"string\" }, \"mimeType\": { \"type\": \"string\" }, \"size\": { \"type\": \"integer\" } } },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n    \"RubricLevel\": {\n      \"type\": \"object\",\n      \"required\": [\"label\", \"points\"],\n      \"properties\": { \"label\": { \"type\": \"string\", \"maxLength\": 100 }, \"points\": { \"$ref\": \"#/sharedSchemas/Decimal\" }, \"description\": { \"type\": \"string\", \"maxLength\": 1000 } }\n    },\n    \"RubricCriterionInput\": {\n      \"type\": \"object\",\n      \"required\": [\"title\", \"maxPoints\", \"levels\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\", \"description\": \"Present on PATCH to keep an existing criterion; omitted for new ones.\" },\n        \"title\": { \"type\": \"string\", \"maxLength\": 150 },\n        \"description\": { \"type\": \"string\", \"maxLength\": 1000 },\n        \"maxPoints\": { \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"levels\": { \"type\": \"array\", \"minItems\": 1, \"items\": { \"$ref\": \"#/sharedSchemas/RubricLevel\" } }\n      },\n      \"description\": \"Array order = criterion order.\"\n    },\n    \"RubricCriterion\": {\n      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/RubricCriterionInput\" }],\n      \"properties\": { \"id\": { \"type\": \"string\" }, \"order\": { \"type\": \"integer\" } }\n    },\n    \"AssignmentInput\": {\n      \"description\": \"Zod assignmentInput (FR-7). superRefine: lateCutoffAt > dueAt; if rubric given, Σ criterion.maxPoints = maxPoints. Service: status SCHEDULED requires availableFrom > server now (FR-12).\",\n      \"type\": \"object\",\n      \"required\": [\"title\", \"submissionType\", \"maxPoints\", \"dueAt\", \"status\"],\n      \"properties\": {\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 150 },\n        \"instructions\": { \"type\": \"string\", \"maxLength\": 50000, \"description\": \"Markdown.\" },\n        \"submissionType\": { \"$ref\": \"#/sharedSchemas/SubmissionType\" },\n        \"maxPoints\": { \"description\": \"0–1000\", \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"dueAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"availableFrom\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"allowLate\": { \"type\": \"boolean\", \"default\": false },\n        \"lateCutoffAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"latePenaltyPercentPerDay\": { \"description\": \"0–100\", \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"maxLatePenaltyPercent\": { \"description\": \"0–100\", \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"maxFileCount\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 10, \"default\": 3 },\n        \"allowExtraCredit\": { \"type\": \"boolean\", \"default\": false },\n        \"status\": { \"$ref\": \"#/sharedSchemas/AssignmentStatus\" },\n        \"rubric\": { \"type\": \"array\", \"nullable\": true, \"items\": { \"$ref\": \"#/sharedSchemas/RubricCriterionInput\" }, \"description\": \"null/omitted = no rubric. On PATCH, null removes the rubric.\" },\n        \"attachmentFileIds\": { \"type\": \"array\", \"maxItems\": 10, \"items\": { \"type\": \"string\" }, \"description\": \"Uploads from POST /api/files {context:'assignment'} owned by the caller. On PATCH this is the full new set; removed ids are detached.\" }\n      }\n    },\n    \"Assignment\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"courseId\": { \"type\": \"string\" },\n        \"courseName\": { \"type\": \"string\" },\n        \"title\": { \"type\": \"string\" },\n        \"instructions\": { \"type\": \"string\" },\n        \"submissionType\": { \"$ref\": \"#/sharedSchemas/SubmissionType\" },\n        \"maxPoints\": { \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"dueAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"availableFrom\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"allowLate\": { \"type\": \"boolean\" },\n        \"lateCutoffAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"latePenaltyPercentPerDay\": { \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"maxLatePenaltyPercent\": { \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"maxFileCount\": { \"type\": \"integer\" },\n        \"allowExtraCredit\": { \"type\": \"boolean\" },\n        \"status\": { \"$ref\": \"#/sharedSchemas/AssignmentStatus\" },\n        \"archivedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true, \"description\": \"Managers only; always null for students/parents (archived is NOT_FOUND for them).\" },\n        \"rubric\": { \"type\": \"array\", \"nullable\": true, \"items\": { \"$ref\": \"#/sharedSchemas/RubricCriterion\" } },\n        \"attachments\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/FileRef\" } },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      }\n    },\n    \"AssignmentSummary\": {\n      \"description\": \"List row: Assignment minus instructions, rubric and attachments, plus hasRubric.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" }, \"courseId\": { \"type\": \"string\" }, \"courseName\": { \"type\": \"string\" }, \"title\": { \"type\": \"string\" },\n        \"submissionType\": { \"$ref\": \"#/sharedSchemas/SubmissionType\" }, \"maxPoints\": { \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"dueAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"availableFrom\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"status\": { \"$ref\": \"#/sharedSchemas/AssignmentStatus\" }, \"archivedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"hasRubric\": { \"type\": \"boolean\" }\n      }\n    },\n    \"ManagerCounts\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"enrolled\": { \"type\": \"integer\", \"description\": \"ACTIVE enrollments\" },\n        \"submitted\": { \"type\": \"integer\" },\n        \"graded\": { \"type\": \"integer\" },\n        \"returned\": { \"type\": \"integer\" },\n        \"exempt\": { \"type\": \"integer\" },\n        \"missing\": { \"type\": \"integer\", \"description\": \"missingWhere: visible, past due, not NO_SUBMISSION, no submission, not exempt (FR-35, FR-60)\" }\n      }\n    },\n    \"Submission\": {\n      \"description\": \"Full (manager) shape. Student/parent responses get the same shape through toStudentSubmission: grade fields null until RETURNED, history omitted.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"assignmentId\": { \"type\": \"string\" },\n        \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" },\n        \"status\": { \"$ref\": \"#/sharedSchemas/SubmissionStatus\" },\n        \"attemptNumber\": { \"type\": \"integer\", \"description\": \"0 = offline grade (FR-8)\" },\n        \"text\": { \"type\": \"string\", \"nullable\": true },\n        \"files\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/FileRef\" } },\n        \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"isLate\": { \"type\": \"boolean\" },\n        \"lateDays\": { \"type\": \"integer\" },\n        \"rawScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true },\n        \"penaltyPercent\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true },\n        \"finalScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true },\n        \"rubricScores\": { \"type\": \"array\", \"nullable\": true, \"items\": { \"$ref\": \"#/sharedSchemas/RubricScore\" } },\n        \"feedback\": { \"type\": \"string\", \"nullable\": true, \"description\": \"Markdown\" },\n        \"gradedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"gradedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"returnedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"history\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SubmissionAttempt\" }, \"description\": \"Managers only (FR-55). Oldest first.\" }\n      }\n    },\n    \"SubmissionAttempt\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"attemptNumber\": { \"type\": \"integer\" },\n        \"text\": { \"type\": \"string\", \"nullable\": true },\n        \"files\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/FileRef\" } },\n        \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      }\n    },\n    \"RubricScore\": {\n      \"type\": \"object\",\n      \"required\": [\"criterionId\", \"points\"],\n      \"properties\": { \"criterionId\": { \"type\": \"string\" }, \"points\": { \"$ref\": \"#/sharedSchemas/Decimal\" }, \"comment\": { \"type\": \"string\", \"maxLength\": 2000 } }\n    },\n    \"GradeInput\": {\n      \"description\": \"Zod gradeInput. With a rubric: rubricScores required, each criterion exactly once, 0 ≤ points ≤ criterion.maxPoints, server sets rawScore = Σ points and ignores any client rawScore (D7). Without a rubric: rawScore required, 0 ≤ rawScore ≤ maxPoints (×1.2 if allowExtraCredit) (FR-36). finalScore is always computed server-side (FR-31).\",\n      \"type\": \"object\",\n      \"required\": [\"penaltyPercent\"],\n      \"properties\": {\n        \"rawScore\": { \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"penaltyPercent\": { \"description\": \"0–100; UI prefills grading-math.defaultPenalty\", \"$ref\": \"#/sharedSchemas/Decimal\" },\n        \"feedback\": { \"type\": \"string\", \"maxLength\": 10000 },\n        \"rubricScores\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RubricScore\" } },\n        \"return\": { \"type\": \"boolean\", \"default\": false, \"description\": \"'Save & return' in one transaction (D6).\" }\n      }\n    },\n    \"StudentAssignmentRow\": {\n      \"description\": \"Row for student/parent lists. submission is the toStudentSubmission shape without history or text/files (summary only).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"assignment\": { \"$ref\": \"#/sharedSchemas/AssignmentSummary\" },\n        \"group\": { \"type\": \"string\", \"enum\": [\"UPCOMING\", \"MISSING\", \"SUBMITTED\", \"RETURNED\", \"CLOSED\"], \"description\": \"Server-computed, first match wins: RETURNED (submission RETURNED) → SUBMITTED (submission exists) → UPCOMING (dueAt > now) → MISSING (missingWhere) → CLOSED (past due but exempt or NO_SUBMISSION; UI lists it under 'Past due' with no missing badge). FR-18 'Past due (missing)' = MISSING.\" },\n        \"exempt\": { \"type\": \"boolean\" },\n        \"submission\": {\n          \"type\": \"object\", \"nullable\": true,\n          \"properties\": {\n            \"id\": { \"type\": \"string\" }, \"status\": { \"$ref\": \"#/sharedSchemas/SubmissionStatus\" }, \"attemptNumber\": { \"type\": \"integer\" },\n            \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"isLate\": { \"type\": \"boolean\" },\n            \"finalScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true }, \"returnedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true }\n          }\n        }\n      }\n    }\n  },\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/{courseId}/assignments\",\n      \"description\": \"Role-shaped list for the course Assignments tab. Auth: requireUser + assertCanViewCourse. Managers (canSeeDrafts) get every status incl. archived, with counts (one groupBy). Students/parents get only visibleWhere(now) assignments with their own submission state; parents pass studentId (resolveViewedStudent; defaults to the only linked child). Read path fires publishOnce for newly visible SCHEDULED rows (fire-and-forget, FR-42). Sorted by dueAt asc.\",\n      \"query\": { \"studentId\": { \"type\": \"string\", \"description\": \"PARENT only; must be a linked child\" } },\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"description\": \"{ data: ... }\",\n        \"oneOf\": [\n          { \"title\": \"manager\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"manager\" }, \"items\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/AssignmentSummary\" }], \"properties\": { \"counts\": { \"$ref\": \"#/sharedSchemas/ManagerCounts\" } } } } } },\n          { \"title\": \"student/parent\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"student\" }, \"studentId\": { \"type\": \"string\" }, \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentAssignmentRow\" } } } }\n        ]\n      },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN (not in course / studentId not linked)\", \"NOT_FOUND (course)\"],\n      \"requirementIds\": [\"FR-48\", \"FR-17\", \"FR-18\", \"FR-13\", \"FR-42\", \"FR-52\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/{courseId}/assignments\",\n      \"description\": \"Create an assignment with optional rubric and attachments in one transaction. Auth: assertCanManageCourse. After commit, if visible now → publishOnce (assignment.published to ACTIVE-enrolled students). Audit assignment.create.\",\n      \"requestSchema\": { \"$ref\": \"#/sharedSchemas/AssignmentInput\" },\n      \"responseSchema\": { \"description\": \"201 { data: Assignment }\", \"$ref\": \"#/sharedSchemas/Assignment\" },\n      \"errors\": [\"VALIDATION_ERROR (Zod; 'Rubric totals {sum} points but the assignment is worth {maxPoints}.'; SCHEDULED with availableFrom ≤ now; attachment not owned/wrong context)\", \"FORBIDDEN\", \"NOT_FOUND (course)\"],\n      \"requirementIds\": [\"FR-49\", \"FR-7\", \"FR-9\", \"FR-11\", \"FR-12\", \"FR-42\", \"FR-59\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/assignments/{assignmentId}\",\n      \"description\": \"Assignment detail. Auth: requireUser + assertCanViewCourse. Non-managers get NOT_FOUND unless isAssignmentVisible. Students/parents also get their own submission (toStudentSubmission) and exemption flag. serverNow lets the client offset its countdown (display only, FR-19).\",\n      \"query\": { \"studentId\": { \"type\": \"string\", \"description\": \"PARENT only; must be a linked child\" } },\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"assignment\": { \"$ref\": \"#/sharedSchemas/Assignment\" },\n          \"canManage\": { \"type\": \"boolean\" },\n          \"submission\": { \"$ref\": \"#/sharedSchemas/Submission\", \"nullable\": true, \"description\": \"Student/parent only; serializer applied. Absent for managers.\" },\n          \"exempt\": { \"type\": \"boolean\", \"description\": \"Student/parent only\" },\n          \"submissionCount\": { \"type\": \"integer\", \"description\": \"Managers only; drives the FR-14 edit warning\" },\n          \"serverNow\": { \"type\": \"string\", \"format\": \"date-time\" }\n        }\n      },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-50\", \"FR-19\", \"FR-26\", \"FR-27\", \"FR-13\", \"FR-52\", \"NFR-2\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/assignments/{assignmentId}\",\n      \"description\": \"Update an assignment. Auth: assertCanManageCourse. Body is a partial AssignmentInput (same superRefine on the merged result). attachmentFileIds is the full new set (removed files detached). If it becomes visible and notifiedAt is null → publishOnce. Client shows the FR-14 'review grades' banner if maxPoints changed and submissionCount > 0. Audit assignment.update.\",\n      \"requestSchema\": { \"description\": \"Partial<AssignmentInput>\", \"$ref\": \"#/sharedSchemas/AssignmentInput\" },\n      \"responseSchema\": { \"$ref\": \"#/sharedSchemas/Assignment\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-51\", \"FR-12\", \"FR-14\", \"FR-11\", \"FR-42\", \"FR-59\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/assignments/{assignmentId}\",\n      \"description\": \"Hard delete (with rubric, attachments detached) when there are 0 submissions; otherwise set archivedAt. Auth: assertCanManageCourse. Audit assignment.delete | assignment.archive.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"result\": { \"type\": \"string\", \"enum\": [\"deleted\", \"archived\"] } } },\n      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-51\", \"FR-52\", \"FR-59\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/assignments/{assignmentId}/duplicate\",\n      \"description\": \"Copy as DRAFT to each target course. Auth: manage source course and assertCanManageCourse for every target (all checked before any write). Rubric copied as new rows; attachments re-saved as new FileObjects (context 'assignment'); same dueAt, availableFrom/lateCutoffAt keep offsets; notifiedAt null. One transaction per target. Audit assignment.duplicate.\",\n      \"requestSchema\": { \"type\": \"object\", \"required\": [\"courseIds\"], \"properties\": { \"courseIds\": { \"type\": \"array\", \"minItems\": 1, \"items\": { \"type\": \"string\" } } } },\n      \"responseSchema\": { \"description\": \"201\", \"type\": \"object\", \"properties\": { \"created\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"courseId\": { \"type\": \"string\" }, \"assignmentId\": { \"type\": \"string\" } } } } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN (any target not managed)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-15\", \"FR-59\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/assignments/{assignmentId}/submissions\",\n      \"description\": \"Grading roster: every ACTIVE-enrolled student, including those who have not submitted, with chip status, exemption and submission summary. Auth: assertCanManageCourse. Paginated (pageSize ≤ 100). Sort by name (default) or submittedAt; optional chip filter.\",\n      \"query\": {\n        \"page\": { \"type\": \"integer\", \"default\": 1 },\n        \"pageSize\": { \"type\": \"integer\", \"maximum\": 100, \"default\": 100 },\n        \"sort\": { \"type\": \"string\", \"enum\": [\"name\", \"submittedAt\"], \"default\": \"name\" },\n        \"status\": { \"$ref\": \"#/sharedSchemas/ChipStatus\" }\n      },\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"description\": \"paginated envelope; data[] items:\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" },\n          \"chipStatus\": { \"$ref\": \"#/sharedSchemas/ChipStatus\" },\n          \"exempt\": { \"type\": \"boolean\" },\n          \"submission\": {\n            \"type\": \"object\", \"nullable\": true,\n            \"properties\": {\n              \"id\": { \"type\": \"string\" }, \"status\": { \"$ref\": \"#/sharedSchemas/SubmissionStatus\" }, \"attemptNumber\": { \"type\": \"integer\" },\n              \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"isLate\": { \"type\": \"boolean\" }, \"lateDays\": { \"type\": \"integer\" },\n              \"finalScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true }, \"gradedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n              \"returnedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true }\n            }\n          }\n        }\n      },\n      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-54\", \"FR-28\", \"FR-35\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/assignments/{assignmentId}/submissions\",\n      \"description\": \"Submit or resubmit. Auth: requireRole STUDENT. Server-clock checks in order (first failure wins): visible → ACTIVE-enrolled → not exempt and type ≠ NO_SUBMISSION → deadline/late cutoff → content matches type and fileIds ≤ maxFileCount → each file owned by caller, context 'submission', unattached or already on this submission. Resubmit (status SUBMITTED, incl. attempt-0 offline row) snapshots SubmissionHistory, increments attemptNumber, clears grade fields. Returns 201 on first submit, 200 on resubmit.\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"text\": { \"type\": \"string\", \"maxLength\": 50000 },\n          \"fileIds\": { \"type\": \"array\", \"maxItems\": 10, \"items\": { \"type\": \"string\" }, \"default\": [] }\n        }\n      },\n      \"responseSchema\": { \"description\": \"Receipt: toStudentSubmission shape (grade fields null).\", \"$ref\": \"#/sharedSchemas/Submission\" },\n      \"errors\": [\n        \"NOT_FOUND (assignment not visible)\",\n        \"FORBIDDEN (not STUDENT / not ACTIVE-enrolled)\",\n        \"VALIDATION_ERROR (exempt; NO_SUBMISSION; 'The deadline has passed and late submissions are closed.'; missing text/files for type; too many files; file not yours / wrong context)\",\n        \"CONFLICT ('This submission has been returned and can no longer be changed.')\"\n      ],\n      \"requirementIds\": [\"FR-53\", \"FR-22\", \"FR-23\", \"FR-24\", \"FR-35\", \"FR-60\", \"FR-7\", \"NFR-2\", \"FR-59\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/assignments/{assignmentId}/return\",\n      \"description\": \"Bulk 'Return all graded'. Auth: assertCanManageCourse. Default set = gradedAt != null AND status SUBMITTED. Supplied ids that are ungraded/already returned/not in this assignment are skipped and reported. One updateMany, then notifyStudentAndParents(assignment.returned) per student and one audit row per submission.\",\n      \"requestSchema\": { \"type\": \"object\", \"properties\": { \"submissionIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } } },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"returned\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n          \"skipped\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"submissionId\": { \"type\": \"string\" }, \"reason\": { \"type\": \"string\", \"enum\": [\"NOT_GRADED\", \"ALREADY_RETURNED\", \"NOT_FOUND\"] } } } }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-32\", \"FR-44\", \"FR-59\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/assignments/{assignmentId}/grade-offline\",\n      \"description\": \"'Grade without submission'. Auth: assertCanManageCourse. Student must be ACTIVE-enrolled with no existing submission. Creates the attemptNumber 0 Submission (text null, no files, submittedAt = gradedAt, penalty 0) using the same rubric/raw-score validation as PUT /grade. return:true also returns it. Audit submission.grade_offline.\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"studentId\"],\n        \"properties\": {\n          \"studentId\": { \"type\": \"string\" },\n          \"rawScore\": { \"$ref\": \"#/sharedSchemas/Decimal\" },\n          \"feedback\": { \"type\": \"string\", \"maxLength\": 10000 },\n          \"rubricScores\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RubricScore\" } },\n          \"return\": { \"type\": \"boolean\", \"default\": false }\n        }\n      },\n      \"responseSchema\": { \"description\": \"201\", \"$ref\": \"#/sharedSchemas/Submission\" },\n      \"errors\": [\"VALIDATION_ERROR (score out of range / rubric incomplete / student not enrolled)\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT (submission already exists — grade that one)\"],\n      \"requirementIds\": [\"FR-34\", \"FR-8\", \"FR-36\", \"FR-59\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/assignments/{assignmentId}/exemptions/{studentId}\",\n      \"description\": \"Exempt a student (idempotent upsert of GradeExemption). Auth: assertCanManageCourse; student must be enrolled. Effects: removed from missing, no reminders, cannot submit; row is the PRD-11 exclusion flag. Audit assignment.exempt.\",\n      \"requestSchema\": { \"type\": \"object\", \"properties\": { \"reason\": { \"type\": \"string\", \"maxLength\": 500 } } },\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"assignmentId\": { \"type\": \"string\" }, \"studentId\": { \"type\": \"string\" }, \"exempt\": { \"const\": true }, \"reason\": { \"type\": \"string\", \"nullable\": true } } },\n      \"errors\": [\"VALIDATION_ERROR (student not enrolled)\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-35\", \"FR-5\", \"FR-59\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/assignments/{assignmentId}/exemptions/{studentId}\",\n      \"description\": \"Remove an exemption (idempotent deleteMany). Auth: assertCanManageCourse. Audit assignment.unexempt.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"assignmentId\": { \"type\": \"string\" }, \"studentId\": { \"type\": \"string\" }, \"exempt\": { \"const\": false } } },\n      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-35\", \"FR-59\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/submissions/{submissionId}\",\n      \"description\": \"Submission detail for the grading main panel and student/parent results. Auth: submitting student, linked parent, or course manager; anyone else NOT_FOUND. Managers get the full shape incl. history (with files); student/parent get toStudentSubmission. Grading page caches and prefetches next/prev (NFR-3).\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"$ref\": \"#/sharedSchemas/Submission\" },\n      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-55\", \"FR-29\", \"FR-26\", \"FR-27\", \"NFR-3\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/submissions/{submissionId}/grade\",\n      \"description\": \"Save a grade (status stays SUBMITTED, invisible to student) or Save & return (return:true → RETURNED + returnedAt in the same transaction, then notifyStudentAndParents(assignment.returned, 'Course: Title — {final}/{max}')). Auth: assertCanManageCourse. Server computes rawScore (rubric) and finalScore = computeFinalScore(raw, penalty). Re-grading a RETURNED submission is allowed and keeps it RETURNED. Audit submission.grade (+ submission.return).\",\n      \"requestSchema\": { \"$ref\": \"#/sharedSchemas/GradeInput\" },\n      \"responseSchema\": { \"description\": \"Full manager shape\", \"$ref\": \"#/sharedSchemas/Submission\" },\n      \"errors\": [\"VALIDATION_ERROR (score/penalty range; rubric scores missing, duplicated or over criterion max)\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-56\", \"FR-30\", \"FR-31\", \"FR-32\", \"FR-36\", \"FR-44\", \"FR-59\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/assignments\",\n      \"description\": \"Data for /assignments. STUDENT: own rows across ACTIVE enrollments, filtered by tab (UPCOMING sorted by dueAt asc; MISSING = missingWhere; SUBMITTED; RETURNED) and courseId. PARENT: same, for studentId (linked child; defaults to the only child). TEACHER: 'To grade' = SUBMITTED, ungraded submissions in courses where teacherId or coTeacherIds includes them, oldest submittedAt first. ADMIN: 'To grade' across all courses. Fires publishOnce for newly visible SCHEDULED rows (student/parent).\",\n      \"query\": {\n        \"studentId\": { \"type\": \"string\", \"description\": \"PARENT only\" },\n        \"tab\": { \"type\": \"string\", \"enum\": [\"UPCOMING\", \"MISSING\", \"SUBMITTED\", \"RETURNED\"], \"default\": \"UPCOMING\", \"description\": \"STUDENT/PARENT only\" },\n        \"courseId\": { \"type\": \"string\" }\n      },\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"oneOf\": [\n          { \"title\": \"student/parent\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"student\" }, \"studentId\": { \"type\": \"string\" }, \"children\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/UserRef\" }, \"description\": \"PARENT only, for the child selector\" }, \"courses\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } }, \"description\": \"for the course filter\" }, \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentAssignmentRow\" } } } },\n          { \"title\": \"to-grade (TEACHER/ADMIN)\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"toGrade\" }, \"items\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"submissionId\": { \"type\": \"string\" }, \"assignment\": { \"$ref\": \"#/sharedSchemas/AssignmentSummary\" }, \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" }, \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"isLate\": { \"type\": \"boolean\" } } } } } }\n        ]\n      },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN (studentId not a linked child)\"],\n      \"requirementIds\": [\"FR-57\", \"FR-37\", \"FR-38\", \"FR-39\", \"FR-35\", \"FR-60\", \"FR-42\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/{studentId}/assignments\",\n      \"description\": \"Per-student assignment list across the student's ACTIVE enrollments (students/[id]/assignments page). Auth: assertCanViewStudent. Per course: viewers who manage that course get full grade fields; everyone else gets toStudentSubmission (D8). Only visible, non-archived assignments.\",\n      \"query\": { \"courseId\": { \"type\": \"string\" } },\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" },\n          \"items\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentAssignmentRow\" }], \"properties\": { \"canManage\": { \"type\": \"boolean\" } } } }\n        }\n      },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND (student)\"],\n      \"requirementIds\": [\"FR-58\", \"FR-41\", \"FR-27\", \"NFR-4\"]\n    }\n  ],\n  \"reusedEndpoints\": [\n    { \"method\": \"POST\", \"path\": \"/api/files\", \"note\": \"Unchanged. Clients upload with context 'assignment' (authoring) or 'submission' (student) before referencing fileIds.\", \"requirementIds\": [\"FR-9\", \"FR-20\", \"FR-47\"] },\n    { \"method\": \"GET\", \"path\": \"/api/files/{id}?inline=1\", \"note\": \"Unchanged handler; new resolvers assignmentResolver/submissionResolver in src/server/files/contexts.ts. Header change D11 (X-Frame-Options SAMEORIGIN for this path only) enables PDF iframe preview.\", \"requirementIds\": [\"FR-29\", \"FR-47\", \"NFR-4\"] },\n    { \"method\": \"POST\", \"path\": \"/api/internal/email/dispatch\", \"note\": \"Unchanged contract; now also calls sendDueReminders(now) on every request (due_soon, missing).\", \"requirementIds\": [\"FR-43\", \"FR-45\", \"FR-6\"] }\n  ],\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_01MXjUrKWjBs5MFXJRW7imKv","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
