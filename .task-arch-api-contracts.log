{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgm8YPDAcSwEYMngas1RW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018hoQDx8r7Cvdqu5M54e3dL","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-7\",\n  \"timestamp\": \"2026-11-06T06:45:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-10 forbids renaming routes)\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/attendance.ts) → resource assert → attendance-service → ok()/paginated(). Every helper comes from src/server/http.ts (system-design §3.1).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },\n    \"validationErrorDetails\": \"A ZodError maps to VALIDATION_ERROR with details = zod flatten() { formErrors, fieldErrors }. Service-raised NFR-3 roster errors use details { invalidStudentIds: string[] } or { missingStudentIds: string[] }.\",\n    \"dates\": \"Date-only values are 'yyyy-MM-dd' strings interpreted in SchoolSettings.timezone. Timestamps are ISO 8601 UTC. Display uses formatInSchoolTz (ADR-5).\",\n    \"ids\": \"All ids are cuid strings.\",\n    \"requirementIds\": [\"FR-35\", \"FR-36\", \"NFR-7\", \"NFR-8\"]\n  },\n  \"sharedSchemas\": {\n    \"DateOnly\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n    \"AttendanceStatus\": { \"type\": \"string\", \"enum\": [\"PRESENT\", \"ABSENT\", \"LATE\", \"EXCUSED\"] },\n    \"AttendanceMode\": { \"type\": \"string\", \"enum\": [\"PER_PERIOD\", \"DAILY_HOMEROOM\", \"BOTH\"] },\n    \"RegisterKey\": {\n      \"description\": \"Zod union registerQuery (C6). Course variant or section (daily) variant; exactly one (FR-2).\",\n      \"oneOf\": [\n        { \"type\": \"object\", \"required\": [\"courseId\", \"date\", \"periodId\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" }, \"periodId\": { \"type\": \"string\" } } },\n        { \"type\": \"object\", \"required\": [\"sectionId\", \"date\"], \"properties\": { \"sectionId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } }\n      ]\n    },\n    \"RegisterRecordInput\": {\n      \"description\": \"Zod registerRecord (C6). minutesLate is required (1–240) iff status = LATE and forbidden otherwise (superRefine). EXCUSED is ADMIN-only, checked in the service (FR-10).\",\n      \"type\": \"object\",\n      \"required\": [\"studentId\", \"status\"],\n      \"properties\": {\n        \"studentId\": { \"type\": \"string\" },\n        \"status\": { \"$ref\": \"#/sharedSchemas/AttendanceStatus\" },\n        \"minutesLate\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 240 },\n        \"note\": { \"type\": \"string\", \"maxLength\": 500 }\n      }\n    },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n    \"Register\": {\n      \"description\": \"Returned by GET and PUT /api/attendance/register.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"key\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n        \"header\": { \"type\": \"object\", \"properties\": { \"courseName\": { \"type\": \"string|null\" }, \"sectionName\": { \"type\": \"string\" }, \"periodName\": { \"type\": \"string|null\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } },\n        \"sessionId\": { \"type\": \"string|null\", \"description\": \"null when no register has been saved yet\" },\n        \"students\": {\n          \"type\": \"array\",\n          \"description\": \"Roster active on the date, sorted by last name (FR-9, NFR-3)\",\n          \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" }, \"avatarUrl\": { \"type\": \"string|null\" } } }\n        },\n        \"records\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" }, \"description\": \"Existing records; empty for a new register (nothing preselected, FR-9)\" },\n        \"takenBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"readOnly\": { \"type\": \"boolean\" },\n        \"readOnlyReason\": { \"type\": \"string|null\", \"description\": \"e.g. 'Teachers can edit registers up to 14 days after the register date' (FR-19)\" },\n        \"canExcuse\": { \"type\": \"boolean\", \"description\": \"true only for ADMIN (FR-10)\" }\n      }\n    },\n    \"StatusCounts\": { \"type\": \"object\", \"properties\": { \"records\": { \"type\": \"integer\" }, \"present\": { \"type\": \"integer\" }, \"absent\": { \"type\": \"integer\" }, \"late\": { \"type\": \"integer\" }, \"excused\": { \"type\": \"integer\" }, \"rate\": { \"type\": \"number|null\", \"description\": \"(P+L+E)/records×100, 1 dp; null when records = 0 (FR-28)\" } } },\n    \"StudentSummaryRow\": {\n      \"allOf\": [\n        { \"type\": \"object\", \"properties\": { \"studentId\": { \"type\": \"string\" }, \"studentName\": { \"type\": \"string\" }, \"sectionName\": { \"type\": \"string|null\" }, \"gradeLevelName\": { \"type\": \"string|null\" } } },\n        { \"$ref\": \"#/sharedSchemas/StatusCounts\" }\n      ]\n    }\n  },\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/today\",\n      \"description\": \"The teacher's meetings for today in the school timezone (getScheduleForDate) joined with today's sessions, with the current slot flagged. Includes daily homeroom entries when attendanceMode is DAILY_HOMEROOM or BOTH. Guard: requireRole('TEACHER','ADMIN'). An ADMIN gets [] meetings plus no homeroom entries unless they are a homeroom teacher.\",\n      \"requestSchema\": { \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" },\n          \"meetings\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"kind\": \"'course'\",\n              \"courseId\": \"string\",\n              \"courseName\": \"string\",\n              \"sectionName\": \"string\",\n              \"periodId\": \"string\",\n              \"periodName\": \"string\",\n              \"startTime\": \"HH:mm\",\n              \"endTime\": \"HH:mm\",\n              \"isCurrent\": \"boolean\",\n              \"taken\": \"null | { at: ISO date-time, by: UserRef }\"\n            }\n          },\n          \"dailyRegisters\": {\n            \"type\": \"array\",\n            \"items\": { \"kind\": \"'section'\", \"sectionId\": \"string\", \"sectionName\": \"string\", \"taken\": \"null | { at, by: UserRef }\" }\n          }\n        }\n      },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-6\", \"FR-7\", \"FR-35\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Load a course register (?courseId=&date=&periodId=) or daily register (?sectionId=&date=). Guard: requireUser, then assertCanManageCourse or assertCanManageSection (ADMIN or homeroom teacher). Future dates → 400; TEACHER more than 14 days back → 403 for opening (canOpen). Past the edit window → readOnly = true with readOnlyReason.\",\n      \"requestSchema\": { \"query\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" } },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\"VALIDATION_ERROR (bad key, future date)\", \"FORBIDDEN (no access, outside 14-day open window)\", \"NOT_FOUND (course/section/period)\"],\n      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-19\", \"FR-35\", \"NFR-3\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Create or update the session and all records in one transaction (system-design §3.2). Records must cover the whole active roster and only roster students. After commit: audit('attendance.record.update') per changed status, and notifyStudentAndParents per transition into ABSENT/LATE or ABSENT→PRESENT (corrected). Re-saving unchanged statuses sends nothing. Idempotent: a P2002 race on the partial unique index re-reads the session rather than returning CONFLICT.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod registerPutBody = RegisterKey & { records }\",\n          \"allOf\": [\n            { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n            { \"type\": \"object\", \"required\": [\"records\"], \"properties\": { \"records\": { \"type\": \"array\", \"minItems\": 1, \"uniqueBy\": \"studentId\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" } } } }\n          ]\n        }\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\n        \"VALIDATION_ERROR (schema; future date; studentId not active on date → details.invalidStudentIds; roster not fully marked → details.missingStudentIds)\",\n        \"FORBIDDEN (no access; TEACHER past 14-day edit window; EXCUSED by non-ADMIN)\",\n        \"NOT_FOUND\"\n      ],\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"FR-35\", \"FR-36\", \"NFR-1\", \"NFR-3\", \"NFR-5\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/{studentId}/attendance\",\n      \"description\": \"Student attendance tab data in one indexed query. Guard: requireUser + assertCanViewStudent (parent → linked students, student → self, teacher/admin per existing rules). Session kind follows attendanceMode (course sessions for PER_PERIOD/BOTH, section sessions for DAILY_HOMEROOM). `note` is omitted from rows for STUDENT and PARENT. from/to default to the current month; summaries always cover the current term and academic year regardless of from/to.\",\n      \"requestSchema\": { \"path\": { \"studentId\": \"string\" }, \"query\": { \"from\": \"DateOnly?\", \"to\": \"DateOnly?\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"summary\": { \"term\": { \"$ref\": \"#/sharedSchemas/StatusCounts\", \"termName\": \"string|null\" }, \"year\": { \"$ref\": \"#/sharedSchemas/StatusCounts\" } },\n          \"calendar\": { \"type\": \"array\", \"items\": { \"date\": \"DateOnly\", \"colour\": \"'success'|'warning'|'error'|'default'\", \"present\": \"int\", \"absent\": \"int\", \"late\": \"int\", \"excused\": \"int\" } },\n          \"records\": {\n            \"type\": \"array\",\n            \"items\": { \"id\": \"string\", \"date\": \"DateOnly\", \"periodName\": \"string|null\", \"courseName\": \"string|null\", \"sectionName\": \"string|null\", \"status\": \"AttendanceStatus\", \"minutesLate\": \"int|null\", \"note\": \"string|null (absent key for STUDENT/PARENT)\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-35\", \"NFR-1\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/{courseId}/attendance\",\n      \"description\": \"Course attendance matrix: the last 20 sessions by date (columns) × enrolled students (ACTIVE, plus DROPPED students with records) with P/A/L/E cells and per-student rate. Guard: requireUser + assertCanManageCourse.\",\n      \"requestSchema\": { \"path\": { \"courseId\": \"string\" }, \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"sessions\": { \"type\": \"array\", \"items\": { \"sessionId\": \"string\", \"date\": \"DateOnly\", \"periodId\": \"string\", \"periodName\": \"string\" } },\n          \"students\": {\n            \"type\": \"array\",\n            \"items\": { \"studentId\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"enrollmentStatus\": \"'ACTIVE'|'DROPPED'\", \"cells\": \"{ [sessionId]: AttendanceStatus }\", \"rate\": \"number|null\" }\n          }\n        }\n      },\n      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-28\", \"FR-29\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/overview\",\n      \"description\": \"Today overview: expected meetings (getSchoolScheduleForDate + homeroom sections when mode includes daily) vs taken sessions, the school-wide rate for the date, and missing registers (no session and period.startTime + 15 min ≤ now in school tz; only computed when date is today). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"date\": \"DateOnly? (default school today; future → 400)\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": \"DateOnly\",\n          \"expected\": \"int\",\n          \"taken\": \"int\",\n          \"rate\": \"number|null\",\n          \"missing\": {\n            \"type\": \"array\",\n            \"items\": { \"courseId\": \"string\", \"courseName\": \"string\", \"sectionName\": \"string\", \"periodId\": \"string\", \"periodName\": \"string\", \"startTime\": \"HH:mm\", \"teacher\": \"UserRef\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/report\",\n      \"description\": \"Per-student summary over the filtered range (groupBy studentId, status). JSON is paginated (pageSize ≤ 100). With ?format=csv returns every row as text/csv (Content-Disposition: attachment; filename=attendance-report-<from>-<to>.csv) via toCsv, with columns: Student, Section, Grade, Records, Present, Absent, Late, Excused, Rate. Guard: requireRole('ADMIN').\",\n      \"requestSchema\": {\n        \"query\": {\n          \"from\": \"DateOnly (required)\",\n          \"to\": \"DateOnly (required, ≥ from, range ≤ 366 days)\",\n          \"gradeLevelId\": \"string?\",\n          \"sectionId\": \"string?\",\n          \"courseId\": \"string?\",\n          \"status\": \"AttendanceStatus? (only students with ≥1 record of this status)\",\n          \"format\": \"'csv'?\",\n          \"page\": \"int? (default 1, ignored for csv)\",\n          \"pageSize\": \"int? (default 20, max 100, ignored for csv)\"\n        }\n      },\n      \"responseSchema\": {\n        \"json\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" } }, \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n        \"csv\": \"text/csv; charset=utf-8\"\n      },\n      \"errors\": [\"VALIDATION_ERROR (range > 366 days, to < from)\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-32\", \"FR-35\", \"FR-36\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/below-threshold\",\n      \"description\": \"Students whose year-to-date rate is below SchoolSettings.attendanceAlertThreshold, sorted by rate ascending. Paginated (pageSize ≤ 100). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"page\": \"int?\", \"pageSize\": \"int? (max 100)\" } },\n      \"responseSchema\": {\n        \"data\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" }, { \"href\": \"/students/<id>/attendance\" }] } },\n        \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\", \"threshold\": \"int\" }\n      },\n      \"errors\": [\"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-35\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/attendance/remind\",\n      \"description\": \"Send 'attendance.register_missing' to the course teacher (notify, link /attendance/take/<courseId>?date=&periodId=), then audit('attendance.remind'). Guard: requireRole('ADMIN'). Returns 200 even if the notification fails to enqueue, because notify never throws.\",\n      \"requestSchema\": { \"body\": { \"type\": \"object\", \"required\": [\"courseId\", \"periodId\", \"date\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"periodId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } } },\n      \"responseSchema\": { \"data\": { \"reminded\": { \"$ref\": \"#/sharedSchemas/UserRef\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND (course/period)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-31\", \"FR-35\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/settings/school\",\n      \"description\": \"Minimal school settings update for this PRD: only the attendance fields (FR-5 default; the user may override this). Built on updateSchoolSettings() and writes audit('school_settings.update', { old, new }). Guard: requireRole('ADMIN'). Unknown keys are rejected (strict schema) so this route cannot widen scope.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod attendanceSettingsPatch (strict). At least one field.\",\n          \"type\": \"object\",\n          \"minProperties\": 1,\n          \"additionalProperties\": false,\n          \"properties\": { \"attendanceMode\": { \"$ref\": \"#/sharedSchemas/AttendanceMode\" }, \"attendanceAlertThreshold\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 } }\n        }\n      },\n      \"responseSchema\": { \"data\": { \"attendanceMode\": \"AttendanceMode\", \"attendanceAlertThreshold\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-4\", \"FR-5\", \"NFR-8\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3017,"cache_read_input_tokens":51484,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3017},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f90400c-337b-4bd2-a543-f73a5eb37374","uuid":"616f7618-38a6-4e85-8712-14f9683cc35b","timestamp":"2026-11-06T05:35:49.300Z","request_id":"req_011Cgm8YP2GUm2EWY4kYdGHU","wire_tool_inputs":{"toolu_018hoQDx8r7Cvdqu5M54e3dL":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-7\",\n  \"timestamp\": \"2026-11-06T06:45:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-10 forbids renaming routes)\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/attendance.ts) → resource assert → attendance-service → ok()/paginated(). Every helper comes from src/server/http.ts (system-design §3.1).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },\n    \"validationErrorDetails\": \"A ZodError maps to VALIDATION_ERROR with details = zod flatten() { formErrors, fieldErrors }. Service-raised NFR-3 roster errors use details { invalidStudentIds: string[] } or { missingStudentIds: string[] }.\",\n    \"dates\": \"Date-only values are 'yyyy-MM-dd' strings interpreted in SchoolSettings.timezone. Timestamps are ISO 8601 UTC. Display uses formatInSchoolTz (ADR-5).\",\n    \"ids\": \"All ids are cuid strings.\",\n    \"requirementIds\": [\"FR-35\", \"FR-36\", \"NFR-7\", \"NFR-8\"]\n  },\n  \"sharedSchemas\": {\n    \"DateOnly\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n    \"AttendanceStatus\": { \"type\": \"string\", \"enum\": [\"PRESENT\", \"ABSENT\", \"LATE\", \"EXCUSED\"] },\n    \"AttendanceMode\": { \"type\": \"string\", \"enum\": [\"PER_PERIOD\", \"DAILY_HOMEROOM\", \"BOTH\"] },\n    \"RegisterKey\": {\n      \"description\": \"Zod union registerQuery (C6). Course variant or section (daily) variant; exactly one (FR-2).\",\n      \"oneOf\": [\n        { \"type\": \"object\", \"required\": [\"courseId\", \"date\", \"periodId\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" }, \"periodId\": { \"type\": \"string\" } } },\n        { \"type\": \"object\", \"required\": [\"sectionId\", \"date\"], \"properties\": { \"sectionId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } }\n      ]\n    },\n    \"RegisterRecordInput\": {\n      \"description\": \"Zod registerRecord (C6). minutesLate is required (1–240) iff status = LATE and forbidden otherwise (superRefine). EXCUSED is ADMIN-only, checked in the service (FR-10).\",\n      \"type\": \"object\",\n      \"required\": [\"studentId\", \"status\"],\n      \"properties\": {\n        \"studentId\": { \"type\": \"string\" },\n        \"status\": { \"$ref\": \"#/sharedSchemas/AttendanceStatus\" },\n        \"minutesLate\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 240 },\n        \"note\": { \"type\": \"string\", \"maxLength\": 500 }\n      }\n    },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n    \"Register\": {\n      \"description\": \"Returned by GET and PUT /api/attendance/register.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"key\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n        \"header\": { \"type\": \"object\", \"properties\": { \"courseName\": { \"type\": \"string|null\" }, \"sectionName\": { \"type\": \"string\" }, \"periodName\": { \"type\": \"string|null\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } },\n        \"sessionId\": { \"type\": \"string|null\", \"description\": \"null when no register has been saved yet\" },\n        \"students\": {\n          \"type\": \"array\",\n          \"description\": \"Roster active on the date, sorted by last name (FR-9, NFR-3)\",\n          \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" }, \"avatarUrl\": { \"type\": \"string|null\" } } }\n        },\n        \"records\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" }, \"description\": \"Existing records; empty for a new register (nothing preselected, FR-9)\" },\n        \"takenBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"readOnly\": { \"type\": \"boolean\" },\n        \"readOnlyReason\": { \"type\": \"string|null\", \"description\": \"e.g. 'Teachers can edit registers up to 14 days after the register date' (FR-19)\" },\n        \"canExcuse\": { \"type\": \"boolean\", \"description\": \"true only for ADMIN (FR-10)\" }\n      }\n    },\n    \"StatusCounts\": { \"type\": \"object\", \"properties\": { \"records\": { \"type\": \"integer\" }, \"present\": { \"type\": \"integer\" }, \"absent\": { \"type\": \"integer\" }, \"late\": { \"type\": \"integer\" }, \"excused\": { \"type\": \"integer\" }, \"rate\": { \"type\": \"number|null\", \"description\": \"(P+L+E)/records×100, 1 dp; null when records = 0 (FR-28)\" } } },\n    \"StudentSummaryRow\": {\n      \"allOf\": [\n        { \"type\": \"object\", \"properties\": { \"studentId\": { \"type\": \"string\" }, \"studentName\": { \"type\": \"string\" }, \"sectionName\": { \"type\": \"string|null\" }, \"gradeLevelName\": { \"type\": \"string|null\" } } },\n        { \"$ref\": \"#/sharedSchemas/StatusCounts\" }\n      ]\n    }\n  },\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/today\",\n      \"description\": \"The teacher's meetings for today in the school timezone (getScheduleForDate) joined with today's sessions, with the current slot flagged. Includes daily homeroom entries when attendanceMode is DAILY_HOMEROOM or BOTH. Guard: requireRole('TEACHER','ADMIN'). An ADMIN gets [] meetings plus no homeroom entries unless they are a homeroom teacher.\",\n      \"requestSchema\": { \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" },\n          \"meetings\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"kind\": \"'course'\",\n              \"courseId\": \"string\",\n              \"courseName\": \"string\",\n              \"sectionName\": \"string\",\n              \"periodId\": \"string\",\n              \"periodName\": \"string\",\n              \"startTime\": \"HH:mm\",\n              \"endTime\": \"HH:mm\",\n              \"isCurrent\": \"boolean\",\n              \"taken\": \"null | { at: ISO date-time, by: UserRef }\"\n            }\n          },\n          \"dailyRegisters\": {\n            \"type\": \"array\",\n            \"items\": { \"kind\": \"'section'\", \"sectionId\": \"string\", \"sectionName\": \"string\", \"taken\": \"null | { at, by: UserRef }\" }\n          }\n        }\n      },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-6\", \"FR-7\", \"FR-35\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Load a course register (?courseId=&date=&periodId=) or daily register (?sectionId=&date=). Guard: requireUser, then assertCanManageCourse or assertCanManageSection (ADMIN or homeroom teacher). Future dates → 400; TEACHER more than 14 days back → 403 for opening (canOpen). Past the edit window → readOnly = true with readOnlyReason.\",\n      \"requestSchema\": { \"query\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" } },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\"VALIDATION_ERROR (bad key, future date)\", \"FORBIDDEN (no access, outside 14-day open window)\", \"NOT_FOUND (course/section/period)\"],\n      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-19\", \"FR-35\", \"NFR-3\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Create or update the session and all records in one transaction (system-design §3.2). Records must cover the whole active roster and only roster students. After commit: audit('attendance.record.update') per changed status, and notifyStudentAndParents per transition into ABSENT/LATE or ABSENT→PRESENT (corrected). Re-saving unchanged statuses sends nothing. Idempotent: a P2002 race on the partial unique index re-reads the session rather than returning CONFLICT.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod registerPutBody = RegisterKey & { records }\",\n          \"allOf\": [\n            { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n            { \"type\": \"object\", \"required\": [\"records\"], \"properties\": { \"records\": { \"type\": \"array\", \"minItems\": 1, \"uniqueBy\": \"studentId\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" } } } }\n          ]\n        }\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\n        \"VALIDATION_ERROR (schema; future date; studentId not active on date → details.invalidStudentIds; roster not fully marked → details.missingStudentIds)\",\n        \"FORBIDDEN (no access; TEACHER past 14-day edit window; EXCUSED by non-ADMIN)\",\n        \"NOT_FOUND\"\n      ],\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"FR-35\", \"FR-36\", \"NFR-1\", \"NFR-3\", \"NFR-5\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/{studentId}/attendance\",\n      \"description\": \"Student attendance tab data in one indexed query. Guard: requireUser + assertCanViewStudent (parent → linked students, student → self, teacher/admin per existing rules). Session kind follows attendanceMode (course sessions for PER_PERIOD/BOTH, section sessions for DAILY_HOMEROOM). `note` is omitted from rows for STUDENT and PARENT. from/to default to the current month; summaries always cover the current term and academic year regardless of from/to.\",\n      \"requestSchema\": { \"path\": { \"studentId\": \"string\" }, \"query\": { \"from\": \"DateOnly?\", \"to\": \"DateOnly?\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"summary\": { \"term\": { \"$ref\": \"#/sharedSchemas/StatusCounts\", \"termName\": \"string|null\" }, \"year\": { \"$ref\": \"#/sharedSchemas/StatusCounts\" } },\n          \"calendar\": { \"type\": \"array\", \"items\": { \"date\": \"DateOnly\", \"colour\": \"'success'|'warning'|'error'|'default'\", \"present\": \"int\", \"absent\": \"int\", \"late\": \"int\", \"excused\": \"int\" } },\n          \"records\": {\n            \"type\": \"array\",\n            \"items\": { \"id\": \"string\", \"date\": \"DateOnly\", \"periodName\": \"string|null\", \"courseName\": \"string|null\", \"sectionName\": \"string|null\", \"status\": \"AttendanceStatus\", \"minutesLate\": \"int|null\", \"note\": \"string|null (absent key for STUDENT/PARENT)\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-35\", \"NFR-1\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/{courseId}/attendance\",\n      \"description\": \"Course attendance matrix: the last 20 sessions by date (columns) × enrolled students (ACTIVE, plus DROPPED students with records) with P/A/L/E cells and per-student rate. Guard: requireUser + assertCanManageCourse.\",\n      \"requestSchema\": { \"path\": { \"courseId\": \"string\" }, \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"sessions\": { \"type\": \"array\", \"items\": { \"sessionId\": \"string\", \"date\": \"DateOnly\", \"periodId\": \"string\", \"periodName\": \"string\" } },\n          \"students\": {\n            \"type\": \"array\",\n            \"items\": { \"studentId\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"enrollmentStatus\": \"'ACTIVE'|'DROPPED'\", \"cells\": \"{ [sessionId]: AttendanceStatus }\", \"rate\": \"number|null\" }\n          }\n        }\n      },\n      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-28\", \"FR-29\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/overview\",\n      \"description\": \"Today overview: expected meetings (getSchoolScheduleForDate + homeroom sections when mode includes daily) vs taken sessions, the school-wide rate for the date, and missing registers (no session and period.startTime + 15 min ≤ now in school tz; only computed when date is today). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"date\": \"DateOnly? (default school today; future → 400)\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": \"DateOnly\",\n          \"expected\": \"int\",\n          \"taken\": \"int\",\n          \"rate\": \"number|null\",\n          \"missing\": {\n            \"type\": \"array\",\n            \"items\": { \"courseId\": \"string\", \"courseName\": \"string\", \"sectionName\": \"string\", \"periodId\": \"string\", \"periodName\": \"string\", \"startTime\": \"HH:mm\", \"teacher\": \"UserRef\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/report\",\n      \"description\": \"Per-student summary over the filtered range (groupBy studentId, status). JSON is paginated (pageSize ≤ 100). With ?format=csv returns every row as text/csv (Content-Disposition: attachment; filename=attendance-report-<from>-<to>.csv) via toCsv, with columns: Student, Section, Grade, Records, Present, Absent, Late, Excused, Rate. Guard: requireRole('ADMIN').\",\n      \"requestSchema\": {\n        \"query\": {\n          \"from\": \"DateOnly (required)\",\n          \"to\": \"DateOnly (required, ≥ from, range ≤ 366 days)\",\n          \"gradeLevelId\": \"string?\",\n          \"sectionId\": \"string?\",\n          \"courseId\": \"string?\",\n          \"status\": \"AttendanceStatus? (only students with ≥1 record of this status)\",\n          \"format\": \"'csv'?\",\n          \"page\": \"int? (default 1, ignored for csv)\",\n          \"pageSize\": \"int? (default 20, max 100, ignored for csv)\"\n        }\n      },\n      \"responseSchema\": {\n        \"json\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" } }, \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n        \"csv\": \"text/csv; charset=utf-8\"\n      },\n      \"errors\": [\"VALIDATION_ERROR (range > 366 days, to < from)\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-32\", \"FR-35\", \"FR-36\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/below-threshold\",\n      \"description\": \"Students whose year-to-date rate is below SchoolSettings.attendanceAlertThreshold, sorted by rate ascending. Paginated (pageSize ≤ 100). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"page\": \"int?\", \"pageSize\": \"int? (max 100)\" } },\n      \"responseSchema\": {\n        \"data\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" }, { \"href\": \"/students/<id>/attendance\" }] } },\n        \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\", \"threshold\": \"int\" }\n      },\n      \"errors\": [\"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-35\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/attendance/remind\",\n      \"description\": \"Send 'attendance.register_missing' to the course teacher (notify, link /attendance/take/<courseId>?date=&periodId=), then audit('attendance.remind'). Guard: requireRole('ADMIN'). Returns 200 even if the notification fails to enqueue, because notify never throws.\",\n      \"requestSchema\": { \"body\": { \"type\": \"object\", \"required\": [\"courseId\", \"periodId\", \"date\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"periodId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } } },\n      \"responseSchema\": { \"data\": { \"reminded\": { \"$ref\": \"#/sharedSchemas/UserRef\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND (course/period)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-31\", \"FR-35\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/settings/school\",\n      \"description\": \"Minimal school settings update for this PRD: only the attendance fields (FR-5 default; the user may override this). Built on updateSchoolSettings() and writes audit('school_settings.update', { old, new }). Guard: requireRole('ADMIN'). Unknown keys are rejected (strict schema) so this route cannot widen scope.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod attendanceSettingsPatch (strict). At least one field.\",\n          \"type\": \"object\",\n          \"minProperties\": 1,\n          \"additionalProperties\": false,\n          \"properties\": { \"attendanceMode\": { \"$ref\": \"#/sharedSchemas/AttendanceMode\" }, \"attendanceAlertThreshold\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 } }\n        }\n      },\n      \"responseSchema\": { \"data\": { \"attendanceMode\": \"AttendanceMode\", \"attendanceAlertThreshold\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-4\", \"FR-5\", \"NFR-8\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n"}}}
