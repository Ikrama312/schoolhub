{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lr39ds6acirgBRnuKF25sj","type":"tool_result","content":" */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)","is_error":false}]},"parent_tool_use_id":null,"session_id":"d2e59def-a937-4e61-837c-a8e39741caba","uuid":"617cd765-cc7e-4291-98f6-7f51d75a829e","timestamp":"2026-11-09T17:25:17.434Z","tool_use_result":{"stdout":" */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Lr39ds6acirgBRnuKF25sj","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
