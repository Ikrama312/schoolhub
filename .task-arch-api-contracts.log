etableView\" } },","+      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-35\", \"FR-15\", \"FR-16\", \"NFR-2\", \"NFR-7\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/timetable/availability\",","+      \"routeFile\": \"src/app/api/timetable/availability/route.ts\",","+      \"description\": \"Clash preview for dragging a course: for every teaching-day × period cell in the course's academic year, the clash messages that placing it there would produce. Only cells with clashes are returned. The course's own slots are ignored. roomId (D2) enables the ROOM rule for that room; omitted → ROOM rule skipped. Fixed query count (NFR-3).\",","       \"auth\": \"requireRole('ADMIN')\",","       \"requestSchema\": {","         \"query\": {","-          \"status\": { \"type\": \"string\", \"enum\": [\"PENDING\", \"SENDING\", \"SENT\", \"FAILED\"], \"optional\": true },","-          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },","-          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }","+          \"courseId\": { \"type\": \"string\" },","+          \"roomId\": { \"type\": \"string\", \"optional\": true }","+        },","+        \"zod\": \"availabilityQuerySchema\"","+      },","+      \"responseSchema\": {","+        \"data\": {","+          \"type\": \"object\",","+          \"additionalProperties\": { \"type\": \"array\", \"items\": \"string\" },","+          \"keyFormat\": \"<dayOfWeek>-<periodId>\",","+          \"example\": { \"1-clx0p2\": [\"Clash: Mr Smith already teaches MATH-7B on Monday, Period 2.\"] }","         }","       },","-      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/EmailLogItem\" } }, \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" } },","+      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-36\", \"FR-19\", \"NFR-3\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/timetable/free-rooms\",","+      \"routeFile\": \"src/app/api/timetable/free-rooms/route.ts\",","+      \"description\": \"Non-archived rooms with no slot at (academicYearId, dayOfWeek, periodId), ordered by name. excludeSlotId keeps the slot's own current room in the list. Added by design decision D1 to resolve intake blocker FR-21.\",","+      \"auth\": \"requireRole('ADMIN')\",","+      \"requestSchema\": {","+        \"query\": {","+          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"coerce\": true },","+          \"periodId\": { \"type\": \"string\" },","+          \"academicYearId\": { \"type\": \"string\" },","+          \"excludeSlotId\": { \"type\": \"string\", \"optional\": true }","+        },","+        \"zod\": \"freeRoomsQuerySchema\"","+      },","+      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Room\" } } },","       \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],","-      \"requirementIds\": [\"FR-39\", \"FR-31\", \"NFR-8\"]","+      \"requirementIds\": [\"FR-21\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/admin/email-log/{id}/retry\",","-      \"routeFile\": \"src/app/api/admin/email-log/[id]/retry/route.ts\",","-      \"description\": \"Resets a FAILED row with updateMany({ id, status: FAILED }, { attempts: 0, status: PENDING, nextAttemptAt: now, lastError: null }). A count of 0 (missing or not FAILED) returns 404 NOT_FOUND, so a double click is harmless.\",","+      \"path\": \"/api/timetable/slots\",","+      \"routeFile\": \"src/app/api/timetable/slots/route.ts\",","+      \"description\": \"Place a course in a cell. SERIALIZABLE transaction with retry on P2034: validateSlot runs inside it; any clash → 409 with every clash, nothing saved. academicYearId = course.academicYearId. Archived course or archived roomId → 400. Audited after commit as timetableSlot.create.\",","       \"auth\": \"requireRole('ADMIN')\",","-      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },","-      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\", \"status\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"status\": { \"const\": \"PENDING\" } } } },","-      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-32\", \"FR-39\", \"NFR-8\"]","+      \"requestSchema\": {","+        \"body\": {","+          \"courseId\": { \"type\": \"string\" },","+          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },","+          \"periodId\": { \"type\": \"string\" },","+          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }","+        },","+        \"zod\": \"slotCreateSchema\"","+      },","+      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },","+      \"errorResponses\": {","+        \"409\": {","+          \"error\": {","+            \"code\": \"CONFLICT\",","+            \"message\": \"<first clash message>[ (+N more)]\",","+            \"details\": { \"clashes\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Clash\" } } }","+          }","+        }","+      },","+      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],","+      \"requirementIds\": [\"FR-37\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-17\", \"FR-20\", \"FR-40\", \"NFR-1\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/admin/notifications/test\",","-      \"routeFile\": \"src/app/api/admin/notifications/test/route.ts\",","-      \"description\": \"Calls notify({ type: 'system.test', userIds: [me.id], title: 'Test notification', link: '/dashboard', email: { template: 'generic-notification' } }) for the calling admin. notify() never throws, so the route always returns 200 once auth passes.\",","+      \"method\": \"PATCH\",","+      \"path\": \"/api/timetable/slots/{id}\",","+      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",","+      \"description\": \"Move a slot and/or change its room. The patch is merged over the existing slot and re-validated with the slot itself excluded. A room-only patch (FR-21) uses the same path. Same transaction, 409 shape and audit (timetableSlot.update with from/to) as POST.\",","       \"auth\": \"requireRole('ADMIN')\",","-      \"requestSchema\": {},","-      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"ok\"], \"properties\": { \"ok\": { \"const\": true } } } },","-      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],","-      \"requirementIds\": [\"FR-33\", \"FR-4\", \"FR-6\", \"NFR-8\", \"NFR-16\"]","+      \"requestSchema\": {","+        \"params\": { \"id\": \"string\" },","+        \"body\": {","+          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"optional\": true },","+          \"periodId\": { \"type\": \"string\", \"optional\": true },","+          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }","+        },","+        \"constraint\": \"at least one key\",","+        \"zod\": \"slotUpdateSchema\"","+      },","+      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },","+      \"errorResponses\": { \"409\": \"same as POST /api/timetable/slots\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],","+      \"requirementIds\": [\"FR-37\", \"FR-14\", \"FR-18\", \"FR-20\", \"FR-21\", \"FR-40\", \"NFR-1\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/internal/email/dispatch\",","-      \"routeFile\": \"src/app/api/internal/email/dispatch/route.ts\",","-      \"description\": \"The cron entry point. It runs dispatchEmails({ batchSize: 50 }), then the best-effort purgeOldNotifications() at most once per 24 h per process (a purge failure never fails the response). It is public in middleware and gated only by the bearer token.\",","-      \"auth\": \"Authorization: Bearer ${CRON_SECRET}. The token is compared with crypto.timingSafeEqual, and an unset CRON_SECRET or a missing or wrong token returns 401 UNAUTHENTICATED.\",","-      \"requestSchema\": { \"headers\": { \"Authorization\": { \"type\": \"string\", \"pattern\": \"^Bearer .+$\" } } },","-      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"sent\", \"failed\", \"retried\"], \"properties\": { \"sent\": { \"type\": \"integer\" }, \"failed\": { \"type\": \"integer\" }, \"retried\": { \"type\": \"integer\" } } } },","-      \"errors\": [\"UNAUTHENTICATED\"],","-      \"requirementIds\": [\"FR-19\", \"FR-17\", \"FR-18\", \"FR-27\", \"NFR-3\", \"NFR-4\", \"NFR-5\", \"NFR-8\"]","+      \"method\": \"DELETE\",","+      \"path\": \"/api/timetable/slots/{id}\",","+      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",","+      \"description\": \"Remove a slot. Audited as timetableSlot.delete.\",","+      \"auth\": \"requireRole('ADMIN')\",","+      \"requestSchema\": { \"params\": { \"id\": \"string\" } },","+      \"responseSchema\": { \"data\": { \"id\": \"string\" } },","+      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-37\", \"FR-18\", \"FR-40\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/me/timetable\",","+      \"routeFile\": \"src/app/api/me/timetable/route.ts\",","+      \"description\": \"The caller's personal timetable. TEACHER → own (incl. co-taught). STUDENT → self; a studentId other than self → 403. PARENT → studentId required when >1 linked children, defaults to the only child, must pass assertCanViewStudent else 403. ADMIN → { periods, days, slots: [] } (D5). academicYearId defaults to the current AcademicYear.\",","+      \"auth\": \"requireUser + role-specific checks above\",","+      \"requestSchema\": {","+        \"query\": {","+          \"studentId\": { \"type\": \"string\", \"optional\": true },","+          \"academicYearId\": { \"type\": \"string\", \"optional\": true }","+        },","+        \"zod\": \"meTimetableQuerySchema\"","+      },","+      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },","+      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-38\", \"FR-24\", \"FR-25\", \"FR-27\", \"NFR-7\"]","     }","   ],"," ","   \"nonHttpContracts\": [","     {","-      \"name\": \"notify\",","-      \"module\": \"src/server/notifications/notify.ts\",","-      \"signature\": \"notify(input: { type: NotificationType; userIds: string[]; title: string; body?: string; link?: string; email?: { subject?: string; template: 'generic-notification'; data: Record<string, unknown> } }): Promise<void>\",","-      \"notes\": \"It never throws (FR-11). Call it after the caller's transaction commits. It truncates the title to 140 and the body to 500, and it drops an unsafe link.\",","-      \"requirementIds\": [\"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-9\", \"FR-10\", \"FR-11\", \"NFR-1\", \"NFR-6\", \"NFR-18\"]","+      \"name\": \"getScheduleForDate\",","+      \"module\": \"src/server/timetable/timetable-service.ts\",","+      \"signature\": \"getScheduleForDate(target: { userId: string; role: Role } | { sectionId: string }, date: Date): Promise<{ period: Period; course: TimetableSlotExpanded['course']; room: Room | null }[]>\",","+      \"behaviour\": \"Weekday from SchoolSettings.timezone. [] if the day is not teaching. Ordered by period.order. PARENT target → [].\",","+      \"requirementIds\": [\"FR-30\", \"FR-45\", \"NFR-15\"]","     },","     {","-      \"name\": \"notifyStudentAndParents\",","-      \"module\": \"src/server/notifications/notify.ts\",","-      \"signature\": \"notifyStudentAndParents(input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] }): Promise<void>\",","-      \"requirementIds\": [\"FR-12\", \"NFR-14\"]","+      \"name\": \"getCurrentSlot\",","+      \"module\": \"src/server/timetable/timetable-service.ts\",","+      \"signature\": \"getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null>\",","+      \"behaviour\": \"Entry whose period has startTime <= hhmm < endTime in the school timezone, else null.\",","+      \"requirementIds\": [\"FR-31\", \"FR-45\"]","     },","     {","-      \"name\": \"dispatchEmails\",","-      \"module\": \"src/server/email/dispatch.ts\",","-      \"signature\": \"dispatchEmails(opts?: { batchSize?: number }): Promise<{ sent: number; failed: number; retried: number }>\",","-      \"notes\": \"Used by the dispatch route and scripts/worker-email.ts (15 s loop).\",","-      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-20\", \"NFR-4\", \"NFR-5\"]","-    },","-    {","-      \"name\": \"sendAuthEmail\",","-      \"module\": \"src/server/auth/email.ts\",","-      \"signature\": \"unchanged; the body now renders invite/password-reset and calls enqueueEmail(). It still throws on failure.\",","-      \"requirementIds\": [\"FR-16\", \"FR-4\"]","+      \"name\": \"validateSlot\",","+      \"module\": \"src/server/timetable/timetable-service.ts\",","+      \"signature\": \"validateSlot(input: { courseId; dayOfWeek; periodId; roomId: string | null; excludeSlotId?: string }, db?: Prisma.TransactionClient): Promise<Clash[]>\",","+      \"behaviour\": \"Returns ALL clashes; excludeSlotId removes the moving slot from comparison.\",","+      \"requirementIds\": [\"FR-14\"]","     }","   ],"," "]}],"originalFile":"{\n  \"ticketId\": \"SH-4\",\n  \"timestamp\": \"2026-11-04T12:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-13 forbids renaming routes)\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<item[]>\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"string\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404\n    },\n    \"pagination\": \"?page (default 1) & ?pageSize (default 20, max 100) via the existing parsePagination()\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody(zod from src/lib/validators/notifications.ts) → service → ok()/paginated(), all from src/server/http.ts. No new error codes.\",\n    \"middleware\": \"src/middleware.ts still returns 401 UNAUTHENTICATED for sessionless /api/* requests. '/api/internal/' is added to PUBLIC_API_PATHS (src/config/public-routes.ts) so cron can reach the dispatch route, where CRON_SECRET is the only gate.\",\n    \"requirementIds\": [\"NFR-8\", \"NFR-11\", \"NFR-13\", \"FR-41\"]\n  },\n\n  \"sharedSchemas\": {\n    \"Notification\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"type\", \"title\", \"body\", \"link\", \"readAt\", \"createdAt\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"type\": { \"type\": \"string\", \"description\": \"key of NOTIFICATION_TYPES\" },\n        \"category\": { \"type\": \"string\", \"enum\": [\"ACCOUNT\", \"ACADEMIC\", \"ATTENDANCE\", \"COMMUNICATION\", \"FINANCE\", \"SYSTEM\"], \"description\": \"derived from the registry and not stored\" },\n        \"title\": { \"type\": \"string\", \"maxLength\": 140 },\n        \"body\": { \"type\": [\"string\", \"null\"], \"maxLength\": 500 },\n        \"link\": { \"type\": [\"string\", \"null\"], \"description\": \"safe relative path (isSafeRelativeLink) or null\" },\n        \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"requirementIds\": [\"FR-1\", \"FR-3\", \"NFR-6\", \"NFR-18\"]\n    },\n    \"NotificationPreferenceItem\": {\n      \"type\": \"object\",\n      \"required\": [\"type\", \"label\", \"description\", \"category\", \"inApp\", \"email\", \"mandatoryInApp\"],\n      \"properties\": {\n        \"type\": { \"type\": \"string\" },\n        \"label\": { \"type\": \"string\" },\n        \"description\": { \"type\": \"string\" },\n        \"category\": { \"type\": \"string\", \"enum\": [\"ACCOUNT\", \"ACADEMIC\", \"ATTENDANCE\", \"COMMUNICATION\", \"FINANCE\", \"SYSTEM\"] },\n        \"inApp\": { \"type\": \"boolean\", \"description\": \"always true when mandatoryInApp\" },\n        \"email\": { \"type\": \"boolean\" },\n        \"mandatoryInApp\": { \"type\": \"boolean\" }\n      },\n      \"requirementIds\": [\"FR-7\", \"FR-28\", \"FR-29\", \"FR-37\"]\n    },\n    \"EmailLogItem\": {\n      \"type\": \"object\",\n      \"description\": \"EmailOutbox row WITHOUT html/text\",\n      \"required\": [\"id\", \"toEmail\", \"toName\", \"subject\", \"status\", \"attempts\", \"lastError\", \"nextAttemptAt\", \"sentAt\", \"createdAt\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"toEmail\": { \"type\": \"string\" },\n        \"toName\": { \"type\": [\"string\", \"null\"] },\n        \"subject\": { \"type\": \"string\" },\n        \"status\": { \"type\": \"string\", \"enum\": [\"PENDING\", \"SENDING\", \"SENT\", \"FAILED\"] },\n        \"attempts\": { \"type\": \"integer\" },\n        \"lastError\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 },\n        \"nextAttemptAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"sentAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"requirementIds\": [\"FR-31\", \"FR-39\"]\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/notifications\",\n      \"routeFile\": \"src/app/api/notifications/route.ts\",\n      \"description\": \"Paginated list of the caller's own notifications, newest first. 'unread=true' gives readAt IS NULL, and 'category' gives type IN typesInCategory(category).\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {\n        \"query\": {\n          \"unread\": { \"type\": \"string\", \"enum\": [\"true\", \"false\"], \"optional\": true },\n          \"category\": { \"type\": \"string\", \"enum\": [\"ACCOUNT\", \"ACADEMIC\", \"ATTENDANCE\", \"COMMUNICATION\", \"FINANCE\", \"SYSTEM\"], \"optional\": true },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Notification\" } }, \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-34\", \"FR-24\", \"FR-26\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/notifications/unread-count\",\n      \"routeFile\": \"src/app/api/notifications/unread-count/route.ts\",\n      \"description\": \"Count of the caller's unread notifications. It is index-only on [userId, readAt, createdAt], with a target under 50 ms, and the bell polls it every 30 s while the tab is visible.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"count\"], \"properties\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-35\", \"FR-22\", \"FR-23\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/read-all\",\n      \"routeFile\": \"src/app/api/notifications/read-all/route.ts\",\n      \"description\": \"Sets readAt = now on all of the caller's unread notifications. It is idempotent.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"count\"], \"properties\": { \"count\": { \"type\": \"integer\", \"description\": \"rows updated\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/{id}/read\",\n      \"routeFile\": \"src/app/api/notifications/[id]/read/route.ts\",\n      \"description\": \"Marks one notification read. It runs updateMany({ id, userId: me.id }), and a count of 0 returns 404 NOT_FOUND, so it never reveals other users' rows.\",\n      \"auth\": \"requireUser (owner only)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\"], \"properties\": { \"id\": { \"type\": \"string\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/{id}/unread\",\n      \"routeFile\": \"src/app/api/notifications/[id]/unread/route.ts\",\n      \"description\": \"Marks one notification unread (readAt = null). Same owner scoping and 404 rule as /read.\",\n      \"auth\": \"requireUser (owner only)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\"], \"properties\": { \"id\": { \"type\": \"string\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-36\", \"FR-26\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/notification-preferences\",\n      \"routeFile\": \"src/app/api/me/notification-preferences/route.ts\",\n      \"description\": \"Returns visibleTypesFor(me.role) (registry types with the caller's role, excluding emailOnly) merged with the caller's NotificationPreference rows through resolvePrefs. It is not paginated because the registry is small.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/NotificationPreferenceItem\" } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-37\", \"FR-7\", \"FR-28\", \"FR-29\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/me/notification-preferences\",\n      \"routeFile\": \"src/app/api/me/notification-preferences/route.ts\",\n      \"description\": \"Upserts one preference on userId_type. It returns VALIDATION_ERROR for an unknown type, an emailOnly type, a type not visible to the caller's role, or inApp=false on a mandatoryInApp type.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {\n        \"body\": {\n          \"type\": \"object\",\n          \"required\": [\"type\", \"inApp\", \"email\"],\n          \"additionalProperties\": false,\n          \"properties\": { \"type\": { \"type\": \"string\" }, \"inApp\": { \"type\": \"boolean\" }, \"email\": { \"type\": \"boolean\" } },\n          \"zod\": \"updatePreferenceBody (src/lib/validators/notifications.ts)\"\n        }\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/NotificationPreferenceItem\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-38\", \"FR-29\", \"FR-30\", \"FR-41\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/email-log\",\n      \"routeFile\": \"src/app/api/admin/email-log/route.ts\",\n      \"description\": \"Paginated EmailOutbox rows ordered by createdAt desc, with an optional status filter. The query never selects html or text.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"query\": {\n          \"status\": { \"type\": \"string\", \"enum\": [\"PENDING\", \"SENDING\", \"SENT\", \"FAILED\"], \"optional\": true },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/EmailLogItem\" } }, \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-39\", \"FR-31\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/email-log/{id}/retry\",\n      \"routeFile\": \"src/app/api/admin/email-log/[id]/retry/route.ts\",\n      \"description\": \"Resets a FAILED row with updateMany({ id, status: FAILED }, { attempts: 0, status: PENDING, nextAttemptAt: now, lastError: null }). A count of 0 (missing or not FAILED) returns 404 NOT_FOUND, so a double click is harmless.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\", \"status\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"status\": { \"const\": \"PENDING\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-32\", \"FR-39\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/notifications/test\",\n      \"routeFile\": \"src/app/api/admin/notifications/test/route.ts\",\n      \"description\": \"Calls notify({ type: 'system.test', userIds: [me.id], title: 'Test notification', link: '/dashboard', email: { template: 'generic-notification' } }) for the calling admin. notify() never throws, so the route always returns 200 once auth passes.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"ok\"], \"properties\": { \"ok\": { \"const\": true } } } },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-4\", \"FR-6\", \"NFR-8\", \"NFR-16\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"routeFile\": \"src/app/api/internal/email/dispatch/route.ts\",\n      \"description\": \"The cron entry point. It runs dispatchEmails({ batchSize: 50 }), then the best-effort purgeOldNotifications() at most once per 24 h per process (a purge failure never fails the response). It is public in middleware and gated only by the bearer token.\",\n      \"auth\": \"Authorization: Bearer ${CRON_SECRET}. The token is compared with crypto.timingSafeEqual, and an unset CRON_SECRET or a missing or wrong token returns 401 UNAUTHENTICATED.\",\n      \"requestSchema\": { \"headers\": { \"Authorization\": { \"type\": \"string\", \"pattern\": \"^Bearer .+$\" } } },\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"sent\", \"failed\", \"retried\"], \"properties\": { \"sent\": { \"type\": \"integer\" }, \"failed\": { \"type\": \"integer\" }, \"retried\": { \"type\": \"integer\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-19\", \"FR-17\", \"FR-18\", \"FR-27\", \"NFR-3\", \"NFR-4\", \"NFR-5\", \"NFR-8\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    {\n      \"name\": \"notify\",\n      \"module\": \"src/server/notifications/notify.ts\",\n      \"signature\": \"notify(input: { type: NotificationType; userIds: string[]; title: string; body?: string; link?: string; email?: { subject?: string; template: 'generic-notification'; data: Record<string, unknown> } }): Promise<void>\",\n      \"notes\": \"It never throws (FR-11). Call it after the caller's transaction commits. It truncates the title to 140 and the body to 500, and it drops an unsafe link.\",\n      \"requirementIds\": [\"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-9\", \"FR-10\", \"FR-11\", \"NFR-1\", \"NFR-6\", \"NFR-18\"]\n    },\n    {\n      \"name\": \"notifyStudentAndParents\",\n      \"module\": \"src/server/notifications/notify.ts\",\n      \"signature\": \"notifyStudentAndParents(input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] }): Promise<void>\",\n      \"requirementIds\": [\"FR-12\", \"NFR-14\"]\n    },\n    {\n      \"name\": \"dispatchEmails\",\n      \"module\": \"src/server/email/dispatch.ts\",\n      \"signature\": \"dispatchEmails(opts?: { batchSize?: number }): Promise<{ sent: number; failed: number; retried: number }>\",\n      \"notes\": \"Used by the dispatch route and scripts/worker-email.ts (15 s loop).\",\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-20\", \"NFR-4\", \"NFR-5\"]\n    },\n    {\n      \"name\": \"sendAuthEmail\",\n      \"module\": \"src/server/auth/email.ts\",\n      \"signature\": \"unchanged; the body now renders invite/password-reset and calls enqueueEmail(). It still throws on failure.\",\n      \"requirementIds\": [\"FR-16\", \"FR-4\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_018NCbEjypWRPe1E2psr3yGh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
