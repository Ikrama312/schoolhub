signment minus instructions, rubric and attachments, plus hasRubric.\",","+      \"type\": \"object\",","+      \"properties\": {","+        \"id\": { \"type\": \"string\" }, \"courseId\": { \"type\": \"string\" }, \"courseName\": { \"type\": \"string\" }, \"title\": { \"type\": \"string\" },","+        \"submissionType\": { \"$ref\": \"#/sharedSchemas/SubmissionType\" }, \"maxPoints\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","+        \"dueAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"availableFrom\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","+        \"status\": { \"$ref\": \"#/sharedSchemas/AssignmentStatus\" }, \"archivedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","+        \"hasRubric\": { \"type\": \"boolean\" }","+      }","+    },","+    \"ManagerCounts\": {","+      \"type\": \"object\",","+      \"properties\": {","+        \"enrolled\": { \"type\": \"integer\", \"description\": \"ACTIVE enrollments\" },","+        \"submitted\": { \"type\": \"integer\" },","+        \"graded\": { \"type\": \"integer\" },","+        \"returned\": { \"type\": \"integer\" },","+        \"exempt\": { \"type\": \"integer\" },","+        \"missing\": { \"type\": \"integer\", \"description\": \"missingWhere: visible, past due, not NO_SUBMISSION, no submission, not exempt (FR-35, FR-60)\" }","+      }","+    },","+    \"Submission\": {","+      \"description\": \"Full (manager) shape. Student/parent responses get the same shape through toStudentSubmission: grade fields null until RETURNED, history omitted.\",","+      \"type\": \"object\",","+      \"properties\": {","+        \"id\": { \"type\": \"string\" },","+        \"assignmentId\": { \"type\": \"string\" },","+        \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" },","+        \"status\": { \"$ref\": \"#/sharedSchemas/SubmissionStatus\" },","+        \"attemptNumber\": { \"type\": \"integer\", \"description\": \"0 = offline grade (FR-8)\" },","+        \"text\": { \"type\": \"string\", \"nullable\": true },","+        \"files\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/FileRef\" } },","+        \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" },","+        \"isLate\": { \"type\": \"boolean\" },","+        \"lateDays\": { \"type\": \"integer\" },","+        \"rawScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true },","+        \"penaltyPercent\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true },","+        \"finalScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true },","+        \"rubricScores\": { \"type\": \"array\", \"nullable\": true, \"items\": { \"$ref\": \"#/sharedSchemas/RubricScore\" } },","+        \"feedback\": { \"type\": \"string\", \"nullable\": true, \"description\": \"Markdown\" },","+        \"gradedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },","+        \"gradedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","+        \"returnedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","+        \"history\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SubmissionAttempt\" }, \"description\": \"Managers only (FR-55). Oldest first.\" }","+      }","+    },","+    \"SubmissionAttempt\": {","+      \"type\": \"object\",","+      \"properties\": {","+        \"attemptNumber\": { \"type\": \"integer\" },","+        \"text\": { \"type\": \"string\", \"nullable\": true },","+        \"files\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/FileRef\" } },","+        \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }","+      }","+    },","+    \"RubricScore\": {","+      \"type\": \"object\",","+      \"required\": [\"criterionId\", \"points\"],","+      \"properties\": { \"criterionId\": { \"type\": \"string\" }, \"points\": { \"$ref\": \"#/sharedSchemas/Decimal\" }, \"comment\": { \"type\": \"string\", \"maxLength\": 2000 } }","+    },","+    \"GradeInput\": {","+      \"description\": \"Zod gradeInput. With a rubric: rubricScores required, each criterion exactly once, 0 ≤ points ≤ criterion.maxPoints, server sets rawScore = Σ points and ignores any client rawScore (D7). Without a rubric: rawScore required, 0 ≤ rawScore ≤ maxPoints (×1.2 if allowExtraCredit) (FR-36). finalScore is always computed server-side (FR-31).\",","+      \"type\": \"object\",","+      \"required\": [\"penaltyPercent\"],","+      \"properties\": {","+        \"rawScore\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","+        \"penaltyPercent\": { \"description\": \"0–100; UI prefills grading-math.defaultPenalty\", \"$ref\": \"#/sharedSchemas/Decimal\" },","+        \"feedback\": { \"type\": \"string\", \"maxLength\": 10000 },","+        \"rubricScores\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RubricScore\" } },","+        \"return\": { \"type\": \"boolean\", \"default\": false, \"description\": \"'Save & return' in one transaction (D6).\" }","+      }","+    },","+    \"StudentAssignmentRow\": {","+      \"description\": \"Row for student/parent lists. submission is the toStudentSubmission shape without history or text/files (summary only).\",","+      \"type\": \"object\",","+      \"properties\": {","+        \"assignment\": { \"$ref\": \"#/sharedSchemas/AssignmentSummary\" },","+        \"group\": { \"type\": \"string\", \"enum\": [\"UPCOMING\", \"MISSING\", \"SUBMITTED\", \"RETURNED\"], \"description\": \"FR-18 'Past due' = MISSING. Exempt or NO_SUBMISSION assignments past due land in UPCOMING→ no; they are grouped as SUBMITTED=false/MISSING=false and shown under 'Past due' only if missingWhere matches. Exempt rows carry exempt=true and group = RETURNED if returned else UPCOMING when not yet due, otherwise SUBMITTED-less 'PAST' — see note.\" },","+        \"exempt\": { \"type\": \"boolean\" },","+        \"submission\": {","+          \"type\": \"object\", \"nullable\": true,","+          \"properties\": {","+            \"id\": { \"type\": \"string\" }, \"status\": { \"$ref\": \"#/sharedSchemas/SubmissionStatus\" }, \"attemptNumber\": { \"type\": \"integer\" },","+            \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"isLate\": { \"type\": \"boolean\" },","+            \"finalScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true }, \"returnedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true }","+          }","+        }","+      }","     }","   },","   \"endpoints\": [","     {","       \"method\": \"GET\",","-      \"path\": \"/api/attendance/today\",","-      \"description\": \"The teacher's meetings for today in the school timezone (getScheduleForDate) joined with today's sessions, with the current slot flagged. Includes daily homeroom entries when attendanceMode is DAILY_HOMEROOM or BOTH. Guard: requireRole('TEACHER','ADMIN'). An ADMIN gets [] meetings plus no homeroom entries unless they are a homeroom teacher.\",","-      \"requestSchema\": { \"query\": {} },","+      \"path\": \"/api/courses/{courseId}/assignments\",","+      \"description\": \"Role-shaped list for the course Assignments tab. Auth: requireUser + assertCanViewCourse. Managers (canSeeDrafts) get every status incl. archived, with counts (one groupBy). Students/parents get only visibleWhere(now) assignments with their own submission state; parents pass studentId (resolveViewedStudent; defaults to the only linked child). Read path fires publishOnce for newly visible SCHEDULED rows (fire-and-forget, FR-42). Sorted by dueAt asc.\",","+      \"query\": { \"studentId\": { \"type\": \"string\", \"description\": \"PARENT only; must be a linked child\" } },","+      \"requestSchema\": {},","       \"responseSchema\": {","-        \"data\": {","-          \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" },","-          \"meetings\": {","-            \"type\": \"array\",","-            \"items\": {","-              \"kind\": \"'course'\",","-              \"courseId\": \"string\",","-              \"courseName\": \"string\",","-              \"sectionName\": \"string\",","-              \"periodId\": \"string\",","-              \"periodName\": \"string\",","-              \"startTime\": \"HH:mm\",","-              \"endTime\": \"HH:mm\",","-              \"isCurrent\": \"boolean\",","-              \"taken\": \"null | { at: ISO date-time, by: UserRef }\"","-            }","-          },","-          \"dailyRegisters\": {","-            \"type\": \"array\",","-            \"items\": { \"kind\": \"'section'\", \"sectionId\": \"string\", \"sectionName\": \"string\", \"taken\": \"null | { at, by: UserRef }\" }","-          }","+        \"description\": \"{ data: ... }\",","+        \"oneOf\": [","+          { \"title\": \"manager\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"manager\" }, \"items\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/AssignmentSummary\" }], \"properties\": { \"counts\": { \"$ref\": \"#/sharedSchemas/ManagerCounts\" } } } } } },","+          { \"title\": \"student/parent\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"student\" }, \"studentId\": { \"type\": \"string\" }, \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentAssignmentRow\" } } } }","+        ]","+      },","+      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN (not in course / studentId not linked)\", \"NOT_FOUND (course)\"],","+      \"requirementIds\": [\"FR-48\", \"FR-17\", \"FR-18\", \"FR-13\", \"FR-42\", \"FR-52\", \"NFR-4\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/courses/{courseId}/assignments\",","+      \"description\": \"Create an assignment with optional rubric and attachments in one transaction. Auth: assertCanManageCourse. After commit, if visible now → publishOnce (assignment.published to ACTIVE-enrolled students). Audit assignment.create.\",","+      \"requestSchema\": { \"$ref\": \"#/sharedSchemas/AssignmentInput\" },","+      \"responseSchema\": { \"description\": \"201 { data: Assignment }\", \"$ref\": \"#/sharedSchemas/Assignment\" },","+      \"errors\": [\"VALIDATION_ERROR (Zod; 'Rubric totals {sum} points but the assignment is worth {maxPoints}.'; SCHEDULED with availableFrom ≤ now; attachment not owned/wrong context)\", \"FORBIDDEN\", \"NOT_FOUND (course)\"],","+      \"requirementIds\": [\"FR-49\", \"FR-7\", \"FR-9\", \"FR-11\", \"FR-12\", \"FR-42\", \"FR-59\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/assignments/{assignmentId}\",","+      \"description\": \"Assignment detail. Auth: requireUser + assertCanViewCourse. Non-managers get NOT_FOUND unless isAssignmentVisible. Students/parents also get their own submission (toStudentSubmission) and exemption flag. serverNow lets the client offset its countdown (display only, FR-19).\",","+      \"query\": { \"studentId\": { \"type\": \"string\", \"description\": \"PARENT only; must be a linked child\" } },","+      \"requestSchema\": {},","+      \"responseSchema\": {","+        \"type\": \"object\",","+        \"properties\": {","+          \"assignment\": { \"$ref\": \"#/sharedSchemas/Assignment\" },","+          \"canManage\": { \"type\": \"boolean\" },","+          \"submission\": { \"$ref\": \"#/sharedSchemas/Submission\", \"nullable\": true, \"description\": \"Student/parent only; serializer applied. Absent for managers.\" },","+          \"exempt\": { \"type\": \"boolean\", \"description\": \"Student/parent only\" },","+          \"submissionCount\": { \"type\": \"integer\", \"description\": \"Managers only; drives the FR-14 edit warning\" },","+          \"serverNow\": { \"type\": \"string\", \"format\": \"date-time\" }","         }","       },","-      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],","-      \"requirementIds\": [\"FR-6\", \"FR-7\", \"FR-35\"]","+      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-50\", \"FR-19\", \"FR-26\", \"FR-27\", \"FR-13\", \"FR-52\", \"NFR-2\", \"NFR-4\"]","     },","     {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/assignments/{assignmentId}\",","+      \"description\": \"Update an assignment. Auth: assertCanManageCourse. Body is a partial AssignmentInput (same superRefine on the merged result). attachmentFileIds is the full new set (removed files detached). If it becomes visible and notifiedAt is null → publishOnce. Client shows the FR-14 'review grades' banner if maxPoints changed and submissionCount > 0. Audit assignment.update.\",","+      \"requestSchema\": { \"description\": \"Partial<AssignmentInput>\", \"$ref\": \"#/sharedSchemas/AssignmentInput\" },","+      \"responseSchema\": { \"$ref\": \"#/sharedSchemas/Assignment\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-51\", \"FR-12\", \"FR-14\", \"FR-11\", \"FR-42\", \"FR-59\"]","+    },","+    {","+      \"method\": \"DELETE\",","+      \"path\": \"/api/assignments/{assignmentId}\",","+      \"description\": \"Hard delete (with rubric, attachments detached) when there are 0 submissions; otherwise set archivedAt. Auth: assertCanManageCourse. Audit assignment.delete | assignment.archive.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"result\": { \"type\": \"string\", \"enum\": [\"deleted\", \"archived\"] } } },","+      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-51\", \"FR-52\", \"FR-59\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/assignments/{assignmentId}/duplicate\",","+      \"description\": \"Copy as DRAFT to each target course. Auth: manage source course and assertCanManageCourse for every target (all checked before any write). Rubric copied as new rows; attachments re-saved as new FileObjects (context 'assignment'); same dueAt, availableFrom/lateCutoffAt keep offsets; notifiedAt null. One transaction per target. Audit assignment.duplicate.\",","+      \"requestSchema\": { \"type\": \"object\", \"required\": [\"courseIds\"], \"properties\": { \"courseIds\": { \"type\": \"array\", \"minItems\": 1, \"items\": { \"type\": \"string\" } } } },","+      \"responseSchema\": { \"description\": \"201\", \"type\": \"object\", \"properties\": { \"created\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"courseId\": { \"type\": \"string\" }, \"assignmentId\": { \"type\": \"string\" } } } } } },","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN (any target not managed)\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-15\", \"FR-59\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/attendance/register\",","-      \"description\": \"Load a course register (?courseId=&date=&periodId=) or daily register (?sectionId=&date=). Guard: requireUser, then assertCanManageCourse or assertCanManageSection (ADMIN or homeroom teacher). Future dates → 400; TEACHER more than 14 days back → 403 for opening (canOpen). Past the edit window → readOnly = true with readOnlyReason.\",","-      \"requestSchema\": { \"query\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" } },","-      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },","-      \"errors\": [\"VALIDATION_ERROR (bad key, future date)\", \"FORBIDDEN (no access, outside 14-day open window)\", \"NOT_FOUND (course/section/period)\"],","-      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-19\", \"FR-35\", \"NFR-3\", \"NFR-7\"]","+      \"path\": \"/api/assignments/{assignmentId}/submissions\",","+      \"description\": \"Grading roster: every ACTIVE-enrolled student, including those who have not submitted, with chip status, exemption and submission summary. Auth: assertCanManageCourse. Paginated (pageSize ≤ 100). Sort by name (default) or submittedAt; optional chip filter.\",","+      \"query\": {","+        \"page\": { \"type\": \"integer\", \"default\": 1 },","+        \"pageSize\": { \"type\": \"integer\", \"maximum\": 100, \"default\": 100 },","+        \"sort\": { \"type\": \"string\", \"enum\": [\"name\", \"submittedAt\"], \"default\": \"name\" },","+        \"status\": { \"$ref\": \"#/sharedSchemas/ChipStatus\" }","+      },","+      \"requestSchema\": {},","+      \"responseSchema\": {","+        \"description\": \"paginated envelope; data[] items:\",","+        \"type\": \"object\",","+        \"properties\": {","+          \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" },","+          \"chipStatus\": { \"$ref\": \"#/sharedSchemas/ChipStatus\" },","+          \"exempt\": { \"type\": \"boolean\" },","+          \"submission\": {","+            \"type\": \"object\", \"nullable\": true,","+            \"properties\": {","+              \"id\": { \"type\": \"string\" }, \"status\": { \"$ref\": \"#/sharedSchemas/SubmissionStatus\" }, \"attemptNumber\": { \"type\": \"integer\" },","+              \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"isLate\": { \"type\": \"boolean\" }, \"lateDays\": { \"type\": \"integer\" },","+              \"finalScore\": { \"$ref\": \"#/sharedSchemas/Decimal\", \"nullable\": true }, \"gradedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","+              \"returnedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true }","+            }","+          }","+        }","+      },","+      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-54\", \"FR-28\", \"FR-35\"]","     },","     {","-      \"method\": \"PUT\",","-      \"path\": \"/api/attendance/register\",","-      \"description\": \"Create or update the session and all records in one transaction (system-design §3.2). Records must cover the whole active roster and only roster students. After commit: audit('attendance.record.update') per changed status, and notifyStudentAndParents per transition into ABSENT/LATE or ABSENT→PRESENT (corrected). Re-saving unchanged statuses sends nothing. Idempotent: a P2002 race on the partial unique index re-reads the session rather than returning CONFLICT.\",","+      \"method\": \"POST\",","+      \"path\": \"/api/assignments/{assignmentId}/submissions\",","+      \"description\": \"Submit or resubmit. Auth: requireRole STUDENT. Server-clock checks in order (first failure wins): visible → ACTIVE-enrolled → not exempt and type ≠ NO_SUBMISSION → deadline/late cutoff → content matches type and fileIds ≤ maxFileCount → each file owned by caller, context 'submission', unattached or already on this submission. Resubmit (status SUBMITTED, incl. attempt-0 offline row) snapshots SubmissionHistory, increments attemptNumber, clears grade fields. Returns 201 on first submit, 200 on resubmit.\",","       \"requestSchema\": {","-        \"body\": {","-          \"description\": \"Zod registerPutBody = RegisterKey & { records }\",","-          \"allOf\": [","-            { \"$ref\": \"#/sharedSchemas/RegisterKey\" },","-            { \"type\": \"object\", \"required\": [\"records\"], \"properties\": { \"records\": { \"type\": \"array\", \"minItems\": 1, \"uniqueBy\": \"studentId\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" } } } }","-          ]","+        \"type\": \"object\",","+        \"properties\": {","+          \"text\": { \"type\": \"string\", \"maxLength\": 50000 },","+          \"fileIds\": { \"type\": \"array\", \"maxItems\": 10, \"items\": { \"type\": \"string\" }, \"default\": [] }","         }","       },","-      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },","+      \"responseSchema\": { \"description\": \"Receipt: toStudentSubmission shape (grade fields null).\", \"$ref\": \"#/sharedSchemas/Submission\" },","       \"errors\": [","-        \"VALIDATION_ERROR (schema; future date; studentId not active on date → details.invalidStudentIds; roster not fully marked → details.missingStudentIds)\",","-        \"FORBIDDEN (no access; TEACHER past 14-day edit window; EXCUSED by non-ADMIN)\",","-        \"NOT_FOUND\"","+        \"NOT_FOUND (assignment not visible)\",","+        \"FORBIDDEN (not STUDENT / not ACTIVE-enrolled)\",","+        \"VALIDATION_ERROR (exempt; NO_SUBMISSION; 'The deadline has passed and late submissions are closed.'; missing text/files for type; too many files; file not yours / wrong context)\",","+        \"CONFLICT ('This submission has been returned and can no longer be changed.')\"","       ],","-      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"FR-35\", \"FR-36\", \"NFR-1\", \"NFR-3\", \"NFR-5\", \"NFR-7\"]","+      \"requirementIds\": [\"FR-53\", \"FR-22\", \"FR-23\", \"FR-24\", \"FR-35\", \"FR-60\", \"FR-7\", \"NFR-2\", \"FR-59\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/students/{studentId}/attendance\",","-      \"description\": \"Student attendance tab data in one indexed query. Guard: requireUser + assertCanViewStudent (parent → linked students, student → self, teacher/admin per existing rules). Session kind follows attendanceMode (course sessions for PER_PERIOD/BOTH, section sessions for DAILY_HOMEROOM). `note` is omitted from rows for STUDENT and PARENT. from/to default to the current month; summaries always cover the current term and academic year regardless of from/to.\",","-      \"requestSchema\": { \"path\": { \"studentId\": \"string\" }, \"query\": { \"from\": \"DateOnly?\", \"to\": \"DateOnly?\" } },","+      \"method\": \"POST\",","+      \"path\": \"/api/assignments/{assignmentId}/return\",","+      \"description\": \"Bulk 'Return all graded'. Auth: assertCanManageCourse. Default set = gradedAt != null AND status SUBMITTED. Supplied ids that are ungraded/already returned/not in this assignment are skipped and reported. One updateMany, then notifyStudentAndParents(assignment.returned) per student and one audit row per submission.\",","+      \"requestSchema\": { \"type\": \"object\", \"properties\": { \"submissionIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } } },","       \"responseSchema\": {","-        \"data\": {","-          \"summary\": { \"term\": { \"$ref\": \"#/sharedSchemas/StatusCounts\", \"termName\": \"string|null\" }, \"year\": { \"$ref\": \"#/sharedSchemas/StatusCounts\" } },","-          \"calendar\": { \"type\": \"array\", \"items\": { \"date\": \"DateOnly\", \"colour\": \"'success'|'warning'|'error'|'default'\", \"present\": \"int\", \"absent\": \"int\", \"late\": \"int\", \"excused\": \"int\" } },","-          \"records\": {","-            \"type\": \"array\",","-            \"items\": { \"id\": \"string\", \"date\": \"DateOnly\", \"periodName\": \"string|null\", \"courseName\": \"string|null\", \"sectionName\": \"string|null\", \"status\": \"AttendanceStatus\", \"minutesLate\": \"int|null\", \"note\": \"string|null (absent key for STUDENT/PARENT)\" }","-          }","+        \"type\": \"object\",","+        \"properties\": {","+          \"returned\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },","+          \"skipped\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"submissionId\": { \"type\": \"string\" }, \"reason\": { \"type\": \"string\", \"enum\": [\"NOT_GRADED\", \"ALREADY_RETURNED\", \"NOT_FOUND\"] } } } }","         }","       },","       \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-35\", \"NFR-1\", \"NFR-7\"]","+      \"requirementIds\": [\"FR-32\", \"FR-44\", \"FR-59\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/courses/{courseId}/attendance\",","-      \"description\": \"Course attendance matrix: the last 20 sessions by date (columns) × enrolled students (ACTIVE, plus DROPPED students with records) with P/A/L/E cells and per-student rate. Guard: requireUser + assertCanManageCourse.\",","-      \"requestSchema\": { \"path\": { \"courseId\": \"string\" }, \"query\": {} },","-      \"responseSchema\": {","-        \"data\": {","-          \"sessions\": { \"type\": \"array\", \"items\": { \"sessionId\": \"string\", \"date\": \"DateOnly\", \"periodId\": \"string\", \"periodName\": \"string\" } },","-          \"students\": {","-            \"type\": \"array\",","-            \"items\": { \"studentId\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"enrollmentStatus\": \"'ACTIVE'|'DROPPED'\", \"cells\": \"{ [sessionId]: AttendanceStatus }\", \"rate\": \"number|null\" }","-          }","+      \"method\": \"POST\",","+      \"path\": \"/api/assignments/{assignmentId}/grade-offline\",","+      \"description\": \"'Grade without submission'. Auth: assertCanManageCourse. Student must be ACTIVE-enrolled with no existing submission. Creates the attemptNumber 0 Submission (text null, no files, submittedAt = gradedAt, penalty 0) using the same rubric/raw-score validation as PUT /grade. return:true also returns it. Audit submission.grade_offline.\",","+      \"requestSchema\": {","+        \"type\": \"object\",","+        \"required\": [\"studentId\"],","+        \"properties\": {","+          \"studentId\": { \"type\": \"string\" },","+          \"rawScore\": { \"$ref\": \"#/sharedSchemas/Decimal\" },","+          \"feedback\": { \"type\": \"string\", \"maxLength\": 10000 },","+          \"rubricScores\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RubricScore\" } },","+          \"return\": { \"type\": \"boolean\", \"default\": false }","         }","       },","+      \"responseSchema\": { \"description\": \"201\", \"$ref\": \"#/sharedSchemas/Submission\" },","+      \"errors\": [\"VALIDATION_ERROR (score out of range / rubric incomplete / student not enrolled)\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT (submission already exists — grade that one)\"],","+      \"requirementIds\": [\"FR-34\", \"FR-8\", \"FR-36\", \"FR-59\"]","+    },","+    {","+      \"method\": \"PUT\",","+      \"path\": \"/api/assignments/{assignmentId}/exemptions/{studentId}\",","+      \"description\": \"Exempt a student (idempotent upsert of GradeExemption). Auth: assertCanManageCourse; student must be enrolled. Effects: removed from missing, no reminders, cannot submit; row is the PRD-11 exclusion flag. Audit assignment.exempt.\",","+      \"requestSchema\": { \"type\": \"object\", \"properties\": { \"reason\": { \"type\": \"string\", \"maxLength\": 500 } } },","+      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"assignmentId\": { \"type\": \"string\" }, \"studentId\": { \"type\": \"string\" }, \"exempt\": { \"const\": true }, \"reason\": { \"type\": \"string\", \"nullable\": true } } },","+      \"errors\": [\"VALIDATION_ERROR (student not enrolled)\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-35\", \"FR-5\", \"FR-59\"]","+    },","+    {","+      \"method\": \"DELETE\",","+      \"path\": \"/api/assignments/{assignmentId}/exemptions/{studentId}\",","+      \"description\": \"Remove an exemption (idempotent deleteMany). Auth: assertCanManageCourse. Audit assignment.unexempt.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"assignmentId\": { \"type\": \"string\" }, \"studentId\": { \"type\": \"string\" }, \"exempt\": { \"const\": false } } },","       \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-28\", \"FR-29\", \"FR-35\", \"NFR-7\"]","+      \"requirementIds\": [\"FR-35\", \"FR-59\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/admin/attendance/overview\",","-      \"description\": \"Today overview: expected meetings (getSchoolScheduleForDate + homeroom sections when mode includes daily) vs taken sessions, the school-wide rate for the date, and missing registers (no session and period.startTime + 15 min ≤ now in school tz; only computed when date is today). Guard: requireRole('ADMIN').\",","-      \"requestSchema\": { \"query\": { \"date\": \"DateOnly? (default school today; future → 400)\" } },","-      \"responseSchema\": {","-        \"data\": {","-          \"date\": \"DateOnly\",","-          \"expected\": \"int\",","-          \"taken\": \"int\",","-          \"rate\": \"number|null\",","-          \"missing\": {","-            \"type\": \"array\",","-            \"items\": { \"courseId\": \"string\", \"courseName\": \"string\", \"sectionName\": \"string\", \"periodId\": \"string\", \"periodName\": \"string\", \"startTime\": \"HH:mm\", \"teacher\": \"UserRef\" }","-          }","-        }","-      },","-      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],","-      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-35\", \"NFR-7\"]","+      \"path\": \"/api/submissions/{submissionId}\",","+      \"description\": \"Submission detail for the grading main panel and student/parent results. Auth: submitting student, linked parent, or course manager; anyone else NOT_FOUND. Managers get the full shape incl. history (with files); student/parent get toStudentSubmission. Grading page caches and prefetches next/prev (NFR-3).\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"$ref\": \"#/sharedSchemas/Submission\" },","+      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-55\", \"FR-29\", \"FR-26\", \"FR-27\", \"NFR-3\", \"NFR-4\"]","     },","     {","+      \"method\": \"PUT\",","+      \"path\": \"/api/submissions/{submissionId}/grade\",","+      \"description\": \"Save a grade (status stays SUBMITTED, invisible to student) or Save & return (return:true → RETURNED + returnedAt in the same transaction, then notifyStudentAndParents(assignment.returned, 'Course: Title — {final}/{max}')). Auth: assertCanManageCourse. Server computes rawScore (rubric) and finalScore = computeFinalScore(raw, penalty). Re-grading a RETURNED submission is allowed and keeps it RETURNED. Audit submission.grade (+ submission.return).\",","+      \"requestSchema\": { \"$ref\": \"#/sharedSchemas/GradeInput\" },","+      \"responseSchema\": { \"description\": \"Full manager shape\", \"$ref\": \"#/sharedSchemas/Submission\" },","+      \"errors\": [\"VALIDATION_ERROR (score/penalty range; rubric scores missing, duplicated or over criterion max)\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-56\", \"FR-30\", \"FR-31\", \"FR-32\", \"FR-36\", \"FR-44\", \"FR-59\", \"NFR-1\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/admin/attendance/report\",","-      \"description\": \"Per-student summary over the filtered range (groupBy studentId, status). JSON is paginated (pageSize ≤ 100). With ?format=csv returns every row as text/csv (Content-Disposition: attachment; filename=attendance-report-<from>-<to>.csv) via toCsv, with columns: Student, Section, Grade, Records, Present, Absent, Late, Excused, Rate. Guard: requireRole('ADMIN').\",","-      \"requestSchema\": {","-        \"query\": {","-          \"from\": \"DateOnly (required)\",","-          \"to\": \"DateOnly (required, ≥ from, range ≤ 366 days)\",","-          \"gradeLevelId\": \"string?\",","-          \"sectionId\": \"string?\",","-          \"courseId\": \"string?\",","-          \"status\": \"AttendanceStatus? (only students with ≥1 record of this status)\",","-          \"format\": \"'csv'?\",","-          \"page\": \"int? (default 1, ignored for csv)\",","-          \"pageSize\": \"int? (default 20, max 100, ignored for csv)\"","-        }","+      \"path\": \"/api/me/assignments\",","+      \"description\": \"Data for /assignments. STUDENT: own rows across ACTIVE enrollments, filtered by tab (UPCOMING sorted by dueAt asc; MISSING = missingWhere; SUBMITTED; RETURNED) and courseId. PARENT: same, for studentId (linked child; defaults to the only child). TEACHER: 'To grade' = SUBMITTED, ungraded submissions in courses where teacherId or coTeacherIds includes them, oldest submittedAt first. ADMIN: 'To grade' across all courses. Fires publishOnce for newly visible SCHEDULED rows (student/parent).\",","+      \"query\": {","+        \"studentId\": { \"type\": \"string\", \"description\": \"PARENT only\" },","+        \"tab\": { \"type\": \"string\", \"enum\": [\"UPCOMING\", \"MISSING\", \"SUBMITTED\", \"RETURNED\"], \"default\": \"UPCOMING\", \"description\": \"STUDENT/PARENT only\" },","+        \"courseId\": { \"type\": \"string\" }","       },","+      \"requestSchema\": {},","       \"responseSchema\": {","-        \"json\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" } }, \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },","-        \"csv\": \"text/csv; charset=utf-8\"","+        \"oneOf\": [","+          { \"title\": \"student/parent\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"student\" }, \"studentId\": { \"type\": \"string\" }, \"children\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/UserRef\" }, \"description\": \"PARENT only, for the child selector\" }, \"courses\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } }, \"description\": \"for the course filter\" }, \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentAssignmentRow\" } } } },","+          { \"title\": \"to-grade (TEACHER/ADMIN)\", \"type\": \"object\", \"properties\": { \"view\": { \"const\": \"toGrade\" }, \"items\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"submissionId\": { \"type\": \"string\" }, \"assignment\": { \"$ref\": \"#/sharedSchemas/AssignmentSummary\" }, \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" }, \"submittedAt\": { \"type\": \"string\", \"format\": \"date-time\" }, \"isLate\": { \"type\": \"boolean\" } } } } } }","+        ]","       },","-      \"errors\": [\"VALIDATION_ERROR (range > 366 days, to < from)\", \"FORBIDDEN\"],","-      \"requirementIds\": [\"FR-32\", \"FR-35\", \"FR-36\", \"NFR-8\"]","+      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN (studentId not a linked child)\"],","+      \"requirementIds\": [\"FR-57\", \"FR-37\", \"FR-38\", \"FR-39\", \"FR-35\", \"FR-60\", \"FR-42\", \"NFR-4\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/admin/attendance/below-threshold\",","-      \"description\": \"Students whose year-to-date rate is below SchoolSettings.attendanceAlertThreshold, sorted by rate ascending. Paginated (pageSize ≤ 100). Guard: requireRole('ADMIN').\",","-      \"requestSchema\": { \"query\": { \"page\": \"int?\", \"pageSize\": \"int? (max 100)\" } },","+      \"path\": \"/api/students/{studentId}/assignments\",","+      \"description\": \"Per-student assignment list across the student's ACTIVE enrollments (students/[id]/assignments page). Auth: assertCanViewStudent. Per course: viewers who manage that course get full grade fields; everyone else gets toStudentSubmission (D8). Only visible, non-archived assignments.\",","+      \"query\": { \"courseId\": { \"type\": \"string\" } },","+      \"requestSchema\": {},","       \"responseSchema\": {","-        \"data\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" }, { \"href\": \"/students/<id>/attendance\" }] } },","-        \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\", \"threshold\": \"int\" }","-      },","-      \"errors\": [\"FORBIDDEN\"],","-      \"requirementIds\": [\"FR-33\", \"FR-35\", \"NFR-8\"]","-    },","-    {","-      \"method\": \"POST\",","-      \"path\": \"/api/admin/attendance/remind\",","-      \"description\": \"Send 'attendance.register_missing' to the course teacher (notify, link /attendance/take/<courseId>?date=&periodId=), then audit('attendance.remind'). Guard: requireRole('ADMIN'). Returns 200 even if the notification fails to enqueue, because notify never throws.\",","-      \"requestSchema\": { \"body\": { \"type\": \"object\", \"required\": [\"courseId\", \"periodId\", \"date\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"periodId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } } },","-      \"responseSchema\": { \"data\": { \"reminded\": { \"$ref\": \"#/sharedSchemas/UserRef\" } } },","-      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND (course/period)\"],","-      \"requirementIds\": [\"FR-23\", \"FR-31\", \"FR-35\"]","-    },","-    {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/settings/school\",","-      \"description\": \"Minimal school settings update for this PRD: only the attendance fields (FR-5 default; the user may override this). Built on updateSchoolSettings() and writes audit('school_settings.update', { old, new }). Guard: requireRole('ADMIN'). Unknown keys are rejected (strict schema) so this route cannot widen scope.\",","-      \"requestSchema\": {","-        \"body\": {","-          \"description\": \"Zod attendanceSettingsPatch (strict). At least one field.\",","-          \"type\": \"object\",","-          \"minProperties\": 1,","-          \"additionalProperties\": false,","-          \"properties\": { \"attendanceMode\": { \"$ref\": \"#/sharedSchemas/AttendanceMode\" }, \"attendanceAlertThreshold\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 } }","+        \"type\": \"object\",","+        \"properties\": {","+          \"student\": { \"$ref\": \"#/sharedSchemas/UserRef\" },","+          \"items\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentAssignmentRow\" }], \"properties\": { \"canManage\": { \"type\": \"boolean\" } } } }","         }","       },","-      \"responseSchema\": { \"data\": { \"attendanceMode\": \"AttendanceMode\", \"attendanceAlertThreshold\": \"int\" } },","-      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],","-      \"requirementIds\": [\"FR-4\", \"FR-5\", \"NFR-8\"]","+      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND (student)\"],","+      \"requirementIds\": [\"FR-58\", \"FR-41\", \"FR-27\", \"NFR-4\"]","     }","   ],","+  \"reusedEndpoints\": [","+    { \"method\": \"POST\", \"path\": \"/api/files\", \"note\": \"Unchanged. Clients upload with context 'assignment' (authoring) or 'submission' (student) before referencing fileIds.\", \"requirementIds\": [\"FR-9\", \"FR-20\", \"FR-47\"] },","+    { \"method\": \"GET\", \"path\": \"/api/files/{id}?inline=1\", \"note\": \"Unchanged handler; new resolvers assignmentResolver/submissionResolver in src/server/files/contexts.ts. Header change D11 (X-Frame-Options SAMEORIGIN for this path only) enables PDF iframe preview.\", \"requirementIds\": [\"FR-29\", \"FR-47\", \"NFR-4\"] },","+    { \"method\": \"POST\", \"path\": \"/api/internal/email/dispatch\", \"note\": \"Unchanged contract; now also calls sendDueReminders(now) on every request (due_soon, missing).\", \"requirementIds\": [\"FR-43\", \"FR-45\", \"FR-6\"] }","+  ],","   \"status\": \"complete\""," }"]}],"originalFile":"{\n  \"ticketId\": \"SH-7\",\n  \"timestamp\": \"2026-11-06T06:45:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-10 forbids renaming routes)\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/attendance.ts) → resource assert → attendance-service → ok()/paginated(). Every helper comes from src/server/http.ts (system-design §3.1).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },\n    \"validationErrorDetails\": \"A ZodError maps to VALIDATION_ERROR with details = zod flatten() { formErrors, fieldErrors }. Service-raised NFR-3 roster errors use details { invalidStudentIds: string[] } or { missingStudentIds: string[] }.\",\n    \"dates\": \"Date-only values are 'yyyy-MM-dd' strings interpreted in SchoolSettings.timezone. Timestamps are ISO 8601 UTC. Display uses formatInSchoolTz (ADR-5).\",\n    \"ids\": \"All ids are cuid strings.\",\n    \"requirementIds\": [\"FR-35\", \"FR-36\", \"NFR-7\", \"NFR-8\"]\n  },\n  \"sharedSchemas\": {\n    \"DateOnly\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n    \"AttendanceStatus\": { \"type\": \"string\", \"enum\": [\"PRESENT\", \"ABSENT\", \"LATE\", \"EXCUSED\"] },\n    \"AttendanceMode\": { \"type\": \"string\", \"enum\": [\"PER_PERIOD\", \"DAILY_HOMEROOM\", \"BOTH\"] },\n    \"RegisterKey\": {\n      \"description\": \"Zod union registerQuery (C6). Course variant or section (daily) variant; exactly one (FR-2).\",\n      \"oneOf\": [\n        { \"type\": \"object\", \"required\": [\"courseId\", \"date\", \"periodId\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" }, \"periodId\": { \"type\": \"string\" } } },\n        { \"type\": \"object\", \"required\": [\"sectionId\", \"date\"], \"properties\": { \"sectionId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } }\n      ]\n    },\n    \"RegisterRecordInput\": {\n      \"description\": \"Zod registerRecord (C6). minutesLate is required (1–240) iff status = LATE and forbidden otherwise (superRefine). EXCUSED is ADMIN-only, checked in the service (FR-10).\",\n      \"type\": \"object\",\n      \"required\": [\"studentId\", \"status\"],\n      \"properties\": {\n        \"studentId\": { \"type\": \"string\" },\n        \"status\": { \"$ref\": \"#/sharedSchemas/AttendanceStatus\" },\n        \"minutesLate\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 240 },\n        \"note\": { \"type\": \"string\", \"maxLength\": 500 }\n      }\n    },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n    \"Register\": {\n      \"description\": \"Returned by GET and PUT /api/attendance/register.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"key\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n        \"header\": { \"type\": \"object\", \"properties\": { \"courseName\": { \"type\": \"string|null\" }, \"sectionName\": { \"type\": \"string\" }, \"periodName\": { \"type\": \"string|null\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } },\n        \"sessionId\": { \"type\": \"string|null\", \"description\": \"null when no register has been saved yet\" },\n        \"students\": {\n          \"type\": \"array\",\n          \"description\": \"Roster active on the date, sorted by last name (FR-9, NFR-3)\",\n          \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" }, \"avatarUrl\": { \"type\": \"string|null\" } } }\n        },\n        \"records\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" }, \"description\": \"Existing records; empty for a new register (nothing preselected, FR-9)\" },\n        \"takenBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"readOnly\": { \"type\": \"boolean\" },\n        \"readOnlyReason\": { \"type\": \"string|null\", \"description\": \"e.g. 'Teachers can edit registers up to 14 days after the register date' (FR-19)\" },\n        \"canExcuse\": { \"type\": \"boolean\", \"description\": \"true only for ADMIN (FR-10)\" }\n      }\n    },\n    \"StatusCounts\": { \"type\": \"object\", \"properties\": { \"records\": { \"type\": \"integer\" }, \"present\": { \"type\": \"integer\" }, \"absent\": { \"type\": \"integer\" }, \"late\": { \"type\": \"integer\" }, \"excused\": { \"type\": \"integer\" }, \"rate\": { \"type\": \"number|null\", \"description\": \"(P+L+E)/records×100, 1 dp; null when records = 0 (FR-28)\" } } },\n    \"StudentSummaryRow\": {\n      \"allOf\": [\n        { \"type\": \"object\", \"properties\": { \"studentId\": { \"type\": \"string\" }, \"studentName\": { \"type\": \"string\" }, \"sectionName\": { \"type\": \"string|null\" }, \"gradeLevelName\": { \"type\": \"string|null\" } } },\n        { \"$ref\": \"#/sharedSchemas/StatusCounts\" }\n      ]\n    }\n  },\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/today\",\n      \"description\": \"The teacher's meetings for today in the school timezone (getScheduleForDate) joined with today's sessions, with the current slot flagged. Includes daily homeroom entries when attendanceMode is DAILY_HOMEROOM or BOTH. Guard: requireRole('TEACHER','ADMIN'). An ADMIN gets [] meetings plus no homeroom entries unless they are a homeroom teacher.\",\n      \"requestSchema\": { \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" },\n          \"meetings\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"kind\": \"'course'\",\n              \"courseId\": \"string\",\n              \"courseName\": \"string\",\n              \"sectionName\": \"string\",\n              \"periodId\": \"string\",\n              \"periodName\": \"string\",\n              \"startTime\": \"HH:mm\",\n              \"endTime\": \"HH:mm\",\n              \"isCurrent\": \"boolean\",\n              \"taken\": \"null | { at: ISO date-time, by: UserRef }\"\n            }\n          },\n          \"dailyRegisters\": {\n            \"type\": \"array\",\n            \"items\": { \"kind\": \"'section'\", \"sectionId\": \"string\", \"sectionName\": \"string\", \"taken\": \"null | { at, by: UserRef }\" }\n          }\n        }\n      },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-6\", \"FR-7\", \"FR-35\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Load a course register (?courseId=&date=&periodId=) or daily register (?sectionId=&date=). Guard: requireUser, then assertCanManageCourse or assertCanManageSection (ADMIN or homeroom teacher). Future dates → 400; TEACHER more than 14 days back → 403 for opening (canOpen). Past the edit window → readOnly = true with readOnlyReason.\",\n      \"requestSchema\": { \"query\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" } },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\"VALIDATION_ERROR (bad key, future date)\", \"FORBIDDEN (no access, outside 14-day open window)\", \"NOT_FOUND (course/section/period)\"],\n      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-19\", \"FR-35\", \"NFR-3\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Create or update the session and all records in one transaction (system-design §3.2). Records must cover the whole active roster and only roster students. After commit: audit('attendance.record.update') per changed status, and notifyStudentAndParents per transition into ABSENT/LATE or ABSENT→PRESENT (corrected). Re-saving unchanged statuses sends nothing. Idempotent: a P2002 race on the partial unique index re-reads the session rather than returning CONFLICT.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod registerPutBody = RegisterKey & { records }\",\n          \"allOf\": [\n            { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n            { \"type\": \"object\", \"required\": [\"records\"], \"properties\": { \"records\": { \"type\": \"array\", \"minItems\": 1, \"uniqueBy\": \"studentId\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" } } } }\n          ]\n        }\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\n        \"VALIDATION_ERROR (schema; future date; studentId not active on date → details.invalidStudentIds; roster not fully marked → details.missingStudentIds)\",\n        \"FORBIDDEN (no access; TEACHER past 14-day edit window; EXCUSED by non-ADMIN)\",\n        \"NOT_FOUND\"\n      ],\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"FR-35\", \"FR-36\", \"NFR-1\", \"NFR-3\", \"NFR-5\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/{studentId}/attendance\",\n      \"description\": \"Student attendance tab data in one indexed query. Guard: requireUser + assertCanViewStudent (parent → linked students, student → self, teacher/admin per existing rules). Session kind follows attendanceMode (course sessions for PER_PERIOD/BOTH, section sessions for DAILY_HOMEROOM). `note` is omitted from rows for STUDENT and PARENT. from/to default to the current month; summaries always cover the current term and academic year regardless of from/to.\",\n      \"requestSchema\": { \"path\": { \"studentId\": \"string\" }, \"query\": { \"from\": \"DateOnly?\", \"to\": \"DateOnly?\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"summary\": { \"term\": { \"$ref\": \"#/sharedSchemas/StatusCounts\", \"termName\": \"string|null\" }, \"year\": { \"$ref\": \"#/sharedSchemas/StatusCounts\" } },\n          \"calendar\": { \"type\": \"array\", \"items\": { \"date\": \"DateOnly\", \"colour\": \"'success'|'warning'|'error'|'default'\", \"present\": \"int\", \"absent\": \"int\", \"late\": \"int\", \"excused\": \"int\" } },\n          \"records\": {\n            \"type\": \"array\",\n            \"items\": { \"id\": \"string\", \"date\": \"DateOnly\", \"periodName\": \"string|null\", \"courseName\": \"string|null\", \"sectionName\": \"string|null\", \"status\": \"AttendanceStatus\", \"minutesLate\": \"int|null\", \"note\": \"string|null (absent key for STUDENT/PARENT)\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-35\", \"NFR-1\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/{courseId}/attendance\",\n      \"description\": \"Course attendance matrix: the last 20 sessions by date (columns) × enrolled students (ACTIVE, plus DROPPED students with records) with P/A/L/E cells and per-student rate. Guard: requireUser + assertCanManageCourse.\",\n      \"requestSchema\": { \"path\": { \"courseId\": \"string\" }, \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"sessions\": { \"type\": \"array\", \"items\": { \"sessionId\": \"string\", \"date\": \"DateOnly\", \"periodId\": \"string\", \"periodName\": \"string\" } },\n          \"students\": {\n            \"type\": \"array\",\n            \"items\": { \"studentId\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"enrollmentStatus\": \"'ACTIVE'|'DROPPED'\", \"cells\": \"{ [sessionId]: AttendanceStatus }\", \"rate\": \"number|null\" }\n          }\n        }\n      },\n      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-28\", \"FR-29\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/overview\",\n      \"description\": \"Today overview: expected meetings (getSchoolScheduleForDate + homeroom sections when mode includes daily) vs taken sessions, the school-wide rate for the date, and missing registers (no session and period.startTime + 15 min ≤ now in school tz; only computed when date is today). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"date\": \"DateOnly? (default school today; future → 400)\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": \"DateOnly\",\n          \"expected\": \"int\",\n          \"taken\": \"int\",\n          \"rate\": \"number|null\",\n          \"missing\": {\n            \"type\": \"array\",\n            \"items\": { \"courseId\": \"string\", \"courseName\": \"string\", \"sectionName\": \"string\", \"periodId\": \"string\", \"periodName\": \"string\", \"startTime\": \"HH:mm\", \"teacher\": \"UserRef\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/report\",\n      \"description\": \"Per-student summary over the filtered range (groupBy studentId, status). JSON is paginated (pageSize ≤ 100). With ?format=csv returns every row as text/csv (Content-Disposition: attachment; filename=attendance-report-<from>-<to>.csv) via toCsv, with columns: Student, Section, Grade, Records, Present, Absent, Late, Excused, Rate. Guard: requireRole('ADMIN').\",\n      \"requestSchema\": {\n        \"query\": {\n          \"from\": \"DateOnly (required)\",\n          \"to\": \"DateOnly (required, ≥ from, range ≤ 366 days)\",\n          \"gradeLevelId\": \"string?\",\n          \"sectionId\": \"string?\",\n          \"courseId\": \"string?\",\n          \"status\": \"AttendanceStatus? (only students with ≥1 record of this status)\",\n          \"format\": \"'csv'?\",\n          \"page\": \"int? (default 1, ignored for csv)\",\n          \"pageSize\": \"int? (default 20, max 100, ignored for csv)\"\n        }\n      },\n      \"responseSchema\": {\n        \"json\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" } }, \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n        \"csv\": \"text/csv; charset=utf-8\"\n      },\n      \"errors\": [\"VALIDATION_ERROR (range > 366 days, to < from)\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-32\", \"FR-35\", \"FR-36\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/below-threshold\",\n      \"description\": \"Students whose year-to-date rate is below SchoolSettings.attendanceAlertThreshold, sorted by rate ascending. Paginated (pageSize ≤ 100). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"page\": \"int?\", \"pageSize\": \"int? (max 100)\" } },\n      \"responseSchema\": {\n        \"data\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" }, { \"href\": \"/students/<id>/attendance\" }] } },\n        \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\", \"threshold\": \"int\" }\n      },\n      \"errors\": [\"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-35\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/attendance/remind\",\n      \"description\": \"Send 'attendance.register_missing' to the course teacher (notify, link /attendance/take/<courseId>?date=&periodId=), then audit('attendance.remind'). Guard: requireRole('ADMIN'). Returns 200 even if the notification fails to enqueue, because notify never throws.\",\n      \"requestSchema\": { \"body\": { \"type\": \"object\", \"required\": [\"courseId\", \"periodId\", \"date\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"periodId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } } },\n      \"responseSchema\": { \"data\": { \"reminded\": { \"$ref\": \"#/sharedSchemas/UserRef\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND (course/period)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-31\", \"FR-35\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/settings/school\",\n      \"description\": \"Minimal school settings update for this PRD: only the attendance fields (FR-5 default; the user may override this). Built on updateSchoolSettings() and writes audit('school_settings.update', { old, new }). Guard: requireRole('ADMIN'). Unknown keys are rejected (strict schema) so this route cannot widen scope.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod attendanceSettingsPatch (strict). At least one field.\",\n          \"type\": \"object\",\n          \"minProperties\": 1,\n          \"additionalProperties\": false,\n          \"properties\": { \"attendanceMode\": { \"$ref\": \"#/sharedSchemas/AttendanceMode\" }, \"attendanceAlertThreshold\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 } }\n        }\n      },\n      \"responseSchema\": { \"data\": { \"attendanceMode\": \"AttendanceMode\", \"attendanceAlertThreshold\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-4\", \"FR-5\", \"NFR-8\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_01C7xz2qZGn4AuMtzzoqxTf8","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
