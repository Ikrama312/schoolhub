fault\": 20 }","-        }","-      },","-      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Notification\" } }, \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" } },","-      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\"],","-      \"requirementIds\": [\"FR-34\", \"FR-24\", \"FR-26\", \"NFR-11\"]","-    },","-    {","-      \"method\": \"GET\",","-      \"path\": \"/api/notifications/unread-count\",","-      \"routeFile\": \"src/app/api/notifications/unread-count/route.ts\",","-      \"description\": \"Count of the caller's unread notifications. It is index-only on [userId, readAt, createdAt], with a target under 50 ms, and the bell polls it every 30 s while the tab is visible.\",","-      \"auth\": \"requireUser\",","+      \"path\": \"/api/periods\",","+      \"routeFile\": \"src/app/api/periods/route.ts\",","+      \"description\": \"All periods ordered by `order` ascending.\",","+      \"auth\": \"requireUser (any role)\",","       \"requestSchema\": {},","-      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"count\"], \"properties\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } } },","+      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } } },","       \"errors\": [\"UNAUTHENTICATED\"],","-      \"requirementIds\": [\"FR-35\", \"FR-22\", \"FR-23\", \"NFR-2\"]","+      \"requirementIds\": [\"FR-33\", \"FR-5\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/notifications/read-all\",","-      \"routeFile\": \"src/app/api/notifications/read-all/route.ts\",","-      \"description\": \"Sets readAt = now on all of the caller's unread notifications. It is idempotent.\",","-      \"auth\": \"requireUser\",","-      \"requestSchema\": {},","-      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"count\"], \"properties\": { \"count\": { \"type\": \"integer\", \"description\": \"rows updated\" } } } },","-      \"errors\": [\"UNAUTHENTICATED\"],","-      \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]","+      \"path\": \"/api/periods\",","+      \"routeFile\": \"src/app/api/periods/route.ts\",","+      \"description\": \"Create a period. order = max(order)+1. Rejects endTime <= startTime (Zod) and any overlap with another period (service: \\\"Overlaps '<name>' (<s>–<e>).\\\"). Audited as period.create.\",","+      \"auth\": \"requireRole('ADMIN')\",","+      \"requestSchema\": {","+        \"body\": {","+          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 50 },","+          \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },","+          \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },","+          \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\" }","+        },","+        \"zod\": \"periodSchema\"","+      },","+      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/Period\" } },","+      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-33\", \"FR-5\", \"FR-6\", \"FR-40\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/notifications/{id}/read\",","-      \"routeFile\": \"src/app/api/notifications/[id]/read/route.ts\",","-      \"description\": \"Marks one notification read. It runs updateMany({ id, userId: me.id }), and a count of 0 returns 404 NOT_FOUND, so it never reveals other users' rows.\",","-      \"auth\": \"requireUser (owner only)\",","-      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },","-      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\"], \"properties\": { \"id\": { \"type\": \"string\" } } } },","-      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]","+      \"method\": \"PATCH\",","+      \"pa