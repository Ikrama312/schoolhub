{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dd6dBcqRPEX3iwe44dXgou","type":"tool_result","content":"The file /Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2823560b-6b63-4da8-95f5-9dff2410c0ed","uuid":"e3d74edf-a566-4bee-9cb5-6a33099c98b5","timestamp":"2026-11-09T12:11:42.186Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-11\",\n  \"timestamp\": \"2026-11-09T17:45:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api (existing SchoolHub convention, not /api/v1; route files live under src/app/api/**/route.ts). Requirement: FR-39, NFR-9.\",\n    \"handlerPipeline\": \"withHandler → requireUser/requireRole → Zod schema from src/lib/validators/gradebook.ts → service in src/server/gradebook/ or src/server/report-cards/ → ok(data) / ok(data, {status: 201}). Requirement: FR-39, NFR-6.\",\n    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. None of these endpoints is paginated: the largest list (report cards for one term, up to ~600 rows) must be complete so 'Publish all' / 'Print all' can act on the full filtered list.\",\n    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } } from src/server/http.ts. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, INTERNAL 500.\",\n    \"decimals\": \"Input: number | string with at most 2 decimals (same `decimal(min,max,label)` helper pattern as validators/assignments.ts). Output: points and weights are 2 dp strings via fixed2 (\\\"18.00\\\"). Computed percents are 1 dp strings rounded half-up once (\\\"78.0\\\"), or null when nothing counts. Requirement: NFR-1, FR-13.\",\n    \"dates\": \"ISO 8601 UTC strings. Clients render with DateDisplay in SchoolSettings.timezone. Requirement: NFR-10.\",\n    \"accessTerms\": \"manage = assertCanManageCourse (ADMIN, or TEACHER who teaches the course). view course = assertCanViewCourse. view student = assertCanViewStudent (self, linked parent, teacher of the student, homeroom teacher, ADMIN). Unauthorised access to a specific entity returns NOT_FOUND where the existing assert does so. Requirement: NFR-6, FR-39.\",\n    \"privacy\": \"Student/parent-facing responses (GET /api/students/:id/grades, GET /api/report-cards with studentId, GET /api/report-cards/:id) never include hidden items, unreleased scores, updatedById or unpublished cards. Requirement: NFR-5, FR-42, FR-37.\"\n  },\n\n  \"components\": {\n    \"Decimal2In\": { \"oneOf\": [{ \"type\": \"number\" }, { \"type\": \"string\", \"pattern\": \"^\\\\d+(\\\\.\\\\d{1,2})?$\" }] },\n    \"Decimal2Out\": { \"type\": \"string\", \"pattern\": \"^-?\\\\d+\\\\.\\\\d{2}$\", \"example\": \"18.00\" },\n    \"Percent1Out\": { \"type\": [\"string\", \"null\"], \"pattern\": \"^\\\\d+\\\\.\\\\d$\", \"example\": \"78.0\" },\n    \"Band\": {\n      \"type\": \"object\",\n      \"required\": [\"letter\", \"minPercent\"],\n      \"properties\": {\n        \"letter\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 5 },\n        \"minPercent\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 100 },\n        \"gpa\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 10, \"description\": \"Stored only, never computed (NFR-13).\" },\n        \"descriptor\": { \"type\": \"string\", \"maxLength\": 100 }\n      }\n    },\n    \"Bands\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": { \"$ref\": \"#/components/Band\" },\n      \"description\": \"bandsSchema: minPercent strictly descending, last band minPercent = 0, letters unique (case-sensitive). Server re-sorts nothing; out-of-order input is a VALIDATION_ERROR. Requirement: FR-16.\"\n    },\n    \"GradingScale\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"isDefault\": { \"type\": \"boolean\" },\n        \"bands\": { \"$ref\": \"#/components/Bands\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      }\n    },\n    \"GradeCategory\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"dropLowest\": { \"type\": \"integer\", \"minimum\": 0 },\n        \"order\": { \"type\": \"integer\" }\n      }\n    },\n    \"GradeItem\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"courseId\": { \"type\": \"string\" },\n        \"termId\": { \"type\": \"string\" },\n        \"categoryId\": { \"type\": [\"string\", \"null\"] },\n        \"title\": { \"type\": \"string\" },\n        \"maxPoints\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"source\": { \"enum\": [\"ASSIGNMENT\", \"QUIZ\", \"MANUAL\"] },\n        \"sourceId\": { \"type\": [\"string\", \"null\"] },\n        \"isVisible\": { \"type\": \"boolean\" }\n      }\n    },\n    \"Grade\": {\n      \"type\": \"object\",\n      \"description\": \"Teacher-facing grade cell. A student with no Grade row is returned as score null, excused false, missing false.\",\n      \"properties\": {\n        \"gradeItemId\": { \"type\": \"string\" },\n        \"studentId\": { \"type\": \"string\" },\n        \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },\n        \"excused\": { \"type\": \"boolean\" },\n        \"missing\": { \"type\": \"boolean\" },\n        \"comment\": { \"type\": [\"string\", \"null\"] },\n        \"updatedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n      }\n    },\n    \"TermOverride\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"percent\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },\n        \"letter\": { \"type\": [\"string\", \"null\"] },\n        \"teacherComment\": { \"type\": [\"string\", \"null\"] }\n      }\n    },\n    \"CategoryResult\": {\n      \"type\": \"object\",\n      \"description\": \"id null = implicit 'Uncategorised' bucket (weight 0 when the course has categories, A8).\",\n      \"properties\": {\n        \"id\": { \"type\": [\"string\", \"null\"] },\n        \"name\": { \"type\": \"string\" },\n        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n        \"earned\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"possible\": { \"$ref\": \"#/components/Decimal2Out\" },\n        \"droppedItemIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n      }\n    },\n    \"StudentTermResult\": {\n      \"type\": \"object\",\n      \"description\": \"Output of grade-calc.computeStudentTerm, the single shared calculation (FR-10–FR-15). percent/letter are final (override applied); computed* are pre-override.\",\n      \"properties\": {\n        \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/CategoryResult\" } },\n        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n        \"letter\": { \"type\": [\"string\", \"null\"] },\n        \"descriptor\": { \"type\": [\"string\", \"null\"] },\n        \"computedPercent\": { \"$ref\": \"#/components/Percent1Out\" },\n        \"computedLetter\": { \"type\": [\"string\", \"null\"] },\n        \"overridden\": { \"type\": \"boolean\" },\n        \"override\": { \"oneOf\": [{ \"$ref\": \"#/components/TermOverride\" }, { \"type\": \"null\" }] }\n      }\n    },\n    \"TermRef\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\" },\n        \"startDate\": { \"type\": \"string\", \"format\": \"date\" },\n        \"endDate\": { \"type\": \"string\", \"format\": \"date\" },\n        \"isCurrent\": { \"type\": \"boolean\" }\n      }\n    },\n    \"ReportCardSnapshotV1\": {\n      \"type\": \"object\",\n      \"description\": \"snapshotSchema in src/server/report-cards/snapshot.ts. Frozen at generation; never recomputed on read or print (FR-31).\",\n      \"properties\": {\n        \"v\": { \"const\": 1 },\n        \"school\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"logoUrl\": { \"type\": [\"string\", \"null\"] } } },\n        \"student\": { \"type\": \"object\", \"properties\": {\n          \"name\": { \"type\": \"string\" }, \"admissionNumber\": { \"type\": [\"string\", \"null\"] },\n          \"gradeLevel\": { \"type\": \"string\" }, \"section\": { \"type\": \"string\" }, \"homeroomTeacher\": { \"type\": [\"string\", \"null\"] } } },\n        \"term\": { \"type\": \"object\", \"properties\": {\n          \"name\": { \"type\": \"string\" }, \"startDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"endDate\": { \"type\": \"string\", \"format\": \"date\" }, \"academicYear\": { \"type\": \"string\" } } },\n        \"courses\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": {\n          \"subject\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"teacher\": { \"type\": [\"string\", \"null\"] },\n          \"percent\": { \"$ref\": \"#/components/Percent1Out\" }, \"letter\": { \"type\": [\"string\", \"null\"] },\n          \"descriptor\": { \"type\": [\"string\", \"null\"] }, \"teacherComment\": { \"type\": [\"string\", \"null\"] },\n          \"scaleName\": { \"type\": \"string\" } } } },\n        \"attendance\": { \"type\": \"object\", \"properties\": {\n          \"rate\": { \"type\": [\"string\", \"null\"], \"description\": \"Same formula as the existing attendance getReport consumers (B13).\" },\n          \"absences\": { \"type\": \"integer\" }, \"lates\": { \"type\": \"integer\" },\n          \"counts\": { \"type\": \"object\", \"additionalProperties\": { \"type\": \"integer\" } } } },\n        \"scale\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },\n        \"extraScales\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },\n          \"description\": \"Course-specific scales used by any course on the card, for the legend.\" }\n      }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/grading-scales\",\n      \"description\": \"List all grading scales, default first then by name. Any authenticated user (requireUser).\",\n      \"auth\": \"any authenticated user\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradingScale\" } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-39\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/grading-scales\",\n      \"description\": \"Create a scale (scaleSchema). If isDefault is true, the other scales' isDefault is cleared in the same transaction. If no scale exists yet, the new scale becomes the default whatever isDefault says. The partial unique index grading_scale_one_default is the backstop. Audit gradingScale.create. Returns 201.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"name\", \"bands\"],\n        \"properties\": {\n          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n          \"isDefault\": { \"type\": \"boolean\", \"default\": false },\n          \"bands\": { \"$ref\": \"#/components/Bands\" }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/components/GradingScale\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-16\", \"FR-39\", \"NFR-13\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/grading-scales/:id\",\n      \"description\": \"Partial update. isDefault: true clears the other defaults in a transaction. isDefault: false on the current default is a VALIDATION_ERROR (make another scale default instead), so exactly one default always exists. Published report cards keep their embedded legend. Audit gradingScale.update with {old, new}.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"properties\": {\n          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n          \"isDefault\": { \"type\": \"boolean\" },\n          \"bands\": { \"$ref\": \"#/components/Bands\" }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/components/GradingScale\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-16\", \"FR-39\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/grading-scales/:id\",\n      \"description\": \"Delete a scale. CONFLICT if it is the default or any Course.gradingScaleId references it (details: { courseCount }) (A11). Audit gradingScale.delete.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" } } },\n      \"errors\": [\"CONFLICT\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-16\", \"FR-39\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/grade-categories\",\n      \"description\": \"The course's categories ordered by `order`, plus its scale setting. gradingScaleId null means the school default; effectiveScale is the scale actually used.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"gradingScaleId\": { \"type\": [\"string\", \"null\"] },\n          \"effectiveScale\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n          \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeCategory\" } }\n        }\n      },\n      \"errors\": [\"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-17\", \"FR-2\", \"FR-39\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/courses/:id/grade-categories\",\n      \"description\": \"Replace the full category list in one transaction: rows with an id are updated, rows without one are created, and existing categories missing from the list are deleted (GradeItem/Assignment/Quiz.categoryId → null via SetNull). A non-empty list must total exactly 100 using dec(sum).eq(100); otherwise VALIDATION_ERROR with details { sum: \\\"90.00\\\" } so the UI can show 'Weights total 90 / 100'. An empty list is allowed (the course then uses points totals, FR-12). Names are unique within the request (case-insensitive). Ids must belong to this course (else VALIDATION_ERROR). If gradingScaleId is present it is set too (null = school default; an unknown id is VALIDATION_ERROR). Audit gradeCategories.replace with {old, new}. Returns the same shape as GET.\",\n      \"auth\": \"manage\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"categories\"],\n        \"properties\": {\n          \"categories\": {\n            \"type\": \"array\",\n            \"maxItems\": 20,\n            \"items\": {\n              \"type\": \"object\",\n              \"required\": [\"name\", \"weightPercent\", \"order\"],\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 60 },\n                \"weightPercent\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"minimum\": 0, \"maximum\": 100 },\n                \"dropLowest\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 50, \"default\": 0 },\n                \"order\": { \"type\": \"integer\", \"minimum\": 0 }\n              }\n            }\n          },\n          \"gradingScaleId\": { \"type\": [\"string\", \"null\"] }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/endpoints/4/responseSchema\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-17\", \"FR-40\", \"FR-2\", \"FR-12\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/gradebook\",\n      \"description\": \"Full gradebook for one term in one denormalised payload, loaded with the batched load.ts queries plus the submission/attempt lookups, and computed in memory (NFR-2: 35×80 < 800 ms). Query: termId (optional; defaults to the term containing today in the course's academic year, else the first term). format=csv returns text/csv (Content-Disposition: attachment; filename=\\\"<courseCode>-<termName>-gradebook.csv\\\") built with toCsv: columns Last name, First name, one per item ('<title> (/<max>)', cell = score | EX | M | blank), one per category average, Term %, Letter. That is the grid as displayed: same row order, and hidden items included as the teacher sees them. Students are active enrollments sorted by lastName, firstName. Items are sorted by category order, then dueAt (nulls last), then title. Each grade cell carries isLate and submissionId/attemptId for the late icon and click-through.\",\n      \"auth\": \"manage\",\n      \"requestSchema\": {\n        \"query\": {\n          \"termId\": { \"type\": \"string\" },\n          \"format\": { \"enum\": [\"json\", \"csv\"], \"default\": \"json\" }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"course\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n          \"term\": { \"$ref\": \"#/components/TermRef\" },\n          \"terms\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/TermRef\" } },\n          \"scale\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },\n          \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeCategory\" } },\n          \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeItem\" } },\n          \"rows\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"student\": { \"type\": \"object\", \"properties\": {\n                  \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" },\n                  \"admissionNumber\": { \"type\": [\"string\", \"null\"] } } },\n                \"cells\": {\n                  \"type\": \"object\",\n                  \"description\": \"Keyed by gradeItemId; every item has a cell.\",\n                  \"additionalProperties\": {\n                    \"allOf\": [{ \"$ref\": \"#/components/Grade\" }],\n                    \"properties\": {\n                      \"isLate\": { \"type\": \"boolean\" },\n                      \"submissionId\": { \"type\": [\"string\", \"null\"], \"description\": \"ASSIGNMENT items: link to the existing submission grading page (FR-21).\" },\n                      \"attemptId\": { \"type\": [\"string\", \"null\"], \"description\": \"QUIZ items: the attempt the score came from, by scoring policy.\" }\n                    }\n                  }\n                },\n                \"result\": { \"$ref\": \"#/components/StudentTermResult\" }\n              }\n            }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-18\", \"FR-19\", \"FR-21\", \"FR-24\", \"FR-25\", \"FR-15\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"NFR-2\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/grade-items\",\n      \"description\": \"Create a MANUAL grade item (manualItemSchema). categoryId must belong to the course. termId must be a term of the course's academic year. Returns 201.\",\n      \"auth\": \"manage\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"title\", \"maxPoints\", \"termId\"],\n        \"properties\": {\n          \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 200 },\n          \"categoryId\": { \"type\": [\"string\", \"null\"] },\n          \"maxPoints\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"exclusiveMinimum\": 0, \"maximum\": 1000 },\n          \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n          \"termId\": { \"type\": \"string\" }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/components/GradeItem\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-22\", \"FR-39\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/grade-items/:id\",\n      \"description\": \"Update an item (itemPatchSchema). MANUAL items accept every field. ASSIGNMENT/QUIZ items accept only isVisible; any other field is a VALIDATION_ERROR ('Edit this item at its source'). isVisible: false hides the item from students/parents and removes it from calculation (FR-24). Sync changes isVisible only on source visibility transitions, so a teacher's hide survives source re-saves (A7). Lowering maxPoints below an existing score on a MANUAL item is a VALIDATION_ERROR.\",\n      \"auth\": \"manage (via the item's course)\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"properties\": {\n          \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 200 },\n          \"categoryId\": { \"type\": [\"string\", \"null\"] },\n          \"maxPoints\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"exclusiveMinimum\": 0, \"maximum\": 1000 },\n          \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n          \"termId\": { \"type\": \"string\" },\n          \"isVisible\": { \"type\": \"boolean\" }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/components/GradeItem\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-9\", \"FR-24\", \"FR-22\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/grade-items/:id\",\n      \"description\": \"Delete a MANUAL item; its grades cascade. Non-MANUAL items are a VALIDATION_ERROR, because deleting the source deletes them (FR-4). Audit gradeItem.delete with the item and its grades as `old`.\",\n      \"auth\": \"manage (via the item's course)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-9\", \"FR-22\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/grade-items/:id/mark-missing\",\n      \"description\": \"Column action 'Set all ungraded to missing'. Requires item.dueAt to be set and now > dueAt (A5); otherwise VALIDATION_ERROR. For every actively enrolled student whose grade has score null, excused false and missing false (including students with no Grade row), sets missing = true in one transaction. Allowed on any source: it only touches rows with no score, so it never overrides a synced score (FR-9). A later sync that writes a score makes it count normally. One audit row grade.markMissing with { itemId, studentIds }. No notifications.\",\n      \"auth\": \"manage (via the item's course)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"updatedCount\": { \"type\": \"integer\" }, \"studentIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-24\", \"FR-10\", \"NFR-4\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/grade-items/:id/grades/:studentId\",\n      \"description\": \"Upsert one grade cell (gradePutSchema; at least one field). MANUAL items: all fields; score must satisfy 0 ≤ score ≤ maxPoints. Grid keys map to E → {excused: true}, M → {missing: true}, Delete → {score: null, excused: false, missing: false}. ASSIGNMENT/QUIZ items: comment only; any other field is a VALIDATION_ERROR (FR-9). studentId must be actively enrolled in the item's course (else NOT_FOUND). Audit grade.update with {old, new} for every change. After commit, if the item is MANUAL and score went from null to a value, notifyStudentAndParents('grade.posted') once (A9). Returns the saved cell plus the student's recomputed term result so the grid refreshes the category and term columns.\",\n      \"auth\": \"manage (via the item's course)\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"properties\": {\n          \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2In\" }, { \"type\": \"null\" }] },\n          \"excused\": { \"type\": \"boolean\" },\n          \"missing\": { \"type\": \"boolean\" },\n          \"comment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"grade\": { \"$ref\": \"#/components/Grade\" },\n          \"result\": { \"$ref\": \"#/components/StudentTermResult\" }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-20\", \"FR-9\", \"FR-19\", \"FR-38\", \"NFR-4\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/courses/:id/term-overrides/:studentId\",\n      \"description\": \"Upsert a TermGradeOverride (termOverrideSchema). termId must be a term of the course's year. letter must exist in the course's effective scale (else VALIDATION_ERROR). Percent-only re-derives the letter from the scale (A12). Letter-only keeps the computed percent (FR-14, AC-6). Setting all three to null clears the override but keeps the row. studentId must be enrolled (else NOT_FOUND). Audit termOverride.upsert with {old, new}. Returns the override and the recomputed result.\",\n      \"auth\": \"manage\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"termId\"],\n        \"properties\": {\n          \"termId\": { \"type\": \"string\" },\n          \"percent\": { \"oneOf\": [{ \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"minimum\": 0, \"maximum\": 100 }, { \"type\": \"null\" }] },\n          \"letter\": { \"type\": [\"string\", \"null\"], \"maxLength\": 5 },\n          \"teacherComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"override\": { \"$ref\": \"#/components/TermOverride\" },\n          \"result\": { \"$ref\": \"#/components/StudentTermResult\" }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-23\", \"FR-14\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/:id/grades\",\n      \"description\": \"Student/parent grades view for one term (default: current term). Optional courseId limits the response to one course (course Grades tab, FR-28). Only visible items are loaded (filtered in the query), and the calculation runs over those items, so totals match what is shown. Grade rows only ever hold released scores (sync gating), so no further score filtering is needed. Courses are the student's active enrollments in the term's academic year, ordered by course name. colour: ≥ 80 success (green), 60–79.9 warning (amber), < 60 error (red), null when percent is null. Whitelist serializer: no updatedById, no hidden items, no submission/attempt ids.\",\n      \"auth\": \"view student\",\n      \"requestSchema\": {\n        \"query\": {\n          \"termId\": { \"type\": \"string\" },\n          \"courseId\": { \"type\": \"string\" }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"student\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" } } },\n          \"term\": { \"$ref\": \"#/components/TermRef\" },\n          \"terms\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/TermRef\" } },\n          \"courses\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"course\": { \"type\": \"object\", \"properties\": {\n                  \"id\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"teacherName\": { \"type\": [\"string\", \"null\"] } } },\n                \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n                \"letter\": { \"type\": [\"string\", \"null\"] },\n                \"descriptor\": { \"type\": [\"string\", \"null\"] },\n                \"colour\": { \"enum\": [\"success\", \"warning\", \"error\", null] },\n                \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/CategoryResult\" } },\n                \"items\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"id\": { \"type\": \"string\" },\n                      \"title\": { \"type\": \"string\" },\n                      \"categoryId\": { \"type\": [\"string\", \"null\"] },\n                      \"categoryName\": { \"type\": \"string\" },\n                      \"maxPoints\": { \"$ref\": \"#/components/Decimal2Out\" },\n                      \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                      \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },\n                      \"percent\": { \"$ref\": \"#/components/Percent1Out\" },\n                      \"comment\": { \"type\": [\"string\", \"null\"] },\n                      \"missing\": { \"type\": \"boolean\" },\n                      \"excused\": { \"type\": \"boolean\" },\n                      \"dropped\": { \"type\": \"boolean\" }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-42\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-15\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/report-cards\",\n      \"description\": \"Two modes. (A) Without studentId: the admin/homeroom roster for a term. termId is required; gradeLevelId and sectionId are optional filters. ADMIN sees all sections. A TEACHER is limited to sections where Section.homeroomTeacherId = user (filters outside those return an empty list). Other roles get FORBIDDEN. Returns one row per active student in scope, including students with no card yet (status NOT_GENERATED), sorted by section then lastName. Warnings are computed in the same batched pass (NFR-3). (B) With studentId: the student's cards across terms (termId optional filter), newest term first, for the Report cards tab (FR-36). Access is view student. STUDENT/PARENT get PUBLISHED cards only. ADMIN and the student's teachers get all.\",\n      \"auth\": \"(A) ADMIN, homeroom TEACHER; (B) view student\",\n      \"requestSchema\": {\n        \"query\": {\n          \"termId\": { \"type\": \"string\", \"description\": \"Required in mode A.\" },\n          \"gradeLevelId\": { \"type\": \"string\" },\n          \"sectionId\": { \"type\": \"string\" },\n          \"studentId\": { \"type\": \"string\" }\n        }\n      },\n      \"responseSchema\": {\n        \"oneOf\": [\n          {\n            \"title\": \"RosterRow[] (mode A)\",\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"student\": { \"type\": \"object\", \"properties\": {\n                  \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" },\n                  \"admissionNumber\": { \"type\": [\"string\", \"null\"] },\n                  \"gradeLevel\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n                  \"section\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } } },\n                \"status\": { \"enum\": [\"NOT_GENERATED\", \"DRAFT\", \"PUBLISHED\"] },\n                \"reportCard\": { \"oneOf\": [{ \"type\": \"null\" }, { \"type\": \"object\", \"properties\": {\n                  \"id\": { \"type\": \"string\" }, \"generatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n                  \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n                  \"hasHomeroomComment\": { \"type\": \"boolean\" }, \"hasPrincipalComment\": { \"type\": \"boolean\" } } }] },\n                \"warnings\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"type\": { \"enum\": [\"UNGRADED_ITEMS\", \"MISSING_TEACHER_COMMENT\"] },\n                      \"courseId\": { \"type\": \"string\" },\n                      \"courseCode\": { \"type\": \"string\" },\n                      \"count\": { \"type\": \"integer\", \"description\": \"UNGRADED_ITEMS: visible, past-due items with no score that are neither missing nor excused.\" }\n                    }\n                  }\n                }\n              }\n            }\n          },\n          {\n            \"title\": \"StudentCard[] (mode B)\",\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": { \"type\": \"string\" },\n                \"term\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"academicYear\": { \"type\": \"string\" } } },\n                \"status\": { \"enum\": [\"DRAFT\", \"PUBLISHED\"] },\n                \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }\n              }\n            }\n          }\n        ]\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-29\", \"FR-33\", \"FR-36\", \"FR-37\", \"NFR-3\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/report-cards/generate\",\n      \"description\": \"Build or refresh snapshots (generateSchema). Students not enrolled in the term's academic year are skipped. Missing cards are created as DRAFT (createMany skipDuplicates). Existing DRAFT cards get a new snapshot and generatedAt via updateMany WHERE status = 'DRAFT'. PUBLISHED cards are never touched (FR-31, AC-8). Comments on existing drafts are preserved. Batched loads, in-memory calc, writes in chunks of 100 (NFR-3: 600 × 8 < 30 s).\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"termId\", \"studentIds\"],\n        \"properties\": {\n          \"termId\": { \"type\": \"string\" },\n          \"studentIds\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"created\": { \"type\": \"integer\" },\n          \"refreshed\": { \"type\": \"integer\" },\n          \"skippedPublished\": { \"type\": \"integer\" },\n          \"skippedNotEnrolled\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/report-cards/:id\",\n      \"description\": \"One card for the review and print pages. assertCanViewReportCard: ADMIN; a TEACHER who teaches any course of the student or is their homeroom teacher; the STUDENT themselves or a linked PARENT only when status = PUBLISHED. Everyone else gets NOT_FOUND, so a 7B student cannot tell that Sam's card exists (FR-37, AC-7). The body comes from the snapshot only and is never recomputed. permissions tells the review page which fields to enable. publishedById is omitted for STUDENT/PARENT.\",\n      \"auth\": \"assertCanViewReportCard\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": { \"type\": \"string\" },\n          \"studentId\": { \"type\": \"string\" },\n          \"termId\": { \"type\": \"string\" },\n          \"status\": { \"enum\": [\"DRAFT\", \"PUBLISHED\"] },\n          \"snapshot\": { \"$ref\": \"#/components/ReportCardSnapshotV1\" },\n          \"homeroomComment\": { \"type\": [\"string\", \"null\"] },\n          \"principalComment\": { \"type\": [\"string\", \"null\"] },\n          \"generatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n          \"publishedById\": { \"type\": [\"string\", \"null\"] },\n          \"permissions\": { \"type\": \"object\", \"properties\": {\n            \"canEditHomeroomComment\": { \"type\": \"boolean\" },\n            \"canEditPrincipalComment\": { \"type\": \"boolean\" },\n            \"canPublish\": { \"type\": \"boolean\" } } }\n        }\n      },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-37\", \"FR-32\", \"FR-35\", \"FR-36\", \"NFR-5\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/report-cards/:id\",\n      \"description\": \"Edit comments (reportCardPatchSchema). Access is checked per field: homeroomComment needs ADMIN or the homeroom teacher of the student's section; principalComment needs ADMIN only. A field the caller may not edit is FORBIDDEN. Callers who cannot view the card get NOT_FOUND. Only DRAFT cards can be edited; PUBLISHED returns CONFLICT ('Unpublish to edit') (A13). Returns the same shape as GET.\",\n      \"auth\": \"ADMIN; homeroom TEACHER (homeroomComment only)\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"minProperties\": 1,\n        \"properties\": {\n          \"homeroomComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 },\n          \"principalComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }\n        }\n      },\n      \"responseSchema\": { \"$ref\": \"#/endpoints/16/responseSchema\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n      \"requirementIds\": [\"FR-32\", \"FR-33\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/report-cards/publish\",\n      \"description\": \"Publish one card or a bulk filtered list (publishSchema). Only DRAFT cards change: updateMany WHERE id IN ids AND status = 'DRAFT' sets status PUBLISHED, publishedAt = now and publishedById = user. Ids that are unknown or already published are returned in skippedIds. Audit reportCard.publish. After commit, notify report_card.published (defaultEmail true) to the student and linked parents for each published card.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"ids\"],\n        \"properties\": {\n          \"ids\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"publishedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n          \"skippedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-34\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/report-cards/unpublish\",\n      \"description\": \"Unpublish (unpublishSchema; reason required). PUBLISHED cards return to DRAFT and publishedAt/publishedById are cleared (A13). Others are returned in skippedIds. One audit row reportCard.unpublish per card with {old, new, reason}. No notification.\",\n      \"auth\": \"ADMIN\",\n      \"requestSchema\": {\n        \"type\": \"object\",\n        \"required\": [\"ids\", \"reason\"],\n        \"properties\": {\n          \"ids\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } },\n          \"reason\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 500 }\n        }\n      },\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"unpublishedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n          \"skippedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-34\", \"NFR-4\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    { \"kind\": \"notification\", \"name\": \"grade.posted\", \"recipients\": \"STUDENT + linked PARENTs\", \"defaultEmail\": false, \"payload\": { \"courseId\": \"string\", \"gradeItemId\": \"string\", \"itemTitle\": \"string\" }, \"requirementIds\": [\"FR-38\"] },\n    { \"kind\": \"notification\", \"name\": \"report_card.published\", \"recipients\": \"STUDENT + linked PARENTs\", \"defaultEmail\": true, \"payload\": { \"reportCardId\": \"string\", \"termName\": \"string\" }, \"requirementIds\": [\"FR-34\", \"FR-38\"] },\n    { \"kind\": \"npm-script\", \"name\": \"gradebook:backfill\", \"command\": \"tsx scripts/gradebook-backfill.ts\", \"output\": \"logger.info summary { items, grades } and exit 0; idempotent\", \"requirementIds\": [\"FR-8\"] },\n    { \"kind\": \"page\", \"name\": \"/report-cards/[id]/print and /report-cards/print?termId=&gradeLevelId=&sectionId=\", \"note\": \"Server components call report-card-service directly (no extra API). Same access as GET /api/report-cards/:id; bulk print renders PUBLISHED cards only.\", \"requirementIds\": [\"FR-35\", \"NFR-11\"] }\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":174,"newStart":1,"newLines":158,"lines":[" {","-  \"ticketId\": \"SH-10\",","-  \"timestamp\": \"2026-11-09T13:00:00Z\",","+  \"ticketId\": \"SH-11\",","+  \"timestamp\": \"2026-11-09T17:45:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\","," ","   \"conventions\": {","-    \"basePath\": \"/api. This is the existing project convention; there is no /api/v1 prefix (system-design §3.3).\",","-    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/quiz.ts) → one call into src/server/quiz/*-service.ts → ok()/paginated(). All of these come from src/server/http.ts. Handlers contain no logic (NFR-6, NFR-7).\",","-    \"successEnvelope\": { \"data\": \"<responseSchema>\" },","-    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int ≥ 1, default 1\", \"pageSize\": \"int 1–100, default 20 (parsePagination)\", \"total\": \"int\" } },","-    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },","-    \"errorCodes\": {","-      \"VALIDATION_ERROR\": \"400. Zod failure (details = zod flatten()) or a service rule failure such as canPublish problems, points > question points, or step ≠ 0.5.\",","-      \"UNAUTHENTICATED\": \"401. No session, or a bad cron secret on the internal route.\",","-      \"NOT_FOUND\": \"404. The resource is missing OR the caller cannot access it. Existence is never revealed, so FORBIDDEN is not used for quiz resources (NFR-5).\",","-      \"CONFLICT\": \"409. Answer write after deadlineAt + 30 s, a closed or not-yet-open quiz, attempt limit reached, edit lock (quiz has attempts), delete with attempts, an invalid status transition, or a write to a non-IN_PROGRESS attempt.\",","-      \"INTERNAL\": \"500. Logged with logger.error and never detailed to the client.\"","-    },","-    \"createdStatus\": \"POST endpoints that create a resource return 201 via ok(x, {status: 201}). Every other success returns 200.\",","-    \"decimals\": \"points, score, maxScore, pointsAwarded, totalPoints and the analytics averages are serialized as strings with 2 decimals by fixed2 from @/server/assignments/grading-math (e.g. \\\"2.00\\\"). Input decimals accept number | string. Percentages are numbers rounded to 1 decimal.\",","-    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client time (ADR-4). The UI displays times in SchoolSettings.timezone (NFR-6).\",","-    \"ids\": \"cuid strings. Option ids inside Question.options are short cuids generated by the builder and stay stable across edits.\",","-    \"studentPrivacy\": \"Every quiz, attempt or result returned to a STUDENT or PARENT is built only by the allow-listing serializers in src/server/quiz/serializers.ts (toStudentQuiz, toStudentAttempt, toStudentResult). `correct` and `explanation` appear only inside StudentResult.questions[] and only when resultsVisible && showCorrectAnswers. Scores appear only when resultsVisible. Student-path Prisma selects never load `correct` or `explanation` (NFR-1, ADR-5).\",","-    \"lazyAutoSubmit\": \"GET /api/attempts/:id, POST /api/quizzes/:id/attempts, the course list and the teacher grade/list loads call ensureNotExpired first. So an IN_PROGRESS attempt past deadlineAt is always returned already submitted (FR-18).\",","-    \"noEndpointByDesign\": [","-      \"getStudentQuizScore(quizId, studentId) → {score, maxScore, percent, isPractice, attemptsCounted} | null is a TypeScript export of attempt-service.ts for PRD-11. It has no HTTP route (FR-22, FR-33, system-design §4.7).\",","-      \"The grading workspace, the analytics page and the builder's accommodations table are server pages. They call the services directly, after requirePageRole and assertCanManageCourse. Only their writes go through the routes below (system-design §3.4).\",","-      \"Preview mode (FR-8) calls no attempt endpoint (A10).\"","-    ],","-    \"requirementIds\": [\"FR-31\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\", \"NFR-7\"]","+    \"basePath\": \"/api (existing SchoolHub convention, not /api/v1; route files live under src/app/api/**/route.ts). Requirement: FR-39, NFR-9.\",","+    \"handlerPipeline\": \"withHandler → requireUser/requireRole → Zod schema from src/lib/validators/gradebook.ts → service in src/server/gradebook/ or src/server/report-cards/ → ok(data) / ok(data, {status: 201}). Requirement: FR-39, NFR-6.\",","+    \"successEnvelope\": \"{ \\\"data\\\": <responseSchema> }. None of these endpoints is paginated: the largest list (report cards for one term, up to ~600 rows) must be complete so 'Publish all' / 'Print all' can act on the full filtered list.\",","+    \"errorEnvelope\": \"{ \\\"error\\\": { \\\"code\\\": ApiErrorCode, \\\"message\\\": string, \\\"details\\\"?: unknown } } from src/server/http.ts. VALIDATION_ERROR 400 (Zod: details = error.flatten()), UNAUTHENTICATED 401, FORBIDDEN 403, NOT_FOUND 404, CONFLICT 409, INTERNAL 500.\",","+    \"decimals\": \"Input: number | string with at most 2 decimals (same `decimal(min,max,label)` helper pattern as validators/assignments.ts). Output: points and weights are 2 dp strings via fixed2 (\\\"18.00\\\"). Computed percents are 1 dp strings rounded half-up once (\\\"78.0\\\"), or null when nothing counts. Requirement: NFR-1, FR-13.\",","+    \"dates\": \"ISO 8601 UTC strings. Clients render with DateDisplay in SchoolSettings.timezone. Requirement: NFR-10.\",","+    \"accessTerms\": \"manage = assertCanManageCourse (ADMIN, or TEACHER who teaches the course). view course = assertCanViewCourse. view student = assertCanViewStudent (self, linked parent, teacher of the student, homeroom teacher, ADMIN). Unauthorised access to a specific entity returns NOT_FOUND where the existing assert does so. Requirement: NFR-6, FR-39.\",","+    \"privacy\": \"Student/parent-facing responses (GET /api/students/:id/grades, GET /api/report-cards with studentId, GET /api/report-cards/:id) never include hidden items, unreleased scores, updatedById or unpublished cards. Requirement: NFR-5, FR-42, FR-37.\"","   },"," ","-  \"sharedSchemas\": {","-    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^\\\\d+\\\\.\\\\d{2}$\", \"description\": \"Output form. Input form is number | string.\" },","-    \"QuizStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"PUBLISHED\", \"CLOSED\"] },","-    \"QuestionType\": { \"type\": \"string\", \"enum\": [\"SINGLE_CHOICE\", \"MULTIPLE_CHOICE\", \"TRUE_FALSE\", \"SHORT_ANSWER\", \"ESSAY\"] },","-    \"ResultsVisibility\": { \"type\": \"string\", \"enum\": [\"IMMEDIATELY\", \"AFTER_CLOSE\", \"MANUAL\"] },","-    \"AttemptStatus\": { \"type\": \"string\", \"enum\": [\"IN_PROGRESS\", \"SUBMITTED\", \"NEEDS_GRADING\", \"GRADED\"] },","-    \"ScoringPolicy\": { \"type\": \"string\", \"enum\": [\"HIGHEST\", \"LATEST\", \"AVERAGE\"] },","-    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"name\": \"string\" } },","-    \"Option\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"text\": \"string (non-empty)\" } },","-    \"Correct\": {","-      \"description\": \"Keyed by Question.type (FR-2). Manager-only, except as described in conventions.studentPrivacy.\",","-      \"oneOf\": {","-        \"SINGLE_CHOICE\": { \"optionId\": \"string (must be one of options[].id)\" },","-        \"MULTIPLE_CHOICE\": { \"optionIds\": \"string[] (≥ 1, each in options[].id)\" },","-        \"TRUE_FALSE\": { \"value\": \"boolean\" },","-        \"SHORT_ANSWER\": { \"accepted\": \"string[] (1–10, non-empty)\" },","-        \"ESSAY\": { \"guidance\": \"string?\" }","+  \"components\": {","+    \"Decimal2In\": { \"oneOf\": [{ \"type\": \"number\" }, { \"type\": \"string\", \"pattern\": \"^\\\\d+(\\\\.\\\\d{1,2})?$\" }] },","+    \"Decimal2Out\": { \"type\": \"string\", \"pattern\": \"^-?\\\\d+\\\\.\\\\d{2}$\", \"example\": \"18.00\" },","+    \"Percent1Out\": { \"type\": [\"string\", \"null\"], \"pattern\": \"^\\\\d+\\\\.\\\\d$\", \"example\": \"78.0\" },","+    \"Band\": {","+      \"type\": \"object\",","+      \"required\": [\"letter\", \"minPercent\"],","+      \"properties\": {","+        \"letter\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 5 },","+        \"minPercent\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 100 },","+        \"gpa\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 10, \"description\": \"Stored only, never computed (NFR-13).\" },","+        \"descriptor\": { \"type\": \"string\", \"maxLength\": 100 }","       }","     },","-    \"AnswerResponse\": {","-      \"description\": \"answerResponseSchema. A type-agnostic union, so the autosave path doesn't load the Question (NFR-2). A shape that doesn't match the question's type grades as 0 / incorrect at submit.\",","-      \"oneOf\": [","-        { \"optionId\": \"string\" },","-        { \"optionIds\": \"string[]\" },","-        { \"value\": \"boolean\" },","-        { \"text\": \"string (≤ 10,000 chars)\" }","-      ]","+    \"Bands\": {","+      \"type\": \"array\",","+      \"minItems\": 1,","+      \"items\": { \"$ref\": \"#/components/Band\" },","+      \"description\": \"bandsSchema: minPercent strictly descending, last band minPercent = 0, letters unique (case-sensitive). Server re-sorts nothing; out-of-order input is a VALIDATION_ERROR. Requirement: FR-16.\"","     },","-    \"QuizSettingsInput\": {","-      \"description\": \"quizSettingsSchema (FR-2, FR-6). Cross-field rules run in superRefine: availableUntil > availableFrom, and timeLimitMinutes ≤ the window length in minutes. On PATCH, both rules are checked against the stored values merged with the patch.\",","+    \"GradingScale\": {","+      \"type\": \"object\",","       \"properties\": {","-        \"title\": \"string (trimmed, non-empty)\",","-        \"instructions\": \"string (Markdown, default \\\"\\\")\",","-        \"isPractice\": \"boolean (default false)\",","-        \"availableFrom\": \"ISO datetime\",","-        \"availableUntil\": \"ISO datetime\",","-        \"timeLimitMinutes\": \"int 1–300 | null (null = untimed)\",","-        \"maxAttempts\": \"int 1–10 (default 1)\",","-        \"scoringPolicy\": \"ScoringPolicy (default HIGHEST)\",","-        \"shuffleQuestions\": \"boolean (default false)\",","-        \"shuffleOptions\": \"boolean (default false)\",","-        \"oneQuestionPerPage\": \"boolean (default false)\",","-        \"resultsVisibility\": \"ResultsVisibility (default AFTER_CLOSE)\",","-        \"showCorrectAnswers\": \"boolean (default true)\"","+        \"id\": { \"type\": \"string\" },","+        \"name\": { \"type\": \"string\" },","+        \"isDefault\": { \"type\": \"boolean\" },","+        \"bands\": { \"$ref\": \"#/components/Bands\" },","+        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },","+        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }","       }","     },","-    \"QuestionInput\": {","-      \"description\": \"questionSchema, a z.discriminatedUnion on type (FR-2, FR-7). points 0.5–100 in steps of 0.5. options has 2–8 entries for SINGLE_CHOICE/MULTIPLE_CHOICE and is absent for the other types. prompt is non-empty Markdown and may embed a file uploaded with context 'quiz' (FR-39).\",","+    \"GradeCategory\": {","+      \"type\": \"object\",","       \"properties\": {","-        \"type\": \"QuestionType\",","-        \"prompt\": \"string (Markdown)\",","-        \"points\": \"number | string\",","-        \"options\": \"Option[] | undefined\",","-        \"correct\": \"Correct (shape keyed by type)\",","-        \"explanation\": \"string | null\",","-        \"caseSensitive\": \"boolean (SHORT_ANSWER only, default false)\"","+        \"id\": { \"type\": \"string\" },","+        \"name\": { \"type\": \"string\" },","+        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },","+        \"dropLowest\": { \"type\": \"integer\", \"minimum\": 0 },","+        \"order\": { \"type\": \"integer\" }","       }","     },","-    \"ManagerQuestion\": {","+    \"GradeItem\": {","+      \"type\": \"object\",","       \"properties\": {","-        \"id\": \"string\", \"quizId\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\",","-        \"order\": \"int\", \"options\": \"Option[] | null\", \"correct\": \"Correct\", \"explanation\": \"string | null\", \"caseSensitive\": \"boolean\"","+        \"id\": { \"type\": \"string\" },","+        \"courseId\": { \"type\": \"string\" },","+        \"termId\": { \"type\": \"string\" },","+        \"categoryId\": { \"type\": [\"string\", \"null\"] },","+        \"title\": { \"type\": \"string\" },","+        \"maxPoints\": { \"$ref\": \"#/components/Decimal2Out\" },","+        \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","+        \"source\": { \"enum\": [\"ASSIGNMENT\", \"QUIZ\", \"MANUAL\"] },","+        \"sourceId\": { \"type\": [\"string\", \"null\"] },","+        \"isVisible\": { \"type\": \"boolean\" }","       }","     },","-    \"ManagerQuiz\": {","-      \"description\": \"Full quiz, including answers. Returned only to managers (assertCanManageCourse).\",","+    \"Grade\": {","+      \"type\": \"object\",","+      \"description\": \"Teacher-facing grade cell. A student with no Grade row is returned as score null, excused false, missing false.\",","       \"properties\": {","-        \"id\": \"string\", \"courseId\": \"string\",","-        \"...\": \"every QuizSettingsInput field, resolved\",","-        \"status\": \"QuizStatus\",","-        \"resultsReleasedAt\": \"ISO datetime | null\",","-        \"createdById\": \"string\", \"createdAt\": \"ISO datetime\", \"updatedAt\": \"ISO datetime\",","-        \"questions\": \"ManagerQuestion[] (sorted by order)\",","-        \"totalPoints\": \"Decimal (Σ points, FR-8)\",","-        \"attemptCount\": \"int\",","-        \"locked\": \"boolean (attemptCount > 0, edit lock FR-10)\",","-        \"publishProblems\": \"string[] (canPublish(questions); empty means publishable, FR-9)\"","+        \"gradeItemId\": { \"type\": \"string\" },","+        \"studentId\": { \"type\": \"string\" },","+        \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },","+        \"excused\": { \"type\": \"boolean\" },","+        \"missing\": { \"type\": \"boolean\" },","+        \"comment\": { \"type\": [\"string\", \"null\"] },","+        \"updatedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }","       }","     },","-    \"StudentQuiz\": {","-      \"description\": \"toStudentQuiz. Allow-listed, with no questions and no `correct` (NFR-1). Drives the start screen (FR-12).\",","+    \"TermOverride\": {","+      \"type\": \"object\",","       \"properties\": {","-        \"id\": \"string\", \"courseId\": \"string\", \"title\": \"string\", \"instructions\": \"string\", \"isPractice\": \"boolean\",","-        \"status\": \"QuizStatus (DRAFT is never returned to a non-manager; that case is NOT_FOUND)\",","-        \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\",","-        \"timeLimitMinutes\": \"int | null\", \"oneQuestionPerPage\": \"boolean\", \"resultsVisibility\": \"ResultsVisibility\",","-        \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",","-        \"extraTimeMinutes\": \"int (caller's accommodation, 0 if none; 0 for parents)\",","-        \"attemptLimit\": \"int (attemptLimit(maxAttempts, extraAttempts), FR-23)\",","-        \"attemptsUsed\": \"int (caller's own attempts; 0 for parents)\",","-        \"inProgressAttemptId\": \"string | null (Resume target, FR-19)\",","-        \"isOpen\": \"boolean (PUBLISHED && availableFrom ≤ now < availableUntil)\"","+        \"percent\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },","+        \"letter\": { \"type\": [\"string\", \"null\"] },","+        \"teacherComment\": { \"type\": [\"string\", \"null\"] }","       }","     },","-    \"StudentQuestion\": {","-      \"description\": \"A question as shown in the player. It never contains correct, explanation or caseSensitive.\",","-      \"properties\": { \"id\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\", \"options\": \"Option[] | null (in seededShuffle(options, attempt.id) order when shuffleOptions, FR-13)\" }","-    },","-    \"StudentAttempt\": {","-      \"description\": \"toStudentAttempt. Returned while status = IN_PROGRESS (FR-13, FR-14, FR-19).\",","+    \"CategoryResult\": {","+      \"type\": \"object\",","+      \"description\": \"id null = implicit 'Uncategorised' bucket (weight 0 when the course has categories, A8).\",","       \"properties\": {","-        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\", \"status\": \"\\\"IN_PROGRESS\\\"\",","-        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime (always set: untimed attempts use availableUntil)\",","-        \"serverNow\": \"ISO datetime (lets the display-only timer correct for client clock skew, ADR-4)\",","-        \"oneQuestionPerPage\": \"boolean\",","-        \"questions\": \"StudentQuestion[] (in the frozen questionOrder)\",","-        \"answers\": \"{ questionId: string, response: AnswerResponse | null, savedAt: ISO datetime }[] (no grading fields)\"","+        \"id\": { \"type\": [\"string\", \"null\"] },","+        \"name\": { \"type\": \"string\" },","+        \"weightPercent\": { \"$ref\": \"#/components/Decimal2Out\" },","+        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },","+        \"earned\": { \"$ref\": \"#/components/Decimal2Out\" },","+        \"possible\": { \"$ref\": \"#/components/Decimal2Out\" },","+        \"droppedItemIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }","       }","     },","-    \"StudentResult\": {","-      \"description\": \"toStudentResult. Returned for a submitted attempt to its owner or a linked parent (FR-20, FR-21). When resultsVisible = false, every score field is null and questions is null; the UI shows 'Submitted — results will be available later.'\",","+    \"StudentTermResult\": {","+      \"type\": \"object\",","+      \"description\": \"Output of grade-calc.computeStudentTerm, the single shared calculation (FR-10–FR-15). percent/letter are final (override applied); computed* are pre-override.\",","       \"properties\": {","-        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\",","-        \"status\": \"\\\"SUBMITTED\\\" | \\\"NEEDS_GRADING\\\" | \\\"GRADED\\\"\",","-        \"startedAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime\", \"autoSubmitted\": \"boolean\",","-        \"resultsVisible\": \"boolean\",","-        \"awaitingGrading\": \"boolean (status ≠ GRADED)\",","-        \"score\": \"Decimal | null (only when resultsVisible && status = GRADED)\",","-        \"maxScore\": \"Decimal\",","-        \"percent\": \"number | null (same condition as score)\",","-        \"questions\": \"null | { id, type, prompt, points: Decimal, options: Option[] | null, response: AnswerResponse | null, pendingReview: boolean (needsReview, A8), pointsAwarded: Decimal | null (null when pendingReview), isCorrect: boolean | null, feedback: string | null, correct?: Correct (only if showCorrectAnswers), explanation?: string | null (only if showCorrectAnswers) }[] (in questionOrder)\"","+        \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/CategoryResult\" } },","+        \"percent\": { \"$ref\": \"#/components/Percent1Out\" },","+        \"letter\": { \"type\": [\"string\", \"null\"] },","+        \"descriptor\": { \"type\": [\"string\", \"null\"] },","+        \"computedPercent\": { \"$ref\": \"#/components/Percent1Out\" },","+        \"computedLetter\": { \"type\": [\"string\", \"null\"] },","+        \"overridden\": { \"type\": \"boolean\" },","+        \"override\": { \"oneOf\": [{ \"$ref\": \"#/components/TermOverride\" }, { \"type\": \"null\" }] }","       }","     },","-    \"ManagerAnswer\": {","+    \"TermRef\": {","+      \"type\": \"object\",","       \"properties\": {","-        \"questionId\": \"string\", \"response\": \"AnswerResponse | null\", \"pointsAwarded\": \"Decimal | null\", \"isCorrect\": \"boolean | null\",","-        \"feedback\": \"string | null\", \"gradedById\": \"string | null\", \"needsReview\": \"boolean (derived, A8)\", \"updatedAt\": \"ISO datetime\"","+        \"id\": { \"type\": \"string\" },","+        \"name\": { \"type\": \"string\" },","+        \"startDate\": { \"type\": \"string\", \"format\": \"date\" },","+        \"endDate\": { \"type\": \"string\", \"format\": \"date\" },","+        \"isCurrent\": { \"type\": \"boolean\" }","       }","     },","-    \"ManagerAttempt\": {","-      \"description\": \"The full attempt for a course manager (FR-24).\",","+    \"ReportCardSnapshotV1\": {","+      \"type\": \"object\",","+      \"description\": \"snapshotSchema in src/server/report-cards/snapshot.ts. Frozen at generation; never recomputed on read or print (FR-31).\",","       \"properties\": {","-        \"id\": \"string\", \"quizId\": \"string\", \"student\": \"UserRef\", \"attemptNumber\": \"int\", \"status\": \"AttemptStatus\",","-        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime | null\", \"autoSubmitted\": \"boolean\",","-        \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\",","-        \"questionOrder\": \"string[]\",","-        \"questions\": \"ManagerQuestion[] (in questionOrder)\",","-        \"answers\": \"ManagerAnswer[]\"","+        \"v\": { \"const\": 1 },","+        \"school\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"logoUrl\": { \"type\": [\"string\", \"null\"] } } },","+        \"student\": { \"type\": \"object\", \"properties\": {","+          \"name\": { \"type\": \"string\" }, \"admissionNumber\": { \"type\": [\"string\", \"null\"] },","+          \"gradeLevel\": { \"type\": \"string\" }, \"section\": { \"type\": \"string\" }, \"homeroomTeacher\": { \"type\": [\"string\", \"null\"] } } },","+        \"term\": { \"type\": \"object\", \"properties\": {","+          \"name\": { \"type\": \"string\" }, \"startDate\": { \"type\": \"string\", \"format\": \"date\" },","+          \"endDate\": { \"type\": \"string\", \"format\": \"date\" }, \"academicYear\": { \"type\": \"string\" } } },","+        \"courses\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": {","+          \"subject\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"teacher\": { \"type\": [\"string\", \"null\"] },","+          \"percent\": { \"$ref\": \"#/components/Percent1Out\" }, \"letter\": { \"type\": [\"string\", \"null\"] },","+          \"descriptor\": { \"type\": [\"string\", \"null\"] }, \"teacherComment\": { \"type\": [\"string\", \"null\"] },","+          \"scaleName\": { \"type\": \"string\" } } } },","+        \"attendance\": { \"type\": \"object\", \"properties\": {","+          \"rate\": { \"type\": [\"string\", \"null\"], \"description\": \"Same formula as the existing attendance getReport consumers (B13).\" },","+          \"absences\": { \"type\": \"integer\" }, \"lates\": { \"type\": \"integer\" },","+          \"counts\": { \"type\": \"object\", \"additionalProperties\": { \"type\": \"integer\" } } } },","+        \"scale\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },","+        \"extraScales\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": { \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },","+          \"description\": \"Course-specific scales used by any course on the card, for the legend.\" }","       }","     }","   },"]},{"oldStart":176,"oldLines":248,"newStart":160,"newLines":511,"lines":["   \"endpoints\": [","     {","       \"method\": \"GET\",","-      \"path\": \"/api/courses/:id/quizzes\",","-      \"description\": \"Role-shaped, paginated course Quizzes tab list (FR-11). Access: assertCanViewCourse. Managers see every status. Students and parents see only PUBLISHED and CLOSED quizzes. Sorted by availableFrom desc. Runs ensureNotExpired on the caller's own IN_PROGRESS attempts before computing groups.\",","-      \"auth\": \"view course\",","+      \"path\": \"/api/grading-scales\",","+      \"description\": \"List all grading scales, default first then by name. Any authenticated user (requireUser).\",","+      \"auth\": \"any authenticated user\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradingScale\" } },","+      \"errors\": [\"UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-39\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/grading-scales\",","+      \"description\": \"Create a scale (scaleSchema). If isDefault is true, the other scales' isDefault is cleared in the same transaction. If no scale exists yet, the new scale becomes the default whatever isDefault says. The partial unique index grading_scale_one_default is the backstop. Audit gradingScale.create. Returns 201.\",","+      \"auth\": \"ADMIN\",","       \"requestSchema\": {","-        \"params\": { \"id\": \"courseId (cuid)\" },","-        \"query\": { \"page\": \"int?\", \"pageSize\": \"int? ≤ 100\" }","-      },","-      \"responseSchema\": {","-        \"envelope\": \"paginated\",","-        \"item\": {","-          \"oneOf\": {","-            \"manager\": {","-              \"role\": \"\\\"MANAGER\\\"\",","-              \"id\": \"string\", \"title\": \"string\", \"status\": \"QuizStatus\", \"isPractice\": \"boolean\",","-              \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\", \"timeLimitMinutes\": \"int | null\",","-              \"resultsVisibility\": \"ResultsVisibility\", \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",","-              \"attemptCount\": \"int\", \"averagePercent\": \"number | null (submitted+graded attempts)\", \"needsGradingCount\": \"int (attempts with status NEEDS_GRADING)\"","-            },","-            \"student\": {","-              \"role\": \"\\\"STUDENT\\\"\",","-              \"quiz\": \"StudentQuiz\",","-              \"group\": \"\\\"UPCOMING\\\" | \\\"AVAILABLE\\\" | \\\"COMPLETED\\\" | \\\"MISSED\\\". UPCOMING = now < availableFrom. AVAILABLE = isOpen && (attemptsUsed < attemptLimit || inProgressAttemptId). COMPLETED = ≥ 1 submitted attempt and not AVAILABLE. MISSED = now ≥ availableUntil with 0 attempts (A2).\",","-              \"latestResult\": \"{ attemptId: string, status: AttemptStatus, score: Decimal | null, maxScore: Decimal, percent: number | null } | null (scores null unless resultsVisible)\"","-            },","-            \"parent\": {","-              \"role\": \"\\\"PARENT\\\"\",","-              \"student\": \"UserRef (linked child enrolled in the course; one row per child × quiz)\",","-              \"quiz\": \"StudentQuiz\",","-              \"results\": \"{ attemptId: string, attemptNumber: int, submittedAt: ISO datetime, score: Decimal | null, maxScore: Decimal, percent: number | null }[] (only attempts where resultsVisible, read-only)\"","-            }","-          }","+        \"type\": \"object\",","+        \"required\": [\"name\", \"bands\"],","+        \"properties\": {","+          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },","+          \"isDefault\": { \"type\": \"boolean\", \"default\": false },","+          \"bands\": { \"$ref\": \"#/components/Bands\" }","         }","       },","-      \"errors\": [\"NOT_FOUND (course not visible)\"],","-      \"requirementIds\": [\"FR-11\", \"FR-31\", \"FR-33\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\"]","+      \"responseSchema\": { \"$ref\": \"#/components/GradingScale\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-16\", \"FR-39\", \"NFR-13\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/courses/:id/quizzes\",","-      \"description\": \"Creates a DRAFT quiz. The /quizzes/new page sends defaults and then redirects to /edit (FR-6). createdById = caller. Returns 201.\",","-      \"auth\": \"manage course\",","+      \"method\": \"PATCH\",","+      \"path\": \"/api/grading-scales/:id\",","+      \"description\": \"Partial update. isDefault: true clears the other defaults in a transaction. isDefault: false on the current default is a VALIDATION_ERROR (make another scale default instead), so exactly one default always exists. Published report cards keep their embedded legend. Audit gradingScale.update with {old, new}.\",","+      \"auth\": \"ADMIN\",","       \"requestSchema\": {","-        \"params\": { \"id\": \"courseId\" },","-        \"body\": \"QuizSettingsInput with title, availableFrom and availableUntil required; every other field optional (FR-1 defaults)\"","+        \"type\": \"object\",","+        \"minProperties\": 1,","+        \"properties\": {","+          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },","+          \"isDefault\": { \"type\": \"boolean\" },","+          \"bands\": { \"$ref\": \"#/components/Bands\" }","+        }","       },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\", \"status\": 201 },","-      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (cannot manage course)\"],","-      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-31\", \"FR-34\"]","+      \"responseSchema\": { \"$ref\": \"#/components/GradingScale\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-16\", \"FR-39\"]","     },","     {","+      \"method\": \"DELETE\",","+      \"path\": \"/api/grading-scales/:id\",","+      \"description\": \"Delete a scale. CONFLICT if it is the default or any Course.gradingScaleId references it (details: { courseCount }) (A11). Audit gradingScale.delete.\",","+      \"auth\": \"ADMIN\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" } } },","+      \"errors\": [\"CONFLICT\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-16\", \"FR-39\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/quizzes/:id\",","-      \"description\": \"Manager: ManagerQuiz, the full quiz including correct answers. STUDENT (ACTIVE enrollee) or PARENT (linked to an enrollee): toStudentQuiz, with no questions and never `correct`. A DRAFT quiz is NOT_FOUND for non-managers.\",","+      \"path\": \"/api/courses/:id/grade-categories\",","+      \"description\": \"The course's categories ordered by `order`, plus its scale setting. gradingScaleId null means the school default; effectiveScale is the scale actually used.\",","       \"auth\": \"view course\",","-      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"ManagerQuiz\", \"StudentQuiz\"] } },","-      \"errors\": [\"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-12\", \"FR-31\", \"FR-34\", \"NFR-1\", \"NFR-5\"]","+      \"requestSchema\": {},","+      \"responseSchema\": {","+        \"type\": \"object\",","+        \"properties\": {","+          \"gradingScaleId\": { \"type\": [\"string\", \"null\"] },","+          \"effectiveScale\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },","+          \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeCategory\" } }","+        }","+      },","+      \"errors\": [\"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-17\", \"FR-2\", \"FR-39\"]","     },","     {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/quizzes/:id\",","-      \"description\": \"Updates settings and/or the status transition. Allowed transitions are DRAFT→PUBLISHED and PUBLISHED→CLOSED only (A9); any other change is CONFLICT. Publishing runs canPublish: if there are problems it returns VALIDATION_ERROR with details {problems: string[]} (FR-9). Otherwise it does a conditional updateMany where status = DRAFT, and only if that updated a row is notify('quiz.published') sent, after commit, to ACTIVE enrollees (FR-29). resultsReleasedAt cannot be set here; use release-results.\",","-      \"auth\": \"manage course\",","+      \"method\": \"PUT\",","+      \"path\": \"/api/courses/:id/grade-categories\",","+      \"description\": \"Replace the full category list in one transaction: rows with an id are updated, rows without one are created, and existing categories missing from the list are deleted (GradeItem/Assignment/Quiz.categoryId → null via SetNull). A non-empty list must total exactly 100 using dec(sum).eq(100); otherwise VALIDATION_ERROR with details { sum: \\\"90.00\\\" } so the UI can show 'Weights total 90 / 100'. An empty list is allowed (the course then uses points totals, FR-12). Names are unique within the request (case-insensitive). Ids must belong to this course (else VALIDATION_ERROR). If gradingScaleId is present it is set too (null = school default; an unknown id is VALIDATION_ERROR). Audit gradeCategories.replace with {old, new}. Returns the same shape as GET.\",","+      \"auth\": \"manage\",","       \"requestSchema\": {","-        \"params\": { \"id\": \"quizId\" },","-        \"body\": \"Partial<QuizSettingsInput> & { status?: \\\"PUBLISHED\\\" | \\\"CLOSED\\\" } (at least one key)\"","+        \"type\": \"object\",","+        \"required\": [\"categories\"],","+        \"properties\": {","+          \"categories\": {","+            \"type\": \"array\",","+            \"maxItems\": 20,","+            \"items\": {","+              \"type\": \"object\",","+              \"required\": [\"name\", \"weightPercent\", \"order\"],","+              \"properties\": {","+                \"id\": { \"type\": \"string\" },","+                \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 60 },","+                \"weightPercent\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"minimum\": 0, \"maximum\": 100 },","+                \"dropLowest\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 50, \"default\": 0 },","+                \"order\": { \"type\": \"integer\", \"minimum\": 0 }","+              }","+            }","+          },","+          \"gradingScaleId\": { \"type\": [\"string\", \"null\"] }","+        }","       },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\" },","-      \"errors\": [\"VALIDATION_ERROR (schema, cross-field rule, or publish problems)\", \"CONFLICT (invalid status transition)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-9\", \"FR-29\", \"FR-31\"]","+      \"responseSchema\": { \"$ref\": \"#/endpoints/4/responseSchema\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-17\", \"FR-40\", \"FR-2\", \"FR-12\", \"NFR-1\", \"NFR-4\"]","     },","     {","-      \"method\": \"DELETE\",","-      \"path\": \"/api/quizzes/:id\",","-      \"description\": \"Deletes the quiz (questions and accommodations cascade). Allowed only while no attempt exists.\",","-      \"auth\": \"manage course\",","-      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },","-      \"errors\": [\"CONFLICT (quiz has attempts)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-31\"]","+      \"method\": \"GET\",","+      \"path\": \"/api/courses/:id/gradebook\",","+      \"description\": \"Full gradebook for one term in one denormalised payload, loaded with the batched load.ts queries plus the submission/attempt lookups, and computed in memory (NFR-2: 35×80 < 800 ms). Query: termId (optional; defaults to the term containing today in the course's academic year, else the first term). format=csv returns text/csv (Content-Disposition: attachment; filename=\\\"<courseCode>-<termName>-gradebook.csv\\\") built with toCsv: columns Last name, First name, one per item ('<title> (/<max>)', cell = score | EX | M | blank), one per category average, Term %, Letter. That is the grid as displayed: same row order, and hidden items included as the teacher sees them. Students are active enrollments sorted by lastName, firstName. Items are sorted by category order, then dueAt (nulls last), then title. Each grade cell carries isLate and submissionId/attemptId for the late icon and click-through.\",","+      \"auth\": \"manage\",","+      \"requestSchema\": {","+        \"query\": {","+          \"termId\": { \"type\": \"string\" },","+          \"format\": { \"enum\": [\"json\", \"csv\"], \"default\": \"json\" }","+        }","+      },","+      \"responseSchema\": {","+        \"type\": \"object\",","+        \"properties\": {","+          \"course\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },","+          \"term\": { \"$ref\": \"#/components/TermRef\" },","+          \"terms\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/TermRef\" } },","+          \"scale\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"bands\": { \"$ref\": \"#/components/Bands\" } } },","+          \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeCategory\" } },","+          \"items\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/GradeItem\" } },","+          \"rows\": {","+            \"type\": \"array\",","+            \"items\": {","+              \"type\": \"object\",","+              \"properties\": {","+                \"student\": { \"type\": \"object\", \"properties\": {","+                  \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" },","+                  \"admissionNumber\": { \"type\": [\"string\", \"null\"] } } },","+                \"cells\": {","+                  \"type\": \"object\",","+                  \"description\": \"Keyed by gradeItemId; every item has a cell.\",","+                  \"additionalProperties\": {","+                    \"allOf\": [{ \"$ref\": \"#/components/Grade\" }],","+                    \"properties\": {","+                      \"isLate\": { \"type\": \"boolean\" },","+                      \"submissionId\": { \"type\": [\"string\", \"null\"], \"description\": \"ASSIGNMENT items: link to the existing submission grading page (FR-21).\" },","+                      \"attemptId\": { \"type\": [\"string\", \"null\"], \"description\": \"QUIZ items: the attempt the score came from, by scoring policy.\" }","+                    }","+                  }","+                },","+                \"result\": { \"$ref\": \"#/components/StudentTermResult\" }","+              }","+            }","+          }","+        }","+      },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-18\", \"FR-19\", \"FR-21\", \"FR-24\", \"FR-25\", \"FR-15\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"NFR-2\", \"NFR-8\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/quizzes/:id/questions\",","-      \"description\": \"Adds a question at order = max + 1. The builder's Duplicate action is this call with a copied body (FR-7). Edit lock: CONFLICT when the quiz has attempts (FR-10). Returns 201.\",","-      \"auth\": \"manage course\",","-      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"QuestionInput\" },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\", \"status\": 201 },","-      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]","+      \"path\": \"/api/courses/:id/grade-items\",","+      \"description\": \"Create a MANUAL grade item (manualItemSchema). categoryId must belong to the course. termId must be a term of the course's academic year. Returns 201.\",","+      \"auth\": \"manage\",","+      \"requestSchema\": {","+        \"type\": \"object\",","+        \"required\": [\"title\", \"maxPoints\", \"termId\"],","+        \"properties\": {","+          \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 200 },","+          \"categoryId\": { \"type\": [\"string\", \"null\"] },","+          \"maxPoints\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"exclusiveMinimum\": 0, \"maximum\": 1000 },","+          \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","+          \"termId\": { \"type\": \"string\" }","+        }","+      },","+      \"responseSchema\": { \"$ref\": \"#/components/GradeItem\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-22\", \"FR-39\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/quizzes/:id/questions/reorder\",","-      \"description\": \"Rewrites Question.order to match the given list, in one transaction. The list must be exactly the quiz's question ids (a permutation), otherwise VALIDATION_ERROR. Blocked by the edit lock.\",","-      \"auth\": \"manage course\",","-      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": { \"questionIds\": \"string[]\" } },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion[] (new order)\" },","-      \"errors\": [\"VALIDATION_ERROR (not a permutation)\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]","-    },","-    {","       \"method\": \"PATCH\",","-      \"path\": \"/api/questions/:id\",","-      \"description\": \"Edits a question. Without attempts, any QuestionInput field can change; the result is re-validated as a whole against the type's schema. With attempts (edit lock, FR-10), only prompt and explanation can change, plus correct.accepted and caseSensitive for SHORT_ANSWER. Any other key gives CONFLICT with the message 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.' Editing never triggers a regrade (A3).\",","-      \"auth\": \"manage course (of the question's quiz)\",","-      \"requestSchema\": { \"params\": { \"id\": \"questionId\" }, \"body\": \"Partial<QuestionInput>\" },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\" },","-      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]","+      \"path\": \"/api/grade-items/:id\",","+      \"description\": \"Update an item (itemPatchSchema). MANUAL items accept every field. ASSIGNMENT/QUIZ items accept only isVisible; any other field is a VALIDATION_ERROR ('Edit this item at its source'). isVisible: false hides the item from students/parents and removes it from calculation (FR-24). Sync changes isVisible only on source visibility transitions, so a teacher's hide survives source re-saves (A7). Lowering maxPoints below an existing score on a MANUAL item is a VALIDATION_ERROR.\",","+      \"auth\": \"manage (via the item's course)\",","+      \"requestSchema\": {","+        \"type\": \"object\",","+        \"minProperties\": 1,","+        \"properties\": {","+          \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 200 },","+          \"categoryId\": { \"type\": [\"string\", \"null\"] },","+          \"maxPoints\": { \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"exclusiveMinimum\": 0, \"maximum\": 1000 },","+          \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","+          \"termId\": { \"type\": \"string\" },","+          \"isVisible\": { \"type\": \"boolean\" }","+        }","+      },","+      \"responseSchema\": { \"$ref\": \"#/components/GradeItem\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-9\", \"FR-24\", \"FR-22\", \"NFR-5\"]","     },","     {","       \"method\": \"DELETE\",","-      \"path\": \"/api/questions/:id\",","-      \"description\": \"Deletes a question and closes the gap in order. Blocked by the edit lock.\",","-      \"auth\": \"manage course\",","-      \"requestSchema\": { \"params\": { \"id\": \"questionId\" } },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },","-      \"errors\": [\"CONFLICT (edit lock)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]","+      \"path\": \"/api/grade-items/:id\",","+      \"description\": \"Delete a MANUAL item; its grades cascade. Non-MANUAL items are a VALIDATION_ERROR, because deleting the source deletes them (FR-4). Audit gradeItem.delete with the item and its grades as `old`.\",","+      \"auth\": \"manage (via the item's course)\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" } } },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-9\", \"FR-22\", \"NFR-4\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/quizzes/:id/regrade\",","-      \"description\": \"In one transaction: re-runs gradeAnswer on every answer with gradedById = null across submitted attempts (manual grades always win, A8), runs recomputeAttempt on each attempt, then writes audit('quiz.regrade').\",","-      \"auth\": \"manage course\",","-      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"attemptCount\": \"int\", \"changedAnswerCount\": \"int\" } },","-      \"errors\": [\"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-10\", \"FR-25\", \"FR-38\"]","+      \"path\": \"/api/grade-items/:id/mark-missing\",","+      \"description\": \"Column action 'Set all ungraded to missing'. Requires item.dueAt to be set and now > dueAt (A5); otherwise VALIDATION_ERROR. For every actively enrolled student whose grade has score null, excused false and missing false (including students with no Grade row), sets missing = true in one transaction. Allowed on any source: it only touches rows with no score, so it never overrides a synced score (FR-9). A later sync that writes a score makes it count normally. One audit row grade.markMissing with { itemId, studentIds }. No notifications.\",","+      \"auth\": \"manage (via the item's course)\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"updatedCount\": { \"type\": \"integer\" }, \"studentIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } } },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-24\", \"FR-10\", \"NFR-4\", \"NFR-10\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/quizzes/:id/release-results\",","-      \"description\": \"MANUAL visibility only. Runs updateMany({id, resultsVisibility: MANUAL, resultsReleasedAt: null} → now). If that updated a row, it calls notifyStudentAndParents('quiz.results_released') for every student with a submitted attempt, then audit('quiz.release_results'). A repeat call is a no-op that returns the existing timestamp. A non-MANUAL quiz is CONFLICT.\",","-      \"auth\": \"manage course\",","-      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"resultsReleasedAt\": \"ISO datetime\", \"notified\": \"boolean (false on repeat)\" } },","-      \"errors\": [\"CONFLICT (resultsVisibility ≠ MANUAL)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-20\", \"FR-30\", \"FR-38\"]","+      \"method\": \"PUT\",","+      \"path\": \"/api/grade-items/:id/grades/:studentId\",","+      \"description\": \"Upsert one grade cell (gradePutSchema; at least one field). MANUAL items: all fields; score must satisfy 0 ≤ score ≤ maxPoints. Grid keys map to E → {excused: true}, M → {missing: true}, Delete → {score: null, excused: false, missing: false}. ASSIGNMENT/QUIZ items: comment only; any other field is a VALIDATION_ERROR (FR-9). studentId must be actively enrolled in the item's course (else NOT_FOUND). Audit grade.update with {old, new} for every change. After commit, if the item is MANUAL and score went from null to a value, notifyStudentAndParents('grade.posted') once (A9). Returns the saved cell plus the student's recomputed term result so the grid refreshes the category and term columns.\",","+      \"auth\": \"manage (via the item's course)\",","+      \"requestSchema\": {","+        \"type\": \"object\",","+        \"minProperties\": 1,","+        \"properties\": {","+          \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2In\" }, { \"type\": \"null\" }] },","+          \"excused\": { \"type\": \"boolean\" },","+          \"missing\": { \"type\": \"boolean\" },","+          \"comment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }","+        }","+      },","+      \"responseSchema\": {","+        \"type\": \"object\",","+        \"properties\": {","+          \"grade\": { \"$ref\": \"#/components/Grade\" },","+          \"result\": { \"$ref\": \"#/components/StudentTermResult\" }","+        }","+      },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-20\", \"FR-9\", \"FR-19\", \"FR-38\", \"NFR-4\", \"NFR-1\"]","     },","     {","+      \"method\": \"PUT\",","+      \"path\": \"/api/courses/:id/term-overrides/:studentId\",","+      \"description\": \"Upsert a TermGradeOverride (termOverrideSchema). termId must be a term of the course's year. letter must exist in the course's effective scale (else VALIDATION_ERROR). Percent-only re-derives the letter from the scale (A12). Letter-only keeps the computed percent (FR-14, AC-6). Setting all three to null clears the override but keeps the row. studentId must be enrolled (else NOT_FOUND). Audit termOverride.upsert with {old, new}. Returns the override and the recomputed result.\",","+      \"auth\": \"manage\",","+      \"requestSchema\": {","+        \"type\": \"object\",","+        \"required\": [\"termId\"],","+        \"properties\": {","+          \"termId\": { \"type\": \"string\" },","+          \"percent\": { \"oneOf\": [{ \"allOf\": [{ \"$ref\": \"#/components/Decimal2In\" }], \"minimum\": 0, \"maximum\": 100 }, { \"type\": \"null\" }] },","+          \"letter\": { \"type\": [\"string\", \"null\"], \"maxLength\": 5 },","+          \"teacherComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }","+        }","+      },","+      \"responseSchema\": {","+        \"type\": \"object\",","+        \"properties\": {","+          \"override\": { \"$ref\": \"#/components/TermOverride\" },","+          \"result\": { \"$ref\": \"#/components/StudentTermResult\" }","+        }","+      },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-23\", \"FR-14\", \"NFR-4\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/quizzes/:id/analytics\",","-      \"description\": \"Quiz analytics computed in memory over submitted attempts (FR-26, FR-27). With ?format=csv it returns text/csv (Content-Disposition: attachment; filename=\\\"quiz-<id>-attempts.csv\\\"), built with toCsv. CSV columns: student, attemptNumber, score, then one points column per question in quiz order.\",","-      \"auth\": \"manage course\",","-      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"query\": { \"format\": \"\\\"json\\\" | \\\"csv\\\" (default json)\" } },","+      \"path\": \"/api/students/:id/grades\",","+      \"description\": \"Student/parent grades view for one term (default: current term). Optional courseId limits the response to one course (course Grades tab, FR-28). Only visible items are loaded (filtered in the query), and the calculation runs over those items, so totals match what is shown. Grade rows only ever hold released scores (sync gating), so no further score filtering is needed. Courses are the student's active enrollments in the term's academic year, ordered by course name. colour: ≥ 80 success (green), 60–79.9 warning (amber), < 60 error (red), null when percent is null. Whitelist serializer: no updatedById, no hidden items, no submission/attempt ids.\",","+      \"auth\": \"view student\",","+      \"requestSchema\": {","+        \"query\": {","+          \"termId\": { \"type\": \"string\" },","+          \"courseId\": { \"type\": \"string\" }","+        }","+      },","       \"responseSchema\": {","-        \"envelope\": \"data (json) | raw text/csv\",","-        \"data\": {","-          \"summary\": { \"attempts\": \"int\", \"average\": \"Decimal | null\", \"median\": \"Decimal | null\", \"highest\": \"Decimal | null\", \"lowest\": \"Decimal | null\", \"averageTimeSeconds\": \"int | null\" },","-          \"histogram\": \"{ bucket: \\\"0–10\\\" | … | \\\"90–100\\\", count: int }[10] (by percent; 100% goes in the last bucket)\",","-          \"questions\": \"{ questionId, order: int, type: QuestionType, prompt, points: Decimal, percentCorrect: number | null, averagePoints: Decimal | null, optionDistribution: { optionId, text, count: int, isCorrect: boolean }[] | null (choice types only), mostChosenWrongOptionId: string | null }[]\"","+        \"type\": \"object\",","+        \"properties\": {","+          \"student\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" } } },","+          \"term\": { \"$ref\": \"#/components/TermRef\" },","+          \"terms\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/TermRef\" } },","+          \"courses\": {","+            \"type\": \"array\",","+            \"items\": {","+              \"type\": \"object\",","+              \"properties\": {","+                \"course\": { \"type\": \"object\", \"properties\": {","+                  \"id\": { \"type\": \"string\" }, \"code\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"teacherName\": { \"type\": [\"string\", \"null\"] } } },","+                \"percent\": { \"$ref\": \"#/components/Percent1Out\" },","+                \"letter\": { \"type\": [\"string\", \"null\"] },","+                \"descriptor\": { \"type\": [\"string\", \"null\"] },","+                \"colour\": { \"enum\": [\"success\", \"warning\", \"error\", null] },","+                \"categories\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/CategoryResult\" } },","+                \"items\": {","+                  \"type\": \"array\",","+                  \"items\": {","+                    \"type\": \"object\",","+                    \"properties\": {","+                      \"id\": { \"type\": \"string\" },","+                      \"title\": { \"type\": \"string\" },","+                      \"categoryId\": { \"type\": [\"string\", \"null\"] },","+                      \"categoryName\": { \"type\": \"string\" },","+                      \"maxPoints\": { \"$ref\": \"#/components/Decimal2Out\" },","+                      \"dueAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","+                      \"score\": { \"oneOf\": [{ \"$ref\": \"#/components/Decimal2Out\" }, { \"type\": \"null\" }] },","+                      \"percent\": { \"$ref\": \"#/components/Percent1Out\" },","+                      \"comment\": { \"type\": [\"string\", \"null\"] },","+                      \"missing\": { \"type\": \"boolean\" },","+                      \"excused\": { \"type\": \"boolean\" },","+                      \"dropped\": { \"type\": \"boolean\" }","+                    }","+                  }","+                }","+              }","+            }","+          }","         }","       },","-      \"errors\": [\"VALIDATION_ERROR (bad format)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-26\", \"FR-27\"]","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-42\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-15\", \"NFR-5\", \"NFR-6\"]","     },","     {","-      \"method\": \"PUT\",","-      \"path\": \"/api/quizzes/:id/accommodations/:studentId\",","-      \"description\": \"Upserts the QuizAccommodation for one ACTIVE enrollee, then writes audit('quiz.accommodation'). It applies only to attempts started afterwards, because deadlineAt is frozen at start (A7). Sending {0, 0} keeps the row; that is equivalent to no accommodation.\",","-      \"auth\": \"manage course\",","+      \"method\": \"GET\",","+      \"path\": \"/api/report-cards\",","+      \"description\": \"Two modes. (A) Without studentId: the admin/homeroom roster for a term. termId is required; gradeLevelId and sectionId are optional filters. ADMIN sees all sections. A TEACHER is limited to sections where Section.homeroomTeacherId = user (filters outside those return an empty list). Other roles get FORBIDDEN. Returns one row per active student in scope, including students with no card yet (status NOT_GENERATED), sorted by section then lastName. Warnings are computed in the same batched pass (NFR-3). (B) With studentId: the student's cards across terms (termId optional filter), newest term first, for the Report cards tab (FR-36). Access is view student. STUDENT/PARENT get PUBLISHED cards only. ADMIN and the student's teachers get all.\",","+      \"auth\": \"(A) ADMIN, homeroom TEACHER; (B) view student\",","       \"requestSchema\": {","-        \"params\": { \"id\": \"quizId\", \"studentId\": \"userId (must be ACTIVE enrolled in the course)\" },","-        \"body\": { \"extraTimeMinutes\": \"int 0–300\", \"extraAttempts\": \"int 0–5\" }","+        \"query\": {","+          \"termId\": { \"type\": \"string\", \"description\": \"Required in mode A.\" },","+          \"gradeLevelId\": { \"type\": \"string\" },","+          \"sectionId\": { \"type\": \"string\" },","+          \"studentId\": { \"type\": \"string\" }","+        }","       },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"quizId\": \"string\", \"studentId\": \"string\", \"extraTimeMinutes\": \"int\", \"extraAttempts\": \"int\" } },","-      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (quiz or student not in course)\"],","-      \"requirementIds\": [\"FR-28\", \"FR-2\", \"FR-23\", \"FR-38\"]","+      \"responseSchema\": {","+        \"oneOf\": [","+          {","+            \"title\": \"RosterRow[] (mode A)\",","+            \"type\": \"array\",","+            \"items\": {","+              \"type\": \"object\",","+              \"properties\": {","+                \"student\": { \"type\": \"object\", \"properties\": {","+                  \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" },","+                  \"admissionNumber\": { \"type\": [\"string\", \"null\"] },","+                  \"gradeLevel\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },","+                  \"section\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } } } },","+                \"status\": { \"enum\": [\"NOT_GENERATED\", \"DRAFT\", \"PUBLISHED\"] },","+                \"reportCard\": { \"oneOf\": [{ \"type\": \"null\" }, { \"type\": \"object\", \"properties\": {","+                  \"id\": { \"type\": \"string\" }, \"generatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },","+                  \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","+                  \"hasHomeroomComment\": { \"type\": \"boolean\" }, \"hasPrincipalComment\": { \"type\": \"boolean\" } } }] },","+                \"warnings\": {","+                  \"type\": \"array\",","+                  \"items\": {","+                    \"type\": \"object\",","+                    \"properties\": {","+                      \"type\": { \"enum\": [\"UNGRADED_ITEMS\", \"MISSING_TEACHER_COMMENT\"] },","+                      \"courseId\": { \"type\": \"string\" },","+                      \"courseCode\": { \"type\": \"string\" },","+                      \"count\": { \"type\": \"integer\", \"description\": \"UNGRADED_ITEMS: visible, past-due items with no score that are neither missing nor excused.\" }","+                    }","+                  }","+                }","+              }","+            }","+          },","+          {","+            \"title\": \"StudentCard[] (mode B)\",","+            \"type\": \"array\",","+            \"items\": {","+              \"type\": \"object\",","+              \"properties\": {","+                \"id\": { \"type\": \"string\" },","+                \"term\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"academicYear\": { \"type\": \"string\" } } },","+                \"status\": { \"enum\": [\"DRAFT\", \"PUBLISHED\"] },","+                \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" }","+              }","+            }","+          }","+        ]","+      },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-29\", \"FR-33\", \"FR-36\", \"FR-37\", \"NFR-3\", \"NFR-5\", \"NFR-6\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/quizzes/:id/attempts\",","-      \"description\": \"STUDENT start or resume (system-design §4.2). Requires the quiz to be PUBLISHED with availableFrom ≤ now < availableUntil, else CONFLICT. An existing IN_PROGRESS attempt goes through ensureNotExpired and is returned with 200 (resume, FR-19). Otherwise, attempt count ≥ attemptLimit is CONFLICT (FR-23). Otherwise the attempt is created with id pre-generated, questionOrder frozen (seededShuffle by id when shuffleQuestions) and deadlineAt = computeDeadline(...), and returned with 201. A P2002 race on the partial unique index re-reads and returns the IN_PROGRESS attempt with 200.\",","-      \"auth\": \"role STUDENT + view course (ACTIVE enrollee)\",","-      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentAttempt\", \"status\": \"201 created | 200 resumed\" },","-      \"errors\": [\"CONFLICT (quiz not open | attempt limit reached)\", \"NOT_FOUND (quiz not visible)\", \"FORBIDDEN is not used; a non-STUDENT gets NOT_FOUND\"],","-      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-19\", \"FR-23\", \"FR-28\", \"FR-32\", \"NFR-1\"]","+      \"path\": \"/api/report-cards/generate\",","+      \"description\": \"Build or refresh snapshots (generateSchema). Students not enrolled in the term's academic year are skipped. Missing cards are created as DRAFT (createMany skipDuplicates). Existing DRAFT cards get a new snapshot and generatedAt via updateMany WHERE status = 'DRAFT'. PUBLISHED cards are never touched (FR-31, AC-8). Comments on existing drafts are preserved. Batched loads, in-memory calc, writes in chunks of 100 (NFR-3: 600 × 8 < 30 s).\",","+      \"auth\": \"ADMIN\",","+      \"requestSchema\": {","+        \"type\": \"object\",","+        \"required\": [\"termId\", \"studentIds\"],","+        \"properties\": {","+          \"termId\": { \"type\": \"string\" },","+          \"studentIds\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } }","+        }","+      },","+      \"responseSchema\": {","+        \"type\": \"object\",","+        \"properties\": {","+          \"created\": { \"type\": \"integer\" },","+          \"refreshed\": { \"type\": \"integer\" },","+          \"skippedPublished\": { \"type\": \"integer\" },","+          \"skippedNotEnrolled\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }","+        }","+      },","+      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-30\", \"FR-31\", \"NFR-3\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/attempts/:id\",","-      \"description\": \"Calls ensureNotExpired first (FR-18), then assertCanAccessAttempt (FR-34). Owner: StudentAttempt while IN_PROGRESS, otherwise StudentResult. Linked PARENT: StudentResult, and only if the attempt is submitted and resultsVisible, else NOT_FOUND. Course manager: ManagerAttempt. Any other caller gets NOT_FOUND.\",","-      \"auth\": \"owner | linked parent (read-only) | course manager\",","-      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" } },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"StudentAttempt\", \"StudentResult\", \"ManagerAttempt\"] } },","+      \"path\": \"/api/report-cards/:id\",","+      \"description\": \"One card for the review and print pages. assertCanViewReportCard: ADMIN; a TEACHER who teaches any course of the student or is their homeroom teacher; the STUDENT themselves or a linked PARENT only when status = PUBLISHED. Everyone else gets NOT_FOUND, so a 7B student cannot tell that Sam's card exists (FR-37, AC-7). The body comes from the snapshot only and is never recomputed. permissions tells the review page which fields to enable. publishedById is omitted for STUDENT/PARENT.\",","+      \"auth\": \"assertCanViewReportCard\",","+      \"requestSchema\": {},","+      \"responseSchema\": {","+        \"type\": \"object\",","+        \"properties\": {","+          \"id\": { \"type\": \"string\" },","+          \"studentId\": { \"type\": \"string\" },","+          \"termId\": { \"type\": \"string\" },","+          \"status\": { \"enum\": [\"DRAFT\", \"PUBLISHED\"] },","+          \"snapshot\": { \"$ref\": \"#/components/ReportCardSnapshotV1\" },","+          \"homeroomComment\": { \"type\": [\"string\", \"null\"] },","+          \"principalComment\": { \"type\": [\"string\", \"null\"] },","+          \"generatedAt\": { \"type\": \"string\", \"format\": \"date-time\" },","+          \"publishedAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","+          \"publishedById\": { \"type\": [\"string\", \"null\"] },","+          \"permissions\": { \"type\": \"object\", \"properties\": {","+            \"canEditHomeroomComment\": { \"type\": \"boolean\" },","+            \"canEditPrincipalComment\": { \"type\": \"boolean\" },","+            \"canPublish\": { \"type\": \"boolean\" } } }","+        }","+      },","       \"errors\": [\"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-24\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\"]","+      \"requirementIds\": [\"FR-37\", \"FR-32\", \"FR-35\", \"FR-36\", \"NFR-5\", \"NFR-11\"]","     },","     {","-      \"method\": \"PUT\",","-      \"path\": \"/api/attempts/:id/answers/:questionId\",","-      \"description\": \"Autosave hot path (system-design §4.3, NFR-2): one attempt read, no Quiz or Question load, then one QuizAnswer upsert on the (attemptId, questionId) PK. Checks: studentId ≠ caller → NOT_FOUND; questionId ∉ questionOrder → NOT_FOUND; status ≠ IN_PROGRESS → CONFLICT; now > deadlineAt + 30 s → submitAttempt(id, {auto: true}) then CONFLICT 'Time is up' (FR-16). Idempotent, so localStorage replays are safe (FR-15). response: null clears the answer.\",","-      \"auth\": \"owner (STUDENT)\",","+      \"method\": \"PATCH\",","+      \"path\": \"/api/report-cards/:id\",","+      \"description\": \"Edit comments (reportCardPatchSchema). Access is checked per field: homeroomComment needs ADMIN or the homeroom teacher of the student's section; principalComment needs ADMIN only. A field the caller may not edit is FORBIDDEN. Callers who cannot view the card get NOT_FOUND. Only DRAFT cards can be edited; PUBLISHED returns CONFLICT ('Unpublish to edit') (A13). Returns the same shape as GET.\",","+      \"auth\": \"ADMIN; homeroom TEACHER (homeroomComment only)\",","       \"requestSchema\": {","-        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId\" },","-        \"body\": { \"response\": \"AnswerResponse | null\" }","+        \"type\": \"object\",","+        \"minProperties\": 1,","+        \"properties\": {","+          \"homeroomComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 },","+          \"principalComment\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 }","+        }","       },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"questionId\": \"string\", \"savedAt\": \"ISO datetime\" }, \"note\": \"Carries no grading data (NFR-1). On 409 the client stops its queue, clears localStorage['quiz-attempt:<id>'] and routes to the result page.\" },","-      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (not in progress | past deadline + grace)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-32\", \"NFR-2\", \"NFR-1\"]","+      \"responseSchema\": { \"$ref\": \"#/endpoints/16/responseSchema\" },","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],","+      \"requirementIds\": [\"FR-32\", \"FR-33\", \"NFR-6\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/attempts/:id/submit\",","-      \"description\": \"Runs submitAttempt(id, {auto: false}) (system-design §4.4). The IN_PROGRESS → SUBMITTED claim is atomic; missing answers are created as null, every answer is auto-graded, then recomputeAttempt sets status NEEDS_GRADING or GRADED (FR-17). An already-submitted attempt returns its current state with 200 (idempotent, no error). A submit after the deadline still succeeds as a manual submit; nothing is lost because the answers were already saved.\",","-      \"auth\": \"owner (STUDENT)\",","-      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" }, \"body\": \"none\" },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentResult\" },","-      \"errors\": [\"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-17\", \"FR-25\", \"FR-32\", \"NFR-1\"]","-    },","-    {","-      \"method\": \"PUT\",","-      \"path\": \"/api/attempts/:id/answers/:questionId/grade\",","-      \"description\": \"Manual grade or override (FR-24). The attempt must be submitted (not IN_PROGRESS), else CONFLICT. pointsAwarded must be ≤ question.points and a multiple of 0.5, else VALIDATION_ERROR. Sets pointsAwarded, isCorrect = (pointsAwarded == question.points), feedback and gradedById = caller, upserting the answer row if it is missing. Then recomputeAttempt (FR-25), and audit('quizAnswer.grade') after commit. No notification is sent (FR-30). The body field is named pointsAwarded per the PRD API table (system-design §3.2 calls it `points`; manualGradeSchema should use pointsAwarded).\",","-      \"auth\": \"manage course\",","+      \"path\": \"/api/report-cards/publish\",","+      \"description\": \"Publish one card or a bulk filtered list (publishSchema). Only DRAFT cards change: updateMany WHERE id IN ids AND status = 'DRAFT' sets status PUBLISHED, publishedAt = now and publishedById = user. Ids that are unknown or already published are returned in skippedIds. Audit reportCard.publish. After commit, notify report_card.published (defaultEmail true) to the student and linked parents for each published card.\",","+      \"auth\": \"ADMIN\",","       \"requestSchema\": {","-        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId (must be in questionOrder)\" },","-        \"body\": { \"pointsAwarded\": \"number | string, ≥ 0, step 0.5\", \"feedback\": \"string | null (optional)\" }","+        \"type\": \"object\",","+        \"required\": [\"ids\"],","+        \"properties\": {","+          \"ids\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } }","+        }","       },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"answer\": \"ManagerAnswer\", \"attempt\": { \"id\": \"string\", \"status\": \"AttemptStatus\", \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\" } } },","-      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (attempt in progress)\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-4\", \"FR-38\"]","+      \"responseSchema\": {","+        \"type\": \"object\",","+        \"properties\": {","+          \"publishedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },","+          \"skippedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }","+        }","+      },","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-34\", \"FR-38\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/internal/email/dispatch\",","-      \"description\": \"EXISTING cron route. The request/response contract is unchanged: Bearer CRON_SECRET in, ok(dispatchEmails result) out. Changed behaviour only: after sendDueReminders(now), it also runs autoSubmitExpiredAttempts(now) (IN_PROGRESS with deadlineAt < now − 30 s, ≤ 200 per call) and sendAfterCloseResultsReleased(now) (atomic resultsReleasedAt claim, A6). Each runs in its own try/catch with logger.error, on every request, and both are idempotent.\",","-      \"auth\": \"cron secret\",","-      \"requestSchema\": { \"headers\": { \"authorization\": \"Bearer <CRON_SECRET>\" }, \"body\": \"none\" },","-      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"unchanged dispatchEmails() result\" },","-      \"errors\": [\"UNAUTHENTICATED\"],","-      \"requirementIds\": [\"FR-18\", \"FR-30\", \"FR-35\"]","+      \"path\": \"/api/report-cards/unpublish\",","+      \"description\": \"Unpublish (unpublishSchema; reason required). PUBLISHED cards return to DRAFT and publishedAt/publishedById are cleared (A13). Others are returned in skippedIds. One audit row reportCard.unpublish per card with {old, new, reason}. No notification.\",","+      \"auth\": \"ADMIN\",","+      \"requestSchema\": {","+        \"type\": \"object\",","+        \"required\": [\"ids\", \"reason\"],","+        \"properties\": {","+          \"ids\": { \"type\": \"array\", \"minItems\": 1, \"maxItems\": 2000, \"uniqueItems\": true, \"items\": { \"type\": \"string\" } },","+          \"reason\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 500 }","+        }","+      },","+      \"responseSchema\": {","+        \"type\": \"object\",","+        \"properties\": {","+          \"unpublishedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },","+          \"skippedIds\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }","+        }","+      },","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-34\", \"NFR-4\"]","     }","   ],"," ","-  \"reusedUnchanged\": [","-    \"POST /api/files and GET /api/files/:id serve question-prompt images with the new 'quiz' file context and resolver (manager, or course viewer once the quiz is PUBLISHED). The route contracts don't change (FR-39, system-design §3.5).\"","+  \"nonHttpContracts\": [","+    { \"kind\": \"notification\", \"name\": \"grade.posted\", \"recipients\": \"STUDENT + linked PARENTs\", \"defaultEmail\": false, \"payload\": { \"courseId\": \"string\", \"gradeItemId\": \"string\", \"itemTitle\": \"string\" }, \"requirementIds\": [\"FR-38\"] },","+    { \"kind\": \"notification\", \"name\": \"report_card.published\", \"recipients\": \"STUDENT + linked PARENTs\", \"defaultEmail\": true, \"payload\": { \"reportCardId\": \"string\", \"termName\": \"string\" }, \"requirementIds\": [\"FR-34\", \"FR-38\"] },","+    { \"kind\": \"npm-script\", \"name\": \"gradebook:backfill\", \"command\": \"tsx scripts/gradebook-backfill.ts\", \"output\": \"logger.info summary { items, grades } and exit 0; idempotent\", \"requirementIds\": [\"FR-8\"] },","+    { \"kind\": \"page\", \"name\": \"/report-cards/[id]/print and /report-cards/print?termId=&gradeLevelId=&sectionId=\", \"note\": \"Server components call report-card-service directly (no extra API). Same access as GET /api/report-cards/:id; bulk print renders PUBLISHED cards only.\", \"requirementIds\": [\"FR-35\", \"NFR-11\"] }","   ],"," ","   \"status\": \"complete\""]}],"originalFile":"{\n  \"ticketId\": \"SH-10\",\n  \"timestamp\": \"2026-11-09T13:00:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api. This is the existing project convention; there is no /api/v1 prefix (system-design §3.3).\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/quiz.ts) → one call into src/server/quiz/*-service.ts → ok()/paginated(). All of these come from src/server/http.ts. Handlers contain no logic (NFR-6, NFR-7).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int ≥ 1, default 1\", \"pageSize\": \"int 1–100, default 20 (parsePagination)\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": \"400. Zod failure (details = zod flatten()) or a service rule failure such as canPublish problems, points > question points, or step ≠ 0.5.\",\n      \"UNAUTHENTICATED\": \"401. No session, or a bad cron secret on the internal route.\",\n      \"NOT_FOUND\": \"404. The resource is missing OR the caller cannot access it. Existence is never revealed, so FORBIDDEN is not used for quiz resources (NFR-5).\",\n      \"CONFLICT\": \"409. Answer write after deadlineAt + 30 s, a closed or not-yet-open quiz, attempt limit reached, edit lock (quiz has attempts), delete with attempts, an invalid status transition, or a write to a non-IN_PROGRESS attempt.\",\n      \"INTERNAL\": \"500. Logged with logger.error and never detailed to the client.\"\n    },\n    \"createdStatus\": \"POST endpoints that create a resource return 201 via ok(x, {status: 201}). Every other success returns 200.\",\n    \"decimals\": \"points, score, maxScore, pointsAwarded, totalPoints and the analytics averages are serialized as strings with 2 decimals by fixed2 from @/server/assignments/grading-math (e.g. \\\"2.00\\\"). Input decimals accept number | string. Percentages are numbers rounded to 1 decimal.\",\n    \"timestamps\": \"ISO 8601 UTC strings. 'now' is always the server clock; no request carries a client time (ADR-4). The UI displays times in SchoolSettings.timezone (NFR-6).\",\n    \"ids\": \"cuid strings. Option ids inside Question.options are short cuids generated by the builder and stay stable across edits.\",\n    \"studentPrivacy\": \"Every quiz, attempt or result returned to a STUDENT or PARENT is built only by the allow-listing serializers in src/server/quiz/serializers.ts (toStudentQuiz, toStudentAttempt, toStudentResult). `correct` and `explanation` appear only inside StudentResult.questions[] and only when resultsVisible && showCorrectAnswers. Scores appear only when resultsVisible. Student-path Prisma selects never load `correct` or `explanation` (NFR-1, ADR-5).\",\n    \"lazyAutoSubmit\": \"GET /api/attempts/:id, POST /api/quizzes/:id/attempts, the course list and the teacher grade/list loads call ensureNotExpired first. So an IN_PROGRESS attempt past deadlineAt is always returned already submitted (FR-18).\",\n    \"noEndpointByDesign\": [\n      \"getStudentQuizScore(quizId, studentId) → {score, maxScore, percent, isPractice, attemptsCounted} | null is a TypeScript export of attempt-service.ts for PRD-11. It has no HTTP route (FR-22, FR-33, system-design §4.7).\",\n      \"The grading workspace, the analytics page and the builder's accommodations table are server pages. They call the services directly, after requirePageRole and assertCanManageCourse. Only their writes go through the routes below (system-design §3.4).\",\n      \"Preview mode (FR-8) calls no attempt endpoint (A10).\"\n    ],\n    \"requirementIds\": [\"FR-31\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\", \"NFR-7\"]\n  },\n\n  \"sharedSchemas\": {\n    \"Decimal\": { \"type\": \"string\", \"pattern\": \"^\\\\d+\\\\.\\\\d{2}$\", \"description\": \"Output form. Input form is number | string.\" },\n    \"QuizStatus\": { \"type\": \"string\", \"enum\": [\"DRAFT\", \"PUBLISHED\", \"CLOSED\"] },\n    \"QuestionType\": { \"type\": \"string\", \"enum\": [\"SINGLE_CHOICE\", \"MULTIPLE_CHOICE\", \"TRUE_FALSE\", \"SHORT_ANSWER\", \"ESSAY\"] },\n    \"ResultsVisibility\": { \"type\": \"string\", \"enum\": [\"IMMEDIATELY\", \"AFTER_CLOSE\", \"MANUAL\"] },\n    \"AttemptStatus\": { \"type\": \"string\", \"enum\": [\"IN_PROGRESS\", \"SUBMITTED\", \"NEEDS_GRADING\", \"GRADED\"] },\n    \"ScoringPolicy\": { \"type\": \"string\", \"enum\": [\"HIGHEST\", \"LATEST\", \"AVERAGE\"] },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"name\": \"string\" } },\n    \"Option\": { \"type\": \"object\", \"properties\": { \"id\": \"string\", \"text\": \"string (non-empty)\" } },\n    \"Correct\": {\n      \"description\": \"Keyed by Question.type (FR-2). Manager-only, except as described in conventions.studentPrivacy.\",\n      \"oneOf\": {\n        \"SINGLE_CHOICE\": { \"optionId\": \"string (must be one of options[].id)\" },\n        \"MULTIPLE_CHOICE\": { \"optionIds\": \"string[] (≥ 1, each in options[].id)\" },\n        \"TRUE_FALSE\": { \"value\": \"boolean\" },\n        \"SHORT_ANSWER\": { \"accepted\": \"string[] (1–10, non-empty)\" },\n        \"ESSAY\": { \"guidance\": \"string?\" }\n      }\n    },\n    \"AnswerResponse\": {\n      \"description\": \"answerResponseSchema. A type-agnostic union, so the autosave path doesn't load the Question (NFR-2). A shape that doesn't match the question's type grades as 0 / incorrect at submit.\",\n      \"oneOf\": [\n        { \"optionId\": \"string\" },\n        { \"optionIds\": \"string[]\" },\n        { \"value\": \"boolean\" },\n        { \"text\": \"string (≤ 10,000 chars)\" }\n      ]\n    },\n    \"QuizSettingsInput\": {\n      \"description\": \"quizSettingsSchema (FR-2, FR-6). Cross-field rules run in superRefine: availableUntil > availableFrom, and timeLimitMinutes ≤ the window length in minutes. On PATCH, both rules are checked against the stored values merged with the patch.\",\n      \"properties\": {\n        \"title\": \"string (trimmed, non-empty)\",\n        \"instructions\": \"string (Markdown, default \\\"\\\")\",\n        \"isPractice\": \"boolean (default false)\",\n        \"availableFrom\": \"ISO datetime\",\n        \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int 1–300 | null (null = untimed)\",\n        \"maxAttempts\": \"int 1–10 (default 1)\",\n        \"scoringPolicy\": \"ScoringPolicy (default HIGHEST)\",\n        \"shuffleQuestions\": \"boolean (default false)\",\n        \"shuffleOptions\": \"boolean (default false)\",\n        \"oneQuestionPerPage\": \"boolean (default false)\",\n        \"resultsVisibility\": \"ResultsVisibility (default AFTER_CLOSE)\",\n        \"showCorrectAnswers\": \"boolean (default true)\"\n      }\n    },\n    \"QuestionInput\": {\n      \"description\": \"questionSchema, a z.discriminatedUnion on type (FR-2, FR-7). points 0.5–100 in steps of 0.5. options has 2–8 entries for SINGLE_CHOICE/MULTIPLE_CHOICE and is absent for the other types. prompt is non-empty Markdown and may embed a file uploaded with context 'quiz' (FR-39).\",\n      \"properties\": {\n        \"type\": \"QuestionType\",\n        \"prompt\": \"string (Markdown)\",\n        \"points\": \"number | string\",\n        \"options\": \"Option[] | undefined\",\n        \"correct\": \"Correct (shape keyed by type)\",\n        \"explanation\": \"string | null\",\n        \"caseSensitive\": \"boolean (SHORT_ANSWER only, default false)\"\n      }\n    },\n    \"ManagerQuestion\": {\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\",\n        \"order\": \"int\", \"options\": \"Option[] | null\", \"correct\": \"Correct\", \"explanation\": \"string | null\", \"caseSensitive\": \"boolean\"\n      }\n    },\n    \"ManagerQuiz\": {\n      \"description\": \"Full quiz, including answers. Returned only to managers (assertCanManageCourse).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\",\n        \"...\": \"every QuizSettingsInput field, resolved\",\n        \"status\": \"QuizStatus\",\n        \"resultsReleasedAt\": \"ISO datetime | null\",\n        \"createdById\": \"string\", \"createdAt\": \"ISO datetime\", \"updatedAt\": \"ISO datetime\",\n        \"questions\": \"ManagerQuestion[] (sorted by order)\",\n        \"totalPoints\": \"Decimal (Σ points, FR-8)\",\n        \"attemptCount\": \"int\",\n        \"locked\": \"boolean (attemptCount > 0, edit lock FR-10)\",\n        \"publishProblems\": \"string[] (canPublish(questions); empty means publishable, FR-9)\"\n      }\n    },\n    \"StudentQuiz\": {\n      \"description\": \"toStudentQuiz. Allow-listed, with no questions and no `correct` (NFR-1). Drives the start screen (FR-12).\",\n      \"properties\": {\n        \"id\": \"string\", \"courseId\": \"string\", \"title\": \"string\", \"instructions\": \"string\", \"isPractice\": \"boolean\",\n        \"status\": \"QuizStatus (DRAFT is never returned to a non-manager; that case is NOT_FOUND)\",\n        \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\",\n        \"timeLimitMinutes\": \"int | null\", \"oneQuestionPerPage\": \"boolean\", \"resultsVisibility\": \"ResultsVisibility\",\n        \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n        \"extraTimeMinutes\": \"int (caller's accommodation, 0 if none; 0 for parents)\",\n        \"attemptLimit\": \"int (attemptLimit(maxAttempts, extraAttempts), FR-23)\",\n        \"attemptsUsed\": \"int (caller's own attempts; 0 for parents)\",\n        \"inProgressAttemptId\": \"string | null (Resume target, FR-19)\",\n        \"isOpen\": \"boolean (PUBLISHED && availableFrom ≤ now < availableUntil)\"\n      }\n    },\n    \"StudentQuestion\": {\n      \"description\": \"A question as shown in the player. It never contains correct, explanation or caseSensitive.\",\n      \"properties\": { \"id\": \"string\", \"type\": \"QuestionType\", \"prompt\": \"string\", \"points\": \"Decimal\", \"options\": \"Option[] | null (in seededShuffle(options, attempt.id) order when shuffleOptions, FR-13)\" }\n    },\n    \"StudentAttempt\": {\n      \"description\": \"toStudentAttempt. Returned while status = IN_PROGRESS (FR-13, FR-14, FR-19).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\", \"status\": \"\\\"IN_PROGRESS\\\"\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime (always set: untimed attempts use availableUntil)\",\n        \"serverNow\": \"ISO datetime (lets the display-only timer correct for client clock skew, ADR-4)\",\n        \"oneQuestionPerPage\": \"boolean\",\n        \"questions\": \"StudentQuestion[] (in the frozen questionOrder)\",\n        \"answers\": \"{ questionId: string, response: AnswerResponse | null, savedAt: ISO datetime }[] (no grading fields)\"\n      }\n    },\n    \"StudentResult\": {\n      \"description\": \"toStudentResult. Returned for a submitted attempt to its owner or a linked parent (FR-20, FR-21). When resultsVisible = false, every score field is null and questions is null; the UI shows 'Submitted — results will be available later.'\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"quizTitle\": \"string\", \"attemptNumber\": \"int\",\n        \"status\": \"\\\"SUBMITTED\\\" | \\\"NEEDS_GRADING\\\" | \\\"GRADED\\\"\",\n        \"startedAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime\", \"autoSubmitted\": \"boolean\",\n        \"resultsVisible\": \"boolean\",\n        \"awaitingGrading\": \"boolean (status ≠ GRADED)\",\n        \"score\": \"Decimal | null (only when resultsVisible && status = GRADED)\",\n        \"maxScore\": \"Decimal\",\n        \"percent\": \"number | null (same condition as score)\",\n        \"questions\": \"null | { id, type, prompt, points: Decimal, options: Option[] | null, response: AnswerResponse | null, pendingReview: boolean (needsReview, A8), pointsAwarded: Decimal | null (null when pendingReview), isCorrect: boolean | null, feedback: string | null, correct?: Correct (only if showCorrectAnswers), explanation?: string | null (only if showCorrectAnswers) }[] (in questionOrder)\"\n      }\n    },\n    \"ManagerAnswer\": {\n      \"properties\": {\n        \"questionId\": \"string\", \"response\": \"AnswerResponse | null\", \"pointsAwarded\": \"Decimal | null\", \"isCorrect\": \"boolean | null\",\n        \"feedback\": \"string | null\", \"gradedById\": \"string | null\", \"needsReview\": \"boolean (derived, A8)\", \"updatedAt\": \"ISO datetime\"\n      }\n    },\n    \"ManagerAttempt\": {\n      \"description\": \"The full attempt for a course manager (FR-24).\",\n      \"properties\": {\n        \"id\": \"string\", \"quizId\": \"string\", \"student\": \"UserRef\", \"attemptNumber\": \"int\", \"status\": \"AttemptStatus\",\n        \"startedAt\": \"ISO datetime\", \"deadlineAt\": \"ISO datetime\", \"submittedAt\": \"ISO datetime | null\", \"autoSubmitted\": \"boolean\",\n        \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\",\n        \"questionOrder\": \"string[]\",\n        \"questions\": \"ManagerQuestion[] (in questionOrder)\",\n        \"answers\": \"ManagerAnswer[]\"\n      }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Role-shaped, paginated course Quizzes tab list (FR-11). Access: assertCanViewCourse. Managers see every status. Students and parents see only PUBLISHED and CLOSED quizzes. Sorted by availableFrom desc. Runs ensureNotExpired on the caller's own IN_PROGRESS attempts before computing groups.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId (cuid)\" },\n        \"query\": { \"page\": \"int?\", \"pageSize\": \"int? ≤ 100\" }\n      },\n      \"responseSchema\": {\n        \"envelope\": \"paginated\",\n        \"item\": {\n          \"oneOf\": {\n            \"manager\": {\n              \"role\": \"\\\"MANAGER\\\"\",\n              \"id\": \"string\", \"title\": \"string\", \"status\": \"QuizStatus\", \"isPractice\": \"boolean\",\n              \"availableFrom\": \"ISO datetime\", \"availableUntil\": \"ISO datetime\", \"timeLimitMinutes\": \"int | null\",\n              \"resultsVisibility\": \"ResultsVisibility\", \"questionCount\": \"int\", \"totalPoints\": \"Decimal\",\n              \"attemptCount\": \"int\", \"averagePercent\": \"number | null (submitted+graded attempts)\", \"needsGradingCount\": \"int (attempts with status NEEDS_GRADING)\"\n            },\n            \"student\": {\n              \"role\": \"\\\"STUDENT\\\"\",\n              \"quiz\": \"StudentQuiz\",\n              \"group\": \"\\\"UPCOMING\\\" | \\\"AVAILABLE\\\" | \\\"COMPLETED\\\" | \\\"MISSED\\\". UPCOMING = now < availableFrom. AVAILABLE = isOpen && (attemptsUsed < attemptLimit || inProgressAttemptId). COMPLETED = ≥ 1 submitted attempt and not AVAILABLE. MISSED = now ≥ availableUntil with 0 attempts (A2).\",\n              \"latestResult\": \"{ attemptId: string, status: AttemptStatus, score: Decimal | null, maxScore: Decimal, percent: number | null } | null (scores null unless resultsVisible)\"\n            },\n            \"parent\": {\n              \"role\": \"\\\"PARENT\\\"\",\n              \"student\": \"UserRef (linked child enrolled in the course; one row per child × quiz)\",\n              \"quiz\": \"StudentQuiz\",\n              \"results\": \"{ attemptId: string, attemptNumber: int, submittedAt: ISO datetime, score: Decimal | null, maxScore: Decimal, percent: number | null }[] (only attempts where resultsVisible, read-only)\"\n            }\n          }\n        }\n      },\n      \"errors\": [\"NOT_FOUND (course not visible)\"],\n      \"requirementIds\": [\"FR-11\", \"FR-31\", \"FR-33\", \"FR-34\", \"NFR-1\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/quizzes\",\n      \"description\": \"Creates a DRAFT quiz. The /quizzes/new page sends defaults and then redirects to /edit (FR-6). createdById = caller. Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"courseId\" },\n        \"body\": \"QuizSettingsInput with title, availableFrom and availableUntil required; every other field optional (FR-1 defaults)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (cannot manage course)\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-31\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Manager: ManagerQuiz, the full quiz including correct answers. STUDENT (ACTIVE enrollee) or PARENT (linked to an enrollee): toStudentQuiz, with no questions and never `correct`. A DRAFT quiz is NOT_FOUND for non-managers.\",\n      \"auth\": \"view course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"ManagerQuiz\", \"StudentQuiz\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-31\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Updates settings and/or the status transition. Allowed transitions are DRAFT→PUBLISHED and PUBLISHED→CLOSED only (A9); any other change is CONFLICT. Publishing runs canPublish: if there are problems it returns VALIDATION_ERROR with details {problems: string[]} (FR-9). Otherwise it does a conditional updateMany where status = DRAFT, and only if that updated a row is notify('quiz.published') sent, after commit, to ACTIVE enrollees (FR-29). resultsReleasedAt cannot be set here; use release-results.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\" },\n        \"body\": \"Partial<QuizSettingsInput> & { status?: \\\"PUBLISHED\\\" | \\\"CLOSED\\\" } (at least one key)\"\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuiz\" },\n      \"errors\": [\"VALIDATION_ERROR (schema, cross-field rule, or publish problems)\", \"CONFLICT (invalid status transition)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-6\", \"FR-2\", \"FR-9\", \"FR-29\", \"FR-31\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/quizzes/:id\",\n      \"description\": \"Deletes the quiz (questions and accommodations cascade). Allowed only while no attempt exists.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (quiz has attempts)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions\",\n      \"description\": \"Adds a question at order = max + 1. The builder's Duplicate action is this call with a copied body (FR-7). Edit lock: CONFLICT when the quiz has attempts (FR-10). Returns 201.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"QuestionInput\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\", \"status\": 201 },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/questions/reorder\",\n      \"description\": \"Rewrites Question.order to match the given list, in one transaction. The list must be exactly the quiz's question ids (a permutation), otherwise VALIDATION_ERROR. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": { \"questionIds\": \"string[]\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion[] (new order)\" },\n      \"errors\": [\"VALIDATION_ERROR (not a permutation)\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Edits a question. Without attempts, any QuestionInput field can change; the result is re-validated as a whole against the type's schema. With attempts (edit lock, FR-10), only prompt and explanation can change, plus correct.accepted and caseSensitive for SHORT_ANSWER. Any other key gives CONFLICT with the message 'Quiz has attempts — only text, explanation and accepted answers can change. Use Regrade after editing accepted answers.' Editing never triggers a regrade (A3).\",\n      \"auth\": \"manage course (of the question's quiz)\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" }, \"body\": \"Partial<QuestionInput>\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"ManagerQuestion\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-2\", \"FR-10\", \"FR-31\", \"FR-39\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/questions/:id\",\n      \"description\": \"Deletes a question and closes the gap in order. Blocked by the edit lock.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"questionId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"CONFLICT (edit lock)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-7\", \"FR-10\", \"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/regrade\",\n      \"description\": \"In one transaction: re-runs gradeAnswer on every answer with gradedById = null across submitted attempts (manual grades always win, A8), runs recomputeAttempt on each attempt, then writes audit('quiz.regrade').\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"attemptCount\": \"int\", \"changedAnswerCount\": \"int\" } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-10\", \"FR-25\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/release-results\",\n      \"description\": \"MANUAL visibility only. Runs updateMany({id, resultsVisibility: MANUAL, resultsReleasedAt: null} → now). If that updated a row, it calls notifyStudentAndParents('quiz.results_released') for every student with a submitted attempt, then audit('quiz.release_results'). A repeat call is a no-op that returns the existing timestamp. A non-MANUAL quiz is CONFLICT.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"resultsReleasedAt\": \"ISO datetime\", \"notified\": \"boolean (false on repeat)\" } },\n      \"errors\": [\"CONFLICT (resultsVisibility ≠ MANUAL)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-20\", \"FR-30\", \"FR-38\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/quizzes/:id/analytics\",\n      \"description\": \"Quiz analytics computed in memory over submitted attempts (FR-26, FR-27). With ?format=csv it returns text/csv (Content-Disposition: attachment; filename=\\\"quiz-<id>-attempts.csv\\\"), built with toCsv. CSV columns: student, attemptNumber, score, then one points column per question in quiz order.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"query\": { \"format\": \"\\\"json\\\" | \\\"csv\\\" (default json)\" } },\n      \"responseSchema\": {\n        \"envelope\": \"data (json) | raw text/csv\",\n        \"data\": {\n          \"summary\": { \"attempts\": \"int\", \"average\": \"Decimal | null\", \"median\": \"Decimal | null\", \"highest\": \"Decimal | null\", \"lowest\": \"Decimal | null\", \"averageTimeSeconds\": \"int | null\" },\n          \"histogram\": \"{ bucket: \\\"0–10\\\" | … | \\\"90–100\\\", count: int }[10] (by percent; 100% goes in the last bucket)\",\n          \"questions\": \"{ questionId, order: int, type: QuestionType, prompt, points: Decimal, percentCorrect: number | null, averagePoints: Decimal | null, optionDistribution: { optionId, text, count: int, isCorrect: boolean }[] | null (choice types only), mostChosenWrongOptionId: string | null }[]\"\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR (bad format)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-26\", \"FR-27\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/quizzes/:id/accommodations/:studentId\",\n      \"description\": \"Upserts the QuizAccommodation for one ACTIVE enrollee, then writes audit('quiz.accommodation'). It applies only to attempts started afterwards, because deadlineAt is frozen at start (A7). Sending {0, 0} keeps the row; that is equivalent to no accommodation.\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"quizId\", \"studentId\": \"userId (must be ACTIVE enrolled in the course)\" },\n        \"body\": { \"extraTimeMinutes\": \"int 0–300\", \"extraAttempts\": \"int 0–5\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"quizId\": \"string\", \"studentId\": \"string\", \"extraTimeMinutes\": \"int\", \"extraAttempts\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"NOT_FOUND (quiz or student not in course)\"],\n      \"requirementIds\": [\"FR-28\", \"FR-2\", \"FR-23\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/quizzes/:id/attempts\",\n      \"description\": \"STUDENT start or resume (system-design §4.2). Requires the quiz to be PUBLISHED with availableFrom ≤ now < availableUntil, else CONFLICT. An existing IN_PROGRESS attempt goes through ensureNotExpired and is returned with 200 (resume, FR-19). Otherwise, attempt count ≥ attemptLimit is CONFLICT (FR-23). Otherwise the attempt is created with id pre-generated, questionOrder frozen (seededShuffle by id when shuffleQuestions) and deadlineAt = computeDeadline(...), and returned with 201. A P2002 race on the partial unique index re-reads and returns the IN_PROGRESS attempt with 200.\",\n      \"auth\": \"role STUDENT + view course (ACTIVE enrollee)\",\n      \"requestSchema\": { \"params\": { \"id\": \"quizId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentAttempt\", \"status\": \"201 created | 200 resumed\" },\n      \"errors\": [\"CONFLICT (quiz not open | attempt limit reached)\", \"NOT_FOUND (quiz not visible)\", \"FORBIDDEN is not used; a non-STUDENT gets NOT_FOUND\"],\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-19\", \"FR-23\", \"FR-28\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attempts/:id\",\n      \"description\": \"Calls ensureNotExpired first (FR-18), then assertCanAccessAttempt (FR-34). Owner: StudentAttempt while IN_PROGRESS, otherwise StudentResult. Linked PARENT: StudentResult, and only if the attempt is submitted and resultsVisible, else NOT_FOUND. Course manager: ManagerAttempt. Any other caller gets NOT_FOUND.\",\n      \"auth\": \"owner | linked parent (read-only) | course manager\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" } },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"oneOf\": [\"StudentAttempt\", \"StudentResult\", \"ManagerAttempt\"] } },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-24\", \"FR-32\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId\",\n      \"description\": \"Autosave hot path (system-design §4.3, NFR-2): one attempt read, no Quiz or Question load, then one QuizAnswer upsert on the (attemptId, questionId) PK. Checks: studentId ≠ caller → NOT_FOUND; questionId ∉ questionOrder → NOT_FOUND; status ≠ IN_PROGRESS → CONFLICT; now > deadlineAt + 30 s → submitAttempt(id, {auto: true}) then CONFLICT 'Time is up' (FR-16). Idempotent, so localStorage replays are safe (FR-15). response: null clears the answer.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId\" },\n        \"body\": { \"response\": \"AnswerResponse | null\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"questionId\": \"string\", \"savedAt\": \"ISO datetime\" }, \"note\": \"Carries no grading data (NFR-1). On 409 the client stops its queue, clears localStorage['quiz-attempt:<id>'] and routes to the result page.\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (not in progress | past deadline + grace)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-15\", \"FR-16\", \"FR-32\", \"NFR-2\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/attempts/:id/submit\",\n      \"description\": \"Runs submitAttempt(id, {auto: false}) (system-design §4.4). The IN_PROGRESS → SUBMITTED claim is atomic; missing answers are created as null, every answer is auto-graded, then recomputeAttempt sets status NEEDS_GRADING or GRADED (FR-17). An already-submitted attempt returns its current state with 200 (idempotent, no error). A submit after the deadline still succeeds as a manual submit; nothing is lost because the answers were already saved.\",\n      \"auth\": \"owner (STUDENT)\",\n      \"requestSchema\": { \"params\": { \"id\": \"attemptId\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"StudentResult\" },\n      \"errors\": [\"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-17\", \"FR-25\", \"FR-32\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attempts/:id/answers/:questionId/grade\",\n      \"description\": \"Manual grade or override (FR-24). The attempt must be submitted (not IN_PROGRESS), else CONFLICT. pointsAwarded must be ≤ question.points and a multiple of 0.5, else VALIDATION_ERROR. Sets pointsAwarded, isCorrect = (pointsAwarded == question.points), feedback and gradedById = caller, upserting the answer row if it is missing. Then recomputeAttempt (FR-25), and audit('quizAnswer.grade') after commit. No notification is sent (FR-30). The body field is named pointsAwarded per the PRD API table (system-design §3.2 calls it `points`; manualGradeSchema should use pointsAwarded).\",\n      \"auth\": \"manage course\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"attemptId\", \"questionId\": \"questionId (must be in questionOrder)\" },\n        \"body\": { \"pointsAwarded\": \"number | string, ≥ 0, step 0.5\", \"feedback\": \"string | null (optional)\" }\n      },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": { \"answer\": \"ManagerAnswer\", \"attempt\": { \"id\": \"string\", \"status\": \"AttemptStatus\", \"score\": \"Decimal | null\", \"maxScore\": \"Decimal\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"CONFLICT (attempt in progress)\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-4\", \"FR-38\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING cron route. The request/response contract is unchanged: Bearer CRON_SECRET in, ok(dispatchEmails result) out. Changed behaviour only: after sendDueReminders(now), it also runs autoSubmitExpiredAttempts(now) (IN_PROGRESS with deadlineAt < now − 30 s, ≤ 200 per call) and sendAfterCloseResultsReleased(now) (atomic resultsReleasedAt claim, A6). Each runs in its own try/catch with logger.error, on every request, and both are idempotent.\",\n      \"auth\": \"cron secret\",\n      \"requestSchema\": { \"headers\": { \"authorization\": \"Bearer <CRON_SECRET>\" }, \"body\": \"none\" },\n      \"responseSchema\": { \"envelope\": \"data\", \"data\": \"unchanged dispatchEmails() result\" },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-18\", \"FR-30\", \"FR-35\"]\n    }\n  ],\n\n  \"reusedUnchanged\": [\n    \"POST /api/files and GET /api/files/:id serve question-prompt images with the new 'quiz' file context and resolver (manager, or course viewer once the quiz is PUBLISHED). The route contracts don't change (FR-39, system-design §3.5).\"\n  ],\n\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_01Dd6dBcqRPEX3iwe44dXgou","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
