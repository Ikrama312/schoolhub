e },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Notification\" } }, \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-34\", \"FR-24\", \"FR-26\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/notifications/unread-count\",\n      \"routeFile\": \"src/app/api/notifications/unread-count/route.ts\",\n      \"description\": \"Count of the caller's unread notifications. It is index-only on [userId, readAt, createdAt], with a target under 50 ms, and the bell polls it every 30 s while the tab is visible.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"count\"], \"properties\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-35\", \"FR-22\", \"FR-23\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/read-all\",\n      \"routeFile\": \"src/app/api/notifications/read-all/route.ts\",\n      \"description\": \"Sets readAt = now on all of the caller's unread notifications. It is idempotent.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"count\"], \"properties\": { \"count\": { \"type\": \"integer\", \"description\": \"rows updated\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/{id}/read\",\n      \"routeFile\": \"src/app/api/notifications/[id]/read/route.ts\",\n      \"description\": \"Marks one notification read. It runs updateMany({ id, userId: me.id }), and a count of 0 returns 404 NOT_FOUND, so it never reveals other users' rows.\",\n      \"auth\": \"requireUser (owner only)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\"], \"properties\": { \"id\": { \"type\": \"string\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/notifications/{id}/unread\",\n      \"routeFile\": \"src/app/api/notifications/[id]/unread/route.ts\",\n      \"description\": \"Marks one notification unread (readAt = null). Same owner scoping and 404 rule as /read.\",\n      \"auth\": \"requireUser (owner only)\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\"], \"properties\": { \"id\": { \"type\": \"string\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-36\", \"FR-26\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/notification-preferences\",\n      \"routeFile\": \"src/app/api/me/notification-preferences/route.ts\",\n      \"description\": \"Returns visibleTypesFor(me.role) (registry types with the caller's role, excluding emailOnly) merged with the caller's NotificationPreference rows through resolvePrefs. It is not paginated because the registry is small.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/NotificationPreferenceItem\" } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-37\", \"FR-7\", \"FR-28\", \"FR-29\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/me/notification-preferences\",\n      \"routeFile\": \"src/app/api/me/notification-preferences/route.ts\",\n      \"description\": \"Upserts one preference on userId_type. It returns VALIDATION_ERROR for an unknown type, an emailOnly type, a type not visible to the caller's role, or inApp=false on a mandatoryInApp type.\",\n      \"auth\": \"requireUser\",\n      \"requestSchema\": {\n        \"body\": {\n          \"type\": \"object\",\n          \"required\": [\"type\", \"inApp\", \"email\"],\n          \"additionalProperties\": false,\n          \"properties\": { \"type\": { \"type\": \"string\" }, \"inApp\": { \"type\": \"boolean\" }, \"email\": { \"type\": \"boolean\" } },\n          \"zod\": \"updatePreferenceBody (src/lib/validators/notifications.ts)\"\n        }\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/NotificationPreferenceItem\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-38\", \"FR-29\", \"FR-30\", \"FR-41\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/email-log\",\n      \"routeFile\": \"src/app/api/admin/email-log/route.ts\",\n      \"description\": \"Paginated EmailOutbox rows ordered by createdAt desc, with an optional status filter. The query never selects html or text.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"query\": {\n          \"status\": { \"type\": \"string\", \"enum\": [\"PENDING\", \"SENDING\", \"SENT\", \"FAILED\"], \"optional\": true },\n          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },\n          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }\n        }\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/EmailLogItem\" } }, \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-39\", \"FR-31\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/email-log/{id}/retry\",\n      \"routeFile\": \"src/app/api/admin/email-log/[id]/retry/route.ts\",\n      \"description\": \"Resets a FAILED row with updateMany({ id, status: FAILED }, { attempts: 0, status: PENDING, nextAttemptAt: now, lastError: null }). A count of 0 (missing or not FAILED) returns 404 NOT_FOUND, so a double click is harmless.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\", \"status\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"status\": { \"const\": \"PENDING\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-32\", \"FR-39\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/notifications/test\",\n      \"routeFile\": \"src/app/api/admin/notifications/test/route.ts\",\n      \"description\": \"Calls notify({ type: 'system.test', userIds: [me.id], title: 'Test notification', link: '/dashboard', email: { template: 'generic-notification' } }) for the calling admin. notify() never throws, so the route always returns 200 once auth passes.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"ok\"], \"properties\": { \"ok\": { \"const\": true } } } },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-4\", \"FR-6\", \"NFR-8\", \"NFR-16\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"routeFile\": \"src/app/api/internal/email/dispatch/route.ts\",\n      \"description\": \"The cron entry point. It runs dispatchEmails({ batchSize: 50 }), then the best-effort purgeOldNotifications() at most once per 24 h per process (a purge failure never fails the response). It is public in middleware and gated only by the bearer token.\",\n      \"auth\": \"Authorization: Bearer ${CRON_SECRET}. The token is compared with crypto.timingSafeEqual, and an unset CRON_SECRET or a missing or wrong token returns 401 UNAUTHENTICATED.\",\n      \"requestSchema\": { \"headers\": { \"Authorization\": { \"type\": \"string\", \"pattern\": \"^Bearer .+$\" } } },\n      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"sent\", \"failed\", \"retried\"], \"properties\": { \"sent\": { \"type\": \"integer\" }, \"failed\": { \"type\": \"integer\" }, \"retried\": { \"type\": \"integer\" } } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-19\", \"FR-17\", \"FR-18\", \"FR-27\", \"NFR-3\", \"NFR-4\", \"NFR-5\", \"NFR-8\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    {\n      \"name\": \"notify\",\n      \"module\": \"src/server/notifications/notify.ts\",\n      \"signature\": \"notify(input: { type: NotificationType; userIds: string[]; title: string; body?: string; link?: string; email?: { subject?: string; template: 'generic-notification'; data: Record<string, unknown> } }): Promise<void>\",\n      \"notes\": \"It never throws (FR-11). Call it after the caller's transaction commits. It truncates the title to 140 and the body to 500, and it drops an unsafe link.\",\n      \"requirementIds\": [\"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-9\", \"FR-10\", \"FR-11\", \"NFR-1\", \"NFR-6\", \"NFR-18\"]\n    },\n    {\n      \"name\": \"notifyStudentAndParents\",\n      \"module\": \"src/server/notifications/notify.ts\",\n      \"signature\": \"notifyStudentAndParents(input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] }): Promise<void>\",\n      \"requirementIds\": [\"FR-12\", \"NFR-14\"]\n    },\n    {\n      \"name\": \"dispatchEmails\",\n      \"module\": \"src/server/email/dispatch.ts\",\n      \"signature\": \"dispatchEmails(opts?: { batchSize?: number }): Promise<{ sent: number; failed: number; retried: number }>\",\n      \"notes\": \"Used by the dispatch route and scripts/worker-email.ts (15 s loop).\",\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-20\", \"NFR-4\", \"NFR-5\"]\n    },\n    {\n      \"name\": \"sendAuthEmail\",\n      \"module\": \"src/server/auth/email.ts\",\n      \"signature\": \"unchanged; the body now renders invite/password-reset and calls enqueueEmail(). It still throws on failure.\",\n      \"requirementIds\": [\"FR-16\", \"FR-4\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n"}}}
