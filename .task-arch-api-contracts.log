ontracts.json'))\ntxt=json.dumps(d)\ncited=set(re.findall(r'\"((?:N?FR)-\\d+)\"',txt))\nprint('bad ids',cited-ids); print('uncited',sorted(ids-cited))\ndef res(p):\n    o=d\n    for k in p.lstrip('#/').split('/'): o=o[int(k)] if isinstance(o,list) else o[k]\n    return o\nfor ref in set(re.findall(r'\"\\$ref\": \"([^\"]+)\"',txt)): res(ref)\nprint('refs ok', len(d['endpoints']), [d['endpoints'][i]['path'] for i in (4,16)])\nEOF","description":"Validate contracts JSON, requirement ids and refs"}}}
