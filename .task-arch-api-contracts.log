{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KH4sSdoNot4UBx7jsfjmCy","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"579a4bd9-1ad7-4baf-96fe-8a4735bbff00","uuid":"a87ddcff-72da-4c83-9d3e-083d70301d6a","timestamp":"2026-11-04T06:40:17.558Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"abcd-1\",\n  \"timestamp\": \"2026-11-04T00:03:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention; no /api/v1 prefix - NFR-9 forbids renaming routes)\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"errorEnvelope\": { \"error\": { \"code\": \"string\", \"message\": \"string\", \"details\": \"object?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"INVALID_TOKEN\": 410,\n      \"RATE_LIMITED\": 429\n    },\n    \"handlerPattern\": \"withHandler(parseBody(zodSchema) -> service -> ok()) from src/server/http.ts\",\n    \"csrf\": \"src/middleware.ts rejects non-GET/HEAD /api/* requests whose Origin header is present and differs from the app origin (403 FORBIDDEN). The Auth.js endpoints also use their own CSRF token. Session cookie: HttpOnly, SameSite=Lax, Secure in prod.\",\n    \"unauthenticatedApi\": \"src/middleware.ts returns 401 UNAUTHENTICATED for /api/* outside PUBLIC_API_PATHS ['/api/health', '/api/auth/']\",\n    \"requirementIds\": [\"NFR-2\", \"NFR-8\", \"NFR-9\", \"FR-12\"]\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/auth/csrf\",\n      \"description\": \"Auth.js protocol endpoint, served by the /api/auth/[...nextauth] catch-all (handlers.GET). Returns the CSRF token that signIn()/signOut() use. Public.\",\n      \"auth\": \"public\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"csrfToken\": { \"type\": \"string\" } } },\n      \"envelope\": \"Auth.js native (not the {data} envelope)\",\n      \"requirementIds\": [\"FR-34\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/auth/session\",\n      \"description\": \"Auth.js protocol endpoint (catch-all). Returns the current session or null. Public. Middleware does not gate it.\",\n      \"auth\": \"public\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"oneOf\": [\n          { \"type\": \"null\" },\n          {\n            \"type\": \"object\",\n            \"properties\": {\n              \"user\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"id\": { \"type\": \"string\" },\n                  \"role\": { \"type\": \"string\", \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\", \"...existing Role enum values\"] },\n                  \"firstName\": { \"type\": \"string\" },\n                  \"lastName\": { \"type\": \"string\" },\n                  \"email\": { \"type\": \"string\", \"format\": \"email\" }\n                },\n                \"required\": [\"id\", \"role\", \"firstName\", \"lastName\", \"email\"]\n              },\n              \"expires\": { \"type\": \"string\", \"format\": \"date-time\" }\n            }\n          }\n        ]\n      },\n      \"envelope\": \"Auth.js native\",\n      \"requirementIds\": [\"FR-10\", \"FR-34\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/callback/credentials\",\n      \"description\": \"Auth.js Credentials sign-in (catch-all handlers.POST). Credentials.authorize delegates to authorizeCredentials(): IP rate limit (10 / 5 min) -> trim + lower-case the email -> exactly one bcrypt compare (DUMMY_HASH if the user is missing) -> status/archived/lock checks -> lockout bookkeeping -> audit. On success the jwt callback sets {id, role, firstName, lastName, email, authTime, checkedAt}, maxAge 8h, updateAge 15m. The client calls it through signIn('credentials', {redirect:false}) and reads the error code.\",\n      \"auth\": \"public (Auth.js CSRF token)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/x-www-form-urlencoded\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"email\": { \"type\": \"string\", \"format\": \"email\", \"transform\": \"trim + toLowerCase\" },\n          \"password\": { \"type\": \"string\" },\n          \"csrfToken\": { \"type\": \"string\" },\n          \"callbackUrl\": { \"type\": \"string\", \"note\": \"sanitised by safeCallbackUrl(): only a relative path starting with '/' and not '//' or '/\\\\'; otherwise /dashboard\" }\n        },\n        \"required\": [\"email\", \"password\", \"csrfToken\"]\n      },\n      \"responseSchema\": {\n        \"success\": { \"sets-cookie\": \"authjs.session-token (__Secure- prefix in prod)\", \"url\": \"safeCallbackUrl(callbackUrl)\" },\n        \"failure\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"error\": { \"const\": \"CredentialsSignin\" },\n            \"code\": {\n              \"type\": \"string\",\n              \"enum\": [\"invalid\", \"disabled\", \"locked:<minutes>\", \"rate_limited\"],\n              \"uiMessages\": {\n                \"invalid\": \"Email or password is incorrect.\",\n                \"disabled\": \"This account is disabled. Contact the school office.\",\n                \"locked:N\": \"This account is temporarily locked. Try again in N minutes.\",\n                \"rate_limited\": \"Too many attempts. Wait a few minutes and try again.\"\n              }\n            }\n          }\n        }\n      },\n      \"sideEffects\": [\n        \"wrong password: failedLoginCount += 1; at 5 -> lockedUntil = now + 15 min, failedLoginCount = 0\",\n        \"success: failedLoginCount = 0, lastLoginAt = now\",\n        \"audit auth.login.success | auth.login.failure {email, reason} | auth.lockout, with the IP from x-forwarded-for\"\n      ],\n      \"envelope\": \"Auth.js native\",\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-9\", \"FR-10\", \"FR-30\", \"FR-34\", \"NFR-2\", \"NFR-3\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/signout\",\n      \"description\": \"Auth.js sign-out (catch-all). Clears the session cookie. The shell calls it through signOut({redirectTo:'/login'}).\",\n      \"auth\": \"public (Auth.js CSRF token)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/x-www-form-urlencoded\",\n        \"type\": \"object\",\n        \"properties\": { \"csrfToken\": { \"type\": \"string\" }, \"callbackUrl\": { \"type\": \"string\" } },\n        \"required\": [\"csrfToken\"]\n      },\n      \"responseSchema\": { \"url\": \"/login\" },\n      \"envelope\": \"Auth.js native\",\n      \"requirementIds\": [\"FR-32\", \"FR-34\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/accept-invite\",\n      \"description\": \"Activates an invited account. Flow: verifyToken(token, 'INVITE') -> assertPasswordAllowed -> bcrypt.hash(12) -> one transaction {passwordHash, status=ACTIVE, passwordChangedAt=now} + consumeToken -> audit auth.invite.accepted. It does NOT mint a session: on 200 the client calls signIn('credentials', {email, password, redirectTo:'/dashboard'}). Public via the /api/auth/ prefix and protected by the middleware origin check.\",\n      \"auth\": \"public + origin check\",\n      \"handler\": \"src/app/api/auth/accept-invite/route.ts -> services/auth.acceptInvite\",\n      \"requestSchema\": {\n        \"zod\": \"acceptInviteSchema\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"token\": { \"type\": \"string\", \"description\": \"raw base64url token from /invite/<token>\" },\n          \"password\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"≥1 letter, ≥1 digit, != email, not in common-passwords.txt\" },\n          \"confirm\": { \"type\": \"string\", \"description\": \"must equal password (client and zod refine)\" }\n        },\n        \"required\": [\"token\", \"password\", \"confirm\"]\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"email\": { \"type\": \"string\", \"format\": \"email\" } }, \"required\": [\"email\"] } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"password\": [\"string\"], \"confirm\": [\"string\"] } } } },\n        \"403\": { \"error\": { \"code\": \"FORBIDDEN\", \"message\": \"Cross-origin request rejected\" } },\n        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This invitation link is invalid or has expired. Ask the school office to send a new one.\" } }\n      },\n      \"requirementIds\": [\"FR-13\", \"FR-16\", \"FR-17\", \"FR-30\", \"FR-31\", \"FR-37\", \"NFR-1\", \"NFR-2\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/forgot-password\",\n      \"description\": \"Requests a password-reset link. Over 10 requests per IP per hour -> 429. Over 3 requests per email per hour -> silent generic 200 (no enumeration). Only an existing ACTIVE user gets createToken(PASSWORD_RESET, 60 min), which invalidates older unused reset tokens, plus sendAuthEmail(user, 'password-reset', link). Unknown or inactive emails write nothing. The response body is always identical.\",\n      \"auth\": \"public + origin check\",\n      \"handler\": \"src/app/api/auth/forgot-password/route.ts -> services/auth.requestPasswordReset\",\n      \"requestSchema\": {\n        \"zod\": \"forgotPasswordSchema\",\n        \"type\": \"object\",\n        \"properties\": { \"email\": { \"type\": \"string\", \"format\": \"email\", \"transform\": \"trim + toLowerCase\" } },\n        \"required\": [\"email\"]\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"message\": { \"const\": \"If an account exists for that email, we've sent a reset link.\" } } } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"email\": [\"string\"] } } } },\n        \"429\": { \"error\": { \"code\": \"RATE_LIMITED\", \"message\": \"Too many attempts. Wait a few minutes and try again.\" } }\n      },\n      \"requirementIds\": [\"FR-2\", \"FR-13\", \"FR-19\", \"FR-20\", \"FR-22\", \"NFR-2\", \"NFR-3\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/reset-password\",\n      \"description\": \"Completes a reset. Flow: verifyToken(token, 'PASSWORD_RESET') -> assertPasswordAllowed -> hash -> one transaction {passwordHash, passwordChangedAt=now, failedLoginCount=0, lockedUntil=null} + consumeToken -> audit auth.password.reset. The client then redirects to /login?reset=1, which shows a useToast success toast. Existing sessions are revoked within 5 min by the jwt callback (passwordChangedAt > authTime).\",\n      \"auth\": \"public + origin check\",\n      \"handler\": \"src/app/api/auth/reset-password/route.ts -> services/auth.resetPassword\",\n      \"requestSchema\": {\n        \"zod\": \"resetPasswordSchema\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"token\": { \"type\": \"string\" },\n          \"password\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"same as accept-invite\" },\n          \"confirm\": { \"type\": \"string\" }\n        },\n        \"required\": [\"token\", \"password\", \"confirm\"]\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"ok\": { \"const\": true } } } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"password\": [\"string\"], \"confirm\": [\"string\"] } } } },\n        \"403\": { \"error\": { \"code\": \"FORBIDDEN\" } },\n        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This reset link is invalid or has expired.\" } }\n      },\n      \"requirementIds\": [\"FR-11\", \"FR-13\", \"FR-17\", \"FR-21\", \"FR-30\", \"FR-31\", \"NFR-1\", \"NFR-2\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/account/password\",\n      \"description\": \"Changes the signed-in user's password. Flow: await requireUser() -> bcrypt-compare currentPassword -> assertPasswordAllowed(newPassword, email) -> hash -> update {passwordHash, passwordChangedAt=now} -> audit auth.password.changed -> unstable_update({reauth:true}), so this session's authTime moves past passwordChangedAt. Other sessions fail the jwt check within 5 min. The UI shows the 'Password updated' toast.\",\n      \"auth\": \"session required (middleware 401 + requireUser())\",\n      \"handler\": \"src/app/api/account/password/route.ts -> services/auth.changePassword\",\n      \"requestSchema\": {\n        \"zod\": \"changePasswordSchema\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"currentPassword\": { \"type\": \"string\" },\n          \"newPassword\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"same as accept-invite\" },\n          \"confirm\": { \"type\": \"string\" }\n        },\n        \"required\": [\"currentPassword\", \"newPassword\", \"confirm\"]\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"ok\": { \"const\": true } } }, \"sets-cookie\": \"re-issued session token\" },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"currentPassword\": [\"Current password is incorrect.\"], \"newPassword\": [\"string\"], \"confirm\": [\"string\"] } } } },\n        \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" } },\n        \"403\": { \"error\": { \"code\": \"FORBIDDEN\", \"message\": \"Cross-origin request rejected\" } }\n      },\n      \"requirementIds\": [\"FR-11\", \"FR-17\", \"FR-23\", \"FR-28\", \"FR-30\", \"FR-31\", \"NFR-2\", \"NFR-7\", \"NFR-8\"]\n    }\n  ],\n\n  \"changedBehaviourOnExistingEndpoints\": {\n    \"description\": \"Every existing route handler (33 route.ts files) changes from requireRole(...) to await requireRole(...), backed by the real session. Paths, request shapes and response shapes don't change. New possible responses on all of them:\",\n    \"responses\": {\n      \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" }, \"source\": \"middleware (no session) or requireUser/requireRole (session revoked)\" },\n      \"403\": { \"error\": { \"code\": \"FORBIDDEN\" }, \"source\": \"requireRole role mismatch, or the middleware cross-origin check on mutations\" }\n    },\n    \"unchanged\": [\"/api/health stays public\"],\n    \"requirementIds\": [\"FR-12\", \"FR-28\", \"FR-29\", \"NFR-7\", \"NFR-9\"]\n  },\n\n  \"explicitlyAbsent\": [\n    { \"item\": \"No sign-up / register endpoint\", \"requirementIds\": [\"FR-37\"] },\n    { \"item\": \"No admin user-management, SSO, MFA or magic-link endpoints\", \"requirementIds\": [\"NFR-11\"] },\n    { \"item\": \"No /api/v1 prefix; existing /api convention kept\", \"requirementIds\": [\"NFR-9\"] }\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":198,"newStart":1,"newLines":234,"lines":[" {","-  \"ticketId\": \"abcd-05\",","-  \"timestamp\": \"2026-10-27T00:30:00Z\",","+  \"ticketId\": \"abcd-1\",","+  \"timestamp\": \"2026-11-04T00:03:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\","," ","-  \"note\": \"Derived from system-design.md (REST API surface + Data Flow) and 05-classes-enrollment.md's API table; 17 endpoints (the table's '·'-joined rows are expanded). Conventions shared by every endpoint, not repeated per entry: (1) every handler is wrapped in withHandler() from src/server/http.ts, which maps ZodError->VALIDATION_ERROR 400, AppError->its code, Prisma P2002->CONFLICT 409, P2025->NOT_FOUND 404; (2) success = ok() -> { data }, lists = paginated() -> { data: [...], meta: { page, pageSize, total } } — the real helper nests pagination under `meta`, unlike the PRD's flat example; follow the helper; (3) list query conventions: page (default 1), pageSize (default 20, max 100), sort, order=asc|desc, q; (4) auth: every route calls requireRole(...) from src/server/auth/requireRole.ts (NFR-7 stand-in; no permissions.ts/requireUser()); course-scoped reads additionally call assertCanViewCourse from src/server/auth/course-access.ts (FR-18); (5) every write calls audit() inside the same $transaction (FR-24) via the service/engine, never at the route layer; (6) handlers are thin: zod parse -> one service call -> envelope. Shared shapes are named under `schemas` and referenced as \\\"$ref\\\": \\\"#/schemas/<Name>\\\".\",","-","-  \"schemas\": {","-    \"Section\": {","-      \"id\": \"string\", \"academicYearId\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevel\": { \"id\": \"string\", \"name\": \"string\", \"order\": \"number\" },","-      \"name\": \"string\", \"homeroomTeacherId\": \"string|null\", \"homeroomTeacher\": { \"id\": \"string\", \"name\": \"string\" },","-      \"roomId\": \"string|null\", \"room\": { \"id\": \"string\", \"name\": \"string\" }, \"capacity\": \"number (1-60)\",","-      \"memberCount\": \"number\", \"courseCount\": \"number\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"","+  \"conventions\": {","+    \"basePath\": \"/api (existing project convention; no /api/v1 prefix - NFR-9 forbids renaming routes)\",","+    \"successEnvelope\": { \"data\": \"<responseSchema>\" },","+    \"errorEnvelope\": { \"error\": { \"code\": \"string\", \"message\": \"string\", \"details\": \"object?\" } },","+    \"errorCodes\": {","+      \"VALIDATION_ERROR\": 400,","+      \"UNAUTHENTICATED\": 401,","+      \"FORBIDDEN\": 403,","+      \"INVALID_TOKEN\": 410,","+      \"RATE_LIMITED\": 429","     },","-    \"SectionInput\": {","-      \"academicYearId\": \"string (required on create)\", \"gradeLevelId\": \"string\", \"name\": \"string (min 1)\",","-      \"homeroomTeacherId\": \"string|null (must be role=TEACHER; at most one section per teacher per year -> CONFLICT)\",","-      \"roomId\": \"string|null\", \"capacity\": \"int 1-60, default 30\"","-    },","-    \"Course\": {","-      \"id\": \"string\", \"academicYearId\": \"string\", \"subjectId\": \"string\", \"subject\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"color\": \"string\" },","-      \"sectionId\": \"string|null\", \"section\": { \"id\": \"string\", \"name\": \"string\", \"room\": { \"id\": \"string\", \"name\": \"string\" } },","-      \"teacherId\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" }, \"coTeacherIds\": \"string[]\", \"coTeachers\": [{ \"id\": \"string\", \"name\": \"string\" }],","-      \"name\": \"string\", \"code\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"description\": \"string|null\", \"capacity\": \"number|null\",","-      \"archivedAt\": \"ISO 8601|null\", \"enrolledCount\": \"number (ACTIVE only)\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"","-    },","-    \"CourseInput\": {","-      \"academicYearId\": \"string (required on create)\", \"subjectId\": \"string\", \"sectionId\": \"string|null (required iff kind=CORE — single zod refinement shared with the dialog, FR-14)\",","-      \"teacherId\": \"string (role=TEACHER)\", \"coTeacherIds\": \"string[] (max 3, role=TEACHER)\", \"name\": \"string (default '<Subject> – <Section>')\",","-      \"code\": \"string (default '<SUBJECTCODE>-<SECTION>', transformed to uppercase; unique per year -> CONFLICT)\", \"kind\": \"CORE|ELECTIVE (default CORE)\",","-      \"capacity\": \"int>=1|null\", \"description\": \"string|null\"","-    },","-    \"Enrollment\": {","-      \"id\": \"string\", \"courseId\": \"string\", \"studentId\": \"string\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\" },","-      \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\"","-    },","-    \"EnrollStudentsInput\": { \"studentIds\": \"string[] (min 1)\", \"overrideCapacity\": \"boolean (optional, default false)\" },","-    \"EnrollResult\": { \"enrolled\": \"number (new ACTIVE rows)\", \"reactivated\": \"number (DROPPED->ACTIVE)\", \"alreadyActive\": \"number\" },","-    \"CapacityConflict\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Section 7A is full (30/30). | Course MATH-7A is full (30/30).\" } }","+    \"handlerPattern\": \"withHandler(parseBody(zodSchema) -> service -> ok()) from src/server/http.ts\",","+    \"csrf\": \"src/middleware.ts rejects non-GET/HEAD /api/* requests whose Origin header is present and differs from the app origin (403 FORBIDDEN). The Auth.js endpoints also use their own CSRF token. Session cookie: HttpOnly, SameSite=Lax, Secure in prod.\",","+    \"unauthenticatedApi\": \"src/middleware.ts returns 401 UNAUTHENTICATED for /api/* outside PUBLIC_API_PATHS ['/api/health', '/api/auth/']\",","+    \"requirementIds\": [\"NFR-2\", \"NFR-8\", \"NFR-9\", \"FR-12\"]","   },"," ","   \"endpoints\": [","     {","       \"method\": \"GET\",","-      \"path\": \"/api/sections\",","-      \"description\": \"List sections for an academic year (defaults to current). Roles: ADMIN, TEACHER. Service: sections-service.listSections.\",","-      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, defaults to current AcademicYear)\", \"gradeLevelId\": \"string (optional)\", \"q\": \"string (optional, name search)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"name|gradeLevel|memberCount (default gradeLevel)\", \"order\": \"asc|desc\" } },","-      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Section\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } }, \"403\": \"FORBIDDEN (STUDENT/PARENT)\" },","-      \"requirementIds\": [\"FR-2\", \"FR-23\", \"NFR-7\"]","+      \"path\": \"/api/auth/csrf\",","+      \"description\": \"Auth.js protocol endpoint, served by the /api/auth/[...nextauth] catch-all (handlers.GET). Returns the CSRF token that signIn()/signOut() use. Public.\",","+      \"auth\": \"public\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"csrfToken\": { \"type\": \"string\" } } },","+      \"envelope\": \"Auth.js native (not the {data} envelope)\",","+      \"requirementIds\": [\"FR-34\", \"NFR-2\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/sections\",","-      \"description\": \"Create a section. Role: ADMIN. Homeroom-teacher-per-year check runs inside the write transaction (system-design Decision 3). Audits section.create.\",","-      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/SectionInput\" } },","-      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"409\": \"CONFLICT — duplicate name in year (P2002), or teacher already homeroom of another section this year\", \"400\": \"VALIDATION_ERROR\" },","-      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]","-    },","-    {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/sections/:id\",","-      \"description\": \"Update a section (partial SectionInput, academicYearId immutable). Role: ADMIN. Capacity may not be lowered below current memberCount. Audits section.update.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<SectionInput> without academicYearId\" },","-      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (name/homeroom uniqueness)\", \"400\": \"VALIDATION_ERROR (capacity < memberCount)\" },","-      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]","-    },","-    {","-      \"method\": \"DELETE\",","-      \"path\": \"/api/sections/:id\",","-      \"description\": \"Delete a section. Role: ADMIN. Allowed only when it has no members and no courses. Audits section.delete.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" } },","-      \"responseSchema\": { \"200\": { \"data\": { \"id\": \"string\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT — 'Section 7A still has members or courses.'\" },","-      \"requirementIds\": [\"FR-23\", \"FR-24\"]","-    },","-    {","-      \"method\": \"POST\",","-      \"path\": \"/api/sections/:id/members\",","-      \"description\": \"Add students to a section and auto-enroll them ACTIVE in every non-archived CORE course of the section (reactivating DROPPED rows), all in one $transaction via roster-engine.enrollSectionCoreCourses with batched createMany/updateMany. Role: ADMIN. Audits section.member.add + enrollment.*.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },","+      \"method\": \"GET\",","+      \"path\": \"/api/auth/session\",","+      \"description\": \"Auth.js protocol endpoint (catch-all). Returns the current session or null. Public. Middleware does not gate it.\",","+      \"auth\": \"public\",","+      \"requestSchema\": {},","       \"responseSchema\": {","-        \"201\": { \"data\": { \"added\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },","-        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Sam Student is already in section 7A for 2026–2027.' (SectionMember @@unique P2002, mapped to the friendly message by the service)\"],","-        \"400\": \"VALIDATION_ERROR — student not role=STUDENT or wrong grade level\", \"404\": \"NOT_FOUND\"","+        \"oneOf\": [","+          { \"type\": \"null\" },","+          {","+            \"type\": \"object\",","+            \"properties\": {","+              \"user\": {","+                \"type\": \"object\",","+                \"properties\": {","+                  \"id\": { \"type\": \"string\" },","+                  \"role\": { \"type\": \"string\", \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\", \"...existing Role enum values\"] },","+                  \"firstName\": { \"type\": \"string\" },","+                  \"lastName\": { \"type\": \"string\" },","+                  \"email\": { \"type\": \"string\", \"format\": \"email\" }","+                },","+                \"required\": [\"id\", \"role\", \"firstName\", \"lastName\", \"email\"]","+              },","+              \"expires\": { \"type\": \"string\", \"format\": \"date-time\" }","+            }","+          }","+        ]","       },","-      \"requirementIds\": [\"FR-4\", \"FR-7\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-2\", \"NFR-3\"]","+      \"envelope\": \"Auth.js native\",","+      \"requirementIds\": [\"FR-10\", \"FR-34\"]","     },","     {","-      \"method\": \"DELETE\",","-      \"path\": \"/api/sections/:id/members/:studentId\",","-      \"description\": \"Remove a student from a section; their ACTIVE enrollments in this section's CORE courses become DROPPED with droppedAt=now (electives untouched) via roster-engine.dropSectionCoreCourses, same transaction. Role: ADMIN. Audits section.member.remove + enrollment.drop.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\", \"studentId\": \"string\" } },","-      \"responseSchema\": { \"200\": { \"data\": { \"removed\": true, \"droppedEnrollments\": \"number\" } }, \"404\": \"NOT_FOUND (student not a member)\" },","-      \"requirementIds\": [\"FR-4\", \"FR-8\", \"FR-12\", \"FR-23\", \"FR-24\"]","-    },","-    {","       \"method\": \"POST\",","-      \"path\": \"/api/students/:id/move-section\",","-      \"description\": \"Move a student to another section of the same academic year in a single $transaction: remove membership + drop source CORE enrollments, add membership + enroll/reactivate destination CORE enrollments (roster-engine.moveStudentSection). Electives unchanged. Role: ADMIN. Audits section.member.move + enrollment.*.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string (studentId)\" }, \"body\": { \"toSectionId\": \"string\", \"overrideCapacity\": \"boolean (optional, default false)\" } },","+      \"path\": \"/api/auth/callback/credentials\",","+      \"description\": \"Auth.js Credentials sign-in (catch-all handlers.POST). Credentials.authorize delegates to authorizeCredentials(): IP rate limit (10 / 5 min) -> trim + lower-case the email -> exactly one bcrypt compare (DUMMY_HASH if the user is missing) -> status/archived/lock checks -> lockout bookkeeping -> audit. On success the jwt callback sets {id, role, firstName, lastName, email, authTime, checkedAt}, maxAge 8h, updateAge 15m. The client calls it through signIn('credentials', {redirect:false}) and reads the error code.\",","+      \"auth\": \"public (Auth.js CSRF token)\",","+      \"requestSchema\": {","+        \"contentType\": \"application/x-www-form-urlencoded\",","+        \"type\": \"object\",","+        \"properties\": {","+          \"email\": { \"type\": \"string\", \"format\": \"email\", \"transform\": \"trim + toLowerCase\" },","+          \"password\": { \"type\": \"string\" },","+          \"csrfToken\": { \"type\": \"string\" },","+          \"callbackUrl\": { \"type\": \"string\", \"note\": \"sanitised by safeCallbackUrl(): only a relative path starting with '/' and not '//' or '/\\\\'; otherwise /dashboard\" }","+        },","+        \"required\": [\"email\", \"password\", \"csrfToken\"]","+      },","       \"responseSchema\": {","-        \"200\": { \"data\": { \"fromSectionId\": \"string\", \"toSectionId\": \"string\", \"dropped\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },","-        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }],","-        \"400\": \"VALIDATION_ERROR — destination in a different academic year, or same as source\", \"404\": \"NOT_FOUND — student has no section this year, or toSectionId unknown\"","+        \"success\": { \"sets-cookie\": \"authjs.session-token (__Secure- prefix in prod)\", \"url\": \"safeCallbackUrl(callbackUrl)\" },","+        \"failure\": {","+          \"type\": \"object\",","+          \"properties\": {","+            \"error\": { \"const\": \"CredentialsSignin\" },","+            \"code\": {","+              \"type\": \"string\",","+              \"enum\": [\"invalid\", \"disabled\", \"locked:<minutes>\", \"rate_limited\"],","+              \"uiMessages\": {","+                \"invalid\": \"Email or password is incorrect.\",","+                \"disabled\": \"This account is disabled. Contact the school office.\",","+                \"locked:N\": \"This account is temporarily locked. Try again in N minutes.\",","+                \"rate_limited\": \"Too many attempts. Wait a few minutes and try again.\"","+              }","+            }","+          }","+        }","       },","-      \"requirementIds\": [\"FR-9\", \"FR-7\", \"FR-8\", \"FR-11\", \"FR-23\", \"FR-24\"]","+      \"sideEffects\": [","+        \"wrong password: failedLoginCount += 1; at 5 -> lockedUntil = now + 15 min, failedLoginCount = 0\",","+        \"success: failedLoginCount = 0, lastLoginAt = now\",","+        \"audit auth.login.success | auth.login.failure {email, reason} | auth.lockout, with the IP from x-forwarded-for\"","+      ],","+      \"envelope\": \"Auth.js native\",","+      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-9\", \"FR-10\", \"FR-30\", \"FR-34\", \"NFR-2\", \"NFR-3\", \"NFR-4\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/sections/:id/core-courses\",","-      \"description\": \"Bulk-create one CORE course per item (default name '<Subject> – <Section>', code '<SUBJECTCODE>-<SECTION>') and enroll all current section members in each, one $transaction. Subjects must be non-archived. Role: ADMIN. Audits course.create + enrollment.* per course.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"items\": [{ \"subjectId\": \"string\", \"teacherId\": \"string (role=TEACHER)\" }], \"_constraints\": \"items min 1, subjectIds unique\" } },","-      \"responseSchema\": { \"201\": { \"data\": { \"courses\": [{ \"$ref\": \"#/schemas/Course\" }], \"enrollmentsCreated\": \"number\" } }, \"409\": \"CONFLICT — course code already exists this year (P2002)\", \"400\": \"VALIDATION_ERROR\" },","-      \"requirementIds\": [\"FR-5\", \"FR-10\", \"FR-23\", \"FR-24\", \"NFR-3\"]","+      \"path\": \"/api/auth/signout\",","+      \"description\": \"Auth.js sign-out (catch-all). Clears the session cookie. The shell calls it through signOut({redirectTo:'/login'}).\",","+      \"auth\": \"public (Auth.js CSRF token)\",","+      \"requestSchema\": {","+        \"contentType\": \"application/x-www-form-urlencoded\",","+        \"type\": \"object\",","+        \"properties\": { \"csrfToken\": { \"type\": \"string\" }, \"callbackUrl\": { \"type\": \"string\" } },","+        \"required\": [\"csrfToken\"]","+      },","+      \"responseSchema\": { \"url\": \"/login\" },","+      \"envelope\": \"Auth.js native\",","+      \"requirementIds\": [\"FR-32\", \"FR-34\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/sections/copy-to-year\",","-      \"description\": \"Structural copy of all sections from one year to a future, non-current year: name, room, capacity copied; gradeLevel advanced to the next GradeLevel by `order` (sections at the top grade are skipped); no members, no homeroom teacher, no courses. Role: ADMIN. Audits section.create per copy.\",","-      \"requestSchema\": { \"body\": { \"fromYearId\": \"string\", \"toYearId\": \"string (must be a future, non-current AcademicYear)\" } },","-      \"responseSchema\": { \"201\": { \"data\": { \"created\": \"number\", \"skipped\": [{ \"name\": \"string\", \"reason\": \"no next grade level | name already exists in target year\" }] } }, \"400\": \"VALIDATION_ERROR — toYearId is current or not in the future\" },","-      \"requirementIds\": [\"FR-6\", \"FR-23\", \"FR-24\", \"NFR-6\"]","+      \"path\": \"/api/auth/accept-invite\",","+      \"description\": \"Activates an invited account. Flow: verifyToken(token, 'INVITE') -> assertPasswordAllowed -> bcrypt.hash(12) -> one transaction {passwordHash, status=ACTIVE, passwordChangedAt=now} + consumeToken -> audit auth.invite.accepted. It does NOT mint a session: on 200 the client calls signIn('credentials', {email, password, redirectTo:'/dashboard'}). Public via the /api/auth/ prefix and protected by the middleware origin check.\",","+      \"auth\": \"public + origin check\",","+      \"handler\": \"src/app/api/auth/accept-invite/route.ts -> services/auth.acceptInvite\",","+      \"requestSchema\": {","+        \"zod\": \"acceptInviteSchema\",","+        \"type\": \"object\",","+        \"properties\": {","+          \"token\": { \"type\": \"string\", \"description\": \"raw base64url token from /invite/<token>\" },","+          \"password\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"≥1 letter, ≥1 digit, != email, not in common-passwords.txt\" },","+          \"confirm\": { \"type\": \"string\", \"description\": \"must equal password (client and zod refine)\" }","+        },","+        \"required\": [\"token\", \"password\", \"confirm\"]","+      },","+      \"responseSchema\": {","+        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"email\": { \"type\": \"string\", \"format\": \"email\" } }, \"required\": [\"email\"] } },","+        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"password\": [\"string\"], \"confirm\": [\"string\"] } } } },","+        \"403\": { \"error\": { \"code\": \"FORBIDDEN\", \"message\": \"Cross-origin request rejected\" } },","+        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This invitation link is invalid or has expired. Ask the school office to send a new one.\" } }","+      },","+      \"requirementIds\": [\"FR-13\", \"FR-16\", \"FR-17\", \"FR-30\", \"FR-31\", \"FR-37\", \"NFR-1\", \"NFR-2\", \"NFR-8\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/courses\",","-      \"description\": \"List courses. ADMIN sees all; TEACHER sees courses they teach/co-teach; STUDENT/PARENT see courses with an ACTIVE enrollment for self/linked child (scoping done in courses-service, not by client filter). Excludes archived unless includeArchived=true (ADMIN only).\",","-      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, default current)\", \"gradeLevelId\": \"string\", \"subjectId\": \"string\", \"teacherId\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"sectionId\": \"string\", \"includeArchived\": \"boolean\", \"q\": \"string (name/code)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"code|name|enrolledCount\", \"order\": \"asc|desc\" } },","-      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Course\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },","-      \"requirementIds\": [\"FR-13\", \"FR-23\", \"NFR-7\"]","-    },","-    {","       \"method\": \"POST\",","-      \"path\": \"/api/courses\",","-      \"description\": \"Create a course. Role: ADMIN. A new CORE course on a section enrolls all current section members ACTIVE in the same transaction (FR-10). Audits course.create (+ enrollment.* if CORE).\",","-      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/CourseInput\" } },","-      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"409\": \"CONFLICT — code already used this year\", \"400\": \"VALIDATION_ERROR — e.g. kind=CORE without sectionId, >3 coTeachers\" },","-      \"requirementIds\": [\"FR-14\", \"FR-10\", \"FR-23\", \"FR-24\"]","-    },","-    {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/courses/:id\",","-      \"description\": \"Update a course (partial CourseInput; academicYearId/sectionId/kind immutable after creation to avoid silent roster rewrites). Archive via { archived: true } (sets archivedAt), unarchive via { archived: false }. Role: ADMIN. Audits course.update / course.archive.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<CourseInput> without academicYearId/sectionId/kind, plus archived?: boolean\" },","-      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (code)\", \"400\": \"VALIDATION_ERROR (capacity < enrolledCount)\" },","-      \"requirementIds\": [\"FR-14\", \"FR-23\", \"FR-24\"]","-    },","-    {","-      \"method\": \"GET\",","-      \"path\": \"/api/courses/:id\",","-      \"description\": \"Course header/overview data for /courses/[courseId]. Gated by assertCanViewCourse (ADMIN all; TEACHER teacher/co-teacher; STUDENT ACTIVE enrollment; PARENT linked child ACTIVE enrollment).\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" } },","-      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"403\": \"FORBIDDEN\", \"404\": \"NOT_FOUND\" },","-      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\", \"FR-23\"]","-    },","-    {","-      \"method\": \"GET\",","-      \"path\": \"/api/courses/:id/roster\",","-      \"description\": \"Course roster, ACTIVE enrollments by default. Gated by assertCanViewCourse; PARENT gets FORBIDDEN (Roster tab not shown). Shape from courses-service.getCourseRoster(id, viewerRole) — the same function the Roster tab server component uses.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"query\": { \"status\": \"ACTIVE|DROPPED|ALL (default ACTIVE; DROPPED/ALL only for ADMIN/TEACHER)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"q\": \"string\" } },","+      \"path\": \"/api/auth/forgot-password\",","+      \"description\": \"Requests a password-reset link. Over 10 requests per IP per hour -> 429. Over 3 requests per email per hour -> silent generic 200 (no enumeration). Only an existing ACTIVE user gets createToken(PASSWORD_RESET, 60 min), which invalidates older unused reset tokens, plus sendAuthEmail(user, 'password-reset', link). Unknown or inactive emails write nothing. The response body is always identical.\",","+      \"auth\": \"public + origin check\",","+      \"handler\": \"src/app/api/auth/forgot-password/route.ts -> services/auth.requestPasswordReset\",","+      \"requestSchema\": {","+        \"zod\": \"forgotPasswordSchema\",","+        \"type\": \"object\",","+        \"properties\": { \"email\": { \"type\": \"string\", \"format\": \"email\", \"transform\": \"trim + toLowerCase\" } },","+        \"required\": [\"email\"]","+      },","       \"responseSchema\": {","-        \"200 (ADMIN, TEACHER)\": { \"data\": [{ \"enrollmentId\": \"string\", \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\", \"profileUrl\": \"/students/:id\" } }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },","-        \"200 (STUDENT)\": { \"data\": [{ \"name\": \"string\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" }, \"_privacy\": \"Projection is names only — no ids, emails, admission numbers, avatars or profile links; status forced to ACTIVE (NFR-4)\" },","-        \"403\": \"FORBIDDEN (no view access, or PARENT)\"","+        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"message\": { \"const\": \"If an account exists for that email, we've sent a reset link.\" } } } },","+        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"email\": [\"string\"] } } } },","+        \"429\": { \"error\": { \"code\": \"RATE_LIMITED\", \"message\": \"Too many attempts. Wait a few minutes and try again.\" } }","       },","-      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-12\", \"FR-23\", \"NFR-4\"]","+      \"requirementIds\": [\"FR-2\", \"FR-13\", \"FR-19\", \"FR-20\", \"FR-22\", \"NFR-2\", \"NFR-3\", \"NFR-8\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/courses/:id/enrollments\",","-      \"description\": \"Enroll students directly in a course (create or reactivate DROPPED; same semantics as the roster engine helper). Role: ADMIN. Refused for CORE courses (membership is managed via the section). Capacity checked via checkCapacityOrThrow. Audits enrollment.create / enrollment.reactivate.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },","-      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/EnrollResult\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Core course enrollment is managed via section 7A.'\"], \"400\": \"VALIDATION_ERROR — non-student ids\", \"404\": \"NOT_FOUND\" },","-      \"requirementIds\": [\"FR-15\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-3\"]","+      \"path\": \"/api/auth/reset-password\",","+      \"description\": \"Completes a reset. Flow: verifyToken(token, 'PASSWORD_RESET') -> assertPasswordAllowed -> hash -> one transaction {passwordHash, passwordChangedAt=now, failedLoginCount=0, lockedUntil=null} + consumeToken -> audit auth.password.reset. The client then redirects to /login?reset=1, which shows a useToast success toast. Existing sessions are revoked within 5 min by the jwt callback (passwordChangedAt > authTime).\",","+      \"auth\": \"public + origin check\",","+      \"handler\": \"src/app/api/auth/reset-password/route.ts -> services/auth.resetPassword\",","+      \"requestSchema\": {","+        \"zod\": \"resetPasswordSchema\",","+        \"type\": \"object\",","+        \"properties\": {","+          \"token\": { \"type\": \"string\" },","+          \"password\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"same as accept-invite\" },","+          \"confirm\": { \"type\": \"string\" }","+        },","+        \"required\": [\"token\", \"password\", \"confirm\"]","+      },","+      \"responseSchema\": {","+        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"ok\": { \"const\": true } } } },","+        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"password\": [\"string\"], \"confirm\": [\"string\"] } } } },","+        \"403\": { \"error\": { \"code\": \"FORBIDDEN\" } },","+        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This reset link is invalid or has expired.\" } }","+      },","+      \"requirementIds\": [\"FR-11\", \"FR-13\", \"FR-17\", \"FR-21\", \"FR-30\", \"FR-31\", \"NFR-1\", \"NFR-2\", \"NFR-8\"]","     },","     {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/enrollments/:id\",","-      \"description\": \"Drop or reactivate a single enrollment (DROPPED sets droppedAt=now; ACTIVE clears it and runs checkCapacityOrThrow). Historical data is retained either way. Role: ADMIN. Audits enrollment.drop / enrollment.reactivate.\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"status\": \"ACTIVE|DROPPED\", \"overrideCapacity\": \"boolean (optional, only meaningful for ACTIVE)\" } },","-      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Enrollment\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }], \"404\": \"NOT_FOUND\" },","-      \"requirementIds\": [\"FR-15\", \"FR-12\", \"FR-11\", \"FR-23\", \"FR-24\"]","-    },","-    {","-      \"method\": \"GET\",","-      \"path\": \"/api/me/courses\",","-      \"description\": \"Current user's courses for /my-courses, current academic year, non-archived. TEACHER: taught/co-taught; STUDENT: ACTIVE enrollments; PARENT: grouped by linked child; ADMIN: empty list (admins use /admin/courses). Role: any (requireRole(...ALL_ROLES), NFR-7 stand-in identity).\",","-      \"requestSchema\": {},","+      \"method\": \"POST\",","+      \"path\": \"/api/account/password\",","+      \"description\": \"Changes the signed-in user's password. Flow: await requireUser() -> bcrypt-compare currentPassword -> assertPasswordAllowed(newPassword, email) -> hash -> update {passwordHash, passwordChangedAt=now} -> audit auth.password.changed -> unstable_update({reauth:true}), so this session's authTime moves past passwordChangedAt. Other sessions fail the jwt check within 5 min. The UI shows the 'Password updated' toast.\",","+      \"auth\": \"session required (middleware 401 + requireUser())\",","+      \"handler\": \"src/app/api/account/password/route.ts -> services/auth.changePassword\",","+      \"requestSchema\": {","+        \"zod\": \"changePasswordSchema\",","+        \"type\": \"object\",","+        \"properties\": {","+          \"currentPassword\": { \"type\": \"string\" },","+          \"newPassword\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"same as accept-invite\" },","+          \"confirm\": { \"type\": \"string\" }","+        },","+        \"required\": [\"currentPassword\", \"newPassword\", \"confirm\"]","+      },","       \"responseSchema\": {","-        \"200 (TEACHER)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"section\": { \"id\": \"string\", \"name\": \"string\" }, \"enrolledCount\": \"number\" }] },","-        \"200 (STUDENT)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] },","-        \"200 (PARENT)\": { \"data\": [{ \"child\": { \"id\": \"string\", \"name\": \"string\" }, \"courses\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] }] }","+        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"ok\": { \"const\": true } } }, \"sets-cookie\": \"re-issued session token\" },","+        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"currentPassword\": [\"Current password is incorrect.\"], \"newPassword\": [\"string\"], \"confirm\": [\"string\"] } } } },","+        \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" } },","+        \"403\": { \"error\": { \"code\": \"FORBIDDEN\", \"message\": \"Cross-origin request rejected\" } }","       },","-      \"requirementIds\": [\"FR-19\", \"FR-23\", \"NFR-7\"]","+      \"requirementIds\": [\"FR-11\", \"FR-17\", \"FR-23\", \"FR-28\", \"FR-30\", \"FR-31\", \"NFR-2\", \"NFR-7\", \"NFR-8\"]","     }","   ],","+","+  \"changedBehaviourOnExistingEndpoints\": {","+    \"description\": \"Every existing route handler (33 route.ts files) changes from requireRole(...) to await requireRole(...), backed by the real session. Paths, request shapes and response shapes don't change. New possible responses on all of them:\",","+    \"responses\": {","+      \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" }, \"source\": \"middleware (no session) or requireUser/requireRole (session revoked)\" },","+      \"403\": { \"error\": { \"code\": \"FORBIDDEN\" }, \"source\": \"requireRole role mismatch, or the middleware cross-origin check on mutations\" }","+    },","+    \"unchanged\": [\"/api/health stays public\"],","+    \"requirementIds\": [\"FR-12\", \"FR-28\", \"FR-29\", \"NFR-7\", \"NFR-9\"]","+  },","+","+  \"explicitlyAbsent\": [","+    { \"item\": \"No sign-up / register endpoint\", \"requirementIds\": [\"FR-37\"] },","+    { \"item\": \"No admin user-management, SSO, MFA or magic-link endpoints\", \"requirementIds\": [\"NFR-11\"] },","+    { \"item\": \"No /api/v1 prefix; existing /api convention kept\", \"requirementIds\": [\"NFR-9\"] }","+  ],","+","   \"status\": \"complete\""," }"]}],"originalFile":"{\n  \"ticketId\": \"abcd-05\",\n  \"timestamp\": \"2026-10-27T00:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md (REST API surface + Data Flow) and 05-classes-enrollment.md's API table; 17 endpoints (the table's '·'-joined rows are expanded). Conventions shared by every endpoint, not repeated per entry: (1) every handler is wrapped in withHandler() from src/server/http.ts, which maps ZodError->VALIDATION_ERROR 400, AppError->its code, Prisma P2002->CONFLICT 409, P2025->NOT_FOUND 404; (2) success = ok() -> { data }, lists = paginated() -> { data: [...], meta: { page, pageSize, total } } — the real helper nests pagination under `meta`, unlike the PRD's flat example; follow the helper; (3) list query conventions: page (default 1), pageSize (default 20, max 100), sort, order=asc|desc, q; (4) auth: every route calls requireRole(...) from src/server/auth/requireRole.ts (NFR-7 stand-in; no permissions.ts/requireUser()); course-scoped reads additionally call assertCanViewCourse from src/server/auth/course-access.ts (FR-18); (5) every write calls audit() inside the same $transaction (FR-24) via the service/engine, never at the route layer; (6) handlers are thin: zod parse -> one service call -> envelope. Shared shapes are named under `schemas` and referenced as \\\"$ref\\\": \\\"#/schemas/<Name>\\\".\",\n\n  \"schemas\": {\n    \"Section\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevel\": { \"id\": \"string\", \"name\": \"string\", \"order\": \"number\" },\n      \"name\": \"string\", \"homeroomTeacherId\": \"string|null\", \"homeroomTeacher\": { \"id\": \"string\", \"name\": \"string\" },\n      \"roomId\": \"string|null\", \"room\": { \"id\": \"string\", \"name\": \"string\" }, \"capacity\": \"number (1-60)\",\n      \"memberCount\": \"number\", \"courseCount\": \"number\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"SectionInput\": {\n      \"academicYearId\": \"string (required on create)\", \"gradeLevelId\": \"string\", \"name\": \"string (min 1)\",\n      \"homeroomTeacherId\": \"string|null (must be role=TEACHER; at most one section per teacher per year -> CONFLICT)\",\n      \"roomId\": \"string|null\", \"capacity\": \"int 1-60, default 30\"\n    },\n    \"Course\": {\n      \"id\": \"string\", \"academicYearId\": \"string\", \"subjectId\": \"string\", \"subject\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"color\": \"string\" },\n      \"sectionId\": \"string|null\", \"section\": { \"id\": \"string\", \"name\": \"string\", \"room\": { \"id\": \"string\", \"name\": \"string\" } },\n      \"teacherId\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" }, \"coTeacherIds\": \"string[]\", \"coTeachers\": [{ \"id\": \"string\", \"name\": \"string\" }],\n      \"name\": \"string\", \"code\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"description\": \"string|null\", \"capacity\": \"number|null\",\n      \"archivedAt\": \"ISO 8601|null\", \"enrolledCount\": \"number (ACTIVE only)\", \"createdAt\": \"ISO 8601\", \"updatedAt\": \"ISO 8601\"\n    },\n    \"CourseInput\": {\n      \"academicYearId\": \"string (required on create)\", \"subjectId\": \"string\", \"sectionId\": \"string|null (required iff kind=CORE — single zod refinement shared with the dialog, FR-14)\",\n      \"teacherId\": \"string (role=TEACHER)\", \"coTeacherIds\": \"string[] (max 3, role=TEACHER)\", \"name\": \"string (default '<Subject> – <Section>')\",\n      \"code\": \"string (default '<SUBJECTCODE>-<SECTION>', transformed to uppercase; unique per year -> CONFLICT)\", \"kind\": \"CORE|ELECTIVE (default CORE)\",\n      \"capacity\": \"int>=1|null\", \"description\": \"string|null\"\n    },\n    \"Enrollment\": {\n      \"id\": \"string\", \"courseId\": \"string\", \"studentId\": \"string\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\" },\n      \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\"\n    },\n    \"EnrollStudentsInput\": { \"studentIds\": \"string[] (min 1)\", \"overrideCapacity\": \"boolean (optional, default false)\" },\n    \"EnrollResult\": { \"enrolled\": \"number (new ACTIVE rows)\", \"reactivated\": \"number (DROPPED->ACTIVE)\", \"alreadyActive\": \"number\" },\n    \"CapacityConflict\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Section 7A is full (30/30). | Course MATH-7A is full (30/30).\" } }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/sections\",\n      \"description\": \"List sections for an academic year (defaults to current). Roles: ADMIN, TEACHER. Service: sections-service.listSections.\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, defaults to current AcademicYear)\", \"gradeLevelId\": \"string (optional)\", \"q\": \"string (optional, name search)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"name|gradeLevel|memberCount (default gradeLevel)\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Section\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } }, \"403\": \"FORBIDDEN (STUDENT/PARENT)\" },\n      \"requirementIds\": [\"FR-2\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections\",\n      \"description\": \"Create a section. Role: ADMIN. Homeroom-teacher-per-year check runs inside the write transaction (system-design Decision 3). Audits section.create.\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/SectionInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"409\": \"CONFLICT — duplicate name in year (P2002), or teacher already homeroom of another section this year\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Update a section (partial SectionInput, academicYearId immutable). Role: ADMIN. Capacity may not be lowered below current memberCount. Audits section.update.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<SectionInput> without academicYearId\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Section\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (name/homeroom uniqueness)\", \"400\": \"VALIDATION_ERROR (capacity < memberCount)\" },\n      \"requirementIds\": [\"FR-3\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id\",\n      \"description\": \"Delete a section. Role: ADMIN. Allowed only when it has no members and no courses. Audits section.delete.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"id\": \"string\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT — 'Section 7A still has members or courses.'\" },\n      \"requirementIds\": [\"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/members\",\n      \"description\": \"Add students to a section and auto-enroll them ACTIVE in every non-archived CORE course of the section (reactivating DROPPED rows), all in one $transaction via roster-engine.enrollSectionCoreCourses with batched createMany/updateMany. Role: ADMIN. Audits section.member.add + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": {\n        \"201\": { \"data\": { \"added\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Sam Student is already in section 7A for 2026–2027.' (SectionMember @@unique P2002, mapped to the friendly message by the service)\"],\n        \"400\": \"VALIDATION_ERROR — student not role=STUDENT or wrong grade level\", \"404\": \"NOT_FOUND\"\n      },\n      \"requirementIds\": [\"FR-4\", \"FR-7\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-2\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/sections/:id/members/:studentId\",\n      \"description\": \"Remove a student from a section; their ACTIVE enrollments in this section's CORE courses become DROPPED with droppedAt=now (electives untouched) via roster-engine.dropSectionCoreCourses, same transaction. Role: ADMIN. Audits section.member.remove + enrollment.drop.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\", \"studentId\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"removed\": true, \"droppedEnrollments\": \"number\" } }, \"404\": \"NOT_FOUND (student not a member)\" },\n      \"requirementIds\": [\"FR-4\", \"FR-8\", \"FR-12\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/students/:id/move-section\",\n      \"description\": \"Move a student to another section of the same academic year in a single $transaction: remove membership + drop source CORE enrollments, add membership + enroll/reactivate destination CORE enrollments (roster-engine.moveStudentSection). Electives unchanged. Role: ADMIN. Audits section.member.move + enrollment.*.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string (studentId)\" }, \"body\": { \"toSectionId\": \"string\", \"overrideCapacity\": \"boolean (optional, default false)\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"fromSectionId\": \"string\", \"toSectionId\": \"string\", \"dropped\": \"number\", \"enrollments\": { \"$ref\": \"#/schemas/EnrollResult\" } } },\n        \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }],\n        \"400\": \"VALIDATION_ERROR — destination in a different academic year, or same as source\", \"404\": \"NOT_FOUND — student has no section this year, or toSectionId unknown\"\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-7\", \"FR-8\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/:id/core-courses\",\n      \"description\": \"Bulk-create one CORE course per item (default name '<Subject> – <Section>', code '<SUBJECTCODE>-<SECTION>') and enroll all current section members in each, one $transaction. Subjects must be non-archived. Role: ADMIN. Audits course.create + enrollment.* per course.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"items\": [{ \"subjectId\": \"string\", \"teacherId\": \"string (role=TEACHER)\" }], \"_constraints\": \"items min 1, subjectIds unique\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"courses\": [{ \"$ref\": \"#/schemas/Course\" }], \"enrollmentsCreated\": \"number\" } }, \"409\": \"CONFLICT — course code already exists this year (P2002)\", \"400\": \"VALIDATION_ERROR\" },\n      \"requirementIds\": [\"FR-5\", \"FR-10\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/sections/copy-to-year\",\n      \"description\": \"Structural copy of all sections from one year to a future, non-current year: name, room, capacity copied; gradeLevel advanced to the next GradeLevel by `order` (sections at the top grade are skipped); no members, no homeroom teacher, no courses. Role: ADMIN. Audits section.create per copy.\",\n      \"requestSchema\": { \"body\": { \"fromYearId\": \"string\", \"toYearId\": \"string (must be a future, non-current AcademicYear)\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"created\": \"number\", \"skipped\": [{ \"name\": \"string\", \"reason\": \"no next grade level | name already exists in target year\" }] } }, \"400\": \"VALIDATION_ERROR — toYearId is current or not in the future\" },\n      \"requirementIds\": [\"FR-6\", \"FR-23\", \"FR-24\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses\",\n      \"description\": \"List courses. ADMIN sees all; TEACHER sees courses they teach/co-teach; STUDENT/PARENT see courses with an ACTIVE enrollment for self/linked child (scoping done in courses-service, not by client filter). Excludes archived unless includeArchived=true (ADMIN only).\",\n      \"requestSchema\": { \"query\": { \"academicYearId\": \"string (optional, default current)\", \"gradeLevelId\": \"string\", \"subjectId\": \"string\", \"teacherId\": \"string\", \"kind\": \"CORE|ELECTIVE\", \"sectionId\": \"string\", \"includeArchived\": \"boolean\", \"q\": \"string (name/code)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"sort\": \"code|name|enrolledCount\", \"order\": \"asc|desc\" } },\n      \"responseSchema\": { \"200\": { \"data\": [{ \"$ref\": \"#/schemas/Course\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } } },\n      \"requirementIds\": [\"FR-13\", \"FR-23\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses\",\n      \"description\": \"Create a course. Role: ADMIN. A new CORE course on a section enrolls all current section members ACTIVE in the same transaction (FR-10). Audits course.create (+ enrollment.* if CORE).\",\n      \"requestSchema\": { \"body\": { \"$ref\": \"#/schemas/CourseInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"409\": \"CONFLICT — code already used this year\", \"400\": \"VALIDATION_ERROR — e.g. kind=CORE without sectionId, >3 coTeachers\" },\n      \"requirementIds\": [\"FR-14\", \"FR-10\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Update a course (partial CourseInput; academicYearId/sectionId/kind immutable after creation to avoid silent roster rewrites). Archive via { archived: true } (sets archivedAt), unarchive via { archived: false }. Role: ADMIN. Audits course.update / course.archive.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": \"Partial<CourseInput> without academicYearId/sectionId/kind, plus archived?: boolean\" },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"404\": \"NOT_FOUND\", \"409\": \"CONFLICT (code)\", \"400\": \"VALIDATION_ERROR (capacity < enrolledCount)\" },\n      \"requirementIds\": [\"FR-14\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id\",\n      \"description\": \"Course header/overview data for /courses/[courseId]. Gated by assertCanViewCourse (ADMIN all; TEACHER teacher/co-teacher; STUDENT ACTIVE enrollment; PARENT linked child ACTIVE enrollment).\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Course\" } }, \"403\": \"FORBIDDEN\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\", \"FR-23\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/:id/roster\",\n      \"description\": \"Course roster, ACTIVE enrollments by default. Gated by assertCanViewCourse; PARENT gets FORBIDDEN (Roster tab not shown). Shape from courses-service.getCourseRoster(id, viewerRole) — the same function the Roster tab server component uses.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"query\": { \"status\": \"ACTIVE|DROPPED|ALL (default ACTIVE; DROPPED/ALL only for ADMIN/TEACHER)\", \"page\": \"int\", \"pageSize\": \"int<=100\", \"q\": \"string\" } },\n      \"responseSchema\": {\n        \"200 (ADMIN, TEACHER)\": { \"data\": [{ \"enrollmentId\": \"string\", \"status\": \"ACTIVE|DROPPED\", \"enrolledAt\": \"ISO 8601\", \"droppedAt\": \"ISO 8601|null\", \"student\": { \"id\": \"string\", \"name\": \"string\", \"avatarUrl\": \"string|null\", \"admissionNumber\": \"string|null\", \"profileUrl\": \"/students/:id\" } }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },\n        \"200 (STUDENT)\": { \"data\": [{ \"name\": \"string\" }], \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" }, \"_privacy\": \"Projection is names only — no ids, emails, admission numbers, avatars or profile links; status forced to ACTIVE (NFR-4)\" },\n        \"403\": \"FORBIDDEN (no view access, or PARENT)\"\n      },\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-12\", \"FR-23\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/courses/:id/enrollments\",\n      \"description\": \"Enroll students directly in a course (create or reactivate DROPPED; same semantics as the roster engine helper). Role: ADMIN. Refused for CORE courses (membership is managed via the section). Capacity checked via checkCapacityOrThrow. Audits enrollment.create / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"$ref\": \"#/schemas/EnrollStudentsInput\" } },\n      \"responseSchema\": { \"201\": { \"data\": { \"$ref\": \"#/schemas/EnrollResult\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }, \"CONFLICT — 'Core course enrollment is managed via section 7A.'\"], \"400\": \"VALIDATION_ERROR — non-student ids\", \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-11\", \"FR-23\", \"FR-24\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/enrollments/:id\",\n      \"description\": \"Drop or reactivate a single enrollment (DROPPED sets droppedAt=now; ACTIVE clears it and runs checkCapacityOrThrow). Historical data is retained either way. Role: ADMIN. Audits enrollment.drop / enrollment.reactivate.\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" }, \"body\": { \"status\": \"ACTIVE|DROPPED\", \"overrideCapacity\": \"boolean (optional, only meaningful for ACTIVE)\" } },\n      \"responseSchema\": { \"200\": { \"data\": { \"$ref\": \"#/schemas/Enrollment\" } }, \"409\": [{ \"$ref\": \"#/schemas/CapacityConflict\" }], \"404\": \"NOT_FOUND\" },\n      \"requirementIds\": [\"FR-15\", \"FR-12\", \"FR-11\", \"FR-23\", \"FR-24\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/courses\",\n      \"description\": \"Current user's courses for /my-courses, current academic year, non-archived. TEACHER: taught/co-taught; STUDENT: ACTIVE enrollments; PARENT: grouped by linked child; ADMIN: empty list (admins use /admin/courses). Role: any (requireRole(...ALL_ROLES), NFR-7 stand-in identity).\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"200 (TEACHER)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"section\": { \"id\": \"string\", \"name\": \"string\" }, \"enrolledCount\": \"number\" }] },\n        \"200 (STUDENT)\": { \"data\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] },\n        \"200 (PARENT)\": { \"data\": [{ \"child\": { \"id\": \"string\", \"name\": \"string\" }, \"courses\": [{ \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"subjectColor\": \"string\", \"teacher\": { \"id\": \"string\", \"name\": \"string\" } }] }] }\n      },\n      \"requirementIds\": [\"FR-19\", \"FR-23\", \"NFR-7\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_01KH4sSdoNot4UBx7jsfjmCy","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
