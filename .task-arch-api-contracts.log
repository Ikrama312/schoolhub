{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0192quAUi3oTivhGBVtXjcEx","type":"tool_result","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\nsrc/server/auth/student-access.ts:63:export async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n56: * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n57: * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n58: * not allowed to see this particular studentId -- NOT_FOUND rather than\n59: * FORBIDDEN so existence of another family's student is never revealed.\n60: * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n71:    throw new AppError('NOT_FOUND', 'Resource not found');\n74:  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');","is_error":false}]},"parent_tool_use_id":null,"session_id":"3dc3003b-f495-40f4-b937-7fc5d8e13052","uuid":"e399990d-1c7f-48ff-8cc3-93256a992ddd","timestamp":"2026-11-10T04:33:01.763Z","tool_use_result":{"stdout":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\nsrc/server/auth/student-access.ts:63:export async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\n56: * FR-17/FR-25: throws FORBIDDEN for a role that can never see student\n57: * records (none today), or NOT_FOUND for STUDENT/PARENT callers who are\n58: * not allowed to see this particular studentId -- NOT_FOUND rather than\n59: * FORBIDDEN so existence of another family's student is never revealed.\n60: * ADMIN/TEACHER get a plain FORBIDDEN if ever denied (never applicable to\n71:    throw new AppError('NOT_FOUND', 'Resource not found');\n74:  throw new AppError('FORBIDDEN', 'You do not have permission to view this student.');","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0192quAUi3oTivhGBVtXjcEx","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
