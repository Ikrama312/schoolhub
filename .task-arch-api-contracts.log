{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018hoQDx8r7Cvdqu5M54e3dL","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/api-contracts.json has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"3f90400c-337b-4bd2-a543-f73a5eb37374","uuid":"ad531ba5-0288-4aff-9a82-9680b7895e64","timestamp":"2026-11-06T05:35:49.478Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-7\",\n  \"timestamp\": \"2026-11-06T06:45:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-10 forbids renaming routes)\",\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/attendance.ts) → resource assert → attendance-service → ok()/paginated(). Every helper comes from src/server/http.ts (system-design §3.1).\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"total\": \"int\" } },\n    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },\n    \"validationErrorDetails\": \"A ZodError maps to VALIDATION_ERROR with details = zod flatten() { formErrors, fieldErrors }. Service-raised NFR-3 roster errors use details { invalidStudentIds: string[] } or { missingStudentIds: string[] }.\",\n    \"dates\": \"Date-only values are 'yyyy-MM-dd' strings interpreted in SchoolSettings.timezone. Timestamps are ISO 8601 UTC. Display uses formatInSchoolTz (ADR-5).\",\n    \"ids\": \"All ids are cuid strings.\",\n    \"requirementIds\": [\"FR-35\", \"FR-36\", \"NFR-7\", \"NFR-8\"]\n  },\n  \"sharedSchemas\": {\n    \"DateOnly\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n    \"AttendanceStatus\": { \"type\": \"string\", \"enum\": [\"PRESENT\", \"ABSENT\", \"LATE\", \"EXCUSED\"] },\n    \"AttendanceMode\": { \"type\": \"string\", \"enum\": [\"PER_PERIOD\", \"DAILY_HOMEROOM\", \"BOTH\"] },\n    \"RegisterKey\": {\n      \"description\": \"Zod union registerQuery (C6). Course variant or section (daily) variant; exactly one (FR-2).\",\n      \"oneOf\": [\n        { \"type\": \"object\", \"required\": [\"courseId\", \"date\", \"periodId\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" }, \"periodId\": { \"type\": \"string\" } } },\n        { \"type\": \"object\", \"required\": [\"sectionId\", \"date\"], \"properties\": { \"sectionId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } }\n      ]\n    },\n    \"RegisterRecordInput\": {\n      \"description\": \"Zod registerRecord (C6). minutesLate is required (1–240) iff status = LATE and forbidden otherwise (superRefine). EXCUSED is ADMIN-only, checked in the service (FR-10).\",\n      \"type\": \"object\",\n      \"required\": [\"studentId\", \"status\"],\n      \"properties\": {\n        \"studentId\": { \"type\": \"string\" },\n        \"status\": { \"$ref\": \"#/sharedSchemas/AttendanceStatus\" },\n        \"minutesLate\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 240 },\n        \"note\": { \"type\": \"string\", \"maxLength\": 500 }\n      }\n    },\n    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n    \"Register\": {\n      \"description\": \"Returned by GET and PUT /api/attendance/register.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"key\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n        \"header\": { \"type\": \"object\", \"properties\": { \"courseName\": { \"type\": \"string|null\" }, \"sectionName\": { \"type\": \"string\" }, \"periodName\": { \"type\": \"string|null\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } },\n        \"sessionId\": { \"type\": \"string|null\", \"description\": \"null when no register has been saved yet\" },\n        \"students\": {\n          \"type\": \"array\",\n          \"description\": \"Roster active on the date, sorted by last name (FR-9, NFR-3)\",\n          \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" }, \"avatarUrl\": { \"type\": \"string|null\" } } }\n        },\n        \"records\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" }, \"description\": \"Existing records; empty for a new register (nothing preselected, FR-9)\" },\n        \"takenBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },\n        \"readOnly\": { \"type\": \"boolean\" },\n        \"readOnlyReason\": { \"type\": \"string|null\", \"description\": \"e.g. 'Teachers can edit registers up to 14 days after the register date' (FR-19)\" },\n        \"canExcuse\": { \"type\": \"boolean\", \"description\": \"true only for ADMIN (FR-10)\" }\n      }\n    },\n    \"StatusCounts\": { \"type\": \"object\", \"properties\": { \"records\": { \"type\": \"integer\" }, \"present\": { \"type\": \"integer\" }, \"absent\": { \"type\": \"integer\" }, \"late\": { \"type\": \"integer\" }, \"excused\": { \"type\": \"integer\" }, \"rate\": { \"type\": \"number|null\", \"description\": \"(P+L+E)/records×100, 1 dp; null when records = 0 (FR-28)\" } } },\n    \"StudentSummaryRow\": {\n      \"allOf\": [\n        { \"type\": \"object\", \"properties\": { \"studentId\": { \"type\": \"string\" }, \"studentName\": { \"type\": \"string\" }, \"sectionName\": { \"type\": \"string|null\" }, \"gradeLevelName\": { \"type\": \"string|null\" } } },\n        { \"$ref\": \"#/sharedSchemas/StatusCounts\" }\n      ]\n    }\n  },\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/today\",\n      \"description\": \"The teacher's meetings for today in the school timezone (getScheduleForDate) joined with today's sessions, with the current slot flagged. Includes daily homeroom entries when attendanceMode is DAILY_HOMEROOM or BOTH. Guard: requireRole('TEACHER','ADMIN'). An ADMIN gets [] meetings plus no homeroom entries unless they are a homeroom teacher.\",\n      \"requestSchema\": { \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" },\n          \"meetings\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"kind\": \"'course'\",\n              \"courseId\": \"string\",\n              \"courseName\": \"string\",\n              \"sectionName\": \"string\",\n              \"periodId\": \"string\",\n              \"periodName\": \"string\",\n              \"startTime\": \"HH:mm\",\n              \"endTime\": \"HH:mm\",\n              \"isCurrent\": \"boolean\",\n              \"taken\": \"null | { at: ISO date-time, by: UserRef }\"\n            }\n          },\n          \"dailyRegisters\": {\n            \"type\": \"array\",\n            \"items\": { \"kind\": \"'section'\", \"sectionId\": \"string\", \"sectionName\": \"string\", \"taken\": \"null | { at, by: UserRef }\" }\n          }\n        }\n      },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-6\", \"FR-7\", \"FR-35\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Load a course register (?courseId=&date=&periodId=) or daily register (?sectionId=&date=). Guard: requireUser, then assertCanManageCourse or assertCanManageSection (ADMIN or homeroom teacher). Future dates → 400; TEACHER more than 14 days back → 403 for opening (canOpen). Past the edit window → readOnly = true with readOnlyReason.\",\n      \"requestSchema\": { \"query\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" } },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\"VALIDATION_ERROR (bad key, future date)\", \"FORBIDDEN (no access, outside 14-day open window)\", \"NOT_FOUND (course/section/period)\"],\n      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-19\", \"FR-35\", \"NFR-3\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"Create or update the session and all records in one transaction (system-design §3.2). Records must cover the whole active roster and only roster students. After commit: audit('attendance.record.update') per changed status, and notifyStudentAndParents per transition into ABSENT/LATE or ABSENT→PRESENT (corrected). Re-saving unchanged statuses sends nothing. Idempotent: a P2002 race on the partial unique index re-reads the session rather than returning CONFLICT.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod registerPutBody = RegisterKey & { records }\",\n          \"allOf\": [\n            { \"$ref\": \"#/sharedSchemas/RegisterKey\" },\n            { \"type\": \"object\", \"required\": [\"records\"], \"properties\": { \"records\": { \"type\": \"array\", \"minItems\": 1, \"uniqueBy\": \"studentId\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" } } } }\n          ]\n        }\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },\n      \"errors\": [\n        \"VALIDATION_ERROR (schema; future date; studentId not active on date → details.invalidStudentIds; roster not fully marked → details.missingStudentIds)\",\n        \"FORBIDDEN (no access; TEACHER past 14-day edit window; EXCUSED by non-ADMIN)\",\n        \"NOT_FOUND\"\n      ],\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"FR-35\", \"FR-36\", \"NFR-1\", \"NFR-3\", \"NFR-5\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/{studentId}/attendance\",\n      \"description\": \"Student attendance tab data in one indexed query. Guard: requireUser + assertCanViewStudent (parent → linked students, student → self, teacher/admin per existing rules). Session kind follows attendanceMode (course sessions for PER_PERIOD/BOTH, section sessions for DAILY_HOMEROOM). `note` is omitted from rows for STUDENT and PARENT. from/to default to the current month; summaries always cover the current term and academic year regardless of from/to.\",\n      \"requestSchema\": { \"path\": { \"studentId\": \"string\" }, \"query\": { \"from\": \"DateOnly?\", \"to\": \"DateOnly?\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"summary\": { \"term\": { \"$ref\": \"#/sharedSchemas/StatusCounts\", \"termName\": \"string|null\" }, \"year\": { \"$ref\": \"#/sharedSchemas/StatusCounts\" } },\n          \"calendar\": { \"type\": \"array\", \"items\": { \"date\": \"DateOnly\", \"colour\": \"'success'|'warning'|'error'|'default'\", \"present\": \"int\", \"absent\": \"int\", \"late\": \"int\", \"excused\": \"int\" } },\n          \"records\": {\n            \"type\": \"array\",\n            \"items\": { \"id\": \"string\", \"date\": \"DateOnly\", \"periodName\": \"string|null\", \"courseName\": \"string|null\", \"sectionName\": \"string|null\", \"status\": \"AttendanceStatus\", \"minutesLate\": \"int|null\", \"note\": \"string|null (absent key for STUDENT/PARENT)\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-35\", \"NFR-1\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/courses/{courseId}/attendance\",\n      \"description\": \"Course attendance matrix: the last 20 sessions by date (columns) × enrolled students (ACTIVE, plus DROPPED students with records) with P/A/L/E cells and per-student rate. Guard: requireUser + assertCanManageCourse.\",\n      \"requestSchema\": { \"path\": { \"courseId\": \"string\" }, \"query\": {} },\n      \"responseSchema\": {\n        \"data\": {\n          \"sessions\": { \"type\": \"array\", \"items\": { \"sessionId\": \"string\", \"date\": \"DateOnly\", \"periodId\": \"string\", \"periodName\": \"string\" } },\n          \"students\": {\n            \"type\": \"array\",\n            \"items\": { \"studentId\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"enrollmentStatus\": \"'ACTIVE'|'DROPPED'\", \"cells\": \"{ [sessionId]: AttendanceStatus }\", \"rate\": \"number|null\" }\n          }\n        }\n      },\n      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-28\", \"FR-29\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/overview\",\n      \"description\": \"Today overview: expected meetings (getSchoolScheduleForDate + homeroom sections when mode includes daily) vs taken sessions, the school-wide rate for the date, and missing registers (no session and period.startTime + 15 min ≤ now in school tz; only computed when date is today). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"date\": \"DateOnly? (default school today; future → 400)\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"date\": \"DateOnly\",\n          \"expected\": \"int\",\n          \"taken\": \"int\",\n          \"rate\": \"number|null\",\n          \"missing\": {\n            \"type\": \"array\",\n            \"items\": { \"courseId\": \"string\", \"courseName\": \"string\", \"sectionName\": \"string\", \"periodId\": \"string\", \"periodName\": \"string\", \"startTime\": \"HH:mm\", \"teacher\": \"UserRef\" }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-35\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/report\",\n      \"description\": \"Per-student summary over the filtered range (groupBy studentId, status). JSON is paginated (pageSize ≤ 100). With ?format=csv returns every row as text/csv (Content-Disposition: attachment; filename=attendance-report-<from>-<to>.csv) via toCsv, with columns: Student, Section, Grade, Records, Present, Absent, Late, Excused, Rate. Guard: requireRole('ADMIN').\",\n      \"requestSchema\": {\n        \"query\": {\n          \"from\": \"DateOnly (required)\",\n          \"to\": \"DateOnly (required, ≥ from, range ≤ 366 days)\",\n          \"gradeLevelId\": \"string?\",\n          \"sectionId\": \"string?\",\n          \"courseId\": \"string?\",\n          \"status\": \"AttendanceStatus? (only students with ≥1 record of this status)\",\n          \"format\": \"'csv'?\",\n          \"page\": \"int? (default 1, ignored for csv)\",\n          \"pageSize\": \"int? (default 20, max 100, ignored for csv)\"\n        }\n      },\n      \"responseSchema\": {\n        \"json\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" } }, \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },\n        \"csv\": \"text/csv; charset=utf-8\"\n      },\n      \"errors\": [\"VALIDATION_ERROR (range > 366 days, to < from)\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-32\", \"FR-35\", \"FR-36\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/admin/attendance/below-threshold\",\n      \"description\": \"Students whose year-to-date rate is below SchoolSettings.attendanceAlertThreshold, sorted by rate ascending. Paginated (pageSize ≤ 100). Guard: requireRole('ADMIN').\",\n      \"requestSchema\": { \"query\": { \"page\": \"int?\", \"pageSize\": \"int? (max 100)\" } },\n      \"responseSchema\": {\n        \"data\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" }, { \"href\": \"/students/<id>/attendance\" }] } },\n        \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\", \"threshold\": \"int\" }\n      },\n      \"errors\": [\"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-35\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/admin/attendance/remind\",\n      \"description\": \"Send 'attendance.register_missing' to the course teacher (notify, link /attendance/take/<courseId>?date=&periodId=), then audit('attendance.remind'). Guard: requireRole('ADMIN'). Returns 200 even if the notification fails to enqueue, because notify never throws.\",\n      \"requestSchema\": { \"body\": { \"type\": \"object\", \"required\": [\"courseId\", \"periodId\", \"date\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"periodId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } } },\n      \"responseSchema\": { \"data\": { \"reminded\": { \"$ref\": \"#/sharedSchemas/UserRef\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND (course/period)\"],\n      \"requirementIds\": [\"FR-23\", \"FR-31\", \"FR-35\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/settings/school\",\n      \"description\": \"Minimal school settings update for this PRD: only the attendance fields (FR-5 default; the user may override this). Built on updateSchoolSettings() and writes audit('school_settings.update', { old, new }). Guard: requireRole('ADMIN'). Unknown keys are rejected (strict schema) so this route cannot widen scope.\",\n      \"requestSchema\": {\n        \"body\": {\n          \"description\": \"Zod attendanceSettingsPatch (strict). At least one field.\",\n          \"type\": \"object\",\n          \"minProperties\": 1,\n          \"additionalProperties\": false,\n          \"properties\": { \"attendanceMode\": { \"$ref\": \"#/sharedSchemas/AttendanceMode\" }, \"attendanceAlertThreshold\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 } }\n        }\n      },\n      \"responseSchema\": { \"data\": { \"attendanceMode\": \"AttendanceMode\", \"attendanceAlertThreshold\": \"int\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-4\", \"FR-5\", \"NFR-8\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":452,"newStart":1,"newLines":252,"lines":[" {","-  \"ticketId\": \"SH-1\",","-  \"timestamp\": \"2026-11-05T17:40:00Z\",","+  \"ticketId\": \"SH-7\",","+  \"timestamp\": \"2026-11-06T06:45:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\",","   \"conventions\": {","-    \"basePath\": \"/api (existing project convention; no /api/v1 prefix — NFR-13 forbids renaming routes)\",","-    \"scope\": \"SH-1 adds NO new endpoints (system-design.md §1, ADR-1, NFR-13). Every contract below documents an EXISTING route that the new pages (C1–C5), shell (C7) and tests (C8, C9) call. Dev must not modify src/app/api/** or src/server/**.\",","-    \"successEnvelope\": {","-      \"data\": \"<responseSchema>\"","-    },","-    \"errorEnvelope\": {","-      \"error\": {","-        \"code\": \"string\",","-        \"message\": \"string\",","-        \"details\": \"unknown?\"","-      }","-    },","-    \"errorCodes\": {","-      \"VALIDATION_ERROR\": 400,","-      \"UNAUTHENTICATED\": 401,","-      \"FORBIDDEN\": 403,","-      \"NOT_FOUND\": 404,","-      \"CONFLICT\": 409,","-      \"INVALID_TOKEN\": 410,","-      \"RATE_LIMITED\": 429,","-      \"INTERNAL\": 500","-    },","-    \"validationErrorDetails\": \"VALIDATION_ERROR details are Zod flatten() output: { formErrors: string[], fieldErrors: { [field]: string[] } }. Service-raised policy errors use the same { fieldErrors } shape, so applyFieldErrors() handles both.\",","-    \"handlerPattern\": \"withHandler → (requireUser) → parseBody(schema from src/lib/validators/auth.ts) → services/auth.ts → ok(). All helpers in src/server/http.ts.\",","-    \"requirementIds\": [","-      \"NFR-10\",","-      \"NFR-11\",","-      \"NFR-13\"","-    ]","+    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-10 forbids renaming routes)\",","+    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (schemas from src/lib/validators/attendance.ts) → resource assert → attendance-service → ok()/paginated(). Every helper comes from src/server/http.ts (system-design §3.1).\",","+    \"successEnvelope\": { \"data\": \"<responseSchema>\" },","+    \"paginatedEnvelope\": { \"data\": \"<responseSchema>[]\", \"meta\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"total\": \"int\" } },","+    \"errorEnvelope\": { \"error\": { \"code\": \"ApiErrorCode\", \"message\": \"string\", \"details\": \"unknown?\" } },","+    \"errorCodes\": { \"VALIDATION_ERROR\": 400, \"UNAUTHENTICATED\": 401, \"FORBIDDEN\": 403, \"NOT_FOUND\": 404, \"CONFLICT\": 409, \"INTERNAL\": 500 },","+    \"validationErrorDetails\": \"A ZodError maps to VALIDATION_ERROR with details = zod flatten() { formErrors, fieldErrors }. Service-raised NFR-3 roster errors use details { invalidStudentIds: string[] } or { missingStudentIds: string[] }.\",","+    \"dates\": \"Date-only values are 'yyyy-MM-dd' strings interpreted in SchoolSettings.timezone. Timestamps are ISO 8601 UTC. Display uses formatInSchoolTz (ADR-5).\",","+    \"ids\": \"All ids are cuid strings.\",","+    \"requirementIds\": [\"FR-35\", \"FR-36\", \"NFR-7\", \"NFR-8\"]","   },","   \"sharedSchemas\": {","-    \"Email\": {","-      \"type\": \"string\",","-      \"format\": \"email\",","-      \"note\": \"trimmed and lower-cased by emailField before use\"","+    \"DateOnly\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },","+    \"AttendanceStatus\": { \"type\": \"string\", \"enum\": [\"PRESENT\", \"ABSENT\", \"LATE\", \"EXCUSED\"] },","+    \"AttendanceMode\": { \"type\": \"string\", \"enum\": [\"PER_PERIOD\", \"DAILY_HOMEROOM\", \"BOTH\"] },","+    \"RegisterKey\": {","+      \"description\": \"Zod union registerQuery (C6). Course variant or section (daily) variant; exactly one (FR-2).\",","+      \"oneOf\": [","+        { \"type\": \"object\", \"required\": [\"courseId\", \"date\", \"periodId\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" }, \"periodId\": { \"type\": \"string\" } } },","+        { \"type\": \"object\", \"required\": [\"sectionId\", \"date\"], \"properties\": { \"sectionId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } }","+      ]","     },","-    \"NewPassword\": {","-      \"type\": \"string\",","-      \"minLength\": 10,","-      \"maxLength\": 128,","-      \"note\": \"≥1 letter, ≥1 digit, ≠ user email, not in common-passwords.txt (server-side only). FR-15.\"","-    },","-    \"Ok\": {","+    \"RegisterRecordInput\": {","+      \"description\": \"Zod registerRecord (C6). minutesLate is required (1–240) iff status = LATE and forbidden otherwise (superRefine). EXCUSED is ADMIN-only, checked in the service (FR-10).\",","       \"type\": \"object\",","-      \"required\": [","-        \"ok\"","-      ],","+      \"required\": [\"studentId\", \"status\"],","       \"properties\": {","-        \"ok\": {","-          \"const\": true","-        }","+        \"studentId\": { \"type\": \"string\" },","+        \"status\": { \"$ref\": \"#/sharedSchemas/AttendanceStatus\" },","+        \"minutesLate\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 240 },","+        \"note\": { \"type\": \"string\", \"maxLength\": 500 }","       }","     },","-    \"FieldErrors\": {","+    \"UserRef\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },","+    \"Register\": {","+      \"description\": \"Returned by GET and PUT /api/attendance/register.\",","       \"type\": \"object\",","       \"properties\": {","-        \"formErrors\": {","+        \"key\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" },","+        \"header\": { \"type\": \"object\", \"properties\": { \"courseName\": { \"type\": \"string|null\" }, \"sectionName\": { \"type\": \"string\" }, \"periodName\": { \"type\": \"string|null\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } },","+        \"sessionId\": { \"type\": \"string|null\", \"description\": \"null when no register has been saved yet\" },","+        \"students\": {","           \"type\": \"array\",","-          \"items\": {","-            \"type\": \"string\"","-          }","+          \"description\": \"Roster active on the date, sorted by last name (FR-9, NFR-3)\",","+          \"items\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" }, \"avatarUrl\": { \"type\": \"string|null\" } } }","         },","-        \"fieldErrors\": {","-          \"type\": \"object\",","-          \"additionalProperties\": {","-            \"type\": \"array\",","-            \"items\": {","-              \"type\": \"string\"","-            }","-          }","-        }","+        \"records\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" }, \"description\": \"Existing records; empty for a new register (nothing preselected, FR-9)\" },","+        \"takenBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },","+        \"updatedBy\": { \"$ref\": \"#/sharedSchemas/UserRef\", \"nullable\": true },","+        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\", \"nullable\": true },","+        \"readOnly\": { \"type\": \"boolean\" },","+        \"readOnlyReason\": { \"type\": \"string|null\", \"description\": \"e.g. 'Teachers can edit registers up to 14 days after the register date' (FR-19)\" },","+        \"canExcuse\": { \"type\": \"boolean\", \"description\": \"true only for ADMIN (FR-10)\" }","       }","+    },","+    \"StatusCounts\": { \"type\": \"object\", \"properties\": { \"records\": { \"type\": \"integer\" }, \"present\": { \"type\": \"integer\" }, \"absent\": { \"type\": \"integer\" }, \"late\": { \"type\": \"integer\" }, \"excused\": { \"type\": \"integer\" }, \"rate\": { \"type\": \"number|null\", \"description\": \"(P+L+E)/records×100, 1 dp; null when records = 0 (FR-28)\" } } },","+    \"StudentSummaryRow\": {","+      \"allOf\": [","+        { \"type\": \"object\", \"properties\": { \"studentId\": { \"type\": \"string\" }, \"studentName\": { \"type\": \"string\" }, \"sectionName\": { \"type\": \"string|null\" }, \"gradeLevelName\": { \"type\": \"string|null\" } } },","+        { \"$ref\": \"#/sharedSchemas/StatusCounts\" }","+      ]","     }","   },","   \"endpoints\": [","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/auth/callback/credentials\",","-      \"description\": \"Auth.js credentials sign-in (served by /api/auth/[...nextauth]). Called ONLY through signIn('credentials', { email, password, redirect: false }) from next-auth/react, which fetches the CSRF token itself. Runs authorizeCredentials: IP rate limit (10 / 5 min), user lookup, bcrypt or DUMMY_HASH compare, status and lock checks, lockout counter, audit. Used by the existing /login (verify only), C4 post-invite sign-in, and the C9 e2e signInAs helper.\",","-      \"auth\": \"public\",","-      \"requestSchema\": {","-        \"contentType\": \"application/x-www-form-urlencoded\",","-        \"type\": \"object\",","-        \"required\": [","-          \"email\",","-          \"password\",","-          \"csrfToken\"","-        ],","-        \"properties\": {","-          \"email\": {","-            \"$ref\": \"#/sharedSchemas/Email\"","+      \"method\": \"GET\",","+      \"path\": \"/api/attendance/today\",","+      \"description\": \"The teacher's meetings for today in the school timezone (getScheduleForDate) joined with today's sessions, with the current slot flagged. Includes daily homeroom entries when attendanceMode is DAILY_HOMEROOM or BOTH. Guard: requireRole('TEACHER','ADMIN'). An ADMIN gets [] meetings plus no homeroom entries unless they are a homeroom teacher.\",","+      \"requestSchema\": { \"query\": {} },","+      \"responseSchema\": {","+        \"data\": {","+          \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" },","+          \"meetings\": {","+            \"type\": \"array\",","+            \"items\": {","+              \"kind\": \"'course'\",","+              \"courseId\": \"string\",","+              \"courseName\": \"string\",","+              \"sectionName\": \"string\",","+              \"periodId\": \"string\",","+              \"periodName\": \"string\",","+              \"startTime\": \"HH:mm\",","+              \"endTime\": \"HH:mm\",","+              \"isCurrent\": \"boolean\",","+              \"taken\": \"null | { at: ISO date-time, by: UserRef }\"","+            }","           },","-          \"password\": {","-            \"type\": \"string\",","-            \"minLength\": 1","-          },","-          \"csrfToken\": {","-            \"type\": \"string\",","-            \"note\": \"from GET /api/auth/csrf; added automatically by signIn()\"","-          },","-          \"callbackUrl\": {","-            \"type\": \"string\",","-            \"note\": \"sanitised by the redirect callback; the client also applies safeCallbackUrl()\"","+          \"dailyRegisters\": {","+            \"type\": \"array\",","+            \"items\": { \"kind\": \"'section'\", \"sectionId\": \"string\", \"sectionName\": \"string\", \"taken\": \"null | { at, by: UserRef }\" }","           }","         }","       },","-      \"responseSchema\": {","-        \"note\": \"Not the {data} envelope — Auth.js framework response. signIn(..., { redirect: false }) resolves to the object below.\",","-        \"success\": {","-          \"ok\": true,","-          \"error\": null,","-          \"sideEffects\": \"sets the HttpOnly session cookie (8h JWT); failedLoginCount=0, lastLoginAt=now; audit auth.login.success\"","-        },","-        \"failure\": {","-          \"ok\": false,","-          \"error\": \"CredentialsSignin\",","-          \"code\": {","-            \"type\": \"string\",","-            \"enum\": [","-              \"invalid\",","-              \"disabled\",","-              \"rate_limited\",","-              \"locked:<N>\"","-            ],","-            \"uiMapping\": {","-              \"locked:<N>\": \"This account is temporarily locked. Try again in N minutes.\",","-              \"disabled\": \"This account is disabled. Contact the school office.\",","-              \"rate_limited\": \"Too many attempts. Wait a few minutes and try again.\",","-              \"*\": \"Email or password is incorrect.\"","-            },","-            \"note\": \"Mapped by the existing loginErrorMessage(code) in src/app/(auth)/login/LoginForm.tsx (already handles rate_limited, R3). Each failure audits auth.login.failure { email, reason }; the 5th consecutive failure also audits auth.lockout and returns locked:15.\"","-          }","+      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-6\", \"FR-7\", \"FR-35\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/attendance/register\",","+      \"description\": \"Load a course register (?courseId=&date=&periodId=) or daily register (?sectionId=&date=). Guard: requireUser, then assertCanManageCourse or assertCanManageSection (ADMIN or homeroom teacher). Future dates → 400; TEACHER more than 14 days back → 403 for opening (canOpen). Past the edit window → readOnly = true with readOnlyReason.\",","+      \"requestSchema\": { \"query\": { \"$ref\": \"#/sharedSchemas/RegisterKey\" } },","+      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },","+      \"errors\": [\"VALIDATION_ERROR (bad key, future date)\", \"FORBIDDEN (no access, outside 14-day open window)\", \"NOT_FOUND (course/section/period)\"],","+      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-19\", \"FR-35\", \"NFR-3\", \"NFR-7\"]","+    },","+    {","+      \"method\": \"PUT\",","+      \"path\": \"/api/attendance/register\",","+      \"description\": \"Create or update the session and all records in one transaction (system-design §3.2). Records must cover the whole active roster and only roster students. After commit: audit('attendance.record.update') per changed status, and notifyStudentAndParents per transition into ABSENT/LATE or ABSENT→PRESENT (corrected). Re-saving unchanged statuses sends nothing. Idempotent: a P2002 race on the partial unique index re-reads the session rather than returning CONFLICT.\",","+      \"requestSchema\": {","+        \"body\": {","+          \"description\": \"Zod registerPutBody = RegisterKey & { records }\",","+          \"allOf\": [","+            { \"$ref\": \"#/sharedSchemas/RegisterKey\" },","+            { \"type\": \"object\", \"required\": [\"records\"], \"properties\": { \"records\": { \"type\": \"array\", \"minItems\": 1, \"uniqueBy\": \"studentId\", \"items\": { \"$ref\": \"#/sharedSchemas/RegisterRecordInput\" } } } }","+          ]","         }","       },","-      \"requirementIds\": [","-        \"FR-2\",","-        \"FR-3\",","-        \"FR-4\",","-        \"FR-5\",","-        \"FR-6\",","-        \"FR-7\",","-        \"FR-8\",","-        \"FR-9\",","-        \"NFR-2\",","-        \"NFR-3\",","-        \"NFR-4\",","-        \"NFR-14\"","-      ]","+      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Register\" } },","+      \"errors\": [","+        \"VALIDATION_ERROR (schema; future date; studentId not active on date → details.invalidStudentIds; roster not fully marked → details.missingStudentIds)\",","+        \"FORBIDDEN (no access; TEACHER past 14-day edit window; EXCUSED by non-ADMIN)\",","+        \"NOT_FOUND\"","+      ],","+      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-10\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-18\", \"FR-19\", \"FR-21\", \"FR-22\", \"FR-35\", \"FR-36\", \"NFR-1\", \"NFR-3\", \"NFR-5\", \"NFR-7\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/auth/csrf\",","-      \"description\": \"Auth.js CSRF token (served by /api/auth/[...nextauth]). Called implicitly by signIn()/signOut(). C9 signs in through the UI, so no test calls it directly.\",","-      \"auth\": \"public\",","-      \"requestSchema\": {},","+      \"path\": \"/api/students/{studentId}/attendance\",","+      \"description\": \"Student attendance tab data in one indexed query. Guard: requireUser + assertCanViewStudent (parent → linked students, student → self, teacher/admin per existing rules). Session kind follows attendanceMode (course sessions for PER_PERIOD/BOTH, section sessions for DAILY_HOMEROOM). `note` is omitted from rows for STUDENT and PARENT. from/to default to the current month; summaries always cover the current term and academic year regardless of from/to.\",","+      \"requestSchema\": { \"path\": { \"studentId\": \"string\" }, \"query\": { \"from\": \"DateOnly?\", \"to\": \"DateOnly?\" } },","       \"responseSchema\": {","-        \"type\": \"object\",","-        \"required\": [","-          \"csrfToken\"","-        ],","-        \"properties\": {","-          \"csrfToken\": {","-            \"type\": \"string\"","+        \"data\": {","+          \"summary\": { \"term\": { \"$ref\": \"#/sharedSchemas/StatusCounts\", \"termName\": \"string|null\" }, \"year\": { \"$ref\": \"#/sharedSchemas/StatusCounts\" } },","+          \"calendar\": { \"type\": \"array\", \"items\": { \"date\": \"DateOnly\", \"colour\": \"'success'|'warning'|'error'|'default'\", \"present\": \"int\", \"absent\": \"int\", \"late\": \"int\", \"excused\": \"int\" } },","+          \"records\": {","+            \"type\": \"array\",","+            \"items\": { \"id\": \"string\", \"date\": \"DateOnly\", \"periodName\": \"string|null\", \"courseName\": \"string|null\", \"sectionName\": \"string|null\", \"status\": \"AttendanceStatus\", \"minutesLate\": \"int|null\", \"note\": \"string|null (absent key for STUDENT/PARENT)\" }","           }","         }","       },","-      \"requirementIds\": [","-        \"NFR-2\"","-      ]","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-24\", \"FR-25\", \"FR-26\", \"FR-27\", \"FR-28\", \"FR-35\", \"NFR-1\", \"NFR-7\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/auth/signout\",","-      \"description\": \"Auth.js sign-out (served by /api/auth/[...nextauth]). Called only through signOut({ redirectTo: '/login' }) from the shell user menu (C7). Clears the session cookie.\",","-      \"auth\": \"session cookie (no-op if absent)\",","-      \"requestSchema\": {","-        \"contentType\": \"application/x-www-form-urlencoded\",","-        \"type\": \"object\",","-        \"required\": [","-          \"csrfToken\"","-        ],","-        \"properties\": {","-          \"csrfToken\": {","-            \"type\": \"string\"","+      \"method\": \"GET\",","+      \"path\": \"/api/courses/{courseId}/attendance\",","+      \"description\": \"Course attendance matrix: the last 20 sessions by date (columns) × enrolled students (ACTIVE, plus DROPPED students with records) with P/A/L/E cells and per-student rate. Guard: requireUser + assertCanManageCourse.\",","+      \"requestSchema\": { \"path\": { \"courseId\": \"string\" }, \"query\": {} },","+      \"responseSchema\": {","+        \"data\": {","+          \"sessions\": { \"type\": \"array\", \"items\": { \"sessionId\": \"string\", \"date\": \"DateOnly\", \"periodId\": \"string\", \"periodName\": \"string\" } },","+          \"students\": {","+            \"type\": \"array\",","+            \"items\": { \"studentId\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"enrollmentStatus\": \"'ACTIVE'|'DROPPED'\", \"cells\": \"{ [sessionId]: AttendanceStatus }\", \"rate\": \"number|null\" }","           }","         }","       },","-      \"responseSchema\": {","-        \"note\": \"Framework redirect; client navigates to /login.\"","-      },","-      \"requirementIds\": [","-        \"FR-26\",","-        \"NFR-2\"","-      ]","+      \"errors\": [\"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-28\", \"FR-29\", \"FR-35\", \"NFR-7\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/auth/forgot-password\",","-      \"description\": \"Request a password reset link (C1 /forgot-password). Always returns the same 200 body whether or not the account exists (no enumeration). IP limit 10/h → 429; per-email limit 3/h is SILENT (still 200, no token). For an ACTIVE, non-archived user: createToken(PASSWORD_RESET, 60 min), sendAuthEmail('password-reset') → EmailOutbox, audit auth.password.reset_requested. UI (C1): 2xx → success Alert with data.message; 429 → error Alert 'Too many attempts. Wait a few minutes and try again.' (IP-scoped, so it reveals nothing about the account).\",","-      \"auth\": \"public\",","-      \"requestSchema\": {","-        \"contentType\": \"application/json\",","-        \"zod\": \"forgotPasswordSchema\",","-        \"type\": \"object\",","-        \"required\": [","-          \"email\"","-        ],","-        \"properties\": {","-          \"email\": {","-            \"$ref\": \"#/sharedSchemas/Email\"","-          }","-        }","-      },","+      \"method\": \"GET\",","+      \"path\": \"/api/admin/attendance/overview\",","+      \"description\": \"Today overview: expected meetings (getSchoolScheduleForDate + homeroom sections when mode includes daily) vs taken sessions, the school-wide rate for the date, and missing registers (no session and period.startTime + 15 min ≤ now in school tz; only computed when date is today). Guard: requireRole('ADMIN').\",","+      \"requestSchema\": { \"query\": { \"date\": \"DateOnly? (default school today; future → 400)\" } },","       \"responseSchema\": {","-        \"200\": {","-          \"data\": {","-            \"message\": \"If an account exists for that email, we've sent a reset link.\"","+        \"data\": {","+          \"date\": \"DateOnly\",","+          \"expected\": \"int\",","+          \"taken\": \"int\",","+          \"rate\": \"number|null\",","+          \"missing\": {","+            \"type\": \"array\",","+            \"items\": { \"courseId\": \"string\", \"courseName\": \"string\", \"sectionName\": \"string\", \"periodId\": \"string\", \"periodName\": \"string\", \"startTime\": \"HH:mm\", \"teacher\": \"UserRef\" }","           }","-        },","-        \"400\": {","-          \"error\": {","-            \"code\": \"VALIDATION_ERROR\",","-            \"details\": {","-              \"$ref\": \"#/sharedSchemas/FieldErrors\"","-            }","-          }","-        },","-        \"429\": {","-          \"error\": {","-            \"code\": \"RATE_LIMITED\",","-            \"message\": \"Too many requests. Wait a few minutes and try again.\"","-          }","         }","       },","-      \"requirementIds\": [","-        \"FR-17\",","-        \"FR-18\",","-        \"FR-31\",","-        \"NFR-1\",","-        \"NFR-10\"","-      ]","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-30\", \"FR-31\", \"FR-35\", \"NFR-7\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/auth/reset-password\",","-      \"description\": \"Set a new password from a reset link (C2 page → C4 TokenPasswordForm mode=reset). verifyToken(PASSWORD_RESET) → policy → bcrypt 12 → transaction(consume token, set hash, passwordChangedAt=now, failedLoginCount=0, lockedUntil=null) → audit auth.password.reset. Success → router.replace('/login?reset=1'). 410 → C4 switches to the invalid-link Alert. Other sessions are revoked within 5 min through the passwordChangedAt recheck.\",","-      \"auth\": \"public (token-gated)\",","+      \"method\": \"GET\",","+      \"path\": \"/api/admin/attendance/report\",","+      \"description\": \"Per-student summary over the filtered range (groupBy studentId, status). JSON is paginated (pageSize ≤ 100). With ?format=csv returns every row as text/csv (Content-Disposition: attachment; filename=attendance-report-<from>-<to>.csv) via toCsv, with columns: Student, Section, Grade, Records, Present, Absent, Late, Excused, Rate. Guard: requireRole('ADMIN').\",","       \"requestSchema\": {","-        \"contentType\": \"application/json\",","-        \"zod\": \"resetPasswordSchema\",","-        \"type\": \"object\",","-        \"required\": [","-          \"token\",","-          \"password\",","-          \"confirm\"","-        ],","-        \"properties\": {","-          \"token\": {","-            \"type\": \"string\",","-            \"minLength\": 1,","-            \"note\": \"raw token from the URL; never logged or audited\"","-          },","-          \"password\": {","-            \"$ref\": \"#/sharedSchemas/NewPassword\"","-          },","-          \"confirm\": {","-            \"type\": \"string\",","-            \"note\": \"must equal password. Field is `confirm`, NOT `confirmPassword` (system-design C4 wording is wrong). SetPasswordForm's onSubmit(password, confirm) already uses this name.\"","-          }","+        \"query\": {","+          \"from\": \"DateOnly (required)\",","+          \"to\": \"DateOnly (required, ≥ from, range ≤ 366 days)\",","+          \"gradeLevelId\": \"string?\",","+          \"sectionId\": \"string?\",","+          \"courseId\": \"string?\",","+          \"status\": \"AttendanceStatus? (only students with ≥1 record of this status)\",","+          \"format\": \"'csv'?\",","+          \"page\": \"int? (default 1, ignored for csv)\",","+          \"pageSize\": \"int? (default 20, max 100, ignored for csv)\"","         }","       },","       \"responseSchema\": {","-        \"200\": {","-          \"data\": {","-            \"$ref\": \"#/sharedSchemas/Ok\"","-          }","-        },","-        \"400\": {","-          \"error\": {","-            \"code\": \"VALIDATION_ERROR\",","-            \"details\": {","-              \"$ref\": \"#/sharedSchemas/FieldErrors\"","-            },","-            \"note\": \"policy failures come back under fieldErrors.password (incl. 'This password is too common. Choose another.')\"","-          }","-        },","-        \"410\": {","-          \"error\": {","-            \"code\": \"INVALID_TOKEN\",","-            \"message\": \"This link is invalid or has expired.\"","-          }","-        }","+        \"json\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" } }, \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" } },","+        \"csv\": \"text/csv; charset=utf-8\"","       },","-      \"requirementIds\": [","-        \"FR-12\",","-        \"FR-15\",","-        \"FR-19\",","-        \"FR-10\",","-        \"NFR-1\",","-        \"NFR-8\",","-        \"NFR-10\"","-      ]","+      \"errors\": [\"VALIDATION_ERROR (range > 366 days, to < from)\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-32\", \"FR-35\", \"FR-36\", \"NFR-8\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/auth/accept-invite\",","-      \"description\": \"Activate an invited account (C3 page → C4 TokenPasswordForm mode=invite). verifyToken(INVITE) → policy → bcrypt 12 → transaction(consume token, set hash, status=ACTIVE, passwordChangedAt=now) → audit auth.invite.accepted. Does NOT create a session: C4 then calls signIn('credentials', { email, password, redirect: false }) and router.replace('/dashboard'). On 410 C4 renders the FR-13 copy ('This invitation link is invalid or has expired. Ask the school office to send a new one.'), not the service message.\",","-      \"auth\": \"public (token-gated)\",","-      \"requestSchema\": {","-        \"contentType\": \"application/json\",","-        \"zod\": \"acceptInviteSchema\",","-        \"type\": \"object\",","-        \"required\": [","-          \"token\",","-          \"password\",","-          \"confirm\"","-        ],","-        \"properties\": {","-          \"token\": {","-            \"type\": \"string\",","-            \"minLength\": 1","-          },","-          \"password\": {","-            \"$ref\": \"#/sharedSchemas/NewPassword\"","-          },","-          \"confirm\": {","-            \"type\": \"string\"","-          }","-        }","-      },","+      \"method\": \"GET\",","+      \"path\": \"/api/admin/attendance/below-threshold\",","+      \"description\": \"Students whose year-to-date rate is below SchoolSettings.attendanceAlertThreshold, sorted by rate ascending. Paginated (pageSize ≤ 100). Guard: requireRole('ADMIN').\",","+      \"requestSchema\": { \"query\": { \"page\": \"int?\", \"pageSize\": \"int? (max 100)\" } },","       \"responseSchema\": {","-        \"200\": {","-          \"data\": {","-            \"type\": \"object\",","-            \"required\": [","-              \"email\"","-            ],","-            \"properties\": {","-              \"email\": {","-                \"$ref\": \"#/sharedSchemas/Email\"","-              }","-            }","-          }","-        },","-        \"400\": {","-          \"error\": {","-            \"code\": \"VALIDATION_ERROR\",","-            \"details\": {","-              \"$ref\": \"#/sharedSchemas/FieldErrors\"","-            }","-          }","-        },","-        \"410\": {","-          \"error\": {","-            \"code\": \"INVALID_TOKEN\",","-            \"message\": \"This link is invalid or has expired.\"","-          }","-        }","+        \"data\": { \"type\": \"array\", \"items\": { \"allOf\": [{ \"$ref\": \"#/sharedSchemas/StudentSummaryRow\" }, { \"href\": \"/students/<id>/attendance\" }] } },","+        \"meta\": { \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\", \"threshold\": \"int\" }","       },","-      \"requirementIds\": [","-        \"FR-12\",","-        \"FR-13\",","-        \"FR-14\",","-        \"FR-15\",","-        \"NFR-1\",","-        \"NFR-8\",","-        \"NFR-10\",","-        \"NFR-14\"","-      ]","+      \"errors\": [\"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-33\", \"FR-35\", \"NFR-8\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/account/password\",","-      \"description\": \"Signed-in password change (C5 /account/security). requireUser → changePasswordSchema → bcrypt compare current → policy → update hash + passwordChangedAt → audit auth.password.changed → unstable_update({ reauth: true }) re-issues THIS session so only other sessions are revoked (within 5 min). Success → useToast 'Password updated', form reset, router.refresh().\",","-      \"auth\": \"session required (requireUser; middleware returns 401 UNAUTHENTICATED JSON without a session)\",","+      \"path\": \"/api/admin/attendance/remind\",","+      \"description\": \"Send 'attendance.register_missing' to the course teacher (notify, link /attendance/take/<courseId>?date=&periodId=), then audit('attendance.remind'). Guard: requireRole('ADMIN'). Returns 200 even if the notification fails to enqueue, because notify never throws.\",","+      \"requestSchema\": { \"body\": { \"type\": \"object\", \"required\": [\"courseId\", \"periodId\", \"date\"], \"properties\": { \"courseId\": { \"type\": \"string\" }, \"periodId\": { \"type\": \"string\" }, \"date\": { \"$ref\": \"#/sharedSchemas/DateOnly\" } } } },","+      \"responseSchema\": { \"data\": { \"reminded\": { \"$ref\": \"#/sharedSchemas/UserRef\" } } },","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\", \"NOT_FOUND (course/period)\"],","+      \"requirementIds\": [\"FR-23\", \"FR-31\", \"FR-35\"]","+    },","+    {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/settings/school\",","+      \"description\": \"Minimal school settings update for this PRD: only the attendance fields (FR-5 default; the user may override this). Built on updateSchoolSettings() and writes audit('school_settings.update', { old, new }). Guard: requireRole('ADMIN'). Unknown keys are rejected (strict schema) so this route cannot widen scope.\",","       \"requestSchema\": {","-        \"contentType\": \"application/json\",","-        \"zod\": \"changePasswordSchema\",","-        \"type\": \"object\",","-        \"required\": [","-          \"currentPassword\",","-          \"newPassword\",","-          \"confirm\"","-        ],","-        \"properties\": {","-          \"currentPassword\": {","-            \"type\": \"string\",","-            \"minLength\": 1","-          },","-          \"newPassword\": {","-            \"$ref\": \"#/sharedSchemas/NewPassword\"","-          },","-          \"confirm\": {","-            \"type\": \"string\"","-          }","+        \"body\": {","+          \"description\": \"Zod attendanceSettingsPatch (strict). At least one field.\",","+          \"type\": \"object\",","+          \"minProperties\": 1,","+          \"additionalProperties\": false,","+          \"properties\": { \"attendanceMode\": { \"$ref\": \"#/sharedSchemas/AttendanceMode\" }, \"attendanceAlertThreshold\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 } }","         }","       },","-      \"responseSchema\": {","-        \"200\": {","-          \"data\": {","-            \"$ref\": \"#/sharedSchemas/Ok\"","-          }","-        },","-        \"400\": {","-          \"error\": {","-            \"code\": \"VALIDATION_ERROR\",","-            \"details\": {","-              \"$ref\": \"#/sharedSchemas/FieldErrors\"","-            }","-          },","-          \"cases\": {","-            \"wrongCurrent\": \"{ message: 'Current password is incorrect.', details: { fieldErrors: { currentPassword: ['Current password is incorrect.'] } } }\",","-            \"policyFailure\": \"details.fieldErrors.password (NOT newPassword): assertPasswordAllowed (src/server/auth/password-policy.ts) hard-codes the `password` key. ChangePasswordForm must remap password → newPassword before applyFieldErrors(), or the error renders nowhere. Client-side Zod already catches every rule except common-password, so in practice this case only appears for common passwords.\"","-          }","-        },","-        \"401\": {","-          \"error\": {","-            \"code\": \"UNAUTHENTICATED\"","-          }","-        }","-      },","-      \"requirementIds\": [","-        \"FR-10\",","-        \"FR-15\",","-        \"FR-20\",","-        \"FR-23\",","-        \"NFR-9\",","-        \"NFR-10\",","-        \"NFR-11\"","-      ]","+      \"responseSchema\": { \"data\": { \"attendanceMode\": \"AttendanceMode\", \"attendanceAlertThreshold\": \"int\" } },","+      \"errors\": [\"VALIDATION_ERROR\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-4\", \"FR-5\", \"NFR-8\"]","     }","   ],","-  \"unauthenticatedBehaviour\": {","-    \"description\": \"middleware.ts (existing): unauthenticated /api/* requests other than /api/health, /api/auth/* and public-routes.ts paths return 401 { error: { code: 'UNAUTHENTICATED' } }; unauthenticated (app) page requests redirect to /login?callbackUrl=<path>.\",","-    \"requirementIds\": [","-      \"FR-11\",","-      \"NFR-9\"","-    ]","-  },","-  \"designCorrections\": [","-    \"system-design.md C4 posts `confirmPassword`; the real field is `confirm` (resetPasswordSchema / acceptInviteSchema / changePasswordSchema in src/lib/validators/auth.ts). Body is { token, password, confirm }.\",","-    \"system-design.md C5 doesn't cover common-password errors on /api/account/password: they arrive under fieldErrors.password and must be remapped to newPassword in ChangePasswordForm. Fix it on the client, not in the service (NFR-13).\",","-    \"system-design.md R2 is confirmed: INVALID_TOKEN → HTTP 410 (src/server/http.ts). It is not in the NFR-10 list; it is kept as-is.\"","-  ],","   \"status\": \"complete\""," }"]}],"originalFile":"{\n  \"ticketId\": \"SH-1\",\n  \"timestamp\": \"2026-11-05T17:40:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention; no /api/v1 prefix — NFR-13 forbids renaming routes)\",\n    \"scope\": \"SH-1 adds NO new endpoints (system-design.md §1, ADR-1, NFR-13). Every contract below documents an EXISTING route that the new pages (C1–C5), shell (C7) and tests (C8, C9) call. Dev must not modify src/app/api/** or src/server/**.\",\n    \"successEnvelope\": {\n      \"data\": \"<responseSchema>\"\n    },\n    \"errorEnvelope\": {\n      \"error\": {\n        \"code\": \"string\",\n        \"message\": \"string\",\n        \"details\": \"unknown?\"\n      }\n    },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409,\n      \"INVALID_TOKEN\": 410,\n      \"RATE_LIMITED\": 429,\n      \"INTERNAL\": 500\n    },\n    \"validationErrorDetails\": \"VALIDATION_ERROR details are Zod flatten() output: { formErrors: string[], fieldErrors: { [field]: string[] } }. Service-raised policy errors use the same { fieldErrors } shape, so applyFieldErrors() handles both.\",\n    \"handlerPattern\": \"withHandler → (requireUser) → parseBody(schema from src/lib/validators/auth.ts) → services/auth.ts → ok(). All helpers in src/server/http.ts.\",\n    \"requirementIds\": [\n      \"NFR-10\",\n      \"NFR-11\",\n      \"NFR-13\"\n    ]\n  },\n  \"sharedSchemas\": {\n    \"Email\": {\n      \"type\": \"string\",\n      \"format\": \"email\",\n      \"note\": \"trimmed and lower-cased by emailField before use\"\n    },\n    \"NewPassword\": {\n      \"type\": \"string\",\n      \"minLength\": 10,\n      \"maxLength\": 128,\n      \"note\": \"≥1 letter, ≥1 digit, ≠ user email, not in common-passwords.txt (server-side only). FR-15.\"\n    },\n    \"Ok\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"ok\"\n      ],\n      \"properties\": {\n        \"ok\": {\n          \"const\": true\n        }\n      }\n    },\n    \"FieldErrors\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"formErrors\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"fieldErrors\": {\n          \"type\": \"object\",\n          \"additionalProperties\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"endpoints\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/callback/credentials\",\n      \"description\": \"Auth.js credentials sign-in (served by /api/auth/[...nextauth]). Called ONLY through signIn('credentials', { email, password, redirect: false }) from next-auth/react, which fetches the CSRF token itself. Runs authorizeCredentials: IP rate limit (10 / 5 min), user lookup, bcrypt or DUMMY_HASH compare, status and lock checks, lockout counter, audit. Used by the existing /login (verify only), C4 post-invite sign-in, and the C9 e2e signInAs helper.\",\n      \"auth\": \"public\",\n      \"requestSchema\": {\n        \"contentType\": \"application/x-www-form-urlencoded\",\n        \"type\": \"object\",\n        \"required\": [\n          \"email\",\n          \"password\",\n          \"csrfToken\"\n        ],\n        \"properties\": {\n          \"email\": {\n            \"$ref\": \"#/sharedSchemas/Email\"\n          },\n          \"password\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"csrfToken\": {\n            \"type\": \"string\",\n            \"note\": \"from GET /api/auth/csrf; added automatically by signIn()\"\n          },\n          \"callbackUrl\": {\n            \"type\": \"string\",\n            \"note\": \"sanitised by the redirect callback; the client also applies safeCallbackUrl()\"\n          }\n        }\n      },\n      \"responseSchema\": {\n        \"note\": \"Not the {data} envelope — Auth.js framework response. signIn(..., { redirect: false }) resolves to the object below.\",\n        \"success\": {\n          \"ok\": true,\n          \"error\": null,\n          \"sideEffects\": \"sets the HttpOnly session cookie (8h JWT); failedLoginCount=0, lastLoginAt=now; audit auth.login.success\"\n        },\n        \"failure\": {\n          \"ok\": false,\n          \"error\": \"CredentialsSignin\",\n          \"code\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"invalid\",\n              \"disabled\",\n              \"rate_limited\",\n              \"locked:<N>\"\n            ],\n            \"uiMapping\": {\n              \"locked:<N>\": \"This account is temporarily locked. Try again in N minutes.\",\n              \"disabled\": \"This account is disabled. Contact the school office.\",\n              \"rate_limited\": \"Too many attempts. Wait a few minutes and try again.\",\n              \"*\": \"Email or password is incorrect.\"\n            },\n            \"note\": \"Mapped by the existing loginErrorMessage(code) in src/app/(auth)/login/LoginForm.tsx (already handles rate_limited, R3). Each failure audits auth.login.failure { email, reason }; the 5th consecutive failure also audits auth.lockout and returns locked:15.\"\n          }\n        }\n      },\n      \"requirementIds\": [\n        \"FR-2\",\n        \"FR-3\",\n        \"FR-4\",\n        \"FR-5\",\n        \"FR-6\",\n        \"FR-7\",\n        \"FR-8\",\n        \"FR-9\",\n        \"NFR-2\",\n        \"NFR-3\",\n        \"NFR-4\",\n        \"NFR-14\"\n      ]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/auth/csrf\",\n      \"description\": \"Auth.js CSRF token (served by /api/auth/[...nextauth]). Called implicitly by signIn()/signOut(). C9 signs in through the UI, so no test calls it directly.\",\n      \"auth\": \"public\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"csrfToken\"\n        ],\n        \"properties\": {\n          \"csrfToken\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"requirementIds\": [\n        \"NFR-2\"\n      ]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/signout\",\n      \"description\": \"Auth.js sign-out (served by /api/auth/[...nextauth]). Called only through signOut({ redirectTo: '/login' }) from the shell user menu (C7). Clears the session cookie.\",\n      \"auth\": \"session cookie (no-op if absent)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/x-www-form-urlencoded\",\n        \"type\": \"object\",\n        \"required\": [\n          \"csrfToken\"\n        ],\n        \"properties\": {\n          \"csrfToken\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"responseSchema\": {\n        \"note\": \"Framework redirect; client navigates to /login.\"\n      },\n      \"requirementIds\": [\n        \"FR-26\",\n        \"NFR-2\"\n      ]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/forgot-password\",\n      \"description\": \"Request a password reset link (C1 /forgot-password). Always returns the same 200 body whether or not the account exists (no enumeration). IP limit 10/h → 429; per-email limit 3/h is SILENT (still 200, no token). For an ACTIVE, non-archived user: createToken(PASSWORD_RESET, 60 min), sendAuthEmail('password-reset') → EmailOutbox, audit auth.password.reset_requested. UI (C1): 2xx → success Alert with data.message; 429 → error Alert 'Too many attempts. Wait a few minutes and try again.' (IP-scoped, so it reveals nothing about the account).\",\n      \"auth\": \"public\",\n      \"requestSchema\": {\n        \"contentType\": \"application/json\",\n        \"zod\": \"forgotPasswordSchema\",\n        \"type\": \"object\",\n        \"required\": [\n          \"email\"\n        ],\n        \"properties\": {\n          \"email\": {\n            \"$ref\": \"#/sharedSchemas/Email\"\n          }\n        }\n      },\n      \"responseSchema\": {\n        \"200\": {\n          \"data\": {\n            \"message\": \"If an account exists for that email, we've sent a reset link.\"\n          }\n        },\n        \"400\": {\n          \"error\": {\n            \"code\": \"VALIDATION_ERROR\",\n            \"details\": {\n              \"$ref\": \"#/sharedSchemas/FieldErrors\"\n            }\n          }\n        },\n        \"429\": {\n          \"error\": {\n            \"code\": \"RATE_LIMITED\",\n            \"message\": \"Too many requests. Wait a few minutes and try again.\"\n          }\n        }\n      },\n      \"requirementIds\": [\n        \"FR-17\",\n        \"FR-18\",\n        \"FR-31\",\n        \"NFR-1\",\n        \"NFR-10\"\n      ]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/reset-password\",\n      \"description\": \"Set a new password from a reset link (C2 page → C4 TokenPasswordForm mode=reset). verifyToken(PASSWORD_RESET) → policy → bcrypt 12 → transaction(consume token, set hash, passwordChangedAt=now, failedLoginCount=0, lockedUntil=null) → audit auth.password.reset. Success → router.replace('/login?reset=1'). 410 → C4 switches to the invalid-link Alert. Other sessions are revoked within 5 min through the passwordChangedAt recheck.\",\n      \"auth\": \"public (token-gated)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/json\",\n        \"zod\": \"resetPasswordSchema\",\n        \"type\": \"object\",\n        \"required\": [\n          \"token\",\n          \"password\",\n          \"confirm\"\n        ],\n        \"properties\": {\n          \"token\": {\n            \"type\": \"string\",\n            \"minLength\": 1,\n            \"note\": \"raw token from the URL; never logged or audited\"\n          },\n          \"password\": {\n            \"$ref\": \"#/sharedSchemas/NewPassword\"\n          },\n          \"confirm\": {\n            \"type\": \"string\",\n            \"note\": \"must equal password. Field is `confirm`, NOT `confirmPassword` (system-design C4 wording is wrong). SetPasswordForm's onSubmit(password, confirm) already uses this name.\"\n          }\n        }\n      },\n      \"responseSchema\": {\n        \"200\": {\n          \"data\": {\n            \"$ref\": \"#/sharedSchemas/Ok\"\n          }\n        },\n        \"400\": {\n          \"error\": {\n            \"code\": \"VALIDATION_ERROR\",\n            \"details\": {\n              \"$ref\": \"#/sharedSchemas/FieldErrors\"\n            },\n            \"note\": \"policy failures come back under fieldErrors.password (incl. 'This password is too common. Choose another.')\"\n          }\n        },\n        \"410\": {\n          \"error\": {\n            \"code\": \"INVALID_TOKEN\",\n            \"message\": \"This link is invalid or has expired.\"\n          }\n        }\n      },\n      \"requirementIds\": [\n        \"FR-12\",\n        \"FR-15\",\n        \"FR-19\",\n        \"FR-10\",\n        \"NFR-1\",\n        \"NFR-8\",\n        \"NFR-10\"\n      ]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/accept-invite\",\n      \"description\": \"Activate an invited account (C3 page → C4 TokenPasswordForm mode=invite). verifyToken(INVITE) → policy → bcrypt 12 → transaction(consume token, set hash, status=ACTIVE, passwordChangedAt=now) → audit auth.invite.accepted. Does NOT create a session: C4 then calls signIn('credentials', { email, password, redirect: false }) and router.replace('/dashboard'). On 410 C4 renders the FR-13 copy ('This invitation link is invalid or has expired. Ask the school office to send a new one.'), not the service message.\",\n      \"auth\": \"public (token-gated)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/json\",\n        \"zod\": \"acceptInviteSchema\",\n        \"type\": \"object\",\n        \"required\": [\n          \"token\",\n          \"password\",\n          \"confirm\"\n        ],\n        \"properties\": {\n          \"token\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"password\": {\n            \"$ref\": \"#/sharedSchemas/NewPassword\"\n          },\n          \"confirm\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"responseSchema\": {\n        \"200\": {\n          \"data\": {\n            \"type\": \"object\",\n            \"required\": [\n              \"email\"\n            ],\n            \"properties\": {\n              \"email\": {\n                \"$ref\": \"#/sharedSchemas/Email\"\n              }\n            }\n          }\n        },\n        \"400\": {\n          \"error\": {\n            \"code\": \"VALIDATION_ERROR\",\n            \"details\": {\n              \"$ref\": \"#/sharedSchemas/FieldErrors\"\n            }\n          }\n        },\n        \"410\": {\n          \"error\": {\n            \"code\": \"INVALID_TOKEN\",\n            \"message\": \"This link is invalid or has expired.\"\n          }\n        }\n      },\n      \"requirementIds\": [\n        \"FR-12\",\n        \"FR-13\",\n        \"FR-14\",\n        \"FR-15\",\n        \"NFR-1\",\n        \"NFR-8\",\n        \"NFR-10\",\n        \"NFR-14\"\n      ]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/account/password\",\n      \"description\": \"Signed-in password change (C5 /account/security). requireUser → changePasswordSchema → bcrypt compare current → policy → update hash + passwordChangedAt → audit auth.password.changed → unstable_update({ reauth: true }) re-issues THIS session so only other sessions are revoked (within 5 min). Success → useToast 'Password updated', form reset, router.refresh().\",\n      \"auth\": \"session required (requireUser; middleware returns 401 UNAUTHENTICATED JSON without a session)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/json\",\n        \"zod\": \"changePasswordSchema\",\n        \"type\": \"object\",\n        \"required\": [\n          \"currentPassword\",\n          \"newPassword\",\n          \"confirm\"\n        ],\n        \"properties\": {\n          \"currentPassword\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"newPassword\": {\n            \"$ref\": \"#/sharedSchemas/NewPassword\"\n          },\n          \"confirm\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"responseSchema\": {\n        \"200\": {\n          \"data\": {\n            \"$ref\": \"#/sharedSchemas/Ok\"\n          }\n        },\n        \"400\": {\n          \"error\": {\n            \"code\": \"VALIDATION_ERROR\",\n            \"details\": {\n              \"$ref\": \"#/sharedSchemas/FieldErrors\"\n            }\n          },\n          \"cases\": {\n            \"wrongCurrent\": \"{ message: 'Current password is incorrect.', details: { fieldErrors: { currentPassword: ['Current password is incorrect.'] } } }\",\n            \"policyFailure\": \"details.fieldErrors.password (NOT newPassword): assertPasswordAllowed (src/server/auth/password-policy.ts) hard-codes the `password` key. ChangePasswordForm must remap password → newPassword before applyFieldErrors(), or the error renders nowhere. Client-side Zod already catches every rule except common-password, so in practice this case only appears for common passwords.\"\n          }\n        },\n        \"401\": {\n          \"error\": {\n            \"code\": \"UNAUTHENTICATED\"\n          }\n        }\n      },\n      \"requirementIds\": [\n        \"FR-10\",\n        \"FR-15\",\n        \"FR-20\",\n        \"FR-23\",\n        \"NFR-9\",\n        \"NFR-10\",\n        \"NFR-11\"\n      ]\n    }\n  ],\n  \"unauthenticatedBehaviour\": {\n    \"description\": \"middleware.ts (existing): unauthenticated /api/* requests other than /api/health, /api/auth/* and public-routes.ts paths return 401 { error: { code: 'UNAUTHENTICATED' } }; unauthenticated (app) page requests redirect to /login?callbackUrl=<path>.\",\n    \"requirementIds\": [\n      \"FR-11\",\n      \"NFR-9\"\n    ]\n  },\n  \"designCorrections\": [\n    \"system-design.md C4 posts `confirmPassword`; the real field is `confirm` (resetPasswordSchema / acceptInviteSchema / changePasswordSchema in src/lib/validators/auth.ts). Body is { token, password, confirm }.\",\n    \"system-design.md C5 doesn't cover common-password errors on /api/account/password: they arrive under fieldErrors.password and must be remapped to newPassword in ChangePasswordForm. Fix it on the client, not in the service (NFR-13).\",\n    \"system-design.md R2 is confirmed: INVALID_TOKEN → HTTP 410 (src/server/http.ts). It is not in the NFR-10 list; it is kept as-is.\"\n  ],\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_018hoQDx8r7Cvdqu5M54e3dL","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
