haredSchemas/FieldErrors\" } } },\n        \"429\": { \"error\": { \"code\": \"RATE_LIMITED\", \"message\": \"Too many requests. Wait a few minutes and try again.\" } }\n      },\n      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-31\", \"NFR-1\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/reset-password\",\n      \"description\": \"Set a new password from a reset link (C3 /reset-password/[token]). verifyToken(PASSWORD_RESET) → policy → bcrypt 12 → transaction(consume token, set hash, passwordChangedAt=now, failedLoginCount=0, lockedUntil=null) → audit auth.password.reset. Success → UI goes to /login?reset=1. Other sessions are revoked within 5 min through the passwordChangedAt recheck.\",\n      \"auth\": \"public (token-gated)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/json\",\n        \"zod\": \"resetPasswordSchema\",\n        \"type\": \"object\",\n        \"required\": [\"token\", \"password\", \"confirm\"],\n        \"properties\": {\n          \"token\": { \"type\": \"string\", \"minLength\": 1, \"note\": \"raw token from the URL; never logged or audited\" },\n          \"password\": { \"$ref\": \"#/sharedSchemas/NewPassword\" },\n          \"confirm\": { \"type\": \"string\", \"note\": \"must equal password. Field is `confirm`, NOT `confirmPassword` (system-design C3 wording is wrong).\" }\n        }\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"$ref\": \"#/sharedSchemas/Ok\" } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"$ref\": \"#/sharedSchemas/FieldErrors\" }, \"note\": \"policy failures come back under fieldErrors.password (incl. 'This password is too common. Choose another.')\" } },\n        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This link is invalid or has expired.\" } }\n      },\n      \"requirementIds\": [\"FR-12\", \"FR-15\", \"FR-19\", \"FR-10\", \"NFR-1\", \"NFR-8\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/accept-invite\",\n      \"description\": \"Activate an invited account (C4 /invite/[token]). verifyToken(INVITE) → policy → bcrypt 12 → transaction(consume token, set hash, status=ACTIVE, passwordChangedAt=now) → audit auth.invite.accepted. Does NOT create a session: the client then calls signIn('credentials') with the returned email and the password just set, and goes to /dashboard. On 410 the PAGE renders the FR-13 copy ('This invitation link is invalid or has expired. Ask the school office to send a new one.'), not the service message.\",\n      \"auth\": \"public (token-gated)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/json\",\n        \"zod\": \"acceptInviteSchema\",\n        \"type\": \"object\",\n        \"required\": [\"token\", \"password\", \"confirm\"],\n        \"properties\": {\n          \"token\": { \"type\": \"string\", \"minLength\": 1 },\n          \"password\": { \"$ref\": \"#/sharedSchemas/NewPassword\" },\n          \"confirm\": { \"type\": \"string\" }\n        }\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"type\": \"object\", \"required\": [\"email\"], \"properties\": { \"email\": { \"$ref\": \"#/sharedSchemas/Email\" } } } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"$ref\": \"#/sharedSchemas/FieldErrors\" } } },\n        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This link is invalid or has expired.\" } }\n      },\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"NFR-1\", \"NFR-8\", \"NFR-10\", \"NFR-14\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/account/password\",\n      \"description\": \"Signed-in password change (C5 /account/security). requireUser → changePasswordSchema → bcrypt compare current → policy → update hash + passwordChangedAt → audit auth.password.changed → unstable_update({ reauth: true }) re-issues THIS session so only other sessions are revoked (within 5 min). Success → useToast 'Password updated'.\",\n      \"auth\": \"session required (requireUser; middleware returns 401 UNAUTHENTICATED JSON without a session)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/json\",\n        \"zod\": \"changePasswordSchema\",\n        \"type\": \"object\",\n        \"required\": [\"currentPassword\", \"newPassword\", \"confirm\"],\n        \"properties\": {\n          \"currentPassword\": { \"type\": \"string\", \"minLength\": 1 },\n          \"newPassword\": { \"$ref\": \"#/sharedSchemas/NewPassword\" },\n          \"confirm\": { \"type\": \"string\" }\n        }\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"$ref\": \"#/sharedSchemas/Ok\" } },\n        \"400\": {\n          \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"$ref\": \"#/sharedSchemas/FieldErrors\" } },\n          \"cases\": {\n            \"wrongCurrent\": \"{ message: 'Current password is incorrect.', details: { fieldErrors: { currentPassword: ['Current password is incorrect.'] } } }\",\n            \"policyFailure\": \"details.fieldErrors.password (NOT newPassword) — assertPasswordAllowed hard-codes the `password` key. ChangePasswordForm must remap password → newPassword before applyFieldErrors(), or the error renders nowhere. Client-side Zod already catches all rules except common-password, so this case only appears for common passwords.\"\n          }\n        },\n        \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" } }\n      },\n      \"requirementIds\": [\"FR-10\", \"FR-15\", \"FR-20\", \"FR-23\", \"NFR-9\", \"NFR-10\", \"NFR-11\"]\n    }\n  ],\n\n  \"unauthenticatedBehaviour\": {\n    \"description\": \"middleware.ts (existing): unauthenticated /api/* requests other than /api/health, /api/auth/* and public-routes.ts paths return 401 { error: { code: 'UNAUTHENTICATED' } }; unauthenticated (app) page requests redirect to /login?callbackUrl=<path>.\",\n    \"requirementIds\": [\"FR-11\", \"NFR-9\"]\n  },\n\n  \"designCorrections\": [\n    \"system-design.md C3 posts `confirmPassword`; the real field is `confirm` (resetPasswordSchema / acceptInviteSchema / changePasswordSchema).\",\n    \"system-design.md R3 says INVALID_TOKEN is 400; src/server/http.ts maps it to 410.\",\n    \"system-design.md C5 doesn't cover common-password errors on /api/account/password: they arrive under fieldErrors.password and must be remapped to newPassword on the client. Fix this in ChangePasswordForm, not in the service (NFR-13).\"\n  ],\n\n  \"status\": \"complete\"\n}\nsrc/app/api/account:\npassword\n\nsrc/app/api/auth:\n[...nextauth]\naccept-invite\nforgot-password\nreset-password\n=== src/app/api/auth/[...nextauth]/route.ts\nimport { handlers } from '@/server/auth/auth';\n\nexport const { GET, POST } = handlers;\n=== src/app/api/auth/forgot-password/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { forgotPasswordSchema } from '@/lib/validators/auth';\nimport { requestPasswordReset } from '@/server/services/auth';\n\n/** POST /api/auth/forgot-password — public; always the same 200 body, 429 per IP (FR-19). */\nexport const POST = withHandler(async (request: Request) => {\n  const body = await parseBody(request, forgotPasswordSchema);\n  return ok(await requestPasswordReset(body, request));\n});\n=== src/app/api/auth/reset-password/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { resetPasswordSchema } from '@/lib/validators/auth';\nimport { resetPassword } from '@/server/services/auth';\n\n/** POST /api/auth/reset-password — public; 410 for an invalid/expired/used token (FR-21). */\nexport const POST = withHandler(async (request: Request) => {\n  const body = await parseBody(request, resetPasswordSchema);\n  return ok(await resetPassword(body, request));\n});\n=== src/app/api/auth/accept-invite/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { acceptInviteSchema } from '@/lib/validators/auth';\nimport { acceptInvite } from '@/server/services/auth';\n\n/** POST /api/auth/accept-invite — public; activates an invited account (FR-16). */\nexport const POST = withHandler(async (request: Request) => {\n  const body = await parseBody(request, acceptInviteSchema);\n  return ok(await acceptInvite(body, request));\n});\n=== src/app/api/account/password/route.ts\nimport { ok, parseBody, withHandler } from '@/server/http';\nimport { requireUser } from '@/server/auth/requireRole';\nimport { changePasswordSchema } from '@/lib/validators/auth';\nimport { changePassword } from '@/server/services/auth';\nimport { unstable_update } from '@/server/auth/auth';\n\n/** POST /api/account/password — signed-in password change (FR-23). */\nexport const POST = withHandler(async (request: Request) => {\n  const user = await requireUser();\n  const body = await parseBody(request, changePasswordSchema);\n  await changePassword(user, body, request);\n  // Move this session's authTime past passwordChangedAt so only *other* sessions are revoked.\n  await unstable_update({ reauth: true } as Parameters<typeof unstable_update>[0]);\n  return ok({ ok: true });\n});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01UGe3NcmFE9u8nybdbZ7vsn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
