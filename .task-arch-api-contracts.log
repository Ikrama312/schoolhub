: string) =>\n59:  `Rubric totals ${sum} points but the assignment is worth ${maxPoints}.`;\n67:  maxPoints: decimal(0, 1000, 'Max points'),\n72:  latePenaltyPercentPerDay: decimal(0, 100, 'Penalty per day').default(0),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LPkpEeXwPWqmacFuY4rXmA","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
