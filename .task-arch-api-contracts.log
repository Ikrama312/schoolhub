{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HkuTutRz227n64vPyXvKge","type":"tool_result","content":"1\tgenerator client {\n2\t  provider = \"prisma-client-js\"\n3\t}\n4\t\n5\tdatasource db {\n6\t  provider = \"postgresql\"\n7\t  url      = env(\"DATABASE_URL\")\n8\t}\n9\t\n10\tenum Role {\n11\t  ADMIN\n12\t  TEACHER\n13\t  STUDENT\n14\t  PARENT\n15\t}\n16\t\n17\tenum UserStatus {\n18\t  ACTIVE\n19\t  INVITED\n20\t  DISABLED\n21\t  ARCHIVED\n22\t}\n23\t\n24\tenum AuthTokenType {\n25\t  INVITE\n26\t  PASSWORD_RESET\n27\t}\n28\t\n29\t/// Every authenticated person. passwordHash is nullable because an INVITED\n30\t/// user has no password until they accept their invite (TASK-8's\n31\t/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n32\tmodel User {\n33\t  id                String      @id @default(cuid())\n34\t  email             String      @unique\n35\t  passwordHash      String?\n36\t  firstName         String\n37\t  lastName          String\n38\t  role              Role\n39\t  status            UserStatus  @default(INVITED)\n40\t  failedLoginCount  Int         @default(0)\n41\t  lockedUntil       DateTime?\n42\t  lastLoginAt       DateTime?\n43\t  passwordChangedAt DateTime?\n44\t  createdAt         DateTime    @default(now())\n45\t  updatedAt         DateTime    @updatedAt\n46\t  authTokens        AuthToken[]\n47\t  auditLogs         AuditLog[]\n48\t}\n49\t\n50\t/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n51\t/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n52\t/// user. One shared shape for both token types; src/server/auth/tokens.ts\n53\t/// is the single producer/consumer.\n54\tmodel AuthToken {\n55\t  id        String        @id @default(cuid())\n56\t  userId    String\n57\t  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n58\t  type      AuthTokenType\n59\t  tokenHash String        @unique\n60\t  expiresAt DateTime\n61\t  usedAt    DateTime?\n62\t  createdAt DateTime      @default(now())\n63\t\n64\t  @@index([userId, type])\n65\t}\n66\t\n67\t/// Insert-only audit trail written exclusively through src/server/audit.ts's\n68\t/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n69\t/// non-existent email can still be recorded.\n70\tmodel AuditLog {\n71\t  id         String   @id @default(cuid())\n72\t  actorId    String?\n73\t  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n74\t  action     String\n75\t  entityType String?\n76\t  entityId   String?\n77\t  metadata   Json?\n78\t  ip         String?\n79\t  createdAt  DateTime @default(now())\n80\t\n81\t  @@index([actorId])\n82\t  @@index([action])\n83\t}\n84\t\n85\t/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n86\t/// info. Later PRDs read this for top-bar branding and public footer; no\n87\t/// other PRD should add a second row or a second settings model.\n88\tmodel SchoolSettings {\n89\t  id           String   @id @default(\"singleton\")\n90\t  name         String   @default(\"SchoolHub Academy\")\n91\t  shortName    String   @default(\"SchoolHub\")\n92\t  logoUrl      String?\n93\t  timezone     String   @default(\"UTC\")\n94\t  addressLine1 String?\n95\t  addressLine2 String?\n96\t  city         String?\n97\t  country      String?\n98\t  phone        String?\n99\t  email        String?\n100\t  website      String?\n101\t  createdAt    DateTime @default(now())\n102\t  updatedAt    DateTime @updatedAt\n103\t}\n104\t\n105\t/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n106\t/// at a time -- enforced in src/server/services/academicYears.ts's\n107\t/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n108\t/// express \"exactly one true\" as a simple unique index).\n109\tmodel AcademicYear {\n110\t  id        String   @id @default(cuid())"}]},"parent_tool_use_id":null,"session_id":"744674dc-d209-4d85-a196-0650535a8eff","uuid":"9ac450dd-42a2-47bc-9ed5-fb267f13d37d","timestamp":"2026-10-19T09:15:14.711Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/prisma/schema.prisma","content":"generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())","numLines":110,"startLine":1,"totalLines":175}}}
