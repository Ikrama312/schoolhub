{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019YCNH2yJo6up8c28Q3YpVV","type":"tool_result","content":"1\t{\n2\t  \"ticketId\": \"abcd-03\",\n3\t  \"timestamp\": \"2026-10-19T14:20:00Z\",\n4\t  \"phase\": \"architect\",\n5\t  \"version\": \"1.0\",\n6\t\n7\t  \"note\": \"Derived from system-design.md's Component Breakdown/Data Flow (abcd-03) and the source PRD's explicit API table (03-user-management.md, section 'API'), which fully specifies method/path/role/body for all 18 endpoints. Two items carried forward from system-design.md's Status section, unresolved by this sub-task because they are sequencing/confirmation items for dev-planning, not contract-shape questions: (1) FR-31 is MEDIUM confidence — the unlock contract below assumes it clears exactly lockedUntil/failedLoginCount per prisma/schema.prisma, confirm before implementation; (2) POST /api/users/:id/invite and the session-level effect of POST /api/users/:id/status are written against src/server/services/users.ts's sendInvite(userId) and PRD-01's session/status re-check, neither of which exists in src/ yet (only their schema does) — see handoff-to-dev-planning.json blockers.\",\n8\t\n9\t  \"conventions\": {\n10\t    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n11\t    \"listEnvelope\": { \"data\": \"[...]\", \"page\": 1, \"pageSize\": 20, \"total\": 0 },\n12\t    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n13\t    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\"],\n14\t    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100)\",\n15\t    \"sorting\": \"?sort=field&order=asc|desc\",\n16\t    \"search\": \"?q=\",\n17\t    \"auth\": \"Per-endpoint role gate shown in each entry's description, enforced server-side via requireRole()/assertCanViewStudent (never UI-only). Student-scoped reads additionally run assertCanViewStudent, which throws FORBIDDEN or NOT_FOUND (for STUDENT/PARENT callers, to avoid revealing existence) rather than a blanket 403.\",\n18\t    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action user.<verb> (e.g. user.created, user.status_changed, user.archived, user.unlocked, user.imported, parent_link.created, parent_link.removed).\",\n19\t    \"privacy\": \"medicalNotes is stripped server-side (never UI-only) from every response reachable by STUDENT/PARENT roles and from every CSV export row (NFR-1).\"\n20\t  },\n21\t\n22\t  \"endpoints\": [\n23\t    {\n24\t      \"method\": \"GET\",\n25\t      \"path\": \"/api/users\",\n26\t      \"description\": \"ADMIN only. Paginated, filtered user list backed by the (lastName, firstName, email) index.\",\n27\t      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean? (default false)\", \"page\": \"int?\", \"pageSize\": \"int?\" },\n28\t      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"gradeLevelId\": \"string|null\", \"gradeLevelName\": \"string|null\", \"lastLoginAt\": \"datetime|null\", \"lockedUntil\": \"datetime|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },\n29\t      \"requirementIds\": [\"FR-2\", \"FR-3\", \"NFR-2\"]\n30\t    },\n31\t    {\n32\t      \"method\": \"POST\",\n33\t      \"path\": \"/api/users\",\n34\t      \"description\": \"ADMIN only. Creates a User + role-specific profile row + any inline parent/student links in one transaction; generates admissionNumber (S<year>-####) or employeeNumber (T-####) where applicable.\",\n35\t      \"requestSchema\": { \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"role\": \"Role\", \"profile\": \"StudentProfileInput|TeacherProfileInput|ParentProfileInput (shape depends on role; see FR-1)\", \"links\": \"[{ linkedUserId: string, relationship: GuardianRelationship, isPrimary: boolean }]?\", \"sendInvite\": \"boolean (default true)\" },\n36\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },\n37\t      \"requirementIds\": [\"FR-1\", \"FR-6\", \"FR-7\", \"FR-9\", \"FR-10\", \"FR-15\", \"FR-16\"]\n38\t    },\n39\t    {\n40\t      \"method\": \"GET\",\n41\t      \"path\": \"/api/users/:id\",\n42\t      \"description\": \"ADMIN only. Full user + role profile + family links (component 6) + 20 most recent AuditLog rows where actorId=id OR entityId=id.\",\n43\t      \"requestSchema\": {},\n44\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"lastLoginAt\": \"datetime|null\", \"profile\": \"object\", \"familyLinks\": [ { \"id\": \"string\", \"linkedUserId\": \"string\", \"linkedUserName\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } ], \"recentAuditLogs\": [ { \"id\": \"string\", \"action\": \"string\", \"actorId\": \"string|null\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"createdAt\": \"datetime\" } ] } },\n45\t      \"requirementIds\": [\"FR-11\"]\n46\t    },\n47\t    {\n48\t      \"method\": \"PATCH\",\n49\t      \"path\": \"/api/users/:id\",\n50\t      \"description\": \"ADMIN only. Updates common + profile fields. role is rejected server-side if present and different from the existing row (FR-9 is a service-layer invariant, not just a form convenience). An email diff invalidates (marks used) any pending AuthToken rows of type INVITE for this user.\",\n51\t      \"requestSchema\": { \"firstName\": \"string?\", \"lastName\": \"string?\", \"email\": \"string?\", \"phone\": \"string?\", \"profile\": \"Partial<StudentProfileInput|TeacherProfileInput|ParentProfileInput>?\" },\n52\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },\n53\t      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-10\"]\n54\t    },\n55\t    {\n56\t      \"method\": \"POST\",\n57\t      \"path\": \"/api/users/:id/invite\",\n58\t      \"description\": \"ADMIN only. Resends an invitation email via src/server/services/users.ts's sendInvite(userId) (PRD-01 interface; see note — stub/no-op until PRD-01 lands, call site does not change).\",\n59\t      \"requestSchema\": {},\n60\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"inviteSentAt\": \"datetime\" } },\n61\t      \"requirementIds\": [\"FR-7\"]\n62\t    },\n63\t    {\n64\t      \"method\": \"POST\",\n65\t      \"path\": \"/api/users/:id/unlock\",\n66\t      \"description\": \"ADMIN only. Clears lockedUntil and failedLoginCount, restoring sign-in access immediately. MEDIUM confidence (FR-31) — field names confirmed against prisma/schema.prisma; verify no other lockout field exists before implementation.\",\n67\t      \"requestSchema\": {},\n68\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"lockedUntil\": null, \"failedLoginCount\": 0 } },\n69\t      \"requirementIds\": [\"FR-31\"]\n70\t    },\n71\t    {\n72\t      \"method\": \"POST\",\n73\t      \"path\": \"/api/users/:id/status\",\n74\t      \"description\": \"ADMIN only. Sets status to ACTIVE or DISABLED. Rejects self-disable and disabling the last active ADMIN with VALIDATION_ERROR 'At least one active admin is required.' The 'sessions stop working within 5 minutes' effect (FR-12) is PRD-01's session re-check reading status on token refresh, not built here (NFR-7) — this endpoint only guarantees status is correct the instant the write commits.\",\n75\t      \"requestSchema\": { \"status\": \"\\\"ACTIVE\\\"|\\\"DISABLED\\\"\" },\n76\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\" } },\n77\t      \"requirementIds\": [\"FR-12\", \"FR-14\"]\n78\t    },\n79\t    {\n80\t      \"method\": \"POST\",\n81\t      \"path\": \"/api/users/:id/archive\",\n82\t      \"description\": \"ADMIN only. Sets archivedAt=now and status=DISABLED. Same self/last-admin guard as /status. Archived users are excluded from every list/picker query by default (component 3/7/16), enforced at the query layer.\",\n83\t      \"requestSchema\": {},\n84\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": \"datetime\" } },\n85\t      \"requirementIds\": [\"FR-13\", \"FR-14\"]\n86\t    },\n87\t    {\n88\t      \"method\": \"POST\",\n89\t      \"path\": \"/api/users/:id/restore\",\n90\t      \"description\": \"ADMIN only. Clears archivedAt. Does not auto-reactivate status; an admin re-enables separately via /status.\",\n91\t      \"requestSchema\": {},\n92\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": null } },\n93\t      \"requirementIds\": [\"FR-13\"]\n94\t    },\n95\t    {\n96\t      \"method\": \"POST\",\n97\t      \"path\": \"/api/users/import\",\n98\t      \"description\": \"ADMIN only. Re-validates every row server-side (never trusts the client) against the same Zod schemas as the create form, in batches of 200; each batch runs in one prisma.$transaction (all-or-rollback, NFR-3). Grade levels matched case-insensitively by name/shortName; dates parsed strictly as YYYY-MM-DD; rows whose email already exists are skipped, not errored (FR-23).\",\n99\t      \"requestSchema\": { \"type\": \"\\\"STUDENTS\\\"|\\\"TEACHERS\\\"\", \"rows\": \"object[] (raw parsed CSV rows, re-validated server-side)\", \"sendInvites\": \"boolean (default false)\" },\n100\t      \"responseSchema\": { \"data\": { \"createdStudents\": \"int\", \"createdParents\": \"int\", \"linkedExistingParents\": \"int\", \"skipped\": \"int\", \"failed\": \"int\", \"rowResults\": [ { \"rowIndex\": \"int\", \"result\": \"\\\"created\\\"|\\\"skipped\\\"|\\\"error\\\"\", \"reason\": \"string|null\" } ], \"errorReportCsvUrl\": \"string|null\" } },\n101\t      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-22\", \"FR-23\", \"NFR-3\"]\n102\t    },\n103\t    {\n104\t      \"method\": \"GET\",\n105\t      \"path\": \"/api/users/export\",\n106\t      \"description\": \"ADMIN only. Same filters as GET /api/users; returns text/csv. medicalNotes is excluded and every cell passes through escapeCsvCell() (NFR-4) to neutralise formula injection.\",\n107\t      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean?\" },\n108\t      \"responseSchema\": { \"contentType\": \"text/csv\", \"body\": \"csv string, one row per matched user, medicalNotes column omitted\" },\n109\t      \"requirementIds\": [\"FR-5\", \"NFR-1\", \"NFR-4\"]\n110\t    },\n111\t    {\n112\t      \"method\": \"GET\",\n113\t      \"path\": \"/api/users/search\",\n114\t      \"description\": \"ADMIN and TEACHER only. Picker search reusing the list query's filters, capped to 20 rows, projected down, excluding archived users.\",\n115\t      \"requestSchema\": { \"role\": \"Role?\", \"q\": \"string?\" },\n116\t      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"email\": \"string\", \"role\": \"Role\" } ] },\n117\t      \"requirementIds\": [\"FR-28\"]\n118\t    },\n119\t    {\n120\t      \"method\": \"POST\",\n121\t      \"path\": \"/api/students/:id/parents\",\n122\t      \"description\": \"ADMIN only. Links a parent to a student inside one transaction: rejects a 5th link for the student (VALIDATION_ERROR) and, if isPrimary is true, clears isPrimary on every other link for that student first.\",\n123\t      \"requestSchema\": { \"parentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" },\n124\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"parentId\": \"string\", \"studentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } },\n125\t      \"requirementIds\": [\"FR-15\", \"FR-16\"]\n126\t    },\n127\t    {\n128\t      \"method\": \"DELETE\",\n129\t      \"path\": \"/api/students/:id/parents/:parentId\",\n130\t      \"description\": \"ADMIN only. Removes a parent-student link.\",\n131\t      \"requestSchema\": {},\n132\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n133\t      \"requirementIds\": [\"FR-15\"]\n134\t    },\n135\t    {\n136\t      \"method\": \"GET\",\n137\t      \"path\": \"/api/students/:id\",\n138\t      \"description\": \"Gated by assertCanViewStudent (ADMIN/TEACHER full access; STUDENT self only; PARENT linked children only — FORBIDDEN or NOT_FOUND otherwise, never revealing existence to STUDENT/PARENT). medicalNotes is stripped in the service layer for STUDENT/PARENT roles before the response is built.\",\n139\t      \"requestSchema\": {},\n140\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"admissionNumber\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevelName\": \"string\", \"status\": \"UserStatus\", \"dateOfBirth\": \"date\", \"gender\": \"Gender\", \"addressLine1\": \"string|null\", \"city\": \"string|null\", \"medicalNotes\": \"string|null (omitted entirely for STUDENT/PARENT)\", \"emergencyContact\": \"string|null\", \"emergencyPhone\": \"string|null\", \"familyLinks\": \"[{ linkedUserId, linkedUserName, relationship, isPrimary }]\" } },\n141\t      \"requirementIds\": [\"FR-24\", \"FR-25\", \"NFR-1\"]\n142\t    },\n143\t    {\n144\t      \"method\": \"GET\",\n145\t      \"path\": \"/api/me/children\",\n146\t      \"description\": \"PARENT only. Lists the caller's linked children for the My Children page.\",\n147\t      \"requestSchema\": {},\n148\t      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"gradeLevelName\": \"string\", \"admissionNumber\": \"string\" } ] },\n149\t      \"requirementIds\": [\"FR-26\"]\n150\t    },\n151\t    {\n152\t      \"method\": \"PATCH\",\n153\t      \"path\": \"/api/me/profile\",\n154\t      \"description\": \"Any authenticated user, self only. Narrower mutation path than /api/users/:id — editable fields are phone, plus occupation/address for PARENT role; name/email/role are read-only here.\",\n155\t      \"requestSchema\": { \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"occupation\": \"string? (PARENT only)\", \"address\": \"string? (PARENT only)\" },\n156\t      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"phone\": \"string|null\", \"occupation\": \"string|null\", \"address\": \"string|null\" } },\n157\t      \"requirementIds\": [\"FR-27\"]\n158\t    },\n159\t    {\n160\t      \"method\": \"GET\",\n161\t      \"path\": \"/api/audit-logs\",\n162\t      \"description\": \"ADMIN only. Read-only paginated view over the existing AuditLog table; filters by actor, action prefix, and date range. No new write path.\",\n163\t      \"requestSchema\": { \"actorId\": \"string?\", \"actionPrefix\": \"string?\", \"dateFrom\": \"date?\", \"dateTo\": \"date?\", \"page\": \"int?\", \"pageSize\": \"int?\" },\n164\t      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"createdAt\": \"datetime\", \"actorId\": \"string|null\", \"actorName\": \"string|null\", \"action\": \"string\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"ip\": \"string|null\", \"metadata\": \"object|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },\n165\t      \"requirementIds\": [\"FR-29\"]\n166\t    }\n167\t  ],\n168\t\n169\t  \"status\": \"complete\"\n170\t}\n171\t"}]},"parent_tool_use_id":null,"session_id":"54b3bb1c-c2bb-4763-9a84-dd2308368397","uuid":"f6b9c35d-5e12-4182-ad98-192b0c1f8cc9","timestamp":"2026-10-19T10:11:40.260Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"abcd-03\",\n  \"timestamp\": \"2026-10-19T14:20:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md's Component Breakdown/Data Flow (abcd-03) and the source PRD's explicit API table (03-user-management.md, section 'API'), which fully specifies method/path/role/body for all 18 endpoints. Two items carried forward from system-design.md's Status section, unresolved by this sub-task because they are sequencing/confirmation items for dev-planning, not contract-shape questions: (1) FR-31 is MEDIUM confidence — the unlock contract below assumes it clears exactly lockedUntil/failedLoginCount per prisma/schema.prisma, confirm before implementation; (2) POST /api/users/:id/invite and the session-level effect of POST /api/users/:id/status are written against src/server/services/users.ts's sendInvite(userId) and PRD-01's session/status re-check, neither of which exists in src/ yet (only their schema does) — see handoff-to-dev-planning.json blockers.\",\n\n  \"conventions\": {\n    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n    \"listEnvelope\": { \"data\": \"[...]\", \"page\": 1, \"pageSize\": 20, \"total\": 0 },\n    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\"],\n    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100)\",\n    \"sorting\": \"?sort=field&order=asc|desc\",\n    \"search\": \"?q=\",\n    \"auth\": \"Per-endpoint role gate shown in each entry's description, enforced server-side via requireRole()/assertCanViewStudent (never UI-only). Student-scoped reads additionally run assertCanViewStudent, which throws FORBIDDEN or NOT_FOUND (for STUDENT/PARENT callers, to avoid revealing existence) rather than a blanket 403.\",\n    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action user.<verb> (e.g. user.created, user.status_changed, user.archived, user.unlocked, user.imported, parent_link.created, parent_link.removed).\",\n    \"privacy\": \"medicalNotes is stripped server-side (never UI-only) from every response reachable by STUDENT/PARENT roles and from every CSV export row (NFR-1).\"\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users\",\n      \"description\": \"ADMIN only. Paginated, filtered user list backed by the (lastName, firstName, email) index.\",\n      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean? (default false)\", \"page\": \"int?\", \"pageSize\": \"int?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"gradeLevelId\": \"string|null\", \"gradeLevelName\": \"string|null\", \"lastLoginAt\": \"datetime|null\", \"lockedUntil\": \"datetime|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users\",\n      \"description\": \"ADMIN only. Creates a User + role-specific profile row + any inline parent/student links in one transaction; generates admissionNumber (S<year>-####) or employeeNumber (T-####) where applicable.\",\n      \"requestSchema\": { \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"role\": \"Role\", \"profile\": \"StudentProfileInput|TeacherProfileInput|ParentProfileInput (shape depends on role; see FR-1)\", \"links\": \"[{ linkedUserId: string, relationship: GuardianRelationship, isPrimary: boolean }]?\", \"sendInvite\": \"boolean (default true)\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },\n      \"requirementIds\": [\"FR-1\", \"FR-6\", \"FR-7\", \"FR-9\", \"FR-10\", \"FR-15\", \"FR-16\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users/:id\",\n      \"description\": \"ADMIN only. Full user + role profile + family links (component 6) + 20 most recent AuditLog rows where actorId=id OR entityId=id.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"lastLoginAt\": \"datetime|null\", \"profile\": \"object\", \"familyLinks\": [ { \"id\": \"string\", \"linkedUserId\": \"string\", \"linkedUserName\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } ], \"recentAuditLogs\": [ { \"id\": \"string\", \"action\": \"string\", \"actorId\": \"string|null\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"createdAt\": \"datetime\" } ] } },\n      \"requirementIds\": [\"FR-11\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/users/:id\",\n      \"description\": \"ADMIN only. Updates common + profile fields. role is rejected server-side if present and different from the existing row (FR-9 is a service-layer invariant, not just a form convenience). An email diff invalidates (marks used) any pending AuthToken rows of type INVITE for this user.\",\n      \"requestSchema\": { \"firstName\": \"string?\", \"lastName\": \"string?\", \"email\": \"string?\", \"phone\": \"string?\", \"profile\": \"Partial<StudentProfileInput|TeacherProfileInput|ParentProfileInput>?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },\n      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/invite\",\n      \"description\": \"ADMIN only. Resends an invitation email via src/server/services/users.ts's sendInvite(userId) (PRD-01 interface; see note — stub/no-op until PRD-01 lands, call site does not change).\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"inviteSentAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/unlock\",\n      \"description\": \"ADMIN only. Clears lockedUntil and failedLoginCount, restoring sign-in access immediately. MEDIUM confidence (FR-31) — field names confirmed against prisma/schema.prisma; verify no other lockout field exists before implementation.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"lockedUntil\": null, \"failedLoginCount\": 0 } },\n      \"requirementIds\": [\"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/status\",\n      \"description\": \"ADMIN only. Sets status to ACTIVE or DISABLED. Rejects self-disable and disabling the last active ADMIN with VALIDATION_ERROR 'At least one active admin is required.' The 'sessions stop working within 5 minutes' effect (FR-12) is PRD-01's session re-check reading status on token refresh, not built here (NFR-7) — this endpoint only guarantees status is correct the instant the write commits.\",\n      \"requestSchema\": { \"status\": \"\\\"ACTIVE\\\"|\\\"DISABLED\\\"\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\" } },\n      \"requirementIds\": [\"FR-12\", \"FR-14\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/archive\",\n      \"description\": \"ADMIN only. Sets archivedAt=now and status=DISABLED. Same self/last-admin guard as /status. Archived users are excluded from every list/picker query by default (component 3/7/16), enforced at the query layer.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-13\", \"FR-14\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/restore\",\n      \"description\": \"ADMIN only. Clears archivedAt. Does not auto-reactivate status; an admin re-enables separately via /status.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": null } },\n      \"requirementIds\": [\"FR-13\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/import\",\n      \"description\": \"ADMIN only. Re-validates every row server-side (never trusts the client) against the same Zod schemas as the create form, in batches of 200; each batch runs in one prisma.$transaction (all-or-rollback, NFR-3). Grade levels matched case-insensitively by name/shortName; dates parsed strictly as YYYY-MM-DD; rows whose email already exists are skipped, not errored (FR-23).\",\n      \"requestSchema\": { \"type\": \"\\\"STUDENTS\\\"|\\\"TEACHERS\\\"\", \"rows\": \"object[] (raw parsed CSV rows, re-validated server-side)\", \"sendInvites\": \"boolean (default false)\" },\n      \"responseSchema\": { \"data\": { \"createdStudents\": \"int\", \"createdParents\": \"int\", \"linkedExistingParents\": \"int\", \"skipped\": \"int\", \"failed\": \"int\", \"rowResults\": [ { \"rowIndex\": \"int\", \"result\": \"\\\"created\\\"|\\\"skipped\\\"|\\\"error\\\"\", \"reason\": \"string|null\" } ], \"errorReportCsvUrl\": \"string|null\" } },\n      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-22\", \"FR-23\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users/export\",\n      \"description\": \"ADMIN only. Same filters as GET /api/users; returns text/csv. medicalNotes is excluded and every cell passes through escapeCsvCell() (NFR-4) to neutralise formula injection.\",\n      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean?\" },\n      \"responseSchema\": { \"contentType\": \"text/csv\", \"body\": \"csv string, one row per matched user, medicalNotes column omitted\" },\n      \"requirementIds\": [\"FR-5\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users/search\",\n      \"description\": \"ADMIN and TEACHER only. Picker search reusing the list query's filters, capped to 20 rows, projected down, excluding archived users.\",\n      \"requestSchema\": { \"role\": \"Role?\", \"q\": \"string?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"email\": \"string\", \"role\": \"Role\" } ] },\n      \"requirementIds\": [\"FR-28\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/students/:id/parents\",\n      \"description\": \"ADMIN only. Links a parent to a student inside one transaction: rejects a 5th link for the student (VALIDATION_ERROR) and, if isPrimary is true, clears isPrimary on every other link for that student first.\",\n      \"requestSchema\": { \"parentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"parentId\": \"string\", \"studentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } },\n      \"requirementIds\": [\"FR-15\", \"FR-16\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/students/:id/parents/:parentId\",\n      \"description\": \"ADMIN only. Removes a parent-student link.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n      \"requirementIds\": [\"FR-15\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/:id\",\n      \"description\": \"Gated by assertCanViewStudent (ADMIN/TEACHER full access; STUDENT self only; PARENT linked children only — FORBIDDEN or NOT_FOUND otherwise, never revealing existence to STUDENT/PARENT). medicalNotes is stripped in the service layer for STUDENT/PARENT roles before the response is built.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"admissionNumber\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevelName\": \"string\", \"status\": \"UserStatus\", \"dateOfBirth\": \"date\", \"gender\": \"Gender\", \"addressLine1\": \"string|null\", \"city\": \"string|null\", \"medicalNotes\": \"string|null (omitted entirely for STUDENT/PARENT)\", \"emergencyContact\": \"string|null\", \"emergencyPhone\": \"string|null\", \"familyLinks\": \"[{ linkedUserId, linkedUserName, relationship, isPrimary }]\" } },\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/children\",\n      \"description\": \"PARENT only. Lists the caller's linked children for the My Children page.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"gradeLevelName\": \"string\", \"admissionNumber\": \"string\" } ] },\n      \"requirementIds\": [\"FR-26\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/me/profile\",\n      \"description\": \"Any authenticated user, self only. Narrower mutation path than /api/users/:id — editable fields are phone, plus occupation/address for PARENT role; name/email/role are read-only here.\",\n      \"requestSchema\": { \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"occupation\": \"string? (PARENT only)\", \"address\": \"string? (PARENT only)\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"phone\": \"string|null\", \"occupation\": \"string|null\", \"address\": \"string|null\" } },\n      \"requirementIds\": [\"FR-27\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/audit-logs\",\n      \"description\": \"ADMIN only. Read-only paginated view over the existing AuditLog table; filters by actor, action prefix, and date range. No new write path.\",\n      \"requestSchema\": { \"actorId\": \"string?\", \"actionPrefix\": \"string?\", \"dateFrom\": \"date?\", \"dateTo\": \"date?\", \"page\": \"int?\", \"pageSize\": \"int?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"createdAt\": \"datetime\", \"actorId\": \"string|null\", \"actorName\": \"string|null\", \"action\": \"string\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"ip\": \"string|null\", \"metadata\": \"object|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },\n      \"requirementIds\": [\"FR-29\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","numLines":171,"startLine":1,"totalLines":171}}}
