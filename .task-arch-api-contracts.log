{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VKnSdqKE4RM6HahjycaCRh","type":"tool_result","content":"1\timport { NextResponse } from 'next/server';\n2\timport { Prisma } from '@prisma/client';\n3\timport { ZodError, type ZodTypeAny, type output } from 'zod';\n4\timport { logger } from '@/lib/logger';\n5\t\n6\t/**\n7\t * The one chokepoint every route handler goes through. Nothing here should\n8\t * be reimplemented per-route — new endpoints import from this module, they\n9\t * don't hand-roll envelopes, pagination clamping or error mapping.\n10\t */\n11\t\n12\texport type ApiErrorCode =\n13\t  | 'VALIDATION_ERROR'\n14\t  | 'NOT_FOUND'\n15\t  | 'CONFLICT'\n16\t  | 'INTERNAL'\n17\t  | 'RATE_LIMITED'\n18\t  | 'UNAUTHENTICATED'\n19\t  | 'FORBIDDEN'\n20\t  | 'INVALID_TOKEN';\n21\t\n22\tconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n23\t  VALIDATION_ERROR: 400,\n24\t  NOT_FOUND: 404,\n25\t  CONFLICT: 409,\n26\t  INTERNAL: 500,\n27\t  RATE_LIMITED: 429,\n28\t  UNAUTHENTICATED: 401,\n29\t  FORBIDDEN: 403,\n30\t  INVALID_TOKEN: 410,\n31\t};\n32\t\n33\t/** Throw this from a handler for a known, intentional failure. */\n34\texport class AppError extends Error {\n35\t  code: ApiErrorCode;\n36\t  details?: unknown;\n37\t\n38\t  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n39\t    super(message);\n40\t    this.code = code;\n41\t    this.details = details;\n42\t  }\n43\t}\n44\t\n45\texport function ok<T>(data: T, init?: ResponseInit) {\n46\t  return NextResponse.json({ data }, init);\n47\t}\n48\t\n49\texport function paginated<T>(\n50\t  data: T[],\n51\t  meta: { page: number; pageSize: number; total: number },\n52\t  init?: ResponseInit,\n53\t) {\n54\t  return NextResponse.json({ data, meta }, init);\n55\t}\n56\t\n57\texport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n58\t  return NextResponse.json(\n59\t    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n60\t    { status: ERROR_STATUS[code] },\n61\t  );\n62\t}\n63\t\n64\t/**\n65\t * Wraps a route handler, mapping thrown errors to the shared envelope:\n66\t * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n67\t * AppError -> its own code/status\n68\t * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n69\t * anything else -> INTERNAL (500), stack logged, never returned to client\n70\t */"}]},"parent_tool_use_id":null,"session_id":"8f1e9cdf-3174-43b4-adaa-4e6aa4038a8c","uuid":"5f7d190b-3dad-4064-8c18-86423e8fc06c","timestamp":"2026-11-09T18:54:12.962Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/server/http.ts","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\n  );\n}\n\n/**\n * Wraps a route handler, mapping thrown errors to the shared envelope:\n * ZodError -> VALIDATION_ERROR (400, flattened field errors in details)\n * AppError -> its own code/status\n * Prisma P2002 -> CONFLICT, P2025 -> NOT_FOUND\n * anything else -> INTERNAL (500), stack logged, never returned to client\n */","numLines":70,"startLine":1,"totalLines":138}},"tool_result_meta":[{"id":"toolu_01VKnSdqKE4RM6HahjycaCRh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
