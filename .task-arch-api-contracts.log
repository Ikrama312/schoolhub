ethod\": \"GET\",\n      \"path\": \"/api/subjects\",\n      \"description\": \"List subjects, searchable by name/code via ?q=.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string(hex)\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/subjects\",\n      \"description\": \"Create a subject. Code is normalised upper-case; duplicate code returns CONFLICT (409) with field error 'Code already used by <subject>.'\",\n      \"requestSchema\": { \"name\": \"string\", \"code\": \"string (2-10 chars, normalised upper-case)\", \"description\": \"string?\", \"color\": \"string(hex, one of 12 preset swatches)\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\" } },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/subjects/:id\",\n      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n      \"requestSchema\": { \"name\": \"string?\", \"code\": \"string?\", \"description\": \"string?\", \"color\": \"string(hex)?\", \"archived\": \"boolean?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\", \"archivedAt\": \"datetime|null\" } },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/rooms\",\n      \"description\": \"List rooms.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-17\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/rooms\",\n      \"description\": \"Create a room.\",\n      \"requestSchema\": { \"name\": \"string\", \"building\": \"string?\", \"capacity\": \"int (1-500)?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\" } },\n      \"requirementIds\": [\"FR-17\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/rooms/:id\",\n      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n      \"requestSchema\": { \"name\": \"string?\", \"building\": \"string?\", \"capacity\": \"int?\", \"archived\": \"boolean?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\", \"archivedAt\": \"datetime|null\" } },\n      \"requirementIds\": [\"FR-17\", \"NFR-6\", \"NFR-7\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":127,"newStart":1,"newLines":193,"lines":[" {","-  \"ticketId\": \"abcd-2\",","-  \"timestamp\": \"2026-10-16T21:45:00Z\",","+  \"ticketId\": \"abcd-02\",","+  \"timestamp\": \"2026-10-19T13:30:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\","," ","-  \"sharedEnvelope\": {","-    \"description\": \"Two families of endpoint exist in this PRD. (1) Auth.js (NextAuth v5)'s own catch-all route (/api/auth/callback/credentials, /api/auth/session, /api/auth/signout, /api/auth/csrf) — its request/response wire format is owned by the library, not src/server/http.ts, and is documented per-endpoint below only at the level dev-planning needs (inputs, outcomes, which FRs they satisfy). (2) Four new form-submission endpoints (invite/accept, forgot-password, reset-password, change-password) that are genuinely ours and MUST route through the existing src/server/http.ts chokepoint (ok/apiError/withHandler/parseBody) per NFR-7 — no parallel envelope. That chokepoint's ApiErrorCode union currently only has VALIDATION_ERROR/NOT_FOUND/CONFLICT/INTERNAL (see src/server/http.ts); this PRD needs three more values, which dev-planning/dev must EXTEND that union and errorCodeToStatus map with, not fork a second error-mapping file.\",","-    \"success\": { \"data\": \"<payload>\" },","-    \"error\": { \"error\": { \"code\": \"string\", \"message\": \"string\", \"details\": \"object (optional)\" } },","-    \"errorCodeToStatus\": {","-      \"VALIDATION_ERROR\": 400,","-      \"NOT_FOUND\": 404,","-      \"CONFLICT\": 409,","-      \"INTERNAL\": 500,","-      \"RATE_LIMITED\": 429,","-      \"UNAUTHENTICATED\": 401,","-      \"INVALID_TOKEN\": 410","-    },","-    \"newErrorCodesForThisPrd\": {","-      \"RATE_LIMITED\": \"Sign-in and forgot-password rate limiters (FR-6, FR-17) short-circuit to this before any DB work.\",","-      \"UNAUTHENTICATED\": \"Defense-in-depth on change-password's requireUser() guard (FR-20, FR-23) — middleware.ts already blocks unauthenticated (app) requests, this is the handler-level backstop.\",","-      \"INVALID_TOKEN\": \"Invite/reset token is missing, wrong type, expired, or already used (FR-12, FR-18, FR-19) — distinct from NOT_FOUND because the token row may exist but be unusable; mapped to 410 Gone.\"","-    },","-    \"notModeledAsEndpoints\": \"Component 9's service functions (createUser, createInviteToken, sendInvite, setUserStatus, unlockUser — FR-22) are an internal module surface called by prisma/seed.ts (FR-28) and by later PRDs' admin UI, not by any form in this PRD. No endpoint is defined for them here; inventing an admin API now would be scope creep past NFR-8. Likewise /invite/[token] and /reset-password/[token]'s GET render (token validity check for FR-12) happens inside the Server Component itself via a direct Prisma lookup, not a client-side API call — no GET endpoint is defined for that for the same reason.\",","-    \"requirementIds\": [\"NFR-7\", \"NFR-8\"]","+  \"note\": \"arch-design-system did not leave a system-design.md for this ticket (not found anywhere under artifacts/architect/ for ticketId abcd-02 — see handoff-to-dev-planning.json blockers). Contracts below are derived directly from artifacts/intake/requirements.json and the source PRD's explicit API table (02-academic-structure.md, section 'API'), which fully specify method/path/role/body for every endpoint.\",","+","+  \"conventions\": {","+    \"successEnvelope\": { \"data\": \"<resource or array>\" },","+    \"listEnvelope\": { \"data\": \"[...]\", \"page\": 1, \"pageSize\": 20, \"total\": 0 },","+    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },","+    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\"],","+    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100)\",","+    \"sorting\": \"?sort=field&order=asc|desc\",","+    \"search\": \"?q=\",","+    \"auth\": \"GET endpoints: any signed-in user. All write endpoints (POST/PATCH/DELETE): requireRole('ADMIN') server-side, 403 on non-admin.\",","+    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action <entity>.create|update|archive|delete.\"","   },"," ","   \"endpoints\": [","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/auth/callback/credentials\",","-      \"description\": \"Auth.js (NextAuth v5) Credentials provider callback, invoked internally by signIn('credentials') from the /login page. Runs the authorize() chokepoint: rate-limit check (10/IP/5min) before any DB work, email normalize, status/lockout branch (dummy bcrypt-compare for timing safety on a non-existent user), bcrypt compare (cost 12), failedLoginCount/lockedUntil mutation, audit() writes, and on success stamps id/role/firstName/lastName/email into the JWT. Wire format (form-encoded body, redirect-based response) is owned by Auth.js, not src/server/http.ts.\",","-      \"requestSchema\": {","-        \"email\": \"string\",","-        \"password\": \"string\",","-        \"csrfToken\": \"string (Auth.js-issued)\",","-        \"callbackUrl\": \"string\"","-      },","-      \"responseSchema\": {","-        \"redirectSuccess\": \"same-origin callbackUrl if relative, else /dashboard (FR-7)\",","-        \"redirectFailure\": \"/login?error=CredentialsSignin — same generic message for unknown-user and wrong-password (FR-4)\",","-        \"redirectLocked\": \"/login?error=CredentialsSignin — locked-account message includes remaining minutes (FR-4)\",","-        \"redirectDisabled\": \"/login?error=CredentialsSignin — distinct disabled-account message (FR-4)\",","-        \"redirectRateLimited\": \"/login?error=RateLimited — 'Too many attempts' message (FR-6)\"","-      },","-      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"NFR-1\", \"NFR-2\", \"NFR-3\"]","+      \"method\": \"GET\",","+      \"path\": \"/api/settings/school\",","+      \"description\": \"Return the single SchoolSettings record.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string (IANA zone)\" } },","+      \"requirementIds\": [\"FR-2\", \"FR-5\", \"NFR-6\"]","     },","     {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/settings/school\",","+      \"description\": \"Update one or more SchoolSettings fields. Writes audit entry settings.school.update with changed field names in metadata.\",","+      \"requestSchema\": { \"name\": \"string?\", \"logoUrl\": \"string(url)?\", \"address\": \"string?\", \"contactEmail\": \"string?\", \"contactPhone\": \"string?\", \"timezone\": \"string (IANA zone)?\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string\" } },","+      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/auth/session\",","-      \"description\": \"Auth.js session read. The jwt callback applies the passwordChangedAt invalidation check (throttled to once per 5 minutes per token) before returning session.user; a token issued before the latest passwordChangedAt comes back null, forcing re-login on that device.\",","+      \"path\": \"/api/academic-years\",","+      \"description\": \"List academic years including their terms, ordered by term order.\",","       \"requestSchema\": {},","-      \"responseSchema\": {","-        \"data\": {","-          \"user\": { \"id\": \"string\", \"role\": \"Role\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\" }","-        },","-        \"orNull\": \"null when unauthenticated or invalidated by passwordChangedAt\"","-      },","-      \"requirementIds\": [\"FR-9\", \"FR-10\"]","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\", \"terms\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] } ] },","+      \"requirementIds\": [\"FR-6\", \"FR-10\", \"FR-11\", \"NFR-6\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/auth/signout\",","-      \"description\": \"Auth.js sign-out, clears the session cookie. Invoked by the top-bar user menu's 'Sign out' action, which then redirects to /login.\",","-      \"requestSchema\": { \"csrfToken\": \"string (Auth.js-issued)\" },","-      \"responseSchema\": { \"redirect\": \"/login\" },","-      \"requirementIds\": [\"FR-25\"]","+      \"path\": \"/api/academic-years\",","+      \"description\": \"Create an academic year. Validates endDate after startDate and no date-range overlap with any other year, inside a transaction.\",","+      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },","+      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/auth/csrf\",","-      \"description\": \"Auth.js CSRF token issuance, consumed by every auth form (sign-in, sign-out, and this PRD's own POST endpoints reuse the same Auth.js session's CSRF protection) per NFR-1.\",","+      \"method\": \"PATCH\",","+      \"path\": \"/api/academic-years/:id\",","+      \"description\": \"Update an academic year's name/dates; re-validates the overlap rule.\",","+      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },","+      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/academic-years/:id/set-current\",","+      \"description\": \"Set isCurrent = true on this year and false on every other year, inside one transaction. Confirm dialog gates this on the client.\",","       \"requestSchema\": {},","-      \"responseSchema\": { \"csrfToken\": \"string\" },","-      \"requirementIds\": [\"NFR-1\"]","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"isCurrent\": true } },","+      \"requirementIds\": [\"FR-8\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","     },","     {","+      \"method\": \"DELETE\",","+      \"path\": \"/api/academic-years/:id\",","+      \"description\": \"Delete an academic year. Returns CONFLICT (409) if it has terms or is referenced elsewhere.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },","+      \"requirementIds\": [\"FR-9\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","       \"method\": \"POST\",","-      \"path\": \"/api/auth/invite/accept\",","-      \"description\": \"Accept-invitation submit from /invite/[token]. Looks up the AuthToken by SHA-256 hash of the submitted token (must be type INVITE, unused, within 7-day expiry), validates the new password against the shared policy module, then as one service-layer step: hashes it, sets status=ACTIVE and passwordChangedAt=now, marks the token used, signs the user in, and audits auth.invite.accepted — kept atomic so a failure partway doesn't leave a used token with no activated account.\",","-      \"requestSchema\": { \"token\": \"string\", \"password\": \"string\", \"confirmPassword\": \"string\" },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"redirectTo\": \"/dashboard\" } },","-        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": { \"fieldErrors\": \"object\" } } },","-        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This invitation link is invalid or has expired.\" } }","-      },","-      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\"]","+      \"path\": \"/api/academic-years/:id/terms\",","+      \"description\": \"Create a term under this academic year. Validates term dates fall inside the year's range and do not overlap sibling terms; order auto-assigns as max+1.\",","+      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },","+      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/auth/forgot-password\",","-      \"description\": \"Always responds 200 with the same generic message regardless of whether the account exists (anti-enumeration, pairs with NFR-2's intent). Rate-limited 3/email/hr and 10/IP/hr via component 3's limiter — the limiter key is the submitted email/IP itself, not account existence, so a 429 here doesn't leak whether an account exists. For an existing ACTIVE user only: issues a PASSWORD_RESET token (32 random bytes, 60-min expiry), revokes that user's older unused reset tokens, and calls sendAuthEmail(user, 'password-reset', link).\",","-      \"requestSchema\": { \"email\": \"string\" },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"message\": \"If an account exists for that email, we've sent a reset link.\" } },","-        \"429\": { \"error\": { \"code\": \"RATE_LIMITED\", \"message\": \"Too many attempts. Try again later.\" } }","-      },","-      \"requirementIds\": [\"FR-17\", \"FR-18\"]","+      \"path\": \"/api/academic-years/:id/terms/generate\",","+      \"description\": \"Split the year's date range into equal consecutive, named, contiguous terms. Only allowed when the year has zero terms. Earlier terms get the extra day when the range doesn't divide evenly.\",","+      \"requestSchema\": { \"pattern\": \"'SEMESTERS' | 'TRIMESTERS' | 'QUARTERS'\" },","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] },","+      \"requirementIds\": [\"FR-14\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","     },","     {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/terms/:id\",","+      \"description\": \"Update a term's name/dates/order. Re-validates range and sibling-overlap rules.\",","+      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\", \"order\": \"int?\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },","+      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","+      \"method\": \"DELETE\",","+      \"path\": \"/api/terms/:id\",","+      \"description\": \"Delete a term.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },","+      \"requirementIds\": [\"FR-12\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","       \"method\": \"POST\",","-      \"path\": \"/api/auth/reset-password\",","-      \"description\": \"Submit from /reset-password/[token]. Looks up the AuthToken by SHA-256 hash (must be type PASSWORD_RESET, unused, within 60-min expiry), validates the new password against the shared policy module, sets the new hash and passwordChangedAt, clears failedLoginCount/lockedUntil, marks the token used, and audits auth.password.reset.\",","-      \"requestSchema\": { \"token\": \"string\", \"password\": \"string\", \"confirmPassword\": \"string\" },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"redirectTo\": \"/login\" } },","-        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": { \"fieldErrors\": \"object\" } } },","-        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This reset link is invalid or has expired.\" } }","-      },","-      \"requirementIds\": [\"FR-15\", \"FR-19\"]","+      \"path\": \"/api/terms/reorder\",","+      \"description\": \"Persist a new term order for one academic year (drag handle or up/down buttons).\",","+      \"requestSchema\": { \"academicYearId\": \"string\", \"termIds\": \"string[]\" },","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"order\": \"int\" } ] },","+      \"requirementIds\": [\"FR-13\", \"NFR-6\", \"NFR-7\"]","     },","     {","+      \"method\": \"GET\",","+      \"path\": \"/api/grade-levels\",","+      \"description\": \"List grade levels ordered by `order`. ?includeArchived=true includes archived rows.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } ] },","+      \"requirementIds\": [\"FR-15\", \"NFR-6\"]","+    },","+    {","       \"method\": \"POST\",","-      \"path\": \"/api/auth/change-password\",","-      \"description\": \"Submit from /account/security, behind requireUser() (FR-23) — the route handler re-checks the session as a backstop even though middleware.ts already blocks unauthenticated (app) requests. Checks the current password against the stored hash (wrong value is a field-level VALIDATION_ERROR, not a generic failure), validates the new password against the shared policy module, bumps passwordChangedAt (invalidating every other session via the jwt callback's check), and re-issues the current session's token so the acting user isn't logged out by their own action.\",","-      \"requestSchema\": { \"currentPassword\": \"string\", \"newPassword\": \"string\", \"confirmPassword\": \"string\" },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"message\": \"Password updated.\" } },","-        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": { \"fieldErrors\": \"object\" } } },","-        \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\", \"message\": \"string\" } }","-      },","-      \"requirementIds\": [\"FR-15\", \"FR-20\", \"FR-23\"]","+      \"path\": \"/api/grade-levels\",","+      \"description\": \"Create a grade level.\",","+      \"requestSchema\": { \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" } },","+      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/grade-levels/:id\",","+      \"description\": \"Update fields, reorder, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",","+      \"requestSchema\": { \"name\": \"string?\", \"shortName\": \"string?\", \"order\": \"int?\", \"archived\": \"boolean?\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } },","+      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/subjects\",","+      \"description\": \"List subjects, searchable by name/code via ?q=.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string(hex)\", \"archivedAt\": \"datetime|null\" } ] },","+      \"requirementIds\": [\"FR-16\", \"NFR-6\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/subjects\",","+      \"description\": \"Create a subject. Code is normalised upper-case; duplicate code returns CONFLICT (409) with field error 'Code already used by <subject>.'\",","+      \"requestSchema\": { \"name\": \"string\", \"code\": \"string (2-10 chars, normalised upper-case)\", \"description\": \"string?\", \"color\": \"string(hex, one of 12 preset swatches)\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\" } },","+      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/subjects/:id\",","+      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",","+      \"requestSchema\": { \"name\": \"string?\", \"code\": \"string?\", \"description\": \"string?\", \"color\": \"string(hex)?\", \"archived\": \"boolean?\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\", \"archivedAt\": \"datetime|null\" } },","+      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/rooms\",","+      \"description\": \"List rooms.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\", \"archivedAt\": \"datetime|null\" } ] },","+      \"requirementIds\": [\"FR-17\", \"NFR-6\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/rooms\",","+      \"description\": \"Create a room.\",","+      \"requestSchema\": { \"name\": \"string\", \"building\": \"string?\", \"capacity\": \"int (1-500)?\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\" } },","+      \"requirementIds\": [\"FR-17\", \"NFR-6\", \"NFR-7\"]","+    },","+    {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/rooms/:id\",","+      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",","+      \"requestSchema\": { \"name\": \"string?\", \"building\": \"string?\", \"capacity\": \"int?\", \"archived\": \"boolean?\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\", \"archivedAt\": \"datetime|null\" } },","+      \"requirementIds\": [\"FR-17\", \"NFR-6\", \"NFR-7\"]","     }","   ],","+","   \"status\": \"complete\""," }"]}],"originalFile":"{\n  \"ticketId\": \"abcd-2\",\n  \"timestamp\": \"2026-10-16T21:45:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"sharedEnvelope\": {\n    \"description\": \"Two families of endpoint exist in this PRD. (1) Auth.js (NextAuth v5)'s own catch-all route (/api/auth/callback/credentials, /api/auth/session, /api/auth/signout, /api/auth/csrf) — its request/response wire format is owned by the library, not src/server/http.ts, and is documented per-endpoint below only at the level dev-planning needs (inputs, outcomes, which FRs they satisfy). (2) Four new form-submission endpoints (invite/accept, forgot-password, reset-password, change-password) that are genuinely ours and MUST route through the existing src/server/http.ts chokepoint (ok/apiError/withHandler/parseBody) per NFR-7 — no parallel envelope. That chokepoint's ApiErrorCode union currently only has VALIDATION_ERROR/NOT_FOUND/CONFLICT/INTERNAL (see src/server/http.ts); this PRD needs three more values, which dev-planning/dev must EXTEND that union and errorCodeToStatus map with, not fork a second error-mapping file.\",\n    \"success\": { \"data\": \"<payload>\" },\n    \"error\": { \"error\": { \"code\": \"string\", \"message\": \"string\", \"details\": \"object (optional)\" } },\n    \"errorCodeToStatus\": {\n      \"VALIDATION_ERROR\": 400,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409,\n      \"INTERNAL\": 500,\n      \"RATE_LIMITED\": 429,\n      \"UNAUTHENTICATED\": 401,\n      \"INVALID_TOKEN\": 410\n    },\n    \"newErrorCodesForThisPrd\": {\n      \"RATE_LIMITED\": \"Sign-in and forgot-password rate limiters (FR-6, FR-17) short-circuit to this before any DB work.\",\n      \"UNAUTHENTICATED\": \"Defense-in-depth on change-password's requireUser() guard (FR-20, FR-23) — middleware.ts already blocks unauthenticated (app) requests, this is the handler-level backstop.\",\n      \"INVALID_TOKEN\": \"Invite/reset token is missing, wrong type, expired, or already used (FR-12, FR-18, FR-19) — distinct from NOT_FOUND because the token row may exist but be unusable; mapped to 410 Gone.\"\n    },\n    \"notModeledAsEndpoints\": \"Component 9's service functions (createUser, createInviteToken, sendInvite, setUserStatus, unlockUser — FR-22) are an internal module surface called by prisma/seed.ts (FR-28) and by later PRDs' admin UI, not by any form in this PRD. No endpoint is defined for them here; inventing an admin API now would be scope creep past NFR-8. Likewise /invite/[token] and /reset-password/[token]'s GET render (token validity check for FR-12) happens inside the Server Component itself via a direct Prisma lookup, not a client-side API call — no GET endpoint is defined for that for the same reason.\",\n    \"requirementIds\": [\"NFR-7\", \"NFR-8\"]\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/callback/credentials\",\n      \"description\": \"Auth.js (NextAuth v5) Credentials provider callback, invoked internally by signIn('credentials') from the /login page. Runs the authorize() chokepoint: rate-limit check (10/IP/5min) before any DB work, email normalize, status/lockout branch (dummy bcrypt-compare for timing safety on a non-existent user), bcrypt compare (cost 12), failedLoginCount/lockedUntil mutation, audit() writes, and on success stamps id/role/firstName/lastName/email into the JWT. Wire format (form-encoded body, redirect-based response) is owned by Auth.js, not src/server/http.ts.\",\n      \"requestSchema\": {\n        \"email\": \"string\",\n        \"password\": \"string\",\n        \"csrfToken\": \"string (Auth.js-issued)\",\n        \"callbackUrl\": \"string\"\n      },\n      \"responseSchema\": {\n        \"redirectSuccess\": \"same-origin callbackUrl if relative, else /dashboard (FR-7)\",\n        \"redirectFailure\": \"/login?error=CredentialsSignin — same generic message for unknown-user and wrong-password (FR-4)\",\n        \"redirectLocked\": \"/login?error=CredentialsSignin — locked-account message includes remaining minutes (FR-4)\",\n        \"redirectDisabled\": \"/login?error=CredentialsSignin — distinct disabled-account message (FR-4)\",\n        \"redirectRateLimited\": \"/login?error=RateLimited — 'Too many attempts' message (FR-6)\"\n      },\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"NFR-1\", \"NFR-2\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/auth/session\",\n      \"description\": \"Auth.js session read. The jwt callback applies the passwordChangedAt invalidation check (throttled to once per 5 minutes per token) before returning session.user; a token issued before the latest passwordChangedAt comes back null, forcing re-login on that device.\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"data\": {\n          \"user\": { \"id\": \"string\", \"role\": \"Role\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\" }\n        },\n        \"orNull\": \"null when unauthenticated or invalidated by passwordChangedAt\"\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/signout\",\n      \"description\": \"Auth.js sign-out, clears the session cookie. Invoked by the top-bar user menu's 'Sign out' action, which then redirects to /login.\",\n      \"requestSchema\": { \"csrfToken\": \"string (Auth.js-issued)\" },\n      \"responseSchema\": { \"redirect\": \"/login\" },\n      \"requirementIds\": [\"FR-25\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/auth/csrf\",\n      \"description\": \"Auth.js CSRF token issuance, consumed by every auth form (sign-in, sign-out, and this PRD's own POST endpoints reuse the same Auth.js session's CSRF protection) per NFR-1.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"csrfToken\": \"string\" },\n      \"requirementIds\": [\"NFR-1\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/invite/accept\",\n      \"description\": \"Accept-invitation submit from /invite/[token]. Looks up the AuthToken by SHA-256 hash of the submitted token (must be type INVITE, unused, within 7-day expiry), validates the new password against the shared policy module, then as one service-layer step: hashes it, sets status=ACTIVE and passwordChangedAt=now, marks the token used, signs the user in, and audits auth.invite.accepted — kept atomic so a failure partway doesn't leave a used token with no activated account.\",\n      \"requestSchema\": { \"token\": \"string\", \"password\": \"string\", \"confirmPassword\": \"string\" },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"redirectTo\": \"/dashboard\" } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": { \"fieldErrors\": \"object\" } } },\n        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This invitation link is invalid or has expired.\" } }\n      },\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/forgot-password\",\n      \"description\": \"Always responds 200 with the same generic message regardless of whether the account exists (anti-enumeration, pairs with NFR-2's intent). Rate-limited 3/email/hr and 10/IP/hr via component 3's limiter — the limiter key is the submitted email/IP itself, not account existence, so a 429 here doesn't leak whether an account exists. For an existing ACTIVE user only: issues a PASSWORD_RESET token (32 random bytes, 60-min expiry), revokes that user's older unused reset tokens, and calls sendAuthEmail(user, 'password-reset', link).\",\n      \"requestSchema\": { \"email\": \"string\" },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"message\": \"If an account exists for that email, we've sent a reset link.\" } },\n        \"429\": { \"error\": { \"code\": \"RATE_LIMITED\", \"message\": \"Too many attempts. Try again later.\" } }\n      },\n      \"requirementIds\": [\"FR-17\", \"FR-18\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/reset-password\",\n      \"description\": \"Submit from /reset-password/[token]. Looks up the AuthToken by SHA-256 hash (must be type PASSWORD_RESET, unused, within 60-min expiry), validates the new password against the shared policy module, sets the new hash and passwordChangedAt, clears failedLoginCount/lockedUntil, marks the token used, and audits auth.password.reset.\",\n      \"requestSchema\": { \"token\": \"string\", \"password\": \"string\", \"confirmPassword\": \"string\" },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"redirectTo\": \"/login\" } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": { \"fieldErrors\": \"object\" } } },\n        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This reset link is invalid or has expired.\" } }\n      },\n      \"requirementIds\": [\"FR-15\", \"FR-19\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/change-password\",\n      \"description\": \"Submit from /account/security, behind requireUser() (FR-23) — the route handler re-checks the session as a backstop even though middleware.ts already blocks unauthenticated (app) requests. Checks the current password against the stored hash (wrong value is a field-level VALIDATION_ERROR, not a generic failure), validates the new password against the shared policy module, bumps passwordChangedAt (invalidating every other session via the jwt callback's check), and re-issues the current session's token so the acting user isn't logged out by their own action.\",\n      \"requestSchema\": { \"currentPassword\": \"string\", \"newPassword\": \"string\", \"confirmPassword\": \"string\" },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"message\": \"Password updated.\" } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": { \"fieldErrors\": \"object\" } } },\n        \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\", \"message\": \"string\" } }\n      },\n      \"requirementIds\": [\"FR-15\", \"FR-20\", \"FR-23\"]\n    }\n  ],\n  \"status\": \"complete\"\n}\n","userModified":false}}
