SEMBLY\"] },\n    \"HHMM\": { \"type\": \"string\", \"pattern\": \"^([01]\\\\d|2[0-3]):[0-5]\\\\d$\", \"note\": \"24-hour, school timezone\" },\n    \"Period\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\", \"startTime\", \"endTime\", \"kind\", \"order\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 50 },\n        \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n        \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n        \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\" },\n        \"order\": { \"type\": \"integer\" }\n      }\n    },\n    \"SchoolDay\": {\n      \"type\": \"object\",\n      \"required\": [\"dayOfWeek\", \"isTeaching\"],\n      \"properties\": {\n        \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"note\": \"ISO 1=Mon … 7=Sun\" },\n        \"isTeaching\": { \"type\": \"boolean\" }\n      }\n    },\n    \"SchoolDayWithCount\": {\n      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/SchoolDay\" }],\n      \"properties\": { \"slotCount\": { \"type\": \"integer\", \"note\": \"slots on this day across ALL academic years (D3)\" } }\n    },\n    \"TimetableSlot\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"academicYearId\", \"courseId\", \"dayOfWeek\", \"periodId\", \"roomId\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"academicYearId\": { \"type\": \"string\" },\n        \"courseId\": { \"type\": \"string\" },\n        \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },\n        \"periodId\": { \"type\": \"string\" },\n        \"roomId\": { \"type\": [\"string\", \"null\"] }\n      }\n    },\n    \"TimetableSlotExpanded\": {\n      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/TimetableSlot\" }],\n      \"properties\": {\n        \"course\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"id\": { \"type\": \"string\" },\n            \"code\": { \"type\": \"string\" },\n            \"name\": { \"type\": \"string\" },\n            \"sectionId\": { \"type\": [\"string\", \"null\"] },\n            \"subject\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"color\": { \"type\": [\"string\", \"null\"] } } },\n            \"teacher\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" } } },\n            \"section\": { \"type\": [\"object\", \"null\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } }\n          }\n        },\n        \"room\": { \"type\": [\"object\", \"null\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n        \"period\": { \"$ref\": \"#/sharedSchemas/Period\" }\n      }\n    },\n    \"TimetableView\": {\n      \"type\": \"object\",\n      \"required\": [\"periods\", \"days\", \"slots\"],\n      \"note\": \"Everything the grid needs in one response (NFR-2).\",\n      \"properties\": {\n        \"periods\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } },\n        \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDay\" } },\n        \"slots\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } }\n      }\n    },\n    \"Clash\": {\n      \"type\": \"object\",\n      \"required\": [\"rule\", \"message\"],\n      \"properties\": {\n        \"rule\": { \"type\": \"string\", \"enum\": [\"TEACHER\", \"ROOM\", \"SECTION\", \"STUDENT\", \"PERIOD_KIND\", \"NON_TEACHING_DAY\"] },\n        \"message\": { \"type\": \"string\", \"note\": \"exact FR wording, see system-design.md §3.3\" }\n      }\n    },\n    \"Room\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\"],\n      \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"capacity\": { \"type\": [\"integer\", \"null\"] } }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/periods\",\n      \"routeFile\": \"src/app/api/periods/route.ts\",\n      \"description\": \"All periods ordered by `order` ascending.\",\n      \"auth\": \"requireUser (any role)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-33\", \"FR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/periods\",\n      \"routeFile\": \"src/app/api/periods/route.ts\",\n      \"description\": \"Create a period. order = max(order)+1. Rejects endTime <= startTime (Zod) and any overlap with another period (service: \\\"Overlaps '<name>' (<s>–<e>).\\\"). Audited as period.create.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": {\n          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 50 },\n          \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n          \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n          \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\" }\n        },\n        \"zod\": \"periodSchema\"\n      },\n      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/Period\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-5\", \"FR-6\", \"FR-40\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/periods/{id}\",\n      \"routeFile\": \"src/app/api/periods/[id]/route.ts\",\n      \"description\": \"Partial update. The service re-validates end>start and overlap against the merged row (self excluded). Audited as period.update.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"string\" },\n        \"body\": {\n          \"name\": { \"type\": \"string\", \"optional\": true },\n          \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\", \"optional\": true },\n          \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\", \"optional\": true },\n          \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\", \"optional\": true }\n        },\n        \"zod\": \"periodUpdateSchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Period\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-33\", \"FR-6\", \"FR-40\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/periods/{id}\",\n      \"routeFile\": \"src/app/api/periods/[id]/route.ts\",\n      \"description\": \"Delete a period. Refused with 409 if any timetable slot references it. Audited as period.delete.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n      \"errorResponses\": {\n        \"409\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Period has N timetable slots. Remove them first.\", \"details\": { \"slotCount\": \"integer\" } } }\n      },\n      \"errors\": [\"CONFLICT\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-33\", \"FR-8\", \"FR-40\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/periods/reorder\",\n      \"routeFile\": \"src/app/api/periods/reorder/route.ts\",\n      \"description\": \"Set display order from the full id list (index 0 → order 1). The id set must equal the existing set exactly, else 400. Two-phase write in one transaction. Audited as period.reorder.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": { \"periodIds\": { \"type\": \"array\", \"items\": \"string\", \"minItems\": 1, \"uniqueItems\": true } },\n        \"zod\": \"periodReorderSchema\"\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-5\", \"FR-40\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/school-days\",\n      \"routeFile\": \"src/app/api/school-days/route.ts\",\n      \"description\": \"All 7 days, Mon→Sun, each with slotCount (all academic years) so the confirm dialog can show how many slots switching a day off will remove.\",\n      \"auth\": \"requireUser (any role)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDayWithCount\" }, \"length\": 7 } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-34\", \"FR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/school-days\",\n      \"routeFile\": \"src/app/api/school-days/route.ts\",\n      \"description\": \"Replace all 7 teaching flags. In one transaction, deletes every slot (all years) on days switching true→false, then updates the rows. Audited as schoolDay.update { changed, deletedSlotCount }.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": { \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDay\" }, \"length\": 7, \"note\": \"unique dayOfWeek 1–7\" } },\n        \"zod\": \"schoolDaysSchema\"\n      },\n      \"responseSchema\": {\n        \"data\": {\n          \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDayWithCount\" } },\n          \"deletedSlotCount\": \"integer\"\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-34\", \"FR-7\", \"FR-40\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/timetable\",\n      \"routeFile\": \"src/app/api/timetable/route.ts\",\n      \"description\": \"Timetable for one section, teacher or room in one academic year. Teacher view includes co-taught courses. Access via assertCanViewTimetable: ADMIN any view; TEACHER only view=teacher&id=self, or view=section for sections they are homeroom teacher of or teach/co-teach a non-archived course in (D8); everyone else 403.\",\n      \"auth\": \"requireUser + assertCanViewTimetable\",\n      \"requestSchema\": {\n        \"query\": {\n          \"view\": { \"type\": \"string\", \"enum\": [\"section\", \"teacher\", \"room\"] },\n          \"id\": { \"type\": \"string\" },\n          \"academicYearId\": { \"type\": \"string\" }\n        },\n        \"zod\": \"timetableQuerySchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-35\", \"FR-15\", \"FR-16\", \"NFR-2\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/timetable/availability\",\n      \"routeFile\": \"src/app/api/timetable/availability/route.ts\",\n      \"description\": \"Clash preview for dragging a course: for every teaching-day × period cell in the course's academic year, the clash messages that placing it there would produce. Only cells with clashes are returned. The course's own slots are ignored. roomId (D2) enables the ROOM rule for that room; omitted → ROOM rule skipped. Fixed query count (NFR-3).\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"query\": {\n          \"courseId\": { \"type\": \"string\" },\n          \"roomId\": { \"type\": \"string\", \"optional\": true }\n        },\n        \"zod\": \"availabilityQuerySchema\"\n      },\n      \"responseSchema\": {\n        \"data\": {\n          \"type\": \"object\",\n          \"additionalProperties\": { \"type\": \"array\", \"items\": \"string\" },\n          \"keyFormat\": \"<dayOfWeek>-<periodId>\",\n          \"example\": { \"1-clx0p2\": [\"Clash: Mr Smith already teaches MATH-7B on Monday, Period 2.\"] }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-36\", \"FR-19\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/timetable/free-rooms\",\n      \"routeFile\": \"src/app/api/timetable/free-rooms/route.ts\",\n      \"description\": \"Non-archived rooms with no slot at (academicYearId, dayOfWeek, periodId), ordered by name. excludeSlotId keeps the slot's own current room in the list. Added by design decision D1 to resolve intake blocker FR-21.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"query\": {\n          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"coerce\": true },\n          \"periodId\": { \"type\": \"string\" },\n          \"academicYearId\": { \"type\": \"string\" },\n          \"excludeSlotId\": { \"type\": \"string\", \"optional\": true }\n        },\n        \"zod\": \"freeRoomsQuerySchema\"\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Room\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-21\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/timetable/slots\",\n      \"routeFile\": \"src/app/api/timetable/slots/route.ts\",\n      \"description\": \"Place a course in a cell. SERIALIZABLE transaction with retry on P2034: validateSlot runs inside it; any clash → 409 with every clash, nothing saved. academicYearId = course.academicYearId. Archived course or archived roomId → 400. Audited after commit as timetableSlot.create.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": {\n          \"courseId\": { \"type\": \"string\" },\n          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },\n          \"periodId\": { \"type\": \"string\" },\n          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }\n        },\n        \"zod\": \"slotCreateSchema\"\n      },\n      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },\n      \"errorResponses\": {\n        \"409\": {\n          \"error\": {\n            \"code\": \"CONFLICT\",\n            \"message\": \"<first clash message>[ (+N more)]\",\n            \"details\": { \"clashes\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Clash\" } } }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n      \"requirementIds\": [\"FR-37\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-17\", \"FR-20\", \"FR-40\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/timetable/slots/{id}\",\n      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",\n      \"description\": \"Move a slot and/or change its room. The patch is merged over the existing slot and re-validated with the slot itself excluded. A room-only patch (FR-21) uses the same path. Same transaction, 409 shape and audit (timetableSlot.update with from/to) as POST.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"string\" },\n        \"body\": {\n          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"optional\": true },\n          \"periodId\": { \"type\": \"string\", \"optional\": true },\n          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }\n        },\n        \"constraint\": \"at least one key\",\n        \"zod\": \"slotUpdateSchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },\n      \"errorResponses\": { \"409\": \"same as POST /api/timetable/slots\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n      \"requirementIds\": [\"FR-37\", \"FR-14\", \"FR-18\", \"FR-20\", \"FR-21\", \"FR-40\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/timetable/slots/{id}\",\n      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",\n      \"description\": \"Remove a slot. Audited as timetableSlot.delete.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-37\", \"FR-18\", \"FR-40\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/timetable\",\n      \"routeFile\": \"src/app/api/me/timetable/route.ts\",\n      \"description\": \"The caller's personal timetable. TEACHER → own (incl. co-taught). STUDENT → self; a studentId other than self → 403. PARENT → studentId required when >1 linked children, defaults to the only child, must pass assertCanViewStudent else 403. ADMIN → { periods, days, slots: [] } (D5). academicYearId defaults to the current AcademicYear.\",\n      \"auth\": \"requireUser + role-specific checks above\",\n      \"requestSchema\": {\n        \"query\": {\n          \"studentId\": { \"type\": \"string\", \"optional\": true },\n          \"academicYearId\": { \"type\": \"string\", \"optional\": true }\n        },\n        \"zod\": \"meTimetableQuerySchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-38\", \"FR-24\", \"FR-25\", \"FR-27\", \"NFR-7\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    {\n      \"name\": \"getScheduleForDate\",\n      \"module\": \"src/server/timetable/timetable-service.ts\",\n      \"signature\": \"getScheduleForDate(target: { userId: string; role: Role } | { sectionId: string }, date: Date): Promise<{ period: Period; course: TimetableSlotExpanded['course']; room: Room | null }[]>\",\n      \"behaviour\": \"Weekday from SchoolSettings.timezone. [] if the day is not teaching. Ordered by period.order. PARENT target → [].\",\n      \"requirementIds\": [\"FR-30\", \"FR-45\", \"NFR-15\"]\n    },\n    {\n      \"name\": \"getCurrentSlot\",\n      \"module\": \"src/server/timetable/timetable-service.ts\",\n      \"signature\": \"getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null>\",\n      \"behaviour\": \"Entry whose period has startTime <= hhmm < endTime in the school timezone, else null.\",\n      \"requirementIds\": [\"FR-31\", \"FR-45\"]\n    },\n    {\n      \"name\": \"validateSlot\",\n      \"module\": \"src/server/timetable/timetable-service.ts\",\n      \"signature\": \"validateSlot(input: { courseId; dayOfWeek; periodId; roomId: string | null; excludeSlotId?: string }, db?: Prisma.TransactionClient): Promise<Clash[]>\",\n      \"behaviour\": \"Returns ALL clashes; excludeSlotId removes the moving slot from comparison.\",\n      \"requirementIds\": [\"FR-14\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":247,"newStart":1,"newLines":379,"lines":[" {","-  \"ticketId\": \"SH-4\",","-  \"timestamp\": \"2026-11-04T12:30:00Z\",","+  \"ticketId\": \"SH-6\",","+  \"timestamp\": \"2026-11-05T06:20:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\","," ","   \"conventions\": {","-    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-13 forbids renaming routes)\",","+    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-9 forbids renaming routes)\",","     \"successEnvelope\": { \"data\": \"<responseSchema>\" },","-    \"paginatedEnvelope\": { \"data\": \"<item[]>\", \"meta\": { \"page\": \"number\", \"pageSize\": \"number\", \"total\": \"number\" } },","     \"errorEnvelope\": { \"error\": { \"code\": \"string\", \"message\": \"string\", \"details\": \"unknown?\" } },","     \"errorCodes\": {","       \"VALIDATION_ERROR\": 400,","       \"UNAUTHENTICATED\": 401,","       \"FORBIDDEN\": 403,","-      \"NOT_FOUND\": 404","+      \"NOT_FOUND\": 404,","+      \"CONFLICT\": 409","     },","-    \"pagination\": \"?page (default 1) & ?pageSize (default 20, max 100) via the existing parsePagination()\",","-    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody(zod from src/lib/validators/notifications.ts) → service → ok()/paginated(), all from src/server/http.ts. No new error codes.\",","-    \"middleware\": \"src/middleware.ts still returns 401 UNAUTHENTICATED for sessionless /api/* requests. '/api/internal/' is added to PUBLIC_API_PATHS (src/config/public-routes.ts) so cron can reach the dispatch route, where CRON_SECRET is the only gate.\",","-    \"requirementIds\": [\"NFR-8\", \"NFR-11\", \"NFR-13\", \"FR-41\"]","+    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (Zod from src/lib/validators/timetable.ts) → timetable-service → ok(), all from src/server/http.ts. No new error codes. Prisma P2002 (the @@unique backstop) is already mapped to 409 by withHandler.\",","+    \"statusCodes\": \"POST create → 201 via ok(data, { status: 201 }); everything else 200. DELETE returns { data: { id } }.\",","+    \"academicYear\": \"academicYearId is never accepted on slot writes; it is derived from course.academicYearId (FR-37).\",","+    \"requirementIds\": [\"NFR-7\", \"NFR-8\", \"NFR-9\", \"FR-39\"]","   },"," ","   \"sharedSchemas\": {","-    \"Notification\": {","+    \"PeriodKind\": { \"type\": \"string\", \"enum\": [\"CLASS\", \"BREAK\", \"LUNCH\", \"ASSEMBLY\"] },","+    \"HHMM\": { \"type\": \"string\", \"pattern\": \"^([01]\\\\d|2[0-3]):[0-5]\\\\d$\", \"note\": \"24-hour, school timezone\" },","+    \"Period\": {","       \"type\": \"object\",","-      \"required\": [\"id\", \"type\", \"title\", \"body\", \"link\", \"readAt\", \"createdAt\"],","+      \"required\": [\"id\", \"name\", \"startTime\", \"endTime\", \"kind\", \"order\"],","       \"properties\": {","         \"id\": { \"type\": \"string\" },","-        \"type\": { \"type\": \"string\", \"description\": \"key of NOTIFICATION_TYPES\" },","-        \"category\": { \"type\": \"string\", \"enum\": [\"ACCOUNT\", \"ACADEMIC\", \"ATTENDANCE\", \"COMMUNICATION\", \"FINANCE\", \"SYSTEM\"], \"description\": \"derived from the registry and not stored\" },","-        \"title\": { \"type\": \"string\", \"maxLength\": 140 },","-        \"body\": { \"type\": [\"string\", \"null\"], \"maxLength\": 500 },","-        \"link\": { \"type\": [\"string\", \"null\"], \"description\": \"safe relative path (isSafeRelativeLink) or null\" },","-        \"readAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }","-      },","-      \"requirementIds\": [\"FR-1\", \"FR-3\", \"NFR-6\", \"NFR-18\"]","+        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 50 },","+        \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },","+        \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },","+        \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\" },","+        \"order\": { \"type\": \"integer\" }","+      }","     },","-    \"NotificationPreferenceItem\": {","+    \"SchoolDay\": {","       \"type\": \"object\",","-      \"required\": [\"type\", \"label\", \"description\", \"category\", \"inApp\", \"email\", \"mandatoryInApp\"],","+      \"required\": [\"dayOfWeek\", \"isTeaching\"],","       \"properties\": {","-        \"type\": { \"type\": \"string\" },","-        \"label\": { \"type\": \"string\" },","-        \"description\": { \"type\": \"string\" },","-        \"category\": { \"type\": \"string\", \"enum\": [\"ACCOUNT\", \"ACADEMIC\", \"ATTENDANCE\", \"COMMUNICATION\", \"FINANCE\", \"SYSTEM\"] },","-        \"inApp\": { \"type\": \"boolean\", \"description\": \"always true when mandatoryInApp\" },","-        \"email\": { \"type\": \"boolean\" },","-        \"mandatoryInApp\": { \"type\": \"boolean\" }","-      },","-      \"requirementIds\": [\"FR-7\", \"FR-28\", \"FR-29\", \"FR-37\"]","+        \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"note\": \"ISO 1=Mon … 7=Sun\" },","+        \"isTeaching\": { \"type\": \"boolean\" }","+      }","     },","-    \"EmailLogItem\": {","+    \"SchoolDayWithCount\": {","+      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/SchoolDay\" }],","+      \"properties\": { \"slotCount\": { \"type\": \"integer\", \"note\": \"slots on this day across ALL academic years (D3)\" } }","+    },","+    \"TimetableSlot\": {","       \"type\": \"object\",","-      \"description\": \"EmailOutbox row WITHOUT html/text\",","-      \"required\": [\"id\", \"toEmail\", \"toName\", \"subject\", \"status\", \"attempts\", \"lastError\", \"nextAttemptAt\", \"sentAt\", \"createdAt\"],","+      \"required\": [\"id\", \"academicYearId\", \"courseId\", \"dayOfWeek\", \"periodId\", \"roomId\"],","       \"properties\": {","         \"id\": { \"type\": \"string\" },","-        \"toEmail\": { \"type\": \"string\" },","-        \"toName\": { \"type\": [\"string\", \"null\"] },","-        \"subject\": { \"type\": \"string\" },","-        \"status\": { \"type\": \"string\", \"enum\": [\"PENDING\", \"SENDING\", \"SENT\", \"FAILED\"] },","-        \"attempts\": { \"type\": \"integer\" },","-        \"lastError\": { \"type\": [\"string\", \"null\"], \"maxLength\": 1000 },","-        \"nextAttemptAt\": { \"type\": \"string\", \"format\": \"date-time\" },","-        \"sentAt\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },","-        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }","-      },","-      \"requirementIds\": [\"FR-31\", \"FR-39\"]","+        \"academicYearId\": { \"type\": \"string\" },","+        \"courseId\": { \"type\": \"string\" },","+        \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },","+        \"periodId\": { \"type\": \"string\" },","+        \"roomId\": { \"type\": [\"string\", \"null\"] }","+      }","+    },","+    \"TimetableSlotExpanded\": {","+      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/TimetableSlot\" }],","+      \"properties\": {","+        \"course\": {","+          \"type\": \"object\",","+          \"properties\": {","+            \"id\": { \"type\": \"string\" },","+            \"code\": { \"type\": \"string\" },","+            \"name\": { \"type\": \"string\" },","+            \"sectionId\": { \"type\": [\"string\", \"null\"] },","+            \"subject\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"color\": { \"type\": [\"string\", \"null\"] } } },","+            \"teacher\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" } } },","+            \"section\": { \"type\": [\"object\", \"null\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } }","+          }","+        },","+        \"room\": { \"type\": [\"object\", \"null\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },","+        \"period\": { \"$ref\": \"#/sharedSchemas/Period\" }","+      }","+    },","+    \"TimetableView\": {","+      \"type\": \"object\",","+      \"required\": [\"periods\", \"days\", \"slots\"],",