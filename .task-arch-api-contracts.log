points\": [","     {","       \"method\": \"GET\",","-      \"path\": \"/api/auth/csrf\",","-      \"description\": \"Auth.js protocol endpoint, served by the /api/auth/[...nextauth] catch-all (handlers.GET). Returns the CSRF token that signIn()/signOut() use. Public.\",","-      \"auth\": \"public\",","-      \"requestSchema\": {},","-      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"csrfToken\": { \"type\": \"string\" } } },","-      \"envelope\": \"Auth.js native (not the {data} envelope)\",","-      \"requirementIds\": [\"FR-34\", \"NFR-2\"]","+      \"path\": \"/api/notifications\",","+      \"routeFile\": \"src/app/api/notifications/route.ts\",","+      \"description\": \"Paginated list of the caller's own notifications, newest first. 'unread=true' gives readAt IS NULL, and 'category' gives type IN typesInCategory(category).\",","+      \"auth\": \"requireUser\",","+      \"requestSchema\": {","+        \"query\": {","+          \"unread\": { \"type\": \"string\", \"enum\": [\"true\", \"false\"], \"optional\": true },","+          \"category\": { \"type\": \"string\", \"enum\": [\"ACCOUNT\", \"ACADEMIC\", \"ATTENDANCE\", \"COMMUNICATION\", \"FINANCE\", \"SYSTEM\"], \"optional\": true },","+          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },","+          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }","+        }","+      },","+      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Notification\" } }, \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" } },","+      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-34\", \"FR-24\", \"FR-26\", \"NFR-11\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/auth/session\",","-      \"description\": \"Auth.js protocol endpoint (catch-all). Returns the current session or null. Public. Middleware does not gate it.\",","-      \"auth\": \"public\",","+      \"path\": \"/api/notifications/unread-count\",","+      \"routeFile\": \"src/app/api/notifications/unread-count/route.ts\",","+      \"description\": \"Count of the caller's unread notifications. It is index-only on [userId, readAt, createdAt], with a target under 50 ms, and the bell polls it every 30 s while the tab is visible.\",","+      \"auth\": \"requireUser\",","       \"requestSchema\": {},","-      \"responseSchema\": {","-        \"oneOf\": [","-          { \"type\": \"null\" },","-          {","-            \"type\": \"object\",","-            \"properties\": {","-              \"user\": {","-                \"type\": \"object\",","-                \"properties\": {","-                  \"id\": { \"type\": \"string\" },","-                  \"role\": { \"type\": \"string\", \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"] },","-                  \"firstName\": { \"type\": \"string\" },","-                  \"lastName\": { \"type\": \"string\" },","-                  \"email\": { \"type\": \"string\", \"format\": \"email\" }","-                },","-                \"required\": [\"id\", \"role\", \"firstName\", \"lastName\", \"email\"]","-              },","-              \"expires\": { \"type\": \"string\", \"format\": \"date-time\" }","-            }","-          }","-        ]","-      },","-      \"envelope\": \"Auth.js native\",","-      \"requirementIds\": [\"FR-10\", \"FR-34\"]","+      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"count\"], \"properties\": { \"count\": { \"type\": \"integer\", \"minimum\": 0 } } } },","+      \"errors\": [\"UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-35\", \"FR-22\", \"FR-23\", \"NFR-2\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/auth/callback/credentials\",","-      \"description\": \"Auth.js Credentials sign-in (catch-all handlers.POST). Credentials.authorize delegates to authorizeCredentials(): IP rate limit (10 / 5 min) -> trim + lower-case the email -> exactly one bcrypt compare (DUMMY_HASH if the user is missing) -> status/archived/lock checks -> lockout bookkeeping -> audit. On success the jwt callback sets {id, role, firstName, lastName, email, authTime, checkedAt}, maxAge 8h, updateAge 15m. The client calls it through signIn('credentials', {redirect:false}) and reads the error code.\",","-      \"auth\": \"public (Auth.js CSRF token)\",","-      \"requestSchema\": {","-        \"contentType\": \"application/x-www-form-urlencoded\",","-        \"type\": \"object\",","-        \"properties\": {","-          \"email\": { \"type\": \"string\", \"format\": \"email\", \"transform\": \"trim + toLowerCase\" },","-          \"password\": { \"type\": \"string\" },","-          \"csrfToken\": { \"type\": \"string\" },","-          \"callbackUrl\": { \"type\": \"string\", \"note\": \"sanitised by safeCallbackUrl(): only a relative path starting with '/' and not '//' or '/\\\\'; otherwise /dashboard\" }","-        },","-        \"required\": [\"email\", \"password\", \"csrfToken\"]","-      },","-      \"responseSchema\": {","-        \"success\": { \"sets-cookie\": \"authjs.session-token (__Secure- prefix in prod)\", \"url\": \"safeCallbackUrl(callbackUrl)\" },","-        \"failure\": {","-          \"type\": \"object\",","-          \"properties\": {","-            \"error\": { \"const\": \"CredentialsSignin\" },","-            \"code\": {","-              \"type\": \"string\",","-              \"enum\": [\"invalid\", \"disabled\", \"locked:<minutes>\", \"rate_limited\"],","-              \"uiMessages\": {","-                \"invalid\": \"Email or password is incorrect.\",","-                \"disabled\": \"This account is disabled. Contact the school office.\",","-                \"locked:N\": \"This account is temporarily locked. Try again in N minutes.\",","-                \"rate_limited\": \"Too many attempts. Wait a few minutes and try again.\"","-              }","-            }","-          }","-        }","-      },","-      \"sideEffects\": [","-        \"wrong password: failedLoginCount += 1; at 5 -> lockedUntil = now + 15 min, failedLoginCount = 0\",","-        \"success: failedLoginCount = 0, lastLoginAt = now\",","-        \"audit auth.login.success | auth.login.failure {email, reason} | auth.lockout, with the IP from x-forwarded-for\"","-      ],","-      \"envelope\": \"Auth.js native\",","-      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-9\", \"FR-10\", \"FR-30\", \"FR-34\", \"NFR-2\", \"NFR-3\", \"NFR-4\"]","+      \"path\": \"/api/notifications/read-all\",","+      \"routeFile\": \"src/app/api/notifications/read-all/route.ts\",","+      \"description\": \"Sets readAt = now on all of the caller's unread notifications. It is idempotent.\",","+      \"auth\": \"requireUser\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"count\"], \"properties\": { \"count\": { \"type\": \"integer\", \"description\": \"rows updated\" } } } },","+      \"errors\": [\"UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/auth/signout\",","-      \"description\": \"Auth.js sign-out (catch-all). Clears the session cookie. The shell calls it through signOut({redirectTo:'/login'}).\",","-      \"auth\": \"public (Auth.js CSRF token)\",","-      \"requestSchema\": {","-        \"contentType\": \"application/x-www-form-urlencoded\",","-        \"type\": \"object\",","-        \"properties\": { \"csrfToken\": { \"type\": \"string\" }, \"callbackUrl\": { \"type\": \"string\" } },","-        \"required\": [\"csrfToken\"]","-      },","-      \"responseSchema\": { \"url\": \"/login\" },","-      \"envelope\": \"Auth.js native\",","-      \"requirementIds\": [\"FR-32\", \"FR-34\"]","+      \"path\": \"/api/notifications/{id}/read\",","+      \"routeFile\": \"src/app/api/notifications/[id]/read/route.ts\",","+      \"description\": \"Marks one notification read. It runs updateMany({ id, userId: me.id }), and a count of 0 returns 404 NOT_FOUND, so it never reveals other users' rows.\",","+      \"auth\": \"requireUser (owner only)\",","+      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },","+      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\"], \"properties\": { \"id\": { \"type\": \"string\" } } } },","+      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-36\", \"FR-25\", \"FR-26\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/auth/accept-invite\",","-      \"description\": \"Activates an invited account. Flow: verifyToken(token, 'INVITE') -> assertPasswordAllowed -> bcrypt.hash(12) -> one transaction {passwordHash, status=ACTIVE, passwordChangedAt=now} + consumeToken -> audit auth.invite.accepted. It does NOT mint a session: on 200 the client calls signIn('credentials', {email, password, redirectTo:'/dashboard'}). Public via the /api/auth/ prefix and protected by the middleware origin check.\",","-      \"auth\": \"public + origin check\",","-      \"handler\": \"src/app/api/auth/accept-invite/route.ts -> services/auth.acceptInvite\",","+      \"path\": \"/api/notifications/{id}/unread\",","+      \"routeFile\": \"src/app/api/notifications/[id]/unread/route.ts\",","+      \"description\": \"Marks one notification unread (readAt = null). Same owner scoping and 404 rule as /read.\",","+      \"auth\": \"requireUser (owner only)\",","+      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },","+      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\"], \"properties\": { \"id\": { \"type\": \"string\" } } } },","+      \"errors\": [\"UNAUTHENTICATED\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-36\", \"FR-26\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/me/notification-preferences\",","+      \"routeFile\": \"src/app/api/me/notification-preferences/route.ts\",","+      \"description\": \"Returns visibleTypesFor(me.role) (registry types with the caller's role, excluding emailOnly) merged with the caller's NotificationPreference rows through resolvePrefs. It is not paginated because the registry is small.\",","+      \"auth\": \"requireUser\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/NotificationPreferenceItem\" } } },","+      \"errors\": [\"UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-37\", \"FR-7\", \"FR-28\", \"FR-29\"]","+    },","+    {","+      \"method\": \"PUT\",","+      \"path\": \"/api/me/notification-preferences\",","+      \"routeFile\": \"src/app/api/me/notification-preferences/route.ts\",","+      \"description\": \"Upserts one preference on userId_type. It returns VALIDATION_ERROR for an unknown type, an emailOnly type, a type not visible to the caller's role, or inApp=false on a mandatoryInApp type.\",","+      \"auth\": \"requireUser\",","       \"requestSchema\": {","-        \"zod\": \"acceptInviteSchema\",","-        \"type\": \"object\",","-        \"properties\": {","-          \"token\": { \"type\": \"string\", \"description\": \"raw base64url token from /invite/<token>\" },","-          \"password\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"≥1 letter, ≥1 digit, != email, not in common-passwords.txt\" },","-          \"confirm\": { \"type\": \"string\", \"description\": \"must equal password (client and zod refine)\" }","-        },","-        \"required\": [\"token\", \"password\", \"confirm\"]","+        \"body\": {","+          \"type\": \"object\",","+          \"required\": [\"type\", \"inApp\", \"email\"],","+          \"additionalProperties\": false,","+          \"properties\": { \"type\": { \"type\": \"string\" }, \"inApp\": { \"type\": \"boolean\" }, \"email\": { \"type\": \"boolean\" } },","+          \"zod\": \"updatePreferenceBody (src/lib/validators/notifications.ts)\"","+        }","       },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"email\": { \"type\": \"string\", \"format\": \"email\" } }, \"required\": [\"email\"] } },","-        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"password\": [\"string\"], \"confirm\": [\"string\"] } } } },","-        \"403\": { \"error\": { \"code\": \"FORBIDDEN\", \"message\": \"Cross-origin request rejected\" } },","-        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This invitation link is invalid or has expired. Ask the school office to send a new one.\" } }","-      },","-      \"requirementIds\": [\"FR-13\", \"FR-16\", \"FR-17\", \"FR-30\", \"FR-31\", \"FR-37\", \"NFR-1\", \"NFR-2\", \"NFR-8\"]","+      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/NotificationPreferenceItem\" } },","+      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-38\", \"FR-29\", \"FR-30\", \"FR-41\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/auth/forgot-password\",","-      \"description\": \"Requests a password-reset link. Over 10 requests per IP per hour -> 429. Over 3 requests per email per hour -> silent generic 200 (no enumeration). Only an existing ACTIVE user gets createToken(PASSWORD_RESET, 60 min), which invalidates older unused reset tokens, plus sendAuthEmail(user, 'password-reset', link). Unknown or inactive emails write nothing. The response body is always identical.\",","-      \"auth\": \"public + origin check\",","-      \"handler\": \"src/app/api/auth/forgot-password/route.ts -> services/auth.requestPasswordReset\",","+      \"method\": \"GET\",","+      \"path\": \"/api/admin/email-log\",","+      \"routeFile\": \"src/app/api/admin/email-log/route.ts\",","+      \"description\": \"Paginated EmailOutbox rows ordered by createdAt desc, with an optional status filter. The query never selects html or text.\",","+      \"auth\": \"requireRole('ADMIN')\",","       \"requestSchema\": {","-        \"zod\": \"forgotPasswordSchema\",","-        \"type\": \"object\",","-        \"properties\": { \"email\": { \"type\": \"string\", \"format\": \"email\", \"transform\": \"trim + toLowerCase\" } },","-        \"required\": [\"email\"]","+        \"query\": {","+          \"status\": { \"type\": \"string\", \"enum\": [\"PENDING\", \"SENDING\", \"SENT\", \"FAILED\"], \"optional\": true },","+          \"page\": { \"type\": \"integer\", \"minimum\": 1, \"default\": 1 },","+          \"pageSize\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"default\": 20 }","+        }","       },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"message\": { \"const\": \"If an account exists for that email, we've sent a reset link.\" } } } },","-        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"email\": [\"string\"] } } } },","-        \"429\": { \"error\": { \"code\": \"RATE_LIMITED\", \"message\": \"Too many attempts. Wait a few minutes and try again.\" } }","-      },","-      \"requirementIds\": [\"FR-2\", \"FR-13\", \"FR-19\", \"FR-20\", \"FR-22\", \"NFR-2\", \"NFR-3\", \"NFR-8\"]","+      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/EmailLogItem\" } }, \"meta\": { \"page\": \"integer\", \"pageSize\": \"integer\", \"total\": \"integer\" } },","+      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-39\", \"FR-31\", \"NFR-8\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/auth/reset-password\",","-      \"description\": \"Completes a reset. Flow: verifyToken(token, 'PASSWORD_RESET') -> assertPasswordAllowed -> hash -> one transaction {passwordHash, passwordChangedAt=now, failedLoginCount=0, lockedUntil=null} + consumeToken -> audit auth.password.reset. The client then redirects to /login?reset=1, which shows a useToast success toast. Existing sessions are revoked within 5 min by the jwt callback (passwordChangedAt > authTime).\",","-      \"auth\": \"public + origin check\",","-      \"handler\": \"src/app/api/auth/reset-password/route.ts -> services/auth.resetPassword\",","-      \"requestSchema\": {","-        \"zod\": \"resetPasswordSchema\",","-        \"type\": \"object\",","-        \"properties\": {","-          \"token\": { \"type\": \"string\" },","-          \"password\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"same as accept-invite\" },","-          \"confirm\": { \"type\": \"string\" }","-        },","-        \"required\": [\"token\", \"password\", \"confirm\"]","-      },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"ok\": { \"const\": true } } } },","-        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"password\": [\"string\"], \"confirm\": [\"string\"] } } } },","-        \"403\": { \"error\": { \"code\": \"FORBIDDEN\" } },","-        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This reset link is invalid or has expired.\" } }","-      },","-      \"requirementIds\": [\"FR-11\", \"FR-13\", \"FR-17\", \"FR-21\", \"FR-30\", \"FR-31\", \"NFR-1\", \"NFR-2\", \"NFR-8\"]","+      \"path\": \"/api/admin/email-log/{id}/retry\",","+      \"routeFile\": \"src/app/api/admin/email-log/[id]/retry/route.ts\",","+      \"description\": \"Resets a FAILED row with updateMany({ id, status: FAILED }, { attempts: 0, status: PENDING, nextAttemptAt: now, lastError: null }). A count of 0 (missing or not FAILED) returns 404 NOT_FOUND, so a double click is harmless.\",","+      \"auth\": \"requireRole('ADMIN')\",","+      \"requestSchema\": { \"params\": { \"id\": { \"type\": \"string\" } } },","+      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"id\", \"status\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"status\": { \"const\": \"PENDING\" } } } },","+      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],","+      \"requirementIds\": [\"FR-32\", \"FR-39\", \"NFR-8\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/account/password\",","-      \"description\": \"Changes the signed-in user's password. Flow: await requireUser() -> bcrypt-compare currentPassword -> assertPasswordAllowed(newPassword, email) -> hash -> update {passwordHash, passwordChangedAt=now} -> audit auth.password.changed -> unstable_update({reauth:true}), so this session's authTime moves past passwordChangedAt. Other sessions fail the jwt check within 5 min. The UI shows the 'Password updated' toast.\",","-      \"auth\": \"session required (middleware 401 + requireUser())\",","-      \"handler\": \"src/app/api/account/password/route.ts -> services/auth.changePassword\",","-      \"requestSchema\": {","-        \"zod\": \"changePasswordSchema\",","-        \"type\": \"object\",","-        \"properties\": {","-          \"currentPassword\": { \"type\": \"string\" },","-          \"newPassword\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"same as accept-invite\" },","-          \"confirm\": { \"type\": \"string\" }","-        },","-        \"required\": [\"currentPassword\", \"newPassword\", \"confirm\"]","-      },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"ok\": { \"const\": true } } }, \"sets-cookie\": \"re-issued session token\" },","-        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"currentPassword\": [\"Current password is incorrect.\"], \"newPassword\": [\"string\"], \"confirm\": [\"string\"] } } } },","-        \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" } },","-        \"403\": { \"error\": { \"code\": \"FORBIDDEN\", \"message\": \"Cross-origin request rejected\" } }","-      },","-      \"requirementIds\": [\"FR-11\", \"FR-17\", \"FR-23\", \"FR-28\", \"FR-30\", \"FR-31\", \"NFR-2\", \"NFR-7\", \"NFR-8\"]","+      \"path\": \"/api/admin/notifications/test\",","+      \"routeFile\": \"src/app/api/admin/notifications/test/route.ts\",","+      \"description\": \"Calls notify({ type: 'system.test', userIds: [me.id], title: 'Test notification', link: '/dashboard', email: { template: 'generic-notification' } }) for the calling admin. notify() never throws, so the route always returns 200 once auth passes.\",","+      \"auth\": \"requireRole('ADMIN')\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"ok\"], \"properties\": { \"ok\": { \"const\": true } } } },","+      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\"],","+      \"requirementIds\": [\"FR-33\", \"FR-4\", \"FR-6\", \"NFR-8\", \"NFR-16\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/internal/email/dispatch\",","+      \"routeFile\": \"src/app/api/internal/email/dispatch/route.ts\",","+      \"description\": \"The cron entry point. It runs dispatchEmails({ batchSize: 50 }), then the best-effort purgeOldNotifications() at most once per 24 h per process (a purge failure never fails the response). It is public in middleware and gated only by the bearer token.\",","+      \"auth\": \"Authorization: Bearer ${CRON_SECRET}. The token is compared with crypto.timingSafeEqual, and an unset CRON_SECRET or a missing or wrong token returns 401 UNAUTHENTICATED.\",","+      \"requestSchema\": { \"headers\": { \"Authorization\": { \"type\": \"string\", \"pattern\": \"^Bearer .+$\" } } },","+      \"responseSchema\": { \"data\": { \"type\": \"object\", \"required\": [\"sent\", \"failed\", \"retried\"], \"properties\": { \"sent\": { \"type\": \"integer\" }, \"failed\": { \"type\": \"integer\" }, \"retried\": { \"type\": \"integer\" } } } },","+      \"errors\": [\"UNAUTHENTICATED\"],","+      \"requirementIds\": [\"FR-19\", \"FR-17\", \"FR-18\", \"FR-27\", \"NFR-3\", \"NFR-4\", \"NFR-5\", \"NFR-8\"]","     }","   ],"," ","-  \"changedBehaviourOnExistingEndpoints\": {","-    \"description\": \"Every existing route handler (33 route.ts files) changes from requireRole(...) to await requireRole(...), backed by the real session. Paths, request shapes and response shapes don't change. New possible responses on all of them:\",","-    \"responses\": {","-      \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" }, \"source\": \"middleware (no session) or requireUser/requireRole (session revoked)\" },","-      \"403\": { \"error\": { \"code\": \"FORBIDDEN\" }, \"source\": \"requireRole role mismatch, or the middleware cross-origin check on mutations\" }","+  \"nonHttpContracts\": [","+    {","+      \"name\": \"notify\",","+      \"module\": \"src/server/notifications/notify.ts\",","+      \"signature\": \"notify(input: { type: NotificationType; userIds: string[]; title: string; body?: string; link?: string; email?: { subject?: string; template: 'generic-notification'; data: Record<string, unknown> } }): Promise<void>\",","+      \"notes\": \"It never throws (FR-11). Call it after the caller's transaction commits. It truncates the title to 140 and the body to 500, and it drops an unsafe link.\",","+      \"requirementIds\": [\"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-9\", \"FR-10\", \"FR-11\", \"NFR-1\", \"NFR-6\", \"NFR-18\"]","     },","-    \"unchanged\": [\"/api/health stays public\"],","-    \"requirementIds\": [\"FR-12\", \"FR-28\", \"FR-29\", \"NFR-7\", \"NFR-9\"]","-  },","-","-  \"explicitlyAbsent\": [","-    { \"item\": \"No sign-up / register endpoint\", \"requirementIds\": [\"FR-37\"] },","-    { \"item\": \"No admin user-management, SSO, MFA or magic-link endpoints\", \"requirementIds\": [\"NFR-11\"] },","-    { \"item\": \"No /api/v1 prefix; existing /api convention kept\", \"requirementIds\": [\"NFR-9\"] }","+    {","+      \"name\": \"notifyStudentAndParents\",","+      \"module\": \"src/server/notifications/notify.ts\",","+      \"signature\": \"notifyStudentAndParents(input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] }): Promise<void>\",","+      \"requirementIds\": [\"FR-12\", \"NFR-14\"]","+    },","+    {","+      \"name\": \"dispatchEmails\",","+      \"module\": \"src/server/email/dispatch.ts\",","+      \"signature\": \"dispatchEmails(opts?: { batchSize?: number }): Promise<{ sent: number; failed: number; retried: number }>\",","+      \"notes\": \"Used by the dispatch route and scripts/worker-email.ts (15 s loop).\",","+      \"requirementIds\": [\"FR-17\", \"FR-18\", \"FR-20\", \"NFR-4\", \"NFR-5\"]","+    },","+    {","+      \"name\": \"sendAuthEmail\",","+      \"module\": \"src/server/auth/email.ts\",","+      \"signature\": \"unchanged; the body now renders invite/password-reset and calls enqueueEmail(). It still throws on failure.\",","+      \"requirementIds\": [\"FR-16\", \"FR-4\"]","+    }","   ],"," ","   \"status\": \"complete\""]}],"originalFile":"{\n  \"ticketId\": \"abcd-1\",\n  \"timestamp\": \"2026-11-04T00:03:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention; no /api/v1 prefix - NFR-9 forbids renaming routes)\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"errorEnvelope\": { \"error\": { \"code\": \"string\", \"message\": \"string\", \"details\": \"object?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"INVALID_TOKEN\": 410,\n      \"RATE_LIMITED\": 429\n    },\n    \"handlerPattern\": \"withHandler(parseBody(zodSchema) -> service -> ok()) from src/server/http.ts\",\n    \"csrf\": \"src/middleware.ts rejects non-GET/HEAD /api/* requests whose Origin header is present and differs from the app origin (403 FORBIDDEN). The Auth.js endpoints also use their own CSRF token. Session cookie: HttpOnly, SameSite=Lax, Secure in prod.\",\n    \"unauthenticatedApi\": \"src/middleware.ts returns 401 UNAUTHENTICATED for /api/* outside PUBLIC_API_PATHS ['/api/health', '/api/auth/']\",\n    \"requirementIds\": [\"NFR-2\", \"NFR-8\", \"NFR-9\", \"FR-12\"]\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/auth/csrf\",\n      \"description\": \"Auth.js protocol endpoint, served by the /api/auth/[...nextauth] catch-all (handlers.GET). Returns the CSRF token that signIn()/signOut() use. Public.\",\n      \"auth\": \"public\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"type\": \"object\", \"properties\": { \"csrfToken\": { \"type\": \"string\" } } },\n      \"envelope\": \"Auth.js native (not the {data} envelope)\",\n      \"requirementIds\": [\"FR-34\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/auth/session\",\n      \"description\": \"Auth.js protocol endpoint (catch-all). Returns the current session or null. Public. Middleware does not gate it.\",\n      \"auth\": \"public\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"oneOf\": [\n          { \"type\": \"null\" },\n          {\n            \"type\": \"object\",\n            \"properties\": {\n              \"user\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"id\": { \"type\": \"string\" },\n                  \"role\": { \"type\": \"string\", \"enum\": [\"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"] },\n                  \"firstName\": { \"type\": \"string\" },\n                  \"lastName\": { \"type\": \"string\" },\n                  \"email\": { \"type\": \"string\", \"format\": \"email\" }\n                },\n                \"required\": [\"id\", \"role\", \"firstName\", \"lastName\", \"email\"]\n              },\n              \"expires\": { \"type\": \"string\", \"format\": \"date-time\" }\n            }\n          }\n        ]\n      },\n      \"envelope\": \"Auth.js native\",\n      \"requirementIds\": [\"FR-10\", \"FR-34\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/callback/credentials\",\n      \"description\": \"Auth.js Credentials sign-in (catch-all handlers.POST). Credentials.authorize delegates to authorizeCredentials(): IP rate limit (10 / 5 min) -> trim + lower-case the email -> exactly one bcrypt compare (DUMMY_HASH if the user is missing) -> status/archived/lock checks -> lockout bookkeeping -> audit. On success the jwt callback sets {id, role, firstName, lastName, email, authTime, checkedAt}, maxAge 8h, updateAge 15m. The client calls it through signIn('credentials', {redirect:false}) and reads the error code.\",\n      \"auth\": \"public (Auth.js CSRF token)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/x-www-form-urlencoded\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"email\": { \"type\": \"string\", \"format\": \"email\", \"transform\": \"trim + toLowerCase\" },\n          \"password\": { \"type\": \"string\" },\n          \"csrfToken\": { \"type\": \"string\" },\n          \"callbackUrl\": { \"type\": \"string\", \"note\": \"sanitised by safeCallbackUrl(): only a relative path starting with '/' and not '//' or '/\\\\'; otherwise /dashboard\" }\n        },\n        \"required\": [\"email\", \"password\", \"csrfToken\"]\n      },\n      \"responseSchema\": {\n        \"success\": { \"sets-cookie\": \"authjs.session-token (__Secure- prefix in prod)\", \"url\": \"safeCallbackUrl(callbackUrl)\" },\n        \"failure\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"error\": { \"const\": \"CredentialsSignin\" },\n            \"code\": {\n              \"type\": \"string\",\n              \"enum\": [\"invalid\", \"disabled\", \"locked:<minutes>\", \"rate_limited\"],\n              \"uiMessages\": {\n                \"invalid\": \"Email or password is incorrect.\",\n                \"disabled\": \"This account is disabled. Contact the school office.\",\n                \"locked:N\": \"This account is temporarily locked. Try again in N minutes.\",\n                \"rate_limited\": \"Too many attempts. Wait a few minutes and try again.\"\n              }\n            }\n          }\n        }\n      },\n      \"sideEffects\": [\n        \"wrong password: failedLoginCount += 1; at 5 -> lockedUntil = now + 15 min, failedLoginCount = 0\",\n        \"success: failedLoginCount = 0, lastLoginAt = now\",\n        \"audit auth.login.success | auth.login.failure {email, reason} | auth.lockout, with the IP from x-forwarded-for\"\n      ],\n      \"envelope\": \"Auth.js native\",\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"FR-5\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-9\", \"FR-10\", \"FR-30\", \"FR-34\", \"NFR-2\", \"NFR-3\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/signout\",\n      \"description\": \"Auth.js sign-out (catch-all). Clears the session cookie. The shell calls it through signOut({redirectTo:'/login'}).\",\n      \"auth\": \"public (Auth.js CSRF token)\",\n      \"requestSchema\": {\n        \"contentType\": \"application/x-www-form-urlencoded\",\n        \"type\": \"object\",\n        \"properties\": { \"csrfToken\": { \"type\": \"string\" }, \"callbackUrl\": { \"type\": \"string\" } },\n        \"required\": [\"csrfToken\"]\n      },\n      \"responseSchema\": { \"url\": \"/login\" },\n      \"envelope\": \"Auth.js native\",\n      \"requirementIds\": [\"FR-32\", \"FR-34\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/accept-invite\",\n      \"description\": \"Activates an invited account. Flow: verifyToken(token, 'INVITE') -> assertPasswordAllowed -> bcrypt.hash(12) -> one transaction {passwordHash, status=ACTIVE, passwordChangedAt=now} + consumeToken -> audit auth.invite.accepted. It does NOT mint a session: on 200 the client calls signIn('credentials', {email, password, redirectTo:'/dashboard'}). Public via the /api/auth/ prefix and protected by the middleware origin check.\",\n      \"auth\": \"public + origin check\",\n      \"handler\": \"src/app/api/auth/accept-invite/route.ts -> services/auth.acceptInvite\",\n      \"requestSchema\": {\n        \"zod\": \"acceptInviteSchema\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"token\": { \"type\": \"string\", \"description\": \"raw base64url token from /invite/<token>\" },\n          \"password\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"≥1 letter, ≥1 digit, != email, not in common-passwords.txt\" },\n          \"confirm\": { \"type\": \"string\", \"description\": \"must equal password (client and zod refine)\" }\n        },\n        \"required\": [\"token\", \"password\", \"confirm\"]\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"email\": { \"type\": \"string\", \"format\": \"email\" } }, \"required\": [\"email\"] } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"password\": [\"string\"], \"confirm\": [\"string\"] } } } },\n        \"403\": { \"error\": { \"code\": \"FORBIDDEN\", \"message\": \"Cross-origin request rejected\" } },\n        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This invitation link is invalid or has expired. Ask the school office to send a new one.\" } }\n      },\n      \"requirementIds\": [\"FR-13\", \"FR-16\", \"FR-17\", \"FR-30\", \"FR-31\", \"FR-37\", \"NFR-1\", \"NFR-2\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/forgot-password\",\n      \"description\": \"Requests a password-reset link. Over 10 requests per IP per hour -> 429. Over 3 requests per email per hour -> silent generic 200 (no enumeration). Only an existing ACTIVE user gets createToken(PASSWORD_RESET, 60 min), which invalidates older unused reset tokens, plus sendAuthEmail(user, 'password-reset', link). Unknown or inactive emails write nothing. The response body is always identical.\",\n      \"auth\": \"public + origin check\",\n      \"handler\": \"src/app/api/auth/forgot-password/route.ts -> services/auth.requestPasswordReset\",\n      \"requestSchema\": {\n        \"zod\": \"forgotPasswordSchema\",\n        \"type\": \"object\",\n        \"properties\": { \"email\": { \"type\": \"string\", \"format\": \"email\", \"transform\": \"trim + toLowerCase\" } },\n        \"required\": [\"email\"]\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"message\": { \"const\": \"If an account exists for that email, we've sent a reset link.\" } } } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"email\": [\"string\"] } } } },\n        \"429\": { \"error\": { \"code\": \"RATE_LIMITED\", \"message\": \"Too many attempts. Wait a few minutes and try again.\" } }\n      },\n      \"requirementIds\": [\"FR-2\", \"FR-13\", \"FR-19\", \"FR-20\", \"FR-22\", \"NFR-2\", \"NFR-3\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/auth/reset-password\",\n      \"description\": \"Completes a reset. Flow: verifyToken(token, 'PASSWORD_RESET') -> assertPasswordAllowed -> hash -> one transaction {passwordHash, passwordChangedAt=now, failedLoginCount=0, lockedUntil=null} + consumeToken -> audit auth.password.reset. The client then redirects to /login?reset=1, which shows a useToast success toast. Existing sessions are revoked within 5 min by the jwt callback (passwordChangedAt > authTime).\",\n      \"auth\": \"public + origin check\",\n      \"handler\": \"src/app/api/auth/reset-password/route.ts -> services/auth.resetPassword\",\n      \"requestSchema\": {\n        \"zod\": \"resetPasswordSchema\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"token\": { \"type\": \"string\" },\n          \"password\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"same as accept-invite\" },\n          \"confirm\": { \"type\": \"string\" }\n        },\n        \"required\": [\"token\", \"password\", \"confirm\"]\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"ok\": { \"const\": true } } } },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"password\": [\"string\"], \"confirm\": [\"string\"] } } } },\n        \"403\": { \"error\": { \"code\": \"FORBIDDEN\" } },\n        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This reset link is invalid or has expired.\" } }\n      },\n      \"requirementIds\": [\"FR-11\", \"FR-13\", \"FR-17\", \"FR-21\", \"FR-30\", \"FR-31\", \"NFR-1\", \"NFR-2\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/account/password\",\n      \"description\": \"Changes the signed-in user's password. Flow: await requireUser() -> bcrypt-compare currentPassword -> assertPasswordAllowed(newPassword, email) -> hash -> update {passwordHash, passwordChangedAt=now} -> audit auth.password.changed -> unstable_update({reauth:true}), so this session's authTime moves past passwordChangedAt. Other sessions fail the jwt check within 5 min. The UI shows the 'Password updated' toast.\",\n      \"auth\": \"session required (middleware 401 + requireUser())\",\n      \"handler\": \"src/app/api/account/password/route.ts -> services/auth.changePassword\",\n      \"requestSchema\": {\n        \"zod\": \"changePasswordSchema\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"currentPassword\": { \"type\": \"string\" },\n          \"newPassword\": { \"type\": \"string\", \"minLength\": 10, \"maxLength\": 128, \"policy\": \"same as accept-invite\" },\n          \"confirm\": { \"type\": \"string\" }\n        },\n        \"required\": [\"currentPassword\", \"newPassword\", \"confirm\"]\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"type\": \"object\", \"properties\": { \"ok\": { \"const\": true } } }, \"sets-cookie\": \"re-issued session token\" },\n        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"fieldErrors\": { \"currentPassword\": [\"Current password is incorrect.\"], \"newPassword\": [\"string\"], \"confirm\": [\"string\"] } } } },\n        \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" } },\n        \"403\": { \"error\": { \"code\": \"FORBIDDEN\", \"message\": \"Cross-origin request rejected\" } }\n      },\n      \"requirementIds\": [\"FR-11\", \"FR-17\", \"FR-23\", \"FR-28\", \"FR-30\", \"FR-31\", \"NFR-2\", \"NFR-7\", \"NFR-8\"]\n    }\n  ],\n\n  \"changedBehaviourOnExistingEndpoints\": {\n    \"description\": \"Every existing route handler (33 route.ts files) changes from requireRole(...) to await requireRole(...), backed by the real session. Paths, request shapes and response shapes don't change. New possible responses on all of them:\",\n    \"responses\": {\n      \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" }, \"source\": \"middleware (no session) or requireUser/requireRole (session revoked)\" },\n      \"403\": { \"error\": { \"code\": \"FORBIDDEN\" }, \"source\": \"requireRole role mismatch, or the middleware cross-origin check on mutations\" }\n    },\n    \"unchanged\": [\"/api/health stays public\"],\n    \"requirementIds\": [\"FR-12\", \"FR-28\", \"FR-29\", \"NFR-7\", \"NFR-9\"]\n  },\n\n  \"explicitlyAbsent\": [\n    { \"item\": \"No sign-up / register endpoint\", \"requirementIds\": [\"FR-37\"] },\n    { \"item\": \"No admin user-management, SSO, MFA or magic-link endpoints\", \"requirementIds\": [\"NFR-11\"] },\n    { \"item\": \"No /api/v1 prefix; existing /api convention kept\", \"requirementIds\": [\"NFR-9\"] }\n  ],\n\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_019PDQTfeQKBh5dLwKxsgWNq","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
