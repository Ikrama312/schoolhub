} }","+      },","+      \"requirementIds\": [\"FR-12\", \"FR-15\", \"FR-19\", \"FR-10\", \"NFR-1\", \"NFR-8\", \"NFR-10\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/timetable/availability\",","-      \"routeFile\": \"src/app/api/timetable/availability/route.ts\",","-      \"description\": \"Clash preview for dragging a course: for every teaching-day × period cell in the course's academic year, the clash messages that placing it there would produce. Only cells with clashes are returned. The course's own slots are ignored. roomId (D2) enables the ROOM rule for that room; omitted → ROOM rule skipped. Fixed query count (NFR-3).\",","-      \"auth\": \"requireRole('ADMIN')\",","+      \"method\": \"POST\",","+      \"path\": \"/api/auth/accept-invite\",","+      \"description\": \"Activate an invited account (C4 /invite/[token]). verifyToken(INVITE) → policy → bcrypt 12 → transaction(consume token, set hash, status=ACTIVE, passwordChangedAt=now) → audit auth.invite.accepted. Does NOT create a session: the client then calls signIn('credentials') with the returned email and the password just set, and goes to /dashboard. On 410 the PAGE renders the FR-13 copy ('This invitation link is invalid or has expired. Ask the school office to send a new one.'), not the service message.\",","+      \"auth\": \"public (token-gated)\",","       \"requestSchema\": {","-        \"query\": {","-          \"courseId\": { \"type\": \"string\" },","-          \"roomId\": { \"type\": \"string\", \"optional\": true }","-        },","-        \"zod\": \"availabilityQuerySchema\"","+        \"contentType\": \"application/json\",","+        \"zod\": \"acceptInviteSchema\",","+        \"type\": \"object\",","+        \"required\": [\"token\", \"password\", \"confirm\"],","+        \"properties\": {","+          \"token\": { \"type\": \"string\", \"minLength\": 1 },","+          \"password\": { \"$ref\": \"#/sharedSchemas/NewPassword\" },","+          \"confirm\": { \"type\": \"string\" }","+        }","       },","       \"responseSchema\": {","-        \"data\": {","-          \"type\": \"object\",","-          \"additionalProperties\": { \"type\": \"array\", \"items\": \"string\" },","-          \"keyFormat\": \"<dayOfWeek>-<periodId>\",","-          \"example\": { \"1-clx0p2\": [\"Clash: Mr Smith already teaches MATH-7B on Monday, Period 2.\"] }","-        }","+        \"200\": { \"data\": { \"type\": \"object\", \"required\": [\"email\"], \"properties\": { \"email\": { \"$ref\": \"#/sharedSchemas/Email\" } } } },","+        \"400\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"$ref\": \"#/sharedSchemas/FieldErrors\" } } },","+        \"410\": { \"error\": { \"code\": \"INVALID_TOKEN\", \"message\": \"This link is invalid or has expired.\" } }","       },","-      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-36\", \"FR-19\", \"NFR-3\"]","+      \"requirementIds\": [\"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"NFR-1\", \"NFR-8\", \"NFR-10\", \"NFR-14\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/timetable/free-rooms\",","-      \"routeFile\": \"src/app/api/timetable/free-rooms/route.ts\",","-      \"description\": \"Non-archived rooms with no slot at (academicYearId, dayOfWeek, periodId), ordered by name. excludeSlotId keeps the slot's own current room in the list. Added by design decision D1 to resolve intake blocker FR-21.\",","-      \"auth\": \"requireRole('ADMIN')\",","-      \"requestSchema\": {","-        \"query\": {","-          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"coerce\": true },","-          \"periodId\": { \"type\": \"string\" },","-          \"academicYearId\": { \"type\": \"string\" },","-          \"excludeSlotId\": { \"type\": \"string\", \"optional\": true }","-        },","-        \"zod\": \"freeRoomsQuerySchema\"","-      },","-      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Room\" } } },","-      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],","-      \"requirementIds\": [\"FR-21\"]","-    },","-    {","       \"method\": \"POST\",","-      \"path\": \"/api/timetable/slots\",","-      \"routeFile\": \"src/app/api/timetable/slots/route.ts\",","-      \"description\": \"Place a course in a cell. SERIALIZABLE transaction with retry on P2034: validateSlot runs inside it; any clash → 409 with every clash, nothing saved. academicYearId = course.academicYearId. Archived course or archived roomId → 400. Audited after commit as timetableSlot.create.\",","-      \"auth\": \"requireRole('ADMIN')\",","+      \"path\": \"/api/account/password\",","+      \"description\": \"Signed-in password change (C5 /account/security). requireUser → changePasswordSchema → bcrypt compare current → policy → update hash + passwordChangedAt → audit auth.password.changed → unstable_update({ reauth: true }) re-issues THIS session so only other sessions are revoked (within 5 min). Success → useToast 'Password updated'.\",","+      \"auth\": \"session required (requireUser; middleware returns 401 UNAUTHENTICATED JSON without a session)\",","       \"requestSchema\": {","-        \"body\": {","-          \"courseId\": { \"type\": \"string\" },","-          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },","-          \"periodId\": { \"type\": \"string\" },","-          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }","-        },","-        \"zod\": \"slotCreateSchema\"","-      },","-      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },","-      \"errorResponses\": {","-        \"409\": {","-          \"error\": {","-            \"code\": \"CONFLICT\",","-            \"message\": \"<first clash message>[ (+N more)]\",","-            \"details\": { \"clashes\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Clash\" } } }","-          }","+        \"contentType\": \"application/json\",","+        \"zod\": \"changePasswordSchema\",","+        \"type\": \"object\",","+        \"required\": [\"currentPassword\", \"newPassword\", \"confirm\"],","+        \"properties\": {","+          \"currentPassword\": { \"type\": \"string\", \"minLength\": 1 },","+          \"newPassword\": { \"$ref\": \"#/sharedSchemas/NewPassword\" },","+          \"confirm\": { \"type\": \"string\" }","         }","       },","-      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],","-      \"requirementIds\": [\"FR-37\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-17\", \"FR-20\", \"FR-40\", \"NFR-1\"]","-    },","-    {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/timetable/slots/{id}\",","-      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",","-      \"description\": \"Move a slot and/or change its room. The patch is merged over the existing slot and re-validated with the slot itself excluded. A room-only patch (FR-21) uses the same path. Same transaction, 409 shape and audit (timetableSlot.update with from/to) as POST.\",","-      \"auth\": \"requireRole('ADMIN')\",","-      \"requestSchema\": {","-        \"params\": { \"id\": \"string\" },","-        \"body\": {","-          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"optional\": true },","-          \"periodId\": { \"type\": \"string\", \"optional\": true },","-          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }","+      \"responseSchema\": {","+        \"200\": { \"data\": { \"$ref\": \"#/sharedSchemas/Ok\" } },","+        \"400\": {","+          \"error\": { \"code\": \"VALIDATION_ERROR\", \"details\": { \"$ref\": \"#/sharedSchemas/FieldErrors\" } },","+          \"cases\": {","+            \"wrongCurrent\": \"{ message: 'Current password is incorrect.', details: { fieldErrors: { currentPassword: ['Current password is incorrect.'] } } }\",","+            \"policyFailure\": \"details.fieldErrors.password (NOT newPassword) — assertPasswordAllowed hard-codes the `password` key. ChangePasswordForm must remap password → newPassword before applyFieldErrors(), or the error renders nowhere. Client-side Zod already catches all rules except common-password, so this case only appears for common passwords.\"","+          }","         },","-        \"constraint\": \"at least one key\",","-        \"zod\": \"slotUpdateSchema\"","+        \"401\": { \"error\": { \"code\": \"UNAUTHENTICATED\" } }","       },","-      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },","-      \"errorResponses\": { \"409\": \"same as POST /api/timetable/slots\" },","-      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],","-      \"requirementIds\": [\"FR-37\", \"FR-14\", \"FR-18\", \"FR-20\", \"FR-21\", \"FR-40\", \"NFR-1\"]","-    },","-    {","-      \"method\": \"DELETE\",","-      \"path\": \"/api/timetable/slots/{id}\",","-      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",","-      \"description\": \"Remove a slot. Audited as timetableSlot.delete.\",","-      \"auth\": \"requireRole('ADMIN')\",","-      \"requestSchema\": { \"params\": { \"id\": \"string\" } },","-      \"responseSchema\": { \"data\": { \"id\": \"string\" } },","-      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],","-      \"requirementIds\": [\"FR-37\", \"FR-18\", \"FR-40\"]","-    },","-    {","-      \"method\": \"GET\",","-      \"path\": \"/api/me/timetable\",","-      \"routeFile\": \"src/app/api/me/timetable/route.ts\",","-      \"description\": \"The caller's personal timetable. TEACHER → own (incl. co-taught). STUDENT → self; a studentId other than self → 403. PARENT → studentId required when >1 linked children, defaults to the only child, must pass assertCanViewStudent else 403. ADMIN → { periods, days, slots: [] } (D5). academicYearId defaults to the current AcademicYear.\",","-      \"auth\": \"requireUser + role-specific checks above\",","-      \"requestSchema\": {","-        \"query\": {","-          \"studentId\": { \"type\": \"string\", \"optional\": true },","-          \"academicYearId\": { \"type\": \"string\", \"optional\": true }","-        },","-        \"zod\": \"meTimetableQuerySchema\"","-      },","-      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },","-      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],","-      \"requirementIds\": [\"FR-38\", \"FR-24\", \"FR-25\", \"FR-27\", \"NFR-7\"]","+      \"requirementIds\": [\"FR-10\", \"FR-15\", \"FR-20\", \"FR-23\", \"NFR-9\", \"NFR-10\", \"NFR-11\"]","     }","   ],"," ","-  \"nonHttpContracts\": [","-    {","-      \"name\": \"getScheduleForDate\",","-      \"module\": \"src/server/timetable/timetable-service.ts\",","-      \"signature\": \"getScheduleForDate(target: { userId: string; role: Role } | { sectionId: string }, date: Date): Promise<{ period: Period; course: TimetableSlotExpanded['course']; room: Room | null }[]>\",","-      \"behaviour\": \"Weekday from SchoolSettings.timezone. [] if the day is not teaching. Ordered by period.order. PARENT target → [].\",","-      \"requirementIds\": [\"FR-30\", \"FR-45\", \"NFR-15\"]","-    },","-    {","-      \"name\": \"getCurrentSlot\",","-      \"module\": \"src/server/timetable/timetable-service.ts\",","-      \"signature\": \"getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null>\",","-      \"behaviour\": \"Entry whose period has startTime <= hhmm < endTime in the school timezone, else null.\",","-      \"requirementIds\": [\"FR-31\", \"FR-45\"]","-    },","-    {","-      \"name\": \"validateSlot\",","-      \"module\": \"src/server/timetable/timetable-service.ts\",","-      \"signature\": \"validateSlot(input: { courseId; dayOfWeek; periodId; roomId: string | null; excludeSlotId?: string }, db?: Prisma.TransactionClient): Promise<Clash[]>\",","-      \"behaviour\": \"Returns ALL clashes; excludeSlotId removes the moving slot from comparison.\",","-      \"requirementIds\": [\"FR-14\"]","-    }","+  \"unauthenticatedBehaviour\": {","+    \"description\": \"middleware.ts (existing): unauthenticated /api/* requests other than /api/health, /api/auth/* and public-routes.ts paths return 401 { error: { code: 'UNAUTHENTICATED' } }; unauthenticated (app) page requests redirect to /login?callbackUrl=<path>.\",","+    \"requirementIds\": [\"FR-11\", \"NFR-9\"]","+  },","+","+  \"designCorrections\": [","+    \"system-design.md C3 posts `confirmPassword`; the real field is `confirm` (resetPasswordSchema / acceptInviteSchema / changePasswordSchema).\",","+    \"system-design.md R3 says INVALID_TOKEN is 400; src/server/http.ts maps it to 410.\",","+    \"system-design.md C5 doesn't cover common-password errors on /api/account/password: they arrive under fieldErrors.password and must be remapped to newPassword on the client. Fix this in ChangePasswordForm, not in the service (NFR-13).\"","   ],"," ","   \"status\": \"complete\""]}],"originalFile":"{\n  \"ticketId\": \"SH-6\",\n  \"timestamp\": \"2026-11-05T06:20:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"basePath\": \"/api (existing project convention, no /api/v1 prefix; NFR-9 forbids renaming routes)\",\n    \"successEnvelope\": { \"data\": \"<responseSchema>\" },\n    \"errorEnvelope\": { \"error\": { \"code\": \"string\", \"message\": \"string\", \"details\": \"unknown?\" } },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409\n    },\n    \"handlerPattern\": \"withHandler → requireUser/requireRole → parseQuery/parseBody (Zod from src/lib/validators/timetable.ts) → timetable-service → ok(), all from src/server/http.ts. No new error codes. Prisma P2002 (the @@unique backstop) is already mapped to 409 by withHandler.\",\n    \"statusCodes\": \"POST create → 201 via ok(data, { status: 201 }); everything else 200. DELETE returns { data: { id } }.\",\n    \"academicYear\": \"academicYearId is never accepted on slot writes; it is derived from course.academicYearId (FR-37).\",\n    \"requirementIds\": [\"NFR-7\", \"NFR-8\", \"NFR-9\", \"FR-39\"]\n  },\n\n  \"sharedSchemas\": {\n    \"PeriodKind\": { \"type\": \"string\", \"enum\": [\"CLASS\", \"BREAK\", \"LUNCH\", \"ASSEMBLY\"] },\n    \"HHMM\": { \"type\": \"string\", \"pattern\": \"^([01]\\\\d|2[0-3]):[0-5]\\\\d$\", \"note\": \"24-hour, school timezone\" },\n    \"Period\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\", \"startTime\", \"endTime\", \"kind\", \"order\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 50 },\n        \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n        \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n        \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\" },\n        \"order\": { \"type\": \"integer\" }\n      }\n    },\n    \"SchoolDay\": {\n      \"type\": \"object\",\n      \"required\": [\"dayOfWeek\", \"isTeaching\"],\n      \"properties\": {\n        \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"note\": \"ISO 1=Mon … 7=Sun\" },\n        \"isTeaching\": { \"type\": \"boolean\" }\n      }\n    },\n    \"SchoolDayWithCount\": {\n      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/SchoolDay\" }],\n      \"properties\": { \"slotCount\": { \"type\": \"integer\", \"note\": \"slots on this day across ALL academic years (D3)\" } }\n    },\n    \"TimetableSlot\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"academicYearId\", \"courseId\", \"dayOfWeek\", \"periodId\", \"roomId\"],\n      \"properties\": {\n        \"id\": { \"type\": \"string\" },\n        \"academicYearId\": { \"type\": \"string\" },\n        \"courseId\": { \"type\": \"string\" },\n        \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },\n        \"periodId\": { \"type\": \"string\" },\n        \"roomId\": { \"type\": [\"string\", \"null\"] }\n      }\n    },\n    \"TimetableSlotExpanded\": {\n      \"allOf\": [{ \"$ref\": \"#/sharedSchemas/TimetableSlot\" }],\n      \"properties\": {\n        \"course\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"id\": { \"type\": \"string\" },\n            \"code\": { \"type\": \"string\" },\n            \"name\": { \"type\": \"string\" },\n            \"sectionId\": { \"type\": [\"string\", \"null\"] },\n            \"subject\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"color\": { \"type\": [\"string\", \"null\"] } } },\n            \"teacher\": { \"type\": \"object\", \"properties\": { \"id\": { \"type\": \"string\" }, \"firstName\": { \"type\": \"string\" }, \"lastName\": { \"type\": \"string\" } } },\n            \"section\": { \"type\": [\"object\", \"null\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } }\n          }\n        },\n        \"room\": { \"type\": [\"object\", \"null\"], \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" } } },\n        \"period\": { \"$ref\": \"#/sharedSchemas/Period\" }\n      }\n    },\n    \"TimetableView\": {\n      \"type\": \"object\",\n      \"required\": [\"periods\", \"days\", \"slots\"],\n      \"note\": \"Everything the grid needs in one response (NFR-2).\",\n      \"properties\": {\n        \"periods\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } },\n        \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDay\" } },\n        \"slots\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } }\n      }\n    },\n    \"Clash\": {\n      \"type\": \"object\",\n      \"required\": [\"rule\", \"message\"],\n      \"properties\": {\n        \"rule\": { \"type\": \"string\", \"enum\": [\"TEACHER\", \"ROOM\", \"SECTION\", \"STUDENT\", \"PERIOD_KIND\", \"NON_TEACHING_DAY\"] },\n        \"message\": { \"type\": \"string\", \"note\": \"exact FR wording, see system-design.md §3.3\" }\n      }\n    },\n    \"Room\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\"],\n      \"properties\": { \"id\": { \"type\": \"string\" }, \"name\": { \"type\": \"string\" }, \"capacity\": { \"type\": [\"integer\", \"null\"] } }\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/periods\",\n      \"routeFile\": \"src/app/api/periods/route.ts\",\n      \"description\": \"All periods ordered by `order` ascending.\",\n      \"auth\": \"requireUser (any role)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-33\", \"FR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/periods\",\n      \"routeFile\": \"src/app/api/periods/route.ts\",\n      \"description\": \"Create a period. order = max(order)+1. Rejects endTime <= startTime (Zod) and any overlap with another period (service: \\\"Overlaps '<name>' (<s>–<e>).\\\"). Audited as period.create.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": {\n          \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 50 },\n          \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n          \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\" },\n          \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\" }\n        },\n        \"zod\": \"periodSchema\"\n      },\n      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/Period\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-5\", \"FR-6\", \"FR-40\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/periods/{id}\",\n      \"routeFile\": \"src/app/api/periods/[id]/route.ts\",\n      \"description\": \"Partial update. The service re-validates end>start and overlap against the merged row (self excluded). Audited as period.update.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"string\" },\n        \"body\": {\n          \"name\": { \"type\": \"string\", \"optional\": true },\n          \"startTime\": { \"$ref\": \"#/sharedSchemas/HHMM\", \"optional\": true },\n          \"endTime\": { \"$ref\": \"#/sharedSchemas/HHMM\", \"optional\": true },\n          \"kind\": { \"$ref\": \"#/sharedSchemas/PeriodKind\", \"optional\": true }\n        },\n        \"zod\": \"periodUpdateSchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/Period\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-33\", \"FR-6\", \"FR-40\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/periods/{id}\",\n      \"routeFile\": \"src/app/api/periods/[id]/route.ts\",\n      \"description\": \"Delete a period. Refused with 409 if any timetable slot references it. Audited as period.delete.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n      \"errorResponses\": {\n        \"409\": { \"error\": { \"code\": \"CONFLICT\", \"message\": \"Period has N timetable slots. Remove them first.\", \"details\": { \"slotCount\": \"integer\" } } }\n      },\n      \"errors\": [\"CONFLICT\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-33\", \"FR-8\", \"FR-40\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/periods/reorder\",\n      \"routeFile\": \"src/app/api/periods/reorder/route.ts\",\n      \"description\": \"Set display order from the full id list (index 0 → order 1). The id set must equal the existing set exactly, else 400. Two-phase write in one transaction. Audited as period.reorder.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": { \"periodIds\": { \"type\": \"array\", \"items\": \"string\", \"minItems\": 1, \"uniqueItems\": true } },\n        \"zod\": \"periodReorderSchema\"\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Period\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-33\", \"FR-5\", \"FR-40\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/school-days\",\n      \"routeFile\": \"src/app/api/school-days/route.ts\",\n      \"description\": \"All 7 days, Mon→Sun, each with slotCount (all academic years) so the confirm dialog can show how many slots switching a day off will remove.\",\n      \"auth\": \"requireUser (any role)\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDayWithCount\" }, \"length\": 7 } },\n      \"errors\": [\"UNAUTHENTICATED\"],\n      \"requirementIds\": [\"FR-34\", \"FR-7\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/school-days\",\n      \"routeFile\": \"src/app/api/school-days/route.ts\",\n      \"description\": \"Replace all 7 teaching flags. In one transaction, deletes every slot (all years) on days switching true→false, then updates the rows. Audited as schoolDay.update { changed, deletedSlotCount }.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": { \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDay\" }, \"length\": 7, \"note\": \"unique dayOfWeek 1–7\" } },\n        \"zod\": \"schoolDaysSchema\"\n      },\n      \"responseSchema\": {\n        \"data\": {\n          \"days\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/SchoolDayWithCount\" } },\n          \"deletedSlotCount\": \"integer\"\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-34\", \"FR-7\", \"FR-40\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/timetable\",\n      \"routeFile\": \"src/app/api/timetable/route.ts\",\n      \"description\": \"Timetable for one section, teacher or room in one academic year. Teacher view includes co-taught courses. Access via assertCanViewTimetable: ADMIN any view; TEACHER only view=teacher&id=self, or view=section for sections they are homeroom teacher of or teach/co-teach a non-archived course in (D8); everyone else 403.\",\n      \"auth\": \"requireUser + assertCanViewTimetable\",\n      \"requestSchema\": {\n        \"query\": {\n          \"view\": { \"type\": \"string\", \"enum\": [\"section\", \"teacher\", \"room\"] },\n          \"id\": { \"type\": \"string\" },\n          \"academicYearId\": { \"type\": \"string\" }\n        },\n        \"zod\": \"timetableQuerySchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-35\", \"FR-15\", \"FR-16\", \"NFR-2\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/timetable/availability\",\n      \"routeFile\": \"src/app/api/timetable/availability/route.ts\",\n      \"description\": \"Clash preview for dragging a course: for every teaching-day × period cell in the course's academic year, the clash messages that placing it there would produce. Only cells with clashes are returned. The course's own slots are ignored. roomId (D2) enables the ROOM rule for that room; omitted → ROOM rule skipped. Fixed query count (NFR-3).\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"query\": {\n          \"courseId\": { \"type\": \"string\" },\n          \"roomId\": { \"type\": \"string\", \"optional\": true }\n        },\n        \"zod\": \"availabilityQuerySchema\"\n      },\n      \"responseSchema\": {\n        \"data\": {\n          \"type\": \"object\",\n          \"additionalProperties\": { \"type\": \"array\", \"items\": \"string\" },\n          \"keyFormat\": \"<dayOfWeek>-<periodId>\",\n          \"example\": { \"1-clx0p2\": [\"Clash: Mr Smith already teaches MATH-7B on Monday, Period 2.\"] }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-36\", \"FR-19\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/timetable/free-rooms\",\n      \"routeFile\": \"src/app/api/timetable/free-rooms/route.ts\",\n      \"description\": \"Non-archived rooms with no slot at (academicYearId, dayOfWeek, periodId), ordered by name. excludeSlotId keeps the slot's own current room in the list. Added by design decision D1 to resolve intake blocker FR-21.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"query\": {\n          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"coerce\": true },\n          \"periodId\": { \"type\": \"string\" },\n          \"academicYearId\": { \"type\": \"string\" },\n          \"excludeSlotId\": { \"type\": \"string\", \"optional\": true }\n        },\n        \"zod\": \"freeRoomsQuerySchema\"\n      },\n      \"responseSchema\": { \"data\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Room\" } } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-21\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/timetable/slots\",\n      \"routeFile\": \"src/app/api/timetable/slots/route.ts\",\n      \"description\": \"Place a course in a cell. SERIALIZABLE transaction with retry on P2034: validateSlot runs inside it; any clash → 409 with every clash, nothing saved. academicYearId = course.academicYearId. Archived course or archived roomId → 400. Audited after commit as timetableSlot.create.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"body\": {\n          \"courseId\": { \"type\": \"string\" },\n          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7 },\n          \"periodId\": { \"type\": \"string\" },\n          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }\n        },\n        \"zod\": \"slotCreateSchema\"\n      },\n      \"responseSchema\": { \"status\": 201, \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },\n      \"errorResponses\": {\n        \"409\": {\n          \"error\": {\n            \"code\": \"CONFLICT\",\n            \"message\": \"<first clash message>[ (+N more)]\",\n            \"details\": { \"clashes\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/sharedSchemas/Clash\" } } }\n          }\n        }\n      },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n      \"requirementIds\": [\"FR-37\", \"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-17\", \"FR-20\", \"FR-40\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/timetable/slots/{id}\",\n      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",\n      \"description\": \"Move a slot and/or change its room. The patch is merged over the existing slot and re-validated with the slot itself excluded. A room-only patch (FR-21) uses the same path. Same transaction, 409 shape and audit (timetableSlot.update with from/to) as POST.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": {\n        \"params\": { \"id\": \"string\" },\n        \"body\": {\n          \"dayOfWeek\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 7, \"optional\": true },\n          \"periodId\": { \"type\": \"string\", \"optional\": true },\n          \"roomId\": { \"type\": [\"string\", \"null\"], \"optional\": true }\n        },\n        \"constraint\": \"at least one key\",\n        \"zod\": \"slotUpdateSchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableSlotExpanded\" } },\n      \"errorResponses\": { \"409\": \"same as POST /api/timetable/slots\" },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\", \"CONFLICT\"],\n      \"requirementIds\": [\"FR-37\", \"FR-14\", \"FR-18\", \"FR-20\", \"FR-21\", \"FR-40\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/timetable/slots/{id}\",\n      \"routeFile\": \"src/app/api/timetable/slots/[id]/route.ts\",\n      \"description\": \"Remove a slot. Audited as timetableSlot.delete.\",\n      \"auth\": \"requireRole('ADMIN')\",\n      \"requestSchema\": { \"params\": { \"id\": \"string\" } },\n      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n      \"errors\": [\"UNAUTHENTICATED\", \"FORBIDDEN\", \"NOT_FOUND\"],\n      \"requirementIds\": [\"FR-37\", \"FR-18\", \"FR-40\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/timetable\",\n      \"routeFile\": \"src/app/api/me/timetable/route.ts\",\n      \"description\": \"The caller's personal timetable. TEACHER → own (incl. co-taught). STUDENT → self; a studentId other than self → 403. PARENT → studentId required when >1 linked children, defaults to the only child, must pass assertCanViewStudent else 403. ADMIN → { periods, days, slots: [] } (D5). academicYearId defaults to the current AcademicYear.\",\n      \"auth\": \"requireUser + role-specific checks above\",\n      \"requestSchema\": {\n        \"query\": {\n          \"studentId\": { \"type\": \"string\", \"optional\": true },\n          \"academicYearId\": { \"type\": \"string\", \"optional\": true }\n        },\n        \"zod\": \"meTimetableQuerySchema\"\n      },\n      \"responseSchema\": { \"data\": { \"$ref\": \"#/sharedSchemas/TimetableView\" } },\n      \"errors\": [\"VALIDATION_ERROR\", \"UNAUTHENTICATED\", \"FORBIDDEN\"],\n      \"requirementIds\": [\"FR-38\", \"FR-24\", \"FR-25\", \"FR-27\", \"NFR-7\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    {\n      \"name\": \"getScheduleForDate\",\n      \"module\": \"src/server/timetable/timetable-service.ts\",\n      \"signature\": \"getScheduleForDate(target: { userId: string; role: Role } | { sectionId: string }, date: Date): Promise<{ period: Period; course: TimetableSlotExpanded['course']; room: Room | null }[]>\",\n      \"behaviour\": \"Weekday from SchoolSettings.timezone. [] if the day is not teaching. Ordered by period.order. PARENT target → [].\",\n      \"requirementIds\": [\"FR-30\", \"FR-45\", \"NFR-15\"]\n    },\n    {\n      \"name\": \"getCurrentSlot\",\n      \"module\": \"src/server/timetable/timetable-service.ts\",\n      \"signature\": \"getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null>\",\n      \"behaviour\": \"Entry whose period has startTime <= hhmm < endTime in the school timezone, else null.\",\n      \"requirementIds\": [\"FR-31\", \"FR-45\"]\n    },\n    {\n      \"name\": \"validateSlot\",\n      \"module\": \"src/server/timetable/timetable-service.ts\",\n      \"signature\": \"validateSlot(input: { courseId; dayOfWeek; periodId; roomId: string | null; excludeSlotId?: string }, db?: Prisma.TransactionClient): Promise<Clash[]>\",\n      \"behaviour\": \"Returns ALL clashes; excludeSlotId removes the moving slot from comparison.\",\n      \"requirementIds\": [\"FR-14\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_0195ygKwithjRsyQmQ1yyGm3","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
