{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgBLowdkdF9cN9DA8hJjm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013MA2HqchPq9b8Xx9p62nWF","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"abcd-03\",\n  \"timestamp\": \"2026-10-19T14:20:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md's Component Breakdown/Data Flow (abcd-03) and the source PRD's explicit API table (03-user-management.md, section 'API'), which fully specifies method/path/role/body for all 18 endpoints. Two items carried forward from system-design.md's Status section, unresolved by this sub-task because they are sequencing/confirmation items for dev-planning, not contract-shape questions: (1) FR-31 is MEDIUM confidence — the unlock contract below assumes it clears exactly lockedUntil/failedLoginCount per prisma/schema.prisma, confirm before implementation; (2) POST /api/users/:id/invite and the session-level effect of POST /api/users/:id/status are written against src/server/services/users.ts's sendInvite(userId) and PRD-01's session/status re-check, neither of which exists in src/ yet (only their schema does) — see handoff-to-dev-planning.json blockers.\",\n\n  \"conventions\": {\n    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n    \"listEnvelope\": { \"data\": \"[...]\", \"page\": 1, \"pageSize\": 20, \"total\": 0 },\n    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\"],\n    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100)\",\n    \"sorting\": \"?sort=field&order=asc|desc\",\n    \"search\": \"?q=\",\n    \"auth\": \"Per-endpoint role gate shown in each entry's description, enforced server-side via requireRole()/assertCanViewStudent (never UI-only). Student-scoped reads additionally run assertCanViewStudent, which throws FORBIDDEN or NOT_FOUND (for STUDENT/PARENT callers, to avoid revealing existence) rather than a blanket 403.\",\n    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action user.<verb> (e.g. user.created, user.status_changed, user.archived, user.unlocked, user.imported, parent_link.created, parent_link.removed).\",\n    \"privacy\": \"medicalNotes is stripped server-side (never UI-only) from every response reachable by STUDENT/PARENT roles and from every CSV export row (NFR-1).\"\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users\",\n      \"description\": \"ADMIN only. Paginated, filtered user list backed by the (lastName, firstName, email) index.\",\n      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean? (default false)\", \"page\": \"int?\", \"pageSize\": \"int?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"gradeLevelId\": \"string|null\", \"gradeLevelName\": \"string|null\", \"lastLoginAt\": \"datetime|null\", \"lockedUntil\": \"datetime|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users\",\n      \"description\": \"ADMIN only. Creates a User + role-specific profile row + any inline parent/student links in one transaction; generates admissionNumber (S<year>-####) or employeeNumber (T-####) where applicable.\",\n      \"requestSchema\": { \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"role\": \"Role\", \"profile\": \"StudentProfileInput|TeacherProfileInput|ParentProfileInput (shape depends on role; see FR-1)\", \"links\": \"[{ linkedUserId: string, relationship: GuardianRelationship, isPrimary: boolean }]?\", \"sendInvite\": \"boolean (default true)\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },\n      \"requirementIds\": [\"FR-1\", \"FR-6\", \"FR-7\", \"FR-9\", \"FR-10\", \"FR-15\", \"FR-16\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users/:id\",\n      \"description\": \"ADMIN only. Full user + role profile + family links (component 6) + 20 most recent AuditLog rows where actorId=id OR entityId=id.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"lastLoginAt\": \"datetime|null\", \"profile\": \"object\", \"familyLinks\": [ { \"id\": \"string\", \"linkedUserId\": \"string\", \"linkedUserName\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } ], \"recentAuditLogs\": [ { \"id\": \"string\", \"action\": \"string\", \"actorId\": \"string|null\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"createdAt\": \"datetime\" } ] } },\n      \"requirementIds\": [\"FR-11\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/users/:id\",\n      \"description\": \"ADMIN only. Updates common + profile fields. role is rejected server-side if present and different from the existing row (FR-9 is a service-layer invariant, not just a form convenience). An email diff invalidates (marks used) any pending AuthToken rows of type INVITE for this user.\",\n      \"requestSchema\": { \"firstName\": \"string?\", \"lastName\": \"string?\", \"email\": \"string?\", \"phone\": \"string?\", \"profile\": \"Partial<StudentProfileInput|TeacherProfileInput|ParentProfileInput>?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },\n      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/invite\",\n      \"description\": \"ADMIN only. Resends an invitation email via src/server/services/users.ts's sendInvite(userId) (PRD-01 interface; see note — stub/no-op until PRD-01 lands, call site does not change).\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"inviteSentAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/unlock\",\n      \"description\": \"ADMIN only. Clears lockedUntil and failedLoginCount, restoring sign-in access immediately. MEDIUM confidence (FR-31) — field names confirmed against prisma/schema.prisma; verify no other lockout field exists before implementation.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"lockedUntil\": null, \"failedLoginCount\": 0 } },\n      \"requirementIds\": [\"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/status\",\n      \"description\": \"ADMIN only. Sets status to ACTIVE or DISABLED. Rejects self-disable and disabling the last active ADMIN with VALIDATION_ERROR 'At least one active admin is required.' The 'sessions stop working within 5 minutes' effect (FR-12) is PRD-01's session re-check reading status on token refresh, not built here (NFR-7) — this endpoint only guarantees status is correct the instant the write commits.\",\n      \"requestSchema\": { \"status\": \"\\\"ACTIVE\\\"|\\\"DISABLED\\\"\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\" } },\n      \"requirementIds\": [\"FR-12\", \"FR-14\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/archive\",\n      \"description\": \"ADMIN only. Sets archivedAt=now and status=DISABLED. Same self/last-admin guard as /status. Archived users are excluded from every list/picker query by default (component 3/7/16), enforced at the query layer.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-13\", \"FR-14\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/restore\",\n      \"description\": \"ADMIN only. Clears archivedAt. Does not auto-reactivate status; an admin re-enables separately via /status.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": null } },\n      \"requirementIds\": [\"FR-13\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/import\",\n      \"description\": \"ADMIN only. Re-validates every row server-side (never trusts the client) against the same Zod schemas as the create form, in batches of 200; each batch runs in one prisma.$transaction (all-or-rollback, NFR-3). Grade levels matched case-insensitively by name/shortName; dates parsed strictly as YYYY-MM-DD; rows whose email already exists are skipped, not errored (FR-23).\",\n      \"requestSchema\": { \"type\": \"\\\"STUDENTS\\\"|\\\"TEACHERS\\\"\", \"rows\": \"object[] (raw parsed CSV rows, re-validated server-side)\", \"sendInvites\": \"boolean (default false)\" },\n      \"responseSchema\": { \"data\": { \"createdStudents\": \"int\", \"createdParents\": \"int\", \"linkedExistingParents\": \"int\", \"skipped\": \"int\", \"failed\": \"int\", \"rowResults\": [ { \"rowIndex\": \"int\", \"result\": \"\\\"created\\\"|\\\"skipped\\\"|\\\"error\\\"\", \"reason\": \"string|null\" } ], \"errorReportCsvUrl\": \"string|null\" } },\n      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-22\", \"FR-23\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users/export\",\n      \"description\": \"ADMIN only. Same filters as GET /api/users; returns text/csv. medicalNotes is excluded and every cell passes through escapeCsvCell() (NFR-4) to neutralise formula injection.\",\n      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean?\" },\n      \"responseSchema\": { \"contentType\": \"text/csv\", \"body\": \"csv string, one row per matched user, medicalNotes column omitted\" },\n      \"requirementIds\": [\"FR-5\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users/search\",\n      \"description\": \"ADMIN and TEACHER only. Picker search reusing the list query's filters, capped to 20 rows, projected down, excluding archived users.\",\n      \"requestSchema\": { \"role\": \"Role?\", \"q\": \"string?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"email\": \"string\", \"role\": \"Role\" } ] },\n      \"requirementIds\": [\"FR-28\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/students/:id/parents\",\n      \"description\": \"ADMIN only. Links a parent to a student inside one transaction: rejects a 5th link for the student (VALIDATION_ERROR) and, if isPrimary is true, clears isPrimary on every other link for that student first.\",\n      \"requestSchema\": { \"parentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"parentId\": \"string\", \"studentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } },\n      \"requirementIds\": [\"FR-15\", \"FR-16\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/students/:id/parents/:parentId\",\n      \"description\": \"ADMIN only. Removes a parent-student link.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n      \"requirementIds\": [\"FR-15\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/:id\",\n      \"description\": \"Gated by assertCanViewStudent (ADMIN/TEACHER full access; STUDENT self only; PARENT linked children only — FORBIDDEN or NOT_FOUND otherwise, never revealing existence to STUDENT/PARENT). medicalNotes is stripped in the service layer for STUDENT/PARENT roles before the response is built.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"admissionNumber\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevelName\": \"string\", \"status\": \"UserStatus\", \"dateOfBirth\": \"date\", \"gender\": \"Gender\", \"addressLine1\": \"string|null\", \"city\": \"string|null\", \"medicalNotes\": \"string|null (omitted entirely for STUDENT/PARENT)\", \"emergencyContact\": \"string|null\", \"emergencyPhone\": \"string|null\", \"familyLinks\": \"[{ linkedUserId, linkedUserName, relationship, isPrimary }]\" } },\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/children\",\n      \"description\": \"PARENT only. Lists the caller's linked children for the My Children page.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"gradeLevelName\": \"string\", \"admissionNumber\": \"string\" } ] },\n      \"requirementIds\": [\"FR-26\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/me/profile\",\n      \"description\": \"Any authenticated user, self only. Narrower mutation path than /api/users/:id — editable fields are phone, plus occupation/address for PARENT role; name/email/role are read-only here.\",\n      \"requestSchema\": { \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"occupation\": \"string? (PARENT only)\", \"address\": \"string? (PARENT only)\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"phone\": \"string|null\", \"occupation\": \"string|null\", \"address\": \"string|null\" } },\n      \"requirementIds\": [\"FR-27\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/audit-logs\",\n      \"description\": \"ADMIN only. Read-only paginated view over the existing AuditLog table; filters by actor, action prefix, and date range. No new write path.\",\n      \"requestSchema\": { \"actorId\": \"string?\", \"actionPrefix\": \"string?\", \"dateFrom\": \"date?\", \"dateTo\": \"date?\", \"page\": \"int?\", \"pageSize\": \"int?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"createdAt\": \"datetime\", \"actorId\": \"string|null\", \"actorName\": \"string|null\", \"action\": \"string\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"ip\": \"string|null\", \"metadata\": \"object|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },\n      \"requirementIds\": [\"FR-29\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1685,"cache_read_input_tokens":56923,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1685},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"744674dc-d209-4d85-a196-0650535a8eff","uuid":"c653b36e-1bb8-422c-a9be-e5e4415c3bf1","timestamp":"2026-10-19T09:16:24.383Z","request_id":"req_011CgBLowLtHXBPt2DCWzWDX"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013MA2HqchPq9b8Xx9p62nWF","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"744674dc-d209-4d85-a196-0650535a8eff","uuid":"358112cd-a696-451d-9b1f-16ff860a4e98","timestamp":"2026-10-19T09:16:24.484Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"abcd-03\",\n  \"timestamp\": \"2026-10-19T14:20:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"Derived from system-design.md's Component Breakdown/Data Flow (abcd-03) and the source PRD's explicit API table (03-user-management.md, section 'API'), which fully specifies method/path/role/body for all 18 endpoints. Two items carried forward from system-design.md's Status section, unresolved by this sub-task because they are sequencing/confirmation items for dev-planning, not contract-shape questions: (1) FR-31 is MEDIUM confidence — the unlock contract below assumes it clears exactly lockedUntil/failedLoginCount per prisma/schema.prisma, confirm before implementation; (2) POST /api/users/:id/invite and the session-level effect of POST /api/users/:id/status are written against src/server/services/users.ts's sendInvite(userId) and PRD-01's session/status re-check, neither of which exists in src/ yet (only their schema does) — see handoff-to-dev-planning.json blockers.\",\n\n  \"conventions\": {\n    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n    \"listEnvelope\": { \"data\": \"[...]\", \"page\": 1, \"pageSize\": 20, \"total\": 0 },\n    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\"],\n    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100)\",\n    \"sorting\": \"?sort=field&order=asc|desc\",\n    \"search\": \"?q=\",\n    \"auth\": \"Per-endpoint role gate shown in each entry's description, enforced server-side via requireRole()/assertCanViewStudent (never UI-only). Student-scoped reads additionally run assertCanViewStudent, which throws FORBIDDEN or NOT_FOUND (for STUDENT/PARENT callers, to avoid revealing existence) rather than a blanket 403.\",\n    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action user.<verb> (e.g. user.created, user.status_changed, user.archived, user.unlocked, user.imported, parent_link.created, parent_link.removed).\",\n    \"privacy\": \"medicalNotes is stripped server-side (never UI-only) from every response reachable by STUDENT/PARENT roles and from every CSV export row (NFR-1).\"\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users\",\n      \"description\": \"ADMIN only. Paginated, filtered user list backed by the (lastName, firstName, email) index.\",\n      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean? (default false)\", \"page\": \"int?\", \"pageSize\": \"int?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"gradeLevelId\": \"string|null\", \"gradeLevelName\": \"string|null\", \"lastLoginAt\": \"datetime|null\", \"lockedUntil\": \"datetime|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"NFR-2\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users\",\n      \"description\": \"ADMIN only. Creates a User + role-specific profile row + any inline parent/student links in one transaction; generates admissionNumber (S<year>-####) or employeeNumber (T-####) where applicable.\",\n      \"requestSchema\": { \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"role\": \"Role\", \"profile\": \"StudentProfileInput|TeacherProfileInput|ParentProfileInput (shape depends on role; see FR-1)\", \"links\": \"[{ linkedUserId: string, relationship: GuardianRelationship, isPrimary: boolean }]?\", \"sendInvite\": \"boolean (default true)\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },\n      \"requirementIds\": [\"FR-1\", \"FR-6\", \"FR-7\", \"FR-9\", \"FR-10\", \"FR-15\", \"FR-16\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users/:id\",\n      \"description\": \"ADMIN only. Full user + role profile + family links (component 6) + 20 most recent AuditLog rows where actorId=id OR entityId=id.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"lastLoginAt\": \"datetime|null\", \"profile\": \"object\", \"familyLinks\": [ { \"id\": \"string\", \"linkedUserId\": \"string\", \"linkedUserName\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } ], \"recentAuditLogs\": [ { \"id\": \"string\", \"action\": \"string\", \"actorId\": \"string|null\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"createdAt\": \"datetime\" } ] } },\n      \"requirementIds\": [\"FR-11\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/users/:id\",\n      \"description\": \"ADMIN only. Updates common + profile fields. role is rejected server-side if present and different from the existing row (FR-9 is a service-layer invariant, not just a form convenience). An email diff invalidates (marks used) any pending AuthToken rows of type INVITE for this user.\",\n      \"requestSchema\": { \"firstName\": \"string?\", \"lastName\": \"string?\", \"email\": \"string?\", \"phone\": \"string?\", \"profile\": \"Partial<StudentProfileInput|TeacherProfileInput|ParentProfileInput>?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },\n      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/invite\",\n      \"description\": \"ADMIN only. Resends an invitation email via src/server/services/users.ts's sendInvite(userId) (PRD-01 interface; see note — stub/no-op until PRD-01 lands, call site does not change).\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"inviteSentAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/unlock\",\n      \"description\": \"ADMIN only. Clears lockedUntil and failedLoginCount, restoring sign-in access immediately. MEDIUM confidence (FR-31) — field names confirmed against prisma/schema.prisma; verify no other lockout field exists before implementation.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"lockedUntil\": null, \"failedLoginCount\": 0 } },\n      \"requirementIds\": [\"FR-31\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/status\",\n      \"description\": \"ADMIN only. Sets status to ACTIVE or DISABLED. Rejects self-disable and disabling the last active ADMIN with VALIDATION_ERROR 'At least one active admin is required.' The 'sessions stop working within 5 minutes' effect (FR-12) is PRD-01's session re-check reading status on token refresh, not built here (NFR-7) — this endpoint only guarantees status is correct the instant the write commits.\",\n      \"requestSchema\": { \"status\": \"\\\"ACTIVE\\\"|\\\"DISABLED\\\"\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\" } },\n      \"requirementIds\": [\"FR-12\", \"FR-14\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/archive\",\n      \"description\": \"ADMIN only. Sets archivedAt=now and status=DISABLED. Same self/last-admin guard as /status. Archived users are excluded from every list/picker query by default (component 3/7/16), enforced at the query layer.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": \"datetime\" } },\n      \"requirementIds\": [\"FR-13\", \"FR-14\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/:id/restore\",\n      \"description\": \"ADMIN only. Clears archivedAt. Does not auto-reactivate status; an admin re-enables separately via /status.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": null } },\n      \"requirementIds\": [\"FR-13\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/users/import\",\n      \"description\": \"ADMIN only. Re-validates every row server-side (never trusts the client) against the same Zod schemas as the create form, in batches of 200; each batch runs in one prisma.$transaction (all-or-rollback, NFR-3). Grade levels matched case-insensitively by name/shortName; dates parsed strictly as YYYY-MM-DD; rows whose email already exists are skipped, not errored (FR-23).\",\n      \"requestSchema\": { \"type\": \"\\\"STUDENTS\\\"|\\\"TEACHERS\\\"\", \"rows\": \"object[] (raw parsed CSV rows, re-validated server-side)\", \"sendInvites\": \"boolean (default false)\" },\n      \"responseSchema\": { \"data\": { \"createdStudents\": \"int\", \"createdParents\": \"int\", \"linkedExistingParents\": \"int\", \"skipped\": \"int\", \"failed\": \"int\", \"rowResults\": [ { \"rowIndex\": \"int\", \"result\": \"\\\"created\\\"|\\\"skipped\\\"|\\\"error\\\"\", \"reason\": \"string|null\" } ], \"errorReportCsvUrl\": \"string|null\" } },\n      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-22\", \"FR-23\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users/export\",\n      \"description\": \"ADMIN only. Same filters as GET /api/users; returns text/csv. medicalNotes is excluded and every cell passes through escapeCsvCell() (NFR-4) to neutralise formula injection.\",\n      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean?\" },\n      \"responseSchema\": { \"contentType\": \"text/csv\", \"body\": \"csv string, one row per matched user, medicalNotes column omitted\" },\n      \"requirementIds\": [\"FR-5\", \"NFR-1\", \"NFR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/users/search\",\n      \"description\": \"ADMIN and TEACHER only. Picker search reusing the list query's filters, capped to 20 rows, projected down, excluding archived users.\",\n      \"requestSchema\": { \"role\": \"Role?\", \"q\": \"string?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"email\": \"string\", \"role\": \"Role\" } ] },\n      \"requirementIds\": [\"FR-28\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/students/:id/parents\",\n      \"description\": \"ADMIN only. Links a parent to a student inside one transaction: rejects a 5th link for the student (VALIDATION_ERROR) and, if isPrimary is true, clears isPrimary on every other link for that student first.\",\n      \"requestSchema\": { \"parentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"parentId\": \"string\", \"studentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } },\n      \"requirementIds\": [\"FR-15\", \"FR-16\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/students/:id/parents/:parentId\",\n      \"description\": \"ADMIN only. Removes a parent-student link.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n      \"requirementIds\": [\"FR-15\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/:id\",\n      \"description\": \"Gated by assertCanViewStudent (ADMIN/TEACHER full access; STUDENT self only; PARENT linked children only — FORBIDDEN or NOT_FOUND otherwise, never revealing existence to STUDENT/PARENT). medicalNotes is stripped in the service layer for STUDENT/PARENT roles before the response is built.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"admissionNumber\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevelName\": \"string\", \"status\": \"UserStatus\", \"dateOfBirth\": \"date\", \"gender\": \"Gender\", \"addressLine1\": \"string|null\", \"city\": \"string|null\", \"medicalNotes\": \"string|null (omitted entirely for STUDENT/PARENT)\", \"emergencyContact\": \"string|null\", \"emergencyPhone\": \"string|null\", \"familyLinks\": \"[{ linkedUserId, linkedUserName, relationship, isPrimary }]\" } },\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"NFR-1\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/children\",\n      \"description\": \"PARENT only. Lists the caller's linked children for the My Children page.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"gradeLevelName\": \"string\", \"admissionNumber\": \"string\" } ] },\n      \"requirementIds\": [\"FR-26\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/me/profile\",\n      \"description\": \"Any authenticated user, self only. Narrower mutation path than /api/users/:id — editable fields are phone, plus occupation/address for PARENT role; name/email/role are read-only here.\",\n      \"requestSchema\": { \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"occupation\": \"string? (PARENT only)\", \"address\": \"string? (PARENT only)\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"phone\": \"string|null\", \"occupation\": \"string|null\", \"address\": \"string|null\" } },\n      \"requirementIds\": [\"FR-27\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/audit-logs\",\n      \"description\": \"ADMIN only. Read-only paginated view over the existing AuditLog table; filters by actor, action prefix, and date range. No new write path.\",\n      \"requestSchema\": { \"actorId\": \"string?\", \"actionPrefix\": \"string?\", \"dateFrom\": \"date?\", \"dateTo\": \"date?\", \"page\": \"int?\", \"pageSize\": \"int?\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"createdAt\": \"datetime\", \"actorId\": \"string|null\", \"actorName\": \"string|null\", \"action\": \"string\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"ip\": \"string|null\", \"metadata\": \"object|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },\n      \"requirementIds\": [\"FR-29\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":10,"newStart":1,"newLines":10,"lines":[" {","-  \"ticketId\": \"abcd-02\",","-  \"timestamp\": \"2026-10-19T13:30:00Z\",","+  \"ticketId\": \"abcd-03\",","+  \"timestamp\": \"2026-10-19T14:20:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\","," ","-  \"note\": \"arch-design-system did not leave a system-design.md for this ticket (not found anywhere under artifacts/architect/ for ticketId abcd-02 — see handoff-to-dev-planning.json blockers). Contracts below are derived directly from artifacts/intake/requirements.json and the source PRD's explicit API table (02-academic-structure.md, section 'API'), which fully specify method/path/role/body for every endpoint.\",","+  \"note\": \"Derived from system-design.md's Component Breakdown/Data Flow (abcd-03) and the source PRD's explicit API table (03-user-management.md, section 'API'), which fully specifies method/path/role/body for all 18 endpoints. Two items carried forward from system-design.md's Status section, unresolved by this sub-task because they are sequencing/confirmation items for dev-planning, not contract-shape questions: (1) FR-31 is MEDIUM confidence — the unlock contract below assumes it clears exactly lockedUntil/failedLoginCount per prisma/schema.prisma, confirm before implementation; (2) POST /api/users/:id/invite and the session-level effect of POST /api/users/:id/status are written against src/server/services/users.ts's sendInvite(userId) and PRD-01's session/status re-check, neither of which exists in src/ yet (only their schema does) — see handoff-to-dev-planning.json blockers.\","," ","   \"conventions\": {","     \"successEnvelope\": { \"data\": \"<resource or array>\" },"]},{"oldStart":14,"oldLines":178,"newStart":14,"newLines":155,"lines":["     \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100)\",","     \"sorting\": \"?sort=field&order=asc|desc\",","     \"search\": \"?q=\",","-    \"auth\": \"GET endpoints: any signed-in user. All write endpoints (POST/PATCH/DELETE): requireRole('ADMIN') server-side, 403 on non-admin.\",","-    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action <entity>.create|update|archive|delete.\"","+    \"auth\": \"Per-endpoint role gate shown in each entry's description, enforced server-side via requireRole()/assertCanViewStudent (never UI-only). Student-scoped reads additionally run assertCanViewStudent, which throws FORBIDDEN or NOT_FOUND (for STUDENT/PARENT callers, to avoid revealing existence) rather than a blanket 403.\",","+    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action user.<verb> (e.g. user.created, user.status_changed, user.archived, user.unlocked, user.imported, parent_link.created, parent_link.removed).\",","+    \"privacy\": \"medicalNotes is stripped server-side (never UI-only) from every response reachable by STUDENT/PARENT roles and from every CSV export row (NFR-1).\"","   },"," ","   \"endpoints\": [","     {","       \"method\": \"GET\",","-      \"path\": \"/api/settings/school\",","-      \"description\": \"Return the single SchoolSettings record.\",","-      \"requestSchema\": {},","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string (IANA zone)\" } },","-      \"requirementIds\": [\"FR-2\", \"FR-5\", \"NFR-6\"]","+      \"path\": \"/api/users\",","+      \"description\": \"ADMIN only. Paginated, filtered user list backed by the (lastName, firstName, email) index.\",","+      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean? (default false)\", \"page\": \"int?\", \"pageSize\": \"int?\" },","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"gradeLevelId\": \"string|null\", \"gradeLevelName\": \"string|null\", \"lastLoginAt\": \"datetime|null\", \"lockedUntil\": \"datetime|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },","+      \"requirementIds\": [\"FR-2\", \"FR-3\", \"NFR-2\"]","     },","     {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/settings/school\",","-      \"description\": \"Update one or more SchoolSettings fields. Writes audit entry settings.school.update with changed field names in metadata.\",","-      \"requestSchema\": { \"name\": \"string?\", \"logoUrl\": \"string(url)?\", \"address\": \"string?\", \"contactEmail\": \"string?\", \"contactPhone\": \"string?\", \"timezone\": \"string (IANA zone)?\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string\" } },","-      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"NFR-6\", \"NFR-7\"]","+      \"method\": \"POST\",","+      \"path\": \"/api/users\",","+      \"description\": \"ADMIN only. Creates a User + role-specific profile row + any inline parent/student links in one transaction; generates admissionNumber (S<year>-####) or employeeNumber (T-####) where applicable.\",","+      \"requestSchema\": { \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"role\": \"Role\", \"profile\": \"StudentProfileInput|TeacherProfileInput|ParentProfileInput (shape depends on role; see FR-1)\", \"links\": \"[{ linkedUserId: string, relationship: GuardianRelationship, isPrimary: boolean }]?\", \"sendInvite\": \"boolean (default true)\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },","+      \"requirementIds\": [\"FR-1\", \"FR-6\", \"FR-7\", \"FR-9\", \"FR-10\", \"FR-15\", \"FR-16\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/academic-years\",","-      \"description\": \"List academic years including their terms, ordered by term order.\",","+      \"path\": \"/api/users/:id\",","+      \"description\": \"ADMIN only. Full user + role profile + family links (component 6) + 20 most recent AuditLog rows where actorId=id OR entityId=id.\",","       \"requestSchema\": {},","-      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\", \"terms\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] } ] },","-      \"requirementIds\": [\"FR-6\", \"FR-10\", \"FR-11\", \"NFR-6\"]","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"lastLoginAt\": \"datetime|null\", \"profile\": \"object\", \"familyLinks\": [ { \"id\": \"string\", \"linkedUserId\": \"string\", \"linkedUserName\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } ], \"recentAuditLogs\": [ { \"id\": \"string\", \"action\": \"string\", \"actorId\": \"string|null\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"createdAt\": \"datetime\" } ] } },","+      \"requirementIds\": [\"FR-11\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/academic-years\",","-      \"description\": \"Create an academic year. Validates endDate after startDate and no date-range overlap with any other year, inside a transaction.\",","-      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },","-      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","-    },","-    {","       \"method\": \"PATCH\",","-      \"path\": \"/api/academic-years/:id\",","-      \"description\": \"Update an academic year's name/dates; re-validates the overlap rule.\",","-      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },","-      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","+      \"path\": \"/api/users/:id\",","+      \"description\": \"ADMIN only. Updates common + profile fields. role is rejected server-side if present and different from the existing row (FR-9 is a service-layer invariant, not just a form convenience). An email diff invalidates (marks used) any pending AuthToken rows of type INVITE for this user.\",","+      \"requestSchema\": { \"firstName\": \"string?\", \"lastName\": \"string?\", \"email\": \"string?\", \"phone\": \"string?\", \"profile\": \"Partial<StudentProfileInput|TeacherProfileInput|ParentProfileInput>?\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"status\": \"UserStatus\", \"profile\": \"object\" } },","+      \"requirementIds\": [\"FR-8\", \"FR-9\", \"FR-10\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/academic-years/:id/set-current\",","-      \"description\": \"Set isCurrent = true on this year and false on every other year, inside one transaction. Confirm dialog gates this on the client.\",","+      \"path\": \"/api/users/:id/invite\",","+      \"description\": \"ADMIN only. Resends an invitation email via src/server/services/users.ts's sendInvite(userId) (PRD-01 interface; see note — stub/no-op until PRD-01 lands, call site does not change).\",","       \"requestSchema\": {},","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"isCurrent\": true } },","-      \"requirementIds\": [\"FR-8\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"inviteSentAt\": \"datetime\" } },","+      \"requirementIds\": [\"FR-7\"]","     },","     {","-      \"method\": \"DELETE\",","-      \"path\": \"/api/academic-years/:id\",","-      \"description\": \"Delete an academic year. Returns CONFLICT (409) if it has terms or is referenced elsewhere.\",","+      \"method\": \"POST\",","+      \"path\": \"/api/users/:id/unlock\",","+      \"description\": \"ADMIN only. Clears lockedUntil and failedLoginCount, restoring sign-in access immediately. MEDIUM confidence (FR-31) — field names confirmed against prisma/schema.prisma; verify no other lockout field exists before implementation.\",","       \"requestSchema\": {},","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },","-      \"requirementIds\": [\"FR-9\", \"NFR-6\", \"NFR-7\"]","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"lockedUntil\": null, \"failedLoginCount\": 0 } },","+      \"requirementIds\": [\"FR-31\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/academic-years/:id/terms\",","-      \"description\": \"Create a term under this academic year. Validates term dates fall inside the year's range and do not overlap sibling terms; order auto-assigns as max+1.\",","-      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },","-      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","+      \"path\": \"/api/users/:id/status\",","+      \"description\": \"ADMIN only. Sets status to ACTIVE or DISABLED. Rejects self-disable and disabling the last active ADMIN with VALIDATION_ERROR 'At least one active admin is required.' The 'sessions stop working within 5 minutes' effect (FR-12) is PRD-01's session re-check reading status on token refresh, not built here (NFR-7) — this endpoint only guarantees status is correct the instant the write commits.\",","+      \"requestSchema\": { \"status\": \"\\\"ACTIVE\\\"|\\\"DISABLED\\\"\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\" } },","+      \"requirementIds\": [\"FR-12\", \"FR-14\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/academic-years/:id/terms/generate\",","-      \"description\": \"Split the year's date range into equal consecutive, named, contiguous terms. Only allowed when the year has zero terms. Earlier terms get the extra day when the range doesn't divide evenly.\",","-      \"requestSchema\": { \"pattern\": \"'SEMESTERS' | 'TRIMESTERS' | 'QUARTERS'\" },","-      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] },","-      \"requirementIds\": [\"FR-14\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","-    },","-    {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/terms/:id\",","-      \"description\": \"Update a term's name/dates/order. Re-validates range and sibling-overlap rules.\",","-      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\", \"order\": \"int?\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },","-      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]","-    },","-    {","-      \"method\": \"DELETE\",","-      \"path\": \"/api/terms/:id\",","-      \"description\": \"Delete a term.\",","+      \"path\": \"/api/users/:id/archive\",","+      \"description\": \"ADMIN only. Sets archivedAt=now and status=DISABLED. Same self/last-admin guard as /status. Archived users are excluded from every list/picker query by default (component 3/7/16), enforced at the query layer.\",","       \"requestSchema\": {},","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },","-      \"requirementIds\": [\"FR-12\", \"NFR-6\", \"NFR-7\"]","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": \"datetime\" } },","+      \"requirementIds\": [\"FR-13\", \"FR-14\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/terms/reorder\",","-      \"description\": \"Persist a new term order for one academic year (drag handle or up/down buttons).\",","-      \"requestSchema\": { \"academicYearId\": \"string\", \"termIds\": \"string[]\" },","-      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"order\": \"int\" } ] },","-      \"requirementIds\": [\"FR-13\", \"NFR-6\", \"NFR-7\"]","-    },","-    {","-      \"method\": \"GET\",","-      \"path\": \"/api/grade-levels\",","-      \"description\": \"List grade levels ordered by `order`. ?includeArchived=true includes archived rows.\",","+      \"path\": \"/api/users/:id/restore\",","+      \"description\": \"ADMIN only. Clears archivedAt. Does not auto-reactivate status; an admin re-enables separately via /status.\",","       \"requestSchema\": {},","-      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } ] },","-      \"requirementIds\": [\"FR-15\", \"NFR-6\"]","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"status\": \"UserStatus\", \"archivedAt\": null } },","+      \"requirementIds\": [\"FR-13\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/grade-levels\",","-      \"description\": \"Create a grade level.\",","-      \"requestSchema\": { \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" } },","-      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]","+      \"path\": \"/api/users/import\",","+      \"description\": \"ADMIN only. Re-validates every row server-side (never trusts the client) against the same Zod schemas as the create form, in batches of 200; each batch runs in one prisma.$transaction (all-or-rollback, NFR-3). Grade levels matched case-insensitively by name/shortName; dates parsed strictly as YYYY-MM-DD; rows whose email already exists are skipped, not errored (FR-23).\",","+      \"requestSchema\": { \"type\": \"\\\"STUDENTS\\\"|\\\"TEACHERS\\\"\", \"rows\": \"object[] (raw parsed CSV rows, re-validated server-side)\", \"sendInvites\": \"boolean (default false)\" },","+      \"responseSchema\": { \"data\": { \"createdStudents\": \"int\", \"createdParents\": \"int\", \"linkedExistingParents\": \"int\", \"skipped\": \"int\", \"failed\": \"int\", \"rowResults\": [ { \"rowIndex\": \"int\", \"result\": \"\\\"created\\\"|\\\"skipped\\\"|\\\"error\\\"\", \"reason\": \"string|null\" } ], \"errorReportCsvUrl\": \"string|null\" } },","+      \"requirementIds\": [\"FR-18\", \"FR-20\", \"FR-21\", \"FR-22\", \"FR-23\", \"NFR-3\"]","     },","     {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/grade-levels/:id\",","-      \"description\": \"Update fields, reorder, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",","-      \"requestSchema\": { \"name\": \"string?\", \"shortName\": \"string?\", \"order\": \"int?\", \"archived\": \"boolean?\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } },","-      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]","+      \"method\": \"GET\",","+      \"path\": \"/api/users/export\",","+      \"description\": \"ADMIN only. Same filters as GET /api/users; returns text/csv. medicalNotes is excluded and every cell passes through escapeCsvCell() (NFR-4) to neutralise formula injection.\",","+      \"requestSchema\": { \"role\": \"Role[]?\", \"status\": \"UserStatus?\", \"gradeLevelId\": \"string?\", \"q\": \"string?\", \"includeArchived\": \"boolean?\" },","+      \"responseSchema\": { \"contentType\": \"text/csv\", \"body\": \"csv string, one row per matched user, medicalNotes column omitted\" },","+      \"requirementIds\": [\"FR-5\", \"NFR-1\", \"NFR-4\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/subjects\",","-      \"description\": \"List subjects, searchable by name/code via ?q=.\",","-      \"requestSchema\": {},","-      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string(hex)\", \"archivedAt\": \"datetime|null\" } ] },","-      \"requirementIds\": [\"FR-16\", \"NFR-6\"]","+      \"path\": \"/api/users/search\",","+      \"description\": \"ADMIN and TEACHER only. Picker search reusing the list query's filters, capped to 20 rows, projected down, excluding archived users.\",","+      \"requestSchema\": { \"role\": \"Role?\", \"q\": \"string?\" },","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"email\": \"string\", \"role\": \"Role\" } ] },","+      \"requirementIds\": [\"FR-28\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/subjects\",","-      \"description\": \"Create a subject. Code is normalised upper-case; duplicate code returns CONFLICT (409) with field error 'Code already used by <subject>.'\",","-      \"requestSchema\": { \"name\": \"string\", \"code\": \"string (2-10 chars, normalised upper-case)\", \"description\": \"string?\", \"color\": \"string(hex, one of 12 preset swatches)\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\" } },","-      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]","+      \"path\": \"/api/students/:id/parents\",","+      \"description\": \"ADMIN only. Links a parent to a student inside one transaction: rejects a 5th link for the student (VALIDATION_ERROR) and, if isPrimary is true, clears isPrimary on every other link for that student first.\",","+      \"requestSchema\": { \"parentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"parentId\": \"string\", \"studentId\": \"string\", \"relationship\": \"GuardianRelationship\", \"isPrimary\": \"boolean\" } },","+      \"requirementIds\": [\"FR-15\", \"FR-16\"]","     },","     {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/subjects/:id\",","-      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",","-      \"requestSchema\": { \"name\": \"string?\", \"code\": \"string?\", \"description\": \"string?\", \"color\": \"string(hex)?\", \"archived\": \"boolean?\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\", \"archivedAt\": \"datetime|null\" } },","-      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]","+      \"method\": \"DELETE\",","+      \"path\": \"/api/students/:id/parents/:parentId\",","+      \"description\": \"ADMIN only. Removes a parent-student link.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },","+      \"requirementIds\": [\"FR-15\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/rooms\",","-      \"description\": \"List rooms.\",","+      \"path\": \"/api/students/:id\",","+      \"description\": \"Gated by assertCanViewStudent (ADMIN/TEACHER full access; STUDENT self only; PARENT linked children only — FORBIDDEN or NOT_FOUND otherwise, never revealing existence to STUDENT/PARENT). medicalNotes is stripped in the service layer for STUDENT/PARENT roles before the response is built.\",","       \"requestSchema\": {},","-      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\", \"archivedAt\": \"datetime|null\" } ] },","-      \"requirementIds\": [\"FR-17\", \"NFR-6\"]","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"admissionNumber\": \"string\", \"gradeLevelId\": \"string\", \"gradeLevelName\": \"string\", \"status\": \"UserStatus\", \"dateOfBirth\": \"date\", \"gender\": \"Gender\", \"addressLine1\": \"string|null\", \"city\": \"string|null\", \"medicalNotes\": \"string|null (omitted entirely for STUDENT/PARENT)\", \"emergencyContact\": \"string|null\", \"emergencyPhone\": \"string|null\", \"familyLinks\": \"[{ linkedUserId, linkedUserName, relationship, isPrimary }]\" } },","+      \"requirementIds\": [\"FR-24\", \"FR-25\", \"NFR-1\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/rooms\",","-      \"description\": \"Create a room.\",","-      \"requestSchema\": { \"name\": \"string\", \"building\": \"string?\", \"capacity\": \"int (1-500)?\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\" } },","-      \"requirementIds\": [\"FR-17\", \"NFR-6\", \"NFR-7\"]","+      \"method\": \"GET\",","+      \"path\": \"/api/me/children\",","+      \"description\": \"PARENT only. Lists the caller's linked children for the My Children page.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"gradeLevelName\": \"string\", \"admissionNumber\": \"string\" } ] },","+      \"requirementIds\": [\"FR-26\"]","     },","     {","       \"method\": \"PATCH\",","-      \"path\": \"/api/rooms/:id\",","-      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",","-      \"requestSchema\": { \"name\": \"string?\", \"building\": \"string?\", \"capacity\": \"int?\", \"archived\": \"boolean?\" },","-      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\", \"archivedAt\": \"datetime|null\" } },","-      \"requirementIds\": [\"FR-17\", \"NFR-6\", \"NFR-7\"]","+      \"path\": \"/api/me/profile\",","+      \"description\": \"Any authenticated user, self only. Narrower mutation path than /api/users/:id — editable fields are phone, plus occupation/address for PARENT role; name/email/role are read-only here.\",","+      \"requestSchema\": { \"phone\": \"string? (^\\\\+?[0-9 ()-]{7,20}$)\", \"occupation\": \"string? (PARENT only)\", \"address\": \"string? (PARENT only)\" },","+      \"responseSchema\": { \"data\": { \"id\": \"string\", \"firstName\": \"string\", \"lastName\": \"string\", \"email\": \"string\", \"role\": \"Role\", \"phone\": \"string|null\", \"occupation\": \"string|null\", \"address\": \"string|null\" } },","+      \"requirementIds\": [\"FR-27\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/audit-logs\",","+      \"description\": \"ADMIN only. Read-only paginated view over the existing AuditLog table; filters by actor, action prefix, and date range. No new write path.\",","+      \"requestSchema\": { \"actorId\": \"string?\", \"actionPrefix\": \"string?\", \"dateFrom\": \"date?\", \"dateTo\": \"date?\", \"page\": \"int?\", \"pageSize\": \"int?\" },","+      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"createdAt\": \"datetime\", \"actorId\": \"string|null\", \"actorName\": \"string|null\", \"action\": \"string\", \"entityType\": \"string|null\", \"entityId\": \"string|null\", \"ip\": \"string|null\", \"metadata\": \"object|null\" } ], \"page\": \"int\", \"pageSize\": \"int\", \"total\": \"int\" },","+      \"requirementIds\": [\"FR-29\"]","     }","   ],"," "]}],"originalFile":"{\n  \"ticketId\": \"abcd-02\",\n  \"timestamp\": \"2026-10-19T13:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"note\": \"arch-design-system did not leave a system-design.md for this ticket (not found anywhere under artifacts/architect/ for ticketId abcd-02 — see handoff-to-dev-planning.json blockers). Contracts below are derived directly from artifacts/intake/requirements.json and the source PRD's explicit API table (02-academic-structure.md, section 'API'), which fully specify method/path/role/body for every endpoint.\",\n\n  \"conventions\": {\n    \"successEnvelope\": { \"data\": \"<resource or array>\" },\n    \"listEnvelope\": { \"data\": \"[...]\", \"page\": 1, \"pageSize\": 20, \"total\": 0 },\n    \"errorEnvelope\": { \"error\": { \"code\": \"VALIDATION_ERROR\", \"message\": \"string\", \"details\": {} } },\n    \"errorCodes\": [\"VALIDATION_ERROR (400)\", \"UNAUTHENTICATED (401)\", \"FORBIDDEN (403)\", \"NOT_FOUND (404)\", \"CONFLICT (409)\", \"RATE_LIMITED (429)\", \"INTERNAL (500)\"],\n    \"pagination\": \"?page= (default 1), ?pageSize= (default 20, max 100)\",\n    \"sorting\": \"?sort=field&order=asc|desc\",\n    \"search\": \"?q=\",\n    \"auth\": \"GET endpoints: any signed-in user. All write endpoints (POST/PATCH/DELETE): requireRole('ADMIN') server-side, 403 on non-admin.\",\n    \"audit\": \"Every write endpoint writes an AuditLog row via audit() with action <entity>.create|update|archive|delete.\"\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/settings/school\",\n      \"description\": \"Return the single SchoolSettings record.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string (IANA zone)\" } },\n      \"requirementIds\": [\"FR-2\", \"FR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/settings/school\",\n      \"description\": \"Update one or more SchoolSettings fields. Writes audit entry settings.school.update with changed field names in metadata.\",\n      \"requestSchema\": { \"name\": \"string?\", \"logoUrl\": \"string(url)?\", \"address\": \"string?\", \"contactEmail\": \"string?\", \"contactPhone\": \"string?\", \"timezone\": \"string (IANA zone)?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"logoUrl\": \"string|null\", \"address\": \"string\", \"contactEmail\": \"string\", \"contactPhone\": \"string\", \"timezone\": \"string\" } },\n      \"requirementIds\": [\"FR-2\", \"FR-3\", \"FR-4\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/academic-years\",\n      \"description\": \"List academic years including their terms, ordered by term order.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\", \"terms\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] } ] },\n      \"requirementIds\": [\"FR-6\", \"FR-10\", \"FR-11\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/academic-years\",\n      \"description\": \"Create an academic year. Validates endDate after startDate and no date-range overlap with any other year, inside a transaction.\",\n      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },\n      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/academic-years/:id\",\n      \"description\": \"Update an academic year's name/dates; re-validates the overlap rule.\",\n      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"isCurrent\": \"boolean\" } },\n      \"requirementIds\": [\"FR-7\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/academic-years/:id/set-current\",\n      \"description\": \"Set isCurrent = true on this year and false on every other year, inside one transaction. Confirm dialog gates this on the client.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"isCurrent\": true } },\n      \"requirementIds\": [\"FR-8\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/academic-years/:id\",\n      \"description\": \"Delete an academic year. Returns CONFLICT (409) if it has terms or is referenced elsewhere.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n      \"requirementIds\": [\"FR-9\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/academic-years/:id/terms\",\n      \"description\": \"Create a term under this academic year. Validates term dates fall inside the year's range and do not overlap sibling terms; order auto-assigns as max+1.\",\n      \"requestSchema\": { \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/academic-years/:id/terms/generate\",\n      \"description\": \"Split the year's date range into equal consecutive, named, contiguous terms. Only allowed when the year has zero terms. Earlier terms get the extra day when the range doesn't divide evenly.\",\n      \"requestSchema\": { \"pattern\": \"'SEMESTERS' | 'TRIMESTERS' | 'QUARTERS'\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } ] },\n      \"requirementIds\": [\"FR-14\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/terms/:id\",\n      \"description\": \"Update a term's name/dates/order. Re-validates range and sibling-overlap rules.\",\n      \"requestSchema\": { \"name\": \"string?\", \"startDate\": \"date?\", \"endDate\": \"date?\", \"order\": \"int?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"academicYearId\": \"string\", \"name\": \"string\", \"startDate\": \"date\", \"endDate\": \"date\", \"order\": \"int\" } },\n      \"requirementIds\": [\"FR-12\", \"FR-13\", \"NFR-1\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/terms/:id\",\n      \"description\": \"Delete a term.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n      \"requirementIds\": [\"FR-12\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/terms/reorder\",\n      \"description\": \"Persist a new term order for one academic year (drag handle or up/down buttons).\",\n      \"requestSchema\": { \"academicYearId\": \"string\", \"termIds\": \"string[]\" },\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"order\": \"int\" } ] },\n      \"requirementIds\": [\"FR-13\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/grade-levels\",\n      \"description\": \"List grade levels ordered by `order`. ?includeArchived=true includes archived rows.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-15\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/grade-levels\",\n      \"description\": \"Create a grade level.\",\n      \"requestSchema\": { \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\" } },\n      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/grade-levels/:id\",\n      \"description\": \"Update fields, reorder, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n      \"requestSchema\": { \"name\": \"string?\", \"shortName\": \"string?\", \"order\": \"int?\", \"archived\": \"boolean?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"shortName\": \"string\", \"order\": \"int\", \"archivedAt\": \"datetime|null\" } },\n      \"requirementIds\": [\"FR-15\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/subjects\",\n      \"description\": \"List subjects, searchable by name/code via ?q=.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string(hex)\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/subjects\",\n      \"description\": \"Create a subject. Code is normalised upper-case; duplicate code returns CONFLICT (409) with field error 'Code already used by <subject>.'\",\n      \"requestSchema\": { \"name\": \"string\", \"code\": \"string (2-10 chars, normalised upper-case)\", \"description\": \"string?\", \"color\": \"string(hex, one of 12 preset swatches)\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\" } },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/subjects/:id\",\n      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n      \"requestSchema\": { \"name\": \"string?\", \"code\": \"string?\", \"description\": \"string?\", \"color\": \"string(hex)?\", \"archived\": \"boolean?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"code\": \"string\", \"description\": \"string|null\", \"color\": \"string\", \"archivedAt\": \"datetime|null\" } },\n      \"requirementIds\": [\"FR-16\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/rooms\",\n      \"description\": \"List rooms.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": [ { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\", \"archivedAt\": \"datetime|null\" } ] },\n      \"requirementIds\": [\"FR-17\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/rooms\",\n      \"description\": \"Create a room.\",\n      \"requestSchema\": { \"name\": \"string\", \"building\": \"string?\", \"capacity\": \"int (1-500)?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\" } },\n      \"requirementIds\": [\"FR-17\", \"NFR-6\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/rooms/:id\",\n      \"description\": \"Update fields, or archive/unarchive ({ archived: true|false }) when referenced elsewhere instead of deleting.\",\n      \"requestSchema\": { \"name\": \"string?\", \"building\": \"string?\", \"capacity\": \"int?\", \"archived\": \"boolean?\" },\n      \"responseSchema\": { \"data\": { \"id\": \"string\", \"name\": \"string\", \"building\": \"string|null\", \"capacity\": \"int|null\", \"archivedAt\": \"datetime|null\" } },\n      \"requirementIds\": [\"FR-17\", \"NFR-6\", \"NFR-7\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","userModified":false}}
