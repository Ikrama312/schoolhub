{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgtXRWj7X472bADZUtqd7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016DMcehc1fAyx4aMmN1uHCk","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-15\",\n  \"timestamp\": \"2026-11-10T13:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the stale SH-14 contracts.\",\n    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (FR-43, NFR-6)\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with schemas from src/lib/validators/{absence-notes,conferences,consent-forms}.ts → access helper (assertCanViewStudent, assertHomeroomOrAdmin, assertConsentOwnerOrAdmin) → one service call → ok(data) / ok(data, {status:201}) / paginated(rows, meta). Everything comes from src/server/http.ts. Do not hand-roll envelopes. (FR-43, NFR-5, NFR-7)\",\n    \"envelopes\": {\n      \"success\": \"{ data: T }\",\n      \"list\": \"{ data: T[], meta: { page, pageSize, total } } via paginated(). The query takes ?page (default 1), ?pageSize (default 20, clamped to 100 by parsePagination), ?sort=<field>:<asc|desc> and ?q. (NFR-10)\",\n      \"error\": \"{ error: { code, message, details? } }\",\n      \"nonJson\": \"GET /api/conference-slots/:id/ics returns text/calendar. GET /api/consent-forms/:id/tracking?format=csv returns text/csv with Content-Disposition: attachment.\"\n    },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409,\n      \"RATE_LIMITED\": 429,\n      \"INTERNAL\": 500\n    },\n    \"errorPolicy\": [\n      \"A studentId the caller cannot view, or a note/form/slot belonging to one, returns 404 NOT_FOUND so existence does not leak. (NFR-5)\",\n      \"A visible resource the caller may not act on returns 403 FORBIDDEN with details.reason. The reasons are NOT_HOMEROOM, NOT_FORM_OWNER, NOT_SLOT_TEACHER, NOT_BOOKER and AUDIENCE_NOT_ALLOWED. (NFR-5, FR-21, FR-36, FR-39)\",\n      \"Business-rule failures that the caller can fix by changing input return 400 VALIDATION_ERROR with details.reason. The reasons are OUTSIDE_BOOKING_WINDOW, PAST_DUE, SIGNATURE_MISMATCH and DATE_WINDOW. http.ts has no 422 code, so system-design's '422' maps to 400. (FR-18, FR-32, FR-37)\",\n      \"State races return 409 CONFLICT with details.reason. The reasons are SLOT_TAKEN ('That slot was just taken'), OVERLAP ('You already have a meeting with <teacher> at <time>'), ONE_PER_TEACHER, ALREADY_REVIEWED and SLOT_BOOKED. (NFR-1, FR-22, FR-29, FR-31)\",\n      \"The remind throttle returns 429 RATE_LIMITED with details.retryAfterMs and a Retry-After header. (FR-39)\"\n    ],\n    \"dates\": \"Date-only fields are 'yyyy-MM-dd' strings (@db.Date). Instants are ISO 8601 UTC. Every 'today' / window / due rule is evaluated in SchoolSettings.timezone via schoolToday(). (NFR-8)\",\n    \"audit\": \"Absence review, consent respond/change and conference event create/update call audit({ request }) so getClientIp() captures the IP. (NFR-3, FR-23, FR-38)\"\n  },\n\n  \"components\": {\n    \"AbsenceNoteInput\": {\n      \"studentId\": \"string (cuid)\",\n      \"fromDate\": \"yyyy-MM-dd, ≥ schoolToday − 14 days\",\n      \"toDate\": \"yyyy-MM-dd, ≥ fromDate, ≤ schoolToday + 60 days, span ≤ 30 days\",\n      \"partialDay\": \"boolean\",\n      \"periodIds\": \"string[]. Required and non-empty when partialDay is true. Must be empty or absent when it is false.\",\n      \"reason\": \"AbsenceReason\",\n      \"details\": \"string, ≤ 1000 chars, optional\",\n      \"fileId\": \"string, optional. Must be a File uploaded with context 'absence-note'.\"\n    },\n    \"AbsenceNote\": {\n      \"id\": \"string\",\n      \"student\": \"{ id, firstName, lastName, sectionName }\",\n      \"submittedBy\": \"{ id, name }\",\n      \"fromDate\": \"yyyy-MM-dd\",\n      \"toDate\": \"yyyy-MM-dd\",\n      \"partialDay\": \"boolean\",\n      \"periods\": \"{ id, name }[]\",\n      \"reason\": \"AbsenceReason\",\n      \"details\": \"string | null\",\n      \"file\": \"{ id, name, url } | null\",\n      \"status\": \"PENDING | APPROVED | REJECTED\",\n      \"reviewedBy\": \"{ id, name } | null\",\n      \"reviewNote\": \"string | null\",\n      \"reviewedAt\": \"ISO | null\",\n      \"createdAt\": \"ISO\"\n    },\n    \"ConferenceEventInput\": {\n      \"title\": \"string, 1..200\",\n      \"date\": \"yyyy-MM-dd\",\n      \"bookingOpensAt\": \"ISO\",\n      \"bookingClosesAt\": \"ISO, > bookingOpensAt, ≤ the end of `date` in the school timezone\",\n      \"slotMinutes\": \"int 5..60\",\n      \"gradeLevelIds\": \"string[], at least 1\"\n    },\n    \"ConferenceEvent\": {\n      \"id\": \"string\",\n      \"title\": \"string\",\n      \"date\": \"yyyy-MM-dd\",\n      \"bookingOpensAt\": \"ISO\",\n      \"bookingClosesAt\": \"ISO\",\n      \"slotMinutes\": \"int\",\n      \"gradeLevels\": \"{ id, name }[]\",\n      \"bookingOpen\": \"boolean (computed)\",\n      \"createdBy\": \"{ id, name }\"\n    },\n    \"ConferenceSlot\": {\n      \"id\": \"string\",\n      \"eventId\": \"string\",\n      \"teacher\": \"{ id, name, subjects: string[] }\",\n      \"startsAt\": \"ISO\",\n      \"endsAt\": \"ISO\",\n      \"location\": \"string | null\",\n      \"blocked\": \"boolean\",\n      \"available\": \"boolean (not booked and not blocked)\",\n      \"booking\": \"{ parent: { id, name }, student: { id, firstName, lastName }, parentNote: string | null } | null. Only the booking parent, the slot's teacher and ADMIN see this field. Everyone else gets null and sees only `available`. (NFR-5)\",\n      \"mine\": \"boolean (booked by the caller)\"\n    },\n    \"ConsentFormInput\": {\n      \"title\": \"string, 1..200\",\n      \"description\": \"string (Markdown), 1..10000\",\n      \"dueAt\": \"ISO, in the future\",\n      \"eventId\": \"string | null (CalendarEvent)\",\n      \"audiences\": \"{ type: 'GRADE_LEVEL' | 'SECTION' | 'COURSE', refId: string }[], 1..20. TEACHER callers may only use COURSE refIds they manage. Anything else returns 403 AUDIENCE_NOT_ALLOWED.\"\n    },\n    \"ConsentForm\": {\n      \"id\": \"string\",\n      \"title\": \"string\",\n      \"description\": \"string (Markdown)\",\n      \"dueAt\": \"ISO\",\n      \"event\": \"{ id, title, startsAt } | null\",\n      \"audiences\": \"{ type, refId, label }[]\",\n      \"createdBy\": \"{ id, name }\",\n      \"lastRemindedAt\": \"ISO | null (creator/admin only)\",\n      \"counts\": \"{ granted, declined, noResponse } (creator/admin only)\",\n      \"children\": \"PARENT only: { studentId, firstName, response: { value, respondedBy: { id, name }, comment, updatedAt } | null }[], listing every linked child in the audience\"\n    },\n    \"ConsentResponseInput\": {\n      \"studentId\": \"string\",\n      \"value\": \"GRANTED | DECLINED\",\n      \"signature\": \"string, 1..200. Must match the caller's full name after trim().toLowerCase().\",\n      \"comment\": \"string, ≤ 1000, optional\"\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/me/selected-child\",\n      \"description\": \"PARENT. Sets the sh_child cookie (httpOnly, sameSite=lax, 1 year) after checking ParentStudentLink. An unlinked studentId returns 404. The client then calls router.refresh().\",\n      \"requestSchema\": { \"studentId\": \"string\" },\n      \"responseSchema\": { \"data\": { \"studentId\": \"string\" } },\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-6\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/children/summary\",\n      \"description\": \"PARENT. Returns one summary card per linked child for /my-children. Data comes from overview-service.getChildrenSummary.\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"data\": [\n          {\n            \"student\": \"{ id, firstName, lastName, avatarUrl, sectionName }\",\n            \"attendanceRateTerm\": \"number 0..1 | null\",\n            \"missingAssignments\": \"int\",\n            \"averageGradePct\": \"number | null\"\n          }\n        ]\n      },\n      \"requirementIds\": [\"FR-7\", \"FR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/:id/overview\",\n      \"description\": \"PARENT (linked child) or staff, checked by assertCanViewStudent. Returns all eight overview cards from the same overview-service functions the streaming page uses. ?cards=today,attendance,... limits which cards load.\",\n      \"requestSchema\": { \"query\": { \"cards\": \"comma list of today|attendance|assignments|grades|announcements|events|teachers|actions, optional\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"today\": \"{ isSchoolDay: boolean, noSchoolReason: string | null, periods: { periodName, startsAt, endsAt, courseName, room, teacherName }[] }\",\n          \"attendance\": \"{ rateTerm: number | null, absences: int, lates: int, last5: { date, periodName | null, status }[] }\",\n          \"assignments\": \"{ missing: { id, title, courseName, dueAt }[], dueNext7Days: { id, title, courseName, dueAt }[] }\",\n          \"grades\": \"{ recent: { gradeItemId, title, courseName, score, maxScore, returnedAt }[], courses: { courseId, courseName, currentPct: number | null }[] }\",\n          \"announcements\": \"[] for now, because PRD-12 is absent (FR-13 partial)\",\n          \"events\": \"{ id, title, startsAt, endsAt, allDay, source: 'calendar' | 'myMeetings' }[], at most 5\",\n          \"teachers\": \"{ userId, name, subjects: string[], messageHref }[]\",\n          \"actions\": \"{ type: 'consent' | 'conference', id, title, dueAt | bookingClosesAt, href }[]\"\n        }\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-17\", \"FR-35\", \"NFR-2\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/absence-notes\",\n      \"description\": \"Paginated and scoped by role. PARENT sees notes for linked children. A homeroom TEACHER sees their own section's students. ADMIN sees all. A non-homeroom TEACHER gets 403 NOT_HOMEROOM. Default sort is createdAt:desc. ?q matches the student name.\",\n      \"requestSchema\": { \"query\": { \"status\": \"PENDING|APPROVED|REJECTED, optional\", \"studentId\": \"optional\", \"from\": \"yyyy-MM-dd, optional\", \"to\": \"yyyy-MM-dd, optional\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"createdAt|fromDate:asc|desc\", \"q\": \"string\" } },\n      \"responseSchema\": { \"data\": \"AbsenceNote[]\", \"meta\": \"{ page, pageSize, total }\" },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-5\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/absence-notes\",\n      \"description\": \"PARENT, for a linked child only. Creates a PENDING note and notifies the homeroom teacher and ADMINs with absence_note.submitted. Upload the file first via POST /api/files with context=absence-note.\",\n      \"requestSchema\": \"AbsenceNoteInput\",\n      \"responseSchema\": { \"status\": 201, \"data\": \"AbsenceNote\" },\n      \"requirementIds\": [\"FR-2\", \"FR-18\", \"FR-19\", \"FR-41\", \"FR-44\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/absence-notes/:id\",\n      \"description\": \"Detail view for the parent, homeroom teacher or ADMIN. Reviewers also get the attendance records that already exist for the note's dates and periods.\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"data\": \"AbsenceNote & { attendanceRecords?: { id, date, periodId | null, periodName | null, status, note | null }[] } (reviewers only)\"\n      },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"FR-41\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/absence-notes/:id/review\",\n      \"description\": \"Homeroom TEACHER or ADMIN. Runs a conditional update on a PENDING note. If the note is no longer PENDING, returns 409 ALREADY_REVIEWED. On APPROVED, covered ABSENT records and missing records become EXCUSED with the note 'Absence note #<id>', all in the same transaction. Then it calls audit({ request }) and notifies linked parents with absence_note.reviewed, including reviewNote.\",\n      \"requestSchema\": { \"decision\": \"APPROVED | REJECTED\", \"reviewNote\": \"string ≤ 1000. Required (min 1) when the decision is REJECTED.\" },\n      \"responseSchema\": { \"data\": { \"note\": \"AbsenceNote\", \"recordsExcused\": \"int\", \"recordsCreated\": \"int\" } },\n      \"requirementIds\": [\"FR-22\", \"FR-23\", \"FR-26\", \"FR-44\", \"NFR-3\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/files\",\n      \"description\": \"EXISTING, extended. Adds the context 'absence-note': PDF, JPG or PNG only, sniffed with file-type. Read access goes to linked parents, the homeroom teacher and ADMIN, through the resolver in src/server/files/contexts.ts. The multipart contract is unchanged.\",\n      \"requestSchema\": { \"multipart\": { \"context\": \"'absence-note' (sent before file)\", \"file\": \"binary, application/pdf | image/jpeg | image/png\" } },\n      \"responseSchema\": { \"status\": 201, \"data\": { \"id\": \"string\", \"name\": \"string\", \"size\": \"int\", \"mimeType\": \"string\" } },\n      \"requirementIds\": [\"FR-18\", \"FR-41\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conferences\",\n      \"description\": \"Lists events by role. ADMIN sees all. TEACHER sees events whose eligible grade levels include students they teach. PARENT sees events eligible for any linked child. Paginated, default sort date:desc, ?q matches the title.\",\n      \"requestSchema\": { \"query\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"date|title:asc|desc\", \"q\": \"string\", \"upcoming\": \"boolean, optional\" } },\n      \"responseSchema\": { \"data\": \"ConferenceEvent[]\", \"meta\": \"{ page, pageSize, total }\" },\n      \"requirementIds\": [\"FR-28\", \"FR-42\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conferences\",\n      \"description\": \"ADMIN. Creates an event, notifies teachers of eligible students with conference.slots_requested, and calls audit({ request }).\",\n      \"requestSchema\": \"ConferenceEventInput\",\n      \"responseSchema\": { \"status\": 201, \"data\": \"ConferenceEvent\" },\n      \"requirementIds\": [\"FR-2\", \"FR-28\", \"FR-44\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conferences/:id\",\n      \"description\": \"Event detail, visible to the same audience as the list. TEACHER callers also get mySlotCount. PARENT callers get the child's teachers that have slots.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": \"ConferenceEvent & { mySlotCount?: int, teachers?: { id, name, subjects: string[] }[] }\" },\n      \"requirementIds\": [\"FR-28\", \"FR-30\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/conferences/:id\",\n      \"description\": \"ADMIN. Partial ConferenceEventInput. Changing slotMinutes or date while booked slots exist returns 409 SLOT_BOOKED. Calls audit({ request }).\",\n      \"requestSchema\": \"Partial<ConferenceEventInput>\",\n      \"responseSchema\": { \"data\": \"ConferenceEvent\" },\n      \"requirementIds\": [\"FR-2\", \"FR-28\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/conferences/:id/availability\",\n      \"description\": \"TEACHER, for their own availability. In one transaction it deletes the caller's unbooked, unblocked slots and inserts slots generated from the ranges (generateSlots, slotMinutes). Booked and blocked slots stay. Ranges must lie within the event date and must not overlap.\",\n      \"requestSchema\": { \"ranges\": \"{ start: 'HH:mm', end: 'HH:mm' }[], 1..10, times in the school timezone on the event date\", \"location\": \"string ≤ 200, optional\" },\n      \"responseSchema\": { \"data\": { \"slots\": \"ConferenceSlot[]\", \"created\": \"int\", \"removed\": \"int\", \"kept\": \"int\" } },\n      \"requirementIds\": [\"FR-29\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conferences/:id/slots\",\n      \"description\": \"PARENT: slots of the selected child's teachers. The child comes from ?studentId, else sh_child via getSelectedChild. TEACHER: their own slots, with ?view=day returning only booked slots ordered by startsAt for the printable day view. ADMIN: all slots, filterable by teacherId. The view returns all slots, not a paginated list.\",\n      \"requestSchema\": { \"query\": { \"studentId\": \"optional (PARENT)\", \"teacherId\": \"optional (ADMIN)\", \"view\": \"'day', optional (TEACHER/ADMIN)\" } },\n      \"responseSchema\": { \"data\": \"ConferenceSlot[]\" },\n      \"requirementIds\": [\"FR-5\", \"FR-29\", \"FR-30\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/conference-slots/:id\",\n      \"description\": \"The slot's TEACHER, or ADMIN. Blocks or unblocks a slot, or edits its location. Blocking a booked slot returns 409 SLOT_BOOKED.\",\n      \"requestSchema\": { \"blocked\": \"boolean, optional\", \"location\": \"string ≤ 200 | null, optional\" },\n      \"responseSchema\": { \"data\": \"ConferenceSlot\" },\n      \"requirementIds\": [\"FR-29\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/conference-slots/:id\",\n      \"description\": \"The slot's TEACHER, or ADMIN. Removes an unbooked slot. A booked slot returns 409 SLOT_BOOKED.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n      \"requirementIds\": [\"FR-29\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conference-slots/:id/book\",\n      \"description\": \"PARENT, for a linked child. Only allowed while now is within [bookingOpensAt, bookingClosesAt], else 400 OUTSIDE_BOOKING_WINDOW. In one transaction: an overlap check against the parent's other bookings (409 OVERLAP), then updateMany where {id, bookedByParentId: null, blocked: false} (count 0 returns 409 SLOT_TAKEN), with P2002 on (eventId, teacherId, bookedForStudentId) returning 409 ONE_PER_TEACHER. After commit it sends conference.booked to the parent and teacher, with an ics link.\",\n      \"requestSchema\": { \"studentId\": \"string\", \"parentNote\": \"string ≤ 500, optional\" },\n      \"responseSchema\": { \"data\": \"ConferenceSlot\", \"errors\": { \"409\": \"{ error: { code: 'CONFLICT', message: 'That slot was just taken' | 'You already have a meeting with <teacher> at <time>' | ..., details: { reason } } }\" } },\n      \"requirementIds\": [\"FR-2\", \"FR-30\", \"FR-31\", \"FR-32\", \"FR-33\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conference-slots/:id/cancel\",\n      \"description\": \"The booking PARENT (403 NOT_BOOKER otherwise) or ADMIN. Only allowed before bookingClosesAt, else 400 OUTSIDE_BOOKING_WINDOW. Clears the booking fields and sends conference.cancelled to the parent and teacher. To reschedule, the client cancels and then books.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": \"ConferenceSlot\" },\n      \"requirementIds\": [\"FR-32\", \"FR-33\", \"FR-44\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conference-slots/:id/ics\",\n      \"description\": \"The booking parent, the slot's teacher, or ADMIN. Returns a single VEVENT built with src/server/calendar/ical.ts.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"contentType\": \"text/calendar; charset=utf-8\", \"body\": \"VCALENDAR with one VEVENT (UID slot-<id>@schoolhub, DTSTART/DTEND UTC, SUMMARY, LOCATION)\" },\n      \"requirementIds\": [\"FR-33\", \"FR-35\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/consent-forms\",\n      \"description\": \"PARENT: forms whose audience includes a linked child, with children[] response status. ?pending=true filters to forms not yet answered for some child. TEACHER: forms they created. ADMIN: all forms. Paginated, default sort dueAt:asc, ?q matches the title.\",\n      \"requestSchema\": { \"query\": { \"pending\": \"boolean, optional\", \"studentId\": \"optional (PARENT)\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"dueAt|createdAt:asc|desc\", \"q\": \"string\" } },\n      \"responseSchema\": { \"data\": \"ConsentForm[]\", \"meta\": \"{ page, pageSize, total }\" },\n      \"requirementIds\": [\"FR-16\", \"FR-37\", \"FR-42\", \"NFR-5\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/consent-forms\",\n      \"description\": \"ADMIN can target any audience. TEACHER can only target COURSE audiences they manage, checked by canTargetAudience per row. Creates the form and notifies parents of resolved audience students with consent.requested.\",\n      \"requestSchema\": \"ConsentFormInput\",\n      \"responseSchema\": { \"status\": 201, \"data\": \"ConsentForm & { notifiedParents: int }\" },\n      \"requirementIds\": [\"FR-36\", \"FR-44\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/consent-forms/:id\",\n      \"description\": \"The audience's parents (with their own children[]), the creator, or ADMIN. Anyone else gets 404.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": \"ConsentForm\" },\n      \"requirementIds\": [\"FR-36\", \"FR-37\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/consent-forms/:id/responses\",\n      \"description\": \"PARENT, for a linked child in the audience. Only allowed while now < dueAt, else 400 PAST_DUE. The signature must match the caller's full name case-insensitively, else 400 SIGNATURE_MISMATCH. Upserts by (formId, studentId), so any linked parent overwrites the single response. Calls audit({ before, after, request }) on create and on every change.\",\n      \"requestSchema\": \"ConsentResponseInput\",\n      \"responseSchema\": { \"data\": { \"formId\": \"string\", \"studentId\": \"string\", \"value\": \"GRANTED | DECLINED\", \"respondedBy\": \"{ id, name }\", \"comment\": \"string | null\", \"updatedAt\": \"ISO\", \"changed\": \"boolean (true if it overwrote a previous response)\" } },\n      \"requirementIds\": [\"FR-37\", \"FR-38\", \"NFR-3\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/consent-forms/:id/tracking\",\n      \"description\": \"The creator or ADMIN (assertConsentOwnerOrAdmin, 403 NOT_FORM_OWNER otherwise). Returns one row per audience student. ?format=csv returns the whole filtered set as CSV via src/server/csv.ts, without pagination.\",\n      \"requestSchema\": { \"query\": { \"status\": \"GRANTED|DECLINED|NO_RESPONSE, optional\", \"format\": \"'csv', optional\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"studentName|status|respondedAt:asc|desc\", \"q\": \"string (student name)\" } },\n      \"responseSchema\": {\n        \"data\": [ { \"student\": \"{ id, firstName, lastName, sectionName }\", \"status\": \"GRANTED | DECLINED | NO_RESPONSE\", \"respondedBy\": \"{ id, name } | null\", \"respondedAt\": \"ISO | null\", \"comment\": \"string | null\" } ],\n        \"meta\": \"{ page, pageSize, total, counts: { granted, declined, noResponse } }\",\n        \"csv\": \"columns: Student, Section, Status, Responded by, Responded at, Comment\"\n      },\n      \"requirementIds\": [\"FR-39\", \"NFR-5\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/consent-forms/:id/remind\",\n      \"description\": \"The creator or ADMIN. Claims the throttle with updateMany where {id, lastRemindedAt null or < now − 24h}. A count of 0 returns 429 RATE_LIMITED with details.retryAfterMs. Otherwise sends consent.reminder to parents of non-responding students. A form past dueAt returns 400 PAST_DUE.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"notifiedParents\": \"int\", \"remindedAt\": \"ISO\" } },\n      \"requirementIds\": [\"FR-39\", \"FR-44\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/timetable\",\n      \"description\": \"EXISTING, extended. When a PARENT omits studentId, it defaults to getSelectedChild (sh_child, then the first child) instead of erroring or asking. An explicit ?studentId= still overrides it. /assignments and /grades pages use the same default server-side. The response shape is unchanged.\",\n      \"requestSchema\": { \"query\": { \"studentId\": \"optional override\" } },\n      \"responseSchema\": { \"data\": \"unchanged existing timetable shape\" },\n      \"requirementIds\": [\"FR-5\", \"FR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"EXISTING, extended (getRegister). For each student covered by an APPROVED note, it pre-fills status EXCUSED when no record exists and adds absence-note fields. The teacher can still change the status.\",\n      \"requestSchema\": { \"query\": \"unchanged\" },\n      \"responseSchema\": { \"data\": \"existing register shape; each student row gains { absenceNoteId: string | null, excusable: boolean, prefilled: boolean }\" },\n      \"requirementIds\": [\"FR-24\", \"FR-25\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"EXISTING, extended (saveRegister). EXCUSED is accepted if the caller is ADMIN or an APPROVED note covers the student/date/period. Otherwise it returns 403 with details.reason='NO_APPROVED_NOTE'. attendance.absent notifications skip students covered by a PENDING or APPROVED note.\",\n      \"requestSchema\": \"unchanged\",\n      \"responseSchema\": { \"data\": \"unchanged\" },\n      \"requirementIds\": [\"FR-25\", \"FR-27\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING cron route, extended. Adds an isolated try-block that calls sendConsentDueReminders(now). For each form with dueAt in (now, now+48h] and a null dueReminderSentAt, it claims the form and sends consent.reminder to non-responders. A failure is logged and does not abort the other jobs.\",\n      \"requestSchema\": \"unchanged (internal auth)\",\n      \"responseSchema\": { \"data\": \"existing summary & { consentReminders: { forms: int, notified: int } }\" },\n      \"requirementIds\": [\"FR-40\", \"FR-44\", \"NFR-8\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    {\n      \"name\": \"NOTIFICATION_TYPES additions (src/server/notifications/types.ts)\",\n      \"shape\": \"absence_note.submitted (email false), absence_note.reviewed (email true), conference.slots_requested, conference.booked, conference.cancelled, consent.requested (email true), consent.reminder (email true)\",\n      \"requirementIds\": [\"FR-19\", \"FR-26\", \"FR-28\", \"FR-33\", \"FR-36\", \"FR-40\", \"FR-44\"]\n    },\n    {\n      \"name\": \"getSelectedChild(user, searchParams?) → { studentId, firstName } | null\",\n      \"shape\": \"React cache(). Checks a linked ?studentId first, then a linked sh_child cookie, then the first linked child. Never throws on a bad cookie.\",\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"NFR-5\"]\n    },\n    {\n      \"name\": \"Pure helpers\",\n      \"shape\": \"coversRecord(note, { date, periodId }) → boolean; generateSlots(ranges, slotMinutes) → { startsAt, endsAt }[]; overlaps(a, b) → boolean; signatureMatches(typed, fullName) → boolean\",\n      \"requirementIds\": [\"FR-23\", \"FR-29\", \"FR-31\", \"FR-37\", \"FR-46\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":712,"cache_read_input_tokens":57184,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":712},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6637fabe-b275-41d2-a9c7-8a4e5da1a9d1","uuid":"54bce6a3-6be1-41e3-92a2-04b1711915ba","timestamp":"2026-11-10T03:20:30.664Z","request_id":"req_011CgtXRWXiEYkQJMu9awLTW","wire_tool_inputs":{"toolu_016DMcehc1fAyx4aMmN1uHCk":{"file_path":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-15\",\n  \"timestamp\": \"2026-11-10T13:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the stale SH-14 contracts.\",\n    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (FR-43, NFR-6)\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with schemas from src/lib/validators/{absence-notes,conferences,consent-forms}.ts → access helper (assertCanViewStudent, assertHomeroomOrAdmin, assertConsentOwnerOrAdmin) → one service call → ok(data) / ok(data, {status:201}) / paginated(rows, meta). Everything comes from src/server/http.ts. Do not hand-roll envelopes. (FR-43, NFR-5, NFR-7)\",\n    \"envelopes\": {\n      \"success\": \"{ data: T }\",\n      \"list\": \"{ data: T[], meta: { page, pageSize, total } } via paginated(). The query takes ?page (default 1), ?pageSize (default 20, clamped to 100 by parsePagination), ?sort=<field>:<asc|desc> and ?q. (NFR-10)\",\n      \"error\": \"{ error: { code, message, details? } }\",\n      \"nonJson\": \"GET /api/conference-slots/:id/ics returns text/calendar. GET /api/consent-forms/:id/tracking?format=csv returns text/csv with Content-Disposition: attachment.\"\n    },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409,\n      \"RATE_LIMITED\": 429,\n      \"INTERNAL\": 500\n    },\n    \"errorPolicy\": [\n      \"A studentId the caller cannot view, or a note/form/slot belonging to one, returns 404 NOT_FOUND so existence does not leak. (NFR-5)\",\n      \"A visible resource the caller may not act on returns 403 FORBIDDEN with details.reason. The reasons are NOT_HOMEROOM, NOT_FORM_OWNER, NOT_SLOT_TEACHER, NOT_BOOKER and AUDIENCE_NOT_ALLOWED. (NFR-5, FR-21, FR-36, FR-39)\",\n      \"Business-rule failures that the caller can fix by changing input return 400 VALIDATION_ERROR with details.reason. The reasons are OUTSIDE_BOOKING_WINDOW, PAST_DUE, SIGNATURE_MISMATCH and DATE_WINDOW. http.ts has no 422 code, so system-design's '422' maps to 400. (FR-18, FR-32, FR-37)\",\n      \"State races return 409 CONFLICT with details.reason. The reasons are SLOT_TAKEN ('That slot was just taken'), OVERLAP ('You already have a meeting with <teacher> at <time>'), ONE_PER_TEACHER, ALREADY_REVIEWED and SLOT_BOOKED. (NFR-1, FR-22, FR-29, FR-31)\",\n      \"The remind throttle returns 429 RATE_LIMITED with details.retryAfterMs and a Retry-After header. (FR-39)\"\n    ],\n    \"dates\": \"Date-only fields are 'yyyy-MM-dd' strings (@db.Date). Instants are ISO 8601 UTC. Every 'today' / window / due rule is evaluated in SchoolSettings.timezone via schoolToday(). (NFR-8)\",\n    \"audit\": \"Absence review, consent respond/change and conference event create/update call audit({ request }) so getClientIp() captures the IP. (NFR-3, FR-23, FR-38)\"\n  },\n\n  \"components\": {\n    \"AbsenceNoteInput\": {\n      \"studentId\": \"string (cuid)\",\n      \"fromDate\": \"yyyy-MM-dd, ≥ schoolToday − 14 days\",\n      \"toDate\": \"yyyy-MM-dd, ≥ fromDate, ≤ schoolToday + 60 days, span ≤ 30 days\",\n      \"partialDay\": \"boolean\",\n      \"periodIds\": \"string[]. Required and non-empty when partialDay is true. Must be empty or absent when it is false.\",\n      \"reason\": \"AbsenceReason\",\n      \"details\": \"string, ≤ 1000 chars, optional\",\n      \"fileId\": \"string, optional. Must be a File uploaded with context 'absence-note'.\"\n    },\n    \"AbsenceNote\": {\n      \"id\": \"string\",\n      \"student\": \"{ id, firstName, lastName, sectionName }\",\n      \"submittedBy\": \"{ id, name }\",\n      \"fromDate\": \"yyyy-MM-dd\",\n      \"toDate\": \"yyyy-MM-dd\",\n      \"partialDay\": \"boolean\",\n      \"periods\": \"{ id, name }[]\",\n      \"reason\": \"AbsenceReason\",\n      \"details\": \"string | null\",\n      \"file\": \"{ id, name, url } | null\",\n      \"status\": \"PENDING | APPROVED | REJECTED\",\n      \"reviewedBy\": \"{ id, name } | null\",\n      \"reviewNote\": \"string | null\",\n      \"reviewedAt\": \"ISO | null\",\n      \"createdAt\": \"ISO\"\n    },\n    \"ConferenceEventInput\": {\n      \"title\": \"string, 1..200\",\n      \"date\": \"yyyy-MM-dd\",\n      \"bookingOpensAt\": \"ISO\",\n      \"bookingClosesAt\": \"ISO, > bookingOpensAt, ≤ the end of `date` in the school timezone\",\n      \"slotMinutes\": \"int 5..60\",\n      \"gradeLevelIds\": \"string[], at least 1\"\n    },\n    \"ConferenceEvent\": {\n      \"id\": \"string\",\n      \"title\": \"string\",\n      \"date\": \"yyyy-MM-dd\",\n      \"bookingOpensAt\": \"ISO\",\n      \"bookingClosesAt\": \"ISO\",\n      \"slotMinutes\": \"int\",\n      \"gradeLevels\": \"{ id, name }[]\",\n      \"bookingOpen\": \"boolean (computed)\",\n      \"createdBy\": \"{ id, name }\"\n    },\n    \"ConferenceSlot\": {\n      \"id\": \"string\",\n      \"eventId\": \"string\",\n      \"teacher\": \"{ id, name, subjects: string[] }\",\n      \"startsAt\": \"ISO\",\n      \"endsAt\": \"ISO\",\n      \"location\": \"string | null\",\n      \"blocked\": \"boolean\",\n      \"available\": \"boolean (not booked and not blocked)\",\n      \"booking\": \"{ parent: { id, name }, student: { id, firstName, lastName }, parentNote: string | null } | null. Only the booking parent, the slot's teacher and ADMIN see this field. Everyone else gets null and sees only `available`. (NFR-5)\",\n      \"mine\": \"boolean (booked by the caller)\"\n    },\n    \"ConsentFormInput\": {\n      \"title\": \"string, 1..200\",\n      \"description\": \"string (Markdown), 1..10000\",\n      \"dueAt\": \"ISO, in the future\",\n      \"eventId\": \"string | null (CalendarEvent)\",\n      \"audiences\": \"{ type: 'GRADE_LEVEL' | 'SECTION' | 'COURSE', refId: string }[], 1..20. TEACHER callers may only use COURSE refIds they manage. Anything else returns 403 AUDIENCE_NOT_ALLOWED.\"\n    },\n    \"ConsentForm\": {\n      \"id\": \"string\",\n      \"title\": \"string\",\n      \"description\": \"string (Markdown)\",\n      \"dueAt\": \"ISO\",\n      \"event\": \"{ id, title, startsAt } | null\",\n      \"audiences\": \"{ type, refId, label }[]\",\n      \"createdBy\": \"{ id, name }\",\n      \"lastRemindedAt\": \"ISO | null (creator/admin only)\",\n      \"counts\": \"{ granted, declined, noResponse } (creator/admin only)\",\n      \"children\": \"PARENT only: { studentId, firstName, response: { value, respondedBy: { id, name }, comment, updatedAt } | null }[], listing every linked child in the audience\"\n    },\n    \"ConsentResponseInput\": {\n      \"studentId\": \"string\",\n      \"value\": \"GRANTED | DECLINED\",\n      \"signature\": \"string, 1..200. Must match the caller's full name after trim().toLowerCase().\",\n      \"comment\": \"string, ≤ 1000, optional\"\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/me/selected-child\",\n      \"description\": \"PARENT. Sets the sh_child cookie (httpOnly, sameSite=lax, 1 year) after checking ParentStudentLink. An unlinked studentId returns 404. The client then calls router.refresh().\",\n      \"requestSchema\": { \"studentId\": \"string\" },\n      \"responseSchema\": { \"data\": { \"studentId\": \"string\" } },\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-6\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/children/summary\",\n      \"description\": \"PARENT. Returns one summary card per linked child for /my-children. Data comes from overview-service.getChildrenSummary.\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"data\": [\n          {\n            \"student\": \"{ id, firstName, lastName, avatarUrl, sectionName }\",\n            \"attendanceRateTerm\": \"number 0..1 | null\",\n            \"missingAssignments\": \"int\",\n            \"averageGradePct\": \"number | null\"\n          }\n        ]\n      },\n      \"requirementIds\": [\"FR-7\", \"FR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/:id/overview\",\n      \"description\": \"PARENT (linked child) or staff, checked by assertCanViewStudent. Returns all eight overview cards from the same overview-service functions the streaming page uses. ?cards=today,attendance,... limits which cards load.\",\n      \"requestSchema\": { \"query\": { \"cards\": \"comma list of today|attendance|assignments|grades|announcements|events|teachers|actions, optional\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"today\": \"{ isSchoolDay: boolean, noSchoolReason: string | null, periods: { periodName, startsAt, endsAt, courseName, room, teacherName }[] }\",\n          \"attendance\": \"{ rateTerm: number | null, absences: int, lates: int, last5: { date, periodName | null, status }[] }\",\n          \"assignments\": \"{ missing: { id, title, courseName, dueAt }[], dueNext7Days: { id, title, courseName, dueAt }[] }\",\n          \"grades\": \"{ recent: { gradeItemId, title, courseName, score, maxScore, returnedAt }[], courses: { courseId, courseName, currentPct: number | null }[] }\",\n          \"announcements\": \"[] for now, because PRD-12 is absent (FR-13 partial)\",\n          \"events\": \"{ id, title, startsAt, endsAt, allDay, source: 'calendar' | 'myMeetings' }[], at most 5\",\n          \"teachers\": \"{ userId, name, subjects: string[], messageHref }[]\",\n          \"actions\": \"{ type: 'consent' | 'conference', id, title, dueAt | bookingClosesAt, href }[]\"\n        }\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-17\", \"FR-35\", \"NFR-2\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/absence-notes\",\n      \"description\": \"Paginated and scoped by role. PARENT sees notes for linked children. A homeroom TEACHER sees their own section's students. ADMIN sees all. A non-homeroom TEACHER gets 403 NOT_HOMEROOM. Default sort is createdAt:desc. ?q matches the student name.\",\n      \"requestSchema\": { \"query\": { \"status\": \"PENDING|APPROVED|REJECTED, optional\", \"studentId\": \"optional\", \"from\": \"yyyy-MM-dd, optional\", \"to\": \"yyyy-MM-dd, optional\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"createdAt|fromDate:asc|desc\", \"q\": \"string\" } },\n      \"responseSchema\": { \"data\": \"AbsenceNote[]\", \"meta\": \"{ page, pageSize, total }\" },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-5\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/absence-notes\",\n      \"description\": \"PARENT, for a linked child only. Creates a PENDING note and notifies the homeroom teacher and ADMINs with absence_note.submitted. Upload the file first via POST /api/files with context=absence-note.\",\n      \"requestSchema\": \"AbsenceNoteInput\",\n      \"responseSchema\": { \"status\": 201, \"data\": \"AbsenceNote\" },\n      \"requirementIds\": [\"FR-2\", \"FR-18\", \"FR-19\", \"FR-41\", \"FR-44\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/absence-notes/:id\",\n      \"description\": \"Detail view for the parent, homeroom teacher or ADMIN. Reviewers also get the attendance records that already exist for the note's dates and periods.\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"data\": \"AbsenceNote & { attendanceRecords?: { id, date, periodId | null, periodName | null, status, note | null }[] } (reviewers only)\"\n      },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"FR-41\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/absence-notes/:id/review\",\n      \"description\": \"Homeroom TEACHER or ADMIN. Runs a conditional update on a PENDING note. If the note is no longer PENDING, returns 409 ALREADY_REVIEWED. On APPROVED, covered ABSENT records and missing records become EXCUSED with the note 'Absence note #<id>', all in the same transaction. Then it calls audit({ request }) and notifies linked parents with absence_note.reviewed, including reviewNote.\",\n      \"requestSchema\": { \"decision\": \"APPROVED | REJECTED\", \"reviewNote\": \"string ≤ 1000. Required (min 1) when the decision is REJECTED.\" },\n      \"responseSchema\": { \"data\": { \"note\": \"AbsenceNote\", \"recordsExcused\": \"int\", \"recordsCreated\": \"int\" } },\n      \"requirementIds\": [\"FR-22\", \"FR-23\", \"FR-26\", \"FR-44\", \"NFR-3\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/files\",\n      \"description\": \"EXISTING, extended. Adds the context 'absence-note': PDF, JPG or PNG only, sniffed with file-type. Read access goes to linked parents, the homeroom teacher and ADMIN, through the resolver in src/server/files/contexts.ts. The multipart contract is unchanged.\",\n      \"requestSchema\": { \"multipart\": { \"context\": \"'absence-note' (sent before file)\", \"file\": \"binary, application/pdf | image/jpeg | image/png\" } },\n      \"responseSchema\": { \"status\": 201, \"data\": { \"id\": \"string\", \"name\": \"string\", \"size\": \"int\", \"mimeType\": \"string\" } },\n      \"requirementIds\": [\"FR-18\", \"FR-41\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conferences\",\n      \"description\": \"Lists events by role. ADMIN sees all. TEACHER sees events whose eligible grade levels include students they teach. PARENT sees events eligible for any linked child. Paginated, default sort date:desc, ?q matches the title.\",\n      \"requestSchema\": { \"query\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"date|title:asc|desc\", \"q\": \"string\", \"upcoming\": \"boolean, optional\" } },\n      \"responseSchema\": { \"data\": \"ConferenceEvent[]\", \"meta\": \"{ page, pageSize, total }\" },\n      \"requirementIds\": [\"FR-28\", \"FR-42\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conferences\",\n      \"description\": \"ADMIN. Creates an event, notifies teachers of eligible students with conference.slots_requested, and calls audit({ request }).\",\n      \"requestSchema\": \"ConferenceEventInput\",\n      \"responseSchema\": { \"status\": 201, \"data\": \"ConferenceEvent\" },\n      \"requirementIds\": [\"FR-2\", \"FR-28\", \"FR-44\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conferences/:id\",\n      \"description\": \"Event detail, visible to the same audience as the list. TEACHER callers also get mySlotCount. PARENT callers get the child's teachers that have slots.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": \"ConferenceEvent & { mySlotCount?: int, teachers?: { id, name, subjects: string[] }[] }\" },\n      \"requirementIds\": [\"FR-28\", \"FR-30\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/conferences/:id\",\n      \"description\": \"ADMIN. Partial ConferenceEventInput. Changing slotMinutes or date while booked slots exist returns 409 SLOT_BOOKED. Calls audit({ request }).\",\n      \"requestSchema\": \"Partial<ConferenceEventInput>\",\n      \"responseSchema\": { \"data\": \"ConferenceEvent\" },\n      \"requirementIds\": [\"FR-2\", \"FR-28\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/conferences/:id/availability\",\n      \"description\": \"TEACHER, for their own availability. In one transaction it deletes the caller's unbooked, unblocked slots and inserts slots generated from the ranges (generateSlots, slotMinutes). Booked and blocked slots stay. Ranges must lie within the event date and must not overlap.\",\n      \"requestSchema\": { \"ranges\": \"{ start: 'HH:mm', end: 'HH:mm' }[], 1..10, times in the school timezone on the event date\", \"location\": \"string ≤ 200, optional\" },\n      \"responseSchema\": { \"data\": { \"slots\": \"ConferenceSlot[]\", \"created\": \"int\", \"removed\": \"int\", \"kept\": \"int\" } },\n      \"requirementIds\": [\"FR-29\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conferences/:id/slots\",\n      \"description\": \"PARENT: slots of the selected child's teachers. The child comes from ?studentId, else sh_child via getSelectedChild. TEACHER: their own slots, with ?view=day returning only booked slots ordered by startsAt for the printable day view. ADMIN: all slots, filterable by teacherId. The view returns all slots, not a paginated list.\",\n      \"requestSchema\": { \"query\": { \"studentId\": \"optional (PARENT)\", \"teacherId\": \"optional (ADMIN)\", \"view\": \"'day', optional (TEACHER/ADMIN)\" } },\n      \"responseSchema\": { \"data\": \"ConferenceSlot[]\" },\n      \"requirementIds\": [\"FR-5\", \"FR-29\", \"FR-30\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/conference-slots/:id\",\n      \"description\": \"The slot's TEACHER, or ADMIN. Blocks or unblocks a slot, or edits its location. Blocking a booked slot returns 409 SLOT_BOOKED.\",\n      \"requestSchema\": { \"blocked\": \"boolean, optional\", \"location\": \"string ≤ 200 | null, optional\" },\n      \"responseSchema\": { \"data\": \"ConferenceSlot\" },\n      \"requirementIds\": [\"FR-29\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/conference-slots/:id\",\n      \"description\": \"The slot's TEACHER, or ADMIN. Removes an unbooked slot. A booked slot returns 409 SLOT_BOOKED.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n      \"requirementIds\": [\"FR-29\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conference-slots/:id/book\",\n      \"description\": \"PARENT, for a linked child. Only allowed while now is within [bookingOpensAt, bookingClosesAt], else 400 OUTSIDE_BOOKING_WINDOW. In one transaction: an overlap check against the parent's other bookings (409 OVERLAP), then updateMany where {id, bookedByParentId: null, blocked: false} (count 0 returns 409 SLOT_TAKEN), with P2002 on (eventId, teacherId, bookedForStudentId) returning 409 ONE_PER_TEACHER. After commit it sends conference.booked to the parent and teacher, with an ics link.\",\n      \"requestSchema\": { \"studentId\": \"string\", \"parentNote\": \"string ≤ 500, optional\" },\n      \"responseSchema\": { \"data\": \"ConferenceSlot\", \"errors\": { \"409\": \"{ error: { code: 'CONFLICT', message: 'That slot was just taken' | 'You already have a meeting with <teacher> at <time>' | ..., details: { reason } } }\" } },\n      \"requirementIds\": [\"FR-2\", \"FR-30\", \"FR-31\", \"FR-32\", \"FR-33\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conference-slots/:id/cancel\",\n      \"description\": \"The booking PARENT (403 NOT_BOOKER otherwise) or ADMIN. Only allowed before bookingClosesAt, else 400 OUTSIDE_BOOKING_WINDOW. Clears the booking fields and sends conference.cancelled to the parent and teacher. To reschedule, the client cancels and then books.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": \"ConferenceSlot\" },\n      \"requirementIds\": [\"FR-32\", \"FR-33\", \"FR-44\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conference-slots/:id/ics\",\n      \"description\": \"The booking parent, the slot's teacher, or ADMIN. Returns a single VEVENT built with src/server/calendar/ical.ts.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"contentType\": \"text/calendar; charset=utf-8\", \"body\": \"VCALENDAR with one VEVENT (UID slot-<id>@schoolhub, DTSTART/DTEND UTC, SUMMARY, LOCATION)\" },\n      \"requirementIds\": [\"FR-33\", \"FR-35\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/consent-forms\",\n      \"description\": \"PARENT: forms whose audience includes a linked child, with children[] response status. ?pending=true filters to forms not yet answered for some child. TEACHER: forms they created. ADMIN: all forms. Paginated, default sort dueAt:asc, ?q matches the title.\",\n      \"requestSchema\": { \"query\": { \"pending\": \"boolean, optional\", \"studentId\": \"optional (PARENT)\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"dueAt|createdAt:asc|desc\", \"q\": \"string\" } },\n      \"responseSchema\": { \"data\": \"ConsentForm[]\", \"meta\": \"{ page, pageSize, total }\" },\n      \"requirementIds\": [\"FR-16\", \"FR-37\", \"FR-42\", \"NFR-5\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/consent-forms\",\n      \"description\": \"ADMIN can target any audience. TEACHER can only target COURSE audiences they manage, checked by canTargetAudience per row. Creates the form and notifies parents of resolved audience students with consent.requested.\",\n      \"requestSchema\": \"ConsentFormInput\",\n      \"responseSchema\": { \"status\": 201, \"data\": \"ConsentForm & { notifiedParents: int }\" },\n      \"requirementIds\": [\"FR-36\", \"FR-44\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/consent-forms/:id\",\n      \"description\": \"The audience's parents (with their own children[]), the creator, or ADMIN. Anyone else gets 404.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": \"ConsentForm\" },\n      \"requirementIds\": [\"FR-36\", \"FR-37\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/consent-forms/:id/responses\",\n      \"description\": \"PARENT, for a linked child in the audience. Only allowed while now < dueAt, else 400 PAST_DUE. The signature must match the caller's full name case-insensitively, else 400 SIGNATURE_MISMATCH. Upserts by (formId, studentId), so any linked parent overwrites the single response. Calls audit({ before, after, request }) on create and on every change.\",\n      \"requestSchema\": \"ConsentResponseInput\",\n      \"responseSchema\": { \"data\": { \"formId\": \"string\", \"studentId\": \"string\", \"value\": \"GRANTED | DECLINED\", \"respondedBy\": \"{ id, name }\", \"comment\": \"string | null\", \"updatedAt\": \"ISO\", \"changed\": \"boolean (true if it overwrote a previous response)\" } },\n      \"requirementIds\": [\"FR-37\", \"FR-38\", \"NFR-3\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/consent-forms/:id/tracking\",\n      \"description\": \"The creator or ADMIN (assertConsentOwnerOrAdmin, 403 NOT_FORM_OWNER otherwise). Returns one row per audience student. ?format=csv returns the whole filtered set as CSV via src/server/csv.ts, without pagination.\",\n      \"requestSchema\": { \"query\": { \"status\": \"GRANTED|DECLINED|NO_RESPONSE, optional\", \"format\": \"'csv', optional\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"studentName|status|respondedAt:asc|desc\", \"q\": \"string (student name)\" } },\n      \"responseSchema\": {\n        \"data\": [ { \"student\": \"{ id, firstName, lastName, sectionName }\", \"status\": \"GRANTED | DECLINED | NO_RESPONSE\", \"respondedBy\": \"{ id, name } | null\", \"respondedAt\": \"ISO | null\", \"comment\": \"string | null\" } ],\n        \"meta\": \"{ page, pageSize, total, counts: { granted, declined, noResponse } }\",\n        \"csv\": \"columns: Student, Section, Status, Responded by, Responded at, Comment\"\n      },\n      \"requirementIds\": [\"FR-39\", \"NFR-5\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/consent-forms/:id/remind\",\n      \"description\": \"The creator or ADMIN. Claims the throttle with updateMany where {id, lastRemindedAt null or < now − 24h}. A count of 0 returns 429 RATE_LIMITED with details.retryAfterMs. Otherwise sends consent.reminder to parents of non-responding students. A form past dueAt returns 400 PAST_DUE.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"notifiedParents\": \"int\", \"remindedAt\": \"ISO\" } },\n      \"requirementIds\": [\"FR-39\", \"FR-44\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/timetable\",\n      \"description\": \"EXISTING, extended. When a PARENT omits studentId, it defaults to getSelectedChild (sh_child, then the first child) instead of erroring or asking. An explicit ?studentId= still overrides it. /assignments and /grades pages use the same default server-side. The response shape is unchanged.\",\n      \"requestSchema\": { \"query\": { \"studentId\": \"optional override\" } },\n      \"responseSchema\": { \"data\": \"unchanged existing timetable shape\" },\n      \"requirementIds\": [\"FR-5\", \"FR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"EXISTING, extended (getRegister). For each student covered by an APPROVED note, it pre-fills status EXCUSED when no record exists and adds absence-note fields. The teacher can still change the status.\",\n      \"requestSchema\": { \"query\": \"unchanged\" },\n      \"responseSchema\": { \"data\": \"existing register shape; each student row gains { absenceNoteId: string | null, excusable: boolean, prefilled: boolean }\" },\n      \"requirementIds\": [\"FR-24\", \"FR-25\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"EXISTING, extended (saveRegister). EXCUSED is accepted if the caller is ADMIN or an APPROVED note covers the student/date/period. Otherwise it returns 403 with details.reason='NO_APPROVED_NOTE'. attendance.absent notifications skip students covered by a PENDING or APPROVED note.\",\n      \"requestSchema\": \"unchanged\",\n      \"responseSchema\": { \"data\": \"unchanged\" },\n      \"requirementIds\": [\"FR-25\", \"FR-27\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING cron route, extended. Adds an isolated try-block that calls sendConsentDueReminders(now). For each form with dueAt in (now, now+48h] and a null dueReminderSentAt, it claims the form and sends consent.reminder to non-responders. A failure is logged and does not abort the other jobs.\",\n      \"requestSchema\": \"unchanged (internal auth)\",\n      \"responseSchema\": { \"data\": \"existing summary & { consentReminders: { forms: int, notified: int } }\" },\n      \"requirementIds\": [\"FR-40\", \"FR-44\", \"NFR-8\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    {\n      \"name\": \"NOTIFICATION_TYPES additions (src/server/notifications/types.ts)\",\n      \"shape\": \"absence_note.submitted (email false), absence_note.reviewed (email true), conference.slots_requested, conference.booked, conference.cancelled, consent.requested (email true), consent.reminder (email true)\",\n      \"requirementIds\": [\"FR-19\", \"FR-26\", \"FR-28\", \"FR-33\", \"FR-36\", \"FR-40\", \"FR-44\"]\n    },\n    {\n      \"name\": \"getSelectedChild(user, searchParams?) → { studentId, firstName } | null\",\n      \"shape\": \"React cache(). Checks a linked ?studentId first, then a linked sh_child cookie, then the first linked child. Never throws on a bad cookie.\",\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"NFR-5\"]\n    },\n    {\n      \"name\": \"Pure helpers\",\n      \"shape\": \"coversRecord(note, { date, periodId }) → boolean; generateSlots(ranges, slotMinutes) → { startsAt, endsAt }[]; overlaps(a, b) → boolean; signatureMatches(typed, fullName) → boolean\",\n      \"requirementIds\": [\"FR-23\", \"FR-29\", \"FR-31\", \"FR-37\", \"FR-46\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016DMcehc1fAyx4aMmN1uHCk","type":"tool_result","content":"The file /Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"6637fabe-b275-41d2-a9c7-8a4e5da1a9d1","uuid":"aea91412-4d09-4b81-b4c3-0d48fac5ea45","timestamp":"2026-11-10T03:20:30.757Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/architect/api-contracts.json","content":"{\n  \"ticketId\": \"SH-15\",\n  \"timestamp\": \"2026-11-10T13:30:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the stale SH-14 contracts.\",\n    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (FR-43, NFR-6)\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with schemas from src/lib/validators/{absence-notes,conferences,consent-forms}.ts → access helper (assertCanViewStudent, assertHomeroomOrAdmin, assertConsentOwnerOrAdmin) → one service call → ok(data) / ok(data, {status:201}) / paginated(rows, meta). Everything comes from src/server/http.ts. Do not hand-roll envelopes. (FR-43, NFR-5, NFR-7)\",\n    \"envelopes\": {\n      \"success\": \"{ data: T }\",\n      \"list\": \"{ data: T[], meta: { page, pageSize, total } } via paginated(). The query takes ?page (default 1), ?pageSize (default 20, clamped to 100 by parsePagination), ?sort=<field>:<asc|desc> and ?q. (NFR-10)\",\n      \"error\": \"{ error: { code, message, details? } }\",\n      \"nonJson\": \"GET /api/conference-slots/:id/ics returns text/calendar. GET /api/consent-forms/:id/tracking?format=csv returns text/csv with Content-Disposition: attachment.\"\n    },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409,\n      \"RATE_LIMITED\": 429,\n      \"INTERNAL\": 500\n    },\n    \"errorPolicy\": [\n      \"A studentId the caller cannot view, or a note/form/slot belonging to one, returns 404 NOT_FOUND so existence does not leak. (NFR-5)\",\n      \"A visible resource the caller may not act on returns 403 FORBIDDEN with details.reason. The reasons are NOT_HOMEROOM, NOT_FORM_OWNER, NOT_SLOT_TEACHER, NOT_BOOKER and AUDIENCE_NOT_ALLOWED. (NFR-5, FR-21, FR-36, FR-39)\",\n      \"Business-rule failures that the caller can fix by changing input return 400 VALIDATION_ERROR with details.reason. The reasons are OUTSIDE_BOOKING_WINDOW, PAST_DUE, SIGNATURE_MISMATCH and DATE_WINDOW. http.ts has no 422 code, so system-design's '422' maps to 400. (FR-18, FR-32, FR-37)\",\n      \"State races return 409 CONFLICT with details.reason. The reasons are SLOT_TAKEN ('That slot was just taken'), OVERLAP ('You already have a meeting with <teacher> at <time>'), ONE_PER_TEACHER, ALREADY_REVIEWED and SLOT_BOOKED. (NFR-1, FR-22, FR-29, FR-31)\",\n      \"The remind throttle returns 429 RATE_LIMITED with details.retryAfterMs and a Retry-After header. (FR-39)\"\n    ],\n    \"dates\": \"Date-only fields are 'yyyy-MM-dd' strings (@db.Date). Instants are ISO 8601 UTC. Every 'today' / window / due rule is evaluated in SchoolSettings.timezone via schoolToday(). (NFR-8)\",\n    \"audit\": \"Absence review, consent respond/change and conference event create/update call audit({ request }) so getClientIp() captures the IP. (NFR-3, FR-23, FR-38)\"\n  },\n\n  \"components\": {\n    \"AbsenceNoteInput\": {\n      \"studentId\": \"string (cuid)\",\n      \"fromDate\": \"yyyy-MM-dd, ≥ schoolToday − 14 days\",\n      \"toDate\": \"yyyy-MM-dd, ≥ fromDate, ≤ schoolToday + 60 days, span ≤ 30 days\",\n      \"partialDay\": \"boolean\",\n      \"periodIds\": \"string[]. Required and non-empty when partialDay is true. Must be empty or absent when it is false.\",\n      \"reason\": \"AbsenceReason\",\n      \"details\": \"string, ≤ 1000 chars, optional\",\n      \"fileId\": \"string, optional. Must be a File uploaded with context 'absence-note'.\"\n    },\n    \"AbsenceNote\": {\n      \"id\": \"string\",\n      \"student\": \"{ id, firstName, lastName, sectionName }\",\n      \"submittedBy\": \"{ id, name }\",\n      \"fromDate\": \"yyyy-MM-dd\",\n      \"toDate\": \"yyyy-MM-dd\",\n      \"partialDay\": \"boolean\",\n      \"periods\": \"{ id, name }[]\",\n      \"reason\": \"AbsenceReason\",\n      \"details\": \"string | null\",\n      \"file\": \"{ id, name, url } | null\",\n      \"status\": \"PENDING | APPROVED | REJECTED\",\n      \"reviewedBy\": \"{ id, name } | null\",\n      \"reviewNote\": \"string | null\",\n      \"reviewedAt\": \"ISO | null\",\n      \"createdAt\": \"ISO\"\n    },\n    \"ConferenceEventInput\": {\n      \"title\": \"string, 1..200\",\n      \"date\": \"yyyy-MM-dd\",\n      \"bookingOpensAt\": \"ISO\",\n      \"bookingClosesAt\": \"ISO, > bookingOpensAt, ≤ the end of `date` in the school timezone\",\n      \"slotMinutes\": \"int 5..60\",\n      \"gradeLevelIds\": \"string[], at least 1\"\n    },\n    \"ConferenceEvent\": {\n      \"id\": \"string\",\n      \"title\": \"string\",\n      \"date\": \"yyyy-MM-dd\",\n      \"bookingOpensAt\": \"ISO\",\n      \"bookingClosesAt\": \"ISO\",\n      \"slotMinutes\": \"int\",\n      \"gradeLevels\": \"{ id, name }[]\",\n      \"bookingOpen\": \"boolean (computed)\",\n      \"createdBy\": \"{ id, name }\"\n    },\n    \"ConferenceSlot\": {\n      \"id\": \"string\",\n      \"eventId\": \"string\",\n      \"teacher\": \"{ id, name, subjects: string[] }\",\n      \"startsAt\": \"ISO\",\n      \"endsAt\": \"ISO\",\n      \"location\": \"string | null\",\n      \"blocked\": \"boolean\",\n      \"available\": \"boolean (not booked and not blocked)\",\n      \"booking\": \"{ parent: { id, name }, student: { id, firstName, lastName }, parentNote: string | null } | null. Only the booking parent, the slot's teacher and ADMIN see this field. Everyone else gets null and sees only `available`. (NFR-5)\",\n      \"mine\": \"boolean (booked by the caller)\"\n    },\n    \"ConsentFormInput\": {\n      \"title\": \"string, 1..200\",\n      \"description\": \"string (Markdown), 1..10000\",\n      \"dueAt\": \"ISO, in the future\",\n      \"eventId\": \"string | null (CalendarEvent)\",\n      \"audiences\": \"{ type: 'GRADE_LEVEL' | 'SECTION' | 'COURSE', refId: string }[], 1..20. TEACHER callers may only use COURSE refIds they manage. Anything else returns 403 AUDIENCE_NOT_ALLOWED.\"\n    },\n    \"ConsentForm\": {\n      \"id\": \"string\",\n      \"title\": \"string\",\n      \"description\": \"string (Markdown)\",\n      \"dueAt\": \"ISO\",\n      \"event\": \"{ id, title, startsAt } | null\",\n      \"audiences\": \"{ type, refId, label }[]\",\n      \"createdBy\": \"{ id, name }\",\n      \"lastRemindedAt\": \"ISO | null (creator/admin only)\",\n      \"counts\": \"{ granted, declined, noResponse } (creator/admin only)\",\n      \"children\": \"PARENT only: { studentId, firstName, response: { value, respondedBy: { id, name }, comment, updatedAt } | null }[], listing every linked child in the audience\"\n    },\n    \"ConsentResponseInput\": {\n      \"studentId\": \"string\",\n      \"value\": \"GRANTED | DECLINED\",\n      \"signature\": \"string, 1..200. Must match the caller's full name after trim().toLowerCase().\",\n      \"comment\": \"string, ≤ 1000, optional\"\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/me/selected-child\",\n      \"description\": \"PARENT. Sets the sh_child cookie (httpOnly, sameSite=lax, 1 year) after checking ParentStudentLink. An unlinked studentId returns 404. The client then calls router.refresh().\",\n      \"requestSchema\": { \"studentId\": \"string\" },\n      \"responseSchema\": { \"data\": { \"studentId\": \"string\" } },\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-6\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/children/summary\",\n      \"description\": \"PARENT. Returns one summary card per linked child for /my-children. Data comes from overview-service.getChildrenSummary.\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"data\": [\n          {\n            \"student\": \"{ id, firstName, lastName, avatarUrl, sectionName }\",\n            \"attendanceRateTerm\": \"number 0..1 | null\",\n            \"missingAssignments\": \"int\",\n            \"averageGradePct\": \"number | null\"\n          }\n        ]\n      },\n      \"requirementIds\": [\"FR-7\", \"FR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/students/:id/overview\",\n      \"description\": \"PARENT (linked child) or staff, checked by assertCanViewStudent. Returns all eight overview cards from the same overview-service functions the streaming page uses. ?cards=today,attendance,... limits which cards load.\",\n      \"requestSchema\": { \"query\": { \"cards\": \"comma list of today|attendance|assignments|grades|announcements|events|teachers|actions, optional\" } },\n      \"responseSchema\": {\n        \"data\": {\n          \"today\": \"{ isSchoolDay: boolean, noSchoolReason: string | null, periods: { periodName, startsAt, endsAt, courseName, room, teacherName }[] }\",\n          \"attendance\": \"{ rateTerm: number | null, absences: int, lates: int, last5: { date, periodName | null, status }[] }\",\n          \"assignments\": \"{ missing: { id, title, courseName, dueAt }[], dueNext7Days: { id, title, courseName, dueAt }[] }\",\n          \"grades\": \"{ recent: { gradeItemId, title, courseName, score, maxScore, returnedAt }[], courses: { courseId, courseName, currentPct: number | null }[] }\",\n          \"announcements\": \"[] for now, because PRD-12 is absent (FR-13 partial)\",\n          \"events\": \"{ id, title, startsAt, endsAt, allDay, source: 'calendar' | 'myMeetings' }[], at most 5\",\n          \"teachers\": \"{ userId, name, subjects: string[], messageHref }[]\",\n          \"actions\": \"{ type: 'consent' | 'conference', id, title, dueAt | bookingClosesAt, href }[]\"\n        }\n      },\n      \"requirementIds\": [\"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-17\", \"FR-35\", \"NFR-2\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/absence-notes\",\n      \"description\": \"Paginated and scoped by role. PARENT sees notes for linked children. A homeroom TEACHER sees their own section's students. ADMIN sees all. A non-homeroom TEACHER gets 403 NOT_HOMEROOM. Default sort is createdAt:desc. ?q matches the student name.\",\n      \"requestSchema\": { \"query\": { \"status\": \"PENDING|APPROVED|REJECTED, optional\", \"studentId\": \"optional\", \"from\": \"yyyy-MM-dd, optional\", \"to\": \"yyyy-MM-dd, optional\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"createdAt|fromDate:asc|desc\", \"q\": \"string\" } },\n      \"responseSchema\": { \"data\": \"AbsenceNote[]\", \"meta\": \"{ page, pageSize, total }\" },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-5\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/absence-notes\",\n      \"description\": \"PARENT, for a linked child only. Creates a PENDING note and notifies the homeroom teacher and ADMINs with absence_note.submitted. Upload the file first via POST /api/files with context=absence-note.\",\n      \"requestSchema\": \"AbsenceNoteInput\",\n      \"responseSchema\": { \"status\": 201, \"data\": \"AbsenceNote\" },\n      \"requirementIds\": [\"FR-2\", \"FR-18\", \"FR-19\", \"FR-41\", \"FR-44\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/absence-notes/:id\",\n      \"description\": \"Detail view for the parent, homeroom teacher or ADMIN. Reviewers also get the attendance records that already exist for the note's dates and periods.\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"data\": \"AbsenceNote & { attendanceRecords?: { id, date, periodId | null, periodName | null, status, note | null }[] } (reviewers only)\"\n      },\n      \"requirementIds\": [\"FR-20\", \"FR-21\", \"FR-41\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/absence-notes/:id/review\",\n      \"description\": \"Homeroom TEACHER or ADMIN. Runs a conditional update on a PENDING note. If the note is no longer PENDING, returns 409 ALREADY_REVIEWED. On APPROVED, covered ABSENT records and missing records become EXCUSED with the note 'Absence note #<id>', all in the same transaction. Then it calls audit({ request }) and notifies linked parents with absence_note.reviewed, including reviewNote.\",\n      \"requestSchema\": { \"decision\": \"APPROVED | REJECTED\", \"reviewNote\": \"string ≤ 1000. Required (min 1) when the decision is REJECTED.\" },\n      \"responseSchema\": { \"data\": { \"note\": \"AbsenceNote\", \"recordsExcused\": \"int\", \"recordsCreated\": \"int\" } },\n      \"requirementIds\": [\"FR-22\", \"FR-23\", \"FR-26\", \"FR-44\", \"NFR-3\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/files\",\n      \"description\": \"EXISTING, extended. Adds the context 'absence-note': PDF, JPG or PNG only, sniffed with file-type. Read access goes to linked parents, the homeroom teacher and ADMIN, through the resolver in src/server/files/contexts.ts. The multipart contract is unchanged.\",\n      \"requestSchema\": { \"multipart\": { \"context\": \"'absence-note' (sent before file)\", \"file\": \"binary, application/pdf | image/jpeg | image/png\" } },\n      \"responseSchema\": { \"status\": 201, \"data\": { \"id\": \"string\", \"name\": \"string\", \"size\": \"int\", \"mimeType\": \"string\" } },\n      \"requirementIds\": [\"FR-18\", \"FR-41\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conferences\",\n      \"description\": \"Lists events by role. ADMIN sees all. TEACHER sees events whose eligible grade levels include students they teach. PARENT sees events eligible for any linked child. Paginated, default sort date:desc, ?q matches the title.\",\n      \"requestSchema\": { \"query\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"date|title:asc|desc\", \"q\": \"string\", \"upcoming\": \"boolean, optional\" } },\n      \"responseSchema\": { \"data\": \"ConferenceEvent[]\", \"meta\": \"{ page, pageSize, total }\" },\n      \"requirementIds\": [\"FR-28\", \"FR-42\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conferences\",\n      \"description\": \"ADMIN. Creates an event, notifies teachers of eligible students with conference.slots_requested, and calls audit({ request }).\",\n      \"requestSchema\": \"ConferenceEventInput\",\n      \"responseSchema\": { \"status\": 201, \"data\": \"ConferenceEvent\" },\n      \"requirementIds\": [\"FR-2\", \"FR-28\", \"FR-44\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conferences/:id\",\n      \"description\": \"Event detail, visible to the same audience as the list. TEACHER callers also get mySlotCount. PARENT callers get the child's teachers that have slots.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": \"ConferenceEvent & { mySlotCount?: int, teachers?: { id, name, subjects: string[] }[] }\" },\n      \"requirementIds\": [\"FR-28\", \"FR-30\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/conferences/:id\",\n      \"description\": \"ADMIN. Partial ConferenceEventInput. Changing slotMinutes or date while booked slots exist returns 409 SLOT_BOOKED. Calls audit({ request }).\",\n      \"requestSchema\": \"Partial<ConferenceEventInput>\",\n      \"responseSchema\": { \"data\": \"ConferenceEvent\" },\n      \"requirementIds\": [\"FR-2\", \"FR-28\", \"NFR-3\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/conferences/:id/availability\",\n      \"description\": \"TEACHER, for their own availability. In one transaction it deletes the caller's unbooked, unblocked slots and inserts slots generated from the ranges (generateSlots, slotMinutes). Booked and blocked slots stay. Ranges must lie within the event date and must not overlap.\",\n      \"requestSchema\": { \"ranges\": \"{ start: 'HH:mm', end: 'HH:mm' }[], 1..10, times in the school timezone on the event date\", \"location\": \"string ≤ 200, optional\" },\n      \"responseSchema\": { \"data\": { \"slots\": \"ConferenceSlot[]\", \"created\": \"int\", \"removed\": \"int\", \"kept\": \"int\" } },\n      \"requirementIds\": [\"FR-29\", \"NFR-8\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conferences/:id/slots\",\n      \"description\": \"PARENT: slots of the selected child's teachers. The child comes from ?studentId, else sh_child via getSelectedChild. TEACHER: their own slots, with ?view=day returning only booked slots ordered by startsAt for the printable day view. ADMIN: all slots, filterable by teacherId. The view returns all slots, not a paginated list.\",\n      \"requestSchema\": { \"query\": { \"studentId\": \"optional (PARENT)\", \"teacherId\": \"optional (ADMIN)\", \"view\": \"'day', optional (TEACHER/ADMIN)\" } },\n      \"responseSchema\": { \"data\": \"ConferenceSlot[]\" },\n      \"requirementIds\": [\"FR-5\", \"FR-29\", \"FR-30\", \"FR-34\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/conference-slots/:id\",\n      \"description\": \"The slot's TEACHER, or ADMIN. Blocks or unblocks a slot, or edits its location. Blocking a booked slot returns 409 SLOT_BOOKED.\",\n      \"requestSchema\": { \"blocked\": \"boolean, optional\", \"location\": \"string ≤ 200 | null, optional\" },\n      \"responseSchema\": { \"data\": \"ConferenceSlot\" },\n      \"requirementIds\": [\"FR-29\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/conference-slots/:id\",\n      \"description\": \"The slot's TEACHER, or ADMIN. Removes an unbooked slot. A booked slot returns 409 SLOT_BOOKED.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"id\": \"string\" } },\n      \"requirementIds\": [\"FR-29\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conference-slots/:id/book\",\n      \"description\": \"PARENT, for a linked child. Only allowed while now is within [bookingOpensAt, bookingClosesAt], else 400 OUTSIDE_BOOKING_WINDOW. In one transaction: an overlap check against the parent's other bookings (409 OVERLAP), then updateMany where {id, bookedByParentId: null, blocked: false} (count 0 returns 409 SLOT_TAKEN), with P2002 on (eventId, teacherId, bookedForStudentId) returning 409 ONE_PER_TEACHER. After commit it sends conference.booked to the parent and teacher, with an ics link.\",\n      \"requestSchema\": { \"studentId\": \"string\", \"parentNote\": \"string ≤ 500, optional\" },\n      \"responseSchema\": { \"data\": \"ConferenceSlot\", \"errors\": { \"409\": \"{ error: { code: 'CONFLICT', message: 'That slot was just taken' | 'You already have a meeting with <teacher> at <time>' | ..., details: { reason } } }\" } },\n      \"requirementIds\": [\"FR-2\", \"FR-30\", \"FR-31\", \"FR-32\", \"FR-33\", \"NFR-1\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/conference-slots/:id/cancel\",\n      \"description\": \"The booking PARENT (403 NOT_BOOKER otherwise) or ADMIN. Only allowed before bookingClosesAt, else 400 OUTSIDE_BOOKING_WINDOW. Clears the booking fields and sends conference.cancelled to the parent and teacher. To reschedule, the client cancels and then books.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": \"ConferenceSlot\" },\n      \"requirementIds\": [\"FR-32\", \"FR-33\", \"FR-44\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/conference-slots/:id/ics\",\n      \"description\": \"The booking parent, the slot's teacher, or ADMIN. Returns a single VEVENT built with src/server/calendar/ical.ts.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"contentType\": \"text/calendar; charset=utf-8\", \"body\": \"VCALENDAR with one VEVENT (UID slot-<id>@schoolhub, DTSTART/DTEND UTC, SUMMARY, LOCATION)\" },\n      \"requirementIds\": [\"FR-33\", \"FR-35\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/consent-forms\",\n      \"description\": \"PARENT: forms whose audience includes a linked child, with children[] response status. ?pending=true filters to forms not yet answered for some child. TEACHER: forms they created. ADMIN: all forms. Paginated, default sort dueAt:asc, ?q matches the title.\",\n      \"requestSchema\": { \"query\": { \"pending\": \"boolean, optional\", \"studentId\": \"optional (PARENT)\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"dueAt|createdAt:asc|desc\", \"q\": \"string\" } },\n      \"responseSchema\": { \"data\": \"ConsentForm[]\", \"meta\": \"{ page, pageSize, total }\" },\n      \"requirementIds\": [\"FR-16\", \"FR-37\", \"FR-42\", \"NFR-5\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/consent-forms\",\n      \"description\": \"ADMIN can target any audience. TEACHER can only target COURSE audiences they manage, checked by canTargetAudience per row. Creates the form and notifies parents of resolved audience students with consent.requested.\",\n      \"requestSchema\": \"ConsentFormInput\",\n      \"responseSchema\": { \"status\": 201, \"data\": \"ConsentForm & { notifiedParents: int }\" },\n      \"requirementIds\": [\"FR-36\", \"FR-44\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/consent-forms/:id\",\n      \"description\": \"The audience's parents (with their own children[]), the creator, or ADMIN. Anyone else gets 404.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": \"ConsentForm\" },\n      \"requirementIds\": [\"FR-36\", \"FR-37\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/consent-forms/:id/responses\",\n      \"description\": \"PARENT, for a linked child in the audience. Only allowed while now < dueAt, else 400 PAST_DUE. The signature must match the caller's full name case-insensitively, else 400 SIGNATURE_MISMATCH. Upserts by (formId, studentId), so any linked parent overwrites the single response. Calls audit({ before, after, request }) on create and on every change.\",\n      \"requestSchema\": \"ConsentResponseInput\",\n      \"responseSchema\": { \"data\": { \"formId\": \"string\", \"studentId\": \"string\", \"value\": \"GRANTED | DECLINED\", \"respondedBy\": \"{ id, name }\", \"comment\": \"string | null\", \"updatedAt\": \"ISO\", \"changed\": \"boolean (true if it overwrote a previous response)\" } },\n      \"requirementIds\": [\"FR-37\", \"FR-38\", \"NFR-3\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/consent-forms/:id/tracking\",\n      \"description\": \"The creator or ADMIN (assertConsentOwnerOrAdmin, 403 NOT_FORM_OWNER otherwise). Returns one row per audience student. ?format=csv returns the whole filtered set as CSV via src/server/csv.ts, without pagination.\",\n      \"requestSchema\": { \"query\": { \"status\": \"GRANTED|DECLINED|NO_RESPONSE, optional\", \"format\": \"'csv', optional\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"studentName|status|respondedAt:asc|desc\", \"q\": \"string (student name)\" } },\n      \"responseSchema\": {\n        \"data\": [ { \"student\": \"{ id, firstName, lastName, sectionName }\", \"status\": \"GRANTED | DECLINED | NO_RESPONSE\", \"respondedBy\": \"{ id, name } | null\", \"respondedAt\": \"ISO | null\", \"comment\": \"string | null\" } ],\n        \"meta\": \"{ page, pageSize, total, counts: { granted, declined, noResponse } }\",\n        \"csv\": \"columns: Student, Section, Status, Responded by, Responded at, Comment\"\n      },\n      \"requirementIds\": [\"FR-39\", \"NFR-5\", \"NFR-10\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/consent-forms/:id/remind\",\n      \"description\": \"The creator or ADMIN. Claims the throttle with updateMany where {id, lastRemindedAt null or < now − 24h}. A count of 0 returns 429 RATE_LIMITED with details.retryAfterMs. Otherwise sends consent.reminder to parents of non-responding students. A form past dueAt returns 400 PAST_DUE.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"data\": { \"notifiedParents\": \"int\", \"remindedAt\": \"ISO\" } },\n      \"requirementIds\": [\"FR-39\", \"FR-44\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/timetable\",\n      \"description\": \"EXISTING, extended. When a PARENT omits studentId, it defaults to getSelectedChild (sh_child, then the first child) instead of erroring or asking. An explicit ?studentId= still overrides it. /assignments and /grades pages use the same default server-side. The response shape is unchanged.\",\n      \"requestSchema\": { \"query\": { \"studentId\": \"optional override\" } },\n      \"responseSchema\": { \"data\": \"unchanged existing timetable shape\" },\n      \"requirementIds\": [\"FR-5\", \"FR-4\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"EXISTING, extended (getRegister). For each student covered by an APPROVED note, it pre-fills status EXCUSED when no record exists and adds absence-note fields. The teacher can still change the status.\",\n      \"requestSchema\": { \"query\": \"unchanged\" },\n      \"responseSchema\": { \"data\": \"existing register shape; each student row gains { absenceNoteId: string | null, excusable: boolean, prefilled: boolean }\" },\n      \"requirementIds\": [\"FR-24\", \"FR-25\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"EXISTING, extended (saveRegister). EXCUSED is accepted if the caller is ADMIN or an APPROVED note covers the student/date/period. Otherwise it returns 403 with details.reason='NO_APPROVED_NOTE'. attendance.absent notifications skip students covered by a PENDING or APPROVED note.\",\n      \"requestSchema\": \"unchanged\",\n      \"responseSchema\": { \"data\": \"unchanged\" },\n      \"requirementIds\": [\"FR-25\", \"FR-27\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING cron route, extended. Adds an isolated try-block that calls sendConsentDueReminders(now). For each form with dueAt in (now, now+48h] and a null dueReminderSentAt, it claims the form and sends consent.reminder to non-responders. A failure is logged and does not abort the other jobs.\",\n      \"requestSchema\": \"unchanged (internal auth)\",\n      \"responseSchema\": { \"data\": \"existing summary & { consentReminders: { forms: int, notified: int } }\" },\n      \"requirementIds\": [\"FR-40\", \"FR-44\", \"NFR-8\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    {\n      \"name\": \"NOTIFICATION_TYPES additions (src/server/notifications/types.ts)\",\n      \"shape\": \"absence_note.submitted (email false), absence_note.reviewed (email true), conference.slots_requested, conference.booked, conference.cancelled, consent.requested (email true), consent.reminder (email true)\",\n      \"requirementIds\": [\"FR-19\", \"FR-26\", \"FR-28\", \"FR-33\", \"FR-36\", \"FR-40\", \"FR-44\"]\n    },\n    {\n      \"name\": \"getSelectedChild(user, searchParams?) → { studentId, firstName } | null\",\n      \"shape\": \"React cache(). Checks a linked ?studentId first, then a linked sh_child cookie, then the first linked child. Never throws on a bad cookie.\",\n      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"NFR-5\"]\n    },\n    {\n      \"name\": \"Pure helpers\",\n      \"shape\": \"coversRecord(note, { date, periodId }) → boolean; generateSlots(ranges, slotMinutes) → { startsAt, endsAt }[]; overlaps(a, b) → boolean; signatureMatches(typed, fullName) → boolean\",\n      \"requirementIds\": [\"FR-23\", \"FR-29\", \"FR-31\", \"FR-37\", \"FR-46\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":17,"newStart":1,"newLines":18,"lines":[" {","-  \"ticketId\": \"SH-14\",","-  \"timestamp\": \"2026-11-10T00:10:00Z\",","+  \"ticketId\": \"SH-15\",","+  \"timestamp\": \"2026-11-10T13:30:00Z\",","   \"phase\": \"architect\",","   \"version\": \"1.0\","," ","   \"conventions\": {","-    \"replaces\": \"This file replaces the stale SH-13 contracts.\",","-    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (NFR-8)\",","-    \"handlerPipeline\": \"withHandler → requireUser / requireRole (except the feed and public events) → parseQuery / parseBody with schemas from src/lib/validators/calendar.ts → one service call in src/server/calendar/* → ok(data) / ok(data, {status:201}). Reuse src/server/http.ts; do not hand-roll envelopes. (NFR-8, NFR-9)\",","+    \"replaces\": \"This file replaces the stale SH-14 contracts.\",","+    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (FR-43, NFR-6)\",","+    \"handlerPipeline\": \"withHandler → requireUser / requireRole → parseQuery / parseBody with schemas from src/lib/validators/{absence-notes,conferences,consent-forms}.ts → access helper (assertCanViewStudent, assertHomeroomOrAdmin, assertConsentOwnerOrAdmin) → one service call → ok(data) / ok(data, {status:201}) / paginated(rows, meta). Everything comes from src/server/http.ts. Do not hand-roll envelopes. (FR-43, NFR-5, NFR-7)\",","     \"envelopes\": {","       \"success\": \"{ data: T }\",","+      \"list\": \"{ data: T[], meta: { page, pageSize, total } } via paginated(). The query takes ?page (default 1), ?pageSize (default 20, clamped to 100 by parsePagination), ?sort=<field>:<asc|desc> and ?q. (NFR-10)\",","       \"error\": \"{ error: { code, message, details? } }\",","-      \"nonJson\": \"GET /api/events/:id/ics, GET /api/calendar/feed/:token and GET /api/events/:id/rsvps?format=csv return raw bodies (text/calendar or text/csv), not the JSON envelope.\"","+      \"nonJson\": \"GET /api/conference-slots/:id/ics returns text/calendar. GET /api/consent-forms/:id/tracking?format=csv returns text/csv with Content-Disposition: attachment.\"","     },","     \"errorCodes\": {","       \"VALIDATION_ERROR\": 400,"]},{"oldStart":19,"oldLines":361,"newStart":20,"newLines":382,"lines":["       \"FORBIDDEN\": 403,","       \"NOT_FOUND\": 404,","       \"CONFLICT\": 409,","-      \"RATE_LIMITED\": 429","+      \"RATE_LIMITED\": 429,","+      \"INTERNAL\": 500","     },","     \"errorPolicy\": [","-      \"An event the caller cannot see returns 404 NOT_FOUND, so its existence does not leak. An event cuid is never treated as authorisation. (NFR-5, NFR-7)\",","-      \"A visible event the caller may not change (not the creator and not ADMIN) returns 403 FORBIDDEN with details.reason='NOT_CREATOR'. (FR-8)\",","-      \"A non-admin who sends isNoSchool=true, isPublic=true or category HOLIDAY/TERM_BREAK gets 403 FORBIDDEN with details.reason='ADMIN_ONLY_FIELD' and details.field. (FR-6)\",","-      \"A teacher who targets an audience that fails canTargetAudience gets 403 FORBIDDEN with details.reason='AUDIENCE_NOT_ALLOWED' and details.index (the index in audiences[]). Nothing is written. (FR-7)\",","-      \"An RSVP on an event with rsvpEnabled=false returns 409 CONFLICT with details.reason='RSVP_DISABLED'. An RSVP at or after rsvpDeadline returns 409 CONFLICT with details.reason='RSVP_CLOSED'. A visible event where the caller is not in the audience (for example the creator, or an admin) returns 403 FORBIDDEN with details.reason='NOT_IN_AUDIENCE'. (FR-21)\",","-      \"studentId for a student the caller cannot view returns 404 NOT_FOUND. (FR-11, NFR-7)\",","-      \"A range with to − from > 100 days, or to ≤ from, returns 400 VALIDATION_ERROR. (FR-32)\",","-      \"A register save on a no-school date without holidayOverride=true returns 400 VALIDATION_ERROR with details.reason='HOLIDAY_OVERRIDE_REQUIRED' and details.noSchoolReason. (FR-18, D-8)\",","-      \"A rate-limit hit returns 429 RATE_LIMITED with details.retryAfterMs and a Retry-After header in seconds. (FR-27, D-9)\",","-      \"An unknown or reset feed token, or a token whose user is not ACTIVE, returns 404 text/plain 'Not found'. It does not use the JSON envelope, and it does not distinguish the cases. (FR-24, NFR-5)\"","+      \"A studentId the caller cannot view, or a note/form/slot belonging to one, returns 404 NOT_FOUND so existence does not leak. (NFR-5)\",","+      \"A visible resource the caller may not act on returns 403 FORBIDDEN with details.reason. The reasons are NOT_HOMEROOM, NOT_FORM_OWNER, NOT_SLOT_TEACHER, NOT_BOOKER and AUDIENCE_NOT_ALLOWED. (NFR-5, FR-21, FR-36, FR-39)\",","+      \"Business-rule failures that the caller can fix by changing input return 400 VALIDATION_ERROR with details.reason. The reasons are OUTSIDE_BOOKING_WINDOW, PAST_DUE, SIGNATURE_MISMATCH and DATE_WINDOW. http.ts has no 422 code, so system-design's '422' maps to 400. (FR-18, FR-32, FR-37)\",","+      \"State races return 409 CONFLICT with details.reason. The reasons are SLOT_TAKEN ('That slot was just taken'), OVERLAP ('You already have a meeting with <teacher> at <time>'), ONE_PER_TEACHER, ALREADY_REVIEWED and SLOT_BOOKED. (NFR-1, FR-22, FR-29, FR-31)\",","+      \"The remind throttle returns 429 RATE_LIMITED with details.retryAfterMs and a Retry-After header. (FR-39)\"","     ],","-    \"ids\": \"All ids are cuid strings. Timestamps are ISO 8601 UTC strings. Dates (yyyy-MM-dd) are calendar dates in the school timezone. The client renders times in SchoolSettings.timezone. (NFR-3, NFR-8)\",","-    \"allDay\": \"All-day input uses startDate/endDate as yyyy-MM-dd with an INCLUSIVE end. The server stores [schoolMidnight(startDate), schoolMidnight(endDate+1)). All-day output gives start/end as UTC instants with an EXCLUSIVE end, plus allDay=true. (FR-4, NFR-3)\",","-    \"occurrenceIds\": \"An expanded occurrence has id '<eventId>:<occurrenceStartISO>' and eventId '<eventId>'. Every /api/events/:id route takes the plain eventId. Edits apply to the whole series. (FR-15)\"","+    \"dates\": \"Date-only fields are 'yyyy-MM-dd' strings (@db.Date). Instants are ISO 8601 UTC. Every 'today' / window / due rule is evaluated in SchoolSettings.timezone via schoolToday(). (NFR-8)\",","+    \"audit\": \"Absence review, consent respond/change and conference event create/update call audit({ request }) so getClientIp() captures the IP. (NFR-3, FR-23, FR-38)\"","   },"," ","   \"components\": {","-    \"EventCategory\": \"HOLIDAY|TERM_BREAK|EXAM|EVENT|MEETING|TRIP|SPORTS|DEADLINE|OTHER\",","-    \"Recurrence\": \"NONE|WEEKLY|MONTHLY\",","-    \"RsvpResponse\": \"YES|NO|MAYBE\",","-    \"AudienceType\": \"SCHOOL|STAFF|ROLE|GRADE_LEVEL|SECTION|COURSE\",","-    \"CalendarSource\": \"events|holidays|assignments|quizzes|timetable\",","-    \"UserSummary\": { \"id\": \"string\", \"name\": \"string\", \"role\": \"ADMIN|TEACHER|STUDENT|PARENT\" },","-    \"AudienceInput\": {","-      \"type\": \"AudienceType\",","-      \"refId\": \"string|null (gradeLevelId | sectionId | courseId | role name for ROLE; must be null for SCHOOL/STAFF)\",","-      \"includeStudents\": \"boolean (default true)\",","-      \"includeParents\": \"boolean (default true)\",","-      \"includeTeachers\": \"boolean (default true)\"","+    \"AbsenceNoteInput\": {","+      \"studentId\": \"string (cuid)\",","+      \"fromDate\": \"yyyy-MM-dd, ≥ schoolToday − 14 days\",","+      \"toDate\": \"yyyy-MM-dd, ≥ fromDate, ≤ schoolToday + 60 days, span ≤ 30 days\",","+      \"partialDay\": \"boolean\",","+      \"periodIds\": \"string[]. Required and non-empty when partialDay is true. Must be empty or absent when it is false.\",","+      \"reason\": \"AbsenceReason\",","+      \"details\": \"string, ≤ 1000 chars, optional\",","+      \"fileId\": \"string, optional. Must be a File uploaded with context 'absence-note'.\"","     },","-    \"AudienceDTO\": \"AudienceInput & { id: string, label: string (e.g. 'Grade 7 · parents', 'Robotics Club') }\",","-    \"EventInput\": {","-      \"title\": \"string, 1..150\",","-      \"description\": \"string|null, Markdown, ≤ 5000\",","-      \"category\": \"EventCategory\",","-      \"allDay\": \"boolean\",","-      \"startAt\": \"ISO datetime, required when allDay=false\",","-      \"endAt\": \"ISO datetime ≥ startAt, required when allDay=false\",","-      \"startDate\": \"yyyy-MM-dd, required when allDay=true\",","-      \"endDate\": \"yyyy-MM-dd ≥ startDate, inclusive, required when allDay=true\",","-      \"location\": \"string|null, ≤ 200\",","-      \"roomId\": \"string|null (stored, unused: NFR-11)\",","-      \"recurrence\": \"Recurrence (default NONE)\",","-      \"recurrenceUntil\": \"yyyy-MM-dd|null. Required for WEEKLY/MONTHLY, ≤ start + 1 year, ≥ start date. Must be null for NONE.\",","-      \"isNoSchool\": \"boolean, optional. ADMIN only. Defaults to category ∈ {HOLIDAY, TERM_BREAK} (FR-5).\",","-      \"rsvpEnabled\": \"boolean (default false)\",","-      \"rsvpDeadline\": \"ISO datetime|null. Required when rsvpEnabled, and must be ≤ the first occurrence's start.\",","-      \"isPublic\": \"boolean (default false). ADMIN only.\",","-      \"audiences\": \"AudienceInput[], 1..20\"","+    \"AbsenceNote\": {","+      \"id\": \"string\",","+      \"student\": \"{ id, firstName, lastName, sectionName }\",","+      \"submittedBy\": \"{ id, name }\",","+      \"fromDate\": \"yyyy-MM-dd\",","+      \"toDate\": \"yyyy-MM-dd\",","+      \"partialDay\": \"boolean\",","+      \"periods\": \"{ id, name }[]\",","+      \"reason\": \"AbsenceReason\",","+      \"details\": \"string | null\",","+      \"file\": \"{ id, name, url } | null\",","+      \"status\": \"PENDING | APPROVED | REJECTED\",","+      \"reviewedBy\": \"{ id, name } | null\",","+      \"reviewNote\": \"string | null\",","+      \"reviewedAt\": \"ISO | null\",","+      \"createdAt\": \"ISO\"","     },","-    \"EventDTO\": {","+    \"ConferenceEventInput\": {","+      \"title\": \"string, 1..200\",","+      \"date\": \"yyyy-MM-dd\",","+      \"bookingOpensAt\": \"ISO\",","+      \"bookingClosesAt\": \"ISO, > bookingOpensAt, ≤ the end of `date` in the school timezone\",","+      \"slotMinutes\": \"int 5..60\",","+      \"gradeLevelIds\": \"string[], at least 1\"","+    },","+    \"ConferenceEvent\": {","       \"id\": \"string\",","       \"title\": \"string\",","-      \"description\": \"string|null\",","-      \"category\": \"EventCategory\",","-      \"allDay\": \"boolean\",","-      \"startAt\": \"string (series start for recurring events)\",","-      \"endAt\": \"string (exclusive when allDay)\",","-      \"location\": \"string|null\",","-      \"recurrence\": \"Recurrence\",","-      \"recurrenceUntil\": \"yyyy-MM-dd|null\",","-      \"isNoSchool\": \"boolean\",","-      \"isPublic\": \"boolean\",","-      \"rsvpEnabled\": \"boolean\",","-      \"rsvpDeadline\": \"string|null\",","-      \"rsvpOpen\": \"boolean (rsvpEnabled && now < rsvpDeadline)\",","-      \"audiences\": \"AudienceDTO[]\",","-      \"createdBy\": \"UserSummary\",","-      \"createdAt\": \"string\",","-      \"updatedAt\": \"string\",","-      \"canEdit\": \"boolean (creator or ADMIN)\",","-      \"canRsvp\": \"boolean (rsvpOpen && caller is in the audience)\",","-      \"myRsvp\": \"RsvpDTO|null\",","-      \"rsvpTotals\": \"{ yes: number, no: number, maybe: number, guests: number } | null (null when rsvpEnabled=false)\"","+      \"date\": \"yyyy-MM-dd\",","+      \"bookingOpensAt\": \"ISO\",","+      \"bookingClosesAt\": \"ISO\",","+      \"slotMinutes\": \"int\",","+      \"gradeLevels\": \"{ id, name }[]\",","+      \"bookingOpen\": \"boolean (computed)\",","+      \"createdBy\": \"{ id, name }\"","     },","-    \"RsvpInput\": {","-      \"response\": \"RsvpResponse\",","-      \"guests\": \"integer 0..5 (default 0). The server forces 0 for non-PARENT callers.\",","-      \"note\": \"string|null, ≤ 500\"","+    \"ConferenceSlot\": {","+      \"id\": \"string\",","+      \"eventId\": \"string\",","+      \"teacher\": \"{ id, name, subjects: string[] }\",","+      \"startsAt\": \"ISO\",","+      \"endsAt\": \"ISO\",","+      \"location\": \"string | null\",","+      \"blocked\": \"boolean\",","+      \"available\": \"boolean (not booked and not blocked)\",","+      \"booking\": \"{ parent: { id, name }, student: { id, firstName, lastName }, parentNote: string | null } | null. Only the booking parent, the slot's teacher and ADMIN see this field. Everyone else gets null and sees only `available`. (NFR-5)\",","+      \"mine\": \"boolean (booked by the caller)\"","     },","-    \"RsvpDTO\": { \"response\": \"RsvpResponse\", \"guests\": \"number\", \"note\": \"string|null\", \"updatedAt\": \"string\" },","-    \"RsvpListItem\": \"RsvpDTO & { user: UserSummary }\",","-    \"CalendarItem\": {","-      \"kind\": \"event|assignment|quiz|timetable\",","-      \"id\": \"string (occurrence id for events, '<kind>:<entityId>[:<studentId>]' for others, so the id stays unique per child)\",","-      \"eventId\": \"string|null (events only)\",","-      \"source\": \"CalendarSource\",","-      \"title\": \"string (deadlines for a parent get the prefix '<childName>: ')\",","-      \"start\": \"string\",","-      \"end\": \"string (exclusive when allDay; equals start for deadlines)\",","-      \"allDay\": \"boolean\",","-      \"category\": \"EventCategory|null (events only)\",","-      \"color\": \"string (category colour for events, course/subject colour for deadlines and timetable)\",","-      \"location\": \"string|null\",","-      \"href\": \"string|null (assignment/quiz page for deadlines, '/calendar?event=<eventId>' for events; FR-13)\",","-      \"childName\": \"string|null (PARENT deadlines only)\",","-      \"isNoSchool\": \"boolean\"","+    \"ConsentFormInput\": {","+      \"title\": \"string, 1..200\",","+      \"description\": \"string (Markdown), 1..10000\",","+      \"dueAt\": \"ISO, in the future\",","+      \"eventId\": \"string | null (CalendarEvent)\",","+      \"audiences\": \"{ type: 'GRADE_LEVEL' | 'SECTION' | 'COURSE', refId: string }[], 1..20. TEACHER callers may only use COURSE refIds they manage. Anything else returns 403 AUDIENCE_NOT_ALLOWED.\"","     },","-    \"SchoolDayResult\": { \"date\": \"yyyy-MM-dd\", \"isSchoolDay\": \"boolean\", \"reason\": \"string|null ('Not a teaching day' | 'Holiday: <title>')\" },","-    \"PublicEventDTO\": {","-      \"id\": \"string (occurrence id)\",","-      \"eventId\": \"string\",","+    \"ConsentForm\": {","+      \"id\": \"string\",","       \"title\": \"string\",","-      \"category\": \"EventCategory\",","-      \"start\": \"string\",","-      \"end\": \"string\",","-      \"allDay\": \"boolean\",","-      \"location\": \"string|null\",","-      \"description\": \"string|null\"","+      \"description\": \"string (Markdown)\",","+      \"dueAt\": \"ISO\",","+      \"event\": \"{ id, title, startsAt } | null\",","+      \"audiences\": \"{ type, refId, label }[]\",","+      \"createdBy\": \"{ id, name }\",","+      \"lastRemindedAt\": \"ISO | null (creator/admin only)\",","+      \"counts\": \"{ granted, declined, noResponse } (creator/admin only)\",","+      \"children\": \"PARENT only: { studentId, firstName, response: { value, respondedBy: { id, name }, comment, updatedAt } | null }[], listing every linked child in the audience\"","     },","-    \"FeedStatus\": {","-      \"url\": \"string|null ('<APP_URL>/api/calendar/feed/<rawToken>.ics'; non-null only when the token was just created or reset; D-6)\",","-      \"hasToken\": \"boolean\",","-      \"createdAt\": \"string|null\"","+    \"ConsentResponseInput\": {","+      \"studentId\": \"string\",","+      \"value\": \"GRANTED | DECLINED\",","+      \"signature\": \"string, 1..200. Must match the caller's full name after trim().toLowerCase().\",","+      \"comment\": \"string, ≤ 1000, optional\"","     }","   },"," ","   \"endpoints\": [","     {","+      \"method\": \"POST\",","+      \"path\": \"/api/me/selected-child\",","+      \"description\": \"PARENT. Sets the sh_child cookie (httpOnly, sameSite=lax, 1 year) after checking ParentStudentLink. An unlinked studentId returns 404. The client then calls router.refresh().\",","+      \"requestSchema\": { \"studentId\": \"string\" },","+      \"responseSchema\": { \"data\": { \"studentId\": \"string\" } },","+      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-6\", \"NFR-5\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/calendar\",","-      \"description\": \"Merged, expanded, audience-filtered calendar items for the caller, for any role. ADMIN sees every event. Others see events whose audience includes them (or their linked children, for parents) plus events they created. Holidays = HOLIDAY/TERM_BREAK/isNoSchool events; 'events' = all other events, with no overlap. timetable is projected only onto school days. Auth: requireUser. Service: getCalendarItems.\",","-      \"requestSchema\": {","-        \"query\": {","-          \"from\": \"ISO datetime, required\",","-          \"to\": \"ISO datetime, required, > from, to − from ≤ 100 days\",","-          \"sources\": \"comma-separated CalendarSource list, optional (default 'events,holidays,assignments,quizzes')\",","-          \"studentId\": \"string, optional. PARENT: a linked child. STUDENT: self only. ADMIN/TEACHER: any student they can view (resolveViewedStudent). Otherwise 404.\"","-        }","-      },","+      \"path\": \"/api/me/children/summary\",","+      \"description\": \"PARENT. Returns one summary card per linked child for /my-children. Data comes from overview-service.getChildrenSummary.\",","+      \"requestSchema\": {},","       \"responseSchema\": {","-        \"200\": { \"data\": { \"items\": \"CalendarItem[] sorted by start\", \"timezone\": \"string (SchoolSettings.timezone)\" } },","-        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (studentId)\"]","+        \"data\": [","+          {","+            \"student\": \"{ id, firstName, lastName, avatarUrl, sectionName }\",","+            \"attendanceRateTerm\": \"number 0..1 | null\",","+            \"missingAssignments\": \"int\",","+            \"averageGradePct\": \"number | null\"","+          }","+        ]","       },","-      \"requirementIds\": [\"FR-10\", \"FR-11\", \"FR-13\", \"FR-15\", \"FR-32\", \"NFR-4\", \"NFR-7\"]","+      \"requirementIds\": [\"FR-7\", \"FR-8\"]","     },","     {","-      \"method\": \"POST\",","-      \"path\": \"/api/events\",","-      \"description\": \"Create an event and replace its audiences in one transaction. Applies the FR-5 isNoSchool default, the admin-only field check (FR-6) and canTargetAudience per audience (FR-7). After commit: if the first occurrence starts within 30 days, notify the resolved audience minus the creator with 'event.holiday_created' (HOLIDAY/TERM_BREAK) or 'event.created', link '/calendar?event=<id>'. Auth: requireRole('ADMIN','TEACHER'). Service: createEvent.\",","-      \"requestSchema\": { \"body\": \"EventInput\" },","+      \"method\": \"GET\",","+      \"path\": \"/api/students/:id/overview\",","+      \"description\": \"PARENT (linked child) or staff, checked by assertCanViewStudent. Returns all eight overview cards from the same overview-service functions the streaming page uses. ?cards=today,attendance,... limits which cards load.\",","+      \"requestSchema\": { \"query\": { \"cards\": \"comma list of today|attendance|assignments|grades|announcements|events|teachers|actions, optional\" } },","       \"responseSchema\": {","-        \"201\": { \"data\": \"EventDTO\" },","-        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role | ADMIN_ONLY_FIELD | AUDIENCE_NOT_ALLOWED)\"]","+        \"data\": {","+          \"today\": \"{ isSchoolDay: boolean, noSchoolReason: string | null, periods: { periodName, startsAt, endsAt, courseName, room, teacherName }[] }\",","+          \"attendance\": \"{ rateTerm: number | null, absences: int, lates: int, last5: { date, periodName | null, status }[] }\",","+          \"assignments\": \"{ missing: { id, title, courseName, dueAt }[], dueNext7Days: { id, title, courseName, dueAt }[] }\",","+          \"grades\": \"{ recent: { gradeItemId, title, courseName, score, maxScore, returnedAt }[], courses: { courseId, courseName, currentPct: number | null }[] }\",","+          \"announcements\": \"[] for now, because PRD-12 is absent (FR-13 partial)\",","+          \"events\": \"{ id, title, startsAt, endsAt, allDay, source: 'calendar' | 'myMeetings' }[], at most 5\",","+          \"teachers\": \"{ userId, name, subjects: string[], messageHref }[]\",","+          \"actions\": \"{ type: 'consent' | 'conference', id, title, dueAt | bookingClosesAt, href }[]\"","+        }","       },","-      \"requirementIds\": [\"FR-4\", \"FR-5\", \"FR-6\", \"FR-7\", \"FR-14\", \"FR-28\", \"FR-33\"]","+      \"requirementIds\": [\"FR-9\", \"FR-10\", \"FR-11\", \"FR-12\", \"FR-13\", \"FR-14\", \"FR-15\", \"FR-16\", \"FR-17\", \"FR-35\", \"NFR-2\", \"NFR-5\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/events/:id\",","-      \"description\": \"One event (series) as seen by the caller, with myRsvp, rsvpTotals and canEdit/canRsvp. Visibility uses the same audience rule as GET /api/calendar with sources=['events','holidays']. Auth: requireUser. Service: getEvent.\",","-      \"requestSchema\": { \"params\": { \"id\": \"eventId (cuid)\" } },","-      \"responseSchema\": {","-        \"200\": { \"data\": \"EventDTO\" },","-        \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"]","-      },","-      \"requirementIds\": [\"FR-12\", \"FR-22\", \"FR-33\", \"NFR-7\"]","+      \"path\": \"/api/absence-notes\",","+      \"description\": \"Paginated and scoped by role. PARENT sees notes for linked children. A homeroom TEACHER sees their own section's students. ADMIN sees all. A non-homeroom TEACHER gets 403 NOT_HOMEROOM. Default sort is createdAt:desc. ?q matches the student name.\",","+      \"requestSchema\": { \"query\": { \"status\": \"PENDING|APPROVED|REJECTED, optional\", \"studentId\": \"optional\", \"from\": \"yyyy-MM-dd, optional\", \"to\": \"yyyy-MM-dd, optional\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"createdAt|fromDate:asc|desc\", \"q\": \"string\" } },","+      \"responseSchema\": { \"data\": \"AbsenceNote[]\", \"meta\": \"{ page, pageSize, total }\" },","+      \"requirementIds\": [\"FR-20\", \"FR-21\", \"NFR-5\", \"NFR-10\"]","     },","     {","-      \"method\": \"PATCH\",","-      \"path\": \"/api/events/:id\",","-      \"description\": \"Partial update of the whole series. Every field of EventInput is optional. If audiences is present it replaces the full set, and each entry is re-checked with canTargetAudience. If allDay changes, the matching start/end fields are required. After commit: audit() when an ADMIN edits someone else's event (FR-36). If startAt, endAt, allDay or location changed and the event has an occurrence ending after now, notify 'event.updated' once to the audience minus the editor. Auth: requireUser, then creator or ADMIN. Service: updateEvent.\",","-      \"requestSchema\": { \"params\": { \"id\": \"eventId\" }, \"body\": \"Partial<EventInput> (at least one field)\" },","-      \"responseSchema\": {","-        \"200\": { \"data\": \"EventDTO\" },","-        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (NOT_CREATOR | ADMIN_ONLY_FIELD | AUDIENCE_NOT_ALLOWED)\", \"404 NOT_FOUND\"]","-      },","-      \"requirementIds\": [\"FR-4\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-15\", \"FR-29\", \"FR-33\", \"FR-36\"]","+      \"method\": \"POST\",","+      \"path\": \"/api/absence-notes\",","+      \"description\": \"PARENT, for a linked child only. Creates a PENDING note and notifies the homeroom teacher and ADMINs with absence_note.submitted. Upload the file first via POST /api/files with context=absence-note.\",","+      \"requestSchema\": \"AbsenceNoteInput\",","+      \"responseSchema\": { \"status\": 201, \"data\": \"AbsenceNote\" },","+      \"requirementIds\": [\"FR-2\", \"FR-18\", \"FR-19\", \"FR-41\", \"FR-44\", \"NFR-8\"]","     },","     {","-      \"method\": \"DELETE\",","-      \"path\": \"/api/events/:id\",","-      \"description\": \"Delete an event series. Audiences and RSVPs cascade. audit() when an ADMIN deletes someone else's event. No notification. Auth: requireUser, then creator or ADMIN. Service: deleteEvent.\",","-      \"requestSchema\": { \"params\": { \"id\": \"eventId\" } },","+      \"method\": \"GET\",","+      \"path\": \"/api/absence-notes/:id\",","+      \"description\": \"Detail view for the parent, homeroom teacher or ADMIN. Reviewers also get the attendance records that already exist for the note's dates and periods.\",","+      \"requestSchema\": {},","       \"responseSchema\": {","-        \"200\": { \"data\": { \"id\": \"string\", \"deleted\": true } },","-        \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (NOT_CREATOR)\", \"404 NOT_FOUND\"]","+        \"data\": \"AbsenceNote & { attendanceRecords?: { id, date, periodId | null, periodName | null, status, note | null }[] } (reviewers only)\"","       },","-      \"requirementIds\": [\"FR-8\", \"FR-33\", \"FR-36\"]","+      \"requirementIds\": [\"FR-20\", \"FR-21\", \"FR-41\", \"NFR-5\"]","     },","     {","+      \"method\": \"POST\",","+      \"path\": \"/api/absence-notes/:id/review\",","+      \"description\": \"Homeroom TEACHER or ADMIN. Runs a conditional update on a PENDING note. If the note is no longer PENDING, returns 409 ALREADY_REVIEWED. On APPROVED, covered ABSENT records and missing records become EXCUSED with the note 'Absence note #<id>', all in the same transaction. Then it calls audit({ request }) and notifies linked parents with absence_note.reviewed, including reviewNote.\",","+      \"requestSchema\": { \"decision\": \"APPROVED | REJECTED\", \"reviewNote\": \"string ≤ 1000. Required (min 1) when the decision is REJECTED.\" },","+      \"responseSchema\": { \"data\": { \"note\": \"AbsenceNote\", \"recordsExcused\": \"int\", \"recordsCreated\": \"int\" } },","+      \"requirementIds\": [\"FR-22\", \"FR-23\", \"FR-26\", \"FR-44\", \"NFR-3\", \"NFR-5\"]","+    },","+    {","+      \"method\": \"POST\",","+      \"path\": \"/api/files\",","+      \"description\": \"EXISTING, extended. Adds the context 'absence-note': PDF, JPG or PNG only, sniffed with file-type. Read access goes to linked parents, the homeroom teacher and ADMIN, through the resolver in src/server/files/contexts.ts. The multipart contract is unchanged.\",","+      \"requestSchema\": { \"multipart\": { \"context\": \"'absence-note' (sent before file)\", \"file\": \"binary, application/pdf | image/jpeg | image/png\" } },","+      \"responseSchema\": { \"status\": 201, \"data\": { \"id\": \"string\", \"name\": \"string\", \"size\": \"int\", \"mimeType\": \"string\" } },","+      \"requirementIds\": [\"FR-18\", \"FR-41\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/events/:id/ics\",","-      \"description\": \"Single-event iCalendar download ('Add to my calendar'). Recurring events are emitted as one VEVENT with RRULE, plus a VTIMEZONE. Auth: requireUser plus the same visibility as GET /api/events/:id. Service: getEvent → buildCalendar([event]).\",","-      \"requestSchema\": { \"params\": { \"id\": \"eventId\" } },","-      \"responseSchema\": {","-        \"200\": {","-          \"contentType\": \"text/calendar; charset=utf-8\",","-          \"headers\": { \"Content-Disposition\": \"attachment; filename=\\\"<slugified-title>.ics\\\"\" },","-          \"body\": \"RFC 5545 VCALENDAR (CRLF, lines folded at 75 octets, TEXT escaped)\"","-        },","-        \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"]","-      },","-      \"requirementIds\": [\"FR-12\", \"FR-26\", \"FR-33\", \"NFR-3\", \"NFR-6\"]","+      \"path\": \"/api/conferences\",","+      \"description\": \"Lists events by role. ADMIN sees all. TEACHER sees events whose eligible grade levels include students they teach. PARENT sees events eligible for any linked child. Paginated, default sort date:desc, ?q matches the title.\",","+      \"requestSchema\": { \"query\": { \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"date|title:asc|desc\", \"q\": \"string\", \"upcoming\": \"boolean, optional\" } },","+      \"responseSchema\": { \"data\": \"ConferenceEvent[]\", \"meta\": \"{ page, pageSize, total }\" },","+      \"requirementIds\": [\"FR-28\", \"FR-42\", \"NFR-10\"]","     },","     {","-      \"method\": \"PUT\",","-      \"path\": \"/api/events/:id/rsvp\",","-      \"description\": \"Create or replace the caller's RSVP for the series. Checks run in this order: visible (404), rsvpEnabled (409 RSVP_DISABLED), isUserInAudience (403 NOT_IN_AUDIENCE), now < rsvpDeadline (409 RSVP_CLOSED). guests is forced to 0 for non-parents. Upsert on (eventId, userId). Auth: requireUser. Service: upsertRsvp.\",","-      \"requestSchema\": { \"params\": { \"id\": \"eventId\" }, \"body\": \"RsvpInput\" },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"myRsvp\": \"RsvpDTO\", \"rsvpTotals\": \"{ yes, no, maybe, guests }\" } },","-        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (NOT_IN_AUDIENCE)\", \"404 NOT_FOUND\", \"409 CONFLICT (RSVP_DISABLED | RSVP_CLOSED)\"]","-      },","-      \"requirementIds\": [\"FR-21\", \"NFR-7\"]","+      \"method\": \"POST\",","+      \"path\": \"/api/conferences\",","+      \"description\": \"ADMIN. Creates an event, notifies teachers of eligible students with conference.slots_requested, and calls audit({ request }).\",","+      \"requestSchema\": \"ConferenceEventInput\",","+      \"responseSchema\": { \"status\": 201, \"data\": \"ConferenceEvent\" },","+      \"requirementIds\": [\"FR-2\", \"FR-28\", \"FR-44\", \"NFR-3\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/events/:id/rsvps\",","-      \"description\": \"Full RSVP list for the creator or an ADMIN. With format=csv it streams CSV through src/server/csv.ts, with columns name, role, response, guests, note, updatedAt. Auth: requireUser, then creator or ADMIN. Service: listRsvps.\",","-      \"requestSchema\": { \"params\": { \"id\": \"eventId\" }, \"query\": { \"format\": \"'json' | 'csv' (default json)\" } },","-      \"responseSchema\": {","-        \"200\": {","-          \"json\": { \"data\": { \"items\": \"RsvpListItem[] sorted by user name\", \"totals\": \"{ yes, no, maybe, guests }\" } },","-          \"csv\": { \"contentType\": \"text/csv; charset=utf-8\", \"headers\": { \"Content-Disposition\": \"attachment; filename=\\\"rsvps-<eventId>.csv\\\"\" } }","-        },","-        \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (NOT_CREATOR)\", \"404 NOT_FOUND\", \"409 CONFLICT (RSVP_DISABLED)\"]","-      },","-      \"requirementIds\": [\"FR-22\"]","+      \"path\": \"/api/conferences/:id\",","+      \"description\": \"Event detail, visible to the same audience as the list. TEACHER callers also get mySlotCount. PARENT callers get the child's teachers that have slots.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": \"ConferenceEvent & { mySlotCount?: int, teachers?: { id, name, subjects: string[] }[] }\" },","+      \"requirementIds\": [\"FR-28\", \"FR-30\"]","     },","     {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/conferences/:id\",","+      \"description\": \"ADMIN. Partial ConferenceEventInput. Changing slotMinutes or date while booked slots exist returns 409 SLOT_BOOKED. Calls audit({ request }).\",","+      \"requestSchema\": \"Partial<ConferenceEventInput>\",","+      \"responseSchema\": { \"data\": \"ConferenceEvent\" },","+      \"requirementIds\": [\"FR-2\", \"FR-28\", \"NFR-3\"]","+    },","+    {","+      \"method\": \"PUT\",","+      \"path\": \"/api/conferences/:id/availability\",","+      \"description\": \"TEACHER, for their own availability. In one transaction it deletes the caller's unbooked, unblocked slots and inserts slots generated from the ranges (generateSlots, slotMinutes). Booked and blocked slots stay. Ranges must lie within the event date and must not overlap.\",","+      \"requestSchema\": { \"ranges\": \"{ start: 'HH:mm', end: 'HH:mm' }[], 1..10, times in the school timezone on the event date\", \"location\": \"string ≤ 200, optional\" },","+      \"responseSchema\": { \"data\": { \"slots\": \"ConferenceSlot[]\", \"created\": \"int\", \"removed\": \"int\", \"kept\": \"int\" } },","+      \"requirementIds\": [\"FR-29\", \"NFR-8\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/me/calendar-feed\",","-      \"description\": \"The caller's feed status. If the caller has no token, one is created (32 random bytes, base64url) and its hash stored, and the URL is returned once. If a token already exists, url is null, because only the hash is stored (D-6). Auth: requireUser. Service: getOrCreateFeedToken.\",","+      \"path\": \"/api/conferences/:id/slots\",","+      \"description\": \"PARENT: slots of the selected child's teachers. The child comes from ?studentId, else sh_child via getSelectedChild. TEACHER: their own slots, with ?view=day returning only booked slots ordered by startsAt for the printable day view. ADMIN: all slots, filterable by teacherId. The view returns all slots, not a paginated list.\",","+      \"requestSchema\": { \"query\": { \"studentId\": \"optional (PARENT)\", \"teacherId\": \"optional (ADMIN)\", \"view\": \"'day', optional (TEACHER/ADMIN)\" } },","+      \"responseSchema\": { \"data\": \"ConferenceSlot[]\" },","+      \"requirementIds\": [\"FR-5\", \"FR-29\", \"FR-30\", \"FR-34\", \"NFR-1\", \"NFR-5\"]","+    },","+    {","+      \"method\": \"PATCH\",","+      \"path\": \"/api/conference-slots/:id\",","+      \"description\": \"The slot's TEACHER, or ADMIN. Blocks or unblocks a slot, or edits its location. Blocking a booked slot returns 409 SLOT_BOOKED.\",","+      \"requestSchema\": { \"blocked\": \"boolean, optional\", \"location\": \"string ≤ 200 | null, optional\" },","+      \"responseSchema\": { \"data\": \"ConferenceSlot\" },","+      \"requirementIds\": [\"FR-29\"]","+    },","+    {","+      \"method\": \"DELETE\",","+      \"path\": \"/api/conference-slots/:id\",","+      \"description\": \"The slot's TEACHER, or ADMIN. Removes an unbooked slot. A booked slot returns 409 SLOT_BOOKED.\",","       \"requestSchema\": {},","-      \"responseSchema\": {","-        \"200\": { \"data\": \"FeedStatus\" },","-        \"errors\": [\"401 UNAUTHENTICATED\"]","-      },","-      \"requirementIds\": [\"FR-24\", \"FR-25\", \"NFR-5\"]","+      \"responseSchema\": { \"data\": { \"id\": \"string\" } },","+      \"requirementIds\": [\"FR-29\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/me/calendar-feed/reset\",","-      \"description\": \"Replace the caller's token (upsert a new hash). The old URL returns 404 immediately. The new URL is returned once. The raw token is never logged. Auth: requireUser. Service: resetFeedToken.\",","-      \"requestSchema\": { \"body\": \"{} (empty)\" },","-      \"responseSchema\": {","-        \"200\": { \"data\": \"FeedStatus (url non-null, hasToken=true)\" },","-        \"errors\": [\"401 UNAUTHENTICATED\"]","-      },","-      \"requirementIds\": [\"FR-24\", \"FR-25\", \"NFR-5\"]","+      \"path\": \"/api/conference-slots/:id/book\",","+      \"description\": \"PARENT, for a linked child. Only allowed while now is within [bookingOpensAt, bookingClosesAt], else 400 OUTSIDE_BOOKING_WINDOW. In one transaction: an overlap check against the parent's other bookings (409 OVERLAP), then updateMany where {id, bookedByParentId: null, blocked: false} (count 0 returns 409 SLOT_TAKEN), with P2002 on (eventId, teacherId, bookedForStudentId) returning 409 ONE_PER_TEACHER. After commit it sends conference.booked to the parent and teacher, with an ics link.\",","+      \"requestSchema\": { \"studentId\": \"string\", \"parentNote\": \"string ≤ 500, optional\" },","+      \"responseSchema\": { \"data\": \"ConferenceSlot\", \"errors\": { \"409\": \"{ error: { code: 'CONFLICT', message: 'That slot was just taken' | 'You already have a meeting with <teacher> at <time>' | ..., details: { reason } } }\" } },","+      \"requirementIds\": [\"FR-2\", \"FR-30\", \"FR-31\", \"FR-32\", \"FR-33\", \"NFR-1\", \"NFR-5\"]","     },","     {","+      \"method\": \"POST\",","+      \"path\": \"/api/conference-slots/:id/cancel\",","+      \"description\": \"The booking PARENT (403 NOT_BOOKER otherwise) or ADMIN. Only allowed before bookingClosesAt, else 400 OUTSIDE_BOOKING_WINDOW. Clears the booking fields and sends conference.cancelled to the parent and teacher. To reschedule, the client cancels and then books.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": \"ConferenceSlot\" },","+      \"requirementIds\": [\"FR-32\", \"FR-33\", \"FR-44\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/calendar/feed/:token\",","-      \"description\": \"Private iCal subscription feed, authenticated by token. Route folder: src/app/api/calendar/feed/[token]/route.ts. The handler strips a trailing '.ics' from the param, then hashToken → CalendarFeedToken lookup → user ACTIVE → rateLimit('calfeed:'+tokenHash, 60, 3_600_000) → getCalendarItems(user, now−30d..now+365d, sources events/holidays/assignments/quizzes, series mode) → buildCalendar. Contents match what the user sees in the app. Parents get all their children's audiences and deadlines.\",","-      \"requestSchema\": { \"params\": { \"token\": \"'<base64url>.ics' or '<base64url>'\" } },","-      \"responseSchema\": {","-        \"200\": {","-          \"contentType\": \"text/calendar; charset=utf-8\",","-          \"headers\": { \"Cache-Control\": \"private, max-age=900\" },","-          \"body\": \"VCALENDAR with PRODID, X-WR-CALNAME 'SchoolHub', VTIMEZONE for the school tz, VEVENTs (UID '<id>@schoolhub', RRULE for series, VALUE=DATE for all-day with exclusive DTEND, URL on deadlines)\"","-        },","-        \"404\": { \"contentType\": \"text/plain\", \"body\": \"Not found\" },","-        \"429\": { \"body\": \"{ error: { code: 'RATE_LIMITED', message, details: { retryAfterMs } } }\", \"headers\": { \"Retry-After\": \"seconds\" } }","-      },","-      \"requirementIds\": [\"FR-26\", \"FR-27\", \"NFR-3\", \"NFR-5\", \"NFR-6\"]","+      \"path\": \"/api/conference-slots/:id/ics\",","+      \"description\": \"The booking parent, the slot's teacher, or ADMIN. Returns a single VEVENT built with src/server/calendar/ical.ts.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"contentType\": \"text/calendar; charset=utf-8\", \"body\": \"VCALENDAR with one VEVENT (UID slot-<id>@schoolhub, DTSTART/DTEND UTC, SUMMARY, LOCATION)\" },","+      \"requirementIds\": [\"FR-33\", \"FR-35\"]","     },","     {","       \"method\": \"GET\",","-      \"path\": \"/api/school-day\",","-      \"description\": \"Is this date a school day, and if not, why. A new singular folder; the existing /api/school-days (PRD-06) is untouched. Auth: requireUser. Service: isSchoolDay.\",","-      \"requestSchema\": { \"query\": { \"date\": \"yyyy-MM-dd (school-tz calendar date), required\" } },","-      \"responseSchema\": {","-        \"200\": { \"data\": \"SchoolDayResult\" },","-        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"]","-      },","-      \"requirementIds\": [\"FR-16\", \"FR-19\", \"FR-34\"]","+      \"path\": \"/api/consent-forms\",","+      \"description\": \"PARENT: forms whose audience includes a linked child, with children[] response status. ?pending=true filters to forms not yet answered for some child. TEACHER: forms they created. ADMIN: all forms. Paginated, default sort dueAt:asc, ?q matches the title.\",","+      \"requestSchema\": { \"query\": { \"pending\": \"boolean, optional\", \"studentId\": \"optional (PARENT)\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"dueAt|createdAt:asc|desc\", \"q\": \"string\" } },","+      \"responseSchema\": { \"data\": \"ConsentForm[]\", \"meta\": \"{ page, pageSize, total }\" },","+      \"requirementIds\": [\"FR-16\", \"FR-37\", \"FR-42\", \"NFR-5\", \"NFR-10\"]","     },","     {","+      \"method\": \"POST\",","+      \"path\": \"/api/consent-forms\",","+      \"description\": \"ADMIN can target any audience. TEACHER can only target COURSE audiences they manage, checked by canTargetAudience per row. Creates the form and notifies parents of resolved audience students with consent.requested.\",","+      \"requestSchema\": \"ConsentFormInput\",","+      \"responseSchema\": { \"status\": 201, \"data\": \"ConsentForm & { notifiedParents: int }\" },","+      \"requirementIds\": [\"FR-36\", \"FR-44\", \"NFR-5\"]","+    },","+    {","       \"method\": \"GET\",","-      \"path\": \"/api/public/events\",","-      \"description\": \"Public events (isPublic=true), expanded, with public-safe fields only. This is a hook for PRD-18; no UI is added. Auth: none. rateLimit('pubcal:'+getClientIp, 120, 3_600_000). Service: getPublicEvents.\",","-      \"requestSchema\": { \"query\": { \"from\": \"ISO datetime, required\", \"to\": \"ISO datetime, required, > from, ≤ from + 100 days\" } },","-      \"responseSchema\": {","-        \"200\": { \"data\": { \"items\": \"PublicEventDTO[] sorted by start\" } },","-        \"errors\": [\"400 VALIDATION_ERROR\", \"429 RATE_LIMITED (details.retryAfterMs, Retry-After header)\"]","-      },","-      \"requirementIds\": [\"FR-30\", \"NFR-5\", \"NFR-11\"]","+      \"path\": \"/api/consent-forms/:id\",","+      \"description\": \"The audience's parents (with their own children[]), the creator, or ADMIN. Anyone else gets 404.\",","+      \"requestSchema\": {},","+      \"responseSchema\": { \"data\": \"ConsentForm\" },","+      \"requirementIds\": [\"FR-36\", \"FR-37\", \"NFR-5\"]","     },","     {","       \"method\": \"POST\",","-      \"path\": \"/api/academic-years/:id/term-breaks\",","-      \"description\": \"Create an all-day TERM_BREAK event (isNoSchool=true, SCHOOL audience, title 'Term break') for each gap of at least one day between consecutive terms, from prev.endDate+1 to next.startDate (exclusive). Idempotent: a gap that already has a TERM_BREAK with the same span is skipped. Writes one audit() entry. Sends no event.created notifications. Auth: requireRole('ADMIN'). Service: createTermBreaks.\",","-      \"requestSchema\": { \"params\": { \"id\": \"academicYearId\" }, \"body\": \"{} (empty)\" },","+      \"path\": \"/api/consent-forms/:id/responses\",","+      \"description\": \"PARENT, for a linked child in the audience. Only allowed while now < dueAt, else 400 PAST_DUE. The signature must match the caller's full name case-insensitively, else 400 SIGNATURE_MISMATCH. Upserts by (formId, studentId), so any linked parent overwrites the single response. Calls audit({ before, after, request }) on create and on every change.\",","+      \"requestSchema\": \"ConsentResponseInput\",","+      \"responseSchema\": { \"data\": { \"formId\": \"string\", \"studentId\": \"string\", \"value\": \"GRANTED | DECLINED\", \"respondedBy\": \"{ id, name }\", \"comment\": \"string | null\", \"updatedAt\": \"ISO\", \"changed\": \"boolean (true if it overwrote a previous response)\" } },","+      \"requirementIds\": [\"FR-37\", \"FR-38\", \"NFR-3\", \"NFR-5\"]","+    },","+    {","+      \"method\": \"GET\",","+      \"path\": \"/api/consent-forms/:id/tracking\",","+      \"description\": \"The creator or ADMIN (assertConsentOwnerOrAdmin, 403 NOT_FORM_OWNER otherwise). Returns one row per audience student. ?format=csv returns the whole filtered set as CSV via src/server/csv.ts, without pagination.\",","+      \"requestSchema\": { \"query\": { \"status\": \"GRANTED|DECLINED|NO_RESPONSE, optional\", \"format\": \"'csv', optional\", \"page\": \"int\", \"pageSize\": \"int ≤ 100\", \"sort\": \"studentName|status|respondedAt:asc|desc\", \"q\": \"string (student name)\" } },","       \"responseSchema\": {","-        \"200\": { \"data\": { \"created\": \"number\", \"skipped\": \"number\", \"events\": \"EventDTO[] (created only)\" } },","-        \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND (year)\"]","+        \"data\": [ { \"student\": \"{ id, firstName, lastName, sectionName }\", \"status\": \"GRANTED | DECLINED | NO_RESPONSE\", \"respondedBy\": \"{ id, name } | null\", \"respondedAt\": \"ISO | null\", \"comment\": \"string | null\" } ],","+        \"meta\": \"{ page, pageSize, total, counts: { granted, declined, noResponse } }\",","+        \"csv\": \"columns: Student, Section, Status, Responded by, Responded at, Comment\"","       },","-      \"requirementIds\": [\"FR-20\", \"FR-36\"]","+      \"requirementIds\": [\"FR-39\", \"NFR-5\", \"NFR-10\"]","     },","     {","-      \"method\": \"GET\",","-      \"path\": \"/api/attendance/today\",","-      \"description\": \"EXISTING route, extended. getToday adds noSchoolReason so the landing page can show 'No classes today — <reason>'. All other fields are unchanged.\",","+      \"method\": \"POST\",","+      \"path\": \"/api/consent-forms/:id/remind\",","+      \"description\": \"The creator or ADMIN. Claims the throttle with updateMany where {id, lastRemindedAt null or < now − 24h}. A count of 0 returns 429 RATE_LIMITED with details.retryAfterMs. Otherwise sends consent.reminder to parents of non-responding students. A form past dueAt returns 400 PAST_DUE.\",","       \"requestSchema\": {},","-      \"responseSchema\": { \"200\": { \"data\": \"<existing shape> & { noSchoolReason: string|null }\" } },","-      \"requirementIds\": [\"FR-18\"]","+      \"responseSchema\": { \"data\": { \"notifiedParents\": \"int\", \"remindedAt\": \"ISO\" } },","+      \"requirementIds\": [\"FR-39\", \"FR-44\"]","     },","     {","       \"method\": \"GET\",","+      \"path\": \"/api/me/timetable\",","+      \"description\": \"EXISTING, extended. When a PARENT omits studentId, it defaults to getSelectedChild (sh_child, then the first child) instead of erroring or asking. An explicit ?studentId= still overrides it. /assignments and /grades pages use the same default server-side. The response shape is unchanged.\",","+      \"requestSchema\": { \"query\": { \"studentId\": \"optional override\" } },","+      \"responseSchema\": { \"data\": \"unchanged existing timetable shape\" },","+      \"requirementIds\": [\"FR-5\", \"FR-4\"]","+    },","+    {","+      \"method\": \"GET\",","       \"path\": \"/api/attendance/register\",","-      \"description\": \"EXISTING route, extended. The register response adds noSchoolReason for the requested date, which drives the RegisterForm warning Alert. All other fields are unchanged. This contract adds the field on top of system-design §2.4, which names only getToday/getOverview; RegisterForm needs it for the banner.\",","-      \"requestSchema\": { \"query\": \"<existing registerQuery>\" },","-      \"responseSchema\": { \"200\": { \"data\": \"<existing shape> & { noSchoolReason: string|null }\" } },","-      \"requirementIds\": [\"FR-18\"]","+      \"description\": \"EXISTING, extended (getRegister). For each student covered by an APPROVED note, it pre-fills status EXCUSED when no record exists and adds absence-note fields. The teacher can still change the status.\",","+      \"requestSchema\": { \"query\": \"unchanged\" },","+      \"responseSchema\": { \"data\": \"existing register shape; each student row gains { absenceNoteId: string | null, excusable: boolean, prefilled: boolean }\" },","+      \"requirementIds\": [\"FR-24\", \"FR-25\"]","     },","     {","       \"method\": \"PUT\",","       \"path\": \"/api/attendance/register\",","-      \"description\": \"EXISTING route, extended (D-8). registerPutBody gains an optional holidayOverride flag. If isSchoolDay(date) is false and holidayOverride !== true, the save is rejected and nothing is written.\",","-      \"requestSchema\": { \"body\": \"<existing registerPutBody> & { holidayOverride?: boolean (default false) }\" },","-      \"responseSchema\": {","-        \"200\": { \"data\": \"<existing shape>\" },","-        \"errors\": [\"400 VALIDATION_ERROR (details.reason='HOLIDAY_OVERRIDE_REQUIRED', details.noSchoolReason)\"]","-      },","-      \"requirementIds\": [\"FR-18\", \"NFR-7\"]","+      \"description\": \"EXISTING, extended (saveRegister). EXCUSED is accepted if the caller is ADMIN or an APPROVED note covers the student/date/period. Otherwise it returns 403 with details.reason='NO_APPROVED_NOTE'. attendance.absent notifications skip students covered by a PENDING or APPROVED note.\",","+      \"requestSchema\": \"unchanged\",","+      \"responseSchema\": { \"data\": \"unchanged\" },","+      \"requirementIds\": [\"FR-25\", \"FR-27\"]","     },","     {","       \"method\": \"POST\",","       \"path\": \"/api/internal/email/dispatch\",","-      \"description\": \"EXISTING cron route, extended. Adds an isolated try/catch block that calls sendRsvpReminders(now). The summary gains rsvpReminders; a failure there is logged and does not fail the other blocks. Auth is unchanged.\",","-      \"requestSchema\": {},","-      \"responseSchema\": { \"200\": { \"data\": \"<existing summary> & { rsvpReminders: { events: number, notified: number } }\" } },","-      \"requirementIds\": [\"FR-23\", \"NFR-9\"]","+      \"description\": \"EXISTING cron route, extended. Adds an isolated try-block that calls sendConsentDueReminders(now). For each form with dueAt in (now, now+48h] and a null dueReminderSentAt, it claims the form and sends consent.reminder to non-responders. A failure is logged and does not abort the other jobs.\",","+      \"requestSchema\": \"unchanged (internal auth)\",","+      \"responseSchema\": { \"data\": \"existing summary & { consentReminders: { forms: int, notified: int } }\" },","+      \"requirementIds\": [\"FR-40\", \"FR-44\", \"NFR-8\"]","     }","   ],"," ","   \"nonHttpContracts\": [","     {","-      \"name\": \"getUpcomingEventsForUser(user, limit = 5): Promise<CalendarItem[]>\",","-      \"module\": \"src/server/calendar/sources.ts\",","-      \"description\": \"Hook for PRD-16 dashboards: getCalendarItems(user, now..now+90d, ['events','holidays']), sorted, first `limit` items. No route or UI.\",","-      \"requirementIds\": [\"FR-31\", \"NFR-11\"]","+      \"name\": \"NOTIFICATION_TYPES additions (src/server/notifications/types.ts)\",","+      \"shape\": \"absence_note.submitted (email false), absence_note.reviewed (email true), conference.slots_requested, conference.booked, conference.cancelled, consent.requested (email true), consent.reminder (email true)\",","+      \"requirementIds\": [\"FR-19\", \"FR-26\", \"FR-28\", \"FR-33\", \"FR-36\", \"FR-40\", \"FR-44\"]","     },","     {","-      \"name\": \"getPublicEvents(from: Date, to: Date): Promise<PublicEventDTO[]>\",","-      \"module\": \"src/server/calendar/sources.ts\",","-      \"description\": \"Shared by GET /api/public/events and PRD-18.\",","-      \"requirementIds\": [\"FR-30\"]","+      \"name\": \"getSelectedChild(user, searchParams?) → { studentId, firstName } | null\",","+      \"shape\": \"React cache(). Checks a linked ?studentId first, then a linked sh_child cookie, then the first linked child. Never throws on a bad cookie.\",","+      \"requirementIds\": [\"FR-3\", \"FR-4\", \"FR-5\", \"NFR-5\"]","     },","     {","-      \"name\": \"isSchoolDay(date: Date | string): Promise<{ isSchoolDay: boolean, reason: string|null }>\",","-      \"module\": \"src/server/calendar/calendar-service.ts\",","-      \"description\": \"Called by timetable-service.getScheduleForDate (returns [] when false), attendance-service and GET /api/school-day.\",","-      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\"]","-    },","-    {","-      \"name\": \"Notification types\",","-      \"module\": \"src/server/notifications/types.ts\",","-      \"description\": \"event.created (COMMUNICATION, defaultEmail false), event.holiday_created (COMMUNICATION, defaultEmail true), event.updated (COMMUNICATION, false) and event.rsvp_reminder (COMMUNICATION, false). Payload: { eventId, title, startAt, allDay, location }. Link: '/calendar?event=<eventId>'.\",","-      \"requirementIds\": [\"FR-23\", \"FR-28\", \"FR-29\"]","+      \"name\": \"Pure helpers\",","+      \"shape\": \"coversRecord(note, { date, periodId }) → boolean; generateSlots(ranges, slotMinutes) → { startsAt, endsAt }[]; overlaps(a, b) → boolean; signatureMatches(typed, fullName) → boolean\",","+      \"requirementIds\": [\"FR-23\", \"FR-29\", \"FR-31\", \"FR-37\", \"FR-46\"]","     }","   ],"," "]}],"originalFile":"{\n  \"ticketId\": \"SH-14\",\n  \"timestamp\": \"2026-11-10T00:10:00Z\",\n  \"phase\": \"architect\",\n  \"version\": \"1.0\",\n\n  \"conventions\": {\n    \"replaces\": \"This file replaces the stale SH-13 contracts.\",\n    \"basePath\": \"/api. This is the existing SchoolHub convention, not /api/v1. Route files are src/app/api/**/route.ts. (NFR-8)\",\n    \"handlerPipeline\": \"withHandler → requireUser / requireRole (except the feed and public events) → parseQuery / parseBody with schemas from src/lib/validators/calendar.ts → one service call in src/server/calendar/* → ok(data) / ok(data, {status:201}). Reuse src/server/http.ts; do not hand-roll envelopes. (NFR-8, NFR-9)\",\n    \"envelopes\": {\n      \"success\": \"{ data: T }\",\n      \"error\": \"{ error: { code, message, details? } }\",\n      \"nonJson\": \"GET /api/events/:id/ics, GET /api/calendar/feed/:token and GET /api/events/:id/rsvps?format=csv return raw bodies (text/calendar or text/csv), not the JSON envelope.\"\n    },\n    \"errorCodes\": {\n      \"VALIDATION_ERROR\": 400,\n      \"UNAUTHENTICATED\": 401,\n      \"FORBIDDEN\": 403,\n      \"NOT_FOUND\": 404,\n      \"CONFLICT\": 409,\n      \"RATE_LIMITED\": 429\n    },\n    \"errorPolicy\": [\n      \"An event the caller cannot see returns 404 NOT_FOUND, so its existence does not leak. An event cuid is never treated as authorisation. (NFR-5, NFR-7)\",\n      \"A visible event the caller may not change (not the creator and not ADMIN) returns 403 FORBIDDEN with details.reason='NOT_CREATOR'. (FR-8)\",\n      \"A non-admin who sends isNoSchool=true, isPublic=true or category HOLIDAY/TERM_BREAK gets 403 FORBIDDEN with details.reason='ADMIN_ONLY_FIELD' and details.field. (FR-6)\",\n      \"A teacher who targets an audience that fails canTargetAudience gets 403 FORBIDDEN with details.reason='AUDIENCE_NOT_ALLOWED' and details.index (the index in audiences[]). Nothing is written. (FR-7)\",\n      \"An RSVP on an event with rsvpEnabled=false returns 409 CONFLICT with details.reason='RSVP_DISABLED'. An RSVP at or after rsvpDeadline returns 409 CONFLICT with details.reason='RSVP_CLOSED'. A visible event where the caller is not in the audience (for example the creator, or an admin) returns 403 FORBIDDEN with details.reason='NOT_IN_AUDIENCE'. (FR-21)\",\n      \"studentId for a student the caller cannot view returns 404 NOT_FOUND. (FR-11, NFR-7)\",\n      \"A range with to − from > 100 days, or to ≤ from, returns 400 VALIDATION_ERROR. (FR-32)\",\n      \"A register save on a no-school date without holidayOverride=true returns 400 VALIDATION_ERROR with details.reason='HOLIDAY_OVERRIDE_REQUIRED' and details.noSchoolReason. (FR-18, D-8)\",\n      \"A rate-limit hit returns 429 RATE_LIMITED with details.retryAfterMs and a Retry-After header in seconds. (FR-27, D-9)\",\n      \"An unknown or reset feed token, or a token whose user is not ACTIVE, returns 404 text/plain 'Not found'. It does not use the JSON envelope, and it does not distinguish the cases. (FR-24, NFR-5)\"\n    ],\n    \"ids\": \"All ids are cuid strings. Timestamps are ISO 8601 UTC strings. Dates (yyyy-MM-dd) are calendar dates in the school timezone. The client renders times in SchoolSettings.timezone. (NFR-3, NFR-8)\",\n    \"allDay\": \"All-day input uses startDate/endDate as yyyy-MM-dd with an INCLUSIVE end. The server stores [schoolMidnight(startDate), schoolMidnight(endDate+1)). All-day output gives start/end as UTC instants with an EXCLUSIVE end, plus allDay=true. (FR-4, NFR-3)\",\n    \"occurrenceIds\": \"An expanded occurrence has id '<eventId>:<occurrenceStartISO>' and eventId '<eventId>'. Every /api/events/:id route takes the plain eventId. Edits apply to the whole series. (FR-15)\"\n  },\n\n  \"components\": {\n    \"EventCategory\": \"HOLIDAY|TERM_BREAK|EXAM|EVENT|MEETING|TRIP|SPORTS|DEADLINE|OTHER\",\n    \"Recurrence\": \"NONE|WEEKLY|MONTHLY\",\n    \"RsvpResponse\": \"YES|NO|MAYBE\",\n    \"AudienceType\": \"SCHOOL|STAFF|ROLE|GRADE_LEVEL|SECTION|COURSE\",\n    \"CalendarSource\": \"events|holidays|assignments|quizzes|timetable\",\n    \"UserSummary\": { \"id\": \"string\", \"name\": \"string\", \"role\": \"ADMIN|TEACHER|STUDENT|PARENT\" },\n    \"AudienceInput\": {\n      \"type\": \"AudienceType\",\n      \"refId\": \"string|null (gradeLevelId | sectionId | courseId | role name for ROLE; must be null for SCHOOL/STAFF)\",\n      \"includeStudents\": \"boolean (default true)\",\n      \"includeParents\": \"boolean (default true)\",\n      \"includeTeachers\": \"boolean (default true)\"\n    },\n    \"AudienceDTO\": \"AudienceInput & { id: string, label: string (e.g. 'Grade 7 · parents', 'Robotics Club') }\",\n    \"EventInput\": {\n      \"title\": \"string, 1..150\",\n      \"description\": \"string|null, Markdown, ≤ 5000\",\n      \"category\": \"EventCategory\",\n      \"allDay\": \"boolean\",\n      \"startAt\": \"ISO datetime, required when allDay=false\",\n      \"endAt\": \"ISO datetime ≥ startAt, required when allDay=false\",\n      \"startDate\": \"yyyy-MM-dd, required when allDay=true\",\n      \"endDate\": \"yyyy-MM-dd ≥ startDate, inclusive, required when allDay=true\",\n      \"location\": \"string|null, ≤ 200\",\n      \"roomId\": \"string|null (stored, unused: NFR-11)\",\n      \"recurrence\": \"Recurrence (default NONE)\",\n      \"recurrenceUntil\": \"yyyy-MM-dd|null. Required for WEEKLY/MONTHLY, ≤ start + 1 year, ≥ start date. Must be null for NONE.\",\n      \"isNoSchool\": \"boolean, optional. ADMIN only. Defaults to category ∈ {HOLIDAY, TERM_BREAK} (FR-5).\",\n      \"rsvpEnabled\": \"boolean (default false)\",\n      \"rsvpDeadline\": \"ISO datetime|null. Required when rsvpEnabled, and must be ≤ the first occurrence's start.\",\n      \"isPublic\": \"boolean (default false). ADMIN only.\",\n      \"audiences\": \"AudienceInput[], 1..20\"\n    },\n    \"EventDTO\": {\n      \"id\": \"string\",\n      \"title\": \"string\",\n      \"description\": \"string|null\",\n      \"category\": \"EventCategory\",\n      \"allDay\": \"boolean\",\n      \"startAt\": \"string (series start for recurring events)\",\n      \"endAt\": \"string (exclusive when allDay)\",\n      \"location\": \"string|null\",\n      \"recurrence\": \"Recurrence\",\n      \"recurrenceUntil\": \"yyyy-MM-dd|null\",\n      \"isNoSchool\": \"boolean\",\n      \"isPublic\": \"boolean\",\n      \"rsvpEnabled\": \"boolean\",\n      \"rsvpDeadline\": \"string|null\",\n      \"rsvpOpen\": \"boolean (rsvpEnabled && now < rsvpDeadline)\",\n      \"audiences\": \"AudienceDTO[]\",\n      \"createdBy\": \"UserSummary\",\n      \"createdAt\": \"string\",\n      \"updatedAt\": \"string\",\n      \"canEdit\": \"boolean (creator or ADMIN)\",\n      \"canRsvp\": \"boolean (rsvpOpen && caller is in the audience)\",\n      \"myRsvp\": \"RsvpDTO|null\",\n      \"rsvpTotals\": \"{ yes: number, no: number, maybe: number, guests: number } | null (null when rsvpEnabled=false)\"\n    },\n    \"RsvpInput\": {\n      \"response\": \"RsvpResponse\",\n      \"guests\": \"integer 0..5 (default 0). The server forces 0 for non-PARENT callers.\",\n      \"note\": \"string|null, ≤ 500\"\n    },\n    \"RsvpDTO\": { \"response\": \"RsvpResponse\", \"guests\": \"number\", \"note\": \"string|null\", \"updatedAt\": \"string\" },\n    \"RsvpListItem\": \"RsvpDTO & { user: UserSummary }\",\n    \"CalendarItem\": {\n      \"kind\": \"event|assignment|quiz|timetable\",\n      \"id\": \"string (occurrence id for events, '<kind>:<entityId>[:<studentId>]' for others, so the id stays unique per child)\",\n      \"eventId\": \"string|null (events only)\",\n      \"source\": \"CalendarSource\",\n      \"title\": \"string (deadlines for a parent get the prefix '<childName>: ')\",\n      \"start\": \"string\",\n      \"end\": \"string (exclusive when allDay; equals start for deadlines)\",\n      \"allDay\": \"boolean\",\n      \"category\": \"EventCategory|null (events only)\",\n      \"color\": \"string (category colour for events, course/subject colour for deadlines and timetable)\",\n      \"location\": \"string|null\",\n      \"href\": \"string|null (assignment/quiz page for deadlines, '/calendar?event=<eventId>' for events; FR-13)\",\n      \"childName\": \"string|null (PARENT deadlines only)\",\n      \"isNoSchool\": \"boolean\"\n    },\n    \"SchoolDayResult\": { \"date\": \"yyyy-MM-dd\", \"isSchoolDay\": \"boolean\", \"reason\": \"string|null ('Not a teaching day' | 'Holiday: <title>')\" },\n    \"PublicEventDTO\": {\n      \"id\": \"string (occurrence id)\",\n      \"eventId\": \"string\",\n      \"title\": \"string\",\n      \"category\": \"EventCategory\",\n      \"start\": \"string\",\n      \"end\": \"string\",\n      \"allDay\": \"boolean\",\n      \"location\": \"string|null\",\n      \"description\": \"string|null\"\n    },\n    \"FeedStatus\": {\n      \"url\": \"string|null ('<APP_URL>/api/calendar/feed/<rawToken>.ics'; non-null only when the token was just created or reset; D-6)\",\n      \"hasToken\": \"boolean\",\n      \"createdAt\": \"string|null\"\n    }\n  },\n\n  \"endpoints\": [\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/calendar\",\n      \"description\": \"Merged, expanded, audience-filtered calendar items for the caller, for any role. ADMIN sees every event. Others see events whose audience includes them (or their linked children, for parents) plus events they created. Holidays = HOLIDAY/TERM_BREAK/isNoSchool events; 'events' = all other events, with no overlap. timetable is projected only onto school days. Auth: requireUser. Service: getCalendarItems.\",\n      \"requestSchema\": {\n        \"query\": {\n          \"from\": \"ISO datetime, required\",\n          \"to\": \"ISO datetime, required, > from, to − from ≤ 100 days\",\n          \"sources\": \"comma-separated CalendarSource list, optional (default 'events,holidays,assignments,quizzes')\",\n          \"studentId\": \"string, optional. PARENT: a linked child. STUDENT: self only. ADMIN/TEACHER: any student they can view (resolveViewedStudent). Otherwise 404.\"\n        }\n      },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"items\": \"CalendarItem[] sorted by start\", \"timezone\": \"string (SchoolSettings.timezone)\" } },\n        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"404 NOT_FOUND (studentId)\"]\n      },\n      \"requirementIds\": [\"FR-10\", \"FR-11\", \"FR-13\", \"FR-15\", \"FR-32\", \"NFR-4\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/events\",\n      \"description\": \"Create an event and replace its audiences in one transaction. Applies the FR-5 isNoSchool default, the admin-only field check (FR-6) and canTargetAudience per audience (FR-7). After commit: if the first occurrence starts within 30 days, notify the resolved audience minus the creator with 'event.holiday_created' (HOLIDAY/TERM_BREAK) or 'event.created', link '/calendar?event=<id>'. Auth: requireRole('ADMIN','TEACHER'). Service: createEvent.\",\n      \"requestSchema\": { \"body\": \"EventInput\" },\n      \"responseSchema\": {\n        \"201\": { \"data\": \"EventDTO\" },\n        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (role | ADMIN_ONLY_FIELD | AUDIENCE_NOT_ALLOWED)\"]\n      },\n      \"requirementIds\": [\"FR-4\", \"FR-5\", \"FR-6\", \"FR-7\", \"FR-14\", \"FR-28\", \"FR-33\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/events/:id\",\n      \"description\": \"One event (series) as seen by the caller, with myRsvp, rsvpTotals and canEdit/canRsvp. Visibility uses the same audience rule as GET /api/calendar with sources=['events','holidays']. Auth: requireUser. Service: getEvent.\",\n      \"requestSchema\": { \"params\": { \"id\": \"eventId (cuid)\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": \"EventDTO\" },\n        \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"]\n      },\n      \"requirementIds\": [\"FR-12\", \"FR-22\", \"FR-33\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"PATCH\",\n      \"path\": \"/api/events/:id\",\n      \"description\": \"Partial update of the whole series. Every field of EventInput is optional. If audiences is present it replaces the full set, and each entry is re-checked with canTargetAudience. If allDay changes, the matching start/end fields are required. After commit: audit() when an ADMIN edits someone else's event (FR-36). If startAt, endAt, allDay or location changed and the event has an occurrence ending after now, notify 'event.updated' once to the audience minus the editor. Auth: requireUser, then creator or ADMIN. Service: updateEvent.\",\n      \"requestSchema\": { \"params\": { \"id\": \"eventId\" }, \"body\": \"Partial<EventInput> (at least one field)\" },\n      \"responseSchema\": {\n        \"200\": { \"data\": \"EventDTO\" },\n        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (NOT_CREATOR | ADMIN_ONLY_FIELD | AUDIENCE_NOT_ALLOWED)\", \"404 NOT_FOUND\"]\n      },\n      \"requirementIds\": [\"FR-4\", \"FR-6\", \"FR-7\", \"FR-8\", \"FR-15\", \"FR-29\", \"FR-33\", \"FR-36\"]\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/api/events/:id\",\n      \"description\": \"Delete an event series. Audiences and RSVPs cascade. audit() when an ADMIN deletes someone else's event. No notification. Auth: requireUser, then creator or ADMIN. Service: deleteEvent.\",\n      \"requestSchema\": { \"params\": { \"id\": \"eventId\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"id\": \"string\", \"deleted\": true } },\n        \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (NOT_CREATOR)\", \"404 NOT_FOUND\"]\n      },\n      \"requirementIds\": [\"FR-8\", \"FR-33\", \"FR-36\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/events/:id/ics\",\n      \"description\": \"Single-event iCalendar download ('Add to my calendar'). Recurring events are emitted as one VEVENT with RRULE, plus a VTIMEZONE. Auth: requireUser plus the same visibility as GET /api/events/:id. Service: getEvent → buildCalendar([event]).\",\n      \"requestSchema\": { \"params\": { \"id\": \"eventId\" } },\n      \"responseSchema\": {\n        \"200\": {\n          \"contentType\": \"text/calendar; charset=utf-8\",\n          \"headers\": { \"Content-Disposition\": \"attachment; filename=\\\"<slugified-title>.ics\\\"\" },\n          \"body\": \"RFC 5545 VCALENDAR (CRLF, lines folded at 75 octets, TEXT escaped)\"\n        },\n        \"errors\": [\"401 UNAUTHENTICATED\", \"404 NOT_FOUND\"]\n      },\n      \"requirementIds\": [\"FR-12\", \"FR-26\", \"FR-33\", \"NFR-3\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/events/:id/rsvp\",\n      \"description\": \"Create or replace the caller's RSVP for the series. Checks run in this order: visible (404), rsvpEnabled (409 RSVP_DISABLED), isUserInAudience (403 NOT_IN_AUDIENCE), now < rsvpDeadline (409 RSVP_CLOSED). guests is forced to 0 for non-parents. Upsert on (eventId, userId). Auth: requireUser. Service: upsertRsvp.\",\n      \"requestSchema\": { \"params\": { \"id\": \"eventId\" }, \"body\": \"RsvpInput\" },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"myRsvp\": \"RsvpDTO\", \"rsvpTotals\": \"{ yes, no, maybe, guests }\" } },\n        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\", \"403 FORBIDDEN (NOT_IN_AUDIENCE)\", \"404 NOT_FOUND\", \"409 CONFLICT (RSVP_DISABLED | RSVP_CLOSED)\"]\n      },\n      \"requirementIds\": [\"FR-21\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/events/:id/rsvps\",\n      \"description\": \"Full RSVP list for the creator or an ADMIN. With format=csv it streams CSV through src/server/csv.ts, with columns name, role, response, guests, note, updatedAt. Auth: requireUser, then creator or ADMIN. Service: listRsvps.\",\n      \"requestSchema\": { \"params\": { \"id\": \"eventId\" }, \"query\": { \"format\": \"'json' | 'csv' (default json)\" } },\n      \"responseSchema\": {\n        \"200\": {\n          \"json\": { \"data\": { \"items\": \"RsvpListItem[] sorted by user name\", \"totals\": \"{ yes, no, maybe, guests }\" } },\n          \"csv\": { \"contentType\": \"text/csv; charset=utf-8\", \"headers\": { \"Content-Disposition\": \"attachment; filename=\\\"rsvps-<eventId>.csv\\\"\" } }\n        },\n        \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN (NOT_CREATOR)\", \"404 NOT_FOUND\", \"409 CONFLICT (RSVP_DISABLED)\"]\n      },\n      \"requirementIds\": [\"FR-22\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/me/calendar-feed\",\n      \"description\": \"The caller's feed status. If the caller has no token, one is created (32 random bytes, base64url) and its hash stored, and the URL is returned once. If a token already exists, url is null, because only the hash is stored (D-6). Auth: requireUser. Service: getOrCreateFeedToken.\",\n      \"requestSchema\": {},\n      \"responseSchema\": {\n        \"200\": { \"data\": \"FeedStatus\" },\n        \"errors\": [\"401 UNAUTHENTICATED\"]\n      },\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/me/calendar-feed/reset\",\n      \"description\": \"Replace the caller's token (upsert a new hash). The old URL returns 404 immediately. The new URL is returned once. The raw token is never logged. Auth: requireUser. Service: resetFeedToken.\",\n      \"requestSchema\": { \"body\": \"{} (empty)\" },\n      \"responseSchema\": {\n        \"200\": { \"data\": \"FeedStatus (url non-null, hasToken=true)\" },\n        \"errors\": [\"401 UNAUTHENTICATED\"]\n      },\n      \"requirementIds\": [\"FR-24\", \"FR-25\", \"NFR-5\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/calendar/feed/:token\",\n      \"description\": \"Private iCal subscription feed, authenticated by token. Route folder: src/app/api/calendar/feed/[token]/route.ts. The handler strips a trailing '.ics' from the param, then hashToken → CalendarFeedToken lookup → user ACTIVE → rateLimit('calfeed:'+tokenHash, 60, 3_600_000) → getCalendarItems(user, now−30d..now+365d, sources events/holidays/assignments/quizzes, series mode) → buildCalendar. Contents match what the user sees in the app. Parents get all their children's audiences and deadlines.\",\n      \"requestSchema\": { \"params\": { \"token\": \"'<base64url>.ics' or '<base64url>'\" } },\n      \"responseSchema\": {\n        \"200\": {\n          \"contentType\": \"text/calendar; charset=utf-8\",\n          \"headers\": { \"Cache-Control\": \"private, max-age=900\" },\n          \"body\": \"VCALENDAR with PRODID, X-WR-CALNAME 'SchoolHub', VTIMEZONE for the school tz, VEVENTs (UID '<id>@schoolhub', RRULE for series, VALUE=DATE for all-day with exclusive DTEND, URL on deadlines)\"\n        },\n        \"404\": { \"contentType\": \"text/plain\", \"body\": \"Not found\" },\n        \"429\": { \"body\": \"{ error: { code: 'RATE_LIMITED', message, details: { retryAfterMs } } }\", \"headers\": { \"Retry-After\": \"seconds\" } }\n      },\n      \"requirementIds\": [\"FR-26\", \"FR-27\", \"NFR-3\", \"NFR-5\", \"NFR-6\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/school-day\",\n      \"description\": \"Is this date a school day, and if not, why. A new singular folder; the existing /api/school-days (PRD-06) is untouched. Auth: requireUser. Service: isSchoolDay.\",\n      \"requestSchema\": { \"query\": { \"date\": \"yyyy-MM-dd (school-tz calendar date), required\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": \"SchoolDayResult\" },\n        \"errors\": [\"400 VALIDATION_ERROR\", \"401 UNAUTHENTICATED\"]\n      },\n      \"requirementIds\": [\"FR-16\", \"FR-19\", \"FR-34\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/public/events\",\n      \"description\": \"Public events (isPublic=true), expanded, with public-safe fields only. This is a hook for PRD-18; no UI is added. Auth: none. rateLimit('pubcal:'+getClientIp, 120, 3_600_000). Service: getPublicEvents.\",\n      \"requestSchema\": { \"query\": { \"from\": \"ISO datetime, required\", \"to\": \"ISO datetime, required, > from, ≤ from + 100 days\" } },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"items\": \"PublicEventDTO[] sorted by start\" } },\n        \"errors\": [\"400 VALIDATION_ERROR\", \"429 RATE_LIMITED (details.retryAfterMs, Retry-After header)\"]\n      },\n      \"requirementIds\": [\"FR-30\", \"NFR-5\", \"NFR-11\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/academic-years/:id/term-breaks\",\n      \"description\": \"Create an all-day TERM_BREAK event (isNoSchool=true, SCHOOL audience, title 'Term break') for each gap of at least one day between consecutive terms, from prev.endDate+1 to next.startDate (exclusive). Idempotent: a gap that already has a TERM_BREAK with the same span is skipped. Writes one audit() entry. Sends no event.created notifications. Auth: requireRole('ADMIN'). Service: createTermBreaks.\",\n      \"requestSchema\": { \"params\": { \"id\": \"academicYearId\" }, \"body\": \"{} (empty)\" },\n      \"responseSchema\": {\n        \"200\": { \"data\": { \"created\": \"number\", \"skipped\": \"number\", \"events\": \"EventDTO[] (created only)\" } },\n        \"errors\": [\"401 UNAUTHENTICATED\", \"403 FORBIDDEN\", \"404 NOT_FOUND (year)\"]\n      },\n      \"requirementIds\": [\"FR-20\", \"FR-36\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/today\",\n      \"description\": \"EXISTING route, extended. getToday adds noSchoolReason so the landing page can show 'No classes today — <reason>'. All other fields are unchanged.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"200\": { \"data\": \"<existing shape> & { noSchoolReason: string|null }\" } },\n      \"requirementIds\": [\"FR-18\"]\n    },\n    {\n      \"method\": \"GET\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"EXISTING route, extended. The register response adds noSchoolReason for the requested date, which drives the RegisterForm warning Alert. All other fields are unchanged. This contract adds the field on top of system-design §2.4, which names only getToday/getOverview; RegisterForm needs it for the banner.\",\n      \"requestSchema\": { \"query\": \"<existing registerQuery>\" },\n      \"responseSchema\": { \"200\": { \"data\": \"<existing shape> & { noSchoolReason: string|null }\" } },\n      \"requirementIds\": [\"FR-18\"]\n    },\n    {\n      \"method\": \"PUT\",\n      \"path\": \"/api/attendance/register\",\n      \"description\": \"EXISTING route, extended (D-8). registerPutBody gains an optional holidayOverride flag. If isSchoolDay(date) is false and holidayOverride !== true, the save is rejected and nothing is written.\",\n      \"requestSchema\": { \"body\": \"<existing registerPutBody> & { holidayOverride?: boolean (default false) }\" },\n      \"responseSchema\": {\n        \"200\": { \"data\": \"<existing shape>\" },\n        \"errors\": [\"400 VALIDATION_ERROR (details.reason='HOLIDAY_OVERRIDE_REQUIRED', details.noSchoolReason)\"]\n      },\n      \"requirementIds\": [\"FR-18\", \"NFR-7\"]\n    },\n    {\n      \"method\": \"POST\",\n      \"path\": \"/api/internal/email/dispatch\",\n      \"description\": \"EXISTING cron route, extended. Adds an isolated try/catch block that calls sendRsvpReminders(now). The summary gains rsvpReminders; a failure there is logged and does not fail the other blocks. Auth is unchanged.\",\n      \"requestSchema\": {},\n      \"responseSchema\": { \"200\": { \"data\": \"<existing summary> & { rsvpReminders: { events: number, notified: number } }\" } },\n      \"requirementIds\": [\"FR-23\", \"NFR-9\"]\n    }\n  ],\n\n  \"nonHttpContracts\": [\n    {\n      \"name\": \"getUpcomingEventsForUser(user, limit = 5): Promise<CalendarItem[]>\",\n      \"module\": \"src/server/calendar/sources.ts\",\n      \"description\": \"Hook for PRD-16 dashboards: getCalendarItems(user, now..now+90d, ['events','holidays']), sorted, first `limit` items. No route or UI.\",\n      \"requirementIds\": [\"FR-31\", \"NFR-11\"]\n    },\n    {\n      \"name\": \"getPublicEvents(from: Date, to: Date): Promise<PublicEventDTO[]>\",\n      \"module\": \"src/server/calendar/sources.ts\",\n      \"description\": \"Shared by GET /api/public/events and PRD-18.\",\n      \"requirementIds\": [\"FR-30\"]\n    },\n    {\n      \"name\": \"isSchoolDay(date: Date | string): Promise<{ isSchoolDay: boolean, reason: string|null }>\",\n      \"module\": \"src/server/calendar/calendar-service.ts\",\n      \"description\": \"Called by timetable-service.getScheduleForDate (returns [] when false), attendance-service and GET /api/school-day.\",\n      \"requirementIds\": [\"FR-16\", \"FR-17\", \"FR-18\"]\n    },\n    {\n      \"name\": \"Notification types\",\n      \"module\": \"src/server/notifications/types.ts\",\n      \"description\": \"event.created (COMMUNICATION, defaultEmail false), event.holiday_created (COMMUNICATION, defaultEmail true), event.updated (COMMUNICATION, false) and event.rsvp_reminder (COMMUNICATION, false). Payload: { eventId, title, startAt, allDay, location }. Link: '/calendar?event=<eventId>'.\",\n      \"requirementIds\": [\"FR-23\", \"FR-28\", \"FR-29\"]\n    }\n  ],\n\n  \"status\": \"complete\"\n}\n","userModified":false},"tool_result_meta":[{"id":"toolu_016DMcehc1fAyx4aMmN1uHCk","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
