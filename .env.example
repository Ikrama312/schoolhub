# Postgres connection string used by Prisma. Matches docker-compose.yml's
# schoolhub/schoolhub/schoolhub db/user/password on localhost:5432.
DATABASE_URL="postgresql://schoolhub:schoolhub@localhost:5432/schoolhub?schema=public"

# Public base URL of the app (used for absolute links, e.g. in emails later).
APP_URL="http://localhost:3000"

# Secret used to sign auth sessions (wired up by a later PRD). Generate with
# `openssl rand -base64 32` for real environments.
AUTH_SECRET="dev-secret-change-me"

# Standard Node environment flag. One of: development | test | production.
NODE_ENV="development"

# Outbound email (PRD-04). "console" (default) logs subject/recipient/text
# instead of sending — fine for dev/test. Switch to "smtp" and fill in the
# SMTP_* vars below for a real mail server.
EMAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="SchoolHub <no-reply@schoolhub.test>"

# Bearer token POST /api/internal/email/dispatch requires in its
# Authorization header. Generate with `openssl rand -base64 32` for real
# environments.
CRON_SECRET="dev-secret-change-me"

# File storage (PRD-08). Uploaded files are written under UPLOAD_DIR (never
# inside public/; git-ignored) and served only via GET /api/files/:id.
UPLOAD_DIR="./uploads"
# Per-file upload limit in megabytes (logos are always capped at 2 MB).
MAX_UPLOAD_MB="25"
