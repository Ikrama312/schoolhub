{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WBZsrGHUNth6nzJjcSSjau","type":"tool_result","content":"// ---------------------------------------------------------------------------\n// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n// ---------------------------------------------------------------------------\n\nexport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\nexport interface ScheduleEntry {\n  period: ExpandedSlot['period'];\n  course: ExpandedSlot['course'];\n  room: ExpandedSlot['room'];\n}\n\n/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\nexport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n  let slotTarget: SlotTarget | null;\n  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n\n  const { isoDay } = schoolNow(date, await schoolTimezone());\n  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n\n  const academicYearId = await currentYearId();\n  if (!academicYearId) return [];\n  const slots = await prisma.timetableSlot.findMany({\n    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n    include: slotInclude,\n    orderBy: { period: { order: 'asc' } },\n  });\n  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n}\n\n/** The entry running at `now` in the school timezone, else null. */\nexport async function getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null> {\n  const [schedule, tz] = await Promise.all([getScheduleForDate(user, now), schoolTimezone()]);\n  const { hhmm } = schoolNow(now, tz);\n  return schedule.find((s) => s.period.startTime <= hhmm && hhmm < s.period.endTime) ?? null;\n}\n\nfunction stripUndefined<T extends object>(obj: T) {\n  return Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== undefined)) as Partial<T>;\n}\nimport { cache } from 'react';\nimport { prisma } from '@/server/db';\n\nexport interface UpdateSchoolSettingsInput {\n  name?: string;\n  shortName?: string;\n  logoUrl?: string | null;\n  timezone?: string;\n  addressLine1?: string | null;\n  addressLine2?: string | null;\n  city?: string | null;\n  country?: string | null;\n  phone?: string | null;\n  email?: string | null;\n  website?: string | null;\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {\n  return prisma.schoolSettings.update({ where: { id: 'singleton' }, data: input });\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,","is_error":false}]},"parent_tool_use_id":null,"session_id":"69c9af49-395f-43b5-8c02-c9a3647dc0ab","uuid":"dc3797e5-c20b-49d6-b463-4aa8c3091bac","timestamp":"2026-11-06T05:31:07.100Z","tool_use_result":{"stdout":"// ---------------------------------------------------------------------------\n// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n// ---------------------------------------------------------------------------\n\nexport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\nexport interface ScheduleEntry {\n  period: ExpandedSlot['period'];\n  course: ExpandedSlot['course'];\n  room: ExpandedSlot['room'];\n}\n\n/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\nexport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n  let slotTarget: SlotTarget | null;\n  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n\n  const { isoDay } = schoolNow(date, await schoolTimezone());\n  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n\n  const academicYearId = await currentYearId();\n  if (!academicYearId) return [];\n  const slots = await prisma.timetableSlot.findMany({\n    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n    include: slotInclude,\n    orderBy: { period: { order: 'asc' } },\n  });\n  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n}\n\n/** The entry running at `now` in the school timezone, else null. */\nexport async function getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null> {\n  const [schedule, tz] = await Promise.all([getScheduleForDate(user, now), schoolTimezone()]);\n  const { hhmm } = schoolNow(now, tz);\n  return schedule.find((s) => s.period.startTime <= hhmm && hhmm < s.period.endTime) ?? null;\n}\n\nfunction stripUndefined<T extends object>(obj: T) {\n  return Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== undefined)) as Partial<T>;\n}\nimport { cache } from 'react';\nimport { prisma } from '@/server/db';\n\nexport interface UpdateSchoolSettingsInput {\n  name?: string;\n  shortName?: string;\n  logoUrl?: string | null;\n  timezone?: string;\n  addressLine1?: string | null;\n  addressLine2?: string | null;\n  city?: string | null;\n  country?: string | null;\n  phone?: string | null;\n  email?: string | null;\n  website?: string | null;\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {\n  return prisma.schoolSettings.update({ where: { id: 'singleton' }, data: input });\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WBZsrGHUNth6nzJjcSSjau","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
