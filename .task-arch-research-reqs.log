{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JKVdWQxX3N4N2LgZkhqbRs","type":"tool_result","content":"123:export async function getToday(user: AccessUser, date?: string) {\n173:export async function getRegister(user: AccessUser, key: RegisterKey) {\n212:export async function saveRegister(user: AccessUser, key: RegisterKey, records: RegisterRecordInput[]) {\n342:export async function getStudentAttendance(user: AccessUser, studentId: string, range: { from?: string; to?: string }) {\n410:export async function getCourseMatrix(user: AccessUser, courseId: string) {\n464:export async function getOverview(dateArg?: string) {\n509:export async function remindTeacher(admin: AccessUser, input: { courseId: string; periodId: string; date: string }, request?: Request) {\n565:export async function getReport(filters: ReportFilters): Promise<StudentSummaryRow[]> {\n583:export async function getBelowThreshold() {\n596:export async function getAttendanceSettings() {\n---\nmodel SchoolSettings {\n  id                       String         @id @default(\"singleton\")\n  name                     String         @default(\"SchoolHub Academy\")\n  shortName                String         @default(\"SchoolHub\")\n  logoUrl                  String?\n  timezone                 String         @default(\"UTC\")\n  addressLine1             String?\n  addressLine2             String?\n  city                     String?\n  country                  String?\n  phone                    String?\n  email                    String?\n  website                  String?\n  /// PRD-07 FR-4\n  attendanceMode           AttendanceMode @default(PER_PERIOD)\n  attendanceAlertThreshold Int            @default(90)\n  createdAt                DateTime       @default(now())\n  updatedAt                DateTime       @updatedAt\n109:  admissionNumber  String     @unique\n112:  gradeLevelId     String\n113:  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n257: