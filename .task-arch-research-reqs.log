{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016jcb9YR69UU4i5PXVdntaY","type":"tool_result","content":"import type { FileObject } from '@prisma/client';\nimport { registerBuiltInContexts } from './contexts';\n\n/**\n * File access registry (PRD-08 FR-9, NFR-1). Every download goes through\n * canAccessFile. Later PRDs call registerFileAccess for their own contexts.\n */\n\nexport interface FileAccessUser {\n  id: string;\n  role: string;\n}\n\nexport type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\n\n/** Resolvers receive null for anonymous callers; only return true for null if the context is public. */\nexport type FileAccessResolver = (user: FileAccessUser | null, file: FileAccessFile) => boolean | Promise<boolean>;\n\nconst registry = new Map<string, FileAccessResolver>();\n\nexport function registerFileAccess(context: string, resolver: FileAccessResolver): void {\n  registry.set(context, resolver);\n}\n\nconst ownerOrAdmin = (user: FileAccessUser | null, file: FileAccessFile) =>\n  user !== null && (user.role === 'ADMIN' || user.id === file.ownerId);\n\nlet builtInsRegistered = false;\n\n/**\n * Dispatch order: (1) unattached -> owner/ADMIN; (2) registered resolver;\n * (3) unknown context -> owner/ADMIN. Anonymous is denied except where a\n * resolver explicitly accepts null. Resolver errors deny.\n */\nexport async function canAccessFile(user: FileAccessUser | null, file: FileAccessFile): Promise<boolean> {\n  // Lazy so the circular import with contexts.ts never hits an uninitialised registry,\n  // and no caller can forget to load the built-in contexts.\n  if (!builtInsRegistered) {\n    builtInsRegistered = true;\n    registerBuiltInContexts(registerFileAccess);\n  }\n  if (file.contextId === null) return ownerOrAdmin(user, file);\n  const resolver = registry.get(file.context);\n  if (!resolver) return ownerOrAdmin(user, file);\n  try {\n    return (await resolver(user, file)) === true;\n  } catch {\n    return false;\n  }\n}\n----\n1:import { prisma } from '@/server/db';\n2:import { assertCanViewCourse } from '@/server/auth/course-access';\n3:import { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\n4:import { isAssignmentVisible } from '@/server/assignments/assignments-service';\n5:import type { FileAccessResolver } from './access';\n87:export function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n88:  register('lesson', lessonResolver);\n89:  register('logo', logoResolver);\n90:  register('assignment', assignmentResolver);\n91:  register('submission', submissionResolver);\n92:  register('quiz', quizResolver);\n----\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\nimport { sendDueReminders } from '@/server/assignments/reminders';\nimport { autoSubmitExpiredAttempts, sendAfterCloseResultsReleased } from '@/server/quiz/maintenance';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n  try {\n    const reminders = await sendDueReminders(new Date());\n    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n  } catch (error) {\n    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  // PRD-10 FR-18/FR-30/FR-35: every request, each isolated; both idempotent.\n  try {\n    const submitted = await autoSubmitExpiredAttempts(new Date());\n    if (submitted) logger.info('Expired quiz attempts auto-submitted', { submitted });\n  } catch (error) {\n    logger.error('Quiz auto-submit failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n  try {\n    const released = await sendAfterCloseResultsReleased(new Date());\n    if (released) logger.info('Quiz results released after close', { released });\n  } catch (error) {\n    logger.error('Quiz results release failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n----\nsrc/app/(app):\naccount\nadmin\nassignments\nattendance\ncourses\ndashboard\ngrades\nlayout.tsx\nmy-courses\nnotifications\nquizzes\nreport-cards\nshell.tsx\nstudents\n\nsrc/app/(app)/account:\nnotifications\nsecurity\n\nsrc/app/(app)/students/[id]:\nassignments\nattendance\ncourses\ngrades\nreport-cards\n\nsrc/components:\nConfirmDialog\nDataTable\nDateDisplay\nEmptyState\nFileList\nFileUpload\nForm