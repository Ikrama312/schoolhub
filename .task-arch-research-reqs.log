{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V7Jq2ZaDDNkhWfY44kpJNX","type":"tool_result","content":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { deleteFile } from '@/server/storage';\n\nconst DAY_MS = 24 * 60 * 60_000;\nconst BATCH = 500;\n\n/**\n * FR-12: delete unattached files (contextId null) older than 24 h -- abandoned\n * uploads, detached attachments, removed inline images, replaced logos.\n * Bytes first, then rows. One batch per call; the daily run catches the rest.\n */\nexport async function purgeOrphanFiles(now: Date = new Date()): Promise<number> {\n  const orphans = await prisma.fileObject.findMany({\n    where: { contextId: null, createdAt: { lt: new Date(now.getTime() - DAY_MS) } },\n    select: { id: true, storageKey: true },\n    take: BATCH,\n  });\n  const deleted: string[] = [];\n  for (const file of orphans) {\n    try {\n      await deleteFile(file.storageKey);\n      deleted.push(file.id);\n    } catch (error) {\n      logger.error('Orphan file delete failed', { id: file.id, message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  // ponytail: a file attached in the ms between findMany and here keeps its row but loses its bytes;\n  // wrap in a row lock if attaching day-old uploads ever becomes common.\n  const { count } = await prisma.fileObject.deleteMany({ where: { id: { in: deleted }, contextId: null } });\n  logger.info('Purged orphan files', { count });\n  return count;\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { BODY_MAX, isSafeRelativeLink, TITLE_MAX } from '@/lib/validators/notifications';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\nimport { resolvePrefs } from './preferences';\nimport { NOTIFICATION_TYPES, type NotificationType } from './types';\n\nexport interface NotifyInput {\n  type: NotificationType;\n  userIds: string[];\n  title: string;\n  body?: string;\n  link?: string;\n  email?: { subject?: string; template: 'generic-notification'; data?: Record<string, unknown> };\n}\n\nfunction truncate(value: string, max: number, field: string, type: string): string {\n  if (value.length <= max) return value;\n  logger.warn('Notification field truncated', { field, type, length: value.length, max });\n  return value.slice(0, max);\n}\n\n/**\n * Single producer entry point (FR-6..11). Writes in-app rows and enqueues\n * emails per resolved preferences. NEVER throws — failures are logged.\n * Call after your transaction commits.\n */\nexport async function notify(input: NotifyInput): Promise<void> {\n  try {\n    const def = NOTIFICATION_TYPES[input.type];\n    const userIds = [...new Set(input.userIds)];\n    if (!def || userIds.length === 0) return;\n\n    const title = truncate(input.title, TITLE_MAX, 'title', input.type);\n    const body = input.body == null ? null : truncate(input.body, BODY_MAX, 'body', input.type);\n    let link: string | null = input.link ?? null;\n    if (link !== null && !isSafeRelativeLink(link)) {\n      logger.warn('Notification link dropped (not a safe relative path)', { type: input.type });\n      link = null;\n    }\n\n    const [users, prefRows] = await Promise.all([\n      prisma.user.findMany({\n        where: { id: { in: userIds }, status: { notIn: ['DISABLED', 'ARCHIVED'] }, archivedAt: null },\n        select: { id: true, email: true, firstName: true },\n      }),\n      prisma.notificationPreference.findMany({ where: { userId: { in: userIds }, type: input.type } }),\n    ]);\n    const prefByUser = new Map(prefRows.map((r) => [r.userId, r]));\n\n    const inAppIds: string[] = [];\n    const emailTo: { email: string; firstName: string }[] = [];\n    for (const user of users) {\n      const prefs = resolvePrefs(def, prefByUser.get(user.id));\n      if (prefs.inApp) inAppIds.push(user.id);\n      if (prefs.email && input.email && user.email) emailTo.push(user);\n    }\n\n    if (inAppIds.length) {\n      await prisma.notification.createMany({\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nimport { prisma } from '@/server/db';\nimport { ANSWER_GRACE_MS } from './grading';\nimport { submitAttempt } from './attempt-service';\nimport { notifyResultsReleased } from './quiz-service';\nimport { syncQuizGrades } from '@/server/gradebook/gradebook-sync';\n\n/**\n * PRD-10 maintenance (FR-18, FR-30, FR-35), run by the internal dispatch cron on every call.\n * Both passes are idempotent across concurrent calls.\n */\n\nconst BATCH = 200;\n\n/** IN_PROGRESS attempts past deadline + grace → auto-submit (≤ 200 per call; lazy path covers the rest). */\nexport async function autoSubmitExpiredAttempts(now = new Date()): Promise<number> {\n  const expired = await prisma.quizAttempt.findMany({\n    where: { status: 'IN_PROGRESS', deadlineAt: { lt: new Date(now.getTime() - ANSWER_GRACE_MS) } },\n    select: { id: true },\n    orderBy: { deadlineAt: 'asc' },\n    take: BATCH,\n  });\n  let submitted = 0;\n  for (const a of expired) if (await submitAttempt(a.id, { auto: true }, now)) submitted++;\n  return submitted;\n}\n\n/** A6: AFTER_CLOSE quizzes past close are claimed via resultsReleasedAt null → now; only the claimer notifies. */\nexport async function sendAfterCloseResultsReleased(now = new Date()): Promise<number> {\n  const due = await prisma.quiz.findMany({\n    where: { resultsVisibility: 'AFTER_CLOSE', availableUntil: { lte: now }, resultsReleasedAt: null, status: { not: 'DRAFT' } },\n    select: { id: true },\n    take: BATCH,\n  });\n  let sent = 0;\n  for (const q of due) {\n    const { count } = await prisma.quiz.updateMany({ where: { id: q.id, resultsReleasedAt: null }, data: { resultsReleasedAt: now } });\n    if (count !== 1) continue;\n    await syncQuizGrades(q.id, now); // PRD-11 FR-7 (R1)\n    await notifyResultsReleased(q.id);\n    sent++;\n  }\n  return sent;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"612c4910-0bea-4d59-adbf-fcf9d39f8b8d","uuid":"034f0211-5dff-4c16-9fd3-1bfdbddaa508","timestamp":"2026-11-09T16:29:14.101Z","tool_use_result":{"stdout":"import { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodTypeAny, type output } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: 