{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KqN36Ro2mBHF2o5T2bkYPv","type":"tool_result","content":"src/components:\nConfirmDialog\nDataTable\nDateDisplay\nEmptyState\nFormField\nLoadingSkeleton\nNotificationBell\nPageHeader\nPasswordChecklist\nStatCard\nToast\nUserAvatar\nUserPicker\n\nsrc/config:\ncourse-tabs.ts\nnavigation.ts\npublic-routes.ts\nstudent-tabs.ts\n\nsrc/server:\nattendance\naudit.ts\nauth\ncontent\ncourses\ncsv.ts\ndb.ts\nemail\nenrollment\nfiles\nhttp.ts\nnotifications\nrate-limit.ts\nsections\nservices\nstorage.ts\ntimetable\n\nsrc/server/files:\naccess.ts\ncontexts.ts\nfiles-service.ts\npurge.ts\nvalidate.ts\n\nsrc/server/notifications:\nnotify.ts\npreferences.ts\npurge.ts\nservice.ts\ntypes.ts\n---\n407:model Course {\n408-  id                 String              @id @default(cuid())\n409-  academicYearId     String\n410-  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n411-  subjectId          String\n412-  subject            Subject             @relation(fields: [subjectId], references: [id])\n413-  sectionId          String?\n414-  section            Section?            @relation(fields: [sectionId], references: [id])\n415-  teacherId          String\n416-  teacher            User                @relation(\"CourseTeacher\", fields: [teacherId], references: [id])\n417-  coTeacherIds       String[]            @default([])\n418-  name               String\n419-  code               String\n420-  kind               CourseKind          @default(CORE)\n421-  description        String?\n422-  capacity           Int?\n423-  archivedAt         DateTime?\n424-  createdAt          DateTime            @default(now())\n425-  updatedAt          DateTime            @updatedAt\n426-  enrollments        Enrollment[]\n427-  timetableSlots     TimetableSlot[]\n428-  attendanceSessions AttendanceSession[]\n429-  modules            Module[]\n172:model AuditLog {\n192:model SchoolSettings {\n436:model Enrollment {\n477:model SchoolDay {\n564:model FileObject {\n---\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\n---\n36:export function registerBuiltInContexts(register: (context: string, resolver: FileAccessRe