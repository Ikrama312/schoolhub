{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JkoBJSvFifhvrGsNR9cSxD","type":"tool_result","content":"import type { FileObject } from '@prisma/client';\nimport { registerBuiltInContexts } from './contexts';\n\n/**\n * File access registry (PRD-08 FR-9, NFR-1). Every download goes through\n * canAccessFile. Later PRDs call registerFileAccess for their own contexts.\n */\n\nexport interface FileAccessUser {\n  id: string;\n  role: string;\n}\n\nexport type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\n\n/** Resolvers receive null for anonymous callers; only return true for null if the context is public. */\nexport type FileAccessResolver = (user: FileAccessUser | null, file: FileAccessFile) => boolean | Promise<boolean>;\n\nconst registry = new Map<string, FileAccessResolver>();\n\nexport function registerFileAccess(context: string, resolver: FileAccessResolver): void {\n  registry.set(context, resolver);\n}\n\nconst ownerOrAdmin = (user: FileAccessUser | null, file: FileAccessFile) =>\n  user !== null && (user.role === 'ADMIN' || user.id === file.ownerId);\n\nlet builtInsRegistered = false;\n\n/**\n * Dispatch order: (1) unattached -> owner/ADMIN; (2) registered resolver;\n * (3) unknown context -> owner/ADMIN. Anonymous is denied except where a\n * resolver explicitly accepts null. Resolver errors deny.\n */\nexport async function canAccessFile(user: FileAccessUser | null, file: FileAccessFile): Promise<boolean> {\n  // Lazy so the circular import with contexts.ts never hits an uninitialised registry,\n  // and no caller can forget to load the built-in contexts.\n  if (!builtInsRegistered) {\n    builtInsRegistered = true;\n    registerBuiltInContexts(registerFileAccess);\n  }\n  if (file.contextId === null) return ownerOrAdmin(user, file);\n  const resolver = registry.get(file.context);\n  if (!resolver) return ownerOrAdmin(user, file);\n  try {\n    return (await resolver(user, file)) === true;\n  } catch {\n    return false;\n  }\n}\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport { isAssignmentVisible } from '@/server/assignments/assignments-service';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'assignment' (PRD-09 FR-47): the caller can view the course and (unless they manage it) the assignment is visible. */\nexport const assignmentResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const a = await prisma.assignment.findUnique({\n    where: { id: file.contextId },\n    select: { status: true, availableFrom: true, archivedAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n  });\n  if (!a) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], a.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, a.course) || isAssignmentVisible(a, new Date());\n};\n\n/**\n * 'submission' (PRD-09 FR-47, NFR-4): the submitting student, their linked parents, or a course\n * manager (ADMIN / teacher / co-teacher). Everyone else, including other students, is denied.\n */\nexport const submissionResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const sub = await prisma.submission.findUnique({\n    where: { id: file.contextId },\n    select: { studentId: true, assignment: { select: { course: { select: { teacherId: true, coTeacherIds: true } } } } },\n  });\n  if (!sub) return false;\n  if (sub.studentId === user.id) return true;\n  if (canSeeDrafts(user, sub.assignment.course)) return true;\n  if (user.role !== 'PARENT') return false;\n  const link = await prisma.parentStudentLink.findFirst({ where: { parentId: user.id, studentId: sub.studentId }, select: { id: true } });\n  return link !== null;\n};\n\n/** 'quiz' (PRD-10 FR-39): a course manager, or a course viewer once the quiz is PUBLISHED/CLOSED (images live only in prompts). */\nexport const quizResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const q = await prisma.quiz.findUnique({\n    where: { id: file.contextId },\n    select: { status: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n  });\n  if (!q) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], q.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, q.course) || q.status !== 'DRAFT';\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n  register('assignment', assignmentResolver);\n  register('submission', submissionResolver);\n  register('quiz', quizResolver);\n}\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\nimport AssignmentOutlinedIcon from '@mui/icons-material/AssignmentOutlined';\nimport GradingOutlinedIcon from '@mui/icons-material/GradingOutlined';\nimport WorkspacePremiumOutlinedIcon from '@mui/icons-material/WorkspacePremiumOutlined';\nimport StraightenOutlinedIcon from '@mui/icons-material/StraightenOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Assignments', href: '/assignments', icon: AssignmentOutlinedIcon, roles: ['STUDENT', 'PARENT', 'TEACHER', 'ADMIN'] },\n  { label: 'Grades', href: '/grades', icon: GradingOutlinedIcon, roles: ['STUDENT', 'PARENT'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Report cards', href: '/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Grading scales', href: '/admin/grading-scales', icon: StraightenOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Report cards', href: '/admin/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n  { key: 'quizzes', label: 'Quizzes', href: (id) => `/courses/${id}/quizzes`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n  // PRD-11 FR-18 / FR-28\n  { key: 'gradebook', label: 'Gradebook', href: (id) => `/courses/${id}/gradebook`, roles: ['ADMIN', 'TEACHER'] },\n  { key: 'grades', label: 'Grades', href: (id) => `/courses/${id}/grades`, roles: ['STUDENT', 'PARENT'] },\n];","is_error":false}]},"parent_tool_use_id":null,"session_id":"612c4910-0bea-4d59-adbf-fcf9d39f8b8d","uuid":"d106ec3e-5fe6-4977-9945-6ba16b075769","timestamp":"2026-11-09T16:29:08.639Z","tool_use_result":{"stdout":"import type { FileObject } from '@prisma/client';\nimport { registerBuiltInContexts } from './contexts';\n\n/**\n * File access registry (PRD-08 FR-9, NFR-1). Every download goes through\n * canAccessFile. Later PRDs call registerFileAccess for their own contexts.\n */\n\nexport interface FileAccessUser {\n  id: string;\n  role: string;\n}\n\nexport type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\n\n/** Resolvers receive null for an