{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gz78eJUqCzV371JShojXK3","type":"tool_result","content":"/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'system.test': {\n    label: 'Test notification',\n    description: 'Test messages sent by an administrator.',\n    category: 'SYSTEM',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  // PRD-07 attendance (FR-20, FR-23).\n  'attendance.absent': {\n    label: 'Marked absent',\n    description: 'A student was marked absent from a class or the daily register.',\n    category: 'ATTENDANCE',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.late': {\n    label: 'Marked late',\n    description: 'A student was marked late.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.corrected': {\n    label: 'Attendance corrected',\n    description: 'An absence was corrected to present.',\n    category: 'ATTENDANCE',\nsrc/server/notifications/notify.ts:8:export interface NotifyInput {\nsrc/server/notifications/notify.ts:28:export async function notify(input: NotifyInput): Promise<void> {\nsrc/server/notifications/notify.ts:87:export function expandStudentRecipients(\nsrc/server/notifications/notify.ts:98:export async function notifyStudentAndParents(\nsrc/server/audit.ts:6:export interface AuditInput {\nsrc/server/audit.ts:26:export async function audit(input: AuditInput): Promise<void> {\nsrc/server/csv.ts:9:export function escapeCsvCell(value: unknown): string {\nsrc/server/csv.ts:29:export function toCsv<T extends object>(columns: { key: string; header: string }[], rows: T[]): string {\nsrc/server/http.ts:12:export type ApiErrorCode =\nsrc/server/http.ts:34:export class AppError extends Error {\nsrc/server/http.ts:45:export function ok<T>(data: T, init?: ResponseInit) {\nsrc/server/http.ts:49:export function paginated<T>(\nsrc/server/http.ts:57:export function apiError(code: ApiErrorCode, message: string, details?: unknown) {\nsrc/server/http.ts:71:export function withHandler<Args extends unknown[]>(\nsrc/server/http.ts:104:export interface PaginationParams {\nsrc/server/http.ts:113:export function parsePagination(searchParams: URLSearchParams): PaginationParams {\nsrc/server/http.ts:125:export async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\nsrc/server/http.ts:131:export function getClientIp(request: Request): string | null {\nsrc/server/http.ts:135:export function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S): output<S> {\nsrc/server/rate-limit.ts:5:export function rateLimit(\nsrc/server/rate-limit.ts:21:export function __resetRateLimits(): void {\nsrc/server/quiz/maintenance.ts:15:export async function autoSubmitExpiredAttempts(now = new Date()): Promise<number> {\nsrc/server/quiz/maintenance.ts:28:export async function sendAfterCloseResultsReleased(now = new Date()): Promise<number> {\nsrc/server/email/render.ts:11:export const TEMPLATES = {\nsrc/server/email/render.ts:17:export type TemplateName = keyof typeof TEMPLATES;\nsrc/server/email/render.ts:19:export type TemplateData = {\nsrc/server/email/render.ts:29:export async function getEmailSchool(): Promise<EmailSchool> {\nsrc/server/email/render.ts:38:export async function renderEmail<T extends TemplateName>(\nroute.ts\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\nimport { sendDueReminders } from '@/server/assignments/reminders';\nimport { autoSubmitExpiredAttempts, sendAfterCloseResultsReleased } from '@/server/quiz/maintenance';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n  try {\n    const reminders = await sendDueReminders(new Date());\n    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n  } catch (error) {\n    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  // PRD-10 FR-18/FR-30/FR-35: every request, each isolated; both idempotent.\n  try {\n    const submitted = await autoSubmitExpiredAttempts(new Date());\n    if (submitted) logger.info('Expired quiz attempts auto-submitted', { submitted });\n  } catch (error) {\n    logger.error('Quiz auto-submit failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n  try {\n    const released = await sendAfterCloseResultsReleased(new Date());\n    if (released) logger.info('Quiz results released after close', { released });\n  } catch (error) {\n    logger.error('Quiz results release failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\nsrc/app:\n(app)\n(auth)\n(public)\napi\nerror.tsx\nforbidden\nglobal-error.tsx\nlayout.tsx\nnot-found.tsx\nproviders.tsx\n\nsrc/app/api:\nacademic-years\naccount\nadmin\nassignments\nattempts\nattendance\naudit-logs\nauth\ncourses\nenrollments\nfiles\ngrade-items\ngrade-levels\ngrading-scales\nhealth\ninternal\nme\nnotifications\nperiods\nquestions\nquizzes\nreport-cards\nrooms\nschool-days\nsections\nsettings\nstudents\nsubjects\nsubmissions\nterms\ntimetable\nusers","is_error":false}]},"parent_tool_use_id":null,"session_id":"612c4910-0bea-4d59-adbf-fcf9d39f8b8d","uuid":"67768de1-fc59-453f-97f5-25be286da705","timestamp":"2026-11-09T16:29:10.287Z","tool_use_result":{"stdout":"/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.i