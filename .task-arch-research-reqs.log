alNotes is visible to ADMIN/TEACHER\n/// only -- enforced in the service layer (src/server/services/users.ts,\n/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\nmodel StudentProfile {\n  userId           String     @id\n  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  admissionNumber  String     @unique\n  dateOfBirth      DateTime   @db.Date\n  gender           Gender     @default(UNDISCLOSED)\n  gradeLevelId     String\n  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])\n  enrollmentDate   DateTime   @db.Date\n  addressLine1     String?\n  city             String?\n  medicalNotes     String?\n  emergencyContact String?\n  emergencyPhone   String?\n}\n\n/// Teacher-specific fields (FR-1).\nmodel TeacherProfile {\n  userId         String    @id\n  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  employeeNumber String    @unique\n  title          String?\n  qualifications String?\n  hireDate       DateTime? @db.Date\n}\n\n/// Parent-specific fields (FR-1).\nmodel ParentProfile {\n  userId     String  @id\n  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  occupation String?\n  address    String?\n}\n\n/// Parent<->student link (FR-15/FR-16). isPrimary is the primary contact for\n/// emails; src/server/services/userLinks.ts is the only writer, enforcing\n/// \"max 4 parents per student\" and \"exactly one isPrimary per student\" as\n/// transaction invariants rather than DB constraints.\nmodel ParentStudentLink {\n  id           String               @id @default(cuid())\n  parentId     String\n  parent       User                 @relation(\"ParentLinks\", fields: [parentId], references: [id], onDelete: Cascade)\n  studentId    String\n  student      User                 @relation(\"StudentLinks\", fields: [studentId], references: [id], onDelete: Cascade)\n  relationship GuardianRelationship\n  isPrimary    Boolean              @default(false)\n  createdAt    DateTime             @default(now())\n\n  @@unique([parentId, studentId])\n  @@index([studentId])\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\nmodel AcademicYear {\n  id             String          @id @default(cuid())\n  name           String          @unique\n  startDate      DateTime        @db.Date\n  endDate        DateTime        @db.Date\n  isCurrent      Boolean         @default(false)\n  createdAt      DateTime        @default(now())\n  updatedAt      DateTime        @updatedAt\n  terms          Term[]\n  sections       Section[]\n  courses        Course[]\n  timetableSlots TimetableSlot[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n/// later PRDs register new keys without a migration. category is resolved\n/// from the registry at read time (src/server/notifications/list.ts), not\n/// stored here. The composite index backs both getUnreadCount() (NFR-3,\n/// <50ms) and listNotifications()'s own-rows-newest-first query.\nmodel Notification {\n  id        String    @id @default(cuid())\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String\n  title     String\n  body      String?\n  link      String?\n  readAt    DateTime?\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n\n  @@index([userId, readAt, createdAt])\n}\n\n/// Per-user, per-type override of the registry's defaultEmail/mandatoryInApp\n/// defaults (PRD-04 FR-3). Composite PK instead of a surrogate id/unique\nenum EnrollmentStatus {\n  ACTIVE\n  DROPPED\n}\n\n/// Homeroom group, e.g. \"7A\". capacity is 1-60 (validated in zod).\nmodel Section {\n  id                 String              @id @default(cuid())\n  academicYearId     String\n  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n  gradeLevelId       String\n  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id])\n  name               String\n  homeroomTeacherId  String?\n  homeroomTeacher    User?               @relation(\"HomeroomTeacher\", fields: [homeroomTeacherId], references: [id])\n  roomId             String?\n  room               Room?               @relation(fields: [roomId], references: [id])\n  capacity           Int                 @default(30)\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  members            SectionMember[]\n  courses            Course[]\n  attendanceSessions AttendanceSession[]\n\n  @@unique([academicYearId, name])\n}\n\n/// academicYearId is denormalised so the DB enforces one section per\n/// student per year (NFR-2).\nmodel SectionMember {\n  id             String   @id @default(cuid())\n  sectionId      String\n  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n  studentId      String\n  student        User     @relation(fields: [studentId], references: [id])\n  joinedAt       DateTime @default(now())\n  academicYearId String\n\n  @@unique([studentId, academicYearId])\n}\n\n/// sectionId is null for cross-section electives. coTeacherIds is a plain\n/// String[] exactly per FR-1 (queried with `has`), max 3 enforced in zod.\nmodel Course {\n  id                 String              @id @default(cuid())\n  academicYearId     String\n  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n  subjectId          String\n  subject            Subject             @relation(fields: [subjectId], references: [id])\n  sectionId          String?\n  section            Section?            @relation(fields: [sectionId], references: [id])\n  teacherId          String\n  teacher            User                @relation(\"CourseTeacher\", fields: [teacherId], references: [id])\n  coTeacherIds       String[]            @default([])\n  name               String\n  code               String\n  kind               CourseKind          @default(CORE)\n  description        String?\n  capacity           Int?\n  archivedAt         DateTime?\n  /// PRD-11 FR-2: null = school default scale.\n  gradingScaleId     String?\n  gradingScale       GradingScale?       @relation(fields: [gradingScaleId], references: [id], onDelete: SetNull)\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  enrollments        Enrollment[]\n  timetableSlots     TimetableSlot[]\n  attendanceSessions AttendanceSession[]\n  modules            Module[]\n  assignments        Assignment[]\n  quizzes            Quiz[]\n  gradeCategories    GradeCategory[]\n  gradeItems         GradeItem[]\n\n  @@unique([academicYearId, code])\n}\n\n/// DROPPED rows are kept (never deleted) so later PRDs' attendance/grades\n/// history stays attached (FR-12).\nmodel Enrollment {\n  id         String           @id @default(cuid())\n  courseId   String\n  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  studentId  String\n  student    User             @relation(fields: [studentId], references: [id])\n  status     EnrollmentStatus @default(ACTIVE)\n  enrolledAt DateTime         @default(now())\n  droppedAt  DateTime?\n\n  @@unique([courseId, studentId])\n  @@index([studentId, status])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-06 Bell Schedule & Timetable (FR-1..FR-4). One repeating week (NFR-15).\n// Clash rules live in src/server/timetable/, not in the DB.\n// ---------------------------------------------------------------------------\n\nenum PeriodKind {\n  CLASS\nmodel FileObject {\n  id                    String                 @id @default(cuid())\n  ownerId               String\n  owner                 User                   @relation(fields: [ownerId], references: [id])\n  originalName          String\n  mimeType              String\n  sizeBytes             Int\n  storageKey            String                 @unique\n  sha256                String\n  context               String\n  contextId             String?\n  createdAt             DateTime               @default(now())\n  lessonAttachments     LessonAttachment[]\n  assignmentAttachments AssignmentAttachment[]\n  submissionFiles       SubmissionFile[]\n\n  @@index([context, contextId])\n}\n\nenum ContentStatus {\n  DRAFT\n  SCHEDULED\n  PUBLISHED","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01F88QX2xoKCg624xnp1iapj","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
