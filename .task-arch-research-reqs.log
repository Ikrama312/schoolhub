\n    { \"id\": \"NFR-6\", \"description\": \"Test coverage: Vitest unit tests for the password policy, token hashing/expiry, lockout counter, rate limiter and callbackUrl same-origin check; Vitest integration tests against a test database for authorize branches, accept-invite, reset-password and change-password; Playwright e2e for sign-in/out, failed-login messaging and forgot-to-reset flow.\", \"confidence\": \"HIGH\", \"source\": \"Test Requirements\" },\n    { \"id\": \"NFR-7\", \"description\": \"Brownfield discipline: reuse existing PRD-00 models/services/components/helpers; never re-scaffold the project, duplicate an existing helper, or rename an existing route or model.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context, paragraph 1\" },\n    { \"id\": \"NFR-8\", \"description\": \"Delivery discipline: keep npm run lint/typecheck/test passing, add only the tests listed in this PRD, do not expand scope beyond this PRD's sections, and do not modify behaviour owned by later PRDs.\", \"confidence\": \"HIGH\", \"source\": \"Assumptions and constraints, Constraints\" }\n  ],\n\n  \"overallConfidencePct\": 98,\n  \"clarificationLog\": [],\n  \"status\": \"complete\"\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
