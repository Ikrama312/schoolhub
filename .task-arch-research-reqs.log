stName, firstName, email])\n139:  relationship GuardianRelationship\n144:  @@index([studentId])\n161:  @@index([userId, type])\n175:  ip         String?\n178:  @@index([actorId])\n179:  @@index([action])\n180:  @@index([entityType, entityId])\n181:  @@index([actorId, createdAt])\nsrc/server/auth/requireRole.ts:14:export interface SessionUser {\nsrc/server/auth/requireRole.ts:22:export const getCurrentUser = cache(async (): Promise<SessionUser | null> => {\nsrc/server/auth/requireRole.ts:37:export async function requireRole(...roles: Role[]): Promise<SessionUser> {\nsrc/server/auth/requireRole.ts:45:export async function requireUser(): Promise<SessionUser> {\nsrc/server/auth/requireRole.ts:49:export async function requirePageRole(...roles: Role[]): Promise<SessionUser> {\nsrc/server/auth/requireRole.ts:57:export async function requirePageUser(): Promise<SessionUser> {\nsrc/lib/validators/auth.ts:10:export const emailField = z.string().trim().toLowerCase().email('Enter a valid email address');\nsrc/lib/validators/auth.ts:12:export interface PasswordCheckResult {\nsrc/lib/validators/auth.ts:19:export const PASSWORD_RULES: Record<keyof PasswordCheckResult, { label: string; error: string }> = {\nsrc/lib/validators/auth.ts:26:export function passwordChecks(password: string, email: string): PasswordCheckResult {\nsrc/lib/validators/auth.ts:36:export function passwordErrors(password: string, email: string): string[] {\nsrc/lib/validators/auth.ts:44:export function safeCallbackUrl(url: string | null | undefined): string {\nsrc/lib/validators/auth.ts:49:export const signInSchema = z.object({\nsrc/lib/validators/auth.ts:54:export const forgotPasswordSchema = z.object({ email: emailField });\nsrc/lib/validators/auth.ts:72:export function setPasswordSchema(email = '') {\nsrc/lib/validators/auth.ts:76:export const acceptInviteSchema = z\nsrc/lib/validators/auth.ts:80:export const resetPasswordSchema = acceptInviteSchema;\nsrc/lib/validators/auth.ts:82:export function changePasswo