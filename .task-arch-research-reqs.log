{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MgjFFxEtiXXK4w3YFZwmv6","type":"tool_result","content":"// ---------------------------------------------------------------------------\n// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n// ---------------------------------------------------------------------------\n\nexport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\nexport interface ScheduleEntry {\n  period: ExpandedSlot['period'];\n  course: ExpandedSlot['course'];\n  room: ExpandedSlot['room'];\n}\n\n/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\nexport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n  let slotTarget: SlotTarget | null;\n  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n\n  const { isoDay } = schoolNow(date, await schoolTimezone());\n  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n\n  const academicYearId = await currentYearId();\n  if (!academicYearId) return [];\n  const slots = await prisma.timetableSlot.findMany({\n    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n    include: slotInclude,\n    orderBy: { period: { order: 'asc' } },\n  });\n  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n}\n\n/**\n * PRD-07 FR-30/31: every class meeting school-wide on `date` (school timezone),\n * ordered by period. Same rules as getScheduleForDate, no target filter.\n */\nexport async function getSchoolScheduleForDate(date: Date): Promise<ScheduleEntry[]> {\n  const { isoDay } = schoolNow(date, await schoolTimezone());\n  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n\n  const academicYearId = await currentYearId();\n  if (!academicYearId) return [];\n  const slots = await prisma.timetableSlot.findMany({\n    where: { academicYearId, dayOfWeek: isoDay },\n    include: slotInclude,\n    orderBy: { period: { order: 'asc' } },\n  });\n  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n}\n\n/** The entry running at `now` in the school timezone, else null. */\nexport async function getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null> {\n  const [schedule, tz] = await Promise.all([getScheduleForDate(user, now), schoolTimezone()]);\n  const { hhmm } = schoolNow(now, tz);\n  return schedule.find((s) => s.period.startTime <= hhmm && hhmm < s.period.endTime) ?? null;\n}\n\nfunction stripUndefined<T extends object>(obj: T) {\n  return Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== undefined)) as Partial<T>;\n}\nsrc/server/attendance/attendance-service.ts:9:import { getScheduleForDate, getSchoolScheduleForDate } from '@/server/timetable/timetable-service';\nsrc/server/attendance/attendance-service.ts:130:  const schedule = await getScheduleForDate({ userId: user.id, role: user.role }, day === today ? now : middayOf(day));\nsrc/server/attendance/attendance-service.ts:472:    getSchoolScheduleForDate(date === today ? now : middayOf(date)),\n// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\nconst hits = new Map<string, number[]>();\n\n/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\nexport function rateLimit(\n  key: string,\n  limit: number,\n  windowMs: number,\n  now: number = Date.now(),\n): { ok: boolean; retryAfterMs: number } {\n  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n  if (recent.length >= limit) {\n    hits.set(key, recent);\n    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n  }\n  recent.push(now);\n  hits.set(key, recent);\n  return { ok: true, retryAfterMs: 0 };\n}\n\nexport function __resetRateLimits(): void {\n  hits.clear();\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { BODY_MAX, isSafeRelativeLink, TITLE_MAX } from '@/lib/validators/notifications';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\nimport { resolvePrefs } from './preferences';\nimport { NOTIFICATION_TYPES, type NotificationType } from './types';\n\nexport interface NotifyInput {\n  type: NotificationType;\n  userIds: string[];\n  title: string;\n  body?: string;\n  link?: string;\n  email?: { subject?: string; template: 'generic-notification'; data?: Record<string, unknown> };\n  /** PRD-13 FR-20: false skips the in-app row (email-only send of a deferred message email). Default true. */\n  inApp?: boolean;\n}\n\nfunction truncate(value: string, max: number, field: string, type: string): string {\n  if (value.length <= max) return value;\n  logger.warn('Notification field truncated', { field, type, length: value.length, max });\n  return value.slice(0, max);\n}\n\n/**\n * Single producer entry point (FR-6..11). Writes in-app rows and enqueues\n * emails per resolved preferences. NEVER throws — failures are logged.\n * Call after your transaction commits.\n */\nexport async function notify(input: NotifyInput): Promise<void> {\n  try {\n    const def = NOTIFICATION_TYPES[input.type];\n    const userIds = [...new Set(input.userIds)];\n    if (!def || userIds.length === 0) return;\n\n    const title = truncate(input.title, TITLE_MAX, 'title', input.type);\n    const body = input.body == null ? null : truncate(input.body, BODY_MAX, 'body', input.type);\n    let link: string | null = input.link ?? null;\n    if (link !== null && !isSafeRelativeLink(link)) {\n      logger.warn('Notification link dropped (not a safe relative path)', { type: input.type });\n  }\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"7b9140b8-a7ae-4ca4-9024-504a0df7df9f","uuid":"c1b9a800-ea2d-4778-8666-5e2065d71b5b","timestamp":"2026-11-09T18:48:16.101Z","tool_use_result":{"stdout":"// ---------------------------------------------------------------------------\n// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n// ---------------------------------------------------------------------------\n\nexport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\nexport interface ScheduleEnt