ces: [id])\n  name               String\n  homeroomTeacherId  String?\n  homeroomTeacher    User?               @relation(\"HomeroomTeacher\", fields: [homeroomTeacherId], references: [id])\n  roomId             String?\n  room               Room?               @relation(fields: [roomId], references: [id])\n  capacity           Int                 @default(30)\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  members            SectionMember[]\n  courses            Course[]\n  attendanceSessions AttendanceSession[]\n\n  @@unique([academicYearId, name])\n}\n\n/// academicYearId is denormalised so the DB enforces one section per\n/// student per year (NFR-2).\nmodel SectionMember {\n  id             String   @id @default(cuid())\n  sectionId      String\n  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n  studentId      String\n  student        User     @relation(fields: [studentId], references: [id])\n  joinedAt       DateTime @default(now())\n  academicYearId String\n\n  @@unique([studentId, academicYearId])\n}\n\n/// sectionId is null for cross-section electives. coTeacherIds is a plain\n/// String[] exactly per FR-1 (queried with `has`), max 3 enforced in zod.\nmodel Course {\n  id                 String              @id @default(cuid())\n  academicYearId     String\n  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n  subjectId          String\n  subject            Subject             @relation(fields: [subjectId], references: [id])\n  sectionId          String?\n  section            Section?            @relation(fields: [sectionId], references: [id])\n  teacherId          String\n  teacher            User                @relation(\"CourseTeacher\", fields: [teacherId], references: [id])\n  coTeacherIds       String[]            @default([])\n  name               String\n  code               String\n  kind               CourseKind          @default(CORE)\n  description        String?\n  capacity           Int?\n  archivedAt         DateTime?\n  /// PRD-11 FR-2: null = school default scale.\n  gradingScaleId     String?\n  gradingScale       GradingScale?       @relation(fields: [gradingScaleId], references: [id], onDelete: SetNull)\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  enrollments        Enrollment[]\n  timetableSlots     TimetableSlot[]\n  attendanceSessions AttendanceSession[]\n  modules            Module[]\n  assignments        Assignment[]\n  quizzes            Quiz[]\n  gradeCategories    GradeCategory[]\n  gradeItems         GradeItem[]\n\n  @@unique([academicYearId, code])\n}\n\n/// DROPPED rows are kept (never deleted) so later PRDs' attendance/grades\n/// history stays attached (FR-12).\nmodel Enrollment {\n  id         String           @id @default(cuid())\n  courseId   String\n  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  studentId  String\n  student    User             @relation(fields: [studentId], references: [id])\n  status     EnrollmentStatus @default(ACTIVE)\n  enrolledAt DateTime         @default(now())\n  droppedAt  DateTime?\n\n  @@unique([courseId, studentId])\n  @@index([studentId, status])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-06 Bell Schedule & Timetable (FR-1..FR-4). One repeating week (NFR-15).\n// Clash rules live in src/server/timetable/, not in the DB.\n// ---------------------------------------------------------------------------\n\nenum PeriodKind {\n  CLASS\n  BREAK\n  LUNCH\n  ASSEMBLY\n}\n\n/// startTime/endTime are 'HH:MM' in SchoolSettings.timezone. order is display order only.\nmodel Period {\n  id                 String              @id @default(cuid())\n  name               String\n  startTime          String\n  endTime            String\n  kind               PeriodKind          @default(CLASS)\n  order              Int                 @unique\n  slots              TimetableSlot[]\n  attendanceSessions AttendanceSession[]\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n}\n\n/// ISO weekday 1=Mon … 7=Sun; seeded with all 7 rows.\nmodel SchoolDay {\n  dayOfWeek  Int     @id\n  isTeaching Boolean @default(true)\n}\n\n/// period is Restrict: deletePeriod refuses with 409 while slots exist (FR-8).\nmodel TimetableSlot {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])\n  courseId       String\n  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  dayOfWeek      Int\n  periodId       String\n  period         Period       @relation(fields: [periodId], references: [id])\n  roomId         String?\n  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([courseId, dayOfWeek, periodId])\n  @@index([academicYearId, dayOfWeek, periodId])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-07 Attendance (FR-1..FR-4). Exactly-one-of(courseId, sectionId) and the\n// two partial unique indexes live in the migration SQL (ADR-2) -- Prisma\n// can't express them.\n// ---------------------------------------------------------------------------\n\nenum AttendanceStatus {\nmodel Assignment {\n  id                       String                 @id @default(cuid())\n  courseId                 String\n  course                   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  title                    String\n  instructions             String                 @default(\"\") @db.Text\n  submissionType           SubmissionType\n  maxPoints                Decimal                @db.Decimal(6, 2)\n  dueAt                    DateTime\n  availableFrom            DateTime?\n  allowLate                Boolean                @default(false)\n  lateCutoffAt             DateTime?\n  latePenaltyPercentPerDay Decimal                @default(0) @db.Decimal(5, 2)\n  maxLatePenaltyPercent    Decimal                @default(0) @db.Decimal(5, 2)\n  maxFileCount             Int                    @default(3)\n  allowExtraCredit         Boolean                @default(false)\n  status                   AssignmentStatus       @default(DRAFT)\n  rubricId                 String?                @unique\n  rubric                   Rubric?                @relation(fields: [rubricId], references: [id], onDelete: SetNull)\n  notifiedAt               DateTime?\n  archivedAt               DateTime?\n  /// PRD-11 FR-2\n  categoryId               String?\n  category                 GradeCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)\n  createdById              String\n  createdAt                DateTime               @default(now())\n  updatedAt                DateTime               @updatedAt\n  attachments              AssignmentAttachment[]\n  submissions              Submission[]\n  exemptions               GradeExemption[]\n  reminders                AssignmentReminder[]\n\n  @@index([courseId, dueAt])\n}\n\n/// file has no onDelete -> Restrict: an attached file can't be hard-deleted.\nmodel Quiz {\n  id                 String              @id @default(cuid())\n  courseId           String\n  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  title              String\n  instructions       String              @default(\"\") // Markdown\n  isPractice         Boolean             @default(false) // practice quizzes never reach the gradebook\n  availableFrom      DateTime\n  availableUntil     DateTime // > availableFrom\n  timeLimitMinutes   Int? // 1–300, null = untimed\n  maxAttempts        Int                 @default(1) // 1–10\n  scoringPolicy      ScoringPolicy       @default(HIGHEST)\n  shuffleQuestions   Boolean             @default(false)\n  shuffleOptions     Boolean             @default(false)\n  oneQuestionPerPage Boolean             @default(false)\n  resultsVisibility  ResultsVisibility   @default(AFTER_CLOSE)\n  showCorrectAnswers Boolean             @default(true) // when results are visible\n  resultsReleasedAt  DateTime? // MANUAL release; also the AFTER_CLOSE \"notified once\" claim (A6)\n  status             QuizStatus          @default(DRAFT)\n  /// PRD-11 FR-2\n  categoryId         String?\n  category           GradeCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)\n  createdById        String\n  createdBy          User                @relation(\"QuizCreatedBy\", fields: [createdById], references: [id])\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  questions          Question[]\n  attempts           QuizAttempt[]\n  accommodations     QuizAccommodation[]\n\n  @@index([courseId, status])\n}\n\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n  @@index([entityType, entityId])\n  @@index([actorId, createdAt])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JSSKmzzLVHkChPjbbjmhAh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
