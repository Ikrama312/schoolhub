 AccessUser, submissionId: string, input: GradeInput, request?: Request) {\n731:export async function bulkReturn(user: AccessUser, assignmentId: string, submissionIds: string[] | undefined, request?: Request) {\n765:export async function gradeOffline(user: AccessUser, assignmentId: string, input: OfflineGradeInput, request?: Request) {\n804:export async function setExemption(\n839:export async function listCourseAssignments(user: AccessUser, courseId: string, studentId?: string) {\n893:export async function getAssignment(user: AccessUser, id: string, studentId?: string) {\n920:export type RosterRow = {\n938:export async function listGradingRoster(\n990:export async function getSubmission(user: AccessUser, submissionId: string) {\n1052:export async function listMyAssignments(user: AccessUser, query: { studentId?: string; tab?: Exclude<Group, 'CLOSED'>; courseId?: string }) {\n1105:export async function listStudentAssignments(user: AccessUser, studentId: string, courseId?: string) {\n37:  // FR-41: SVG is text (no signature) and only allowed for the logo context.\n67:export function checkType(ext: string, sniffed: string | undefined, context: string, head?: Buffer): TypeCheck {\n71:  if (context === 'logo' ? !LOGO_EXTS.includes(ext) : ext === 'svg') return error;\n85:/** Per-context byte limit: 2 MB for logos, MAX_UPLOAD_MB otherwise. */\n86:export function maxBytesFor(context: string, maxUploadMb: number): number {\n87:  return (context === 'logo' ? 2 : maxUploadMb) * 1024 * 1024;\nprisma/migrations/20261107000000_attendance/migration.sql:77:CREATE UNIQUE INDEX \"attendance_session_course_uq\" ON \"AttendanceSession\"(\"courseId\", \"date\", \"periodId\") WHERE \"courseId\" IS NOT NULL;\nprisma/migrations/20261107000000_attendance/migration.sql:78:CREATE UNIQUE INDEX \"attendance_session_section_uq\" ON \"AttendanceSession\"(\"sectionId\", \"date\") WHERE \"sectionId\" IS NOT NULL;\n11:  coTeacherIds       String[]            @default([])\n20:  enrollments        Enr