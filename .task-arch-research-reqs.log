{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01USYvw65XJWf86QJn54hBV2","type":"tool_result","content":"// ---------------------------------------------------------------------------\n// PRD-11 export (FR-22, FR-33) — no endpoint by design\n// ---------------------------------------------------------------------------\n\nexport async function getStudentQuizScore(quizId: string, studentId: string) {\n  const quiz = await prisma.quiz.findUnique({\n    where: { id: quizId },\n    select: {\n      isPractice: true,\n      scoringPolicy: true,\n      attempts: { where: { studentId, status: 'GRADED' }, select: { score: true, maxScore: true, submittedAt: true } },\n    },\n  });\n  if (!quiz) return null;\n  const graded = quiz.attempts.filter((a) => a.score !== null && a.submittedAt !== null).map((a) => ({ score: a.score!, maxScore: a.maxScore, submittedAt: a.submittedAt! }));\n  const result = applyScoringPolicy(quiz.scoringPolicy, graded);\n  return result ? { ...result, isPractice: quiz.isPractice } : null;\n}\n\n---ret\n7:export async function gradeSubmission(user: AccessUser, submissionId: string, input: GradeInput, request?: Request) {\n18:  const returning = input.return && sub.status !== 'RETURNED';\n30:      ...(returning ? { status: 'RETURNED' as const, returnedAt: now } : {}),\n33:  await audit({ actorId: user.id, action: 'submission.grade', entityType: 'Submission', entityId: submissionId, metadata: { assignmentId: a.id, studentId: sub.studentId, finalScore }, request });\n34:  if (returning) {\n35:    await audit({ actorId: user.id, action: 'submission.return', entityType: 'Submission', entityId: submissionId, metadata: { assignmentId: a.id, studentId: sub.studentId }, request });\n36:    await notifyReturned(a, sub.studentId, finalScore);\n42:export async function bulkReturn(user: AccessUser, assignmentId: string, submissionIds: string[] | undefined, request?: Request) {\n47:  const skipped: { submissionId: string; reason: 'NOT_GRADED' | 'ALREADY_RETURNED' | 'NOT_FOUND' }[] = [];\n56:      else if (s.status === 'RETURNED') skipped.push({ submissionId: id, reason: 'ALREADY_RETURNED' });\n65:      data: { status: 'RETURNED', returnedAt: now },\n69:    await audit({ actorId: user.id, action: 'submission.return', entityType: 'Submission', entityId: s.id, metadata: { assignmentId, studentId: s.studentId, bulk: true }, request });\n70:    await notifyReturned(a, s.studentId, s.finalScore);\n76:export async function gradeOffline(user: AccessUser, assignmentId: string, input: OfflineGradeInput, request?: Request) {\n93:      status: input.return ? 'RETURNED' : 'SUBMITTED',\n109:  await audit({ actorId: user.id, action: 'submission.grade_offline', entityType: 'Submission', entityId: sub.id, metadata: { assignmentId, studentId: input.studentId, finalScore }, request });\n110:  if (input.return) await notifyReturned(a, input.studentId, finalScore);\n115:export async function setExemption(\n119:  exempt: boolean,\n126:  if (exempt) {\n137:  await audit({ actorId: user.id, action: exempt ? 'assignment.exempt' : 'assignment.unexempt', entityType: 'Assignment', entityId: assignmentId, metadata: { studentId, reason }, request });\n138:  return exempt ? { assignmentId, studentId, exempt: true as const, reason: reason ?? null } : { assignmentId, studentId, exempt: false as const };\n---status\n2:67:type VisibilityFields = { status: AssignmentStatus; availableFrom: Date | null; archivedAt: Date | null };\n3:70:  return !a.archivedAt && isVisible({ status: a.status, publishAt: a.availableFrom }, now);\n4:74:  return { archivedAt: null, OR: [{ status: 'PUBLISHED' }, { status: 'SCHEDULED', availableFrom: { lte: now } }] };\n5:95:  sub: { status: string } | null,\n6:99:  if (sub?.status === 'RETURNED') return 'RETURNED';\n7:130:    status: a.status,\n8:131:    archivedAt: iso(a.archivedAt),\n9:177:    status: s.status,\n10:201:  if (s.status === 'RETURNED') return rest as SubmissionDto;\n11:214:type SummarySub = { 