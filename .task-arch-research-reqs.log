{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uog77Hex3FbjGe58kJft3C","type":"tool_result","content":"// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\nconst hits = new Map<string, number[]>();\n\n/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\nexport function rateLimit(\n  key: string,\n  limit: number,\n  windowMs: number,\n  now: number = Date.now(),\n): { ok: boolean; retryAfterMs: number } {\n  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n  if (recent.length >= limit) {\n    hits.set(key, recent);\n    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n  }\n  recent.push(now);\n  hits.set(key, recent);\n  return { ok: true, retryAfterMs: 0 };\n}\n\nexport function __resetRateLimits(): void {\n  hits.clear();\n}\n----\n/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'system.test': {\n    label: 'Test notification',\n    description: 'Test messages sent by an administrator.',\n    category: 'SYSTEM',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  // PRD-07 attendance (FR-20, FR-23).\n  'attendance.absent': {\n    label: 'Marked absent',\n    description: 'A student was marked absent from a class or the daily register.',\n    category: 'ATTENDANCE',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.late': {\n    label: 'Marked late',\n    description: 'A student was marked late.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.corrected': {\n    label: 'Attendance corrected',\n    description: 'An absence was corrected to present.',\n    category: 'ATTENDANCE',\n----\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { BODY_MAX, isSafeRelativeLink, TITLE_MAX } from '@/lib/validators/notifications';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\nimport { resolvePrefs } from './preferences';\nimport { NOTIFICATION_TYPES, type NotificationType } from './types';\n\nexport interface NotifyInput {\n  type: NotificationType;\n  userIds: string[];\n  title: string;\n  body?: string;\n  link?: string;\n  email?: { subject?: string; template: 'generic-notification'; data?: Record<string, unknown> };\n}\n\nfunction truncate(value: string, max: number, field: string, type: string): string {\n  if (value.length <= max) return value;\n  logger.warn('Notification field truncated', { field, type, length: value.length, max });\n  return value.slice(0, max);\n}\n\n/**\n * Single producer entry point (FR-6..11). Writes in-app rows and enqueues\n * emails per resolved preferences. NEVER throws — failures are logged.\n * Call after your transaction commits.\n */\nexport async function notify(input: NotifyInput): Promise<void> {\n  try {\n    const def = NOTIFICATION_TYPES[input.type];\n    const userIds = [...new Set(input.userIds)];\n    if (!def || userIds.length === 0) return;\n\n    const title = truncate(input.title, TITLE_MAX, 'title', input.type);\n    const body = input.body == null ? null : truncate(input.body, BODY_MAX, 'body', input.type);\n    let link: string | null = input.link ?? null;\n    if (link !== null && !isSafeRelativeLink(link)) {\n      logger.warn('Notification link dropped (not a safe relative path)', { type: input.type });\n      link = null;\n    }\n\n    const [users, prefRows] = await Promise.all([\n      prisma.user.findMany({\n        where: { id: { in: userIds }, status: { notIn: ['DISABLED', 'ARCHIVED'] }, archivedAt: null },\n        select: { id: true, email: true, firstName: true },\n      }),\n      prisma.notificationPreference.findMany({ where: { userId: { in: userIds }, type: input.type } }),\n    ]);\n    const prefByUser = new Map(prefRows.map((r) => [r.userId, r]));\n\n    const inAppIds: string[] = [];\n    const emailTo: { email: string; firstName: string }[] = [];\n    for (const user of users) {\n      const prefs = resolvePrefs(def, prefByUser.get(user.id));\n      if (prefs.inApp) inAppIds.push(user.id);\n      if (prefs.email && input.email && user.email) emailTo.push(user);\n    }\n\n    if (inAppIds.length) {\n      await prisma.notification.createMany({\n        data: inAppIds.map((userId) => ({ userId, type: input.type, title, body, link })),\n      });\n    }\n\n    if (emailTo.length && input.email) {\n      // Rendered once per call (ADR-6): generic emails carry no per-recipient greeting.\n      const school = await getEmailSchool();\n      const { html, text } = await renderEmail(\n        input.email.template,\n        { title, body, link, ...(input.email.data ?? {}) },\n        school,\n      );\n      const subject = input.email.subject ?? title;\n      await prisma.emailOutbox.createMany({\n        data: emailTo.map((u) => ({ toEmail: u.email, toName: u.firstName, subject, html, text })),\n      });\n    }\n  } catch (error) {\n    logger.error('notify() failed', {\n      type: input.type,","is_error":false}]},"parent_tool_use_id":null,"session_id":"56451f7d-c784-4a25-a233-3bc873207cca","uuid":"41a69c61-0122-4c06-8388-814621c606e3","timestamp":"2026-11-09T17:19:03.226Z","tool_use_result":{"stdout":"// ponytail: per-process limiter, swap the Map for Redis/Postgres if horizontally scaled\nconst hits = new Map<string, number[]>();\n\n/** Sliding-window limiter: allows `limit` calls per `windowMs` per key. */\nexport function rateLimit(\n  key: string,\n  limit: number,\n  windowMs: number,\n  now: number = Date.now(),\n): { ok: boolean; retryAfterMs: number } {\n  const recent = (hits.get(key) ?? []).filter((t) => t > now - windowMs);\n  if (recent.length >= limit) {\n    hits.set(key, recent);\n    return { ok: false, retryAfterMs: recent[0] + windowMs - now };\n  }\n  recent.push(now);\n  hits.set(key, recent);\n  return { ok: true, retryAfterMs: 0 };\n}\n\nexport function __resetRateLimits(): void {\n  hits.clear();\n}\n----\n/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT'