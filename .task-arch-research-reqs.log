{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D5TJGJeq7yYPH7LeoKbVKF","type":"tool_result","content":"import { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { deleteFile } from '@/server/storage';\n\nconst DAY_MS = 24 * 60 * 60_000;\nconst BATCH = 500;\n\n/**\n * FR-12: delete unattached files (contextId null) older than 24 h -- abandoned\n * uploads, detached attachments, removed inline images, replaced logos.\n * Bytes first, then rows. One batch per call; the daily run catches the rest.\n */\nexport async function purgeOrphanFiles(now: Date = new Date()): Promise<number> {\n  const orphans = await prisma.fileObject.findMany({\n    where: { contextId: null, createdAt: { lt: new Date(now.getTime() - DAY_MS) } },\n    select: { id: true, storageKey: true },\n    take: BATCH,\n  });\n  const deleted: string[] = [];\n  for (const file of orphans) {\n    try {\n      await deleteFile(file.storageKey);\n      deleted.push(file.id);\n    } catch (error) {\n      logger.error('Orphan file delete failed', { id: file.id, message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  // ponytail: a file attached in the ms between findMany and here keeps its row but loses its bytes;\n  // wrap in a row lock if attaching day-old uploads ever becomes common.\n  const { count } = await prisma.fileObject.deleteMany({ where: { id: { in: deleted }, contextId: null } });\n  logger.info('Purged orphan files', { count });\n  return count;\n}\nmodel Enrollment {\n  id         String           @id @default(cuid())\n  courseId   String\n  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  studentId  String\n  student    User             @relation(fields: [studentId], references: [id])\n  status     EnrollmentStatus @default(ACTIVE)\n  enrolledAt DateTime         @default(now())\n  droppedAt  DateTime?\n\n  @@unique([courseId, studentId])\n  @@index([studentId, status])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-06 Bell Schedule & Timetable (FR-1..FR-4). One repeating week (NFR-15).\n// Clash rules live in src/server/timetable/, not in the DB.\n// ---------------------------------------------------------------------------\n\nenum PeriodKind {\n  CLASS\n  BREAK\n  LUNCH\n  ASSEMBLY\n}\n\n/// startTime/endTime are 'HH:MM' in SchoolSettings.timezone. order is display order only.\nmodel Period {\n  id                 String              @id @default(cuid())\n  name               String\n  startTime          String\n  endTime            String\n  kind               PeriodKind          @default(CLASS)\n  order              Int                 @unique\n  slots              TimetableSlot[]\n  attendanceSessions AttendanceSession[]\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n}\n\n/// ISO weekday 1=Mon … 7=Sun; seeded with all 7 rows.\nmodel SchoolDay {\n  dayOfWeek  Int     @id\n  isTeaching Boolean @default(true)\n}\n\n/// period is Restrict: deletePeriod refuses with 409 while slots exist (FR-8).\nmodel TimetableSlot {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])\n  courseId       String\n  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  dayOfWeek      Int\n  periodId       String\n  period         Period       @relation(fields: [periodId], references: [id])\n  roomId         String?\n  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([courseId, dayOfWeek, periodId])\n  @@index([academicYearId, dayOfWeek, periodId])\n}\n\n// ---------------------------------------------------------------------------\n\n/// Generic uploaded file (FR-1). Bytes live under UPLOAD_DIR; access goes\n/// through src/server/files/access.ts. contextId null = unattached (purged after 24 h).\nmodel FileObject {\n  id                String             @id @default(cuid())\n  ownerId           String\n  owner             User               @relation(fields: [ownerId], references: [id])\n  originalName      String\n  mimeType          String\n  sizeBytes         Int\n  storageKey        String             @unique\n  sha256            String\n  context           String\n  contextId         String?\n  createdAt         DateTime           @default(now())\n  lessonAttachments LessonAttachment[]\n\n  @@index([context, contextId])\n}\n\nenum ContentStatus {\n  DRAFT\n  SCHEDULED\n  PUBLISHED\n}\n\nmodel Module {\n  id          String        @id @default(cuid())\n  courseId    String\n  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)\n10:export const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\n15:  ACADEMIC: 'Academic',\n33:export const NOTIFICATION_TYPES = {\n97:    category: 'ACADEMIC',\nsrc/server/notifications/notify.ts:8:export interface NotifyInput {\nsrc/server/notifications/notify.ts:28:export async function notify(input: NotifyInput): Promise<void> {\nsrc/server/notifications/notify.ts:87:export function expandStudentRecipients(\nsrc/server/notifications/notify.ts:98:export async function notifyStudentAndParents(\nsrc/server/audit.ts:6:export interface AuditInput {\nsrc/server/audit.ts:26:export async function audit(input: AuditInput): Promise<void> {\nsrc/server/auth/auth.config.ts:10:export const authConfig = {\nsrc/server/auth/auth.ts:9:export const { handlers, auth, signIn, signOut, unstable_update } = NextAuth({\nsrc/server/auth/course-access.ts:25:export async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\nsrc/server/auth/course-access.ts:56:export async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\nsrc/server/auth/credentials.ts:11:export class AuthError extends CredentialsSignin {\nsrc/server/auth/credentials.ts:18:export const MAX_FAILED_LOGINS = 5;\nsrc/server/auth/credentials.ts:19:export const LOCKOUT_MS = 15 * 60_000;\nsrc/server/auth/credentials.ts:27:export function computeLockout(count: number, now: Date): { failedLoginCount: number; lockedUntil: Date | null } {\nsrc/server/auth/credentials.ts:32:export interface AuthorizedUser {\nsrc/server/auth/credentials.ts:40:export async function authorizeCredentials(input: unknown, request: Request): Promise<AuthorizedUser> {\nsrc/server/auth/email.ts:8:export type AuthEmailKind = 'invite' | 'password-reset';\nsrc/server/auth/email.ts:16:export function authLink(kind: AuthEmailKind, rawToken: string): string {\nsrc/server/auth/email.ts:26:export async function sendAuthEmail(\nsrc/server/auth/password-policy.ts:18:export function assertPasswordAllowed(password: string, email: string): void {\nsrc/server/auth/requireRole.ts:14:export interface SessionUser {\nsrc/server/auth/requireRole.ts:22:export const getCurrentUser = cache(async (): Promise<SessionUser | null> => {\nsrc/server/auth/requireRole.ts:37:export async function requireRole(...roles: Role[]): Promise<SessionUser> {\nsrc/server/auth/requireRole.ts:45:export async function requireUser(): Promise<SessionUser> {\nsrc/server/auth/requireRole.ts:49:export async function requirePageRole(...roles: Role[]): Promise<SessionUser> {\nsrc/server/auth/requireRole.ts:57:export async function requirePageUser(): Promise<SessionUser> {\nsrc/server/auth/student-access.ts:5:export interface AccessUser {\nsrc/server/auth/student-access.ts:10:export type AccessibleStudentIds = 'ALL' | string[];\nsrc/server/auth/student-access.ts:20:export async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\nsrc/server/auth/student-access.ts:63:export async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {\nsrc/server/content:\nvisibility.ts\n\nsrc/server/courses:\ncourses-service.ts\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];","is_error":false}]},"parent_tool_use_id":null,"session_id":"91d7b1a5-c851-4385-b1f3-145425ca0827","uuid":"9481188f-f57b-40b4-b00f-56278ad30e9a","timestamp":"2026-11-09T05:24:00.210Z","tool_use_result":{"stdout":"import { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n}\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\nimport { deleteFile } from '@/server/storage';\n\nconst DAY_MS = 24 * 60 * 60_000;\nconst BATCH = 500;\n\n/**\n * FR-12: delete unattached files (contextId null) older than 24 h -- abandoned\n * uploads, detached attachments, removed inline images, replaced logos.\n * Bytes first, then rows. One batch per call; the daily run catches the rest.\n */\nexport async function purgeOrphanFiles(now: Date = new Date()): Promise<number> {\n  const orphans = await prisma.fileObject.findMany({\n    where: { contextId: null, createdAt: { lt: new Date(now.getTime() - DAY_MS) } },\n    select: { id: true, storageKey: true },\n    take: BATCH,\n  });\n  const deleted: string[] = [];\n  for (const file of orphans) {\n    try {\n      await deleteFile(file.storageKey);\n      deleted.push(file.id);\n    } catch (error) {\n      logger.error('Orphan file delete failed', { id: file.id, message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  // ponytail: a file attached in the ms between findMany and here keeps its row but loses its bytes;\n  // wrap in a row lock if attaching day-old uploads ever becomes common.\n  const { count } = await prisma.fileObject.deleteMany({ where: { id: { in: deleted }, contextId: null } });\n  logger.info('Purged orphan files', { count });\n  return count;\n}\nmodel Enrollment {\n  id         String           @id @default(cuid())\n  courseId   String\n  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  studentId  String\n  student    User             @relation(fields: [studentId], references: [id])\n  status     EnrollmentStatus @default(ACTIVE)\n  enrolledAt DateTime         @default(now())\n  droppedAt  DateTime?\n\n  @@unique([courseId, studentId])\n  @@index([studentId, status])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-06 Bell Schedule & Timetable (FR-1..FR-4). One repeating week (NFR-15).\n// Clash rules live in src/server/timetable/, not in the DB.\n// ---------------------------------------------------------------------------\n\nenum PeriodKind {\n  CLASS\n  BREAK\n  LUNCH\n  ASSEMBLY\n}\n\n/// startTime/endTime are 'HH:MM' in SchoolSettings.timezone. order is display order only.\nmodel Period {\n  id                 String              @id @default(cuid())\n  name               String\n  startTime          String\n  endTime            String\n  kind               PeriodKind          @default(CLASS)\n  order              Int                 @unique\n  slots              TimetableSlot[]\n  attendanceSessions AttendanceSession[]\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n}\n\n/// ISO weekday 1=Mon … 7=Sun; seeded with all 7 rows.\nmodel SchoolDay {\n  dayOfWeek  Int     @id\n  isTeaching Boolean @default(true)\n}\n\n/// period is Restrict: deletePeriod refuses with 409 while slots exist (FR-8).\nmodel TimetableSlot {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])\n  courseId       String\n  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  dayOfWeek      Int\n  periodId       String\n  period         Period       @relation(fields: [periodId], references: [id])\n  roomId         String?\n  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([courseId, dayOfWeek, periodId])\n  @@index([academicYearId, dayOfWeek, periodId])\n}\n\n// ---------------------------------------------------------------------------\n\n/// Generic uploaded file (FR-1). Bytes live under UPLOAD_DIR; access goes\n/// through src/server/files/access.ts. contextId null = unattached (purged after 24 h).\nmodel FileObject {\n  id                String             @id @default(cuid())\n  ownerId           String\n  owner             User               @relation(fields: [ownerId], references: [id])\n  originalName      String\n  mimeType          String\n  sizeBytes         Int\n  storageKey        String             @unique\n  sha256            String\n  context           String\n  contextId         String?\n  createdAt         DateTime           @default(now())\n  lessonAttachments LessonAttachment[]\n\n  @@index([context, contextId])\n}\n\nenum ContentStatus {\n  DRAFT\n  SCHEDULED\n  PUBLISHED\n}\n\nmodel Module {\n  id          String        @id @default(cuid())\n  courseId    String\n  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)\n10:export const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\n15:  ACADEMIC: 'Academic',\n33:export const NOTIFICATION_TYPES = {\n97:    category: 'ACADEMIC',\nsrc/server/notifications/notify.ts:8:export interface NotifyInput {\nsrc/server/notifications/notify.ts:28:export async function notify(input: NotifyInput): Promise<void> {\nsrc/server/notifications/notify.ts:87:export function expandStudentRecipients(\nsrc/server/notifications/notify.ts:98:export async function notifyStudentAndParents(\nsrc/server/audit.ts:6:export interface AuditInput {\nsrc/server/audit.ts:26:export async function audit(input: AuditInput): Promise<void> {\nsrc/server/auth/auth.config.ts:10:export const authConfig = {\nsrc/server/auth/auth.ts:9:export const { handlers, auth, signIn, signOut, unstable_update } = NextAuth({\nsrc/server/auth/course-access.ts:25:export async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\nsr