{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PboWCZ5jTt9FSyH2292HoC","type":"tool_result","content":"/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n34:  'account.invite': {\n43:  'account.password_reset': {\n52:  'system.test': {\n61:  'attendance.absent': {\n69:  'attendance.late': {\n77:  'attendance.corrected': {\n85:  'attendance.register_missing': {\n94:  'content.lesson_published': {\n103:  'assignment.published': {\n111:  'assignment.due_soon': {\n119:  'assignment.returned': {\n127:  'assignment.missing': {\n136:  'quiz.published': {\n144:  'quiz.results_released': {\n153:  'grade.posted': {\n161:  'report_card.published': {\n170:  'message.received': {\n178:  'message.reported': {\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\nimport { sendDueReminders } from '@/server/assignments/reminders';\nimport { autoSubmitExpiredAttempts, sendAfterCloseResultsReleased } from '@/server/quiz/maintenance';\nimport { processPendingMessageEmails } from '@/server/messaging/email';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n  try {\n    const reminders = await sendDueReminders(new Date());\n    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n  } catch (error) {\n    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  // PRD-10 FR-18/FR-30/FR-35: every request, each isolated; both idempotent.\n  try {\n    const submitted = await autoSubmitExpiredAttempts(new Date());\n    if (submitted) logger.info('Expired quiz attempts auto-submitted', { submitted });\n  } catch (error) {\n    logger.error('Quiz auto-submit failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n  try {\n    const released = await sendAfterCloseResultsReleased(new Date());\n    if (released) logger.info('Quiz results released after close', { released });\n  } catch (error) {\n    logger.error('Quiz results release failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  // PRD-13 FR-20: deferred message emails, isolated like the jobs above.\n  let messageEmails = { sent: 0, deferred: 0, dropped: 0 };\n  try {\n    messageEmails = await processPendingMessageEmails(new Date());\n    if (messageEmails.sent || messageEmails.deferred || messageEmails.dropped) logger.info('Message emails processed', messageEmails);\n  } catch (error) {\n    logger.error('Message emails failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok({ ...result, messageEmails });\n});\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\nimport AssignmentOutlinedIcon from '@mui/icons-material/AssignmentOutlined';\nimport GradingOutlinedIcon from '@mui/icons-material/GradingOutlined';\nimport WorkspacePremiumOutlinedIcon from '@mui/icons-material/WorkspacePremiumOutlined';\nimport StraightenOutlinedIcon from '@mui/icons-material/StraightenOutlined';\nimport ChatBubbleOutlineIcon from '@mui/icons-material/ChatBubbleOutlineOutlined';\nimport ShieldOutlinedIcon from '@mui/icons-material/ShieldOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n  /** PRD-13 FR-18: the shell renders a live badge for this key. */\n  badge?: 'messages';\n  /** PRD-13 FR-23: hidden unless the flag is set (the page still enforces access itself). */\n  requires?: 'safeguardingLead';\n}\n\nexport interface NavFlags {\n  safeguardingLead?: boolean;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'Messages', href: '/messages', icon: ChatBubbleOutlineIcon, roles: ALL_ROLES, badge: 'messages' },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Assignments', href: '/assignments', icon: AssignmentOutlinedIcon, roles: ['STUDENT', 'PARENT', 'TEACHER', 'ADMIN'] },\n  { label: 'Grades', href: '/grades', icon: GradingOutlinedIcon, roles: ['STUDENT', 'PARENT'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Report cards', href: '/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Grading scales', href: '/admin/grading-scales', icon: StraightenOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Report cards', href: '/admin/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Safeguarding', href: '/admin/safeguarding', icon: ShieldOutlinedIcon, roles: ['ADMIN'], requires: 'safeguardingLead', group: 'Administration' },\n];","is_error":false}]},"parent_tool_use_id":null,"session_id":"7b9140b8-a7ae-4ca4-9024-504a0df7df9f","uuid":"24bbf8ee-0d98-408c-87cd-8729ed3bd946","timestamp":"2026-11-09T18:48:17.310Z","tool_use_result":{"stdout":"/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n34:  'account.invite': {\n43:  'account.password_reset': {\n52:  'system.test': {\n61:  'attendance.absent': {\n69:  'attendance.late': {\n77:  'attendance.corrected': {\n85:  'attendance.register_missing': {\n94:  'content.lesson_published': {\n103:  'assignment.published': {\n111:  'assignment.due_soon': {\n119:  'assignment.returned': {\n127:  'assignment.missing': {\n136:  'quiz.published': {\n144:  'quiz.results_released': {\n153:  'grade.posted': {\n161:  'report_card.published': {\n170:  'message.received': {\n178:  'message.reported': {\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\nimport { sendDueReminders } from '@/server/assignments/reminders';\nimport { autoSubmitExpiredAttempts, sendAfterCloseResultsReleased } from '@/server/quiz/maintenance';\nimport { processPendingMessageEmails } from '@/server/messaging/email';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n  try {\n    const reminders = await sendDueReminders(new Date());\n    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n  } catch (error) {\n    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  // PRD-10 FR-18/FR-30/FR-35: every request, each isolated; both idempotent.\n  try {\n    const submitted = await autoSubmitExpiredAttempts(new Date());\n    if (submitted) logger.info('Expired quiz attempts auto-submitted', { submitted });\n  } catch (error) {\n    logger.error('Quiz auto-submit failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n  try {\n    const released = await sendAfterCloseResultsReleased(new Date());\n    if (released) logger.info('Quiz results released after close', { released });\n  } catch (error) {\n    logger.error('Quiz results release failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  // PRD-13 FR-20: deferred message emails, isolated like the jobs above.\n  let messageEmails = { sent: 0, deferred: 0, dropped: 0 };\n  try {\n    messageEmails = await processPendingMessageEmails(new Date());\n    if (messageEmails.sent || messageEmails.deferred || messageEmails.dropped) logger.info('Message emails processed', messageEmails);\n  } catch (error) {\n    logger.error('Message emails failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok({ ...result, messageEmails });\n});\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\nimport AssignmentOutlinedIcon from '@mui/icons-material/AssignmentOutlined';\nimport GradingOutlinedIcon from '@mui/icons-material/GradingOutlined';\nimport WorkspacePremiumOutlinedIcon from '@mui/icons-material/WorkspacePremiumOutlined';\nimport StraightenOutlinedIcon from '@mui/icons-material/StraightenOutlined';\nimport ChatBubbleOutlineIcon from '@mui/icons-material/ChatBubbleOutlineOutlined';\nimport ShieldOutlinedIcon from '@mui/icons-material/ShieldOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n  /** PRD-13 FR-18: the shell renders a live badge for this key. */\n  badge?: 'messages';\n  /** PRD-13 FR-23: hidden unless the flag is set (the page still enforces access itself). */\n  requires?: 'safeguardingLead';\n}\n\nexport interface NavFlags {\n  safeguardingLead?: boolean;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n  { label: 'Notifications', href: '/notifications', icon: NotificationsNoneIcon, roles: ALL_ROLES },\n  { label: 'Messages', href: '/messages', icon: ChatBubbleOutlineIcon, roles: ALL_ROLES, badge: 'messages' },\n  { label: 'My courses', href: '/my-courses', icon: MenuBookOutlinedIcon, roles: ['TEACHER', 'STUDENT', 'PARENT'] },\n  { label: 'Assignments', href: '/assignments', icon: AssignmentOutlinedIcon, roles: ['STUDENT', 'PARENT', 'TEACHER', 'ADMIN'] },\n  { label: 'Grades', href: '/grades', icon: GradingOutlinedIcon, roles: ['STUDENT', 'PARENT'] },\n  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Report cards', href: '/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['TEACHER'] },\n  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Email log', href: '/admin/email-log', icon: MarkEmailUnreadOutlinedIcon, roles: ['ADMIN'] },\n  { label: 'Sections', href: '/admin/sections', icon: GroupsOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Courses', href: '/admin/courses', icon: ClassOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Grading scales', href: '/admin/grading-scales', icon: StraightenOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Report cards', href: '/admin/report-cards', icon: WorkspacePremiumOutlinedIcon, roles: ['ADMIN'], group: 'Administration' },\n  { label: 'Safeguarding', href: '/admin/safeguarding', icon: ShieldOutlinedIcon, roles: ['ADMIN'], requires: 'safeguardingLead', group: 'Administration' },\n];","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PboWCZ5jTt9FSyH2292HoC","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgsrUAqLdh2MPrfpb4UUC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012NwkcGaNr95JV9HVVLub29","name":"Bash","input":{"command":"cd \"/Users/ikramaansari/Documents/React Projects/schoolhub\" && sed -n 160,190p src/server/notifications/types.ts; sed -n 115,150p src/server/attendance/attendance-service.ts; sed -n 460,480p src/server/attendance/attendance-service.ts; grep -n \"export\" src/server/auth/student-access.ts src/server/auth/course-access.ts src/server/auth/requireRole.ts src/server/messaging/contact-rules.ts; ls -R src/app/api/academic-years src/app/api/terms; grep -n \"export\" src/server/services/terms.ts src/server/services/settings.ts src/server/services/academicYears.ts; grep -rn \"schoolTimezone\\|getSchoolTimezone\" src --include=*.ts -l | head","description":"Inspect access helpers, attendance landing, terms"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7532,"cache_read_input_tokens":52581,"cache_creation":{"ephemeral_5m_input_tokens":7532,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7b9140b8-a7ae-4ca4-9024-504a0df7df9f","uuid":"ee841473-e4d2-4a56-91a5-526c3de0e189","timestamp":"2026-11-09T18:48:20.948Z","request_id":"req_011CgsrUAcgeD9BvHuKJPLHH","wire_tool_inputs":{"toolu_012NwkcGaNr95JV9HVVLub29":{"command":"cd \"/Users/ikramaansari/Documents/React Projects/schoolhub\" && sed -n 160,190p src/server/notifications/types.ts; sed -n 115,150p src/server/attendance/attendance-service.ts; sed -n 460,480p src/server/attendance/attendance-service.ts; grep -n \"export\" src/server/auth/student-access.ts src/server/auth/course-access.ts src/server/auth/requireRole.ts src/server/messaging/contact-rules.ts; ls -R src/app/api/academic-years src/app/api/terms; grep -n \"export\" src/server/services/terms.ts src/server/services/settings.ts src/server/services/academicYears.ts; grep -rn \"schoolTimezone\\|getSchoolTimezone\" src --include=*.ts -l | head","description":"Inspect access helpers, attendance landing, terms"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012NwkcGaNr95JV9HVVLub29","type":"tool_result","content":"  },\n  'report_card.published': {\n    label: 'Report card published',\n    description: 'A term report card is available to view and print.',\n    category: 'ACADEMIC',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ['STUDENT', 'PARENT'],\n  },\n  // PRD-13 messaging (FR-19, FR-26). message.received email is deferred via PendingMessageEmail (FR-20).\n  'message.received': {\n    label: 'New message',\n    description: 'Someone sent you a direct message.',\n    category: 'COMMUNICATION',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  'message.reported': {\n    label: 'Message reported',\n    description: 'A message was reported for safeguarding review.',\n    category: 'COMMUNICATION',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['ADMIN'],\n  },\n} as const satisfies Record<string, NotificationTypeDef>;\n\nexport type NotificationType = keyof typeof NOTIFICATION_TYPES;\n\nconst entries = Object.entries(NOTIFICATION_TYPES) as [NotificationType, NotificationTypeDef][];\n});\n\n// ---------------------------------------------------------------------------\n// Teacher landing (FR-6, FR-7)\n// ---------------------------------------------------------------------------\n\nconst takenSelect = { createdAt: true, takenBy: { select: { id: true, firstName: true, lastName: true } } } as const;\n\nexport async function getToday(user: AccessUser, date?: string) {\n  const { tz, mode } = await loadSettings();\n  const now = new Date();\n  const today = schoolToday(now, tz);\n  const day = date ?? today;\n  assertOpen(user, day, today);\n\n  const schedule = await getScheduleForDate({ userId: user.id, role: user.role }, day === today ? now : middayOf(day));\n  const { hhmm } = schoolNow(now, tz);\n  const courseSessions = schedule.length\n    ? await prisma.attendanceSession.findMany({\n        where: { date: toDbDate(day), courseId: { in: schedule.map((s) => s.course.id) } },\n        select: { courseId: true, periodId: true, ...takenSelect },\n      })\n    : [];\n  const taken = (s: { createdAt: Date; takenBy: { id: string; firstName: string; lastName: string } } | undefined) =>\n    s ? { at: s.createdAt.toISOString(), by: userRef(s.takenBy)! } : null;\n\n  const meetings = schedule.map((s) => ({\n    kind: 'course' as const,\n    courseId: s.course.id,\n    courseName: s.course.name,\n    sectionName: s.course.section?.name ?? '',\n    periodId: s.period.id,\n    periodName: s.period.name,\n    startTime: s.period.startTime,\n    endTime: s.period.endTime,\n    isCurrent: day === today && s.period.startTime <= hhmm && hhmm < s.period.endTime,\n  const t = h * 60 + m + minutes;\n  return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;\n}\n\nexport async function getOverview(dateArg?: string) {\n  const { tz, mode } = await loadSettings();\n  const now = new Date();\n  const today = schoolToday(now, tz);\n  const date = dateArg ?? today;\n  if (date > today) throw new AppError('VALIDATION_ERROR', 'The overview cannot be shown for a future date.');\n\n  const [schedule, sections, sessions, groups] = await Promise.all([\n    getSchoolScheduleForDate(date === today ? now : middayOf(date)),\n    mode === 'PER_PERIOD'\n      ? Promise.resolve([] as { id: string }[])\n      : prisma.section.findMany({ where: { academicYear: { isCurrent: true } }, select: { id: true } }),\n    prisma.attendanceSession.findMany({ where: { date: toDbDate(date) }, select: { courseId: true, periodId: true, sectionId: true } }),\n    prisma.attendanceRecord.groupBy({ by: ['status'], where: { session: { date: toDbDate(date), ...kindWhere(mode) } }, _count: { _all: true } }),\n  ]);\n\n  const done = new Set(sessions.map((s) => (s.courseId ? `${s.courseId}|${s.periodId}` : `section|${s.sectionId}`)));\nsrc/server/auth/student-access.ts