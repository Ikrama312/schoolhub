{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015uFqw6ivdyPcgBpBQ5ry5v","type":"tool_result","content":"import type { ContentStatus } from '@prisma/client';\n\n/**\n * Single source of truth for content visibility (PRD-08 FR-18, FR-19, FR-44).\n * Pure: evaluated at read time, no background job. Used by list, get,\n * prev/next, file access, progress and the Learning tab.\n */\n\nexport interface Publishable {\n  status: ContentStatus;\n  publishAt: Date | null;\n}\n\nexport function isVisible(item: Publishable, now: Date): boolean {\n  if (item.status === 'PUBLISHED') return true;\n  return item.status === 'SCHEDULED' && item.publishAt !== null && item.publishAt.getTime() <= now.getTime();\n}\n\n/** A lesson is visible to students/parents only when it AND its module are visible. */\nexport function isLessonVisible(lesson: Publishable, module: Publishable, now: Date): boolean {\n  return isVisible(module, now) && isVisible(lesson, now);\n}\n\n/** ADMIN, or the course's teacher/co-teacher, see drafts and scheduled items. */\nexport function canSeeDrafts(\n  user: { id: string; role: string },\n  course: { teacherId: string; coTeacherIds: string[] },\n): boolean {\n  if (user.role === 'ADMIN') return true;\n  return user.role === 'TEACHER' && (course.teacherId === user.id || course.coTeacherIds.includes(user.id));\n}\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { AccessUser } from '@/server/auth/student-access';\n\n/**\n * PRD-05 FR-18. `user` is whatever requireRole(...) resolved (NFR-7 stand-in\n * until PRD-01 lands). NOT_FOUND for a missing course, FORBIDDEN otherwise.\n */\n\nasync function loadCourse(courseId: string) {\n  const course = await prisma.course.findUnique({\n    where: { id: courseId },\n    select: { id: true, teacherId: true, coTeacherIds: true },\n  });\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  return course;\n}\n\nfunction teaches(user: AccessUser, course: { teacherId: string; coTeacherIds: string[] }) {\n  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n}\n\nconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n\nexport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n\n  switch (user.role) {\n    case 'ADMIN':\n      return;\n    case 'TEACHER':\n      if (teaches(user, course)) return;\n      throw forbidden();\n    case 'STUDENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    case 'PARENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    default:\n      throw forbidden();\n  }\n}\n\n/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\nexport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER' && teaches(user, course)) return;\n  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');\n}\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n\n/** Students ∪ their linked parents, deduped (FR-12). Pure. */\nexport function expandStudentRecipients(\n  studentIds: string[],\n  links: { studentId: string; parentId: string }[],\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nsrc/server/files/files-service.ts:26:export interface FileSummary {\nsrc/server/files/files-service.ts:33:export const toSummary = (f: Pick<FileObject, 'id' | 'originalName' | 'mimeType' | 'sizeBytes'>): FileSummary => ({\nsrc/server/files/files-service.ts:123:export async function uploadFile(user: FileAccessUser, request: Request): Promise<FileSummary> {\nsrc/server/files/files-service.ts:184:export async function getFileForDownload(user: FileAccessUser | null, id: string) {\nsrc/server/files/files-service.ts:191:export async function deleteUnattachedFile(user: FileAccessUser, id: string, request?: Request): Promise<void> {\nsrc/server/files/files-service.ts:215:export async function attachFiles(\nsrc/server/files/files-service.ts:242:export async function detachFiles(tx: Tx, fileIds: string[]): Promise<void> {\nsrc/server/files/access.ts:9:export interface FileAccessUser {\nsrc/server/files/access.ts:14:export type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\nsrc/server/files/access.ts:17:export type FileAccessResolver = (user: FileAccessUser | null, file: FileAccessFile) => boolean | Promise<boolean>;\nsrc/server/files/access.ts:21:export functi