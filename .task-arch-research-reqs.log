{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ATh7qiNf574dJeGHTTvoU1","type":"tool_result","content":"export async function listAcademicYears() {\n  return prisma.academicYear.findMany({\n    orderBy: { startDate: 'asc' },\n    include: { terms: { orderBy: { order: 'asc' } } },\n  });\n}\n\nexport async function createAcademicYear(input: AcademicYearInput) {\n  assertValidRange(input.startDate, input.endDate);\n  return prisma.$transaction(\n    async (tx) => {\n      await assertNoOverlap(tx, input);\n      return tx.academicYear.create({ data: input });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\nexport async function updateAcademicYear(id: string, input: Partial<AcademicYearInput>) {\n  return prisma.$transaction(\n    async (tx) => {\n      const existing = await tx.academicYear.findUniqueOrThrow({ where: { id } });\n      const startDate = input.startDate ?? existing.startDate;\n      const endDate = input.endDate ?? existing.endDate;\n      assertValidRange(startDate, endDate);\n      await assertNoOverlap(tx, { startDate, endDate }, id);\n      return tx.academicYear.update({\n        where: { id },\n        data: { name: input.name ?? existing.name, startDate, endDate },\n      });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\n/** Sets isCurrent = true on `id` and false on every other year, atomically. */\nsrc/app/api/admin:\nemail-log\nnotifications\n\nsrc/app/api/admin/email-log:\n[id]\nroute.ts\n\nsrc/app/api/admin/email-log/[id]:\nretry\n\nsrc/app/api/admin/email-log/[id]/retry:\nroute.ts\n\nsrc/app/api/admin/notifications:\ntest\n\nsrc/app/api/admin/notifications/test:\nroute.ts\n\nsrc/app/api/me:\nchildren\ncourses\nnotification-preferences\nprofile\n\nsrc/app/api/me/children:\nroute.ts\n\nsrc/app/api/me/courses:\nroute.ts\n\nsrc/app/api/me/notification-preferences:\nroute.ts\n\nsrc/app/api/me/profile:\nroute.ts\ncourses\nemail-log