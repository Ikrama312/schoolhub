{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D9m8pNA25YkbvUCLGmnNAK","type":"tool_result","content":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { AccessUser } from '@/server/auth/student-access';\n\n/**\n * PRD-05 FR-18. `user` is whatever requireRole(...) resolved (NFR-7 stand-in\n * until PRD-01 lands). NOT_FOUND for a missing course, FORBIDDEN otherwise.\n */\n\nasync function loadCourse(courseId: string) {\n  const course = await prisma.course.findUnique({\n    where: { id: courseId },\n    select: { id: true, teacherId: true, coTeacherIds: true },\n  });\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  return course;\n}\n\nfunction teaches(user: AccessUser, course: { teacherId: string; coTeacherIds: string[] }) {\n  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n}\n\nconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n\nexport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n\n  switch (user.role) {\n    case 'ADMIN':\n      return;\n    case 'TEACHER':\n      if (teaches(user, course)) return;\n      throw forbidden();\n    case 'STUDENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    case 'PARENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    default:\n      throw forbidden();\n  }\n}\n\n/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\nexport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER' && teaches(user, course)) return;\n  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\nimport { sendDueReminders } from '@/server/assignments/reminders';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n  try {\n    const reminders = await sendDueReminders(new Date());\n    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n  } catch (error) {\n    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\n// Pure and isomorphic (ADR-7): imported by the grading UI for the live preview and by the\n// service for the stored value. No Prisma client import. Decimal comes from Prisma's browser\n// runtime, which bundles decimal.js, so no new dependency is needed (ADR-1); decimal.js itself is\n// only a transitive devDependency here and would not be installed in production.\nimport { Decimal } from '@prisma/client/runtime/index-browser.js';\n\nexport { Decimal };\nexport type DecimalValue = string | number | { toString(): string };\n\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\nexport const dec = (v: DecimalValue) => new Decimal(typeof v === 'number' ? v : v.toString());\n\n/** \"14.40\" — the wire and storage form (NFR-1, D5). */\nexport const fixed2 = (v: DecimalValue) => dec(v).toDecimalPlaces(2, Decimal.ROUND_HALF_UP).toFixed(2);\n\n/**\n * FR-23: ceil(elapsed / 24 h) on UTC instants, so a DST change in the school timezone does not\n * matter and exactly 24 h late is 1 day (NFR-9). On time (≤ dueAt) is 0.\n */\nexport function lateDays(submittedAt: Date, dueAt: Date): number {\n  const ms = submittedAt.getTime() - dueAt.getTime();\n  return ms <= 0 ? 0 : Math.ceil(ms / DAY_MS);\n}\n\n/** FR-30: min(lateDays × perDay, max), the pre-filled penalty percent. */\nexport function defaultPenalty(days: number, perDay: DecimalValue, max: DecimalValue): Decimal {\n  return Decimal.min(dec(perDay).mul(days), dec(max));\n}\n\n/** FR-31: raw × (1 − pct/100), rounded half-up to 2 dp. */\nexport function computeFinalScore(raw: DecimalValue, penaltyPercent: DecimalValue): Decimal {\n  return dec(raw)\n    .mul(new Decimal(100).minus(dec(penaltyPercent)))\n    .div(100)\n    .toDecimalPlaces(2, Decimal.ROUND_HALF_UP);\n}\n\n/** FR-11: Σ criterion maxPoints. */\nexport function rubricTotal(criteria: readonly { maxPoints: DecimalValue }[]): Decimal {\n  return criteria.reduce((sum, c) => sum.plus(dec(c.maxPoints)), new Decimal(0));\n}\n\n/** FR-36: maxPoints, or 120 % of it when extra credit is allowed (raw score only). */\nexport function maxRawScore(maxPoints: DecimalValue, allowExtraCredit: boolean): Decimal {\n  return allowExtraCredit ? dec(maxPoints).mul('1.2') : dec(maxPoints);\n}\n\nexport type ChipStatus = 'NOT_SUBMITTED' | 'SUBMITTED' | 'LATE' | 'GRADED' | 'RETURNED' | 'EXEMPT';\n\n/** FR-28 roster chip. Exempt wins; then the most advanced state of the submission. */\nexport function submissionChipStatus(row: {\n  exempt: boolean;\n  submission: { status: 'SUBMITTED' | 'RETURNED'; gradedAt: Date | string | null; isLate: boolean } | null;\n}): ChipStatus {\n  if (row.exempt) return 'EXEMPT';\n  const s = row.submission;\n  if (!s) return 'NOT_SUBMITTED';\n  if (s.status === 'RETURNED') return 'RETURNED';\n  if (s.gradedAt) return 'GRADED';\n  return s.isLate ? 'LATE' : 'SUBMITTED';\n}\nsrc/components:\nConfirmDialog\nDataTable\nDateDisplay\nEmptyState\nFileList\nFileUpload\nFormField\nLoadingSkeleton\nMarkdownEditor\nMarkdownView\nNotificationBell\nPageHeader\nPasswordChecklist\nStatCard\nToast\nUserAvatar\nUserPicker\n\nsrc/server/assignments:\nassignments-service.ts\ngrading-math.ts\nreminders.ts\n\nsrc/server/files:\naccess.ts\ncontexts.ts\nfiles-service.ts\npurge.ts\nvalidate.ts\n\nsrc/server/notifications:\nnotify.ts\npreferences.ts\npurge.ts\nservice.ts\ntypes.ts\n/**\n * Notification type registry (PRD-04 FR-2..5). Client-safe: no prisma/env\n * imports, so validators and client pages can import it. Later PRDs add keys\n * to NOTIFICATION_TYPES; there is no runtime registration API.\n */\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nconst ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\nexport const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nexport type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\n\nexport const CATEGORY_LABELS: Record<NotificationCategory, string> = {\n  ACCOUNT: 'Account',\n  ACADEMIC: 'Academic',\n  ATTENDANCE: 'Attendance',\n  COMMUNICATION: 'Communication',\n  FINANCE: 'Finance',\n  SYSTEM: 'System',\n};\n\nexport type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'system.test': {\n    label: 'Test notification',\n    description: 'Test messages sent by an administrator.',\n    category: 'SYSTEM',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    roles: ALL,\n  },\n  // PRD-07 attendance (FR-20, FR-23).\n  'attendance.absent': {\n    label: 'Marked absent',\n    description: 'A student was marked absent from a class or the daily register.',\n    category: 'ATTENDANCE',\n    defaultEmail: true,\n    mandatoryInApp: true,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.late': {\n    label: 'Marked late',\n    description: 'A student was marked late.',\n    category: 'ATTENDANCE',\n    defaultEmail: false,\n    mandatoryInApp: false,\n    roles: ['PARENT', 'STUDENT'],\n  },\n  'attendance.corrected': {\n    label: 'Attendance corrected',\n    description: 'An absence was corrected to present.',\n    category: 'ATTENDANCE',","is_error":false}]},"parent_tool_use_id":null,"session_id":"73285dce-b12a-41d8-b326-53463f575912","uuid":"4207368f-e233-43b6-90f1-7fb6e06502eb","timestamp":"2026-11-09T07:01:33.078Z","tool_use_result":{"stdout":"import { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport type { AccessUser } from '@/server/auth/student-access';\n\n/**\n * PRD-05 FR-18. `user` is whatever requireRole(...) resolved (NFR-7 stand-in\n * until PRD-01 lands). NOT_FOUND for a missing course, FORBIDDEN otherwise.\n */\n\nasync function loadCourse(courseId: string) {\n  const course = await prisma.course.findUnique({\n    where: { id: courseId },\n    select: { id: true, teacherId: true, coTeacherIds: true },\n  });\n  if (!course) throw new AppError('NOT_FOUND', 'Course not found');\n  return course;\n}\n\nfunction teaches(user: AccessUser, course: { teacherId: string; coTeacherIds: string[] }) {\n  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n}\n\nconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n\nexport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n\n  switch (user.role) {\n    case 'ADMIN':\n      return;\n    case 'TEACHER':\n      if (teaches(user, course)) return;\n      throw forbidden();\n    case 'STUDENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    case 'PARENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    default:\n      throw forbidden();\n  }\n}\n\n/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\nexport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER' && teaches(user, course)) return;\n  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');\n}\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\nimport { timingSafeEqual } from 'node:crypto';\nimport { AppError, ok, withHandler } from '@/server/http';\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\nimport { dispatchEmails } from '@/server/email/dispatch';\nimport { purgeOldNotifications } from '@/server/notifications/purge';\nimport { purgeOrphanFiles } from '@/server/files/purge';\nimport { sendDueReminders } from '@/server/assignments/reminders';\n\nexport const dynamic = 'force-dynamic';\n\nconst DAY_MS = 24 * 60 * 60_000;\n// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\nlet lastPurgeAt = 0;\n\nfunction authorized(header: string | null): boolean {\n  if (!env.CRON_SECRET || !header?.startsWith('Bearer ')) return false;\n  const given = Buffer.from(header.slice('Bearer '.length));\n  const expected = Buffer.from(env.CRON_SECRET);\n  return given.length === expected.length && timingSafeEqual(given, expected);\n}\n\n/** POST /api/internal/email/dispatch — cron entry point (FR-19, FR-27, NFR-8). */\nexport const POST = withHandler(async (request: Request) => {\n  if (!authorized(request.headers.get('authorization'))) {\n    throw new AppError('UNAUTHENTICATED', 'Invalid or missing cron secret.');\n  }\n  const result = await dispatchEmails({ batchSize: 50 });\n\n  // PRD-09 FR-43/FR-45: every request, outside the daily purge block; idempotent per AssignmentReminder.\n  try {\n    const reminders = await sendDueReminders(new Date());\n    if (reminders.dueSoon || reminders.missing) logger.info('Assignment reminders sent', reminders);\n  } catch (error) {\n    logger.error('Assignment reminders failed', { message: error instanceof Error ? error.message : String(error) });\n  }\n\n  if (Date.now() - lastPurgeAt > DAY_MS) {\n    lastPurgeAt = Date.now();\n    try {\n      const purged = await purgeOldNotifications();\n      logger.info('Purged old notifications', { purged });\n    } catch (error) {\n      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n    try {\n      await purgeOrphanFiles(new Date());\n    } catch (error) {\n      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });\n    }\n  }\n  return ok(result);\n});\n// Pure and isomorphic (ADR-7): imported by the grading UI for the live preview and by the\n// service for the stored value. No Prisma client import. Decimal comes from Prisma's browser\n// runtime, which bundles decimal.js, so no new dependency is needed (ADR-1); decimal.js itself is\n// only a transitive devDependency here and would not be installed in production.\nimport { Decimal } from '@prisma/client/runtime/index-browser.js';\n\nexport { Decimal };\nexport type DecimalValue = string | number | { toString(): string };\n\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\nexport const dec = (v: DecimalValue) => new Decimal(typeof v === 'number' ? v : v.toString());\n\n/** \"14.40\" — the wire and storage form (NFR-1, D5). */\nexport const fixed2 = (v: DecimalValue) => dec(v).toDecimalPlaces(2, Decimal.ROUND_HALF_UP).toFixed(2);\n\n/**\n * FR-23: ceil(elapsed / 24 h) on UTC instants, so a DST change in the school timezone does not\n * matter and exactly 24 h late is 1 day (NFR-9). On time (≤ dueAt) is 0.\n */\nexport function lateDays(submittedAt: Date, dueAt: Date): number {\n  const ms = submittedAt.getTime() - dueAt.getTime();\n  return ms <= 0 ? 0 :