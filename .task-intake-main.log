{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BpjHA76gPaCciyx9WiiWyr","type":"tool_result","content":"import { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { notify } from '@/server/notifications/notify';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { getSchoolTimezone, visibleWhere } from './assignments-service';\n\n/**\n * FR-43 / FR-45 / FR-60 maintenance pass, run on every dispatcher request (system-design §2.3).\n * Idempotent through the AssignmentReminder unique key: insert per (assignment, student, kind)\n * and notify only when the insert succeeded, so concurrent dispatchers send once.\n */\n\nconst HOUR = 3_600_000;\n// ponytail: missing pass only looks back 8 days; widen or add a cursor if the dispatcher can be down longer.\nconst MISSING_LOOKBACK_MS = 8 * 24 * HOUR;\n\ntype Kind = 'due_soon' | 'missing';\n\n/** ACTIVE enrollees with no submission and no exemption, for assignments in the window. */\nasync function candidates(dueAt: Prisma.DateTimeFilter, now: Date) {\n(eval):1: no matches found: --include=*.ts\nnotify.ts\npreferences.ts\npurge.ts\nservice.ts\ntypes.ts\n6:export type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n8:const ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n10:export const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\n14:  ACCOUNT: 'Account',\n15:  ACADEMIC: 'Academic',\n16:  ATTENDANCE: 'Attendance',\n17:  COMMUNICATION: 'Communication',\n18:  FINANCE: 'Finance',\n19:  SYSTEM: 'System',\n34:  'account.invite': {\n35:    label: 'Account invitation',\n36:    description: 'Invitation to set up your SchoolHub account.',\n37:    category: 'ACCOUNT',\n43:  'account.password_reset': {\n44:    label: 'Password reset',\n45:    description: 'Link to reset your password.',\n46:    category: 'ACCOUNT',\n52:  'system.test': {\n53:    label: 'Test notification',\n54:    description: 'Test messages sent by an administrator.',\n55:    category: 'SYSTEM',\n61:  'attendance.absent': {\n62:    label: 'Marked absent',\n63:    description: 'A student was marked absent from a class or the daily register.',\n64:    category: 'ATTENDANCE',\n67:    roles: ['PARENT', 'STUDENT'],\n69:  'attendance.late': {\n70:    label: 'Marked late',\n71:    description: 'A student was marked late.',\n72:    category: 'ATTENDANCE',","is_error":false}]},"parent_tool_use_id":null,"session_id":"ff0d7d11-4ecb-4594-9705-5d04035e2cd1","uuid":"145d6797-f24c-433e-88f8-a0aa33db7b6e","timestamp":"2026-11-09T06:59:34.272Z","tool_use_result":{"stdout":"import { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { notify } from '@/server/notifications/notify';\nimport { formatInSchoolTz } from '@/lib/dates';\nimport { getSchoolTimezone, visibleWhere } from './assignments-service';\n\n/**\n * FR-43 / FR-45 / FR-60 maintenance pass, run on every dispatcher request (system-design §2.3).\n * Idempotent through the AssignmentReminder unique key: insert per (assignment, student, kind)\n * and notify only when the insert succeeded, so concurrent dispatchers send once.\n */\n\nconst HOUR = 3_600_000;\n// ponytail: missing pass only looks back 8 days; widen or add a cursor if the dispatcher can be down longer.\nconst MISSING_LOOKBACK_MS = 8 * 24 * HOUR;\n\ntype Kind = 'due_soon' | 'missing';\n\n/** ACTIVE enrollees with no submission and no exemption, for assignments in the window. */\nasync function candidates(dueAt: Prisma.DateTimeFilter, now: Date) {\n(eval):1: no matches found: --include=*.ts\nnotify.ts\npreferences.ts\npurge.ts\nservice.ts\ntypes.ts\n6:export type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n8:const ALL: readonly Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n10:export const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\n14:  ACCOUNT: 'Account',\n15:  ACADEMIC: 