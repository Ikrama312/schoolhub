{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018LRiHiikKvgbcqwzwYcrJo","type":"tool_result","content":"import { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface StudentTab {\n  key: string;\n  label: string;\n  href: (studentId: string) => string;\n  roles: Role[];\n}\n\n/** Extension point for the student detail page; later PRDs register their tab here. */\nexport const studentTabs: StudentTab[] = [\n  { key: 'courses', label: 'Courses', href: (id) => `/students/${id}/courses`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\n];\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n}\nsrc/server/notifications/types.ts:6:export type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\nsrc/server/notifications/types.ts:10:export const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nsrc/server/notifications/types.ts:11:export type NotificationCategory = (typeof NOTIFICATION_CATEGORIES)[number];\nsrc/server/notifications/types.ts:13:export const CATEGORY_LABELS: Record<NotificationCategory, string> = {\nsrc/server/notifications/types.ts:22:export type NotificationTypeDef = {\nsrc/server/notifications/types.ts:33:export const NOTIFICATION_TYPES = {\nsrc/server/notifications/types.ts:104:export type NotificationType = keyof typeof NOTIFICATION_TYPES;\nsrc/server/notifications/types.ts:108:export function getTypeDef(type: string): NotificationTypeDef | undefined {\nsrc/server/notifications/types.ts:115:export function visibleTypesFor(role: Role): NotificationType[] {\nsrc/server/notifications/types.ts:120:export function typesInCategory(category: NotificationCategory): NotificationType[] {\nsrc/server/notifications/types.ts:124:export function categoryOf(type: string): NotificationCategory | null {\nsrc/server/notifications/notify.ts:8:export interface NotifyInput {\nsrc/server/notifications/notify.ts:28:export async function notify(input: NotifyInput): Promise<void> {\nsrc/server/notifications/notify.ts:87:export function expandStudentRecipients(\nsrc/server/notifications/notify.ts:98:export async function notifyStudentAndParents(\nsrc/server/attendance/attendance-service.ts\nsrc/server/notifications/notify.ts\nroute.ts\nsrc/server/auth/course-access.ts:25:export async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\nsrc/server/auth/course-access.ts:56:export async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\nsrc/server/auth/student-access.ts:5:export interface AccessUser {\nsrc/server/auth/student-access.ts:10:export type AccessibleStudentIds = 'ALL' | string[];\nsrc/server/auth/student-access.ts:20:export async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\nsrc/server/auth/student-access.ts:63:export async function assertCanViewStudent(user: AccessUser, studentId: string): Promise<void> {","is_error":false}]},"parent_tool_use_id":null,"session_id":"df495bd9-17af-4404-ad8d-134253d4d6e0","uuid":"76953f2f-3960-47ef-a32c-e032818b8216","timestamp":"2026-11-09T05:19:51.377Z","tool_use_result":{"stdout":"import { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] 