{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CBN5SCEPMFVUmZMiXdzYkj","type":"tool_result","content":"/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n/// field shared by every role, archivedAt backs FR-13's archive/restore\n/// (separate from status so a DISABLED-but-not-archived user stays distinct\n/// from an archived one).\nmodel User {\n  id                      String                   @id @default(cuid())\n  email                   String                   @unique\n  passwordHash            String?\n  firstName               String\n  lastName                String\n  phone                   String?\n  role                    Role\n  status                  UserStatus               @default(INVITED)\n  failedLoginCount        Int                      @default(0)\n  lockedUntil             DateTime?\n  lastLoginAt             DateTime?\n  passwordChangedAt       DateTime?\n  archivedAt              DateTime?\n  createdAt               DateTime                 @default(now())\n  updatedAt               DateTime                 @updatedAt\n  authTokens              AuthToken[]\n  auditLogs               AuditLog[]\n  studentProfile          StudentProfile?\n  teacherProfile          TeacherProfile?\n  parentProfile           ParentProfile?\n  parentLinks             ParentStudentLink[]      @relation(\"ParentLinks\")\n  studentLinks            ParentStudentLink[]      @relation(\"StudentLinks\")\n  notifications           Notification[]\n  notificationPreferences NotificationPreference[]\n  homeroomSections        Section[]                @relation(\"HomeroomTeacher\")\n  sectionMemberships      SectionMember[]\n  taughtCourses           Course[]                 @relation(\"CourseTeacher\")\n  enrollments             Enrollment[]\n\n  @@index([lastName, firstName, email])\n}\n\n/// Student-specific fields (FR-1). medicalNotes is visible to ADMIN/TEACHER\n/// only -- enforced in the service layer (src/server/services/users.ts,\n/// src/app/api/students/[id]/route.ts), never by hiding it client-side.\nmodel StudentProfile {\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n  @@index([entityType, entityId])\n  @@index([actorId, createdAt])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nsrc/server/auth/tokens.ts:14:export const INVITE_TTL = { days: 7 } as const;\nsrc/server/auth/tokens.ts:16:export function hashToken(raw: string): string {\nsrc/server/auth/tokens.ts:21:export async function createToken(\nsrc/server/auth/tokens.ts:42:export type VerifiedToken = {\nsrc/server/auth/tokens.ts:48:export async function verifyToken(raw: string, type: AuthTokenType): Promise<VerifiedToken | null> {\nsrc/server/auth/tokens.ts:63:export async function consumeToken(tokenId: string, tx?: Tx): Promise<void> {\nsrc/server/rate-limit.ts:5:export function rateLimit(\nsrc/server/rate-limit.ts:21:export function __resetRateLimits(): void {\nsrc/server/audit.ts:6:export interface AuditInput {\nsrc/server/audit.ts:26:export async function audit(input: AuditInput): Promise<void> {\nsrc/server/auth/email.ts:8:export type AuthEmailKind = 'invite' | 'password-reset';\nsrc/server/auth/email.ts:16:export function authLink(kind: AuthEmailKind, rawToken: string): string {\nsrc/server/auth/email.ts:26:export async function sendAuthEmail(\nsrc/server/auth/credentials.ts:11:export class AuthError extends CredentialsSignin {\nsrc/server/auth/credentials.ts:18:export const MAX_FAILED_LOGINS = 5;\nsrc/server/auth/credentials.ts:19:export const LOCKOUT_MS = 15 * 60_000;\nsrc/server/auth/credentials.ts:27:export function computeLockout(count: number, now: Date): { failedLoginCount: number; lockedUntil: Date | null } {\nsrc/server/auth/credentials.ts:32:export interface AuthorizedUser {\nsrc/server/auth/credentials.ts:40:export async function authorizeCredentials(input: unknown, request: Request): Promise<AuthorizedUser> {\nsrc/server/auth/password-policy.ts:18:export function assertPasswordAllowed(password: string, email: string): void {\nsrc/server/services/auth.ts:17:export const RESET_REQUESTED_MESSAGE = \"If an account exists for that email, we've sent a reset link.\";\nsrc/server/services/auth.ts:21:export async function acceptInvite(input: { token: string; password: string }, request?: Request) {\nsrc/server/services/auth.ts:40:export async function requestPasswordReset(input: { email: string }, request?: Request) {\nsrc/server/services/auth.ts:61:export async function resetPassword(input: { token: string; password: string }, request?: Request) {\nsrc/server/services/auth.ts:80:export async function changePassword(\nsrc/lib/validators/auth.ts:10:export const emailField = z.string().trim().toLowerCase().email('Enter a valid email address');\nsrc/lib/validators/auth.ts:12:export interface PasswordCheckResult {\nsrc/lib/validators/auth.ts:19:export const PASSWORD_RULES: Record<keyof PasswordCheckResult, { label: string; 