esult_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":16,"outputTokens":14324,"cacheReadInputTokens":305249,"cacheCreationInputTokens":58357,"webSearchRequests":0,"costUSD":0.8144498,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":381,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":58357,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
