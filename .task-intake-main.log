{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DvT1sd2VmGDZEpY65HLN4C","type":"tool_result","content":"  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n}\n\nconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n\nexport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n\n  switch (user.role) {\n    case 'ADMIN':\n      return;\n    case 'TEACHER':\n      if (teaches(user, course)) return;\n      throw forbidden();\n    case 'STUDENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    case 'PARENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    default:\n      throw forbidden();\n  }\n}\n\n/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\nexport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER' && teaches(user, course)) return;\n  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');","is_error":false}]},"parent_tool_use_id":null,"session_id":"2c329f7d-691a-4a75-afbf-a9bd625b840d","uuid":"f692ca9d-485c-4372-84b1-33a6338de18e","timestamp":"2026-11-06T18:47:08.975Z","tool_use_result":{"stdout":"  return course.teacherId === user.id || course.coTeacherIds.includes(user.id);\n}\n\nconst forbidden = () => new AppError('FORBIDDEN', 'You do not have permission to view this course.');\n\nexport async function assertCanViewCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n\n  switch (user.role) {\n    case 'ADMIN':\n      return;\n    case 'TEACHER':\n      if (teaches(user, course)) return;\n      throw forbidden();\n    case 'STUDENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, studentId: user.id, status: 'ACTIVE' },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    case 'PARENT': {\n      const enrollment = await prisma.enrollment.findFirst({\n        where: { courseId, status: 'ACTIVE', student: { studentLinks: { some: { parentId: user.id } } } },\n        select: { id: true },\n      });\n      if (enrollment) return;\n      throw forbidden();\n    }\n    default:\n      throw forbidden();\n  }\n}\n\n/** ADMIN, teacher or co-teacher — for later PRDs' course write operations. */\nexport async function assertCanManageCourse(user: AccessUser, courseId: string): Promise<void> {\n  const course = await loadCourse(courseId);\n  if (user.role === 'ADMIN') return;\n  if (user.role === 'TEACHER' && teaches(user, course)) return;\n  throw new AppError('FORBIDDEN', 'You do not have permission to manage this course.');","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DvT1sd2VmGDZEpY65HLN4C","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
