{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AR3adASXfQ7XoynHjb62Eh","type":"tool_result","content":"src/server/notifications/types.ts:10:export const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nsrc/server/notifications/types.ts:16:  ATTENDANCE: 'Attendance',\nsrc/server/timetable/timetable-service.ts:531:// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\nprisma/schema.prisma:424:/// DROPPED rows are kept (never deleted) so later PRDs' attendance/grades\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n// ---------------------------------------------------------------------------\n// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n// ---------------------------------------------------------------------------\n\nexport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\nexport interface ScheduleEntry {\n  period: ExpandedSlot['period'];\n  course: ExpandedSlot['course'];\n  room: ExpandedSlot['room'];\n}\n\n/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\nexport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n  let slotTarget: SlotTarget | null;\n  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n\n  const { isoDay } = schoolNow(date, await schoolTimezone());\n  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n\n  const academicYearId = await currentYearId();\n  if (!academicYearId) return [];\n  const slots = await prisma.timetableSlot.findMany({\n    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n    include: slotInclude,\n    orderBy: { period: { order: 'asc' } },\n  });\n227:model Term {\n228-  id             String       @id @default(cuid())\n229-  academicYearId String\n230-  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n--\n357:enum EnrollmentStatus {\n358-  ACTIVE\n359-  DROPPED\n360-}\n--\n426:model Enrollment {\n427-  id         String           @id @default(cuid())\n428-  courseId   String\n429-  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n--\n432:  status     EnrollmentStatus @default(ACTIVE)\n433-  enrolledAt DateTime         @default(now())\n434-  droppedAt  DateTime?\n435-\nprisma/schema.prisma:84:  homeroomSections        Section[]                @relation(\"HomeroomTeacher\")\nprisma/schema.prisma:347:// exactly; business rules (capacity, CORE auto-enroll, homeroom-once-per-year)\nprisma/schema.prisma:370:  homeroomTeacherId String?\nprisma/schema.prisma:371:  homeroomTeacher   User?           @relation(\"HomeroomTeacher\", fields: [homeroomTeacherId], references: [id])\nsrc/app/(app):\naccount\nadmin\ncourses\ndashboard\nlayout.tsx\nmy-courses\nnotifications\nshell.tsx\nstudents\n\nsrc/app/(app)/admin:\ncourses\nemail-log\nsections\n\nsrc/components:\nConfirmDialog\nDataTable\nDateDisplay\nEmptyState\nFormField\nLoadingSkeleton\nNotificationBell\nPageHeader\nPasswordChecklist\nStatCard\nToast\nUserAvatar\nUserPicker","is_error":false}]},"parent_tool_use_id":null,"session_id":"57a4dc66-5d3c-4bfa-a9bb-908be3700630","uuid":"4417d598-efcf-475f-aceb-d145990a51ae","timestamp":"2026-11-06T05:28:49.356Z","tool_use_result":{"stdout":"src/server/notifications/types.ts:10:export const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\nsrc/server/notifications/types.ts:16:  ATTENDANCE: 'Attendance',\nsrc/server/timetable/timetable-service.ts:531:// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\nprisma/schema.prisma:424:/// DROPPED rows are kept (never deleted) so later PRDs' attendance/grades\n): string[] {\n  const students = new Set(studentIds);\n  const ids = new Set(studentIds);\n  for (const link of links) if (students.has(link.studentId)) ids.add(link.parentId);\n  return [...ids];\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.