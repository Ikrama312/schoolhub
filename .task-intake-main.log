{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T11D1dUsVyZFc2eMzi4Cgj","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub/artifacts/intake/requirements.json has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"df495bd9-17af-4404-ad8d-134253d4d6e0","uuid":"e6cc0460-3349-4fc1-81e0-8eeb1b4c191c","timestamp":"2026-11-09T05:22:27.521Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/intake/requirements.json","content":"{\n  \"ticketId\": \"SH-9\",\n  \"timestamp\": \"2026-11-09T09:00:00Z\",\n  \"phase\": \"intake\",\n  \"version\": \"1.0\",\n  \"prdTitle\": \"PRD-09: Assignments & Submissions\",\n  \"prdTicketRef\": \"SCH-009 (PRD header). The pipeline ticket is SH-9.\",\n  \"runMode\": \"--brownfield --tech-stack react\",\n\n  \"functionalRequirements\": [\n    { \"id\": \"FR-1\", \"description\": \"Add the Prisma enums SubmissionType (ONLINE_TEXT, FILE_UPLOAD, TEXT_AND_FILE, NO_SUBMISSION), AssignmentStatus (DRAFT, SCHEDULED, PUBLISHED) and SubmissionStatus (SUBMITTED, RETURNED) in a new prisma migrate migration.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 Data model (enum block)\" },\n    { \"id\": \"FR-2\", \"description\": \"Add an Assignment model with the fields listed in FR-1. Also add allowExtraCredit Boolean @default(false) (from FR-5.6), notifiedAt DateTime? (from FR-7.1) and archivedAt DateTime? (from the API table). Add a Course→Assignment relation (onDelete Cascade), a rubricId @unique relation to Rubric, and @@index([courseId, dueAt]).\", \"confidence\": \"HIGH\", \"source\": \"FR-1 model Assignment; FR-5.6; FR-7.1; API table (DELETE row)\" },\n    { \"id\": \"FR-3\", \"description\": \"Add the models AssignmentAttachment (assignment↔FileObject), Rubric and RubricCriterion. RubricCriterion has title, description?, maxPoints Decimal(6,2), order, and levels Json [{label, points, description}].\", \"confidence\": \"HIGH\", \"source\": \"FR-1 models AssignmentAttachment, Rubric, RubricCriterion\" },\n    { \"id\": \"FR-4\", \"description\": \"Add the models Submission (@@unique([assignmentId, studentId]), with Decimal rawScore/penaltyPercent/finalScore and Json rubricScores [{criterionId, points, comment}]), SubmissionFile (submission↔FileObject) and SubmissionHistory (attemptNumber, text, fileIds String[], submittedAt).\", \"confidence\": \"HIGH\", \"source\": \"FR-1 models Submission, SubmissionFile, SubmissionHistory\" },\n    { \"id\": \"FR-5\", \"description\": \"Add a GradeExemption model with a composite id (assignmentId, studentId), an optional reason and createdAt.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 model GradeExemption\" },\n    { \"id\": \"FR-6\", \"description\": \"Add an AssignmentReminder table {assignmentId, studentId, kind} with a unique key on all three columns. It makes the due_soon and missing reminders idempotent.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.2 (AssignmentReminder table)\" },\n    { \"id\": \"FR-7\", \"description\": \"Enforce the field limits in Zod schemas in src/lib/validators/assignments.ts, shared by forms and handlers: title ≤150; instructions ≤50,000; maxPoints 0–1000; lateCutoffAt > dueAt; latePenaltyPercentPerDay and maxLatePenaltyPercent 0–100; maxFileCount 1–10; submission text ≤50,000; feedback ≤10,000.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 field comments; Platform Context › Fixed technology decisions (Validation)\" },\n    { \"id\": \"FR-8\", \"description\": \"A teacher can record a grade for a student who did not submit. The service creates a Submission with text = null, no files, submittedAt = gradedAt and attemptNumber = 0 (the offline/no-submission marker).\", \"confidence\": \"HIGH\", \"source\": \"FR-1 (paragraph after the schema); FR-5.5\" },\n\n    { \"id\": \"FR-9\", \"description\": \"Build the create/edit page at /courses/[courseId]/assignments/new. Fields: title, Markdown instructions (the PRD-08 editor), attachments (FileUpload, context 'assignment'), submission type, max points, due date-time (school timezone), optional available-from, late policy (allow-late toggle → cutoff, penalty per day, maximum penalty), maximum file count, allow extra credit, and an optional rubric builder.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1; FR-5.6\" },\n    { \"id\": \"FR-10\", \"description\": \"Default the due date-time to the next teaching day at 23:59 in the school timezone. 'Teaching day' is taken from the existing SchoolDay.isTeaching weekday table, because holidays are not modelled before PRD-14.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-2.1 (default next teaching day 23:59); prisma SchoolDay model (PRD-06)\" },\n    { \"id\": \"FR-11\", \"description\": \"Rubric builder: add, reorder and remove criteria (title, description, levels with label + points + description). The sum of the criterion maximums must equal max points. Otherwise show the inline error 'Rubric totals {sum} points but the assignment is worth {maxPoints}.', and the server rejects the save with VALIDATION_ERROR.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.2; Acceptance Criteria 5\" },\n    { \"id\": \"FR-12\", \"description\": \"Offer 'Save draft' (DRAFT), 'Publish' (PUBLISHED) and 'Schedule' (SCHEDULED). Schedule requires an available-from in the future, and the assignment stays hidden from students and parents until then.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.3; FR-1 (availableFrom comment)\" },\n    { \"id\": \"FR-13\", \"description\": \"A SCHEDULED assignment counts as visible once availableFrom ≤ server now. Visibility is computed at read time. No background job rewrites the status to PUBLISHED.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-2.3 ('becomes visible then'); FR-7.1 ('when scheduled becomes visible on first student list load')\" },\n    { \"id\": \"FR-14\", \"description\": \"Editing the due date or max points of a published assignment that has submissions shows a warning. Changing max points recalculates nothing: existing scores are kept, and a banner prompts the teacher to review grades.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.4\" },\n    { \"id\": \"FR-15\", \"description\": \"A 'Duplicate to other courses' action copies the assignment as DRAFT to selected courses the teacher manages (POST /api/assignments/:id/duplicate {courseIds}). The copy keeps the instructions, attachments, settings and rubric. The copy keeps the same due date-time, and availableFrom/lateCutoffAt keep their offsets from dueAt.\", \"confidence\": \"LOW\", \"source\": \"FR-2.5 ('with the same relative due date'); API table (duplicate row)\" },\n\n    { \"id\": \"FR-16\", \"description\": \"Register an 'Assignments' tab in src/config/course-tabs.ts for all roles that can view the course.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1; Platform Context › Code layout and conventions\" },\n    { \"id\": \"FR-17\", \"description\": \"Teacher/admin view of the course Assignments tab: a table with title, due date, status, submitted/total, graded/submitted and a 'Grade' button.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1 (teacher view)\" },\n    { \"id\": \"FR-18\", \"description\": \"Student view of the course Assignments tab: a list grouped as Upcoming, Past due (missing), Submitted and Returned. Parents see the same view, read-only, for their linked child.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1 (student view, parent view)\" },\n\n    { \"id\": \"FR-19\", \"description\": \"The assignment page /courses/[courseId]/assignments/[assignmentId] shows the instructions (sanitised Markdown), attachments, due date, late policy summary, rubric (if any) and the submission panel. When under 48 hours remain, it adds a live countdown such as 'Due in 5 h 12 min'.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.1\" },\n    { \"id\": \"FR-20\", \"description\": \"The submission panel shows a Markdown text editor and/or file upload, depending on submissionType (NO_SUBMISSION shows neither). File upload respects maxFileCount. Draft text autosaves to localStorage only, never to the server.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.2\" },\n    { \"id\": \"FR-21\", \"description\": \"Clicking Submit opens a confirmation Dialog before the POST.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.3\" },\n    { \"id\": \"FR-22\", \"description\": \"Server submission rules: the assignment is visible; the student is ACTIVE-enrolled in the course; the student is not exempt. If now > dueAt, allowLate must be true and now ≤ lateCutoffAt (when set). Otherwise return VALIDATION_ERROR 'The deadline has passed and late submissions are closed.'\", \"confidence\": \"HIGH\", \"source\": \"FR-4.3; Acceptance Criteria 2\" },\n    { \"id\": \"FR-23\", \"description\": \"On submit, compute isLate = submittedAt > dueAt and lateDays = ceil((submittedAt − dueAt) / 24h), using server time. For example, due Mon 23:59 and submitted Wed 10:00 gives lateDays = 2.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.4; Acceptance Criteria 1\" },\n    { \"id\": \"FR-24\", \"description\": \"Resubmission is allowed until dueAt (or lateCutoffAt / indefinitely when late is allowed) and only while status = SUBMITTED. It copies the previous attempt into SubmissionHistory, increments attemptNumber, and clears rawScore, penaltyPercent, finalScore, feedback, rubricScores, gradedById and gradedAt. Once the work is RETURNED, resubmission is refused.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.5; Acceptance Criteria 3, 4\" },\n    { \"id\": \"FR-25\", \"description\": \"After submitting, the student sees a receipt such as 'Submitted Mon 14 Sep 2026, 21:04 (attempt 2)', in the school timezone, plus the files and text submitted.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.6\" },\n    { \"id\": \"FR-26\", \"description\": \"After return, the student sees the final score, rubric breakdown, feedback and the late penalty applied.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.7\" },\n    { \"id\": \"FR-27\", \"description\": \"Until the work is returned, the student and parent see 'Submitted — awaiting grading'. No score, rubric scores or feedback are sent in the API response.\", \"confidence\": \"HIGH\", \"source\": \"Acceptance Criteria 7; FR-5.4 ('Save' = not yet visible to student)\" },\n\n    { \"id\": \"FR-28\", \"description\": \"Grading page /courses/[courseId]/assignments/[assignmentId]/grade, left panel: an MUI List of all enrolled students with status Chips (Not submitted, Submitted, Late, Graded, Returned, Exempt), a status filter, and sorting by name or submission time.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.1\" },\n    { \"id\": \"FR-29\", \"description\": \"Grading main panel: the selected submission's text as sanitised Markdown, and its files listed with inline preview for images and PDFs (<img>/<iframe> to /api/files/:id?inline=1, which already exists). Previous attempts (SubmissionHistory) are available in a dropdown.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.2\" },\n    { \"id\": \"FR-30\", \"description\": \"Grading form. With a rubric, each criterion is an exclusive ToggleButtonGroup of levels, and the selected points auto-sum into the raw score (for example 8 + 9 → 17). Without a rubric, the raw score is entered directly. The late penalty is pre-filled as min(lateDays × perDay, maxPenalty) and can be overridden. The final score is computed live. There is a Markdown feedback editor.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.3; Acceptance Criteria 1, 6\" },\n    { \"id\": \"FR-31\", \"description\": \"finalScore = rawScore × (1 − penaltyPercent/100), rounded half-up to 2 dp. For example, raw 18 with 20 % → 14.40. It is computed server-side at grading time.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 (finalScore comment); NFR-1 Correctness; Acceptance Criteria 1\" },\n    { \"id\": \"FR-32\", \"description\": \"Grading buttons: 'Save' (graded, not visible to the student), 'Save & return' (returns this submission and sets returnedAt) and the bulk 'Return all graded' (POST /api/assignments/:id/return; submissionIds optional, defaults to all graded and unreturned).\", \"confidence\": \"HIGH\", \"source\": \"FR-5.4; API table (return row)\" },\n    { \"id\": \"FR-33\", \"description\": \"Keyboard shortcuts on the grading screen: J = next student, K = previous student, Ctrl+Enter = save and go to the next student. The shortcuts are not captured while typing in text fields, except Ctrl+Enter.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-5.4; Goals 3\" },\n    { \"id\": \"FR-34\", \"description\": \"'Grade without submission' for students who did not submit (POST /api/assignments/:id/grade-offline {studentId, rawScore, feedback}). It creates the attemptNumber = 0 Submission described in FR-8.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.5; FR-1 paragraph; API table\" },\n    { \"id\": \"FR-35\", \"description\": \"An 'Exempt' toggle (PUT/DELETE /api/assignments/:id/exemptions/:studentId) writes or deletes a GradeExemption. Exempt students are removed from missing counts and lists, get no due_soon or missing reminders, cannot submit, and are flagged for exclusion from future gradebook calculation (PRD-11).\", \"confidence\": \"HIGH\", \"source\": \"FR-5.5; FR-4.3 (not exempt); FR-6.1 (Missing not exempt); API table\" },\n    { \"id\": \"FR-36\", \"description\": \"Validate scores server-side: rawScore and the rubric points must be within 0..maxPoints. When allowExtraCredit is true, rawScore may go up to 120 % of maxPoints. penaltyPercent must be 0–100.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.6; FR-1 (penaltyPercent range)\" },\n\n    { \"id\": \"FR-37\", \"description\": \"Build the /assignments page for STUDENT. It lists every assignment across the student's ACTIVE enrollments in four tabs: Upcoming (sorted by due date), Missing (past due, not submitted, not exempt), Submitted and Returned. There is a course filter.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1; Goals 2\" },\n    { \"id\": \"FR-38\", \"description\": \"The /assignments page for PARENT has a child selector (linked students only) and shows the same content as the student view, read-only.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1 (PARENT)\" },\n    { \"id\": \"FR-39\", \"description\": \"The /assignments page for TEACHER is a 'To grade' list of submitted, ungraded submissions across the courses they teach (teacherId or coTeacherIds), oldest first.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1 (TEACHER)\" },\n    { \"id\": \"FR-40\", \"description\": \"Add an 'Assignments' nav entry for /assignments to src/config/navigation.ts for STUDENT, PARENT and TEACHER.\", \"confidence\": \"MEDIUM\", \"source\": \"Platform Context › Code layout ('A PRD that adds a page adds its nav entry'); FR-6.1\" },\n    { \"id\": \"FR-41\", \"description\": \"Register an 'Assignments' student tab in src/config/student-tabs.ts. It shows the same per-student data to teachers and admins who view the student (GET /api/students/:id/assignments).\", \"confidence\": \"HIGH\", \"source\": \"FR-6.2; API table\" },\n\n    { \"id\": \"FR-42\", \"description\": \"Register and send assignment.published to ACTIVE-enrolled students (in-app; email default false). It is sent on publish, or for SCHEDULED assignments on the first student list load after availableFrom. It is sent exactly once, using Assignment.notifiedAt (set atomically).\", \"confidence\": \"HIGH\", \"source\": \"FR-7.1\" },\n    { \"id\": \"FR-43\", \"description\": \"Register and send assignment.due_soon to students with no submission (and not exempt) once dueAt − 24 h has passed and before dueAt. sendDueReminders() runs on every PRD-04 maintenance dispatcher call (src/app/api/internal/email/dispatch/route.ts). It is idempotent via the AssignmentReminder unique key (kind 'due_soon').\", \"confidence\": \"HIGH\", \"source\": \"FR-7.2; Acceptance Criteria 8\" },\n    { \"id\": \"FR-44\", \"description\": \"Register and send assignment.returned to the student and their parents through the existing notifyStudentAndParents(). The body includes course, title and score, for example 'Mathematics: Fractions worksheet — 18/20'.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.3\" },\n    { \"id\": \"FR-45\", \"description\": \"Register and send assignment.missing to parents only (email default true), once per student, 24 hours after dueAt if the student has still not submitted and is not exempt. It is idempotent via AssignmentReminder (kind 'missing') and runs in the same sendDueReminders() maintenance pass.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.4; Acceptance Criteria 9\" },\n    { \"id\": \"FR-46\", \"description\": \"Add the four notification types to NOTIFICATION_TYPES in src/server/notifications/types.ts with the category ACADEMIC and the role lists that match their recipients.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-7 ('Register and send'); Platform Context (notification type keys registered in types.ts)\" },\n    { \"id\": \"FR-47\", \"description\": \"Register two file access contexts in src/server/files/contexts.ts: 'assignment' (anyone who can view the assignment, with visibility rules applied) and 'submission' (the submitting student, their linked parents, course managers and admins). Any other user is denied.\", \"confidence\": \"HIGH\", \"source\": \"FR-8.1; Acceptance Criteria 10\" },\n\n    { \"id\": \"FR-48\", \"description\": \"GET /api/courses/:id/assignments (view course) returns a role-shaped list. Managers get every status with counts. Students and parents get only visible, non-archived assignments, with their own submission state.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },\n    { \"id\": \"FR-49\", \"description\": \"POST /api/courses/:id/assignments (manage course) creates an assignment with its rubric and attachments.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },\n    { \"id\": \"FR-50\", \"description\": \"GET /api/assignments/:id (view). For students and parents the response includes their own submission, with grading fields only once returned.\", \"confidence\": \"HIGH\", \"source\": \"API table; Acceptance Criteria 7\" },\n    { \"id\": \"FR-51\", \"description\": \"PATCH /api/assignments/:id (manage). DELETE /api/assignments/:id (manage) hard-deletes only when there are no submissions. Otherwise it sets archivedAt.\", \"confidence\": \"HIGH\", \"source\": \"API table (PATCH/DELETE row)\" },\n    { \"id\": \"FR-52\", \"description\": \"Archived assignments are hidden from student and parent lists, /assignments, reminders and new submissions. Managers can still see them.\", \"confidence\": \"LOW\", \"source\": \"API table ('otherwise archive (add archivedAt)') — the behaviour of an archived assignment is not specified\" },\n    { \"id\": \"FR-53\", \"description\": \"POST /api/assignments/:id/submissions (STUDENT) {text?, fileIds[]} applies the FR-22 to FR-24 rules. The fileIds must be the student's own uploads with context 'submission', and their number must be ≤ maxFileCount.\", \"confidence\": \"HIGH\", \"source\": \"API table; FR-4.2–4.5\" },\n    { \"id\": \"FR-54\", \"description\": \"GET /api/assignments/:id/submissions (manage) lists every enrolled student, including those who have not submitted, with their status, exemption and submission summary.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },\n    { \"id\": \"FR-55\", \"description\": \"GET /api/submissions/:id is open to the submitting student, their parents and course managers. SubmissionHistory is included only for managers.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },\n    { \"id\": \"FR-56\", \"description\": \"PUT /api/submissions/:id/grade (manage) {rawScore, penaltyPercent, feedback, rubricScores} sets gradedById/gradedAt and the computed finalScore.\", \"confidence\": \"HIGH\", \"source\": \"API table; FR-5.3\" },\n    { \"id\": \"FR-57\", \"description\": \"GET /api/me/assignments?studentId=&tab= (any role) returns the role-shaped data for /assignments. studentId is accepted for parents (it must be a linked child).\", \"confidence\": \"HIGH\", \"source\": \"API table; FR-6.1\" },\n    { \"id\": \"FR-58\", \"description\": \"GET /api/students/:id/assignments (view student; uses the existing assertCanViewStudent) returns the per-student assignment list.\", \"confidence\": \"HIGH\", \"source\": \"API table; FR-6.2\" },\n    { \"id\": \"FR-59\", \"description\": \"Grading, returning, exempting and offline grading change records owned by a student, so each writes an AuditLog row through the existing audit().\", \"confidence\": \"MEDIUM\", \"source\": \"Platform Context › Code layout (mutations on records owned by someone else write AuditLog)\" },\n    { \"id\": \"FR-60\", \"description\": \"Assignments with submissionType NO_SUBMISSION are not counted as Missing and trigger no due_soon or missing reminders. They are graded offline only.\", \"confidence\": \"LOW\", \"source\": \"FR-1 (NO_SUBMISSION; offline grading paragraph); Seed Data (SCI-7A NO_SUBMISSION graded offline) — the missing/reminder behaviour is not specified\" },\n    { \"id\": \"FR-61\", \"description\": \"Seed data: MATH-7A gets 4 assignments (one returned with all students graded at 55–100 %; one submitted and awaiting grading with 60 % submitted and 2 late; one due in 2 days; one draft). ENG-7A gets 2 (one with a 3-criterion rubric, returned). SCI-7A gets 1 NO_SUBMISSION assignment graded offline. The seed is idempotent and skips when those courses do not exist.\", \"confidence\": \"HIGH\", \"source\": \"Seed Data\" }\n  ],\n\n  \"nonFunctionalRequirements\": [\n    { \"id\": \"NFR-1\", \"description\": \"Correctness: all score arithmetic uses Decimal end to end (Prisma.Decimal / decimal.js, which ships with Prisma), never JS floating point. Final scores round half-up to 2 dp.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements 1\" },\n    { \"id\": \"NFR-2\", \"description\": \"Integrity: submission, deadline, late-day, visibility and reminder checks use server time only. Client timestamps are never trusted.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements 2\" },\n    { \"id\": \"NFR-3\", \"description\": \"Performance: the grading screen switches between students in under 300 ms by prefetching the next and previous submissions.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements 3; Goals 3\" },\n    { \"id\": \"NFR-4\", \"description\": \"Privacy: students never see other students' submissions, scores or files, in the API or through the file URLs.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements 4; Acceptance Criteria 10\" },\n    { \"id\": \"NFR-5\", \"description\": \"Access control is enforced server-side on every handler and server page through requireUser/requireRole and the existing assertCanViewCourse, assertCanManageCourse and assertCanViewStudent. Hiding UI is never the only protection.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout (requireRole.ts); Roles\" },\n    { \"id\": \"NFR-6\", \"description\": \"UI component rule: Material UI v9.5.0 and MUI X only, styled through the theme, sx and styled(). No banned libraries, enforced by the ESLint no-restricted-imports rule. Every component (List, Chip, ToggleButtonGroup, Dialog, Tabs, DataTable/DataGrid, DateTimePicker, Autocomplete, Snackbar via useToast) is looked up through mui-mcp (useMuiDocs → fetchDocs) before use. If mui-mcp is unreachable, that is a blocker. QA verifies there are no banned imports and that every MUI import is documented.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › UI component rule (1–6)\" },\n    { \"id\": \"NFR-7\", \"description\": \"API conventions: route handlers are thin (Zod → service → JSON). They use the {data} / list {data,page,pageSize,total} / {error:{code,message,details}} envelopes and the standard error codes. Pagination defaults to 20 (max 100), with ?sort=&order= and ?q=.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout and conventions\" },\n    { \"id\": \"NFR-8\", \"description\": \"Code layout: business logic goes in src/server/assignments/assignments-service.ts (the PRD-05 feature-subdirectory precedent). Zod schemas go in src/lib/validators/assignments.ts. Routes go under src/app/api/{courses,assignments,submissions,me,students}/…. Pages go under src/app/(app)/….\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout and conventions\" },\n    { \"id\": \"NFR-9\", \"description\": \"Time handling: timestamps are stored in UTC and displayed in SchoolSettings.timezone. The late-day calculation is correct across a DST change in the school timezone and on the exact 24 h boundary (exactly 24 h late = 1 day).\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout (UTC/school tz); Test Requirements (DST, exact 24 h boundary)\" },\n    { \"id\": \"NFR-10\", \"description\": \"Markdown (instructions, submission text, feedback) is rendered with react-markdown + remark-gfm + rehype-sanitize, with every element mapped to an MUI component.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.2 (sanitised Markdown); UI component rule 4\" },\n    { \"id\": \"NFR-11\", \"description\": \"Brownfield reuse: never re-scaffold, rename existing routes or models, or duplicate existing helpers. Reuse notify(), notifyStudentAndParents(), audit(), registerFileAccess/contexts, the files service and /api/files, the DataTable, ConfirmDialog, EmptyState, PageHeader and useToast components, formatInSchoolTz, and the courseTabs/studentTabs registries.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context (reuse paragraph)\" },\n    { \"id\": \"NFR-12\", \"description\": \"Committed code has no console.log. Use the logger from src/lib/logger.ts.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout and conventions\" },\n    { \"id\": \"NFR-13\", \"description\": \"Quality gate: npm run lint, npm run typecheck and npm run test keep passing.\", \"confidence\": \"HIGH\", \"source\": \"Assumptions and constraints (Constraints)\" },\n    { \"id\": \"NFR-14\", \"description\": \"Unit tests cover: the late-days calculation (exact 24 h boundary, DST change), the penalty cap, final-score rounding and rubric-sum validation. Integration tests cover: resubmission history, the return flow, reminder idempotency and the effect of exemptions on the missing list. A Playwright e2e covers: teacher creates → student submits a file → teacher grades with a rubric and returns → student sees feedback; parent sees the missing list.\", \"confidence\": \"HIGH\", \"source\": \"Test Requirements\" },\n    { \"id\": \"NFR-15\", \"description\": \"Scope guard: no plagiarism detection, peer review, group assignments, inline document annotation, or gradebook weighting / term grades (PRD-11 consumes these scores). Do not change behaviour owned by later PRDs.\", \"confidence\": \"HIGH\", \"source\": \"Out of Scope; Assumptions and constraints\" },\n    { \"id\": \"NFR-16\", \"description\": \"Usability goals: a teacher can create and publish an assignment in under 2 minutes, and can grade 30 submissions with the keyboard without leaving the grading screen.\", \"confidence\": \"HIGH\", \"source\": \"Goals 1, 3\" },\n    { \"id\": \"NFR-17\", \"description\": \"English-only UI, single school, support for evergreen browsers (last 2 versions of Chrome, Edge, Firefox and Safari), and basic accessibility (labelled inputs, keyboard-operable controls).\", \"confidence\": \"MEDIUM\", \"source\": \"Assumptions and constraints (Assumptions)\" }\n  ],\n\n  \"overallConfidencePct\": 0,\n\n  \"clarificationLog\": [\n    {\n      \"round\": 1,\n      \"questions\": [\n        \"FR-15: Does 'same relative due date' mean the identical due date-time, or the same offset from some per-course anchor such as the next class meeting in the timetable?\",\n        \"FR-13: Should a SCHEDULED assignment's status flip to PUBLISHED when availableFrom passes, or is visibility only computed?\",\n        \"FR-52: What may students, parents and teachers see or do with an archived assignment?\",\n        \"FR-60: Does a NO_SUBMISSION assignment ever count as Missing or trigger due_soon/missing reminders?\",\n        \"FR-10: Should 'next teaching day' skip holidays? (No holiday model exists before PRD-14.)\",\n        \"FR-36: With allowExtraCredit, can rubric level points also exceed criterion maximums, or is extra credit raw-score only?\",\n        \"FR-39/FR-6.1: What should ADMIN see on /assignments? The PRD defines only the STUDENT, PARENT and TEACHER views.\"\n      ],\n      \"unresolved\": [\n        \"FR-15: no interactive user. Default: keep the identical dueAt, and keep the availableFrom/lateCutoffAt offsets from dueAt.\",\n        \"FR-13: default: visibility is computed at read time, and the status stays SCHEDULED.\",\n        \"FR-52: default: archived assignments are hidden from students and parents, closed to new submissions, excluded from reminders, and still visible to managers (marked 'Archived').\",\n        \"FR-60: default: NO_SUBMISSION assignments are excluded from Missing and from reminders.\",\n        \"FR-10: default: use SchoolDay.isTeaching weekdays only.\",\n        \"FR-36: default: extra credit applies to rawScore only. Rubric points stay within each criterion's maximum.\",\n        \"ADMIN /assignments: default: show the TEACHER-style 'To grade' list across all courses.\"\n      ]\n    },\n    {\n      \"round\": 2,\n      \"questions\": [\n        \"Ticket ID: the PRD header says SCH-009, but the pipeline ticket is SH-9. Confirm that SH-9 is canonical for the artifacts.\"\n      ],\n      \"unresolved\": [\n        \"Ticket ID: proceeding with SH-9 (from the task prompt).\"\n      ]\n    }\n  ],\n\n  \"brownfieldFindings\": [\n    \"DEPENDENCY GAP (PRD-08 incomplete): SH-8 QA FAILED. 39 of 60 requirements are not implemented. The file backend exists: FileObject, storage.ts, src/server/files/{access,contexts,files-service,validate,purge}.ts, POST /api/files and GET /api/files/[id]?inline=1. The UI does not exist: there is no FileUpload, FileList, MarkdownView or Markdown editor. PRD-09 needs these UI components (FR-9, FR-19, FR-20, FR-29, FR-30).\",\n    \"The MUI X version mismatch persists: @mui/x-internals is 9.15.0, but @mui/x-data-grid 9.5.0 needs an older export. Every page that renders DataTable/DataGrid fails to compile, and FR-17 needs a DataTable.\",\n    \"vitest.config.ts imports 'vitest/config.js', which does not resolve, so `npm test` fails to start (NFR-13). vitest.tmp.config.ts works.\",\n    \"next.config.js has CSP script-src 'self', which blocks hydration in a real browser. Earlier e2e runs used bypassCSP.\",\n    \"studentTabs is not rendered by any page, so the FR-41 tab will not be visible until a tab bar exists. courseTabs IS rendered by src/app/(app)/courses/[courseId]/CourseTabs.tsx.\",\n    \"Already installed: react-markdown 10.1.0, remark-gfm 4.0.1, rehype-sanitize 6.0.0, @dnd-kit/sortable 10.0.0, file-type, and decimal.js (via Prisma). No new dependencies are needed.\",\n    \"Reusable: notifyStudentAndParents() in src/server/notifications/notify.ts; the maintenance hook in src/app/api/internal/email/dispatch/route.ts; registerBuiltInContexts in src/server/files/contexts.ts; the Course fields teacherId and coTeacherIds.\"\n  ],\n\n  \"status\": \"complete\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":402,"newStart":1,"newLines":147,"lines":[" {","-  \"ticketId\": \"SH-8\",","-  \"timestamp\": \"2026-11-06T06:00:00Z\",","+  \"ticketId\": \"SH-9\",","+  \"timestamp\": \"2026-11-09T09:00:00Z\",","   \"phase\": \"intake\",","   \"version\": \"1.0\",","-  \"prd\": \"PRD-08: File Storage & Course Content (Modules and Lessons) (SCH-008)\",","+  \"prdTitle\": \"PRD-09: Assignments & Submissions\",","+  \"prdTicketRef\": \"SCH-009 (PRD header). The pipeline ticket is SH-9.\",","   \"runMode\": \"--brownfield --tech-stack react\",","-  \"brownfieldFindings\": [","-    \"Ticket id: the task prompt says SH-8 and the PRD header says SCH-008. All artifacts use SH-8. The artifacts/intake files that were there before belonged to SH-7 and are overwritten.\",","-    \"GREENFIELD FEATURE: the workspace has no file storage or course content code yet. There are no FileObject/Module/Lesson/LessonAttachment/LessonLink/LessonProgress models, no ContentStatus enum, no src/server/storage.ts, no src/server/files/, no content routes or pages, and no UPLOAD_DIR/MAX_UPLOAD_MB entries in .env.example.\",","-    \"MISSING DEPENDENCIES: the PRD needs file-type, react-markdown, remark-gfm, rehype-sanitize and @dnd-kit/sortable, and none of them are in package.json. @dnd-kit/core 6.3.1 is installed. All of these are on the PRD's allowed list of non-visual libraries.\",","-    \"REUSE: assertCanViewCourse()/assertCanManageCourse() in src/server/auth/course-access.ts, assertCanViewStudent()/getAccessibleStudentIds() in src/server/auth/student-access.ts, and requireUser()/requireRole() in src/server/auth/requireRole.ts.\",","-    \"REUSE: rateLimit(key, limit, windowMs) in src/server/rate-limit.ts (a per-process sliding window) for the 60 uploads/hour limit. audit() comes from src/server/audit.ts, notify() from src/server/notifications/notify.ts, and the type keys live in NOTIFICATION_TYPES in src/server/notifications/types.ts.\",","-    \"REUSE: the course tab registry src/config/course-tabs.ts (currently overview, roster and attendance) and the student tab registry src/config/student-tabs.ts (currently courses and attendance). The 'Content' and 'Learning' tabs are added there.\",","-    \"DAILY MAINTENANCE HOOK: PRD-04's 'daily maintenance run' is the once-per-day purgeOldNotifications() call inside src/app/api/internal/email/dispatch/route.ts, which is gated by an in-memory lastPurgeAt. purgeOrphanFiles() should be called next to it.\",","-    \"LOGO: SchoolSettings.logoUrl (String?) is in prisma/schema.prisma:195 and in UpdateSchoolSettingsInput (src/server/services/settings.ts), the email BaseLayout and render.ts use it, and PATCH /api/settings/school exists. However, there is NO /admin/settings/school page in src/app/(app)/admin/, so FR-9's 'replace the logo URL field' has no field to replace.\",","-    \"SHARED COMPONENTS: they live in src/components/<Name>/ (DataTable, ConfirmDialog, EmptyState, FormField, PageHeader, Toast/useToast, UserPicker...), not in src/components/shared/. New shared components (FileUpload, FileList, MarkdownView) should follow the existing src/components/<Name>/ layout.\",","-    \"No .gitignore was found at the workspace root. UPLOAD_DIR (./uploads) must be git-ignored, so either create one or add the entry if a .gitignore exists elsewhere.\",","-    \"VERIFIED: assertCanViewCourse already allows PARENT when a linked student has an ACTIVE enrollment, and STUDENT only when ACTIVE-enrolled. Use it unchanged.\"","-  ],","+","   \"functionalRequirements\": [","-    {","-      \"id\": \"FR-1\",","-      \"description\": \"Add the FileObject Prisma model (ownerId→User, originalName, mimeType, sizeBytes, unique storageKey '<yyyy>/<mm>/<cuid>.<ext>', sha256, context, nullable contextId, createdAt, index on [context, contextId]) with a migration.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1 File storage (Prisma block)\"","-    },","-    {","-      \"id\": \"FR-2\",","-      \"description\": \"Create src/server/storage.ts exposing saveFile(stream, meta), readFile(storageKey) and deleteFile(storageKey). It writes under UPLOAD_DIR (new env var, default ./uploads, git-ignored) and never inside public/.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.1\"","-    },","-    {","-      \"id\": \"FR-3\",","-      \"description\": \"POST /api/files (multipart, any signed-in user) accepts one file plus context and creates a FileObject with contextId null.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.2; API table\"","-    },","-    {","-      \"id\": \"FR-4\",","-      \"description\": \"Enforce a per-file size limit of MAX_UPLOAD_MB (env, default 25). Oversize uploads are rejected with VALIDATION_ERROR 'File exceeds 25 MB.'\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.2\"","-    },","-    {","-      \"id\": \"FR-5\",","-      \"description\": \"Allow only pdf, doc, docx, xls, xlsx, ppt, pptx, txt, csv, png, jpg, jpeg, gif, webp, mp3, mp4 and zip, validated by extension AND by magic-number sniffing with the file-type package. Anything else is rejected with VALIDATION_ERROR 'File type .<ext> is not allowed.'\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.2; Acceptance Criterion 4\"","-    },","-    {","-      \"id\": \"FR-6\",","-      \"description\": \"Text formats with no magic number (txt, csv) and Office OOXML formats that sniff as zip (docx/xlsx/pptx) are accepted when the sniffed type is absent or consistent with the extension. Executable or mismatched signatures are rejected.\",","-      \"confidence\": \"MEDIUM\",","-      \"source\": \"FR-1.2 (inferred: file-type cannot detect txt/csv; OOXML sniffs as zip container)\"","-    },","-    {","-      \"id\": \"FR-7\",","-      \"description\": \"Sanitise filenames: strip path separators and control characters and cap the length at 150 characters, then store the result as originalName.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.3\"","-    },","-    {","-      \"id\": \"FR-8\",","-      \"description\": \"GET /api/files/:id streams the file with the stored MIME type, X-Content-Type-Options: nosniff, and Content-Disposition: attachment. It uses inline for images and PDFs only when ?inline=1.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.4; API table\"","-    },","-    {","-      \"id\": \"FR-9\",","-      \"description\": \"Add a file access resolver registry src/server/files/access.ts with registerFileAccess(context, (user, file) => boolean | Promise<boolean>). An unknown context allows only the owner and ADMIN. Denied requests return 404/403 without streaming any bytes.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.4; Acceptance Criterion 3\"","-    },","-    {","-      \"id\": \"FR-10\",","-      \"description\": \"Register the 'lesson' file context (allowed when the user can view the lesson under the visibility rules) and the 'logo' context (public, including unauthenticated users).\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.4\"","-    },","-    {","-      \"id\": \"FR-11\",","-      \"description\": \"DELETE /api/files/:id is allowed for the owner or ADMIN, only while the file is unattached (contextId null). It removes both the row and the stored bytes.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"API table\"","-    },","-    {","-      \"id\": \"FR-12\",","-      \"description\": \"purgeOrphanFiles() deletes FileObjects with contextId null that are older than 24 hours, together with their stored bytes. It is called from PRD-04's daily maintenance run.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.5\"","-    },","-    {","-      \"id\": \"FR-13\",","-      \"description\": \"Add a reusable MUI FileUpload component: a Paper drop zone with a dashed border, Button component='label' with a visually hidden input, multiple files, a per-file LinearProgress driven by XHR upload progress, and a List of files showing name, size, type icon and a remove button.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.6\"","-    },","-    {","-      \"id\": \"FR-14\",","-      \"description\": \"Add a FileList component that shows attached files with download links to /api/files/:id.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-1.6\"","-    },","-    {","-      \"id\": \"FR-15\",","-      \"description\": \"Add the ContentStatus enum (DRAFT, SCHEDULED, PUBLISHED) and the Module, Lesson, LessonAttachment, LessonLink and LessonProgress models exactly as specified, including the cascade deletes and the composite PK [lessonId, studentId] on LessonProgress.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-2 Content data model\"","-    },","-    {","-      \"id\": \"FR-16\",","-      \"description\": \"Validate content fields with Zod in src/lib/validators/content.ts: module title ≤120, lesson title ≤150, contentMarkdown ≤100,000 chars, estimatedMinutes 1–600, link URLs http(s) only, and videoUrl YouTube/Vimeo only.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-2 field comments; Code layout (validators)\"","-    },","-    {","-      \"id\": \"FR-17\",","-      \"description\": \"Attaching a file to a lesson sets FileObject.context='lesson' and contextId=lessonId. Only files owned by the caller (or any file, for ADMIN) that are still unattached can be attached.\",","-      \"confidence\": \"MEDIUM\",","-      \"source\": \"FR-1 (contextId 'id of the owning record once attached'); FR-5.2\"","-    },","-    {","-      \"id\": \"FR-18\",","-      \"description\": \"Visibility rule: a lesson is visible to STUDENT/PARENT only when both the lesson and its module are PUBLISHED, or SCHEDULED with publishAt <= now. This is evaluated at read time with no background job.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-3.1; Acceptance Criterion 2\"","-    },","-    {","-      \"id\": \"FR-19\",","-      \"description\": \"TEACHER (managing the course) and ADMIN see all modules and lessons with a status badge: Draft grey, Scheduled blue with date, Published green.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-3.2\"","-    },","-    {","-      \"id\": \"FR-20\",","-      \"description\": \"Register a 'Content' course tab for every role that can view the course. It shows modules as ordered MUI Accordions, each listing lessons with title, estimated minutes, attachment count and, for students, a completion check.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-4.1\"","-    },","-    {","-      \"id\": \"FR-21\",","-      \"description\": \"Students see a per-module progress bar ('3 of 5 complete'), a course-level progress bar and a 'Continue' button that opens the first incomplete visible lesson.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-4.2; Acceptance Criterion 5\"","-    },","-    {","-      \"id\": \"FR-22\",","-      \"description\": \"Teacher controls on the Content tab: 'Add module', a per-module menu (edit, publish now, schedule, unpublish, delete, move up/down) and 'Add lesson' per module.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-4.3\"","-    },","-    {","-      \"id\": \"FR-23\",","-      \"description\": \"Lessons can be reordered within and across modules with @dnd-kit/sortable drag handles on MUI Accordion/List items, with up/down IconButtons as the keyboard alternative. The order persists through POST /api/courses/:id/content/reorder with the full ordering { modules: [{ id, lessonIds: [] }] }.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-4.3; API table; Acceptance Criterion 7\"","-    },","-    {","-      \"id\": \"FR-24\",","-      \"description\": \"Deleting a module that contains lessons requires typing the module title in a confirmation Dialog.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-4.4\"","-    },","-    {","-      \"id\": \"FR-25\",","-      \"description\": \"Lesson editor page /courses/[courseId]/lessons/[lessonId]/edit has fields for title, estimated minutes and video URL, plus an MUI Markdown editor: Tabs Write/Preview, a multiline TextField, and a toolbar for bold, italic, headings, lists, link, code, quote, table and image.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-5.1\"","-    },","-    {","-      \"id\": \"FR-26\",","-      \"description\": \"Toolbar image insert uploads through POST /api/files (context 'lesson') and inserts ![alt](/api/files/<id>?inline=1). The editor shows a warning when alt text is missing.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-5.1; NFR Accessibility\"","-    },","-    {","-      \"id\": \"FR-27\",","-      \"description\": \"The lesson editor has an attachments section (FileUpload with reorder) and a links section (title + URL rows). Both are saved via PATCH /api/lessons/:id as attachments and links arrays.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-5.2; API table\"","-    },","-    {","-      \"id\": \"FR-28\",","-      \"description\": \"Lesson status controls are Save draft, Publish now, and Schedule. Schedule uses an MUI date-time picker in the school timezone and the time must be in the future.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-5.3\"","-    },","-    {","-      \"id\": \"FR-29\",","-      \"description\": \"Autosave the draft every 10 seconds while there are unsaved changes, show a 'Saved HH:mm' indicator, and warn on navigation away when changes are unsaved.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-5.4\"","-    },","-    {","-      \"id\": \"FR-30\",","-      \"description\": \"Video URL parser: accept youtube.com/watch?v=, youtu.be/ and vimeo.com/<id> and store the URL as entered. Render it as a privacy-enhanced embed (youtube-nocookie.com/embed/<id>, player.vimeo.com/video/<id>) in a 16:9 responsive iframe with a title attribute.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-5.5; Acceptance Criterion 1\"","-    },","-    {","-      \"id\": \"FR-31\",","-      \"description\": \"Add a shared MarkdownView component that uses react-markdown + remark-gfm + rehype-sanitize (default schema plus img from same origin only) and maps every element to MUI (Typography, Link, Table*, Divider, List/ListItem, Box component='pre'). External links open in a new tab with rel='noopener noreferrer'.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-6.1; Acceptance Criterion 6\"","-    },","-    {","-      \"id\": \"FR-32\",","-      \"description\": \"Lesson viewer /courses/[courseId]/lessons/[lessonId] shows the video embed, attachment list, links, estimated time and Previous/Next navigation across modules, limited to lessons visible to the caller.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-6.2\"","-    },","-    {","-      \"id\": \"FR-33\",","-      \"description\": \"For students, the first lesson view upserts LessonProgress.firstViewedAt, and a 'Mark as complete' button toggles completedAt via POST /api/lessons/:id/progress { completed }. Only ACTIVE enrolled students may do this.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-6.3; API table\"","-    },","-    {","-      \"id\": \"FR-34\",","-      \"description\": \"Teachers get a 'Progress' Drawer on the lesson viewer that lists enrolled students with Viewed/Completed status and dates, served by GET /api/lessons/:id/progress (manage).\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-6.4; API table\"","-    },","-    {","-      \"id\": \"FR-35\",","-      \"description\": \"Register a 'Learning' student tab showing per-course content progress (course, lessons completed / visible, percentage, last activity) via GET /api/students/:id/learning (assertCanViewStudent).\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-7.1; API table\"","-    },","-    {","-      \"id\": \"FR-36\",","-      \"description\": \"Parents can open linked children's course content and lessons read-only, with no 'Mark as complete' button.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-7.2; Acceptance Criterion 8\"","-    },","-    {","-      \"id\": \"FR-37\",","-      \"description\": \"Parents can view a course's Content tab only when a linked student is ACTIVE-enrolled. The existing assertCanViewCourse already enforces this (verified in src/server/auth/course-access.ts PARENT branch), so reuse it as is.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-7.2; Roles (parents see data for linked students)\"","-    },","-    {","-      \"id\": \"FR-38\",","-      \"description\": \"Register the notification type content.lesson_published (category ACADEMIC, default email false). 'Publish now' that makes a lesson visible notifies ACTIVE enrolled students.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-8.1\"","-    },","-    {","-      \"id\": \"FR-39\",","-      \"description\": \"Scheduled lessons send no notification when publishAt passes. The Schedule control shows the tooltip 'Scheduled lessons appear automatically without a notification.'\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-8.2\"","-    },","-    {","-      \"id\": \"FR-40\",","-      \"description\": \"Logo upload: the school settings page uses FileUpload (single image, PNG/JPG/WebP/SVG, max 2 MB, context 'logo') instead of a logo URL field, and stores the resulting /api/files/<id> URL in SchoolSettings.logoUrl.\",","-      \"confidence\": \"MEDIUM\",","-      \"source\": \"FR-9.1 (storage of the URL in logoUrl inferred; existing column reused, no rename)\"","-    },","-    {","-      \"id\": \"FR-41\",","-      \"description\": \"SVG is allowed only for context 'logo'. SVG logo files are served with Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"FR-9.1\"","-    },","-    {","-      \"id\": \"FR-42\",","-      \"description\": \"/admin/settings/school does not exist in the workspace. Create a minimal ADMIN page there that uses the existing PATCH /api/settings/school, holds the logo FileUpload, and adds an nav entry if none exists.\",","-      \"confidence\": \"LOW\",","-      \"source\": \"FR-9.1 (references a page from PRD-02 not found in src/app/(app)/admin/)\"","-    },","-    {","-      \"id\": \"FR-43\",","-      \"description\": \"Content API: GET/POST /api/courses/:id/modules (GET filters by visibility per role and includes lessons and the caller's progress), PATCH/DELETE /api/modules/:id, POST /api/modules/:id/lessons, GET/PATCH/DELETE /api/lessons/:id, using the PRD response/error envelope and the access checks in the API table.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"API table; Code layout (response shape)\"","-    },","-    {","-      \"id\": \"FR-44\",","-      \"description\": \"GET /api/lessons/:id returns NOT_FOUND to STUDENT/PARENT callers when the lesson is not visible under the visibility rules.\",","-      \"confidence\": \"MEDIUM\",","-      \"source\": \"API table ('view (visibility rules)'); FR-3.1\"","-    },","-    {","-      \"id\": \"FR-45\",","-      \"description\": \"Content business logic lives in src/server/content/content-service.ts and file logic in src/server/files/. Route handlers stay thin (Zod → service → JSON).\",","-      \"confidence\": \"MEDIUM\",","-      \"source\": \"Code layout and conventions (feature-named subdirectory precedent)\"","-    },","-    {","-      \"id\": \"FR-46\",","-      \"description\": \"Teacher/admin mutations on content owned by another user (for example an admin editing a teacher's lesson, or deleting someone else's file) write an AuditLog row via audit().\",","-      \"confidence\": \"MEDIUM\",","-      \"source\": \"Code layout and conventions (AuditLog rule)\"","-    },","-    {","-      \"id\": \"FR-47\",","-      \"description\": \"Seed data: MATH-7A gets 3 modules ('Number Sense', 'Fractions', 'Geometry Basics') with 3 published lessons each of realistic Markdown, one with a YouTube video and one with a seeded PDF from prisma/seed-assets/, plus one draft lesson and one lesson scheduled 7 days ahead. ENG-7A gets 2 modules × 2 lessons. Sam has completed 4 MATH-7A lessons.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Seed Data\"","-    },","-    {","-      \"id\": \"FR-48\",","-      \"description\": \"Tests: unit tests for the filename sanitiser, video URL parser, visibility rule and access registry dispatch; integration tests for upload → attach → download with access checks and for the orphan purge; a Playwright test where a teacher creates and publishes a lesson with an attachment and a student completes it.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Test Requirements\"","-    }","+    { \"id\": \"FR-1\", \"description\": \"Add the Prisma enums SubmissionType (ONLINE_TEXT, FILE_UPLOAD, TEXT_AND_FILE, NO_SUBMISSION), AssignmentStatus (DRAFT, SCHEDULED, PUBLISHED) and SubmissionStatus (SUBMITTED, RETURNED) in a new prisma migrate migration.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 Data model (enum block)\" },","+    { \"id\": \"FR-2\", \"description\": \"Add an Assignment model with the fields listed in FR-1. Also add allowExtraCredit Boolean @default(false) (from FR-5.6), notifiedAt DateTime? (from FR-7.1) and archivedAt DateTime? (from the API table). Add a Course→Assignment relation (onDelete Cascade), a rubricId @unique relation to Rubric, and @@index([courseId, dueAt]).\", \"confidence\": \"HIGH\", \"source\": \"FR-1 model Assignment; FR-5.6; FR-7.1; API table (DELETE row)\" },","+    { \"id\": \"FR-3\", \"description\": \"Add the models AssignmentAttachment (assignment↔FileObject), Rubric and RubricCriterion. RubricCriterion has title, description?, maxPoints Decimal(6,2), order, and levels Json [{label, points, description}].\", \"confidence\": \"HIGH\", \"source\": \"FR-1 models AssignmentAttachment, Rubric, RubricCriterion\" },","+    { \"id\": \"FR-4\", \"description\": \"Add the models Submission (@@unique([assignmentId, studentId]), with Decimal rawScore/penaltyPercent/finalScore and Json rubricScores [{criterionId, points, comment}]), SubmissionFile (submission↔FileObject) and SubmissionHistory (attemptNumber, text, fileIds String[], submittedAt).\", \"confidence\": \"HIGH\", \"source\": \"FR-1 models Submission, SubmissionFile, SubmissionHistory\" },","+    { \"id\": \"FR-5\", \"description\": \"Add a GradeExemption model with a composite id (assignmentId, studentId), an optional reason and createdAt.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 model GradeExemption\" },","+    { \"id\": \"FR-6\", \"description\": \"Add an AssignmentReminder table {assignmentId, studentId, kind} with a unique key on all three columns. It makes the due_soon and missing reminders idempotent.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.2 (AssignmentReminder table)\" },","+    { \"id\": \"FR-7\", \"description\": \"Enforce the field limits in Zod schemas in src/lib/validators/assignments.ts, shared by forms and handlers: title ≤150; instructions ≤50,000; maxPoints 0–1000; lateCutoffAt > dueAt; latePenaltyPercentPerDay and maxLatePenaltyPercent 0–100; maxFileCount 1–10; submission text ≤50,000; feedback ≤10,000.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 field comments; Platform Context › Fixed technology decisions (Validation)\" },","+    { \"id\": \"FR-8\", \"description\": \"A teacher can record a grade for a student who did not submit. The service creates a Submission with text = null, no files, submittedAt = gradedAt and attemptNumber = 0 (the offline/no-submission marker).\", \"confidence\": \"HIGH\", \"source\": \"FR-1 (paragraph after the schema); FR-5.5\" },","+","+    { \"id\": \"FR-9\", \"description\": \"Build the create/edit page at /courses/[courseId]/assignments/new. Fields: title, Markdown instructions (the PRD-08 editor), attachments (FileUpload, context 'assignment'), submission type, max points, due date-time (school timezone), optional available-from, late policy (allow-late toggle → cutoff, penalty per day, maximum penalty), maximum file count, allow extra credit, and an optional rubric builder.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.1; FR-5.6\" },","+    { \"id\": \"FR-10\", \"description\": \"Default the due date-time to the next teaching day at 23:59 in the school timezone. 'Teaching day' is taken from the existing SchoolDay.isTeaching weekday table, because holidays are not modelled before PRD-14.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-2.1 (default next teaching day 23:59); prisma SchoolDay model (PRD-06)\" },","+    { \"id\": \"FR-11\", \"description\": \"Rubric builder: add, reorder and remove criteria (title, description, levels with label + points + description). The sum of the criterion maximums must equal max points. Otherwise show the inline error 'Rubric totals {sum} points but the assignment is worth {maxPoints}.', and the server rejects the save with VALIDATION_ERROR.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.2; Acceptance Criteria 5\" },","+    { \"id\": \"FR-12\", \"description\": \"Offer 'Save draft' (DRAFT), 'Publish' (PUBLISHED) and 'Schedule' (SCHEDULED). Schedule requires an available-from in the future, and the assignment stays hidden from students and parents until then.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.3; FR-1 (availableFrom comment)\" },","+    { \"id\": \"FR-13\", \"description\": \"A SCHEDULED assignment counts as visible once availableFrom ≤ server now. Visibility is computed at read time. No background job rewrites the status to PUBLISHED.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-2.3 ('becomes visible then'); FR-7.1 ('when scheduled becomes visible on first student list load')\" },","+    { \"id\": \"FR-14\", \"description\": \"Editing the due date or max points of a published assignment that has submissions shows a warning. Changing max points recalculates nothing: existing scores are kept, and a banner prompts the teacher to review grades.\", \"confidence\": \"HIGH\", \"source\": \"FR-2.4\" },","+    { \"id\": \"FR-15\", \"description\": \"A 'Duplicate to other courses' action copies the assignment as DRAFT to selected courses the teacher manages (POST /api/assignments/:id/duplicate {courseIds}). The copy keeps the instructions, attachments, settings and rubric. The copy keeps the same due date-time, and availableFrom/lateCutoffAt keep their offsets from dueAt.\", \"confidence\": \"LOW\", \"source\": \"FR-2.5 ('with the same relative due date'); API table (duplicate row)\" },","+","+    { \"id\": \"FR-16\", \"description\": \"Register an 'Assignments' tab in src/config/course-tabs.ts for all roles that can view the course.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1; Platform Context › Code layout and conventions\" },","+    { \"id\": \"FR-17\", \"description\": \"Teacher/admin view of the course Assignments tab: a table with title, due date, status, submitted/total, graded/submitted and a 'Grade' button.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1 (teacher view)\" },","+    { \"id\": \"FR-18\", \"description\": \"Student view of the course Assignments tab: a list grouped as Upcoming, Past due (missing), Submitted and Returned. Parents see the same view, read-only, for their linked child.\", \"confidence\": \"HIGH\", \"source\": \"FR-3.1 (student view, parent view)\" },","+","+    { \"id\": \"FR-19\", \"description\": \"The assignment page /courses/[courseId]/assignments/[assignmentId] shows the instructions (sanitised Markdown), attachments, due date, late policy summary, rubric (if any) and the submission panel. When under 48 hours remain, it adds a live countdown such as 'Due in 5 h 12 min'.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.1\" },","+    { \"id\": \"FR-20\", \"description\": \"The submission panel shows a Markdown text editor and/or file upload, depending on submissionType (NO_SUBMISSION shows neither). File upload respects maxFileCount. Draft text autosaves to localStorage only, never to the server.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.2\" },","+    { \"id\": \"FR-21\", \"description\": \"Clicking Submit opens a confirmation Dialog before the POST.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.3\" },","+    { \"id\": \"FR-22\", \"description\": \"Server submission rules: the assignment is visible; the student is ACTIVE-enrolled in the course; the student is not exempt. If now > dueAt, allowLate must be true and now ≤ lateCutoffAt (when set). Otherwise return VALIDATION_ERROR 'The deadline has passed and late submissions are closed.'\", \"confidence\": \"HIGH\", \"source\": \"FR-4.3; Acceptance Criteria 2\" },","+    { \"id\": \"FR-23\", \"description\": \"On submit, compute isLate = submittedAt > dueAt and lateDays = ceil((submittedAt − dueAt) / 24h), using server time. For example, due Mon 23:59 and submitted Wed 10:00 gives lateDays = 2.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.4; Acceptance Criteria 1\" },","+    { \"id\": \"FR-24\", \"description\": \"Resubmission is allowed until dueAt (or lateCutoffAt / indefinitely when late is allowed) and only while status = SUBMITTED. It copies the previous attempt into SubmissionHistory, increments attemptNumber, and clears rawScore, penaltyPercent, finalScore, feedback, rubricScores, gradedById and gradedAt. Once the work is RETURNED, resubmission is refused.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.5; Acceptance Criteria 3, 4\" },","+    { \"id\": \"FR-25\", \"description\": \"After submitting, the student sees a receipt such as 'Submitted Mon 14 Sep 2026, 21:04 (attempt 2)', in the school timezone, plus the files and text submitted.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.6\" },","+    { \"id\": \"FR-26\", \"description\": \"After return, the student sees the final score, rubric breakdown, feedback and the late penalty applied.\", \"confidence\": \"HIGH\", \"source\": \"FR-4.7\" },","+    { \"id\": \"FR-27\", \"description\": \"Until the work is returned, the student and parent see 'Submitted — awaiting grading'. No score, rubric scores or feedback are sent in the API response.\", \"confidence\": \"HIGH\", \"source\": \"Acceptance Criteria 7; FR-5.4 ('Save' = not yet visible to student)\" },","+","+    { \"id\": \"FR-28\", \"description\": \"Grading page /courses/[courseId]/assignments/[assignmentId]/grade, left panel: an MUI List of all enrolled students with status Chips (Not submitted, Submitted, Late, Graded, Returned, Exempt), a status filter, and sorting by name or submission time.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.1\" },","+    { \"id\": \"FR-29\", \"description\": \"Grading main panel: the selected submission's text as sanitised Markdown, and its files listed with inline preview for images and PDFs (<img>/<iframe> to /api/files/:id?inline=1, which already exists). Previous attempts (SubmissionHistory) are available in a dropdown.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.2\" },","+    { \"id\": \"FR-30\", \"description\": \"Grading form. With a rubric, each criterion is an exclusive ToggleButtonGroup of levels, and the selected points auto-sum into the raw score (for example 8 + 9 → 17). Without a rubric, the raw score is entered directly. The late penalty is pre-filled as min(lateDays × perDay, maxPenalty) and can be overridden. The final score is computed live. There is a Markdown feedback editor.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.3; Acceptance Criteria 1, 6\" },","+    { \"id\": \"FR-31\", \"description\": \"finalScore = rawScore × (1 − penaltyPercent/100), rounded half-up to 2 dp. For example, raw 18 with 20 % → 14.40. It is computed server-side at grading time.\", \"confidence\": \"HIGH\", \"source\": \"FR-1 (finalScore comment); NFR-1 Correctness; Acceptance Criteria 1\" },","+    { \"id\": \"FR-32\", \"description\": \"Grading buttons: 'Save' (graded, not visible to the student), 'Save & return' (returns this submission and sets returnedAt) and the bulk 'Return all graded' (POST /api/assignments/:id/return; submissionIds optional, defaults to all graded and unreturned).\", \"confidence\": \"HIGH\", \"source\": \"FR-5.4; API table (return row)\" },","+    { \"id\": \"FR-33\", \"description\": \"Keyboard shortcuts on the grading screen: J = next student, K = previous student, Ctrl+Enter = save and go to the next student. The shortcuts are not captured while typing in text fields, except Ctrl+Enter.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-5.4; Goals 3\" },","+    { \"id\": \"FR-34\", \"description\": \"'Grade without submission' for students who did not submit (POST /api/assignments/:id/grade-offline {studentId, rawScore, feedback}). It creates the attemptNumber = 0 Submission described in FR-8.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.5; FR-1 paragraph; API table\" },","+    { \"id\": \"FR-35\", \"description\": \"An 'Exempt' toggle (PUT/DELETE /api/assignments/:id/exemptions/:studentId) writes or deletes a GradeExemption. Exempt students are removed from missing counts and lists, get no due_soon or missing reminders, cannot submit, and are flagged for exclusion from future gradebook calculation (PRD-11).\", \"confidence\": \"HIGH\", \"source\": \"FR-5.5; FR-4.3 (not exempt); FR-6.1 (Missing not exempt); API table\" },","+    { \"id\": \"FR-36\", \"description\": \"Validate scores server-side: rawScore and the rubric points must be within 0..maxPoints. When allowExtraCredit is true, rawScore may go up to 120 % of maxPoints. penaltyPercent must be 0–100.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.6; FR-1 (penaltyPercent range)\" },","+","+    { \"id\": \"FR-37\", \"description\": \"Build the /assignments page for STUDENT. It lists every assignment across the student's ACTIVE enrollments in four tabs: Upcoming (sorted by due date), Missing (past due, not submitted, not exempt), Submitted and Returned. There is a course filter.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1; Goals 2\" },","+    { \"id\": \"FR-38\", \"description\": \"The /assignments page for PARENT has a child selector (linked students only) and shows the same content as the student view, read-only.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1 (PARENT)\" },","+    { \"id\": \"FR-39\", \"description\": \"The /assignments page for TEACHER is a 'To grade' list of submitted, ungraded submissions across the courses they teach (teacherId or coTeacherIds), oldest first.\", \"confidence\": \"HIGH\", \"source\": \"FR-6.1 (TEACHER)\" },","+    { \"id\": \"FR-40\", \"description\": \"Add an 'Assignments' nav entry for /assignments to src/config/navigation.ts for STUDENT, PARENT and TEACHER.\", \"confidence\": \"MEDIUM\", \"source\": \"Platform Context › Code layout ('A PRD that adds a page adds its nav entry'); FR-6.1\" },","+    { \"id\": \"FR-41\", \"description\": \"Register an 'Assignments' student tab in src/config/student-tabs.ts. It shows the same per-student data to teachers and admins who view the student (GET /api/students/:id/assignments).\", \"confidence\": \"HIGH\", \"source\": \"FR-6.2; API table\" },","+","+    { \"id\": \"FR-42\", \"description\": \"Register and send assignment.published to ACTIVE-enrolled students (in-app; email default false). It is sent on publish, or for SCHEDULED assignments on the first student list load after availableFrom. It is sent exactly once, using Assignment.notifiedAt (set atomically).\", \"confidence\": \"HIGH\", \"source\": \"FR-7.1\" },","+    { \"id\": \"FR-43\", \"description\": \"Register and send assignment.due_soon to students with no submission (and not exempt) once dueAt − 24 h has passed and before dueAt. sendDueReminders() runs on every PRD-04 maintenance dispatcher call (src/app/api/internal/email/dispatch/route.ts). It is idempotent via the AssignmentReminder unique key (kind 'due_soon').\", \"confidence\": \"HIGH\", \"source\": \"FR-7.2; Acceptance Criteria 8\" },","+    { \"id\": \"FR-44\", \"description\": \"Register and send assignment.returned to the student and their parents through the existing notifyStudentAndParents(). The body includes course, title and score, for example 'Mathematics: Fractions worksheet — 18/20'.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.3\" },","+    { \"id\": \"FR-45\", \"description\": \"Register and send assignment.missing to parents only (email default true), once per student, 24 hours after dueAt if the student has still not submitted and is not exempt. It is idempotent via AssignmentReminder (kind 'missing') and runs in the same sendDueReminders() maintenance pass.\", \"confidence\": \"HIGH\", \"source\": \"FR-7.4; Acceptance Criteria 9\" },","+    { \"id\": \"FR-46\", \"description\": \"Add the four notification types to NOTIFICATION_TYPES in src/server/notifications/types.ts with the category ACADEMIC and the role lists that match their recipients.\", \"confidence\": \"MEDIUM\", \"source\": \"FR-7 ('Register and send'); Platform Context (notification type keys registered in types.ts)\" },","+    { \"id\": \"FR-47\", \"description\": \"Register two file access contexts in src/server/files/contexts.ts: 'assignment' (anyone who can view the assignment, with visibility rules applied) and 'submission' (the submitting student, their linked parents, course managers and admins). Any other user is denied.\", \"confidence\": \"HIGH\", \"source\": \"FR-8.1; Acceptance Criteria 10\" },","+","+    { \"id\": \"FR-48\", \"description\": \"GET /api/courses/:id/assignments (view course) returns a role-shaped list. Managers get every status with counts. Students and parents get only visible, non-archived assignments, with their own submission state.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },","+    { \"id\": \"FR-49\", \"description\": \"POST /api/courses/:id/assignments (manage course) creates an assignment with its rubric and attachments.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },","+    { \"id\": \"FR-50\", \"description\": \"GET /api/assignments/:id (view). For students and parents the response includes their own submission, with grading fields only once returned.\", \"confidence\": \"HIGH\", \"source\": \"API table; Acceptance Criteria 7\" },","+    { \"id\": \"FR-51\", \"description\": \"PATCH /api/assignments/:id (manage). DELETE /api/assignments/:id (manage) hard-deletes only when there are no submissions. Otherwise it sets archivedAt.\", \"confidence\": \"HIGH\", \"source\": \"API table (PATCH/DELETE row)\" },","+    { \"id\": \"FR-52\", \"description\": \"Archived assignments are hidden from student and parent lists, /assignments, reminders and new submissions. Managers can still see them.\", \"confidence\": \"LOW\", \"source\": \"API table ('otherwise archive (add archivedAt)') — the behaviour of an archived assignment is not specified\" },","+    { \"id\": \"FR-53\", \"description\": \"POST /api/assignments/:id/submissions (STUDENT) {text?, fileIds[]} applies the FR-22 to FR-24 rules. The fileIds must be the student's own uploads with context 'submission', and their number must be ≤ maxFileCount.\", \"confidence\": \"HIGH\", \"source\": \"API table; FR-4.2–4.5\" },","+    { \"id\": \"FR-54\", \"description\": \"GET /api/assignments/:id/submissions (manage) lists every enrolled student, including those who have not submitted, with their status, exemption and submission summary.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },","+    { \"id\": \"FR-55\", \"description\": \"GET /api/submissions/:id is open to the submitting student, their parents and course managers. SubmissionHistory is included only for managers.\", \"confidence\": \"HIGH\", \"source\": \"API table\" },","+    { \"id\": \"FR-56\", \"description\": \"PUT /api/submissions/:id/grade (manage) {rawScore, penaltyPercent, feedback, rubricScores} sets gradedById/gradedAt and the computed finalScore.\", \"confidence\": \"HIGH\", \"source\": \"API table; FR-5.3\" },","+    { \"id\": \"FR-57\", \"description\": \"GET /api/me/assignments?studentId=&tab= (any role) returns the role-shaped data for /assignments. studentId is accepted for parents (it must be a linked child).\", \"confidence\": \"HIGH\", \"source\": \"API table; FR-6.1\" },","+    { \"id\": \"FR-58\", \"description\": \"GET /api/students/:id/assignments (view student; uses the existing assertCanViewStudent) returns the per-student assignment list.\", \"confidence\": \"HIGH\", \"source\": \"API table; FR-6.2\" },","+    { \"id\": \"FR-59\", \"description\": \"Grading, returning, exempting and offline grading change records owned by a student, so each writes an AuditLog row through the existing audit().\", \"confidence\": \"MEDIUM\", \"source\": \"Platform Context › Code layout (mutations on records owned by someone else write AuditLog)\" },","+    { \"id\": \"FR-60\", \"description\": \"Assignments with submissionType NO_SUBMISSION are not counted as Missing and trigger no due_soon or missing reminders. They are graded offline only.\", \"confidence\": \"LOW\", \"source\": \"FR-1 (NO_SUBMISSION; offline grading paragraph); Seed Data (SCI-7A NO_SUBMISSION graded offline) — the missing/reminder behaviour is not specified\" },","+    { \"id\": \"FR-61\", \"description\": \"Seed data: MATH-7A gets 4 assignments (one returned with all students graded at 55–100 %; one submitted and awaiting grading with 60 % submitted and 2 late; one due in 2 days; one draft). ENG-7A gets 2 (one with a 3-criterion rubric, returned). SCI-7A gets 1 NO_SUBMISSION assignment graded offline. The seed is idempotent and skips when those courses do not exist.\", \"confidence\": \"HIGH\", \"source\": \"Seed Data\" }","   ],","+","   \"nonFunctionalRequirements\": [","-    {","-      \"id\": \"NFR-1\",","-      \"description\": \"Stored files are never served from a static path, and every download goes through the access registry.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Non-Functional Requirements 1 (Security); FR-1.1\"","-    },","-    {","-      \"id\": \"NFR-2\",","-      \"description\": \"Markdown output is sanitised (rehype-sanitize) and javascript: URLs are stripped, so no script executes from lesson content.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Non-Functional Requirements 1; Acceptance Criterion 6\"","-    },","-    {","-      \"id\": \"NFR-3\",","-      \"description\": \"POST /api/files is rate limited to 60 uploads per user per hour (RATE_LIMITED 429), reusing rateLimit() from src/server/rate-limit.ts.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Non-Functional Requirements 1\"","-    },","-    {","-      \"id\": \"NFR-4\",","-      \"description\": \"The Content tab for a course with 20 modules × 10 lessons renders in under 600 ms. This means no N+1 queries: modules, lessons, attachment counts and progress are loaded in a bounded number of queries.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Non-Functional Requirements 2 (Performance)\"","-    },","-    {","-      \"id\": \"NFR-5\",","-      \"description\": \"Uploads stream to disk and the sha256 is computed while streaming, without buffering whole files in memory. The size limit is enforced during the stream.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Non-Functional Requirements 2\"","-    },","-    {","-      \"id\": \"NFR-6\",","-      \"description\": \"Accessibility: embedded video iframes have a title, the editor warns when an image has no alt text, and drag reordering has keyboard up/down IconButton alternatives.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Non-Functional Requirements 3; FR-4.3\"","-    },","-    {","-      \"id\": \"NFR-7\",","-      \"description\": \"UI component rule: only @mui/material, @mui/icons-material and the listed MUI X packages are used. Every component is looked up via the mui-mcp server (useMuiDocs/fetchDocs for the installed 9.5.0) before use. Banned libraries are never imported, and Markdown elements map to MUI via the components prop. If the MCP is unreachable, that is a blocker. QA verifies there are no banned imports and that every MUI import is documented.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Platform Context — UI component rule (item 6 requires intake to record it)\"","-    },","-    {","-      \"id\": \"NFR-8\",","-      \"description\": \"Every content and file handler and every server page enforces access server-side (assertCanViewCourse/assertCanManageCourse/assertCanViewStudent/access registry). Hiding a button is never the only protection.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Code layout and conventions (requireRole.ts)\"","-    },","-    {","-      \"id\": \"NFR-9\",","-      \"description\": \"Brownfield constraint: do not re-scaffold, rename existing routes/models or duplicate helpers. Keep npm run lint && npm run typecheck && npm run test passing. New dependencies are limited to the PRD-allowed set (file-type, react-markdown, remark-gfm, rehype-sanitize, @dnd-kit/sortable).\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Platform Context; Assumptions and constraints\"","-    },","-    {","-      \"id\": \"NFR-10\",","-      \"description\": \"Dates (publishAt, progress dates, 'Saved' indicator) are stored in UTC and displayed in SchoolSettings.timezone. The schedule picker interprets input in the school timezone.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Code layout and conventions (timestamps); FR-5.3\"","-    },","-    {","-      \"id\": \"NFR-11\",","-      \"description\": \"Out of scope: S3/cloud storage (the storage module has a single local-disk implementation), SCORM/H5P/live video, and copying content between courses.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Out of Scope\"","-    },","-    {","-      \"id\": \"NFR-12\",","-      \"description\": \"No console.log in committed code. Use the logger from src/lib/logger.ts. .env.example documents UPLOAD_DIR and MAX_UPLOAD_MB.\",","-      \"confidence\": \"HIGH\",","-      \"source\": \"Code layout and conventions; Fixed technology decisions (.env.example)\"","-    }","+    { \"id\": \"NFR-1\", \"description\": \"Correctness: all score arithmetic uses Decimal end to end (Prisma.Decimal / decimal.js, which ships with Prisma), never JS floating point. Final scores round half-up to 2 dp.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements 1\" },","+    { \"id\": \"NFR-2\", \"description\": \"Integrity: submission, deadline, late-day, visibility and reminder checks use server time only. Client timestamps are never trusted.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements 2\" },","+    { \"id\": \"NFR-3\", \"description\": \"Performance: the grading screen switches between students in under 300 ms by prefetching the next and previous submissions.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements 3; Goals 3\" },","+    { \"id\": \"NFR-4\", \"description\": \"Privacy: students never see other students' submissions, scores or files, in the API or through the file URLs.\", \"confidence\": \"HIGH\", \"source\": \"Non-Functional Requirements 4; Acceptance Criteria 10\" },","+    { \"id\": \"NFR-5\", \"description\": \"Access control is enforced server-side on every handler and server page through requireUser/requireRole and the existing assertCanViewCourse, assertCanManageCourse and assertCanViewStudent. Hiding UI is never the only protection.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout (requireRole.ts); Roles\" },","+    { \"id\": \"NFR-6\", \"description\": \"UI component rule: Material UI v9.5.0 and MUI X only, styled through the theme, sx and styled(). No banned libraries, enforced by the ESLint no-restricted-imports rule. Every component (List, Chip, ToggleButtonGroup, Dialog, Tabs, DataTable/DataGrid, DateTimePicker, Autocomplete, Snackbar via useToast) is looked up through mui-mcp (useMuiDocs → fetchDocs) before use. If mui-mcp is unreachable, that is a blocker. QA verifies there are no banned imports and that every MUI import is documented.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › UI component rule (1–6)\" },","+    { \"id\": \"NFR-7\", \"description\": \"API conventions: route handlers are thin (Zod → service → JSON). They use the {data} / list {data,page,pageSize,total} / {error:{code,message,details}} envelopes and the standard error codes. Pagination defaults to 20 (max 100), with ?sort=&order= and ?q=.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout and conventions\" },","+    { \"id\": \"NFR-8\", \"description\": \"Code layout: business logic goes in src/server/assignments/assignments-service.ts (the PRD-05 feature-subdirectory precedent). Zod schemas go in src/lib/validators/assignments.ts. Routes go under src/app/api/{courses,assignments,submissions,me,students}/…. Pages go under src/app/(app)/….\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout and conventions\" },","+    { \"id\": \"NFR-9\", \"description\": \"Time handling: timestamps are stored in UTC and displayed in SchoolSettings.timezone. The late-day calculation is correct across a DST change in the school timezone and on the exact 24 h boundary (exactly 24 h late = 1 day).\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout (UTC/school tz); Test Requirements (DST, exact 24 h boundary)\" },","+    { \"id\": \"NFR-10\", \"description\": \"Markdown (instructions, submission text, feedback) is rendered with react-markdown + remark-gfm + rehype-sanitize, with every element mapped to an MUI component.\", \"confidence\": \"HIGH\", \"source\": \"FR-5.2 (sanitised Markdown); UI component rule 4\" },","+    { \"id\": \"NFR-11\", \"description\": \"Brownfield reuse: never re-scaffold, rename existing routes or models, or duplicate existing helpers. Reuse notify(), notifyStudentAndParents(), audit(), registerFileAccess/contexts, the files service and /api/files, the DataTable, ConfirmDialog, EmptyState, PageHeader and useToast components, formatInSchoolTz, and the courseTabs/studentTabs registries.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context (reuse paragraph)\" },","+    { \"id\": \"NFR-12\", \"description\": \"Committed code has no console.log. Use the logger from src/lib/logger.ts.\", \"confidence\": \"HIGH\", \"source\": \"Platform Context › Code layout and conventions\" },","+    { \"id\": \"NFR-13\", \"description\": \"Quality gate: npm run lint, npm run typecheck and npm run test keep passing.\", \"confidence\": \"HIGH\", \"source\": \"Assumptions and constraints (Constraints)\" },","+    { \"id\": \"NFR-14\", \"description\": \"Unit tests cover: the late-days calculation (exact 24 h boundary, DST change), the penalty cap, final-score rounding and rubric-sum validation. Integration tests cover: resubmission history, the return flow, reminder idempotency and the effect of exemptions on the missing list. A Playwright e2e covers: teacher creates → student submits a file → teacher grades with a rubric and returns → student sees feedback; parent sees the missing list.\", \"confidence\": \"HIGH\", \"source\": \"Test Requirements\" },","+    { \"id\": \"NFR-15\", \"description\": \"Scope guard: no plagiarism detection, peer review, group assignments, inline document annotation, or gradebook weighting / term grades (PRD-11 consumes these scores). Do not change behaviour owned by later PRDs.\", \"confidence\": \"HIGH\", \"source\": \"Out of Scope; Assumptions and constraints\" },","+    { \"id\": \"NFR-16\", \"description\": \"Usability goals: a teacher can create and publish an assignment in under 2 minutes, and can grade 30 submissions with the keyboard without leaving the grading screen.\", \"confidence\": \"HIGH\", \"source\": \"Goals 1, 3\" },","+    { \"id\": \"NFR-17\", \"description\": \"English-only UI, single school, support for evergreen browsers (last 2 versions of Chrome, Edge, Firefox and Safari), and basic accessibility (labelled inputs, keyboard-operable controls).\", \"confidence\": \"MEDIUM\", \"source\": \"Assumptions and constraints (Assumptions)\" }","   ],","-  \"overallConfidencePct\": 93,","+","+  \"overallConfidencePct\": 0,","+","   \"clarificationLog\": [","     {","       \"round\": 1,","       \"questions\": [","-        \"FR-42: /admin/settings/school (said to come from PRD-02) does not exist in the workspace. Should intake create a minimal school settings page to host the logo upload?\",","-        \"FR-6: How should txt/csv (no magic number) and docx/xlsx/pptx (sniff as zip) pass magic-number validation?\",","-        \"FR-40: Should SchoolSettings.logoUrl store '/api/files/<id>', or should a new logoFileId column be added?\"","+        \"FR-15: Does 'same relative due date' mean the identical due date-time, or the same offset from some per-course anchor such as the next class meeting in the timetable?\",","+        \"FR-13: Should a SCHEDULED assignment's status flip to PUBLISHED when availableFrom passes, or is visibility only computed?\",","+        \"FR-52: What may students, parents and teachers see or do with an archived assignment?\",","+        \"FR-60: Does a NO_SUBMISSION assignment ever count as Missing or trigger due_soon/missing reminders?\",","+        \"FR-10: Should 'next teaching day' skip holidays? (No holiday model exists before PRD-14.)\",","+        \"FR-36: With allowExtraCredit, can rubric level points also exceed criterion maximums, or is extra credit raw-score only?\",","+        \"FR-39/FR-6.1: What should ADMIN see on /assignments? The PRD defines only the STUDENT, PARENT and TEACHER views.\"","       ],","       \"unresolved\": [","-        \"FR-42 default: create a minimal ADMIN /admin/settings/school page on the existing PATCH /api/settings/school.\",","-        \"FR-6 default: accept text types when no signature is detected, accept OOXML when the sniffed type is zip or the matching OOXML mime, and reject everything else that mismatches.\",","-        \"FR-40 default: store '/api/files/<id>' in the existing logoUrl column, with no schema change. Email templates then need an absolute URL (APP_URL prefix).\"","+        \"FR-15: no interactive user. Default: keep the identical dueAt, and keep the availableFrom/lateCutoffAt offsets from dueAt.\",","+        \"FR-13: default: visibility is computed at read time, and the status stays SCHEDULED.\",","+        \"FR-52: default: archived assignments are hidden from students and parents, closed to new submissions, excluded from reminders, and still visible to managers (marked 'Archived').\",","+        \"FR-60: default: NO_SUBMISSION assignments are excluded from Missing and from reminders.\",","+        \"FR-10: default: use SchoolDay.isTeaching weekdays only.\",","+        \"FR-36: default: extra credit applies to rawScore only. Rubric points stay within each criterion's maximum.\",","+        \"ADMIN /assignments: default: show the TEACHER-style 'To grade' list across all courses.\"","       ]","+    },","+    {","+      \"round\": 2,","+      \"questions\": [","+        \"Ticket ID: the PRD header says SCH-009, but the pipeline ticket is SH-9. Confirm that SH-9 is canonical for the artifacts.\"","+      ],","+      \"unresolved\": [","+        \"Ticket ID: proceeding with SH-9 (from the task prompt).\"","+      ]","     }","   ],","+","+  \"brownfieldFindings\": [","+    \"DEPENDENCY GAP (PRD-08 incomplete): SH-8 QA FAILED. 39 of 60 requirements are not implemented. The file backend exists: FileObject, storage.ts, src/server/files/{access,contexts,files-service,validate,purge}.ts, POST /api/files and GET /api/files/[id]?inline=1. The UI does not exist: there is no FileUpload, FileList, MarkdownView or Markdown editor. PRD-09 needs these UI components (FR-9, FR-19, FR-20, FR-29, FR-30).\",","+    \"The MUI X version mismatch persists: @mui/x-internals is 9.15.0, but @mui/x-data-grid 9.5.0 needs an older export. Every page that renders DataTable/DataGrid fails to compile, and FR-17 needs a DataTable.\",","+    \"vitest.config.ts imports 'vitest/config.js', which does not resolve, so `npm test` fails to start (NFR-13). vitest.tmp.config.ts works.\",","+    \"next.config.js has CSP script-src 'self', which blocks hydration in a real browser. Earlier e2e runs used bypassCSP.\",","+    \"studentTabs is not rendered by any page, so the FR-41 tab will not be visible until a tab bar exists. courseTabs IS rendered by src/app/(app)/courses/[courseId]/CourseTabs.tsx.\",","+    \"Already installed: react-markdown 10.1.0, remark-gfm 4.0.1, rehype-sanitize 6.0.0, @dnd-kit/sortable 10.0.0, file-type, and decimal.js (via Prisma). No new dependencies are needed.\",","+    \"Reusable: notifyStudentAndParents() in src/server/notifications/notify.ts; the maintenance hook in src/app/api/internal/email/dispatch/route.ts; registerBuiltInContexts in src/server/files/contexts.ts; the Course fields teacherId and coTeacherIds.\"","+  ],","+","   \"status\": \"complete\"","-}","\\ No newline at end of file","+}"]}],"originalFile":"{\n  \"ticketId\": \"SH-8\",\n  \"timestamp\": \"2026-11-06T06:00:00Z\",\n  \"phase\": \"intake\",\n  \"version\": \"1.0\",\n  \"prd\": \"PRD-08: File Storage & Course Content (Modules and Lessons) (SCH-008)\",\n  \"runMode\": \"--brownfield --tech-stack react\",\n  \"brownfieldFindings\": [\n    \"Ticket id: the task prompt says SH-8 and the PRD header says SCH-008. All artifacts use SH-8. The artifacts/intake files that were there before belonged to SH-7 and are overwritten.\",\n    \"GREENFIELD FEATURE: the workspace has no file storage or course content code yet. There are no FileObject/Module/Lesson/LessonAttachment/LessonLink/LessonProgress models, no ContentStatus enum, no src/server/storage.ts, no src/server/files/, no content routes or pages, and no UPLOAD_DIR/MAX_UPLOAD_MB entries in .env.example.\",\n    \"MISSING DEPENDENCIES: the PRD needs file-type, react-markdown, remark-gfm, rehype-sanitize and @dnd-kit/sortable, and none of them are in package.json. @dnd-kit/core 6.3.1 is installed. All of these are on the PRD's allowed list of non-visual libraries.\",\n    \"REUSE: assertCanViewCourse()/assertCanManageCourse() in src/server/auth/course-access.ts, assertCanViewStudent()/getAccessibleStudentIds() in src/server/auth/student-access.ts, and requireUser()/requireRole() in src/server/auth/requireRole.ts.\",\n    \"REUSE: rateLimit(key, limit, windowMs) in src/server/rate-limit.ts (a per-process sliding window) for the 60 uploads/hour limit. audit() comes from src/server/audit.ts, notify() from src/server/notifications/notify.ts, and the type keys live in NOTIFICATION_TYPES in src/server/notifications/types.ts.\",\n    \"REUSE: the course tab registry src/config/course-tabs.ts (currently overview, roster and attendance) and the student tab registry src/config/student-tabs.ts (currently courses and attendance). The 'Content' and 'Learning' tabs are added there.\",\n    \"DAILY MAINTENANCE HOOK: PRD-04's 'daily maintenance run' is the once-per-day purgeOldNotifications() call inside src/app/api/internal/email/dispatch/route.ts, which is gated by an in-memory lastPurgeAt. purgeOrphanFiles() should be called next to it.\",\n    \"LOGO: SchoolSettings.logoUrl (String?) is in prisma/schema.prisma:195 and in UpdateSchoolSettingsInput (src/server/services/settings.ts), the email BaseLayout and render.ts use it, and PATCH /api/settings/school exists. However, there is NO /admin/settings/school page in src/app/(app)/admin/, so FR-9's 'replace the logo URL field' has no field to replace.\",\n    \"SHARED COMPONENTS: they live in src/components/<Name>/ (DataTable, ConfirmDialog, EmptyState, FormField, PageHeader, Toast/useToast, UserPicker...), not in src/components/shared/. New shared components (FileUpload, FileList, MarkdownView) should follow the existing src/components/<Name>/ layout.\",\n    \"No .gitignore was found at the workspace root. UPLOAD_DIR (./uploads) must be git-ignored, so either create one or add the entry if a .gitignore exists elsewhere.\",\n    \"VERIFIED: assertCanViewCourse already allows PARENT when a linked student has an ACTIVE enrollment, and STUDENT only when ACTIVE-enrolled. Use it unchanged.\"\n  ],\n  \"functionalRequirements\": [\n    {\n      \"id\": \"FR-1\",\n      \"description\": \"Add the FileObject Prisma model (ownerId→User, originalName, mimeType, sizeBytes, unique storageKey '<yyyy>/<mm>/<cuid>.<ext>', sha256, context, nullable contextId, createdAt, index on [context, contextId]) with a migration.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1 File storage (Prisma block)\"\n    },\n    {\n      \"id\": \"FR-2\",\n      \"description\": \"Create src/server/storage.ts exposing saveFile(stream, meta), readFile(storageKey) and deleteFile(storageKey). It writes under UPLOAD_DIR (new env var, default ./uploads, git-ignored) and never inside public/.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.1\"\n    },\n    {\n      \"id\": \"FR-3\",\n      \"description\": \"POST /api/files (multipart, any signed-in user) accepts one file plus context and creates a FileObject with contextId null.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.2; API table\"\n    },\n    {\n      \"id\": \"FR-4\",\n      \"description\": \"Enforce a per-file size limit of MAX_UPLOAD_MB (env, default 25). Oversize uploads are rejected with VALIDATION_ERROR 'File exceeds 25 MB.'\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.2\"\n    },\n    {\n      \"id\": \"FR-5\",\n      \"description\": \"Allow only pdf, doc, docx, xls, xlsx, ppt, pptx, txt, csv, png, jpg, jpeg, gif, webp, mp3, mp4 and zip, validated by extension AND by magic-number sniffing with the file-type package. Anything else is rejected with VALIDATION_ERROR 'File type .<ext> is not allowed.'\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.2; Acceptance Criterion 4\"\n    },\n    {\n      \"id\": \"FR-6\",\n      \"description\": \"Text formats with no magic number (txt, csv) and Office OOXML formats that sniff as zip (docx/xlsx/pptx) are accepted when the sniffed type is absent or consistent with the extension. Executable or mismatched signatures are rejected.\",\n      \"confidence\": \"MEDIUM\",\n      \"source\": \"FR-1.2 (inferred: file-type cannot detect txt/csv; OOXML sniffs as zip container)\"\n    },\n    {\n      \"id\": \"FR-7\",\n      \"description\": \"Sanitise filenames: strip path separators and control characters and cap the length at 150 characters, then store the result as originalName.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.3\"\n    },\n    {\n      \"id\": \"FR-8\",\n      \"description\": \"GET /api/files/:id streams the file with the stored MIME type, X-Content-Type-Options: nosniff, and Content-Disposition: attachment. It uses inline for images and PDFs only when ?inline=1.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.4; API table\"\n    },\n    {\n      \"id\": \"FR-9\",\n      \"description\": \"Add a file access resolver registry src/server/files/access.ts with registerFileAccess(context, (user, file) => boolean | Promise<boolean>). An unknown context allows only the owner and ADMIN. Denied requests return 404/403 without streaming any bytes.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.4; Acceptance Criterion 3\"\n    },\n    {\n      \"id\": \"FR-10\",\n      \"description\": \"Register the 'lesson' file context (allowed when the user can view the lesson under the visibility rules) and the 'logo' context (public, including unauthenticated users).\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.4\"\n    },\n    {\n      \"id\": \"FR-11\",\n      \"description\": \"DELETE /api/files/:id is allowed for the owner or ADMIN, only while the file is unattached (contextId null). It removes both the row and the stored bytes.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"API table\"\n    },\n    {\n      \"id\": \"FR-12\",\n      \"description\": \"purgeOrphanFiles() deletes FileObjects with contextId null that are older than 24 hours, together with their stored bytes. It is called from PRD-04's daily maintenance run.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.5\"\n    },\n    {\n      \"id\": \"FR-13\",\n      \"description\": \"Add a reusable MUI FileUpload component: a Paper drop zone with a dashed border, Button component='label' with a visually hidden input, multiple files, a per-file LinearProgress driven by XHR upload progress, and a List of files showing name, size, type icon and a remove button.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.6\"\n    },\n    {\n      \"id\": \"FR-14\",\n      \"description\": \"Add a FileList component that shows attached files with download links to /api/files/:id.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-1.6\"\n    },\n    {\n      \"id\": \"FR-15\",\n      \"description\": \"Add the ContentStatus enum (DRAFT, SCHEDULED, PUBLISHED) and the Module, Lesson, LessonAttachment, LessonLink and LessonProgress models exactly as specified, including the cascade deletes and the composite PK [lessonId, studentId] on LessonProgress.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-2 Content data model\"\n    },\n    {\n      \"id\": \"FR-16\",\n      \"description\": \"Validate content fields with Zod in src/lib/validators/content.ts: module title ≤120, lesson title ≤150, contentMarkdown ≤100,000 chars, estimatedMinutes 1–600, link URLs http(s) only, and videoUrl YouTube/Vimeo only.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-2 field comments; Code layout (validators)\"\n    },\n    {\n      \"id\": \"FR-17\",\n      \"description\": \"Attaching a file to a lesson sets FileObject.context='lesson' and contextId=lessonId. Only files owned by the caller (or any file, for ADMIN) that are still unattached can be attached.\",\n      \"confidence\": \"MEDIUM\",\n      \"source\": \"FR-1 (contextId 'id of the owning record once attached'); FR-5.2\"\n    },\n    {\n      \"id\": \"FR-18\",\n      \"description\": \"Visibility rule: a lesson is visible to STUDENT/PARENT only when both the lesson and its module are PUBLISHED, or SCHEDULED with publishAt <= now. This is evaluated at read time with no background job.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-3.1; Acceptance Criterion 2\"\n    },\n    {\n      \"id\": \"FR-19\",\n      \"description\": \"TEACHER (managing the course) and ADMIN see all modules and lessons with a status badge: Draft grey, Scheduled blue with date, Published green.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-3.2\"\n    },\n    {\n      \"id\": \"FR-20\",\n      \"description\": \"Register a 'Content' course tab for every role that can view the course. It shows modules as ordered MUI Accordions, each listing lessons with title, estimated minutes, attachment count and, for students, a completion check.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-4.1\"\n    },\n    {\n      \"id\": \"FR-21\",\n      \"description\": \"Students see a per-module progress bar ('3 of 5 complete'), a course-level progress bar and a 'Continue' button that opens the first incomplete visible lesson.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-4.2; Acceptance Criterion 5\"\n    },\n    {\n      \"id\": \"FR-22\",\n      \"description\": \"Teacher controls on the Content tab: 'Add module', a per-module menu (edit, publish now, schedule, unpublish, delete, move up/down) and 'Add lesson' per module.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-4.3\"\n    },\n    {\n      \"id\": \"FR-23\",\n      \"description\": \"Lessons can be reordered within and across modules with @dnd-kit/sortable drag handles on MUI Accordion/List items, with up/down IconButtons as the keyboard alternative. The order persists through POST /api/courses/:id/content/reorder with the full ordering { modules: [{ id, lessonIds: [] }] }.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-4.3; API table; Acceptance Criterion 7\"\n    },\n    {\n      \"id\": \"FR-24\",\n      \"description\": \"Deleting a module that contains lessons requires typing the module title in a confirmation Dialog.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-4.4\"\n    },\n    {\n      \"id\": \"FR-25\",\n      \"description\": \"Lesson editor page /courses/[courseId]/lessons/[lessonId]/edit has fields for title, estimated minutes and video URL, plus an MUI Markdown editor: Tabs Write/Preview, a multiline TextField, and a toolbar for bold, italic, headings, lists, link, code, quote, table and image.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-5.1\"\n    },\n    {\n      \"id\": \"FR-26\",\n      \"description\": \"Toolbar image insert uploads through POST /api/files (context 'lesson') and inserts ![alt](/api/files/<id>?inline=1). The editor shows a warning when alt text is missing.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-5.1; NFR Accessibility\"\n    },\n    {\n      \"id\": \"FR-27\",\n      \"description\": \"The lesson editor has an attachments section (FileUpload with reorder) and a links section (title + URL rows). Both are saved via PATCH /api/lessons/:id as attachments and links arrays.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-5.2; API table\"\n    },\n    {\n      \"id\": \"FR-28\",\n      \"description\": \"Lesson status controls are Save draft, Publish now, and Schedule. Schedule uses an MUI date-time picker in the school timezone and the time must be in the future.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-5.3\"\n    },\n    {\n      \"id\": \"FR-29\",\n      \"description\": \"Autosave the draft every 10 seconds while there are unsaved changes, show a 'Saved HH:mm' indicator, and warn on navigation away when changes are unsaved.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-5.4\"\n    },\n    {\n      \"id\": \"FR-30\",\n      \"description\": \"Video URL parser: accept youtube.com/watch?v=, youtu.be/ and vimeo.com/<id> and store the URL as entered. Render it as a privacy-enhanced embed (youtube-nocookie.com/embed/<id>, player.vimeo.com/video/<id>) in a 16:9 responsive iframe with a title attribute.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-5.5; Acceptance Criterion 1\"\n    },\n    {\n      \"id\": \"FR-31\",\n      \"description\": \"Add a shared MarkdownView component that uses react-markdown + remark-gfm + rehype-sanitize (default schema plus img from same origin only) and maps every element to MUI (Typography, Link, Table*, Divider, List/ListItem, Box component='pre'). External links open in a new tab with rel='noopener noreferrer'.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-6.1; Acceptance Criterion 6\"\n    },\n    {\n      \"id\": \"FR-32\",\n      \"description\": \"Lesson viewer /courses/[courseId]/lessons/[lessonId] shows the video embed, attachment list, links, estimated time and Previous/Next navigation across modules, limited to lessons visible to the caller.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-6.2\"\n    },\n    {\n      \"id\": \"FR-33\",\n      \"description\": \"For students, the first lesson view upserts LessonProgress.firstViewedAt, and a 'Mark as complete' button toggles completedAt via POST /api/lessons/:id/progress { completed }. Only ACTIVE enrolled students may do this.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-6.3; API table\"\n    },\n    {\n      \"id\": \"FR-34\",\n      \"description\": \"Teachers get a 'Progress' Drawer on the lesson viewer that lists enrolled students with Viewed/Completed status and dates, served by GET /api/lessons/:id/progress (manage).\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-6.4; API table\"\n    },\n    {\n      \"id\": \"FR-35\",\n      \"description\": \"Register a 'Learning' student tab showing per-course content progress (course, lessons completed / visible, percentage, last activity) via GET /api/students/:id/learning (assertCanViewStudent).\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-7.1; API table\"\n    },\n    {\n      \"id\": \"FR-36\",\n      \"description\": \"Parents can open linked children's course content and lessons read-only, with no 'Mark as complete' button.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-7.2; Acceptance Criterion 8\"\n    },\n    {\n      \"id\": \"FR-37\",\n      \"description\": \"Parents can view a course's Content tab only when a linked student is ACTIVE-enrolled. The existing assertCanViewCourse already enforces this (verified in src/server/auth/course-access.ts PARENT branch), so reuse it as is.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-7.2; Roles (parents see data for linked students)\"\n    },\n    {\n      \"id\": \"FR-38\",\n      \"description\": \"Register the notification type content.lesson_published (category ACADEMIC, default email false). 'Publish now' that makes a lesson visible notifies ACTIVE enrolled students.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-8.1\"\n    },\n    {\n      \"id\": \"FR-39\",\n      \"description\": \"Scheduled lessons send no notification when publishAt passes. The Schedule control shows the tooltip 'Scheduled lessons appear automatically without a notification.'\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-8.2\"\n    },\n    {\n      \"id\": \"FR-40\",\n      \"description\": \"Logo upload: the school settings page uses FileUpload (single image, PNG/JPG/WebP/SVG, max 2 MB, context 'logo') instead of a logo URL field, and stores the resulting /api/files/<id> URL in SchoolSettings.logoUrl.\",\n      \"confidence\": \"MEDIUM\",\n      \"source\": \"FR-9.1 (storage of the URL in logoUrl inferred; existing column reused, no rename)\"\n    },\n    {\n      \"id\": \"FR-41\",\n      \"description\": \"SVG is allowed only for context 'logo'. SVG logo files are served with Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"FR-9.1\"\n    },\n    {\n      \"id\": \"FR-42\",\n      \"description\": \"/admin/settings/school does not exist in the workspace. Create a minimal ADMIN page there that uses the existing PATCH /api/settings/school, holds the logo FileUpload, and adds an nav entry if none exists.\",\n      \"confidence\": \"LOW\",\n      \"source\": \"FR-9.1 (references a page from PRD-02 not found in src/app/(app)/admin/)\"\n    },\n    {\n      \"id\": \"FR-43\",\n      \"description\": \"Content API: GET/POST /api/courses/:id/modules (GET filters by visibility per role and includes lessons and the caller's progress), PATCH/DELETE /api/modules/:id, POST /api/modules/:id/lessons, GET/PATCH/DELETE /api/lessons/:id, using the PRD response/error envelope and the access checks in the API table.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"API table; Code layout (response shape)\"\n    },\n    {\n      \"id\": \"FR-44\",\n      \"description\": \"GET /api/lessons/:id returns NOT_FOUND to STUDENT/PARENT callers when the lesson is not visible under the visibility rules.\",\n      \"confidence\": \"MEDIUM\",\n      \"source\": \"API table ('view (visibility rules)'); FR-3.1\"\n    },\n    {\n      \"id\": \"FR-45\",\n      \"description\": \"Content business logic lives in src/server/content/content-service.ts and file logic in src/server/files/. Route handlers stay thin (Zod → service → JSON).\",\n      \"confidence\": \"MEDIUM\",\n      \"source\": \"Code layout and conventions (feature-named subdirectory precedent)\"\n    },\n    {\n      \"id\": \"FR-46\",\n      \"description\": \"Teacher/admin mutations on content owned by another user (for example an admin editing a teacher's lesson, or deleting someone else's file) write an AuditLog row via audit().\",\n      \"confidence\": \"MEDIUM\",\n      \"source\": \"Code layout and conventions (AuditLog rule)\"\n    },\n    {\n      \"id\": \"FR-47\",\n      \"description\": \"Seed data: MATH-7A gets 3 modules ('Number Sense', 'Fractions', 'Geometry Basics') with 3 published lessons each of realistic Markdown, one with a YouTube video and one with a seeded PDF from prisma/seed-assets/, plus one draft lesson and one lesson scheduled 7 days ahead. ENG-7A gets 2 modules × 2 lessons. Sam has completed 4 MATH-7A lessons.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Seed Data\"\n    },\n    {\n      \"id\": \"FR-48\",\n      \"description\": \"Tests: unit tests for the filename sanitiser, video URL parser, visibility rule and access registry dispatch; integration tests for upload → attach → download with access checks and for the orphan purge; a Playwright test where a teacher creates and publishes a lesson with an attachment and a student completes it.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Test Requirements\"\n    }\n  ],\n  \"nonFunctionalRequirements\": [\n    {\n      \"id\": \"NFR-1\",\n      \"description\": \"Stored files are never served from a static path, and every download goes through the access registry.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Non-Functional Requirements 1 (Security); FR-1.1\"\n    },\n    {\n      \"id\": \"NFR-2\",\n      \"description\": \"Markdown output is sanitised (rehype-sanitize) and javascript: URLs are stripped, so no script executes from lesson content.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Non-Functional Requirements 1; Acceptance Criterion 6\"\n    },\n    {\n      \"id\": \"NFR-3\",\n      \"description\": \"POST /api/files is rate limited to 60 uploads per user per hour (RATE_LIMITED 429), reusing rateLimit() from src/server/rate-limit.ts.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Non-Functional Requirements 1\"\n    },\n    {\n      \"id\": \"NFR-4\",\n      \"description\": \"The Content tab for a course with 20 modules × 10 lessons renders in under 600 ms. This means no N+1 queries: modules, lessons, attachment counts and progress are loaded in a bounded number of queries.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Non-Functional Requirements 2 (Performance)\"\n    },\n    {\n      \"id\": \"NFR-5\",\n      \"description\": \"Uploads stream to disk and the sha256 is computed while streaming, without buffering whole files in memory. The size limit is enforced during the stream.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Non-Functional Requirements 2\"\n    },\n    {\n      \"id\": \"NFR-6\",\n      \"description\": \"Accessibility: embedded video iframes have a title, the editor warns when an image has no alt text, and drag reordering has keyboard up/down IconButton alternatives.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Non-Functional Requirements 3; FR-4.3\"\n    },\n    {\n      \"id\": \"NFR-7\",\n      \"description\": \"UI component rule: only @mui/material, @mui/icons-material and the listed MUI X packages are used. Every component is looked up via the mui-mcp server (useMuiDocs/fetchDocs for the installed 9.5.0) before use. Banned libraries are never imported, and Markdown elements map to MUI via the components prop. If the MCP is unreachable, that is a blocker. QA verifies there are no banned imports and that every MUI import is documented.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Platform Context — UI component rule (item 6 requires intake to record it)\"\n    },\n    {\n      \"id\": \"NFR-8\",\n      \"description\": \"Every content and file handler and every server page enforces access server-side (assertCanViewCourse/assertCanManageCourse/assertCanViewStudent/access registry). Hiding a button is never the only protection.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Code layout and conventions (requireRole.ts)\"\n    },\n    {\n      \"id\": \"NFR-9\",\n      \"description\": \"Brownfield constraint: do not re-scaffold, rename existing routes/models or duplicate helpers. Keep npm run lint && npm run typecheck && npm run test passing. New dependencies are limited to the PRD-allowed set (file-type, react-markdown, remark-gfm, rehype-sanitize, @dnd-kit/sortable).\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Platform Context; Assumptions and constraints\"\n    },\n    {\n      \"id\": \"NFR-10\",\n      \"description\": \"Dates (publishAt, progress dates, 'Saved' indicator) are stored in UTC and displayed in SchoolSettings.timezone. The schedule picker interprets input in the school timezone.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Code layout and conventions (timestamps); FR-5.3\"\n    },\n    {\n      \"id\": \"NFR-11\",\n      \"description\": \"Out of scope: S3/cloud storage (the storage module has a single local-disk implementation), SCORM/H5P/live video, and copying content between courses.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Out of Scope\"\n    },\n    {\n      \"id\": \"NFR-12\",\n      \"description\": \"No console.log in committed code. Use the logger from src/lib/logger.ts. .env.example documents UPLOAD_DIR and MAX_UPLOAD_MB.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"Code layout and conventions; Fixed technology decisions (.env.example)\"\n    }\n  ],\n  \"overallConfidencePct\": 93,\n  \"clarificationLog\": [\n    {\n      \"round\": 1,\n      \"questions\": [\n        \"FR-42: /admin/settings/school (said to come from PRD-02) does not exist in the workspace. Should intake create a minimal school settings page to host the logo upload?\",\n        \"FR-6: How should txt/csv (no magic number) and docx/xlsx/pptx (sniff as zip) pass magic-number validation?\",\n        \"FR-40: Should SchoolSettings.logoUrl store '/api/files/<id>', or should a new logoFileId column be added?\"\n      ],\n      \"unresolved\": [\n        \"FR-42 default: create a minimal ADMIN /admin/settings/school page on the existing PATCH /api/settings/school.\",\n        \"FR-6 default: accept text types when no signature is detected, accept OOXML when the sniffed type is zip or the matching OOXML mime, and reject everything else that mismatches.\",\n        \"FR-40 default: store '/api/files/<id>' in the existing logoUrl column, with no schema change. Email templates then need an absolute URL (APP_URL prefix).\"\n      ]\n    }\n  ],\n  \"status\": \"complete\"\n}","userModified":false},"tool_result_meta":[{"id":"toolu_01T11D1dUsVyZFc2eMzi4Cgj","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
