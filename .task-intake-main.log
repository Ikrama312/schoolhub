{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015LrDx8mE7ChN1iAbEMKYRw","type":"tool_result","content":"=== prisma schema models ===\n10:enum Role {\n17:enum UserStatus {\n24:enum AuthTokenType {\n29:enum Gender {\n36:enum GuardianRelationship {\n44:enum EmailStatus {\n59:model User {\n91:model StudentProfile {\n108:model TeacherProfile {\n118:model ParentProfile {\n129:model ParentStudentLink {\n147:model AuthToken {\n163:model AuditLog {\n181:model SchoolSettings {\n202:model AcademicYear {\n217:model Term {\n234:model GradeLevel {\n248:model Subject {\n260:model Room {\n276:model Notification {\n295:model NotificationPreference {\n313:model EmailOutbox {\n=== getAccessibleStudentIds ===\nsrc/server/auth/student-access.ts:20:export async function getAccessibleStudentIds(user: AccessUser): Promise<AccessibleStudentIds> {\nsrc/server/auth/student-access.ts:48:  const accessible = await getAccessibleStudentIds(user);\n=== audit() ===\n=== notify() ===\n=== student-tabs.ts ===\nsrc/config/navigation.ts\nsrc/config/student-tabs.ts\n=== navigation.ts ===\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n