{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uq2etuYGj5E1HHCMiERHiS","type":"tool_result","content":"export type NotificationTypeDef = {\n  label: string;\n  description: string;\n  category: NotificationCategory;\n  defaultEmail: boolean;\n  mandatoryInApp: boolean;\n  roles: readonly Role[];\n  /** Sent straight to the outbox (sendAuthEmail); hidden from preferences. */\n  emailOnly?: true;\n};\n\nexport const NOTIFICATION_TYPES = {\n  'account.invite': {\n    label: 'Account invitation',\n    description: 'Invitation to set up your SchoolHub account.',\n    category: 'ACCOUNT',\n    defaultEmail: true,\n    mandatoryInApp: false,\n    emailOnly: true,\n    roles: ALL,\n  },\n  'account.password_reset': {\n    label: 'Password reset',\n    description: 'Link to reset your password.',\n}\n\n/** notify() for students and every parent linked to them (FR-12). Never throws. */\nexport async function notifyStudentAndParents(\n  input: Omit<NotifyInput, 'userIds'> & { studentIds: string[] },\n): Promise<void> {\n  try {\n    const { studentIds, ...rest } = input;\n    const links = await prisma.parentStudentLink.findMany({\n      where: { studentId: { in: studentIds } },\n      select: { studentId: true, parentId: true },\n    });\n    await notify({ ...rest, userIds: expandStudentRecipients(studentIds, links) });\n  } catch (error) {\n    logger.error('notifyStudentAndParents() failed', {\n      type: input.type,\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nmodel Course {\n  id                 String              @id @default(cuid())\n  academicYearId     String\n  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n  subjectId          String\n  subject            Subject             @relation(fields: [subjectId], references: [id])\n  sectionId          String?\n  section            Section?            @relation(fields: [sectionId], references: [id])\n  