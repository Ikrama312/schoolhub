d], references: [id], onDelete: Cascade)\n  relationship GuardianRelationship\n  isPrimary    Boolean              @default(false)\n  createdAt    DateTime             @default(now())\n\n  @@unique([parentId, studentId])\n  @@index([studentId])\n}\n\nmodel Section {\n  id                 String              @id @default(cuid())\n  academicYearId     String\n  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n  gradeLevelId       String\n  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id])\n  name               String\n  homeroomTeacherId  String?\n  homeroomTeacher    User?               @relation(\"HomeroomTeacher\", fields: [homeroomTeacherId], references: [id])\n  roomId             String?\n  room               Room?               @relation(fields: [roomId], references: [id])\n  capacity           Int                 @default(30)\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  members            SectionMember[]\n  courses            Course[]\n  attendanceSessions AttendanceSession[]\n\n  @@unique([academicYearId, name])\n}\n\nmodel SectionMember {\n  id             String   @id @default(cuid())\n  sectionId      String\n  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n  studentId      String\n  student        User     @relation(fields: [studentId], references: [id])\n  joinedAt       DateTime @default(now())\n  academicYearId String\n\n  @@unique([studentId, academicYearId])\n}\n\nmodel Course {\n  id                 String              @id @default(cuid())\n  academicYearId     String\n  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n  subjectId          String\n  subject            Subject             @relation(fields: [subjectId], references: [id])\n  sectionId          String?\n  section            Section?            @relation(fields: [sectionId], references: [id])\n  teacherId          String\n  teacher            User                @relation(\"CourseTeacher\", fields: [teacherId], references: [id])\n  coTeacherIds       String[]            @default([])\n  name               String\n  code               String\n  kind               CourseKind          @default(CORE)\n  description        String?\n  capacity           Int?\n  archivedAt         DateTime?\n  gradingScaleId     String?\n  gradingScale       GradingScale?       @relation(fields: [gradingScaleId], references: [id], onDelete: SetNull)\n  createdAt          DateTime            @default(now())\n  updatedAt          DateTime            @updatedAt\n  enrollments        Enrollment[]\n  timetableSlots     TimetableSlot[]\n  attendanceSessions AttendanceSession[]\n  modules            Module[]\n  assignments        Assignment[]\n  quizzes            Quiz[]\n  gradeCategories    GradeCategory[]\n  gradeItems         GradeItem[]\n\n  @@unique([academicYearId, code])\n}\n\nmodel Enrollment {\n  id         String           @id @default(cuid())\n  courseId   String\n  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  studentId  String\n  student    User             @relation(fields: [studentId], references: [id])\n  status     EnrollmentStatus @default(ACTIVE)\n  enrolledAt DateTime         @default(now())\n  droppedAt  DateTime?\n\n  @@unique([courseId, studentId])\n  @@index([studentId, status])\n}\n\n// ---------------------------------------------------------------------------\n// PRD-06 Bell Schedule & Timetable (FR-1..FR-4). One repeating week (NFR-15).\n// Clash rules live in src/server/timetable/, not in the DB.\n// ---------------------------------------------------------------------------\n\nmodel FileObject {\n  id                    String                 @id @default(cuid())\n  ownerId               String\n  owner                 User                   @relation(fields: [ownerId], references: [id])\n  originalName          String\n  mimeType              String\n  sizeBytes             Int\n  storageKey            String                 @unique\n  sha256                String\n  context               String\n  contextId             String?\n  createdAt             DateTime               @default(now())\n  lessonAttachments     LessonAttachment[]\n  assignmentAttachments AssignmentAttachment[]\n  submissionFiles       SubmissionFile[]\n\n  @@index([context, contextId])\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Pz9RhYbxAP4bMaBm4bCcfL","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
