{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NpYjRM7bvKriZrvKLzS9JB","type":"tool_result","content":"          })\n        ).map((s) => ({ id: s.id, name: `${s.firstName} ${s.lastName}` }));\n  const ids = studentIds.map((s) => s.id);\n  const quizIds = quizzes.map((q) => q.id);\n\n  if (user.role === 'STUDENT') {\n    const open = await prisma.quizAttempt.findMany({ where: { quizId: { in: quizIds }, studentId: user.id, status: 'IN_PROGRESS' }, select: { id: true, status: true, deadlineAt: true } });\n    for (const a of open) await ensureNotExpired(a, now);\n  }\n  const [attempts, accs] = await Promise.all([\n    prisma.quizAttempt.findMany({\n      where: { quizId: { in: quizIds }, studentId: { in: ids } },\n      select: { id: true, quizId: true, studentId: true, attemptNumber: true, status: true, submittedAt: true, score: true, maxScore: true },\n      orderBy: { attemptNumber: 'asc' },\n    }),\n    prisma.quizAccommodation.findMany({ where: { quizId: { in: quizIds }, studentId: { in: ids } } }),\n  ]);\n\n  const scoreOf = (q: (typeof quizzes)[number], a: (typeof attempts)[number]) => {\n    const show = resultsVisible(q, a, now) && a.status === 'GRADED' && a.score !== null;\n    return { score: show ? fixed2(a.score!) : null, maxScore: fixed2(a.maxScore), percent: show ? percentOf(a.score!, a.maxScore) : null };\n  };\n\n  if (user.role === 'STUDENT') {\n    const items = quizzes.map((q) => {\n      const mine = attempts.filter((a) => a.quizId === q.id);\nsrc/server/quiz/grading.ts:32:export function normalizeShortAnswer(s: string): string {\nsrc/server/quiz/grading.ts:40:export function gradeAnswer(q: GradableQuestion, response: unknown): Grade {\nsrc/server/quiz/grading.ts:75:export function needsReview(q: { type: QType }, a: { isCorrect: boolean | null; gradedById: string | null }): boolean {\nsrc/server/quiz/grading.ts:82:export function computeDeadline(startedAt: Date, timeLimitMinutes: number | null, extraTimeMinutes: number, availableUntil: Date): Date {\nsrc/server/quiz/grading.ts:89:export function attemptLimit(maxAttempts: number, extraAttempts = 0): number {\nsrc/server/quiz/grading.ts:94:export function resultsVisible(\nsrc/server/quiz/grading.ts:113:export function canPublish(questions: readonly GradableQuestion[]): string[] {\nsrc/server/quiz/grading.ts:133:export function percentOf(score: DecimalValue, maxScore: DecimalValue): number | null {\nsrc/server/quiz/grading.ts:146:export function applyScoringPolicy(policy: Policy, attempts: readonly ScoredAttempt[]) {\nsrc/server/quiz/grading.ts:165:export function seededShuffle<T>(items: readonly T[], seed: string): T[] {\nmodel Assignment {\n  id                       String                 @id @default(cuid())\n  courseId                 String\n  course                   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)\n  title                    String\n  instructions             String                 @default(\"\") @db.Text\n  submissionType           SubmissionType\n  maxPoints                Decimal                @db.Decimal(6, 2)\n  dueAt                    DateTime\n  availableFrom            DateTime?\n  allowLate                Boolean                @default(false)\n  lateCutoffAt             DateTime?\n  latePenaltyPercentPerDay Decimal                @default(0) @db.Decimal(5, 2)\n  maxLatePenaltyPercent    Decimal                @default(0) @db.Decimal(5, 2)\n  maxFileCount             Int                    @default(3)\n  allowExtraCredit         Boolean                @default(false)\n  status                   AssignmentStatus       @default(DRAFT)\n1:model Submission {\n7:  status         SubmissionStatus    @default(SUBMITTED)\n15:  finalScore     Decimal?            @db.Decimal(6, 2)\n22:  returnedAt     DateTime?\n32:model SubmissionFile {\n42:model SubmissionHistory {\n55:model GradeExemption {\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nsrc/server/assignments:\nassignments-service.ts\ngrading-math.ts\nreminders.ts\n\nsrc/server/services:\nacademicYears.ts\nauth.ts\ndateRange.ts\ngradeLevels.ts\nrooms.ts\nsettings.ts\nsubjects.ts\nterms.ts\nuserImport.ts\nuserLinks.ts\nusers.ts","is_error":false}]},"parent_tool_use_id":null,"session_id":"4e8afab1-1108-4d52-897c-dc8864dd952a","uuid":"d80fcd1f-4dde-48ec-b97d-1aee9e2e7cb9","timestamp":"2026-11-09T12:01:10.450Z","tool_use_result":{"stdout":"          })\n        ).map((s) => ({ id: s.id, name: `${s.firstName} ${s.lastName}` }));\n  const ids = studentIds.map((s) => s.id);\n  const quizIds = quizzes.map((q) => q.id);\n\n  if (user.role === 'STUDENT') {\n    const open = await prisma.quizAttempt.findMany({ where: { quizId: { in: quizIds }, studentId: user.id, status: 'IN_PROGRESS' }, select: { id: true, status: true, deadlineAt: true } });\n    for (const a of open) await ensureNotExpired(a, now);\n  }\n  const [attempts, accs] = await Promise.all([\n    prisma.quizAttempt.findMany({\n      where: { quizId: { in: quizIds }, studentId: { in: ids } },\n      select: { id: true, quizId: true, studentId: true, attemptNumber: true, status: true, submittedAt: true, score: true, maxScore: true },\n      orderBy: { attemptNumber: 'asc' },\n    }),\n    prisma.quizAccommodation.findMany({ where: { quizId: { in: quizIds }, studentId: { in: ids } } }),\n  ]);\n\n  const scoreOf = (q: (typeof quizzes)[number], a: