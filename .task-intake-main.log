{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XWzJdykboPAPsgcQsg5Ygy","type":"tool_result","content":"import type { FileObject } from '@prisma/client';\nimport { registerBuiltInContexts } from './contexts';\n\n/**\n * File access registry (PRD-08 FR-9, NFR-1). Every download goes through\n * canAccessFile. Later PRDs call registerFileAccess for their own contexts.\n */\n\nexport interface FileAccessUser {\n  id: string;\n  role: string;\n}\n\nexport type FileAccessFile = Pick<FileObject, 'id' | 'ownerId' | 'context' | 'contextId'>;\n\n/** Resolvers receive null for anonymous callers; only return true for null if the context is public. */\nexport type FileAccessResolver = (user: FileAccessUser | null, file: FileAccessFile) => boolean | Promise<boolean>;\n\nconst registry = new Map<string, FileAccessResolver>();\n\nexport function registerFileAccess(context: string, resolver: FileAccessResolver): void {\n  registry.set(context, resolver);\n}\n\nconst ownerOrAdmin = (user: FileAccessUser | null, file: FileAccessFile) =>\n  user !== null && (user.role === 'ADMIN' || user.id === file.ownerId);\n\nlet builtInsRegistered = false;\n\n/**\n * Dispatch order: (1) unattached -> owner/ADMIN; (2) registered resolver;\n * (3) unknown context -> owner/ADMIN. Anonymous is denied except where a\n * resolver explicitly accepts null. Resolver errors deny.\n */\nexport async function canAccessFile(user: FileAccessUser | null, file: FileAccessFile): Promise<boolean> {\n  // Lazy so the circular import with contexts.ts never hits an uninitialised registry,\n  // and no caller can forget to load the built-in contexts.\n  if (!builtInsRegistered) {\n    builtInsRegistered = true;\n    registerBuiltInContexts(registerFileAccess);\n  }\n  if (file.contextId === null) return ownerOrAdmin(user, file);\n  const resolver = registry.get(file.context);\n  if (!resolver) return ownerOrAdmin(user, file);\n  try {\n    return (await resolver(user, file)) === true;\n  } catch {\n    return false;\n  }\n}\n----\n3: * imports, so validators and client pages can import it. Later PRDs add keys\n10:export const NOTIFICATION_CATEGORIES = ['ACCOUNT', 'ACADEMIC', 'ATTENDANCE', 'COMMUNICATION', 'FINANCE', 'SYSTEM'] as const;\n17:  COMMUNICATION: 'Communication',\n25:  category: NotificationCategory;\n27:  mandatoryInApp: boolean;\n37:    category: 'ACCOUNT',\n39:    mandatoryInApp: false,\n46:    category: 'ACCOUNT',\n48:    mandatoryInApp: false,\n55:    category: 'SYSTEM',\n57:    mandatoryInApp: false,\n64:    category: 'ATTENDANCE',\n66:    mandatoryInApp: true,\n72:    category: 'ATTENDANCE',\n74:    mandatoryInApp: false,\n80:    category: 'ATTENDANCE',\n82:    mandatoryInApp: false,\n88:    category: 'ATTENDANCE',\n90:    mandatoryInApp: false,\n97:    category: 'ACADEMIC',\n99:    mandatoryInApp: false,\n106:    category: 'ACADEMIC',\n108:    mandatoryInApp: false,\n114:    category: 'ACADEMIC',\n116:    mandatoryInApp: false,\n122:    category: 'ACADEMIC',\n124:    mandatoryInApp: false,\n130:    category: 'ACADEMIC',\n132:    mandatoryInApp: false,\n139:    category: 'ACADEMIC',\n----\n/**\n * Paths reachable without a session (FR-12). A trailing '/' means prefix\n * match. There is deliberately no sign-up path: accounts are admin-created.\n */\nexport const PUBLIC_PAGE_PATHS = ['/', '/login', '/forgot-password', '/invite/', '/reset-password/'];\n// '/api/internal/' is gated by its own CRON_SECRET bearer check (PRD-04 NFR-8), not a session.\n// '/api/files/' (PRD-08 D1): GET runs the file access registry (the logo is public);\n// POST/DELETE call requireUser() themselves.\nexport const PUBLIC_API_PATHS = ['/api/health', '/api/auth/', '/api/internal/', '/api/files/'];\n\nexport function isPublicPath(pathname: string): boolean {\n  return [...PUBLIC_PAGE_PATHS, ...PUBLIC_API_PATHS].some((p) =>\n    p.endsWith('/') && p !== '/' ? pathname.startsWith(p) : pathname === p,\n  );\n}\n---\nimport { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'assignments', label: 'Assignments', href: (id) => `/courses/${id}/assignments`, roles: ALL_ROLES },\n  { key: 'quizzes', label: 'Quizzes', href: (id) => `/courses/${id}/quizzes`, roles: ALL_ROLES },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n  // PRD-11 FR-18 / FR-28\n  { key: 'gradebook', label: 'Gradebook', href: (id) => `/courses/${id}/gradebook`, roles: ['ADMIN', 'TEACHER'] },\n  { key: 'grades', label: 'Grades', href: (id) => `/courses/${id}/grades`, roles: ['STUDENT', 'PARENT'] },\n];\n---\nConfirmDialog\nDataTable\nDateDisplay\nEmptyState\nFileList\nFileUpload\nFormField\ngradebook\nLoadingSkeleton\nMarkdownEditor\nMarkdownView\nNotificationBell\nPageHeader\nPasswordChecklist\nreport-cards\nStatCard\nToast\nUserAvatar\nUserPicker\naccess.ts\nanalytics.ts\nattempt-service.ts\ngrading.ts\nmaintenance.ts\nquiz-service.ts\nserializers.ts\nsrc/app/api/internal/email/dispatch/route.ts\nsrc/components/NotificationBell/NotificationBell.tsx:7:import Badge from '@mui/material/Badge';\nsrc/components/NotificationBell/NotificationBell.tsx:42:/** FR-22..25: unread badge, visibility-gated 30 s poll, popover with the 10 most recent. */\nsrc/components/NotificationBell/NotificationBell.tsx:108:          <Badge badgeContent={count} max={9} color=\"error\" data-testid=\"notification-count\">\nsrc/components/NotificationBell/NotificationBell.tsx:110:          </Badge>","is_error":fal