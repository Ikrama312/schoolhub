{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014N7fnx1VtDm1wnXwhCZS6f","type":"tool_result","content":"1:import { timingSafeEqual } from 'node:crypto';\n2:import { AppError, ok, withHandler } from '@/server/http';\n3:import { env } from '@/lib/env';\n4:import { logger } from '@/lib/logger';\n5:import { dispatchEmails } from '@/server/email/dispatch';\n6:import { purgeOldNotifications } from '@/server/notifications/purge';\n7:import { purgeOrphanFiles } from '@/server/files/purge';\n8:import { sendDueReminders } from '@/server/assignments/reminders';\n9:import { autoSubmitExpiredAttempts, sendAfterCloseResultsReleased } from '@/server/quiz/maintenance';\nimport { prisma } from '@/server/db';\nimport { ANSWER_GRACE_MS } from './grading';\nimport { submitAttempt } from './attempt-service';\nimport { notifyResultsReleased } from './quiz-service';\nimport { syncQuizGrades } from '@/server/gradebook/gradebook-sync';\n\n/**\n * PRD-10 maintenance (FR-18, FR-30, FR-35), run by the internal dispatch cron on every call.\n * Both passes are idempotent across concurrent calls.\n */\n\nconst BATCH = 200;\n\n/** IN_PROGRESS attempts past deadline + grace → auto-submit (≤ 200 per call; lazy path covers the rest). */\nexport async function autoSubmitExpiredAttempts(now = new Date()): Promise<number> {\n  const expired = await prisma.quizAttempt.findMany({\n    where: { status: 'IN_PROGRESS', deadlineAt: { lt: new Date(now.getTime() - ANSWER_GRACE_MS) } },\n    select: { id: true },\n    orderBy: { deadlineAt: 'asc' },\n    take: BATCH,\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\nimport NotificationsNoneIcon from '@mui/icons-material/NotificationsNone';\nimport MarkEmailUnreadOutlinedIcon from '@mui/icons-material/MarkEmailUnreadOutlined';\nimport MenuBookOutlinedIcon from '@mui/icons-material/MenuBookOutlined';\nimport GroupsOutlinedIcon from '@mui/icons-material/GroupsOutlined';\nimport ClassOutlinedIcon from '@mui/icons-material/ClassOutlined';\nimport FactCheckOutlinedIcon from '@mui/icons-material/FactCheckOutlined';\nimport AssignmentOutlinedIcon from '@mui/icons-material/AssignmentOutlined';\nimport GradingOutlinedIcon from '@mui/icons-material/GradingOutlined';\nimport WorkspacePremiumOutlinedIcon from '@mui/icons-material/WorkspacePremiumOutlined';\nimport StraightenOutlinedIcon from '@mui/icons-material/StraightenOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n  /** Sidebar subheader; consecutive items sharing a group render under one heading (PRD-05 Decision 1). */\n  group?: string;\n}\n\n// Exported (PRD-04 TASK-3) so route handlers can call\n// requireRole(...ALL_ROLES) as the stand-in for PRD-01's not-yet-landed\n// requireUser() -- see system-design.md's Component 12.\nexport const ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n18:  { email: 'teacher@schoolhub.test', firstName: 'Tom', lastName: 'Teacher', role: 'TEACHER' },\n20:  { email: 'student@schoolhub.test', firstName: 'Sam', lastName: 'Student', role: 'STUDENT' },\n22:  { email: 'parent@schoolhub.test', firstName: 'Pat', lastName: 'Parent', role: 'PARENT' },\n121:    { name: 'Science', code: 'SCI', color: '#16A34A' },\n180: * PRD-07 FR-38: 7A/7B course sessions for every timetable slot over the 15\n184: * so if 7A/7B (or their slots) are missing this is skipped, never created.\n190:    where: { name: { in: ['7A', '7B'] }, academicYear: { isCurrent: true } },\n208:    console.log('Seed: no 7A/7B timetable slots found, skipping demo attendance');\n304:  const math = await findCourse(['MATH-7A']);\n305:  if (!math) console.log('Seed: MATH-7A not found, skipping its assignments');\n342:  const eng = await findCourse(['ENG-7A', 'ELA-7A']);\n343:  if (!eng) console.log('Seed: ENG-7A/ELA-7A not found, skipping its a