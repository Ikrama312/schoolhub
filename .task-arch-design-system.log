{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DgqsMmdMKiYefnSTndgwup","type":"tool_result","content":"import type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { getClientIp } from '@/server/http';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n  request?: Request;\n}\n\n// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\nconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    const metadata = input.metadata\n      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n      : undefined;\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n// ---------------------------------------------------------------------------\n// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n// ---------------------------------------------------------------------------\n\nexport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\nexport interface ScheduleEntry {\n  period: ExpandedSlot['period'];\n  course: ExpandedSlot['course'];\n  room: ExpandedSlot['room'];\n}\n\n/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\nexport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n  let slotTarget: SlotTarget | null;\n  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n\n  const { isoDay } = schoolNow(date, await schoolTimezone());\n  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n\n  const academicYearId = await currentYearId();\n  if (!academicYearId) return [];\n  const slots = await prisma.timetableSlot.findMany({\n    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n    include: slotInclude,\n    orderBy: { period: { order: 'asc' } },\n  });\n  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n}\n\n/** The entry running at `now` in the school timezone, else null. */\nexport async function getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null> {\n  const [schedule, tz] = await Promise.all([getScheduleForDate(user, now), schoolTimezone()]);\n  const { hhmm } = schoolNow(now, tz);\n  return schedule.find((s) => s.period.startTime <= hhmm && hhmm < s.period.endTime) ?? null;\n}\n\nfunction stripUndefined<T extends object>(obj: T) {\n  return Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== undefined)) as Partial<T>;\n}\nimport { cache } from 'react';\nimport { prisma } from '@/server/db';\n\nexport interface UpdateSchoolSettingsInput {\n  name?: string;\n  shortName?: string;\n  logoUrl?: string | null;\n  timezone?: string;\n  addressLine1?: string | null;\n  addressLine2?: string | null;\n  city?: string | null;\n  country?: string | null;\n  phone?: string | null;\n  email?: string | null;\n  website?: string | null;\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {\n  return prisma.schoolSettings.update({ where: { id: 'singleton' }, data: input });\n}\n550:  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.","is_error":false}]},"parent_tool_use_id":null,"session_id":"90141260-d1a7-451a-8239-c83fc1554359","uuid":"c3ce86b8-c7c4-4149-b3b4-d9f497a33b49","timestamp":"2026-11-06T05:32:43.834Z","tool_use_result":{"stdout":"import type { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { getClientIp } from '@/server/http';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n  /** When given, the client IP (x-forwarded-for) is stored in AuditLog.ip (FR-30). */\n  request?: Request;\n}\n\n// FR-31 defence in depth: callers pass explicit metadata, this strips secrets anyway.\nconst SECRET_KEYS = ['password', 'passwordHash', 'newPassword', 'currentPassword', 'token', 'rawToken'];\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    const metadata = input.metadata\n      ? Object.fromEntries(Object.entries(input.metadata).filter(([key]) => !SECRET_KEYS.includes(key)))\n      : undefined;\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n// ---------------------------------------------------------------------------\n// Exports for later PRDs (FR-30, FR-31): PRD-07 attendance, PRD-16 dashboards\n// ---------------------------------------------------------------------------\n\nexport type ScheduleTarget = { userId: string; role: Role } | { sectionId: string };\nexport interface ScheduleEntry {\n  period: ExpandedSlot['period'];\n  course: ExpandedSlot['course'];\n  room: ExpandedSlot['room'];\n}\n\n/** The target's classes on `date` (school timezone), ordered by period. [] on non-teaching days. */\nexport async function getScheduleForDate(target: ScheduleTarget, date: Date): Promise<ScheduleEntry[]> {\n  let slotTarget: SlotTarget | null;\n  if ('sectionId' in target) slotTarget = { kind: 'section', sectionId: target.sectionId };\n  else if (target.role === 'TEACHER') slotTarget = { kind: 'teacher', userId: target.userId };\n  else if (target.role === 'STUDENT') slotTarget = { kind: 'student', studentId: target.userId };\n  else return []; // ADMIN/PARENT have no own schedule; callers pass the student.\n\n  const { isoDay } = schoolNow(date, await schoolTimezone());\n  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.\n  const day = await prisma.schoolDay.findUnique({ where: { dayOfWeek: isoDay } });\n  if (!(day?.isTeaching ?? isoDay <= 5)) return [];\n\n  const academicYearId = await currentYearId();\n  if (!academicYearId) return [];\n  const slots = await prisma.timetableSlot.findMany({\n    where: { academicYearId, dayOfWeek: isoDay, ...slotWhere(slotTarget) },\n    include: slotInclude,\n    orderBy: { period: { order: 'asc' } },\n  });\n  return slots.map((s) => ({ period: s.period, course: s.course, room: s.room }));\n}\n\n/** The entry running at `now` in the school timezone, else null. */\nexport async function getCurrentSlot(user: { userId: string; role: Role }, now: Date): Promise<ScheduleEntry | null> {\n  const [schedule, tz] = await Promise.all([getScheduleForDate(user, now), schoolTimezone()]);\n  const { hhmm } = schoolNow(now, tz);\n  return schedule.find((s) => s.period.startTime <= hhmm && hhmm < s.period.endTime) ?? null;\n}\n\nfunction stripUndefined<T extends object>(obj: T) {\n  return Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== undefined)) as Partial<T>;\n}\nimport { cache } from 'react';\nimport { prisma } from '@/server/db';\n\nexport interface UpdateSchoolSettingsInput {\n  name?: string;\n  shortName?: string;\n  logoUrl?: string | null;\n  timezone?: string;\n  addressLine1?: string | null;\n  addressLine2?: string | null;\n  city?: string | null;\n  country?: string | null;\n  phone?: string | null;\n  email?: string | null;\n  website?: string | null;\n}\n\n/** Cached per request -- the top bar, public footer and this PRD's settings\n * page all read the one singleton row through this. */\nexport const getSchoolSettings = cache(async () => {\n  return prisma.schoolSettings.upsert({\n    where: { id: 'singleton' },\n    update: {},\n    create: { id: 'singleton' },\n  });\n});\n\nexport async function updateSchoolSettings(input: UpdateSchoolSettingsInput) {\n  return prisma.schoolSettings.update({ where: { id: 'singleton' }, data: input });\n}\n550:  // PRD-14 holidays hook in here: return [] when `date` is a school holiday.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DgqsMmdMKiYefnSTndgwup","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
