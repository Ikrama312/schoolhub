ort async function resetPassword(input: { token: string; password: string }, request?: Request) {\n  const verified = await verifyToken(input.token, 'PASSWORD_RESET');\n}\n\n/**\n * FR-25/FR-27: issue an invite token and email the link. Call sites\n * (POST /api/users/:id/invite, createUser's sendInvite checkbox, CSV import)\n * keep the same {id, inviteSentAt} shape.\n */\nexport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n  const user = await prisma.user.findUnique({ where: { id: userId }, select: { email: true, firstName: true } });\n  if (!user) throw new AppError('NOT_FOUND', 'User not found');\n  const raw = await createInviteToken(userId);\n  await sendAuthEmail(user, 'invite', authLink('invite', raw));\n  return { id: userId, inviteSentAt: new Date() };\n}\n80:  parentLinks             ParentStudentLink[]      @relation(\"ParentLinks\")\n81:  studentLinks            ParentStudentLink[]      @relation(\"StudentLinks\")\n82-  notifications           Notification[]\n83-  notificationPreferences NotificationPreference[]\n84-  homeroomSections        Section[]                @relation(\"HomeroomTeacher\")\n85-  sectionMemberships      SectionMember[]\n86-  taughtCourses           Course[]                 @relation(\"CourseTeacher\")\n87-  enrollments             Enrollment[]\n88-\n89-  @@index([lastName, firstName, email])\n--\n133:model ParentStudentLink {\n134-  id           String               @id @default(cuid())\n135-  parentId     String\n3:189-  name         String   @default(\"SchoolHub Academy\")\n5:191-  logoUrl      String?\n6:192-  timezone     String   @default(\"UTC\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"8a6de621-bc72-44a5-9725-5c1b7f039997","uuid":"1c02722c-dc5b-4384-8a6f-847e7a21835d","timestamp":"2026-11-04T07:01:52.097Z","tool_use_result":{"stdout":"src/server/services/users.ts:4:import { createToken } from '@/server/auth/tokens';\nsrc/server/services/users.ts:384:  return c