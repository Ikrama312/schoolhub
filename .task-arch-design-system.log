g handoff. The current versions of both files are still left over from SH-9.","ttft_ms":1257,"type":"result","duration_ms":164666,"uuid":"8e236801-f82e-45bd-8ae2-966fcade45fb","ttft_stream_ms":943,"time_to_request_ms":126,"first_content_frame_ms":943,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":24,"outputTokens":18285,"cacheReadInputTokens":565667,"cacheCreationInputTokens":62157,"webSearchRequests":0,"costUSD":0.8326743999999999,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":2168,"cacheCreationEphemeral5mInputTokens":47837,"cacheCreationEphemeral1hInputTokens":14320,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
