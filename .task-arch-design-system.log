i-contracts.json` and then the handoff file. The copies of both in the folder now are left over from SH-1 and will be replaced.","ttft_ms":1925,"type":"result","duration_ms":124256,"uuid":"444ca0c2-c50b-4bbf-8412-0230d2c3d145","ttft_stream_ms":929,"time_to_request_ms":114,"first_content_frame_ms":929,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":18,"outputTokens":14125,"cacheReadInputTokens":410146,"cacheCreationInputTokens":58470,"webSearchRequests":0,"costUSD":0.8323611999999999,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":590,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":58470,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
