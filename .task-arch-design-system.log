 fields for emails. Reads the singleton directly\nsrc/server/email/render.ts-27- * (settings.ts uses react `cache`, which doesn't exist outside Next).\nsrc/server/email/render.ts-28- */\nsrc/server/email/render.ts-29-export async function getEmailSchool(): Promise<EmailSchool> {\nsrc/server/email/render.ts-30-  const s = await prisma.schoolSettings.findUnique({\nsrc/server/email/render.ts-31-    where: { id: 'singleton' },\nsrc/server/email/render.ts-32-    select: { name: true, shortName: true, logoUrl: true, addressLine1: true, addressLine2: true },\nsrc/server/email/render.ts-33-  });\nsrc/server/email/render.ts-34-  return s ?? { name: 'SchoolHub Academy', shortName: 'SchoolHub', logoUrl: null, addressLine1: null, addressLine2: null };\n--\nsrc/server/email/templates/GenericNotification.tsx:5:export interface GenericNotificationData {\nsrc/server/email/templates/GenericNotification.tsx-6-  title: string;\n218:/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n219-/// at a time -- enforced in src/server/services/academicYears.ts's\n220-/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n--\n222:model AcademicYear {\n223-  id             String          @id @default(cuid())\n224-  name           String          @unique\n--\n227:  isCurrent      Boolean         @default(false)\n228-  createdAt      DateTime        @default(now())\n229-  updatedAt      DateTime        @updatedAt","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QhbnbatPpwdFTaAPnHwxNL","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
