ame_ms":1068,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":26,"outputTokens":19198,"cacheReadInputTokens":691096,"cacheCreationInputTokens":70239,"webSearchRequests":0,"costUSD":1.0841952,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1344,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":70239,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
