{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D9GFiA4nQnx9ubWD92tQrT","type":"tool_result","content":"24:export interface AudienceRow {\n59:export async function audienceClausesForUser(user: AccessUser, opts: { studentIds?: string[] } = {}): Promise<Clause[]> {\n113:export async function audienceWhereForUser(user: AccessUser, opts: { studentIds?: string[] } = {}): Promise<Prisma.EventAudienceWhereInput> {\n117:export function audienceMatchesClauses(audience: AudienceRow, clauses: Clause[]): boolean {\n126:export async function isUserInAudience(user: AccessUser, audiences: AudienceRow[]): Promise<boolean> {\n193:export async function resolveAudienceUserIds(audiences: AudienceRow[]): Promise<string[]> {\n204:export async function canTargetAudience(user: AccessUser, audience: Pick<AudienceRow, 'type' | 'refId'>): Promise<boolean> {\nsrc/server/auth/requireRole.ts:53:  const callbackUrl = headers().get('x-pathname') ?? '/dashboard';\nsrc/app/(auth)/TokenPasswordForm.tsx:42:    router.replace(!signedIn || signedIn.error ? '/login' : '/dashboard');\n77:  const items = navigationForRole(user.role, { safeguardingLead });\n87:        const active = pathname === item.href || pathname.startsWith(`${item.href}/`);\n90:            key={item.href}\n92:            href={item.href}\n110:          <Fragment key={item.href}>\n173:              <Chip size=\"small\" label={user.role} sx={{ mt: 0.5 }} />\n176:            <MenuItem component={Link} href=\"/account/security\" onClick={() => setMenuAnchor(null)}>\nsrc/app/api/internal/email:\ndispatch\n\nsrc/server/assignments:\nassignments-service.ts\ngrading-math.ts\nreminders.ts\n\nsrc/server/attendance:\nattendance-rules.ts\nattendance-service.ts\n\nsrc/server/gradebook:\nbackfill.ts\ncategories-service.ts\ngrade-calc.ts\ngradebook-service.ts\ngradebook-sync.ts\nload.ts\nscales-service.ts\nstudent-grades-service.ts\nterm-placement.ts\n\nsrc/server/timetable:\nclash-rules.ts\ntimetable-service.ts","is_error"