|\n229:| `POST /api/modules/:id/lessons` | manage | |\n230:| `GET /api/lessons/:id` | view (visibility rules) | |\n231:| `PATCH /api/lessons/:id` · `DELETE /api/lessons/:id` | manage | Includes attachments and links arrays |\n232:| `POST /api/lessons/:id/progress` | STUDENT (enrolled) | `{ completed: boolean }` |\n233:| `GET /api/lessons/:id/progress` | manage | Per-student list |\n234:| `GET /api/students/:id/learning` | `assertCanViewStudent` | |","numLines":13,"totalLines":13},"tool_result_meta":[{"id":"toolu_018cCvEXtC6trJqUVfgZfWyX","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
