{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FrBEwLdCKH4kTNtiAPdJjY","type":"tool_result","content":"import { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n}\n5:import { dispatchEmails } from '@/server/email/dispatch';\n6:import { purgeOldNotifications } from '@/server/notifications/purge';\n7:import { purgeOrphanFiles } from '@/server/files/purge';\n12:// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\n13:let lastPurgeAt = 0;\n27:  const result = await dispatchEmails({ batchSize: 50 });\n29:  if (Date.now() - lastPurgeAt > DAY_MS) {\n30:    lastPurgeAt = Date.now();\n32:      const purged = await purgeOldNotifications();\n33:      logger.info('Purged old notifications', { purged });\n35:      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n38:      await purgeOrphanFiles(new Date());\n40:      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });","is_error":false}]},"parent_tool_use_id":null,"session_id":"2a7b6583-29f5-43b3-9f4e-72722e4e3a4f","uuid":"74ec7dd2-5b21-4e2e-977d-2c89573da9ab","timestamp":"2026-11-09T05:27:05.586Z","tool_use_result":{"stdout":"import { ALL_ROLES, type Role } from './navigation';\n\nexport interface CourseTab {\n  key: string;\n  label: string;\n  href: (courseId: string) => string;\n  roles: Role[];\n}\n\n/**\n * Course home tabs (mirrors student-tabs.ts). Later PRDs (content,\n * assignments, gradebook...) register their tab here.\n */\nexport const courseTabs: CourseTab[] = [\n  { key: 'overview', label: 'Overview', href: (id) => `/courses/${id}`, roles: ALL_ROLES },\n  { key: 'roster', label: 'Roster', href: (id) => `/courses/${id}/roster`, roles: ['ADMIN', 'TEACHER', 'STUDENT'] },\n  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\n];\nimport { prisma } from '@/server/db';\nimport { assertCanViewCourse } from '@/server/auth/course-access';\nimport { canSeeDrafts, isLessonVisible } from '@/server/content/visibility';\nimport type { FileAccessResolver } from './access';\n\n/**\n * Built-in file contexts (PRD-08 FR-10). Registered lazily by access.ts on\n * first canAccessFile call, so every caller gets them.\n */\n\n/** 'lesson': the caller can view the course and (unless they manage it) the lesson is visible. */\nexport const lessonResolver: FileAccessResolver = async (user, file) => {\n  if (!user || !file.contextId) return false;\n  const lesson = await prisma.lesson.findUnique({\n    where: { id: file.contextId },\n    select: {\n      status: true,\n      publishAt: true,\n      module: {\n        select: { status: true, publishAt: true, course: { select: { id: true, teacherId: true, coTeacherIds: true } } },\n      },\n    },\n  });\n  if (!lesson) return false;\n  try {\n    await assertCanViewCourse(user as Parameters<typeof assertCanViewCourse>[0], lesson.module.course.id);\n  } catch {\n    return false;\n  }\n  return canSeeDrafts(user, lesson.module.course) || isLessonVisible(lesson, lesson.module, new Date());\n};\n\n/** 'logo': public, including anonymous (app shell, login page, emails). */\nexport const logoResolver: FileAccessResolver = () => true;\n\nexport function registerBuiltInContexts(register: (context: string, resolver: FileAccessResolver) => void): void {\n  register('lesson', lessonResolver);\n  register('logo', logoResolver);\n}\n5:import { dispatchEmails } from '@/server/email/dispatch';\n6:import { purgeOldNotifications } from '@/server/notifications/purge';\n7:import { purgeOrphanFiles } from '@/server/files/purge';\n12:// ponytail: in-memory lastPurgeAt (per process), move to a DB row if purge cost matters.\n13:let lastPurgeAt = 0;\n27:  const result = await dispatchEmails({ batchSize: 50 });\n29:  if (Date.now() - lastPurgeAt > DAY_MS) {\n30:    lastPurgeAt = Date.now();\n32:      const purged = await purgeOldNotifications();\n33:      logger.info('Purged old notifications', { purged });\n35:      logger.error('Notification purge failed', { message: error instanceof Error ? error.message : String(error) });\n38:      await purgeOrphanFiles(new Date());\n40:      logger.error('Orphan file purge failed', { message: error instanceof Error ? error.message : String(error) });","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FrBEwLdCKH4kTNtiAPdJjY","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgroNaCzy7VinpURzeyzE","type":"message","role":"assistant","content":[{"type":"text","text":"Confirmed. Writing the design."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2003,"cache_read_input_tokens":68628,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2003},"output_tokens":28,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2a7b6583-29f5-43b3-9f4e-72722e4e3a4f","uuid":"581a4ebc-a3a4-4370-9681-9c02b21e460b","timestamp":"2026-11-09T05:27:06.523Z","request_id":"req_011CgroNZpRtAmo5qfUDWao5"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgroNaCzy7VinpURzeyzE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MwXWtuFqrra4hf9AyNk5Wz","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/system-design.md","content":"# System Design: SH-9 · PRD-09 Assignments & Submissions (SCH-009)\n\nTicket: SH-9 · Phase: architect (arch-design-system) · Timestamp: 2026-11-09T10:40:00Z · Status: complete\nInputs: `artifacts/intake/requirements.json` (61 FR + 17 NFR, 95%), `handoff-to-architect.json` (8 blockers),\n`tech-stack-decisions.md` (ADR-1..ADR-8), `requirements-analysis-notes.md` (B1–B16, D1–D10). Run mode: `--brownfield --tech-stack react`.\n\n> This file replaces the stale SH-8 design that was in this folder. `api-contracts.json`, `handoff-to-dev-planning.json`\n> and `threat-model-notes.json` in this folder are also leftovers from earlier tickets. `arch-api-contracts` overwrites the first two.\n\n---\n\n## 1. Overview\n\nSchoolHub is a Next.js 14 App Router monolith (React 18, TS strict, Prisma 5 / PostgreSQL 16, Auth.js v5, MUI 9.5.0).\nSH-9 adds **assignments**: teacher authoring with an optional rubric, student submission with resubmission history,\na keyboard-driven grading screen, return flow, exemptions, offline grading, a cross-course `/assignments` page per role,\nfour notifications, and two reminder passes.\n\nShape of the change:\n\n- **One migration**, `add_assignments` (FR-1..FR-6).\n- **One feature folder**, `src/server/assignments/`, with three files: `assignments-service.ts` (all DB logic),\n  `grading-math.ts` (pure, isomorphic, unit-tested), `reminders.ts` (maintenance pass).\n- **One validator file**, `src/lib/validators/assignments.ts`, shared by forms and handlers.\n- Thin route handlers under `src/app/api/{courses,assignments,submissions,me,students}/…` (NFR-7, NFR-8).\n- Pages under `src/app/(app)/…`, plus the four PRD-08 shared components that were never built (D1).\n- **No new dependencies, services, queues, or cron** (ADR-1, ADR-8). Reminders hook into the existing dispatcher.\n\n### 1.1 Intake blockers and how they are resolved (Compliance Rule 5)\n\n| # | Intake blocker | Resolution in this design |\n|---|---|---|\n| 1 | PRD-08 UI is missing: FileUpload, FileList, MarkdownView, MarkdownEditor | Build the minimum of all four in `src/components/<Name>/<Name>.tsx` (ADR-5, §2.5). No other PRD-08 scope. |\n| 2 | MUI X break: `@mui/x-internals` 9.15.0 vs X 9.5.0 | `package.json` `overrides: { \"@mui/x-internals\": \"9.1.0\" }` (ADR-2). This fixes both DataGrid (FR-17) and DateTimePicker (FR-9). Fallback: FR-17 uses an MUI `Table`, and FR-9 uses `TextField type=\"datetime-local\"`. Dev verifies with `npm ls` plus a compile **before** building UI. |\n| 3 | vitest import break | Change the import in `vitest.config.ts` to `'vitest/config'` and delete `vitest.tmp.config.ts` (ADR-3). |\n| 4 | CSP `script-src 'self'` breaks hydration | Leave it alone. The e2e spec uses `test.use({ bypassCSP: true })` (ADR-4). The platform nonce fix is a follow-up ticket. |\n| 5 | `studentTabs` has no renderer | Register the FR-41 tab and build `students/[id]/assignments/page.tsx`. The page works by direct URL. **No tab bar is built** (NFR-15). This is a known gap and is carried to the handoff. |\n| 6 | LOW-confidence defaults FR-15, FR-52, FR-60 | Adopt intake's defaults as written (§5). Each one is a single predicate or a single copy rule, so it is cheap to change later. |\n| 7 | Reuse list | §2.4 maps each reused helper. No helper is duplicated (NFR-11). |\n| 8 | mui-mcp must be reachable (NFR-6) | This is a hard gate on the dev phase. Dev looks up every MUI component through `useMuiDocs` → `fetchDocs` before using it. If mui-mcp is unreachable, dev stops and reports a blocker. |\n\n### 1.2 New finding from this sub-task (not in intake)\n\n`next.config.js` sends **`X-Frame-Options: DENY`** on `/:path*`. That blocks the same-origin\n`<iframe src=\"/api/files/:id?inline=1\">` PDF preview required by FR-29. CSP `default-src 'self'` already allows same-origin frames,\nso the X-Frame-Options header is the only thing blocking it. `<img>` previews are not affected.\n\n**Decision D11:** in `next.config.js`, split the header rule:\n- `source: '/((?!api/files/).*)'` keeps the existing headers, with `DENY`.\n- `source: '/api/files/:id'` gets the same headers, but with `X-Frame-Options: SAMEORIGIN` and `frame-ancestors 'self'` appended to the CSP.\n\nThe file route already enforces access (`canAccessFile`) and sniffs types (`nosniff`), so letting our own pages frame it adds no exposure.\n**Fallback**, if the dev wants zero header changes: show PDFs as an \"Open\" link (`target=\"_blank\"`) instead of an iframe. Images still preview inline.\n\n---\n\n## 2. Component Breakdown\n\n### 2.1 Data model: migration `add_assignments` (FR-1..FR-6)\n\nAll additive. Existing models get back-relations only (NFR-11).\n\n```\nenum SubmissionType   { ONLINE_TEXT FILE_UPLOAD TEXT_AND_FILE NO_SUBMISSION }   // FR-1\nenum AssignmentStatus { DRAFT SCHEDULED PUBLISHED }                              // FR-1\nenum SubmissionStatus { SUBMITTED RETURNED }                                     // FR-1\n\nAssignment (FR-2)\n  id, courseId → Course (Cascade), title, instructions (Text), submissionType, maxPoints Decimal(6,2),\n  dueAt, availableFrom?, allowLate, lateCutoffAt?, latePenaltyPercentPerDay Decimal(5,2),\n  maxLatePenaltyPercent Decimal(5,2), maxFileCount Int, allowExtraCredit Boolean @default(false),\n  status AssignmentStatus, rubricId String? @unique → Rubric, notifiedAt?, archivedAt?,\n  createdById, createdAt, updatedAt\n  @@index([courseId, dueAt])\n\nAssignmentAttachment (FR-3)  assignmentId → Assignment (Cascade), fileId → FileObject; @@id([assignmentId, fileId])\nRubric (FR-3)                id, criteria RubricCriterion[]\nRubricCriterion (FR-3)       id, rubricId → Rubric (Cascade), title, description?, maxPoints Decimal(6,2), order Int,\n                             levels Json  // [{label, points, description}]\n\nSubmission (FR-4)\n  id, assignmentId → Assignment (Cascade), studentId → User, status SubmissionStatus, text?,\n  attemptNumber Int, submittedAt, isLate Boolean, lateDays Int,\n  rawScore Decimal(6,2)?, penaltyPercent Decimal(5,2)?, finalScore Decimal(6,2)?,\n  rubricScores Json?  // [{criterionId, points, comment}]\n  feedback?, gradedById?, gradedAt?, returnedAt?\n  @@unique([assignmentId, studentId])\nSubmissionFile (FR-4)        submissionId → Submission (Cascade), fileId → FileObject; @@id([submissionId, fileId])\nSubmissionHistory (FR-4)     id, submissionId → Submission (Cascade), attemptNumber, text?, fileIds String[], submittedAt\n\nGradeExemption (FR-5)        assignmentId → Assignment (Cascade), studentId, reason?, createdAt; @@id([assignmentId, studentId])\nAssignmentReminder (FR-6)    assignmentId → Assignment (Cascade), studentId, kind String ('due_soon'|'missing'), createdAt\n                             @@unique([assignmentId, studentId, kind])\n```\n\nBack-relations added: `Course.assignments`, `FileObject.assignmentAttachments`, `FileObject.submissionFiles`, `User.submissions`.\n\nModel decisions:\n- **One Submission row per student.** Earlier attempts live in `SubmissionHistory` (FR-24).\n- `SubmissionHistory.fileIds` has no FK. Old attempt files **stay attached** to the same submission id and are never detached. Detaching them would let `purgeOrphanFiles` delete history bytes (B1).\n- Offline grade (FR-8, FR-34) = a Submission with `attemptNumber 0`, `text null`, no files, and `submittedAt = gradedAt`.\n- A Rubric is 1:1 with an Assignment (`rubricId @unique`). Delete the rubric in the same transaction as a hard-deleted assignment.\n- FR-14: **no column added.** The \"review grades\" banner is client-side, shown after a successful PATCH that changed `maxPoints` while `submissionCount > 0`.\n\n### 2.2 Server: `src/server/assignments/` (NFR-8)\n\n| File | Contents | Reqs |\n|---|---|---|\n| `grading-math.ts` | **Pure and isomorphic** (no Prisma client import; `Decimal` from `decimal.js`, the same package Prisma uses). `lateDays(submittedAt, dueAt)`, `defaultPenalty(lateDays, perDay, max)`, `computeFinalScore(raw, pct)`, `rubricTotal(criteria)`, `maxRawScore(maxPoints, allowExtraCredit)`, `submissionChipStatus(row)` | FR-23, FR-30, FR-31, FR-36, FR-28, NFR-1, NFR-14 |\n| `assignments-service.ts` | All DB logic: visibility, CRUD, duplicate, submit, grade, return, exempt, offline grade, role-shaped lists, the serializer, and notify triggers. | FR-8, FR-12..15, FR-22, FR-24, FR-32, FR-34, FR-35, FR-42, FR-44, FR-48..58, FR-59 |\n| `reminders.ts` | `sendDueReminders(now)`: due_soon and missing passes. | FR-43, FR-45, FR-60 |\n\n`grading-math.ts` imports only `decimal.js`. The service wraps values as `Prisma.Decimal` (same class). This keeps one function for the client preview and the server value (ADR-7).\n\n#### Single-source helpers (inside `assignments-service.ts` unless noted)\n\n| Helper | Definition | Used by |\n|---|---|---|\n| `isAssignmentVisible(a, now)` | `!a.archivedAt && isVisible({ status: a.status, publishAt: a.availableFrom }, now)`. Reuses `src/server/content/visibility.ts`: widen `Publishable.status` to `ContentStatus \\| AssignmentStatus` (same string values). | FR-13, FR-22, FR-47, FR-48, FR-50, FR-52, FR-57, FR-58, reminders |\n| `visibleWhere(now)` | The Prisma `where` equivalent: `{ archivedAt: null, OR: [{status:'PUBLISHED'}, {status:'SCHEDULED', availableFrom:{lte:now}}] }` | list queries, reminders |\n| `missingWhere(now)` | visible ∧ `dueAt < now` ∧ `submissionType ≠ NO_SUBMISSION`; per student: no Submission and no GradeExemption | FR-37, FR-35, FR-45, FR-60 |\n| `toStudentSubmission(sub)` | Removes `rawScore, penaltyPercent, finalScore, feedback, rubricScores, gradedById, gradedAt` unless `status === 'RETURNED'`. Always removes history. | FR-27, FR-50, FR-55, FR-57, FR-58, NFR-4 |\n| `serializeDecimals` | Prisma.Decimal → `string` (\"14.40\") on the way out | NFR-1 (D5) |\n| `canSeeDrafts(user, course)` | **Reused** from `visibility.ts`: ADMIN, teacher or co-teacher = \"manager\" | everywhere |\n| `nextTeachingDayDueAt(now, tz, teachingDays)` | **In `src/lib/dates.ts`**, next to `schoolNow`. Walk from tomorrow (≤7 days) to the first `isTeaching` weekday, take 23:59 local, convert with `fromZonedTime`. If no day is teaching, use tomorrow. | FR-10, NFR-9 |\n| `resolveViewedStudent(user, studentId?)` | STUDENT → self. PARENT → `studentId` must be in `ParentStudentLink`; it defaults to the only linked child. Otherwise FORBIDDEN. | FR-18, FR-38, FR-57 |\n\n#### Key service flows\n\n**Create / update (FR-49, FR-51, FR-11, FR-12, FR-42).** One transaction: Zod parse → if a rubric is given, `rubricTotal == maxPoints`, otherwise\nVALIDATION_ERROR `Rubric totals {sum} points but the assignment is worth {maxPoints}.` → SCHEDULED requires `availableFrom > new Date()` (checked in the service,\nbecause Zod has no server clock, NFR-2) → upsert rubric and criteria → write the assignment → `attachFiles(tx, user, fileIds, 'assignment', id)`. On PATCH,\ndiff the attachments: removed files are `detachFiles` (the purge reclaims them). **After commit**, if the assignment is now visible → `publishOnce(id)`.\n\n**`publishOnce(id)` (FR-42).** `updateMany({ where:{ id, notifiedAt:null }, data:{ notifiedAt: now } })`. Only when `count === 1`, call `notify()` for\n`assignment.published` to ACTIVE-enrolled students. Called from: create/PATCH after commit, and from the student/parent list read paths (FR-48, FR-57)\nfor SCHEDULED assignments that have become visible with `notifiedAt` null. On GET it is fire-and-forget (`void publishOnce(id).catch(logger.error)`) and never fails the read.\n\n**Delete (FR-51).** If there are 0 submissions → detach the attachments, then delete the assignment and its rubric (cascade). Otherwise → set `archivedAt = now`. Audit `assignment.delete|archive`.\n\n**Duplicate (FR-15).** `assertCanManageCourse` for **each** target course, then one transaction per target. Copy the rubric and criteria as new rows.\nAttachments: `readFile` → `saveFile` → a new FileObject (context `'assignment'`), because FileObject holds one context (B2). Status is DRAFT and `notifiedAt` is null.\nSame `dueAt`; `availableFrom` and `lateCutoffAt` keep their offsets from dueAt (FR-15 default).\n\n**Submit (FR-22..FR-24, FR-53, FR-60).** `now = new Date()` on the server. Checks, in order (first failure wins):\n1. Assignment exists and `isAssignmentVisible` → otherwise NOT_FOUND.\n2. `role === 'STUDENT'` and ACTIVE-enrolled in the course → otherwise FORBIDDEN.\n3. Not exempt; `submissionType ≠ NO_SUBMISSION` → otherwise VALIDATION_ERROR.\n4. Deadline: `now ≤ dueAt`, or `allowLate && (!lateCutoffAt || now ≤ lateCutoffAt)` → otherwise VALIDATION_ERROR `The deadline has passed and late submissions are closed.`\n5. Content matches the type: text for ONLINE_TEXT, ≥1 file for FILE_UPLOAD, ≥1 of either for TEXT_AND_FILE. Also `fileIds.length ≤ maxFileCount`.\n6. Each file has `ownerId = me`, `context = 'submission'`, and is unattached **or** already attached to this submission. The service checks `context` before calling `attachFiles`, because `attachFiles` does not (B1).\n\nThen, in one transaction:\n- **No row:** create the Submission (`attemptNumber 1`, `isLate`, `lateDays` from `grading-math`).\n- **Row with `status = SUBMITTED`**, including an attempt-0 offline row (D9): insert `SubmissionHistory` from the current row, `attemptNumber++`, clear all grade fields, and replace the `SubmissionFile` rows. Old files stay attached.\n- **Row with `RETURNED`:** CONFLICT `This submission has been returned and can no longer be changed.`\n\n`attachFiles(tx, user, newFileIds, 'submission', submission.id)`. A P2002 from two concurrent first submits → retry once as a resubmit.\n\n**Grade (FR-56, FR-30, FR-31, FR-36, FR-32 \"Save & return\").** `PUT /api/submissions/:id/grade { rawScore?, penaltyPercent, feedback?, rubricScores?, return?: boolean }`.\n- If the assignment has a rubric: `rubricScores` are required, every criterion must be scored exactly once, `0 ≤ points ≤ criterion.maxPoints`, and **the server sets `rawScore = Σ points`** (any client raw value is ignored, D7).\n- Otherwise: `0 ≤ rawScore ≤ maxRawScore` (×1.2 when `allowExtraCredit`). Extra credit applies to rawScore only.\n- `0 ≤ penaltyPercent ≤ 100`. `finalScore = computeFinalScore`. Set `gradedById`, `gradedAt`. The status stays SUBMITTED.\n- `return: true` → in the same transaction, set `status RETURNED`, `returnedAt`, then notify after commit (D6: a single round trip). Audit `submission.grade` (+ `submission.return`).\n\n**Bulk return (FR-32).** `POST /api/assignments/:id/return { submissionIds? }`. The default set is `gradedAt != null AND status = SUBMITTED`. A supplied id that is ungraded is\nskipped and reported in the response (`{returned, skipped}`). One `updateMany`, then one `notifyStudentAndParents` per student (FR-44), plus **one audit row per submission** (FR-59), so\na per-record audit trail is possible.\n\n**Offline grade (FR-34, FR-8).** The student must be ACTIVE-enrolled. If a submission already exists → CONFLICT (grade that one instead). Create the attempt-0 row\nwith the grade fields and penalty 0, using the same validation as Grade. Audit `submission.grade_offline`.\n\n**Exempt (FR-35).** PUT = `upsert` GradeExemption, DELETE = `deleteMany` (both idempotent). Audit `assignment.exempt|unexempt`. The effects come only through\n`missingWhere`, the submit rule 3, and reminders. The PRD-11 \"exclude\" flag **is** the row itself (NFR-15).\n\n### 2.3 Maintenance: `reminders.ts` (FR-43, FR-45, FR-60)\n\n`sendDueReminders(now)` is called on **every** request to `src/app/api/internal/email/dispatch/route.ts`, outside the daily `lastPurgeAt` block, in its own try/catch with logger (B8).\n\n| Pass | Assignment window | Targets | Notify |\n|---|---|---|---|\n| due_soon | `visibleWhere` ∧ `dueAt ∈ (now, now+24h]` ∧ `type ≠ NO_SUBMISSION` | ACTIVE-enrolled, no Submission, no GradeExemption | `assignment.due_soon` → student |\n| missing | `visibleWhere` ∧ `dueAt ∈ [now−8d, now−24h]` ∧ `type ≠ NO_SUBMISSION` | same | `assignment.missing` → linked parents only, via `notify()` |\n\nIdempotency: `createMany({ data: candidates, skipDuplicates: true })` cannot report *which* rows were inserted, so **insert per (assignment, student) with `create` and catch P2002**,\nand notify only on success. The Postgres unique key makes this safe across concurrent dispatchers. Candidate counts are small (one course × roster).\n`// ponytail: missing pass only looks back 8 days; widen or add a cursor if the dispatcher can be down longer.`\n\n### 2.4 Reuse map (NFR-11)\n\n| Existing | Where | Used for |\n|---|---|---|\n| `requireUser`/`requireRole`, `requirePageUser`/`requirePageRole` | `src/server/auth/requireRole.ts` | every handler and page (NFR-5) |\n| `assertCanViewCourse`, `assertCanManageCourse` | `src/server/auth/course-access.ts` | course-scoped routes |\n| `assertCanViewStudent` | `src/server/auth/student-access.ts` | FR-58 |\n| `isVisible`, `canSeeDrafts` | `src/server/content/visibility.ts` (type widened) | FR-13, manager checks |\n| `withHandler`, `ok`, `paginated`, `parseBody`, `parseQuery`, `parsePagination`, `AppError` | `src/server/http.ts` | NFR-7 envelopes and errors |\n| `audit()` | `src/server/audit.ts` | FR-59 |\n| `notify()`, `notifyStudentAndParents()`, `NOTIFICATION_TYPES` | `src/server/notifications/` | FR-42..FR-46 |\n| `attachFiles`, `detachFiles`, `POST /api/files`, `GET /api/files/:id?inline=1`, `registerBuiltInContexts`, `storage.ts` | `src/server/files/`, `src/server/storage.ts` | FR-9, FR-15, FR-20, FR-29, FR-47, FR-53 |\n| `formatInSchoolTz`, `schoolNow` | `src/lib/dates.ts` | FR-19, FR-25, NFR-9 |\n| `ConfirmDialog`, `DataTable`, `EmptyState`, `PageHeader`, `useToast`, `FormField`, `DateDisplay` | `src/components/` | FR-17, FR-21, lists, forms |\n| `courseTabs`, `studentTabs`, `navigation` | `src/config/` | FR-16, FR-40, FR-41 |\n| `logger` | `src/lib/logger.ts` | NFR-12 |\n\n### 2.5 New shared UI components (blocker 1, ADR-5)\n\n| Component | Build | Reqs |\n|---|---|---|\n| `MarkdownView` | react-markdown + remark-gfm + rehype-sanitize (default schema). Elements map to MUI `Typography`, `Link`, `Table*`, `List*`, `Box component=\"pre\"`. | NFR-10, FR-19, FR-29, FR-26 |\n| `MarkdownEditor` | MUI `TextField multiline` + `Tabs` (Write / Preview → `MarkdownView`). Controlled `value`/`onChange`, plus `maxLength`. | FR-9, FR-20, FR-30 |\n| `FileUpload` | MUI `Button` + hidden `<input type=\"file\" multiple>`. POSTs each file to `/api/files` with `context`. Props `{context, max, value: FileRef[], onChange}`. A `LinearProgress` per file, plus remove. | FR-9, FR-20 |\n| `FileList` | MUI `List` of links to `/api/files/:id`. Optional `preview` prop: `<img>` for `image/*`, `<iframe>` for `application/pdf`, both via `?inline=1` (D11). | FR-19, FR-25, FR-29 |\n\n### 2.6 Validators: `src/lib/validators/assignments.ts` (FR-7)\n\n`assignmentInput` (FR-7 limits; `.superRefine`: `lateCutoffAt > dueAt`, rubric sum = maxPoints using `rubricTotal`), `rubricCriterionInput`,\n`submissionInput {text? ≤50k, fileIds ≤10}`, `gradeInput {rawScore?, penaltyPercent 0–100, feedback? ≤10k, rubricScores?, return?}`,\n`offlineGradeInput`, `bulkReturnInput`, `duplicateInput {courseIds min 1}`, `meAssignmentsQuery {studentId?, tab?, courseId?}`.\nDecimals are accepted as `z.union([z.number(), z.string()])` and converted to Decimal in the service. No request schema has a timestamp field except\n`dueAt`/`availableFrom`/`lateCutoffAt`, which are authoring data, not \"now\" (NFR-2).\n\n### 2.7 Route handlers (thin: Zod → service → envelope; NFR-7)\n\n| Route | Auth | Service fn | Reqs |\n|---|---|---|---|\n| `GET /api/courses/[id]/assignments` | user + view course | `listCourseAssignments` (manager shape with `groupBy` counts / student shape) | FR-48, FR-17, FR-18 |\n| `POST /api/courses/[id]/assignments` | manage course | `createAssignment` | FR-49 |\n| `GET /api/assignments/[id]` | view (NOT_FOUND for invisible to non-manager) | `getAssignment` (+ own submission, `serverNow`) | FR-50, FR-19 |\n| `PATCH` / `DELETE /api/assignments/[id]` | manage | `updateAssignment` / `deleteOrArchiveAssignment` | FR-51, FR-14 |\n| `POST /api/assignments/[id]/duplicate` | manage source + each target | `duplicateAssignment` | FR-15 |\n| `GET /api/assignments/[id]/submissions` | manage | `listGradingRoster` (every ACTIVE enrollee; `pageSize` ≤100) | FR-54, FR-28 |\n| `POST /api/assignments/[id]/submissions` | STUDENT | `submit` | FR-53, FR-22..24 |\n| `POST /api/assignments/[id]/return` | manage | `bulkReturn` | FR-32, FR-44 |\n| `POST /api/assignments/[id]/grade-offline` | manage | `gradeOffline` | FR-34, FR-8 |\n| `PUT` / `DELETE /api/assignments/[id]/exemptions/[studentId]` | manage | `setExemption` | FR-35 |\n| `GET /api/submissions/[id]` | submitter, linked parent, or manager; history for managers only | `getSubmission` | FR-55, FR-29, NFR-3 |\n| `PUT /api/submissions/[id]/grade` | manage | `gradeSubmission` | FR-56, FR-30..32, FR-36 |\n| `GET /api/me/assignments` | any user; role switch | `listMyAssignments` | FR-57, FR-37..39 |\n| `GET /api/students/[id]/assignments` | `assertCanViewStudent` | `listStudentAssignments` | FR-58, FR-41 |\n\nShared response conventions for `arch-api-contracts`: Decimals are **strings**. Timestamps are ISO UTC strings. Student/parent submission objects\nalways pass through `toStudentSubmission`. FR-58: a viewer who manages the course gets the full fields, everyone else gets the serializer (D8).\n`/api/me/assignments` for ADMIN = \"To grade\" across all courses (intake default).\n\n### 2.8 Pages (`src/app/(app)/…`)\n\n| Page | Notes | Reqs |\n|---|---|---|\n| `courses/[courseId]/assignments/page.tsx` | Manager: `DataTable` (title, due, status, submitted/total, graded/submitted, Grade button; Archived chip). Student/parent: grouped `List` (Upcoming / Past due / Submitted / Returned). Parent child selector when more than one linked child is enrolled. | FR-16..18, FR-52 |\n| `courses/[courseId]/assignments/new/page.tsx` + `[assignmentId]/edit/page.tsx` | One shared `AssignmentForm` (react-hook-form + the Zod schema). Defaults: dueAt = `nextTeachingDayDueAt` (computed server-side, passed as a prop), maxPoints 100, FILE_UPLOAD, maxFileCount 3, allowLate off (NFR-16). Rubric builder: `@dnd-kit/sortable` with Up/Down buttons as the keyboard fallback, and a live sum error. Buttons: Save draft / Publish / Schedule. Edit warns per FR-14. \"Duplicate to other courses\" dialog with an `Autocomplete` of managed courses. | FR-9..15 |\n| `courses/[courseId]/assignments/[assignmentId]/page.tsx` | MarkdownView instructions, FileList, due and late-policy summary, rubric table, countdown under 48 h (offset from `serverNow`, display only). Submission panel by type, `localStorage` draft key `assignment:{id}:{userId}` (cleared on success), ConfirmDialog before POST, receipt via `formatInSchoolTz`, returned results, or \"Submitted — awaiting grading\". Parent: read-only, no panel. | FR-19..27 |\n| `courses/[courseId]/assignments/[assignmentId]/grade/page.tsx` | Left: `List` + status `Chip`s from `submissionChipStatus`, filter, sort by name or time. Main: MarkdownView text, FileList with preview, history `Select`. Form: rubric `ToggleButtonGroup`s that auto-sum, prefilled penalty (`defaultPenalty`), live final score (`computeFinalScore`), MarkdownEditor feedback. Buttons Save / Save & return / Return all graded / Grade without submission / Exempt toggle. J/K/Ctrl+Enter keydown handler that skips J/K in input/textarea/contenteditable, with a visible shortcut hint. **NFR-3:** a plain `Map<id, Submission>` cache; after each selection, prefetch the next and previous `GET /api/submissions/:id`. | FR-28..36, NFR-3, NFR-16, NFR-17 |\n| `assignments/page.tsx` | STUDENT: `Tabs` Upcoming/Missing/Submitted/Returned + course filter. PARENT: child selector, same view, read-only. TEACHER/ADMIN: \"To grade\" list, oldest first. | FR-37..39 |\n| `students/[id]/assignments/page.tsx` | Per-student list (FR-58). Reachable by URL only (blocker 5). | FR-41 |\n\n### 2.9 Config and registrations\n\n- `src/config/course-tabs.ts`: `{ key:'assignments', label:'Assignments', href: id => /courses/${id}/assignments, roles: ALL_ROLES }` (FR-16).\n- `src/config/navigation.ts`: `Assignments` → `/assignments`, roles `[STUDENT, PARENT, TEACHER, ADMIN]` (FR-40; ADMIN added because the To-grade default applies to ADMIN).\n- `src/config/student-tabs.ts`: `assignments` entry (FR-41).\n- `src/server/notifications/types.ts`: four keys, category ACADEMIC (FR-46):\n  `assignment.published` [STUDENT] email false · `assignment.due_soon` [STUDENT] email false · `assignment.returned` [STUDENT, PARENT] email false · `assignment.missing` [PARENT] email **true**.\n- `src/server/files/contexts.ts` (FR-47), registered in `registerBuiltInContexts`:\n  - `assignmentResolver`: load the assignment and course → `assertCanViewCourse` → `canSeeDrafts || isAssignmentVisible`.\n  - `submissionResolver`: load the submission and course → allow `studentId === user.id`, a linked parent (`ParentStudentLink`), or `canSeeDrafts`. Deny everyone else, including other students (NFR-4, AC-10).\n- `next.config.js`: D11 header split.\n- `package.json`: `overrides[\"@mui/x-internals\"] = \"9.1.0\"` (ADR-2). `vitest.config.ts` import fix (ADR-3).\n- `prisma/seed.ts`: FR-61 block, idempotent: look up courses by code (skip if missing), upsert by `(courseId, title)`, Decimals as strings, no file bytes.\n\n---\n\n## 3. Data Flow\n\n**Author → publish.** Teacher form → `POST /api/courses/:id/assignments` → validate (Zod + rubric sum + schedule time) → tx (rubric, assignment, attachments) → commit → `publishOnce` → `notify(assignment.published)` to enrolled students.\n\n**Scheduled becomes visible.** No job. A student/parent list read evaluates `visibleWhere(now)`. Any newly visible assignment with `notifiedAt` null → fire-and-forget `publishOnce` (the atomic guard sends exactly once).\n\n**Submit.** Student uploads files → `POST /api/files {context:'submission'}` (unattached, owner-only readable) → `POST /api/assignments/:id/submissions {text, fileIds}` → the six checks in order → tx (history snapshot if resubmitting, upsert submission, file rows, `attachFiles` → contextId = submission.id) → receipt.\nFrom then on, the files are readable through `submissionResolver` only by the student, their parents, and course managers.\n\n**Grade → return.** Grader page loads the roster (FR-54) → selects a student → `GET /api/submissions/:id` (cached; next and previous prefetched) → form computes the preview with `grading-math` → `PUT …/grade {…, return?}` → server recomputes everything authoritatively → tx → audit → (if return) `notifyStudentAndParents(assignment.returned, \"Course: Title — 18/20\")`.\nStudent `GET` now gets the grade fields, because the serializer unlocks on RETURNED.\n\n**Reminders.** The external caller hits `/api/internal/email/dispatch` → `dispatchEmails` → `sendDueReminders(now)` → due_soon and missing candidate queries → per-row `AssignmentReminder.create` (P2002 = already sent) → `notify`.\n\n**Privacy boundaries (NFR-4), three layers:** (1) query scoping: student and parent paths always filter `studentId ∈ resolveViewedStudent`; (2) `toStudentSubmission` serializer; (3) the file resolvers for `/api/files/:id`.\n\n---\n\n## 4. Testing layout (NFR-13, NFR-14)\n\n- `tests/unit/assignments/grading-math.test.ts`: lateDays (exactly 24 h = 1, 24 h + 1 ms = 2, across spring-forward and fall-back in `Europe/London`), penalty cap, final score (18 @ 20 % = \"14.40\", half-up at .005), rubric sum, chip status. Also `nextTeachingDayDueAt` across DST.\n- `tests/integration/assignments/*.test.ts`: resubmission history (files kept attached), RETURNED refuses resubmit, return flow plus serializer unlock, reminder idempotency (call twice → one notification), exemption removes from missing and blocks submit, NO_SUBMISSION excluded, file resolver denies another student (AC-10).\n- `tests/e2e/assignments.spec.ts` (`bypassCSP: true`): teacher creates → student submits a file → teacher grades with a rubric and returns → student sees feedback; parent sees the missing list.\n\n---\n\n## 5. Decisions log\n\n| # | Decision | Reqs |\n|---|---|---|\n| D1 | Build the minimal MarkdownView, MarkdownEditor, FileUpload and FileList in `src/components/` | FR-9, FR-19, FR-20, FR-29, FR-30 |\n| D2 | Pin `@mui/x-internals` 9.1.0 via overrides; fallbacks are MUI `Table` and `datetime-local` | FR-17, FR-9 |\n| D3 | Fix the vitest import; e2e uses bypassCSP | NFR-13, NFR-14 |\n| D4 | Register the student tab and page; no tab bar | FR-41 |\n| D5 | Decimals are strings in JSON | NFR-1 |\n| D6 | \"Save & return\" = `PUT …/grade {return:true}`, one transaction | FR-32 |\n| D7 | With a rubric, the server sets `rawScore = Σ rubric points` | FR-30, FR-36 |\n| D8 | FR-58: managers get the full fields, other viewers get the serializer | FR-58, FR-27 |\n| D9 | An online submit over an unreturned offline grade = a resubmission | FR-8, FR-24 |\n| D10 | The missing pass looks back 8 days (`ponytail:` note) | FR-45 |\n| D11 | `X-Frame-Options: SAMEORIGIN` only for `/api/files/:id`, so PDF iframes work | FR-29 |\n| D12 | Intake defaults adopted: FR-15 same dueAt plus offsets; FR-52 archived = hidden from students/parents, closed, no reminders, visible to managers; FR-60 NO_SUBMISSION never missing or reminded; FR-10 weekdays only; FR-36 extra credit raw-only; ADMIN /assignments = To grade | FR-10, FR-15, FR-36, FR-39, FR-52, FR-60 |\n| D13 | Resubmission after RETURNED → CONFLICT (409). Deadline and content failures → VALIDATION_ERROR | FR-22, FR-24 |\n| D14 | One audit row per affected submission, including bulk return | FR-59 |\n| D15 | FR-14 banner is client-side; no schema column | FR-14 |\n\n---\n\n## 6. Requirements Traceability\n\n| Req | Design element |\n|---|---|\n| FR-1 | §2.1 enums in migration `add_assignments` |\n| FR-2 | §2.1 `Assignment` (+allowExtraCredit, notifiedAt, archivedAt, rubricId @unique, index) |\n| FR-3 | §2.1 `AssignmentAttachment`, `Rubric`, `RubricCriterion` |\n| FR-4 | §2.1 `Submission`, `SubmissionFile`, `SubmissionHistory` |\n| FR-5 | §2.1 `GradeExemption` |\n| FR-6 | §2.1 `AssignmentReminder`; §2.3 idempotency |\n| FR-7 | §2.6 `src/lib/validators/assignments.ts` |\n| FR-8 | §2.1 attempt-0 row; §2.2 Offline grade; D9 |\n| FR-9 | §2.8 `AssignmentForm`; §2.5 MarkdownEditor, FileUpload; D2 |\n| FR-10 | §2.2 `nextTeachingDayDueAt` in `src/lib/dates.ts` |\n| FR-11 | §2.8 rubric builder; §2.2 Create (server rubric-sum check); §2.6 superRefine |\n| FR-12 | §2.8 three buttons; §2.2 Create (SCHEDULED future check) |\n| FR-13 | §2.2 `isAssignmentVisible` / `visibleWhere` (read-time, no job) |\n| FR-14 | §2.8 edit warning; D15 |\n| FR-15 | §2.2 Duplicate; §2.7 duplicate route |\n| FR-16 | §2.9 courseTabs entry |\n| FR-17 | §2.8 manager DataTable; §2.7 FR-48 manager shape; D2 |\n| FR-18 | §2.8 student/parent grouped list; `resolveViewedStudent` |\n| FR-19 | §2.8 assignment page; §2.5 MarkdownView, FileList |\n| FR-20 | §2.8 submission panel (localStorage draft); §2.5 FileUpload |\n| FR-21 | §2.8 ConfirmDialog before POST |\n| FR-22 | §2.2 Submit checks 1–4 |\n| FR-23 | §2.2 `grading-math.lateDays` |\n| FR-24 | §2.2 Submit transaction (history, clear grade, files kept) |\n| FR-25 | §2.8 receipt via `formatInSchoolTz` |\n| FR-26 | §2.8 returned results view |\n| FR-27 | §2.2 `toStudentSubmission` serializer |\n| FR-28 | §2.8 grading left panel; `submissionChipStatus` |\n| FR-29 | §2.8 grading main panel; §2.5 FileList preview; D11 |\n| FR-30 | §2.8 grading form; `defaultPenalty`, `computeFinalScore`; D7 |\n| FR-31 | §2.2 `grading-math.computeFinalScore` (Decimal, ROUND_HALF_UP) |\n| FR-32 | §2.2 Grade (`return:true`) and Bulk return; D6 |\n| FR-33 | §2.8 keydown handler |\n| FR-34 | §2.2 Offline grade; §2.7 grade-offline route |\n| FR-35 | §2.2 Exempt; `missingWhere`; Submit check 3 |\n| FR-36 | §2.2 Grade validation; `maxRawScore` |\n| FR-37 | §2.8 `/assignments` STUDENT; `missingWhere` |\n| FR-38 | §2.8 `/assignments` PARENT; `resolveViewedStudent` |\n| FR-39 | §2.8 `/assignments` TEACHER/ADMIN To grade |\n| FR-40 | §2.9 navigation entry |\n| FR-41 | §2.9 studentTabs entry; §2.8 students page; blocker 5 |\n| FR-42 | §2.2 `publishOnce` (atomic notifiedAt) |\n| FR-43 | §2.3 due_soon pass |\n| FR-44 | §2.2 Grade/Bulk return → `notifyStudentAndParents` |\n| FR-45 | §2.3 missing pass (parents only) |\n| FR-46 | §2.9 NOTIFICATION_TYPES keys |\n| FR-47 | §2.9 `assignmentResolver`, `submissionResolver` |\n| FR-48 | §2.7 `GET /api/courses/[id]/assignments` |\n| FR-49 | §2.7 `POST /api/courses/[id]/assignments`; §2.2 Create |\n| FR-50 | §2.7 `GET /api/assignments/[id]` |\n| FR-51 | §2.7 PATCH/DELETE; §2.2 Delete |\n| FR-52 | §2.2 `isAssignmentVisible` (`!archivedAt`); D12 |\n| FR-53 | §2.7 POST submissions; §2.2 Submit checks 5–6 |\n| FR-54 | §2.7 `GET /api/assignments/[id]/submissions` |\n| FR-55 | §2.7 `GET /api/submissions/[id]` |\n| FR-56 | §2.7 `PUT /api/submissions/[id]/grade`; §2.2 Grade |\n| FR-57 | §2.7 `GET /api/me/assignments` |\n| FR-58 | §2.7 `GET /api/students/[id]/assignments`; D8 |\n| FR-59 | §2.2 audit calls; D14 |\n| FR-60 | §2.2 `missingWhere`, Submit check 3; §2.3 filters; D12 |\n| FR-61 | §2.9 seed block |\n| NFR-1 | §2.2 `grading-math` (Decimal); D5 strings in JSON |\n| NFR-2 | §2.2 server `now` everywhere; §2.6 no client clock fields |\n| NFR-3 | §2.8 grading `Map` cache plus next/prev prefetch |\n| NFR-4 | §3 privacy boundaries (scoping, serializer, resolvers) |\n| NFR-5 | §2.7 auth column; §2.4 reuse of require*/assertCan* |\n| NFR-6 | §1.1 blocker 8; §2.5/§2.8 MUI-only components |\n| NFR-7 | §2.7 thin handlers via `http.ts` helpers |\n| NFR-8 | §2.2 `src/server/assignments/`; §2.6; §2.7; §2.8 |\n| NFR-9 | §2.2 UTC lateDays, `fromZonedTime` default; §4 DST tests |\n| NFR-10 | §2.5 MarkdownView |\n| NFR-11 | §2.4 reuse map |\n| NFR-12 | §2.3 / §2.2 `logger` in catch paths |\n| NFR-13 | §1.1 blockers 2–3; ADR-2, ADR-3 |\n| NFR-14 | §4 testing layout |\n| NFR-15 | §1.1 blockers 4–5 (no CSP or tab-bar work); D12; exemption = row only |\n| NFR-16 | §2.8 form defaults; keyboard grading |\n| NFR-17 | §2.8 dnd-kit Up/Down fallback, shortcut hint, labelled inputs |\n\n## 7. Open items carried to handoff\n\n1. ADR-2 override must compile. Otherwise use the D2 fallbacks.\n2. Platform CSP nonce fix (real-browser hydration) is out of scope.\n3. The `studentTabs` renderer is missing, so the FR-41 tab is not visible.\n4. mui-mcp reachability is a hard gate for dev (NFR-6).\n5. D11 changes a security header (narrowly). Reviewer sign-off is recommended; the fallback is a PDF \"Open\" link.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2003,"cache_read_input_tokens":68628,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2003},"output_tokens":28,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2a7b6583-29f5-43b3-9f4e-72722e4e3a4f","uuid":"297f4eb0-9ed7-4a99-b050-6fd6b2ead40d","timestamp":"2026-11-09T05:29:17.513Z","request_id":"req_011CgroNZpRtAmo5qfUDWao5","wire_tool_inputs":{"toolu_01MwXWtuFqrra4hf9AyNk5Wz":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub/artifacts/architect/system-design.md","content":"# System Design: SH-9 · PRD-09 Assignments & Submissions (SCH-009)\n\nTicket: SH-9 · Phase: architect (arch-design-system) · Timestamp: 2026-11-09T10:40:00Z · Status: complete\nInputs: `artifacts/intake/requirements.json` (61 FR + 17 NFR, 95%), `handoff-to-architect.json` (8 blockers),\n`tech-stack-decisions.md` (ADR-1..ADR-8), `requirements-analysis-notes.md` (B1–B16, D1–D10). Run mode: `--brownfield --tech-stack react`.\n\n> This file replaces the stale SH-8 design that was in this folder. `api-contracts.json`, `handoff-to-dev-planning.json`\n> and `threat-model-notes.json` in this folder are also leftovers from earlier tickets. `arch-api-contracts` overwrites the first two.\n\n---\n\n## 1. Overview\n\nSchoolHub is a Next.js 14 App Router monolith (React 18, TS strict, Prisma 5 / PostgreSQL 16, Auth.js v5, MUI 9.5.0).\nSH-9 adds **assignments**: teacher authoring with an optional rubric, student submission with resubmission history,\na keyboard-driven grading screen, return flow, exemptions, offline grading, a cross-course `/assignments` page per role,\nfour notifications, and two reminder passes.\n\nShape of the change:\n\n- **One migration**, `add_assignments` (FR-1..FR-6).\n- **One feature folder**, `src/server/assignments/`, with three files: `assignments-service.ts` (all DB logic),\n  `grading-math.ts` (pure, isomorphic, unit-tested), `reminders.ts` (maintenance pass).\n- **One validator file**, `src/lib/validators/assignments.ts`, shared by forms and handlers.\n- Thin route handlers under `src/app/api/{courses,assignments,submissions,me,students}/…` (NFR-7, NFR-8).\n- Pages under `src/app/(app)/…`, plus the four PRD-08 shared components that were never built (D1).\n- **No new dependencies, services, queues, or cron** (ADR-1, ADR-8). Reminders hook into the existing dispatcher.\n\n### 1.1 Intake blockers and how they are resolved (Compliance Rule 5)\n\n| # | Intake blocker | Resolution in this design |\n|---|---|---|\n| 1 | PRD-08 UI is missing: FileUpload, FileList, MarkdownView, MarkdownEditor | Build the minimum of all four in `src/components/<Name>/<Name>.tsx` (ADR-5, §2.5). No other PRD-08 scope. |\n| 2 | MUI X break: `@mui/x-internals` 9.15.0 vs X 9.5.0 | `package.json` `overrides: { \"@mui/x-internals\": \"9.1.0\" }` (ADR-2). This fixes both DataGrid (FR-17) and DateTimePicker (FR-9). Fallback: FR-17 uses an MUI `Table`, and FR-9 uses `TextField type=\"datetime-local\"`. Dev verifies with `npm ls` plus a compile **before** building UI. |\n| 3 | vitest import break | Change the import in `vitest.config.ts` to `'vitest/config'` and delete `vitest.tmp.config.ts` (ADR-3). |\n| 4 | CSP `script-src 'self'` breaks hydration | Leave it alone. The e2e spec uses `test.use({ bypassCSP: true })` (ADR-4). The platform nonce fix is a follow-up ticket. |\n| 5 | `studentTabs` has no renderer | Register the FR-41 tab and build `students/[id]/assignments/page.tsx`. The page works by direct URL. **No tab bar is built** (NFR-15). This is a known gap and is carried to the handoff. |\n| 6 | LOW-confidence defaults FR-15, FR-52, FR-60 | Adopt intake's defaults as written (§5). Each one is a single predicate or a single copy rule, so it is cheap to change later. |\n| 7 | Reuse list | §2.4 maps each reused helper. No helper is duplicated (NFR-11). |\n| 8 | mui-mcp must be reachable (NFR-6) | This is a hard gate on the dev phase. Dev looks up every MUI component through `useMuiDocs` → `fetchDocs` before using it. If mui-mcp is unreachable, dev stops and reports a blocker. |\n\n### 1.2 New finding from this sub-task (not in intake)\n\n`next.config.js` sends **`X-Frame-Options: DENY`** on `/:path*`. That blocks the same-origin\n`<iframe src=\"/api/files/:id?inline=1\">` PDF preview required by FR-29. CSP `default-src 'self'` already allows same-origin frames,\nso the X-Frame-Options header is the only thing blocking it. `<img>` previews are not affected.\n\n**Decision D11:** in `next.config.js`, split the header rule:\n- `source: '/((?!api/files/).*)'` keeps the existing headers, with `DENY`.\n- `source: '/api/files/:id'` gets the same headers, but with `X-Frame-Options: SAMEORIGIN` and `frame-ancestors 'self'` appended to the CSP.\n\nThe file route already enforces access (`canAccessFile`) and sniffs types (`nosniff`), so letting our own pages frame it adds no exposure.\n**Fallback**, if the dev wants zero header changes: show PDFs as an \"Open\" link (`target=\"_blank\"`) instead of an iframe. Images still preview inline.\n\n---\n\n## 2. Component Breakdown\n\n### 2.1 Data model: migration `add_assignments` (FR-1..FR-6)\n\nAll additive. Existing models get back-relations only (NFR-11).\n\n```\nenum SubmissionType   { ONLINE_TEXT FILE_UPLOAD TEXT_AND_FILE NO_SUBMISSION }   // FR-1\nenum AssignmentStatus { DRAFT SCHEDULED PUBLISHED }                              // FR-1\nenum SubmissionStatus { SUBMITTED RETURNED }                                     // FR-1\n\nAssignment (FR-2)\n  id, courseId → Course (Cascade), title, instructions (Text), submissionType, maxPoints Decimal(6,2),\n  dueAt, availableFrom?, allowLate, lateCutoffAt?, latePenaltyPercentPerDay Decimal(5,2),\n  maxLatePenaltyPercent Decimal(5,2), maxFileCount Int, allowExtraCredit Boolean @default(false),\n  status AssignmentStatus, rubricId String? @unique → Rubric, notifiedAt?, archivedAt?,\n  createdById, createdAt, updatedAt\n  @@index([courseId, dueAt])\n\nAssignmentAttachment (FR-3)  assignmentId → Assignment (Cascade), fileId → FileObject; @@id([assignmentId, fileId])\nRubric (FR-3)                id, criteria RubricCriterion[]\nRubricCriterion (FR-3)       id, rubricId → Rubric (Cascade), title, description?, maxPoints Decimal(6,2), order Int,\n                             levels Json  // [{label, points, description}]\n\nSubmission (FR-4)\n  id, assignmentId → Assignment (Cascade), studentId → User, status SubmissionStatus, text?,\n  attemptNumber Int, submittedAt, isLate Boolean, lateDays Int,\n  rawScore Decimal(6,2)?, penaltyPercent Decimal(5,2)?, finalScore Decimal(6,2)?,\n  rubricScores Json?  // [{criterionId, points, comment}]\n  feedback?, gradedById?, gradedAt?, returnedAt?\n  @@unique([assignmentId, studentId])\nSubmissionFile (FR-4)        submissionId → Submission (Cascade), fileId → FileObject; @@id([submissionId, fileId])\nSubmissionHistory (FR-4)     id, submissionId → Submission (Cascade), attemptNumber, text?, fileIds String[], submittedAt\n\nGradeExemption (FR-5)        assignmentId → Assignment (Cascade), studentId, reason?, createdAt; @@id([assignmentId, studentId])\nAssignmentReminder (FR-6)    assignmentId → Assignment (Cascade), studentId, kind String ('due_soon'|'missing'), createdAt\n                             @@unique([assignmentId, studentId, kind])\n```\n\nBack-relations added: `Course.assignments`, `FileObject.assignmentAttachments`, `FileObject.submissionFiles`, `User.submissions`.\n\nModel decisions:\n- **One Submission row per student.** Earlier attempts live in `SubmissionHistory` (FR-24).\n- `SubmissionHistory.fileIds` has no FK. Old attempt files **stay attached** to the same submission id and are never detached. Detaching them would let `purgeOrphanFiles` delete history bytes (B1).\n- Offline grade (FR-8, FR-34) = a Submission with `attemptNumber 0`, `text null`, no files, and `submittedAt = gradedAt`.\n- A Rubric is 1:1 with an Assignment (`rubricId @unique`). Delete the rubric in the same transaction as a hard-deleted assignment.\n- FR-14: **no column added.** The \"review grades\" banner is client-side, shown after a successful PATCH that changed `maxPoints` while `submissionCount > 0`.\n\n### 2.2 Server: `src/server/assignments/` (NFR-8)\n\n| File | Contents | Reqs |\n|---|---|---|\n| `grading-math.ts` | **Pure and isomorphic** (no Prisma client import; `Decimal` from `decimal.js`, the same package Prisma uses). `lateDays(submittedAt, dueAt)`, `defaultPenalty(lateDays, perDay, max)`, `computeFinalScore(raw, pct)`, `rubricTotal(criteria)`, `maxRawScore(maxPoints, allowExtraCredit)`, `submissionChipStatus(row)` | FR-23, FR-30, FR-31, FR-36, FR-28, NFR-1, NFR-14 |\n| `assignments-service.ts` | All DB logic: visibility, CRUD, duplicate, submit, grade, return, exempt, offline grade, role-shaped lists, the serializer, and notify triggers. | FR-8, FR-12..15, FR-22, FR-24, FR-32, FR-34, FR-35, FR-42, FR-44, FR-48..58, FR-59 |\n| `reminders.ts` | `sendDueReminders(now)`: due_soon and missing passes. | FR-43, FR-45, FR-60 |\n\n`grading-math.ts` imports only `decimal.js`. The service wraps values as `Prisma.Decimal` (same class). This keeps one function for the client preview and the server value (ADR-7).\n\n#### Single-source helpers (inside `assignments-service.ts` unless noted)\n\n| Helper | Definition | Used by |\n|---|---|---|\n| `isAssignmentVisible(a, now)` | `!a.archivedAt && isVisible({ status: a.status, publishAt: a.availableFrom }, now)`. Reuses `src/server/content/visibility.ts`: widen `Publishable.status` to `ContentStatus \\| AssignmentStatus` (same string values). | FR-13, FR-22, FR-47, FR-48, FR-50, FR-52, FR-57, FR-58, reminders |\n| `visibleWhere(now)` | The Prisma `where` equivalent: `{ archivedAt: null, OR: [{status:'PUBLISHED'}, {status:'SCHEDULED', availableFrom:{lte:now}}] }` | list queries, reminders |\n| `missingWhere(now)` | visible ∧ `dueAt < now` ∧ `submissionType ≠ NO_SUBMISSION`; per student: no Submission and no GradeExemption | FR-37, FR-35, FR-45, FR-60 |\n| `toStudentSubmission(sub)` | Removes `rawScore, penaltyPercent, finalScore, feedback, rubricScores, gradedById, gradedAt` unless `status === 'RETURNED'`. Always removes history. | FR-27, FR-50, FR-55, FR-57, FR-58, NFR-4 |\n| `serializeDecimals` | Prisma.Decimal → `string` (\"14.40\") on the way out | NFR-1 (D5) |\n| `canSeeDrafts(user, course)` | **Reused** from `visibility.ts`: ADMIN, teacher or co-teacher = \"manager\" | everywhere |\n| `nextTeachingDayDueAt(now, tz, teachingDays)` | **In `src/lib/dates.ts`**, next to `schoolNow`. Walk from tomorrow (≤7 days) to the first `isTeaching` weekday, take 23:59 local, convert with `fromZonedTime`. If no day is teaching, use tomorrow. | FR-10, NFR-9 |\n| `resolveViewedStudent(user, studentId?)` | STUDENT → self. PARENT → `studentId` must be in `ParentStudentLink`; it defaults to the only linked child. Otherwise FORBIDDEN. | FR-18, FR-38, FR-57 |\n\n#### Key service flows\n\n**Create / update (FR-49, FR-51, FR-11, FR-12, FR-42).** One transaction: Zod parse → if a rubric is given, `rubricTotal == maxPoints`, otherwise\nVALIDATION_ERROR `Rubric totals {sum} points but the assignment is worth {maxPoints}.` → SCHEDULED requires `availableFrom > new Date()` (checked in the service,\nbecause Zod has no server clock, NFR-2) → upsert rubric and criteria → write the assignment → `attachFiles(tx, user, fileIds, 'assignment', id)`. On PATCH,\ndiff the attachments: removed files are `detachFiles` (the purge reclaims them). **After commit**, if the assignment is now visible → `publishOnce(id)`.\n\n**`publishOnce(id)` (FR-42).** `updateMany({ where:{ id, notifiedAt:null }, data:{ notifiedAt: now } })`. Only when `count === 1`, call `notify()` for\n`assignment.published` to ACTIVE-enrolled students. Called from: create/PATCH after commit, and from the student/parent list read paths (FR-48, FR-57)\nfor SCHEDULED assignments that have become visible with `notifiedAt` null. On GET it is fire-and-forget (`void publishOnce(id).catch(logger.error)`) and never fails the read.\n\n**Delete (FR-51).** If there are 0 submissions → detach the attachments, then delete the assignment and its rubric (cascade). Otherwise → set `archivedAt = now`. Audit `assignment.delete|archive`.\n\n**Duplicate (FR-15).** `assertCanManageCourse` for **each** target course, then one transaction per target. Copy the rubric and criteria as new rows.\nAttachments: `readFile` → `saveFile` → a new FileObject (context `'assignment'`), because FileObject holds one context (B2). Status is DRAFT and `notifiedAt` is null.\nSame `dueAt`; `availableFrom` and `lateCutoffAt` keep their offsets from dueAt (FR-15 default).\n\n**Submit (FR-22..FR-24, FR-53, FR-60).** `now = new Date()` on the server. Checks, in order (first failure wins):\n1. Assignment exists and `isAssignmentVisible` → otherwise NOT_FOUND.\n2. `role === 'STUDENT'` and ACTIVE-enrolled in the course → otherwise FORBIDDEN.\n3. Not exempt; `submissionType ≠ NO_SUBMISSION` → otherwise VALIDATION_ERROR.\n4. Deadline: `now ≤ dueAt`, or `allowLate && (!lateCutoffAt || now ≤ lateCutoffAt)` → otherwise VALIDATION_ERROR `The deadline has passed and late submissions are closed.`\n5. Content matches the type: text for ONLINE_TEXT, ≥1 file for FILE_UPLOAD, ≥1 of either for TEXT_AND_FILE. Also `fileIds.length ≤ maxFileCount`.\n6. Each file has `ownerId = me`, `context = 'submission'`, and is unattached **or** already attached to this submission. The service checks `context` before calling `attachFiles`, because `attachFiles` does not (B1).\n\nThen, in one transaction:\n- **No row:** create the Submission (`attemptNumber 1`, `isLate`, `lateDays` from `grading-math`).\n- **Row with `status = SUBMITTED`**, including an attempt-0 offline row (D9): insert `SubmissionHistory` from the current row, `attemptNumber++`, clear all grade fields, and replace the `SubmissionFile` rows. Old files stay attached.\n- **Row with `RETURNED`:** CONFLICT `This submission has been returned and can no longer be changed.`\n\n`attachFiles(tx, user, newFileIds, 'submission', submission.id)`. A P2002 from two concurrent first submits → retry once as a resubmit.\n\n**Grade (FR-56, FR-30, FR-31, FR-36, FR-32 \"Save & return\").** `PUT /api/submissions/:id/grade { rawScore?, penaltyPercent, feedback?, rubricScores?, return?: boolean }`.\n- If the assignment has a rubric: `rubricScores` are required, every criterion must be scored exactly once, `0 ≤ points ≤ criterion.maxPoints`, and **the server sets `rawScore = Σ points`** (any client raw value is ignored, D7).\n- Otherwise: `0 ≤ rawScore ≤ maxRawScore` (×1.2 when `allowExtraCredit`). Extra credit applies to rawScore only.\n- `0 ≤ penaltyPercent ≤ 100`. `finalScore = computeFinalScore`. Set `gradedById`, `gradedAt`. The status stays SUBMITTED.\n- `return: true` → in the same transaction, set `status RETURNED`, `returnedAt`, then notify after commit (D6: a single round trip). Audit `submission.grade` (+ `submission.return`).\n\n**Bulk return (FR-32).** `POST /api/assignments/:id/return { submissionIds? }`. The default set is `gradedAt != null AND status = SUBMITTED`. A supplied id that is ungraded is\nskipped and reported in the response (`{returned, skipped}`). One `updateMany`, then one `notifyStudentAndParents` per student (FR-44), plus **one audit row per submission** (FR-59), so\na per-record audit trail is possible.\n\n**Offline grade (FR-34, FR-8).** The student must be ACTIVE-enrolled. If a submission already exists → CONFLICT (grade that one instead). Create the attempt-0 row\nwith the grade fields and penalty 0, using the same validation as Grade. Audit `submission.grade_offline`.\n\n**Exempt (FR-35).** PUT = `upsert` GradeExemption, DELETE = `deleteMany` (both idempotent). Audit `assignment.exempt|unexempt`. The effects come only through\n`missingWhere`, the submit rule 3, and reminders. The PRD-11 \"exclude\" flag **is** the row itself (NFR-15).\n\n### 2.3 Maintenance: `reminders.ts` (FR-43, FR-45, FR-60)\n\n`sendDueReminders(now)` is called on **every** request to `src/app/api/internal/email/dispatch/route.ts`, outside the daily `lastPurgeAt` block, in its own try/catch with logger (B8).\n\n| Pass | Assignment window | Targets | Notify |\n|---|---|---|---|\n| due_soon | `visibleWhere` ∧ `dueAt ∈ (now, now+24h]` ∧ `type ≠ NO_SUBMISSION` | ACTIVE-enrolled, no Submission, no GradeExemption | `assignment.due_soon` → student |\n| missing | `visibleWhere` ∧ `dueAt ∈ [now−8d, now−24h]` ∧ `type ≠ NO_SUBMISSION` | same | `assignment.missing` → linked parents only, via `notify()` |\n\nIdempotency: `createMany({ data: candidates, skipDuplicates: true })` cannot report *which* rows were inserted, so **insert per (assignment, student) with `create` and catch P2002**,\nand notify only on success. The Postgres unique key makes this safe across concurrent dispatchers. Candidate counts are small (one course × roster).\n`// ponytail: missing pass only looks back 8 days; widen or add a cursor if the dispatcher can be down longer.`\n\n### 2.4 Reuse map (NFR-11)\n\n| Existing | Where | Used for |\n|---|---|---|\n| `requireUser`/`requireRole`, `requirePageUser`/`requirePageRole` | `src/server/auth/requireRole.ts` | every handler and page (NFR-5) |\n| `assertCanViewCourse`, `assertCanManageCourse` | `src/server/auth/course-access.ts` | course-scoped routes |\n| `assertCanViewStudent` | `src/server/auth/student-access.ts` | FR-58 |\n| `isVisible`, `canSeeDrafts` | `src/server/content/visibility.ts` (type widened) | FR-13, manager checks |\n| `withHandler`, `ok`, `paginated`, `parseBody`, `parseQuery`, `parsePagination`, `AppError` | `src/server/http.ts` | NFR-7 envelopes and errors |\n| `audit()` | `src/server/audit.ts` | FR-59 |\n| `notify()`, `notifyStudentAndParents()`, `NOTIFICATION_TYPES` | `src/server/notifications/` | FR-42..FR-46 |\n| `attachFiles`, `detachFiles`, `POST /api/files`, `GET /api/files/:id?inline=1`, `registerBuiltInContexts`, `storage.ts` | `src/server/files/`, `src/server/storage.ts` | FR-9, FR-15, FR-20, FR-29, FR-47, FR-53 |\n| `formatInSchoolTz`, `schoolNow` | `src/lib/dates.ts` | FR-19, FR-25, NFR-9 |\n| `ConfirmDialog`, `DataTable`, `EmptyState`, `PageHeader`, `useToast`, `FormField`, `DateDisplay` | `src/components/` | FR-17, FR-21, lists, forms |\n| `courseTabs`, `studentTabs`, `navigation` | `src/config/` | FR-16, FR-40, FR-41 |\n| `logger` | `src/lib/logger.ts` | NFR-12 |\n\n### 2.5 New shared UI components (blocker 1, ADR-5)\n\n| Component | Build | Reqs |\n|---|---|---|\n| `MarkdownView` | react-markdown + remark-gfm + rehype-sanitize (default schema). Elements map to MUI `Typography`, `Link`, `Table*`, `List*`, `Box component=\"pre\"`. | NFR-10, FR-19, FR-29, FR-26 |\n| `MarkdownEditor` | MUI `TextField multiline` + `Tabs` (Write / Preview → `MarkdownView`). Controlled `value`/`onChange`, plus `maxLength`. | FR-9, FR-20, FR-30 |\n| `FileUpload` | MUI `Button` + hidden `<input type=\"file\" multiple>`. POSTs each file to `/api/files` with `context`. Props `{context, max, value: FileRef[], onChange}`. A `LinearProgress` per file, plus remove. | FR-9, FR-20 |\n| `FileList` | MUI `List` of links to `/api/files/:id`. Optional `preview` prop: `<img>` for `image/*`, `<iframe>` for `application/pdf`, both via `?inline=1` (D11). | FR-19, FR-25, FR-29 |\n\n### 2.6 Validators: `src/lib/validators/assignments.ts` (FR-7)\n\n`assignmentInput` (FR-7 limits; `.superRefine`: `lateCutoffAt > dueAt`, rubric sum = maxPoints using `rubricTotal`), `rubricCriterionInput`,\n`submissionInput {text? ≤50k, fileIds ≤10}`, `gradeInput {rawScore?, penaltyPercent 0–100, feedback? ≤10k, rubricScores?, return?}`,\n`offlineGradeInput`, `bulkReturnInput`, `duplicateInput {courseIds min 1}`, `meAssignmentsQuery {studentId?, tab?, courseId?}`.\nDecimals are accepted as `z.union([z.number(), z.string()])` and converted to Decimal in the service. No request schema has a timestamp field except\n`dueAt`/`availableFrom`/`lateCutoffAt`, which are authoring data, not \"now\" (NFR-2).\n\n### 2.7 Route handlers (thin: Zod → service → envelope; NFR-7)\n\n| Route | Auth | Service fn | Reqs |\n|---|---|---|---|\n| `GET /api/courses/[id]/assignments` | user + view course | `listCourseAssignments` (manager shape with `groupBy` counts / student shape) | FR-48, FR-17, FR-18 |\n| `POST /api/courses/[id]/assignments` | manage course | `createAssignment` | FR-49 |\n| `GET /api/assignments/[id]` | view (NOT_FOUND for invisible to non-manager) | `getAssignment` (+ own submission, `serverNow`) | FR-50, FR-19 |\n| `PATCH` / `DELETE /api/assignments/[id]` | manage | `updateAssignment` / `deleteOrArchiveAssignment` | FR-51, FR-14 |\n| `POST /api/assignments/[id]/duplicate` | manage source + each target | `duplicateAssignment` | FR-15 |\n| `GET /api/assignments/[id]/submissions` | manage | `listGradingRoster` (every ACTIVE enrollee; `pageSize` ≤100) | FR-54, FR-28 |\n| `POST /api/assignments/[id]/submissions` | STUDENT | `submit` | FR-53, FR-22..24 |\n| `POST /api/assignments/[id]/return` | manage | `bulkReturn` | FR-32, FR-44 |\n| `POST /api/assignments/[id]/grade-offline` | manage | `gradeOffline` | FR-34, FR-8 |\n| `PUT` / `DELETE /api/assignments/[id]/exemptions/[studentId]` | manage | `setExemption` | FR-35 |\n| `GET /api/submissions/[id]` | submitter, linked parent, or manager; history for managers only | `getSubmission` | FR-55, FR-29, NFR-3 |\n| `PUT /api/submissions/[id]/grade` | manage | `gradeSubmission` | FR-56, FR-30..32, FR-36 |\n| `GET /api/me/assignments` | any user; role switch | `listMyAssignments` | FR-57, FR-37..39 |\n| `GET /api/students/[id]/assignments` | `assertCanViewStudent` | `listStudentAssignments` | FR-58, FR-41 |\n\nShared response conventions for `arch-api-contracts`: Decimals are **strings**. Timestamps are ISO UTC strings. Student/parent submission objects\nalways pass through `toStudentSubmission`. FR-58: a viewer who manages the course gets the full fields, everyone else gets the serializer (D8).\n`/api/me/assignments` for ADMIN = \"To grade\" across all courses (intake default).\n\n### 2.8 Pages (`src/app/(app)/…`)\n\n| Page | Notes | Reqs |\n|---|---|---|\n| `courses/[courseId]/assignments/page.tsx` | Manager: `DataTable` (title, due, status, submitted/total, graded/submitted, Grade button; Archived chip). Student/parent: grouped `List` (Upcoming / Past due / Submitted / Returned). Parent child selector when more than one linked child is enrolled. | FR-16..18, FR-52 |\n| `courses/[courseId]/assignments/new/page.tsx` + `[assignmentId]/edit/page.tsx` | One shared `AssignmentForm` (react-hook-form + the Zod schema). Defaults: dueAt = `nextTeachingDayDueAt` (computed server-side, passed as a prop), maxPoints 100, FILE_UPLOAD, maxFileCount 3, allowLate off (NFR-16). Rubric builder: `@dnd-kit/sortable` with Up/Down buttons as the keyboard fallback, and a live sum error. Buttons: Save draft / Publish / Schedule. Edit warns per FR-14. \"Duplicate to other courses\" dialog with an `Autocomplete` of managed courses. | FR-9..15 |\n| `courses/[courseId]/assignments/[assignmentId]/page.tsx` | MarkdownView instructions, FileList, due and late-policy summary, rubric table, countdown under 48 h (offset from `serverNow`, display only). Submission panel by type, `localStorage` draft key `assignment:{id}:{userId}` (cleared on success), ConfirmDialog before POST, receipt via `formatInSchoolTz`, returned results, or \"Submitted — awaiting grading\". Parent: read-only, no panel. | FR-19..27 |\n| `courses/[courseId]/assignments/[assignmentId]/grade/page.tsx` | Left: `List` + status `Chip`s from `submissionChipStatus`, filter, sort by name or time. Main: MarkdownView text, FileList with preview, history `Select`. Form: rubric `ToggleButtonGroup`s that auto-sum, prefilled penalty (`defaultPenalty`), live final score (`computeFinalScore`), MarkdownEditor feedback. Buttons Save / Save & return / Return all graded / Grade without submission / Exempt toggle. J/K/Ctrl+Enter keydown handler that skips J/K in input/textarea/contenteditable, with a visible shortcut hint. **NFR-3:** a plain `Map<id, Submission>` cache; after each selection, prefetch the next and previous `GET /api/submissions/:id`. | FR-28..36, NFR-3, NFR-16, NFR-17 |\n| `assignments/page.tsx` | STUDENT: `Tabs` Upcoming/Missing/Submitted/Returned + course filter. PARENT: child selector, same view, read-only. TEACHER/ADMIN: \"To grade\" list, oldest first. | FR-37..39 |\n| `students/[id]/assignments/page.tsx` | Per-student list (FR-58). Reachable by URL only (blocker 5). | FR-41 |\n\n### 2.9 Config and registrations\n\n- `src/config/course-tabs.ts`: `{ key:'assignments', label:'Assignments', href: id => /courses/${id}/assignments, roles: ALL_ROLES }` (FR-16).\n- `src/config/navigation.ts`: `Assignments` → `/assignments`, roles `[STUDENT, PARENT, TEACHER, ADMIN]` (FR-40; ADMIN added because the To-grade default applies to ADMIN).\n- `src/config/student-tabs.ts`: `assignments` entry (FR-41).\n- `src/server/notifications/types.ts`: four keys, category ACADEMIC (FR-46):\n  `assignment.published` [STUDENT] email false · `assignment.due_soon` [STUDENT] email false · `assignment.returned` [STUDENT, PARENT] email false · `assignment.missing` [PARENT] email **true**.\n- `src/server/files/contexts.ts` (FR-47), registered in `registerBuiltInContexts`:\n  - `assignmentResolver`: load the assignment and course → `assertCanViewCourse` → `canSeeDrafts || isAssignmentVisible`.\n  - `submissionResolver`: load the submission and course → allow `studentId === user.id`, a linked parent (`ParentStudentLink`), or `canSeeDrafts`. Deny everyone else, including other students (NFR-4, AC-10).\n- `next.config.js`: D11 header split.\n- `package.json`: `overrides[\"@mui/x-internals\"] = \"9.1.0\"` (ADR-2). `vitest.config.ts` import fix (ADR-3).\n- `prisma/seed.ts`: FR-61 block, idempotent: look up courses by code (skip if missing), upsert by `(courseId, title)`, Decimals as strings, no file bytes.\n\n---\n\n## 3. Data Flow\n\n**Author → publish.** Teacher form → `POST /api/courses/:id/assignments` → validate (Zod + rubric sum + schedule time) → tx (rubric, assignment, attachments) → commit → `publishOnce` → `notify(assignment.published)` to enrolled students.\n\n**Scheduled becomes visible.** No job. A student/parent list read evaluates `visibleWhere(now)`. Any newly visible assignment with `notifiedAt` null → fire-and-forget `publishOnce` (the atomic guard sends exactly once).\n\n**Submit.** Student uploads files → `POST /api/files {context:'submission'}` (unattached, owner-only readable) → `POST /api/assignments/:id/submissions {text, fileIds}` → the six checks in order → tx (history snapshot if resubmitting, upsert submission, file rows, `attachFiles` → contextId = submission.id) → receipt.\nFrom then on, the files are readable through `submissionResolver` only by the student, their parents, and course managers.\n\n**Grade → return.** Grader page loads the roster (FR-54) → selects a student → `GET /api/submissions/:id` (cached; next and previous prefetched) → form computes the preview with `grading-math` → `PUT …/grade {…, return?}` → server recomputes everything authoritatively → tx → audit → (if return) `notifyStudentAndParents(assignment.returned, \"Course: Title — 18/20\")`.\nStudent `GET` now gets the grade fields, because the serializer unlocks on RETURNED.\n\n**Reminders.** The external caller hits `/api/internal/email/dispatch` → `dispatchEmails` → `sendDueReminders(now)` → due_soon and missing candidate queries → per-row `AssignmentReminder.create` (P2002 = already sent) → `notify`.\n\n**Privacy boundaries (NFR-4), three layers:** (1) query scoping: student and parent paths always filter `studentId ∈ resolveViewedStudent`; (2) `toStudentSubmission` serializer; (3) the file resolvers for `/api/files/:id`.\n\n---\n\n## 4. Testing layout (NFR-13, NFR-14)\n\n- `tests/unit/assignments/grading-math.test.ts`: lateDays (exactly 24 h = 1, 24 h + 1 ms = 2, across spring-forward and fall-back in `Europe/London`), penalty cap, final score (18 @ 20 % = \"14.40\", half-up at .005), rubric sum, chip status. Also `nextTeachingDayDueAt` across DST.\n- `tests/integration/assignments/*.test.ts`: resubmission history (files kept attached), RETURNED refuses resubmit, return flow plus serializer unlock, reminder idempotency (call twice → one notification), exemption removes from missing and blocks submit, NO_SUBMISSION excluded, file resolver denies another student (AC-10).\n- `tests/e2e/assignments.spec.ts` (`bypassCSP: true`): teacher creates → student submits a file → teacher grades with a rubric and returns → student sees feedback; parent sees the missing list.\n\n---\n\n## 5. Decisions log\n\n| # | Decision | Reqs |\n|---|---|---|\n| D1 | Build the minimal MarkdownView, MarkdownEditor, FileUpload and FileList in `src/components/` | FR-9, FR-19, FR-20, FR-29, FR-30 |\n| D2 | Pin `@mui/x-internals` 9.1.0 via overrides; fallbacks are MUI `Table` and `datetime-local` | FR-17, FR-9 |\n| D3 | Fix the vitest import; e2e uses bypassCSP | NFR-13, NFR-14 |\n| D4 | Register the student tab and page; no tab bar | FR-41 |\n| D5 | Decimals are strings in JSON | NFR-1 |\n| D6 | \"Save & return\" = `PUT …/grade {return:true}`, one transaction | FR-32 |\n| D7 | With a rubric, the server sets `rawScore = Σ rubric points` | FR-30, FR-36 |\n| D8 | FR-58: managers get the full fields, other viewers get the serializer | FR-58, FR-27 |\n| D9 | An online submit over an unreturned offline grade = a resubmission | FR-8, FR-24 |\n| D10 | The missing pass looks back 8 days (`ponytail:` note) | FR-45 |\n| D11 | `X-Frame-Options: SAMEORIGIN` only for `/api/files/:id`, so PDF iframes work | FR-29 |\n| D12 | Intake defaults adopted: FR-15 same dueAt plus offsets; FR-52 archived = hidden from students/parents, closed, no reminders, visible to managers; FR-60 NO_SUBMISSION never missing or reminded; FR-10 weekdays only; FR-36 extra credit raw-only; ADMIN /assignments = To grade | FR-10, FR-15, FR-36, FR-39, FR-52, FR-60 |\n| D13 | Resubmission after RETURNED → CONFLICT (409). Deadline and content failures → VALIDATION_ERROR | FR-22, FR-24 |\n| D14 | One audit row per affected submission, including bulk return | FR-59 |\n| D15 | FR-14 banner is client-side; no schema column | FR-14 |\n\n---\n\n## 6. Requirements Traceability\n\n| Req | Design element |\n|---|---|\n| FR-1 | §2.1 enums in migration `add_assignments` |\n| FR-2 | §2.1 `Assignment` (+allowExtraCredit, notifiedAt, archivedAt, rubricId @unique, index) |\n| FR-3 | §2.1 `AssignmentAttachment`, `Rubric`, `RubricCriterion` |\n| FR-4 | §2.1 `Submission`, `SubmissionFile`, `SubmissionHistory` |\n| FR-5 | §2.1 `GradeExemption` |\n| FR-6 | §2.1 `AssignmentReminder`; §2.3 idempotency |\n| FR-7 | §2.6 `src/lib/validators/assignments.ts` |\n| FR-8 | §2.1 attempt-0 row; §2.2 Offline grade; D9 |\n| FR-9 | §2.8 `AssignmentForm`; §2.5 MarkdownEditor, FileUpload; D2 |\n| FR-10 | §2.2 `nextTeachingDayDueAt` in `src/lib/dates.ts` |\n| FR-11 | §2.8 rubric builder; §2.2 Create (server rubric-sum check); §2.6 superRefine |\n| FR-12 | §2.8 three buttons; §2.2 Create (SCHEDULED future check) |\n| FR-13 | §2.2 `isAssignmentVisible` / `visibleWhere` (read-time, no job) |\n| FR-14 | §2.8 edit warning; D15 |\n| FR-15 | §2.2 Duplicate; §2.7 duplicate route |\n| FR-16 | §2.9 courseTabs entry |\n| FR-17 | §2.8 manager DataTable; §2.7 FR-48 manager shape; D2 |\n| FR-18 | §2.8 student/parent grouped list; `resolveViewedStudent` |\n| FR-19 | §2.8 assignment page; §2.5 MarkdownView, FileList |\n| FR-20 | §2.8 submission panel (localStorage draft); §2.5 FileUpload |\n| FR-21 | §2.8 ConfirmDialog before POST |\n| FR-22 | §2.2 Submit checks 1–4 |\n| FR-23 | §2.2 `grading-math.lateDays` |\n| FR-24 | §2.2 Submit transaction (history, clear grade, files kept) |\n| FR-25 | §2.8 receipt via `formatInSchoolTz` |\n| FR-26 | §2.8 returned results view |\n| FR-27 | §2.2 `toStudentSubmission` serializer |\n| FR-28 | §2.8 grading left panel; `submissionChipStatus` |\n| FR-29 | §2.8 grading main panel; §2.5 FileList preview; D11 |\n| FR-30 | §2.8 grading form; `defaultPenalty`, `computeFinalScore`; D7 |\n| FR-31 | §2.2 `grading-math.computeFinalScore` (Decimal, ROUND_HALF_UP) |\n| FR-32 | §2.2 Grade (`return:true`) and Bulk return; D6 |\n| FR-33 | §2.8 keydown handler |\n| FR-34 | §2.2 Offline grade; §2.7 grade-offline route |\n| FR-35 | §2.2 Exempt; `missingWhere`; Submit check 3 |\n| FR-36 | §2.2 Grade validation; `maxRawScore` |\n| FR-37 | §2.8 `/assignments` STUDENT; `missingWhere` |\n| FR-38 | §2.8 `/assignments` PARENT; `resolveViewedStudent` |\n| FR-39 | §2.8 `/assignments` TEACHER/ADMIN To grade |\n| FR-40 | §2.9 navigation entry |\n| FR-41 | §2.9 studentTabs entry; §2.8 students page; blocker 5 |\n| FR-42 | §2.2 `publishOnce` (atomic notifiedAt) |\n| FR-43 | §2.3 due_soon pass |\n| FR-44 | §2.2 Grade/Bulk return → `notifyStudentAndParents` |\n| FR-45 | §2.3 missing pass (parents only) |\n| FR-46 | §2.9 NOTIFICATION_TYPES keys |\n| FR-47 | §2.9 `assignmentResolver`, `submissionResolver` |\n| FR-48 | §2.7 `GET /api/courses/[id]/assignments` |\n| FR-49 | §2.7 `POST /api/courses/[id]/assignments`; §2.2 Create |\n| FR-50 | §2.7 `GET /api/assignments/[id]` |\n| FR-51 | §2.7 PATCH/DELETE; §2.2 Delete |\n| FR-52 | §2.2 `isAssignmentVisible` (`!archivedAt`); D12 |\n| FR-53 | §2.7 POST submissions; §2.2 Submit checks 5–6 |\n| FR-54 | §2.7 `GET /api/assignments/[id]/submissions` |\n| FR-55 | §2.7 `GET /api/submissions/[id]` |\n| FR-56 | §2.7 `PUT /api/submissions/[id]/grade`; §2.2 Grade |\n| FR-57 | §2.7 `GET /api/me/assignments` |\n| FR-58 | §2.7 `GET /api/students/[id]/assignments`; D8 |\n| FR-59 | §2.2 audit calls; D14 |\n| FR-60 | §2.2 `missingWhere`, Submit check 3; §2.3 filters; D12 |\n| FR-61 | §2.9 seed block |\n| NFR-1 | §2.2 `grading-math` (Decimal); D5 strings in JSON |\n| NFR-2 | §2.2 server `now` everywhere; §2.6 no client clock fields |\n| NFR-3 | §2.8 grading `Map` cache plus next/prev prefetch |\n| NFR-4 | §3 privacy boundaries (scoping, serializer, resolvers) |\n| NFR-5 | §2.7 auth column; §2.4 reuse of require*/assertCan* |\n| NFR-6 | §1.1 blocker 8; §2.5/§2.8 MUI-only components |\n| NFR-7 | §2.7 thin handlers via `http.ts` helpers |\n| NFR-8 | §2.2 `src/server/assignments/`; §2.6; §2.7; §2.8 |\n| NFR-9 | §2.2 UTC lateDays, `fromZonedTime` default; §4 DST tests |\n| NFR-10 | §2.5 MarkdownView |\n| NFR-11 | §2.4 reuse map |\n| NFR-12 | §2.3 / §2.2 `logger` in catch paths |\n| NFR-13 | §1.1 blockers 2–3; ADR-2, ADR-3 |\n| NFR-14 | §4 testing layout |\n| NFR-15 | §1.1 blockers 4–5 (no CSP or tab-bar work); D12; exemption = row only |\n| NFR-16 | §2.8 form defaults; keyboard grading |\n| NFR-17 | §2.8 dnd-kit Up/Down fallback, shortcut hint, labelled inputs |\n\n## 7. Open items carried to handoff\n\n1. ADR-2 override must compile. Otherwise use the D2 fallbacks.\n2. Platform CSP nonce fix (real-browser hydration) is out of scope.\n3. The `studentTabs` renderer is missing, so the FR-41 tab is not visible.\n4. mui-mcp reachability is a hard gate for dev (NFR-6).\n5. D11 changes a security header (narrowly). Reviewer sign-off is recommended; the fallback is a PDF \"Open\" link.\n"}}}
