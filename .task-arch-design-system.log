es; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique