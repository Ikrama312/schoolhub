null;\n}\n\n/** Start screen \"Your attempts\" list: the caller's own submitted attempts (no grading data). */\nexport async function listOwnAttempts(user: AccessUser, quizId: string) {\n710:  exemptions               GradeExemption[]\n711-  reminders                AssignmentReminder[]\n712-\n713-  @@index([courseId, dueAt])\n714-}\n715-\n716-/// file has no onDelete -> Restrict: an attached file can't be hard-deleted.\n717-model AssignmentAttachment {\n718-  assignmentId String\n--\n802:model GradeExemption {\n803-  assignmentId String\n804-  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n805-  studentId    String\n806-  reason       String?\n807-  createdAt    DateTime   @default(now())\n808-\n809-  @@id([assignmentId, studentId])\n810-}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01A2teKigtQWA5BU5bWTS3Ri","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
