{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UPEm8cvgMYjSkiBCTbpLL3","type":"tool_result","content":"src/app/(app)/dashboard/page.tsx\nsrc/app/(app)/layout.tsx\nsrc/app/(app)/shell.tsx\nsrc/app/(public)/layout.tsx\nsrc/app/(public)/page.tsx\nsrc/app/api/academic-years/[id]/route.ts\nsrc/app/api/academic-years/[id]/set-current/route.ts\nsrc/app/api/academic-years/[id]/terms/route.ts\nsrc/app/api/academic-years/route.ts\nsrc/app/api/health/route.ts\nsrc/app/error.tsx\nsrc/app/forbidden/page.tsx\nsrc/app/global-error.tsx\nsrc/app/layout.tsx\nsrc/app/not-found.tsx\nsrc/components/ConfirmDialog/ConfirmDialog.tsx\nsrc/components/DataTable/DataTable.tsx\nsrc/components/DateDisplay/DateDisplay.tsx\nsrc/components/EmptyState/EmptyState.tsx\nsrc/components/FormField/FormField.tsx\nsrc/components/LoadingSkeleton/LoadingSkeleton.tsx\nsrc/components/PageHeader/PageHeader.tsx\nsrc/components/StatCard/StatCard.tsx\nsrc/components/Toast/ToastProvider.tsx\nsrc/components/Toast/useToast.ts\nsrc/components/UserAvatar/UserAvatar.tsx\nsrc/config/navigation.ts\nsrc/config/student-tabs.ts\nsrc/lib/dates.ts\nsrc/lib/env.ts\nsrc/lib/logger.ts\nsrc/server/audit.ts\nsrc/server/auth/requireRole.ts\nsrc/server/db.ts\nsrc/server/http.ts\nsrc/server/services/academicYears.ts\nsrc/server/services/dateRange.ts\nsrc/server/services/gradeLevels.ts\nsrc/server/services/rooms.ts\nsrc/server/services/settings.ts\nsrc/server/services/subjects.ts\nsrc/server/services/terms.ts\nsrc/theme/theme.ts\n---prisma---\ngenerator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nenum Role {\n  ADMIN\n  TEACHER\n  STUDENT\n  PARENT\n}\n\nenum UserStatus {\n  ACTIVE\n  INVITED\n  DISABLED\n  ARCHIVED\n}\n\nenum AuthTokenType {\n  INVITE\n  PASSWORD_RESET\n}\n\n/// Every authenticated person. passwordHash is nullable because an INVITED\n/// user has no password until they accept their invite (TASK-8's\n/// acceptInvite step sets both passwordHash and status=ACTIVE together).\nmodel User {\n  id                String      @id @default(cuid())\n  email             String      @unique\n  passwordHash      String?\n  firstName         String\n  lastName          String\n  role              Role\n  status            UserStatus  @default(INVITED)\n  failedLoginCount  Int         @default(0)\n  lockedUntil       DateTime?\n  lastLoginAt       DateTime?\n  passwordChangedAt DateTime?\n  createdAt         DateTime    @default(now())\n  updatedAt         DateTime    @updatedAt\n  authTokens        AuthToken[]\n  auditLogs         AuditLog[]\n}\n\n/// Invite + password-reset tokens. Only the SHA-256 hash is ever stored\n/// (NFR-1) — the raw token exists only in the link emailed/logged to the\n/// user. One shared shape for both token types; src/server/auth/tokens.ts\n/// is the single producer/consumer.\nmodel AuthToken {\n  id        String        @id @default(cuid())\n  userId    String\n  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      AuthTokenType\n  tokenHash String        @unique\n  expiresAt DateTime\n  usedAt    DateTime?\n  createdAt DateTime      @default(now())\n\n  @@index([userId, type])\n}\n\n/// Insert-only audit trail written exclusively through src/server/audit.ts's\n/// audit() helper. actorId is nullable so a failed sign-in attempt against a\n/// non-existent email can still be recorded.\nmodel AuditLog {\n  id         String   @id @default(cuid())\n  actorId    String?\n  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ip         String?\n  createdAt  DateTime @default(now())\n\n  @@index([actorId])\n  @@index([action])\n}\n\n/// Singleton row (fixed id \"singleton\") holding school-wide branding/contact\n/// info. Later PRDs read this for top-bar branding and public footer; no\n/// other PRD should add a second row or a second settings model.\nmodel SchoolSettings {\n  id           String   @id @default(\"singleton\")\n  name         String   @default(\"SchoolHub Academy\")\n  shortName    String   @default(\"SchoolHub\")\n  logoUrl      String?\n  timezone     String   @default(\"UTC\")\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  country      String?\n  phone        String?\n  email        String?\n  website      String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n}\n\n/// One school year, e.g. \"2026-2027\". Exactly one row has isCurrent = true\n/// at a time -- enforced in src/server/services/academicYears.ts's\n/// setCurrentAcademicYear(), never by a DB constraint (Postgres can't\n/// express \"exactly one true\" as a simple unique index).\nmodel AcademicYear {\n  id        String   @id @default(cuid())\n  name      String   @unique\n  startDate DateTime @db.Date\n  endDate   DateTime @db.Date\n  isCurrent Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  terms     Term[]\n}\n\n/// A term (semester/trimester/quarter) inside one academic year. onDelete:\n/// Restrict means the year can't be deleted while it still has terms --\n/// the service layer checks this first to return a friendly 409 instead of\n/// a raw FK error.\nmodel Term {\n  id             String       @id @default(cuid())\n  academicYearId String\n  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n  name           String\n  startDate      DateTime     @db.Date\n  endDate        DateTime     @db.Date\n  order          Int\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  @@unique([academicYearId, name])\n  @@unique([academicYearId, order])\n}\n\n/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n/// reference grade levels, so they're archived instead of deleted.\nmodel GradeLevel {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  shortName  String    @unique\n  order      Int       @unique\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}\n\n/// \"Mathematics\" / \"MATH\". code is always stored upper-case (normalised in\n/// the service layer, not the DB) so the unique constraint catches\n/// case-insensitive duplicates like \"math\" vs \"MATH\".\nmodel Subject {\n  id          String    @id @default(cuid())\n  name        String\n  code        String    @unique\n  description String?\n  color       String    @default(\"#4F46E5\")\n  archivedAt  DateTime?\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n}\n\n/// A physical room classes are scheduled in.\nmodel Room {\n  id         String    @id @default(cuid())\n  name       String    @unique\n  building   String?\n  capacity   Int?\n  archivedAt DateTime?\n  createdAt  DateTime  @default(now())\n  updatedAt  DateTime  @updatedAt\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"2a933411-2428-4c0f-ab5f-3414109df7d8","uuid":"02067dc6-0c34-4a93-a3db-a053707a8783","timestamp":"2026-10-19T09:10:32.772Z","tool_use_result":{"stdout":"src/app/(app)/dashboard/page.tsx\nsrc/app/(app)/layout.tsx\nsrc/app/(app)/shell.tsx\nsrc/app/(public)/layout.tsx\nsrc/app/(public)/page.tsx\nsrc/app/api/academic-years/[id]/route.ts\nsrc/app/api/academic-years/[id]/set-current/route.ts\nsrc/app/api/academic-years/[id]/terms/route.ts\nsrc/app/api/academic-years/route.ts\nsrc/app/api/health/route.ts\nsrc/app/error.tsx\nsrc/app/forbidden/page.tsx\nsrc/app/global-error.tsx\nsrc/app/layout.tsx\nsrc/app/not-found.tsx\nsrc/components/ConfirmDialog/ConfirmDialog.tsx\nsrc/components/DataTable/DataTable.tsx\nsrc/components/DateDisplay/DateDisplay.tsx\nsrc/components/EmptyState/EmptyState.tsx\nsrc/components/FormField/FormField.tsx\nsrc/components/LoadingSkeleto