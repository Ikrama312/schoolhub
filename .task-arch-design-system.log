{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KqQSj6d4XoCPVjrg2aixRP","type":"tool_result","content":"}\n\n/** FR-31: clears exactly the two lockout fields that exist in the schema today. */\nexport async function unlockUser(userId: string) {\n  return prisma.user.update({\n    where: { id: userId },\n    data: { lockedUntil: null, failedLoginCount: 0 },\n    select: { id: true, lockedUntil: true, failedLoginCount: true },\n  });\n}\n\n/**\n * FR-7/FR-12 sequencing dependency (see system-design.md Overview/Component\n * 20): PRD-01's real auth/session has not landed, so this is a stubbed\n * no-op behind the same placeholder convention requireRole.ts establishes.\n * Call sites (POST /api/users/:id/invite, createUser's sendInvite checkbox)\n * do not change when PRD-01 lands and makes this real.\n */\nexport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n  logger.info('sendInvite stub called (PRD-01 auth not landed yet)', { userId });\n  return { id: userId, inviteSentAt: new Date() };\n}\n---shell---\n              onClick={() => setMobileOpen(true)}\n            >\n              <MenuIcon />\n            </IconButton>\n          )}\n          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n            {schoolShortName}\n          </Typography>\n\n          <Tooltip title=\"Notifications\">\n            <IconButton color=\"inherit\" aria-label=\"Notifications\">\n              <Badge badgeContent={0} color=\"error\">\n                <NotificationsNoneIcon />\n              </Badge>\n            </IconButton>\n          </Tooltip>\n\n          <Tooltip title={mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}>\n            <IconButton\n              color=\"inherit\"\n              aria-label=\"Toggle color mode\"\n---nav---\nimport type { ComponentType } from 'react';\nimport DashboardOutlinedIcon from '@mui/icons-material/DashboardOutlined';\n\nexport type Role = 'ADMIN' | 'TEACHER' | 'STUDENT' | 'PARENT';\n\nexport interface NavItem {\n  label: string;\n  href: string;\n  icon: ComponentType;\n  roles: Role[];\n}\n\nconst ALL_ROLES: Role[] = ['ADMIN', 'TEACHER', 'STUDENT', 'PARENT'];\n\n/**\n * Sidebar source of truth. A later PRD that adds a page adds its entry here\n * instead of hard-coding links in the shell.\n */\nexport const navigation: NavItem[] = [\n  { label: 'Dashboard', href: '/dashboard', icon: DashboardOutlinedIcon, roles: ALL_ROLES },\n];\n\nexport function navigationForRole(role: Role): NavItem[] {\n  return navigation.filter((item) => item.roles.includes(role));\n}\n---auth---\nrequireRole.ts\nstudent-access.ts\n---http---\nimport { NextResponse } from 'next/server';\nimport { Prisma } from '@prisma/client';\nimport { ZodError, type ZodSchema } from 'zod';\nimport { logger } from '@/lib/logger';\n\n/**\n * The one chokepoint every route handler goes through. Nothing here should\n * be reimplemented per-route — new endpoints import from this module, they\n * don't hand-roll envelopes, pagination clamping or error mapping.\n */\n\nexport type ApiErrorCode =\n  | 'VALIDATION_ERROR'\n  | 'NOT_FOUND'\n  | 'CONFLICT'\n  | 'INTERNAL'\n  | 'RATE_LIMITED'\n  | 'UNAUTHENTICATED'\n  | 'FORBIDDEN'\n  | 'INVALID_TOKEN';\n\nconst ERROR_STATUS: Record<ApiErrorCode, number> = {\n  VALIDATION_ERROR: 400,\n  NOT_FOUND: 404,\n  CONFLICT: 409,\n  INTERNAL: 500,\n  RATE_LIMITED: 429,\n  UNAUTHENTICATED: 401,\n  FORBIDDEN: 403,\n  INVALID_TOKEN: 410,\n};\n\n/** Throw this from a handler for a known, intentional failure. */\nexport class AppError extends Error {\n  code: ApiErrorCode;\n  details?: unknown;\n\n  constructor(code: ApiErrorCode, message: string, details?: unknown) {\n    super(message);\n    this.code = code;\n    this.details = details;\n  }\n}\n\nexport function ok<T>(data: T, init?: ResponseInit) {\n  return NextResponse.json({ data }, init);\n}\n\nexport function paginated<T>(\n  data: T[],\n  meta: { page: number; pageSize: number; total: number },\n  init?: ResponseInit,\n) {\n  return NextResponse.json({ data, meta }, init);\n}\n\nexport function apiError(code: ApiErrorCode, message: string, details?: unknown) {\n  return NextResponse.json(\n    { error: { code, message, ...(details !== undefined ? { details } : {}) } },\n    { status: ERROR_STATUS[code] },","is_error":false}]},"parent_tool_use_id":null,"session_id":"ecdd0a7a-9233-4799-bc04-313a457b4439","uuid":"13269ada-231b-40a9-bb06-2f539114cfe6","timestamp":"2026-10-19T10:08:28.781Z","tool_use_result":{"stdout":"}\n\n/** FR-31: clears exactly the two lockout fields that exist in the schema today. */\nexport async function unlockUser(userId: string) {\n  return prisma.user.update({\n    where: { id: userId },\n    data: { lockedUntil: null, failedLoginCount: 0 },\n    select: { id: true, lockedUntil: true, failedLoginCount: true },\n  });\n}\n\n/**\n * FR-7/FR-12 sequencing dependency (see system-design.md Overview/Component\n * 20): PRD-01's real auth/session has not landed, so this is a stubbed\n * no-op behind the same placeholder convention requireRole.ts establishes.\n * Call sites (POST /api/users/:id/invite, createUser's sendInvite checkbox)\n * do not change when PRD-01 lands and makes this real.\n */\nexport async function sendInvite(userId: string): Promise<{ id: string; inviteSentAt: Date }> {\n  logger.info('sendInvite stub called (PRD-01 auth not landed yet)', { userId });\n  return { id: userId, inviteSentAt: new Date() };\n}\n---shell---\n              onClick={() => setMobileOpen(true)}\n            >\n              <MenuIcon />\n            </IconButton>\n          )}\n          <Typography variant=\"h6\" noWrap sx={{ flexGrow: 1 }}>\n            {schoolShortName}\n          </Typography>\n\n          <Tooltip title=\"Notifications\">\n            <IconButton color=\"inherit\" aria-label=\"Notifications\">\n              <Badge badgeContent={0} color=\"error\">\n                <NotificationsNoneIcon />\n