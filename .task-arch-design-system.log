{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QNjDDfrRiuF77ssS7fmdDa","type":"tool_result","content":"import { cache } from 'react';\nimport { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { rangesOverlap } from './dateRange';\nimport { getSchoolSettings } from './settings';\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface AcademicYearInput {\n  name: string;\n  startDate: Date;\n  endDate: Date;\n}\n\nfunction assertValidRange(startDate: Date, endDate: Date) {\n  if (endDate <= startDate) {\n    throw new AppError('VALIDATION_ERROR', 'End date must be after start date.');\n  }\n}\n\nasync function assertNoOverlap(\n  tx: Prisma.TransactionClient,\n  range: { startDate: Date; endDate: Date },\n  excludeId?: string,\n) {\n  const others = await tx.academicYear.findMany({\n    where: excludeId ? { id: { not: excludeId } } : undefined,\n  });\n  const conflict = others.find((year) => rangesOverlap(range, year));\n  if (conflict) {\n    throw new AppError('VALIDATION_ERROR', `Dates overlap with ${conflict.name}.`);\n  }\n}\n\nexport async function listAcademicYears() {\n  return prisma.academicYear.findMany({\n    orderBy: { startDate: 'asc' },\n    include: { terms: { orderBy: { order: 'asc' } } },\n  });\n}\n\nexport async function createAcademicYear(input: AcademicYearInput) {\n  assertValidRange(input.startDate, input.endDate);\n  return prisma.$transaction(\n    async (tx) => {\n      await assertNoOverlap(tx, input);\n      return tx.academicYear.create({ data: input });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\nexport async function updateAcademicYear(id: string, input: Partial<AcademicYearInput>) {\n  return prisma.$transaction(\n    async (tx) => {\n      const existing = await tx.academicYear.findUniqueOrThrow({ where: { id } });\n      const startDate = input.startDate ?? existing.startDate;\n      const endDate = input.endDate ?? existing.endDate;\n      assertValidRange(startDate, endDate);\n      await assertNoOverlap(tx, { startDate, endDate }, id);","is_error":false}]},"parent_tool_use_id":null,"session_id":"2a933411-2428-4c0f-ab5f-3414109df7d8","uuid":"6f02bc6e-edcc-4249-b415-96a85c870a01","timestamp":"2026-10-19T09:12:15.950Z","tool_use_result":{"stdout":"import { cache } from 'react';\nimport { Prisma } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { AppError } from '@/server/http';\nimport { rangesOverlap } from './dateRange';\nimport { getSchoolSettings } from './settings';\nimport { formatInSchoolTz } from '@/lib/dates';\n\nexport interface AcademicYearInput {\n  name: string;\n  startDate: Date;\n  endDate: Date;\n}\n\nfunction assertValidRange(startDate: Date, endDate: Date) {\n  if (endDate <= startDate) {\n    throw new AppError('VALIDATION_ERROR', 'End date must be after start date.');\n  }\n}\n\nasync function assertNoOverlap(\n  tx: Prisma.TransactionClient,\n  range: { startDate: Date; endDate: Date },\n  excludeId?: string,\n) {\n  const others = await tx.academicYear.findMany({\n    where: excludeId ? { id: { not: excludeId } } : undefined,\n  });\n  const conflict = others.find((year) => rangesOverlap(range, year));\n  if (conflict) {\n    throw new AppError('VALIDATION_ERROR', `Dates overlap with ${conflict.name}.`);\n  }\n}\n\nexport async function listAcademicYears() {\n  return prisma.academicYear.findMany({\n    orderBy: { startDate: 'asc' },\n    include: { terms: { orderBy: { order: 'asc' } } },\n  });\n}\n\nexport async function createAcademicYear(input: AcademicYearInput) {\n  assertValidRange(input.startDate, input.endDate);\n  return prisma.$transaction(\n    async (tx) => {\n      await assertNoOverlap(tx, input);\n      return tx.academicYear.create({ data: input });\n    },\n    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },\n  );\n}\n\nexport async function updateAcademicYear(id: string, input: Partial<AcademicYearInput>) {\n  return prisma.$transaction(\n    async (tx) => {\n      const existing = await tx.academicYear.findUniqueOrThrow({ where: { id } });\n      const startDate = input.startDate ?? existing.startDate;\n      const endDate = input.endDate ?? existing.endDate;\n      assertValidRange(startDate, endDate);\n      await assertNoOverlap(tx, { startDate, endDate }, id);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgBLZFydtuA7vFxGAdSdX","type":"message","role":"assistant","content":[{"type":"text","text":"I now have everything I need: real codebase conventions, exact schema fields, the full API table, and confirmation that PRD-01's auth infra doesn't actually exist in `src/` yet. Writing `system-design.md`."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3069,"cache_read_input_tokens":75009,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3069},"output_tokens":1,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2a933411-2428-4c0f-ab5f-3414109df7d8","uuid":"7b7ce46f-ef07-452e-90b3-b06e8d8a625a","timestamp":"2026-10-19T09:12:18.488Z","request_id":"req_011CgBLZFHxhJd6qU5zwruBj"}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgBLZFydtuA7vFxGAdSdX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KaVBLuhjYtfDWwjxHDQYD7","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/system-design.md","content":"# System Design — ticket abcd-03 (PRD-03 User Management)\n\nPhase: architect (`arch-design-system`) | Status: complete\n\n## Overview\n\nPRD-03 is brownfield on top of PRD-00 (foundation) and PRD-02 (academic\nstructure), both of which are actually built in `src/`. Intake reports\n**97% confidence and zero blockers** (`handoff-to-architect.json`), and\nonly one requirement (FR-31, unlock) carries MEDIUM confidence — both\ncarried forward unchanged below.\n\n**Finding beyond intake's blocker list, surfaced here because it changes\nthe design:** `requirements.json` and the source PRD (`03-user-management.md`)\nboth write FR-7, FR-12, FR-31 and NFR-7 as if PRD-01 (auth/RBAC) already\nexists to be \"reused\" or \"extended\". Reading the actual codebase shows it\ndoes not — `src/server/auth/` contains only `requireRole.ts`, whose own\ndoc comment states plainly: *\"PRD-01 (real auth/session) has not landed in\nthis workspace yet... returns the same ADMIN placeholder identity\nAppShell renders.\"* There is no `authorize()`, no `middleware.ts`, no\n`src/server/services/users.ts`, no `sendInvite`/`sendAuthEmail`, no login\npage, and the seed script creates no users. The `User`/`AuthToken`/\n`AuditLog` Prisma models and the `lockedUntil`/`failedLoginCount`/\n`passwordChangedAt` columns *do* exist in `prisma/schema.prisma` (PRD-01's\nmigration landed), and `src/server/audit.ts`'s `audit()` helper is real\nand working — only the service/route/session layer is missing.\n\nThis does **not** block `arch-design-system` from producing a design — it\nchanges what the design must say: PRD-03's auth-adjacent requirements are\ndesigned against the *interfaces PRD-01's own design doc already commits\nto* (`src/server/services/users.ts`'s `sendInvite(userId)`, `src/server/\nauth/permissions.ts`'s `requireRole`), on the assumption PRD-01 lands\nfirst. `requireRole.ts`'s placeholder is itself built to absorb that swap\nwith zero call-site changes, so PRD-03 calls it exactly as it will call\nthe real thing later. Flagged explicitly in the Requirements Traceability\ntable below (FR-7, FR-12, FR-31, NFR-7) and restated for `dev-planning` in\nthe Status section — this is a sequencing dependency, not a design defect.\n\nNo new tech decisions are made here beyond `tech-stack-decisions.md`\n(ADR-1 through ADR-9): existing stack only, papaparse client-side only,\nsynchronous per-batch transactions, one shared CSV-escaping util, MUI-only\nUI, additive schema with one new index, shared Zod schemas, reuse of\nPRD-01's session/lockout plumbing (per the finding above), static CSV\ntemplates. This document arranges those choices into components, data\nflow, and per-FR/NFR traceability, per NFR-7/NFR-8's brownfield-and-scope\ndiscipline.\n\nThree chokepoints recur across nearly every requirement and are designed\nbelow as named, independently-testable modules rather than inline route\ncode: the **user list/filter query** (FR-2/3/11, NFR-2), the **CSV import\ntransaction** (FR-18–23, NFR-3), and **`student-access.ts`** (FR-17, NFR-1).\nA fourth cross-cutting rule, **CSV-escaping + medicalNotes redaction**\n(NFR-1/NFR-4), is designed as one shared helper applied at every\nexport/read boundary rather than per-endpoint logic.\n\n## Component Breakdown\n\n| # | Component | Responsibility | Key files | FR/NFR |\n|---|-----------|-----------------|------------|--------|\n| 1 | Data Model | `StudentProfile`/`TeacherProfile`/`ParentProfile`/`ParentStudentLink` + `Gender`/`GuardianRelationship` enums, relations from `User`; one composite index `User(lastName, firstName, email)` | `prisma/schema.prisma` | FR-1, NFR-2 |\n| 2 | User Service Layer | `createUser`, `updateUser`, `setUserStatus`, `archiveUser`/`restoreUser`, `unlockUser`, admission-number/employee-number generators (`S<year>-####` / `T-####`), last-active-admin guard, self-disable/self-archive guard | `src/server/services/users.ts` | FR-3..FR-5, FR-9, FR-10, FR-14, FR-31 |\n| 3 | List/Filter Query | `GET /api/users` query builder: role/status/gradeLevelId/q/includeArchived filters, search across name/email/admissionNumber/employeeNumber, server-side pagination via `src/server/http.ts`'s `parsePagination`, ordered to use the new index | `src/app/api/users/route.ts`, `src/server/services/users.ts` (`listUsers`) | FR-2, FR-3, NFR-2 |\n| 4 | User Detail Composition | `GET /api/users/:id` assembling profile + status + lastLoginAt + family links (component 6) + 20 most recent `AuditLog` rows where `actorId = id OR entityId = id` | `src/app/api/users/[id]/route.ts` | FR-11 |\n| 5 | Create/Edit Form Flow | MUI `Stepper` (role select → common + role-specific fields), inline parent/student linking, \"Send invitation email now\" checkbox, email-change confirm dialog (reuses `ConfirmDialog`), read-only role on edit, shared Zod schemas from component 11 as the RHF resolver | `src/app/(app)/admin/users/new/page.tsx`, `.../[id]/edit/page.tsx` | FR-6, FR-7, FR-8, FR-9, FR-10 |\n| 6 | Family Linking Service | `linkParentToStudent`/`unlinkParentFromStudent` — max-4-parents check, single-`isPrimary` invariant (set-one-clears-others) inside one transaction; called from student form, parent form, and the student-detail Family card | `src/server/services/userLinks.ts` | FR-15, FR-16 |\n| 7 | Access Control Helper | `getAccessibleStudentIds(user)` (ADMIN→`\"ALL\"`, STUDENT→`[user.id]`, PARENT→linked ids via component 6's link table, TEACHER→`[]` until PRD-05), `assertCanViewStudent(user, studentId)` (FORBIDDEN/NOT_FOUND) | `src/server/auth/student-access.ts` | FR-17, FR-25, NFR-1 |\n| 8 | CSV Import — Client | Template download links (component 9), 2 MB/2,000-row cap enforced before upload, papaparse parse into a preview `DataGrid` with per-row Valid/Warning/Error + per-cell reason | `src/app/(app)/admin/users/import/page.tsx` | FR-18, FR-19 |\n| 9 | CSV Import — Server Transaction | `POST /api/users/import`: re-validates every row against component 11's Zod schemas (never trusts the client), batches of 200, one `prisma.$transaction` per batch (all-or-rollback, NFR-3), case-insensitive grade-level match by `name`/`shortName`, strict `YYYY-MM-DD` dates, existing-email rows → \"Skipped — already exists\", summary + error-report CSV via component 10 | `src/app/api/users/import/route.ts`, `src/server/services/userImport.ts`, `public/templates/students-template.csv`, `public/templates/teachers-template.csv` | FR-18, FR-20, FR-21, FR-22, FR-23, NFR-3 |\n| 10 | CSV Export/Escaping Util | `escapeCsvCell()` (leading `=`,`+`,`-`,`@` → apostrophe-prefixed) and `toCsv()` used by bulk \"Export CSV\" (`GET /api/users/export`), the import error report, and nowhere else is CSV built ad hoc; also strips `medicalNotes` from every export row | `src/server/csv.ts` | FR-5 (export), FR-22, NFR-1, NFR-4 |\n| 11 | Shared Validators | One Zod schema per entity (student/teacher/parent row): DOB 3–21yo, phone `^\\+?[0-9 ()-]{7,20}$`, used as the RHF resolver (component 5) and the CSV row validator (components 8 & 9) — single source of truth | `src/lib/validators/users.ts` | FR-10, FR-19, FR-20 |\n| 12 | Student Surface | `/students/[studentId]` header (avatar, name, admission number, grade level, status) + \"Overview\" tab registered in the existing tab registry (profile, family via component 6, emergency contact; `medicalNotes` gated to ADMIN/TEACHER, enforced server-side by component 7/13, not just hidden in the UI) | `src/app/(app)/students/[studentId]/page.tsx`, `src/config/student-tabs.ts` (extend existing empty array) | FR-24, FR-25, NFR-1 |\n| 13 | Student Detail API | `GET /api/students/:id`: gated by `assertCanViewStudent` (component 7), strips `medicalNotes` for STUDENT/PARENT in the service layer (not the client) | `src/app/api/students/[id]/route.ts` | FR-24, NFR-1 |\n| 14 | Parent Surface | `/my-children` (PARENT only): cards (name, grade level, admission number) from `GET /api/me/children`, linking to component 12; empty state via existing `EmptyState` component | `src/app/(app)/my-children/page.tsx`, `src/app/api/me/children/route.ts` | FR-26 |\n| 15 | Self-Service Profile | `/account/profile`: read-only name/email/role, editable phone (+occupation/address for PARENT) via `PATCH /api/me/profile` — a narrower mutation path, deliberately not routed through component 2's admin service | `src/app/(app)/account/profile/page.tsx`, `src/app/api/me/profile/route.ts` | FR-27 |\n| 16 | Directory Picker API + Component | `GET /api/users/search?role=&q=` (ADMIN/TEACHER only, excludes archived, ≤20 results, `{id,name,email,role}`); reusable `UserPicker` on MUI `Autocomplete` (async, `multiple`, avatar+name+role `renderOption`) | `src/app/api/users/search/route.ts`, `src/components/UserPicker/UserPicker.tsx` | FR-28 |\n| 17 | Audit Log Viewer | `/admin/audit-log`: read-only table (time, actor, action, entityType, entityId linked when a user, IP) + filters (actor, action prefix, date range) + right-anchored `Drawer` with pretty-printed metadata JSON on row click; reads the existing `AuditLog` table, no new write path | `src/app/(app)/admin/audit-log/page.tsx`, `src/app/api/audit-logs/route.ts` | FR-29 |\n| 18 | Navigation | New entries: Administration→Users/Import users/Audit log, Parent→\"My children\", user menu→\"Profile\" | `src/config/navigation.ts` (extend existing array) | FR-30 |\n| 19 | Admin Row/Bulk Actions UI | View/Edit/Resend/Unlock/Disable-Enable/Archive-Restore row actions + Resend/Disable/Export-CSV bulk actions on `DataTable`'s selection — thin dispatch onto components 2/9/10's service calls, confirmed via `ConfirmDialog` for destructive ones | reuses `src/components/DataTable/DataTable.tsx`, `src/components/ConfirmDialog/ConfirmDialog.tsx` | FR-4, FR-5 |\n| 20 | Auth/Session Touchpoints (sequencing dependency) | FR-7's `sendInvite(userId)`, FR-12's session-status re-check, FR-31's lockout-field clear — all called through the stable interfaces PRD-01's own design doc defines (`src/server/services/users.ts`, `src/server/auth/permissions.ts`) rather than re-implemented here (NFR-7); see Overview finding | *(PRD-01, not yet landed)* | FR-7, FR-12, FR-31, NFR-7 |\n| 21 | Design System (MUI-only) | Every new screen built from `@mui/material`/`@mui/icons-material`/MUI X only; reuses `DataTable`, `ConfirmDialog`, `UserAvatar`, `EmptyState`, `FormField`, `PageHeader`, `Toast` | reuses `src/components/*`, `src/theme/theme.ts` | NFR-5 |\n| 22 | Test Harness | Vitest unit (CSV row validator, admission-number generator, `escapeCsvCell`, `getAccessibleStudentIds` per role); Vitest integration (import-batch rollback, last-admin guard, primary-link uniqueness); Playwright e2e (create-student-with-parent, CSV import w/ error row, parent My-children→student page) | `tests/**`, `tests/e2e/**` | NFR-6 |\n\nDependency order: 1 (Data Model) underlies everything. 2 (User Service)\ndepends on 1 and is called by 3, 4, 5, 9, 19. 6 (Family Linking) depends on\n1 and feeds 4, 5, 12, 14. 7 (Access Control Helper) depends on 6 and gates\n12, 13, 14. 8→9 is one pipeline; 9 depends on 2, 6, 11 and feeds 10's\nerror-report path. 16 depends on 2. 17 depends only on the existing\n`AuditLog` table. 20 is the one component this PRD does not build —\neverything that calls into it (5, 2, 19) must tolerate it landing late or\nbeing stubbed, per the Overview finding. 21–22 wrap all of the above.\n\n## Data Flow\n\n**User list, `GET /api/users` (FR-2/3, NFR-2):**\n1. `parseQuery` (existing `src/server/http.ts` helper) validates\n   `role`/`status`/`gradeLevelId`/`q`/`includeArchived`/pagination params.\n2. Component 3 builds one Prisma query: `status != ARCHIVED` unless\n   `includeArchived`, `q` matched against name/email/admissionNumber/\n   employeeNumber, ordered/filtered to use the `(lastName, firstName,\n   email)` index (component 1) so the 5,000-row/<300ms budget (NFR-2) holds\n   without client-side filtering.\n3. `paginated()` (existing `http.ts` helper) returns rows + meta; the\n   `DataTable` (component 19/21) reads page/pageSize/sort from the URL, not\n   local state, matching its existing contract.\n\n**Create user, `POST /api/users` (FR-6/7/8/9/10):**\n1. Component 11's Zod schema (role-specific) validates the Stepper's step-2\n   payload server-side (never trust the client-validated form alone).\n2. Component 2's `createUser` generates `admissionNumber`/`employeeNumber`\n   where applicable, creates the `User` + profile row + any inline\n   parent/student links (component 6) in one transaction.\n3. If \"Send invitation email now\" is checked, calls component 20's\n   `sendInvite(userId)` — see Overview finding: this call is wired to the\n   interface PRD-01 commits to, and is a no-op/stub until that interface is\n   real.\n4. `audit('user.created', ...)` via the existing `src/server/audit.ts`.\n\n**Edit user / email change (FR-8/9):**\n1. Role is rejected server-side if present and different from the existing\n   row (not just hidden in the UI) — a service-layer invariant, not a form\n   convenience.\n2. An email diff triggers `ConfirmDialog` client-side; on confirm, the PATCH\n   handler updates the email and invalidates (marks used/expired) any\n   pending `AuthToken` rows of type INVITE for that user, so a stale invite\n   link can't activate the old address.\n\n**Status changes (FR-12/13/14):**\n1. `setUserStatus`/`archiveUser` (component 2) check: not self, and —if\n   disabling an ADMIN— that at least one other ACTIVE ADMIN remains, else\n   `AppError('VALIDATION_ERROR', 'At least one active admin is required.')`.\n2. Disable sets `status=DISABLED`; archive additionally sets\n   `archivedAt=now`. Both are pure data writes today; the \"stops working\n   within 5 minutes\" session-level effect (FR-12) is PRD-01's session check\n   re-reading `status` on its token-refresh interval — this PRD does not\n   and should not build that check (NFR-7), it only guarantees `status` is\n   correct the instant the mutation commits.\n3. Every list/picker query (components 3, 16) and `getAccessibleStudentIds`\n   (component 7) excludes `ARCHIVED` users by default, so archival's\n   app-wide picker exclusion (FR-13) is enforced once, at the query layer,\n   not per-caller.\n\n**Family linking (FR-15/16):**\n1. `linkParentToStudent` runs inside one transaction: count existing links\n   for the student (reject the 5th with `VALIDATION_ERROR`), and if the new\n   link is `isPrimary`, clear `isPrimary` on every other link for that\n   student first, then insert.\n2. Reachable from three entry points (student form, parent form, student\n   detail \"Family\" card) that all call this one function — no duplicated\n   invariant logic.\n\n**CSV import (FR-18–23, NFR-3):**\n1. Browser: papaparse parses the uploaded file (component 8), rejecting\n   >2 MB/>2,000 rows before parsing; each row runs through component 11's\n   Zod schema plus a grade-level-name lookup for Valid/Warning/Error\n   classification with a per-cell reason, rendered in a preview `DataGrid`.\n2. \"Import N valid rows\" POSTs rows (not the file) in chunks of 200 to\n   component 9.\n3. Server re-validates every row independently of the client (NFR-3's\n   trust boundary), matches grade levels case-insensitively by `name` or\n   `shortName`, parses dates strictly as `YYYY-MM-DD`, and skips rows whose\n   email already exists (\"Skipped — already exists\", FR-23) rather than\n   erroring.\n4. Each 200-row batch runs in one `prisma.$transaction` (ADR-3): any row\n   failure that isn't a plain \"skip\" rolls back only that batch, never the\n   whole import; results aggregate into the post-import summary (component\n   10) and, for failed rows, an escaped error-report CSV.\n\n**Student/parent surfaces (FR-24/25/26):**\n1. `/students/[studentId]` and `/my-children` both resolve access through\n   component 7 (`assertCanViewStudent` / `getAccessibleStudentIds`) — no\n   page implements its own authorization check.\n2. `GET /api/students/:id` (component 13) strips `medicalNotes` for\n   STUDENT/PARENT roles in the service layer before the response is built,\n   so no client-side hiding can leak it (NFR-1); the same strip applies\n   inside component 10's CSV export path.\n\n**Directory picker (FR-28):** `GET /api/users/search` reuses component 3's\nunderlying query (role/q filters, archived excluded) capped to 20 rows and\nprojected down to `{id,name,email,role}` — no separate search index.\n\n**Audit log viewer (FR-29):** pure read over the existing `AuditLog` table\n(`src/server/audit.ts`'s schema) with actor/action-prefix/date-range\nfilters and pagination; no new write path, matching NFR-7.\n\n## Requirements Traceability\n\n| Requirement | Design Element |\n|---|---|\n| FR-1 | Component 1 — Prisma models/enums + relations |\n| FR-2 | Component 3 — `GET /api/users` list query |\n| FR-3 | Component 3 — filters (role/status/gradeLevel/search/archived) |\n| FR-4 | Component 19 — row actions dispatch |\n| FR-5 | Component 19 (UI) + Component 10 (export) — bulk actions |\n| FR-6 | Component 5 — Stepper create/edit form |\n| FR-7 | Component 5 (checkbox) + **Component 20** — `sendInvite` call (sequencing dependency, see Overview) |\n| FR-8 | Component 5 — email-change confirm + invite-token invalidation |\n| FR-9 | Component 2 + 5 — role immutability, service + form |\n| FR-10 | Component 11 — shared DOB/phone Zod schema |\n| FR-11 | Component 4 — user detail composition |\n| FR-12 | Component 2 (status write) + **Component 20** — session-level effect (sequencing dependency, see Overview) |\n| FR-13 | Component 2 — archive write; Components 3/7/16 — app-wide picker exclusion |\n| FR-14 | Component 2 — self/last-admin guard |\n| FR-15 | Component 6 — link service, 3 entry points |\n| FR-16 | Component 6 — max-4 / single-primary invariant |\n| FR-17 | Component 7 — `student-access.ts` |\n| FR-18 | Component 9 — static templates; Component 8 — download UI |\n| FR-19 | Component 8 — client parse + preview grid |\n| FR-20 | Component 9 — server re-validation + batched transactions |\n| FR-21 | Component 9 — invite toggle, grade-level matching, strict dates |\n| FR-22 | Component 9 + 10 — summary + error-report CSV |\n| FR-23 | Component 9 — existing-email skip rule |\n| FR-24 | Component 12 — student detail page + Overview tab |\n| FR-25 | Component 7 + 12 — `assertCanViewStudent` gate |\n| FR-26 | Component 14 — `/my-children` |\n| FR-27 | Component 15 — `/account/profile` |\n| FR-28 | Component 16 — search API + `UserPicker` |\n| FR-29 | Component 17 — audit log viewer |\n| FR-30 | Component 18 — navigation entries |\n| FR-31 | **Component 20** — unlock clears PRD-01's lockout fields (MEDIUM confidence, carried from intake — verify exact field names against `prisma/schema.prisma`, which already has `lockedUntil`/`failedLoginCount`) |\n| NFR-1 | Component 7 + 13 + 10 — `medicalNotes` redaction (service layer + export) |\n| NFR-2 | Component 1 + 3 — composite index + server-side pagination |\n| NFR-3 | Component 9 — one transaction per 200-row batch |\n| NFR-4 | Component 10 — `escapeCsvCell` shared util |\n| NFR-5 | Component 21 — MUI-only, existing ESLint `no-restricted-imports` |\n| NFR-6 | Component 22 — Vitest unit/integration + Playwright e2e |\n| NFR-7 | Component 2/6/7 (new, additive) + **Component 20** (reuse, not rebuild, PRD-01's interfaces — see Overview) |\n| NFR-8 | All components — additive only, no PRD-05 (class/section) behavior touched |\n\n## Status\n\nComplete. All 31 FR ids and 8 NFR ids are accounted for above; none were\ndropped. Two things carry forward for `arch-api-contracts` and\n`dev-planning`:\n\n1. **FR-31 (MEDIUM confidence):** confirm `POST /api/users/:id/unlock`\n   clears exactly `lockedUntil`/`failedLoginCount` (both already in\n   `prisma/schema.prisma`) before finalizing the contract.\n2. **Sequencing dependency on PRD-01 (Component 20):** `src/server/\n   services/users.ts`'s `sendInvite`, and the session-status re-check\n   behind FR-12, do not exist in `src/` yet — only their schema\n   (`User.status`/`lockedUntil`/`failedLoginCount`/`passwordChangedAt`,\n   `AuthToken`) and the `requireRole()` placeholder exist. This is not a\n   reason to re-implement them inside PRD-03 (NFR-7 forbids it) — it is a\n   reason `dev-planning` should either sequence PRD-01's dev work ahead of\n   PRD-03's component 20 items, or stub `sendInvite`/the status re-check\n   behind the same placeholder convention `requireRole.ts` already\n   establishes, so call sites don't change when PRD-01 lands. The source\n   API table in `03-user-management.md` is otherwise fully specified and\n   ready for `arch-api-contracts` to derive `api-contracts.json` directly\n   from (18 endpoints: `GET/POST /api/users`, `GET/PATCH /api/users/:id`,\n   `POST /api/users/:id/{invite,unlock,status,archive,restore}`, `POST\n   /api/users/import`, `GET /api/users/export`, `GET /api/users/search`,\n   `POST /api/students/:id/parents`, `DELETE /api/students/:id/parents/\n   :parentId`, `GET /api/students/:id`, `GET /api/me/children`, `PATCH\n   /api/me/profile`, `GET /api/audit-logs`).\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3069,"cache_read_input_tokens":75009,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3069},"output_tokens":1,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2a933411-2428-4c0f-ab5f-3414109df7d8","uuid":"708c98c7-2d19-481a-9b0e-2b3f22ea78c9","timestamp":"2026-10-19T09:13:43.930Z","request_id":"req_011CgBLZFHxhJd6qU5zwruBj"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KaVBLuhjYtfDWwjxHDQYD7","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/system-design.md has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2a933411-2428-4c0f-ab5f-3414109df7d8","uuid":"6e248c98-0f63-4662-bfe7-0facc27bfe1d","timestamp":"2026-10-19T09:13:44.074Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/system-design.md","content":"# System Design — ticket abcd-03 (PRD-03 User Management)\n\nPhase: architect (`arch-design-system`) | Status: complete\n\n## Overview\n\nPRD-03 is brownfield on top of PRD-00 (foundation) and PRD-02 (academic\nstructure), both of which are actually built in `src/`. Intake reports\n**97% confidence and zero blockers** (`handoff-to-architect.json`), and\nonly one requirement (FR-31, unlock) carries MEDIUM confidence — both\ncarried forward unchanged below.\n\n**Finding beyond intake's blocker list, surfaced here because it changes\nthe design:** `requirements.json` and the source PRD (`03-user-management.md`)\nboth write FR-7, FR-12, FR-31 and NFR-7 as if PRD-01 (auth/RBAC) already\nexists to be \"reused\" or \"extended\". Reading the actual codebase shows it\ndoes not — `src/server/auth/` contains only `requireRole.ts`, whose own\ndoc comment states plainly: *\"PRD-01 (real auth/session) has not landed in\nthis workspace yet... returns the same ADMIN placeholder identity\nAppShell renders.\"* There is no `authorize()`, no `middleware.ts`, no\n`src/server/services/users.ts`, no `sendInvite`/`sendAuthEmail`, no login\npage, and the seed script creates no users. The `User`/`AuthToken`/\n`AuditLog` Prisma models and the `lockedUntil`/`failedLoginCount`/\n`passwordChangedAt` columns *do* exist in `prisma/schema.prisma` (PRD-01's\nmigration landed), and `src/server/audit.ts`'s `audit()` helper is real\nand working — only the service/route/session layer is missing.\n\nThis does **not** block `arch-design-system` from producing a design — it\nchanges what the design must say: PRD-03's auth-adjacent requirements are\ndesigned against the *interfaces PRD-01's own design doc already commits\nto* (`src/server/services/users.ts`'s `sendInvite(userId)`, `src/server/\nauth/permissions.ts`'s `requireRole`), on the assumption PRD-01 lands\nfirst. `requireRole.ts`'s placeholder is itself built to absorb that swap\nwith zero call-site changes, so PRD-03 calls it exactly as it will call\nthe real thing later. Flagged explicitly in the Requirements Traceability\ntable below (FR-7, FR-12, FR-31, NFR-7) and restated for `dev-planning` in\nthe Status section — this is a sequencing dependency, not a design defect.\n\nNo new tech decisions are made here beyond `tech-stack-decisions.md`\n(ADR-1 through ADR-9): existing stack only, papaparse client-side only,\nsynchronous per-batch transactions, one shared CSV-escaping util, MUI-only\nUI, additive schema with one new index, shared Zod schemas, reuse of\nPRD-01's session/lockout plumbing (per the finding above), static CSV\ntemplates. This document arranges those choices into components, data\nflow, and per-FR/NFR traceability, per NFR-7/NFR-8's brownfield-and-scope\ndiscipline.\n\nThree chokepoints recur across nearly every requirement and are designed\nbelow as named, independently-testable modules rather than inline route\ncode: the **user list/filter query** (FR-2/3/11, NFR-2), the **CSV import\ntransaction** (FR-18–23, NFR-3), and **`student-access.ts`** (FR-17, NFR-1).\nA fourth cross-cutting rule, **CSV-escaping + medicalNotes redaction**\n(NFR-1/NFR-4), is designed as one shared helper applied at every\nexport/read boundary rather than per-endpoint logic.\n\n## Component Breakdown\n\n| # | Component | Responsibility | Key files | FR/NFR |\n|---|-----------|-----------------|------------|--------|\n| 1 | Data Model | `StudentProfile`/`TeacherProfile`/`ParentProfile`/`ParentStudentLink` + `Gender`/`GuardianRelationship` enums, relations from `User`; one composite index `User(lastName, firstName, email)` | `prisma/schema.prisma` | FR-1, NFR-2 |\n| 2 | User Service Layer | `createUser`, `updateUser`, `setUserStatus`, `archiveUser`/`restoreUser`, `unlockUser`, admission-number/employee-number generators (`S<year>-####` / `T-####`), last-active-admin guard, self-disable/self-archive guard | `src/server/services/users.ts` | FR-3..FR-5, FR-9, FR-10, FR-14, FR-31 |\n| 3 | List/Filter Query | `GET /api/users` query builder: role/status/gradeLevelId/q/includeArchived filters, search across name/email/admissionNumber/employeeNumber, server-side pagination via `src/server/http.ts`'s `parsePagination`, ordered to use the new index | `src/app/api/users/route.ts`, `src/server/services/users.ts` (`listUsers`) | FR-2, FR-3, NFR-2 |\n| 4 | User Detail Composition | `GET /api/users/:id` assembling profile + status + lastLoginAt + family links (component 6) + 20 most recent `AuditLog` rows where `actorId = id OR entityId = id` | `src/app/api/users/[id]/route.ts` | FR-11 |\n| 5 | Create/Edit Form Flow | MUI `Stepper` (role select → common + role-specific fields), inline parent/student linking, \"Send invitation email now\" checkbox, email-change confirm dialog (reuses `ConfirmDialog`), read-only role on edit, shared Zod schemas from component 11 as the RHF resolver | `src/app/(app)/admin/users/new/page.tsx`, `.../[id]/edit/page.tsx` | FR-6, FR-7, FR-8, FR-9, FR-10 |\n| 6 | Family Linking Service | `linkParentToStudent`/`unlinkParentFromStudent` — max-4-parents check, single-`isPrimary` invariant (set-one-clears-others) inside one transaction; called from student form, parent form, and the student-detail Family card | `src/server/services/userLinks.ts` | FR-15, FR-16 |\n| 7 | Access Control Helper | `getAccessibleStudentIds(user)` (ADMIN→`\"ALL\"`, STUDENT→`[user.id]`, PARENT→linked ids via component 6's link table, TEACHER→`[]` until PRD-05), `assertCanViewStudent(user, studentId)` (FORBIDDEN/NOT_FOUND) | `src/server/auth/student-access.ts` | FR-17, FR-25, NFR-1 |\n| 8 | CSV Import — Client | Template download links (component 9), 2 MB/2,000-row cap enforced before upload, papaparse parse into a preview `DataGrid` with per-row Valid/Warning/Error + per-cell reason | `src/app/(app)/admin/users/import/page.tsx` | FR-18, FR-19 |\n| 9 | CSV Import — Server Transaction | `POST /api/users/import`: re-validates every row against component 11's Zod schemas (never trusts the client), batches of 200, one `prisma.$transaction` per batch (all-or-rollback, NFR-3), case-insensitive grade-level match by `name`/`shortName`, strict `YYYY-MM-DD` dates, existing-email rows → \"Skipped — already exists\", summary + error-report CSV via component 10 | `src/app/api/users/import/route.ts`, `src/server/services/userImport.ts`, `public/templates/students-template.csv`, `public/templates/teachers-template.csv` | FR-18, FR-20, FR-21, FR-22, FR-23, NFR-3 |\n| 10 | CSV Export/Escaping Util | `escapeCsvCell()` (leading `=`,`+`,`-`,`@` → apostrophe-prefixed) and `toCsv()` used by bulk \"Export CSV\" (`GET /api/users/export`), the import error report, and nowhere else is CSV built ad hoc; also strips `medicalNotes` from every export row | `src/server/csv.ts` | FR-5 (export), FR-22, NFR-1, NFR-4 |\n| 11 | Shared Validators | One Zod schema per entity (student/teacher/parent row): DOB 3–21yo, phone `^\\+?[0-9 ()-]{7,20}$`, used as the RHF resolver (component 5) and the CSV row validator (components 8 & 9) — single source of truth | `src/lib/validators/users.ts` | FR-10, FR-19, FR-20 |\n| 12 | Student Surface | `/students/[studentId]` header (avatar, name, admission number, grade level, status) + \"Overview\" tab registered in the existing tab registry (profile, family via component 6, emergency contact; `medicalNotes` gated to ADMIN/TEACHER, enforced server-side by component 7/13, not just hidden in the UI) | `src/app/(app)/students/[studentId]/page.tsx`, `src/config/student-tabs.ts` (extend existing empty array) | FR-24, FR-25, NFR-1 |\n| 13 | Student Detail API | `GET /api/students/:id`: gated by `assertCanViewStudent` (component 7), strips `medicalNotes` for STUDENT/PARENT in the service layer (not the client) | `src/app/api/students/[id]/route.ts` | FR-24, NFR-1 |\n| 14 | Parent Surface | `/my-children` (PARENT only): cards (name, grade level, admission number) from `GET /api/me/children`, linking to component 12; empty state via existing `EmptyState` component | `src/app/(app)/my-children/page.tsx`, `src/app/api/me/children/route.ts` | FR-26 |\n| 15 | Self-Service Profile | `/account/profile`: read-only name/email/role, editable phone (+occupation/address for PARENT) via `PATCH /api/me/profile` — a narrower mutation path, deliberately not routed through component 2's admin service | `src/app/(app)/account/profile/page.tsx`, `src/app/api/me/profile/route.ts` | FR-27 |\n| 16 | Directory Picker API + Component | `GET /api/users/search?role=&q=` (ADMIN/TEACHER only, excludes archived, ≤20 results, `{id,name,email,role}`); reusable `UserPicker` on MUI `Autocomplete` (async, `multiple`, avatar+name+role `renderOption`) | `src/app/api/users/search/route.ts`, `src/components/UserPicker/UserPicker.tsx` | FR-28 |\n| 17 | Audit Log Viewer | `/admin/audit-log`: read-only table (time, actor, action, entityType, entityId linked when a user, IP) + filters (actor, action prefix, date range) + right-anchored `Drawer` with pretty-printed metadata JSON on row click; reads the existing `AuditLog` table, no new write path | `src/app/(app)/admin/audit-log/page.tsx`, `src/app/api/audit-logs/route.ts` | FR-29 |\n| 18 | Navigation | New entries: Administration→Users/Import users/Audit log, Parent→\"My children\", user menu→\"Profile\" | `src/config/navigation.ts` (extend existing array) | FR-30 |\n| 19 | Admin Row/Bulk Actions UI | View/Edit/Resend/Unlock/Disable-Enable/Archive-Restore row actions + Resend/Disable/Export-CSV bulk actions on `DataTable`'s selection — thin dispatch onto components 2/9/10's service calls, confirmed via `ConfirmDialog` for destructive ones | reuses `src/components/DataTable/DataTable.tsx`, `src/components/ConfirmDialog/ConfirmDialog.tsx` | FR-4, FR-5 |\n| 20 | Auth/Session Touchpoints (sequencing dependency) | FR-7's `sendInvite(userId)`, FR-12's session-status re-check, FR-31's lockout-field clear — all called through the stable interfaces PRD-01's own design doc defines (`src/server/services/users.ts`, `src/server/auth/permissions.ts`) rather than re-implemented here (NFR-7); see Overview finding | *(PRD-01, not yet landed)* | FR-7, FR-12, FR-31, NFR-7 |\n| 21 | Design System (MUI-only) | Every new screen built from `@mui/material`/`@mui/icons-material`/MUI X only; reuses `DataTable`, `ConfirmDialog`, `UserAvatar`, `EmptyState`, `FormField`, `PageHeader`, `Toast` | reuses `src/components/*`, `src/theme/theme.ts` | NFR-5 |\n| 22 | Test Harness | Vitest unit (CSV row validator, admission-number generator, `escapeCsvCell`, `getAccessibleStudentIds` per role); Vitest integration (import-batch rollback, last-admin guard, primary-link uniqueness); Playwright e2e (create-student-with-parent, CSV import w/ error row, parent My-children→student page) | `tests/**`, `tests/e2e/**` | NFR-6 |\n\nDependency order: 1 (Data Model) underlies everything. 2 (User Service)\ndepends on 1 and is called by 3, 4, 5, 9, 19. 6 (Family Linking) depends on\n1 and feeds 4, 5, 12, 14. 7 (Access Control Helper) depends on 6 and gates\n12, 13, 14. 8→9 is one pipeline; 9 depends on 2, 6, 11 and feeds 10's\nerror-report path. 16 depends on 2. 17 depends only on the existing\n`AuditLog` table. 20 is the one component this PRD does not build —\neverything that calls into it (5, 2, 19) must tolerate it landing late or\nbeing stubbed, per the Overview finding. 21–22 wrap all of the above.\n\n## Data Flow\n\n**User list, `GET /api/users` (FR-2/3, NFR-2):**\n1. `parseQuery` (existing `src/server/http.ts` helper) validates\n   `role`/`status`/`gradeLevelId`/`q`/`includeArchived`/pagination params.\n2. Component 3 builds one Prisma query: `status != ARCHIVED` unless\n   `includeArchived`, `q` matched against name/email/admissionNumber/\n   employeeNumber, ordered/filtered to use the `(lastName, firstName,\n   email)` index (component 1) so the 5,000-row/<300ms budget (NFR-2) holds\n   without client-side filtering.\n3. `paginated()` (existing `http.ts` helper) returns rows + meta; the\n   `DataTable` (component 19/21) reads page/pageSize/sort from the URL, not\n   local state, matching its existing contract.\n\n**Create user, `POST /api/users` (FR-6/7/8/9/10):**\n1. Component 11's Zod schema (role-specific) validates the Stepper's step-2\n   payload server-side (never trust the client-validated form alone).\n2. Component 2's `createUser` generates `admissionNumber`/`employeeNumber`\n   where applicable, creates the `User` + profile row + any inline\n   parent/student links (component 6) in one transaction.\n3. If \"Send invitation email now\" is checked, calls component 20's\n   `sendInvite(userId)` — see Overview finding: this call is wired to the\n   interface PRD-01 commits to, and is a no-op/stub until that interface is\n   real.\n4. `audit('user.created', ...)` via the existing `src/server/audit.ts`.\n\n**Edit user / email change (FR-8/9):**\n1. Role is rejected server-side if present and different from the existing\n   row (not just hidden in the UI) — a service-layer invariant, not a form\n   convenience.\n2. An email diff triggers `ConfirmDialog` client-side; on confirm, the PATCH\n   handler updates the email and invalidates (marks used/expired) any\n   pending `AuthToken` rows of type INVITE for that user, so a stale invite\n   link can't activate the old address.\n\n**Status changes (FR-12/13/14):**\n1. `setUserStatus`/`archiveUser` (component 2) check: not self, and —if\n   disabling an ADMIN— that at least one other ACTIVE ADMIN remains, else\n   `AppError('VALIDATION_ERROR', 'At least one active admin is required.')`.\n2. Disable sets `status=DISABLED`; archive additionally sets\n   `archivedAt=now`. Both are pure data writes today; the \"stops working\n   within 5 minutes\" session-level effect (FR-12) is PRD-01's session check\n   re-reading `status` on its token-refresh interval — this PRD does not\n   and should not build that check (NFR-7), it only guarantees `status` is\n   correct the instant the mutation commits.\n3. Every list/picker query (components 3, 16) and `getAccessibleStudentIds`\n   (component 7) excludes `ARCHIVED` users by default, so archival's\n   app-wide picker exclusion (FR-13) is enforced once, at the query layer,\n   not per-caller.\n\n**Family linking (FR-15/16):**\n1. `linkParentToStudent` runs inside one transaction: count existing links\n   for the student (reject the 5th with `VALIDATION_ERROR`), and if the new\n   link is `isPrimary`, clear `isPrimary` on every other link for that\n   student first, then insert.\n2. Reachable from three entry points (student form, parent form, student\n   detail \"Family\" card) that all call this one function — no duplicated\n   invariant logic.\n\n**CSV import (FR-18–23, NFR-3):**\n1. Browser: papaparse parses the uploaded file (component 8), rejecting\n   >2 MB/>2,000 rows before parsing; each row runs through component 11's\n   Zod schema plus a grade-level-name lookup for Valid/Warning/Error\n   classification with a per-cell reason, rendered in a preview `DataGrid`.\n2. \"Import N valid rows\" POSTs rows (not the file) in chunks of 200 to\n   component 9.\n3. Server re-validates every row independently of the client (NFR-3's\n   trust boundary), matches grade levels case-insensitively by `name` or\n   `shortName`, parses dates strictly as `YYYY-MM-DD`, and skips rows whose\n   email already exists (\"Skipped — already exists\", FR-23) rather than\n   erroring.\n4. Each 200-row batch runs in one `prisma.$transaction` (ADR-3): any row\n   failure that isn't a plain \"skip\" rolls back only that batch, never the\n   whole import; results aggregate into the post-import summary (component\n   10) and, for failed rows, an escaped error-report CSV.\n\n**Student/parent surfaces (FR-24/25/26):**\n1. `/students/[studentId]` and `/my-children` both resolve access through\n   component 7 (`assertCanViewStudent` / `getAccessibleStudentIds`) — no\n   page implements its own authorization check.\n2. `GET /api/students/:id` (component 13) strips `medicalNotes` for\n   STUDENT/PARENT roles in the service layer before the response is built,\n   so no client-side hiding can leak it (NFR-1); the same strip applies\n   inside component 10's CSV export path.\n\n**Directory picker (FR-28):** `GET /api/users/search` reuses component 3's\nunderlying query (role/q filters, archived excluded) capped to 20 rows and\nprojected down to `{id,name,email,role}` — no separate search index.\n\n**Audit log viewer (FR-29):** pure read over the existing `AuditLog` table\n(`src/server/audit.ts`'s schema) with actor/action-prefix/date-range\nfilters and pagination; no new write path, matching NFR-7.\n\n## Requirements Traceability\n\n| Requirement | Design Element |\n|---|---|\n| FR-1 | Component 1 — Prisma models/enums + relations |\n| FR-2 | Component 3 — `GET /api/users` list query |\n| FR-3 | Component 3 — filters (role/status/gradeLevel/search/archived) |\n| FR-4 | Component 19 — row actions dispatch |\n| FR-5 | Component 19 (UI) + Component 10 (export) — bulk actions |\n| FR-6 | Component 5 — Stepper create/edit form |\n| FR-7 | Component 5 (checkbox) + **Component 20** — `sendInvite` call (sequencing dependency, see Overview) |\n| FR-8 | Component 5 — email-change confirm + invite-token invalidation |\n| FR-9 | Component 2 + 5 — role immutability, service + form |\n| FR-10 | Component 11 — shared DOB/phone Zod schema |\n| FR-11 | Component 4 — user detail composition |\n| FR-12 | Component 2 (status write) + **Component 20** — session-level effect (sequencing dependency, see Overview) |\n| FR-13 | Component 2 — archive write; Components 3/7/16 — app-wide picker exclusion |\n| FR-14 | Component 2 — self/last-admin guard |\n| FR-15 | Component 6 — link service, 3 entry points |\n| FR-16 | Component 6 — max-4 / single-primary invariant |\n| FR-17 | Component 7 — `student-access.ts` |\n| FR-18 | Component 9 — static templates; Component 8 — download UI |\n| FR-19 | Component 8 — client parse + preview grid |\n| FR-20 | Component 9 — server re-validation + batched transactions |\n| FR-21 | Component 9 — invite toggle, grade-level matching, strict dates |\n| FR-22 | Component 9 + 10 — summary + error-report CSV |\n| FR-23 | Component 9 — existing-email skip rule |\n| FR-24 | Component 12 — student detail page + Overview tab |\n| FR-25 | Component 7 + 12 — `assertCanViewStudent` gate |\n| FR-26 | Component 14 — `/my-children` |\n| FR-27 | Component 15 — `/account/profile` |\n| FR-28 | Component 16 — search API + `UserPicker` |\n| FR-29 | Component 17 — audit log viewer |\n| FR-30 | Component 18 — navigation entries |\n| FR-31 | **Component 20** — unlock clears PRD-01's lockout fields (MEDIUM confidence, carried from intake — verify exact field names against `prisma/schema.prisma`, which already has `lockedUntil`/`failedLoginCount`) |\n| NFR-1 | Component 7 + 13 + 10 — `medicalNotes` redaction (service layer + export) |\n| NFR-2 | Component 1 + 3 — composite index + server-side pagination |\n| NFR-3 | Component 9 — one transaction per 200-row batch |\n| NFR-4 | Component 10 — `escapeCsvCell` shared util |\n| NFR-5 | Component 21 — MUI-only, existing ESLint `no-restricted-imports` |\n| NFR-6 | Component 22 — Vitest unit/integration + Playwright e2e |\n| NFR-7 | Component 2/6/7 (new, additive) + **Component 20** (reuse, not rebuild, PRD-01's interfaces — see Overview) |\n| NFR-8 | All components — additive only, no PRD-05 (class/section) behavior touched |\n\n## Status\n\nComplete. All 31 FR ids and 8 NFR ids are accounted for above; none were\ndropped. Two things carry forward for `arch-api-contracts` and\n`dev-planning`:\n\n1. **FR-31 (MEDIUM confidence):** confirm `POST /api/users/:id/unlock`\n   clears exactly `lockedUntil`/`failedLoginCount` (both already in\n   `prisma/schema.prisma`) before finalizing the contract.\n2. **Sequencing dependency on PRD-01 (Component 20):** `src/server/\n   services/users.ts`'s `sendInvite`, and the session-status re-check\n   behind FR-12, do not exist in `src/` yet — only their schema\n   (`User.status`/`lockedUntil`/`failedLoginCount`/`passwordChangedAt`,\n   `AuthToken`) and the `requireRole()` placeholder exist. This is not a\n   reason to re-implement them inside PRD-03 (NFR-7 forbids it) — it is a\n   reason `dev-planning` should either sequence PRD-01's dev work ahead of\n   PRD-03's component 20 items, or stub `sendInvite`/the status re-check\n   behind the same placeholder convention `requireRole.ts` already\n   establishes, so call sites don't change when PRD-01 lands. The source\n   API table in `03-user-management.md` is otherwise fully specified and\n   ready for `arch-api-contracts` to derive `api-contracts.json` directly\n   from (18 endpoints: `GET/POST /api/users`, `GET/PATCH /api/users/:id`,\n   `POST /api/users/:id/{invite,unlock,status,archive,restore}`, `POST\n   /api/users/import`, `GET /api/users/export`, `GET /api/users/search`,\n   `POST /api/students/:id/parents`, `DELETE /api/students/:id/parents/\n   :parentId`, `GET /api/students/:id`, `GET /api/me/children`, `PATCH\n   /api/me/profile`, `GET /api/audit-logs`).\n","structuredPatch":[{"oldStart":1,"oldLines":201,"newStart":1,"newLines":255,"lines":["-# System Design — ticket abcd-2 (SchoolHub auth PRD)","+# System Design — ticket abcd-03 (PRD-03 User Management)"," "," Phase: architect (`arch-design-system`) | Status: complete"," "," ## Overview"," ","-This PRD is brownfield on top of the abcd-1 scaffold: it adds credentials","-authentication, session/route guarding, invite acceptance, password","-reset/change, permission helpers, and audit logging to the existing Next.js","-14 App Router / Prisma / MUI v9 app. Intake reported **98% confidence and","-zero blockers** (`artifacts/intake/handoff-to-architect.json`) — there is","-nothing to flag here beyond that figure; all 28 FRs and 8 NFRs are HIGH","-confidence except FR-11 (MEDIUM — `src/config/public-routes.ts` doesn't","-exist yet and is treated below as a new file) and FR-26 (MEDIUM — assumed","-wiring change, not a rewrite, of `navigation.ts`'s existing filter","-signature).","+PRD-03 is brownfield on top of PRD-00 (foundation) and PRD-02 (academic","+structure), both of which are actually built in `src/`. Intake reports","+**97% confidence and zero blockers** (`handoff-to-architect.json`), and","+only one requirement (FR-31, unlock) carries MEDIUM confidence — both","+carried forward unchanged below."," ","-No new architecture decisions are made here beyond what","-`tech-stack-decisions.md` (ADR-1 through ADR-7) already fixed: Auth.js","-(NextAuth v5) Credentials provider with JWT sessions, bcrypt (cost 12) with","-a dummy-compare for timing safety, Node's built-in `crypto` for tokens, an","-in-memory sliding-window rate limiter, Prisma-schema extension (no new","-DB/ORM), reuse of MUI v9 + React Hook Form + Zod for every screen, and reuse","-of the existing Vitest/Playwright stack. This document arranges those","-choices into components and data flow, per NFR-7's brownfield discipline","-(reuse abcd-1's models/services/helpers; never re-scaffold or duplicate).","+**Finding beyond intake's blocker list, surfaced here because it changes","+the design:** `requirements.json` and the source PRD (`03-user-management.md`)","+both write FR-7, FR-12, FR-31 and NFR-7 as if PRD-01 (auth/RBAC) already","+exists to be \"reused\" or \"extended\". Reading the actual codebase shows it","+does not — `src/server/auth/` contains only `requireRole.ts`, whose own","+doc comment states plainly: *\"PRD-01 (real auth/session) has not landed in","+this workspace yet... returns the same ADMIN placeholder identity","+AppShell renders.\"* There is no `authorize()`, no `middleware.ts`, no","+`src/server/services/users.ts`, no `sendInvite`/`sendAuthEmail`, no login","+page, and the seed script creates no users. The `User`/`AuthToken`/","+`AuditLog` Prisma models and the `lockedUntil`/`failedLoginCount`/","+`passwordChangedAt` columns *do* exist in `prisma/schema.prisma` (PRD-01's","+migration landed), and `src/server/audit.ts`'s `audit()` helper is real","+and working — only the service/route/session layer is missing."," ","-Three shared chokepoints recur across nearly every requirement and are","-designed below as named, independently-testable modules rather than inline","-route code: `authorize()` (sign-in), `audit()` (every audited action), and","-the password-policy module (every password-setting path). A fourth","-cross-cutting mechanism, the `passwordChangedAt` timestamp, ties together","-session invalidation, change-password, and reset-password and is called out","-in its own Data Flow subsection so its three writers don't drift.","+This does **not** block `arch-design-system` from producing a design — it","+changes what the design must say: PRD-03's auth-adjacent requirements are","+designed against the *interfaces PRD-01's own design doc already commits","+to* (`src/server/services/users.ts`'s `sendInvite(userId)`, `src/server/","+auth/permissions.ts`'s `requireRole`), on the assumption PRD-01 lands","+first. `requireRole.ts`'s placeholder is itself built to absorb that swap","+with zero call-site changes, so PRD-03 calls it exactly as it will call","+the real thing later. Flagged explicitly in the Requirements Traceability","+table below (FR-7, FR-12, FR-31, NFR-7) and restated for `dev-planning` in","+the Status section — this is a sequencing dependency, not a design defect."," ","+No new tech decisions are made here beyond `tech-stack-decisions.md`","+(ADR-1 through ADR-9): existing stack only, papaparse client-side only,","+synchronous per-batch transactions, one shared CSV-escaping util, MUI-only","+UI, additive schema with one new index, shared Zod schemas, reuse of","+PRD-01's session/lockout plumbing (per the finding above), static CSV","+templates. This document arranges those choices into components, data","+flow, and per-FR/NFR traceability, per NFR-7/NFR-8's brownfield-and-scope","+discipline.","+","+Three chokepoints recur across nearly every requirement and are designed","+below as named, independently-testable modules rather than inline route","+code: the **user list/filter query** (FR-2/3/11, NFR-2), the **CSV import","+transaction** (FR-18–23, NFR-3), and **`student-access.ts`** (FR-17, NFR-1).","+A fourth cross-cutting rule, **CSV-escaping + medicalNotes redaction**","+(NFR-1/NFR-4), is designed as one shared helper applied at every","+export/read boundary rather than per-endpoint logic.","+"," ## Component Breakdown"," "," | # | Component | Responsibility | Key files | FR/NFR |"," |---|-----------|-----------------|------------|--------|","-| 1 | Data Model | `User`/`AuthToken`/`AuditLog` models + `Role`/`UserStatus`/`AuthTokenType` enums, extending the existing Prisma schema | `prisma/schema.prisma` | FR-1, NFR-1, NFR-7 |","-| 2 | Credentials Auth Core | `authorize()` chokepoint (normalize email → status/lockout checks → bcrypt compare → dummy-compare branch), `/login` page, failure-messaging matrix, lockout counter mutation, same-origin `callbackUrl` guard | `src/server/auth/authorize.ts`, `src/app/(public)/login/page.tsx`, `src/lib/callback-url.ts` | FR-2, FR-3, FR-4, FR-5, FR-7, NFR-2, NFR-3 |","-| 3 | Rate Limiting | In-memory sliding-window limiter, configurable key (per-IP, or per-email+per-IP), exported for reuse | `src/server/rate-limit.ts` | FR-6, FR-17 |","-| 4 | Session / Route Guard | Auth.js config (`jwt`/`session` callbacks carrying id/role/firstName/lastName/email, 8h lifetime, `passwordChangedAt` invalidation throttled to 5-min checks), `middleware.ts` perimeter, new allowlist file | `src/server/auth/config.ts` (or `auth.ts`), `middleware.ts`, `src/config/public-routes.ts` | FR-9, FR-10, FR-11, NFR-1 |","-| 5 | Invite Flow | Token lookup by SHA-256 hash (type=INVITE, unused, 7-day expiry), accept-invite form + atomic submit (validate → hash → activate → mark-used → sign-in → redirect → audit) | `src/app/(public)/invite/[token]/page.tsx`, `src/server/services/users.ts` (accept-invite step) | FR-12, FR-13, FR-14 |","-| 6 | Password Policy | Single Zod rule set (length, letter+digit, not-email, not-common-password) exported for both server validation and the client-side live checklist — one schema, not two | `src/lib/validators/auth.ts` | FR-15, FR-16 |","-| 7 | Password Reset Flow | `/forgot-password` constant-response + rate limit, reset-token issuance (32 random bytes, 60-min expiry, invalidate prior unused reset tokens via a shared `revokeUnusedTokens(userId, type)` helper), `/reset-password/[token]` (set hash, clear lockout fields, mark used, audit, redirect) | `src/app/(public)/forgot-password/page.tsx`, `src/app/(public)/reset-password/[token]/page.tsx`, `src/server/services/users.ts` | FR-17, FR-18, FR-19 |","-| 8 | Change Password | `/account/security` form (current-password check, FR-15 policy on new password, bumps `passwordChangedAt`, re-issues current session token) | `src/app/(app)/account/security/page.tsx` | FR-20, FR-21 |","-| 9 | Service Layer | Stable exported surface for this and later PRDs: `createUser`, `createInviteToken`, `sendInvite`, `setUserStatus`, `unlockUser` | `src/server/services/users.ts` | FR-22, NFR-7 |","-| 10 | Permission Helpers | `getCurrentUser()`, `requireUser()` (throws UNAUTHENTICATED / redirects to `/login`), `requireRole(...roles)` (throws FORBIDDEN / redirects to `/forbidden`) — no generic `can()` by design | `src/server/auth/permissions.ts` | FR-23, NFR-8 |","-| 11 | Audit Logging | `audit()` insert-only helper: captures IP from `x-forwarded-for`, never throws, never logs secrets — single call site signature for FR-8/14/19 | `src/server/audit.ts` | FR-8, FR-14 (audit step), FR-19 (audit step), FR-24, NFR-1 |","-| 12 | App Shell Integration | Top-bar user menu wired to real session (name/role badge/avatar initials, sign-out), \"Account security\" menu entry, `navigation.ts` switched from placeholder to real session role | `src/app/(app)/layout.tsx` (user menu), `src/config/navigation.ts` | FR-21 (menu entry), FR-25, FR-26 |","-| 13 | Notifications Stub | `sendAuthEmail()` logs recipient/subject/link via `logger.info`; stable signature so PRD-04 can swap the implementation without touching call sites | `src/server/email/send-auth-email.ts` | FR-27 |","-| 14 | Seed Data | Seeds six ACTIVE users + one INVITED user via the Service Layer (component 9), logs the invite link via component 13 | `prisma/seed.ts` | FR-28 |","-| 15 | Design System (MUI-only) | Every new screen (`/login`, `/invite/[token]`, `/forgot-password`, `/reset-password/[token]`, `/account/security`) built from existing MUI v9 + React Hook Form + Zod resolver patterns; shared form-error pattern (`aria-live=\"polite\"`, focus-to-first-invalid-field) | reuses abcd-1's `src/components/*`, `src/theme/theme.ts` | NFR-4, NFR-5 |","-| 16 | Lint/CI Gate | No new lint rule; existing `no-restricted-imports` ESLint rule from abcd-1 continues to apply; `lint`/`typecheck`/`test` stay green, scope capped to this PRD's test list | `.eslintrc*` (unchanged) | NFR-5, NFR-8 |","-| 17 | Test Harness | Vitest unit (policy, token hash/expiry, lockout counter, rate limiter, callbackUrl guard), Vitest integration against test DB (authorize branches, accept-invite, reset-password, change-password), Playwright e2e (sign-in/out, failed-login messaging, forgot-to-reset) | `tests/**`, `tests/e2e/**` | NFR-6 |","+| 1 | Data Model | `StudentProfile`/`TeacherProfile`/`ParentProfile`/`ParentStudentLink` + `Gender`/`GuardianRelationship` enums, relations from `User`; one composite index `User(lastName, firstName, email)` | `prisma/schema.prisma` | FR-1, NFR-2 |","+| 2 | User Service Layer | `createUser`, `updateUser`, `setUserStatus`, `archiveUser`/`restoreUser`, `unlockUser`, admission-number/employee-number generators (`S<year>-####` / `T-####`), last-active-admin guard, self-disable/self-archive guard | `src/server/services/users.ts` | FR-3..FR-5, FR-9, FR-10, FR-14, FR-31 |","+| 3 | List/Filter Query | `GET /api/users` query builder: role/status/gradeLevelId/q/includeArchived filters, search across name/email/admissionNumber/employeeNumber, server-side pagination via `src/server/http.ts`'s `parsePagination`, ordered to use the new index | `src/app/api/users/route.ts`, `src/server/services/users.ts` (`listUsers`) | FR-2, FR-3, NFR-2 |","+| 4 | User Detail Composition | `GET /api/users/:id` assembling profile + status + lastLoginAt + family links (component 6) + 20 most recent `AuditLog` rows where `actorId = id OR entityId = id` | `src/app/api/users/[id]/route.ts` | FR-11 |","+| 5 | Create/Edit Form Flow | MUI `Stepper` (role select → common + role-specific fields), inline parent/student linking, \"Send invitation email now\" checkbox, email-change confirm dialog (reuses `ConfirmDialog`), read-only role on edit, shared Zod schemas from component 11 as the RHF resolver | `src/app/(app)/admin/users/new/page.tsx`, `.../[id]/edit/page.tsx` | FR-6, FR-7, FR-8, FR-9, FR-10 |","+| 6 | Family Linking Service | `linkParentToStudent`/`unlinkParentFromStudent` — max-4-parents check, single-`isPrimary` invariant (set-one-clears-others) inside one transaction; called from student form, parent form, and the student-detail Family card | `src/server/services/userLinks.ts` | FR-15, FR-16 |","+| 7 | Access Control Helper | `getAccessibleStudentIds(user)` (ADMIN→`\"ALL\"`, STUDENT→`[user.id]`, PARENT→linked ids via component 6's link table, TEACHER→`[]` until PRD-05), `assertCanViewStudent(user, studentId)` (FORBIDDEN/NOT_FOUND) | `src/server/auth/student-access.ts` | FR-17, FR-25, NFR-1 |","+| 8 | CSV Import — Client | Template download links (component 9), 2 MB/2,000-row cap enforced before upload, papaparse parse into a preview `DataGrid` with per-row Valid/Warning/Error + per-cell reason | `src/app/(app)/admin/users/import/page.tsx` | FR-18, FR-19 |","+| 9 | CSV Import — Server Transaction | `POST /api/users/import`: re-validates every row against component 11's Zod schemas (never trusts the client), batches of 200, one `prisma.$transaction` per batch (all-or-rollback, NFR-3), case-insensitive grade-level match by `name`/`shortName`, strict `YYYY-MM-DD` dates, existing-email rows → \"Skipped — already exists\", summary + error-report CSV via component 10 | `src/app/api/users/import/route.ts`, `src/server/services/userImport.ts`, `public/templates/students-template.csv`, `public/templates/teachers-template.csv` | FR-18, FR-20, FR-21, FR-22, FR-23, NFR-3 |","+| 10 | CSV Export/Escaping Util | `escapeCsvCell()` (leading `=`,`+`,`-`,`@` → apostrophe-prefixed) and `toCsv()` used by bulk \"Export CSV\" (`GET /api/users/export`), the import error report, and nowhere else is CSV built ad hoc; also strips `medicalNotes` from every export row | `src/server/csv.ts` | FR-5 (export), FR-22, NFR-1, NFR-4 |","+| 11 | Shared Validators | One Zod schema per entity (student/teacher/parent row): DOB 3–21yo, phone `^\\+?[0-9 ()-]{7,20}$`, used as the RHF resolver (component 5) and the CSV row validator (components 8 & 9) — single source of truth | `src/lib/validators/users.ts` | FR-10, FR-19, FR-20 |","+| 12 | Student Surface | `/students/[studentId]` header (avatar, name, admission number, grade level, status) + \"Overview\" tab registered in the existing tab registry (profile, family via component 6, emergency contact; `medicalNotes` gated to ADMIN/TEACHER, enforced server-side by component 7/13, not just hidden in the UI) | `src/app/(app)/students/[studentId]/page.tsx`, `src/config/student-tabs.ts` (extend existing empty array) | FR-24, FR-25, NFR-1 |","+| 13 | Student Detail API | `GET /api/students/:id`: gated by `assertCanViewStudent` (component 7), strips `medicalNotes` for STUDENT/PARENT in the service layer (not the client) | `src/app/api/students/[id]/route.ts` | FR-24, NFR-1 |","+| 14 | Parent Surface | `/my-children` (PARENT only): cards (name, grade level, admission number) from `GET /api/me/children`, linking to component 12; empty state via existing `EmptyState` component | `src/app/(app)/my-children/page.tsx`, `src/app/api/me/children/route.ts` | FR-26 |","+| 15 | Self-Service Profile | `/account/profile`: read-only name/email/role, editable phone (+occupation/address for PARENT) via `PATCH /api/me/profile` — a narrower mutation path, deliberately not routed through component 2's admin service | `src/app/(app)/account/profile/page.tsx`, `src/app/api/me/profile/route.ts` | FR-27 |","+| 16 | Directory Picker API + Component | `GET /api/users/search?role=&q=` (ADMIN/TEACHER only, excludes archived, ≤20 results, `{id,name,email,role}`); reusable `UserPicker` on MUI `Autocomplete` (async, `multiple`, avatar+name+role `renderOption`) | `src/app/api/users/search/route.ts`, `src/components/UserPicker/UserPicker.tsx` | FR-28 |","+| 17 | Audit Log Viewer | `/admin/audit-log`: read-only table (time, actor, action, entityType, entityId linked when a user, IP) + filters (actor, action prefix, date range) + right-anchored `Drawer` with pretty-printed metadata JSON on row click; reads the existing `AuditLog` table, no new write path | `src/app/(app)/admin/audit-log/page.tsx`, `src/app/api/audit-logs/route.ts` | FR-29 |","+| 18 | Navigation | New entries: Administration→Users/Import users/Audit log, Parent→\"My children\", user menu→\"Profile\" | `src/config/navigation.ts` (extend existing array) | FR-30 |","+| 19 | Admin Row/Bulk Actions UI | View/Edit/Resend/Unlock/Disable-Enable/Archive-Restore row actions + Resend/Disable/Export-CSV bulk actions on `DataTable`'s selection — thin dispatch onto components 2/9/10's service calls, confirmed via `ConfirmDialog` for destructive ones | reuses `src/components/DataTable/DataTable.tsx`, `src/components/ConfirmDialog/ConfirmDialog.tsx` | FR-4, FR-5 |","+| 20 | Auth/Session Touchpoints (sequencing dependency) | FR-7's `sendInvite(userId)`, FR-12's session-status re-check, FR-31's lockout-field clear — all called through the stable interfaces PRD-01's own design doc defines (`src/server/services/users.ts`, `src/server/auth/permissions.ts`) rather than re-implemented here (NFR-7); see Overview finding | *(PRD-01, not yet landed)* | FR-7, FR-12, FR-31, NFR-7 |","+| 21 | Design System (MUI-only) | Every new screen built from `@mui/material`/`@mui/icons-material`/MUI X only; reuses `DataTable`, `ConfirmDialog`, `UserAvatar`, `EmptyState`, `FormField`, `PageHeader`, `Toast` | reuses `src/components/*`, `src/theme/theme.ts` | NFR-5 |","+| 22 | Test Harness | Vitest unit (CSV row validator, admission-number generator, `escapeCsvCell`, `getAccessibleStudentIds` per role); Vitest integration (import-batch rollback, last-admin guard, primary-link uniqueness); Playwright e2e (create-student-with-parent, CSV import w/ error row, parent My-children→student page) | `tests/**`, `tests/e2e/**` | NFR-6 |"," ","-Dependency order: 1 (Data Model) underlies everything. 2, 5, 7, 8 all depend","-on 1 + 6 (Password Policy) + 11 (Audit) + 3 (Rate Limiting where noted). 4","-(Session/Route Guard) depends on 1 + 2 (consumes `authorize()`'s result) and","-gates 12 (App Shell) and every `(app)` page. 9 (Service Layer) is called by","-5, 7's reset-issuance, and 14 (Seed). 10 (Permission Helpers) backs up 4's","-perimeter at the page/handler level. 13 is called by 5 (seed-time invite","-link) and 7 (reset email). 15–17 wrap all of the above.","+Dependency order: 1 (Data Model) underlies everything. 2 (User Service)","+depends on 1 and is called by 3, 4, 5, 9, 19. 6 (Family Linking) depends on","+1 and feeds 4, 5, 12, 14. 7 (Access Control Helper) depends on 6 and gates","+12, 13, 14. 8→9 is one pipeline; 9 depends on 2, 6, 11 and feeds 10's","+error-report path. 16 depends on 2. 17 depends only on the existing","+`AuditLog` table. 20 is the one component this PRD does not build —","+everything that calls into it (5, 2, 19) must tolerate it landing late or","+being stubbed, per the Overview finding. 21–22 wrap all of the above."," "," ## Data Flow"," ","-**Sign-in, `POST` via `signIn('credentials')` → `authorize()` (FR-2/3/4/5/7/8, NFR-2/3):**","-1. Rate limiter (component 3) checks 10 attempts/IP/5-min before any DB","-   work; over the limit short-circuits with `RATE_LIMITED` (FR-6).","-2. `authorize()` lower-cases/trims the email and looks up the `User`.","-3. Non-existent user → run the dummy bcrypt compare against a fixed hash","-   (NFR-2) anyway, then fail with the generic message (FR-4).","-4. Existing user: status ≠ ACTIVE, archived, or `lockedUntil` in the future","-   → fail with the disabled/locked message (locked message includes","-   remaining minutes) — no bcrypt compare needed here since the account","-   doesn't reach the password check per FR-4/FR-3's branch order.","-5. Otherwise bcrypt-compare (cost 12) the password.","-   - Wrong password: increment `failedLoginCount`; at 5 increments set","-     `lockedUntil = now + 15min` and reset the counter (FR-5); write","-     `auth.login.failure` (and `auth.lockout` if the threshold was just hit)","-     via `audit()` (component 11, FR-8).","-   - Correct password: reset `failedLoginCount` to 0, set `lastLoginAt`,","-     write `auth.login.success` (FR-8).","-6. On success, the `jwt` callback (component 4) stamps id/role/firstName/","-   lastName/email into the token (FR-9); the route layer validates","-   `callbackUrl` is a same-origin relative path before redirecting, else","-   falls back to `/dashboard` (FR-7).","+**User list, `GET /api/users` (FR-2/3, NFR-2):**","+1. `parseQuery` (existing `src/server/http.ts` helper) validates","+   `role`/`status`/`gradeLevelId`/`q`/`includeArchived`/pagination params.","+2. Component 3 builds one Prisma query: `status != ARCHIVED` unless","+   `includeArchived`, `q` matched against name/email/admissionNumber/","+   employeeNumber, ordered/filtered to use the `(lastName, firstName,","+   email)` index (component 1) so the 5,000-row/<300ms budget (NFR-2) holds","+   without client-side filtering.","+3. `paginated()` (existing `http.ts` helper) returns rows + meta; the","+   `DataTable` (component 19/21) reads page/pageSize/sort from the URL, not","+   local state, matching its existing contract."," ","-**Session validation, every request through `middleware.ts` + the `jwt`","-callback (FR-9/10/11, NFR-1):**","-1. `middleware.ts` redirects unauthenticated `(app)` requests to","-   `/login?callbackUrl=<path>`; for `/api/*` it returns 401 JSON unless the","-   path is `/api/health`, `/api/auth/*`, or listed in","-   `src/config/public-routes.ts`.","-2. The `jwt` callback checks — at most once per 5 minutes per token, to","-   bound cost — whether `passwordChangedAt` is later than the token's issue","-   time; if so the session is invalid and re-login is forced on that","-   device.","+**Create user, `POST /api/users` (FR-6/7/8/9/10):**","+1. Component 11's Zod schema (role-specific) validates the Stepper's step-2","+   payload server-side (never trust the client-validated form alone).","+2. Component 2's `createUser` generates `admissionNumber`/`employeeNumber`","+   where applicable, creates the `User` + profile row + any inline","+   parent/student links (component 6) in one transaction.","+3. If \"Send invitation email now\" is checked, calls component 20's","+   `sendInvite(userId)` — see Overview finding: this call is wired to the","+   interface PRD-01 commits to, and is a no-op/stub until that interface is","+   real.","+4. `audit('user.created', ...)` via the existing `src/server/audit.ts`."," ","-**Invite acceptance, `/invite/[token]` (FR-12/13/14):**","-1. Look up the token by its SHA-256 hash (never store/compare the raw","-   token, NFR-1); it must be type INVITE, unused, and within 7 days of","-   issuance, else show the invalid/expired state (distinct from sign-in's","-   failure messaging).","-2. Valid token renders the invited user's name/email read-only plus","-   new/confirm-password fields.","-3. Submit runs as one service-layer step in `src/server/services/users.ts`:","-   validate against the Password Policy module (component 6) → hash →","-   `status = ACTIVE`, `passwordChangedAt = now` → mark token used → sign the","-   user in → redirect to `/dashboard` → `audit('auth.invite.accepted')`.","-   These steps stay together so a failure partway doesn't leave a used","-   token with no activated account.","+**Edit user / email change (FR-8/9):**","+1. Role is rejected server-side if present and different from the existing","+   row (not just hidden in the UI) — a service-layer invariant, not a form","+   convenience.","+2. An email diff triggers `ConfirmDialog` client-side; on confirm, the PATCH","+   handler updates the email and invalidates (marks used/expired) any","+   pending `AuthToken` rows of type INVITE for that user, so a stale invite","+   link can't activate the old address."," ","-**Forgot/reset password (FR-17/18/19, pairs with NFR-2's anti-enumeration","-intent):**","-1. `/forgot-password` always returns the same message regardless of account","-   existence; rate-limited both per-email (3/hr) and per-IP (10/hr) through","-   component 3's configurable-key limiter.","-2. For an existing ACTIVE user only: issue a PASSWORD_RESET token (32 random","-   bytes, base64url, 60-min expiry) and call `revokeUnusedTokens(userId,","-   'PASSWORD_RESET')` to invalidate older unused reset tokens for that user","-   — this invalidate-on-reissue rule is reset-specific and must not leak","-   into the invite path's token producer. Then `sendAuthEmail(user,","-   'password-reset', link)` (component 13).","-3. `/reset-password/[token]` sets the new hash and `passwordChangedAt`,","-   clears the lockout fields (`failedLoginCount`, `lockedUntil` — kept in","-   sync with FR-5's lockout field set), marks the token used, audits","-   `auth.password.reset`, redirects to `/login`.","+**Status changes (FR-12/13/14):**","+1. `setUserStatus`/`archiveUser` (component 2) check: not self, and —if","+   disabling an ADMIN— that at least one other ACTIVE ADMIN remains, else","+   `AppError('VALIDATION_ERROR', 'At least one active admin is required.')`.","+2. Disable sets `status=DISABLED`; archive additionally sets","+   `archivedAt=now`. Both are pure data writes today; the \"stops working","+   within 5 minutes\" session-level effect (FR-12) is PRD-01's session check","+   re-reading `status` on its token-refresh interval — this PRD does not","+   and should not build that check (NFR-7), it only guarantees `status` is","+   correct the instant the mutation commits.","+3. Every list/picker query (components 3, 16) and `getAccessibleStudentIds`","+   (component 7) excludes `ARCHIVED` users by default, so archival's","+   app-wide picker exclusion (FR-13) is enforced once, at the query layer,","+   not per-caller."," ","-**`passwordChangedAt` — one field, three writers, one reader:** FR-19","-(reset), FR-20 (change-password), and FR-14 (invite acceptance) each write","-this timestamp; the `jwt` callback (FR-10) is the single reader that forces","-re-login elsewhere. Change-password (FR-20) additionally re-issues the","-*current* session's token immediately after writing it, so the acting user","-isn't logged out by their own action while every other session is.","+**Family linking (FR-15/16):**","+1. `linkParentToStudent` runs inside one transaction: count existing links","+   for the student (reject the 5th with `VALIDATION_ERROR`), and if the new","+   link is `isPrimary`, clear `isPrimary` on every other link for that","+   student first, then insert.","+2. Reachable from three entry points (student form, parent form, student","+   detail \"Family\" card) that all call this one function — no duplicated","+   invariant logic."," ","-**App shell integration (FR-21/25/26):** once component 4 produces a real","-session, component 12 replaces abcd-1's placeholder user-menu slot and","-`navigation.ts`'s placeholder role with the session's real name/role/","-avatar-initials and `Role` value — a wiring change against abcd-1's existing","-filter signature, not new UI.","+**CSV import (FR-18–23, NFR-3):**","+1. Browser: papaparse parses the uploaded file (component 8), rejecting","+   >2 MB/>2,000 rows before parsing; each row runs through component 11's","+   Zod schema plus a grade-level-name lookup for Valid/Warning/Error","+   classification with a per-cell reason, rendered in a preview `DataGrid`.","+2. \"Import N valid rows\" POSTs rows (not the file) in chunks of 200 to","+   component 9.","+3. Server re-validates every row independently of the client (NFR-3's","+   trust boundary), matches grade levels case-insensitively by `name` or","+   `shortName`, parses dates strictly as `YYYY-MM-DD`, and skips rows whose","+   email already exists (\"Skipped — already exists\", FR-23) rather than","+   erroring.","+4. Each 200-row batch runs in one `prisma.$transaction` (ADR-3): any row","+   failure that isn't a plain \"skip\" rolls back only that batch, never the","+   whole import; results aggregate into the post-import summary (component","+   10) and, for failed rows, an escaped error-report CSV."," ","-**Seed flow (FR-28):** `prisma/seed.ts` calls `createUser`/","-`createInviteToken` (component 9, not duplicated logic) to create six","-ACTIVE users and one INVITED user (shared password `SchoolHub123!`), and","-logs the invited user's invite link through `sendAuthEmail`'s `logger.info`","-path (component 13).","+**Student/parent surfaces (FR-24/25/26):**","+1. `/students/[studentId]` and `/my-children` both resolve access through","+   component 7 (`assertCanViewStudent` / `getAccessibleStudentIds`) — no","+   page implements its own authorization check.","+2. `GET /api/students/:id` (component 13) strips `medicalNotes` for","+   STUDENT/PARENT roles in the service layer before the response is built,","+   so no client-side hiding can leak it (NFR-1); the same strip applies","+   inside component 10's CSV export path."," ","+**Directory picker (FR-28):** `GET /api/users/search` reuses component 3's","+underlying query (role/q filters, archived excluded) capped to 20 rows and","+projected down to `{id,name,email,role}` — no separate search index.","+","+**Audit log viewer (FR-29):** pure read over the existing `AuditLog` table","+(`src/server/audit.ts`'s schema) with actor/action-prefix/date-range","+filters and pagination; no new write path, matching NFR-7.","+"," ## Requirements Traceability"," "," | Requirement | Design Element |"," |---|---|","-| FR-1 | Component 1 — `User`/`AuthToken`/`AuditLog` + enums |","-| FR-2 | Component 2 — `/login` page (MUI form) |","-| FR-3 | Component 2 — `authorize()` |","-| FR-4 | Component 2 — failure-messaging matrix |","-| FR-5 | Component 2 — lockout counter mutation |","-| FR-6 | Component 3 — sign-in rate limit (10/IP/5min) |","-| FR-7 | Component 2 — `callbackUrl` same-origin guard |","-| FR-8 | Component 11 — `audit()` calls from `authorize()` |","-| FR-9 | Component 4 — `jwt`/`session` callbacks |","-| FR-10 | Component 4 — `passwordChangedAt` invalidation check |","-| FR-11 | Component 4 — `middleware.ts` + `public-routes.ts` |","-| FR-12 | Component 5 — invite-token lookup |","-| FR-13 | Component 5 — accept-invitation form |","-| FR-14 | Component 5 — accept-invite submit (service-layer transaction) |","-| FR-15 | Component 6 — password-policy Zod schema |","-| FR-16 | Component 6 — live strength checklist (client mirror) |","-| FR-17 | Component 7 — `/forgot-password` + rate limit |","-| FR-18 | Component 7 — reset-token issuance + `revokeUnusedTokens` |","-| FR-19 | Component 7 — `/reset-password/[token]` |","-| FR-20 | Component 8 — `/account/security` change-password form |","-| FR-21 | Component 8 + Component 12 — \"Account security\" menu entry |","-| FR-22 | Component 9 — `src/server/services/users.ts` exports |","-| FR-23 | Component 10 — `src/server/auth/permissions.ts` |","-| FR-24 | Component 11 — `audit()` helper signature |","-| FR-25 | Component 12 — top-bar user menu (real session) |","-| FR-26 | Component 12 — `navigation.ts` real role wiring |","-| FR-27 | Component 13 — `sendAuthEmail()` stub |","-| FR-28 | Component 14 — `prisma/seed.ts` |","-| NFR-1 | Component 1 + 4 + 11 — hash-only tokens, constant-time compare, HttpOnly/Secure/SameSite cookies, Auth.js CSRF |","-| NFR-2 | Component 2 — dummy bcrypt-compare branch |","-| NFR-3 | Component 2 — p95 < 1s budget at cost 12 |","-| NFR-4 | Component 15 — shared form-error pattern (all 5 auth forms) |","-| NFR-5 | Component 15 + 16 — MUI-only enforcement, existing ESLint rule |","-| NFR-6 | Component 17 — Vitest unit/integration + Playwright e2e |","-| NFR-7 | Component 1 + 9 + 10 + 11 — brownfield reuse of abcd-1 conventions |","-| NFR-8 | Component 16 — lint/typecheck/test gate, scope cap |","+| FR-1 | Component 1 — Prisma models/enums + relations |","+| FR-2 | Component 3 — `GET /api/users` list query |","+| FR-3 | Component 3 — filters (role/status/gradeLevel/search/archived) |","+| FR-4 | Component 19 — row actions dispatch |","+| FR-5 | Component 19 (UI) + Component 10 (export) — bulk actions |","+| FR-6 | Component 5 — Stepper create/edit form |","+| FR-7 | Component 5 (checkbox) + **Component 20** — `sendInvite` call (sequencing dependency, see Overview) |","+| FR-8 | Component 5 — email-change confirm + invite-token invalidation |","+| FR-9 | Component 2 + 5 — role immutability, service + form |","+| FR-10 | Component 11 — shared DOB/phone Zod schema |","+| FR-11 | Component 4 — user detail composition |","+| FR-12 | Component 2 (status write) + **Component 20** — session-level effect (sequencing dependency, see Overview) |","+| FR-13 | Component 2 — archive write; Components 3/7/16 — app-wide picker exclusion |","+| FR-14 | Component 2 — self/last-admin guard |","+| FR-15 | Component 6 — link service, 3 entry points |","+| FR-16 | Component 6 — max-4 / single-primary invariant |","+| FR-17 | Component 7 — `student-access.ts` |","+| FR-18 | Component 9 — static templates; Component 8 — download UI |","+| FR-19 | Component 8 — client parse + preview grid |","+| FR-20 | Component 9 — server re-validation + batched transactions |","+| FR-21 | Component 9 — invite toggle, grade-level matching, strict dates |","+| FR-22 | Component 9 + 10 — summary + error-report CSV |","+| FR-23 | Component 9 — existing-email skip rule |","+| FR-24 | Component 12 — student detail page + Overview tab |","+| FR-25 | Component 7 + 12 — `assertCanViewStudent` gate |","+| FR-26 | Component 14 — `/my-children` |","+| FR-27 | Component 15 — `/account/profile` |","+| FR-28 | Component 16 — search API + `UserPicker` |","+| FR-29 | Component 17 — audit log viewer |","+| FR-30 | Component 18 — navigation entries |","+| FR-31 | **Component 20** — unlock clears PRD-01's lockout fields (MEDIUM confidence, carried from intake — verify exact field names against `prisma/schema.prisma`, which already has `lockedUntil`/`failedLoginCount`) |","+| NFR-1 | Component 7 + 13 + 10 — `medicalNotes` redaction (service layer + export) |","+| NFR-2 | Component 1 + 3 — composite index + server-side pagination |","+| NFR-3 | Component 9 — one transaction per 200-row batch |","+| NFR-4 | Component 10 — `escapeCsvCell` shared util |","+| NFR-5 | Component 21 — MUI-only, existing ESLint `no-restricted-imports` |","+| NFR-6 | Component 22 — Vitest unit/integration + Playwright e2e |","+| NFR-7 | Component 2/6/7 (new, additive) + **Component 20** (reuse, not rebuild, PRD-01's interfaces — see Overview) |","+| NFR-8 | All components — additive only, no PRD-05 (class/section) behavior touched |"," "," ## Status"," ","-Complete. All 28 FR ids and 8 NFR ids are accounted for above; none were","-dropped. FR-11 and FR-26 carry forward intake's MEDIUM-confidence notes","-(new `public-routes.ts` file; assumed-compatible `navigation.ts` signature)","-for `arch-api-contracts` and dev-planning to verify against the real","-abcd-1 code rather than treat as settled. No blockers to carry forward —","-`arch-api-contracts` can proceed to deriving the API surface (the `/login`,","-`/invite/[token]`, `/forgot-password`, `/reset-password/[token]`, and","-`/account/security` form-submission endpoints, plus Auth.js's own","-`/api/auth/*` routes).","+Complete. All 31 FR ids and 8 NFR ids are accounted for above; none were","+dropped. Two things carry forward for `arch-api-contracts` and","+`dev-planning`:","+","+1. **FR-31 (MEDIUM confidence):** confirm `POST /api/users/:id/unlock`","+   clears exactly `lockedUntil`/`failedLoginCount` (both already in","+   `prisma/schema.prisma`) before finalizing the contract.","+2. **Sequencing dependency on PRD-01 (Component 20):** `src/server/","+   services/users.ts`'s `sendInvite`, and the session-status re-check","+   behind FR-12, do not exist in `src/` yet — only their schema","+   (`User.status`/`lockedUntil`/`failedLoginCount`/`passwordChangedAt`,","+   `AuthToken`) and the `requireRole()` placeholder exist. This is not a","+   reason to re-implement them inside PRD-03 (NFR-7 forbids it) — it is a","+   reason `dev-planning` should either sequence PRD-01's dev work ahead of","+   PRD-03's component 20 items, or stub `sendInvite`/the status re-check","+   behind the same placeholder convention `requireRole.ts` already","+   establishes, so call sites don't change when PRD-01 lands. The source","+   API table in `03-user-management.md` is otherwise fully specified and","+   ready for `arch-api-contracts` to derive `api-contracts.json` directly","+   from (18 endpoints: `GET/POST /api/users`, `GET/PATCH /api/users/:id`,","+   `POST /api/users/:id/{invite,unlock,status,archive,restore}`, `POST","+   /api/users/import`, `GET /api/users/export`, `GET /api/users/search`,","+   `POST /api/students/:id/parents`, `DELETE /api/students/:id/parents/","+   :parentId`, `GET /api/students/:id`, `GET /api/me/children`, `PATCH","+   /api/me/profile`, `GET /api/audit-logs`)."]}],"originalFile":"# System Design — ticket abcd-2 (SchoolHub auth PRD)\n\nPhase: architect (`arch-design-system`) | Status: complete\n\n## Overview\n\nThis PRD is brownfield on top of the abcd-1 scaffold: it adds credentials\nauthentication, session/route guarding, invite acceptance, password\nreset/change, permission helpers, and audit logging to the existing Next.js\n14 App Router / Prisma / MUI v9 app. Intake reported **98% confidence and\nzero blockers** (`artifacts/intake/handoff-to-architect.json`) — there is\nnothing to flag here beyond that figure; all 28 FRs and 8 NFRs are HIGH\nconfidence except FR-11 (MEDIUM — `src/config/public-routes.ts` doesn't\nexist yet and is treated below as a new file) and FR-26 (MEDIUM — assumed\nwiring change, not a rewrite, of `navigation.ts`'s existing filter\nsignature).\n\nNo new architecture decisions are made here beyond what\n`tech-stack-decisions.md` (ADR-1 through ADR-7) already fixed: Auth.js\n(NextAuth v5) Credentials provider with JWT sessions, bcrypt (cost 12) with\na dummy-compare for timing safety, Node's built-in `crypto` for tokens, an\nin-memory sliding-window rate limiter, Prisma-schema extension (no new\nDB/ORM), reuse of MUI v9 + React Hook Form + Zod for every screen, and reuse\nof the existing Vitest/Playwright stack. This document arranges those\nchoices into components and data flow, per NFR-7's brownfield discipline\n(reuse abcd-1's models/services/helpers; never re-scaffold or duplicate).\n\nThree shared chokepoints recur across nearly every requirement and are\ndesigned below as named, independently-testable modules rather than inline\nroute code: `authorize()` (sign-in), `audit()` (every audited action), and\nthe password-policy module (every password-setting path). A fourth\ncross-cutting mechanism, the `passwordChangedAt` timestamp, ties together\nsession invalidation, change-password, and reset-password and is called out\nin its own Data Flow subsection so its three writers don't drift.\n\n## Component Breakdown\n\n| # | Component | Responsibility | Key files | FR/NFR |\n|---|-----------|-----------------|------------|--------|\n| 1 | Data Model | `User`/`AuthToken`/`AuditLog` models + `Role`/`UserStatus`/`AuthTokenType` enums, extending the existing Prisma schema | `prisma/schema.prisma` | FR-1, NFR-1, NFR-7 |\n| 2 | Credentials Auth Core | `authorize()` chokepoint (normalize email → status/lockout checks → bcrypt compare → dummy-compare branch), `/login` page, failure-messaging matrix, lockout counter mutation, same-origin `callbackUrl` guard | `src/server/auth/authorize.ts`, `src/app/(public)/login/page.tsx`, `src/lib/callback-url.ts` | FR-2, FR-3, FR-4, FR-5, FR-7, NFR-2, NFR-3 |\n| 3 | Rate Limiting | In-memory sliding-window limiter, configurable key (per-IP, or per-email+per-IP), exported for reuse | `src/server/rate-limit.ts` | FR-6, FR-17 |\n| 4 | Session / Route Guard | Auth.js config (`jwt`/`session` callbacks carrying id/role/firstName/lastName/email, 8h lifetime, `passwordChangedAt` invalidation throttled to 5-min checks), `middleware.ts` perimeter, new allowlist file | `src/server/auth/config.ts` (or `auth.ts`), `middleware.ts`, `src/config/public-routes.ts` | FR-9, FR-10, FR-11, NFR-1 |\n| 5 | Invite Flow | Token lookup by SHA-256 hash (type=INVITE, unused, 7-day expiry), accept-invite form + atomic submit (validate → hash → activate → mark-used → sign-in → redirect → audit) | `src/app/(public)/invite/[token]/page.tsx`, `src/server/services/users.ts` (accept-invite step) | FR-12, FR-13, FR-14 |\n| 6 | Password Policy | Single Zod rule set (length, letter+digit, not-email, not-common-password) exported for both server validation and the client-side live checklist — one schema, not two | `src/lib/validators/auth.ts` | FR-15, FR-16 |\n| 7 | Password Reset Flow | `/forgot-password` constant-response + rate limit, reset-token issuance (32 random bytes, 60-min expiry, invalidate prior unused reset tokens via a shared `revokeUnusedTokens(userId, type)` helper), `/reset-password/[token]` (set hash, clear lockout fields, mark used, audit, redirect) | `src/app/(public)/forgot-password/page.tsx`, `src/app/(public)/reset-password/[token]/page.tsx`, `src/server/services/users.ts` | FR-17, FR-18, FR-19 |\n| 8 | Change Password | `/account/security` form (current-password check, FR-15 policy on new password, bumps `passwordChangedAt`, re-issues current session token) | `src/app/(app)/account/security/page.tsx` | FR-20, FR-21 |\n| 9 | Service Layer | Stable exported surface for this and later PRDs: `createUser`, `createInviteToken`, `sendInvite`, `setUserStatus`, `unlockUser` | `src/server/services/users.ts` | FR-22, NFR-7 |\n| 10 | Permission Helpers | `getCurrentUser()`, `requireUser()` (throws UNAUTHENTICATED / redirects to `/login`), `requireRole(...roles)` (throws FORBIDDEN / redirects to `/forbidden`) — no generic `can()` by design | `src/server/auth/permissions.ts` | FR-23, NFR-8 |\n| 11 | Audit Logging | `audit()` insert-only helper: captures IP from `x-forwarded-for`, never throws, never logs secrets — single call site signature for FR-8/14/19 | `src/server/audit.ts` | FR-8, FR-14 (audit step), FR-19 (audit step), FR-24, NFR-1 |\n| 12 | App Shell Integration | Top-bar user menu wired to real session (name/role badge/avatar initials, sign-out), \"Account security\" menu entry, `navigation.ts` switched from placeholder to real session role | `src/app/(app)/layout.tsx` (user menu), `src/config/navigation.ts` | FR-21 (menu entry), FR-25, FR-26 |\n| 13 | Notifications Stub | `sendAuthEmail()` logs recipient/subject/link via `logger.info`; stable signature so PRD-04 can swap the implementation without touching call sites | `src/server/email/send-auth-email.ts` | FR-27 |\n| 14 | Seed Data | Seeds six ACTIVE users + one INVITED user via the Service Layer (component 9), logs the invite link via component 13 | `prisma/seed.ts` | FR-28 |\n| 15 | Design System (MUI-only) | Every new screen (`/login`, `/invite/[token]`, `/forgot-password`, `/reset-password/[token]`, `/account/security`) built from existing MUI v9 + React Hook Form + Zod resolver patterns; shared form-error pattern (`aria-live=\"polite\"`, focus-to-first-invalid-field) | reuses abcd-1's `src/components/*`, `src/theme/theme.ts` | NFR-4, NFR-5 |\n| 16 | Lint/CI Gate | No new lint rule; existing `no-restricted-imports` ESLint rule from abcd-1 continues to apply; `lint`/`typecheck`/`test` stay green, scope capped to this PRD's test list | `.eslintrc*` (unchanged) | NFR-5, NFR-8 |\n| 17 | Test Harness | Vitest unit (policy, token hash/expiry, lockout counter, rate limiter, callbackUrl guard), Vitest integration against test DB (authorize branches, accept-invite, reset-password, change-password), Playwright e2e (sign-in/out, failed-login messaging, forgot-to-reset) | `tests/**`, `tests/e2e/**` | NFR-6 |\n\nDependency order: 1 (Data Model) underlies everything. 2, 5, 7, 8 all depend\non 1 + 6 (Password Policy) + 11 (Audit) + 3 (Rate Limiting where noted). 4\n(Session/Route Guard) depends on 1 + 2 (consumes `authorize()`'s result) and\ngates 12 (App Shell) and every `(app)` page. 9 (Service Layer) is called by\n5, 7's reset-issuance, and 14 (Seed). 10 (Permission Helpers) backs up 4's\nperimeter at the page/handler level. 13 is called by 5 (seed-time invite\nlink) and 7 (reset email). 15–17 wrap all of the above.\n\n## Data Flow\n\n**Sign-in, `POST` via `signIn('credentials')` → `authorize()` (FR-2/3/4/5/7/8, NFR-2/3):**\n1. Rate limiter (component 3) checks 10 attempts/IP/5-min before any DB\n   work; over the limit short-circuits with `RATE_LIMITED` (FR-6).\n2. `authorize()` lower-cases/trims the email and looks up the `User`.\n3. Non-existent user → run the dummy bcrypt compare against a fixed hash\n   (NFR-2) anyway, then fail with the generic message (FR-4).\n4. Existing user: status ≠ ACTIVE, archived, or `lockedUntil` in the future\n   → fail with the disabled/locked message (locked message includes\n   remaining minutes) — no bcrypt compare needed here since the account\n   doesn't reach the password check per FR-4/FR-3's branch order.\n5. Otherwise bcrypt-compare (cost 12) the password.\n   - Wrong password: increment `failedLoginCount`; at 5 increments set\n     `lockedUntil = now + 15min` and reset the counter (FR-5); write\n     `auth.login.failure` (and `auth.lockout` if the threshold was just hit)\n     via `audit()` (component 11, FR-8).\n   - Correct password: reset `failedLoginCount` to 0, set `lastLoginAt`,\n     write `auth.login.success` (FR-8).\n6. On success, the `jwt` callback (component 4) stamps id/role/firstName/\n   lastName/email into the token (FR-9); the route layer validates\n   `callbackUrl` is a same-origin relative path before redirecting, else\n   falls back to `/dashboard` (FR-7).\n\n**Session validation, every request through `middleware.ts` + the `jwt`\ncallback (FR-9/10/11, NFR-1):**\n1. `middleware.ts` redirects unauthenticated `(app)` requests to\n   `/login?callbackUrl=<path>`; for `/api/*` it returns 401 JSON unless the\n   path is `/api/health`, `/api/auth/*`, or listed in\n   `src/config/public-routes.ts`.\n2. The `jwt` callback checks — at most once per 5 minutes per token, to\n   bound cost — whether `passwordChangedAt` is later than the token's issue\n   time; if so the session is invalid and re-login is forced on that\n   device.\n\n**Invite acceptance, `/invite/[token]` (FR-12/13/14):**\n1. Look up the token by its SHA-256 hash (never store/compare the raw\n   token, NFR-1); it must be type INVITE, unused, and within 7 days of\n   issuance, else show the invalid/expired state (distinct from sign-in's\n   failure messaging).\n2. Valid token renders the invited user's name/email read-only plus\n   new/confirm-password fields.\n3. Submit runs as one service-layer step in `src/server/services/users.ts`:\n   validate against the Password Policy module (component 6) → hash →\n   `status = ACTIVE`, `passwordChangedAt = now` → mark token used → sign the\n   user in → redirect to `/dashboard` → `audit('auth.invite.accepted')`.\n   These steps stay together so a failure partway doesn't leave a used\n   token with no activated account.\n\n**Forgot/reset password (FR-17/18/19, pairs with NFR-2's anti-enumeration\nintent):**\n1. `/forgot-password` always returns the same message regardless of account\n   existence; rate-limited both per-email (3/hr) and per-IP (10/hr) through\n   component 3's configurable-key limiter.\n2. For an existing ACTIVE user only: issue a PASSWORD_RESET token (32 random\n   bytes, base64url, 60-min expiry) and call `revokeUnusedTokens(userId,\n   'PASSWORD_RESET')` to invalidate older unused reset tokens for that user\n   — this invalidate-on-reissue rule is reset-specific and must not leak\n   into the invite path's token producer. Then `sendAuthEmail(user,\n   'password-reset', link)` (component 13).\n3. `/reset-password/[token]` sets the new hash and `passwordChangedAt`,\n   clears the lockout fields (`failedLoginCount`, `lockedUntil` — kept in\n   sync with FR-5's lockout field set), marks the token used, audits\n   `auth.password.reset`, redirects to `/login`.\n\n**`passwordChangedAt` — one field, three writers, one reader:** FR-19\n(reset), FR-20 (change-password), and FR-14 (invite acceptance) each write\nthis timestamp; the `jwt` callback (FR-10) is the single reader that forces\nre-login elsewhere. Change-password (FR-20) additionally re-issues the\n*current* session's token immediately after writing it, so the acting user\nisn't logged out by their own action while every other session is.\n\n**App shell integration (FR-21/25/26):** once component 4 produces a real\nsession, component 12 replaces abcd-1's placeholder user-menu slot and\n`navigation.ts`'s placeholder role with the session's real name/role/\navatar-initials and `Role` value — a wiring change against abcd-1's existing\nfilter signature, not new UI.\n\n**Seed flow (FR-28):** `prisma/seed.ts` calls `createUser`/\n`createInviteToken` (component 9, not duplicated logic) to create six\nACTIVE users and one INVITED user (shared password `SchoolHub123!`), and\nlogs the invited user's invite link through `sendAuthEmail`'s `logger.info`\npath (component 13).\n\n## Requirements Traceability\n\n| Requirement | Design Element |\n|---|---|\n| FR-1 | Component 1 — `User`/`AuthToken`/`AuditLog` + enums |\n| FR-2 | Component 2 — `/login` page (MUI form) |\n| FR-3 | Component 2 — `authorize()` |\n| FR-4 | Component 2 — failure-messaging matrix |\n| FR-5 | Component 2 — lockout counter mutation |\n| FR-6 | Component 3 — sign-in rate limit (10/IP/5min) |\n| FR-7 | Component 2 — `callbackUrl` same-origin guard |\n| FR-8 | Component 11 — `audit()` calls from `authorize()` |\n| FR-9 | Component 4 — `jwt`/`session` callbacks |\n| FR-10 | Component 4 — `passwordChangedAt` invalidation check |\n| FR-11 | Component 4 — `middleware.ts` + `public-routes.ts` |\n| FR-12 | Component 5 — invite-token lookup |\n| FR-13 | Component 5 — accept-invitation form |\n| FR-14 | Component 5 — accept-invite submit (service-layer transaction) |\n| FR-15 | Component 6 — password-policy Zod schema |\n| FR-16 | Component 6 — live strength checklist (client mirror) |\n| FR-17 | Component 7 — `/forgot-password` + rate limit |\n| FR-18 | Component 7 — reset-token issuance + `revokeUnusedTokens` |\n| FR-19 | Component 7 — `/reset-password/[token]` |\n| FR-20 | Component 8 — `/account/security` change-password form |\n| FR-21 | Component 8 + Component 12 — \"Account security\" menu entry |\n| FR-22 | Component 9 — `src/server/services/users.ts` exports |\n| FR-23 | Component 10 — `src/server/auth/permissions.ts` |\n| FR-24 | Component 11 — `audit()` helper signature |\n| FR-25 | Component 12 — top-bar user menu (real session) |\n| FR-26 | Component 12 — `navigation.ts` real role wiring |\n| FR-27 | Component 13 — `sendAuthEmail()` stub |\n| FR-28 | Component 14 — `prisma/seed.ts` |\n| NFR-1 | Component 1 + 4 + 11 — hash-only tokens, constant-time compare, HttpOnly/Secure/SameSite cookies, Auth.js CSRF |\n| NFR-2 | Component 2 — dummy bcrypt-compare branch |\n| NFR-3 | Component 2 — p95 < 1s budget at cost 12 |\n| NFR-4 | Component 15 — shared form-error pattern (all 5 auth forms) |\n| NFR-5 | Component 15 + 16 — MUI-only enforcement, existing ESLint rule |\n| NFR-6 | Component 17 — Vitest unit/integration + Playwright e2e |\n| NFR-7 | Component 1 + 9 + 10 + 11 — brownfield reuse of abcd-1 conventions |\n| NFR-8 | Component 16 — lint/typecheck/test gate, scope cap |\n\n## Status\n\nComplete. All 28 FR ids and 8 NFR ids are accounted for above; none were\ndropped. FR-11 and FR-26 carry forward intake's MEDIUM-confidence notes\n(new `public-routes.ts` file; assumed-compatible `navigation.ts` signature)\nfor `arch-api-contracts` and dev-planning to verify against the real\nabcd-1 code rather than treat as settled. No blockers to carry forward —\n`arch-api-contracts` can proceed to deriving the API surface (the `/login`,\n`/invite/[token]`, `/forgot-password`, `/reset-password/[token]`, and\n`/account/security` form-submission endpoints, plus Auth.js's own\n`/api/auth/*` routes).\n","userModified":false}}
