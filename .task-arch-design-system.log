{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LDAe25YEGvGF4nFYxUh9aP","type":"tool_result","content":"import * as React from 'react';\nimport { Button, Section, Text } from '@react-email/components';\nimport { BaseLayout, buttonStyle, textStyle, type EmailSchool } from './BaseLayout';\n\nexport interface GenericNotificationData {\n  title: string;\n  body?: string | null;\n  /** Safe relative path; the CTA points at APP_URL + link. */\n  link?: string | null;\n  ctaLabel?: string;\n}\n\n/** FR-15: title, body (plain text, pre-line), CTA to APP_URL + link. */\nexport function GenericNotification({\n  school,\n  appUrl,\n  data,\n}: {\n  school: EmailSchool;\n  appUrl: string;\n  data: GenericNotificationData;\n}) {\n  return (\n    <BaseLayout school={school} appUrl={appUrl} preview={data.title}>\n      <Text style={{ ...textStyle, fontSize: 16, fontWeight: 700 }}>{data.title}</Text>\n./.task-arch-research-stack.log\n./17-fees.md\n./12-announcements.md\n./03-user-management.md\n./.task-dev-main.log\n./06-timetable.md\n./10-quizzes.md\n./18-public-site-admissions.md\n./07-attendance.md\n./00-foundation.md\n578:model FileObject {\n579-  id                    String                 @id @default(cuid())\n580-  ownerId               String\n581-  owner                 User                   @relation(fields: [ownerId], references: [id])\n582-  originalName          String\n583-  mimeType              String\n584-  sizeBytes             Int\n585-  storageKey            String                 @unique\n586-  sha256                String\n587-  context               String\n588-  contextId             String?\n589-  createdAt             DateTime               @default(now())\n590-  lessonAttachments     LessonAttachment[]\n591-  assignmentAttachments AssignmentAttachment[]\n592-  submissionFiles       SubmissionFile[]\n593-\n594-  @@index([context, contextId])\n595-}\n596-\n597-enum ContentStatus {\n598-  DRAFT","is_error":false}]},"parent_tool_u