s":1391,"type":"result","duration_ms":155727,"uuid":"8f633c30-10ca-40e7-8505-75dd5632ef0e","ttft_stream_ms":913,"time_to_request_ms":108,"first_content_frame_ms":914,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":18,"outputTokens":17463,"cacheReadInputTokens":432579,"cacheCreationInputTokens":65768,"webSearchRequests":0,"costUSD":0.8067418000000001,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":883,"cacheCreationEphemeral5mInputTokens":51750,"cacheCreationEphemeral1hInputTokens":14018,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
