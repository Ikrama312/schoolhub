{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0149oq5sduta4P1vXsxKxZ7r","type":"tool_result","content":"export const INVITE_TTL = { days: 7 } as const;\n\nexport function hashToken(raw: string): string {\n  return createHash('sha256').update(raw).digest('hex');\n}\n\n/** Invalidates the user's older unused tokens of `type`, then issues a new one. Returns the raw token. */\nexport async function createToken(\n  userId: string,\n  type: AuthTokenType,\n  ttl: { minutes?: number; days?: number },\n  tx?: Tx,\n): Promise<string> {\n  const raw = randomBytes(32).toString('base64url');\n  const now = new Date();\n  const ttlMs = ((ttl.days ?? 0) * 24 * 60 + (ttl.minutes ?? 0)) * 60_000;\n\n  const run = async (client: Tx) => {\n    await client.authToken.updateMany({ where: { userId, type, usedAt: null }, data: { usedAt: now } });\n    await client.authToken.create({\n      data: { userId, type, tokenHash: hashToken(raw), expiresAt: new Date(now.getTime() + ttlMs) },\n    });\n  };\n  if (tx) await run(tx);\n  else await prisma.$transaction(run);\n  return raw;\n}\n{\"invite\":\"15xB767rhzabcmIikoNqtWqAbL93KyqSyLmqzDv7Hos\",\"reset\":\"Q0ijkE-qAtOtNDdXbWp8gsj4M3FL83ic65cUwvtc2eo\"}","is_error":false}]},"parent_tool_use_id":null,"session_id":"fec0918a-90f0-4d65-82e8-8c5873335661","uuid":"a6df9a46-c8b3-457c-a695-2b8bc3d817fd","timestamp":"2026-11-05T17:16:16.824Z","tool_use_result":{"stdout":"export const INVITE_TTL = { days: 7 } as const;\n\nexport function hashToken(raw: string): string {\n  return createHash('sha256').update(raw).digest('hex');\n}\n\n/** Invalidates the user's older unused tokens of `type`, then issues a new one. Returns the raw token. */\nexport async function createToken(\n  userId: string,\n  type: AuthTokenType,\n  ttl: { minutes?: number; days?: number },\n  tx?: Tx,\n): Promise<string> {\n  const raw = randomBytes(32).toString('base64url');\n  const now = new Date();\n  const ttlMs = ((ttl.days ?? 0) * 24 * 60 + (ttl.minutes ?? 0)) * 60_000;\n\n  const run = async (client: Tx) => {\n    await client.authToken.updateMany({ where: { userId, type, usedAt: null }, data: { usedAt: now } });\n    await client.authToken.create({\n      data: { userId, type, tokenHash: hashToken(raw), expiresAt: new Date(now.getTime() + ttlMs) },\n    });\n  };\n  if (tx) await run(tx);\n  else await prisma.$transaction(run);\n  return raw;\n}\n{\"invite\":\"15xB767rhzabcmIikoNqtWqAbL93KyqSyLmqzDv7Hos\",\"reset\":\"Q0ijkE-qAtOtNDdXbWp8gsj4M3FL83ic65cUwvtc2eo\"}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0149oq5sduta4P1vXsxKxZ7r","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
