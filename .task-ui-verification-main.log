{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LDUfeKCzBsdxeze8d6G4TV","type":"tool_result","content":"import Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { prisma } from '@/server/db';\nimport { getSchoolSettings } from '@/server/services/settings';\nimport { getAttendanceSettings, getBelowThreshold, getOverview } from '@/server/attendance/attendance-service';\nimport { schoolToday } from '@/server/attendance/attendance-rules';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { AdminAttendanceClient } from './AdminAttendanceClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /admin/attendance — ADMIN (FR-5, FR-30 to FR-33). */\nexport default async function AdminAttendancePage() {\n  await requirePageRole('ADMIN');\n  const { timezone } = await getSchoolSettings();\n  const today = schoolToday(new Date(), timezone);\n  const current = { academicYear: { isCurrent: true } };\n  const [overview, below, settings, gradeLevels, sections, courses] = await Promise.all([\n    getOverview(),\n    getBelowThreshold(),\n    getAttendanceSettings(),\n    prisma.gradeLevel.findMany({ where: { archivedAt: null }, select: { id: true, name: true }, orderBy: { order: 'asc' } }),\n    prisma.section.findMany({ where: current, select: { id: true, name: true }, orderBy: { name: 'asc' } }),\n    prisma.course.findMany({ where: { ...current, archivedAt: null }, select: { id: true, name: true }, orderBy: { name: 'asc' } }),\n  ]);\n\n  return (\n    <Box>\n      <PageHeader title=\"Attendance\" description=\"Today's registers, reports and settings\" />\n      <AdminAttendanceClient\n        overview={overview}\n        below={below}\n        settings={settings}\n        options={{ gradeLevels, sections, courses }}\n        today={today}\n        monthStart={`${today.slice(0, 8)}01`}\n      />\n    </Box>\n  );\n}\nsrc/config/course-tabs.ts:17:  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\nsrc/config/navigation.ts:34:  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\nsrc/config/navigation.ts:35:  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\nsrc/config/student-tabs.ts:13:  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\nPER_PERIOD|America/New_York","is_error":false}]},"parent_tool_use_id":null,"session_id":"b0d33c40-44ea-44a6-8793-0fcbf67c071f","uuid":"637b0e91-f5b9-4081-ae3d-f0ffb6b18eb2","timestamp":"2026-11-06T06:16:36.987Z","tool_use_result":{"stdout":"import Box from '@mui/material/Box';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { prisma } from '@/server/db';\nimport { getSchoolSettings } from '@/server/services/settings';\nimport { getAttendanceSettings, getBelowThreshold, getOverview } from '@/server/attendance/attendance-service';\nimport { schoolToday } from '@/server/attendance/attendance-rules';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { AdminAttendanceClient } from './AdminAttendanceClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /admin/attendance — ADMIN (FR-5, FR-30 to FR-33). */\nexport default async function AdminAttendancePage() {\n  await requirePageRole('ADMIN');\n  const { timezone } = await getSchoolSettings();\n  const today = schoolToday(new Date(), timezone);\n  const current = { academicYear: { isCurrent: true } };\n  const [overview, below, settings, gradeLevels, sections, courses] = await Promise.all([\n    getOverview(),\n    getBelowThreshold(),\n    getAttendanceSettings(),\n    prisma.gradeLevel.findMany({ where: { archivedAt: null }, select: { id: true, name: true }, orderBy: { order: 'asc' } }),\n    prisma.section.findMany({ where: current, select: { id: true, name: true }, orderBy: { name: 'asc' } }),\n    prisma.course.findMany({ where: { ...current, archivedAt: null }, select: { id: true, name: true }, orderBy: { name: 'asc' } }),\n  ]);\n\n  return (\n    <Box>\n      <PageHeader title=\"Attendance\" description=\"Today's registers, reports and settings\" />\n      <AdminAttendanceClient\n        overview={overview}\n        below={below}\n        settings={settings}\n        options={{ gradeLevels, sections, courses }}\n        today={today}\n        monthStart={`${today.slice(0, 8)}01`}\n      />\n    </Box>\n  );\n}\nsrc/config/course-tabs.ts:17:  { key: 'attendance', label: 'Attendance', href: (id) => `/courses/${id}/attendance`, roles: ['TEACHER', 'ADMIN'] },\nsrc/config/navigation.ts:34:  { label: 'Attendance', href: '/attendance/take', icon: FactCheckOutlinedIcon, roles: ['TEACHER'] },\nsrc/config/navigation.ts:35:  { label: 'Attendance', href: '/admin/attendance', icon: FactCheckOutlinedIcon, roles: ['ADMIN'] },\nsrc/config/student-tabs.ts:13:  { key: 'attendance', label: 'Attendance', href: (id) => `/students/${id}/attendance`, roles: ALL_ROLES },\nPER_PERIOD|America/New_York","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LDUfeKCzBsdxeze8d6G4TV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
