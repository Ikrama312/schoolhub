{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N8puiLwxFLoGFm3UhBCpag","type":"tool_result","content":"60\t\n61\tinterface MenuActions {\n62\t  items: Map<string, Item>;\n63\t  toggleVisible: (item: Item) => void;\n64\t  markMissing: (item: Item) => void;\n65\t  showStats: (item: Item) => void;\n66\t}\n67\tconst MenuContext = createContext<MenuActions | null>(null);\n68\t\n69\t/** FR-24 column menu: hide/show to students, set ungraded to missing, statistics. */\n70\tfunction GradebookColumnMenu(props: GridColumnMenuProps) {\n71\t  const actions = useContext(MenuContext);\n72\t  const item = actions?.items.get(props.colDef.field);\n73\t  if (!actions || !item) return <GridColumnMenu {...props} />;\n74\t  const pastDue = !!item.dueAt && new Date(item.dueAt).getTime() < Date.now();\n75\t  const run = (fn: (i: Item) => void) => (e: React.MouseEvent) => {\n76\t    props.hideMenu(e);\n77\t    fn(item);\n78\t  };\n79\t  return (\n80\t    <GridColumnMenu\n81\t      {...props}\n82\t      slots={{\n83\t        columnMenuVisibilityItem: () => (\n84\t          <MenuItem onClick={run(actions.toggleVisible)}>\n85\t            <ListItemIcon>{item.isVisible ? <VisibilityOffOutlinedIcon fontSize=\"small\" /> : <VisibilityOutlinedIcon fontSize=\"small\" />}</ListItemIcon>\n86\t            <ListItemText>{item.isVisible ? 'Hide from students' : 'Show to students'}</ListItemText>\n87\t          </MenuItem>\n88\t        ),\n89\t        columnMenuMissingItem: () => (\n90\t          <MenuItem onClick={run(actions.markMissing)} disabled={!pastDue}>\n91\t            <ListItemIcon>\n92\t              <RuleIcon fontSize=\"small\" />\n93\t            </ListItemIcon>\n94\t            <ListItemText secondary={pastDue ? undefined : 'After the due date'}>Set ungraded to missing</ListItemText>\n95\t          </MenuItem>\n96\t        ),\n97\t        columnMenuStatsItem: () => (\n98\t          <MenuItem onClick={run(actions.showStats)}>\n99\t            <ListItemIcon>\n100\t              <BarChartIcon fontSize=\"small\" />\n101\t            </ListItemIcon>\n102\t            <ListItemText>Item statistics</ListItemText>\n103\t          </MenuItem>\n104\t        ),\n105\t      }}\n106\t      slotProps={{ columnMenuVisibilityItem: { displayOrder: 1 }, columnMenuMissingItem: { displayOrder: 2 }, columnMenuStatsItem: { displayOrder: 3 } }}\n107\t    />\n108\t  );\n109\t}\n110\t\n111\tfunction cellText(c: Cell) {\n112\t  if (c.excused) return 'EX';\n113\t  if (c.score !== null) return pts(c.score);\n114\t  if (c.missing) return 'M';\n115\t  return '—';\n116\t}\n117\t\n118\texport function GradebookGrid({ initial, timezone }: { initial: GradebookPayload; timezone: string }) {\n119\t  const router = useRouter();\n120\t  const { showToast } = useToast();\n121\t  const [data, setData] = useState(initial);\n122\t  const [cellErrors, setCellErrors] = useState<Record<string, string>>({});\n123\t  const [addOpen, setAddOpen] = useState(false);\n124\t  const [stats, setStats] = useState<Item | null>(null);\n125\t  const [override, setOverride] = useState<Row | null>(null);\n126\t  const courseId = data.course.id;\n127\t\n128\t  const reload = useCallback(\n129\t    async (termId = data.term.id) => {\n130\t      const res = await fetch(`/api/courses/${courseId}/gradebook?termId=${encodeURIComponent(termId)}`);\n131\t      const json = await res.json().catch(() => ({}));\n132\t      if (!res.ok) return showToast({ message: json?.error?.message ?? 'Could not load the gradebook.', severity: 'error' });\n133\t      setData(json.data);\n134\t      setCellErrors({});\n135\t    },\n136\t    [courseId, data.term.id, showToast],\n137\t  );\n138\t\n139\t  const patchRow = (studentId: string, fn: (r: Row) => Row) => setData((d) => ({ ...d, rows: d.rows.map((r) => (r.student.id === studentId ? fn(r) : r)) }));\n140\t\n141\t  /** Optimistic single-cell save (FR-20). */\n142\t  const saveCell = useCallback(\n143\t    async (studentId: string, item: Item, body: { score?: string | null; excused?: boolean; missing?: boolean }) => {\n144\t      const key = `${studentId}:${item.id}`;\n145\t      const prev = data.rows.find((r) => r.student.id === studentId)?.cells[item.id];\n146\t      if (!prev) return;\n147\t      patchRow(studentId, (r) => ({ ...r, cells: { ...r.cells, [item.id]: { ...prev, ...body } } }));\n148\t      setCellErrors(({ [key]: _gone, ...rest }) => rest);\n149\t      const res = await fetch(`/api/grade-items/${item.id}/grades/${studentId}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });\n150\t      const json = await res.json().catch(() => ({}));\n151\t      if (!res.ok) {\n152\t        const message = json?.error?.message ?? 'Could not save.';\n153\t        patchRow(studentId, (r) => ({ ...r, cells: { ...r.cells, [item.id]: prev } }));\n154\t        setCellErrors((e) => ({ ...e, [key]: message }));\n155\t        showToast({ message, severity: 'error' });\n156\t        return;\n157\t      }\n158\t      patchRow(studentId, (r) => ({ ...r, cells: { ...r.cells, [item.id]: { ...r.cells[item.id], ...json.data.grade } }, result: json.data.result }));\n159\t    },\n160\t    [data.rows, showToast],\n161\t  );\n162\t\n163\t  const items = useMemo(() => new Map(data.items.map((i) => [i.id, i])), [data.items]);\n164\t  const menuActions: MenuActions = useMemo(\n165\t    () => ({\n166\t      items,\n167\t      showStats: setStats,\n168\t      toggleVisible: async (item) => {\n169\t        const res = await fetch(`/api/grade-items/${item.id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ isVisible: !item.isVisible }) });\n170\t        const json = await res.json().catch(() => ({}));\n171\t        if (!res.ok) return showToast({ message: json?.error?.message ?? 'Could not update the item.', severity: 'error' });\n172\t        showToast({ message: item.isVisible ? 'Hidden from students' : 'Shown to students', severity: 'success' });\n173\t        await reload();\n174\t      },\n175\t      markMissing: async (item) => {\n176\t        const res = await fetch(`/api/grade-items/${item.id}/mark-missing`, { method: 'POST' });\n177\t        const json = await res.json().catch(() => ({}));\n178\t        if (!res.ok) return showToast({ message: json?.error?.message ?? 'Could not mark missing.', severity: 'error' });\n179\t        showToast({ message: `${json.data.updatedCount} marked missing`, severity: 'success' });\n180\t        await reload();\n181\t      },\n182\t    }),\n183\t    [items, reload, showToast],\n184\t  );\n185\t\n186\t  const catResult = (r: StudentTermResult, id: string | null) => r.categories.find((c) => c.id === id)?.percent ?? null;\n187\t  const hasUncategorised = data.rows.some((r) => r.result.categories.some((c) => c.id === null));\n188\t\n189\t  const columns: GridColDef<GridRow>[] = useMemo(() => {\n190\t    const itemCols: GridColDef<GridRow>[] = data.items.map((item) => {\n191\t      const Icon = SOURCE_ICON[item.source];\n192\t      return {\n193\t        field: item.id,\n194\t        type: 'number',\n195\t        width: 120,\n196\t        sortable: false,\n197\t        editable: true,\n198\t        headerAlign: 'center',\n199\t        align: 'center',\n200\t        description: `${item.title} — ${SOURCE_LABEL[item.source]}${item.isVisible ? '' : ' (hidden from students)'}`,\n201\t        valueGetter: (_v, row) => {\n202\t          const s = (row.cells as Row['cells'])[item.id]?.score;\n203\t          return s === null || s === undefined ? null : Number(s);\n204\t        },\n205\t        renderHeader: () => (\n206\t          <Stack sx={{ lineHeight: 1.2, py: 0.5, opacity: item.isVisible ? 1 : 0.6, minWidth: 0 }}>\n207\t            <Stack direction=\"row\" spacing={0.5} sx={{ alignItems: 'center', minWidth: 0 }}>\n208\t              <Icon fontSize=\"inherit\" aria-label={SOURCE_LABEL[item.source]} />\n209\t              {!item.isVisible && <VisibilityOffOutlinedIcon fontSize=\"inherit\" aria-label=\"Hidden from students\" />}\n210\t              <Typography variant=\"caption\" sx={{ fontWeight: 600 }} noWrap>\n211\t                {item.title}\n212\t              </Typography>\n213\t            </Stack>\n214\t            <Typography variant=\"caption\" color=\"text.secondary\" noWrap>\n215\t              {item.dueAt ? formatInSchoolTz(item.dueAt, 'd MMM', timezone) : 'No date'} · /{pts(item.maxPoints)}\n216\t            </Typography>\n217\t          </Stack>\n218\t        ),\n219\t        renderCell: ({ row }) => {\n220\t          const cell = (row.cells as Row['cells'])[item.id];\n221\t          const err = cellErrors[`${row.id}:${item.id}`];\n222\t          const text = cellText(cell);\n223\t          return (\n224\t            <Tooltip title={err ?? cell.comment ?? ''}>\n225\t              <Box\n226\t                sx={{ width: '100%', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 0.5, color: text === 'M' ? 'error.main' : undefined, fontWeight: text === 'M' ? 700 : undefined, outline: err ? '2px solid' : undefined, outlineColor: 'error.main' }}\n227\t                data-testid={`cell-${row.id}-${item.id}`}\n228\t              >\n229\t                {text}\n230\t                {cell.isLate && <AccessTimeIcon fontSize=\"inherit\" aria-label=\"Late\" />}\n231\t              </Box>\n232\t            </Tooltip>\n233\t          );\n234\t        },\n235\t      };\n236\t    });\n237\t\n238\t    const catCol = (id: string | null, name: string): GridColDef<GridRow> => ({\n239\t      field: `cat:${id ?? 'none'}`,\n240\t      headerName: `${name} %`,\n241\t      width: 120,\n242\t      sortable: false,\n243\t      align: 'center',\n244\t      headerAlign: 'center',\n245\t      valueGetter: (_v, row) => catResult(row.result as StudentTermResult, id) ?? '—',\n246\t    });\n247\t\n248\t    return [\n249\t      {\n250\t        field: 'name',\n251\t        headerName: 'Student',\n252\t        width: 200,\n253\t        renderCell: ({ row }) => (\n254\t          <Stack direction=\"row\" sx={{ alignItems: 'center', width: '100%' }}>\n255\t            <Typography variant=\"body2\" noWrap sx={{ flex: 1 }}>\n256\t              {row.name}\n257\t            </Typography>\n258\t            <Tooltip title=\"Override term grade / comment\">\n259\t              <IconButton size=\"small\" aria-label={`Override term grade for ${row.name}`} onClick={() => setOverride(data.rows.find((r) => r.student.id === row.id) ?? null)}>\n260\t                <TuneIcon fontSize=\"inherit\" />\n261\t              </IconButton>\n262\t            </Tooltip>\n263\t          </Stack>\n264\t        ),\n265\t      },\n266\t      ...itemCols,\n267\t      ...data.categories.map((c) => catCol(c.id, c.name)),\n268\t      ...(hasUncategorised ? [catCol(null, 'Uncategorised')] : []),\n269\t      {\n270\t        field: 'term',\n271\t        headerName: 'Term',\n272\t        width: 130,\n273\t        sortable: false,\n274\t        align: 'center',\n275\t        headerAlign: 'center',\n276\t        renderCell: ({ row }) => {\n277\t          const r = row.result as StudentTermResult;\n278\t          return (\n279\t            <Typography variant=\"body2\" sx={{ fontWeight: 700 }} data-testid={`term-${row.id}`}>\n280\t              {r.percent === null ? '—' : `${r.percent}% ${r.letter ?? ''}`}\n281\t              {r.overridden ? ' *' : ''}\n282\t            </Typography>\n283\t          );\n284\t        },\n285\t      },\n286\t    ];\n287\t  }, [data.items, data.categories, data.rows, cellErrors, hasUncategorised, timezone]);\n288\t\n289\t  const grouping: GridColumnGroupingModel = useMemo(() => {\n290\t    const known = new Set(data.categories.map((c) => c.id));\n291\t    const groups = data.categories.map((c) => ({ groupId: c.id, headerName: `${c.name} (${pts(c.weightPercent)}%)`, children: data.items.filter((i) => i.categoryId === c.id).map((i) => ({ field: i.id })) }));\n292\t    const loose = data.items.filter((i) => !i.categoryId || !known.has(i.categoryId)).map((i) => ({ field: i.id }));\n293\t    if (loose.length) groups.push({ groupId: 'uncategorised', headerName: 'Uncategorised', children: loose });\n294\t    groups.push({ groupId: 'averages', headerName: 'Averages', children: [...data.categories.map((c) => ({ field: `cat:${c.id}` })), ...(hasUncategorised ? [{ field: 'cat:none' }] : []), { field: 'term' }] });\n295\t    return groups.filter((g) => g.children.length);\n296\t  }, [data.categories, data.items, hasUncategorised]);\n297\t\n298\t  const gridRows: GridRow[] = useMemo(\n299\t    () => data.rows.map((r) => ({ id: r.student.id, name: `${r.student.lastName}, ${r.student.firstName}`, cells: r.cells, result: r.result })),\n300\t    [data.rows],\n301\t  );\n302\t\n303\t  const onCellKeyDown: GridEventListener<'cellKeyDown'> = (params, event) => {\n304\t    const item = items.get(params.field);\n305\t    if (!item || item.source !== 'MANUAL' || params.cellMode !== 'view') return;\n306\t    const k = event.key;\n307\t    let body: { score: null; excused: boolean; missing: boolean } | null = null;\n308\t    if (k === 'e' || k === 'E') body = { score: null, excused: true, missing: false };\n309\t    else if (k === 'm' || k === 'M') body = { score: null, excused: false, missing: true };\n310\t    else if (k === 'Delete' || k === 'Backspace') body = { score: null, excused: false, missing: false };\n311\t    if (!body) return;\n312\t    event.defaultMuiPrevented = true;\n313\t    event.preventDefault();\n314\t    void saveCell(String(params.id), item, body);\n315\t  };\n316\t\n317\t  const processRowUpdate = (newRow: GridRow, oldRow: GridRow) => {\n318\t    for (const item of data.items) {\n319\t      // Only the edited field is set on newRow; every other value comes from valueGetter.\n320\t      if (!Object.prototype.hasOwnProperty.call(newRow, item.id)) continue;\n321\t      const next = newRow[item.id] as number | null;\n322\t      const prev = (oldRow.cells as Row['cells'])[item.id]?.score;\n323\t      const prevNum = prev === null || prev === undefined ? null : Number(prev);\n324\t      if (next === prevNum) continue;\n325\t      if (next === null || Number.isNaN(next)) {\n326\t        void saveCell(newRow.id, item, { score: null, excused: false, missing: false });\n327\t      } else if (next < 0 || next > Number(item.maxPoints)) {\n328\t        const key = `${newRow.id}:${item.id}`;\n329\t        setCellErrors((e) => ({ ...e, [key]: `Enter 0–${pts(item.maxPoints)}` }));\n330\t        showToast({ message: `Score must be between 0 and ${pts(item.maxPoints)}.`, severity: 'error' });\n331\t        return oldRow;\n332\t      } else {\n333\t        void saveCell(newRow.id, item, { score: String(Math.round(next * 100) / 100), excused: false, missing: false });\n334\t      }\n335\t    }\n336\t    return oldRow; // state is owned by saveCell (optimistic), the grid re-reads it from rows\n337\t  };\n338\t\n339\t  const onCellClick: GridEventListener<'cellClick'> = (params) => {\n340\t    const item = items.get(params.field);\n341\t    if (!item || item.source === 'MANUAL' || !item.sourceId) return;\n342\t    const cell = (params.row.cells as Row['cells'])[item.id];\n343\t    if (item.source === 'ASSIGNMENT') router.push(`/courses/${courseId}/assignments/${item.sourceId}/grade?studentId=${params.id}`);\n344\t    else if (cell.attemptId) router.push(`/quizzes/${item.sourceId}/attempts/${cell.attemptId}`);\n345\t  };\n346\t\n347\t  const csvHref = `/api/courses/${courseId}/gradebook?termId=${encodeURIComponent(data.term.id)}&format=csv`;\n348\t  const letters = data.scale?.bands.map((b) => b.letter) ?? [];\n349\t\n350\t  return (\n351\t    <Stack spacing={2}>\n352\t      <Stack direction={{ xs: 'column', sm: 'row' }} spacing={1} sx={{ alignItems: { sm: 'center' } }}>\n353\t        <TextField select size=\"small\" label=\"Term\" value={data.term.id} onChange={(e) => void reload(e.target.value)} sx={{ minWidth: 200 }}>\n354\t          {data.terms.map((t) => (\n355\t            <MenuItem key={t.id} value={t.id}>\n356\t              {t.name}\n357\t              {t.isCurrent ? ' (current)' : ''}\n358\t            </MenuItem>\n359\t          ))}\n360\t        </TextField>\n361\t        <Box sx={{ flex: 1 }} />\n362\t        <Button startIcon={<AddIcon />} variant=\"contained\" onClick={() => setAddOpen(true)}>\n363\t          Add manual item\n364\t        </Button>\n365\t        <Button startIcon={<DownloadIcon />} component=\"a\" href={csvHref}>\n366\t          Export CSV\n367\t        </Button>\n368\t        <Button startIcon={<SettingsOutlinedIcon />} component={NextLink} href={`/courses/${courseId}/gradebook/settings`}>\n369\t          Settings\n370\t        </Button>\n371\t      </Stack>\n372\t      <Typography variant=\"body2\" color=\"text.secondary\">\n373\t        Scale: {data.scale?.name ?? 'none set'}. Manual cells: type a score, E = excused, M = missing, Delete = clear. Click a synced score to open its source. * = overridden.\n374\t      </Typography>\n375\t      <MenuContext.Provider value={menuActions}>\n376\t        <Box sx={{ height: '70vh', minHeight: 360 }}>\n377\t          <DataGrid\n378\t            rows={gridRows}\n379\t            columns={columns}\n380\t            columnGroupingModel={grouping}\n381\t            columnHeaderHeight={64}\n382\t            isCellEditable={(p) => items.get(p.field)?.source === 'MANUAL'}\n383\t            processRowUpdate={processRowUpdate}\n384\t            onProcessRowUpdateError={(e) => showToast({ message: e instanceof Error ? e.message : 'Could not save.', severity: 'error' })}\n385\t            onCellKeyDown={onCellKeyDown}\n386\t            onCellClick={onCellClick}\n387\t            slots={{ columnMenu: GradebookColumnMenu }}\n388\t            disableRowSelectionOnClick\n389\t            hideFooter\n390\t            aria-label={`Gradebook for ${data.course.name}, ${data.term.name}`}\n391\t          />\n392\t        </Box>\n393\t      </MenuContext.Provider>\n394\t\n395\t      <AddManualItemDialog\n396\t        open={addOpen}\n397\t        courseId={courseId}\n398\t        timezone={timezone}\n399\t        categories={data.categories}\n400\t        terms={data.terms}\n401\t        defaultTermId={data.term.id}\n402\t        onClose={() => setAddOpen(false)}\n403\t        onCreated={() => {\n404\t          setAddOpen(false);\n405\t          showToast({ message: 'Item added', severity: 'success' });\n406\t          void reload();\n407\t        }}\n408\t      />\n409\t      {stats && <ItemStatsDialog title={stats.title} item={stats} cells={data.rows.map((r) => r.cells[stats.id])} onClose={() => setStats(null)} />}\n410\t      {override && (\n411\t        <TermOverrideDialog\n412\t          courseId={courseId}\n413\t          termId={data.term.id}\n414\t          student={override.student}\n415\t          result={override.result}\n416\t          letters={letters}\n417\t          onClose={() => setOverride(null)}\n418\t          onSaved={(result) => {\n419\t            patchRow(override.student.id, (r) => ({ ...r, result }));\n420\t            setOverride(null);\n421\t            showToast({ message: 'Term grade saved', severity: 'success' });\n422\t          }}\n423\t        />\n424\t      )}\n425\t    </Stack>\n426\t  );\n427\t}\n428\t"}]},"parent_tool_use_id":null,"session_id":"95715b00-b89d-488d-810b-cf963fb0733f","uuid":"57907a8e-5733-4608-b1b8-f68c864ec32d","timestamp":"2026-11-09T14:43:41.038Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ikramaansari/Documents/React Projects/schoolhub/src/components/gradebook/GradebookGrid.tsx","content":"\ninterface MenuActions {\n  items: Map<string, Item>;\n  toggleVisible: (item: Item) => void;\n  markMissing: (item: Item) => void;\n  showStats: (item: Item) => void;\n}\nconst MenuContext = createContext<MenuActions | null>(null);\n\n/** FR-24 column menu: hide/show to students, set ungraded to missing, statistics. */\nfunction GradebookColumnMenu(props: GridColumnMenuProps) {\n  const actions = useContext(MenuContext);\n  const item = actions?.items.get(props.colDef.field);\n  if (!actions || !item) return <GridColumnMenu {...props} />;\n  const pastDue = !!item.dueAt && new Date(item.dueAt).getTime() < Date.now();\n  const run = (fn: (i: Item) => void) => (e: React.MouseEvent) => {\n    props.hideMenu(e);\n    fn(item);\n  };\n  return (\n    <GridColumnMenu\n      {...props}\n      slots={{\n        columnMenuVisibilityItem: () => (\n          <MenuItem onClick={run(actions.toggleVisible)}>\n            <ListItemIcon>{item.isVisible ? <VisibilityOffOutlinedIcon fontSize=\"small\" /> : <VisibilityOutlinedIcon fontSize=\"small\" />}</ListItemIcon>\n            <ListItemText>{item.isVisible ? 'Hide from students' : 'Show to students'}</ListItemText>\n          </MenuItem>\n        ),\n        columnMenuMissingItem: () => (\n          <MenuItem onClick={run(actions.markMissing)} disabled={!pastDue}>\n            <ListItemIcon>\n              <RuleIcon fontSize=\"small\" />\n            </ListItemIcon>\n            <ListItemText secondary={pastDue ? undefined : 'After the due date'}>Set ungraded to missing</ListItemText>\n          </MenuItem>\n        ),\n        columnMenuStatsItem: () => (\n          <MenuItem onClick={run(actions.showStats)}>\n            <ListItemIcon>\n              <BarChartIcon fontSize=\"small\" />\n            </ListItemIcon>\n            <ListItemText>Item statistics</ListItemText>\n          </MenuItem>\n        ),\n      }}\n      slotProps={{ columnMenuVisibilityItem: { displayOrder: 1 }, columnMenuMissingItem: { displayOrder: 2 }, columnMenuStatsItem: { displayOrder: 3 } }}\n    />\n  );\n}\n\nfunction cellText(c: Cell) {\n  if (c.excused) return 'EX';\n  if (c.score !== null) return pts(c.score);\n  if (c.missing) return 'M';\n  return '—';\n}\n\nexport function GradebookGrid({ initial, timezone }: { initial: GradebookPayload; timezone: string }) {\n  const router = useRouter();\n  const { showToast } = useToast();\n  const [data, setData] = useState(initial);\n  const [cellErrors, setCellErrors] = useState<Record<string, string>>({});\n  const [addOpen, setAddOpen] = useState(false);\n  const [stats, setStats] = useState<Item | null>(null);\n  const [override, setOverride] = useState<Row | null>(null);\n  const courseId = data.course.id;\n\n  const reload = useCallback(\n    async (termId = data.term.id) => {\n      const res = await fetch(`/api/courses/${courseId}/gradebook?termId=${encodeURIComponent(termId)}`);\n      const json = await res.json().catch(() => ({}));\n      if (!res.ok) return showToast({ message: json?.error?.message ?? 'Could not load the gradebook.', severity: 'error' });\n      setData(json.data);\n      setCellErrors({});\n    },\n    [courseId, data.term.id, showToast],\n  );\n\n  const patchRow = (studentId: string, fn: (r: Row) => Row) => setData((d) => ({ ...d, rows: d.rows.map((r) => (r.student.id === studentId ? fn(r) : r)) }));\n\n  /** Optimistic single-cell save (FR-20). */\n  const saveCell = useCallback(\n    async (studentId: string, item: Item, body: { score?: string | null; excused?: boolean; missing?: boolean }) => {\n      const key = `${studentId}:${item.id}`;\n      const prev = data.rows.find((r) => r.student.id === studentId)?.cells[item.id];\n      if (!prev) return;\n      patchRow(studentId, (r) => ({ ...r, cells: { ...r.cells, [item.id]: { ...prev, ...body } } }));\n      setCellErrors(({ [key]: _gone, ...rest }) => rest);\n      const res = await fetch(`/api/grade-items/${item.id}/grades/${studentId}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });\n      const json = await res.json().catch(() => ({}));\n      if (!res.ok) {\n        const message = json?.error?.message ?? 'Could not save.';\n        patchRow(studentId, (r) => ({ ...r, cells: { ...r.cells, [item.id]: prev } }));\n        setCellErrors((e) => ({ ...e, [key]: message }));\n        showToast({ message, severity: 'error' });\n        return;\n      }\n      patchRow(studentId, (r) => ({ ...r, cells: { ...r.cells, [item.id]: { ...r.cells[item.id], ...json.data.grade } }, result: json.data.result }));\n    },\n    [data.rows, showToast],\n  );\n\n  const items = useMemo(() => new Map(data.items.map((i) => [i.id, i])), [data.items]);\n  const menuActions: MenuActions = useMemo(\n    () => ({\n      items,\n      showStats: setStats,\n      toggleVisible: async (item) => {\n        const res = await fetch(`/api/grade-items/${item.id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ isVisible: !item.isVisible }) });\n        const json = await res.json().catch(() => ({}));\n        if (!res.ok) return showToast({ message: json?.error?.message ?? 'Could not update the item.', severity: 'error' });\n        showToast({ message: item.isVisible ? 'Hidden from students' : 'Shown to students', severity: 'success' });\n        await reload();\n      },\n      markMissing: async (item) => {\n        const res = await fetch(`/api/grade-items/${item.id}/mark-missing`, { method: 'POST' });\n        const json = await res.json().catch(() => ({}));\n        if (!res.ok) return showToast({ message: json?.error?.message ?? 'Could not mark missing.', severity: 'error' });\n        showToast({ message: `${json.data.updatedCount} marked missing`, severity: 'success' });\n        await reload();\n      },\n    }),\n    [items, reload, showToast],\n  );\n\n  const catResult = (r: StudentTermResult, id: string | null) => r.categories.find((c) => c.id === id)?.percent ?? null;\n  const hasUncategorised = data.rows.some((r) => r.result.categories.some((c) => c.id === null));\n\n  const columns: GridColDef<GridRow>[] = useMemo(() => {\n    const itemCols: GridColDef<GridRow>[] = data.items.map((item) => {\n      const Icon = SOURCE_ICON[item.source];\n      return {\n        field: item.id,\n        type: 'number',\n        width: 120,\n        sortable: false,\n        editable: true,\n        headerAlign: 'center',\n        align: 'center',\n        description: `${item.title} — ${SOURCE_LABEL[item.source]}${item.isVisible ? '' : ' (hidden from students)'}`,\n        valueGetter: (_v, row) => {\n          const s = (row.cells as Row['cells'])[item.id]?.score;\n          return s === null || s === undefined ? null : Number(s);\n        },\n        renderHeader: () => (\n          <Stack sx={{ lineHeight: 1.2, py: 0.5, opacity: item.isVisible ? 1 : 0.6, minWidth: 0 }}>\n            <Stack direction=\"row\" spacing={0.5} sx={{ alignItems: 'center', minWidth: 0 }}>\n              <Icon fontSize=\"inherit\" aria-label={SOURCE_LABEL[item.source]} />\n              {!item.isVisible && <VisibilityOffOutlinedIcon fontSize=\"inherit\" aria-label=\"Hidden from students\" />}\n              <Typography variant=\"caption\" sx={{ fontWeight: 600 }} noWrap>\n                {item.title}\n              </Typography>\n            </Stack>\n            <Typography variant=\"caption\" color=\"text.secondary\" noWrap>\n              {item.dueAt ? formatInSchoolTz(item.dueAt, 'd MMM', timezone) : 'No date'} · /{pts(item.maxPoints)}\n            </Typography>\n          </Stack>\n        ),\n        renderCell: ({ row }) => {\n          const cell = (row.cells as Row['cells'])[item.id];\n          const err = cellErrors[`${row.id}:${item.id}`];\n          const text = cellText(cell);\n          return (\n            <Tooltip title={err ?? cell.comment ?? ''}>\n              <Box\n                sx={{ width: '100%', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 0.5, color: text === 'M' ? 'error.main' : undefined, fontWeight: text === 'M' ? 700 : undefined, outline: err ? '2px solid' : undefined, outlineColor: 'error.main' }}\n                data-testid={`cell-${row.id}-${item.id}`}\n              >\n                {text}\n                {cell.isLate && <AccessTimeIcon fontSize=\"inherit\" aria-label=\"Late\" />}\n              </Box>\n            </Tooltip>\n          );\n        },\n      };\n    });\n\n    const catCol = (id: string | null, name: string): GridColDef<GridRow> => ({\n      field: `cat:${id ?? 'none'}`,\n      headerName: `${name} %`,\n      width: 120,\n      sortable: false,\n      align: 'center',\n      headerAlign: 'center',\n      valueGetter: (_v, row) => catResult(row.result as StudentTermResult, id) ?? '—',\n    });\n\n    return [\n      {\n        field: 'name',\n        headerName: 'Student',\n        width: 200,\n        renderCell: ({ row }) => (\n          <Stack direction=\"row\" sx={{ alignItems: 'center', width: '100%' }}>\n            <Typography variant=\"body2\" noWrap sx={{ flex: 1 }}>\n              {row.name}\n            </Typography>\n            <Tooltip title=\"Override term grade / comment\">\n              <IconButton size=\"small\" aria-label={`Override term grade for ${row.name}`} onClick={() => setOverride(data.rows.find((r) => r.student.id === row.id) ?? null)}>\n                <TuneIcon fontSize=\"inherit\" />\n              </IconButton>\n            </Tooltip>\n          </Stack>\n        ),\n      },\n      ...itemCols,\n      ...data.categories.map((c) => catCol(c.id, c.name)),\n      ...(hasUncategorised ? [catCol(null, 'Uncategorised')] : []),\n      {\n        field: 'term',\n        headerName: 'Term',\n        width: 130,\n        sortable: false,\n        align: 'center',\n        headerAlign: 'center',\n        renderCell: ({ row }) => {\n          const r = row.result as StudentTermResult;\n          return (\n            <Typography variant=\"body2\" sx={{ fontWeight: 700 }} data-testid={`term-${row.id}`}>\n              {r.percent === null ? '—' : `${r.percent}% ${r.letter ?? ''}`}\n              {r.overridden ? ' *' : ''}\n            </Typography>\n          );\n        },\n      },\n    ];\n  }, [data.items, data.categories, data.rows, cellErrors, hasUncategorised, timezone]);\n\n  const grouping: GridColumnGroupingModel = useMemo(() => {\n    const known = new Set(data.categories.map((c) => c.id));\n    const groups = data.categories.map((c) => ({ groupId: c.id, headerName: `${c.name} (${pts(c.weightPercent)}%)`, children: data.items.filter((i) => i.categoryId === c.id).map((i) => ({ field: i.id })) }));\n    const loose = data.items.filter((i) => !i.categoryId || !known.has(i.categoryId)).map((i) => ({ field: i.id }));\n    if (loose.length) groups.push({ groupId: 'uncategorised', headerName: 'Uncategorised', children: loose });\n    groups.push({ groupId: 'averages', headerName: 'Averages', children: [...data.categories.map((c) => ({ field: `cat:${c.id}` })), ...(hasUncategorised ? [{ field: 'cat:none' }] : []), { field: 'term' }] });\n    return groups.filter((g) => g.children.length);\n  }, [data.categories, data.items, hasUncategorised]);\n\n  const gridRows: GridRow[] = useMemo(\n    () => data.rows.map((r) => ({ id: r.student.id, name: `${r.student.lastName}, ${r.student.firstName}`, cells: r.cells, result: r.result })),\n    [data.rows],\n  );\n\n  const onCellKeyDown: GridEventListener<'cellKeyDown'> = (params, event) => {\n    const item = items.get(params.field);\n    if (!item || item.source !== 'MANUAL' || params.cellMode !== 'view') return;\n    const k = event.key;\n    let body: { score: null; excused: boolean; missing: boolean } | null = null;\n    if (k === 'e' || k === 'E') body = { score: null, excused: true, missing: false };\n    else if (k === 'm' || k === 'M') body = { score: null, excused: false, missing: true };\n    else if (k === 'Delete' || k === 'Backspace') body = { score: null, excused: false, missing: false };\n    if (!body) return;\n    event.defaultMuiPrevented = true;\n    event.preventDefault();\n    void saveCell(String(params.id), item, body);\n  };\n\n  const processRowUpdate = (newRow: GridRow, oldRow: GridRow) => {\n    for (const item of data.items) {\n      // Only the edited field is set on newRow; every other value comes from valueGetter.\n      if (!Object.prototype.hasOwnProperty.call(newRow, item.id)) continue;\n      const next = newRow[item.id] as number | null;\n      const prev = (oldRow.cells as Row['cells'])[item.id]?.score;\n      const prevNum = prev === null || prev === undefined ? null : Number(prev);\n      if (next === prevNum) continue;\n      if (next === null || Number.isNaN(next)) {\n        void saveCell(newRow.id, item, { score: null, excused: false, missing: false });\n      } else if (next < 0 || next > Number(item.maxPoints)) {\n        const key = `${newRow.id}:${item.id}`;\n        setCellErrors((e) => ({ ...e, [key]: `Enter 0–${pts(item.maxPoints)}` }));\n        showToast({ message: `Score must be between 0 and ${pts(item.maxPoints)}.`, severity: 'error' });\n        return oldRow;\n      } else {\n        void saveCell(newRow.id, item, { score: String(Math.round(next * 100) / 100), excused: false, missing: false });\n      }\n    }\n    return oldRow; // state is owned by saveCell (optimistic), the grid re-reads it from rows\n  };\n\n  const onCellClick: GridEventListener<'cellClick'> = (params) => {\n    const item = items.get(params.field);\n    if (!item || item.source === 'MANUAL' || !item.sourceId) return;\n    const cell = (params.row.cells as Row['cells'])[item.id];\n    if (item.source === 'ASSIGNMENT') router.push(`/courses/${courseId}/assignments/${item.sourceId}/grade?studentId=${params.id}`);\n    else if (cell.attemptId) router.push(`/quizzes/${item.sourceId}/attempts/${cell.attemptId}`);\n  };\n\n  const csvHref = `/api/courses/${courseId}/gradebook?termId=${encodeURIComponent(data.term.id)}&format=csv`;\n  const letters = data.scale?.bands.map((b) => b.letter) ?? [];\n\n  return (\n    <Stack spacing={2}>\n      <Stack direction={{ xs: 'column', sm: 'row' }} spacing={1} sx={{ alignItems: { sm: 'center' } }}>\n        <TextField select size=\"small\" label=\"Term\" value={data.term.id} onChange={(e) => void reload(e.target.value)} sx={{ minWidth: 200 }}>\n          {data.terms.map((t) => (\n            <MenuItem key={t.id} value={t.id}>\n              {t.name}\n              {t.isCurrent ? ' (current)' : ''}\n            </MenuItem>\n          ))}\n        </TextField>\n        <Box sx={{ flex: 1 }} />\n        <Button startIcon={<AddIcon />} variant=\"contained\" onClick={() => setAddOpen(true)}>\n          Add manual item\n        </Button>\n        <Button startIcon={<DownloadIcon />} component=\"a\" href={csvHref}>\n          Export CSV\n        </Button>\n        <Button startIcon={<SettingsOutlinedIcon />} component={NextLink} href={`/courses/${courseId}/gradebook/settings`}>\n          Settings\n        </Button>\n      </Stack>\n      <Typography variant=\"body2\" color=\"text.secondary\">\n        Scale: {data.scale?.name ?? 'none set'}. Manual cells: type a score, E = excused, M = missing, Delete = clear. Click a synced score to open its source. * = overridden.\n      </Typography>\n      <MenuContext.Provider value={menuActions}>\n        <Box sx={{ height: '70vh', minHeight: 360 }}>\n          <DataGrid\n            rows={gridRows}\n            columns={columns}\n            columnGroupingModel={grouping}\n            columnHeaderHeight={64}\n            isCellEditable={(p) => items.get(p.field)?.source === 'MANUAL'}\n            processRowUpdate={processRowUpdate}\n            onProcessRowUpdateError={(e) => showToast({ message: e instanceof Error ? e.message : 'Could not save.', severity: 'error' })}\n            onCellKeyDown={onCellKeyDown}\n            onCellClick={onCellClick}\n            slots={{ columnMenu: GradebookColumnMenu }}\n            disableRowSelectionOnClick\n            hideFooter\n            aria-label={`Gradebook for ${data.course.name}, ${data.term.name}`}\n          />\n        </Box>\n      </MenuContext.Provider>\n\n      <AddManualItemDialog\n        open={addOpen}\n        courseId={courseId}\n        timezone={timezone}\n        categories={data.categories}\n        terms={data.terms}\n        defaultTermId={data.term.id}\n        onClose={() => setAddOpen(false)}\n        onCreated={() => {\n          setAddOpen(false);\n          showToast({ message: 'Item added', severity: 'success' });\n          void reload();\n        }}\n      />\n      {stats && <ItemStatsDialog title={stats.title} item={stats} cells={data.rows.map((r) => r.cells[stats.id])} onClose={() => setStats(null)} />}\n      {override && (\n        <TermOverrideDialog\n          courseId={courseId}\n          termId={data.term.id}\n          student={override.student}\n          result={override.result}\n          letters={letters}\n          onClose={() => setOverride(null)}\n          onSaved={(result) => {\n            patchRow(override.student.id, (r) => ({ ...r, result }));\n            setOverride(null);\n            showToast({ message: 'Term grade saved', severity: 'success' });\n          }}\n        />\n      )}\n    </Stack>\n  );\n}\n","numLines":369,"startLine":60,"totalLines":428}},"tool_result_meta":[{"id":"toolu_01N8puiLwxFLoGFm3UhBCpag","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
