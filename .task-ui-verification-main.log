{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgrsHzeVd7PG6EktVtXQB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CuzGBck2WDQEHUWo9eLL3m","name":"Write","input":{"file_path":"/tmp/sh9-uiv/driver.cjs","content":"// Throwaway SH-9 UI verification driver. Lives outside the repo. Usage: node driver.cjs <repoDir> <outDir>\nconst path = require('path');\nconst fs = require('fs');\nconst [, , REPO, OUT] = process.argv;\nconst req = (m) => require(path.join(REPO, 'node_modules', m));\nconst { chromium } = req('playwright');\nconst { PrismaClient } = req('@prisma/client');\nconst bcrypt = req('bcrypt');\n\nconst BASE = 'http://localhost:3300';\nconst TAG = 'uiv-sh9';\nconst PW = 'Uiv-Sh9!2026-pass';\nconst email = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst SHOTS = path.join(OUT, 'screenshots');\nfs.mkdirSync(SHOTS, { recursive: true });\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {} };\nconst H = 3600_000, D = 24 * H;\n\nasync function cleanup() {\n  const courses = await prisma.course.findMany({ where: { code: { startsWith: TAG } }, select: { id: true } });\n  const cids = courses.map((c) => c.id);\n  const rubricIds = (await prisma.assignment.findMany({ where: { courseId: { in: cids } }, select: { rubricId: true } }))\n    .map((a) => a.rubricId).filter(Boolean);\n  await prisma.course.deleteMany({ where: { id: { in: cids } } });\n  await prisma.rubric.deleteMany({ where: { id: { in: rubricIds } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  for (const [model, field] of [['notification', 'userId'], ['fileObject', 'ownerId'], ['auditLog', 'actorId'], ['parentStudentLink', 'parentId'], ['session', 'userId']]) {\n    try { await prisma[model].deleteMany({ where: { [field]: { in: ids } } }); } catch {}\n  }\n  try { await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } }); } catch {}\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n}\n\nconst ids = {};\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, firstName, lastName, role) => prisma.user.create({ data: { email: email(n), firstName, lastName, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const admin = await mk('admin', 'Ada', 'Admin', 'ADMIN');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Morgan', 'Late', 'STUDENT');\n  const s3 = await mk('s3', 'Jamie', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s1.id, relationship: 'MOTHER', isPrimary: true } });\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s3.id, relationship: 'MOTHER', isPrimary: false } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  const c2 = await prisma.course.create({ data: { name: 'UIV Maths B', code: `${TAG}-b`, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id, notifiedAt: new Date() };\n  const rubric = await prisma.rubric.create({ data: {} });\n  const lv = (max) => [{ label: 'Excellent', points: String(max), description: '' }, { label: 'Good', points: String(max - 2), description: '' }, { label: 'Weak', points: '2', description: '' }];\n  const crA = await prisma.rubricCriterion.create({ data: { rubricId: rubric.id, title: 'Accuracy', maxPoints: '10', order: 0, levels: lv(10) } });\n  const crB = await prisma.rubricCriterion.create({ data: { rubricId: rubric.id, title: 'Working', maxPoints: '10', order: 1, levels: lv(10) } });\n  const a1 = await prisma.assignment.create({ data: { ...base, title: 'UIV Fractions worksheet', instructions: '## Task\\n\\nSolve **all** questions.\\n\\n- Q1\\n- Q2\\n\\n<script>alert(1)</script>', submissionType: 'TEXT_AND_FILE', maxPoints: '20', dueAt: new Date(now + 5 * H), allowLate: true, latePenaltyPercentPerDay: '10', maxLatePenaltyPercent: '30', maxFileCount: 2, status: 'PUBLISHED', rubricId: rubric.id } });\n  const a2 = await prisma.assignment.create({ data: { ...base, title: 'UIV Reading log', instructions: 'Write a short reading log.', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now - 2 * D - H), allowLate: true, latePenaltyPercentPerDay: '10', maxLatePenaltyPercent: '50', status: 'PUBLISHED' } });\n  const a3 = await prisma.assignment.create({ data: { ...base, title: 'UIV Lab safety demo', submissionType: 'NO_SUBMISSION', maxPoints: '5', dueAt: new Date(now - D), status: 'PUBLISHED' } });\n  const a4 = await prisma.assignment.create({ data: { ...base, title: 'UIV Draft essay', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 7 * D), status: 'DRAFT', notifiedAt: null } });\n  const a5 = await prisma.assignment.create({ data: { ...base, title: 'UIV Scheduled quiz', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 9 * D), availableFrom: new Date(now + 3 * D), status: 'SCHEDULED', notifiedAt: null } });\n  // s1 on a2: returned, 8/10 with feedback\n  await prisma.submission.create({ data: { assignmentId: a2.id, studentId: s1.id, status: 'RETURNED', text: 'I read *Holes* chapters 1-4.', attemptNumber: 1, submittedAt: new Date(now - 3 * D), rawScore: '8', penaltyPercent: '0', finalScore: '8', feedback: 'Good summary — add **page numbers** next time.', gradedById: t.id, gradedAt: new Date(now - D), returnedAt: new Date(now - D) } });\n  // s2 on a2: late by 2 days (submitted dueAt+1day+1h → ceil = 2 days), attempt 2 with history\n  const sub2 = await prisma.submission.create({ data: { assignmentId: a2.id, studentId: s2.id, status: 'SUBMITTED', text: 'Second attempt: chapters 1-6 summary.', attemptNumber: 2, submittedAt: new Date(now - 2 * D - H + D + H), isLate: true, lateDays: 1 } });\n  await prisma.submissionHistory.create({ data: { submissionId: sub2.id, attemptNumber: 1, text: 'First attempt: chapters 1-2.', fileIds: [], submittedAt: new Date(now - 2 * D - 2 * H) } });\n  Object.assign(ids, { t: t.id, admin: admin.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, c2: c2.id, a1: a1.id, a2: a2.id, a3: a3.id, a4: a4.id, a5: a5.id, crA: crA.id, crB: crB.id, sub2: sub2.id });\n  R.fixtures = ids;\n}\n\nasync function login(ctx, who) {\n  const page = await ctx.newPage();\n  const { csrfToken } = await (await page.request.get(`${BASE}/api/auth/csrf`)).json();\n  await page.request.post(`${BASE}/api/auth/callback/credentials`, { form: { email: email(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get(`${BASE}/api/auth/session`)).json();\n  if (s?.user?.email !== email(who)) throw new Error(`login failed for ${who}`);\n  const errs = (R.consoleErrors[who] ||= []);\n  page.on('console', (m) => { if (m.type() === 'error') errs.push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => errs.push('pageerror: ' + String(e).slice(0, 300)));\n  return page;\n}\n\nasync function step(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 4).join(' | ') }; }\n  console.log(name, R.results[name].ok ? 'OK' : 'FAIL ' + R.results[name].error);\n}\nconst shot = (page, n) => page.screenshot({ path: path.join(SHOTS, `${n}.png`), fullPage: true });\nasync function go(page, p) {\n  const res = await page.goto(BASE + p, { waitUntil: 'networkidle', timeout: 90_000 });\n  return { status: res.status(), finalUrl: page.url().replace(BASE, '') };\n}\nconst text = (page) => page.locator('main').innerText().catch(() => page.locator('body').innerText());\nasync function hydrated(fn, check, tries = 15) {\n  for (let i = 0; i < tries; i++) { try { await fn(); if (await check()) return true; } catch {} await new Promise((r) => setTimeout(r, 1000)); }\n  return false;\n}\n\n(async () => {\n  await setup();\n  const browser = await chromium.launch();\n  const desk = () => browser.newContext({ viewport: { width: 1280, height: 800 }, bypassCSP: true, timezoneId: 'UTC' });\n  const mob = () => browser.newContext({ viewport: { width: 375, height: 667 }, bypassCSP: true, timezoneId: 'UTC' });\n  const c = `/courses/${ids.c1}/assignments`;\n\n  // ---------- TEACHER ----------\n  const tctx = await desk();\n  const tp = await login(tctx, 'teacher');\n  await step('teacher-nav', async () => {\n    const r = await go(tp, '/dashboard');\n    return { ...r, navAssignments: await tp.getByRole('link', { name: 'Assignments' }).count() };\n  });\n  await step('teacher-course-assignments-table', async () => {\n    const r = await go(tp, c);\n    await shot(tp, 'teacher-course-assignments-1280');\n    return { ...r, courseTab: await tp.getByRole('tab', { name: 'Assignments' }).count() + await tp.getByRole('link', { name: 'Assignments' }).count(),\n      headers: await tp.getByRole('columnheader').allInnerTexts(), gradeButtons: await tp.getByRole('link', { name: 'Grade' }).count() + await tp.getByRole('button', { name: 'Grade' }).count(),\n      text: (await text(tp)).slice(0, 1500) };\n  });\n  await step('teacher-new-form', async () => {\n    const r = await go(tp, `${c}/new`);\n    const due = await tp.getByLabel('Due').first().inputValue().catch(() => null);\n    const dueGroup = await tp.locator('text=School time').first().innerText().catch(() => null);\n    const pickerText = await tp.locator('.MuiPickersInputBase-root, .MuiPickersSectionList-root').first().innerText().catch(() => null);\n    await shot(tp, 'teacher-assignment-new-1280');\n    const buttons = await tp.getByRole('button').allInnerTexts();\n    return { ...r, dueValue: due, pickerText, dueHelper: dueGroup, buttons: buttons.filter((b) => b.trim()), labels: await tp.locator('label').allInnerTexts() };\n  });\n  await step('teacher-rubric-builder', async () => {\n    await tp.getByLabel('Title').fill('UIV Created via form');\n    await tp.getByLabel('Max points').first().fill('20');\n    const ok = await hydrated(() => tp.getByLabel('Grade with a rubric').check(), async () => (await tp.getByRole('button', { name: 'Add criterion' }).count()) > 0);\n    await tp.getByRole('button', { name: 'Add criterion' }).click();\n    await tp.waitForTimeout(400);\n    const oneCrit = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).allInnerTexts();\n    await shot(tp, 'teacher-rubric-mismatch-1280');\n    const publishDisabled = await tp.getByRole('button', { name: 'Publish' }).isDisabled();\n    await tp.getByRole('button', { name: 'Add criterion' }).click();\n    await tp.waitForTimeout(400);\n    const twoCrit = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).count();\n    const reorder = await tp.getByRole('button', { name: /move|up|down/i }).count();\n    const remove = await tp.getByRole('button', { name: /remove|delete/i }).count();\n    await tp.getByLabel('Criterion 1 title').fill('Accuracy');\n    await tp.getByLabel('Criterion 2 title').fill('Working');\n    await shot(tp, 'teacher-rubric-builder-1280');\n    await tp.getByRole('button', { name: 'Save draft' }).click();\n    await tp.waitForTimeout(3000);\n    const saved = await prisma.assignment.findFirst({ where: { title: 'UIV Created via form' }, include: { rubric: { include: { criteria: true } } } });\n    return { hydrated: ok, mismatchAlertOneCriterion: oneCrit, publishDisabledOnMismatch: publishDisabled, mismatchAlertCountTwoCriteria: twoCrit, reorderButtons: reorder, removeButtons: remove,\n      savedStatus: saved?.status, savedCriteria: saved?.rubric?.criteria.length, savedDueAt: saved?.dueAt, afterUrl: tp.url().replace(BASE, '') };\n  });\n  await step('teacher-edit-published-with-submissions', async () => {\n    const r = await go(tp, `${c}/${ids.a2}/edit`);\n    const alerts = await tp.getByRole('alert').allInnerTexts();\n    await shot(tp, 'teacher-assignment-edit-1280');\n    await hydrated(() => tp.getByRole('button', { name: 'Duplicate to other courses' }).click(), async () => (await tp.getByRole('dialog').count()) > 0);\n    await tp.waitForTimeout(500);\n    await shot(tp, 'teacher-duplicate-dialog-1280');\n    const dlg = await tp.getByRole('dialog').innerText().catch(() => null);\n    let duplicated = null;\n    try {\n      await tp.getByRole('dialog').getByLabel('Courses').click();\n      await tp.getByRole('option', { name: /UIV Maths B/ }).click();\n      await tp.getByRole('dialog').getByRole('button', { name: /^Duplicate/ }).click();\n      await tp.waitForTimeout(2500);\n      duplicated = await prisma.assignment.findFirst({ where: { courseId: ids.c2, title: 'UIV Reading log' }, select: { status: true, dueAt: true } });\n    } catch (e) { duplicated = 'error: ' + String(e).slice(0, 200); }\n    return { ...r, alerts, dialog: dlg, duplicated };\n  });\n  await step('teacher-grade-page', async () => {\n    const r = await go(tp, `${c}/${ids.a2}/grade`);\n    await tp.waitForTimeout(1000);\n    const list = await tp.getByRole('list', { name: 'Students' }).innerText().catch(() => null);\n    await shot(tp, 'teacher-grade-1280');\n    return { ...r, studentList: list, text: (await text(tp)).slice(0, 2500) };\n  });\n  await step('teacher-grade-late-student', async () => {\n    await hydrated(() => tp.getByRole('button', { name: /Morgan Late/ }).click(), async () => (await text(tp)).includes('Second attempt'));\n    await tp.waitForTimeout(500);\n    const penalty = await tp.getByLabel('Late penalty %').inputValue().catch(() => null);\n    const attemptSel = await tp.getByLabel('Attempt').count();\n    let historyShown = null;\n    try {\n      await tp.getByLabel('Attempt').click();\n      const opts = await tp.getByRole('option').allInnerTexts();\n      await tp.getByRole('option', { name: /1/ }).first().click();\n      await tp.waitForTimeout(400);\n      historyShown = { opts, firstAttemptVisible: (await text(tp)).includes('First attempt: chapters 1-2.') };\n      await tp.getByLabel('Attempt').click();\n      await tp.getByRole('option').last().click();\n    } catch (e) { historyShown = 'error: ' + String(e).slice(0, 200); }\n    const raw = tp.getByLabel(/Raw score/).first();\n    await raw.fill('9');\n    await tp.waitForTimeout(300);\n    const finalLive = await tp.getByLabel('Final score').inputValue().catch(() => null);\n    await shot(tp, 'teacher-grade-late-1280');\n    return { prefilledPenalty: penalty, attemptDropdown: attemptSel, historyShown, finalLive };\n  });\n  await step('teacher-grade-shortcuts', async () => {\n    const sel = async () => (await tp.locator('[aria-label=\"Students\"] .Mui-selected').innerText().catch(() => null));\n    await tp.locator('body').click({ position: { x: 5, y: 5 } }).catch(() => {});\n    await tp.locator('h1').first().click().catch(() => {});\n    const before = await sel();\n    await tp.keyboard.press('j'); await tp.waitForTimeout(500);\n    const afterJ = await sel();\n    await tp.keyboard.press('k'); await tp.waitForTimeout(500);\n    const afterK = await sel();\n    await tp.getByLabel('Feedback', { exact: true }).click().catch(() => {});\n    await tp.keyboard.press('j'); await tp.waitForTimeout(300);\n    const afterJInField = await sel();\n    return { before, afterJ, afterK, afterJInField };\n  });\n  await step('teacher-save-and-return', async () => {\n    await tp.getByRole('button', { name: /Morgan Late/ }).click();\n    await tp.waitForTimeout(500);\n    await tp.getByLabel(/Raw score/).first().fill('9');\n    await tp.getByLabel('Feedback', { exact: true }).fill('Late, but solid work.');\n    await tp.getByRole('button', { name: 'Save & return' }).click();\n    await tp.waitForTimeout(2500);\n    const s = await prisma.submission.findUnique({ where: { id: ids.sub2 } });\n    await shot(tp, 'teacher-grade-returned-1280');\n    return { status: s.status, rawScore: String(s.rawScore), penalty: String(s.penaltyPercent), finalScore: String(s.finalScore), returnedAt: s.returnedAt, snack: await tp.getByRole('alert').allInnerTexts() };\n  });\n  await step('teacher-offline-and-exempt', async () => {\n    await tp.getByRole('button', { name: /Jamie Missing/ }).click();\n    await tp.waitForTimeout(800);\n    const t1 = await text(tp);\n    await shot(tp, 'teacher-grade-not-submitted-1280');\n    const ex = tp.getByLabel('Exempt');\n    await ex.check();\n    await tp.waitForTimeout(2000);\n    const exRow = await prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: ids.a2, studentId: ids.s3 } } });\n    const t2 = await text(tp);\n    await shot(tp, 'teacher-grade-exempt-1280');\n    await ex.uncheck();\n    await tp.waitForTimeout(2000);\n    const exRow2 = await prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: ids.a2, studentId: ids.s3 } } });\n    return { gradeWithoutSubmissionShown: t1.includes('Grade without submission'), exemptWritten: !!exRow, exemptAlert: t2.includes('Exempt: excluded'), exemptDeleted: !exRow2 };\n  });\n  await step('teacher-offline-grade-no-submission-type', async () => {\n    const r = await go(tp, `${c}/${ids.a3}/grade`);\n    await tp.waitForTimeout(800);\n    await tp.getByRole('button', { name: /Alex Aardvark/ }).click();\n    await tp.waitForTimeout(500);\n    await tp.getByLabel(/Raw score/).first().fill('4');\n    await tp.getByRole('button', { name: /^Save$/ }).click();\n    await tp.waitForTimeout(2500);\n    const s = await prisma.submission.findFirst({ where: { assignmentId: ids.a3, studentId: ids.s1 } });\n    await shot(tp, 'teacher-grade-offline-1280');\n    return { ...r, created: s && { attemptNumber: s.attemptNumber, rawScore: String(s.rawScore), status: s.status, returnedAt: s.returnedAt } };\n  });\n\n  // ---------- STUDENT (desktop: submit; mobile: views) ----------\n  const sctx = await mob();\n  const sp = await login(sctx, 's1');\n  await step('student-nav', async () => {\n    await go(sp, '/dashboard');\n    const menu = sp.getByRole('button', { name: /menu|navigation|open drawer/i }).first();\n    if (await menu.count()) await menu.click().catch(() => {});\n    await sp.waitForTimeout(500);\n    return { navAssignments: await sp.getByRole('link', { name: 'Assignments' }).count() };\n  });\n  await step('student-course-assignments', async () => {\n    const r = await go(sp, c);\n    await shot(sp, 'student-course-assignments-375');\n    return { ...r, text: (await text(sp)).slice(0, 1500), hiddenDraftOrScheduled: !(await text(sp)).match(/UIV Draft essay|UIV Scheduled quiz/) };\n  });\n  await step('student-assignment-page-countdown', async () => {\n    const r = await go(sp, `${c}/${ids.a1}`);\n    await sp.waitForTimeout(1500);\n    const t = await text(sp);\n    await shot(sp, 'student-assignment-375');\n    return { ...r, countdown: (t.match(/Due in[^\\n]*/) || [null])[0], rubricTable: await sp.getByRole('table', { name: 'Rubric' }).count(),\n      scriptRenderedAsText: t.includes('<script>'), headingTask: await sp.getByRole('heading', { name: 'Task' }).count(),\n      latePolicy: (t.match(/[^\\n]*(late|penalty)[^\\n]*/i) || [null])[0], answerField: await sp.getByLabel('Your answer').count(), fileInput: await sp.getByLabel('Attach files').count(), overflowX: await sp.evaluate(() => document.documentElement.scrollWidth > window.innerWidth) };\n  });\n  await step('student-submit-dialog-receipt', async () => {\n    const ok = await hydrated(() => sp.getByLabel('Your answer').first().fill('My answers: 1/2, 3/4.'), async () => true, 3);\n    await sp.waitForTimeout(1200);\n    const ls = await sp.evaluate(() => Object.entries(localStorage).filter(([k]) => /draft|assign|submission/i.test(k)).map(([k, v]) => [k, v.slice(0, 60)]));\n    await sp.getByRole('button', { name: 'Submit', exact: true }).click();\n    await sp.waitForTimeout(500);\n    const dlg = await sp.getByRole('dialog').innerText().catch(() => null);\n    await shot(sp, 'student-submit-dialog-375');\n    const preCount = await prisma.submission.count({ where: { assignmentId: ids.a1, studentId: ids.s1 } });\n    await sp.getByRole('dialog').getByRole('button', { name: 'Submit' }).click();\n    await sp.waitForTimeout(2500);\n    const t = await text(sp);\n    await shot(sp, 'student-submitted-375');\n    return { filled: ok, localStorageDraft: ls, dialog: dlg, submissionBeforeConfirm: preCount, receipt: (t.match(/Submitted [A-Z][a-z]{2} [^\\n]*attempt[^\\n]*/) || [null])[0], awaiting: t.includes('Submitted — awaiting grading') };\n  });\n  await step('student-returned-view', async () => {\n    const r = await go(sp, `${c}/${ids.a2}`);\n    const t = await text(sp);\n    await shot(sp, 'student-returned-375');\n    return { ...r, text: t.slice(0, 1500), hasFeedback: t.includes('page numbers'), hasScore: /8(\\.00)?\\s*\\/\\s*10/.test(t) };\n  });\n  await step('student-assignments-page', async () => {\n    const r = await go(sp, '/assignments');\n    const tabs = await sp.getByRole('tab').allInnerTexts();\n    await shot(sp, 'student-assignments-upcoming-375');\n    const per = {};\n    for (const name of ['Missing', 'Submitted', 'Returned']) {\n      await hydrated(() => sp.getByRole('tab', { name: new RegExp(name) }).click(), async () => (await sp.getByRole('tab', { name: new RegExp(name), selected: true }).count()) > 0, 10);\n      await sp.waitForTimeout(400);\n      per[name] = (await sp.getByRole('tabpanel').innerText().catch(() => text(sp))).slice(0, 400);\n      await shot(sp, `student-assignments-${name.toLowerCase()}-375`);\n    }\n    const courseFilter = await sp.getByLabel(/Course/).count();\n    return { ...r, tabs, per, courseFilter };\n  });\n\n  // ---------- PARENT ----------\n  const pctx = await mob();\n  const pp = await login(pctx, 'parent');\n  await step('parent-assignments-page', async () => {\n    const r = await go(pp, '/assignments');\n    await shot(pp, 'parent-assignments-375');\n    const t = await text(pp);\n    const sel = await pp.getByLabel(/Child|Student/).count();\n    const menu = pp.getByRole('button', { name: /menu|navigation|open drawer/i }).first();\n    const nav = await pp.getByRole('link', { name: 'Assignments' }).count();\n    return { ...r, childSelector: sel, text: t.slice(0, 1000), submitControls: await pp.getByRole('button', { name: 'Submit' }).count(), nav, hasMenu: await menu.count() };\n  });\n  await step('parent-child-switch', async () => {\n    const r = await go(pp, `/assignments?studentId=${ids.s3}`);\n    await hydrated(() => pp.getByRole('tab', { name: /Missing/ }).click(), async () => (await pp.getByRole('tab', { name: /Missing/, selected: true }).count()) > 0, 10);\n    await pp.waitForTimeout(400);\n    await shot(pp, 'parent-assignments-missing-375');\n    return { ...r, text: (await text(pp)).slice(0, 800) };\n  });\n  await step('parent-assignment-readonly', async () => {\n    const r = await go(pp, `${c}/${ids.a1}?studentId=${ids.s1}`);\n    await shot(pp, 'parent-assignment-375');\n    const t = await text(pp);\n    return { ...r, awaiting: t.includes('Submitted — awaiting grading'), submitButtons: await pp.getByRole('button', { name: 'Submit' }).count(), answerField: await pp.getByLabel('Your answer').count(), text: t.slice(0, 800) };\n  });\n\n  // ---------- TEACHER to-grade, ADMIN student tab ----------\n  await step('teacher-to-grade', async () => {\n    const r = await go(tp, '/assignments');\n    await shot(tp, 'teacher-to-grade-1280');\n    return { ...r, text: (await text(tp)).slice(0, 800) };\n  });\n  const actx = await desk();\n  const ap = await login(actx, 'admin');\n  await step('admin-student-assignments-tab', async () => {\n    const r = await go(ap, `/students/${ids.s1}/assignments`);\n    await shot(ap, 'admin-student-assignments-1280');\n    return { ...r, tabs: await ap.getByRole('tab').allInnerTexts(), text: (await text(ap)).slice(0, 1000) };\n  });\n  await step('admin-course-assignments', async () => {\n    const r = await go(ap, c);\n    await shot(ap, 'admin-course-assignments-1280');\n    return { ...r, gradeButtons: await ap.getByRole('link', { name: 'Grade' }).count() };\n  });\n\n  await browser.close();\n})()\n  .catch((e) => { R.fatal = String(e); console.error(e); })\n  .finally(async () => {\n    try { await cleanup(); R.cleanedUp = true; } catch (e) { R.cleanupError = String(e); }\n    fs.writeFileSync(path.join(OUT, 'uiv-raw.json'), JSON.stringify(R, null, 1));\n    await prisma.$disconnect();\n  });\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":137,"cache_read_input_tokens":65286,"cache_creation":{"ephemeral_5m_input_tokens":137,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4d5985c3-c3cf-4564-ae4d-e780109f626c","uuid":"b7e818b5-1f9c-4f22-922c-ff3dfc550c62","timestamp":"2026-11-09T06:19:50.083Z","request_id":"req_011CgrsHz5X6wmsAd9n3HYFL","wire_tool_inputs":{"toolu_01CuzGBck2WDQEHUWo9eLL3m":{"file_path":"/tmp/sh9-uiv/driver.cjs","content":"// Throwaway SH-9 UI verification driver. Lives outside the repo. Usage: node driver.cjs <repoDir> <outDir>\nconst path = require('path');\nconst fs = require('fs');\nconst [, , REPO, OUT] = process.argv;\nconst req = (m) => require(path.join(REPO, 'node_modules', m));\nconst { chromium } = req('playwright');\nconst { PrismaClient } = req('@prisma/client');\nconst bcrypt = req('bcrypt');\n\nconst BASE = 'http://localhost:3300';\nconst TAG = 'uiv-sh9';\nconst PW = 'Uiv-Sh9!2026-pass';\nconst email = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst SHOTS = path.join(OUT, 'screenshots');\nfs.mkdirSync(SHOTS, { recursive: true });\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {} };\nconst H = 3600_000, D = 24 * H;\n\nasync function cleanup() {\n  const courses = await prisma.course.findMany({ where: { code: { startsWith: TAG } }, select: { id: true } });\n  const cids = courses.map((c) => c.id);\n  const rubricIds = (await prisma.assignment.findMany({ where: { courseId: { in: cids } }, select: { rubricId: true } }))\n    .map((a) => a.rubricId).filter(Boolean);\n  await prisma.course.deleteMany({ where: { id: { in: cids } } });\n  await prisma.rubric.deleteMany({ where: { id: { in: rubricIds } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  for (const [model, field] of [['notification', 'userId'], ['fileObject', 'ownerId'], ['auditLog', 'actorId'], ['parentStudentLink', 'parentId'], ['session', 'userId']]) {\n    try { await prisma[model].deleteMany({ where: { [field]: { in: ids } } }); } catch {}\n  }\n  try { await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } }); } catch {}\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n}\n\nconst ids = {};\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, firstName, lastName, role) => prisma.user.create({ data: { email: email(n), firstName, lastName, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const admin = await mk('admin', 'Ada', 'Admin', 'ADMIN');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Morgan', 'Late', 'STUDENT');\n  const s3 = await mk('s3', 'Jamie', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s1.id, relationship: 'MOTHER', isPrimary: true } });\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s3.id, relationship: 'MOTHER', isPrimary: false } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  const c2 = await prisma.course.create({ data: { name: 'UIV Maths B', code: `${TAG}-b`, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id, notifiedAt: new Date() };\n  const rubric = await prisma.rubric.create({ data: {} });\n  const lv = (max) => [{ label: 'Excellent', points: String(max), description: '' }, { label: 'Good', points: String(max - 2), description: '' }, { label: 'Weak', points: '2', description: '' }];\n  const crA = await prisma.rubricCriterion.create({ data: { rubricId: rubric.id, title: 'Accuracy', maxPoints: '10', order: 0, levels: lv(10) } });\n  const crB = await prisma.rubricCriterion.create({ data: { rubricId: rubric.id, title: 'Working', maxPoints: '10', order: 1, levels: lv(10) } });\n  const a1 = await prisma.assignment.create({ data: { ...base, title: 'UIV Fractions worksheet', instructions: '## Task\\n\\nSolve **all** questions.\\n\\n- Q1\\n- Q2\\n\\n<script>alert(1)</script>', submissionType: 'TEXT_AND_FILE', maxPoints: '20', dueAt: new Date(now + 5 * H), allowLate: true, latePenaltyPercentPerDay: '10', maxLatePenaltyPercent: '30', maxFileCount: 2, status: 'PUBLISHED', rubricId: rubric.id } });\n  const a2 = await prisma.assignment.create({ data: { ...base, title: 'UIV Reading log', instructions: 'Write a short reading log.', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now - 2 * D - H), allowLate: true, latePenaltyPercentPerDay: '10', maxLatePenaltyPercent: '50', status: 'PUBLISHED' } });\n  const a3 = await prisma.assignment.create({ data: { ...base, title: 'UIV Lab safety demo', submissionType: 'NO_SUBMISSION', maxPoints: '5', dueAt: new Date(now - D), status: 'PUBLISHED' } });\n  const a4 = await prisma.assignment.create({ data: { ...base, title: 'UIV Draft essay', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 7 * D), status: 'DRAFT', notifiedAt: null } });\n  const a5 = await prisma.assignment.create({ data: { ...base, title: 'UIV Scheduled quiz', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 9 * D), availableFrom: new Date(now + 3 * D), status: 'SCHEDULED', notifiedAt: null } });\n  // s1 on a2: returned, 8/10 with feedback\n  await prisma.submission.create({ data: { assignmentId: a2.id, studentId: s1.id, status: 'RETURNED', text: 'I read *Holes* chapters 1-4.', attemptNumber: 1, submittedAt: new Date(now - 3 * D), rawScore: '8', penaltyPercent: '0', finalScore: '8', feedback: 'Good summary — add **page numbers** next time.', gradedById: t.id, gradedAt: new Date(now - D), returnedAt: new Date(now - D) } });\n  // s2 on a2: late by 2 days (submitted dueAt+1day+1h → ceil = 2 days), attempt 2 with history\n  const sub2 = await prisma.submission.create({ data: { assignmentId: a2.id, studentId: s2.id, status: 'SUBMITTED', text: 'Second attempt: chapters 1-6 summary.', attemptNumber: 2, submittedAt: new Date(now - 2 * D - H + D + H), isLate: true, lateDays: 1 } });\n  await prisma.submissionHistory.create({ data: { submissionId: sub2.id, attemptNumber: 1, text: 'First attempt: chapters 1-2.', fileIds: [], submittedAt: new Date(now - 2 * D - 2 * H) } });\n  Object.assign(ids, { t: t.id, admin: admin.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, c2: c2.id, a1: a1.id, a2: a2.id, a3: a3.id, a4: a4.id, a5: a5.id, crA: crA.id, crB: crB.id, sub2: sub2.id });\n  R.fixtures = ids;\n}\n\nasync function login(ctx, who) {\n  const page = await ctx.newPage();\n  const { csrfToken } = await (await page.request.get(`${BASE}/api/auth/csrf`)).json();\n  await page.request.post(`${BASE}/api/auth/callback/credentials`, { form: { email: email(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get(`${BASE}/api/auth/session`)).json();\n  if (s?.user?.email !== email(who)) throw new Error(`login failed for ${who}`);\n  const errs = (R.consoleErrors[who] ||= []);\n  page.on('console', (m) => { if (m.type() === 'error') errs.push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => errs.push('pageerror: ' + String(e).slice(0, 300)));\n  return page;\n}\n\nasync function step(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 4).join(' | ') }; }\n  console.log(name, R.results[name].ok ? 'OK' : 'FAIL ' + R.results[name].error);\n}\nconst shot = (page, n) => page.screenshot({ path: path.join(SHOTS, `${n}.png`), fullPage: true });\nasync function go(page, p) {\n  const res = await page.goto(BASE + p, { waitUntil: 'networkidle', timeout: 90_000 });\n  return { status: res.status(), finalUrl: page.url().replace(BASE, '') };\n}\nconst text = (page) => page.locator('main').innerText().catch(() => page.locator('body').innerText());\nasync function hydrated(fn, check, tries = 15) {\n  for (let i = 0; i < tries; i++) { try { await fn(); if (await check()) return true; } catch {} await new Promise((r) => setTimeout(r, 1000)); }\n  return false;\n}\n\n(async () => {\n  await setup();\n  const browser = await chromium.launch();\n  const desk = () => browser.newContext({ viewport: { width: 1280, height: 800 }, bypassCSP: true, timezoneId: 'UTC' });\n  const mob = () => browser.newContext({ viewport: { width: 375, height: 667 }, bypassCSP: true, timezoneId: 'UTC' });\n  const c = `/courses/${ids.c1}/assignments`;\n\n  // ---------- TEACHER ----------\n  const tctx = await desk();\n  const tp = await login(tctx, 'teacher');\n  await step('teacher-nav', async () => {\n    const r = await go(tp, '/dashboard');\n    return { ...r, navAssignments: await tp.getByRole('link', { name: 'Assignments' }).count() };\n  });\n  await step('teacher-course-assignments-table', async () => {\n    const r = await go(tp, c);\n    await shot(tp, 'teacher-course-assignments-1280');\n    return { ...r, courseTab: await tp.getByRole('tab', { name: 'Assignments' }).count() + await tp.getByRole('link', { name: 'Assignments' }).count(),\n      headers: await tp.getByRole('columnheader').allInnerTexts(), gradeButtons: await tp.getByRole('link', { name: 'Grade' }).count() + await tp.getByRole('button', { name: 'Grade' }).count(),\n      text: (await text(tp)).slice(0, 1500) };\n  });\n  await step('teacher-new-form', async () => {\n    const r = await go(tp, `${c}/new`);\n    const due = await tp.getByLabel('Due').first().inputValue().catch(() => null);\n    const dueGroup = await tp.locator('text=School time').first().innerText().catch(() => null);\n    const pickerText = await tp.locator('.MuiPickersInputBase-root, .MuiPickersSectionList-root').first().innerText().catch(() => null);\n    await shot(tp, 'teacher-assignment-new-1280');\n    const buttons = await tp.getByRole('button').allInnerTexts();\n    return { ...r, dueValue: due, pickerText, dueHelper: dueGroup, buttons: buttons.filter((b) => b.trim()), labels: await tp.locator('label').allInnerTexts() };\n  });\n  await step('teacher-rubric-builder', async () => {\n    await tp.getByLabel('Title').fill('UIV Created via form');\n    await tp.getByLabel('Max points').first().fill('20');\n    const ok = await hydrated(() => tp.getByLabel('Grade with a rubric').check(), async () => (await tp.getByRole('button', { name: 'Add criterion' }).count()) > 0);\n    await tp.getByRole('button', { name: 'Add criterion' }).click();\n    await tp.waitForTimeout(400);\n    const oneCrit = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).allInnerTexts();\n    await shot(tp, 'teacher-rubric-mismatch-1280');\n    const publishDisabled = await tp.getByRole('button', { name: 'Publish' }).isDisabled();\n    await tp.getByRole('button', { name: 'Add criterion' }).click();\n    await tp.waitForTimeout(400);\n    const twoCrit = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).count();\n    const reorder = await tp.getByRole('button', { name: /move|up|down/i }).count();\n    const remove = await tp.getByRole('button', { name: /remove|delete/i }).count();\n    await tp.getByLabel('Criterion 1 title').fill('Accuracy');\n    await tp.getByLabel('Criterion 2 title').fill('Working');\n    await shot(tp, 'teacher-rubric-builder-1280');\n    await tp.getByRole('button', { name: 'Save draft' }).click();\n    await tp.waitForTimeout(3000);\n    const saved = await prisma.assignment.findFirst({ where: { title: 'UIV Created via form' }, include: { rubric: { include: { criteria: true } } } });\n    return { hydrated: ok, mismatchAlertOneCriterion: oneCrit, publishDisabledOnMismatch: publishDisabled, mismatchAlertCountTwoCriteria: twoCrit, reorderButtons: reorder, removeButtons: remove,\n      savedStatus: saved?.status, savedCriteria: saved?.rubric?.criteria.length, savedDueAt: saved?.dueAt, afterUrl: tp.url().replace(BASE, '') };\n  });\n  await step('teacher-edit-published-with-submissions', async () => {\n    const r = await go(tp, `${c}/${ids.a2}/edit`);\n    const alerts = await tp.getByRole('alert').allInnerTexts();\n    await shot(tp, 'teacher-assignment-edit-1280');\n    await hydrated(() => tp.getByRole('button', { name: 'Duplicate to other courses' }).click(), async () => (await tp.getByRole('dialog').count()) > 0);\n    await tp.waitForTimeout(500);\n    await shot(tp, 'teacher-duplicate-dialog-1280');\n    const dlg = await tp.getByRole('dialog').innerText().catch(() => null);\n    let duplicated = null;\n    try {\n      await tp.getByRole('dialog').getByLabel('Courses').click();\n      await tp.getByRole('option', { name: /UIV Maths B/ }).click();\n      await tp.getByRole('dialog').getByRole('button', { name: /^Duplicate/ }).click();\n      await tp.waitForTimeout(2500);\n      duplicated = await prisma.assignment.findFirst({ where: { courseId: ids.c2, title: 'UIV Reading log' }, select: { status: true, dueAt: true } });\n    } catch (e) { duplicated = 'error: ' + String(e).slice(0, 200); }\n    return { ...r, alerts, dialog: dlg, duplicated };\n  });\n  await step('teacher-grade-page', async () => {\n    const r = await go(tp, `${c}/${ids.a2}/grade`);\n    await tp.waitForTimeout(1000);\n    const list = await tp.getByRole('list', { name: 'Students' }).innerText().catch(() => null);\n    await shot(tp, 'teacher-grade-1280');\n    return { ...r, studentList: list, text: (await text(tp)).slice(0, 2500) };\n  });\n  await step('teacher-grade-late-student', async () => {\n    await hydrated(() => tp.getByRole('button', { name: /Morgan Late/ }).click(), async () => (await text(tp)).includes('Second attempt'));\n    await tp.waitForTimeout(500);\n    const penalty = await tp.getByLabel('Late penalty %').inputValue().catch(() => null);\n    const attemptSel = await tp.getByLabel('Attempt').count();\n    let historyShown = null;\n    try {\n      await tp.getByLabel('Attempt').click();\n      const opts = await tp.getByRole('option').allInnerTexts();\n      await tp.getByRole('option', { name: /1/ }).first().click();\n      await tp.waitForTimeout(400);\n      historyShown = { opts, firstAttemptVisible: (await text(tp)).includes('First attempt: chapters 1-2.') };\n      await tp.getByLabel('Attempt').click();\n      await tp.getByRole('option').last().click();\n    } catch (e) { historyShown = 'error: ' + String(e).slice(0, 200); }\n    const raw = tp.getByLabel(/Raw score/).first();\n    await raw.fill('9');\n    await tp.waitForTimeout(300);\n    const finalLive = await tp.getByLabel('Final score').inputValue().catch(() => null);\n    await shot(tp, 'teacher-grade-late-1280');\n    return { prefilledPenalty: penalty, attemptDropdown: attemptSel, historyShown, finalLive };\n  });\n  await step('teacher-grade-shortcuts', async () => {\n    const sel = async () => (await tp.locator('[aria-label=\"Students\"] .Mui-selected').innerText().catch(() => null));\n    await tp.locator('body').click({ position: { x: 5, y: 5 } }).catch(() => {});\n    await tp.locator('h1').first().click().catch(() => {});\n    const before = await sel();\n    await tp.keyboard.press('j'); await tp.waitForTimeout(500);\n    const afterJ = await sel();\n    await tp.keyboard.press('k'); await tp.waitForTimeout(500);\n    const afterK = await sel();\n    await tp.getByLabel('Feedback', { exact: true }).click().catch(() => {});\n    await tp.keyboard.press('j'); await tp.waitForTimeout(300);\n    const afterJInField = await sel();\n    return { before, afterJ, afterK, afterJInField };\n  });\n  await step('teacher-save-and-return', async () => {\n    await tp.getByRole('button', { name: /Morgan Late/ }).click();\n    await tp.waitForTimeout(500);\n    await tp.getByLabel(/Raw score/).first().fill('9');\n    await tp.getByLabel('Feedback', { exact: true }).fill('Late, but solid work.');\n    await tp.getByRole('button', { name: 'Save & return' }).click();\n    await tp.waitForTimeout(2500);\n    const s = await prisma.submission.findUnique({ where: { id: ids.sub2 } });\n    await shot(tp, 'teacher-grade-returned-1280');\n    return { status: s.status, rawScore: String(s.rawScore), penalty: String(s.penaltyPercent), finalScore: String(s.finalScore), returnedAt: s.returnedAt, snack: await tp.getByRole('alert').allInnerTexts() };\n  });\n  await step('teacher-offline-and-exempt', async () => {\n    await tp.getByRole('button', { name: /Jamie Missing/ }).click();\n    await tp.waitForTimeout(800);\n    const t1 = await text(tp);\n    await shot(tp, 'teacher-grade-not-submitted-1280');\n    const ex = tp.getByLabel('Exempt');\n    await ex.check();\n    await tp.waitForTimeout(2000);\n    const exRow = await prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: ids.a2, studentId: ids.s3 } } });\n    const t2 = await text(tp);\n    await shot(tp, 'teacher-grade-exempt-1280');\n    await ex.uncheck();\n    await tp.waitForTimeout(2000);\n    const exRow2 = await prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: ids.a2, studentId: ids.s3 } } });\n    return { gradeWithoutSubmissionShown: t1.includes('Grade without submission'), exemptWritten: !!exRow, exemptAlert: t2.includes('Exempt: excluded'), exemptDeleted: !exRow2 };\n  });\n  await step('teacher-offline-grade-no-submission-type', async () => {\n    const r = await go(tp, `${c}/${ids.a3}/grade`);\n    await tp.waitForTimeout(800);\n    await tp.getByRole('button', { name: /Alex Aardvark/ }).click();\n    await tp.waitForTimeout(500);\n    await tp.getByLabel(/Raw score/).first().fill('4');\n    await tp.getByRole('button', { name: /^Save$/ }).click();\n    await tp.waitForTimeout(2500);\n    const s = await prisma.submission.findFirst({ where: { assignmentId: ids.a3, studentId: ids.s1 } });\n    await shot(tp, 'teacher-grade-offline-1280');\n    return { ...r, created: s && { attemptNumber: s.attemptNumber, rawScore: String(s.rawScore), status: s.status, returnedAt: s.returnedAt } };\n  });\n\n  // ---------- STUDENT (desktop: submit; mobile: views) ----------\n  const sctx = await mob();\n  const sp = await login(sctx, 's1');\n  await step('student-nav', async () => {\n    await go(sp, '/dashboard');\n    const menu = sp.getByRole('button', { name: /menu|navigation|open drawer/i }).first();\n    if (await menu.count()) await menu.click().catch(() => {});\n    await sp.waitForTimeout(500);\n    return { navAssignments: await sp.getByRole('link', { name: 'Assignments' }).count() };\n  });\n  await step('student-course-assignments', async () => {\n    const r = await go(sp, c);\n    await shot(sp, 'student-course-assignments-375');\n    return { ...r, text: (await text(sp)).slice(0, 1500), hiddenDraftOrScheduled: !(await text(sp)).match(/UIV Draft essay|UIV Scheduled quiz/) };\n  });\n  await step('student-assignment-page-countdown', async () => {\n    const r = await go(sp, `${c}/${ids.a1}`);\n    await sp.waitForTimeout(1500);\n    const t = await text(sp);\n    await shot(sp, 'student-assignment-375');\n    return { ...r, countdown: (t.match(/Due in[^\\n]*/) || [null])[0], rubricTable: await sp.getByRole('table', { name: 'Rubric' }).count(),\n      scriptRenderedAsText: t.includes('<script>'), headingTask: await sp.getByRole('heading', { name: 'Task' }).count(),\n      latePolicy: (t.match(/[^\\n]*(late|penalty)[^\\n]*/i) || [null])[0], answerField: await sp.getByLabel('Your answer').count(), fileInput: await sp.getByLabel('Attach files').count(), overflowX: await sp.evaluate(() => document.documentElement.scrollWidth > window.innerWidth) };\n  });\n  await step('student-submit-dialog-receipt', async () => {\n    const ok = await hydrated(() => sp.getByLabel('Your answer').first().fill('My answers: 1/2, 3/4.'), async () => true, 3);\n    await sp.waitForTimeout(1200);\n    const ls = await sp.evaluate(() => Object.entries(localStorage).filter(([k]) => /draft|assign|submission/i.test(k)).map(([k, v]) => [k, v.slice(0, 60)]));\n    await sp.getByRole('button', { name: 'Submit', exact: true }).click();\n    await sp.waitForTimeout(500);\n    const dlg = await sp.getByRole('dialog').innerText().catch(() => null);\n    await shot(sp, 'student-submit-dialog-375');\n    const preCount = await prisma.submission.count({ where: { assignmentId: ids.a1, studentId: ids.s1 } });\n    await sp.getByRole('dialog').getByRole('button', { name: 'Submit' }).click();\n    await sp.waitForTimeout(2500);\n    const t = await text(sp);\n    await shot(sp, 'student-submitted-375');\n    return { filled: ok, localStorageDraft: ls, dialog: dlg, submissionBeforeConfirm: preCount, receipt: (t.match(/Submitted [A-Z][a-z]{2} [^\\n]*attempt[^\\n]*/) || [null])[0], awaiting: t.includes('Submitted — awaiting grading') };\n  });\n  await step('student-returned-view', async () => {\n    const r = await go(sp, `${c}/${ids.a2}`);\n    const t = await text(sp);\n    await shot(sp, 'student-returned-375');\n    return { ...r, text: t.slice(0, 1500), hasFeedback: t.includes('page numbers'), hasScore: /8(\\.00)?\\s*\\/\\s*10/.test(t) };\n  });\n  await step('student-assignments-page', async () => {\n    const r = await go(sp, '/assignments');\n    const tabs = await sp.getByRole('tab').allInnerTexts();\n    await shot(sp, 'student-assignments-upcoming-375');\n    const per = {};\n    for (const name of ['Missing', 'Submitted', 'Returned']) {\n      await hydrated(() => sp.getByRole('tab', { name: new RegExp(name) }).click(), async () => (await sp.getByRole('tab', { name: new RegExp(name), selected: true }).count()) > 0, 10);\n      await sp.waitForTimeout(400);\n      per[name] = (await sp.getByRole('tabpanel').innerText().catch(() => text(sp))).slice(0, 400);\n      await shot(sp, `student-assignments-${name.toLowerCase()}-375`);\n    }\n    const courseFilter = await sp.getByLabel(/Course/).count();\n    return { ...r, tabs, per, courseFilter };\n  });\n\n  // ---------- PARENT ----------\n  const pctx = await mob();\n  const pp = await login(pctx, 'parent');\n  await step('parent-assignments-page', async () => {\n    const r = await go(pp, '/assignments');\n    await shot(pp, 'parent-assignments-375');\n    const t = await text(pp);\n    const sel = await pp.getByLabel(/Child|Student/).count();\n    const menu = pp.getByRole('button', { name: /menu|navigation|open drawer/i }).first();\n    const nav = await pp.getByRole('link', { name: 'Assignments' }).count();\n    return { ...r, childSelector: sel, text: t.slice(0, 1000), submitControls: await pp.getByRole('button', { name: 'Submit' }).count(), nav, hasMenu: await menu.count() };\n  });\n  await step('parent-child-switch', async () => {\n    const r = await go(pp, `/assignments?studentId=${ids.s3}`);\n    await hydrated(() => pp.getByRole('tab', { name: /Missing/ }).click(), async () => (await pp.getByRole('tab', { name: /Missing/, selected: true }).count()) > 0, 10);\n    await pp.waitForTimeout(400);\n    await shot(pp, 'parent-assignments-missing-375');\n    return { ...r, text: (await text(pp)).slice(0, 800) };\n  });\n  await step('parent-assignment-readonly', async () => {\n    const r = await go(pp, `${c}/${ids.a1}?studentId=${ids.s1}`);\n    await shot(pp, 'parent-assignment-375');\n    const t = await text(pp);\n    return { ...r, awaiting: t.includes('Submitted — awaiting grading'), submitButtons: await pp.getByRole('button', { name: 'Submit' }).count(), answerField: await pp.getByLabel('Your answer').count(), text: t.slice(0, 800) };\n  });\n\n  // ---------- TEACHER to-grade, ADMIN student tab ----------\n  await step('teacher-to-grade', async () => {\n    const r = await go(tp, '/assignments');\n    await shot(tp, 'teacher-to-grade-1280');\n    return { ...r, text: (await text(tp)).slice(0, 800) };\n  });\n  const actx = await desk();\n  const ap = await login(actx, 'admin');\n  await step('admin-student-assignments-tab', async () => {\n    const r = await go(ap, `/students/${ids.s1}/assignments`);\n    await shot(ap, 'admin-student-assignments-1280');\n    return { ...r, tabs: await ap.getByRole('tab').allInnerTexts(), text: (await text(ap)).slice(0, 1000) };\n  });\n  await step('admin-course-assignments', async () => {\n    const r = await go(ap, c);\n    await shot(ap, 'admin-course-assignments-1280');\n    return { ...r, gradeButtons: await ap.getByRole('link', { name: 'Grade' }).count() };\n  });\n\n  await browser.close();\n})()\n  .catch((e) => { R.fatal = String(e); console.error(e); })\n  .finally(async () => {\n    try { await cleanup(); R.cleanedUp = true; } catch (e) { R.cleanupError = String(e); }\n    fs.writeFileSync(path.join(OUT, 'uiv-raw.json'), JSON.stringify(R, null, 1));\n    await prisma.$disconnect();\n  });\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CuzGBck2WDQEHUWo9eLL3m","type":"tool_result","content":"File created successfully at: /tmp/sh9-uiv/driver.cjs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"4d5985c3-c3cf-4564-ae4d-e780109f626c","uuid":"25a47e83-e809-4a8b-81a7-1e3c6f268661","timestamp":"2026-11-09T06:19:50.220Z","tool_use_result":{"type":"create","filePath":"/tmp/sh9-uiv/driver.cjs","content":"// Throwaway SH-9 UI verification driver. Lives outside the repo. Usage: node driver.cjs <repoDir> <outDir>\nconst path = require('path');\nconst fs = require('fs');\nconst [, , REPO, OUT] = process.argv;\nconst req = (m) => require(path.join(REPO, 'node_modules', m));\nconst { chromium } = req('playwright');\nconst { PrismaClient } = req('@prisma/client');\nconst bcrypt = req('bcrypt');\n\nconst BASE = 'http://localhost:3300';\nconst TAG = 'uiv-sh9';\nconst PW = 'Uiv-Sh9!2026-pass';\nconst email = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst SHOTS = path.join(OUT, 'screenshots');\nfs.mkdirSync(SHOTS, { recursive: true });\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {} };\nconst H = 3600_000, D = 24 * H;\n\nasync function cleanup() {\n  const courses = await prisma.course.findMany({ where: { code: { startsWith: TAG } }, select: { id: true } });\n  const cids = courses.map((c) => c.id);\n  const rubricIds = (await prisma.assignment.findMany({ where: { courseId: { in: cids } }, select: { rubricId: true } }))\n    .map((a) => a.rubricId).filter(Boolean);\n  await prisma.course.deleteMany({ where: { id: { in: cids } } });\n  await prisma.rubric.deleteMany({ where: { id: { in: rubricIds } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  for (const [model, field] of [['notification', 'userId'], ['fileObject', 'ownerId'], ['auditLog', 'actorId'], ['parentStudentLink', 'parentId'], ['session', 'userId']]) {\n    try { await prisma[model].deleteMany({ where: { [field]: { in: ids } } }); } catch {}\n  }\n  try { await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } }); } catch {}\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n}\n\nconst ids = {};\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, firstName, lastName, role) => prisma.user.create({ data: { email: email(n), firstName, lastName, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const admin = await mk('admin', 'Ada', 'Admin', 'ADMIN');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Morgan', 'Late', 'STUDENT');\n  const s3 = await mk('s3', 'Jamie', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s1.id, relationship: 'MOTHER', isPrimary: true } });\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s3.id, relationship: 'MOTHER', isPrimary: false } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  const c2 = await prisma.course.create({ data: { name: 'UIV Maths B', code: `${TAG}-b`, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id, notifiedAt: new Date() };\n  const rubric = await prisma.rubric.create({ data: {} });\n  const lv = (max) => [{ label: 'Excellent', points: String(max), description: '' }, { label: 'Good', points: String(max - 2), description: '' }, { label: 'Weak', points: '2', description: '' }];\n  const crA = await prisma.rubricCriterion.create({ data: { rubricId: rubric.id, title: 'Accuracy', maxPoints: '10', order: 0, levels: lv(10) } });\n  const crB = await prisma.rubricCriterion.create({ data: { rubricId: rubric.id, title: 'Working', maxPoints: '10', order: 1, levels: lv(10) } });\n  const a1 = await prisma.assignment.create({ data: { ...base, title: 'UIV Fractions worksheet', instructions: '## Task\\n\\nSolve **all** questions.\\n\\n- Q1\\n- Q2\\n\\n<script>alert(1)</script>', submissionType: 'TEXT_AND_FILE', maxPoints: '20', dueAt: new Date(now + 5 * H), allowLate: true, latePenaltyPercentPerDay: '10', maxLatePenaltyPercent: '30', maxFileCount: 2, status: 'PUBLISHED', rubricId: rubric.id } });\n  const a2 = await prisma.assignment.create({ data: { ...base, title: 'UIV Reading log', instructions: 'Write a short reading log.', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now - 2 * D - H), allowLate: true, latePenaltyPercentPerDay: '10', maxLatePenaltyPercent: '50', status: 'PUBLISHED' } });\n  const a3 = await prisma.assignment.create({ data: { ...base, title: 'UIV Lab safety demo', submissionType: 'NO_SUBMISSION', maxPoints: '5', dueAt: new Date(now - D), status: 'PUBLISHED' } });\n  const a4 = await prisma.assignment.create({ data: { ...base, title: 'UIV Draft essay', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 7 * D), status: 'DRAFT', notifiedAt: null } });\n  const a5 = await prisma.assignment.create({ data: { ...base, title: 'UIV Scheduled quiz', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 9 * D), availableFrom: new Date(now + 3 * D), status: 'SCHEDULED', notifiedAt: null } });\n  // s1 on a2: returned, 8/10 with feedback\n  await prisma.submission.create({ data: { assignmentId: a2.id, studentId: s1.id, status: 'RETURNED', text: 'I read *Holes* chapters 1-4.', attemptNumber: 1, submittedAt: new Date(now - 3 * D), rawScore: '8', penaltyPercent: '0', finalScore: '8', feedback: 'Good summary — add **page numbers** next time.', gradedById: t.id, gradedAt: new Date(now - D), returnedAt: new Date(now - D) } });\n  // s2 on a2: late by 2 days (submitted dueAt+1day+1h → ceil = 2 days), attempt 2 with history\n  const sub2 = await prisma.submission.create({ data: { assignmentId: a2.id, studentId: s2.id, status: 'SUBMITTED', text: 'Second attempt: chapters 1-6 summary.', attemptNumber: 2, submittedAt: new Date(now - 2 * D - H + D + H), isLate: true, lateDays: 1 } });\n  await prisma.submissionHistory.create({ data: { submissionId: sub2.id, attemptNumber: 1, text: 'First attempt: chapters 1-2.', fileIds: [], submittedAt: new Date(now - 2 * D - 2 * H) } });\n  Object.assign(ids, { t: t.id, admin: admin.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, c2: c2.id, a1: a1.id, a2: a2.id, a3: a3.id, a4: a4.id, a5: a5.id, crA: crA.id, crB: crB.id, sub2: sub2.id });\n  R.fixtures = ids;\n}\n\nasync function login(ctx, who) {\n  const page = await ctx.newPage();\n  const { csrfToken } = await (await page.request.get(`${BASE}/api/auth/csrf`)).json();\n  await page.request.post(`${BASE}/api/auth/callback/credentials`, { form: { email: email(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get(`${BASE}/api/auth/session`)).json();\n  if (s?.user?.email !== email(who)) throw new Error(`login failed for ${who}`);\n  const errs = (R.consoleErrors[who] ||= []);\n  page.on('console', (m) => { if (m.type() === 'error') errs.push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => errs.push('pageerror: ' + String(e).slice(0, 300)));\n  return page;\n}\n\nasync function step(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 4).join(' | ') }; }\n  console.log(name, R.results[name].ok ? 'OK' : 'FAIL ' + R.results[name].error);\n}\nconst shot = (page, n) => page.screenshot({ path: path.join(SHOTS, `${n}.png`), fullPage: true });\nasync function go(page, p) {\n  const res = await page.goto(BASE + p, { waitUntil: 'networkidle', timeout: 90_000 });\n  return { status: res.status(), finalUrl: page.url().replace(BASE, '') };\n}\nconst text = (page) => page.locator('main').innerText().catch(() => page.locator('body').innerText());\nasync function hydrated(fn, check, tries = 15) {\n  for (let i = 0; i < tries; i++) { try { await fn(); if (await check()) return true; } catch {} await new Promise((r) => setTimeout(r, 1000)); }\n  return false;\n}\n\n(async () => {\n  await setup();\n  const browser = await chromium.launch();\n  const desk = () => browser.newContext({ viewport: { width: 1280, height: 800 }, bypassCSP: true, timezoneId: 'UTC' });\n  const mob = () => browser.newContext({ viewport: { width: 375, height: 667 }, bypassCSP: true, timezoneId: 'UTC' });\n  const c = `/courses/${ids.c1}/assignments`;\n\n  // ---------- TEACHER ----------\n  const tctx = await desk();\n  const tp = await login(tctx, 'teacher');\n  await step('teacher-nav', async () => {\n    const r = await go(tp, '/dashboard');\n    return { ...r, navAssignments: await tp.getByRole('link', { name: 'Assignments' }).count() };\n  });\n  await step('teacher-course-assignments-table', async () => {\n    const r = await go(tp, c);\n    await shot(tp, 'teacher-course-assignments-1280');\n    return { ...r, courseTab: await tp.getByRole('tab', { name: 'Assignments' }).count() + await tp.getByRole('link', { name: 'Assignments' }).count(),\n      headers: await tp.getByRole('columnheader').allInnerTexts(), gradeButtons: await tp.getByRole('link', { name: 'Grade' }).count() + await tp.getByRole('button', { name: 'Grade' }).count(),\n      text: (await text(tp)).slice(0, 1500) };\n  });\n  await step('teacher-new-form', async () => {\n    const r = await go(tp, `${c}/new`);\n    const due = await tp.getByLabel('Due').first().inputValue().catch(() => null);\n    const dueGroup = await tp.locator('text=School time').first().innerText().catch(() => null);\n    const pickerText = await tp.locator('.MuiPickersInputBase-root, .MuiPickersSectionList-root').first().innerText().catch(() => null);\n    await shot(tp, 'teacher-assignment-new-1280');\n    const buttons = await tp.getByRole('button').allInnerTexts();\n    return { ...r, dueValue: due, pickerText, dueHelper: dueGroup, buttons: buttons.filter((b) => b.trim()), labels: await tp.locator('label').allInnerTexts() };\n  });\n  await step('teacher-rubric-builder', async () => {\n    await tp.getByLabel('Title').fill('UIV Created via form');\n    await tp.getByLabel('Max points').first().fill('20');\n    const ok = await hydrated(() => tp.getByLabel('Grade with a rubric').check(), async () => (await tp.getByRole('button', { name: 'Add criterion' }).count()) > 0);\n    await tp.getByRole('button', { name: 'Add criterion' }).click();\n    await tp.waitForTimeout(400);\n    const oneCrit = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).allInnerTexts();\n    await shot(tp, 'teacher-rubric-mismatch-1280');\n    const publishDisabled = await tp.getByRole('button', { name: 'Publish' }).isDisabled();\n    await tp.getByRole('button', { name: 'Add criterion' }).click();\n    await tp.waitForTimeout(400);\n    const twoCrit = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).count();\n    const reorder = await tp.getByRole('button', { name: /move|up|down/i }).count();\n    const remove = await tp.getByRole('button', { name: /remove|delete/i }).count();\n    await tp.getByLabel('Criterion 1 title').fill('Accuracy');\n    await tp.getByLabel('Criterion 2 title').fill('Working');\n    await shot(tp, 'teacher-rubric-builder-1280');\n    await tp.getByRole('button', { name: 'Save draft' }).click();\n    await tp.waitForTimeout(3000);\n    const saved = await prisma.assignment.findFirst({ where: { title: 'UIV Created via form' }, include: { rubric: { include: { criteria: true } } } });\n    return { hydrated: ok, mismatchAlertOneCriterion: oneCrit, publishDisabledOnMismatch: publishDisabled, mismatchAlertCountTwoCriteria: twoCrit, reorderButtons: reorder, removeButtons: remove,\n      savedStatus: saved?.status, savedCriteria: saved?.rubric?.criteria.length, savedDueAt: saved?.dueAt, afterUrl: tp.url().replace(BASE, '') };\n  });\n  await step('teacher-edit-published-with-submissions', async () => {\n    const r = await go(tp, `${c}/${ids.a2}/edit`);\n    const alerts = await tp.getByRole('alert').allInnerTexts();\n    await shot(tp, 'teacher-assignment-edit-1280');\n    await hydrated(() => tp.getByRole('button', { name: 'Duplicate to other courses' }).click(), async () => (await tp.getByRole('dialog').count()) > 0);\n    await tp.waitForTimeout(500);\n    await shot(tp, 'teacher-duplicate-dialog-1280');\n    const dlg = await tp.getByRole('dialog').innerText().catch(() => null);\n    let duplicated = null;\n    try {\n      await tp.getByRole('dialog').getByLabel('Courses').click();\n      await tp.getByRole('option', { name: /UIV Maths B/ }).click();\n      await tp.getByRole('dialog').getByRole('button', { name: /^Duplicate/ }).click();\n      await tp.waitForTimeout(2500);\n      duplicated = await prisma.assignment.findFirst({ where: { courseId: ids.c2, title: 'UIV Reading log' }, select: { status: true, dueAt: true } });\n    } catch (e) { duplicated = 'error: ' + String(e).slice(0, 200); }\n    return { ...r, alerts, dialog: dlg, duplicated };\n  });\n  await step('teacher-grade-page', async () => {\n    const r = await go(tp, `${c}/${ids.a2}/grade`);\n    await tp.waitForTimeout(1000);\n    const list = await tp.getByRole('list', { name: 'Students' }).innerText().catch(() => null);\n    await shot(tp, 'teacher-grade-1280');\n    return { ...r, studentList: list, text: (await text(tp)).slice(0, 2500) };\n  });\n  await step('teacher-grade-late-student', async () => {\n    await hydrated(() => tp.getByRole('button', { name: /Morgan Late/ }).click(), async () => (await text(tp)).includes('Second attempt'));\n    await tp.waitForTimeout(500);\n    const penalty = await tp.getByLabel('Late penalty %').inputValue().catch(() => null);\n    const attemptSel = await tp.getByLabel('Attempt').count();\n    let historyShown = null;\n    try {\n      await tp.getByLabel('Attempt').click();\n      const opts = await tp.getByRole('option').allInnerTexts();\n      await tp.getByRole('option', { name: /1/ }).first().click();\n      await tp.waitForTimeout(400);\n      historyShown = { opts, firstAttemptVisible: (await text(tp)).includes('First attempt: chapters 1-2.') };\n      await tp.getByLabel('Attempt').click();\n      await tp.getByRole('option').last().click();\n    } catch (e) { historyShown = 'error: ' + String(e).slice(0, 200); }\n    const raw = tp.getByLabel(/Raw score/).first();\n    await raw.fill('9');\n    await tp.waitForTimeout(300);\n    const finalLive = await tp.getByLabel('Final score').inputValue().catch(() => null);\n    await shot(tp, 'teacher-grade-late-1280');\n    return { prefilledPenalty: penalty, attemptDropdown: attemptSel, historyShown, finalLive };\n  });\n  await step('teacher-grade-shortcuts', async () => {\n    const sel = async () => (await tp.locator('[aria-label=\"Students\"] .Mui-selected').innerText().catch(() => null));\n    await tp.locator('body').click({ position: { x: 5, y: 5 } }).catch(() => {});\n    await tp.locator('h1').first().click().catch(() => {});\n    const before = await sel();\n    await tp.keyboard.press('j'); await tp.waitForTimeout(500);\n    const afterJ = await sel();\n    await tp.keyboard.press('k'); await tp.waitForTimeout(500);\n    const afterK = await sel();\n    await tp.getByLabel('Feedback', { exact: true }).click().catch(() => {});\n    await tp.keyboard.press('j'); await tp.waitForTimeout(300);\n    const afterJInField = await sel();\n    return { before, afterJ, afterK, afterJInField };\n  });\n  await step('teacher-save-and-return', async () => {\n    await tp.getByRole('button', { name: /Morgan Late/ }).click();\n    await tp.waitForTimeout(500);\n    await tp.getByLabel(/Raw score/).first().fill('9');\n    await tp.getByLabel('Feedback', { exact: true }).fill('Late, but solid work.');\n    await tp.getByRole('button', { name: 'Save & return' }).click();\n    await tp.waitForTimeout(2500);\n    const s = await prisma.submission.findUnique({ where: { id: ids.sub2 } });\n    await shot(tp, 'teacher-grade-returned-1280');\n    return { status: s.status, rawScore: String(s.rawScore), penalty: String(s.penaltyPercent), finalScore: String(s.finalScore), returnedAt: s.returnedAt, snack: await tp.getByRole('alert').allInnerTexts() };\n  });\n  await step('teacher-offline-and-exempt', async () => {\n    await tp.getByRole('button', { name: /Jamie Missing/ }).click();\n    await tp.waitForTimeout(800);\n    const t1 = await text(tp);\n    await shot(tp, 'teacher-grade-not-submitted-1280');\n    const ex = tp.getByLabel('Exempt');\n    await ex.check();\n    await tp.waitForTimeout(2000);\n    const exRow = await prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: ids.a2, studentId: ids.s3 } } });\n    const t2 = await text(tp);\n    await shot(tp, 'teacher-grade-exempt-1280');\n    await ex.uncheck();\n    await tp.waitForTimeout(2000);\n    const exRow2 = await prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: ids.a2, studentId: ids.s3 } } });\n    return { gradeWithoutSubmissionShown: t1.includes('Grade without submission'), exemptWritten: !!exRow, exemptAlert: t2.includes('Exempt: excluded'), exemptDeleted: !exRow2 };\n  });\n  await step('teacher-offline-grade-no-submission-type', async () => {\n    const r = await go(tp, `${c}/${ids.a3}/grade`);\n    await tp.waitForTimeout(800);\n    await tp.getByRole('button', { name: /Alex Aardvark/ }).click();\n    await tp.waitForTimeout(500);\n    await tp.getByLabel(/Raw score/).first().fill('4');\n    await tp.getByRole('button', { name: /^Save$/ }).click();\n    await tp.waitForTimeout(2500);\n    const s = await prisma.submission.findFirst({ where: { assignmentId: ids.a3, studentId: ids.s1 } });\n    await shot(tp, 'teacher-grade-offline-1280');\n    return { ...r, created: s && { attemptNumber: s.attemptNumber, rawScore: String(s.rawScore), status: s.status, returnedAt: s.returnedAt } };\n  });\n\n  // ---------- STUDENT (desktop: submit; mobile: views) ----------\n  const sctx = await mob();\n  const sp = await login(sctx, 's1');\n  await step('student-nav', async () => {\n    await go(sp, '/dashboard');\n    const menu = sp.getByRole('button', { name: /menu|navigation|open drawer/i }).first();\n    if (await menu.count()) await menu.click().catch(() => {});\n    await sp.waitForTimeout(500);\n    return { navAssignments: await sp.getByRole('link', { name: 'Assignments' }).count() };\n  });\n  await step('student-course-assignments', async () => {\n    const r = await go(sp, c);\n    await shot(sp, 'student-course-assignments-375');\n    return { ...r, text: (await text(sp)).slice(0, 1500), hiddenDraftOrScheduled: !(await text(sp)).match(/UIV Draft essay|UIV Scheduled quiz/) };\n  });\n  await step('student-assignment-page-countdown', async () => {\n    const r = await go(sp, `${c}/${ids.a1}`);\n    await sp.waitForTimeout(1500);\n    const t = await text(sp);\n    await shot(sp, 'student-assignment-375');\n    return { ...r, countdown: (t.match(/Due in[^\\n]*/) || [null])[0], rubricTable: await sp.getByRole('table', { name: 'Rubric' }).count(),\n      scriptRenderedAsText: t.includes('<script>'), headingTask: await sp.getByRole('heading', { name: 'Task' }).count(),\n      latePolicy: (t.match(/[^\\n]*(late|penalty)[^\\n]*/i) || [null])[0], answerField: await sp.getByLabel('Your answer').count(), fileInput: await sp.getByLabel('Attach files').count(), overflowX: await sp.evaluate(() => document.documentElement.scrollWidth > window.innerWidth) };\n  });\n  await step('student-submit-dialog-receipt', async () => {\n    const ok = await hydrated(() => sp.getByLabel('Your answer').first().fill('My answers: 1/2, 3/4.'), async () => true, 3);\n    await sp.waitForTimeout(1200);\n    const ls = await sp.evaluate(() => Object.entries(localStorage).filter(([k]) => /draft|assign|submission/i.test(k)).map(([k, v]) => [k, v.slice(0, 60)]));\n    await sp.getByRole('button', { name: 'Submit', exact: true }).click();\n    await sp.waitForTimeout(500);\n    const dlg = await sp.getByRole('dialog').innerText().catch(() => null);\n    await shot(sp, 'student-submit-dialog-375');\n    const preCount = await prisma.submission.count({ where: { assignmentId: ids.a1, studentId: ids.s1 } });\n    await sp.getByRole('dialog').getByRole('button', { name: 'Submit' }).click();\n    await sp.waitForTimeout(2500);\n    const t = await text(sp);\n    await shot(sp, 'student-submitted-375');\n    return { filled: ok, localStorageDraft: ls, dialog: dlg, submissionBeforeConfirm: preCount, receipt: (t.match(/Submitted [A-Z][a-z]{2} [^\\n]*attempt[^\\n]*/) || [null])[0], awaiting: t.includes('Submitted — awaiting grading') };\n  });\n  await step('student-returned-view', async () => {\n    const r = await go(sp, `${c}/${ids.a2}`);\n    const t = await text(sp);\n    await shot(sp, 'student-returned-375');\n    return { ...r, text: t.slice(0, 1500), hasFeedback: t.includes('page numbers'), hasScore: /8(\\.00)?\\s*\\/\\s*10/.test(t) };\n  });\n  await step('student-assignments-page', async () => {\n    const r = await go(sp, '/assignments');\n    const tabs = await sp.getByRole('tab').allInnerTexts();\n    await shot(sp, 'student-assignments-upcoming-375');\n    const per = {};\n    for (const name of ['Missing', 'Submitted', 'Returned']) {\n      await hydrated(() => sp.getByRole('tab', { name: new RegExp(name) }).click(), async () => (await sp.getByRole('tab', { name: new RegExp(name), selected: true }).count()) > 0, 10);\n      await sp.waitForTimeout(400);\n      per[name] = (await sp.getByRole('tabpanel').innerText().catch(() => text(sp))).slice(0, 400);\n      await shot(sp, `student-assignments-${name.toLowerCase()}-375`);\n    }\n    const courseFilter = await sp.getByLabel(/Course/).count();\n    return { ...r, tabs, per, courseFilter };\n  });\n\n  // ---------- PARENT ----------\n  const pctx = await mob();\n  const pp = await login(pctx, 'parent');\n  await step('parent-assignments-page', async () => {\n    const r = await go(pp, '/assignments');\n    await shot(pp, 'parent-assignments-375');\n    const t = await text(pp);\n    const sel = await pp.getByLabel(/Child|Student/).count();\n    const menu = pp.getByRole('button', { name: /menu|navigation|open drawer/i }).first();\n    const nav = await pp.getByRole('link', { name: 'Assignments' }).count();\n    return { ...r, childSelector: sel, text: t.slice(0, 1000), submitControls: await pp.getByRole('button', { name: 'Submit' }).count(), nav, hasMenu: await menu.count() };\n  });\n  await step('parent-child-switch', async () => {\n    const r = await go(pp, `/assignments?studentId=${ids.s3}`);\n    await hydrated(() => pp.getByRole('tab', { name: /Missing/ }).click(), async () => (await pp.getByRole('tab', { name: /Missing/, selected: true }).count()) > 0, 10);\n    await pp.waitForTimeout(400);\n    await shot(pp, 'parent-assignments-missing-375');\n    return { ...r, text: (await text(pp)).slice(0, 800) };\n  });\n  await step('parent-assignment-readonly', async () => {\n    const r = await go(pp, `${c}/${ids.a1}?studentId=${ids.s1}`);\n    await shot(pp, 'parent-assignment-375');\n    const t = await text(pp);\n    return { ...r, awaiting: t.includes('Submitted — awaiting grading'), submitButtons: await pp.getByRole('button', { name: 'Submit' }).count(), answerField: await pp.getByLabel('Your answer').count(), text: t.slice(0, 800) };\n  });\n\n  // ---------- TEACHER to-grade, ADMIN student tab ----------\n  await step('teacher-to-grade', async () => {\n    const r = await go(tp, '/assignments');\n    await shot(tp, 'teacher-to-grade-1280');\n    return { ...r, text: (await text(tp)).slice(0, 800) };\n  });\n  const actx = await desk();\n  const ap = await login(actx, 'admin');\n  await step('admin-student-assignments-tab', async () => {\n    const r = await go(ap, `/students/${ids.s1}/assignments`);\n    await shot(ap, 'admin-student-assignments-1280');\n    return { ...r, tabs: await ap.getByRole('tab').allInnerTexts(), text: (await text(ap)).slice(0, 1000) };\n  });\n  await step('admin-course-assignments', async () => {\n    const r = await go(ap, c);\n    await shot(ap, 'admin-course-assignments-1280');\n    return { ...r, gradeButtons: await ap.getByRole('link', { name: 'Grade' }).count() };\n  });\n\n  await browser.close();\n})()\n  .catch((e) => { R.fatal = String(e); console.error(e); })\n  .finally(async () => {\n    try { await cleanup(); R.cleanedUp = true; } catch (e) { R.cleanupError = String(e); }\n    fs.writeFileSync(path.join(OUT, 'uiv-raw.json'), JSON.stringify(R, null, 1));\n    await prisma.$disconnect();\n  });\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01CuzGBck2WDQEHUWo9eLL3m","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
