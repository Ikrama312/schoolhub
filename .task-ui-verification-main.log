{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ANiCaTJrP4cCAHrCS4ywjA","type":"tool_result","content":"// SH-10 UI verification driver. Throwaway; lives outside the repo. Run with cwd = repo (for node_modules).\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst AxeBuilder = require('@axe-core/playwright').default;\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/forge/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh10';\nconst PW = 'Uiv-Sh10!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst H = 3600_000, D = 24 * H;\n\nasync function cleanup() {\n  await prisma.course.deleteMany({ where: { code: { startsWith: TAG } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.quizAttempt.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.notification.deleteMany({ where: { userId: { in: ids } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.fileObject.deleteMany({ where: { ownerId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n}\n\nconst OPTS = [{ id: 'o1', text: '1/2' }, { id: 'o2', text: '2/3' }, { id: 'o3', text: '3/4' }, { id: 'o4', text: '2/4' }];\nconst QSET = [\n  { type: 'SINGLE_CHOICE', prompt: 'Which fraction is **largest**?', points: '2', options: OPTS, correct: { optionId: 'o3' }, explanation: '3/4 = 0.75.' },\n  { type: 'MULTIPLE_CHOICE', prompt: 'Select every fraction equal to one half.', points: '4', options: OPTS, correct: { optionIds: ['o1', 'o4'] }, explanation: '2/4 simplifies to 1/2.' },\n  { type: 'TRUE_FALSE', prompt: '5/5 equals 1.', points: '1', correct: { value: true } },\n  { type: 'SHORT_ANSWER', prompt: 'Name the bottom number of a fraction.', points: '1', correct: { accepted: ['denominator'] } },\n  { type: 'ESSAY', prompt: 'Explain how you compare two fractions.', points: '4', correct: { guidance: 'Common denominator or decimals.' } },\n];\n\nasync function mkQuiz(data, qs) {\n  const quiz = await prisma.quiz.create({ data });\n  const questions = [];\n  for (const [i, q] of qs.entries()) questions.push(await prisma.question.create({ data: { ...q, quizId: quiz.id, order: i } }));\n  return { quiz, questions };\n}\nasync function mkAttempt(quiz, questions, studentId, n, status, answers, extra = {}) {\n  const max = questions.reduce((s, q) => s + Number(q.points), 0);\n  const score = status === 'GRADED' ? answers.reduce((s, a) => s + Number(a.pointsAwarded ?? 0), 0) : null;\n  const a = await prisma.quizAttempt.create({ data: { quizId: quiz.id, studentId, attemptNumber: n, status, startedAt: new Date(Date.now() - 2 * D), submittedAt: new Date(Date.now() - 2 * D + 12 * 60_000), questionOrder: questions.map((q) => q.id), maxScore: String(max), score: score == null ? null : String(score), ...extra } });\n  for (const [i, ans] of answers.entries()) if (ans) await prisma.quizAnswer.create({ data: { attemptId: a.id, questionId: questions[i].id, ...ans } });\n  return a;\n}\n\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Blake', 'Bell', 'STUDENT');\n  const s3 = await mk('s3', 'Morgan', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s2.id, relationship: 'MOTHER', isPrimary: true } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id };\n  // qA: open, IMMEDIATELY, 20 min, 2 attempts; s1 takes it live through the UI. s2 has one graded attempt (analytics data).\n  const A = await mkQuiz({ ...base, title: 'UIV Fractions check', instructions: 'Answer **all** questions. Calculators allowed.', availableFrom: new Date(now - D), availableUntil: new Date(now + 2 * D), timeLimitMinutes: 20, maxAttempts: 2, resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: true, status: 'PUBLISHED' }, QSET);\n  const qa = A.questions;\n  await mkAttempt(A.quiz, qa, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o2' }, pointsAwarded: '0', isCorrect: false },\n    { response: { optionIds: ['o1'] }, pointsAwarded: '2', isCorrect: false },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'Denominator' }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'I turn them into decimals.' }, pointsAwarded: '3', isCorrect: null, feedback: 'Good, show an example next time.', gradedById: t.id },\n  ]);\n  // qB: upcoming (AFTER_CLOSE).\n  const B = await mkQuiz({ ...base, title: 'UIV Unit 1 test', availableFrom: new Date(now + 2 * D), availableUntil: new Date(now + 3 * D), timeLimitMinutes: 45, resultsVisibility: 'AFTER_CLOSE', status: 'PUBLISHED' }, QSET.slice(0, 3));\n  // qC: closed; s2 graded (parent sees it, released via IMMEDIATELY); s3 never attempted → Missed.\n  const C = await mkQuiz({ ...base, title: 'UIV Decimals quick check', availableFrom: new Date(now - 5 * D), availableUntil: new Date(now - D), resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: false, status: 'CLOSED' }, QSET.slice(0, 3));\n  const cAtt = await mkAttempt(C.quiz, C.questions, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o2'] }, pointsAwarded: '0', isCorrect: false },\n    { response: { value: false }, pointsAwarded: '0', isCorrect: false },\n  ]);\n  // qD: draft with an unfinished choice question → publish checklist.\n  const Dq = await mkQuiz({ ...base, title: 'UIV Draft quiz', availableFrom: new Date(now + D), availableUntil: new Date(now + 2 * D), status: 'DRAFT' }, [{ type: 'SINGLE_CHOICE', prompt: 'Draft question', points: '1', options: OPTS.slice(0, 2), correct: {} }]);\n  // qE: MANUAL results; s3 submitted, awaiting release.\n  const E = await mkQuiz({ ...base, title: 'UIV Manual-release quiz', availableFrom: new Date(now - D), availableUntil: new Date(now + D), resultsVisibility: 'MANUAL', status: 'PUBLISHED', maxAttempts: 1 }, QSET.slice(0, 3));\n  const eAtt = await mkAttempt(E.quiz, E.questions, s3.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o4'] }, pointsAwarded: '4', isCorrect: true },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n  ]);\n  // qF: practice, one-per-page, 1-minute limit → red timer + navigator (s3).\n  const F = await mkQuiz({ ...base, title: 'UIV Practice sprint', isPractice: true, availableFrom: new Date(now - D), availableUntil: new Date(now + D), timeLimitMinutes: 1, maxAttempts: 3, oneQuestionPerPage: true, resultsVisibility: 'IMMEDIATELY', status: 'PUBLISHED' }, QSET.slice(0, 4));\n  Object.assign(R.fixtures, { t: t.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, qA: A.quiz.id, qB: B.quiz.id, qC: C.quiz.id, qD: Dq.quiz.id, qE: E.quiz.id, qF: F.quiz.id, cAtt: cAtt.id, eAtt: eAtt.id });\n  return R.fixtures;\n}\n\nlet browser;\nasync function ctxFor(who, width) {\n  const ctx = await browser.newContext({ baseURL: BASE, bypassCSP: true, viewport: { width, height: width < 600 ? 667 : 800 } });\n  const page = await ctx.newPage();\n  R.consoleErrors[who] ??= [];\n  page.on('console', (m) => { if (m.type() === 'error') R.consoleErrors[who].push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => R.consoleErrors[who].push('PAGEERROR ' + String(e).slice(0, 300)));\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  await page.request.post('/api/auth/callback/credentials', { form: { email: em(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get('/api/auth/session')).json();\n  if (s?.user?.email !== em(who)) throw new Error('sign-in failed for ' + who);\n  return { ctx, page };\n}\nconst txt = async (page) => (await page.locator('main').first().innerText().catch(() => page.locator('body').innerText())).slice(0, 1500);\nasync function go(page, url, waitText) {\n  const res = await page.goto(url, { waitUntil: 'load', timeout: 60_000 });\n  if (waitText) await page.getByText(waitText).first().waitFor({ timeout: 20_000 });\n  await page.waitForTimeout(800);\n  return { status: res?.status(), finalUrl: new URL(page.url()).pathname };\n}\nasync function check(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 3).join(' | ') }; }\n  console.log(name, R.results[name].ok, R.results[name].error ?? '');\n}\nconst shot = (page, n) => page.screenshot({ path: `${SHOTS}/${n}.png`, fullPage: true, timeout: 60_000 }).catch(() => page.screenshot({ path: `${SHOTS}/${n}.png`, timeout: 60_000 }));\nconst overflowX = (page) => page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\nconst axe = async (page) => (await new AxeBuilder({ page }).include('main').analyze()).violations.map((v) => `${v.id} (${v.impact}) x${v.nodes.length}`);\nasync function hydrated(fn, timeout = 15_000) { const end = Date.now() + timeout; let e; while (Date.now() < end) { try { return await fn(); } catch (x) { e = x; await new Promise((r) => setTimeout(r, 500)); } } throw e; }\n\n(async () => {\n  fs.rmSync(SHOTS, { recursive: true, force: true }); fs.mkdirSync(SHOTS, { recursive: true });\n  const f = await setup();\n  browser = await chromium.launch();\n  const CQ = `/courses/${f.c1}/quizzes`;\n  try {\n    // ---------- TEACHER (1280) ----------\n    const T = await ctxFor('teacher', 1280); const tp = T.page;\n    await check('teacher-course-quizzes-tab', async () => {","is_error":false}]},"parent_tool_use_id":null,"session_id":"95715b00-b89d-488d-810b-cf963fb0733f","uuid":"29241fb8-8b6a-42a7-81ba-2f288c0364f2","timestamp":"2026-11-09T14:43:23.450Z","tool_use_result":{"stdout":"// SH-10 UI verification driver. Throwaway; lives outside the repo. Run with cwd = repo (for node_modules).\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst AxeBuilder = require('@axe-core/playwright').default;\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/forge/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh10';\nconst PW = 'Uiv-Sh10!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst H = 3600_000, D = 24 * H;\n\nasync function cleanup() {\n  await prisma.course.deleteMany({ where: { code: { startsWith: TAG } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.quizAttempt.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.notification.deleteMany({ where: { userId: { in: ids } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.fileObject.deleteMany({ where: { ownerId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n}\n\nconst OPTS = [{ id: 'o1', text: '1/2' }, { id: 'o2', text: '2/3' }, { id: 'o3', text: '3/4' }, { id: 'o4', text: '2/4' }];\nconst QSET = [\n  { type: 'SINGLE_CHOICE', prompt: 'Which fraction is **largest**?', points: '2', options: OPTS, correct: { optionId: 'o3' }, explanation: '3/4 = 0.75.' },\n  { type: 'MULTIPLE_CHOICE', prompt: 'Select every fraction equal to one half.', points: '4', options: OPTS, correct: { optionIds: ['o1', 'o4'] }, explanation: '2/4 simplifies to 1/2.' },\n  { type: 'TRUE_FALSE', prompt: '5/5 equals 1.', points: '1', correct: { value: true } },\n  { type: 'SHORT_ANSWER', prompt: 'Name the bottom number of a fraction.', points: '1', correct: { accepted: ['denominator'] } },\n  { type: 'ESSAY', prompt: 'Explain how you compare two fractions.', points: '4', correct: { guidance: 'Common denominator or decimals.' } },\n];\n\nasync function mkQuiz(data, qs) {\n  const quiz = await prisma.quiz.create({ data });\n  const questions = [];\n  for (const [i, q] of qs.entries()) questions.push(await prisma.question.create({ data: { ...q, quizId: quiz.id, order: i } }));\n  return { quiz, questions };\n}\nasync function mkAttempt(quiz, questions, studentId, n, status, answers, extra = {}) {\n  const max = questions.reduce((s, q) => s + Number(q.points), 0);\n  const score = status === 'GRADED' ? answers.reduce((s, a) => s + Number(a.pointsAwarded ?? 0), 0) : null;\n  const a = await prisma.quizAttempt.create({ data: { quizId: quiz.id, studentId, attemptNumber: n, status, startedAt: new Date(Date.now() - 2 * D), submittedAt: new Date(Date.now() - 2 * D + 12 * 60_000), questionOrder: questions.map((q) => q.id), maxScore: String(max), score: score == null ? null : String(score), ...extra } });\n  for (const [i, ans] of answers.entries()) if (ans) await prisma.quizAnswer.create({ data: { attemptId: a.id, questionId: questions[i].id, ...ans } });\n  return a;\n}\n\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Blake', 'Bell', 'STUDENT');\n  const s3 = await mk('s3', 'Morgan', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s2.id, relationship: 'MOTHER', isPrimary: true } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id };\n  // qA: open, IMMEDIATELY, 20 min, 2 attempts; s1 takes it live through the UI. s2 has one graded attempt (analytics data).\n  const A = await mkQuiz({ ...base, title: 'UIV Fractions check', instructions: 'Answer **all** questions. Calculators allowed.', availableFrom: new Date(now - D), availableUntil: new Date(now + 2 * D), timeLimitMinutes: 20, maxAttempts: 2, resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: true, status: 'PUBLISHED' }, QSET);\n  const qa = A.questions;\n  await mkAttempt(A.quiz, qa, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o2' }, pointsAwarded: '0', isCorrect: false },\n    { response: { optionIds: ['o1'] }, pointsAwarded: '2', isCorrect: false },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'Denominator' }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'I turn them into decimals.' }, pointsAwarded: '3', isCorrect: null, feedback: 'Good, show an example next time.', gradedById: t.id },\n  ]);\n  // qB: upcoming (AFTER_CLOSE).\n  const B = await mkQuiz({ ...base, title: 'UIV Unit 1 test', availableFrom: new Date(now + 2 * D), availableUntil: new Date(now + 3 * D), timeLimitMinutes: 45, resultsVisibility: 'AFTER_CLOSE', status: 'PUBLISHED' }, QSET.slice(0, 3));\n  // qC: closed; s2 graded (parent sees it, released via IMMEDIATELY); s3 never attempted → Missed.\n  const C = await mkQuiz({ ...base, title: 'UIV Decimals quick check', availableFrom: new Date(now - 5 * D), availableUntil: new Date(now - D), resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: false, status: 'CLOSED' }, QSET.slice(0, 3));\n  const cAtt = await mkAttempt(C.quiz, C.questions, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o2'] }, pointsAwarded: '0', isCorrect: false },\n    { response: { value: false }, pointsAwarded: '0', isCorrect: false },\n  ]);\n  // qD: draft with an unfinished choice question → publish checklist.\n  const Dq = await mkQuiz({ ...base, title: 'UIV Draft quiz', availableFrom: new Date(now + D), availableUntil: new Date(now + 2 * D), status: 'DRAFT' }, [{ type: 'SINGLE_CHOICE', prompt: 'Draft question', points: '1', options: OPTS.slice(0, 2), correct: {} }]);\n  // qE: MANUAL results; s3 submitted, awaiting release.\n  const E = await mkQuiz({ ...base, title: 'UIV Manual-release quiz', availableFrom: new Date(now - D), availableUntil: new Date(now + D), resultsVisibility: 'MANUAL', status: 'PUBLISHED', maxAttempts: 1 }, QSET.slice(0, 3));\n  const eAtt = await mkAttempt(E.quiz, E.questions, s3.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o4'] }, pointsAwarded: '4', isCorrect: true },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n  ]);\n  // qF: practice, one-per-page, 1-minute limit → red timer + navigator (s3).\n  const F = await mkQuiz({ ...base, title: 'UIV Practice sprint', isPractice: true, availableFrom: new Date(now - D), availableUntil: new Date(now + D), timeLimitMinutes: 1, maxAttempts: 3, oneQuestionPerPage: true, resultsVisibility: 'IMMEDIATELY', status: 'PUBLISHED' }, QSET.slice(0, 4));\n  Object.assign(R.fixtures, { t: t.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, qA: A.quiz.id, qB: B.quiz.id, qC: C.quiz.id, qD: Dq.quiz.id, qE: E.quiz.id, qF: F.quiz.id, cAtt: cAtt.id, eAtt: eAtt.id });\n  return R.fixtures;\n}\n\nlet browser;\nasync function ctxFor(who, width) {\n  const ctx = await browser.newContext({ baseURL: BASE, bypassCSP: true, viewport: { width, height: width < 600 ? 667 : 800 } });\n  const page = await ctx.newPage();\n  R.consoleErrors[who] ??= [];\n  page.on('console', (m) => { if (m.type() === 'error') R.consoleErrors[who].push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => R.consoleErrors[who].push('PAGEERROR ' + String(e).slice(0, 300)));\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  await page.request.post('/api/auth/callback/credentials', { form: { email: em(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get('/api/auth/session')).json();\n  if (s?.user?.email !== em(who)) throw new Error('sign-in failed for ' + who);\n  return { ctx, page };\n}\nconst txt = async (page) => (await page.locator('main').first().innerText().catch(() => page.locator('body').innerText())).slice(0, 1500);\nasync function go(page, url, waitText) {\n  const res = await page.goto(url, { waitUntil: 'load', timeout: 60_000 });\n  if (waitText) await page.getByText(waitText).first().waitFor({ timeout: 20_000 });\n  await page.waitForTimeout(800);\n  return { status: res?.status(), finalUrl: new URL(page.url()).pathname };\n}\nasync function check(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 3).join(' | ') }; }\n  console.log(name, R.results[name].ok, R.results[name].error ?? '');\n}\nconst shot = (page, n) => page.screenshot({ path: `${SHOTS}/${n}.png`, fullPage: true, timeout: 60_000 }).catch(() => page.screenshot({ path: `${SHOTS}/${n}.png`, timeout: 60_000 }));\nconst overflowX = (page) => page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\nconst axe = async (page) => (await new AxeBuilder({ page }).include('main').analyze()).violations.map((v) => `${v.id} (${v.impact}) x${v.nodes.length}`);\nasync function hydrated(fn, timeout = 15_000) { const end = Date.now() + timeout; let e; while (Date.now() < end) { try { return await fn(); } catch (x) { e = x; await new Promise((r) => setTimeout(r, 500)); } } throw e; }\n\n(async () => {\n  fs.rmSync(SHOTS, { recursive: true, force: true }); fs.mkdirSync(SHOTS, { recursive: true });\n  const f = await setup();\n  browser = await chromium.launch();\n  const CQ = `/courses/${f.c1}/quizzes`;\n  try {\n    // ---------- TEACHER (1280) ----------\n    const T = await ctxFor('teacher', 1280); const tp = T.page;\n    await check('teacher-course-quizzes-tab', async () => {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_res