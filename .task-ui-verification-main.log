n QuizGradingWorkspace({ questions, initialAttempts }: { questions: ManagerQuestion[]; initialAttempts: ManagerAttempt[] }) {\n  const [attempts, setAttempts] = useState(initialAttempts);\n  const [mode, setMode] = useState<'student' | 'question'>('student');\n48:        <TextField select size=\"small\" label=\"Question type\" value={type} onChange={(e) => setType(e.target.value as QuestionType)} sx={{ minWidth: 200 }} disabled={locked}>\n56:          <Button variant=\"outlined\" startIcon={<AddIcon />} onClick={add} disabled={locked}>\n58:          </Button>","is_error":false}]},"parent_tool_use_id":null,"session_id":"0ac7f625-80e7-44e9-9e39-f496ace1cf88","uuid":"5f61709a-efe0-4d98-956a-d8e2d376288c","timestamp":"2026-11-09T07:59:52.301Z","tool_use_result":{"stdout":"    <Paper variant=\"outlined\" sx={{ p: 2 }}>\n      <Stack direction=\"row\" spacing={1} sx={{ alignItems: 'center', mb: 1, flexWrap: 'wrap' }} useFlexGap>\n        <Typography variant=\"subtitle1\" component=\"h3\" sx={{ fontWeight: 600, flex: 1 }}>\n          {heading}\n        </Typography>\n        {answer?.needsReview ? <Chip size=\"small\" color=\"warning\" label=\"Needs grading\" /> : answer?.gradedById ? <Chip size=\"small\" label=\"Graded by teacher\" /> : <Chip size=\"small\" variant=\"outlined\" label=\"Auto-graded\" />}\n        <Typography variant=\"body2\">\n          {pts(answer?.pointsAwarded ?? null)} / {pts(question.points)}\n        </Typography>\n      </Stack>\n      <Typography variant=\"body2\" sx={{ whiteSpace: 'pre-wrap', mb: 2 }}>\n        <strong>Answer:</strong> {describe(answer?.response ?? null, question)}\n      </Typography>\n      <Stack direction={{ xs: 'column', sm: 'row' }} spacing={1} sx={{ alignItems: { sm: 'flex-start' } }}>\n        <TextField\n          label=\"Points\"\n          size=\"small\"\n          value={points}\n          onChange={(e) => setPoints(e.target.value)}\n          error={!!error}\n          helperText={error ?? `0 – ${pts(question.points)}, steps of 0.5`}\n          sx={{ width: { sm: 160 } }}\n          slotProps={{ htmlInput: { inputMode: 'decimal', step: 0.5, min: 0, max } }}\n        />\n        <TextField label=\"Feedback\" size=\"small\" value={feedback} onChange={(e) => setFeedback(e.target.value)} multiline fullWidth slotProps={{ htmlInput: { maxLength: FEEDBACK_MAX } }} />\n        <Button variant=\"contained\" onClick={save} disabled={saving || points === '' || !!error}>\n          Save\n        </Button>\n      </Stack>\n    </Paper>\n  );\n}\n\n/** FR-24: \"By student\" (one attempt at a time) and \"By question\" (all answers to one question). */\nexport function QuizGradingWorkspace({ questions, initialAttempts }: { questions: ManagerQuestion[]; initialAttempts: ManagerAttempt[] }) {\n  const [attempts, setAttempts] = useState(initialAttempts);\n  const [mode, setMode] = useState<'student' | 'question'>('student');\n48:        <TextField select size=\"small\" label=\"Question type\" value={type} onChange={(e) => setType(e.target.value as QuestionType)} sx={{ minWidth: 200 }} disabled={locked}>\n56:          <Button variant=\"outlined\" startIcon={<AddIcon />} onClick={add} disabled={locked}>\n58:          </Button>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Mn5XnEHF4m4hqisVjrvT8M","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgs12HdgJxpAzFiJdQCRz","type":"message","role":"assistant","content":[{"type":"text","text":"Now I'll write the driver."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1354,"cache_read_input_tokens":75327,"cache_creation":{"ephemeral_5m_input_tokens":1354,"ephemeral_1h_input_tokens":0},"output_tokens":32,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0ac7f625-80e7-44e9-9e39-f496ace1cf88","uuid":"d3729fcb-7386-45e0-971e-898085d68b71","timestamp":"2026-11-09T07:59:53.933Z","request_id":"req_011Cgs12HQYbr5rELoK46Hcm"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgs12HdgJxpAzFiJdQCRz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KNy8yBJzCcZxwPFR8wBteG","name":"Write","input":{"file_path":"/tmp/uiv-sh10/driver.cjs","content":"// SH-10 UI verification driver. Throwaway; lives outside the repo. Run with cwd = repo (for node_modules).\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst AxeBuilder = require('@axe-core/playwright').default;\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/forge/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh10';\nconst PW = 'Uiv-Sh10!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst H = 3600_000, D = 24 * H;\n\nasync function cleanup() {\n  await prisma.course.deleteMany({ where: { code: { startsWith: TAG } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.quizAttempt.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.notification.deleteMany({ where: { userId: { in: ids } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.fileObject.deleteMany({ where: { ownerId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n}\n\nconst OPTS = [{ id: 'o1', text: '1/2' }, { id: 'o2', text: '2/3' }, { id: 'o3', text: '3/4' }, { id: 'o4', text: '2/4' }];\nconst QSET = [\n  { type: 'SINGLE_CHOICE', prompt: 'Which fraction is **largest**?', points: '2', options: OPTS, correct: { optionId: 'o3' }, explanation: '3/4 = 0.75.' },\n  { type: 'MULTIPLE_CHOICE', prompt: 'Select every fraction equal to one half.', points: '4', options: OPTS, correct: { optionIds: ['o1', 'o4'] }, explanation: '2/4 simplifies to 1/2.' },\n  { type: 'TRUE_FALSE', prompt: '5/5 equals 1.', points: '1', correct: { value: true } },\n  { type: 'SHORT_ANSWER', prompt: 'Name the bottom number of a fraction.', points: '1', correct: { accepted: ['denominator'] } },\n  { type: 'ESSAY', prompt: 'Explain how you compare two fractions.', points: '4', correct: { guidance: 'Common denominator or decimals.' } },\n];\n\nasync function mkQuiz(data, qs) {\n  const quiz = await prisma.quiz.create({ data });\n  const questions = [];\n  for (const [i, q] of qs.entries()) questions.push(await prisma.question.create({ data: { ...q, quizId: quiz.id, order: i } }));\n  return { quiz, questions };\n}\nasync function mkAttempt(quiz, questions, studentId, n, status, answers, extra = {}) {\n  const max = questions.reduce((s, q) => s + Number(q.points), 0);\n  const score = status === 'GRADED' ? answers.reduce((s, a) => s + Number(a.pointsAwarded ?? 0), 0) : null;\n  const a = await prisma.quizAttempt.create({ data: { quizId: quiz.id, studentId, attemptNumber: n, status, startedAt: new Date(Date.now() - 2 * D), submittedAt: new Date(Date.now() - 2 * D + 12 * 60_000), questionOrder: questions.map((q) => q.id), maxScore: String(max), score: score == null ? null : String(score), ...extra } });\n  for (const [i, ans] of answers.entries()) if (ans) await prisma.quizAnswer.create({ data: { attemptId: a.id, questionId: questions[i].id, ...ans } });\n  return a;\n}\n\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Blake', 'Bell', 'STUDENT');\n  const s3 = await mk('s3', 'Morgan', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s2.id, relationship: 'MOTHER', isPrimary: true } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id };\n  // qA: open, IMMEDIATELY, 20 min, 2 attempts; s1 takes it live through the UI. s2 has one graded attempt (analytics data).\n  const A = await mkQuiz({ ...base, title: 'UIV Fractions check', instructions: 'Answer **all** questions. Calculators allowed.', availableFrom: new Date(now - D), availableUntil: new Date(now + 2 * D), timeLimitMinutes: 20, maxAttempts: 2, resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: true, status: 'PUBLISHED' }, QSET);\n  const qa = A.questions;\n  await mkAttempt(A.quiz, qa, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o2' }, pointsAwarded: '0', isCorrect: false },\n    { response: { optionIds: ['o1'] }, pointsAwarded: '2', isCorrect: false },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'Denominator' }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'I turn them into decimals.' }, pointsAwarded: '3', isCorrect: null, feedback: 'Good, show an example next time.', gradedById: t.id },\n  ]);\n  // qB: upcoming (AFTER_CLOSE).\n  const B = await mkQuiz({ ...base, title: 'UIV Unit 1 test', availableFrom: new Date(now + 2 * D), availableUntil: new Date(now + 3 * D), timeLimitMinutes: 45, resultsVisibility: 'AFTER_CLOSE', status: 'PUBLISHED' }, QSET.slice(0, 3));\n  // qC: closed; s2 graded (parent sees it, released via IMMEDIATELY); s3 never attempted → Missed.\n  const C = await mkQuiz({ ...base, title: 'UIV Decimals quick check', availableFrom: new Date(now - 5 * D), availableUntil: new Date(now - D), resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: false, status: 'CLOSED' }, QSET.slice(0, 3));\n  const cAtt = await mkAttempt(C.quiz, C.questions, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o2'] }, pointsAwarded: '0', isCorrect: false },\n    { response: { value: false }, pointsAwarded: '0', isCorrect: false },\n  ]);\n  // qD: draft with an unfinished choice question → publish checklist.\n  const Dq = await mkQuiz({ ...base, title: 'UIV Draft quiz', availableFrom: new Date(now + D), availableUntil: new Date(now + 2 * D), status: 'DRAFT' }, [{ type: 'SINGLE_CHOICE', prompt: 'Draft question', points: '1', options: OPTS.slice(0, 2), correct: {} }]);\n  // qE: MANUAL results; s3 submitted, awaiting release.\n  const E = await mkQuiz({ ...base, title: 'UIV Manual-release quiz', availableFrom: new Date(now - D), availableUntil: new Date(now + D), resultsVisibility: 'MANUAL', status: 'PUBLISHED', maxAttempts: 1 }, QSET.slice(0, 3));\n  const eAtt = await mkAttempt(E.quiz, E.questions, s3.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o4'] }, pointsAwarded: '4', isCorrect: true },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n  ]);\n  // qF: practice, one-per-page, 1-minute limit → red timer + navigator (s3).\n  const F = await mkQuiz({ ...base, title: 'UIV Practice sprint', isPractice: true, availableFrom: new Date(now - D), availableUntil: new Date(now + D), timeLimitMinutes: 1, maxAttempts: 3, oneQuestionPerPage: true, resultsVisibility: 'IMMEDIATELY', status: 'PUBLISHED' }, QSET.slice(0, 4));\n  Object.assign(R.fixtures, { t: t.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, qA: A.quiz.id, qB: B.quiz.id, qC: C.quiz.id, qD: Dq.quiz.id, qE: E.quiz.id, qF: F.quiz.id, cAtt: cAtt.id, eAtt: eAtt.id });\n  return R.fixtures;\n}\n\nlet browser;\nasync function ctxFor(who, width) {\n  const ctx = await browser.newContext({ baseURL: BASE, bypassCSP: true, viewport: { width, height: width < 600 ? 667 : 800 } });\n  const page = await ctx.newPage();\n  R.consoleErrors[who] ??= [];\n  page.on('console', (m) => { if (m.type() === 'error') R.consoleErrors[who].push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => R.consoleErrors[who].push('PAGEERROR ' + String(e).slice(0, 300)));\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  await page.request.post('/api/auth/callback/credentials', { form: { email: em(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get('/api/auth/session')).json();\n  if (s?.user?.email !== em(who)) throw new Error('sign-in failed for ' + who);\n  return { ctx, page };\n}\nconst txt = async (page) => (await page.locator('main').first().innerText().catch(() => page.locator('body').innerText())).slice(0, 1500);\nasync function go(page, url, waitText) {\n  const res = await page.goto(url, { waitUntil: 'load', timeout: 60_000 });\n  if (waitText) await page.getByText(waitText).first().waitFor({ timeout: 20_000 });\n  await page.waitForTimeout(800);\n  return { status: res?.status(), finalUrl: new URL(page.url()).pathname };\n}\nasync function check(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 3).join(' | ') }; }\n  console.log(name, R.results[name].ok, R.results[name].error ?? '');\n}\nconst shot = (page, n) => page.screenshot({ path: `${SHOTS}/${n}.png`, fullPage: true });\nconst overflowX = (page) => page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\nconst axe = async (page) => (await new AxeBuilder({ page }).include('main').analyze()).violations.map((v) => `${v.id} (${v.impact}) x${v.nodes.length}`);\nasync function hydrated(fn, timeout = 15_000) { const end = Date.now() + timeout; let e; while (Date.now() < end) { try { return await fn(); } catch (x) { e = x; await new Promise((r) => setTimeout(r, 500)); } } throw e; }\n\n(async () => {\n  fs.rmSync(SHOTS, { recursive: true, force: true }); fs.mkdirSync(SHOTS, { recursive: true });\n  const f = await setup();\n  browser = await chromium.launch();\n  const CQ = `/courses/${f.c1}/quizzes`;\n  try {\n    // ---------- TEACHER (1280) ----------\n    const T = await ctxFor('teacher', 1280); const tp = T.page;\n    await check('teacher-course-quizzes-tab', async () => {\n      const r = await go(tp, CQ, 'UIV Fractions check');\n      const out = { ...r, quizzesTab: await tp.getByRole('tab', { name: /quizzes/i }).count() + await tp.getByRole('link', { name: /^quizzes$/i }).count(), headers: await tp.getByRole('columnheader').allInnerTexts(), text: await txt(tp), axe: await axe(tp) };\n      await shot(tp, 'teacher-course-quizzes-1280'); return out;\n    });\n    await check('teacher-new-quiz', async () => {\n      const r = await go(tp, CQ + '/new');\n      await tp.waitForURL(/\\/quizzes\\/[^/]+\\/edit$/, { timeout: 20_000 });\n      const newId = tp.url().split('/quizzes/')[1].split('/')[0];\n      const q = await prisma.quiz.findUnique({ where: { id: newId } });\n      R.fixtures.qNew = newId;\n      return { ...r, redirectedTo: new URL(tp.url()).pathname, createdStatus: q?.status, createdTitle: q?.title };\n    });\n    await check('teacher-builder-add-questions', async () => {\n      await tp.getByText('Before you can publish').first().waitFor({ timeout: 20_000 }).catch(() => {});\n      const emptyText = await txt(tp);\n      await shot(tp, 'teacher-builder-empty-1280');\n      const add = tp.getByRole('button', { name: 'Add question' });\n      await hydrated(async () => { await add.click(); await tp.getByText('1 questions').waitFor({ timeout: 2000 }); });\n      const counts = [];\n      for (const [type, n] of [['Multiple choice', 2], ['True / false', 3], ['Short answer', 4], ['Essay', 5]]) {\n        await tp.getByLabel('Question type').click();\n        const opt = tp.getByRole('option', { name: type });\n        if (!(await opt.count())) { counts.push(`${type}: option missing (${await tp.getByRole('option').allInnerTexts()})`); await tp.keyboard.press('Escape'); continue; }\n        await opt.click(); await add.click();\n        await tp.getByText(`${n} questions`).waitFor({ timeout: 10_000 }); counts.push(`${type}: ${n}`);\n      }\n      const header = await tp.getByText(/questions · /).first().innerText();\n      const problems = await tp.getByRole('alert').filter({ hasText: 'Before you can publish' }).allInnerTexts();\n      const publishDisabled = await tp.getByRole('button', { name: 'Publish', exact: true }).isDisabled();\n      const perQuestion = { drag: await tp.getByRole('button', { name: /^Drag question/ }).count(), duplicate: await tp.getByRole('button', { name: /^Duplicate question/ }).count(), delete: await tp.getByRole('button', { name: /^Delete question/ }).count(), move: await tp.getByRole('button', { name: /^Move question/ }).count() };\n      await shot(tp, 'teacher-builder-questions-1280');\n      return { emptyHasChecklist: emptyText.includes('Before you can publish'), previewDisabledWhenEmpty: null, counts, header, problems, publishDisabled, perQuestion };\n    });\n    await check('teacher-builder-duplicate-delete', async () => {\n      const before = await tp.getByText(/\\d+ questions/).first().innerText();\n      await tp.getByRole('button', { name: 'Duplicate question 1' }).click();\n      await tp.getByText('6 questions').waitFor({ timeout: 10_000 });\n      await tp.getByRole('button', { name: 'Delete question 2' }).click();\n      const dlg = tp.getByRole('dialog');\n      await dlg.waitFor({ timeout: 5000 });\n      const dlgText = await dlg.innerText();\n      await dlg.getByRole('button', { name: /^delete$/i }).click();\n      await tp.getByText('5 questions').waitFor({ timeout: 10_000 });\n      return { before, afterDuplicate: '6 questions', deleteDialog: dlgText, afterDelete: '5 questions' };\n    });\n    await check('teacher-builder-editor', async () => {\n      // Open the first (single choice) question's editor and show its option rows.\n      const editors = await tp.locator('main').getByRole('button', { name: /edit question/i }).count();\n      if (editors) await tp.locator('main').getByRole('button', { name: /edit question/i }).first().click();\n      else await tp.locator('main').getByText('Single choice').first().click();\n      await tp.waitForTimeout(800);\n      const radios = await tp.locator('main input[type=radio]').count();\n      const checkboxes = await tp.locator('main input[type=checkbox]').count();\n      const text = await txt(tp);\n      await shot(tp, 'teacher-question-editor-1280');\n      return { editorsFound: editors, radios, checkboxes, text };\n    });\n    await check('teacher-builder-settings', async () => {\n      await tp.getByRole('tab', { name: 'Settings' }).click();\n      await tp.waitForTimeout(800);\n      const labels = {};\n      for (const l of ['Title', 'Instructions', 'Opens', 'Closes', 'Time limit (minutes)', 'Attempts allowed', 'Scoring policy', 'Results visible', 'Practice quiz (not in gradebook)', 'Shuffle questions', 'Shuffle options', 'One question per page', 'Show correct answers with results'])\n        labels[l] = await tp.getByLabel(l, { exact: false }).count();\n      const accom = await tp.getByRole('table', { name: 'Accommodations' }).count();\n      const accomText = accom ? await tp.getByRole('table', { name: 'Accommodations' }).innerText() : null;\n      await shot(tp, 'teacher-builder-settings-1280');\n      // Time limit longer than window → validation (FR-6). Window of new quiz defaults; set 300 min and save.\n      await tp.getByLabel('Time limit (minutes)').fill('300');\n      const save = tp.getByRole('button', { name: /^save/i }).first();\n      if (await save.count()) await save.click();\n      await tp.waitForTimeout(1200);\n      const errors = await tp.locator('.Mui-error, [role=alert]').allInnerTexts();\n      await shot(tp, 'teacher-settings-timelimit-1280');\n      return { labels, accommodationsTable: accom, accomText, timeLimitErrors: errors.filter(Boolean).slice(0, 6) };\n    });\n    await check('teacher-builder-preview', async () => {\n      await go(tp, `${CQ}/${f.qA}/edit`, 'UIV Fractions check');\n      const lockedAlert = await tp.getByRole('alert').filter({ hasText: 'attempt' }).allInnerTexts();\n      const addDisabled = await tp.getByRole('button', { name: 'Add question' }).isDisabled().catch(() => null);\n      const links = { grade: await tp.getByRole('link', { name: 'Grade' }).count(), analytics: await tp.getByRole('link', { name: 'Analytics' }).count() };\n      await shot(tp, 'teacher-builder-locked-1280');\n      const before = await prisma.quizAttempt.count({ where: { quizId: f.qA } });\n      await tp.getByRole('button', { name: 'Preview as student' }).click();\n      await tp.getByText('Preview as student — nothing is recorded').waitFor({ timeout: 10_000 });\n      await tp.getByRole('dialog').getByLabel('3/4').first().check().catch(() => tp.getByLabel('3/4').first().check());\n      await tp.waitForTimeout(1500);\n      const previewText = await tp.getByRole('dialog').innerText().catch(() => '');\n      await shot(tp, 'teacher-preview-1280');\n      const after = await prisma.quizAttempt.count({ where: { quizId: f.qA } });\n      await tp.getByRole('button', { name: 'Close preview' }).click();\n      return { lockedAlert, addDisabled, links, attemptsBefore: before, attemptsAfterPreview: after, previewHasNotRecorded: previewText.includes('Not recorded'), previewText: previewText.slice(0, 600) };\n    });\n    await check('teacher-draft-publish-checklist', async () => {\n      await go(tp, `${CQ}/${f.qD}/edit`, 'Before you can publish');\n      const problems = await tp.getByRole('alert').filter({ hasText: 'Before you can publish' }).allInnerTexts();\n      const publishDisabled = await tp.getByRole('button', { name: 'Publish', exact: true }).isDisabled();\n      await shot(tp, 'teacher-draft-checklist-1280');\n      return { problems, publishDisabled };\n    });\n\n    // ---------- STUDENT s1 (375): take quiz A live ----------\n    const S1 = await ctxFor('s1', 375); const sp = S1.page;\n    await check('student-course-quizzes-list', async () => {\n      const r = await go(sp, CQ, 'UIV Fractions check');\n      const text = await txt(sp);\n      const out = { ...r, groups: ['Available now', 'Upcoming', 'Completed', 'Missed'].filter((g) => text.includes(g)), draftHidden: !text.includes('UIV Draft quiz'), startButtons: await sp.getByRole('link', { name: 'Start' }).count(), overflowX: await overflowX(sp), text };\n      await shot(sp, 'student-course-quizzes-375'); return out;\n    });\n    await check('student-start-screen', async () => {\n      const r = await go(sp, `/quizzes/${f.qA}/take`, 'Start attempt');\n      const text = await txt(sp);\n      await shot(sp, 'student-start-screen-375');\n      await hydrated(async () => { await sp.getByRole('button', { name: 'Start attempt' }).click(); await sp.getByRole('dialog').waitFor({ timeout: 2000 }); });\n      const dialog = await sp.getByRole('dialog').innerText();\n      await shot(sp, 'student-start-confirm-375');\n      await sp.getByRole('dialog').getByRole('button', { name: 'Start' }).click();\n      await sp.getByRole('button', { name: 'Submit' }).waitFor({ timeout: 15_000 });\n      return { ...r, text, dialog, overflowX: await overflowX(sp) };\n    });\n    await check('student-player-answer-autosave', async () => {\n      await sp.waitForTimeout(800);\n      const timer = await sp.getByLabel(/^Time remaining/).getAttribute('aria-label');\n      await sp.getByLabel('3/4').check();\n      await sp.getByLabel('1/2').nth(0).waitFor();\n      const cbs = sp.getByRole('checkbox');\n      const cbLabels = await sp.locator('main .MuiFormGroup-root label').allInnerTexts();\n      await cbs.nth(cbLabels.indexOf('1/2')).check(); await cbs.nth(cbLabels.indexOf('2/4')).check();\n      await sp.getByLabel('True', { exact: true }).check();\n      const texts = sp.locator('main input[type=text], main textarea:not([aria-hidden])');\n      await texts.nth(0).fill('  Denominator ');\n      await sp.waitForTimeout(200);\n      const pillDuring = await sp.locator('.MuiChip-label').allInnerTexts();\n      await sp.getByText('All answers saved').waitFor({ timeout: 10_000 });\n      const progress = await sp.getByRole('progressbar').first().getAttribute('aria-label');\n      const radios = await sp.locator('main input[type=radio]').count(), checkboxes = await sp.locator('main input[type=checkbox]').count();\n      await shot(sp, 'student-player-375');\n      const a = await prisma.quizAttempt.findFirst({ where: { quizId: f.qA, studentId: f.s1, status: 'IN_PROGRESS' }, include: { answers: true } });\n      R.fixtures.s1Att = a?.id;\n      return { timer, pillDuring, progress, radios, checkboxes, savedAnswersInDb: a?.answers.length, axe: await axe(sp), overflowX: await overflowX(sp) };\n    });\n    await check('student-player-offline-pill', async () => {\n      await S1.ctx.setOffline(true);\n      await sp.locator('main textarea:not([aria-hidden])').first().fill('Offline draft of my essay.');\n      await sp.getByText('Offline — answers saved on this device').waitFor({ timeout: 15_000 });\n      const ls = await sp.evaluate(() => Object.keys(localStorage).filter((k) => k.startsWith('quiz-attempt:')));\n      await shot(sp, 'student-player-offline-375');\n      await S1.ctx.setOffline(false);\n      await sp.getByText('All answers saved').waitFor({ timeout: 20_000 });\n      const a = await prisma.quizAnswer.count({ where: { attemptId: R.fixtures.s1Att } });\n      return { localStorageKeys: ls, recoveredPill: 'All answers saved', answersInDbAfterReconnect: a };\n    });\n    await check('student-player-reload-resume', async () => {\n      await sp.reload({ waitUntil: 'load' });\n      await sp.getByRole('button', { name: 'Submit' }).waitFor({ timeout: 15_000 });\n      await sp.waitForTimeout(800);\n      const checked = await sp.getByLabel('3/4').isChecked();\n      const essay = await sp.locator('main textarea:not([aria-hidden])').first().inputValue();\n      const inProgress = await prisma.quizAttempt.count({ where: { quizId: f.qA, studentId: f.s1, status: 'IN_PROGRESS' } });\n      return { singleChoiceStillChecked: checked, essayValue: essay, inProgressAttempts: inProgress };\n    });\n    await check('student-submit', async () => {\n      await sp.locator('main textarea:not([aria-hidden])').first().fill('');\n      await sp.getByText('All answers saved').waitFor({ timeout: 10_000 });\n      await sp.waitForTimeout(1200);\n      await sp.getByRole('button', { name: 'Submit' }).click();\n      const dialog = await sp.getByRole('dialog').innerText();\n      await shot(sp, 'student-submit-confirm-375');\n      await sp.locator('main textarea').first().count();\n      // Fill the essay before actually submitting, so the teacher has something to grade.\n      await sp.getByRole('dialog').getByRole('button', { name: /cancel/i }).click();\n      await sp.locator('main textarea:not([aria-hidden])').first().fill('Find a common denominator, then compare the numerators.');\n      await sp.getByText('All answers saved').waitFor({ timeout: 10_000 }); await sp.waitForTimeout(1200);\n      await sp.getByRole('button', { name: 'Submit' }).click();\n      await sp.getByRole('dialog').getByRole('button', { name: 'Submit' }).click();\n      await sp.waitForURL(/\\/attempts\\//, { timeout: 20_000 }).catch(() => {});\n      await sp.waitForTimeout(1500);\n      const a = await prisma.quizAttempt.findUnique({ where: { id: R.fixtures.s1Att } });\n      const text = await txt(sp);\n      await shot(sp, 'student-result-needs-grading-375');\n      return { confirmDialog: dialog, landedOn: new URL(sp.url()).pathname, dbStatus: a?.status, dbScore: a?.score?.toString(), text };\n    });\n\n    // ---------- TEACHER grades s1's essay ----------\n    await check('teacher-grade-by-student', async () => {\n      const r = await go(tp, `${CQ}/${f.qA}/grade`);\n      await tp.waitForTimeout(800);\n      const text = await txt(tp);\n      const modes = await tp.getByRole('button', { name: /^By (student|question)$/ }).count() + await tp.getByRole('tab', { name: /^By (student|question)$/ }).count();\n      await shot(tp, 'teacher-grade-by-student-1280');\n      // Pick Alex's attempt if a selector exists\n      const sel = tp.getByLabel('Attempt');\n      if (await sel.count()) { await sel.first().click(); const o = tp.getByRole('option', { name: /Alex/ }); if (await o.count()) await o.first().click(); else await tp.keyboard.press('Escape'); await tp.waitForTimeout(500); }\n      const needs = tp.locator('main .MuiPaper-root').filter({ has: tp.getByText('Needs grading', { exact: true }) }).filter({ has: tp.getByLabel('Points') });\n      const n = await needs.count();\n      let saved = null;\n      if (n) {\n        const card = needs.first();\n        await card.getByLabel('Points').fill('3.5');\n        await card.getByLabel('Feedback').fill('Clear method.');\n        await card.getByRole('button', { name: 'Save' }).click();\n        await tp.getByText('Grade saved').waitFor({ timeout: 10_000 }); saved = 'Grade saved';\n      }\n      await tp.waitForTimeout(800);\n      const a = await prisma.quizAttempt.findUnique({ where: { id: R.fixtures.s1Att } });\n      await shot(tp, 'teacher-grade-saved-1280');\n      return { ...r, modes, needsGradingCards: n, saved, dbStatusAfter: a?.status, dbScoreAfter: a?.score?.toString(), text };\n    });\n    await check('teacher-grade-invalid-points', async () => {\n      const card = tp.locator('main .MuiPaper-root').filter({ has: tp.getByLabel('Points') }).first();\n      await card.getByLabel('Points').fill('99');\n      await tp.waitForTimeout(300);\n      const helper = await card.locator('.MuiFormHelperText-root').first().innerText();\n      const saveDisabled = await card.getByRole('button', { name: 'Save' }).isDisabled();\n      await shot(tp, 'teacher-grade-invalid-1280');\n      await card.getByLabel('Points').fill('0.3'); await tp.waitForTimeout(300);\n      const helperStep = await card.locator('.MuiFormHelperText-root').first().innerText();\n      return { helper, saveDisabled, helperStep };\n    });\n    await check('teacher-grade-by-question', async () => {\n      await go(tp, `${CQ}/${f.qA}/grade`);\n      const b = tp.getByRole('button', { name: 'By question' });\n      await hydrated(async () => { await ((await b.count()) ? b : tp.getByRole('tab', { name: 'By question' })).click(); await tp.getByLabel('Question').first().waitFor({ timeout: 2000 }); });\n      await tp.waitForTimeout(600);\n      const text = await txt(tp);\n      await shot(tp, 'teacher-grade-by-question-1280');\n      return { text };\n    });\n    await check('teacher-analytics', async () => {\n      const r = await go(tp, `${CQ}/${f.qA}/analytics`, 'Median');\n      await tp.waitForTimeout(1200);\n      const text = await txt(tp);\n      const svgBars = await tp.locator('main svg rect, main svg path.MuiBarElement-root').count();\n      const perQ = await tp.getByRole('table', { name: 'Per-question results' }).count();\n      const csv = await tp.getByRole('link', { name: /csv/i }).count() + await tp.getByRole('button', { name: /csv/i }).count();\n      const csvRes = await tp.request.get(`/api/quizzes/${f.qA}/analytics?format=csv`);\n      await shot(tp, 'teacher-analytics-1280');\n      return { ...r, svgBars, perQuestionTable: perQ, csvControl: csv, csvStatus: csvRes.status(), csvHead: (await csvRes.text()).split('\\n').slice(0, 3), axe: await axe(tp), text };\n    });\n    await check('teacher-list-after', async () => {\n      await go(tp, CQ, 'UIV Fractions check');\n      return { text: await txt(tp) };\n    });\n    await check('teacher-release-manual', async () => {\n      await go(tp, `${CQ}/${f.qE}/edit`, 'UIV Manual-release quiz');\n      const btn = tp.getByRole('button', { name: 'Release results' });\n      const present = await btn.count();\n      await shot(tp, 'teacher-manual-release-1280');\n      return { releaseButton: present };\n    });\n\n    // ---------- STUDENT s1 sees graded result ----------\n    await check('student-result-graded', async () => {\n      const r = await go(sp, `/quizzes/${f.qA}/attempts/${R.fixtures.s1Att}`);\n      const text = await txt(sp);\n      await shot(sp, 'student-result-graded-375');\n      return { ...r, hasCorrectAnswer: text.includes('Correct answer'), hasFeedback: text.includes('Clear method.'), overflowX: await overflowX(sp), text };\n    });\n    await check('student-list-after', async () => {\n      await go(sp, CQ, 'UIV Fractions check');\n      const text = await txt(sp);\n      await shot(sp, 'student-course-quizzes-after-375');\n      return { text };\n    });\n\n    // ---------- STUDENT s3: manual-release pending, missed, red timer ----------\n    const S3 = await ctxFor('s3', 375); const s3p = S3.page;\n    await check('student-s3-list', async () => {\n      await go(s3p, CQ, 'UIV Practice sprint');\n      const text = await txt(s3p);\n      await shot(s3p, 'student-s3-quizzes-375');\n      return { hasMissed: text.includes('Missed'), pendingText: text.includes('results will be available later'), text };\n    });\n    await check('student-manual-pending-result', async () => {\n      const r = await go(s3p, `/quizzes/${f.qE}/attempts/${f.eAtt}`);\n      const text = await txt(s3p);\n      await shot(s3p, 'student-result-pending-375');\n      return { ...r, pending: text.includes('Submitted — results will be available later.'), leaksScore: /\\b7\\s*\\/\\s*7\\b/.test(text), text };\n    });\n    await check('student-pending-api-no-correct', async () => {\n      const res = await s3p.request.get(`/api/attempts/${f.eAtt}`); const body = await res.text();\n      const q = await s3p.request.get(`/api/quizzes/${f.qA}`); const qb = await q.text();\n      return { attemptStatus: res.status(), attemptHasCorrect: body.includes('\"correct\"'), quizStatus: q.status(), quizHasCorrect: qb.includes('\"correct\"'), quizHasExplanation: qb.includes('3/4 = 0.75') };\n    });\n    await check('student-one-per-page-timer', async () => {\n      await go(s3p, `/quizzes/${f.qF}/take`, 'Start attempt');\n      await hydrated(async () => { await s3p.getByRole('button', { name: 'Start attempt' }).click(); await s3p.getByRole('dialog').waitFor({ timeout: 2000 }); });\n      const dialog = await s3p.getByRole('dialog').innerText();\n      await s3p.getByRole('dialog').getByRole('button', { name: 'Start' }).click();\n      await s3p.getByRole('navigation', { name: 'Question navigator' }).waitFor({ timeout: 15_000 });\n      await s3p.waitForTimeout(800);\n      const timerEl = s3p.getByLabel(/^Time remaining/);\n      const color = await timerEl.evaluate((e) => getComputedStyle(e).color);\n      await s3p.getByLabel('3/4').check();\n      await s3p.getByRole('button', { name: 'Flag for review' }).click();\n      const navLabels = await s3p.getByRole('navigation', { name: 'Question navigator' }).getByRole('button').evaluateAll((els) => els.map((e) => e.getAttribute('aria-label')));\n      const visibleQuestions = await s3p.locator('main fieldset').count();\n      await shot(s3p, 'student-one-per-page-375');\n      await s3p.getByRole('button', { name: 'Next' }).click(); await s3p.waitForTimeout(300);\n      const legend2 = await s3p.locator('main fieldset').first().innerText();\n      return { dialog, timer: await timerEl.getAttribute('aria-label'), timerColor: color, navLabels, visibleQuestions, page2: legend2.slice(0, 120), overflowX: await overflowX(s3p) };\n    });\n\n    // ---------- PARENT (375) ----------\n    const P = await ctxFor('parent', 375); const pp = P.page;\n    await check('parent-course-quizzes', async () => {\n      const r = await go(pp, CQ);\n      await pp.waitForTimeout(800);\n      const text = await txt(pp);\n      const actions = await pp.getByRole('link', { name: /^(Start|Resume)$/ }).count();\n      await shot(pp, 'parent-course-quizzes-375');\n      return { ...r, text, startResumeLinks: actions, overflowX: await overflowX(pp) };\n    });\n    await check('parent-result-view', async () => {\n      const r = await go(pp, `/quizzes/${f.qC}/attempts/${f.cAtt}`);\n      const text = await txt(pp);\n      await shot(pp, 'parent-result-375');\n      const inputs = await pp.locator('main input, main textarea').count();\n      return { ...r, inputs, hidesCorrectAnswers: !text.includes('Correct answer'), text };\n    });\n\n    // ---------- Student s1 at desktop for one wide view ----------\n    const S1w = await ctxFor('s1', 1280);\n    await check('student-result-graded-1280', async () => {\n      await go(S1w.page, `/quizzes/${f.qA}/attempts/${R.fixtures.s1Att}`);\n      await shot(S1w.page, 'student-result-graded-1280');\n      return {};\n    });\n  } finally {\n    await browser.close();\n    await cleanup().catch((e) => (R.cleanupError = String(e)));\n    R.cleanedUp = !(await prisma.user.count({ where: { email: { startsWith: `${TAG}-` } } }));\n    await prisma.$disconnect();\n    fs.writeFileSync(OUT + '/uiv-raw.json', JSON.stringify(R, null, 1));\n    console.log('done; cleanedUp', R.cleanedUp);\n  }\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1354,"cache_read_input_tokens":75327,"cache_creation":{"ephemeral_5m_input_tokens":1354,"ephemeral_1h_input_tokens":0},"output_tokens":32,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0ac7f625-80e7-44e9-9e39-f496ace1cf88","uuid":"ccb39f60-45ba-4bac-a39f-de46ac54613e","timestamp":"2026-11-09T08:01:36.241Z","request_id":"req_011Cgs12HQYbr5rELoK46Hcm","wire_tool_inputs":{"toolu_01KNy8yBJzCcZxwPFR8wBteG":{"file_path":"/tmp/uiv-sh10/driver.cjs","content":"// SH-10 UI verification driver. Throwaway; lives outside the repo. Run with cwd = repo (for node_modules).\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst AxeBuilder = require('@axe-core/playwright').default;\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/forge/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh10';\nconst PW = 'Uiv-Sh10!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst H = 3600_000, D = 24 * H;\n\nasync function cleanup() {\n  await prisma.course.deleteMany({ where: { code: { startsWith: TAG } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.quizAttempt.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.notification.deleteMany({ where: { userId: { in: ids } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.fileObject.deleteMany({ where: { ownerId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n}\n\nconst OPTS = [{ id: 'o1', text: '1/2' }, { id: 'o2', text: '2/3' }, { id: 'o3', text: '3/4' }, { id: 'o4', text: '2/4' }];\nconst QSET = [\n  { type: 'SINGLE_CHOICE', prompt: 'Which fraction is **largest**?', points: '2', options: OPTS, correct: { optionId: 'o3' }, explanation: '3/4 = 0.75.' },\n  { type: 'MULTIPLE_CHOICE', prompt: 'Select every fraction equal to one half.', points: '4', options: OPTS, correct: { optionIds: ['o1', 'o4'] }, explanation: '2/4 simplifies to 1/2.' },\n  { type: 'TRUE_FALSE', prompt: '5/5 equals 1.', points: '1', correct: { value: true } },\n  { type: 'SHORT_ANSWER', prompt: 'Name the bottom number of a fraction.', points: '1', correct: { accepted: ['denominator'] } },\n  { type: 'ESSAY', prompt: 'Explain how you compare two fractions.', points: '4', correct: { guidance: 'Common denominator or decimals.' } },\n];\n\nasync function mkQuiz(data, qs) {\n  const quiz = await prisma.quiz.create({ data });\n  const questions = [];\n  for (const [i, q] of qs.entries()) questions.push(await prisma.question.create({ data: { ...q, quizId: quiz.id, order: i } }));\n  return { quiz, questions };\n}\nasync function mkAttempt(quiz, questions, studentId, n, status, answers, extra = {}) {\n  const max = questions.reduce((s, q) => s + Number(q.points), 0);\n  const score = status === 'GRADED' ? answers.reduce((s, a) => s + Number(a.pointsAwarded ?? 0), 0) : null;\n  const a = await prisma.quizAttempt.create({ data: { quizId: quiz.id, studentId, attemptNumber: n, status, startedAt: new Date(Date.now() - 2 * D), submittedAt: new Date(Date.now() - 2 * D + 12 * 60_000), questionOrder: questions.map((q) => q.id), maxScore: String(max), score: score == null ? null : String(score), ...extra } });\n  for (const [i, ans] of answers.entries()) if (ans) await prisma.quizAnswer.create({ data: { attemptId: a.id, questionId: questions[i].id, ...ans } });\n  return a;\n}\n\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Blake', 'Bell', 'STUDENT');\n  const s3 = await mk('s3', 'Morgan', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s2.id, relationship: 'MOTHER', isPrimary: true } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id };\n  // qA: open, IMMEDIATELY, 20 min, 2 attempts; s1 takes it live through the UI. s2 has one graded attempt (analytics data).\n  const A = await mkQuiz({ ...base, title: 'UIV Fractions check', instructions: 'Answer **all** questions. Calculators allowed.', availableFrom: new Date(now - D), availableUntil: new Date(now + 2 * D), timeLimitMinutes: 20, maxAttempts: 2, resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: true, status: 'PUBLISHED' }, QSET);\n  const qa = A.questions;\n  await mkAttempt(A.quiz, qa, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o2' }, pointsAwarded: '0', isCorrect: false },\n    { response: { optionIds: ['o1'] }, pointsAwarded: '2', isCorrect: false },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'Denominator' }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'I turn them into decimals.' }, pointsAwarded: '3', isCorrect: null, feedback: 'Good, show an example next time.', gradedById: t.id },\n  ]);\n  // qB: upcoming (AFTER_CLOSE).\n  const B = await mkQuiz({ ...base, title: 'UIV Unit 1 test', availableFrom: new Date(now + 2 * D), availableUntil: new Date(now + 3 * D), timeLimitMinutes: 45, resultsVisibility: 'AFTER_CLOSE', status: 'PUBLISHED' }, QSET.slice(0, 3));\n  // qC: closed; s2 graded (parent sees it, released via IMMEDIATELY); s3 never attempted → Missed.\n  const C = await mkQuiz({ ...base, title: 'UIV Decimals quick check', availableFrom: new Date(now - 5 * D), availableUntil: new Date(now - D), resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: false, status: 'CLOSED' }, QSET.slice(0, 3));\n  const cAtt = await mkAttempt(C.quiz, C.questions, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o2'] }, pointsAwarded: '0', isCorrect: false },\n    { response: { value: false }, pointsAwarded: '0', isCorrect: false },\n  ]);\n  // qD: draft with an unfinished choice question → publish checklist.\n  const Dq = await mkQuiz({ ...base, title: 'UIV Draft quiz', availableFrom: new Date(now + D), availableUntil: new Date(now + 2 * D), status: 'DRAFT' }, [{ type: 'SINGLE_CHOICE', prompt: 'Draft question', points: '1', options: OPTS.slice(0, 2), correct: {} }]);\n  // qE: MANUAL results; s3 submitted, awaiting release.\n  const E = await mkQuiz({ ...base, title: 'UIV Manual-release quiz', availableFrom: new Date(now - D), availableUntil: new Date(now + D), resultsVisibility: 'MANUAL', status: 'PUBLISHED', maxAttempts: 1 }, QSET.slice(0, 3));\n  const eAtt = await mkAttempt(E.quiz, E.questions, s3.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o4'] }, pointsAwarded: '4', isCorrect: true },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n  ]);\n  // qF: practice, one-per-page, 1-minute limit → red timer + navigator (s3).\n  const F = await mkQuiz({ ...base, title: 'UIV Practice sprint', isPractice: true, availableFrom: new Date(now - D), availableUntil: new Date(now + D), timeLimitMinutes: 1, maxAttempts: 3, oneQuestionPerPage: true, resultsVisibility: 'IMMEDIATELY', status: 'PUBLISHED' }, QSET.slice(0, 4));\n  Object.assign(R.fixtures, { t: t.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, qA: A.quiz.id, qB: B.quiz.id, qC: C.quiz.id, qD: Dq.quiz.id, qE: E.quiz.id, qF: F.quiz.id, cAtt: cAtt.id, eAtt: eAtt.id });\n  return R.fixtures;\n}\n\nlet browser;\nasync function ctxFor(who, width) {\n  const ctx = await browser.newContext({ baseURL: BASE, bypassCSP: true, viewport: { width, height: width < 600 ? 667 : 800 } });\n  const page = await ctx.newPage();\n  R.consoleErrors[who] ??= [];\n  page.on('console', (m) => { if (m.type() === 'error') R.consoleErrors[who].push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => R.consoleErrors[who].push('PAGEERROR ' + String(e).slice(0, 300)));\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  await page.request.post('/api/auth/callback/credentials', { form: { email: em(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get('/api/auth/session')).json();\n  if (s?.user?.email !== em(who)) throw new Error('sign-in failed for ' + who);\n  return { ctx, page };\n}\nconst txt = async (page) => (await page.locator('main').first().innerText().catch(() => page.locator('body').innerText())).slice(0, 1500);\nasync function go(page, url, waitText) {\n  const res = await page.goto(url, { waitUntil: 'load', timeout: 60_000 });\n  if (waitText) await page.getByText(waitText).first().waitFor({ timeout: 20_000 });\n  await page.waitForTimeout(800);\n  return { status: res?.status(), finalUrl: new URL(page.url()).pathname };\n}\nasync function check(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 3).join(' | ') }; }\n  console.log(name, R.results[name].ok, R.results[name].error ?? '');\n}\nconst shot = (page, n) => page.screenshot({ path: `${SHOTS}/${n}.png`, fullPage: true });\nconst overflowX = (page) => page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\nconst axe = async (page) => (await new AxeBuilder({ page }).include('main').analyze()).violations.map((v) => `${v.id} (${v.impact}) x${v.nodes.length}`);\nasync function hydrated(fn, timeout = 15_000) { const end = Date.now() + timeout; let e; while (Date.now() < end) { try { return await fn(); } catch (x) { e = x; await new Promise((r) => setTimeout(r, 500)); } } throw e; }\n\n(async () => {\n  fs.rmSync(SHOTS, { recursive: true, force: true }); fs.mkdirSync(SHOTS, { recursive: true });\n  const f = await setup();\n  browser = await chromium.launch();\n  const CQ = `/courses/${f.c1}/quizzes`;\n  try {\n    // ---------- TEACHER (1280) ----------\n    const T = await ctxFor('teacher', 1280); const tp = T.page;\n    await check('teacher-course-quizzes-tab', async () => {\n      const r = await go(tp, CQ, 'UIV Fractions check');\n      const out = { ...r, quizzesTab: await tp.getByRole('tab', { name: /quizzes/i }).count() + await tp.getByRole('link', { name: /^quizzes$/i }).count(), headers: await tp.getByRole('columnheader').allInnerTexts(), text: await txt(tp), axe: await axe(tp) };\n      await shot(tp, 'teacher-course-quizzes-1280'); return out;\n    });\n    await check('teacher-new-quiz', async () => {\n      const r = await go(tp, CQ + '/new');\n      await tp.waitForURL(/\\/quizzes\\/[^/]+\\/edit$/, { timeout: 20_000 });\n      const newId = tp.url().split('/quizzes/')[1].split('/')[0];\n      const q = await prisma.quiz.findUnique({ where: { id: newId } });\n      R.fixtures.qNew = newId;\n      return { ...r, redirectedTo: new URL(tp.url()).pathname, createdStatus: q?.status, createdTitle: q?.title };\n    });\n    await check('teacher-builder-add-questions', async () => {\n      await tp.getByText('Before you can publish').first().waitFor({ timeout: 20_000 }).catch(() => {});\n      const emptyText = await txt(tp);\n      await shot(tp, 'teacher-builder-empty-1280');\n      const add = tp.getByRole('button', { name: 'Add question' });\n      await hydrated(async () => { await add.click(); await tp.getByText('1 questions').waitFor({ timeout: 2000 }); });\n      const counts = [];\n      for (const [type, n] of [['Multiple choice', 2], ['True / false', 3], ['Short answer', 4], ['Essay', 5]]) {\n        await tp.getByLabel('Question type').click();\n        const opt = tp.getByRole('option', { name: type });\n        if (!(await opt.count())) { counts.push(`${type}: option missing (${await tp.getByRole('option').allInnerTexts()})`); await tp.keyboard.press('Escape'); continue; }\n        await opt.click(); await add.click();\n        await tp.getByText(`${n} questions`).waitFor({ timeout: 10_000 }); counts.push(`${type}: ${n}`);\n      }\n      const header = await tp.getByText(/questions · /).first().innerText();\n      const problems = await tp.getByRole('alert').filter({ hasText: 'Before you can publish' }).allInnerTexts();\n      const publishDisabled = await tp.getByRole('button', { name: 'Publish', exact: true }).isDisabled();\n      const perQuestion = { drag: await tp.getByRole('button', { name: /^Drag question/ }).count(), duplicate: await tp.getByRole('button', { name: /^Duplicate question/ }).count(), delete: await tp.getByRole('button', { name: /^Delete question/ }).count(), move: await tp.getByRole('button', { name: /^Move question/ }).count() };\n      await shot(tp, 'teacher-builder-questions-1280');\n      return { emptyHasChecklist: emptyText.includes('Before you can publish'), previewDisabledWhenEmpty: null, counts, header, problems, publishDisabled, perQuestion };\n    });\n    await check('teacher-builder-duplicate-delete', async () => {\n      const before = await tp.getByText(/\\d+ questions/).first().innerText();\n      await tp.getByRole('button', { name: 'Duplicate question 1' }).click();\n      await tp.getByText('6 questions').waitFor({ timeout: 10_000 });\n      await tp.getByRole('button', { name: 'Delete question 2' }).click();\n      const dlg = tp.getByRole('dialog');\n      await dlg.waitFor({ timeout: 5000 });\n      const dlgText = await dlg.innerText();\n      await dlg.getByRole('button', { name: /^delete$/i }).click();\n      await tp.getByText('5 questions').waitFor({ timeout: 10_000 });\n      return { before, afterDuplicate: '6 questions', deleteDialog: dlgText, afterDelete: '5 questions' };\n    });\n    await check('teacher-builder-editor', async () => {\n      // Open the first (single choice) question's editor and show its option rows.\n      const editors = await tp.locator('main').getByRole('button', { name: /edit question/i }).count();\n      if (editors) await tp.locator('main').getByRole('button', { name: /edit question/i }).first().click();\n      else await tp.locator('main').getByText('Single choice').first().click();\n      await tp.waitForTimeout(800);\n      const radios = await tp.locator('main input[type=radio]').count();\n      const checkboxes = await tp.locator('main input[type=checkbox]').count();\n      const text = await txt(tp);\n      await shot(tp, 'teacher-question-editor-1280');\n      return { editorsFound: editors, radios, checkboxes, text };\n    });\n    await check('teacher-builder-settings', async () => {\n      await tp.getByRole('tab', { name: 'Settings' }).click();\n      await tp.waitForTimeout(800);\n      const labels = {};\n      for (const l of ['Title', 'Instructions', 'Opens', 'Closes', 'Time limit (minutes)', 'Attempts allowed', 'Scoring policy', 'Results visible', 'Practice quiz (not in gradebook)', 'Shuffle questions', 'Shuffle options', 'One question per page', 'Show correct answers with results'])\n        labels[l] = await tp.getByLabel(l, { exact: false }).count();\n      const accom = await tp.getByRole('table', { name: 'Accommodations' }).count();\n      const accomText = accom ? await tp.getByRole('table', { name: 'Accommodations' }).innerText() : null;\n      await shot(tp, 'teacher-builder-settings-1280');\n      // Time limit longer than window → validation (FR-6). Window of new quiz defaults; set 300 min and save.\n      await tp.getByLabel('Time limit (minutes)').fill('300');\n      const save = tp.getByRole('button', { name: /^save/i }).first();\n      if (await save.count()) await save.click();\n      await tp.waitForTimeout(1200);\n      const errors = await tp.locator('.Mui-error, [role=alert]').allInnerTexts();\n      await shot(tp, 'teacher-settings-timelimit-1280');\n      return { labels, accommodationsTable: accom, accomText, timeLimitErrors: errors.filter(Boolean).slice(0, 6) };\n    });\n    await check('teacher-builder-preview', async () => {\n      await go(tp, `${CQ}/${f.qA}/edit`, 'UIV Fractions check');\n      const lockedAlert = await tp.getByRole('alert').filter({ hasText: 'attempt' }).allInnerTexts();\n      const addDisabled = await tp.getByRole('button', { name: 'Add question' }).isDisabled().catch(() => null);\n      const links = { grade: await tp.getByRole('link', { name: 'Grade' }).count(), analytics: await tp.getByRole('link', { name: 'Analytics' }).count() };\n      await shot(tp, 'teacher-builder-locked-1280');\n      const before = await prisma.quizAttempt.count({ where: { quizId: f.qA } });\n      await tp.getByRole('button', { name: 'Preview as student' }).click();\n      await tp.getByText('Preview as student — nothing is recorded').waitFor({ timeout: 10_000 });\n      await tp.getByRole('dialog').getByLabel('3/4').first().check().catch(() => tp.getByLabel('3/4').first().check());\n      await tp.waitForTimeout(1500);\n      const previewText = await tp.getByRole('dialog').innerText().catch(() => '');\n      await shot(tp, 'teacher-preview-1280');\n      const after = await prisma.quizAttempt.count({ where: { quizId: f.qA } });\n      await tp.getByRole('button', { name: 'Close preview' }).click();\n      return { lockedAlert, addDisabled, links, attemptsBefore: before, attemptsAfterPreview: after, previewHasNotRecorded: previewText.includes('Not recorded'), previewText: previewText.slice(0, 600) };\n    });\n    await check('teacher-draft-publish-checklist', async () => {\n      await go(tp, `${CQ}/${f.qD}/edit`, 'Before you can publish');\n      const problems = await tp.getByRole('alert').filter({ hasText: 'Before you can publish' }).allInnerTexts();\n      const publishDisabled = await tp.getByRole('button', { name: 'Publish', exact: true }).isDisabled();\n      await shot(tp, 'teacher-draft-checklist-1280');\n      return { problems, publishDisabled };\n    });\n\n    // ---------- STUDENT s1 (375): take quiz A live ----------\n    const S1 = await ctxFor('s1', 375); const sp = S1.page;\n    await check('student-course-quizzes-list', async () => {\n      const r = await go(sp, CQ, 'UIV Fractions check');\n      const text = await txt(sp);\n      const out = { ...r, groups: ['Available now', 'Upcoming', 'Completed', 'Missed'].filter((g) => text.includes(g)), draftHidden: !text.includes('UIV Draft quiz'), startButtons: await sp.getByRole('link', { name: 'Start' }).count(), overflowX: await overflowX(sp), text };\n      await shot(sp, 'student-course-quizzes-375'); return out;\n    });\n    await check('student-start-screen', async () => {\n      const r = await go(sp, `/quizzes/${f.qA}/take`, 'Start attempt');\n      const text = await txt(sp);\n      await shot(sp, 'student-start-screen-375');\n      await hydrated(async () => { await sp.getByRole('button', { name: 'Start attempt' }).click(); await sp.getByRole('dialog').waitFor({ timeout: 2000 }); });\n      const dialog = await sp.getByRole('dialog').innerText();\n      await shot(sp, 'student-start-confirm-375');\n      await sp.getByRole('dialog').getByRole('button', { name: 'Start' }).click();\n      await sp.getByRole('button', { name: 'Submit' }).waitFor({ timeout: 15_000 });\n      return { ...r, text, dialog, overflowX: await overflowX(sp) };\n    });\n    await check('student-player-answer-autosave', async () => {\n      await sp.waitForTimeout(800);\n      const timer = await sp.getByLabel(/^Time remaining/).getAttribute('aria-label');\n      await sp.getByLabel('3/4').check();\n      await sp.getByLabel('1/2').nth(0).waitFor();\n      const cbs = sp.getByRole('checkbox');\n      const cbLabels = await sp.locator('main .MuiFormGroup-root label').allInnerTexts();\n      await cbs.nth(cbLabels.indexOf('1/2')).check(); await cbs.nth(cbLabels.indexOf('2/4')).check();\n      await sp.getByLabel('True', { exact: true }).check();\n      const texts = sp.locator('main input[type=text], main textarea:not([aria-hidden])');\n      await texts.nth(0).fill('  Denominator ');\n      await sp.waitForTimeout(200);\n      const pillDuring = await sp.locator('.MuiChip-label').allInnerTexts();\n      await sp.getByText('All answers saved').waitFor({ timeout: 10_000 });\n      const progress = await sp.getByRole('progressbar').first().getAttribute('aria-label');\n      const radios = await sp.locator('main input[type=radio]').count(), checkboxes = await sp.locator('main input[type=checkbox]').count();\n      await shot(sp, 'student-player-375');\n      const a = await prisma.quizAttempt.findFirst({ where: { quizId: f.qA, studentId: f.s1, status: 'IN_PROGRESS' }, include: { answers: true } });\n      R.fixtures.s1Att = a?.id;\n      return { timer, pillDuring, progress, radios, checkboxes, savedAnswersInDb: a?.answers.length, axe: await axe(sp), overflowX: await overflowX(sp) };\n    });\n    await check('student-player-offline-pill', async () => {\n      await S1.ctx.setOffline(true);\n      await sp.locator('main textarea:not([aria-hidden])').first().fill('Offline draft of my essay.');\n      await sp.getByText('Offline — answers saved on this device').waitFor({ timeout: 15_000 });\n      const ls = await sp.evaluate(() => Object.keys(localStorage).filter((k) => k.startsWith('quiz-attempt:')));\n      await shot(sp, 'student-player-offline-375');\n      await S1.ctx.setOffline(false);\n      await sp.getByText('All answers saved').waitFor({ timeout: 20_000 });\n      const a = await prisma.quizAnswer.count({ where: { attemptId: R.fixtures.s1Att } });\n      return { localStorageKeys: ls, recoveredPill: 'All answers saved', answersInDbAfterReconnect: a };\n    });\n    await check('student-player-reload-resume', async () => {\n      await sp.reload({ waitUntil: 'load' });\n      await sp.getByRole('button', { name: 'Submit' }).waitFor({ timeout: 15_000 });\n      await sp.waitForTimeout(800);\n      const checked = await sp.getByLabel('3/4').isChecked();\n      const essay = await sp.locator('main textarea:not([aria-hidden])').first().inputValue();\n      const inProgress = await prisma.quizAttempt.count({ where: { quizId: f.qA, studentId: f.s1, status: 'IN_PROGRESS' } });\n      return { singleChoiceStillChecked: checked, essayValue: essay, inProgressAttempts: inProgress };\n    });\n    await check('student-submit', async () => {\n      await sp.locator('main textarea:not([aria-hidden])').first().fill('');\n      await sp.getByText('All answers saved').waitFor({ timeout: 10_000 });\n      await sp.waitForTimeout(1200);\n      await sp.getByRole('button', { name: 'Submit' }).click();\n      const dialog = await sp.getByRole('dialog').innerText();\n      await shot(sp, 'student-submit-confirm-375');\n      await sp.locator('main textarea').first().count();\n      // Fill the essay before actually submitting, so the teacher has something to grade.\n      await sp.getByRole('dialog').getByRole('button', { name: /cancel/i }).click();\n      await sp.locator('main textarea:not([aria-hidden])').first().fill('Find a common denominator, then compare the numerators.');\n      await sp.getByText('All answers saved').waitFor({ timeout: 10_000 }); await sp.waitForTimeout(1200);\n      await sp.getByRole('button', { name: 'Submit' }).click();\n      await sp.getByRole('dialog').getByRole('button', { name: 'Submit' }).click();\n      await sp.waitForURL(/\\/attempts\\//, { timeout: 20_000 }).catch(() => {});\n      await sp.waitForTimeout(1500);\n      const a = await prisma.quizAttempt.findUnique({ where: { id: R.fixtures.s1Att } });\n      const text = await txt(sp);\n      await shot(sp, 'student-result-needs-grading-375');\n      return { confirmDialog: dialog, landedOn: new URL(sp.url()).pathname, dbStatus: a?.status, dbScore: a?.score?.toString(), text };\n    });\n\n    // ---------- TEACHER grades s1's essay ----------\n    await check('teacher-grade-by-student', async () => {\n      const r = await go(tp, `${CQ}/${f.qA}/grade`);\n      await tp.waitForTimeout(800);\n      const text = await txt(tp);\n      const modes = await tp.getByRole('button', { name: /^By (student|question)$/ }).count() + await tp.getByRole('tab', { name: /^By (student|question)$/ }).count();\n      await shot(tp, 'teacher-grade-by-student-1280');\n      // Pick Alex's attempt if a selector exists\n      const sel = tp.getByLabel('Attempt');\n      if (await sel.count()) { await sel.first().click(); const o = tp.getByRole('option', { name: /Alex/ }); if (await o.count()) await o.first().click(); else await tp.keyboard.press('Escape'); await tp.waitForTimeout(500); }\n      const needs = tp.locator('main .MuiPaper-root').filter({ has: tp.getByText('Needs grading', { exact: true }) }).filter({ has: tp.getByLabel('Points') });\n      const n = await needs.count();\n      let saved = null;\n      if (n) {\n        const card = needs.first();\n        await card.getByLabel('Points').fill('3.5');\n        await card.getByLabel('Feedback').fill('Clear method.');\n        await card.getByRole('button', { name: 'Save' }).click();\n        await tp.getByText('Grade saved').waitFor({ timeout: 10_000 }); saved = 'Grade saved';\n      }\n      await tp.waitForTimeout(800);\n      const a = await prisma.quizAttempt.findUnique({ where: { id: R.fixtures.s1Att } });\n      await shot(tp, 'teacher-grade-saved-1280');\n      return { ...r, modes, needsGradingCards: n, saved, dbStatusAfter: a?.status, dbScoreAfter: a?.score?.toString(), text };\n    });\n    await check('teacher-grade-invalid-points', async () => {\n      const card = tp.locator('main .MuiPaper-root').filter({ has: tp.getByLabel('Points') }).first();\n      await card.getByLabel('Points').fill('99');\n      await tp.waitForTimeout(300);\n      const helper = await card.locator('.MuiFormHelperText-root').first().innerText();\n      const saveDisabled = await card.getByRole('button', { name: 'Save' }).isDisabled();\n      await shot(tp, 'teacher-grade-invalid-1280');\n      await card.getByLabel('Points').fill('0.3'); await tp.waitForTimeout(300);\n      const helperStep = await card.locator('.MuiFormHelperText-root').first().innerText();\n      return { helper, saveDisabled, helperStep };\n    });\n    await check('teacher-grade-by-question', async () => {\n      await go(tp, `${CQ}/${f.qA}/grade`);\n      const b = tp.getByRole('button', { name: 'By question' });\n      await hydrated(async () => { await ((await b.count()) ? b : tp.getByRole('tab', { name: 'By question' })).click(); await tp.getByLabel('Question').first().waitFor({ timeout: 2000 }); });\n      await tp.waitForTimeout(600);\n      const text = await txt(tp);\n      await shot(tp, 'teacher-grade-by-question-1280');\n      return { text };\n    });\n    await check('teacher-analytics', async () => {\n      const r = await go(tp, `${CQ}/${f.qA}/analytics`, 'Median');\n      await tp.waitForTimeout(1200);\n      const text = await txt(tp);\n      const svgBars = await tp.locator('main svg rect, main svg path.MuiBarElement-root').count();\n      const perQ = await tp.getByRole('table', { name: 'Per-question results' }).count();\n      const csv = await tp.getByRole('link', { name: /csv/i }).count() + await tp.getByRole('button', { name: /csv/i }).count();\n      const csvRes = await tp.request.get(`/api/quizzes/${f.qA}/analytics?format=csv`);\n      await shot(tp, 'teacher-analytics-1280');\n      return { ...r, svgBars, perQuestionTable: perQ, csvControl: csv, csvStatus: csvRes.status(), csvHead: (await csvRes.text()).split('\\n').slice(0, 3), axe: await axe(tp), text };\n    });\n    await check('teacher-list-after', async () => {\n      await go(tp, CQ, 'UIV Fractions check');\n      return { text: await txt(tp) };\n    });\n    await check('teacher-release-manual', async () => {\n      await go(tp, `${CQ}/${f.qE}/edit`, 'UIV Manual-release quiz');\n      const btn = tp.getByRole('button', { name: 'Release results' });\n      const present = await btn.count();\n      await shot(tp, 'teacher-manual-release-1280');\n      return { releaseButton: present };\n    });\n\n    // ---------- STUDENT s1 sees graded result ----------\n    await check('student-result-graded', async () => {\n      const r = await go(sp, `/quizzes/${f.qA}/attempts/${R.fixtures.s1Att}`);\n      const text = await txt(sp);\n      await shot(sp, 'student-result-graded-375');\n      return { ...r, hasCorrectAnswer: text.includes('Correct answer'), hasFeedback: text.includes('Clear method.'), overflowX: await overflowX(sp), text };\n    });\n    await check('student-list-after', async () => {\n      await go(sp, CQ, 'UIV Fractions check');\n      const text = await txt(sp);\n      await shot(sp, 'student-course-quizzes-after-375');\n      return { text };\n    });\n\n    // ---------- STUDENT s3: manual-release pending, missed, red timer ----------\n    const S3 = await ctxFor('s3', 375); const s3p = S3.page;\n    await check('student-s3-list', async () => {\n      await go(s3p, CQ, 'UIV Practice sprint');\n      const text = await txt(s3p);\n      await shot(s3p, 'student-s3-quizzes-375');\n      return { hasMissed: text.includes('Missed'), pendingText: text.includes('results will be available later'), text };\n    });\n    await check('student-manual-pending-result', async () => {\n      const r = await go(s3p, `/quizzes/${f.qE}/attempts/${f.eAtt}`);\n      const text = await txt(s3p);\n      await shot(s3p, 'student-result-pending-375');\n      return { ...r, pending: text.includes('Submitted — results will be available later.'), leaksScore: /\\b7\\s*\\/\\s*7\\b/.test(text), text };\n    });\n    await check('student-pending-api-no-correct', async () => {\n      const res = await s3p.request.get(`/api/attempts/${f.eAtt}`); const body = await res.text();\n      const q = await s3p.request.get(`/api/quizzes/${f.qA}`); const qb = await q.text();\n      return { attemptStatus: res.status(), attemptHasCorrect: body.includes('\"correct\"'), quizStatus: q.status(), quizHasCorrect: qb.includes('\"correct\"'), quizHasExplanation: qb.includes('3/4 = 0.75') };\n    });\n    await check('student-one-per-page-timer', async () => {\n      await go(s3p, `/quizzes/${f.qF}/take`, 'Start attempt');\n      await hydrated(async () => { await s3p.getByRole('button', { name: 'Start attempt' }).click(); await s3p.getByRole('dialog').waitFor({ timeout: 2000 }); });\n      const dialog = await s3p.getByRole('dialog').innerText();\n      await s3p.getByRole('dialog').getByRole('button', { name: 'Start' }).click();\n      await s3p.getByRole('navigation', { name: 'Question navigator' }).waitFor({ timeout: 15_000 });\n      await s3p.waitForTimeout(800);\n      const timerEl = s3p.getByLabel(/^Time remaining/);\n      const color = await timerEl.evaluate((e) => getComputedStyle(e).color);\n      await s3p.getByLabel('3/4').check();\n      await s3p.getByRole('button', { name: 'Flag for review' }).click();\n      const navLabels = await s3p.getByRole('navigation', { name: 'Question navigator' }).getByRole('button').evaluateAll((els) => els.map((e) => e.getAttribute('aria-label')));\n      const visibleQuestions = await s3p.locator('main fieldset').count();\n      await shot(s3p, 'student-one-per-page-375');\n      await s3p.getByRole('button', { name: 'Next' }).click(); await s3p.waitForTimeout(300);\n      const legend2 = await s3p.locator('main fieldset').first().innerText();\n      return { dialog, timer: await timerEl.getAttribute('aria-label'), timerColor: color, navLabels, visibleQuestions, page2: legend2.slice(0, 120), overflowX: await overflowX(s3p) };\n    });\n\n    // ---------- PARENT (375) ----------\n    const P = await ctxFor('parent', 375); const pp = P.page;\n    await check('parent-course-quizzes', async () => {\n      const r = await go(pp, CQ);\n      await pp.waitForTimeout(800);\n      const text = await txt(pp);\n      const actions = await pp.getByRole('link', { name: /^(Start|Resume)$/ }).count();\n      await shot(pp, 'parent-course-quizzes-375');\n      return { ...r, text, startResumeLinks: actions, overflowX: await overflowX(pp) };\n    });\n    await check('parent-result-view', async () => {\n      const r = await go(pp, `/quizzes/${f.qC}/attempts/${f.cAtt}`);\n      const text = await txt(pp);\n      await shot(pp, 'parent-result-375');\n      const inputs = await pp.locator('main input, main textarea').count();\n      return { ...r, inputs, hidesCorrectAnswers: !text.includes('Correct answer'), text };\n    });\n\n    // ---------- Student s1 at desktop for one wide view ----------\n    const S1w = await ctxFor('s1', 1280);\n    await check('student-result-graded-1280', async () => {\n      await go(S1w.page, `/quizzes/${f.qA}/attempts/${R.fixtures.s1Att}`);\n      await shot(S1w.page, 'student-result-graded-1280');\n      return {};\n    });\n  } finally {\n    await browser.close();\n    await cleanup().catch((e) => (R.cleanupError = String(e)));\n    R.cleanedUp = !(await prisma.user.count({ where: { email: { startsWith: `${TAG}-` } } }));\n    await prisma.$disconnect();\n    fs.writeFileSync(OUT + '/uiv-raw.json', JSON.stringify(R, null, 1));\n    console.log('done; cleanedUp', R.cleanedUp);\n  }\n})();\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KNy8yBJzCcZxwPFR8wBteG","type":"tool_result","content":"File created successfully at: /tmp/uiv-sh10/driver.cjs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"0ac7f625-80e7-44e9-9e39-f496ace1cf88","uuid":"214aa408-b228-4737-9801-5c63546bcdbf","timestamp":"2026-11-09T08:01:36.386Z","tool_use_result":{"type":"create","filePath":"/tmp/uiv-sh10/driver.cjs","content":"// SH-10 UI verification driver. Throwaway; lives outside the repo. Run with cwd = repo (for node_modules).\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst AxeBuilder = require('@axe-core/playwright').default;\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/forge/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh10';\nconst PW = 'Uiv-Sh10!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst H = 3600_000, D = 24 * H;\n\nasync function cleanup() {\n  await prisma.course.deleteMany({ where: { code: { startsWith: TAG } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.quizAttempt.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.notification.deleteMany({ where: { userId: { in: ids } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.fileObject.deleteMany({ where: { ownerId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n}\n\nconst OPTS = [{ id: 'o1', text: '1/2' }, { id: 'o2', text: '2/3' }, { id: 'o3', text: '3/4' }, { id: 'o4', text: '2/4' }];\nconst QSET = [\n  { type: 'SINGLE_CHOICE', prompt: 'Which fraction is **largest**?', points: '2', options: OPTS, correct: { optionId: 'o3' }, explanation: '3/4 = 0.75.' },\n  { type: 'MULTIPLE_CHOICE', prompt: 'Select every fraction equal to one half.', points: '4', options: OPTS, correct: { optionIds: ['o1', 'o4'] }, explanation: '2/4 simplifies to 1/2.' },\n  { type: 'TRUE_FALSE', prompt: '5/5 equals 1.', points: '1', correct: { value: true } },\n  { type: 'SHORT_ANSWER', prompt: 'Name the bottom number of a fraction.', points: '1', correct: { accepted: ['denominator'] } },\n  { type: 'ESSAY', prompt: 'Explain how you compare two fractions.', points: '4', correct: { guidance: 'Common denominator or decimals.' } },\n];\n\nasync function mkQuiz(data, qs) {\n  const quiz = await prisma.quiz.create({ data });\n  const questions = [];\n  for (const [i, q] of qs.entries()) questions.push(await prisma.question.create({ data: { ...q, quizId: quiz.id, order: i } }));\n  return { quiz, questions };\n}\nasync function mkAttempt(quiz, questions, studentId, n, status, answers, extra = {}) {\n  const max = questions.reduce((s, q) => s + Number(q.points), 0);\n  const score = status === 'GRADED' ? answers.reduce((s, a) => s + Number(a.pointsAwarded ?? 0), 0) : null;\n  const a = await prisma.quizAttempt.create({ data: { quizId: quiz.id, studentId, attemptNumber: n, status, startedAt: new Date(Date.now() - 2 * D), submittedAt: new Date(Date.now() - 2 * D + 12 * 60_000), questionOrder: questions.map((q) => q.id), maxScore: String(max), score: score == null ? null : String(score), ...extra } });\n  for (const [i, ans] of answers.entries()) if (ans) await prisma.quizAnswer.create({ data: { attemptId: a.id, questionId: questions[i].id, ...ans } });\n  return a;\n}\n\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Blake', 'Bell', 'STUDENT');\n  const s3 = await mk('s3', 'Morgan', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s2.id, relationship: 'MOTHER', isPrimary: true } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id };\n  // qA: open, IMMEDIATELY, 20 min, 2 attempts; s1 takes it live through the UI. s2 has one graded attempt (analytics data).\n  const A = await mkQuiz({ ...base, title: 'UIV Fractions check', instructions: 'Answer **all** questions. Calculators allowed.', availableFrom: new Date(now - D), availableUntil: new Date(now + 2 * D), timeLimitMinutes: 20, maxAttempts: 2, resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: true, status: 'PUBLISHED' }, QSET);\n  const qa = A.questions;\n  await mkAttempt(A.quiz, qa, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o2' }, pointsAwarded: '0', isCorrect: false },\n    { response: { optionIds: ['o1'] }, pointsAwarded: '2', isCorrect: false },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'Denominator' }, pointsAwarded: '1', isCorrect: true },\n    { response: { text: 'I turn them into decimals.' }, pointsAwarded: '3', isCorrect: null, feedback: 'Good, show an example next time.', gradedById: t.id },\n  ]);\n  // qB: upcoming (AFTER_CLOSE).\n  const B = await mkQuiz({ ...base, title: 'UIV Unit 1 test', availableFrom: new Date(now + 2 * D), availableUntil: new Date(now + 3 * D), timeLimitMinutes: 45, resultsVisibility: 'AFTER_CLOSE', status: 'PUBLISHED' }, QSET.slice(0, 3));\n  // qC: closed; s2 graded (parent sees it, released via IMMEDIATELY); s3 never attempted → Missed.\n  const C = await mkQuiz({ ...base, title: 'UIV Decimals quick check', availableFrom: new Date(now - 5 * D), availableUntil: new Date(now - D), resultsVisibility: 'IMMEDIATELY', showCorrectAnswers: false, status: 'CLOSED' }, QSET.slice(0, 3));\n  const cAtt = await mkAttempt(C.quiz, C.questions, s2.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o2'] }, pointsAwarded: '0', isCorrect: false },\n    { response: { value: false }, pointsAwarded: '0', isCorrect: false },\n  ]);\n  // qD: draft with an unfinished choice question → publish checklist.\n  const Dq = await mkQuiz({ ...base, title: 'UIV Draft quiz', availableFrom: new Date(now + D), availableUntil: new Date(now + 2 * D), status: 'DRAFT' }, [{ type: 'SINGLE_CHOICE', prompt: 'Draft question', points: '1', options: OPTS.slice(0, 2), correct: {} }]);\n  // qE: MANUAL results; s3 submitted, awaiting release.\n  const E = await mkQuiz({ ...base, title: 'UIV Manual-release quiz', availableFrom: new Date(now - D), availableUntil: new Date(now + D), resultsVisibility: 'MANUAL', status: 'PUBLISHED', maxAttempts: 1 }, QSET.slice(0, 3));\n  const eAtt = await mkAttempt(E.quiz, E.questions, s3.id, 1, 'GRADED', [\n    { response: { optionId: 'o3' }, pointsAwarded: '2', isCorrect: true },\n    { response: { optionIds: ['o1', 'o4'] }, pointsAwarded: '4', isCorrect: true },\n    { response: { value: true }, pointsAwarded: '1', isCorrect: true },\n  ]);\n  // qF: practice, one-per-page, 1-minute limit → red timer + navigator (s3).\n  const F = await mkQuiz({ ...base, title: 'UIV Practice sprint', isPractice: true, availableFrom: new Date(now - D), availableUntil: new Date(now + D), timeLimitMinutes: 1, maxAttempts: 3, oneQuestionPerPage: true, resultsVisibility: 'IMMEDIATELY', status: 'PUBLISHED' }, QSET.slice(0, 4));\n  Object.assign(R.fixtures, { t: t.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, qA: A.quiz.id, qB: B.quiz.id, qC: C.quiz.id, qD: Dq.quiz.id, qE: E.quiz.id, qF: F.quiz.id, cAtt: cAtt.id, eAtt: eAtt.id });\n  return R.fixtures;\n}\n\nlet browser;\nasync function ctxFor(who, width) {\n  const ctx = await browser.newContext({ baseURL: BASE, bypassCSP: true, viewport: { width, height: width < 600 ? 667 : 800 } });\n  const page = await ctx.newPage();\n  R.consoleErrors[who] ??= [];\n  page.on('console', (m) => { if (m.type() === 'error') R.consoleErrors[who].push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => R.consoleErrors[who].push('PAGEERROR ' + String(e).slice(0, 300)));\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  await page.request.post('/api/auth/callback/credentials', { form: { email: em(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get('/api/auth/session')).json();\n  if (s?.user?.email !== em(who)) throw new Error('sign-in failed for ' + who);\n  return { ctx, page };\n}\nconst txt = async (page) => (await page.locator('main').first().innerText().catch(() => page.locator('body').innerText())).slice(0, 1500);\nasync function go(page, url, waitText) {\n  const res = await page.goto(url, { waitUntil: 'load', timeout: 60_000 });\n  if (waitText) await page.getByText(waitText).first().waitFor({ timeout: 20_000 });\n  await page.waitForTimeout(800);\n  return { status: res?.status(), finalUrl: new URL(page.url()).pathname };\n}\nasync function check(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 3).join(' | ') }; }\n  console.log(name, R.results[name].ok, R.results[name].error ?? '');\n}\nconst shot = (page, n) => page.screenshot({ path: `${SHOTS}/${n}.png`, fullPage: true });\nconst overflowX = (page) => page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\nconst axe = async (page) => (await new AxeBuilder({ page }).include('main').analyze()).violations.map((v) => `${v.id} (${v.impact}) x${v.nodes.length}`);\nasync function hydrated(fn, timeout = 15_000) { const end = Date.now() + timeout; let e; while (Date.now() < end) { try { return await fn(); } catch (x) { e = x; await new Promise((r) => setTimeout(r, 500)); } } throw e; }\n\n(async () => {\n  fs.rmSync(SHOTS, { recursive: true, force: true }); fs.mkdirSync(SHOTS, { recursive: true });\n  const f = await setup();\n  browser = await chromium.launch();\n  const CQ = `/courses/${f.c1}/quizzes`;\n  try {\n    // ---------- TEACHER (1280) ----------\n    const T = await ctxFor('teacher', 1280); const tp = T.page;\n    await check('teacher-course-quizzes-tab', async () => {\n      const r = await go(tp, CQ, 'UIV Fractions check');\n      const out = { ...r, quizzesTab: await tp.getByRole('tab', { name: /quizzes/i }).count() + await tp.getByRole('link', { name: /^quizzes$/i }).count(), headers: await tp.getByRole('columnheader').allInnerTexts(), text: await txt(tp), axe: await axe(tp) };\n      await shot(tp, 'teacher-course-quizzes-1280'); return out;\n    });\n    await check('teacher-new-quiz', async () => {\n      const r = await go(tp, CQ + '/new');\n      await tp.waitForURL(/\\/quizzes\\/[^/]+\\/edit$/, { timeout: 20_000 });\n      const newId = tp.url().split('/quizzes/')[1].split('/')[0];\n      const q = await prisma.quiz.findUnique({ where: { id: newId } });\n      R.fixtures.qNew = newId;\n      return { ...r, redirectedTo: new URL(tp.url()).pathname, createdStatus: q?.status, createdTitle: q?.title };\n    });\n    await check('teacher-builder-add-questions', async () => {\n      await tp.getByText('Before you can publish').first().waitFor({ timeout: 20_000 }).catch(() => {});\n      const emptyText = await txt(tp);\n      await shot(tp, 'teacher-builder-empty-1280');\n      const add = tp.getByRole('button', { name: 'Add question' });\n      await hydrated(async () => { await add.click(); await tp.getByText('1 questions').waitFor({ timeout: 2000 }); });\n      const counts = [];\n      for (const [type, n] of [['Multiple choice', 2], ['True / false', 3], ['Short answer', 4], ['Essay', 5]]) {\n        await tp.getByLabel('Question type').click();\n        const opt = tp.getByRole('option', { name: type });\n        if (!(await opt.count())) { counts.push(`${type}: option missing (${await tp.getByRole('option').allInnerTexts()})`); await tp.keyboard.press('Escape'); continue; }\n        await opt.click(); await add.click();\n        await tp.getByText(`${n} questions`).waitFor({ timeout: 10_000 }); counts.push(`${type}: ${n}`);\n      }\n      const header = await tp.getByText(/questions · /).first().innerText();\n      const problems = await tp.getByRole('alert').filter({ hasText: 'Before you can publish' }).allInnerTexts();\n      const publishDisabled = await tp.getByRole('button', { name: 'Publish', exact: true }).isDisabled();\n      const perQuestion = { drag: await tp.getByRole('button', { name: /^Drag question/ }).count(), duplicate: await tp.getByRole('button', { name: /^Duplicate question/ }).count(), delete: await tp.getByRole('button', { name: /^Delete question/ }).count(), move: await tp.getByRole('button', { name: /^Move question/ }).count() };\n      await shot(tp, 'teacher-builder-questions-1280');\n      return { emptyHasChecklist: emptyText.includes('Before you can publish'), previewDisabledWhenEmpty: null, counts, header, problems, publishDisabled, perQuestion };\n    });\n    await check('teacher-builder-duplicate-delete', async () => {\n      const before = await tp.getByText(/\\d+ questions/).first().innerText();\n      await tp.getByRole('button', { name: 'Duplicate question 1' }).click();\n      await tp.getByText('6 questions').waitFor({ timeout: 10_000 });\n      await tp.getByRole('button', { name: 'Delete question 2' }).click();\n      const dlg = tp.getByRole('dialog');\n      await dlg.waitFor({ timeout: 5000 });\n      const dlgText = await dlg.innerText();\n      await dlg.getByRole('button', { name: /^delete$/i }).click();\n      await tp.getByText('5 questions').waitFor({ timeout: 10_000 });\n      return { before, afterDuplicate: '6 questions', deleteDialog: dlgText, afterDelete: '5 questions' };\n    });\n    await check('teacher-builder-editor', async () => {\n      // Open the first (single choice) question's editor and show its option rows.\n      const editors = await tp.locator('main').getByRole('button', { name: /edit question/i }).count();\n      if (editors) await tp.locator('main').getByRole('button', { name: /edit question/i }).first().click();\n      else await tp.locator('main').getByText('Single choice').first().click();\n      await tp.waitForTimeout(800);\n      const radios = await tp.locator('main input[type=radio]').count();\n      const checkboxes = await tp.locator('main input[type=checkbox]').count();\n      const text = await txt(tp);\n      await shot(tp, 'teacher-question-editor-1280');\n      return { editorsFound: editors, radios, checkboxes, text };\n    });\n    await check('teacher-builder-settings', async () => {\n      await tp.getByRole('tab', { name: 'Settings' }).click();\n      await tp.waitForTimeout(800);\n      const labels = {};\n      for (const l of ['Title', 'Instructions', 'Opens', 'Closes', 'Time limit (minutes)', 'Attempts allowed', 'Scoring policy', 'Results visible', 'Practice quiz (not in gradebook)', 'Shuffle questions', 'Shuffle options', 'One question per page', 'Show correct answers with 