{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dx7R73ztwmCzRLcQGPijo8","type":"tool_result","content":"import { expect, type Page } from '@playwright/test';\n\n/** Signs in through next-auth's credentials callback; cookies land on `page`'s context. */\nexport async function signInAs(page: Page, email: string, password = 'SchoolHub123!') {\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  const res = await page.request.post('/api/auth/callback/credentials', {\n    form: { email, password, csrfToken, callbackUrl: '/dashboard' },\n  });\n  expect(res.ok()).toBeTruthy();\n  const session = await (await page.request.get('/api/auth/session')).json();\n  expect(session?.user?.email).toBe(email);\n}\n// SH-11 UI verification driver. Throwaway; lives outside the repo. Run with NODE_PATH=<repo>/node_modules, cwd = repo.\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst AxeBuilder = require('@axe-core/playwright').default;\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh11';\nconst PW = 'Uiv-Sh11!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst D = 86_400_000;\n\nasync function cleanup() {\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.reportCard.deleteMany({ where: { studentId: { in: ids } } });\n  const cids = (await prisma.course.findMany({ where: { code: { startsWith: TAG } }, select: { id: true } })).map((c) => c.id);\n  await prisma.termGradeOverride.deleteMany({ where: { courseId: { in: cids } } });\n  await prisma.course.deleteMany({ where: { id: { in: cids } } });\n  await prisma.sectionMember.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.section.deleteMany({ where: { name: TAG } });\n  await prisma.term.deleteMany({ where: { name: `${TAG} term` } });\n  await prisma.gradingScale.deleteMany({ where: { name: { startsWith: TAG } } });\n  await prisma.notification.deleteMany({ where: { userId: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.parentStudentLink.deleteMany({ where: { parentId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n}\n\nasync function setupBase() {\n  await cleanup();\n  const year = await prisma.academicYear.findFirstOrThrow({ where: { isCurrent: true } });\n  const subject = await prisma.subject.findFirstOrThrow();\n  const gl = await prisma.gradeLevel.findFirstOrThrow({ where: { archivedAt: null } });\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } }).then((u) => u.id);\n  const f = R.fixtures;\n  f.year = year.id;\n  f.admin = await mk('admin', 'Ada', 'Office', 'ADMIN');\n  f.t = await mk('teacher', 'Hal', 'Homeroom', 'TEACHER');\n  f.s1 = await mk('s1', 'Sam', 'Aardvark', 'STUDENT');\n  f.s2 = await mk('s2', 'Zed', 'Zebra', 'STUDENT');\n  f.s3 = await mk('s3', 'Olly', 'Outsider', 'STUDENT');\n  f.p = await mk('parent', 'Pam', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.createMany({ data: [f.s1, f.s2].map((studentId, i) => ({ parentId: f.p, studentId, relationship: 'MOTHER', isPrimary: i === 0 })) });\n  f.section = (await prisma.section.create({ data: { name: TAG, academicYearId: year.id, gradeLevelId: gl.id, homeroomTeacherId: f.t } })).id;\n  await prisma.sectionMember.createMany