{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xjf2JNx95B3hZeCnXhdGnd","type":"tool_result","content":"  const childLabel = props.mode === 'teacher' ? `My child's teachers (${props.childFirstName})` : '';\n  const groupFilter = useCallback((label: string) => label === childLabel, [childLabel]);\n\n  return (\n    <Stack direction=\"row\" sx={{ justifyContent: 'flex-end', mb: 1 }}>\n      <Button variant=\"outlined\" size=\"small\" startIcon={<ChatBubbleOutlineOutlinedIcon />} onClick={() => setOpen(true)}>\n        {props.mode === 'parents' ? 'Message parents' : 'Message teacher'}\n      </Button>\n      {props.mode === 'parents' ? (\n        <NewConversationDialog open={open} onClose={() => setOpen(false)} initialRecipients={props.parents} initialSubject={props.studentName} />\n      ) : (\n        <NewConversationDialog open={open} onClose={() => setOpen(false)} groupFilter={groupFilter} />\n      )}\n    </Stack>\n  );\n}\n5:import { StudentMessageActions, type StudentMessageActionsProps } from '@/components/messaging/StudentMessageActions';\n6-\n7-/**\n8- * PRD-13 FR-16: a compact action row above every student tab. The [id] segment name is kept.\n--\n17:      {actions && <StudentMessageActions {...actions} />}\n18-      {children}\n19-    </>\n20-  );\n--\n23:async function resolveActions(user: Awaited<ReturnType<typeof requirePageUser>>, studentId: string): Promise<StudentMessageActionsProps | null> {\n24-  if (user.role === 'STUDENT') return null;\n25-  await assertCanViewStudent(user, studentId);\n26-  const student = await prisma.user.findUnique({\n\n  const toggle = (id: string) =>\n    setSelected((prev) => {\n      const next = new Set(prev);\n      if (!next.delete(id)) next.add(id);\n      return next;\n    });\n\n  return (\n    <TableContainer component={Paper} variant=\"outlined\">\n      <Toolbar variant=\"dense\" sx={{ gap: 2 }}>\n        <Typography variant=\"body2\" sx={{ flex: 1 }} color=\"text.secondary\">\n          {selected.size ? `${selected.size} selected` : 'Select students to message them'}\n        </Typography>\n        <Button size=\"small\" variant=\"contained\" startIcon={<ChatBubbleOutlineOutlinedIcon />} disabled={!selected.size} onClick={() => setOpen(true)}>\n          Message selected students\n        </Button>\n      </Toolbar>\n      <Table size=\"small\" aria-label=\"Course roster\">\n        <TableHead>\n          <TableRow>\n            <TableCell padding=\"checkbox\">\n              <Checkbox\n                checked={allSelected}\n                indeterminate={selected.size > 0 && !allSelected}\n                disabled={!selectable.length}\n                onChange={() => setSelected(allSelected ? new Set() : new Set(selectable.map((r) => r.studentId)))}\n                slotProps={{ input: { 'aria-label': 'Select all students' } }}\n              />\n            </TableCell>\n            <TableCell>Student</TableCell>\n      setBusy(false);\n    }\n  }\n\n  return (\n    <Paper variant=\"outlined\" sx={{ p: 2, mt: 3 }} component=\"section\" aria-labelledby=\"quiet-hours-title\">\n      <Typography variant=\"h6\" id=\"quiet-hours-title\">\n        Quiet hours\n      </Typography>\n      <Typography variant=\"body2\" color=\"text.secondary\" sx={{ mb: 2 }}>\n        Message emails are held until quiet hours end. Times are in the school timezone ({timezone}) and may run past midnight.\n      </Typography>\n      {error && (\n        <Alert severity=\"error\" sx={{ mb: 2 }}>\n          {error}\n        </Alert>\n      )}\n      <Stack direction={{ xs: 'column', sm: 'row' }} spacing={2} sx={{ alignItems: { sm: 'flex-start' } }}>\n        <TextField\n          type=\"time\"\n          label=\"Start\"\n          value={start}\n          onChange={(e) => setStart(e.target.value)}\n          slotProps={{ inputLabel: { shrink: true } }}\n          size=\"small\"\n        />\n        <TextField\n          type=\"time\"\n          label=\"End\"\n          value