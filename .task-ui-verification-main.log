await axe(teacher, 'teacher-inbox-1280');\n    await lead.goto('/admin/safeguarding');\n    await lead.getByText('UIV test report').first().waitFor();\n    await axe(lead, 'lead-safeguarding-1280');\n    await parent.goto('/account/notifications');\n    await parent.getByRole('region', { name: 'Quiet hours' }).waitFor();\n    await axe(parent, 'parent-notifications-1280');\n    rec('axe', true, JSON.stringify(R.axe));\n  });\n\n  await browser.close();\n  R.finished = new Date().toISOString();\n  fs.writeFileSync(OUT + '/uiv-raw.json', JSON.stringify(R, null, 2));\n  if (!process.env.KEEP) await cleanup();\n  const left = await prisma.user.count({ where: { email: { startsWith: `${TAG}-` } } });\n  console.log('fixtures left:', left);\n  await prisma.$disconnect();\n})().catch(async (e) => {\n  console.error('FATAL', e);\n  fs.writeFileSync(OUT + '/uiv-raw.json', JSON.stringify({ ...R, fatal: String(e) }, null, 2));\n  await cleanup().catch(() => {});\n  process.exit(1);\n});\n","structuredPatch":[{"oldStart":125,"oldLines":7,"newStart":125,"newLines":13,"lines":["     await parent.waitForURL(/\\/messages\\/[^/]+$/, { timeout: 10000 });","     convId = parent.url().split('/').pop();","     await thread(parent, 'a question about Sam').waitFor();","-    rec('FR-12 dialog', true, `Recipient picker grouped, subject + first message; navigated to /messages/${convId}`);","+    await parent.waitForTimeout(2500);","+    const lingering = await parent.getByRole('dialog').count();","+    const lingerVisible = lingering ? await parent.getByRole('dialog').first().isVisible() : false;","+    R.fixtures.dialogAfterSend = { lingering, lingerVisible, text: lingering ? (await parent.getByRole('dialog').first().innerText()).slice(0, 300) : '' };","+    await shot(parent, 'parent-after-send-1280');","+    if (lingering) { await parent.keyboard.press('Escape'); await parent.waitForTimeout(800); }","+    rec('FR-12 dialog', lingering === 0, `Recipient picker grouped, subject + first messa