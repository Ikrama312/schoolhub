r({ timeout: 10_000 });\n      await ap.getByRole('button', { name: /Unpublish/ }).click();\n      const dlg = ap.getByRole('dialog'); await dlg.waitFor();\n      const confirmDisabledEmpty = await dlg.getByRole('button', { name: /Unpublish/ }).isDisabled();\n      await shot(ap, 'admin-report-card-unpublish-dialog-1280');\n      await dlg.getByLabel('Reason').fill('Correcting a typo');\n      await dlg.getByRole('button', { name: /Unpublish/ }).click();\n      await ap.getByRole('button', { name: /^Publish/ }).waitFor({ timeout: 10_000 });\n      const audit = await prisma.auditLog.findFirst({ where: { actorId: f.admin, action: { contains: 'unpublish' } } });\n      const db = await prisma.reportCard.findUnique({ where: { id: f.card1 } });\n      return { ...st, principalSaved: db.principalComment, previewHas: { comment: preview.includes('Steady progress'), letter: preview.includes('78.0'), homeroom: preview.includes('kind and focused') }, preview: preview.slice(0, 1200), confirmDisabledEmpty, statusAfterUnpublish: db.status, unpublishAudit: !!audit };\n    });\n\n    await check('admin-publish-all-and-print-all', async () => {\n      await go(ap, '/admin/report-cards');\n      await hydrated(async () => { await ap.getByLabel('Term').click(); await ap.getByRole('option', { name: new RegExp(TAG) }).click({ timeout: 2000 }); });\n      await pickSection();\n      await ap.getByRole('gridcell', { name: 'Aardvark, Sam' }).waitFor();\n      await ap.getByRole('button', { name: /Publish all/ }).click();\n      await ap.getByRole('dialog').getByRole('button', { name: 'Publish' }).click();\n      await ap.waitForTimeout(2000);\n      await ap.getByRole('gridcell', { name: 'Published' }).first().waitFor({ timeout: 15_000 });\n      const rows = await ap.locator('[role=\"row\"]').allInnerTexts();\n      await shot(ap, 'admin-report-cards-published-1280');\n      const notes = await prisma.notification.findMany({ where: { type: 'report_card.published', userId: { in: [f.s1, f.s2, f.p] } }, select: { userId: true } });\n      const printAll = ap.getByRole('link', { name: /Print all/ });\n      await printAll.click(); await ap.waitForURL(/report-cards\\/print/);\n      await ap.waitForTimeout(1000);\n      const articles = await ap.getByRole('article').count();\n      const breaks = await ap.getByRole('article').evaluateAll((els) => els.map((e) => getComputedStyle(e).breakAfter + '/' + getComputedStyle(e).pageBreakAfter));\n      await shot(ap, 'admin-report-cards-print-all-1280');\n      await ap.emulateMedia({ media: 'print' });\n      const breaksPrint = await ap.getByRole('article').evaluateAll((els) => els.map((e) => getComputedStyle(e).breakAfter + '/' + getComputedStyle(e).breakBefore));\n      const pdf = await ap.pdf({ format: 'A4', preferCSSPageSize: true });\n      fs.writeFileSync(`${SHOTS}/print-all.pdf`, pdf);\n      const pages = (pdf.toString('latin1').match(/\\/Type\\s*\\/Page[^s]/g) || []).length;\n      await ap.emulateMedia({ media: 'screen' });\n      return { rows, notifications: notes.length, printAllUrl: new URL(ap.url()).pathname + new URL(ap.url()).search, articles, breaks, breaksPrint, pdfPages: pages };\n    });\n\n    // ---------- STUDENT (375) ----------\n    const sp = R._s.page;\n    await check('student-grades-page', async () => {\n      const r = await go(sp, '/grades', 'UIV Maths');\n      const cards = await sp.locator('[data-testid^=\"grades-course-\"]').allInnerTexts();\n      const chips = await sp.locator('[data-testid^=\"grades-course-\"] .MuiChip-root[aria-label^=\"Term grade\"]').evaluateAll((els) => els.map((e) => ({ label: e.getAttribute('aria-label'), cls: [...e.classList].filter((c) => /color/i.test(c)).join(' ') })));\n      await shot(sp, 'student-grades-375');\n      await sp.getByTestId(`grades-course-${TAG}`).getByRole('button').first().click();\n      await sp.waitForTimeout(800);\n      const detail = await sp.getByTestId(`grades-course-${TAG}`).innerText();\n      await shot(sp, 'stud