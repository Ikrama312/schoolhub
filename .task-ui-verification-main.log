turn out;\n    });\n    await check('student-assignment-page-and-submit', async () => {\n      const r = await go(sp, `${C}/${f.a3}`, 'UIV Fractions worksheet');\n      const pre = await txt(sp);\n      const out = { ...r, hasInstructions: pre.includes('Show your working'), hasRubric: pre.includes('Accuracy'), dueChip: /Due in/.test(pre), answerField: await sp.getByLabel('Your answer').count(), fileInput: await sp.locator('input[type=file]').count(), hScroll: await sp.evaluate(() => document.documentElement.scrollWidth > window.innerWidth) };\n      await shot(sp, 'student-assignment-375');\n      await sp.getByLabel('Your answer').fill('1/2 + 1/4 = 3/4');\n      await sp.getByLabel('Attach files').setInputFiles({ name: 'working.png', mimeType: 'image/png', buffer: PNG });\n      await sp.getByText('working.png').first().waitFor({ timeout: 10_000 });\n      await sp.getByRole('button', { name: 'Submit', exact: true }).click();\n      const dlg = sp.getByRole('dialog'); await dlg.waitFor({ timeout: 5000 });\n      out.confirmDialog = (await dlg.innerText()).slice(0, 200);\n      await dlg.getByRole('button', { name: 'Submit' }).click();\n      await sp.getByText('Submitted — awaiting grading').first().waitFor({ timeout: 10_000 });\n      const post = await txt(sp);\n      out.receipt = (post.match(/Submitted [A-Z][a-z]{2} \\d{1,2} [A-Z][a-z]{2} \\d{4}, \\d{2}:\\d{2} \\(attempt \\d\\)/) || [null])[0];\n      out.awaiting = true; out.noScoreLeaked = !/\\/ 20/.test(post);\n      await shot(sp, 'student-submitted-375');\n      return out;\n    });\n    await check('student-assignments-page', async () => {\n      const r = await go(sp, '/assignments', 'Upcoming');\n      const tabs = await sp.getByRole('tab').allInnerTexts();\n      const out = { ...r, tabs };\n      for (const t of ['Upcoming', 'Past due', 'Submitted', 'Returned']) {\n        const tab = sp.getByRole('tab', { name: new RegExp('^' + t) });\n        if (await tab.count()) { await tab.click(); await sp.wait