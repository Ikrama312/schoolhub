{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgru9oMrJoWBkD4eQJ5fh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Y2JGyUCqwVxeiaGK1bmzU9","name":"Write","input":{"file_path":"/tmp/uiv-sh9/driver.cjs","content":"// SH-9 UI verification driver. Throwaway; lives outside the repo.\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/forge/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh9';\nconst PW = 'Uiv-Sh9!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst H = 3600_000, D = 24 * H;\n// 1x1 red PNG\nconst PNG = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg==', 'base64');\n\nasync function cleanup() {\n  const courses = await prisma.course.findMany({ where: { code: { startsWith: TAG } }, select: { id: true } });\n  const cids = courses.map((c) => c.id);\n  const rubricIds = (await prisma.assignment.findMany({ where: { courseId: { in: cids } }, select: { rubricId: true } })).map((a) => a.rubricId).filter(Boolean);\n  await prisma.course.deleteMany({ where: { id: { in: cids } } });\n  await prisma.rubric.deleteMany({ where: { id: { in: rubricIds } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.submission.deleteMany({ where: { OR: [{ studentId: { in: ids } }, { gradedById: { in: ids } }] } });\n  await prisma.fileObject.deleteMany({ where: { ownerId: { in: ids } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n}\n\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const admin = await mk('admin', 'Ada', 'Admin', 'ADMIN');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Blake', 'Late', 'STUDENT');\n  const s3 = await mk('s3', 'Morgan', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s3.id, relationship: 'MOTHER', isPrimary: true } });\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s1.id, relationship: 'MOTHER', isPrimary: false } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  const c2 = await prisma.course.create({ data: { name: 'UIV Science', code: TAG + '-b', academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id, notifiedAt: new Date() };\n  // a1: past due, late allowed, 10 %/day; s1 returned, s2 submitted 1 day late.\n  const a1 = await prisma.assignment.create({ data: { ...base, title: 'UIV Reading log', instructions: 'Read **chapter 3** and summarise.', submissionType: 'ONLINE_TEXT', maxPoints: '20', dueAt: new Date(now - 2 * D), allowLate: true, latePenaltyPercentPerDay: '10', maxLatePenaltyPercent: '50', status: 'PUBLISHED' } });\n  const a2 = await prisma.assignment.create({ data: { ...base, title: 'UIV Lab safety demo', submissionType: 'NO_SUBMISSION', maxPoints: '10', dueAt: new Date(now - D), status: 'PUBLISHED' } });\n  const rubric = await prisma.rubric.create({ data: { criteria: { create: [\n    { title: 'Accuracy', maxPoints: '10', order: 0, levels: [{ label: 'Excellent', points: 10 }, { label: 'Developing', points: 5 }] },\n    { title: 'Working', maxPoints: '10', order: 1, levels: [{ label: 'Excellent', points: 10 }, { label: 'Developing', points: 5 }] },\n  ] } } });\n  const a3 = await prisma.assignment.create({ data: { ...base, title: 'UIV Fractions worksheet', instructions: 'Show your working.', submissionType: 'TEXT_AND_FILE', maxPoints: '20', dueAt: new Date(now + 5 * H), status: 'PUBLISHED', rubricId: rubric.id } });\n  const a4 = await prisma.assignment.create({ data: { ...base, title: 'UIV Draft essay', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 7 * D), status: 'DRAFT', notifiedAt: null } });\n  const a5 = await prisma.assignment.create({ data: { ...base, title: 'UIV Scheduled quiz', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 9 * D), availableFrom: new Date(now + 5 * D), status: 'SCHEDULED', notifiedAt: null } });\n  await prisma.submission.create({ data: { assignmentId: a1.id, studentId: s1.id, status: 'RETURNED', text: 'My summary of chapter 3.', attemptNumber: 1, submittedAt: new Date(now - 3 * D), rawScore: '18', penaltyPercent: '0', finalScore: '18', feedback: 'Clear and concise.', gradedById: t.id, gradedAt: new Date(now - D), returnedAt: new Date(now - D) } });\n  const sub2 = await prisma.submission.create({ data: { assignmentId: a1.id, studentId: s2.id, status: 'SUBMITTED', text: 'Late *summary*.', attemptNumber: 1, submittedAt: new Date(now - D), isLate: true, lateDays: 1 } });\n  Object.assign(R.fixtures, { t: t.id, admin: admin.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, c2: c2.id, a1: a1.id, a2: a2.id, a3: a3.id, a4: a4.id, a5: a5.id, sub2: sub2.id });\n  return R.fixtures;\n}\n\nlet browser;\nasync function ctxFor(who, width) {\n  const ctx = await browser.newContext({ baseURL: BASE, bypassCSP: true, viewport: { width, height: width < 600 ? 667 : 800 } });\n  const page = await ctx.newPage();\n  R.consoleErrors[who] ??= [];\n  page.on('console', (m) => { if (m.type() === 'error') R.consoleErrors[who].push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => R.consoleErrors[who].push('PAGEERROR ' + String(e).slice(0, 300)));\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  await page.request.post('/api/auth/callback/credentials', { form: { email: em(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get('/api/auth/session')).json();\n  if (s?.user?.email !== em(who)) throw new Error('sign-in failed for ' + who);\n  return { ctx, page };\n}\nconst txt = (page) => page.locator('main').first().innerText().catch(() => page.locator('body').innerText());\nasync function go(page, url, waitText) {\n  const res = await page.goto(url, { waitUntil: 'load', timeout: 60_000 });\n  if (waitText) await page.getByText(waitText).first().waitFor({ timeout: 20_000 });\n  await page.waitForTimeout(800);\n  return { status: res?.status(), finalUrl: new URL(page.url()).pathname };\n}\nasync function check(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 3).join(' | ') }; }\n  console.log(name, R.results[name].ok);\n}\nconst shot = (page, n) => page.screenshot({ path: `${SHOTS}/${n}.png`, fullPage: true });\n\n(async () => {\n  fs.rmSync(SHOTS, { recursive: true, force: true }); fs.mkdirSync(SHOTS, { recursive: true });\n  const f = await setup();\n  browser = await chromium.launch();\n  const C = `/courses/${f.c1}/assignments`;\n  try {\n    // ---------- TEACHER ----------\n    const T = await ctxFor('teacher', 1280); const tp = T.page;\n    await check('teacher-nav', async () => {\n      const r = await go(tp, '/dashboard');\n      return { ...r, navAssignments: await tp.getByRole('link', { name: 'Assignments', exact: true }).count() };\n    });\n    await check('teacher-course-assignments-table', async () => {\n      const r = await go(tp, C, 'UIV Reading log');\n      const headers = await tp.getByRole('columnheader').allInnerTexts();\n      const out = { ...r, courseTab: await tp.getByRole('tab', { name: /assignments/i }).count() + await tp.getByRole('link', { name: /^assignments$/i }).count(), headers, gradeButtons: await tp.getByRole('link', { name: 'Grade' }).count() + await tp.getByRole('button', { name: 'Grade' }).count(), text: (await txt(tp)).slice(0, 1200) };\n      await shot(tp, 'teacher-course-assignments-1280'); return out;\n    });\n    await check('teacher-new-form', async () => {\n      const r = await go(tp, C + '/new', 'Save draft');\n      const labels = {};\n      for (const l of ['Title', 'Instructions', 'Submission type', 'Due', 'Max points', 'Allow late submissions', 'Grade with a rubric', 'Available from (for Schedule)', 'Allow extra credit (raw score up to 120 %)'])\n        labels[l] = await tp.getByLabel(l, { exact: false }).count();\n      const due = await tp.getByLabel('Due', { exact: false }).first().inputValue().catch(() => null);\n      const buttons = {};\n      for (const b of ['Save draft', 'Publish', 'Schedule']) buttons[b] = await tp.getByRole('button', { name: b, exact: true }).count();\n      const out = { ...r, labels, defaultDue: due, buttons, attachInput: await tp.locator('input[type=file]').count() };\n      await shot(tp, 'teacher-assignment-new-1280'); return out;\n    });\n    await check('teacher-rubric-builder', async () => {\n      await tp.getByLabel('Max points').first().fill('20');\n      await tp.getByLabel('Grade with a rubric').check();\n      const add = tp.getByRole('button', { name: 'Add criterion' });\n      await add.waitFor({ timeout: 10_000 });\n      await add.click();\n      const n1 = await tp.getByLabel(/^Criterion \\d+ title/).count();\n      if (n1 === 1) await tp.getByLabel('Criterion 1 title').fill('Accuracy');\n      await tp.waitForTimeout(300);\n      const mismatch = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).allInnerTexts();\n      const publishDisabled = await tp.getByRole('button', { name: 'Publish', exact: true }).isDisabled();\n      await shot(tp, 'teacher-rubric-mismatch-1280');\n      if (await tp.getByLabel(/^Criterion \\d+ title/).count() < 2) await add.click();\n      await tp.getByLabel('Criterion 2 title').fill('Working');\n      await tp.waitForTimeout(300);\n      const mismatchAfter = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).count();\n      const moveBtns = await tp.getByRole('button', { name: /^Move criterion/ }).count();\n      const before = [await tp.getByLabel('Criterion 1 title').inputValue(), await tp.getByLabel('Criterion 2 title').inputValue()];\n      await tp.getByRole('button', { name: /^Move criterion 1/ }).filter({ hasText: '' }).last().click().catch(() => {});\n      const downBtn = tp.getByRole('button', { name: /Move criterion 1 down/ });\n      if (await downBtn.count()) await downBtn.click();\n      await tp.waitForTimeout(300);\n      const after = [await tp.getByLabel('Criterion 1 title').inputValue(), await tp.getByLabel('Criterion 2 title').inputValue()];\n      await shot(tp, 'teacher-rubric-builder-1280');\n      await tp.getByRole('button', { name: /^Remove criterion 2/ }).click();\n      const confirm = tp.getByRole('dialog').getByRole('button', { name: /remove/i });\n      if (await confirm.count()) await confirm.click();\n      await tp.waitForTimeout(300);\n      return { initialCriteria: n1, mismatchOneCriterion: mismatch, publishDisabledOnMismatch: publishDisabled, mismatchAfterTwoCriteria: mismatchAfter, moveButtons: moveBtns, orderBefore: before, orderAfterMove: after, criteriaAfterRemove: await tp.getByLabel(/^Criterion \\d+ title/).count() };\n    });\n    await check('teacher-edit-published-with-submissions', async () => {\n      const r = await go(tp, `${C}/${f.a1}/edit`, 'Duplicate to other courses');\n      const warnings = await tp.locator('.MuiAlert-standardWarning, .MuiAlert-colorWarning').allInnerTexts();\n      const out = { ...r, warnings, title: await tp.getByLabel('Title').inputValue() };\n      await shot(tp, 'teacher-assignment-edit-1280');\n      await tp.getByRole('button', { name: 'Duplicate to other courses' }).click();\n      const dlg = tp.getByRole('dialog');\n      await dlg.waitFor();\n      out.duplicateDialog = (await dlg.innerText()).slice(0, 400);\n      const combo = dlg.getByLabel('Courses');\n      if (await combo.count()) { await combo.click(); await tp.waitForTimeout(400); out.courseOptions = await tp.getByRole('option').allInnerTexts(); }\n      await shot(tp, 'teacher-duplicate-dialog-1280');\n      await tp.keyboard.press('Escape'); await tp.keyboard.press('Escape');\n      return out;\n    });\n    await check('teacher-grade-page', async () => {\n      const r = await go(tp, `${C}/${f.a1}/grade`, 'Shortcuts:');\n      const list = tp.getByRole('list', { name: /Students/ }).or(tp.getByLabel(/^Students/)).first();\n      const out = { ...r, rosterText: (await list.innerText().catch(() => '')).slice(0, 400), chips: await tp.locator('.MuiChip-label').allInnerTexts(), returnAll: await tp.getByRole('button', { name: /Return all graded/ }).allInnerTexts() };\n      await shot(tp, 'teacher-grade-1280'); return out;\n    });\n    await check('teacher-grade-late-student', async () => {\n      await tp.getByRole('button', { name: /Blake Late/ }).first().click();\n      await tp.waitForTimeout(800);\n      const main = await txt(tp);\n      const out = { lateChip: /1 day late/.test(main), submissionTextRendered: await tp.locator('em', { hasText: 'summary' }).count(), penalty: await tp.getByLabel('Late penalty %').inputValue().catch(() => null) };\n      await tp.getByLabel(/^Raw score/).first().fill('18');\n      await tp.waitForTimeout(300);\n      out.finalScore = await tp.getByLabel('Final score').inputValue().catch(() => null);\n      await shot(tp, 'teacher-grade-late-1280');\n      // FR-36: above-max is rejected in the UI\n      await tp.getByLabel(/^Raw score/).first().fill('25'); await tp.waitForTimeout(300);\n      out.aboveMaxText = /Above the maximum/.test(await txt(tp));\n      await tp.getByLabel(/^Raw score/).first().fill('18');\n      return out;\n    });\n    await check('teacher-grade-shortcuts', async () => {\n      const sel = async () => (await tp.locator('[aria-current=\"true\"], .Mui-selected').first().innerText().catch(() => '')).split('\\n')[0];\n      await tp.locator('main').first().click({ position: { x: 5, y: 5 } }).catch(() => {});\n      await tp.locator('body').focus();\n      const start = await sel();\n      await tp.keyboard.press('j'); await tp.waitForTimeout(500); const afterJ = await sel();\n      await tp.keyboard.press('k'); await tp.waitForTimeout(500); const afterK = await sel();\n      await tp.getByLabel('Feedback', { exact: true }).focus();\n      await tp.keyboard.type('j'); await tp.waitForTimeout(300); const whileTyping = await sel();\n      await tp.getByLabel('Feedback', { exact: true }).fill('');\n      return { start, afterJ, afterK, whileTypingInFeedback: whileTyping };\n    });\n    await check('teacher-save-and-return', async () => {\n      await tp.getByRole('button', { name: /Blake Late/ }).first().click(); await tp.waitForTimeout(500);\n      await tp.getByLabel(/^Raw score/).first().fill('18');\n      await tp.getByLabel('Feedback', { exact: true }).fill('Good, but late.');\n      await tp.getByRole('button', { name: 'Save & return' }).click();\n      await tp.getByText('Saved and returned').first().waitFor({ timeout: 10_000 });\n      const sub = await prisma.submission.findUnique({ where: { id: f.sub2 } });\n      await tp.waitForTimeout(500);\n      await shot(tp, 'teacher-grade-returned-1280');\n      return { toast: true, db: { status: sub.status, rawScore: String(sub.rawScore), penaltyPercent: String(sub.penaltyPercent), finalScore: String(sub.finalScore), returnedAt: !!sub.returnedAt } };\n    });\n    await check('teacher-offline-and-exempt', async () => {\n      await tp.getByRole('button', { name: /Morgan Missing/ }).first().click(); await tp.waitForTimeout(600);\n      const out = { gradeWithoutBtn: await tp.getByRole('button', { name: 'Grade without submission' }).count(), notSubmittedText: /Not submitted/.test(await txt(tp)) };\n      await shot(tp, 'teacher-grade-not-submitted-1280');\n      const ex = tp.getByLabel('Exempt').first();\n      out.exemptToggle = await ex.count();\n      if (out.exemptToggle) { await ex.check(); await tp.waitForTimeout(1200); out.exemptionRow = !!(await prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: f.a1, studentId: f.s3 } } })); await ex.uncheck(); await tp.waitForTimeout(1200); out.exemptionRemoved = !(await prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: f.a1, studentId: f.s3 } } })); }\n      return out;\n    });\n    await check('teacher-offline-grade-no-submission-type', async () => {\n      await go(tp, `/courses/${f.c1}/assignments/${f.a2}/grade`, 'Shortcuts:');\n      await tp.getByRole('button', { name: /Morgan Missing/ }).first().click(); await tp.waitForTimeout(600);\n      await tp.getByLabel(/^Raw score/).first().fill('8');\n      await tp.getByRole('button', { name: 'Grade without submission' }).click();\n      await tp.waitForTimeout(1500);\n      const sub = await prisma.submission.findUnique({ where: { assignmentId_studentId: { assignmentId: f.a2, studentId: f.s3 } } });\n      await shot(tp, 'teacher-grade-offline-1280');\n      return { text: (await txt(tp)).slice(0, 300), db: sub && { text: sub.text, rawScore: String(sub.rawScore), finalScore: String(sub.finalScore), status: sub.status } };\n    });\n    await T.ctx.close();\n\n    // ---------- STUDENT (s2 submits on a3 with an image) ----------\n    const S2 = await ctxFor('s2', 375); const sp = S2.page;\n    await check('student-nav', async () => { await go(sp, '/dashboard'); return { navAssignments: await sp.getByRole('link', { name: 'Assignments', exact: true }).count() + await sp.getByRole('button', { name: /menu|navigation/i }).count() * 0 }; });\n    await check('student-course-assignments', async () => {\n      const r = await go(sp, C, 'UIV Fractions worksheet');\n      const t = await txt(sp);\n      const out = { ...r, groups: ['Upcoming', 'Past due', 'Submitted', 'Returned'].filter((g) => t.includes(g)), hidesDraft: !t.includes('UIV Draft essay'), hidesScheduled: !t.includes('UIV Scheduled quiz'), text: t.slice(0, 800), hScroll: await sp.evaluate(() => document.documentElement.scrollWidth > window.innerWidth) };\n      await shot(sp, 'student-course-assignments-375'); return out;\n    });\n    await check('student-assignment-page-and-submit', async () => {\n      const r = await go(sp, `${C}/${f.a3}`, 'UIV Fractions worksheet');\n      const pre = await txt(sp);\n      const out = { ...r, hasInstructions: pre.includes('Show your working'), hasRubric: pre.includes('Accuracy'), dueChip: /Due in/.test(pre), answerField: await sp.getByLabel('Your answer').count(), fileInput: await sp.locator('input[type=file]').count(), hScroll: await sp.evaluate(() => document.documentElement.scrollWidth > window.innerWidth) };\n      await shot(sp, 'student-assignment-375');\n      await sp.getByLabel('Your answer').fill('1/2 + 1/4 = 3/4');\n      await sp.getByLabel('Attach files').setInputFiles({ name: 'working.png', mimeType: 'image/png', buffer: PNG });\n      await sp.getByText('working.png').first().waitFor({ timeout: 10_000 });\n      await sp.getByRole('button', { name: 'Submit', exact: true }).click();\n      const dlg = sp.getByRole('dialog'); await dlg.waitFor({ timeout: 5000 });\n      out.confirmDialog = (await dlg.innerText()).slice(0, 200);\n      await dlg.getByRole('button', { name: 'Submit' }).click();\n      await sp.getByText('Submitted — awaiting grading').first().waitFor({ timeout: 10_000 });\n      const post = await txt(sp);\n      out.receipt = (post.match(/Submitted [A-Z][a-z]{2} \\d{1,2} [A-Z][a-z]{2} \\d{4}, \\d{2}:\\d{2} \\(attempt \\d\\)/) || [null])[0];\n      out.awaiting = true; out.noScoreLeaked = !/\\/ 20/.test(post);\n      await shot(sp, 'student-submitted-375');\n      return out;\n    });\n    await check('student-assignments-page', async () => {\n      const r = await go(sp, '/assignments', 'Upcoming');\n      const tabs = await sp.getByRole('tab').allInnerTexts();\n      const out = { ...r, tabs };\n      for (const t of ['Upcoming', 'Past due', 'Submitted', 'Returned']) {\n        const tab = sp.getByRole('tab', { name: new RegExp('^' + t) });\n        if (await tab.count()) { await tab.click(); await sp.waitForTimeout(500); out['tab:' + t] = (await txt(sp)).slice(0, 500); await shot(sp, `student-assignments-${t.toLowerCase().replace(' ', '-')}-375`); }\n      }\n      return out;\n    });\n    await check('student-returned-view', async () => {\n      const r = await go(sp, `${C}/${f.a1}`, 'UIV Reading log');\n      const t = await txt(sp);\n      await shot(sp, 'student-returned-375');\n      return { ...r, text: t.slice(0, 900), hasFinal: /16(\\.20)?\\s*\\/\\s*20/.test(t), hasFeedback: t.includes('Good, but late.'), hasPenalty: /10\\s*%/.test(t) };\n    });\n    await check('student-no-submission-type', async () => {\n      const r = await go(sp, `${C}/${f.a2}`, 'UIV Lab safety demo');\n      return { ...r, answerField: await sp.getByLabel('Your answer').count(), fileInput: await sp.locator('input[type=file]').count(), submitBtn: await sp.getByRole('button', { name: 'Submit', exact: true }).count(), text: (await txt(sp)).slice(0, 400) };\n    });\n    await S2.ctx.close();\n\n    // ---------- TEACHER grades s2's image submission (inline preview + rubric) ----------\n    const T2 = await ctxFor('teacher', 1280); const tp2 = T2.page;\n    await check('teacher-rubric-grading-and-preview', async () => {\n      await go(tp2, `${C}/${f.a3}/grade`, 'Shortcuts:');\n      await tp2.getByRole('button', { name: /Blake Late/ }).first().click(); await tp2.waitForTimeout(1500);\n      const out = { imgPreview: await tp2.locator('main img').count(), iframe: await tp2.locator('main iframe').count(), toggles: await tp2.getByRole('button', { name: /Excellent · 10|Developing · 5/ }).count() };\n      out.imgLoaded = await tp2.locator('main img').first().evaluate((i) => i.complete && i.naturalWidth > 0).catch(() => false);\n      const ex = tp2.getByRole('button', { name: 'Excellent · 10' }); const dv = tp2.getByRole('button', { name: 'Developing · 5' });\n      await ex.first().click(); await dv.nth(1).click(); await tp2.waitForTimeout(300);\n      out.rawAuto = await tp2.getByLabel(/^Raw score/).first().inputValue().catch(() => null);\n      out.finalScore = await tp2.getByLabel('Final score').inputValue().catch(() => null);\n      await tp2.getByRole('button', { name: 'Save', exact: true }).click(); await tp2.waitForTimeout(1500);\n      const sub = await prisma.submission.findUnique({ where: { assignmentId_studentId: { assignmentId: f.a3, studentId: f.s2 } } });\n      out.db = { status: sub.status, rawScore: String(sub.rawScore), rubricScores: sub.rubricScores, returned: !!sub.returnedAt };\n      out.returnAllLabel = await tp2.getByRole('button', { name: /Return all graded/ }).allInnerTexts();\n      await shot(tp2, 'teacher-grade-rubric-preview-1280');\n      return out;\n    });\n    await check('teacher-to-grade-page', async () => {\n      // s1 submits nothing new; to-grade list should show nothing for a3 now (graded) → seed one ungraded via DB.\n      await prisma.submission.create({ data: { assignmentId: f.a3, studentId: f.s1, text: 'x', attemptNumber: 1, submittedAt: new Date() } });\n      const r = await go(tp2, '/assignments', 'To grade');\n      const t = await txt(tp2); await shot(tp2, 'teacher-to-grade-1280');\n      return { ...r, text: t.slice(0, 600), listsS1: t.includes('Alex Aardvark') || t.includes('UIV Fractions worksheet') };\n    });\n    await check('teacher-student-tab', async () => {\n      const r = await go(tp2, `/students/${f.s3}/assignments`);\n      const t = await txt(tp2); await shot(tp2, 'teacher-student-assignments-1280');\n      return { ...r, text: t.slice(0, 600) };\n    });\n    await T2.ctx.close();\n\n    // ---------- PARENT ----------\n    const P = await ctxFor('parent', 375); const pp = P.page;\n    await check('parent-assignments', async () => {\n      const r = await go(pp, '/assignments', 'Upcoming');\n      const out = { ...r, nav: await pp.getByRole('link', { name: 'Assignments', exact: true }).count(), childSelector: await pp.getByLabel('Child').count() };\n      for (const t of ['Past due', 'Returned']) { const tab = pp.getByRole('tab', { name: new RegExp('^' + t) }); if (await tab.count()) { await tab.click(); await pp.waitForTimeout(500); out['tab:' + t] = (await txt(pp)).slice(0, 400); } }\n      await shot(pp, 'parent-assignments-375');\n      const sel = pp.getByLabel('Child');\n      if (out.childSelector) { await sel.click(); await pp.waitForTimeout(300); out.childOptions = await pp.getByRole('option').allInnerTexts(); await pp.keyboard.press('Escape'); }\n      return out;\n    });\n    await check('parent-assignment-readonly', async () => {\n      const r = await go(pp, `${C}/${f.a1}?studentId=${f.s3}`, 'UIV Reading log');\n      return { ...r, submitBtn: await pp.getByRole('button', { name: 'Submit', exact: true }).count(), answerField: await pp.getByLabel('Your answer').count(), text: (await txt(pp)).slice(0, 400) };\n    });\n    await P.ctx.close();\n  } catch (e) { R.fatal = String(e); }\n  await browser.close();\n  await cleanup(); R.cleanedUp = true;\n  await prisma.$disconnect();\n  fs.writeFileSync(OUT + '/uiv-raw.json', JSON.stringify(R, null, 1));\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1622,"cache_read_input_tokens":54920,"cache_creation":{"ephemeral_5m_input_tokens":1622,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e5bdbc6d-8407-44d1-9b1e-f6d173da0eb5","uuid":"fda58304-922b-48e4-8d23-e6539624ec91","timestamp":"2026-11-09T06:44:19.279Z","request_id":"req_011Cgru9o4k199gPbftTV5cU","wire_tool_inputs":{"toolu_01Y2JGyUCqwVxeiaGK1bmzU9":{"file_path":"/tmp/uiv-sh9/driver.cjs","content":"// SH-9 UI verification driver. Throwaway; lives outside the repo.\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/forge/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh9';\nconst PW = 'Uiv-Sh9!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst H = 3600_000, D = 24 * H;\n// 1x1 red PNG\nconst PNG = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg==', 'base64');\n\nasync function cleanup() {\n  const courses = await prisma.course.findMany({ where: { code: { startsWith: TAG } }, select: { id: true } });\n  const cids = courses.map((c) => c.id);\n  const rubricIds = (await prisma.assignment.findMany({ where: { courseId: { in: cids } }, select: { rubricId: true } })).map((a) => a.rubricId).filter(Boolean);\n  await prisma.course.deleteMany({ where: { id: { in: cids } } });\n  await prisma.rubric.deleteMany({ where: { id: { in: rubricIds } } });\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.submission.deleteMany({ where: { OR: [{ studentId: { in: ids } }, { gradedById: { in: ids } }] } });\n  await prisma.fileObject.deleteMany({ where: { ownerId: { in: ids } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n}\n\nasync function setup() {\n  await cleanup();\n  const year = (await prisma.academicYear.findFirst({ where: { isCurrent: true } })) ?? (await prisma.academicYear.findFirstOrThrow());\n  const subject = await prisma.subject.findFirstOrThrow();\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } });\n  const t = await mk('teacher', 'Terry', 'Teach', 'TEACHER');\n  const admin = await mk('admin', 'Ada', 'Admin', 'ADMIN');\n  const s1 = await mk('s1', 'Alex', 'Aardvark', 'STUDENT');\n  const s2 = await mk('s2', 'Blake', 'Late', 'STUDENT');\n  const s3 = await mk('s3', 'Morgan', 'Missing', 'STUDENT');\n  const p = await mk('parent', 'Paula', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s3.id, relationship: 'MOTHER', isPrimary: true } });\n  await prisma.parentStudentLink.create({ data: { parentId: p.id, studentId: s1.id, relationship: 'MOTHER', isPrimary: false } });\n  const c1 = await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  const c2 = await prisma.course.create({ data: { name: 'UIV Science', code: TAG + '-b', academicYearId: year.id, subjectId: subject.id, teacherId: t.id } });\n  await prisma.enrollment.createMany({ data: [s1, s2, s3].map((s) => ({ courseId: c1.id, studentId: s.id })) });\n  const now = Date.now();\n  const base = { courseId: c1.id, createdById: t.id, notifiedAt: new Date() };\n  // a1: past due, late allowed, 10 %/day; s1 returned, s2 submitted 1 day late.\n  const a1 = await prisma.assignment.create({ data: { ...base, title: 'UIV Reading log', instructions: 'Read **chapter 3** and summarise.', submissionType: 'ONLINE_TEXT', maxPoints: '20', dueAt: new Date(now - 2 * D), allowLate: true, latePenaltyPercentPerDay: '10', maxLatePenaltyPercent: '50', status: 'PUBLISHED' } });\n  const a2 = await prisma.assignment.create({ data: { ...base, title: 'UIV Lab safety demo', submissionType: 'NO_SUBMISSION', maxPoints: '10', dueAt: new Date(now - D), status: 'PUBLISHED' } });\n  const rubric = await prisma.rubric.create({ data: { criteria: { create: [\n    { title: 'Accuracy', maxPoints: '10', order: 0, levels: [{ label: 'Excellent', points: 10 }, { label: 'Developing', points: 5 }] },\n    { title: 'Working', maxPoints: '10', order: 1, levels: [{ label: 'Excellent', points: 10 }, { label: 'Developing', points: 5 }] },\n  ] } } });\n  const a3 = await prisma.assignment.create({ data: { ...base, title: 'UIV Fractions worksheet', instructions: 'Show your working.', submissionType: 'TEXT_AND_FILE', maxPoints: '20', dueAt: new Date(now + 5 * H), status: 'PUBLISHED', rubricId: rubric.id } });\n  const a4 = await prisma.assignment.create({ data: { ...base, title: 'UIV Draft essay', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 7 * D), status: 'DRAFT', notifiedAt: null } });\n  const a5 = await prisma.assignment.create({ data: { ...base, title: 'UIV Scheduled quiz', submissionType: 'ONLINE_TEXT', maxPoints: '10', dueAt: new Date(now + 9 * D), availableFrom: new Date(now + 5 * D), status: 'SCHEDULED', notifiedAt: null } });\n  await prisma.submission.create({ data: { assignmentId: a1.id, studentId: s1.id, status: 'RETURNED', text: 'My summary of chapter 3.', attemptNumber: 1, submittedAt: new Date(now - 3 * D), rawScore: '18', penaltyPercent: '0', finalScore: '18', feedback: 'Clear and concise.', gradedById: t.id, gradedAt: new Date(now - D), returnedAt: new Date(now - D) } });\n  const sub2 = await prisma.submission.create({ data: { assignmentId: a1.id, studentId: s2.id, status: 'SUBMITTED', text: 'Late *summary*.', attemptNumber: 1, submittedAt: new Date(now - D), isLate: true, lateDays: 1 } });\n  Object.assign(R.fixtures, { t: t.id, admin: admin.id, s1: s1.id, s2: s2.id, s3: s3.id, p: p.id, c1: c1.id, c2: c2.id, a1: a1.id, a2: a2.id, a3: a3.id, a4: a4.id, a5: a5.id, sub2: sub2.id });\n  return R.fixtures;\n}\n\nlet browser;\nasync function ctxFor(who, width) {\n  const ctx = await browser.newContext({ baseURL: BASE, bypassCSP: true, viewport: { width, height: width < 600 ? 667 : 800 } });\n  const page = await ctx.newPage();\n  R.consoleErrors[who] ??= [];\n  page.on('console', (m) => { if (m.type() === 'error') R.consoleErrors[who].push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => R.consoleErrors[who].push('PAGEERROR ' + String(e).slice(0, 300)));\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  await page.request.post('/api/auth/callback/credentials', { form: { email: em(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get('/api/auth/session')).json();\n  if (s?.user?.email !== em(who)) throw new Error('sign-in failed for ' + who);\n  return { ctx, page };\n}\nconst txt = (page) => page.locator('main').first().innerText().catch(() => page.locator('body').innerText());\nasync function go(page, url, waitText) {\n  const res = await page.goto(url, { waitUntil: 'load', timeout: 60_000 });\n  if (waitText) await page.getByText(waitText).first().waitFor({ timeout: 20_000 });\n  await page.waitForTimeout(800);\n  return { status: res?.status(), finalUrl: new URL(page.url()).pathname };\n}\nasync function check(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 3).join(' | ') }; }\n  console.log(name, R.results[name].ok);\n}\nconst shot = (page, n) => page.screenshot({ path: `${SHOTS}/${n}.png`, fullPage: true });\n\n(async () => {\n  fs.rmSync(SHOTS, { recursive: true, force: true }); fs.mkdirSync(SHOTS, { recursive: true });\n  const f = await setup();\n  browser = await chromium.launch();\n  const C = `/courses/${f.c1}/assignments`;\n  try {\n    // ---------- TEACHER ----------\n    const T = await ctxFor('teacher', 1280); const tp = T.page;\n    await check('teacher-nav', async () => {\n      const r = await go(tp, '/dashboard');\n      return { ...r, navAssignments: await tp.getByRole('link', { name: 'Assignments', exact: true }).count() };\n    });\n    await check('teacher-course-assignments-table', async () => {\n      const r = await go(tp, C, 'UIV Reading log');\n      const headers = await tp.getByRole('columnheader').allInnerTexts();\n      const out = { ...r, courseTab: await tp.getByRole('tab', { name: /assignments/i }).count() + await tp.getByRole('link', { name: /^assignments$/i }).count(), headers, gradeButtons: await tp.getByRole('link', { name: 'Grade' }).count() + await tp.getByRole('button', { name: 'Grade' }).count(), text: (await txt(tp)).slice(0, 1200) };\n      await shot(tp, 'teacher-course-assignments-1280'); return out;\n    });\n    await check('teacher-new-form', async () => {\n      const r = await go(tp, C + '/new', 'Save draft');\n      const labels = {};\n      for (const l of ['Title', 'Instructions', 'Submission type', 'Due', 'Max points', 'Allow late submissions', 'Grade with a rubric', 'Available from (for Schedule)', 'Allow extra credit (raw score up to 120 %)'])\n        labels[l] = await tp.getByLabel(l, { exact: false }).count();\n      const due = await tp.getByLabel('Due', { exact: false }).first().inputValue().catch(() => null);\n      const buttons = {};\n      for (const b of ['Save draft', 'Publish', 'Schedule']) buttons[b] = await tp.getByRole('button', { name: b, exact: true }).count();\n      const out = { ...r, labels, defaultDue: due, buttons, attachInput: await tp.locator('input[type=file]').count() };\n      await shot(tp, 'teacher-assignment-new-1280'); return out;\n    });\n    await check('teacher-rubric-builder', async () => {\n      await tp.getByLabel('Max points').first().fill('20');\n      await tp.getByLabel('Grade with a rubric').check();\n      const add = tp.getByRole('button', { name: 'Add criterion' });\n      await add.waitFor({ timeout: 10_000 });\n      await add.click();\n      const n1 = await tp.getByLabel(/^Criterion \\d+ title/).count();\n      if (n1 === 1) await tp.getByLabel('Criterion 1 title').fill('Accuracy');\n      await tp.waitForTimeout(300);\n      const mismatch = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).allInnerTexts();\n      const publishDisabled = await tp.getByRole('button', { name: 'Publish', exact: true }).isDisabled();\n      await shot(tp, 'teacher-rubric-mismatch-1280');\n      if (await tp.getByLabel(/^Criterion \\d+ title/).count() < 2) await add.click();\n      await tp.getByLabel('Criterion 2 title').fill('Working');\n      await tp.waitForTimeout(300);\n      const mismatchAfter = await tp.getByRole('alert').filter({ hasText: 'Rubric totals' }).count();\n      const moveBtns = await tp.getByRole('button', { name: /^Move criterion/ }).count();\n      const before = [await tp.getByLabel('Criterion 1 title').inputValue(), await tp.getByLabel('Criterion 2 title').inputValue()];\n      await tp.getByRole('button', { name: /^Move criterion 1/ }).filter({ hasText: '' }).last().click().catch(() => {});\n      const downBtn = tp.getByRole('button', { name: /Move criterion 1 down/ });\n      if (await downBtn.count()) await downBtn.click();\n      await tp.waitForTimeout(300);\n      const after = [await tp.getByLabel('Criterion 1 title').inputValue(), await tp.getByLabel('Criterion 2 title').inputValue()];\n      await shot(tp, 'teacher-rubric-builder-1280');\n      await tp.getByRole('button', { name: /^Remove criterion 2/ }).click();\n      const confirm = tp.getByRole('dialog').getByRole('button', { name: /remove/i });\n      if (await confirm.count()) await confirm.click();\n      await tp.waitForTimeout(300);\n      return { initialCriteria: n1, mismatchOneCriterion: mismatch, publishDisabledOnMismatch: publishDisabled, mismatchAfterTwoCriteria: mismatchAfter, moveButtons: moveBtns, orderBefore: before, orderAfterMove: after, criteriaAfterRemove: await tp.getByLabel(/^Criterion \\d+ title/).count() };\n    });\n    await check('teacher-edit-published-with-submissions', async () => {\n      const r = await go(tp, `${C}/${f.a1}/edit`, 'Duplicate to other courses');\n      const warnings = await tp.locator('.MuiAlert-standardWarning, .MuiAlert-colorWarning').allInnerTexts();\n      const out = { ...r, warnings, title: await tp.getByLabel('Title').inputValue() };\n      await shot(tp, 'teacher-assignment-edit-1280');\n      await tp.getByRole('button', { name: 'Duplicate to other courses' }).click();\n      const dlg = tp.getByRole('dialog');\n      await dlg.waitFor();\n      out.duplicateDialog = (await dlg.innerText()).slice(0, 400);\n      const combo = dlg.getByLabel('Courses');\n      if (await combo.count()) { await combo.click(); await tp.waitForTimeout(400); out.courseOptions = await tp.getByRole('option').allInnerTexts(); }\n      await shot(tp, 'teacher-duplicate-dialog-1280');\n      await tp.keyboard.press('Escape'); await tp.keyboard.press('Escape');\n      return out;\n    });\n    await check('teacher-grade-page', async () => {\n      const r = await go(tp, `${C}/${f.a1}/grade`, 'Shortcuts:');\n      const list = tp.getByRole('list', { name: /Students/ }).or(tp.getByLabel(/^Students/)).first();\n      const out = { ...r, rosterText: (await list.innerText().catch(() => '')).slice(0, 400), chips: await tp.locator('.MuiChip-label').allInnerTexts(), returnAll: await tp.getByRole('button', { name: /Return all graded/ }).allInnerTexts() };\n      await shot(tp, 'teacher-grade-1280'); return out;\n    });\n    await check('teacher-grade-late-student', async () => {\n      await tp.getByRole('button', { name: /Blake Late/ }).first().click();\n      await tp.waitForTimeout(800);\n      const main = await txt(tp);\n      const out = { lateChip: /1 day late/.test(main), submissionTextRendered: await tp.locator('em', { hasText: 'summary' }).count(), penalty: await tp.getByLabel('Late penalty %').inputValue().catch(() => null) };\n      await tp.getByLabel(/^Raw score/).first().fill('18');\n      await tp.waitForTimeout(300);\n      out.finalScore = await tp.getByLabel('Final score').inputValue().catch(() => null);\n      await shot(tp, 'teacher-grade-late-1280');\n      // FR-36: above-max is rejected in the UI\n      await tp.getByLabel(/^Raw score/).first().fill('25'); await tp.waitForTimeout(300);\n      out.aboveMaxText = /Above the maximum/.test(await txt(tp));\n      await tp.getByLabel(/^Raw score/).first().fill('18');\n      return out;\n    });\n    await check('teacher-grade-shortcuts', async () => {\n      const sel = async () => (await tp.locator('[aria-current=\"true\"], .Mui-selected').first().innerText().catch(() => '')).split('\\n')[0];\n      await tp.locator('main').first().click({ position: { x: 5, y: 5 } }).catch(() => {});\n      await tp.locator('body').focus();\n      const start = await sel();\n      await tp.keyboard.press('j'); await tp.waitForTimeout(500); const afterJ = await sel();\n      await tp.keyboard.press('k'); await tp.waitForTimeout(500); const afterK = await sel();\n      await tp.getByLabel('Feedback', { exact: true }).focus();\n      await tp.keyboard.type('j'); await tp.waitForTimeout(300); const whileTyping = await sel();\n      await tp.getByLabel('Feedback', { exact: true }).fill('');\n      return { start, afterJ, afterK, whileTypingInFeedback: whileTyping };\n    });\n    await check('teacher-save-and-return', async () => {\n      await tp.getByRole('button', { name: /Blake Late/ }).first().click(); await tp.waitForTimeout(500);\n      await tp.getByLabel(/^Raw score/).first().fill('18');\n      await tp.getByLabel('Feedback', { exact: true }).fill('Good, but late.');\n      await tp.getByRole('button', { name: 'Save & return' }).click();\n      await tp.getByText('Saved and returned').first().waitFor({ timeout: 10_000 });\n      const sub = await prisma.submission.findUnique({ where: { id: f.sub2 } });\n      await tp.waitForTimeout(500);\n      await shot(tp, 'teacher-grade-returned-1280');\n      return { toast: true, db: { status: sub.status, rawScore: String(sub.rawScore), penaltyPercent: String(sub.penaltyPercent), finalScore: String(sub.finalScore), returnedAt: !!sub.returnedAt } };\n    });\n    await check('teacher-offline-and-exempt', async () => {\n      await tp.getByRole('button', { name: /Morgan Missing/ }).first().click(); await tp.waitForTimeout(600);\n      const out = { gradeWithoutBtn: await tp.getByRole('button', { name: 'Grade without submission' }).count(), notSubmittedText: /Not submitted/.test(await txt(tp)) };\n      await shot(tp, 'teacher-grade-not-submitted-1280');\n      const ex = tp.getByLabel('Exempt').first();\n      out.exemptToggle = await ex.count();\n      if (out.exemptToggle) { await ex.check(); await tp.waitForTimeout(1200); out.exemptionRow = !!(await prisma.gradeExemption.findUnique({ where: { assignmentId_studentId: { assignmentId: f.a1, studentId: f.s3 } } }))