{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgsY9Lc5nWuqgmwHZb3VR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GkXMEGHnyzAFXCN4LmsT9c","name":"Write","input":{"file_path":"/tmp/uiv-sh11/driver.cjs","content":"// SH-11 UI verification driver. Throwaway; lives outside the repo. Run with NODE_PATH=<repo>/node_modules, cwd = repo.\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst AxeBuilder = require('@axe-core/playwright').default;\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh11';\nconst PW = 'Uiv-Sh11!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst D = 86_400_000;\n\nasync function cleanup() {\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.reportCard.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.course.deleteMany({ where: { code: { startsWith: TAG } } });\n  await prisma.sectionMember.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.section.deleteMany({ where: { name: TAG } });\n  await prisma.term.deleteMany({ where: { name: `${TAG} term` } });\n  await prisma.gradingScale.deleteMany({ where: { name: { startsWith: TAG } } });\n  await prisma.notification.deleteMany({ where: { userId: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.parentStudentLink.deleteMany({ where: { parentId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n}\n\nasync function setupBase() {\n  await cleanup();\n  const year = await prisma.academicYear.findFirstOrThrow({ where: { isCurrent: true } });\n  const subject = await prisma.subject.findFirstOrThrow();\n  const gl = await prisma.gradeLevel.findFirstOrThrow({ where: { archivedAt: null } });\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } }).then((u) => u.id);\n  const f = R.fixtures;\n  f.year = year.id;\n  f.admin = await mk('admin', 'Ada', 'Office', 'ADMIN');\n  f.t = await mk('teacher', 'Hal', 'Homeroom', 'TEACHER');\n  f.s1 = await mk('s1', 'Sam', 'Aardvark', 'STUDENT');\n  f.s2 = await mk('s2', 'Zed', 'Zebra', 'STUDENT');\n  f.s3 = await mk('s3', 'Olly', 'Outsider', 'STUDENT');\n  f.p = await mk('parent', 'Pam', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.createMany({ data: [f.s1, f.s2].map((studentId, i) => ({ parentId: f.p, studentId, relationship: 'MOTHER', isPrimary: i === 0 })) });\n  f.section = (await prisma.section.create({ data: { name: TAG, academicYearId: year.id, gradeLevelId: gl.id, homeroomTeacherId: f.t } })).id;\n  await prisma.sectionMember.createMany({ data: [f.s1, f.s2].map((studentId) => ({ sectionId: f.section, studentId, academicYearId: year.id })) });\n  f.c1 = (await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: f.t, sectionId: f.section } })).id;\n  f.c2 = (await prisma.course.create({ data: { name: 'UIV English', code: `${TAG}-eng`, academicYearId: year.id, subjectId: subject.id, teacherId: f.t, sectionId: f.section } })).id;\n  await prisma.enrollment.createMany({ data: [f.c1, f.c2].flatMap((courseId) => [f.s1, f.s2].map((studentId) => ({ courseId, studentId }))) });\n  return f;\n}\n\nasync function setupGrades() {\n  const f = R.fixtures;\n  const today = new Date();\n  f.term = (await prisma.term.create({ data: { academicYearId: f.year, name: `${TAG} term`, startDate: new Date(today.getTime() - 60 * D), endDate: new Date(today.getTime() + 60 * D), order: 99 } })).id;\n  const hw = await prisma.gradeCategory.create({ data: { courseId: f.c1, name: 'Homework', weightPercent: '40', order: 0 } });\n  const ex = await prisma.gradeCategory.create({ data: { courseId: f.c1, name: 'Exams', weightPercent: '60', order: 1 } });\n  f.hwCat = hw.id;\n  const item = (courseId, title, categoryId, maxPoints, d, extra = {}) =>\n    prisma.gradeItem.create({ data: { courseId, termId: f.term, categoryId, title, maxPoints, dueAt: new Date(Date.now() - d * D), source: 'MANUAL', ...extra } }).then((i) => i.id);\n  f.hw1 = await item(f.c1, 'HW one', hw.id, '20', 3);\n  f.hw2 = await item(f.c1, 'HW two', hw.id, '10', 2);\n  f.exam = await item(f.c1, 'Exam', ex.id, '100', 1);\n  f.hidden = await item(f.c1, 'UIV Hidden check', ex.id, '100', 1, { isVisible: false });\n  await prisma.grade.create({ data: { gradeItemId: f.hidden, studentId: f.s1, score: '10', updatedById: f.t } });\n  // Synced assignment item: s2 returned late (8/10); s1 ungraded → ignored, so s1 stays at the FR-15 golden case.\n  const a = await prisma.assignment.create({ data: { courseId: f.c1, title: 'UIV Essay', submissionType: 'TEXT', maxPoints: '10', dueAt: new Date(Date.now() - 4 * D), status: 'PUBLISHED', categoryId: hw.id, createdById: f.t, allowLate: true } });\n  f.assignment = a.id;\n  await prisma.submission.create({ data: { assignmentId: a.id, studentId: f.s2, status: 'RETURNED', text: 'essay', attemptNumber: 1, submittedAt: new Date(Date.now() - 3 * D), isLate: true, lateDays: 1, rawScore: '8', finalScore: '8', returnedAt: new Date(Date.now() - 2 * D), gradedById: f.t } });\n  f.essay = (await prisma.gradeItem.create({ data: { courseId: f.c1, termId: f.term, categoryId: hw.id, title: 'UIV Essay', maxPoints: '10', dueAt: a.dueAt, source: 'ASSIGNMENT', sourceId: a.id } })).id;\n  await prisma.grade.create({ data: { gradeItemId: f.essay, studentId: f.s2, score: '8' } });\n  // English: no categories, 50/100 → red card for s1; s2 65/100 → amber.\n  f.engItem = await item(f.c2, 'Reading log', null, '100', 2);\n  await prisma.grade.create({ data: { gradeItemId: f.engItem, studentId: f.s1, score: '50', comment: 'Read more widely', updatedById: f.t } });\n  await prisma.grade.create({ data: { gradeItemId: f.engItem, studentId: f.s2, score: '65', updatedById: f.t } });\n}\n\nlet browser;\nasync function ctxFor(who, width) {\n  const ctx = await browser.newContext({ baseURL: BASE, bypassCSP: true, viewport: { width, height: width < 600 ? 667 : 800 }, acceptDownloads: true });\n  const page = await ctx.newPage();\n  R.consoleErrors[who] ??= [];\n  page.on('console', (m) => { if (m.type() === 'error') R.consoleErrors[who].push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => R.consoleErrors[who].push('PAGEERROR ' + String(e).slice(0, 300)));\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  await page.request.post('/api/auth/callback/credentials', { form: { email: em(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get('/api/auth/session')).json();\n  if (s?.user?.email !== em(who)) throw new Error('sign-in failed for ' + who);\n  return { ctx, page };\n}\nconst txt = async (page, n = 1500) => (await page.locator('main').first().innerText().catch(() => page.locator('body').innerText())).slice(0, n);\nasync function go(page, url, waitText) {\n  const res = await page.goto(url, { waitUntil: 'load', timeout: 60_000 });\n  if (waitText) await page.getByText(waitText).first().waitFor({ timeout: 20_000 });\n  await page.waitForTimeout(800);\n  return { status: res?.status(), finalUrl: new URL(page.url()).pathname };\n}\nasync function check(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 3).join(' | ') }; }\n  console.log(name, R.results[name].ok, R.results[name].error ?? '');\n}\nconst shot = (page, n) => page.screenshot({ path: `${SHOTS}/${n}.png`, fullPage: true, timeout: 60_000 }).catch(() => page.screenshot({ path: `${SHOTS}/${n}.png`, timeout: 60_000 }));\nconst overflowX = (page) => page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\nconst axe = async (page) => (await new AxeBuilder({ page }).include('main').analyze()).violations.map((v) => `${v.id} (${v.impact}) x${v.nodes.length}`);\nasync function hydrated(fn, timeout = 15_000) { const end = Date.now() + timeout; let e; while (Date.now() < end) { try { return await fn(); } catch (x) { e = x; await new Promise((r) => setTimeout(r, 500)); } } throw e; }\nconst cell = (page, s, i) => page.getByTestId(`cell-${s}-${i}`);\nconst putDone = (page, item, s) => page.waitForResponse((r) => r.url().includes(`/api/grade-items/${item}/grades/${s}`) && r.request().method() === 'PUT', { timeout: 15_000 });\n\n(async () => {\n  fs.rmSync(SHOTS, { recursive: true, force: true }); fs.mkdirSync(SHOTS, { recursive: true });\n  const f = await setupBase();\n  browser = await chromium.launch();\n  const GB = `/courses/${f.c1}/gradebook`;\n  try {\n    const T = await ctxFor('teacher', 1280); const tp = T.page;\n    const A = await ctxFor('admin', 1280); const ap = A.page;\n\n    // ---------- No terms yet (dev DB state) ----------\n    await check('teacher-gradebook-no-terms', async () => {\n      const r = await go(tp, GB);\n      await shot(tp, 'teacher-gradebook-no-terms-1280');\n      return { ...r, text: await txt(tp, 400) };\n    });\n    await setupGrades();\n\n    // ---------- TEACHER gradebook (1280) ----------\n    await check('teacher-gradebook-grid', async () => {\n      const r = await go(tp, GB);\n      await tp.getByRole('grid').waitFor();\n      const tabs = await tp.getByRole('tab').allInnerTexts();\n      const groupHeaders = await tp.locator('.MuiDataGrid-columnHeader--filledGroup, [role=\"columnheader\"][aria-colspan]').allInnerTexts();\n      const headers = (await tp.locator('[role=\"columnheader\"]').allInnerTexts()).map((s) => s.replace(/\\s+/g, ' ').trim());\n      const rowNames = await tp.locator('[data-field=\"name\"][role=\"gridcell\"]').allInnerTexts();\n      const essayS2 = cell(tp, f.s2, f.essay);\n      const lateIcon = await essayS2.locator('[aria-label=\"Late\"]').count();\n      const sourceIcons = { assignment: await tp.locator('[role=\"columnheader\"] [aria-label=\"Assignment\"]').count(), manual: await tp.locator('[role=\"columnheader\"] [aria-label=\"Manual item\"]').count(), hidden: await tp.locator('[role=\"columnheader\"] [aria-label=\"Hidden from students\"]').count() };\n      const cells = { s1hw1: await cell(tp, f.s1, f.hw1).innerText(), s1essay: await cell(tp, f.s1, f.essay).innerText(), s2essay: await essayS2.innerText(), s1hidden: await cell(tp, f.s1, f.hidden).innerText() };\n      const pinned = await tp.locator('.MuiDataGrid-pinnedColumns, [class*=\"pinned\"]').count();\n      await shot(tp, 'teacher-gradebook-initial-1280');\n      return { ...r, tabs, groupHeaders, headers, rowNames, cells, lateIcon, sourceIcons, pinnedEls: pinned, termS1: await tp.getByTestId(`term-${f.s1}`).innerText(), termS2: await tp.getByTestId(`term-${f.s2}`).innerText(), axe: await axe(tp) };\n    });\n\n    await check('teacher-gradebook-keyboard-edit', async () => {\n      await hydrated(async () => { await cell(tp, f.s1, f.hw1).click(); const focused = await tp.evaluate(() => document.activeElement?.getAttribute('role')); if (focused !== 'gridcell') throw new Error('not focused'); });\n      for (const [i, v] of [[f.hw1, '18'], [f.hw2, '9'], [f.exam, '70']]) {\n        await cell(tp, f.s1, i).click();\n        const d = putDone(tp, i, f.s1);\n        await tp.keyboard.type(v); await tp.keyboard.press('Enter');\n        await d; await tp.waitForTimeout(300);\n      }\n      const termS1 = await tp.getByTestId(`term-${f.s1}`).innerText();\n      const cats = await tp.locator(`[data-id=\"${f.s1}\"] [data-field^=\"cat:\"]`).allInnerTexts();\n      // E / M / Delete on s2\n      await cell(tp, f.s2, f.hw1).click(); let d = putDone(tp, f.hw1, f.s2); await tp.keyboard.press('e'); await d; await tp.waitForTimeout(300);\n      await cell(tp, f.s2, f.hw2).click(); d = putDone(tp, f.hw2, f.s2); await tp.keyboard.press('m'); await d; await tp.waitForTimeout(300);\n      const afterEM = { hw1: await cell(tp, f.s2, f.hw1).innerText(), hw2: await cell(tp, f.s2, f.hw2).innerText(), hw2Color: await cell(tp, f.s2, f.hw2).evaluate((e) => getComputedStyle(e).color) };\n      await shot(tp, 'teacher-gradebook-after-edits-1280');\n      d = putDone(tp, f.hw2, f.s2); await tp.keyboard.press('Delete'); await d; await tp.waitForTimeout(300);\n      const afterDel = await cell(tp, f.s2, f.hw2).innerText();\n      // Keyboard on a synced cell must not edit\n      await cell(tp, f.s2, f.essay).locator('xpath=..').focus().catch(() => {});\n      const db = await prisma.grade.findMany({ where: { gradeItem: { courseId: f.c1 } }, select: { studentId: true, gradeItemId: true, score: true, excused: true, missing: true } });\n      const audit = await prisma.auditLog.count({ where: { action: 'grade.update', actorId: f.t } });\n      return { termS1, catsS1: cats, afterEM, afterDel, termS2: await tp.getByTestId(`term-${f.s2}`).innerText(), dbS1Exam: db.find((g) => g.studentId === f.s1 && g.gradeItemId === f.exam)?.score?.toString(), dbS2Hw1: db.find((g) => g.studentId === f.s2 && g.gradeItemId === f.hw1), auditGradeUpdates: audit };\n    });\n\n    await check('teacher-gradebook-invalid-score', async () => {\n      await cell(tp, f.s2, f.hw2).click();\n      await tp.keyboard.type('25'); await tp.keyboard.press('Enter');\n      await tp.waitForTimeout(800);\n      const outline = await cell(tp, f.s2, f.hw2).evaluate((e) => getComputedStyle(e).outlineStyle);\n      const alert = await tp.getByRole('alert').allInnerTexts().catch(() => []);\n      await shot(tp, 'teacher-gradebook-invalid-1280');\n      const db = await prisma.grade.findUnique({ where: { gradeItemId_studentId: { gradeItemId: f.hw2, studentId: f.s2 } } }).catch(() => null);\n      return { cellText: await cell(tp, f.s2, f.hw2).innerText(), outline, alert, dbScore: db?.score?.toString() ?? null };\n    });\n\n    await check('teacher-gradebook-synced-readonly', async () => {\n      const r = await tp.request.put(`/api/grade-items/${f.essay}/grades/${f.s2}`, { data: { score: '10' } });\n      return { apiStatus: r.status(), body: (await r.text()).slice(0, 200) };\n    });\n\n    await check('teacher-gradebook-column-menu', async () => {\n      await go(tp, GB); await tp.getByRole('grid').waitFor();\n      const hdr = tp.locator(`[role=\"columnheader\"][data-field=\"${f.hw1}\"]`);\n      await hydrated(async () => { await hdr.hover(); await hdr.locator('button[aria-label*=\"enu\"]').click({ timeout: 2000 }); await tp.getByRole('menu').waitFor({ timeout: 2000 }); });\n      const menu = (await tp.getByRole('menu').innerText()).split('\\n');\n      await shot(tp, 'teacher-gradebook-column-menu-1280');\n      await tp.getByRole('menuitem', { name: /Item statistics/ }).click();\n      const dlg = tp.getByRole('dialog'); await dlg.waitFor();\n      const stats = await dlg.innerText();\n      await shot(tp, 'teacher-gradebook-item-stats-1280');\n      await dlg.getByRole('button', { name: 'Close' }).click();\n      // Exam (due yesterday): set ungraded to missing; Essay: hide/show\n      const exHdr = tp.locator(`[role=\"columnheader\"][data-field=\"${f.exam}\"]`);\n      await exHdr.hover(); await exHdr.locator('button[aria-label*=\"enu\"]').click();\n      const missingEnabled = !(await tp.getByRole('menuitem', { name: /Set ungraded to missing/ }).isDisabled());\n      await tp.getByRole('menuitem', { name: /Set ungraded to missing/ }).click();\n      await tp.waitForTimeout(1500);\n      const s2exam = await cell(tp, f.s2, f.exam).innerText();\n      return { menu, stats, missingEnabled, s2examAfterMarkMissing: s2exam, termS2: await tp.getByTestId(`term-${f.s2}`).innerText() };\n    });\n\n    await check('teacher-gradebook-hide-show', async () => {\n      const hdr = tp.locator(`[role=\"columnheader\"][data-field=\"${f.hw2}\"]`);\n      await hdr.hover(); await hdr.locator('button[aria-label*=\"enu\"]').click();\n      await tp.getByRole('menuitem', { name: /Hide from students/ }).click();\n      await tp.waitForTimeout(1500);\n      const hiddenIcon = await hdr.locator('[aria-label=\"Hidden from students\"]').count();\n      const db1 = (await prisma.gradeItem.findUnique({ where: { id: f.hw2 } })).isVisible;\n      await hdr.hover(); await hdr.locator('button[aria-label*=\"enu\"]').click();\n      await tp.getByRole('menuitem', { name: /Show to students/ }).click();\n      await tp.waitForTimeout(1500);\n      const db2 = (await prisma.gradeItem.findUnique({ where: { id: f.hw2 } })).isVisible;\n      return { hiddenIconAfterHide: hiddenIcon, dbAfterHide: db1, dbAfterShow: db2 };\n    });\n\n    await check('teacher-gradebook-add-manual-item', async () => {\n      await tp.getByRole('button', { name: 'Add manual item' }).click();\n      const dlg = tp.getByRole('dialog'); await dlg.waitFor();\n      const fields = await dlg.locator('label').allInnerTexts();\n      await dlg.getByRole('button', { name: /Add|Create|Save/ }).last().click();\n      await tp.waitForTimeout(500);\n      const emptyErrors = await dlg.locator('.Mui-error').count();\n      await shot(tp, 'teacher-gradebook-add-item-dialog-1280');\n      await dlg.getByLabel('Title').fill('UIV Oral presentation');\n      await dlg.getByLabel('Max points').fill('10');\n      await dlg.getByRole('button', { name: /Add|Create|Save/ }).last().click();\n      await tp.locator('[role=\"columnheader\"]', { hasText: 'UIV Oral presentation' }).waitFor({ timeout: 10_000 });\n      const db = await prisma.gradeItem.findFirst({ where: { courseId: f.c1, title: 'UIV Oral presentation' } });\n      return { fields, emptyErrors, created: !!db, source: db?.source, termOk: db?.termId === f.term };\n    });\n\n    await check('teacher-gradebook-term-override', async () => {\n      await tp.getByRole('button', { name: 'Override term grade for Aardvark, Sam' }).click();\n      const dlg = tp.getByRole('dialog'); await dlg.waitFor();\n      const fields = await dlg.locator('label').allInnerTexts();\n      await dlg.getByLabel('Letter').click(); await tp.getByRole('option', { name: 'B', exact: true }).click();\n      await dlg.getByLabel(/Teacher comment/).fill('Steady progress this term.');\n      await shot(tp, 'teacher-gradebook-override-dialog-1280');\n      await dlg.getByRole('button', { name: /Save/ }).click();\n      await dlg.waitFor({ state: 'detached', timeout: 10_000 });\n      const term = await tp.getByTestId(`term-${f.s1}`).innerText();\n      const db = await prisma.termGradeOverride.findFirst({ where: { courseId: f.c1, studentId: f.s1 } });\n      return { fields, termAfter: term, db: db && { percent: db.percent?.toString() ?? null, letter: db.letter, comment: db.teacherComment } };\n    });\n\n    await check('teacher-gradebook-csv', async () => {\n      const href = await tp.getByRole('link', { name: 'Export CSV' }).getAttribute('href');\n      const r = await tp.request.get(href);\n      return { href, status: r.status(), contentType: r.headers()['content-type'], disposition: r.headers()['content-disposition'], head: (await r.text()).split('\\n').slice(0, 4) };\n    });\n\n    await check('teacher-gradebook-synced-click', async () => {\n      await cell(tp, f.s2, f.essay).click();\n      await tp.waitForURL(/\\/assignments\\/.+\\/grade/, { timeout: 15_000 });\n      return { url: new URL(tp.url()).pathname + new URL(tp.url()).search };\n    });\n\n    await check('teacher-gradebook-narrow-375', async () => {\n      await tp.setViewportSize({ width: 375, height: 667 });\n      await go(tp, GB); await tp.getByRole('grid').waitFor();\n      const scroller = await tp.locator('.MuiDataGrid-virtualScroller').evaluate((e) => ({ sw: e.scrollWidth, cw: e.clientWidth }));\n      const pageOverflow = await overflowX(tp);\n      await shot(tp, 'teacher-gradebook-375');\n      await tp.setViewportSize({ width: 1280, height: 800 });\n      return { scroller, pageOverflow };\n    });\n\n    await check('teacher-gradebook-settings', async () => {\n      const r = await go(tp, `${GB}/settings`, 'Weights total');\n      const sum0 = await tp.getByText(/Weights total/).innerText();\n      const save = tp.getByRole('button', { name: /^Save/ });\n      const saveEnabled0 = await save.isEnabled();\n      const scale = await tp.getByLabel('Scale').innerText().catch(() => null);\n      await shot(tp, 'teacher-gradebook-settings-1280');\n      await hydrated(async () => { await tp.getByLabel('Weight %').first().fill('30'); if (!(await tp.getByText(/Weights total 90/).count())) throw new Error('no live sum'); });\n      const sum1 = await tp.getByText(/Weights total/).innerText();\n      const saveEnabled1 = await save.isEnabled();\n      await shot(tp, 'teacher-gradebook-settings-invalid-1280');\n      const api = await tp.request.put(`/api/courses/${f.c1}/grade-categories`, { data: { categories: [{ name: 'Homework', weightPercent: '30', dropLowest: 0 }, { name: 'Exams', weightPercent: '60', dropLowest: 0 }] } });\n      await tp.getByLabel('Weight %').first().fill('40');\n      return { ...r, sum0, saveEnabled0, scale, sum1, saveEnabled1, apiStatusSum90: api.status(), axe: await axe(tp) };\n    });\n\n    await check('teacher-assignment-editor-category', async () => {\n      const r = await go(tp, `/courses/${f.c1}/assignments/${f.assignment}/edit`, 'Gradebook category');\n      const sel = tp.getByLabel('Gradebook category');\n      const value = await sel.innerText();\n      await sel.click(); const opts = await tp.getByRole('option').allInnerTexts(); await tp.keyboard.press('Escape');\n      await shot(tp, 'teacher-assignment-editor-category-1280');\n      return { ...r, value, opts };\n    });\n\n    await check('teacher-quiz-editor-category', async () => {\n      const q = await prisma.quiz.create({ data: { courseId: f.c1, createdById: f.t, title: 'UIV Quiz', availableFrom: new Date(Date.now() + D), availableUntil: new Date(Date.now() + 2 * D), status: 'DRAFT' } });\n      f.quiz = q.id;\n      const r = await go(tp, `/courses/${f.c1}/quizzes/${q.id}/edit`);\n      await hydrated(async () => { const tab = tp.getByRole('tab', { name: /Settings/ }); if (await tab.count()) await tab.click(); await tp.getByLabel(/category/i).first().waitFor({ timeout: 2000 }); });\n      const sel = tp.getByLabel(/category/i).first();\n      await sel.click(); const opts = await tp.getByRole('option').allInnerTexts(); await tp.keyboard.press('Escape');\n      await shot(tp, 'teacher-quiz-editor-category-1280');\n      return { ...r, label: await sel.getAttribute('aria-labelledby'), opts };\n    });\n\n    // ---------- ADMIN grading scales ----------\n    await check('admin-grading-scales', async () => {\n      const r = await go(ap, '/admin/grading-scales', 'Standard A–F');\n      const rows = await ap.locator('[role=\"row\"]').allInnerTexts();\n      const nav = await ap.locator('nav, .MuiDrawer-root').first().innerText();\n      await shot(ap, 'admin-grading-scales-1280');\n      await hydrated(async () => { await ap.getByRole('button', { name: 'Edit Standard A–F' }).click({ timeout: 2000 }); await ap.getByRole('dialog').waitFor({ timeout: 2000 }); });\n      const dlg = ap.getByRole('dialog');\n      const bandCount = await dlg.getByLabel('Letter').count();\n      await shot(ap, 'admin-grading-scale-edit-1280');\n      await dlg.getByRole('button', { name: 'Cancel' }).click();\n      return { ...r, rows: rows.slice(0, 4), navHasEntries: { scales: nav.includes('Grading scales'), reportCards: nav.includes('Report cards') }, bandCount, axe: await axe(ap) };\n    });\n\n    await check('admin-grading-scale-validation', async () => {\n      await ap.getByRole('button', { name: /New scale|New grading scale|Add scale|New/ }).first().click();\n      const dlg = ap.getByRole('dialog'); await dlg.waitFor();\n      await dlg.getByLabel('Name').fill(`${TAG} scale`);\n      const letters = dlg.getByLabel('Letter'); const mins = dlg.getByLabel('Min %');\n      const n0 = await letters.count();\n      while ((await letters.count()) < 2) await dlg.getByRole('button', { name: /Add band/ }).click();\n      await letters.nth(0).fill('P'); await mins.nth(0).fill('40');\n      await letters.nth(1).fill('P'); await mins.nth(1).fill('50');\n      await dlg.getByRole('button', { name: /Save/ }).click();\n      await ap.waitForTimeout(800);\n      const errors = await dlg.locator('.Mui-error, .MuiFormHelperText-root.Mui-error, [role=\"alert\"]').allInnerTexts();\n      await shot(ap, 'admin-grading-scale-invalid-1280');\n      await letters.nth(0).fill('Pass'); await mins.nth(0).fill('50');\n      await letters.nth(1).fill('Fail'); await mins.nth(1).fill('0');\n      await dlg.getByRole('button', { name: /Save/ }).click();\n      await dlg.waitFor({ state: 'detached', timeout: 10_000 });\n      const created = await prisma.gradingScale.findFirst({ where: { name: `${TAG} scale` } });\n      await ap.getByRole('button', { name: `Delete ${TAG} scale` }).click();\n      await ap.getByRole('dialog').getByRole('button', { name: /Delete/ }).click();\n      await ap.waitForTimeout(1000);\n      const defaultDeleteDisabled = await ap.getByRole('button', { name: 'Delete Standard A–F' }).isDisabled();\n      return { initialBands: n0, errors: errors.filter(Boolean), created: !!created, bands: created?.bands, deleted: !(await prisma.gradingScale.findFirst({ where: { name: `${TAG} scale` } })), defaultDeleteDisabled };\n    });\n\n    // ---------- ADMIN report cards ----------\n    const pickSection = async () => hydrated(async () => { await ap.getByLabel('Section').click(); await ap.getByRole('option', { name: TAG }).click({ timeout: 2000 }); });\n    await check('admin-report-cards-roster', async () => {\n      const r = await go(ap, '/admin/report-cards');\n      await hydrated(async () => { await ap.getByLabel('Term').click(); await ap.getByRole('option', { name: new RegExp(TAG) }).click({ timeout: 2000 }); });\n      await pickSection();\n      await ap.getByRole('gridcell', { name: 'Aardvark, Sam' }).waitFor({ timeout: 10_000 });\n      const rows = await ap.locator('[role=\"row\"]').allInnerTexts();\n      await shot(ap, 'admin-report-cards-not-generated-1280');\n      return { ...r, rows, buttons: await ap.getByRole('button', { name: /Generate|Publish all|Print all/ }).allInnerTexts(), axe: await axe(ap) };\n    });\n\n    await check('student-blocked-before-publish', async () => {\n      // generate first\n      await ap.getByRole('button', { name: /Generate drafts/ }).click();\n      await ap.getByRole('dialog').getByRole('button', { name: 'Generate' }).click();\n      await ap.getByRole('gridcell', { name: 'Draft' }).first().waitFor({ timeout: 20_000 });\n      const rows = await ap.locator('[role=\"row\"]').allInnerTexts();\n      await shot(ap, 'admin-report-cards-drafts-1280');\n      const card = await prisma.reportCard.findFirstOrThrow({ where: { studentId: f.s1, termId: f.term } });\n      f.card1 = card.id;\n      f.card2 = (await prisma.reportCard.findFirstOrThrow({ where: { studentId: f.s2, termId: f.term } })).id;\n      return { rowsAfterGenerate: rows, snapshotKeys: Object.keys(card.snapshot ?? {}), snapshot: JSON.stringify(card.snapshot).slice(0, 1500) };\n    });\n\n    // Teacher homeroom list + review (draft)\n    await check('teacher-report-cards-homeroom', async () => {\n      const r = await go(tp, `/report-cards?termId=${f.term}`);\n      const text = await txt(tp, 800);\n      const nav = await tp.locator('.MuiDrawer-root').first().innerText();\n      await shot(tp, 'teacher-report-cards-list-1280');\n      await go(tp, `/report-cards/${f.card1}`, 'Homeroom teacher');\n      const hr = tp.getByLabel('Homeroom teacher’s comment'); const pr = tp.getByLabel('Principal’s comment');\n      const state = { homeroomEnabled: await hr.isEnabled(), principalEnabled: await pr.isEnabled() };\n      await hydrated(async () => { await hr.fill('Sam has been a kind and focused member of the class.'); });\n      await tp.getByRole('button', { name: /Save/ }).click();\n      await tp.waitForTimeout(1500);\n      const db = await prisma.reportCard.findUnique({ where: { id: f.card1 } });\n      await shot(tp, 'teacher-report-card-review-1280');\n      return { ...r, listText: text, navReportCards: nav.includes('Report cards'), ...state, savedHomeroom: db.homeroomComment, publishButtons: await tp.getByRole('button', { name: /^Publish|Unpublish/ }).count() };\n    });\n\n    await check('student-draft-forbidden', async () => {\n      const S = await ctxFor('s1', 375); R._s = S;\n      const r = await go(S.page, `/report-cards/${f.card1}/print`);\n      const api = await S.page.request.get(`/api/report-cards/${f.card1}`);\n      const list = await go(S.page, `/students/${f.s1}/report-cards`);\n      return { printStatus: r.status, printUrl: r.finalUrl, text: (await txt(S.page, 300)), apiStatus: api.status(), listText: await txt(S.page, 400) };\n    });\n\n    await check('admin-report-card-review-publish', async () => {\n      await go(ap, `/report-cards/${f.card1}`, 'Principal');\n      const st = { homeroomEnabled: await ap.getByLabel('Homeroom teacher’s comment').isEnabled(), principalEnabled: await ap.getByLabel('Principal’s comment').isEnabled() };\n      await hydrated(async () => { await ap.getByLabel('Principal’s comment').fill('Well done, Sam.'); });\n      await ap.getByRole('button', { name: /Save/ }).click(); await ap.waitForTimeout(1200);\n      const preview = await ap.getByRole('article').first().innerText();\n      await shot(ap, 'admin-report-card-review-draft-1280');\n      await ap.getByRole('button', { name: /^Publish/ }).click();\n      await ap.getByRole('dialog').getByRole('button', { name: /Publish/ }).click();\n      await ap.getByRole('button', { name: /Unpublish/ }).waitFor({ timeout: 10_000 });\n      await ap.getByRole('button', { name: /Unpublish/ }).click();\n      const dlg = ap.getByRole('dialog'); await dlg.waitFor();\n      const confirmDisabledEmpty = await dlg.getByRole('button', { name: /Unpublish/ }).isDisabled();\n      await shot(ap, 'admin-report-card-unpublish-dialog-1280');\n      await dlg.getByLabel('Reason').fill('Correcting a typo');\n      await dlg.getByRole('button', { name: /Unpublish/ }).click();\n      await ap.getByRole('button', { name: /^Publish/ }).waitFor({ timeout: 10_000 });\n      const audit = await prisma.auditLog.findFirst({ where: { actorId: f.admin, action: { contains: 'unpublish' } } });\n      const db = await prisma.reportCard.findUnique({ where: { id: f.card1 } });\n      return { ...st, principalSaved: db.principalComment, previewHas: { comment: preview.includes('Steady progress'), letter: preview.includes('78.0'), homeroom: preview.includes('kind and focused') }, preview: preview.slice(0, 1200), confirmDisabledEmpty, statusAfterUnpublish: db.status, unpublishAudit: !!audit };\n    });\n\n    await check('admin-publish-all-and-print-all', async () => {\n      await go(ap, '/admin/report-cards');\n      await hydrated(async () => { await ap.getByLabel('Term').click(); await ap.getByRole('option', { name: new RegExp(TAG) }).click({ timeout: 2000 }); });\n      await pickSection();\n      await ap.getByRole('gridcell', { name: 'Aardvark, Sam' }).waitFor();\n      await ap.getByRole('button', { name: /Publish all/ }).click();\n      await ap.getByRole('dialog').getByRole('button', { name: 'Publish' }).click();\n      await ap.waitForTimeout(2000);\n      await ap.getByRole('gridcell', { name: 'Published' }).first().waitFor({ timeout: 15_000 });\n      const rows = await ap.locator('[role=\"row\"]').allInnerTexts();\n      await shot(ap, 'admin-report-cards-published-1280');\n      const notes = await prisma.notification.findMany({ where: { type: 'report_card.published', userId: { in: [f.s1, f.s2, f.p] } }, select: { userId: true } });\n      const printAll = ap.getByRole('link', { name: /Print all/ });\n      await printAll.click(); await ap.waitForURL(/report-cards\\/print/);\n      await ap.waitForTimeout(1000);\n      const articles = await ap.getByRole('article').count();\n      const breaks = await ap.getByRole('article').evaluateAll((els) => els.map((e) => getComputedStyle(e).breakAfter + '/' + getComputedStyle(e).pageBreakAfter));\n      await shot(ap, 'admin-report-cards-print-all-1280');\n      await ap.emulateMedia({ media: 'print' });\n      const breaksPrint = await ap.getByRole('article').evaluateAll((els) => els.map((e) => getComputedStyle(e).breakAfter + '/' + getComputedStyle(e).breakBefore));\n      const pdf = await ap.pdf({ format: 'A4', preferCSSPageSize: true });\n      fs.writeFileSync(`${SHOTS}/print-all.pdf`, pdf);\n      const pages = (pdf.toString('latin1').match(/\\/Type\\s*\\/Page[^s]/g) || []).length;\n      await ap.emulateMedia({ media: 'screen' });\n      return { rows, notifications: notes.length, printAllUrl: new URL(ap.url()).pathname + new URL(ap.url()).search, articles, breaks, breaksPrint, pdfPages: pages };\n    });\n\n    // ---------- STUDENT (375) ----------\n    const sp = R._s.page;\n    await check('student-grades-page', async () => {\n      const r = await go(sp, '/grades', 'UIV Maths');\n      const cards = await sp.locator('[data-testid^=\"grades-course-\"]').allInnerTexts();\n      const chips = await sp.locator('[data-testid^=\"grades-course-\"] .MuiChip-root[aria-label^=\"Term grade\"]').evaluateAll((els) => els.map((e) => ({ label: e.getAttribute('aria-label'), cls: [...e.classList].filter((c) => /color/i.test(c)).join(' ') })));\n      await shot(sp, 'student-grades-375');\n      await sp.getByTestId(`grades-course-${TAG}`).getByRole('button').first().click();\n      await sp.waitForTimeout(800);\n      const detail = await sp.getByTestId(`grades-course-${TAG}`).innerText();\n      await shot(sp, 'student-grades-expanded-375');\n      const api = await (await sp.request.get(`/api/students/${f.s1}/grades?termId=${f.term}`)).text();\n      const nav = await sp.locator('.MuiDrawer-root').first().innerText().catch(() => '');\n      return { ...r, cards, chips, detail, hiddenLeakUI: detail.includes('UIV Hidden'), hiddenLeakAPI: api.includes('UIV Hidden'), overflowX: await overflowX(sp), navHasGrades: nav.includes('Grades'), axe: await axe(sp) };\n    });\n    await check('student-course-grades-tab', async () => {\n      const r = await go(sp, `/courses/${f.c1}/grades`, 'UIV Maths');\n      const tabs = await sp.getByRole('tab').allInnerTexts();\n      await shot(sp, 'student-course-grades-375');\n      return { ...r, tabs, cards: await sp.locator('[data-testid^=\"grades-course-\"]').count(), text: await txt(sp, 600) };\n    });\n    await check('student-grades-tab-and-report-cards-tab', async () => {\n      const r1 = await go(sp, `/students/${f.s1}/grades`, 'UIV Maths');\n      await shot(sp, 'student-tab-grades-375');\n      const r2 = await go(sp, `/students/${f.s1}/report-cards`);\n      const text = await txt(sp, 500);\n      await shot(sp, 'student-tab-report-cards-375');\n      await sp.getByRole('link', { name: /Published/ }).first().click();\n      await sp.waitForURL(/\\/print$/);\n      await sp.getByRole('article').waitFor();\n      const doc = await sp.getByRole('article').innerText();\n      await shot(sp, 'student-report-card-print-375');\n      const api = await (await sp.request.get(`/api/report-cards/${f.card1}`)).status();\n      return { r1, r2, listText: text, printHas: { school: doc.includes('SchoolHub'), name: doc.includes('Sam Aardvark'), maths: doc.includes('UIV Maths'), english: doc.includes('UIV English'), legend: /A\\s*≥\\s*93/.test(doc), signature: /signature/i.test(doc), attendance: /attendance/i.test(doc) }, apiStatus: api, overflowX: await overflowX(sp) };\n    });\n\n    // ---------- PARENT (375) ----------\n    await check('parent-grades-and-report-card', async () => {\n      const P = await ctxFor('parent', 375); const pp = P.page;\n      const r = await go(pp, '/grades', 'UIV Maths');\n      const childSel = await pp.getByLabel('Child').count();\n      await shot(pp, 'parent-grades-375');\n      await hydrated(async () => { await pp.getByLabel('Child').click(); await pp.getByRole('option', { name: 'Zed Zebra' }).click({ timeout: 2000 }); });\n      await pp.waitForURL(/studentId=/);\n      await pp.getByText('UIV Maths').first().waitFor();\n      await pp.waitForTimeout(800);\n      const zedCards = await pp.locator('[data-testid^=\"grades-course-\"]').allInnerTexts();\n      await shot(pp, 'parent-grades-child2-375');\n      const nav = await pp.locator('.MuiDrawer-root').first().innerText().catch(() => '');\n      await go(pp, `/report-cards/${f.card1}/print`);\n      const art = pp.getByRole('article'); await art.waitFor();\n      await shot(pp, 'parent-report-card-print-375');\n      await pp.setViewportSize({ width: 1280, height: 900 });\n      await pp.waitForTimeout(500);\n      await shot(pp, 'parent-report-card-print-1280');\n      await pp.emulateMedia({ media: 'print' });\n      const hidden = { drawer: await pp.locator('.MuiDrawer-root').first().isHidden(), appbar: await pp.locator('.MuiAppBar-root').first().isHidden(), printBtn: await pp.getByRole('button', { name: 'Print / Save as PDF' }).isHidden(), docVisible: await art.isVisible() };\n      const pdf = await pp.pdf({ preferCSSPageSize: true });\n      fs.writeFileSync(`${SHOTS}/parent-report-card.pdf`, pdf);\n      const mediabox = (pdf.toString('latin1').match(/\\/MediaBox\\s*\\[[^\\]]+\\]/) || [])[0];\n      const pages = (pdf.toString('latin1').match(/\\/Type\\s*\\/Page[^s]/g) || []).length;\n      await pp.emulateMedia({ media: 'screen' });\n      return { ...r, childSel, zedCards, navHasGrades: nav.includes('Grades'), hiddenUnderPrint: hidden, pdfMediaBox: mediabox, pdfPages: pages };\n    });\n\n    // ---------- OUTSIDER student ----------\n    await check('outsider-student-forbidden', async () => {\n      const O = await ctxFor('s3', 375);\n      const r = await go(O.page, `/report-cards/${f.card1}/print`);\n      const api = await O.page.request.get(`/api/report-cards/${f.card1}`);\n      const grades = await O.page.request.get(`/api/students/${f.s1}/grades`);\n      const page2 = await go(O.page, `/students/${f.s1}/grades`);\n      await shot(O.page, 'outsider-report-card-375');\n      return { printStatus: r.status, printUrl: r.finalUrl, text: await txt(O.page, 200), apiStatus: api.status(), gradesApi: grades.status(), studentGradesPage: page2 };\n    });\n  } finally {\n    await browser.close();\n    if (!process.env.KEEP) { await cleanup(); R.cleanedUp = true; }\n    await prisma.$disconnect();\n    fs.writeFileSync(`${OUT}/uiv-raw.json`, JSON.stringify(R, null, 1));\n  }\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2345,"cache_read_input_tokens":92208,"cache_creation":{"ephemeral_5m_input_tokens":2345,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"95715b00-b89d-488d-810b-cf963fb0733f","uuid":"0ef8cfe6-191b-4f3c-863b-2f2b6686faf7","timestamp":"2026-11-09T14:50:04.123Z","request_id":"req_011CgsY9LF19eVYEvCKsz1GJ","wire_tool_inputs":{"toolu_01GkXMEGHnyzAFXCN4LmsT9c":{"file_path":"/tmp/uiv-sh11/driver.cjs","content":"// SH-11 UI verification driver. Throwaway; lives outside the repo. Run with NODE_PATH=<repo>/node_modules, cwd = repo.\nconst { chromium } = require('playwright');\nconst { PrismaClient } = require('@prisma/client');\nconst AxeBuilder = require('@axe-core/playwright').default;\nconst bcrypt = require('bcrypt');\nconst fs = require('fs');\n\nconst BASE = 'http://localhost:3300';\nconst OUT = '/Users/ikramaansari/Documents/React Projects/schoolhub/artifacts/ui-verification';\nconst SHOTS = OUT + '/screenshots';\nconst TAG = 'uiv-sh11';\nconst PW = 'Uiv-Sh11!2026-pass';\nconst em = (n) => `${TAG}-${n}@schoolhub.test`;\nconst prisma = new PrismaClient();\nconst R = { today: new Date().toISOString(), results: {}, consoleErrors: {}, fixtures: {} };\nconst D = 86_400_000;\n\nasync function cleanup() {\n  const ids = (await prisma.user.findMany({ where: { email: { startsWith: `${TAG}-` } }, select: { id: true } })).map((u) => u.id);\n  await prisma.reportCard.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.course.deleteMany({ where: { code: { startsWith: TAG } } });\n  await prisma.sectionMember.deleteMany({ where: { studentId: { in: ids } } });\n  await prisma.section.deleteMany({ where: { name: TAG } });\n  await prisma.term.deleteMany({ where: { name: `${TAG} term` } });\n  await prisma.gradingScale.deleteMany({ where: { name: { startsWith: TAG } } });\n  await prisma.notification.deleteMany({ where: { userId: { in: ids } } });\n  await prisma.emailOutbox.deleteMany({ where: { toEmail: { startsWith: `${TAG}-` } } });\n  await prisma.auditLog.deleteMany({ where: { actorId: { in: ids } } });\n  await prisma.parentStudentLink.deleteMany({ where: { parentId: { in: ids } } });\n  await prisma.user.deleteMany({ where: { id: { in: ids } } });\n}\n\nasync function setupBase() {\n  await cleanup();\n  const year = await prisma.academicYear.findFirstOrThrow({ where: { isCurrent: true } });\n  const subject = await prisma.subject.findFirstOrThrow();\n  const gl = await prisma.gradeLevel.findFirstOrThrow({ where: { archivedAt: null } });\n  const passwordHash = await bcrypt.hash(PW, 10);\n  const mk = (n, f, l, role) => prisma.user.create({ data: { email: em(n), firstName: f, lastName: l, role, status: 'ACTIVE', passwordHash } }).then((u) => u.id);\n  const f = R.fixtures;\n  f.year = year.id;\n  f.admin = await mk('admin', 'Ada', 'Office', 'ADMIN');\n  f.t = await mk('teacher', 'Hal', 'Homeroom', 'TEACHER');\n  f.s1 = await mk('s1', 'Sam', 'Aardvark', 'STUDENT');\n  f.s2 = await mk('s2', 'Zed', 'Zebra', 'STUDENT');\n  f.s3 = await mk('s3', 'Olly', 'Outsider', 'STUDENT');\n  f.p = await mk('parent', 'Pam', 'Parent', 'PARENT');\n  await prisma.parentStudentLink.createMany({ data: [f.s1, f.s2].map((studentId, i) => ({ parentId: f.p, studentId, relationship: 'MOTHER', isPrimary: i === 0 })) });\n  f.section = (await prisma.section.create({ data: { name: TAG, academicYearId: year.id, gradeLevelId: gl.id, homeroomTeacherId: f.t } })).id;\n  await prisma.sectionMember.createMany({ data: [f.s1, f.s2].map((studentId) => ({ sectionId: f.section, studentId, academicYearId: year.id })) });\n  f.c1 = (await prisma.course.create({ data: { name: 'UIV Maths', code: TAG, academicYearId: year.id, subjectId: subject.id, teacherId: f.t, sectionId: f.section } })).id;\n  f.c2 = (await prisma.course.create({ data: { name: 'UIV English', code: `${TAG}-eng`, academicYearId: year.id, subjectId: subject.id, teacherId: f.t, sectionId: f.section } })).id;\n  await prisma.enrollment.createMany({ data: [f.c1, f.c2].flatMap((courseId) => [f.s1, f.s2].map((studentId) => ({ courseId, studentId }))) });\n  return f;\n}\n\nasync function setupGrades() {\n  const f = R.fixtures;\n  const today = new Date();\n  f.term = (await prisma.term.create({ data: { academicYearId: f.year, name: `${TAG} term`, startDate: new Date(today.getTime() - 60 * D), endDate: new Date(today.getTime() + 60 * D), order: 99 } })).id;\n  const hw = await prisma.gradeCategory.create({ data: { courseId: f.c1, name: 'Homework', weightPercent: '40', order: 0 } });\n  const ex = await prisma.gradeCategory.create({ data: { courseId: f.c1, name: 'Exams', weightPercent: '60', order: 1 } });\n  f.hwCat = hw.id;\n  const item = (courseId, title, categoryId, maxPoints, d, extra = {}) =>\n    prisma.gradeItem.create({ data: { courseId, termId: f.term, categoryId, title, maxPoints, dueAt: new Date(Date.now() - d * D), source: 'MANUAL', ...extra } }).then((i) => i.id);\n  f.hw1 = await item(f.c1, 'HW one', hw.id, '20', 3);\n  f.hw2 = await item(f.c1, 'HW two', hw.id, '10', 2);\n  f.exam = await item(f.c1, 'Exam', ex.id, '100', 1);\n  f.hidden = await item(f.c1, 'UIV Hidden check', ex.id, '100', 1, { isVisible: false });\n  await prisma.grade.create({ data: { gradeItemId: f.hidden, studentId: f.s1, score: '10', updatedById: f.t } });\n  // Synced assignment item: s2 returned late (8/10); s1 ungraded → ignored, so s1 stays at the FR-15 golden case.\n  const a = await prisma.assignment.create({ data: { courseId: f.c1, title: 'UIV Essay', submissionType: 'TEXT', maxPoints: '10', dueAt: new Date(Date.now() - 4 * D), status: 'PUBLISHED', categoryId: hw.id, createdById: f.t, allowLate: true } });\n  f.assignment = a.id;\n  await prisma.submission.create({ data: { assignmentId: a.id, studentId: f.s2, status: 'RETURNED', text: 'essay', attemptNumber: 1, submittedAt: new Date(Date.now() - 3 * D), isLate: true, lateDays: 1, rawScore: '8', finalScore: '8', returnedAt: new Date(Date.now() - 2 * D), gradedById: f.t } });\n  f.essay = (await prisma.gradeItem.create({ data: { courseId: f.c1, termId: f.term, categoryId: hw.id, title: 'UIV Essay', maxPoints: '10', dueAt: a.dueAt, source: 'ASSIGNMENT', sourceId: a.id } })).id;\n  await prisma.grade.create({ data: { gradeItemId: f.essay, studentId: f.s2, score: '8' } });\n  // English: no categories, 50/100 → red card for s1; s2 65/100 → amber.\n  f.engItem = await item(f.c2, 'Reading log', null, '100', 2);\n  await prisma.grade.create({ data: { gradeItemId: f.engItem, studentId: f.s1, score: '50', comment: 'Read more widely', updatedById: f.t } });\n  await prisma.grade.create({ data: { gradeItemId: f.engItem, studentId: f.s2, score: '65', updatedById: f.t } });\n}\n\nlet browser;\nasync function ctxFor(who, width) {\n  const ctx = await browser.newContext({ baseURL: BASE, bypassCSP: true, viewport: { width, height: width < 600 ? 667 : 800 }, acceptDownloads: true });\n  const page = await ctx.newPage();\n  R.consoleErrors[who] ??= [];\n  page.on('console', (m) => { if (m.type() === 'error') R.consoleErrors[who].push(m.text().slice(0, 300)); });\n  page.on('pageerror', (e) => R.consoleErrors[who].push('PAGEERROR ' + String(e).slice(0, 300)));\n  const { csrfToken } = await (await page.request.get('/api/auth/csrf')).json();\n  await page.request.post('/api/auth/callback/credentials', { form: { email: em(who), password: PW, csrfToken, callbackUrl: '/dashboard' } });\n  const s = await (await page.request.get('/api/auth/session')).json();\n  if (s?.user?.email !== em(who)) throw new Error('sign-in failed for ' + who);\n  return { ctx, page };\n}\nconst txt = async (page, n = 1500) => (await page.locator('main').first().innerText().catch(() => page.locator('body').innerText())).slice(0, n);\nasync function go(page, url, waitText) {\n  const res = await page.goto(url, { waitUntil: 'load', timeout: 60_000 });\n  if (waitText) await page.getByText(waitText).first().waitFor({ timeout: 20_000 });\n  await page.waitForTimeout(800);\n  return { status: res?.status(), finalUrl: new URL(page.url()).pathname };\n}\nasync function check(name, fn) {\n  try { R.results[name] = { ok: true, ...(await fn()) }; }\n  catch (e) { R.results[name] = { ok: false, error: String(e).split('\\n').slice(0, 3).join(' | ') }; }\n  console.log(name, R.results[name].ok, R.results[name].error ?? '');\n}\nconst shot = (page, n) => page.screenshot({ path: `${SHOTS}/${n}.png`, fullPage: true, timeout: 60_000 }).catch(() => page.screenshot({ path: `${SHOTS}/${n}.png`, timeout: 60_000 }));\nconst overflowX = (page) => page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\nconst axe = async (page) => (await new AxeBuilder({ page }).include('main').analyze()).violations.map((v) => `${v.id} (${v.impact}) x${v.nodes.length}`);\nasync function hydrated(fn, timeout = 15_000) { const end = Date.now() + timeout; let e; while (Date.now() < end) { try { return await fn(); } catch (x) { e = x; await new Promise((r) => setTimeout(r, 500)); } } throw e; }\nconst cell = (page, s, i) => page.getByTestId(`cell-${s}-${i}`);\nconst putDone = (page, item, s) => page.waitForResponse((r) => r.url().includes(`/api/grade-items/${item}/grades/${s}`) && r.request().method() === 'PUT', { timeout: 15_000 });\n\n(async () => {\n  fs.rmSync(SHOTS, { recursive: true, force: true }); fs.mkdirSync(SHOTS, { recursive: true });\n  const f = await setupBase();\n  browser = await chromium.launch();\n  const GB = `/courses/${f.c1}/gradebook`;\n  try {\n    const T = await ctxFor('teacher', 1280); const tp = T.page;\n    const A = await ctxFor('admin', 1280); const ap = A.page;\n\n    // ---------- No terms yet (dev DB state) ----------\n    await check('teacher-gradebook-no-terms', async () => {\n      const r = await go(tp, GB);\n      await shot(tp, 'teacher-gradebook-no-terms-1280');\n      return { ...r, text: await txt(tp, 400) };\n    });\n    await setupGrades();\n\n    // ---------- TEACHER gradebook (1280) ----------\n    await check('teacher-gradebook-grid', async () => {\n      const r = await go(tp, GB);\n      await tp.getByRole('grid').waitFor();\n      const tabs = await tp.getByRole('tab').allInnerTexts();\n      const groupHeaders = await tp.locator('.MuiDataGrid-columnHeader--filledGroup, [role=\"columnheader\"][aria-colspan]').allInnerTexts();\n      const headers = (await tp.locator('[role=\"columnheader\"]').allInnerTexts()).map((s) => s.replace(/\\s+/g, ' ').trim());\n      const rowNames = await tp.locator('[data-field=\"name\"][role=\"gridcell\"]').allInnerTexts();\n      const essayS2 = cell(tp, f.s2, f.essay);\n      const lateIcon = await essayS2.locator('[aria-label=\"Late\"]').count();\n      const sourceIcons = { assignment: await tp.locator('[role=\"columnheader\"] [aria-label=\"Assignment\"]').count(), manual: await tp.locator('[role=\"columnheader\"] [aria-label=\"Manual item\"]').count(), hidden: await tp.locator('[role=\"columnheader\"] [aria-label=\"Hidden from students\"]').count() };\n      const cells = { s1hw1: await cell(tp, f.s1, f.hw1).innerText(), s1essay: await cell(tp, f.s1, f.essay).innerText(), s2essay: await essayS2.innerText(), s1hidden: await cell(tp, f.s1, f.hidden).innerText() };\n      const pinned = await tp.locator('.MuiDataGrid-pinnedColumns, [class*=\"pinned\"]').count();\n      await shot(tp, 'teacher-gradebook-initial-1280');\n      return { ...r, tabs, groupHeaders, headers, rowNames, cells, lateIcon, sourceIcons, pinnedEls: pinned, termS1: await tp.getByTestId(`term-${f.s1}`).innerText(), termS2: await tp.getByTestId(`term-${f.s2}`).innerText(), axe: await axe(tp) };\n    });\n\n    await check('teacher-gradebook-keyboard-edit', async () => {\n      await hydrated(async () => { await cell(tp, f.s1, f.hw1).click(); const focused = await tp.evaluate(() => document.activeElement?.getAttribute('role')); if (focused !== 'gridcell') throw new Error('not focused'); });\n      for (const [i, v] of [[f.hw1, '18'], [f.hw2, '9'], [f.exam, '70']]) {\n        await cell(tp, f.s1, i).click();\n        const d = putDone(tp, i, f.s1);\n        await tp.keyboard.type(v); await tp.keyboard.press('Enter');\n        await d; await tp.waitForTimeout(300);\n      }\n      const termS1 = await tp.getByTestId(`term-${f.s1}`).innerText();\n      const cats = await tp.locator(`[data-id=\"${f.s1}\"] [data-field^=\"cat:\"]`).allInnerTexts();\n      // E / M / Delete on s2\n      await cell(tp, f.s2, f.hw1).click(); let d = putDone(tp, f.hw1, f.s2); await tp.keyboard.press('e'); await d; await tp.waitForTimeout(300);\n      await cell(tp, f.s2, f.hw2).click(); d = putDone(tp, f.hw2, f.s2); await tp.keyboard.press('m'); await d; await tp.waitForTimeout(300);\n      const afterEM = { hw1: await cell(tp, f.s2, f.hw1).innerText(), hw2: await cell(tp, f.s2, f.hw2).innerText(), hw2Color: await cell(tp, f.s2, f.hw2).evaluate((e) => getComputedStyle(e).color) };\n      await shot(tp, 'teacher-gradebook-after-edits-1280');\n      d = putDone(tp, f.hw2, f.s2); await tp.keyboard.press('Delete'); await d; await tp.waitForTimeout(300);\n      const afterDel = await cell(tp, f.s2, f.hw2).innerText();\n      // Keyboard on a synced cell must not edit\n      await cell(tp, f.s2, f.essay).locator('xpath=..').focus().catch(() => {});\n      const db = await prisma.grade.findMany({ where: { gradeItem: { courseId: f.c1 } }, select: { studentId: true, gradeItemId: true, score: true, excused: true, missing: true } });\n      const audit = await prisma.auditLog.count({ where: { action: 'grade.update', actorId: f.t } });\n      return { termS1, catsS1: cats, afterEM, afterDel, termS2: await tp.getByTestId(`term-${f.s2}`).innerText(), dbS1Exam: db.find((g) => g.studentId === f.s1 && g.gradeItemId === f.exam)?.score?.toString(), dbS2Hw1: db.find((g) => g.studentId === f.s2 && g.gradeItemId === f.hw1), auditGradeUpdates: audit };\n    });\n\n    await check('teacher-gradebook-invalid-score', async () => {\n      await cell(tp, f.s2, f.hw2).click();\n      await tp.keyboard.type('25'); await tp.keyboard.press('Enter');\n      await tp.waitForTimeout(800);\n      const outline = await cell(tp, f.s2, f.hw2).evaluate((e) => getComputedStyle(e).outlineStyle);\n      const alert = await tp.getByRole('alert').allInnerTexts().catch(() => []);\n      await shot(tp, 'teacher-gradebook-invalid-1280');\n      const db = await prisma.grade.findUnique({ where: { gradeItemId_studentId: { gradeItemId: f.hw2, studentId: f.s2 } } }).catch(() => null);\n      return { cellText: await cell(tp, f.s2, f.hw2).innerText(), outline, alert, dbScore: db?.score?.toString() ?? null };\n    });\n\n    await check('teacher-gradebook-synced-readonly', async () => {\n      const r = await tp.request.put(`/api/grade-items/${f.essay}/grades/${f.s2}`, { data: { score: '10' } });\n      return { apiStatus: r.status(), body: (await r.text()).slice(0, 200) };\n    });\n\n    await check('teacher-gradebook-column-menu', async () => {\n      await go(tp, GB); await tp.getByRole('grid').waitFor();\n      const hdr = tp.locator(`[role=\"columnheader\"][data-field=\"${f.hw1}\"]`);\n      await hydrated(async () => { await hdr.hover(); await hdr.locator('button[aria-label*=\"enu\"]').click({ timeout: 2000 }); await tp.getByRole('menu').waitFor({ timeout: 2000 }); });\n      const menu = (await tp.getByRole('menu').innerText()).split('\\n');\n      await shot(tp, 'teacher-gradebook-column-menu-1280');\n      await tp.getByRole('menuitem', { name: /Item statistics/ }).click();\n      const dlg = tp.getByRole('dialog'); await dlg.waitFor();\n      const stats = await dlg.innerText();\n      await shot(tp, 'teacher-gradebook-item-stats-1280');\n      await dlg.getByRole('button', { name: 'Close' }).click();\n      // Exam (due yesterday): set ungraded to missing; Essay: hide/show\n      const exHdr = tp.locator(`[role=\"columnheader\"][data-field=\"${f.exam}\"]`);\n      await exHdr.hover(); await exHdr.locator('button[aria-label*=\"enu\"]').click();\n      const missingEnabled = !(await tp.getByRole('menuitem', { name: /Set ungraded to missing/ }).isDisabled());\n      await tp.getByRole('menuitem', { name: /Set ungraded to missing/ }).click();\n      await tp.waitForTimeout(1500);\n      const s2exam = await cell(tp, f.s2, f.exam).innerText();\n      return { menu, stats, missingEnabled, s2examAfterMarkMissing: s2exam, termS2: await tp.getByTestId(`term-${f.s2}`).innerText() };\n    });\n\n    await check('teacher-gradebook-hide-show', async () => {\n      const hdr = tp.locator(`[role=\"columnheader\"][data-field=\"${f.hw2}\"]`);\n      await hdr.hover(); await hdr.locator('button[aria-label*=\"enu\"]').click();\n      await tp.getByRole('menuitem', { name: /Hide from students/ }).click();\n      await tp.waitForTimeout(1500);\n      const hiddenIcon = await hdr.locator('[aria-label=\"Hidden from students\"]').count();\n      const db1 = (await prisma.gradeItem.findUnique({ where: { id: f.hw2 } })).isVisible;\n      await hdr.hover(); await hdr.locator('button[aria-label*=\"enu\"]').click();\n      await tp.getByRole('menuitem', { name: /Show to students/ }).click();\n      await tp.waitForTimeout(1500);\n      const db2 = (await prisma.gradeItem.findUnique({ where: { id: f.hw2 } })).isVisible;\n      return { hiddenIconAfterHide: hiddenIcon, dbAfterHide: db1, dbAfterShow: db2 };\n    });\n\n    await check('teacher-gradebook-add-manual-item', async () => {\n      await tp.getByRole('button', { name: 'Add manual item' }).click();\n      const dlg = tp.getByRole('dialog'); await dlg.waitFor();\n      const fields = await dlg.locator('label').allInnerTexts();\n      await dlg.getByRole('button', { name: /Add|Create|Save/ }).last().click();\n      await tp.waitForTimeout(500);\n      const emptyErrors = await dlg.locator('.Mui-error').count();\n      await shot(tp, 'teacher-gradebook-add-item-dialog-1280');\n      await dlg.getByLabel('Title').fill('UIV Oral presentation');\n      await dlg.getByLabel('Max points').fill('10');\n      await dlg.getByRole('button', { name: /Add|Create|Save/ }).last().click();\n      await tp.locator('[role=\"columnheader\"]', { hasText: 'UIV Oral presentation' }).waitFor({ timeout: 10_000 });\n      const db = await prisma.gradeItem.findFirst({ where: { courseId: f.c1, title: 'UIV Oral presentation' } });\n      return { fields, emptyErrors, created: !!db, source: db?.source, termOk: db?.termId === f.term };\n    });\n\n    await check('teacher-gradebook-term-override', async () => {\n      await tp.getByRole('button', { name: 'Override term grade for Aardvark, Sam' }).click();\n      const dlg = tp.getByRole('dialog'); await dlg.waitFor();\n      const fields = await dlg.locator('label').allInnerTexts();\n      await dlg.getByLabel('Letter').click(); await tp.getByRole('option', { name: 'B', exact: true }).click();\n      await dlg.getByLabel(/Teacher comment/).fill('Steady progress this term.');\n      await shot(tp, 'teacher-gradebook-override-dialog-1280');\n      await dlg.getByRole('button', { name: /Save/ }).click();\n      await dlg.waitFor({ state: 'detached', timeout: 10_000 });\n      const term = await tp.getByTestId(`term-${f.s1}`).innerText();\n      const db = await prisma.termGradeOverride.findFirst({ where: { courseId: f.c1, studentId: f.s1 } });\n      return { fields, termAfter: term, db: db && { percent: db.percent?.toString() ?? null, letter: db.letter, comment: db.teacherComment } };\n    });\n\n    await check('teacher-gradebook-csv', async () => {\n      const href = await tp.getByRole('link', { name: 'Export CSV' }).getAttribute('href');\n      const r = await tp.request.get(href);\n      return { href, status: r.status(), contentType: r.headers()['content-type'], disposition: r.headers()['content-disposition'], head: (await r.text()).split('\\n').slice(0, 4) };\n    });\n\n    await check('teacher-gradebook-synced-click', async () => {\n      await cell(tp, f.s2, f.essay).click();\n      await tp.waitForURL(/\\/assignments\\/.+\\/grade/, { timeout: 15_000 });\n      return { url: new URL(tp.url()).pathname + new URL(tp.url()).search };\n    });\n\n    await check('teacher-gradebook-narrow-375', async () => {\n      await tp.setViewportSize({ width: 375, height: 667 });\n      await go(tp, GB); await tp.getByRole('grid').waitFor();\n      const scroller = await tp.locator('.MuiDataGrid-virtualScroller').evaluate((e) => ({ sw: e.scrollWidth, cw: e.clientWidth }));\n      const pageOverflow = await overflowX(tp);\n      await shot(tp, 'teacher-gradebook-375');\n      await tp.setViewportSize({ width: 1280, height: 800 });\n      return { scroller, pageOverflow };\n    });\n\n    await check('teacher-gradebook-settings', async () => {\n      const r = await go(tp, `${GB}/settings`, 'Weights total');\n      const sum0 = await tp.getByText(/Weights total/).innerText();\n      const save = tp.getByRole('button', { name: /^Save/ });\n      const saveEnabled0 = await save.isEnabled();\n      const scale = await tp.getByLabel('Scale').innerText().catch(() => null);\n      await shot(tp, 'teacher-gradebook-settings-1280');\n      await hydrated(async () => { await tp.getByLabel('Weight %').first().fill('30'); if (!(await tp.getByText(/Weights total 90/).count())) throw new Error('no live sum'); });\n      const sum1 = await tp.getByText(/Weights total/).innerText();\n      const saveEnabled1 = await save.isEnabled();\n      await shot(tp, 'teacher-gradebook-settings-invalid-1280');\n      const api = await tp.request.put(`/api/courses/${f.c1}/grade-categories`, { data: { categories: [{ name: 'Homework', weightPercent: '30', dropLowest: 0 }, { name: 'Exams', weightPercent: '60', dropLowest: 0 }] } });\n      await tp.getByLabel('Weight %').first().fill('40');\n      return { ...r, sum0, saveEnabled0, scale, sum1, saveEnabled1, apiStatusSum90: api.status(), axe: await axe(tp) };\n    });\n\n    await check('teacher-assignment-editor-category', async () => {\n      const r = await go(tp, `/courses/${f.c1}/assignments/${f.assignment}/edit`, 'Gradebook category');\n      const sel = tp.getByLabel('Gradebook category');\n      const value = await sel.innerText();\n      await sel.click(); const opts = await tp.getByRole('option').allInnerTexts(); await tp.keyboard.press('Escape');\n      await shot(tp, 'teacher-assignment-editor-category-1280');\n      return { ...r, value, opts };\n    });\n\n    await check('teacher-quiz-editor-category', async () => {\n      const q = await prisma.quiz.create({ data: { courseId: f.c1, createdById: f.t, title: 'UIV Quiz', availableFrom: new Date(Date.now() + D), availableUntil: new Date(Date.now() + 2 * D), status: 'DRAFT' } });\n      f.quiz = q.id;\n      const r = await go(tp, `/courses/${f.c1}/quizzes/${q.id}/edit`);\n      await hydrated(async () => { const tab = tp.getByRole('tab', { name: /Settings/ }); if (await tab.count()) await tab.click(); await tp.getByLabel(/category/i).first().waitFor({ timeout: 2000 }); });\n      const sel = tp.getByLabel(/category/i).first();\n      await sel.click(); const opts = await tp.getByRole('option').allInnerTexts(); await tp.keyboard.press('Escape');\n      await shot(tp, 'teacher-quiz-editor-category-1280');\n      return { ...r, label: await sel.getAttribute('aria-labelledby'), opts };\n    });\n\n    // ---------- ADMIN grading scales ----------\n    await check('admin-grading-scales', async () => {\n      const r = await go(ap, '/admin/grading-scales', 'Standard A–F');\n      const rows = await ap.locator('[role=\"row\"]').allInnerTexts();\n      const nav = await ap.locator('nav, .MuiDrawer-root').first().innerText();\n      await shot(ap, 'admin-grading-scales-1280');\n      await hydrated(async () => { await ap.getByRole('button', { name: 'Edit Standard A–F' }).click({ timeout: 2000 }); await ap.getByRole('dialog').waitFor({ timeout: 2000 }); });\n      const dlg = ap.getByRole('dialog');\n      const bandCount = await dlg.getByLabel('Letter').count();\n      await shot(ap, 'admin-grading-scale-edit-1280');\n      await dlg.getByRole('button', { name: 'Cancel' }).click();\n      return { ...r, rows: rows.slice(0, 4), navHasEntries: { scales: nav.includes('Grading scales'), reportCards: nav.includes('Report cards') }, bandCount, axe: await axe(ap) };\n    });\n\n    await check('admin-grading-scale-validation', async () => {\n      await ap.getByRole('button', { name: /New scale|New grading scale|Add scale|New/ }).first().click();\n      const dlg = ap.getByRole('dialog'); await dlg.waitFor();\n      await dlg.getByLabel('Name').fill(`${TAG} scale`);\n      const letters = dlg.getByLabel('Letter'); const mins = dlg.getByLabel('Min %');\n      const n0 = await letters.count();\n      while ((await letters.count()) < 2) await dlg.getByRole('button', { name: /Add band/ }).click();\n      await letters.nth(0).fill('P'); await mins.nth(0).fill('40');\n      await letters.nth(1).fill('P'); await mins.nth(1).fill('50');\n      await dlg.getByRole('button', { name: /Save/ }).click();\n      await ap.waitForTimeout(800);\n      const errors = await dlg.locator('.Mui-error, .MuiFormHelperText-root.Mui-error, [role=\"alert\"]').allInnerTexts();\n      await shot(ap, 'admin-grading-scale-invalid-1280');\n      await letters.nth(0).fill('Pass'); await mins.nth(0).fill('50');\n      await letters.nth(1).fill('Fail'); await mins.nth(1).fill('0');\n      await dlg.getByRole('button', { name: /Save/ }).click();\n      await dlg.waitFor({ state: 'detached', timeout: 10_000 });\n      const created = await prisma.gradingScale.findFirst({ where: { name: `${TAG} scale` } });\n      await ap.getByRole('button', { name: `Delete ${TAG} scale` }).click();\n      await ap.getByRole('dialog').getByRole('button', { name: /Delete/ }).click();\n      await ap.waitForTimeout(1000);\n      const defaultDeleteDisabled = await ap.getByRole('button', { name: 'Delete Standard A–F' }).isDisabled();\n      return { initialBands: n0, errors: errors.filter(Boolean), created: !!created, bands: created?.bands, deleted: !(await prisma.gradingScale.findFirst({ where: { name: `${TAG} scale` } })), defaultDeleteDisabled };\n    });\n\n    // ---------- ADMIN report cards ----------\n    const pickSection = async () => hydrated(async () => { await ap.getByLabel('Section').click(); await ap.getByRole('option', { name: TAG }).click({ timeout: 2000 }); });\n    await check('admin-report-cards-roster', async () => {\n      const r = await go(ap, '/admin/report-cards');\n      await hydrated(async