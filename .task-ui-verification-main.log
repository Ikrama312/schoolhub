{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WxDV99RuWjw7pNmPmbMhjW","type":"tool_result","content":"import { notFound, redirect } from 'next/navigation';\nimport Alert from '@mui/material/Alert';\nimport { requirePageUser } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolTimezone } from '@/server/assignments/assignments-service';\nimport { getGradebook, type GradebookPayload } from '@/server/gradebook/gradebook-service';\nimport { GradebookGrid } from '@/components/gradebook/GradebookGrid';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course \"Gradebook\" tab — PRD-11 FR-18. getGradebook enforces manage access (NFR-6). */\nexport default async function GradebookPage({ params, searchParams }: { params: { courseId: string }; searchParams: { termId?: string } }) {\n  const user = await requirePageUser();\n  let data: GradebookPayload;\n  try {\n    data = await getGradebook(user, params.courseId, searchParams.termId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    if (error instanceof AppError && error.code === 'NOT_FOUND' && error.message.includes('no terms')) {\n      return <Alert severity=\"info\">{error.message} An administrator needs to add terms before grades can be recorded.</Alert>;\n    }\n    if (error instanceof AppError && (error.code === 'NOT_FOUND' || error.code === 'VALIDATION_ERROR')) notFound();\n    throw error;\n  }\n  return <GradebookGrid initial={JSON.parse(JSON.stringify(data))} timezone={await getSchoolTimezone()} />;\n}\nimport { notFound, redirect } from 'next/navigation';\nimport { prisma } from '@/server/db';\nimport { requirePageRole } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getAccessibleStudentIds } from '@/server/auth/student-access';\nimport { getStudentGrades, type StudentGrades } from '@/server/gradebook/student-grades-service';\nimport { PageHeader } from '@/components/PageHeader/PageHeader';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { GradesClient } from './GradesClient';\n\nexport const dynamic = 'force-dynamic';\n\n/** /grades — PRD-11 FR-27. STUDENT sees self; PARENT picks a linked child. */\nexport default async function GradesPage({ searchParams }: { searchParams: { studentId?: string } }) {\n  const user = await requirePageRole('STUDENT', 'PARENT');\n  const accessible = await getAccessibleStudentIds(user);\n  const ids = accessible === 'ALL' ? [] : accessible;\n  const children = await prisma.user.findMany({\n    where: { id: { in: ids }, role: 'STUDENT' },\n    select: { id: true, firstName: true, lastName: true },\n    orderBy: [{ firstName: 'asc' }, { lastName: 'asc' }],\n  });\n  if (!children.length) {\n    return (\n      <>\n        <PageHeader title=\"Grades\" />\n        <EmptyState title=\"No linked students\" description=\"Ask the school office to link your account to your child.\" />\n      </>\n    );\n  }\n  const studentId = searchParams.studentId && children.some((c) => c.id === searchParams.studentId) ? searchParams.studentId : children[0].id;\n  let data: StudentGrades;\n  try {\n    data = await getStudentGrades(user, studentId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'NOT_FOUND') notFound();\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    throw error;\n  }\n  return (\n    <>\n      <PageHeader title=\"Grades\" description={user.role === 'PARENT' ? undefined : 'Your current standing in each course.'} />\n      <GradesClient\n        key={studentId}\n        initial={JSON.parse(JSON.stringify(data))}\n        linkedChildren={user.role === 'PARENT' ? children.map((c) => ({ id: c.id, name: `${c.firstName} ${c.lastName}` })) : []}\n      />\n    </>\n  );\n}\n'use client';\n\nimport { usePathname, useRouter } from 'next/navigation';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport { StudentGradesView } from '@/components/gradebook/StudentGradesView';\nimport type { StudentGrades } from '@/server/gradebook/student-grades-service';\n\n/** FR-27: parent child selector (empty for students) above the shared grades view. */\nexport function GradesClient({ initial, linkedChildren: children, courseId }: { initial: StudentGrades; linkedChildren: { id: string; name: string }[]; courseId?: string }) {\n  const router = useRouter();\n  const pathname = usePathname();\n  return (\n    <Stack spacing={2}>\n      {children.length > 1 && (\n        <TextField select size=\"small\" label=\"Child\" value={initial.student.id} onChange={(e) => router.push(`${pathname}?studentId=${e.target.value}`)} sx={{ maxWidth: 280 }}>\n          {children.map((c) => (\n            <MenuItem key={c.id} value={c.id}>\n              {c.name}\n            </MenuItem>\n          ))}\n        </TextField>\n      )}\n      <StudentGradesView initial={initial} courseId={courseId} />\n    </Stack>\n  );\n}\n'use client';\n\nimport { useState } from 'react';\nimport Accordion from '@mui/material/Accordion';\nimport AccordionDetails from '@mui/material/AccordionDetails';\nimport AccordionSummary from '@mui/material/AccordionSummary';\nimport Card from '@mui/material/Card';\nimport CardContent from '@mui/material/CardContent';\nimport Chip from '@mui/material/Chip';\nimport MenuItem from '@mui/material/MenuItem';\nimport Stack from '@mui/material/Stack';\nimport Table from '@mui/material/Table';\nimport TableBody from '@mui/material/TableBody';\nimport TableCell from '@mui/material/TableCell';\nimport TableHead from '@mui/material/TableHead';\nimport TableRow from '@mui/material/TableRow';\nimport TextField from '@mui/material/TextField';\nimport Typography from '@mui/material/Typography';\nimport ExpandMoreIcon from '@mui/icons-material/ExpandMore';\nimport { EmptyState } from '@/components/EmptyState/EmptyState';\nimport { useToast } from '@/components/Toast/useToast';\nimport type { StudentGrades } from '@/server/gradebook/student-grades-service';\n\nconst pts = (v: string) => String(Number(v));\n\n/**\n * PRD-11 student/parent grade view (FR-26–FR-28). Renders only what GET /api/students/:id/grades\n * returns (visible items, released scores). One card per course; expand for items and subtotals.\n */\nexport function StudentGradesView({ initial, courseId }: { initial: StudentGrades; courseId?: string }) {\n  const { showToast } = useToast();\n  const [data, setData] = useState(initial);\n\n  const changeTerm = async (termId: string) => {\n    const q = new URLSearchParams({ termId, ...(courseId ? { courseId } : {}) });\n    const res = await fetch(`/api/students/${data.student.id}/grades?${q}`);\n    const json = await res.json().catch(() => ({}));\n    if (!res.ok) return showToast({ message: json?.error?.message ?? 'Could not load grades.', severity: 'error' });\n    setData(json.data);\n  };\n\n  if (!data.term) return <EmptyState title=\"No terms yet\" description=\"Grades appear once the school year has terms.\" />;\n\n  return (\n    <Stack spacing={2}>\n      {data.terms.length > 1 && (\n        <TextField select size=\"small\" label=\"Term\" value={data.term.id} onChange={(e) => void changeTerm(e.target.value)} sx={{ maxWidth: 240 }}>\n          {data.terms.map((t) => (\n            <MenuItem key={t.id} value={t.id}>\n              {t.name}\n              {t.isCurrent ? ' (current)' : ''}\n            </MenuItem>\n          ))}\n        </TextField>\n      )}\n      {data.courses.length === 0 && <EmptyState title=\"No courses\" description=\"There are no grades for this term.\" />}\n      {data.courses.map((c) => (\n        <Card key={c.course.id} variant=\"outlined\" data-testid={`grades-course-${c.course.code}`}>\n          <CardContent sx={{ pb: 1 }}>\n            <Stack direction=\"row\" spacing={2} sx={{ alignItems: 'center' }}>\n240:model Term {\n241-  id             String       @id @default(cuid())\n242-  academicYearId String\n243-  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)\n244-  name           String\n245-  startDate      DateTime     @db.Date\n246-  endDate        DateTime     @db.Date\n247-  order          Int\n248-  createdAt      DateTime     @default(now())\n249-  updatedAt      DateTime     @updatedAt\n250-  gradeItems     GradeItem[]\n251-\n252-  @@unique([academicYearId, name])\n253-  @@unique([academicYearId, order])\n254-}\n255-\n256-/// \"Grade 7\" etc. archivedAt is a soft-delete: later PRDs (enrollment)\n257-/// reference grade levels, so they're archived instead of deleted.\n258-model GradeLevel {\n259-  id              String           @id @default(cuid())\n260-  name            String           @unique\n261-  shortName       String           @unique\n262-  order           Int              @unique\n263-  archivedAt      DateTime?\n264-  createdAt       DateTime         @default(now())\n265-  updatedAt       DateTime         @updatedAt\n377:model Section {\n378-  id                 String              @id @default(cuid())\n379-  academicYearId     String\n380-  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n381-  gradeLevelId       String\n382-  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id])\n383-  name               String\n384-  homeroomTeacherId  String?\n385-  homeroomTeacher    User?               @relation(\"HomeroomTeacher\", fields: [homeroomTeacherId], references: [id])\n386-  roomId             String?\n387-  room               Room?               @relation(fields: [roomId], references: [id])\n388-  capacity           Int                 @default(30)\n389-  createdAt          DateTime            @default(now())\n390-  updatedAt          DateTime            @updatedAt\n391-  members            SectionMember[]\n392-  courses            Course[]\n393-  attendanceSessions AttendanceSession[]\n394-\n395-  @@unique([academicYearId, name])\n396-}\n397-\n398-/// academicYearId is denormalised so the DB enforces one section per\n399-/// student per year (NFR-2).\n400:model SectionMember {\n401-  id             String   @id @default(cuid())\n402-  sectionId      String\n403-  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n404-  studentId      String\n405-  student        User     @relation(fields: [studentId], references: [id])\n406-  joinedAt       DateTime @default(now())\n407-  academicYearId String\n408-\n409-  @@unique([studentId, academicYearId])\n410-}\n411-\n412-/// sectionId is null for cross-section electives. coTeacherIds is a plain\n413-/// String[] exactly per FR-1 (queried with `has`), max 3 enforced in zod.\n414-model Course {\n415-  id                 String              @id @default(cuid())\n416-  academicYearId     String\n417-  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])\n418-  subjectId          String\n419-  subject            Subject             @relation(fields: [subjectId], references: [id])\n420-  sectionId          String?\n421-  section            Section?            @relation(fields: [sectionId], references: [id])\n422-  teacherId          String\n423-  teacher            User                @relation(\"CourseTeacher\", fields: [teacherId], references: [id])\n424-  coTeacherIds       String[]            @default([])\n425-  name               String\n690:model Assignment {\n691-  id                       String                 @id @default(cuid())\n692-  courseId                 String\n693-  course                   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)\n694-  title                    String\n695-  instructions             String                 @default(\"\") @db.Text\n696-  submissionType           SubmissionType\n697-  maxPoints                Decimal                @db.Decimal(6, 2)\n698-  dueAt                    DateTime\n699-  availableFrom            DateTime?\n700-  allowLate                Boolean                @default(false)\n701-  lateCutoffAt             DateTime?\n702-  latePenaltyPercentPerDay Decimal                @default(0) @db.Decimal(5, 2)\n703-  maxLatePenaltyPercent    Decimal                @default(0) @db.Decimal(5, 2)\n704-  maxFileCount             Int                    @default(3)\n705-  allowExtraCredit         Boolean                @default(false)\n706-  status                   AssignmentStatus       @default(DRAFT)\n707-  rubricId                 String?                @unique\n708-  rubric                   Rubric?                @relation(fields: [rubricId], references: [id], onDelete: SetNull)\n709-  notifiedAt               DateTime?\n710-  archivedAt               DateTime?\n711-  /// PRD-11 FR-2\n712-  categoryId               String?\n713-  category                 GradeCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)\n714-  createdById              String\n715-  createdAt                DateTime               @default(now())\n757:model Submission {\n758-  id             String              @id @default(cuid())\n759-  assignmentId   String\n760-  assignment     Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n761-  studentId      String\n762-  student        User                @relation(\"SubmissionStudent\", fields: [studentId], references: [id])\n763-  status         SubmissionStatus    @default(SUBMITTED)\n764-  text           String?             @db.Text\n765-  attemptNumber  Int\n766-  submittedAt    DateTime\n767-  isLate         Boolean             @default(false)\n768-  lateDays       Int                 @default(0)\n769-  rawScore       Decimal?            @db.Decimal(6, 2)\n770-  penaltyPercent Decimal?            @db.Decimal(5, 2)\n771-  finalScore     Decimal?            @db.Decimal(6, 2)\n772-  /// [{criterionId, points, comment}]\n773-  rubricScores   Json?\n774-  feedback       String?             @db.Text\n775-  gradedById     String?","is_error":false}]},"parent_tool_use_id":null,"session_id":"95715b00-b89d-488d-810b-cf963fb0733f","uuid":"6e256dea-2161-40a4-8883-75b78fd2156a","timestamp":"2026-11-09T14:43:59.390Z","tool_use_result":{"stdout":"import { notFound, redirect } from 'next/navigation';\nimport Alert from '@mui/material/Alert';\nimport { requirePageUser } from '@/server/auth/requireRole';\nimport { AppError } from '@/server/http';\nimport { getSchoolTimezone } from '@/server/assignments/assignments-service';\nimport { getGradebook, type GradebookPayload } from '@/server/gradebook/gradebook-service';\nimport { GradebookGrid } from '@/components/gradebook/GradebookGrid';\n\nexport const dynamic = 'force-dynamic';\n\n/** Course \"Gradebook\" tab — PRD-11 FR-18. getGradebook enforces manage access (NFR-6). */\nexport default async function GradebookPage({ params, searchParams }: { params: { courseId: string }; searchParams: { termId?: string } }) {\n  const user = await requirePageUser();\n  let data: GradebookPayload;\n  try {\n    data = await getGradebook(user, params.courseId, searchParams.termId);\n  } catch (error) {\n    if (error instanceof AppError && error.code === 'FORBIDDEN') redirect('/forbidden');\n    if (error instanceof AppError && error.code === 'NOT_FOUND' && error.message.includes('no terms')) {\n      return <Alert severity=\"info\">{error.message} An administrator needs to add terms before grades can be recorded.</Alert>;\n    }\n    if (error instanceof AppError && (error.code === 'NOT_FOUND' || error.code === 'VALIDATION_ERROR')) notFound();\n    throw error;\n  }\n  return <GradebookGrid initial={JSON.parse(JSON.stringify(data))} timezone={await getSchoolTimezone()} />;\n}\nimport { notFound, redirect } from 'next/navigation';\nimport { prisma } from