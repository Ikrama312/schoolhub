{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014HrsHD73NgcDhMWCV1aoCh","type":"tool_result","content":"screenshots\nscreenshots-sh14\nui-verification-report.json\nui-verification-report.md\nuiv-raw-sh14.log\n{\n  \"ticketId\": \"SH-15\",\n  \"timestamp\": \"2026-11-10T12:00:00Z\",\n  \"phase\": \"intake\",\n  \"version\": \"1.0\",\n  \"prd\": \"PRD-15 Parent Portal — Child Switcher, Absence Notes & Conference Booking (SCH-015)\",\n  \"functionalRequirements\": [\n    {\n      \"id\": \"FR-1\",\n      \"description\": \"Add Prisma enums AbsenceNoteStatus, AbsenceReason, ConsentResponseValue and models AbsenceNote, ConferenceEvent, ConferenceSlot, ConsentForm, ConsentAudience, ConsentResponse exactly as specified, with a migration; reuse existing AudienceType enum (GRADE_LEVEL/SECTION/COURSE only for consent).\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-1 Data model\"\n    },\n    {\n      \"id\": \"FR-2\",\n      \"description\": \"AbsenceNote validation: toDate >= fromDate, span <= 30 days, details <= 1,000 chars, periodIds used only when partialDay; ConferenceEvent.slotMinutes 5–60; ConferenceSlot.parentNote <= 500 chars.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-1 Data model (field comments)\"\n    },\n    {\n      \"id\": \"FR-3\",\n      \"description\": \"PARENT users with 2+ linked children see a top-bar child switcher (avatar + first name dropdown); selection stored in cookie sh_child.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-2.1\"\n    },\n    {\n      \"id\": \"FR-4\",\n      \"description\": \"sh_child cookie is validated against ParentStudentLink on every request; an invalid/unlinked value falls back to the first child.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-2.1\"\n    },\n    {\n      \"id\": \"FR-5\",\n      \"description\": \"Parent-facing pages accepting studentId (timetable, assignments, grades, calendar filter) default to the selected child, replacing per-page child selectors; ?studentId= remains an override.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-2.2; AC-1\"\n    },\n    {\n      \"id\": \"FR-6\",\n      \"description\": \"Parents with exactly one child see that child's name in the top bar with no dropdown.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-2.3\"\n    },\n    {\n      \"id\": \"FR-7\",\n      \"description\": \"/my-children replaces the PRD-03 'My children' list: one-child parents redirect to /my-children/[studentId]; multi-child parents see cards with attendance rate this term, missing-assignment count and average grade linking to each overview.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-3.1; AC-8\"\n    },\n    {\n      \"id\": \"FR-8\",\n      \"description\": \"Child overview is the default landing page for parents after sign-in (within 2 clicks of sign-in).\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-3 heading; Goals 1; AC-8\"\n    },\n    {\n      \"id\": \"FR-9\",\n      \"description\": \"Overview 'Today' card shows the child's schedule for today or a holiday message (PRD-06/14 data).\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-3.2 Today\"\n    },\n    {\n      \"id\": \"FR-10\",\n      \"description\": \"Overview 'Attendance' card shows term rate, absences and lates this term, last 5 marks and a 'Report an absence' button.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-3.2 Attendance\"\n    },\n    {\n      \"id\": \"FR-11\",\n      \"description\": \"Overview 'Assignments' card shows missing assignments (red) and those due in the next 7 days.\",\n      \"confidence\": \"HIGH\",\n      \"source\": \"PRD-15 FR-3.2 Assignments\"\n    },\n    {\n      \"id\": \"FR-12\",\n      \"description\": \"Overview 'Recent grades' card shows last 5 returned/visible grades with course and score, plus current percent per course.\",\n      \