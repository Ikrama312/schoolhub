ait teacher.getByRole('menuitem', { name: 'Leave group' }).count();\n    await teacher.keyboard.press('Escape');\n    rec('FR-14 leave group', canLeave === 1 && stillListed === 0 && nf === 1,\n      `Leave group offered to student; after leaving, gone from list and thread shows \"Conversation not found\"; creator sees Leave=${creatorLeave}`);\n    R.fixtures.creatorLeaveCount = creatorLeave;\n  });\n  await step('FR-7 relationship ended', async () => {\n    const s2 = await login(browser, 's2', W);\n    await prisma.enrollment.updateMany({ where: { courseId: F.course, studentId: F.s2 }, data: { status: 'DROPPED' } });\n    await s2.goto(`/messages/${groupId}`);\n    await thread(s2, 'reminder about Friday').waitFor({ timeout: 10000 });\n    const msg = await s2.getByText('You can no longer send messages in this conversation.').count();\n    await shot(s2, 'student-relationship-ended-1280');\n    const api = await s2.request.post(`/api/conversations/${groupId}/messages`, { data: { body: 'still here?' } });\n    await teacher.goto(`/messages/${groupId}`);\n    await teacher.getByLabel('Message', { exact: true }).fill('Teacher can still post');\n    await teacher.keyboard.press('Enter');\n    const tOk = await thread(teacher, 'Teacher can still post').waitFor({ timeout: 8000 }).then(() => true).catch(() => false);\n    rec('FR-7 relationship ended', msg === 1 && api.status() === 403 && tOk,\n      `Dropped student sees \"You can no longer send messages in this conversation.\" (${msg === 1}); API send → ${api.status()}; teacher can still send=${tOk}`);\n    await s2.context().close();\n  });\n\n  // ---------- Quiet hours ----------\n  await step('FR-21 quiet hours', async () => {\n    await parent.goto('/account/notifications');\n    const sec = parent.getByRole('region', { name: 'Quiet hours' });\n    await sec.waitFor({ timeout: 10000 });\n    await sec.getByLabel('Start').fill('22:00');\n    await sec.getByLabel('End').fill('07:00');\n    await sec.getByRole('button