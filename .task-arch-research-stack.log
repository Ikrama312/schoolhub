items = navigationForRole(PLACEHOLDER_USER.role);\n162:            <UserAvatar userId={PLACEHOLDER_USER.id} name={PLACEHOLDER_USER.name} size={32} />\n166:              <Typography variant=\"subtitle2\">{PLACEHOLDER_USER.name}</Typography>\n167:              <Chip size=\"small\" label={PLACEHOLDER_USER.role} sx={{ mt: 0.5 }} />\n14:    \"test\": \"vitest run\",\n15:    \"test:e2e\": \"playwright test\",\n51:    \"@axe-core/playwright\": \"4.10.0\",\n70:    \"prisma\": \"5.20.0\",\nimport { formatInTimeZone } from 'date-fns-tz';\nimport { env } from '@/lib/env';\nimport { prisma } from '@/server/db';\nimport { INVITE_TTL } from '@/server/auth/tokens';\nimport { enqueueEmail } from '@/server/email/outbox';\nimport { getEmailSchool, renderEmail } from '@/server/email/render';\n\nexport type AuthEmailKind = 'invite' | 'password-reset';\n\nconst PATHS: Record<AuthEmailKind, string> = { invite: '/invite/', 'password-reset': '/reset-password/' };\nconst SUBJECTS: Record<AuthEmailKind, string> = {\n  invite: \"You're invited to SchoolHub\",\n  'password-reset': 'Reset your SchoolHub password',\n};\n\nexport function authLink(kind: AuthEmailKind, rawToken: string): string {\n  return new URL(PATHS[kind] + encodeURIComponent(rawToken), env.APP_URL).toString();\n}\n\n/**\n * PRD-04 FR-16: renders the invite/password-reset template and enqueues one\n * EmailOutbox row (no Notification row, no preference lookup). Unlike\n * notify(), this still throws: a silently lost invite/reset is worse than a\n * 500. The raw link is never logged.\n */\nexport async function sendAuthEmail(\n  user: { email: string; firstName?: string },\n  kind: AuthEmailKind,\n  link: string,\n): Promise<void> {\n  const school = await getEmailSchool();\n  const name = user.firstName ?? '';\n  let rendered: { html: string; text: string };\n  if (kind === 'invite') {\n    const settings = await prisma.schoolSettings.findUnique({ where: { id: 'singleton' }, select: { timezone: true } });\n    const expires = new Date(Date.now() + INVITE_TTL.days * 24 * 60 * 60_000);\n    const expiresAt = formatInTimeZone(expires, settings?.timezone ?? 'UTC', 'MMMM d, yyyy');\n    rendered = await renderEmail('invite', { name: name || 'there', link, expiresAt }, school);\n  } else {\n    rendered = await renderEmail('password-reset', { name: name || undefined, link }, school);\n86:  // PRD-04 FR-40: 3 system.test notifications (1 read, 2 unread) per demo user.\n87:  // Users are owned by another PRD's seed, so a missing one is skipped, never created.\n89:    const user = await prisma.user.findUnique({ where: { email }, select: { id: true } });\n90:    if (!user) {\n94:    const existing = await prisma.notification.count({ where: { userId: user.id, type: 'system.test' } });\n101:      ].map((n) => ({ ...n, userId: user.id, type: 'system.test', link: '/dashboard' })),\nimport type { NextAuthConfig } from 'next-auth';\nimport { safeCallbackUrl } from '@/lib/validators/auth';\n\n/**\n * Edge-safe Auth.js config (ADR-1): no Prisma, no bcrypt. src/middleware.ts\n * uses this alone; src/server/auth/auth.ts adds the Credentials provider\n * and the revocation-checking jwt callback on Node.\n * Cookies: Auth.js defaults (HttpOnly, SameSite=Lax, __Secure- in prod).\n */\nexport const authConfig = {\n  trustHost: true,\n  session: { strategy: 'jwt', maxAge: 8 * 60 * 60, updateAge: 15 * 60 },\n  pages: { signIn: '/login' },\n  providers: [],\n  callbacks: {\n    session({ session, token }) {\n      session.user.id = token.id;\n      session.user.role = token.role;\n      session.user.firstName = token.firstName;\n      session.user.lastName = token.lastName;\n      session.user.email = token.email ?? '';\n      return session;\n    },\n    redirect({ url, baseUrl }) {\n      // Auth.js hands us absolute URLs; reduce same-origin ones to a path, then sanitise.\n      const path = url.startsWith(baseUrl) ? url.slice(baseUrl.length) || '/' : url;\n      return baseUrl + safeCallbackUrl(path);\n    },\n