{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KjSSEg2MAK7fknw4LDHPSh","type":"tool_result","content":"44:enum EmailStatus {\n45-  PENDING\n46-  SENDING\n47-  SENT\n48-  FAILED\n49-}\n50-\n51-/// Every authenticated person. passwordHash is nullable because an INVITED\n52-/// user has no password until they accept their invite (TASK-8's\n53-/// acceptInvite step sets both passwordHash and status=ACTIVE together).\n54-/// phone and archivedAt are added here (PRD-03/TASK-1) because they are the\n55-/// only task in this PRD that owns schema.prisma: phone is FR-3's common\n56-/// field shared by every role, archivedAt backs FR-13's archive/restore\n57-/// (separate from status so a DISABLED-but-not-archived user stays distinct\n58-/// from an archived one).\n59-model User {\n60-  id                      String                   @id @default(cuid())\n61-  email                   String                   @unique\n62-  passwordHash            String?\n63-  firstName               String\n64-  lastName                String\n65-  phone                   String?\n66-  role                    Role\n67-  status                  UserStatus               @default(INVITED)\n68-  failedLoginCount        Int                      @default(0)\n69-  lockedUntil             DateTime?\n70-  lastLoginAt             DateTime?\n71-  passwordChangedAt       DateTime?\n72-  archivedAt              DateTime?\n73-  createdAt               DateTime                 @default(now())\n74-  updatedAt               DateTime                 @updatedAt\n--\n287:model Notification {\n288-  id        String    @id @default(cuid())\n289-  userId    String\n290-  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n291-  type      String\n292-  title     String\n293-  body      String?\n294-  link      String?\n295-  readAt    DateTime?\n296-  createdAt DateTime  @default(now())\n297-  updatedAt DateTime  @updatedAt\n298-\n299-  @@index([userId, readAt, createdAt])\n300-}\n301-\n302-/// Per-user, per-type override of the registry's defaultEmail/mandatoryInApp\n303-/// defaults (PRD-04 FR-3). Composite PK instead of a surrogate id/unique\n304-/// index -- there is exactly one row per (userId, type) by construction\n305-/// (notify.ts and the preferences PUT route both upsert on it).\n306:model NotificationPreference {\n307-  userId    String\n308-  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n309-  type      String\n310-  inApp     Boolean  @default(true)\n311-  email     Boolean  @default(true)\n312-  updatedAt DateTime @updatedAt\n313-\n314-  @@id([userId, type])\n315-}\n316-\n317-/// Durable outbox row the dispatcher claims and sends (PRD-04 FR-1/FR-5).\n318-/// No FK to User -- toEmail/toName are a point-in-time snapshot (matches\n319-/// the PRD's schema block exactly) so a later email change or user deletion\n320-/// never blocks a queued send. updatedAt doubles as the \"flipped to\n321-/// SENDING\" timestamp the >10-minute stuck-row recovery checks (NFR-4) --\n322-/// Prisma's @updatedAt already bumps it on that status-flip UPDATE, so no\n323-/// separate column is needed.\n324:model EmailOutbox {\n325-  id            String      @id @default(cuid())\n326-  toEmail       String\n327-  toName        String?\n328-  subject       String\n329-  html          String\n330-  text          String\n331-  status        EmailStatus @default(PENDING)\n332-  attempts      Int         @default(0)\n333-  lastError     String?\n334-  nextAttemptAt DateTime    @default(now())\n335-  sentAt        DateTime?\n336-  createdAt     DateTime    @default(now())\n337-  updatedAt     DateTime    @updatedAt\n338-\n339-  @@index([status, nextAttemptAt])\n340-}\n341-\n342-// ---------------------------------------------------------------------------\n343-// PRD-05 Classes & Enrollment (FR-1). Shapes match the PRD schema block\n344-// exactly; business rules (capacity, CORE auto-enroll, homeroom-once-per-year)\n20261019000000_init\n20261019151500_user_management_profiles\n20261027000000_classes_enrollment\n20261104000000_auth_reconcile\nmigration_lock.toml\nimport { z } from 'zod';\n\n/**\n * Fail-fast env validation. Runs once at module load (startup boundary) —\n * anything importing this module gets a readable error naming every\n * missing/invalid variable instead of an undefined-at-runtime surprise.\n */\nconst envSchema = z.object({\n  DATABASE_URL: z.string().min(1, 'DATABASE_URL is required'),\n  APP_URL: z.string().min(1, 'APP_URL is required'),\n  AUTH_SECRET: z.string().min(1, 'AUTH_SECRET is required'),\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n\n  // Email (PRD-04). EMAIL_TRANSPORT defaults to 'console' so dev/test never\n  // need real SMTP creds; the smtp branch (src/server/email/transport.ts)\n  // only reads SMTP_*/EMAIL_FROM when EMAIL_TRANSPORT='smtp'.\n  EMAIL_TRANSPORT: z.enum(['smtp', 'console']).default('console'),\n  SMTP_HOST: z.string().optional(),\n  SMTP_PORT: z.coerce.number().int().optional(),\n  SMTP_USER: z.string().optional(),\n  SMTP_PASS: z.string().optional(),\n  SMTP_SECURE: z.coerce.boolean().optional(),\n  EMAIL_FROM: z.string().optional(),\n  // Bearer token for POST /api/internal/email/dispatch (NFR-8). Optional so\n  // existing .env files don't break; left unset, the route rejects every\n  // request (fail-safe, not fail-open).\n  CRON_SECRET: z.string().optional(),\n});\n\nfunction loadEnv() {\n  const parsed = envSchema.safeParse(process.env);\n  if (!parsed.success) {\n    const issues = parsed.error.issues\n      .map((issue) => `  - ${issue.path.join('.')}: ${issue.message}`)\n      .join('\\n');\n    throw new Error(`Invalid environment variables:\\n${issues}`);\n  }\n  return parsed.data;\n}\n\nexport const env = loadEnv();\nexport type Env = z.infer<typeof envSchema>;\nimport { env } from '@/lib/env';\nimport { logger } from '@/lib/logger';\n\nexport type AuthEmailKind = 'invite' | 'password-reset';\n\nconst PATHS: Record<AuthEmailKind, string> = { invite: '/invite/', 'password-reset': '/reset-password/' };\nconst SUBJECTS: Record<AuthEmailKind, string> = {\n  invite: \"You're invited to SchoolHub\",\n  'password-reset': 'Reset your SchoolHub password',\n};\n\nexport function authLink(kind: AuthEmailKind, rawToken: string): string {\n  return new URL(PATHS[kind] + encodeURIComponent(rawToken), env.APP_URL).toString();\n}\n\n/**\n * FR-22 seam: logs the link instead of sending. PRD-04 replaces this body\n * with an EmailOutbox enqueue. The raw token appears only here, never in audit.\n */\nexport async function sendAuthEmail(\n  user: { email: string; firstName?: string },\n  kind: AuthEmailKind,\n  link: string,\n): Promise<void> {\n  logger.info('Auth email', { to: user.email, subject: SUBJECTS[kind], link });\n}\nsrc/lib:\ndates.ts\nenv.ts\nlogger.ts\nvalidators\n\nsrc/server:\naudit.ts\nauth\ncourses\ncsv.ts\ndb.ts\nenrollment\nhttp.ts\nrate-limit.ts\nsections\nservices\nsrc/lib/logger.ts:17:export const logger = {\nsrc/server/http.ts:12:export type ApiErrorCode =\nsrc/server/http.ts:34:export class AppError extends Error {\nsrc/server/http.ts:45:export function ok<T>(data: T, init?: ResponseInit) {\nsrc/server/http.ts:49:export function paginated<T>(\nsrc/server/http.ts:57:export function apiError(code: ApiErrorCode, message: string, details?: unknown) {\nsrc/server/http.ts:71:export function withHandler<Args extends unknown[]>(\nsrc/server/http.ts:104:export interface PaginationParams {\nsrc/server/http.ts:113:export function parsePagination(searchParams: URLSearchParams): PaginationParams {\nsrc/server/http.ts:125:export async function parseBody<S extends ZodTypeAny>(request: Request, schema: S): Promise<output<S>> {\nsrc/server/http.ts:131:export function getClientIp(request: Request): string | null {\nsrc/server/http.ts:135:export function parseQuery<S extends ZodTypeAny>(searchParams: URLSearchParams, schema: S)