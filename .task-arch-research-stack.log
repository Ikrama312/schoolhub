{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mp1GvtwbySzot9ooYW3Y59","type":"tool_result","content":"import { AppError } from '@/server/http';\nimport type { Role } from '@/config/navigation';\n\n/**\n * Single chokepoint for server-side role checks on write endpoints.\n *\n * PRD-01 (real auth/session) has not landed in this workspace yet, so\n * there is no session to read. This returns the same ADMIN placeholder\n * identity AppShell renders (src/app/(app)/shell.tsx's PLACEHOLDER_USER)\n * and throws FORBIDDEN when that role isn't in the allowed list. Every\n * write endpoint in this PRD calls requireRole() instead of checking role\n * itself, so wiring up a real session later is a one-file change here\n * instead of touching every route.\n */\nconst PLACEHOLDER_USER = { id: 'placeholder-user', role: 'ADMIN' as Role };\n\nexport function requireRole(...roles: Role[]): { id: string; role: Role } {\n  if (!roles.includes(PLACEHOLDER_USER.role)) {\n    throw new AppError('FORBIDDEN', 'You do not have permission to perform this action.');\n  }\n  return PLACEHOLDER_USER;\n}\n---\n(eval):1: no matches found: --include=*.ts\n       0\n       0\nsrc/app/(app)/admin/sections/[id]/page.tsx:12:  requireRole('ADMIN');\nsrc/app/(app)/admin/sections/page.tsx:11:  requireRole('ADMIN');\nsrc/app/(app)/admin/courses/[id]/enrollment/page.tsx:11:  const user = requireRole('ADMIN');\nsrc/app/(app)/admin/courses/page.tsx:11:  const user = requireRole('ADMIN');\nsrc/app/(app)/students/[id]/courses/page.tsx:25:  const user = requireRole(...ALL_ROLES);\nsrc/app/(app)/courses/[courseId]/roster/page.tsx:23:  const user = requireRole(...ALL_ROLES);\nsrc/app/(app)/courses/[courseId]/layout.tsx:23:  const user = requireRole(...ALL_ROLES);\nsrc/app/(app)/my-courses/page.tsx:56:  const user = requireRole(...ALL_ROLES);\n---\nimport { prisma } from '@/server/db';\nimport { logger } from '@/lib/logger';\n\nexport interface AuditInput {\n  actorId?: string | null;\n  action: string;\n  entityType?: string;\n  entityId?: string;\n  metadata?: Record<string, unknown>;\n}\n\n/**\n * Insert-only audit trail, the single writer of AuditLog rows. Every write\n * endpoint calls this after a successful mutation with action\n * `<entity>.create|update|archive|delete`. Never throws -- a failed audit\n * write must not fail the request it's recording, so errors are logged\n * and swallowed.\n */\nexport async function audit(input: AuditInput): Promise<void> {\n  try {\n    await prisma.auditLog.create({\n      data: {\n        actorId: input.actorId ?? null,\n        action: input.action,\n        entityType: input.entityType,\n        entityId: input.entityId,\n        metadata: input.metadata,\n      },\n    });\n  } catch (error) {\n    logger.error('Failed to write audit log', {\n      action: input.action,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\nsrc/lib:\ndates.ts\nenv.ts\nlogger.ts\nvalidators\n\nsrc/server:\naudit.ts\nauth\ncourses\ncsv.ts\ndb.ts\nenrollment\nhttp.ts\nsections\nservices\ntype LogMeta = Record<string, unknown> | undefined;\ntype Level = 'info' | 'warn' | 'error';\n\nconst isProd = process.env.NODE_ENV === 'production';\n\nfunction write(level: Level, message: string, meta?: LogMeta) {\n  const console_ = level === 'error' ? console.error : level === 'warn' ? console.warn : console.log;\n\n  if (isProd) {\n    console_(JSON.stringify({ level, message, meta, time: new Date().toISOString() }));\n    return;\n  }\n\n  console_(`[${level.toUpperCase()}] ${message}`, meta ?? '');\n}\n\nexport const logger = {\n  info: (message: string, meta?: LogMeta) => write('info', message, meta),\n  warn: (message: string, meta?: LogMeta) => write('warn', message, meta),\n  error: (message: string, meta?: LogMeta) => write('error', message, meta),","is_error":false}]},"parent_tool_use_id":null,"session_id":"2d28ca65-c0bb-4a8d-a303-0fc23bd16a10","uuid":"7ed8a7c3-b8e2-4b16-bf9f-abedf8464bd