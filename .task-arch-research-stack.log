10\",\n    \"@types/nodemailer\": \"^6.4.15\",\n    \"@types/papaparse\": \"^5.3.14\",\n    \"@types/react\": \"18.3.3\",\n    \"@types/react-dom\": \"18.3.0\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"e898cb16-9a36-455e-8838-11a321209b69","uuid":"134adc5d-1763-4e72-a5d6-2f0ab886c88e","timestamp":"2026-10-27T16:29:10.945Z","tool_use_result":{"stdout":"{\n  \"name\": \"schoolhub\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"engines\": {\n    \"node\": \">=18.18.0\"\n  },\n  \"scripts\": {\n    \"dev\": \"next dev\",\n    \"build\": \"next build\",\n    \"start\": \"next start\",\n    \"lint\": \"next lint\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\",\n    \"test:e2e\": \"playwright test\",\n    \"db:migrate\": \"prisma migrate dev\",\n    \"db:deploy\": \"prisma migrate deploy\",\n    \"db:seed\": \"tsx prisma/seed.ts\",\n    \"db:reset\": \"prisma migrate reset --force\",\n    \"worker:email\": \"tsx scripts/worker-email.ts\",\n    \"format\": \"prettier --write .\"\n  },\n  \"dependencies\": {\n    \"@emotion/react\": \"11.13.3\",\n    \"@emotion/styled\": \"11.13.0\",\n    \"@hookform/resolvers\": \"3.9.0\",\n    \"@mui/icons-material\": \"9.5.0\",\n    \"@mui/material\": \"9.5.0\",\n    \"@mui/material-nextjs\": \"9.5.0\",\n    \"@mui/x-charts\": \"9.5.0\",\n    \"@mui/x-data-grid\": \"9.5.0\",\n    \"@mui/x-date-pickers\": \"9.5.0\",\n    \"@prisma/client\": \"5.20.0\",\n    \"@react-email/components\": \"0.0.25\",\n    \"@react-email/render\": \"1.0.1\",\n    \"bcrypt\": \"^6.0.0\",\n    \"date-fns\": \"3.6.0\",\n    \"date-fns-tz\": \"3.2.0\",\n    \"next\": \"14.2.18\",\n    \"next-auth\": \"^5.0.0-beta.25\",\n    \"nodemailer\": \"^6.9.14\",\n    \"papaparse\": \"^5.4.1\",\n    \"react\": \"18.3.1\",\n    \"react-dom\": \"18.3.1\",\n    \"react-hook-form\": \"7.53.0\",\n    \"react-is\": \"18.3.1\",\n    \"zod\": \"3.23.8\"\n  },\n  \"devDependencies\": {\n    \"@axe-core/playwright\": \"4.10.0\",\n    \"@playwright/test\": \"1.47.2\",\n    \"@testing-library/jest-dom\": \"6.5.0\",\n    \"@testing-library/react\": \"16.0.1\",\n    \"@testing-library/user-event\": \"14.5.2\",\n    \"@types/bcrypt\": \"^6.0.0\",\n    \"@types/node\": \"20.14.10\",\n    \"@types/nodemailer\": \"^6.4.15\",\n    \"@types/papaparse\": \"^5.3.14\",\n    \"@types/react\": \"18.3.3\",\n    \"@types/react-dom\": \"18.3.0\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgT4Lyzai7VMez7MkrX8W","type":"message","role":"assistant","content":[{"type":"text","text":"Good, confirms the stack. Now writing the ADR file for abcd-05."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1143,"cache_read_input_tokens":44889,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1143},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e898cb16-9a36-455e-8838-11a321209b69","uuid":"84cb9871-c5c5-4b72-8c56-f6e9d87d6762","timestamp":"2026-10-27T16:29:13.133Z","request_id":"req_011CgT4LygUdEDK3ZMdRuCXv"}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgT4Lyzai7VMez7MkrX8W","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GikjMowA8M7ETpxvgLhnS2","name":"Write","input":{"file_path":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/tech-stack-decisions.md","content":"# Tech Stack Decisions — PRD-05 Classes & Enrollment\n\nTicket: abcd-05 · Phase: architect (arch-research-stack) · Status: complete\n\nBase platform (from `artifacts/intake/tech-stack.json`, confidence 100%):\nNext.js 14 App Router, React 18, TypeScript strict, Prisma 5 / PostgreSQL,\nMUI v9 + emotion, `zod` for input validation, `date-fns`. This PRD is\nbrownfield on top of that stack — intake's detection notes already confirm\nit \"adds no new frontend framework or dependency,\" only new Prisma models\nand pages. The decisions below are the implementation-pattern deltas this\nPRD's requirements force, not a re-litigation of the base stack. No new\nruntime dependency is added by this PRD.\n\n## ADR-1: Bulk enroll/drop writes — `Prisma.$transaction` with batched\n`createMany`/`updateMany`, no job queue\n\n**Context.** NFR-3 requires adding 30 students to a section with 8 core\ncourses (240 resulting enrollments) to complete in under 1 second. FR-7–\nFR-10 describe enroll-on-add, drop-on-remove, move-section, and\ncreate-core-course as all-or-nothing operations touching many `Enrollment`\nrows at once.\n\n**Decision.** Implement each of these as a single `prisma.$transaction`\nthat computes the affected (studentId, courseId) pairs in memory first,\nthen issues one `enrollment.createMany({ skipDuplicates: true })` for new\nACTIVE rows and one `enrollment.updateMany` (keyed on the unique\n`[courseId, studentId]`) to reactivate previously-DROPPED rows, instead of\nlooping `create`/`update` calls per student per course. This is plain\nPrisma batch-write API already in the installed `@prisma/client` — no\nqueue, no background worker, no new dependency. 240 rows in one\n`createMany` plus one `updateMany` comfortably clears the 1-second bar on\nPostgres; a per-row loop (240 round-trips) would not.\n\n**Consequences.** Business logic that decides \"create vs. reactivate\" for\neach pair must be computed with a single prior `findMany`, not per-row\nqueries, to keep the whole operation at a small constant number of\nround-trips. If a future PRD needs enroll/drop across thousands of rows\n(bulk import), that's a new ADR for chunking or a background job — not a\nretrofit of this one.\n\n_Cites: FR-7, FR-8, FR-9, FR-10, NFR-3_\n\n## ADR-2: Capacity + uniqueness enforcement — DB unique constraints for\nidentity, in-transaction count check for capacity, no distributed lock\n\n**Context.** NFR-2 requires the one-section-per-student-per-year rule to be\na database constraint, not just app logic. FR-11 requires capacity\nenforcement (section and course) that refuses with CONFLICT unless an\nexplicit \"Override capacity\" flag is set, under concurrent admin actions.\n\n**Decision.** Identity/duplication rules (`@@unique([studentId,\nacademicYearId])` on `SectionMember`, `@@unique([courseId, studentId])` on\n`Enrollment`) are enforced by Postgres unique indexes already specified in\nFR-1; application code catches the Prisma `P2002` violation and maps it to\nthe existing CONFLICT error envelope rather than pre-checking existence\nfirst (avoids a check-then-insert race). Capacity, which is a *computed*\ncount rather than a stored invariant, is checked inside the same\n`$transaction` that performs the insert — `count()` the current\nmembers/enrollments, compare to `capacity`, and only then\n`create`/`createMany`, so a concurrent request either serializes behind the\ntransaction or re-checks and fails cleanly. No advisory lock, no Redis, no\ndistributed-lock library: Postgres's own transactional read-your-writes\nwithin one `$transaction` is sufficient at this app's scale (a school\nadmin console, not a high-concurrency storefront).\n\n**Consequences.** Capacity checks are \"good enough\" serialization, not a\nhard guarantee under extreme concurrent load from multiple admins hitting\nthe exact same section simultaneously; acceptable because this is an\ninternal admin tool with low write concurrency. If that ever changes,\nupgrading the capacity check to `SELECT ... FOR UPDATE` on a row is a small\nfollow-up, not a new ADR.\n\n_Cites: FR-1, FR-11, NFR-2_\n\n## ADR-3: No new dependency for the admin UI (tables, dialogs, pickers)\n\n**Context.** NFR-1 mandates every visible element in the sections/courses/\nenrollment screens come from `@mui/material`, `@mui/icons-material`, or MUI\nX, with no banned libraries (Tailwind, shadcn/ui, Radix, react-select,\netc.). FR-2–FR-6, FR-13–FR-19 describe filtered tables, create/edit\ndialogs, multi-select pickers, tabs, and card grids.\n\n**Decision.** Build all of it from the already-installed MUI v9 set plus\nthe existing shared components (`DataTable`, `UserPicker`, `ConfirmDialog`,\n`useToast`, `PageHeader`) per the brownfield reuse already confirmed in\nintake. Multi-select student/subject pickers extend `UserPicker`'s\nexisting `role` filter pattern rather than introducing a new\nautocomplete/select component. No new UI dependency.\n\n**Consequences.** None beyond the existing MUI-MCP lookup discipline\n(NFR-1) for any component variant not already used elsewhere in the\ncodebase.\n\n_Cites: FR-2, FR-3, FR-4, FR-5, FR-6, FR-13, FR-14, FR-15, FR-17, FR-19, NFR-1_\n\n## ADR-4: Auth — keep the `requireRole(...ALL_ROLES)` stand-in, no new\nauth helper\n\n**Context.** NFR-7 flags that `src/server/auth/permissions.ts` and\n`requireUser()` described in the platform context don't exist yet — only\n`requireRole.ts` and `student-access.ts` are present. This is the same\nbrownfield gap PRD-04's architect handoff already flagged.\n\n**Decision.** New route handlers in this PRD (sections/courses/enrollment\nCRUD, move-section, roster) continue to use the existing\n`requireRole(...ALL_ROLES)`-style stand-in, and `assertCanViewCourse`/\n`assertCanManageCourse` (FR-18) are added as plain functions in\n`src/server/auth/course-access.ts` alongside the existing\n`student-access.ts`, not as part of a new `permissions.ts` module. No new\nauth library, no new abstraction invented ahead of PRD-01 landing it\nproperly.\n\n**Consequences.** Role-gating logic stays slightly duplicated across\nper-feature `*-access.ts` files until PRD-01 ships a real\n`permissions.ts`; that consolidation is PRD-01's job, not this one's.\n\n_Cites: FR-18, FR-22, NFR-7_\n\n## Summary of new dependencies\n\nNone. Every requirement in this PRD (bulk transactional writes, capacity\nchecks, uniqueness, admin UI, auth gating) is covered by Prisma 5,\nPostgreSQL, MUI v9, and TypeScript already in the stack — intake's\nconfidence-100% stack detection holds.\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1143,"cache_read_input_tokens":44889,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1143},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e898cb16-9a36-455e-8838-11a321209b69","uuid":"2b7de622-cd6c-4632-a828-a631276f3e9e","timestamp":"2026-10-27T16:29:39.962Z","request_id":"req_011CgT4LygUdEDK3ZMdRuCXv"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GikjMowA8M7ETpxvgLhnS2","type":"tool_result","content":"The file /Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/tech-stack-decisions.md has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e898cb16-9a36-455e-8838-11a321209b69","uuid":"f996920d-13a7-4e5c-80f1-4d7af25ca6d7","timestamp":"2026-10-27T16:29:40.085Z","tool_use_result":{"type":"update","filePath":"/Users/ikramaansari/Documents/forge/schoolhub-prds/artifacts/architect/tech-stack-decisions.md","content":"# Tech Stack Decisions — PRD-05 Classes & Enrollment\n\nTicket: abcd-05 · Phase: architect (arch-research-stack) · Status: complete\n\nBase platform (from `artifacts/intake/tech-stack.json`, confidence 100%):\nNext.js 14 App Router, React 18, TypeScript strict, Prisma 5 / PostgreSQL,\nMUI v9 + emotion, `zod` for input validation, `date-fns`. This PRD is\nbrownfield on top of that stack — intake's detection notes already confirm\nit \"adds no new frontend framework or dependency,\" only new Prisma models\nand pages. The decisions below are the implementation-pattern deltas this\nPRD's requirements force, not a re-litigation of the base stack. No new\nruntime dependency is added by this PRD.\n\n## ADR-1: Bulk enroll/drop writes — `Prisma.$transaction` with batched\n`createMany`/`updateMany`, no job queue\n\n**Context.** NFR-3 requires adding 30 students to a section with 8 core\ncourses (240 resulting enrollments) to complete in under 1 second. FR-7–\nFR-10 describe enroll-on-add, drop-on-remove, move-section, and\ncreate-core-course as all-or-nothing operations touching many `Enrollment`\nrows at once.\n\n**Decision.** Implement each of these as a single `prisma.$transaction`\nthat computes the affected (studentId, courseId) pairs in memory first,\nthen issues one `enrollment.createMany({ skipDuplicates: true })` for new\nACTIVE rows and one `enrollment.updateMany` (keyed on the unique\n`[courseId, studentId]`) to reactivate previously-DROPPED rows, instead of\nlooping `create`/`update` calls per student per course. This is plain\nPrisma batch-write API already in the installed `@prisma/client` — no\nqueue, no background worker, no new dependency. 240 rows in one\n`createMany` plus one `updateMany` comfortably clears the 1-second bar on\nPostgres; a per-row loop (240 round-trips) would not.\n\n**Consequences.** Business logic that decides \"create vs. reactivate\" for\neach pair must be computed with a single prior `findMany`, not per-row\nqueries, to keep the whole operation at a small constant number of\nround-trips. If a future PRD needs enroll/drop across thousands of rows\n(bulk import), that's a new ADR for chunking or a background job — not a\nretrofit of this one.\n\n_Cites: FR-7, FR-8, FR-9, FR-10, NFR-3_\n\n## ADR-2: Capacity + uniqueness enforcement — DB unique constraints for\nidentity, in-transaction count check for capacity, no distributed lock\n\n**Context.** NFR-2 requires the one-section-per-student-per-year rule to be\na database constraint, not just app logic. FR-11 requires capacity\nenforcement (section and course) that refuses with CONFLICT unless an\nexplicit \"Override capacity\" flag is set, under concurrent admin actions.\n\n**Decision.** Identity/duplication rules (`@@unique([studentId,\nacademicYearId])` on `SectionMember`, `@@unique([courseId, studentId])` on\n`Enrollment`) are enforced by Postgres unique indexes already specified in\nFR-1; application code catches the Prisma `P2002` violation and maps it to\nthe existing CONFLICT error envelope rather than pre-checking existence\nfirst (avoids a check-then-insert race). Capacity, which is a *computed*\ncount rather than a stored invariant, is checked inside the same\n`$transaction` that performs the insert — `count()` the current\nmembers/enrollments, compare to `capacity`, and only then\n`create`/`createMany`, so a concurrent request either serializes behind the\ntransaction or re-checks and fails cleanly. No advisory lock, no Redis, no\ndistributed-lock library: Postgres's own transactional read-your-writes\nwithin one `$transaction` is sufficient at this app's scale (a school\nadmin console, not a high-concurrency storefront).\n\n**Consequences.** Capacity checks are \"good enough\" serialization, not a\nhard guarantee under extreme concurrent load from multiple admins hitting\nthe exact same section simultaneously; acceptable because this is an\ninternal admin tool with low write concurrency. If that ever changes,\nupgrading the capacity check to `SELECT ... FOR UPDATE` on a row is a small\nfollow-up, not a new ADR.\n\n_Cites: FR-1, FR-11, NFR-2_\n\n## ADR-3: No new dependency for the admin UI (tables, dialogs, pickers)\n\n**Context.** NFR-1 mandates every visible element in the sections/courses/\nenrollment screens come from `@mui/material`, `@mui/icons-material`, or MUI\nX, with no banned libraries (Tailwind, shadcn/ui, Radix, react-select,\netc.). FR-2–FR-6, FR-13–FR-19 describe filtered tables, create/edit\ndialogs, multi-select pickers, tabs, and card grids.\n\n**Decision.** Build all of it from the already-installed MUI v9 set plus\nthe existing shared components (`DataTable`, `UserPicker`, `ConfirmDialog`,\n`useToast`, `PageHeader`) per the brownfield reuse already confirmed in\nintake. Multi-select student/subject pickers extend `UserPicker`'s\nexisting `role` filter pattern rather than introducing a new\nautocomplete/select component. No new UI dependency.\n\n**Consequences.** None beyond the existing MUI-MCP lookup discipline\n(NFR-1) for any component variant not already used elsewhere in the\ncodebase.\n\n_Cites: FR-2, FR-3, FR-4, FR-5, FR-6, FR-13, FR-14, FR-15, FR-17, FR-19, NFR-1_\n\n## ADR-4: Auth — keep the `requireRole(...ALL_ROLES)` stand-in, no new\nauth helper\n\n**Context.** NFR-7 flags that `src/server/auth/permissions.ts` and\n`requireUser()` described in the platform context don't exist yet — only\n`requireRole.ts` and `student-access.ts` are present. This is the same\nbrownfield gap PRD-04's architect handoff already flagged.\n\n**Decision.** New route handlers in this PRD (sections/courses/enrollment\nCRUD, move-section, roster) continue to use the existing\n`requireRole(...ALL_ROLES)`-style stand-in, and `assertCanViewCourse`/\n`assertCanManageCourse` (FR-18) are added as plain functions in\n`src/server/auth/course-access.ts` alongside the existing\n`student-access.ts`, not as part of a new `permissions.ts` module. No new\nauth library, no new abstraction invented ahead of PRD-01 landing it\nproperly.\n\n**Consequences.** Role-gating logic stays slightly duplicated across\nper-feature `*-access.ts` files until PRD-01 ships a real\n`permissions.ts`; that consolidation is PRD-01's job, not this one's.\n\n_Cites: FR-18, FR-22, NFR-7_\n\n## Summary of new dependencies\n\nNone. Every requirement in this PRD (bulk transactional writes, capacity\nchecks, uniqueness, admin UI, auth gating) is covered by Prisma 5,\nPostgreSQL, MUI v9, and TypeScript already in the stack — intake's\nconfidence-100% stack detection holds.\n","structuredPatch":[{"oldStart":1,"oldLines":166,"newStart":1,"newLines":124,"lines":["-# Tech Stack Decisions — PRD-04 Notifications & Email","+# Tech Stack Decisions — PRD-05 Classes & Enrollment"," ","-Ticket: abcd-04 · Phase: architect (arch-research-stack) · Status: complete","+Ticket: abcd-05 · Phase: architect (arch-research-stack) · Status: complete"," "," Base platform (from `artifacts/intake/tech-stack.json`, confidence 100%):"," Next.js 14 App Router, React 18, TypeScript strict, Prisma 5 / PostgreSQL,","-MUI v9 + emotion. This PRD is brownfield on top of that stack — the","-decisions below are only the deltas this PRD's requirements force, not a","-re-litigation of the base stack.","+MUI v9 + emotion, `zod` for input validation, `date-fns`. This PRD is","+brownfield on top of that stack — intake's detection notes already confirm","+it \"adds no new frontend framework or dependency,\" only new Prisma models","+and pages. The decisions below are the implementation-pattern deltas this","+PRD's requirements force, not a re-litigation of the base stack. No new","+runtime dependency is added by this PRD."," ","-## ADR-1: Email rendering — `@react-email/components` (new dependency)","+## ADR-1: Bulk enroll/drop writes — `Prisma.$transaction` with batched","+`createMany`/`updateMany`, no job queue"," ","-**Context.** FR-7/FR-8 require branded HTML+plain-text email templates","-(invite, password-reset, generic) sharing a base layout. The codebase has","-no email-rendering layer today (`sendInvite()` in","-`src/server/services/users.ts` is a logging-only stub per FR-9). NFR-1","-scopes MUI to *visible app UI*; it explicitly exempts email templates","-because MUI's `sx`/emotion runtime CSS does not survive email-client HTML","-sanitizers (no `<style>` tag support, inconsistent CSS-in-JS rendering in","-Outlook/Gmail clients).","+**Context.** NFR-3 requires adding 30 students to a section with 8 core","+courses (240 resulting enrollments) to complete in under 1 second. FR-7–","+FR-10 describe enroll-on-add, drop-on-remove, move-section, and","+create-core-course as all-or-nothing operations touching many `Enrollment`","+rows at once."," ","-**Decision.** Add `@react-email/components` (+ `@react-email/render`) as","-the email templating layer, rendered server-side to both an HTML string and","-a plain-text string. This is a new dependency, but it is the one intake","-already named in `detectionNotes` (\"adds Nodemailer + @react-email/components","-for the email layer\"), and it's the standard choice for React-authored,","-email-client-safe markup (table-based layout, inlined styles) — hand-rolling","-that is a bigger lift than reusing the library intake already flagged.","-Templates live under `src/server/email/templates/`, outside the app's React","-tree, so they never import MUI or app-side providers.","+**Decision.** Implement each of these as a single `prisma.$transaction`","+that computes the affected (studentId, courseId) pairs in memory first,","+then issues one `enrollment.createMany({ skipDuplicates: true })` for new","+ACTIVE rows and one `enrollment.updateMany` (keyed on the unique","+`[courseId, studentId]`) to reactivate previously-DROPPED rows, instead of","+looping `create`/`update` calls per student per course. This is plain","+Prisma batch-write API already in the installed `@prisma/client` — no","+queue, no background worker, no new dependency. 240 rows in one","+`createMany` plus one `updateMany` comfortably clears the 1-second bar on","+Postgres; a per-row loop (240 round-trips) would not."," ","-**Consequences.** One new runtime dependency. Templates are a separate","-component universe from the app (plain React components, no MUI, no","-`'use client'`) — contributors must know not to reach for app UI components","-here. Base layout (logo/name header, footer with school address + manage-","-preferences link + disclosure sentence) is a single shared component per","-FR-7, so the three templates (FR-8) stay thin.","-","-_Cites: FR-7, FR-8, FR-9, NFR-1, NFR-6_","-","-## ADR-2: Email transport — Nodemailer with a console-transport dev fallback","-","-**Context.** FR-10/FR-13 require sending queued emails via SMTP, with env","-vars `SMTP_HOST/PORT/USER/PASS/SECURE`, `EMAIL_FROM`, and an","-`EMAIL_TRANSPORT` switch (`smtp|console`, default `console` in dev) so local","-dev never needs real SMTP creds.","-","-**Decision.** Add `nodemailer` as the SMTP client — it's the de facto","-standard Node SMTP library, zero-config for any provider the school's ops","-team points `SMTP_HOST` at, and needs no additional service/queue","-infrastructure. Wrap it behind a one-function `sendMail()` in","-`src/server/email/transport.ts` that switches on `EMAIL_TRANSPORT`: `smtp`","-constructs a Nodemailer transporter from the env vars, `console` just logs","-subject/recipient/text (FR-13) and returns success. No new dependency","-beyond Nodemailer itself — no mail-queue service, no third-party ESP SDK,","-because the queue is already modeled in Postgres (`EmailOutbox`, ADR-3).","-","-**Consequences.** Local/dev/CI runs need zero external services. Production","-requires real SMTP credentials in env; if a future PRD needs provider-specific","-features (templates-as-a-service, bounce webhooks), that's a new ADR, not a","+**Consequences.** Business logic that decides \"create vs. reactivate\" for","+each pair must be computed with a single prior `findMany`, not per-row","+queries, to keep the whole operation at a small constant number of","+round-trips. If a future PRD needs enroll/drop across thousands of rows","+(bulk import), that's a new ADR for chunking or a background job — not a"," retrofit of this one."," ","-_Cites: FR-10, FR-13_","+_Cites: FR-7, FR-8, FR-9, FR-10, NFR-3_"," ","-## ADR-3: Email queue & delivery guarantees — Postgres row-locking, no message broker","+## ADR-2: Capacity + uniqueness enforcement — DB unique constraints for","+identity, in-transaction count check for capacity, no distributed lock"," ","-**Context.** FR-10/FR-11/FR-12 need an outbox with retries/backoff and a","-dispatcher invocable both as an HTTP endpoint (external cron) and a local","-loop. NFR-4 requires no email is ever sent twice under concurrent","-dispatchers, and that rows stuck `SENDING` for >10 min self-heal back to","-`PENDING`.","+**Context.** NFR-2 requires the one-section-per-student-per-year rule to be","+a database constraint, not just app logic. FR-11 requires capacity","+enforcement (section and course) that refuses with CONFLICT unless an","+explicit \"Override capacity\" flag is set, under concurrent admin actions."," ","-**Decision.** Model the queue as the `EmailOutbox` Prisma table (FR-1) and","-drive the dispatcher with `SELECT ... FOR UPDATE SKIP LOCKED` (as a","-`prisma.$queryRaw` transaction) to claim a batch — Postgres supports this","-natively, so no Redis/SQS/BullMQ is needed. This keeps delivery state in","-the same transactional store as the rest of the app (one DB to operate,","-backup, and reason about) and satisfies the \"never sent twice\" guarantee","-via row-level locks instead of a distributed lock service. The 10-minute","-stuck-`SENDING` recovery (NFR-4) is a plain `UPDATE ... WHERE status =","-'SENDING' AND updatedAt < now() - interval '10 minutes'` run at the top of","-each dispatch call — no separate sweeper process.","+**Decision.** Identity/duplication rules (`@@unique([studentId,","+academicYearId])` on `SectionMember`, `@@unique([courseId, studentId])` on","+`Enrollment`) are enforced by Postgres unique indexes already specified in","+FR-1; application code catches the Prisma `P2002` violation and maps it to","+the existing CONFLICT error envelope rather than pre-checking existence","+first (avoids a check-then-insert race). Capacity, which is a *computed*","+count rather than a stored invariant, is checked inside the same","+`$transaction` that performs the insert — `count()` the current","+members/enrollments, compare to `capacity`, and only then","+`create`/`createMany`, so a concurrent request either serializes behind the","+transaction or re-checks and fails cleanly. No advisory lock, no Redis, no","+distributed-lock library: Postgres's own transactional read-your-writes","+within one `$transaction` is sufficient at this app's scale (a school","+admin console, not a high-concurrency storefront)."," ","-**Consequences.** Dispatch throughput is bounded by what a single Postgres","-table can do under `FOR UPDATE SKIP LOCKED`; fine at this app's scale","-(schools, not millions of emails/day — NFR-2's 1,000-recipient/2s bar is the","-stated ceiling). If volume ever outgrows a single-table queue, promoting to","-a real broker is a new ADR, not a patch to this one.","-`ponytail: in-memory last-run tracking for purgeOldNotifications() (FR-17)","-is a single-process assumption — acceptable per the PRD's own note that","-re-running after a restart is fine; move to a DB-tracked cursor only if a","-multi-instance deploy makes double-purges a real cost.`","+**Consequences.** Capacity checks are \"good enough\" serialization, not a","+hard guarantee under extreme concurrent load from multiple admins hitting","+the exact same section simultaneously; acceptable because this is an","+internal admin tool with low write concurrency. If that ever changes,","+upgrading the capacity check to `SELECT ... FOR UPDATE` on a row is a small","+follow-up, not a new ADR."," ","-_Cites: FR-1, FR-10, FR-11, FR-12, NFR-2, NFR-4_","+_Cites: FR-1, FR-11, NFR-2_"," ","-## ADR-4: Dispatcher trigger — HTTP endpoint + optional local loop, no cron infra","+## ADR-3: No new dependency for the admin UI (tables, dialogs, pickers)"," ","-**Context.** FR-12 asks for both `POST /api/internal/email/dispatch`","-(bearer-protected, for an external scheduler) and `npm run worker:email`","-(a local loop calling `dispatchEmails` every 15s) \"for local/simple","-deployments.\"","+**Context.** NFR-1 mandates every visible element in the sections/courses/","+enrollment screens come from `@mui/material`, `@mui/icons-material`, or MUI","+X, with no banned libraries (Tailwind, shadcn/ui, Radix, react-select,","+etc.). FR-2–FR-6, FR-13–FR-19 describe filtered tables, create/edit","+dialogs, multi-select pickers, tabs, and card grids."," ","-**Decision.** Ship both as thin callers of the same `dispatchEmails()`","-function — the route handler for the HTTP path, and a small `tsx` script","-(`scripts/worker-email.ts`, matching the existing `tsx`-based scripts","-pattern already used for `db:seed`) for the loop. No new process manager,","-no node-cron dependency: `setInterval`-in-a-script is sufficient for a","-15-second local loop, and the HTTP path is what production actually relies","-on (external scheduler hits the bearer-protected route). Auth is the","-existing bearer-token-against-`CRON_SECRET` pattern (NFR-8), no new auth","-primitive.","+**Decision.** Build all of it from the already-installed MUI v9 set plus","+the existing shared components (`DataTable`, `UserPicker`, `ConfirmDialog`,","+`useToast`, `PageHeader`) per the brownfield reuse already confirmed in","+intake. Multi-select student/subject pickers extend `UserPicker`'s","+existing `role` filter pattern rather than introducing a new","+autocomplete/select component. No new UI dependency."," ","-**Consequences.** Production deployments must wire an external scheduler","-(cron, platform's scheduled-task feature, etc.) to hit the dispatch route —","-this PRD does not provide one. That's explicitly in scope per FR-12's","-wording (\"for an external scheduler\") and out of scope per NFR-10 (no new","-infra beyond what's listed).","+**Consequences.** None beyond the existing MUI-MCP lookup discipline","+(NFR-1) for any component variant not already used elsewhere in the","+codebase."," ","-_Cites: FR-12, NFR-8_","+_Cites: FR-2, FR-3, FR-4, FR-5, FR-6, FR-13, FR-14, FR-15, FR-17, FR-19, NFR-1_"," ","-## ADR-5: Notification type safety — literal union derived from the registry, no new validation library","+## ADR-4: Auth — keep the `requireRole(...ALL_ROLES)` stand-in, no new","+auth helper"," ","-**Context.** FR-2/FR-3 require a typed registry (`NOTIFICATION_TYPES`) and","-`notify()` rejecting unknown type keys at compile time.","+**Context.** NFR-7 flags that `src/server/auth/permissions.ts` and","+`requireUser()` described in the platform context don't exist yet — only","+`requireRole.ts` and `student-access.ts` are present. This is the same","+brownfield gap PRD-04's architect handoff already flagged."," ","-**Decision.** Define `NOTIFICATION_TYPES` as a `const` object and derive the","-key union via `keyof typeof NOTIFICATION_TYPES` (standard TS pattern,","-already idiomatic in a `strict: true` codebase — no new dependency). Runtime","-validation of request-boundary inputs (e.g. the `type` field arriving in an","-API body) uses `zod`, already a dependency, matching the rest of the","-codebase's API-input-validation convention.","+**Decision.** New route handlers in this PRD (sections/courses/enrollment","+CRUD, move-section, roster) continue to use the existing","+`requireRole(...ALL_ROLES)`-style stand-in, and `assertCanViewCourse`/","+`assertCanManageCourse` (FR-18) are added as plain functions in","+`src/server/auth/course-access.ts` alongside the existing","+`student-access.ts`, not as part of a new `permissions.ts` module. No new","+auth library, no new abstraction invented ahead of PRD-01 landing it","+properly."," ","-**Consequences.** None beyond normal TS discipline — adding a notification","-type later means editing the one registry object, and every caller of","-`notify()` gets the new key for free (or a compile error if they typo it).","+**Consequences.** Role-gating logic stays slightly duplicated across","+per-feature `*-access.ts` files until PRD-01 ships a real","+`permissions.ts`; that consolidation is PRD-01's job, not this one's."," ","-_Cites: FR-2, FR-3, NFR-9_","+_Cites: FR-18, FR-22, NFR-7_"," ","-## ADR-6: No new dependency for polling/popover UI","-","-**Context.** FR-14/FR-15 need a 30s-interval unread-count poll (paused on","-`visibilitychange`) and a popover with a notification list.","-","-**Decision.** Use plain `useEffect` + `setInterval` + the","-`document.visibilitychange` event (native browser APIs) for polling, and","-MUI's own `Popover`/`List`/`Badge` components (NFR-1) for the UI — no","-polling library (no `swr`/`react-query` in the dependency list today, and","-adding one for a single 30s interval is disproportionate to the need).","-","-**Consequences.** If a later PRD needs broader client-side data-fetching","-/caching (multiple polled resources, dedup, retry), that's the point to","-introduce `swr` or `@tanstack/react-query` as a real ADR — not pre-empted","-here for one endpoint.","-","-_Cites: FR-14, FR-15, NFR-1, NFR-10_","-"," ## Summary of new dependencies"," ","-| Package | Why | Alternative considered & rejected |","-|---|---|---|","-| `nodemailer` | SMTP client for the dispatcher | Provider-specific ESP SDK — rejected, over-fits to one vendor; PRD only asks for generic SMTP env vars |","-| `@react-email/components`, `@react-email/render` | Email-client-safe HTML+text templates | Hand-written HTML strings — rejected, harder to keep DRY across 3+ templates and the shared base layout; MUI — rejected per NFR-1's explicit email exemption |","-","-No other new dependencies. Everything else (queueing, retries, locking,","-scheduling, type-safety, polling) is covered by Postgres, Prisma, the","-TypeScript compiler, and native browser/Node APIs already in this stack.","+None. Every requirement in this PRD (bulk transactional writes, capacity","+checks, uniqueness, admin UI, auth gating) is covered by Prisma 5,","+PostgreSQL, MUI v9, and TypeScript already in the stack — intake's","+confidence-100% stack detection holds."]}],"originalFile":"# Tech Stack Decisions — PRD-04 Notifications & Email\n\nTicket: abcd-04 · Phase: architect (arch-research-stack) · Status: complete\n\nBase platform (from `artifacts/intake/tech-stack.json`, confidence 100%):\nNext.js 14 App Router, React 18, TypeScript strict, Prisma 5 / PostgreSQL,\nMUI v9 + emotion. This PRD is brownfield on top of that stack — the\ndecisions below are only the deltas this PRD's requirements force, not a\nre-litigation of the base stack.\n\n## ADR-1: Email rendering — `@react-email/components` (new dependency)\n\n**Context.** FR-7/FR-8 require branded HTML+plain-text email templates\n(invite, password-reset, generic) sharing a base layout. The codebase has\nno email-rendering layer today (`sendInvite()` in\n`src/server/services/users.ts` is a logging-only stub per FR-9). NFR-1\nscopes MUI to *visible app UI*; it explicitly exempts email templates\nbecause MUI's `sx`/emotion runtime CSS does not survive email-client HTML\nsanitizers (no `<style>` tag support, inconsistent CSS-in-JS rendering in\nOutlook/Gmail clients).\n\n**Decision.** Add `@react-email/components` (+ `@react-email/render`) as\nthe email templating layer, rendered server-side to both an HTML string and\na plain-text string. This is a new dependency, but it is the one intake\nalready named in `detectionNotes` (\"adds Nodemailer + @react-email/components\nfor the email layer\"), and it's the standard choice for React-authored,\nemail-client-safe markup (table-based layout, inlined styles) — hand-rolling\nthat is a bigger lift than reusing the library intake already flagged.\nTemplates live under `src/server/email/templates/`, outside the app's React\ntree, so they never import MUI or app-side providers.\n\n**Consequences.** One new runtime dependency. Templates are a separate\ncomponent universe from the app (plain React components, no MUI, no\n`'use client'`) — contributors must know not to reach for app UI components\nhere. Base layout (logo/name header, footer with school address + manage-\npreferences link + disclosure sentence) is a single shared component per\nFR-7, so the three templates (FR-8) stay thin.\n\n_Cites: FR-7, FR-8, FR-9, NFR-1, NFR-6_\n\n## ADR-2: Email transport — Nodemailer with a console-transport dev fallback\n\n**Context.** FR-10/FR-13 require sending queued emails via SMTP, with env\nvars `SMTP_HOST/PORT/USER/PASS/SECURE`, `EMAIL_FROM`, and an\n`EMAIL_TRANSPORT` switch (`smtp|console`, default `console` in dev) so local\ndev never needs real SMTP creds.\n\n**Decision.** Add `nodemailer` as the SMTP client — it's the de facto\nstandard Node SMTP library, zero-config for any provider the school's ops\nteam points `SMTP_HOST` at, and needs no additional service/queue\ninfrastructure. Wrap it behind a one-function `sendMail()` in\n`src/server/email/transport.ts` that switches on `EMAIL_TRANSPORT`: `smtp`\nconstructs a Nodemailer transporter from the env vars, `console` just logs\nsubject/recipient/text (FR-13) and returns success. No new dependency\nbeyond Nodemailer itself — no mail-queue service, no third-party ESP SDK,\nbecause the queue is already modeled in Postgres (`EmailOutbox`, ADR-3).\n\n**Consequences.** Local/dev/CI runs need zero external services. Production\nrequires real SMTP credentials in env; if a future PRD needs provider-specific\nfeatures (templates-as-a-service, bounce webhooks), that's a new ADR, not a\nretrofit of this one.\n\n_Cites: FR-10, FR-13_\n\n## ADR-3: Email queue & delivery guarantees — Postgres row-locking, no message broker\n\n**Context.** FR-10/FR-11/FR-12 need an outbox with retries/backoff and a\ndispatcher invocable both as an HTTP endpoint (external cron) and a local\nloop. NFR-4 requires no email is ever sent twice under concurrent\ndispatchers, and that rows stuck `SENDING` for >10 min self-heal back to\n`PENDING`.\n\n**Decision.** Model the queue as the `EmailOutbox` Prisma table (FR-1) and\ndrive the dispatcher with `SELECT ... FOR UPDATE SKIP LOCKED` (as a\n`prisma.$queryRaw` transaction) to claim a batch — Postgres supports this\nnatively, so no Redis/SQS/BullMQ is needed. This keeps delivery state in\nthe same transactional store as the rest of the app (one DB to operate,\nbackup, and reason about) and satisfies the \"never sent twice\" guarantee\nvia row-level locks instead of a distributed lock service. The 10-minute\nstuck-`SENDING` recovery (NFR-4) is a plain `UPDATE ... WHERE status =\n'SENDING' AND updatedAt < now() - interval '10 minutes'` run at the top of\neach dispatch call — no separate sweeper process.\n\n**Consequences.** Dispatch throughput is bounded by what a single Postgres\ntable can do under `FOR UPDATE SKIP LOCKED`; fine at this app's scale\n(schools, not millions of emails/day — NFR-2's 1,000-recipient/2s bar is the\nstated ceiling). If volume ever outgrows a single-table queue, promoting to\na real broker is a new ADR, not a patch to this one.\n`ponytail: in-memory last-run tracking for purgeOldNotifications() (FR-17)\nis a single-process assumption — acceptable per the PRD's own note that\nre-running after a restart is fine; move to a DB-tracked cursor only if a\nmulti-instance deploy makes double-purges a real cost.`\n\n_Cites: FR-1, FR-10, FR-11, FR-12, NFR-2, NFR-4_\n\n## ADR-4: Dispatcher trigger — HTTP endpoint + optional local loop, no cron infra\n\n**Context.** FR-12 asks for both `POST /api/internal/email/dispatch`\n(bearer-protected, for an external scheduler) and `npm run worker:email`\n(a local loop calling `dispatchEmails` every 15s) \"for local/simple\ndeployments.\"\n\n**Decision.** Ship both as thin callers of the same `dispatchEmails()`\nfunction — the route handler for the HTTP path, and a small `tsx` script\n(`scripts/worker-email.ts`, matching the existing `tsx`-based scripts\npattern already used for `db:seed`) for the loop. No new process manager,\nno node-cron dependency: `setInterval`-in-a-script is sufficient for a\n15-second local loop, and the HTTP path is what production actually relies\non (external scheduler hits the bearer-protected route). Auth is the\nexisting bearer-token-against-`CRON_SECRET` pattern (NFR-8), no new auth\nprimitive.\n\n**Consequences.** Production deployments must wire an external scheduler\n(cron, platform's scheduled-task feature, etc.) to hit the dispatch route —\nthis PRD does not provide one. That's explicitly in scope per FR-12's\nwording (\"for an external scheduler\") and out of scope per NFR-10 (no new\ninfra beyond what's listed).\n\n_Cites: FR-12, NFR-8_\n\n## ADR-5: Notification type safety — literal union derived from the registry, no new validation library\n\n**Context.** FR-2/FR-3 require a typed registry (`NOTIFICATION_TYPES`) and\n`notify()` rejecting unknown type keys at compile time.\n\n**Decision.** Define `NOTIFICATION_TYPES` as a `const` object and derive the\nkey union via `keyof typeof NOTIFICATION_TYPES` (standard TS pattern,\nalready idiomatic in a `strict: true` codebase — no new dependency). Runtime\nvalidation of request-boundary inputs (e.g. the `type` field arriving in an\nAPI body) uses `zod`, already a dependency, matching the rest of the\ncodebase's API-input-validation convention.\n\n**Consequences.** None beyond normal TS discipline — adding a notification\ntype later means editing the one registry object, and every caller of\n`notify()` gets the new key for free (or a compile error if they typo it).\n\n_Cites: FR-2, FR-3, NFR-9_\n\n## ADR-6: No new dependency for polling/popover UI\n\n**Context.** FR-14/FR-15 need a 30s-interval unread-count poll (paused on\n`visibilitychange`) and a popover with a notification list.\n\n**Decision.** Use plain `useEffect` + `setInterval` + the\n`document.visibilitychange` event (native browser APIs) for polling, and\nMUI's own `Popover`/`List`/`Badge` components (NFR-1) for the UI — no\npolling library (no `swr`/`react-query` in the dependency list today, and\nadding one for a single 30s interval is disproportionate to the need).\n\n**Consequences.** If a later PRD needs broader client-side data-fetching\n/caching (multiple polled resources, dedup, retry), that's the point to\nintroduce `swr` or `@tanstack/react-query` as a real ADR — not pre-empted\nhere for one endpoint.\n\n_Cites: FR-14, FR-15, NFR-1, NFR-10_\n\n## Summary of new dependencies\n\n| Package | Why | Alternative considered & rejected |\n|---|---|---|\n| `nodemailer` | SMTP client for the dispatcher | Provider-specific ESP SDK — rejected, over-fits to one vendor; PRD only asks for generic SMTP env vars |\n| `@react-email/components`, `@react-email/render` | Email-client-safe HTML+text templates | Hand-written HTML strings — rejected, harder to keep DRY across 3+ templates and the shared base layout; MUI — rejected per NFR-1's explicit email exemption |\n\nNo other new dependencies. Everything else (queueing, retries, locking,\nscheduling, type-safety, polling) is covered by Postgres, Prisma, the\nTypeScript compiler, and native browser/Node APIs already in this stack.\n","userModified":false}}
