{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TLwyLtYSVThyUkvtQ5Bcbb","type":"tool_result","content":"import bcrypt from 'bcrypt';\nimport { CredentialsSignin } from 'next-auth';\nimport type { Role } from '@prisma/client';\nimport { prisma } from '@/server/db';\nimport { audit } from '@/server/audit';\nimport { getClientIp } from '@/server/http';\nimport { rateLimit } from '@/server/rate-limit';\nimport { signInSchema } from '@/lib/validators/auth';\n\n/** Error code surfaces to the login form via signIn(..., {redirect:false}).code (FR-5, FR-7). */\nexport class AuthError extends CredentialsSignin {\n  constructor(code: string) {\n    super(code);\n    this.code = code;\n  }\n}\n\nexport const MAX_FAILED_LOGINS = 5;\nexport const LOCKOUT_MS = 15 * 60_000;\nconst LOGIN_RATE_LIMIT = 10;\nconst LOGIN_RATE_WINDOW_MS = 5 * 60_000;\n\n// Compared against when the user is missing / has no hash, so every path costs one bcrypt compare (NFR-3).\nconst DUMMY_HASH = bcrypt.hashSync('schoolhub-dummy-password-never-matches', 12);\n\n/** FR-6: given the failure count after this attempt, the values to persist. */\nexport function computeLockout(count: number, now: Date): { failedLoginCount: number; lockedUntil: Date | null } {\n  if (count >= MAX_FAILED_LOGINS) return { failedLoginCount: 0, lockedUntil: new Date(now.getTime() + LOCKOUT_MS) };\n  return { failedLoginCount: count, lockedUntil: null };\n}\n\nexport interface AuthorizedUser {\n  id: string;\n  email: string;\n  firstName: string;\n  lastName: string;\n  role: Role;\n}\n\nexport async function authorizeCredentials(input: unknown, request: Request): Promise<AuthorizedUser> {\n  const ip = getClientIp(request);\n  const fail = async (reason: string, email: string | null, actorId: string | null = null): Promise<never> => {\n    await audit({ actorId, action: 'auth.login.failure', entityType: 'User', entityId: actorId ?? undefined, metadata: { email, reason }, request });\n    throw new AuthError(reason);\n  };\n\n  if (!rateLimit(`login:ip:${ip ?? 'unknown'}`, LOGIN_RATE_LIMIT, LOGIN_RATE_WINDOW_MS).ok) {\n    return fail('rate_limited', null);\n  }\n\n  const parsed = signInSchema.safeParse(input);\n  if (!parsed.success) return fail('invalid', null);\n  const { email, password } = parsed.data;\n\n  const user = await prisma.user.findUnique({ where: { email } });\n  const passwordOk = await bcrypt.compare(password, user?.passwordHash ?? DUMMY_HASH);\n  const now = new Date();\n\n  if (!user) return fail('invalid', email);\n  if (user.status === 'DISABLED') return fail('disabled', email, user.id);\n  if (user.status !== 'ACTIVE' || user.archivedAt) return fail('invalid', email, user.id);\n  if (user.lockedUntil && user.lockedUntil > now) {\n    return fail(`locked:${Math.ceil((user.lockedUntil.getTime() - now.getTime()) / 60_000)}`, email, user.id);\n  }\n\n  if (!passwordOk || !user.passwordHash) {\n    // ponytail: concurrent failures can overshoot the count by one before the lock lands; harmless.\n    const { failedLoginCount } = await prisma.user.update({\n      where: { id: user.id },\n      data: { failedLoginCount: { increment: 1 } },\n      select: { failedLoginCount: true },\n    });\n    const lock = computeLockout(failedLoginCount, now);\n    if (lock.lockedUntil) {\n      await prisma.user.update({ where: { id: user.id }, data: lock });\n      await audit({ actorId: user.id, action: 'auth.lockout', entityType: 'User', entityId: user.id, metadata: { email }, request });\n      return fail(`locked:${LOCKOUT_MS / 60_000}`, email, user.id);\n    }\n    return fail('invalid', email, user.id);\n  }\n\n  await prisma.user.update({ where: { id: user.id }, data: { failedLoginCount: 0, lockedUntil: null, lastLoginAt: now } });\n  await audit({ actorId: user.id, action: 'auth.login.success', entityType: 'User', entityId: user.id, request });\n  return { id: user.id, email: user.email, firstName: user.firstName, lastName: user.lastName, role: user.role };\n}\nimport NextAuth from 'next-auth';\nimport Credentials from 'next-auth/providers/credentials';\nimport { prisma } from '@/server/db';\nimport { authConfig } from '@/server/auth/auth.config';\nimport { authorizeCredentials } from '@/server/auth/credentials';\n\nconst RECHECK_MS = 5 * 60_000;\n\nexport const { handlers, auth, signIn, signOut, unstable_update } = NextAuth({\n  ...authConfig,\n  providers: [\n    Credentials({\n      credentials: { email: {}, password: {} },\n      authorize: (credentials, request) => authorizeCredentials(credentials, request),\n    }),\n  ],\n  callbacks: {\n    ...authConfig.callbacks,\n    async jwt({ token, user, trigger, session }) {\n      const now = Date.now();\n\n      if (trigger === 'signIn' && user) {\n        return {\n          ...token,\n          id: user.id as string,\n          role: user.role,\n          firstName: user.firstName,\n          lastName: user.lastName,\n          email: user.email,\n          authTime: now,\n          checkedAt: now,\n        };\n      }\n\n      // FR-23: the session that just changed its password stays valid.\n      if (trigger === 'update' && (session as { reauth?: boolean } | undefined)?.reauth) {\n        return { ...token, authTime: now, checkedAt: now };\n      }\n\n      // FR-11: revoke within 5 min of disable/archive/password change elsewhere.\n      if (now - (token.checkedAt ?? 0) > RECHECK_MS) {\n        const fresh = await prisma.user.findUnique({\n          where: { id: token.id },\n          select: { passwordChangedAt: true, status: true, archivedAt: true, role: true, firstName: true, lastName: true },\n        });\n        if (!fresh || fresh.status !== 'ACTIVE' || fresh.archivedAt) return null;\n        if (fresh.passwordChangedAt && fresh.passwordChangedAt.getTime() > token.authTime) return null;\n        return { ...token, role: fresh.role, firstName: fresh.firstName, lastName: fresh.lastName, checkedAt: now };\n      }\n\n      return token;\n    },\n  },\n});\n----\nsrc/lib/validators/auth.ts:10:export const emailField = z.string().trim().toLowerCase().email('Enter a valid email address');\nsrc/lib/validators/auth.ts:12:export interface PasswordCheckResult {\nsrc/lib/validators/auth.ts:19:export const PASSWORD_RULES: Record<keyof PasswordCheckResult, { label: string; error: string }> = {\nsrc/lib/validators/auth.ts:26:export function passwordChecks(password: string, email: string): PasswordCheckResult {\nsrc/lib/validators/auth.ts:36:export function passwordErrors(password: string, email: string): string[] {\nsrc/lib/validators/auth.ts:44:export function safeCallbackUrl(url: string | null | undefined): string {\nsrc/lib/validators/auth.ts:49:export const signInSchema = z.object({\nsrc/lib/validators/auth.ts:54:export const forgotPasswordSchema = z.object({ email: emailField });\nsrc/lib/validators/auth.ts:72:export function setPasswordSchema(email = '') {\nsrc/lib/validators/auth.ts:76:export const acceptInviteSchema = z\nsrc/lib/validators/auth.ts:80:export const resetPasswordSchema = acceptInviteSchema;\nsrc/lib/validators/auth.ts:82:export function changePasswordFormSchema(email = '') {\nsrc/lib/validators/auth.ts:92:export const changePasswordSchema = changePasswordFormSchema();\nsrc/lib/validators/auth.ts:94:export type SignInInput = z.infer<typeof signInSchema>;\nsrc/lib/validators/auth.ts:95:export type AcceptInviteInput = z.infer<typeof acceptInviteSchema>;\nsrc/lib/validators/auth.ts:96:export type ResetPasswordInput = z.infer<typeof resetPasswordSchema>;\nsrc/lib/validators/auth.ts:97:export type ChangePasswordInput = z.infer<typeof changePasswordSchema>;\nsrc/lib/validators/auth.ts:98:export type SetPasswordValues = z.infer<ReturnType<typeof setPasswordSchema>>;\nsrc/server/auth/password-policy.ts:18:export function assertPasswordAllowed(password: string, email: string): void {\nsrc/server/rate-limit.ts:5:export function rateLimit(\nsrc/server/rate-limit.ts:21:export function __resetRateLimits(): void {\nsrc/s